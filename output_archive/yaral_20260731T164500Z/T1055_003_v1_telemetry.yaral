/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:47:36.130960+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_Process_Open_Handle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where an unexpected process requests a handle to another process with thread-manipulation-capable access rights. Thread Execution Hijacking (T1055.003) requires OpenThread/OpenProcess with rights sufficient to suspend, write, and resume a thread. This rule fires on the handle acquisition event itself rather than on command-line telemetry, providing a complementary detection layer that is harder for attackers to suppress."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target.process.file.full_path and principal.process.file.full_path populated. Sysmon Event ID 10 (ProcessAccess) mapped to UDM PROCESS_OPEN is the primary source. The access mask field should be mapped to a UDM extension or security_result field if available."
    platform = "Windows"
    false_positives = "Debuggers (Visual Studio, WinDbg, x64dbg), legitimate AV/EDR self-protection handles, JIT compilers (JVM, CLR), crash-reporting agents (WerFault), RMM agents performing process inspection, and profiling tools. Tune aggressively using the reference lists below."
    tuning_guidance = "Add known-good opener binaries (full path) to %global_allowed_process_openers. Add known-good target process names to %global_allowed_process_open_targets. Consider narrowing to non-system32 openers first to reduce volume in noisy environments."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener (principal) must NOT be a well-known system process that
    // legitimately opens handles to other processes for benign reasons.
    // We match on processes outside the canonical Windows system directories
    // OR on scripting hosts that should never be opening arbitrary process handles.
    (
      not $open.principal.process.file.full_path = /\\(windows\\system32|windows\\syswow64|windows\\sysnative)\\/ nocase
      or
      $open.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|cmd)\.exe$/ nocase
    )

    // Target must be a running process that is a plausible hijack victim:
    // system services, browsers, or other long-lived processes.
    // We exclude self-opens (same process opening itself) by requiring the
    // target to be a different well-known host process.
    $open.target.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|SearchHost|SearchIndexer|spoolsv|winlogon|csrss|services|dllhost|taskhost|taskhostw|sihost|ctfmon|audiodg|chrome|msedge|firefox|iexplore)\.exe$/ nocase

    // Exclude the opener being the same binary as the target (self-inspection
    // patterns used by browsers and runtimes).
    not $open.principal.process.file.full_path = $open.target.process.file.full_path

    // Exclude known-good opener binaries supplied per-customer.
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Exclude known-good target processes that are routinely inspected in
    // this environment (e.g., a customer's own monitoring agent opening svchost).
    not $open.target.process.file.full_path in %global_allowed_process_open_targets

    // Exclude openers running from user-writable temp paths that are already
    // caught by other rules (avoid double-alerting on the noisier path).
    not $open.principal.process.file.full_path = /\\(appdata|programdata|temp|tmp)\\/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opener_pid = array_distinct($open.principal.process.pid)
    $target_pid = array_distinct($open.target.process.pid)

  condition:
    $open
}
