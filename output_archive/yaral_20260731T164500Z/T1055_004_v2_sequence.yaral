/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:50:54.213027+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_OpenThread_Then_RemoteModule {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects APC injection pattern: a process opens a handle to a remote thread (PROCESS_OPEN targeting another process) followed by a DLL module load into that same victim process within 5 minutes. This covers QueueUserAPC-style and Early Bird injection where a suspended process is created and a foreign DLL is mapped into it, without relying on command-line matching."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., Sysmon Event ID 10 / CrowdStrike process handle events) and PROCESS_MODULE_LOAD events (e.g., Sysmon Event ID 7). Both event types must populate principal.process.file.full_path and target.process.file.full_path."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio), profilers (VTune, dotTrace), AV/EDR products performing self-injection, JVM/CLR runtimes loading helper DLLs into child processes, RMM agents."
    tuning_guidance = "Add known-good opener processes (debuggers, AV engines, RMM agents) to %apc_allowed_handle_openers. Add known-good DLL paths (signed system DLLs loaded by legitimate tooling) to %apc_allowed_module_paths. Narrow the rule further by requiring the opened process to be a high-value target (lsass, svchost) if noise is excessive."

  events:
    // Event 1: A process opens a handle to a DIFFERENT process's thread.
    // PROCESS_OPEN in UDM represents cross-process handle acquisition.
    // principal = opener, target = victim process being opened.
    $open.metadata.event_type = "PROCESS_OPEN"
    // Opener must not be a known-good system process lineage.
    not $open.principal.process.file.full_path in %apc_allowed_handle_openers
    // Exclude self-opens (same process opening itself is benign).
    $open.principal.process.pid != $open.target.process.pid
    // Victim process must be a running host process worth injecting into.
    $open.target.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|dllhost|werfault|spoolsv|taskhost|taskhostw|sihost|ctfmon|SearchIndexer|msiexec)\.exe$/ nocase
    // Shared join key: the victim hostname where injection occurs.
    $open.principal.hostname = $hostname
    // Secondary join key: victim process image path ties the two events together.
    $open.target.process.file.full_path = $victim_image

    // Event 2: A DLL module load occurs INTO the same victim process image
    // shortly after the handle was opened, consistent with QueueUserAPC
    // causing LoadLibraryA or a mapped shellcode stub loading a DLL.
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.principal.hostname = $hostname
    // The loading process must be the same victim image that was opened.
    $mod.principal.process.file.full_path = $victim_image
    // The loaded DLL must NOT reside in canonical Windows system paths,
    // flagging DLLs dropped to temp, user-writable, or unusual locations.
    not $mod.target.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss][Yy][Ss][Tt][Ee][Mm]32\\/
    not $mod.target.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss][Yy][Ss][Ww][Oo][Ww]64\\/
    not $mod.target.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ww][Ii][Nn][Ss][Xx][Ss]\\/
    not $mod.target.process.file.full_path = /^[Cc]:\\[Pp]rogram [Ff]iles\\/
    not $mod.target.process.file.full_path = /^[Cc]:\\[Pp]rogram [Ff]iles \([Xx]86\)\\/
    not $mod.target.file.full_path in %apc_allowed_module_paths

    // Chronological ordering: handle open must precede the module load.
    $open.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname, $victim_image over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $opener_pid = array_distinct($open.principal.process.pid)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $injected_module = array_distinct($mod.target.process.file.full_path)
    $module_load_count = count($mod.metadata.event_timestamp.seconds)

  condition:
    $open and $mod
}
