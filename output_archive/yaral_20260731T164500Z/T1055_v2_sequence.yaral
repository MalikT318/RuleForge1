/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:45:38.668009+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_ProcessOpen_Then_RemoteThread_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process opening a handle to a remote process (PROCESS_OPEN) followed by a process injection event (PROCESS_INJECTION) originating from the same host within 5 minutes. This two-stage pattern is characteristic of classic injection techniques such as VirtualAllocEx/WriteProcessMemory/CreateRemoteThread and is additive to existing PROCESS_LAUNCH command-line detections."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., Sysmon Event ID 10 / CrowdStrike process handle telemetry) and PROCESS_INJECTION events. Both event types must be ingested into Chronicle UDM."
    platform = "Windows, Linux, macOS"
    false_positives = "Debuggers (Visual Studio, WinDbg, gdb, lldb), legitimate AV/EDR self-protection handle opens, JVM/CLR runtimes opening child process handles, RMM agents performing process inspection, crash-dump collectors (WerFault, Breakpad)."
    tuning_guidance = "Add known-safe opener binaries to %global_allowed_process_openers (e.g., debuggers, AV engines). Add known-safe target process paths to %global_allowed_injection_targets. Raise severity if the target process is a high-value host such as lsass.exe or winlogon.exe."

  events:
    // Leg 1: a process opens a handle to another (remote) process
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path != ""
    $open.target.process.file.full_path != ""
    // Exclude the trivial self-open case
    $open.principal.process.pid != $open.target.process.pid
    // Exclude known-safe openers via reference list
    not $open.principal.process.file.full_path in %global_allowed_process_openers
    // Exclude system idle / kernel pseudo-processes
    not $open.principal.process.file.full_path = /^(System|Idle)$/ nocase
    $open.principal.hostname = $hostname

    // Leg 2: an injection event on the same host, after the handle open
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path != ""
    $inj.target.process.file.full_path != ""
    not $inj.principal.process.file.full_path in %global_allowed_process_openers
    not $inj.target.process.file.full_path in %global_allowed_injection_targets
    // Exclude self-injection (legitimate runtimes inject into themselves)
    not $inj.principal.process.file.full_path = $inj.target.process.file.full_path
    $inj.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the injection
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $target_process = array_distinct($inj.target.process.file.full_path)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $opened_target = array_distinct($open.target.process.file.full_path)
    $injection_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
