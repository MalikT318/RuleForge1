/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:46:28.251215+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_ProcessOpen_Then_RemoteThread_DLL_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the two-stage DLL injection pattern: a non-system process opens a handle to a remote process (PROCESS_OPEN) and then a new thread is created in that target process (PROCESS_INJECTION) within 5 minutes. This covers the VirtualAllocEx/WriteProcessMemory/CreateRemoteThread injection chain without relying on command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., Sysmon Event ID 10 - ProcessAccess) and PROCESS_INJECTION events (e.g., Sysmon Event ID 8 - CreateRemoteThread). Both event types must be ingested into Chronicle UDM."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), AV/EDR products performing process inspection, RMM agents (e.g., CrowdStrike, SentinelOne self-protection), JIT compilers, and software installers that inject into host processes."
    tuning_guidance = "Add known-good opener processes (debuggers, EDR agents) to %global_allowed_process_openers. Add known-good target processes that are routinely injected into by legitimate software to %global_allowed_injection_targets. Consider scoping by asset criticality tier."

  events:
    // Stage 1: A non-system process opens a handle to another process.
    // Sysmon Event 10 (ProcessAccess) maps to PROCESS_OPEN in UDM.
    // principal = the process opening the handle; target = the victim process.
    $open.metadata.event_type = "PROCESS_OPEN"

    // Exclude common system paths that legitimately open process handles at high volume.
    not $open.principal.process.file.full_path = /\\(svchost|lsass|csrss|wininit|services|smss)\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\Windows\\(System32|SysWOW64)\\/ nocase

    // Require the opener to be a user-space or suspicious-path process.
    $open.principal.process.file.full_path = /\.(exe|dll|scr|com)$/ nocase

    // Exclude known-good openers via reference list (EDR agents, debuggers, RMM).
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Exclude known-good injection targets via reference list.
    not $open.target.process.file.full_path in %global_allowed_injection_targets

    // Capture the hostname to join both events to the same machine.
    $open.principal.hostname = $hostname

    // Capture the opener process path to correlate with the injection event.
    $open.principal.process.file.full_path = $opener_path

    // Stage 2: A remote thread is created in a target process on the same host.
    // Sysmon Event 8 (CreateRemoteThread) maps to PROCESS_INJECTION in UDM.
    // principal = the injecting process; target = the process receiving the thread.
    $inj.metadata.event_type = "PROCESS_INJECTION"

    // The injecting process must be the same binary that opened the handle.
    $inj.principal.process.file.full_path = $opener_path

    // Exclude self-injection (same PID) - legitimate for some runtimes.
    // Require the injection to target a different process (cross-process).
    not $inj.principal.process.file.full_path = $inj.target.process.file.full_path

    // Exclude known-good injection targets on the injection side as well.
    not $inj.target.process.file.full_path in %global_allowed_injection_targets

    // Exclude known-good openers on the injection side as well.
    not $inj.principal.process.file.full_path in %global_allowed_process_openers

    $inj.principal.hostname = $hostname

    // Enforce chronological ordering: handle open must precede thread creation.
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $opener_path over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $target_process_open = array_distinct($open.target.process.file.full_path)
    $target_process_injected = array_distinct($inj.target.process.file.full_path)
    $injecting_user = array_distinct($open.principal.user.userid)
    $open_event_count = count($open.metadata.event_timestamp.seconds)
    $inj_event_count = count($inj.metadata.event_timestamp.seconds)

  condition:
    $open and $inj
}
