/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:48:26.473988+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where a process requests thread-level access rights consistent with APC injection (OpenThread / NtQueueApcThread patterns). Attackers performing APC injection must first obtain a handle to a target thread with THREAD_SET_CONTEXT or THREAD_GET_CONTEXT rights before queuing the APC. This rule fires on the resulting handle-open telemetry rather than command-line arguments, providing coverage that is orthogonal to process-creation rules and harder for attackers to suppress."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR telemetry that records PROCESS_OPEN / thread-open events with the requested access mask and the calling process path. Sysmon Event ID 10 (ProcessAccess) with GrantedAccess populated, or a compatible EDR source ingested as UDM PROCESS_OPEN, is required."
    platform = "Windows"
    false_positives = "Debuggers (WinDbg, x64dbg, Visual Studio debugger), profiling tools (VTune, dotTrace), legitimate AV/EDR self-protection hooks, crash-dump collectors (WerFault), and some RMM agents that enumerate thread state."
    tuning_guidance = "Add known-good callers (debuggers, AV engines, RMM agents) to %global_allowed_thread_openers. Narrow further by pairing with a cross-process memory-write event on the same host within a short window. Consider raising severity when the calling process is itself a short-lived or unsigned binary."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Caller must NOT be a known system process performing legitimate thread inspection.
    // Legitimate callers are excluded via reference list; what remains are unexpected openers.
    not $open.principal.process.file.full_path in %global_allowed_thread_openers

    // The calling process should not be a native Windows component under System32
    // performing routine work. We flag callers outside the canonical system paths
    // OR callers that are interpreters/scripting hosts (high-risk LOLBins).
    (
      not $open.principal.process.file.full_path = /\\Windows\\System32\\/  nocase
      or $open.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|certutil|bitsadmin|installutil|regasm|regsvcs|msbuild|cmstp|xwizard|syncappvpublishingserver)\.exe$/  nocase
    )

    // Target must be a process other than the caller itself (cross-process injection).
    // Self-opens are routine; cross-process opens with thread-level rights are suspicious.
    $open.principal.process.pid != $open.target.process.pid

    // Target process is a high-value injection target: a running user-mode process.
    // We look for well-known host processes that adversaries commonly inject into.
    // Broad enough to avoid hardcoding attacker tooling; narrow enough to reduce noise.
    (
      $open.target.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|SearchHost|SearchIndexer|spoolsv|winlogon|csrss|dllhost|taskhost|taskhostw|sihost|ctfmon|dwm|wininit|services|smss)\.exe$/ nocase
      or $open.target.process.file.full_path = /\\(msedge|chrome|firefox|iexplore|MicrosoftEdge)\.exe$/ nocase
    )

    // The requested access mask should include thread-manipulation rights.
    // THREAD_SET_CONTEXT (0x0010) is required for QueueUserAPC.
    // THREAD_GET_CONTEXT (0x0008) is required for Early Bird / suspended-process variants.
    // Chronicle surfaces this in target.process.access_mask when the EDR populates it.
    // We match on the hex string representation as populated by Sysmon/EDR UDM mapping.
    (
      $open.target.process.access_mask = /0x001[0-9a-fA-F]/ nocase
      or $open.target.process.access_mask = /0x0[0-9a-fA-F][1-9a-fA-F][0-9a-fA-F]/ nocase
      or $open.target.process.access_mask = /0x1[fF]3[aA]/ nocase
      or $open.target.process.access_mask = /0x1[fF]0[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]/ nocase
    )

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($open.principal.hostname)

  condition:
    $open
}
