/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:47:59.184868+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_OpenProcess_Then_Suspicious_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects thread execution hijacking by correlating a PROCESS_OPEN event (a process acquiring a handle to a remote process, indicative of OpenThread/SuspendThread API usage) followed by an outbound network connection from the same victim process within 5 minutes. This pattern captures the post-injection network beacon that typically follows successful thread hijacking, providing coverage additive to command-line-based detections."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint via Chronicle ingestion) and NETWORK_CONNECTION events with process context. The PROCESS_OPEN event must populate target.process.pid and principal.process.file.full_path."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio), profilers (VTune, dotTrace), RMM agents (CrowdStrike, SentinelOne self-protection), AV engines performing process inspection, and JIT compilers. Tune via %global_allowed_process_openers and %global_allowed_process_open_targets."
    tuning_guidance = "Add known-good opener process paths to %global_allowed_process_openers (e.g., debuggers, AV engines). Add known-good target process paths to %global_allowed_process_open_targets. Narrow the network side by adding trusted internal CIDR ranges to %rfc1918_internal if not already present. Consider raising risk_score if the opener process is not signed or lives in a user-writable directory."

  events:
    // Event 1: A process opens a handle to another process (PROCESS_OPEN).
    // This is the telemetry signal for OpenThread / SuspendThread API calls.
    // We pre-filter to cases where the opener is NOT a known system tool and
    // the target is a high-value host process (svchost, lsass, explorer, etc.)
    // to avoid a Cartesian explosion on noisy PROCESS_OPEN streams.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(svchost|explorer|lsass|winlogon|csrss|services|spoolsv|taskhost|taskhostw|RuntimeBroker|SearchIndexer|dllhost)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_process_openers
    not $open.target.process.file.full_path in %global_allowed_process_open_targets
    // The opener must not itself be a known Windows system binary acting legitimately.
    not $open.principal.process.file.full_path = /\\(MsMpEng|MpCmdRun|SenseIR|CSFalconService|SentinelAgent)\.exe$/ nocase
    $open.principal.hostname = $hostname
    // Capture the target process name so we can join to the network event
    // from the same victim process on the same host.
    $open.target.process.file.full_path = $victim_proc_path

    // Event 2: The victim process (the one whose thread was hijacked) makes
    // an outbound network connection to a non-RFC1918 address shortly after.
    // This is the post-injection C2 beacon from the hijacked thread.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $victim_proc_path
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname
    // Restrict to common C2 ports to reduce noise; tune as needed.
    $net.target.port >= 1
    not $net.principal.process.file.full_path in %global_allowed_process_open_targets

    // Chronological ordering: handle acquisition must precede the network beacon.
    $open.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $victim_proc_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $open_event_count = count($open.metadata.id)
    $net_event_count = count($net.metadata.id)

  condition:
    $open and $net
}
