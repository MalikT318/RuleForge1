/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:45:21.498938+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_ProcessInjection_ProcessHandleOpen {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious PROCESS_OPEN events where a process requests a handle to another process with permissions consistent with code injection (e.g., PROCESS_VM_WRITE, PROCESS_CREATE_THREAD, PROCESS_VM_OPERATION). Attackers must open a handle to the target process before writing shellcode or a reflective DLL into its address space. This rule fires on the handle-request artifact rather than the command line, providing a complementary detection layer that is harder to evade."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target process details (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint via MDE advanced hunting forwarded to Chronicle, or Sysmon Event ID 10). The target.process.file.full_path and principal.process.file.full_path fields must be populated."
    platform = "Windows, Linux, macOS"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, gdb, lldb), profilers (VTune, perf), AV/EDR agents performing self-inspection, crash reporting tools (WER, Breakpad), JIT runtimes (JVM, .NET CLR), and RMM agents. Tune aggressively using the reference lists below."
    tuning_guidance = "Add known-good opener process paths to %global_allowed_process_openers (e.g., debuggers, AV engines, RMM agents). Add known-good target process paths to %global_allowed_injection_targets. Consider narrowing by requiring the opener and target to be different users (cross-user handle opens are higher fidelity). Raise severity if the target process is a high-value system process (lsass, winlogon, svchost)."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opening (source) process must not be a known-good administrative tool
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // The target process being opened must not be an explicitly allow-listed target
    not $open.target.process.file.full_path in %global_allowed_injection_targets

    // Exclude self-opens: a process opening a handle to itself is normal (e.g., runtime introspection)
    $open.principal.process.pid != $open.target.process.pid

    // Target must be a running process with a resolvable image path - filters noise from
    // handle opens against kernel pseudo-processes and unnamed targets
    $open.target.process.file.full_path = /\// nocase or
    $open.target.process.file.full_path = /\\/ nocase

    // Exclude opens targeting the process's own parent (normal child->parent IPC)
    $open.principal.process.parent_pid != $open.target.process.pid

    // High-value injection targets: system processes that adversaries commonly abuse
    // to blend injected code with legitimate activity
    (
      $open.target.process.file.full_path = /\\(lsass|winlogon|svchost|explorer|csrss|wininit|services|spoolsv|taskhost|taskhostw|dllhost|rundll32|regsvr32|msiexec|werfault|searchindexer|RuntimeBroker)\.exe$/i nocase
      or
      // Cross-session or cross-user opens to any process are suspicious regardless of target name
      $open.target.process.file.full_path = /\.(exe|so|dylib)$/ nocase
    )

    // Exclude Windows kernel and system idle pseudo-processes (PID 0 and PID 4)
    $open.target.process.pid > 4

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opener_pid = array_distinct($open.principal.process.pid)
    $target_pid = array_distinct($open.target.process.pid)

  condition:
    $open
}
