/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:46:05.374600+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_Process_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process opening a handle to another process with permissions consistent with DLL injection preparation (PROCESS_VM_WRITE + PROCESS_CREATE_THREAD). Classic DLL injection requires writing a DLL path into the target process virtual address space and then creating a remote thread; both operations require elevated handle rights that are rarely needed by legitimate software against arbitrary third-party processes. This rule pivots on the PROCESS_OPEN telemetry layer rather than command-line arguments, providing additive coverage orthogonal to process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target.process.access_mask or equivalent handle-rights field (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint via MDE advanced hunting forwarded to Chronicle, or Sysmon Event ID 10 ingested via Chronicle Sysmon parser)."
    platform = "Windows"
    false_positives = "Debuggers (WinDbg, x64dbg, Visual Studio debugger), legitimate AV/EDR self-protection probes, process monitoring tools (Process Hacker, Process Explorer), RMM agents performing memory diagnostics, JVM/CLR runtimes performing cross-process optimisation."
    tuning_guidance = "Add known debugger and monitoring tool paths to %global_allowed_process_open_tools. Add known RMM agent paths to %global_allowed_rmm_agents. Consider narrowing by requiring the opening process to reside outside of %windir% and %programfiles% if your EDR populates principal.process.file.full_path reliably."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opening (injecting) process must NOT be a known Windows system binary.
    // Legitimate OS components rarely need cross-process VM_WRITE + CREATE_THREAD rights.
    not $open.principal.process.file.full_path = /\\windows\\system32\\/  nocase
    not $open.principal.process.file.full_path = /\\windows\\syswow64\\/ nocase
    not $open.principal.process.file.full_path = /\\windows\\sysnative\\/ nocase

    // The target process should not be the same process (self-injection is a separate technique).
    // Chronicle populates principal PID vs target PID; where available, exclude self-opens.
    // We approximate by ensuring the target process path differs from the opener.
    not $open.target.process.file.full_path = $open.principal.process.file.full_path

    // The target must be a running user-mode process (not an idle/system PID placeholder).
    $open.target.process.file.full_path = /\.exe$/  nocase

    // Access mask pattern: DLL injection requires at minimum PROCESS_VM_WRITE (0x0020),
    // PROCESS_VM_OPERATION (0x0008), and PROCESS_CREATE_THREAD (0x0002).
    // Many EDRs surface the access mask as a hex string or integer in the command_line
    // or a dedicated field. Match the combined mask value 0x43A (PROCESS_ALL_ACCESS subsets)
    // or the common shorthand masks seen in injection frameworks.
    // We match on the access_mask field where populated, and fall back to command_line
    // representation emitted by Sysmon (GrantedAccess field forwarded as command_line context).
    (
      $open.target.process.command_line = /0x[0-9a-f]*[13][0-9a-f]{2,}/  nocase
      or
      $open.target.process.command_line = /GrantedAccess.*0x[0-9a-f]*(1f|43|23|3[89a-f])/  nocase
    )

    // Exclude known-safe openers via reference list (MSSP multi-tenant tuning).
    not $open.principal.process.file.full_path in %global_allowed_process_open_tools
    not $open.principal.process.file.full_path in %global_allowed_rmm_agents

    // Exclude processes opening themselves or system idle.
    $open.principal.process.pid != 0
    $open.target.process.pid != 0
    $open.principal.process.pid != $open.target.process.pid

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opening_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
