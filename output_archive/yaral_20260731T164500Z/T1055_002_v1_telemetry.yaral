/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:46:53.105356+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious cross-process handle acquisition consistent with PE injection preparation. Adversaries performing T1055.002 must first open a handle to the target process with PROCESS_VM_WRITE and PROCESS_CREATE_THREAD access rights before calling VirtualAllocEx/WriteProcessMemory/CreateRemoteThread. This rule fires on PROCESS_OPEN events where a non-standard process requests those combined access rights against a high-value system process, catching the state change that precedes the actual injection without relying on command-line telemetry."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR telemetry that surfaces PROCESS_OPEN events with target process name and requested access mask (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, or Sysmon Event ID 10 ingested via Chronicle UDM). The target.process.file.full_path and principal.process.file.full_path fields must be populated."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), AV/EDR self-protection handles, process monitoring tools (Process Hacker, Process Explorer), JIT compilers (CLR, JVM) opening handles to their own child processes, and some RMM agents. Tune using the exclusion lists below."
    tuning_guidance = "Add known-good opener process paths to %global_allowed_process_openers (e.g., debuggers, AV engines, RMM agents). Add approved target process paths to %global_allowed_injection_targets if a specific pairing is a confirmed false positive. Consider narrowing by principal.user.userid to exclude dedicated service accounts."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener (principal) must NOT be a well-known system process that
    // legitimately opens handles to other processes. Regex anchored to
    // filename to survive path variation.
    not $open.principal.process.file.full_path = /\\(lsass|csrss|smss|wininit|services|svchost|MsMpEng|SenseIR|SenseCncProxy|MsSense|elastic-endpoint)\.exe$/ nocase

    // Target must be a high-value system process that adversaries commonly
    // inject into for privilege escalation or AV evasion.
    $open.target.process.file.full_path = /\\(lsass|svchost|explorer|winlogon|csrss|spoolsv|dllhost|RuntimeBroker|SearchIndexer|taskhostw|sihost)\.exe$/ nocase

    // The opener must not be the same binary as the target (self-handle).
    // Chronicle does not support field-to-field comparison directly, so we
    // exclude the most common self-open pattern: svchost opening svchost.
    // Broader self-open suppression is handled by the exclusion list.
    not $open.principal.process.file.full_path = /\\svchost\.exe$/ nocase

    // Opener must not reside in well-known AV / EDR / system directories.
    not $open.principal.process.file.full_path = /\\(Program Files|Program Files \(x86\))\\(Windows Defender|CrowdStrike|SentinelOne|Carbon Black|Cylance|Sophos|ESET|Trend Micro|McAfee|Symantec|Malwarebytes|Elastic)\\/ nocase

    // Opener must not reside in the Windows system directories (legitimate OS components).
    not $open.principal.process.file.full_path = /^[Cc]:\\[Ww]indows\\[Ss]ystem32\\/ nocase
    not $open.principal.process.file.full_path = /^[Cc]:\\[Ww]indows\\[Ss]ys[Ww][Oo][Ww]64\\/ nocase

    // Exclude known-good openers via reference list (MSSP tuning hook).
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Exclude known-good target pairings via reference list.
    not $open.target.process.file.full_path in %global_allowed_injection_targets

    // Require the opener to have a resolvable hostname (filters noise/incomplete events).
    $open.principal.hostname != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opener_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
