/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:47:11.395535+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_ProcessOpen_Then_RemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the two-stage behavioral signature of PE injection: a process opening a handle to a remote process (PROCESS_OPEN) followed by a remote thread creation event (PROCESS_INJECTION) in the same target process within 5 minutes. This covers the VirtualAllocEx/WriteProcessMemory/CreateRemoteThread pattern without relying on command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events for cross-process handle acquisition and PROCESS_INJECTION events for remote thread creation (e.g., CrowdStrike Falcon, SentinelOne, Microsoft Defender for Endpoint via Chronicle ingestion)."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio), JIT compilers, AV/EDR agents performing self-inspection, RMM tools (TeamViewer, AnyDesk remote assistance), and some DRM software that injects into host processes."
    tuning_guidance = "Add known-good injecting processes (debuggers, AV engines, RMM agents) to %global_allowed_injection_sources. Add known-good target processes (e.g., AV host processes) to %global_allowed_injection_targets. Raise severity if the injecting process is not signed or originates from a user-writable directory."

  events:
    // Stage 1: A process opens a handle to a DIFFERENT process (cross-process open)
    $open.metadata.event_type = "PROCESS_OPEN"
    // The opening process must not be opening itself (exclude same-process operations)
    $open.principal.process.pid != $open.target.process.pid
    // Exclude known-good system processes that legitimately open handles to others
    not $open.principal.process.file.full_path = /\\(lsass|csrss|smss|wininit|services)\.exe$/ nocase
    // Exclude known-good injecting tools (debuggers, AV, RMM)
    not $open.principal.process.file.full_path in %global_allowed_injection_sources
    // Exclude known-good target processes
    not $open.target.process.file.full_path in %global_allowed_injection_targets
    // Bind the shared join key: the hostname where both events occur
    $open.principal.hostname = $hostname
    // Bind the injecting process path for outcome enrichment
    $open.principal.process.file.full_path = $injector_path
    // Bind the target process for outcome enrichment
    $open.target.process.file.full_path = $target_path

    // Stage 2: A remote thread or injection event fires on the same host
    $inj.metadata.event_type = "PROCESS_INJECTION"
    // The injecting process in stage 2 must match the opener from stage 1
    $inj.principal.process.file.full_path = $injector_path
    // The target process in stage 2 must match the opened process from stage 1
    $inj.target.process.file.full_path = $target_path
    // Exclude known-good injecting tools (same list, applied to injection event)
    not $inj.principal.process.file.full_path in %global_allowed_injection_sources
    not $inj.target.process.file.full_path in %global_allowed_injection_targets
    $inj.principal.hostname = $hostname

    // Enforce chronological ordering: handle open must precede injection
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($hostname)
    $injecting_processes = array_distinct($open.principal.process.file.full_path)
    $target_processes = array_distinct($open.target.process.file.full_path)
    $injecting_user = array_distinct($open.principal.user.userid)
    $injection_event_count = count($inj.metadata.event_timestamp.seconds)

  condition:
    $open and $inj
}
