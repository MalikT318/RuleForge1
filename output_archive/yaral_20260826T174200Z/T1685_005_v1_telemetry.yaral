/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-26T17:43:46.755265+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_005_EventLog_EVTX_File_Deletion_Or_Truncation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects direct deletion or modification of Windows Event Log .evtx files under the canonical winevt\\logs directory. Attackers who bypass command-line logging can still be caught at the file-system artifact layer when they truncate or remove the raw log files."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1485.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires EDR or Sysmon file-system telemetry (FILE_DELETION or FILE_MODIFICATION events on .evtx paths). Sysmon Event ID 23 (FileDelete) or equivalent EDR file-event telemetry must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Event Log service itself rotating or archiving logs (principal process will be svchost.exe hosting EventLog service). Backup agents reading/copying .evtx files may generate FILE_MODIFICATION events. Log archival scripts run by authorised administrators."
    tuning_guidance = "Add authorised backup or archival process paths to %global_allowed_evtx_managers. The most reliable tuning signal is the principal process: legitimate rotation is always performed by svchost.exe; any other process touching these files is suspicious."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /\\Windows\\System32\\winevt\\[Ll]ogs\\.*\.evtx$/ nocase
    not $file.principal.process.file.full_path = /\\Windows\\[Ss]ystem32\\svchost\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_evtx_managers

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1485.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_log_file = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
