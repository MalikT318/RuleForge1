/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-26T17:43:11.926284+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Auditd_Config_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file-level modifications to Linux Audit system configuration and rules files (/etc/audit/audit.rules, /etc/audit/auditd.conf, /etc/audit/rules.d/*). Adversaries with root access may tamper with these files to suppress audit logging, remove monitoring rules, or disable the audit daemon. This rule fires on the resulting file artifact rather than the command line, providing coverage that survives process-creation log gaps."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR or auditd file-watch telemetry normalised to UDM FILE_MODIFICATION or FILE_CREATION events. Auditd itself can generate these via -w /etc/audit/ -p wa rules; EDR agents (e.g. Falcon, SentinelOne, Elastic) emit equivalent UDM events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate auditd package upgrades (rpm/dpkg), authorised security-baseline automation (Ansible, Chef, Puppet), compliance tooling that rewrites audit rules on a schedule."
    tuning_guidance = "Add authorised configuration-management process paths (e.g. /usr/bin/ansible, /usr/bin/puppet) to %linux_allowed_audit_config_writers. Add known-good parent process paths for package managers (/usr/bin/rpm, /usr/bin/dpkg) to the same list."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target any file under the audit configuration hierarchy
    $file.target.file.full_path = /^\/etc\/audit\// nocase

    // Narrow to the specific high-value files: main rules file, daemon config,
    // and drop-in rules directory entries
    (
      $file.target.file.full_path = /\/etc\/audit\/audit\.rules$/ nocase or
      $file.target.file.full_path = /\/etc\/audit\/auditd\.conf$/ nocase or
      $file.target.file.full_path = /\/etc\/audit\/rules\.d\// nocase
    )

    // Exclude authorised configuration-management and package-manager processes
    not $file.principal.process.file.full_path in %linux_allowed_audit_config_writers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
