/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-26T17:43:32.118841+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Auditd_Config_Tamper_Then_Service_Stop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage Linux Audit system impairment: first a modification to an auditd configuration or rules file, followed within 10 minutes by a process launch that stops or disables the auditd service. Together these indicate an adversary attempting to blind the audit subsystem before or after making persistent configuration changes."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR or auditd file-integrity and process telemetry normalised into Chronicle UDM. FILE_MODIFICATION events must be generated for /etc/audit/ paths and PROCESS_LAUNCH events must capture systemctl/service invocations."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate system administrators rotating auditd rules and restarting the service during maintenance windows; configuration management tools such as Ansible, Puppet, or Chef applying baseline audit policies; OS package upgrades that update audit.rules and restart auditd."
    tuning_guidance = "Add authorised configuration-management process paths to %linux_allowed_audit_config_writers and authorised service-management process paths to %linux_allowed_service_managers. Consider scoping by principal.user.userid to exclude known admin accounts during change windows."

  events:
    // Stage 1: modification of an auditd configuration or rules file
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/etc\/audit\/(audit\.rules|audit\.conf|rules\.d\/.+\.rules|auditd\.conf)$/ nocase
    not $file.principal.process.file.full_path in %linux_allowed_audit_config_writers
    $file.principal.hostname = $hostname

    // Stage 2: a process launch that stops or disables the auditd service
    $svc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $svc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/systemctl$/ nocase
        and $svc.target.process.command_line = /(stop|disable|mask|kill)\s+audit/ nocase
      )
      or
      (
        $svc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/service$/ nocase
        and $svc.target.process.command_line = /auditd\s+(stop|disable)/ nocase
      )
      or
      (
        $svc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(kill|killall|pkill)$/ nocase
        and $svc.target.process.command_line = /auditd/ nocase
      )
    )
    not $svc.principal.process.file.full_path in %linux_allowed_service_managers
    $svc.principal.hostname = $hostname

    // Chronological ordering: config tamper must precede service stop
    $file.metadata.event_timestamp.seconds <= $svc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($hostname)
    $modified_audit_files = array_distinct($file.target.file.full_path)
    $service_stop_cmdline = array_distinct($svc.target.process.command_line)
    $acting_user = array_distinct($svc.principal.user.userid)
    $file_actor_process = array_distinct($file.principal.process.file.full_path)
    $svc_actor_process = array_distinct($svc.principal.process.file.full_path)

  condition:
    $file and $svc
}
