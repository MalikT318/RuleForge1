/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-26T17:42:53.976706+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_SecurityTool_UI_Spoof_RegistryThenProcess {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage UI-spoofing pattern: first, a registry modification that suppresses or disables Windows Security Center / Defender notification and status reporting keys, followed within 10 minutes by the launch of a process that renders a window or tray icon from an unexpected parent or path. Together these indicate an adversary has silenced the real security UI and is substituting a fake healthy-status interface to conceal tool impairment."
    mitre_tactic    = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires EDR or Sysmon registry-modification telemetry (Event ID 13) and process-launch telemetry (Event ID 1 / EDR equivalent). Both must be ingested and normalised to UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Group Policy refreshes that legitimately write Security Center keys; enterprise AV management consoles that update notification settings; Windows Update modifying Defender registry state; custom IT health-dashboard agents."
    tuning_guidance = "Add authorised management processes to %global_allowed_secui_writers. Add known IT dashboard executables to %global_allowed_tray_apps. Narrow the registry key regex if only specific sub-keys are relevant in your environment."

  events:
    // ── Leg 1: registry modification silencing Security Center / Defender UI ──
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target keys that control Security Center notifications, Defender UI,
    // and health-status reporting. Covers both HKLM policy paths and
    // per-user notification suppression.
    $reg.target.registry.registry_key = /\\(Windows Defender|WindowsDefender|SecurityCenter|Security Center|Windows Security|Notifications|DisableAntiSpyware|DisableRealtimeMonitoring|UILockdown|SpynetReporting|SubmitSamplesConsent|Notification_Suppress|HideWindowsSecurityNotificationArea)/ nocase

    // Exclude known-good management writers
    not $reg.principal.process.file.full_path in %global_allowed_secui_writers

    // Capture join key
    $reg.principal.hostname = $hostname

    // ── Leg 2: a process launches that presents a UI window / tray icon ──
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // The child process is NOT a recognised Windows Security binary.
    // Legitimate Windows Security UI lives under WindowsApps or System32.
    // We flag processes that claim to render a UI but live outside those paths.
    not $proc.target.process.file.full_path = /\\(Windows\\System32|Windows\\SysWOW64|WindowsApps|Program Files\\Windows Defender|Program Files \(x86\)\\Windows Defender)/ nocase

    // The command line or binary name mimics security / protection branding
    // without being the real binary — catches fake "Security Center" windows.
    $proc.target.process.command_line = /(security|defender|protect|antivirus|av.?guard|shield|firewall|endpoint|health|safe|tray)/ nocase

    // Exclude known-good tray / dashboard applications
    not $proc.target.process.file.full_path in %global_allowed_tray_apps

    // Join on the same host
    $proc.principal.hostname = $hostname

    // Chronological ordering: registry tamper must precede the fake UI launch
    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity    = array_distinct($hostname)
    $tampered_reg_keys = array_distinct($reg.target.registry.registry_key)
    $suspicious_process = array_distinct($proc.target.process.file.full_path)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $reg_writer_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg and $proc
}
