/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-26T17:42:27.167956+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Security_Tool_UI_Spoof_File_Artifact {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation or modification of security-tool configuration, status, or UI-facing files in locations used by Linux EDR agents, AV engines, and logging daemons. Adversaries who disable or degrade a security tool may write a replacement config or status file to make the tool appear healthy. This rule pivots on the resulting file artifact rather than the process command line, providing coverage that survives command-line log evasion."
    mitre_tactic    = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to Chronicle UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path and principal.process.file.full_path populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate security-tool upgrades or self-updates, configuration management tools (Ansible, Puppet, Chef), package manager post-install scripts (apt/yum/dnf), authorised admin reconfiguration of AV or EDR agents."
    tuning_guidance = "Add known-good updater or package-manager process paths to %linux_allowed_security_tool_writers. Narrow the file path regex if a specific product path generates noise. Consider raising severity to Critical if the writing process is not a recognised security-tool binary."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target: config, status, socket, or UI-facing files belonging to common
    // Linux security-tool families (AV, EDR, audit, SIEM forwarder, IDS).
    // Regex covers paths such as:
    //   /etc/ossec/ossec.conf, /var/ossec/queue/...
    //   /etc/auditd/auditd.conf, /etc/audit/audit.rules
    //   /etc/clamav/clamd.conf, /var/lib/clamav/...
    //   /etc/falco/falco.yaml, /etc/falco/rules.d/...
    //   /opt/<edr-agent>/conf/..., /opt/<edr-agent>/status/...
    //   /var/log/syslog, /var/log/auth.log (status-file spoofing)
    //   /etc/rsyslog.conf, /etc/rsyslog.d/...
    //   /etc/filebeat/filebeat.yml, /etc/metricbeat/...
    //   /etc/snort/snort.conf, /etc/suricata/suricata.yaml
    $file.target.file.full_path = /\/(etc|var|opt|usr\/local)\/(ossec|auditd?|audit|clamav|falco|rsyslog|syslog|filebeat|metricbeat|winlogbeat|snort|suricata|aide|tripwire|chkrootkit|rkhunter|lynis|crowdstrike|sentinelone|cylance|carbon.?black|elastic.?agent|elastic-agent|osquery|wazuh|sysdig)(\/[^\/]*)*\.(conf|yaml|yml|rules?|json|toml|ini|cfg|status|sock|pid|log)$/ nocase

    // Exclude writes by the security tool's own daemon/agent process to
    // avoid alerting on self-updates and routine log rotation.
    not $file.principal.process.file.full_path in %linux_allowed_security_tool_writers

    // Exclude package managers performing legitimate installs/upgrades.
    not $file.principal.process.file.full_path = /\/(usr\/bin\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper)|usr\/lib\/apt\/methods\/|var\/lib\/dpkg\/)/

    // Exclude root-owned configuration management agents.
    not $file.principal.process.file.full_path = /\/(usr\/bin\/(ansible|puppet|chef|salt)|opt\/(puppet|chef|salt)\/)/ nocase

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity    = array_distinct($file.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $modified_file     = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
