/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:29:22.594907+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_Junk_Data_C2_Obfuscation_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes on Linux that exhibit behavioral indicators of junk-data C2 obfuscation: a scripting interpreter or network utility making an outbound connection while passing unusually long or high-entropy-looking argument strings that are characteristic of encoded/padded C2 beacons. Targets the OS mechanism of using standard network tools with obfuscated payloads rather than named attacker tooling."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with full command-line capture (execve syscall arguments). auditd rule: -a always,exit -F arch=b64 -S execve."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate curl/wget commands with long URLs or base64-encoded POST bodies, package managers fetching signed payloads, backup agents, monitoring agents sending encoded metrics."
    tuning_guidance = "Add known-good parent processes to %global_allowed_admin_tools. Add approved script hosts to %global_allowed_script_hosts. Narrow the regex if specific encoding patterns are too broad for the environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target network-capable interpreters and utilities commonly abused for C2
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|php|curl|wget|nc|ncat|netcat|socat|openssl)$/ nocase

    // Command line contains patterns indicative of junk-padded or encoded C2 traffic:
    // Long base64-like blobs, repeated padding characters, or high-symbol-density strings
    // interleaved with meaningful content - characteristic of SUNBURST-style obfuscation.
    // Match any of: base64 blobs >40 chars, repeated junk padding (===, ---), or
    // hex-encoded strings mixed with printable junk.
    $proc.target.process.command_line = /([A-Za-z0-9+\/]{40,}={0,2}|[A-Fa-f0-9]{48,}|(-{4,}|={4,}|\.{4,})[A-Za-z0-9]{4,}(-{4,}|={4,}|\.{4,}))/ nocase

    // Must involve a network destination indicator in the command line
    // (URL, IP-like pattern, or hostname argument) to anchor to C2 context
    $proc.target.process.command_line = /(\bhttps?:\/\/|\b[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b|--data|--data-binary|-d\s+@?['\"]?[A-Za-z0-9+\/=]{20,})/

    // Exclude processes spawned from known-good administrative or security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_security_tools

    // Exclude processes running from standard package-manager or update paths
    not $proc.target.process.command_line = /\/(apt|yum|dnf|zypper|snap|flatpak)\s/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $suspicious_process = array_distinct($proc.target.process.file.full_path)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
