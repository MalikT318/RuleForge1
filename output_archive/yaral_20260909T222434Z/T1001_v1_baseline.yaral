/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:28:59.784464+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_ESXi_Obfuscated_C2_Network_Anomaly {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects potential obfuscated C2 traffic originating from ESXi infrastructure. Adversaries abusing ESXi hosts for C2 often use high-entropy payloads, non-standard ports, or protocol mismatches to hide communications. This rule flags outbound connections from ESXi address space to external destinations on uncommon ports or with anomalous byte ratios indicative of padding or steganographic obfuscation."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Requires firewall or perimeter flow logs with byte counts, port, and IP metadata normalised into UDM NETWORK_FLOW or NETWORK_CONNECTION events. Source IP must be attributable to ESXi management or VM network segments."
    platform        = "ESXi"
    log_source      = "firewall"
    false_positives = "ESXi vMotion traffic, storage replication, backup agents (Veeam, Commvault), NTP synchronisation, VMware update services, and authorised remote management tools may trigger this rule. Tune using %global_allowed_backup_processes and %global_allowed_remote_mgmt exclusions."
    tuning_guidance = "Add known-good ESXi management source IPs to %global_allowed_mgmt_sources. Add approved external update or telemetry domains to %global_allowed_domains. Raise the byte-ratio threshold or restrict to specific ESXi VLAN source ranges if false-positive volume is high."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Traffic must be outbound to an external (non-RFC1918) destination
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good management sources (ESXi hosts enrolled in approved mgmt)
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude approved external domains (update services, VMware telemetry, CDNs)
    not $net.target.domain.name in %global_allowed_domains

    // Flag connections on ports that are non-standard for ESXi legitimate outbound
    // traffic but commonly abused for obfuscated C2 (avoid well-known service ports)
    // Well-known ESXi outbound: 443 (vCenter), 902 (vMotion), 123 (NTP), 53 (DNS),
    // 80 (updates), 8080, 9000 (management APIs).
    // Flag anything outside those expected ranges on TCP/UDP.
    (
      $net.target.port > 1024 and
      $net.target.port != 1514 and   // syslog
      $net.target.port != 2049 and   // NFS
      $net.target.port != 3260 and   // iSCSI
      $net.target.port != 8080 and
      $net.target.port != 8443 and
      $net.target.port != 9000 and
      $net.target.port != 902  and
      $net.target.port != 903
    )

    // Detect asymmetric byte ratios: very large outbound vs minimal inbound
    // is a hallmark of data exfiltration or padded C2 beaconing.
    // sent_bytes >> received_bytes suggests one-way padded/obfuscated traffic.
    $net.network.sent_bytes > 50000
    $net.network.received_bytes < 1000

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)
    $bytes_sent        = max($net.network.sent_bytes)
    $bytes_received    = max($net.network.received_bytes)

  condition:
    $net
}
