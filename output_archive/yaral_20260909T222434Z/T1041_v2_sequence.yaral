/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:27:13.673356+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_002_C2_Exfil_Sustained_Outbound_Then_Large_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with exfiltration over a C2 channel on Linux hosts: an initial outbound connection to a non-internal destination is followed within 1 hour by a high-volume data transfer to the same external host on the same port. This two-stage pattern (beacon then bulk upload) is characteristic of C2 frameworks staging and exfiltrating data over the same channel."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to UDM NETWORK_CONNECTION and NETWORK_FLOW with bytes_sent populated. Both event types must be present for the correlation to fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate backup jobs sending large datasets to cloud storage, software update services, CDN-hosted content delivery, authorised data pipeline egress. Tune using %global_allowed_domains and %global_allowed_backup_processes."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add approved scanner source IPs to %global_allowed_scanners. Raise the bytes_sent threshold if backup or analytics workloads generate false positives. Consider narrowing to specific destination port ranges associated with C2 (e.g., 443, 80, 8080, 8443, 4444) if noise is high."

  events:
    // Stage 1: Initial outbound connection to an external destination (beacon / C2 check-in)
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    not $conn.target.ip in %rfc1918_internal
    not $conn.target.hostname in %global_allowed_domains
    not $conn.principal.ip in %global_allowed_scanners
    $conn.network.direction = "OUTBOUND"
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip
    $conn.target.port = $dst_port

    // Stage 2: Large outbound data transfer to the same external host and port within the window
    $flow.metadata.event_type = "NETWORK_FLOW"
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.hostname in %global_allowed_domains
    not $flow.principal.ip in %global_allowed_scanners
    $flow.network.direction = "OUTBOUND"
    // Threshold: more than 5 MB sent in a single flow record - tune as needed
    $flow.network.sent_bytes > 5242880
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip
    $flow.target.port = $dst_port

    // Enforce chronological ordering: connection observed before or at the time of the large flow
    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip, $dst_port over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($flow.target.ip)
    $destination_ports = array_distinct($flow.target.port)
    $destination_hostnames = array_distinct($flow.target.hostname)
    $total_bytes_sent = max($flow.network.sent_bytes)
    $connection_count = count($conn.metadata.id)

  condition:
    $conn and $flow
}
