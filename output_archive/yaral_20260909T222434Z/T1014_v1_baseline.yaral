/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:32:04.081866+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_Rootkit_Driver_Load_And_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects potential rootkit installation activity on Windows via suspicious kernel driver service creation or modification in the registry. Rootkits commonly register themselves as kernel-mode drivers under HKLM\\SYSTEM\\CurrentControlSet\\Services with a Start type of 1 (system) or 3 (demand) and a Type value of 1 (kernel driver). This rule targets the registry write that establishes the driver service entry, which is a fundamental OS mechanism required by Windows kernel rootkits."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry capturing writes to HKLM\\SYSTEM\\CurrentControlSet\\Services. Sysmon Event ID 13 (RegistryValueSet) or equivalent EDR registry events normalised to UDM REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party kernel drivers installed by security software, hardware vendors, virtualisation platforms (VMware, VirtualBox), or antivirus products. Software deployment and patching tools may also write to this key path."
    tuning_guidance = "Add known-good driver installer processes (e.g., vendor setup executables) to %global_allowed_admin_tools. Add authorised service accounts performing driver deployment to %global_allowed_service_accounts. Narrow the rule by requiring the writing process to be outside known system directories if false-positive volume is high."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Services registry hive where drivers register themselves
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\(CurrentControlSet|ControlSet[0-9]+)\\Services\\[^\\]+\\(ImagePath|Type|Start|ErrorControl)$/

    // The ImagePath value for kernel drivers typically points to a .sys file
    // OR the Type value is being set (Type=1 means kernel driver)
    // Match either an ImagePath pointing to a .sys file or a Type/Start value write
    (
      $reg.target.registry.registry_value_name = /(?i)^ImagePath$/
      and $reg.target.registry.registry_value_data = /(?i)\.sys(\s|$|")/
    )
    or
    $reg.target.registry.registry_value_name = /(?i)^Type$/

    // Exclude writes originating from known system processes performing legitimate driver management
    not $reg.principal.process.file.full_path = /(?i)\\(System32|SysWOW64)\\drvinst\.exe$/
    not $reg.principal.process.file.full_path = /(?i)\\(System32|SysWOW64)\\services\.exe$/
    not $reg.principal.process.file.full_path = /(?i)\\(System32|SysWOW64)\\msiexec\.exe$/
    not $reg.principal.process.file.full_path = /(?i)\\(System32|SysWOW64)\\svchost\.exe$/

    // Exclude approved administrative and security tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

    // Flag writes from suspicious locations - user-writable directories, temp paths, or non-standard paths
    $reg.principal.process.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData|Downloads|Desktop|Documents)|\\Temp\\|\\tmp\\|\\ProgramData\\(?!Microsoft)|\\Windows\\Temp)/

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
