/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:56:30.288670+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Container_Compute_Hijacking_API_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud audit events indicative of container compute hijacking for cryptomining: rapid or anomalous container/pod resource creation via exposed APIs, particularly from unexpected principals or with resource-intensive configurations. Targets the API-level signal of adversaries deploying containers at scale to hijack compute resources."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Requires cloud provider audit logs (e.g., CloudTrail, GCP Audit Logs, Azure Activity Logs) normalised into Chronicle UDM. Container/Kubernetes API server audit logging must be enabled. Events should include resource creation actions for container workloads."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines deploying containers at scale, autoscaling events triggered by load, infrastructure-as-code provisioning tools, authorised batch job frameworks."
    tuning_guidance = "Add known CI/CD service accounts and automation principals to %global_allowed_service_accounts. Add approved cloud principals to %global_allowed_cloud_principals. Narrow the resource_type regex to match only the container resource types relevant to the customer environment (pods, tasks, instances). Consider adding a threshold wrapper if single-event volume is high in busy clusters."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target container or pod resource types - normalised UDM resource type field
    $cloud.target.resource.resource_type = /(?i)(pod|container|task|job|workload|instance)/

    // Detect resource names or labels commonly associated with cryptomining deployments:
    // high-CPU resource requests, mining-related naming patterns, or privileged container flags.
    // We match on the resource name field for suspicious naming patterns associated with
    // mining workloads (e.g., xmr, miner, crypto, coin) OR privileged/host-network flags
    // embedded in resource attributes. This targets the OS mechanism: container API abuse.
    (
      $cloud.target.resource.name = /(?i)(miner|mining|xmr|monero|coin|crypto|hashrate|stratum)/ or
      $cloud.target.resource.attribute.labels.value = /(?i)(miner|mining|xmr|monero|coin|crypto|hashrate|stratum)/ or
      $cloud.target.resource.attribute.labels.key = /(?i)(miner|mining|xmr|monero|coin|crypto|hashrate)/
    )

    // Exclude known authorised automation and cloud principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known authorised admin users performing legitimate provisioning
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_name = array_distinct($cloud.target.resource.name)
    $resource_type = array_distinct($cloud.target.resource.resource_type)
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
