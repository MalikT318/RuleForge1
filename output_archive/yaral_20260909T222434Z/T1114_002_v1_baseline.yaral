/*
  MITRE Technique : T1114.002 - Remote Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:38:17.049596+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_002_Remote_Email_Collection_Mailbox_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects anomalous mailbox access patterns indicative of remote email collection, including access to another user's mailbox via delegated permissions or impersonation, and bulk email search operations consistent with tools like MailSniper. Targets M365 unified audit log events where a principal accesses mailbox resources they do not own."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.002"
    mitre_technique_name = "Email Collection: Remote Email Collection"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log ingestion with Exchange workload events enabled, including MailItemsAccessed, SearchQueryInitiated, and FolderBind operations."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Helpdesk staff with legitimate delegated mailbox access, legal/compliance eDiscovery searches, shared mailbox access by authorized service accounts, executive assistants with calendar/mail delegation."
    tuning_guidance = "Add authorized delegated-access service accounts to %global_allowed_service_accounts. Add authorized admin users performing eDiscovery to %global_allowed_admin_users. Consider narrowing by time-of-day if after-hours access is the primary concern."

  events:
    $auth.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource must be a mailbox or mail folder path
    $auth.target.resource.name = /(?i)(mail|inbox|sentitems|deleteditems|drafts|archive|recoverable|allitems|exchangeadmin)/

    // The accessing principal must differ from the mailbox owner,
    // indicating cross-mailbox or delegated/impersonation access
    $auth.principal.user.userid != $auth.target.user.userid

    // Principal must be a non-empty authenticated identity
    $auth.principal.user.userid != ""
    $auth.target.user.userid != ""

    // Exclude known authorized service and admin accounts
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1114.002")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $accessed_mailbox = array_distinct($auth.target.user.userid)
    $accessed_resource = array_distinct($auth.target.resource.name)
    $source_ip = array_distinct($auth.principal.ip)

  condition:
    $auth
}
