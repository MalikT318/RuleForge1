/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:40:34.661476+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_Process_Spawned_With_Stolen_Token {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process creation with a parent token that does not match the expected parent process, indicating token theft or impersonation. Focuses on privileged processes spawned from non-privileged parents or mismatched integrity levels."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires EDR process telemetry with parent-child lineage and user context."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Scheduled tasks running as SYSTEM, service control manager spawning services, RunAs operations by administrators, installer processes elevating child processes, RMM tools performing privileged operations."
    tuning_guidance = "Add approved parent processes to %global_allowed_admin_tools. Exclude known service accounts from %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    
    // Child process running as SYSTEM or high-privilege account
    (
      $proc.target.user.userid = /(?i)nt authority\\system/ or
      $proc.target.user.userid = /(?i)\\administrator$/
    )
    
    // Parent process running as lower-privileged user (not SYSTEM, not admin service account)
    not $proc.principal.user.userid = /(?i)nt authority\\system/
    not $proc.principal.user.userid in %global_allowed_service_accounts
    
    // Parent is not a known privileged spawner
    not $proc.principal.process.file.full_path = /(?i)\\windows\\system32\\services\.exe$/
    not $proc.principal.process.file.full_path = /(?i)\\windows\\system32\\svchost\.exe$/
    not $proc.principal.process.file.full_path = /(?i)\\windows\\system32\\taskeng\.exe$/
    not $proc.principal.process.file.full_path = /(?i)\\windows\\system32\\taskhostw\.exe$/
    not $proc.principal.process.file.full_path = /(?i)\\windows\\system32\\lsass\.exe$/
    not $proc.principal.process.file.full_path = /(?i)\\windows\\system32\\winlogon\.exe$/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    
    // Exclude legitimate elevation mechanisms
    not $proc.target.process.file.full_path = /(?i)\\windows\\system32\\consent\.exe$/
    not $proc.principal.process.file.full_path = /(?i)\\windows\\system32\\msiexec\.exe$/
    
    // Focus on interactive shells and scripting interpreters that indicate post-exploitation
    (
      $proc.target.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ or
      $proc.target.process.command_line = /(?i)(cmd|powershell|pwsh|wscript|cscript)\.exe/
    )

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
