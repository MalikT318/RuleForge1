/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:52:55.978571+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_Windows_Permission_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects use of built-in Windows permission-modification utilities (icacls, cacls, takeown, attrib) with arguments that grant broad access, remove ACL restrictions, or take ownership of files and directories. Adversaries abuse these tools to evade ACL-based defenses and access protected files."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate IT administration scripts granting permissions during software deployment, backup agents adjusting ACLs, and RMM tooling performing remediation tasks."
    tuning_guidance = "Add known-good parent processes (e.g., deployment orchestrators, backup agents) to %global_allowed_admin_tools or %global_allowed_backup_processes. Scope to sensitive directory paths if noise is high in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the four canonical Windows ACL/ownership utilities
    $proc.target.process.file.full_path = /\\(icacls|cacls|takeown|attrib)\.exe$/  nocase

    // Suspicious argument patterns across the four tools:
    // icacls/cacls: /grant, /grant:r, Everyone, BUILTIN\Users, *S-1-1-0 (Everyone SID)
    // takeown: /f (take ownership of a file/dir)
    // attrib: -r (remove read-only), -s (remove system), -h (remove hidden)
    (
      $proc.target.process.command_line = /\/grant/ nocase or
      $proc.target.process.command_line = /\/grant:r/ nocase or
      $proc.target.process.command_line = /everyone/  nocase or
      $proc.target.process.command_line = /\*S-1-1-0/ nocase or
      $proc.target.process.command_line = /\/f\s/ nocase or
      $proc.target.process.command_line = /\-r\b/ nocase or
      $proc.target.process.command_line = /\/reset/ nocase or
      $proc.target.process.command_line = /\/inheritance:r/ nocase
    )

    // Exclude approved administrative and backup tooling parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_executed = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
