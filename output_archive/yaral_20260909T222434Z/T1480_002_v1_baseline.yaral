/*
  MITRE Technique : T1480.002 - Mutual Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:54:22.358734+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_002_Linux_Mutex_File_Lock_Execution_Guard {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of mutex/lock files in world-writable or temporary directories commonly used by Linux malware as execution guards. Malware creates a lock file to prevent multiple instances from running simultaneously - a hallmark of T1480.002 Mutual Exclusion. Suspicious patterns include lock files created by non-package-manager processes in /tmp, /dev/shm, /var/run, or /var/lock with names matching common mutex naming conventions."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1480.002"
    mitre_technique_name = "Execution Guardrails: Mutual Exclusion"
    log_prerequisites = "Requires Linux EDR or auditd file creation telemetry (auditd -a always,exit -F arch=b64 -S open,creat,openat -F exit=-EEXIST or equivalent EDR file event)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate daemons and services creating PID or lock files in /var/run or /var/lock (e.g., sshd, cron, rsyslog). Package managers creating temporary lock files. Custom application lock files in /tmp."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the path regex to exclude /var/run/<known_service>.pid patterns. Consider adding a process name allowlist for well-known daemons."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target suspicious mutex/lock file locations used by Linux malware
    // /dev/shm is especially suspicious as it is an in-memory filesystem
    // /tmp and /var/tmp are world-writable and commonly abused
    // /var/lock and /var/run are legitimate but warrant scrutiny for unusual creators
    $file.target.file.full_path = /^(\/dev\/shm\/|\/tmp\/|\/var\/tmp\/|\/run\/lock\/|\/var\/lock\/|\/var\/run\/)/ nocase

    // Match file names that follow mutex/lock naming patterns:
    // - files ending in .lock, .lck, .pid, .mutex
    // - files with no extension that look like UUIDs or hex strings (common in malware)
    // - files with names that are purely numeric or alphanumeric hashes
    $file.target.file.full_path = /(\.(lock|lck|mutex|mux|pid|sock\.lock)$|\/\.[a-f0-9]{8,}$|\/[a-f0-9]{16,}$|\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/

    // Exclude well-known system daemons that legitimately create lock/pid files
    not $file.principal.process.file.full_path = /\/(sshd|crond|rsyslogd|systemd|journald|NetworkManager|dhclient|chronyd|ntpd|auditd|dbus-daemon|polkitd|packagekitd|rpm|dpkg|apt|yum|dnf|snapd|containerd|dockerd|kubelet)$/

    // Exclude processes from known-good tooling lists
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Require a principal process to be present (filter out kernel/udev noise)
    $file.principal.process.pid > 0

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1480.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $mutex_file_path = array_distinct($file.target.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
