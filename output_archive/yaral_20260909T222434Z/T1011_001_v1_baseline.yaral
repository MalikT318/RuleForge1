/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:31:38.867077+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_Bluetooth_Exfiltration_Process_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process activity consistent with Bluetooth data exfiltration on Windows. Monitors for processes interacting with Bluetooth APIs, the Windows Bluetooth stack, or known Bluetooth transfer utilities spawned from unusual parent processes. Adversaries may use Bluetooth as an out-of-band exfiltration channel to bypass network-based DLP controls."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Bluetooth"
    log_prerequisites = "Requires EDR process telemetry with command-line arguments and parent process visibility (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Bluetooth file transfer utilities used by IT support, Windows built-in Bluetooth pairing wizard (fsquirt.exe) invoked by users, mobile device management agents, and authorised peripheral management software."
    tuning_guidance = "Add known-good Bluetooth management parent processes to %global_allowed_admin_tools. Add authorised Bluetooth service accounts to %global_allowed_service_accounts. Narrow scope by restricting to sensitive asset hostnames if Bluetooth should be universally disabled in the environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target processes associated with Bluetooth file transfer or stack interaction on Windows:
    // fsquirt.exe  - Windows Bluetooth File Transfer Wizard (built-in OBEx push)
    // btvstack.exe - Bluetooth virtual stack process
    // btdropbox    - Bluetooth drop-box service helper
    // Any process invoking bthprops.cpl or the Bluetooth device enumeration COM interface
    // Also catch PowerShell/cmd invoking Bluetooth-related APIs or WMI Bluetooth classes
    (
      $proc.target.process.file.full_path = /(?i)\\fsquirt\.exe$/ or
      $proc.target.process.file.full_path = /(?i)\\btvstack\.exe$/ or
      $proc.target.process.file.full_path = /(?i)\\btdropbox\.exe$/ or
      $proc.target.process.command_line = /(?i)bthprops/ or
      $proc.target.process.command_line = /(?i)bluetooth/ or
      $proc.target.process.command_line = /(?i)Win32_PnPEntity.*bluetooth/ or
      $proc.target.process.command_line = /(?i)obex/ or
      $proc.target.process.command_line = /(?i)rfcomm/
    )

    // Raise fidelity: flag when spawned from scripting hosts, document readers,
    // or other unusual parents that have no legitimate reason to initiate Bluetooth transfers
    $proc.principal.process.file.full_path = /(?i)\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|winword|excel|powerpnt|outlook|python|pythonw|ruby|perl|node)\.exe$/

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $initiating_process = array_distinct($proc.principal.process.file.full_path)
    $bluetooth_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $username = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
