/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:49:16.033947+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_Port_Knock_Sequence_Followed_By_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects rapid sequential connection attempts to multiple closed ports from a single external source followed by successful connection, indicating potential port knocking or traffic signaling."
    mitre_tactic = "Defense Evasion, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Requires firewall or network perimeter logs with connection state tracking (allowed/denied)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vulnerability scanners, network mapping tools, misconfigured applications attempting multiple service ports, legitimate port scanning from authorized security testing."
    tuning_guidance = "Add authorized scanner sources to %global_allowed_scanners. Adjust threshold count if environment has high baseline scanning activity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    $net.target.port != 0
    (
      $net.security_result.summary = /(?i)(denied|blocked|rejected|dropped)/ or
      $net.security_result.action = "BLOCK" or
      $net.security_result.action = "DENY"
    )
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
