/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:51:38.998625+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_SyncAppvPublishingServer_PowerShell_Proxy {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects abuse of SyncAppvPublishingServer.vbs to proxy PowerShell command execution, bypassing execution policy and defensive controls. Adversaries invoke wscript.exe with SyncAppvPublishingServer.vbs and embed PowerShell commands in the argument string using the 'n;' separator pattern."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture normalised to UDM PROCESS_LAUNCH."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate App-V publishing server synchronisation initiated by SCCM/Intune management agents or App-V client infrastructure. Genuine invocations do not embed PowerShell command blocks in the script argument."
    tuning_guidance = "Add known App-V management hosts to %global_allowed_admin_tools and known service accounts to %global_allowed_service_accounts. Narrow the PowerShell payload regex if the environment uses App-V legitimately."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // wscript.exe is the canonical launcher for this LOLBin technique
    $proc.target.process.file.full_path = /(?i)\\wscript\.exe$/

    // The script must reference SyncAppvPublishingServer.vbs
    $proc.target.process.command_line = /(?i)SyncAppvPublishingServer\.vbs/

    // Adversary pattern: argument contains embedded PowerShell after 'n;' separator
    // Matches patterns like: "n; Invoke-Expression ...", "n; IEX ...", "n; &{...}", etc.
    $proc.target.process.command_line = /(?i)n\s*;.{0,512}(Invoke-Expression|IEX|Invoke-Command|Start-Process|DownloadString|DownloadFile|Net\.WebClient|FromBase64String|EncodedCommand|bypass|hidden|noprofile|scriptblock|powershell)/

    // Exclude known legitimate App-V management tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service accounts performing legitimate App-V sync
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_user     = array_distinct($proc.principal.user.userid)
    $command_line      = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
