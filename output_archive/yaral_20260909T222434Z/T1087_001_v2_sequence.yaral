/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:24:51.107059+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_Linux_Passwd_Read_Then_Outbound_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process reading /etc/passwd (local account enumeration) followed by an outbound network connection from the same host within 10 minutes. This sequence is indicative of local account discovery followed by potential data exfiltration or C2 callback, and provides additive coverage beyond simple command-line detection."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "Requires Linux EDR or auditd telemetry producing FILE_READ events for /etc/passwd and NETWORK_CONNECTION events. Auditd rules must include -w /etc/passwd -p r to capture file reads."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "System management tools (e.g., PAM, SSSD, NSS), backup agents, monitoring daemons, and user-space authentication libraries legitimately read /etc/passwd. Outbound connections from authorised admin tools may also trigger this rule."
    tuning_guidance = "Add known-good processes (backup agents, monitoring daemons, PAM-related binaries) to %global_allowed_backup_processes or %global_allowed_security_tools. Add authorised admin hosts to %global_allowed_mgmt_sources. Exclude service accounts via %global_allowed_service_accounts."

  events:
    // Event 1: Process reads /etc/passwd (local account enumeration)
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/etc\/passwd$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Event 2: Outbound network connection from the same host
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 0
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    // Chronological ordering: file read must precede network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $reading_user = array_distinct($file.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connecting_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $file and $net
}
