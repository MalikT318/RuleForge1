/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:38:34.029100+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_Email_Forwarding_Rule_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of an email forwarding rule in Microsoft 365 mailboxes. Adversaries with valid credentials create inbox forwarding rules to silently exfiltrate email to external or attacker-controlled addresses, and to maintain persistent access to communications even after credential resets."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log ingestion with Exchange Online mailbox auditing enabled. Operations: New-InboxRule, Set-InboxRule, UpdateInboxRules, Set-Mailbox (ForwardingSmtpAddress / ForwardingAddress / DeliverToMailboxAndForward)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate users configuring personal forwarding to approved secondary mailboxes, IT administrators setting up shared mailbox forwarding, CRM or ticketing system integrations that auto-forward support email."
    tuning_guidance = "Add known service accounts that legitimately configure forwarding to %global_allowed_service_accounts. Add known administrator accounts that manage mailbox routing to %global_allowed_admin_users. Consider scoping to external-only forwarding by filtering target addresses outside the organisation domain."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Match Exchange Online inbox rule and mailbox forwarding operations
    // New-InboxRule, Set-InboxRule, UpdateInboxRules cover client-side and
    // PowerShell-based rule creation; Set-Mailbox covers transport-level forwarding
    $cloud.metadata.product_event_type = /(?i)(new-inboxrule|set-inboxrule|updateinboxrules|set-mailbox)/

    // The rule must involve a forwarding action - ForwardTo, RedirectTo,
    // ForwardAsAttachmentTo, ForwardingSmtpAddress, ForwardingAddress,
    // or DeliverToMailboxAndForward are the canonical M365 forwarding parameters
    $cloud.target.resource.attribute.labels["parameters"] = /(?i)(forwardto|redirectto|forwardasattachmentto|forwardingsmtpaddress|forwardingaddress|delivertomailboxandforward)/

    // Exclude approved service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $forwarding_target = array_distinct($cloud.target.resource.attribute.labels["parameters"])
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
