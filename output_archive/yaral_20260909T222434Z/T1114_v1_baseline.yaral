/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:37:51.064889+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Linux_Email_Collection_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes accessing local mail spool files, Maildir directories, or mail client storage on Linux, which is a primary behavioral signal for email collection. Adversaries read or copy mail data from /var/mail, /var/spool/mail, Maildir structures, or mail client profile directories to exfiltrate sensitive communications."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires Linux EDR or auditd file-open/read telemetry (auditd -a always,exit -F arch=b64 -S open,openat,read -F dir=/var/mail recommended). PROCESS_LAUNCH events capturing command-line access to mail paths are also sufficient."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate mail delivery agents (postfix, sendmail, dovecot), mail client applications reading their own spool, backup agents, log aggregation tools, and system administrators performing authorized mail audits."
    tuning_guidance = "Add known mail server daemon process paths (e.g. /usr/lib/postfix, /usr/sbin/dovecot) to %global_allowed_backup_processes. Add authorized admin accounts to %global_allowed_admin_users. Narrow scope by correlating with unusual parent processes or off-hours activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target commands that read, copy, archive, or search mail storage locations
    // Match tools commonly used to collect email data from the command line
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin)\/(cat|cp|mv|tar|zip|gzip|find|grep|rsync|scp|curl|wget|python[23]?|perl|ruby|bash|sh|zsh|dash|awk|sed|strings|less|more|head|tail|xargs|dd)$/ nocase

    // Command line must reference mail storage paths
    (
      $proc.target.process.command_line = /\/var\/(mail|spool\/mail)/ nocase or
      $proc.target.process.command_line = /[Mm]aildir/ nocase or
      $proc.target.process.command_line = /\.thunderbird/ nocase or
      $proc.target.process.command_line = /\.evolution/ nocase or
      $proc.target.process.command_line = /\.local\/share\/evolution/ nocase or
      $proc.target.process.command_line = /\.config\/evolution/ nocase or
      $proc.target.process.command_line = /\.icedove/ nocase or
      $proc.target.process.command_line = /\/home\/[^\/]+\/[Mm]ail\// nocase or
      $proc.target.process.command_line = /\.mbox$/ nocase or
      $proc.target.process.command_line = /\.mbx$/ nocase or
      $proc.target.process.command_line = /mbox/ nocase
    )

    // Exclude known legitimate mail infrastructure processes as parents
    not $proc.principal.process.file.full_path = /\/(postfix|sendmail|dovecot|exim|procmail|fetchmail|mutt|neomutt|alpine|pine)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
