/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:46:09.703291+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_Browser_Process_Injection_Via_Handle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process injection into browser processes via handle opening with suspicious access rights, indicating potential browser session hijacking."
    mitre_tactic = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires EDR process telemetry with handle/injection events or Sysmon Event ID 10."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tools (EDR/AV agents), debugging tools, browser extensions with native messaging hosts, RMM software, password managers with browser integration."
    tuning_guidance = "Add approved security tooling and browser helper processes to %global_allowed_security_tools. Exclude known debugging sessions from authorized development hosts."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"
    $proc.target.process.file.full_path = /\\(chrome|firefox|msedge|iexplore|opera|brave)\.exe$/ nocase
    (
      $proc.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase or
      $proc.principal.process.file.full_path = /\\(python|ruby|perl|java)\.exe$/ nocase or
      $proc.principal.process.file.full_path = /\\temp\\/ nocase or
      $proc.principal.process.file.full_path = /\\appdata\\local\\temp\\/ nocase or
      $proc.principal.process.file.full_path = /\\programdata\\/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
