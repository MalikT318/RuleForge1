/*
  MITRE Technique : T1480.001 - Environmental Keying
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:53:59.256948+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Environmental_Keying_Recon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process command lines consistent with environmental keying reconnaissance - where malware or a dropper enumerates host-specific values (domain membership, IP configuration, volume serial numbers, installed software, system UUID) that are commonly used as inputs to derive cryptographic keys for payload decryption. A single process querying multiple such environmental anchors in one command line is a strong indicator of guardrail logic."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1480.001"
    mitre_technique_name = "Execution Guardrails: Environmental Keying"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with full command-line capture (Event ID 4688 with command-line auditing enabled, or Sysmon Event ID 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate inventory scripts, asset management agents, SCCM/Intune compliance checks, and IT automation tools that enumerate system properties. Security tooling performing host fingerprinting may also trigger."
    tuning_guidance = "Add known asset-management and inventory parent process paths to %global_allowed_admin_tools. Add authorised script-execution hosts to %global_allowed_script_hosts. Narrow by requiring an unusual parent process (e.g. browser, Office app) if false-positive rate is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting and query engines commonly abused for environmental keying recon
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|cmd)\.exe$/ nocase

    // Command line must reference at least one environmental anchor used for key derivation:
    // - Domain/AD membership (userdomain, computername, LDAP queries)
    // - Volume serial number (a classic cryptographic anchor)
    // - Network configuration (IP address, MAC, adapter info)
    // - System UUID / BIOS serial (WMI-based hardware fingerprinting)
    // - Installed software enumeration (registry uninstall keys)
    // Using alternation to catch any single strong indicator in the command line
    $proc.target.process.command_line = /(?i)(VolumeSerialNumber|SerialNumber|UUID|MachineGuid|Win32_ComputerSystemProduct|Win32_BIOS|Win32_NetworkAdapterConfiguration|ipconfig|GetAdaptersInfo|USERDNSDOMAIN|UserDomain|DnsHostName|Win32_ComputerSystem|HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion|Get\-WmiObject|gwmi|Get\-CimInstance|gcim)/ nocase

    // Additionally require a second environmental anchor OR a crypto/encoding indicator
    // to reduce noise - environmental keying combines enumeration WITH crypto operations
    $proc.target.process.command_line = /(?i)(FromBase64String|ToBase64String|Convert\.From|AES|SHA256|SHA1|MD5|CryptoStream|RijndaelManaged|SymmetricAlgorithm|ICryptoTransform|certutil|[Cc]onvert|Decrypt|Encrypt|DeriveByte|PBKDF2|Rfc2898|PasswordDeriveBytes|CreateDecryptor|CreateEncryptor)/ nocase

    // Exclude known-good administrative and security tooling parents
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1480.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
