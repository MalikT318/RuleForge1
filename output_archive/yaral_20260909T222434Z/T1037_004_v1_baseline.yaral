/*
  MITRE Technique : T1037.004 - RC Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:34:07.457326+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_004_RC_Script_Persistence_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of RC script files (rc.local, rc.common, local.sh, etc.) on network devices via management-plane configuration change events. Adversaries modify these startup scripts to achieve persistence across reboots, executing arbitrary commands as root. This is especially relevant for lightweight Unix-like network devices, IoT, and ESXi hypervisors where RC scripts are one of the few persistent storage mechanisms."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.004"
    mitre_technique_name = "Boot or Logon Initialization Scripts: RC Scripts"
    log_prerequisites = "Requires network device management-plane syslog or configuration audit logs normalised to UDM SETTING_MODIFICATION. The log source must capture the configuration path or object name being modified (target.resource.name or target.file.full_path)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network administrators performing scheduled maintenance, firmware upgrades that touch startup scripts, or automated configuration management systems (Ansible, NAPALM, Terraform) applying approved changes."
    tuning_guidance = "Add authorised administrator accounts to %global_allowed_admin_users and approved management source addresses to %global_allowed_mgmt_sources. Scope the match window and threshold if the environment generates high-volume config audit events."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Match RC script paths commonly targeted on network devices, ESXi, and
    // Unix-like embedded systems. Covers rc.local, rc.common, local.sh,
    // rc.d/* variants, and ESXi-specific /etc/rc.local.d/local.sh.
    // nocase handles mixed-case syslog representations.
    (
      $cfg.target.resource.name = /rc\.local/ nocase or
      $cfg.target.resource.name = /rc\.common/ nocase or
      $cfg.target.resource.name = /rc\.local\.d/ nocase or
      $cfg.target.resource.name = /local\.sh/ nocase or
      $cfg.target.resource.name = /\/etc\/rc/ nocase or
      $cfg.target.resource.name = /\/etc\/init\.d/ nocase or
      $cfg.target.file.full_path = /rc\.local/ nocase or
      $cfg.target.file.full_path = /rc\.common/ nocase or
      $cfg.target.file.full_path = /rc\.local\.d/ nocase or
      $cfg.target.file.full_path = /local\.sh/ nocase or
      $cfg.target.file.full_path = /\/etc\/rc/ nocase or
      $cfg.target.file.full_path = /\/etc\/init\.d/ nocase
    )

    // Exclude approved administrators expected to modify startup configuration
    not $cfg.principal.user.userid in %global_allowed_admin_users

    // Exclude changes originating from approved management infrastructure
    not $cfg.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.004")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $modified_resource = array_distinct($cfg.target.resource.name)
    $actor_user = array_distinct($cfg.principal.user.userid)
    $source_ip = array_distinct($cfg.principal.ip)

  condition:
    $cfg
}
