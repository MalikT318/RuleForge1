/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:49:03.509505+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_Indirect_Command_Execution_Via_LOLBin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects abuse of Windows utilities for indirect command execution to bypass security controls. Targets forfiles, pcalua, scriptrunner, and other LOLBins executing commands or scripts."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires EDR process telemetry or Windows Event 4688 with command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative scripts using forfiles for batch operations, software installers invoking pcalua for compatibility, authorized automation using scriptrunner."
    tuning_guidance = "Add approved parent processes to %global_allowed_admin_tools. Exclude known-good script paths from %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\forfiles\.exe$/ nocase
        (
          $proc.target.process.command_line = /\/c\s+(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)/ nocase
          or $proc.target.process.command_line = /\/c\s+.*\.(bat|cmd|ps1|vbs|js|wsf|hta)/ nocase
        )
      )
      or (
        $proc.target.process.file.full_path = /\\pcalua\.exe$/ nocase
        (
          $proc.target.process.command_line = /-a\s+(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32)/ nocase
          or $proc.target.process.command_line = /-a\s+.*\.(bat|cmd|ps1|vbs|js|exe|dll)/ nocase
        )
      )
      or (
        $proc.target.process.file.full_path = /\\scriptrunner\.exe$/ nocase
        $proc.target.process.command_line = /-appvscript/ nocase
      )
      or (
        $proc.target.process.file.full_path = /\\ssh\.exe$/ nocase
        (
          $proc.target.process.command_line = /(?i)-o\s+proxycommand=/
          or $proc.target.process.command_line = /(?i)-o\s+localcommand=/
        )
      )
      or (
        $proc.target.process.file.full_path = /\\wsl\.exe$/ nocase
        (
          $proc.target.process.command_line = /-e\s+(bash|sh|python|perl|nc|netcat)/ nocase
          or $proc.target.process.command_line = /--exec\s+(bash|sh|python|perl|nc|netcat)/ nocase
        )
      )
      or (
        $proc.target.process.file.full_path = /\\bash\.exe$/ nocase
        $proc.target.process.command_line = /-c\s+(curl|wget|nc|netcat|python|perl)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
