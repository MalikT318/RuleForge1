/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:47:06.463156+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Suspicious_Package_Manager_Post_Install_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a package manager (pip, npm, gem, cargo, composer) spawning a shell or interpreter as a child process, which is the primary behavioral signal of a malicious post-install or lifecycle script executing during dependency installation. Compromised or typosquatted packages commonly abuse setup.py, package.json scripts, or gemspec hooks to run arbitrary code at install time."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with parent-child process lineage (principal = parent, target = child). Auditd execve syscall events or EDR PROCESS_LAUNCH events with ppid resolution are required."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate packages with build steps that invoke compilers or interpreters (e.g., native extension compilation via gcc, node-gyp). CI/CD pipeline runners executing install steps as part of automated builds. Developer workstations running trusted packages with post-install scripts."
    tuning_guidance = "Add known CI/CD runner hostnames or service accounts to %global_allowed_service_accounts. Add approved build orchestration parent processes to %global_allowed_admin_tools. Narrow scope by excluding known-good package names if your EDR captures command-line arguments. Consider raising severity if the child process immediately attempts network activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent must be a package manager process
    $proc.principal.process.file.full_path = /\/(pip[23]?|pip|npm|node|gem|cargo|composer|yarn|pnpm|poetry|pipenv|conda|easy_install)$/ nocase

    // Child process is a shell, interpreter, or common post-exploit utility
    // Targeting the combination of package-manager parent + shell/interpreter child
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash|python[23]?|python|perl[0-9.]*|perl|ruby|node|lua[0-9.]*|lua|tclsh|expect|curl|wget|nc|ncat|netcat|socat|awk|gawk|mawk|xargs)$/

    // Exclude cases where the child is simply another package manager tool
    // (e.g., pip calling python -m pip internally is expected)
    not $proc.target.process.command_line = /\-m\s+(pip|ensurepip|venv|virtualenv|site)/ nocase

    // Exclude known-good CI/CD service accounts and automation principals
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved build and admin tooling parent chains
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude hosts designated as approved script execution environments
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
