/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:39:13.061938+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_001_Peripheral_Device_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Low"
    description     = "Detects process execution patterns consistent with peripheral device discovery on Windows. Adversaries enumerate attached devices (USB, printers, cameras, smart card readers) using built-in Windows utilities such as wmic, pnputil, devcon, Get-PnpDevice, or by querying the device registry hive. This rule targets the process-launch signal for those enumeration commands."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with command-line capture enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "IT asset inventory tools, hardware auditing scripts, printer management software, driver deployment pipelines, and helpdesk remote-support sessions routinely enumerate peripheral devices."
    tuning_guidance = "Add known asset-management or IT tooling parent processes to %global_allowed_admin_tools. Add authorised service accounts that run scheduled hardware audits to %global_allowed_service_accounts. Scope by principal.hostname to high-value targets if noise is excessive."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the set of Windows built-in and common utilities used for peripheral enumeration.
    // wmic path Win32_PnPEntity / Win32_USBHub / Win32_Printer etc.
    // pnputil /enum-devices
    // Get-PnpDevice (PowerShell)
    // fsutil fsinfo drives (removable storage)
    // dxdiag (device diagnostics)
    // devmgmt.msc / mmc launching device manager
    (
      (
        $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /Win32_PnP/ nocase
          or $proc.target.process.command_line = /Win32_USB/ nocase
          or $proc.target.process.command_line = /Win32_Printer/ nocase
          or $proc.target.process.command_line = /Win32_SerialPort/ nocase
          or $proc.target.process.command_line = /Win32_SoundDevice/ nocase
          or $proc.target.process.command_line = /Win32_DiskDrive/ nocase
          or $proc.target.process.command_line = /Win32_PointingDevice/ nocase
          or $proc.target.process.command_line = /Win32_Keyboard/ nocase
          or $proc.target.process.command_line = /Win32_VideoController/ nocase
        )
      )
      or
      (
        $proc.target.process.file.full_path = /\\pnputil\.exe$/ nocase
        and $proc.target.process.command_line = /enum-devices/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /Get-PnpDevice/ nocase
          or $proc.target.process.command_line = /Get-WmiObject.*Win32_PnP/ nocase
          or $proc.target.process.command_line = /Get-CimInstance.*Win32_PnP/ nocase
          or $proc.target.process.command_line = /Get-WmiObject.*Win32_USB/ nocase
          or $proc.target.process.command_line = /Get-CimInstance.*Win32_USB/ nocase
          or $proc.target.process.command_line = /Get-WmiObject.*Win32_Printer/ nocase
          or $proc.target.process.command_line = /Get-CimInstance.*Win32_Printer/ nocase
          or $proc.target.process.command_line = /Get-WmiObject.*Win32_DiskDrive/ nocase
          or $proc.target.process.command_line = /Get-CimInstance.*Win32_DiskDrive/ nocase
        )
      )
      or
      (
        $proc.target.process.file.full_path = /\\fsutil\.exe$/ nocase
        and $proc.target.process.command_line = /fsinfo\s+drives/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\dxdiag\.exe$/ nocase
        and $proc.target.process.command_line = /\/t\s+/ nocase
      )
    )

    // Exclude known administrative and IT tooling parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score       = max(35)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity   = array_distinct($proc.principal.hostname)
    $triggered_process = array_distinct($proc.target.process.file.full_path)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process   = array_distinct($proc.principal.process.file.full_path)
    $acting_user      = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
