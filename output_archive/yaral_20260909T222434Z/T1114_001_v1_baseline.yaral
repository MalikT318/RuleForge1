/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:38:02.548627+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Local_Outlook_Data_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects non-Outlook processes accessing local Outlook data files (.ost/.pst), indicating potential email collection activity."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires EDR file access telemetry or Windows Security event log 4663."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup software, eDiscovery tools, PST migration utilities, email archiving solutions, antivirus scans."
    tuning_guidance = "Add approved backup and archiving processes to %global_allowed_backup_processes."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\AppData\\Local\\Microsoft\\Outlook\\.*\.(ost|pst)$/ nocase or
    $file.target.file.full_path = /\\Documents\\Outlook Files\\.*\.(pst|ost)$/ nocase
    not $file.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\scanpst\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\scanost\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
