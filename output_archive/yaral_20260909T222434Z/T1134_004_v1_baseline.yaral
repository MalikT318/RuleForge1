/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:42:14.086606+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_PPID_Spoofing_Suspicious_Lineage {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process launches where the reported parent process is an implausible or high-value spoofing target (explorer.exe, lsass.exe, winlogon.exe, services.exe) but the grandparent or calling context is inconsistent with legitimate Windows behaviour. PPID spoofing abuses CreateProcess with an explicit PPID handle to make a malicious child appear to originate from a trusted parent, bypassing parent-child lineage detections. This rule targets the most common spoofing pattern: a scripting engine, document renderer, or shell spawning with a forged high-trust parent."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry that populates both principal.process (true calling process) and target.process (new process), including full image paths and command lines. Sysmon Event ID 1 or equivalent EDR PROCESS_LAUNCH events with parent image populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "UAC elevation via consent.exe or svchost.exe legitimately re-parents processes. Some RMM and deployment tools (e.g., SCCM, Intune management agent) spawn processes with an explicit parent handle. Automated test frameworks (e.g., Atomic Red Team) will trigger this rule intentionally."
    tuning_guidance = "Add known-good parent binaries used by RMM or deployment tooling to %global_allowed_admin_tools. Add service accounts that legitimately perform this action to %global_allowed_service_accounts. Narrow the target process list if specific interpreters generate excessive noise in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // The newly launched process is a high-value attacker target:
    // scripting engines, shells, and LOLBins commonly used post-PPID-spoof.
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|certutil|bitsadmin|installutil)\.exe$/ nocase

    // The reported parent (principal.process) is a high-trust Windows process
    // that adversaries commonly spoof to blend in. Legitimate spawning from
    // these parents for the child processes above is rare or follows strict
    // patterns that the additional filters below break.
    $proc.principal.process.file.full_path = /\\(explorer|lsass|winlogon|services|svchost|csrss|smss|wininit|taskhost|taskhostw|sihost|userinit)\.exe$/ nocase

    // Exclude the grandparent being a known Windows system path that would
    // indicate a legitimate UAC or service-manager re-parenting chain.
    // When PPID spoofing occurs the true caller is often a document renderer,
    // macro host, or attacker binary - NOT a system binary in System32.
    not $proc.principal.process.file.full_path = /\\Windows\\System32\\svchost\.exe$/ nocase

    // Exclude consent.exe-mediated UAC elevation (legitimate re-parenting).
    not $proc.principal.process.file.full_path = /\\Windows\\System32\\consent\.exe$/ nocase

    // Exclude approved administrative and RMM tooling acting as the true caller.
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved service accounts performing legitimate automation.
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved script hosts (e.g., sanctioned automation servers).
    not $proc.principal.hostname in %global_allowed_script_hosts

    // Narrow signal: the child command line contains indicators of
    // post-exploitation activity (encoded commands, download cradles, reflective
    // loading) which are not expected from a legitimately re-parented process.
    $proc.target.process.command_line = /(-enc|-encodedcommand|-e\s+[A-Za-z0-9+\/]{20,}|downloadstring|iex|invoke-expression|frombase64|webclient|http|\\\\[^\\]+\\[a-z\$]+\$|reflection\.assembly|loadfile|bypass|-nop|-noprofile|-windowstyle\s+hid)/  nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $spoofed_parent = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
