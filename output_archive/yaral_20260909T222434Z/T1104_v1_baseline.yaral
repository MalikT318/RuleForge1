/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:37:30.695415+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_MultiStage_C2_Dropper_Spawns_Shell {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a multi-stage C2 pattern where a non-interactive or unusual parent process (loader/first-stage RAT) spawns a command interpreter or scripting host. This is the canonical hand-off from a first-stage beacon to a second-stage interactive shell or RAT stager. The rule targets the process-lineage signal: a parent that is not a known shell or user-facing application launching cmd, powershell, pwsh, wscript, cscript, or mshta."
    mitre_tactic         = "Command and Control"
    mitre_technique      = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites    = "Requires EDR process telemetry with parent-child process lineage (command line and full path for both parent and child). Sysmon Event ID 1 or equivalent EDR PROCESS_LAUNCH events."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Software update agents, RMM tools, deployment pipelines, and monitoring agents that legitimately spawn shells. Tune by adding known-good parent process paths to %global_allowed_admin_tools or %global_allowed_remote_mgmt."
    tuning_guidance      = "Add legitimate parent process full paths (e.g., RMM agents, patch management binaries) to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Consider narrowing by also requiring the child command line to contain download, encoded, or IEX patterns for higher fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child is a shell, scripting host, or HTML application host - classic second-stage delivery vehicles
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|wmic)\.exe$/ nocase

    // Parent is NOT a known interactive shell or user-facing launcher
    // Exclude explorer, Office apps, and known shells that legitimately spawn these children
    not $proc.principal.process.file.full_path = /\\(explorer|cmd|powershell|pwsh|conhost|bash|wt)\.exe$/ nocase

    // Parent is NOT a known browser (browsers legitimately spawn helpers)
    not $proc.principal.process.file.full_path = /\\(chrome|firefox|msedge|iexplore|opera|brave)\.exe$/ nocase

    // Parent is NOT a known Office application (covered by separate Office macro rules)
    not $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub)\.exe$/ nocase

    // Parent must be a real executable (not empty / system idle)
    $proc.principal.process.file.full_path != ""

    // Parent is NOT a Windows system management binary that legitimately spawns shells
    not $proc.principal.process.file.full_path = /\\(msiexec|setup|install|unins|update|patch|svchost|services|lsass|csrss|smss|wininit|winlogon|taskhostw|sihost|userinit|RuntimeBroker)\.exe$/ nocase

    // Exclude approved administrative and remote management tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

    // Exclude approved service accounts driving automation
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $child_process     = array_distinct($proc.target.process.file.full_path)
    $child_cmdline     = array_distinct($proc.target.process.command_line)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
