/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:33:02.327133+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_001_Chunked_Exfil_Size_Limits {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects a pattern consistent with T1030 Data Transfer Size Limits: a single outbound network flow to an external destination carries a small but non-trivial byte count that falls within a narrow band typical of deliberate chunking (e.g. 1 KB – 512 KB per session). Adversaries split exfiltrated data into fixed-size chunks to stay below volume-based alerting thresholds. The rule fires on flows where the sent bytes are suspiciously uniform and the destination is outside RFC-1918 space. Tune the byte-range thresholds and destination exclusions for each client environment."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites = "Requires per-flow byte-count telemetry from a firewall or perimeter device normalised into Chronicle UDM NETWORK_FLOW events. Fields network.sent_bytes and network.received_bytes must be populated."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Streaming media clients, software update agents, CDN health-check beacons, IoT telemetry, and any application that legitimately sends fixed-size payloads. Allowlist known-good destinations in %global_allowed_domains and approved scanner sources in %global_allowed_scanners."
    tuning_guidance = "Adjust the sent_bytes lower bound (currently 1024) and upper bound (currently 524288) to match the noise floor observed in each client environment. Add high-volume trusted destinations to %global_allowed_domains. Raise severity to High if the destination port is non-standard (not 80/443/22)."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Outbound flow only - source must be internal, destination external
    $net.principal.ip != ""
    $net.target.ip != ""

    // Exclude internal-to-internal traffic using the RFC-1918 reference list
    not $net.principal.ip in %rfc1918_internal
    // Exclude flows to known-good external destinations
    not $net.target.domain.name in %global_allowed_domains
    // Exclude authorised scanner sources
    not $net.principal.ip in %global_allowed_scanners

    // Byte range consistent with deliberate chunking:
    // Lower bound: 1 KB  (avoids noise from keepalives / empty ACKs)
    // Upper bound: 512 KB (above this, bulk transfer alerts should fire instead)
    $net.network.sent_bytes >= 1024
    $net.network.sent_bytes <= 524288

    // Ratio guard: sent >> received suggests one-way push (exfil), not a download
    // received_bytes must be populated; allow up to 10 % of sent as response overhead
    $net.network.received_bytes >= 0
    $net.network.sent_bytes > $net.network.received_bytes

    // Exclude well-known management and backup processes by destination port
    // (port 0 means the field is absent; skip those flows)
    $net.target.port > 0

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)
    $bytes_received = max($net.network.received_bytes)
    $destination_domain = array_distinct($net.target.domain.name)

  condition:
    $net
}
