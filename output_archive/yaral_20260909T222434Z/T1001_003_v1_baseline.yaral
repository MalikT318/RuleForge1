/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:30:00.902758+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_Protocol_Service_Impersonation_Suspicious_TLS_HTTP_Masquerade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes that impersonate legitimate protocols or web services for C2 communication. Focuses on non-browser, non-system processes initiating outbound connections on well-known TLS/HTTP ports (443, 80, 8443, 8080) with command-line arguments or parent process lineage indicative of protocol impersonation - e.g. scripting hosts, LOLBins, or unusual binaries connecting on HTTPS/HTTP ports while masquerading as trusted services."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry with process context (event type NETWORK_CONNECTION with principal.process populated). Sysmon Event ID 3 or equivalent EDR network telemetry."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate scripting automation that calls web APIs (e.g. PowerShell update scripts, monitoring agents). Tuning via %global_allowed_admin_tools and %global_allowed_script_hosts is strongly recommended."
    tuning_guidance = "Add known-good parent processes and script hosts to %global_allowed_script_hosts. Add approved admin tooling to %global_allowed_admin_tools. Add known-good external domains to %global_allowed_domains. Consider narrowing to specific unusual parent-child combinations observed in your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target well-known protocol ports commonly impersonated for C2
    (
      $net.target.port = 443 or
      $net.target.port = 80  or
      $net.target.port = 8443 or
      $net.target.port = 8080
    )

    // Exclude internal/loopback destinations - impersonation targets external infra
    not $net.target.ip in %rfc1918_internal

    // Focus on scripting engines, LOLBins, and unusual process types
    // that have no legitimate reason to initiate raw TLS/HTTP connections
    // while potentially masquerading as browser or service traffic
    $net.principal.process.file.full_path = /(?i)\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|msiexec|wmic|cmd|installutil|regasm|regsvcs|cmstp|msbuild|xwizard|pcalua|forfiles|desktopimgdownldr|ieexec|mavinject|syncappvpublishingserver|appsyncpublishingserver|adplus|dnscmd|eudcedit|ntdsutil|odbcconf|pcwrun|replace|rpcping|runscripthelper|sfc|shdocvw|ttdinject|tttracer|vbc|vsjitdebugger|wab|winrm|wmic|wsreset|xwizard)\.exe$/

    // Exclude known-good administrative and security tooling
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude known-good remote management tooling
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
