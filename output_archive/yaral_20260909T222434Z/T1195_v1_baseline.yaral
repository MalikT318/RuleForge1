/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:46:45.036208+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_Supply_Chain_Package_Postinst_Shell_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a package manager (apt, dpkg, rpm, yum, dnf, pip, npm) spawning a shell interpreter as a child process during installation. Legitimate packages rarely require interactive shell execution from maintainer scripts; this pattern is a strong indicator of a supply-chain-compromised package executing a backdoor or dropper via a postinst/preinst/postinstall hook."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry normalised to UDM PROCESS_LAUNCH with principal.process (parent) and target.process (child) populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Some legitimate packages execute shell scripts during installation (e.g., complex post-install configuration). Package managers like pip may invoke sh for build steps. Validate against the specific package name and version in the package manager audit log."
    tuning_guidance = "Add known-good package manager wrapper scripts to %global_allowed_admin_tools. If a specific build host routinely triggers this, add it to %global_allowed_script_hosts. Consider narrowing the child command_line filter to exclude purely benign flags such as 'sh -c echo'."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent must be a package manager or its helper/hook runner
    $proc.principal.process.file.full_path = /\/(apt-get|apt|dpkg|rpm|yum|dnf|pip[23]?|pip|npm|yarn|gem|cargo|go)$/ nocase

    // Child must be a shell interpreter - the suspicious payload executor
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|fish|perl|python[23]?|python|ruby|node|nodejs)$/

    // Exclude shells that are simply printing version or help - low-risk invocations
    not $proc.target.process.command_line = /^\/(ba)?sh\s+--version/ nocase
    not $proc.target.process.command_line = /^\/(ba)?sh\s+-c\s+echo\s/ nocase

    // Exclude known-good administrative tooling and approved script hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

    // Exclude automated build/CI infrastructure service accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
