/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:41:20.620953+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_Create_Process_With_Token {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process creation where the launching process is a known token-manipulation or impersonation utility, or where a privileged shell is spawned by an unexpected parent, indicating CreateProcessWithTokenW or runas-style token abuse for privilege escalation."
    mitre_tactic = "Privilege Escalation, Defense Evasion"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires EDR process telemetry with parent-child process lineage and command-line arguments (Sysmon Event ID 1, Windows Security Event 4688 with command-line auditing enabled, or equivalent EDR telemetry)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate runas usage by administrators, RMM tools performing privileged operations, software deployment agents, PAM solutions that spawn processes under alternate accounts."
    tuning_guidance = "Add known-good administrative parent processes to %global_allowed_admin_tools. Add authorised service accounts that legitimately use runas or token duplication to %global_allowed_service_accounts. Narrow scope by requiring the child process to be a high-value target (cmd.exe, powershell.exe) if noise is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Detect runas-based token process creation or shells spawned under
    // a context inconsistent with the parent's identity.
    // Pattern 1: runas.exe used to launch a process as a different user
    // Pattern 2: known impersonation-capable tools spawning child processes
    //(?i) Pattern 3: privileged shell spawned by an Office/browser/script parent
    //(?i) (lateral movement / post-exploitation pattern)
    (
      // runas.exe spawning any child - the child runs under a new token
      $proc.principal.process.file.full_path = /(?i)\\runas\.exe$/
      or
      // A shell or interpreter is spawned by a process that should not
      // normally create privileged children (Office, browser, script host
      // used as a dropper that then calls CreateProcessWithTokenW)
      (
        $proc.principal.process.file.full_path = /(?i)\\(winword|excel|powerpnt|onenote|outlook|msaccess|mspub)\.exe$/
        and
        $proc.target.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/
      )
      or
      // PowerShell or cmd spawned by a browser - common post-exploit token abuse path
      (
        $proc.principal.process.file.full_path = /(?i)\\(chrome|firefox|msedge|iexplore|opera|brave)\.exe$/
        and
        $proc.target.process.file.full_path = /(?i)\\(cmd|powershell|pwsh)\.exe$/
      )
      or
      //(?i) runas /savecred or /user flag - explicit alternate-token process creation
      (
        $proc.target.process.file.full_path = /(?i)\\runas\.exe$/
        and
        $proc.target.process.command_line = /(?i)\/(user|savecred|noprofile)/
      )
      or
      // PowerShell invoking token-manipulation APIs or Start-Process -Credential
      (
        $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh)\.exe$/
        and
        (
          $proc.target.process.command_line = /(?i)Start-Process/
          or
          $proc.target.process.command_line = /(?i)CreateProcessWithToken/
          or
          $proc.target.process.command_line = /(?i)DuplicateToken/
          or
          $proc.target.process.command_line = /(?i)ImpersonateLoggedOnUser/
          or
          $proc.target.process.command_line = /(?i)WindowsIdentity.*Impersonate/
          or
          $proc.target.process.command_line = /(?i)\-Credential\s/
          or
          $proc.target.process.command_line = /(?i)LogonUser/
        )
      )
    )

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
