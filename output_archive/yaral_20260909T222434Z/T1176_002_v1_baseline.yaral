/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:45:55.132092+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_IDE_Extension_Network_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound network connections from IDE processes (VS Code, IntelliJ, Eclipse) to external destinations. Malicious IDE extensions establish persistence by executing code each time the IDE launches, often beaconing to C2 infrastructure or exfiltrating data. This rule targets the network-observable behaviour: an IDE process making an outbound connection to a non-internal destination on suspicious or uncommon ports."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "Browser Extensions: IDE Extensions"
    log_prerequisites = "Requires firewall or perimeter proxy logs with source IP and destination IP/port visibility. Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events normalised from perimeter telemetry."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate IDE extension marketplace updates (VS Code Marketplace, JetBrains Marketplace, Eclipse Marketplace), GitHub/GitLab integrations, Docker Hub pulls, language server downloads, and authorised remote development tunnels (VS Code Remote SSH). Developers connecting to approved cloud services via IDE plugins."
    tuning_guidance = "Add known-good extension marketplace domains and approved CDN destinations to %global_allowed_domains. Add internal scanner or proxy source IPs to %global_allowed_scanners. Narrow the port list if your environment only uses standard HTTPS (443) for IDE traffic. Consider pairing with endpoint telemetry to confirm the initiating process is an IDE binary."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal address (IDE running on a developer workstation)
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not internal)
    not $net.target.ip in %rfc1918_internal

    // Target ports associated with C2, tunnelling, or non-standard egress
    // Excludes port 443 (standard HTTPS) to reduce noise from legitimate marketplace traffic
    // Focuses on ports commonly abused by malicious extensions for reverse shells or tunnels
    (
      $net.target.port = 4444 or
      $net.target.port = 4445 or
      $net.target.port = 1337 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 9001 or
      $net.target.port = 9090 or
      $net.target.port = 6666 or
      $net.target.port = 1234 or
      $net.target.port = 31337
    )

    // Exclude approved domains (marketplace, CDN, vendor update services)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanners and security testing sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved remote management tooling sources
    not $net.principal.ip in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $destination_hostname = array_distinct($net.target.hostname)

  condition:
    $net
}
