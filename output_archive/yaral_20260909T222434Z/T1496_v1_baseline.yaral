/*
  MITRE Technique : T1496 - Resource Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:56:09.069683+00:00
  Reference       : https://attack.mitre.org/techniques/T1496
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Container_Cryptomining_Process_Launch {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process launches inside containers that match cryptomining or resource-hijacking behavioral patterns: use of CPU-pinning flags, stratum protocol references, mining pool port arguments, or known miner CLI argument patterns. Targets the primary OS mechanism for resource hijacking - spawning a compute-intensive worker process with mining-specific arguments."
    mitre_tactic    = "Impact"
    mitre_technique = "T1496"
    mitre_technique_name = "Resource Hijacking"
    log_prerequisites = "Requires container runtime process telemetry normalised to UDM PROCESS_LAUNCH, including command_line and parent process fields. Kubernetes audit logs or container EDR agents (e.g., Falco, Sysdig) feeding Chronicle."
    platform        = "Linux"
    log_source      = "container"
    false_positives = "Legitimate benchmark tools (stress-ng, sysbench) run by performance teams; authorised cryptocurrency node operators; CI/CD pipelines running compute-heavy build steps."
    tuning_guidance = "Add approved benchmark or build container image names or parent process paths to %global_allowed_admin_tools. Scope exclusions to specific namespaces or service accounts via %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match miners by their characteristic CLI arguments rather than binary name,
    // so the rule survives binary renaming. Stratum protocol, thread/CPU pinning,
    // pool address flags, and donation-level flags are stable miner fingerprints.
    (
      $proc.target.process.command_line = /stratum\+tcp:\/\// nocase or
      $proc.target.process.command_line = /stratum\+ssl:\/\// nocase or
      $proc.target.process.command_line = /--donate-level/ nocase or
      $proc.target.process.command_line = /--cpu-priority/ nocase or
      $proc.target.process.command_line = /--max-cpu-usage/ nocase or
      $proc.target.process.command_line = /--threads\s+[0-9]/ nocase or
      $proc.target.process.command_line = /-o\s+[a-zA-Z0-9.\-]+:[0-9]{4,5}\s+-u\s+/ nocase or
      $proc.target.process.command_line = /--coin\s+(monero|xmr|eth|rvn|ergo)/ nocase or
      $proc.target.process.command_line = /--algo\s+(rx|kawpow|autolykos|ethash|etchash|ghostrider)/ nocase or
      $proc.target.process.command_line = /nicehash/ nocase or
      $proc.target.process.command_line = /minergate/ nocase or
      $proc.target.process.command_line = /nanopool/ nocase or
      $proc.target.process.command_line = /2miners/ nocase or
      $proc.target.process.command_line = /f2pool/ nocase or
      $proc.target.process.command_line = /\/tmp\/[a-zA-Z0-9_\-]{4,}/ nocase
    )

    // Restrict to processes launched from suspicious or writable locations
    // common in container breakout / dropper scenarios
    (
      $proc.target.process.file.full_path = /^\/tmp\// nocase or
      $proc.target.process.file.full_path = /^\/dev\/shm\// nocase or
      $proc.target.process.file.full_path = /^\/var\/tmp\// nocase or
      $proc.target.process.file.full_path = /^\/run\// nocase or
      $proc.target.process.file.full_path = /^\/proc\/[0-9]+\/fd\// nocase or
      $proc.target.process.command_line = /stratum/ nocase or
      $proc.target.process.command_line = /--donate-level/ nocase or
      $proc.target.process.command_line = /--algo/ nocase
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1496")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $launching_process  = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
