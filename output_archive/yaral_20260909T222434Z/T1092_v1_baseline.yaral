/*
  MITRE Technique : T1092 - Communication Through Removable Media
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:36:47.179223+00:00
  Reference       : https://attack.mitre.org/techniques/T1092
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1092_001_Removable_Media_CnC_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects scripting interpreters or command shells writing executable or script files to removable/USB-mounted drives, a primary behavioral signal for T1092 where adversaries stage commands or exfiltrate data via removable media to bridge air-gapped or disconnected networks."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1092"
    mitre_technique_name = "Communication Through Removable Media"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry with parent process context. Sysmon Event ID 11 (FileCreate) or equivalent EDR file telemetry normalised to UDM FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software deployment or backup tools writing to USB drives, IT technicians using bootable USB media, authorized data transfer workflows to removable media in regulated environments."
    tuning_guidance = "Add approved parent processes to %global_allowed_admin_tools. Add authorized service accounts performing removable media operations to %global_allowed_service_accounts. Scope the drive letter regex if your environment uses fixed drive letters for removable media."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file must land on a removable/USB drive (D: through Z: excluding
    // common fixed-drive letters; adjust regex if environment differs).
    // Covers drive letters commonly assigned to USB/removable media on Windows.
    $file.target.file.full_path = /^[D-Zd-z]:\\/

    // File extension must be an executable, script, or archive type
    // commonly used to carry commands or payloads between systems.
    $file.target.file.full_path = /\.(exe|dll|bat|cmd|ps1|vbs|vbe|js|jse|wsf|wsh|hta|lnk|scr|pif|com|py|jar|zip|7z|rar)$/

    // Parent process is a scripting host, shell, or interpreter -
    // the mechanism an adversary uses to write staged payloads.
    $file.principal.process.file.full_path = /\\(cmd\.exe|powershell\.exe|pwsh\.exe|wscript\.exe|cscript\.exe|mshta\.exe|python\.exe|python3\.exe|wmic\.exe|certutil\.exe|bitsadmin\.exe|regsvr32\.exe|rundll32\.exe|msiexec\.exe|explorer\.exe)$/ nocase

    // Exclude known-good administrative and backup tooling.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known-good service accounts performing authorized transfers.
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1092")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_user = array_distinct($file.principal.user.userid)
    $written_file = array_distinct($file.target.file.full_path)
    $parent_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
