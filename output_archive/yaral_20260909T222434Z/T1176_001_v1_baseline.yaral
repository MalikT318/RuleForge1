/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:45:34.749655+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Browser_Extension_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file creation events consistent with browser extension installation on Windows. Monitors writes to Chromium-based and Firefox extension directories, including the Preferences and Secure Preferences files used for silent extension loading. Adversaries abuse these paths to persist malicious extensions without user interaction."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Browser Extensions"
    log_prerequisites = "Requires EDR file telemetry (e.g., Sysmon Event ID 11, CrowdStrike, Defender for Endpoint) producing FILE_CREATION events with full target file paths and principal process information."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate browser extension installs from the Chrome Web Store or Firefox Add-ons, browser auto-updates, enterprise-managed extension deployments via GPO or MDM, and developer-mode extension loading during software development."
    tuning_guidance = "Add known-good browser update and extension management processes to %global_allowed_admin_tools. Scope alerts to non-standard parent processes (i.e., not the browser itself) for higher fidelity. Consider suppressing events where the writing process is the browser binary and the extension ID matches an approved allowlist maintained outside this rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target Chromium-based browser extension paths (Chrome, Edge, Brave, etc.)
    // or Firefox extension paths under the user profile directory.
    // Matches: AppData\Local\Google\Chrome\User Data\...\Extensions\
    //          AppData\Local\Microsoft\Edge\User Data\...\Extensions\
    //          AppData\Roaming\Mozilla\Firefox\Profiles\...\extensions\
    //          Preferences or Secure Preferences files used for silent installs
    $file.target.file.full_path = /(?i)\\AppData\\(Local|Roaming)\\.*(Extensions\\[a-z]{32}|extensions\\.*\.xpi|Preferences|Secure Preferences)/

    // Exclude writes by the browser process itself performing legitimate installs
    not $file.principal.process.file.full_path = /(?i)\\(chrome|msedge|brave|firefox|chromium)\.exe$/

    // Exclude known administrative and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude backup processes that may read/write profile directories
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $target_extension_path = array_distinct($file.target.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
