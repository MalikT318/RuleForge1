/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:48:02.797937+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_Hardware_Backdoor_Persistence_Indicators {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects behavioral indicators consistent with hardware supply chain backdoors on Linux systems. Hardware implants and firmware backdoors typically establish persistence by writing to systemd unit directories, cron paths, or init scripts, and by spawning unexpected processes from kernel module load paths or device driver contexts. This rule targets file creation in persistence locations by processes running from unusual or transient paths, which is a common post-exploitation pattern for hardware-implanted backdoors activating after first boot."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Compromise Hardware Supply Chain"
    log_prerequisites = "Requires Linux EDR or auditd file creation telemetry with principal process path populated. Auditd rules should cover -w /etc/systemd -p wa, -w /etc/cron.d -p wa, -w /etc/init.d -p wa, and -w /lib/systemd -p wa."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers (apt, yum, dnf, rpm) installing legitimate software; configuration management agents (Ansible, Puppet, Chef); container orchestration daemons writing unit files; legitimate firmware update utilities."
    tuning_guidance = "Add known-good package manager and configuration management process paths to %global_allowed_admin_tools. Add authorised service account identities to %global_allowed_service_accounts. Scope exclusions narrowly to specific process paths rather than broad parent directories."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: persistence mechanism paths commonly abused by hardware backdoors
    // activating on first boot or after driver initialisation
    (
      $file.target.file.full_path = /^\/etc\/systemd\// nocase or
      $file.target.file.full_path = /^\/lib\/systemd\/system\// nocase or
      $file.target.file.full_path = /^\/usr\/lib\/systemd\/system\// nocase or
      $file.target.file.full_path = /^\/etc\/cron\.(d|daily|hourly|weekly|monthly)\// nocase or
      $file.target.file.full_path = /^\/var\/spool\/cron\// nocase or
      $file.target.file.full_path = /^\/etc\/init\.d\// nocase or
      $file.target.file.full_path = /^\/etc\/rc\.d\// nocase or
      $file.target.file.full_path = /^\/etc\/modules-load\.d\// nocase or
      $file.target.file.full_path = /^\/etc\/modprobe\.d\// nocase
    )

    // Principal process originates from a suspicious or transient location
    // Legitimate package managers and config agents run from /usr/bin, /usr/sbin, /bin, /sbin
    // Backdoor activation processes often run from /tmp, /dev/shm, /var/tmp, or kernel/driver paths
    (
      $file.principal.process.file.full_path = /^\/tmp\// nocase or
      $file.principal.process.file.full_path = /^\/dev\/shm\// nocase or
      $file.principal.process.file.full_path = /^\/var\/tmp\// nocase or
      $file.principal.process.file.full_path = /^\/run\// nocase or
      $file.principal.process.file.full_path = /^\/proc\// nocase or
      $file.principal.process.file.full_path = /^\/sys\// nocase or
      $file.principal.process.file.full_path = /\/\./ nocase
    )

    // Exclude known-good administrative tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $suspicious_process = array_distinct($file.principal.process.file.full_path)
    $persistence_target = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
