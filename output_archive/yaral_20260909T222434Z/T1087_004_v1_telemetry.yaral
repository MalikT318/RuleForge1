/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:26:20.415849+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_Cloud_Account_Enumeration_IDP_Audit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or repeated directory enumeration of cloud accounts via identity provider audit logs. Adversaries with authenticated access query user listings, role memberships, or group memberships to map the cloud account landscape. This rule fires on audit events that represent directory read operations against user or role objects, which are the state-change artifacts produced by enumeration APIs regardless of the tool used."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires identity provider audit logs normalised into Chronicle UDM. Entra ID (Azure AD) audit logs, Okta System Log, or equivalent IdP producing USER_RESOURCE_ACCESS events for directory read operations."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "HR provisioning systems performing scheduled user exports, IT helpdesk tooling performing user lookups, authorised IAM governance or access review platforms, SIEM/SOAR connectors polling directory state."
    tuning_guidance = "Add known service accounts performing legitimate directory reads to %global_allowed_service_accounts. Add approved scanning or governance principals to %global_allowed_scanners. Raise the threshold or narrow the target.resource.name regex if the environment has high-volume legitimate directory tooling."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource must be a directory object class representing users, roles, groups, or service principals
    $cloud.target.resource.name = /(?i)(user|role|group|member|service.?account|service.?principal|directory|principal)/ nocase

    // The operation name must reflect a read/list/get/enumerate action on the directory
    // IdPs normalise these as read, list, get, enumerate, export, or query operations
    $cloud.target.resource.attribute.labels["operation_name"] = /(?i)(list|get|read|enum|export|query|search|find)/ nocase

    // Actor must be a real authenticated principal (not anonymous)
    $cloud.principal.user.userid != ""

    // Exclude known legitimate service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved governance and scanning principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved admin users performing routine directory operations
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
