/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:35:35.346814+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_ESXi_Local_Data_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects local data staging activity on ESXi hosts where shell commands are used to copy, move, or aggregate files into a central staging location on datastores or scratch directories. Adversaries stage VM disk images, configuration files, and credential stores prior to exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Data Staged: Local Data Staging"
    log_prerequisites = "Requires ESXi shell (hostd/vmkernel) process telemetry normalised to UDM PROCESS_LAUNCH. ESXi shell must be enabled and shell activity forwarded to Chronicle via syslog or ESXi log shipping."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised backup jobs using vSphere APIs or backup agents (Veeam, Commvault, Nakivo) that stage VMDK snapshots. Storage vMotion operations. Authorised datastore maintenance scripts run by infrastructure teams."
    tuning_guidance = "Add authorised backup process names or parent process paths to %global_allowed_backup_processes. Add authorised admin accounts performing scheduled maintenance to %global_allowed_admin_users. Narrow the staging path regex if your environment uses non-default datastore mount points."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Shell binary executing a copy/move/archive operation - ESXi native binaries
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(cp|mv|tar|gzip|cat|dd|rsync|find|zip)$/

    // Command line targets ESXi-specific high-value paths: datastores, VMFS volumes,
    // scratch directories, config stores, or credential/certificate locations
    $proc.target.process.command_line = /(?i)(\/vmfs\/volumes|\/vmfs\/devices|\/scratch|\/store|\/bootbank|\/altbootbank|\/etc\/vmware|\/var\/log|\/tmp\/[a-z0-9_\-]{4,})/

    // Exclude commands that only read a single file to a terminal (no destination staging)
    // Require a second path argument indicating a destination, or archive flag
    $proc.target.process.command_line = /(?i)(\s+-[rRpafzc]+\s|\s+\/vmfs\/|\s+\/scratch\/|\s+\/tmp\/|\s+\/store\/)/

    // Parent process is an interactive or scripted shell - indicates hands-on-keyboard
    // or script-driven staging rather than a known management daemon
    $proc.principal.process.file.full_path = /\/(bin|sbin|usr\/bin)\/(sh|bash|ash|python|python3|perl)$/

    // Exclude known authorised backup and admin tooling
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $staging_command = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
