/*
  MITRE Technique : T1125 - Video Capture
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:39:55.341332+00:00
  Reference       : https://attack.mitre.org/techniques/T1125
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1125_001_Linux_Video_Capture_Device_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes accessing Linux video capture devices (/dev/video*) or known webcam device nodes via network-observable outbound flows shortly after suspicious process activity. This rule targets the network-observable side: unexpected outbound connections from hosts where video capture tooling is active, detected via firewall/proxy perimeter logs. Adversaries may use webcam APIs or CLI tools (v4l2, ffmpeg, gstreamer) to capture video and exfiltrate it outbound."
    mitre_tactic = "Collection"
    mitre_technique = "T1125"
    mitre_technique_name = "Video Capture"
    log_prerequisites = "Requires firewall or perimeter network flow logs with source IP, destination IP, destination port, and byte counts normalized to UDM NETWORK_FLOW or NETWORK_CONNECTION. Internal RFC1918 source addresses must be populated in principal.ip."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate video conferencing tools (Zoom, Teams, Meet) making outbound HTTPS connections; security cameras with cloud storage; authorized screen-sharing or remote support sessions; video streaming services."
    tuning_guidance = "Add known-good video conferencing and streaming destinations to %global_allowed_domains. Add authorized scanner or monitoring source IPs to %global_allowed_scanners. Tune the large-transfer threshold (bytes_sent) based on baseline traffic volume for the environment. Exclude known RMM or backup destinations via %global_allowed_remote_mgmt."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal host (not already an external/internet source)
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not internal RFC1918)
    not $net.target.ip in %rfc1918_internal

    // Target common video exfiltration ports: RTSP (554), RTMP (1935),
    // high-volume HTTPS (443) with large transfers, or non-standard high ports
    // that video streaming tools use. We match on port patterns associated
    // with streaming/upload protocols.
    (
      $net.target.port = 554   or   // RTSP - Real Time Streaming Protocol
      $net.target.port = 1935  or   // RTMP - Real Time Messaging Protocol
      $net.target.port = 8554  or   // RTSP alternate
      $net.target.port = 8080  or   // HTTP alternate often used by capture tools
      $net.target.port = 443        // HTTPS - large upload scenario
    )

    // Large outbound transfer volume is a strong signal for video exfiltration.
    // Video files are large; flag connections sending more than 10 MB outbound.
    // network.sent_bytes is populated by many firewall vendors in UDM.
    $net.network.sent_bytes > 10000000

    // Exclude known-good destinations (CDNs, approved conferencing, update services)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorized remote management and support tooling destinations
    not $net.principal.ip in %global_allowed_remote_mgmt

    // Exclude authorized vulnerability scanners and security testing sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1125")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
