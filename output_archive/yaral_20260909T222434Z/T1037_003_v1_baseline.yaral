/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:33:49.247286+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_Network_Logon_Script_Assignment {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the registry key used to assign network logon scripts via Active Directory or Group Policy. Adversaries write a script path to HKCU or HKLM UserInitMprLogonScript or related GPO keys to achieve persistence that executes at every logon with the victim user's privileges."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires EDR registry telemetry or Sysmon Event ID 13 (RegistryEvent - Value Set) normalised to UDM REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy management tools (GPMC, RSAT) legitimately writing logon script paths during policy deployment. Domain join automation and imaging pipelines may also touch these keys."
    tuning_guidance = "Add authorised GPO management processes (e.g., gpupdate.exe, mmc.exe launched by known admin accounts) to %global_allowed_admin_tools. Add known service accounts that perform policy deployment to %global_allowed_service_accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the canonical registry locations used to assign network logon scripts.
    // UserInitMprLogonScript is the primary per-user key; the Group Policy Machine Scripts
    //(?i) and User Scripts keys are used for GPO-assigned logon/logoff scripts.
    (
      $reg.target.registry.registry_key = /(?i)\\Environment\\UserInitMprLogonScript$/
      or
      $reg.target.registry.registry_key = /(?i)\\Group Policy\\Scripts\\(Logon|Logoff)\\/
      or
      $reg.target.registry.registry_key = /(?i)\\Group Policy\\State\\Machine\\Scripts\\(Startup|Shutdown)\\/
      or
      $reg.target.registry.registry_key = /(?i)\\Group Policy\\State\\.*\\Scripts\\(Logon|Logoff)\\/
      or
      $reg.target.registry.registry_key = /\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon/ nocase
    )

    // For the Winlogon key, narrow to the specific value names used for logon scripts
    // to avoid alerting on every Winlogon registry write.
    (
      not $reg.target.registry.registry_key = /\\Winlogon$/ nocase
      or
      $reg.target.registry.registry_value_name = /^(UserInit|Userinit|Shell|Taskman)$/ nocase
    )

    // The value being written should look like a script or executable path.
    // Legitimate GPO infrastructure writes .bat, .cmd, .ps1, .vbs, .js paths.
    $reg.target.registry.registry_value_data = /(?i)\.(bat|cmd|ps1|vbs|js|wsf|hta|exe)\b/

    // Exclude processes that are authorised to manage GPO and logon script configuration.
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $script_value = array_distinct($reg.target.registry.registry_value_data)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
