/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:49:40.907718+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Port_Knocking_Daemon_Launch {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process launches consistent with port-knocking daemons or raw-socket/libpcap listeners on Linux. Adversaries use port knocking to hide open ports used for persistence or C2 by listening for a predefined sequence of connection attempts on closed ports, often via libpcap sniffing or raw sockets. This rule targets the process-launch signal: a process that (a) is a known port-knocking daemon binary, or (b) is launched with flags that configure raw-socket or pcap-based packet capture combined with firewall-rule manipulation, or (c) is a shell/interpreter spawned from a pcap-capable parent in a suspicious path."
    mitre_tactic    = "Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Requires Linux EDR or auditd process-execution telemetry normalised to UDM PROCESS_LAUNCH events, including command-line arguments and parent process path."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate network monitoring tools (tcpdump, wireshark, nmap) run by administrators; authorised IDS/IPS agents; vulnerability scanners; packet-capture jobs in CI pipelines."
    tuning_guidance = "Add authorised admin tool paths to %global_allowed_admin_tools and authorised scanner source hosts to %global_allowed_scanners. Scope by principal.user.userid to exclude known monitoring service accounts via %global_allowed_service_accounts. Consider narrowing the regex to exclude scheduled tcpdump jobs documented in change management."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match known port-knocking daemon names OR pcap/raw-socket binaries
    // used as the mechanism for packet sniffing in port-knocking implementations.
    // Using a broad regex so renamed-but-not-recompiled variants are caught via
    // argument patterns below; the binary name match is a secondary signal.
    (
      $proc.target.process.file.full_path = /\/(knockd|fwknop|knock|cd00r|portknock)/ nocase
      or
      (
        // pcap-capable binaries invoked with interface sniffing flags
        $proc.target.process.file.full_path = /\/(tcpdump|tshark|dumpcap|scapy)$/ nocase
        and
        // Must also be manipulating firewall rules in the same invocation
        // (piped via shell) OR be launched from a suspicious non-admin path.
        // We detect the firewall-manipulation angle via parent being a shell
        // and the command line referencing iptables/nftables/firewalld.
        $proc.target.process.command_line = /(?i)(iptables|nftables|nft|firewall-cmd|ufw)/ nocase
      )
      or
      (
        // Raw-socket Python/Perl/Ruby scripts that reference pcap or raw socket
        // APIs and firewall manipulation - a common DIY port-knocking pattern.
        $proc.target.process.file.full_path = /\/(python[23]?|perl|ruby|bash|sh|dash|zsh)$/ nocase
        and
        $proc.target.process.command_line = /(?i)(pcap|raw.?socket|SOCK_RAW|libpcap|scapy)/ nocase
        and
        $proc.target.process.command_line = /(?i)(iptables|nftables|nft|firewall-cmd|ufw|ACCEPT|DROP|OPEN)/ nocase
      )
    )

    // Exclude processes launched from paths associated with authorised tooling
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools

    // Exclude known authorised service accounts running monitoring jobs
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude authorised scanner hosts
    not $proc.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggered_process = array_distinct($proc.target.process.file.full_path)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
