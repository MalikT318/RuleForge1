/*
  MITRE Technique : T1216.001 - PubPrn
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:51:21.614167+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_001_PubPrn_Script_Proxy_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects abuse of PubPrn.vbs to proxy execution of remote scriptlets via the script: moniker. Adversaries invoke cscript.exe with PubPrn.vbs and a second parameter beginning with script: (e.g., script:https://...) to bypass application control and signature validation. This technique is largely mitigated on Windows 10+ but remains relevant on older systems and patched variants."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1216.001"
    mitre_technique_name = "System Script Proxy Execution: PubPrn"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer publishing to Active Directory using LDAP:// syntax; however, the script: moniker variant has no legitimate use case."
    tuning_guidance = "If false positives occur from automation scripts, add the parent process path to %global_allowed_script_hosts. The script: moniker in the second argument is the highest-fidelity indicator and should not be relaxed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // cscript or wscript hosting the VBS
    $proc.target.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase

    // Command line must reference PubPrn.vbs
    $proc.target.process.command_line = /(?i)pubprn\.vbs/

    //(?i) The second argument uses the script: moniker instead of the legitimate LDAP:// prefix,
    // indicating remote scriptlet proxy execution
    $proc.target.process.command_line = /(?i)\bscript\s*:/

    // Exclude known-good script hosts (e.g., approved automation platforms)
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $initiating_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
