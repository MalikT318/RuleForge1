/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:45:17.070487+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Browser_Extension_Install_Network_Observable {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects network-observable browser or IDE extension installation activity from Linux endpoints. Malicious extensions are fetched from extension stores or third-party hosts; this rule flags outbound HTTP/HTTPS connections to known extension distribution paths (e.g., /crx/, /vsix/, update manifests) originating from internal hosts. Adversaries abuse extension marketplaces or host malicious packages externally to establish persistent access inside the browser or IDE process."
    mitre_tactic    = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Requires firewall or proxy logs with URL/URI path visibility (layer-7 inspection or SSL inspection). The log source must populate target.url or network.http.request_url and principal.ip."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate developer activity installing approved browser extensions or VS Code extensions. Automated CI/CD pipelines fetching extensions. Corporate software deployment tools. Security tooling that bundles extensions."
    tuning_guidance = "Add approved extension distribution domains to %global_allowed_domains. Add known-good scanner or deployment source IPs to %global_allowed_scanners. Consider scoping by internal subnet if only developer workstations are expected to install extensions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Source must be an internal host - exclude known external scanners
    not $net.principal.ip in %rfc1918_internal

    // Target must NOT be an approved internal or known-good domain
    not $net.target.hostname in %global_allowed_domains

    // Detect extension package fetch patterns across major platforms:
    // Chrome/Chromium .crx downloads, Firefox .xpi, VS Code .vsix,
    // browser extension update manifest requests, and generic extension paths
    (
      $net.network.http.request_url = /\/crx\?/ nocase
      or $net.network.http.request_url = /\.crx(\?|$)/ nocase
      or $net.network.http.request_url = /\.xpi(\?|$)/ nocase
      or $net.network.http.request_url = /\.vsix(\?|$)/ nocase
      or $net.network.http.request_url = /\/extension\/update/ nocase
      or $net.network.http.request_url = /\/updates\.xml/ nocase
      or $net.network.http.request_url = /\/extensionquery/ nocase
      or $net.network.http.request_url = /\/webstore\/inlineinstall/ nocase
      or $net.network.http.request_url = /\/crx\/blobs\// nocase
    )

    // Restrict to standard web ports to avoid matching internal tooling on high ports
    (
      $net.target.port = 80
      or $net.target.port = 443
      or $net.target.port = 8080
      or $net.target.port = 8443
    )

    // Exclude approved scanners and remote management sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_host  = array_distinct($net.target.hostname)
    $requested_url     = array_distinct($net.network.http.request_url)
    $destination_port  = array_distinct($net.target.port)

  condition:
    $net
}
