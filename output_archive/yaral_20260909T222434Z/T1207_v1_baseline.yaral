/*
  MITRE Technique : T1207 - Rogue Domain Controller
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:50:21.415453+00:00
  Reference       : https://attack.mitre.org/techniques/T1207
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1207_001_DCShadow_Rogue_DC_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects DCShadow-style rogue Domain Controller registration by monitoring for creation or modification of nTDSDSA or server objects in the Active Directory Configuration partition via registry or process telemetry. Attackers register a rogue DC by writing these objects to manipulate AD replication without logging through legitimate DC channels."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1207"
    mitre_technique_name = "Rogue Domain Controller"
    log_prerequisites = "Requires EDR process telemetry (Sysmon Event ID 1/10) or Windows Security Event 4688 with command-line auditing enabled. Windows AD replication audit events (4928, 4929) are also relevant but not targeted here."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate DC promotion via dcpromo or Server Manager; AD domain join operations performed by authorized administrators; AD replication health tools."
    tuning_guidance = "Add authorized DC promotion accounts to %global_allowed_admin_users. Add authorized AD management tooling paths to %global_allowed_admin_tools. Scope by environment if DC promotion is a routine operation."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // DCShadow requires invoking replication registration, typically via
    // mimikatz lsadump::dcshadow or custom tooling that calls DsAddressToSiteNamesW,
    // DsReplicaAdd, or NtdsApi. The process lineage and argument patterns are
    // the highest-fidelity behavioral signal available in process telemetry.
    // Detect processes that attempt to register a DC replication endpoint by
    // passing replication-related flags from non-standard parent contexts.

    // The command line must reference DC registration or replication push verbs
    // used by DCShadow tooling (push, dcshadow, or explicit nTDS/replication flags).
    $proc.target.process.command_line = /(?i)(dcshadow|\/push|nTDSDSA|DsReplicaAdd|AddEntry.*nTDS|ReplExt|KCC.*register)/ nocase

    // Exclude known-good administrative tooling paths
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorized admin accounts performing legitimate DC promotion
    not $proc.principal.user.userid in %global_allowed_admin_users

    // Require a hostname to be present for grouping and entity attribution
    $proc.principal.hostname != ""

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1207")
    $primary_entity = array_distinct($proc.principal.hostname)
    $actor_userid = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
