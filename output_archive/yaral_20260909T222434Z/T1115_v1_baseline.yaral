/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:38:51.550741+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_001_Clipboard_Data_Collection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects clipboard data collection on Windows via clip.exe invocation for output capture, PowerShell Get-Clipboard cmdlet, or scripting hosts accessing clipboard APIs. Adversaries use these built-in mechanisms to harvest sensitive data copied by users such as passwords, tokens, and PII."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires EDR process telemetry with command-line capture (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1). PowerShell script-block logging (Event ID 4104) also surfaces Get-Clipboard usage."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative scripts that pipe output to clip.exe for convenience, help-desk tooling that reads clipboard for diagnostics, password managers or productivity tools using clipboard APIs, developer workflows using clip.exe in build scripts."
    tuning_guidance = "Add known-good parent processes (e.g., build agents, approved automation) to %global_allowed_script_hosts. Narrow scope by excluding hosts in %global_allowed_admin_tools if clipboard use is expected on specific admin workstations."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Branch 1: clip.exe used to capture stdin (piped output) - commonly abused to stage clipboard data
    // Branch 2: PowerShell or scripting hosts invoking Get-Clipboard or clipboard-related APIs
    // Branch 3: Suspicious parent processes (script interpreters) launching clip.exe
    (
      (
        $proc.target.process.file.full_path = /(?i)\\clip\.exe$/ and
        (
          $proc.principal.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ or
          $proc.target.process.command_line = /(?i)clip/
        )
      )
      or
      (
        $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh)\.exe$/ and
        (
          $proc.target.process.command_line = /(?i)Get-Clipboard/ or
          $proc.target.process.command_line = /(?i)GetText.*Clipboard/ or
          $proc.target.process.command_line = /(?i)\[Windows\.Forms\.Clipboard\]/ or
          $proc.target.process.command_line = /(?i)System\.Windows\.Forms\.Clipboard/
        )
      )
      or
      (
        $proc.target.process.file.full_path = /(?i)\\(wscript|cscript)\.exe$/ and
        $proc.target.process.command_line = /(?i)(clipboard|GetText|SetText)/
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($proc.principal.hostname)
    $initiating_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
