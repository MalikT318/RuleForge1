/*
  MITRE Technique : T1008 - Fallback Channels
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:31:01.331814+00:00
  Reference       : https://attack.mitre.org/techniques/T1008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1008_Fallback_Channels_MultiDest_Beacon {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects potential fallback channel behaviour observed at the network perimeter: a single internal host making repeated outbound connections to multiple distinct external destinations on the same suspicious port within a short window. Adversaries implement fallback C2 by cycling through a list of controllers when the primary is unreachable. This rule targets the network-observable signature of that pattern - bursts of short-lived or failed connections to rotating external IPs on non-standard or dual-use ports commonly abused for C2 (e.g. 443, 80, 8080, 8443, 4443, 53, 8888)."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1008"
    mitre_technique_name = "Fallback Channels"
    log_prerequisites = "Requires firewall or perimeter proxy flow logs normalised into Chronicle UDM with principal.ip, target.ip, target.port, and metadata.event_type = NETWORK_CONNECTION or NETWORK_FLOW populated. Connection state or bytes-transferred fields improve fidelity but are not required."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "CDN-backed SaaS applications that resolve to many IPs (e.g. Microsoft 365, Akamai-hosted services), load-balanced update services, legitimate multi-homed VPN gateways, and split-tunnel configurations. Browsers with pre-fetch or QUIC fallback may also trigger on port 443/80."
    tuning_guidance = "Add known-good CDN and SaaS destination IPs or ranges to %global_allowed_domains exclusions at the proxy layer. Add approved scanner source IPs to %global_allowed_scanners. Raise the threshold or narrow the port list if false-positive volume is high in a given environment. Consider correlating with endpoint telemetry to confirm the initiating process."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal host - exclude scanner and mgmt sources
    not $net.principal.ip in %rfc1918_internal
    $net.principal.ip = $src_ip

    // Destination must be external (not RFC1918)
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_scanners

    // Target ports commonly abused for C2 fallback channels
    // Covers HTTPS, HTTP, alt-HTTP, alt-HTTPS, and DNS-over-TCP
    (
      $net.target.port = 443  or
      $net.target.port = 80   or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 4443 or
      $net.target.port = 53   or
      $net.target.port = 8888
    )

    // Exclude destinations explicitly allow-listed as known-good domains/IPs
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1008")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ips   = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
