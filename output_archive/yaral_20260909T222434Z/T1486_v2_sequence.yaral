/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:27:55.445750+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_002_Ransomware_ShadowDelete_Then_MassFileWrite {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a ransomware-indicative sequence: shadow copy deletion or backup inhibition (a near-universal ransomware pre-encryption step) followed by high-volume file creation/modification activity on the same host within one hour. This correlation targets the operational pattern rather than specific tool names or command-line payloads, providing additive coverage beyond process-launch command-line rules."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires EDR or Sysmon telemetry normalised to UDM PROCESS_LAUNCH and FILE_CREATION/FILE_MODIFICATION events. Shadow copy deletion visibility requires process command-line logging. File write events must be generated at volume (EDR file-write telemetry or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate backup software that deletes old shadow copies before creating new ones (e.g., Windows Backup, third-party BDR agents). Disk cleanup utilities. Large-scale file migration or deployment jobs. Patch management agents writing many files simultaneously."
    tuning_guidance = "Add backup and deployment parent process paths to %global_allowed_backup_processes. Raise the file-write threshold by adjusting the match window or adding a count-based outcome filter. Exclude known-good service accounts via %global_allowed_service_accounts."

  events:
    // Event 1: Shadow copy deletion or backup inhibition via a Windows built-in or scripting mechanism.
    // Targets the RESULT of the command (a process launched to destroy recovery capability)
    // rather than a specific tool name, so it fires even if the attacker renames vssadmin/wmic/bcdedit.
    $shadow.metadata.event_type = "PROCESS_LAUNCH"

    // Match any process whose command line references VSS/shadow/backup inhibition patterns.
    // Using multiple independent predicates (AND semantics) to avoid a single overlong regex.
    (
      $shadow.target.process.command_line = /(?i)shadow/ or
      $shadow.target.process.command_line = /(?i)vssadmin/ or
      $shadow.target.process.command_line = /(?i)wbadmin/ or
      $shadow.target.process.command_line = /(?i)bcdedit.*recoveryenabled/ or
      $shadow.target.process.command_line = /(?i)diskshadow/
    )
    (
      $shadow.target.process.command_line = /(?i)delete/ or
      $shadow.target.process.command_line = /(?i)resize.*maxsize/ or
      $shadow.target.process.command_line = /(?i)no/ or
      $shadow.target.process.command_line = /(?i)quiet/
    )

    not $shadow.principal.process.file.full_path in %global_allowed_backup_processes
    not $shadow.principal.user.userid in %global_allowed_service_accounts

    $shadow.principal.hostname = $hostname

    // Event 2: Mass file creation or modification - a strong indicator of in-progress encryption.
    // We narrow to extensions commonly targeted by ransomware or to files being written in
    // user-accessible directories, avoiding system directories that generate benign noise.
    $file.metadata.event_type = "FILE_CREATION"

    // Target files written under user profile or data directories (regex anchored to common Windows paths).
    $file.target.file.full_path = /(?i)\\(Users|Documents|Desktop|Downloads|AppData|OneDrive|shares|data|backup|work)\\/ 

    // Exclude known-good writers.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

    $file.principal.hostname = $hostname

    // Chronological ordering: shadow deletion must precede mass file writes.
    $shadow.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($hostname)
    $shadow_cmdlines = array_distinct($shadow.target.process.command_line)
    $shadow_parent_process = array_distinct($shadow.principal.process.file.full_path)
    $affected_paths = array_distinct($file.target.file.full_path)
    $file_write_count = count($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $shadow and $file
}
