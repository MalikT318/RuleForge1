/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:42:31.785906+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_SID_History_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects SID-History Injection via Windows Security Event 4765/4766 (SID History added to account) or via privileged tooling that manipulates the SID-History Active Directory attribute. Adversaries with Domain Admin rights inject well-known or harvested SIDs (e.g., Enterprise Admins S-1-5-21-*-519) into SID-History to silently escalate privileges and bypass access controls without changing group membership."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires Windows Security Event Log (Event ID 4765 - SID History added successfully, 4766 - attempt to add SID History failed) forwarded via EDR or SIEM connector, or EDR process telemetry capturing LDAP/DS attribute writes to the sIDHistory attribute. Windows Advanced Audit Policy: Audit User Account Management must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Active Directory domain migrations or consolidations where sIDHistory is intentionally populated by migration tools (ADMT). Authorised identity governance tooling performing account lifecycle operations."
    tuning_guidance = "Add authorised migration service accounts to %global_allowed_service_accounts. Add approved migration tooling binaries to %global_allowed_admin_tools. During planned migration windows, consider temporarily disabling or suppressing this rule with a scheduled exception rather than permanent exclusion."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // SID-History attribute modification - the sIDHistory LDAP attribute
    // is the direct OS mechanism this technique depends on.
    // UDM normalises Windows Security 4765/4766 and EDR LDAP write telemetry
    // into USER_CHANGE_PERMISSIONS with the attribute name in the target field.
    (
      $auth.target.user.attribute.labels.key = "sIDHistory" nocase
      or
      $auth.target.user.attribute.labels.value = /(?i)sIDHistory/
      or
      $auth.security_result.description = /(?i)sid.?history/
      or
      $auth.target.resource.name = /(?i)sIDHistory/
    )

    // Exclude authorised service accounts performing legitimate migrations
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude authorised migration and identity tooling
    not $auth.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($auth.principal.hostname)
    $target_account = array_distinct($auth.target.user.userid)
    $acting_account = array_distinct($auth.principal.user.userid)
    $acting_process = array_distinct($auth.principal.process.file.full_path)

  condition:
    $auth
}
