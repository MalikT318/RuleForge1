/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:46:24.670350+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_001_Forced_SMB_Auth_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound SMB or WebDAV connections to external (non-RFC1918) destinations, which may indicate forced authentication attacks where a victim host is coerced into authenticating to an adversary-controlled server, exposing NTLM credential hashes. SMB operates on TCP 445/139; WebDAV falls back to TCP 80/443."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Requires firewall or perimeter network flow logs with source/destination IP and port visibility. Flows must be normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SMB to cloud file-sharing services (Azure Files, etc.), WebDAV to approved SaaS platforms, authorised vulnerability scanners, backup agents reaching external storage."
    tuning_guidance = "Add approved external SMB/WebDAV destinations to %global_allowed_domains or source scanner IPs to %global_allowed_scanners. Consider suppressing known-good source subnets via %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target ports associated with SMB (445, 139) and WebDAV fallback (80, 443)
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 80  or
      $net.target.port = 443
    )

    // Destination must be external - exclude RFC1918 internal space
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external destinations (CDNs, update services, approved SaaS)
    not $net.target.domain in %global_allowed_domains

    // Exclude authorised scanners that may probe external SMB
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Require a source IP to be present (internal originator)
    $net.principal.ip != ""

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $destination_domain = array_distinct($net.target.domain)

  condition:
    $net
}
