/*
  MITRE Technique : T1136.003 - Cloud Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:43:17.745175+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_003_Cloud_Account_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new cloud user or service account in an identity provider directory. Adversaries create cloud accounts to establish persistent secondary access without deploying remote access tooling. Fires on any USER_CREATION event not performed by an approved service or admin account."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.003"
    mitre_technique_name = "Create Account: Cloud Account"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM USER_CREATION events (e.g. Entra ID Audit Logs, Okta System Log, Google Workspace Admin SDK). The creating principal's userid must be populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Automated provisioning pipelines, HR onboarding workflows, approved IT admin account creation, break-glass account provisioning."
    tuning_guidance = "Add known provisioning service accounts to %global_allowed_service_accounts. Add approved admin users who routinely create accounts to %global_allowed_admin_users. Consider scoping to off-hours creation or creation of privileged account types for higher fidelity."

  events:
    $cloud.metadata.event_type = "USER_CREATION"

    // The actor performing the creation must be present
    $cloud.principal.user.userid != ""

    // Exclude approved automated provisioning service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrators expected to create accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Exclude approved cloud/identity service principals (e.g. SCIM provisioners)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // The newly created account must have an identifier
    $cloud.target.user.userid != ""

    // Optionally capture whether the new account appears to be a service/non-human identity
    // by matching common service account naming conventions (e.g. svc-, sp-, app-, bot-)
    // This is informational for outcome scoring; the rule fires regardless
    $cloud.target.user.userid = $new_account_id

  outcome:
    // Elevate score when the new account name suggests a service principal or privileged role
    $risk_score = max(
      if(
        re.regex($new_account_id, /(?i)(svc[-_]|sp[-_]|app[-_]|bot[-_]|automation|pipeline|deploy|admin|root|superuser)/),
        85,
        65
      )
    )
    $mitre_technique_id = array_distinct("T1136.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $created_account = array_distinct($cloud.target.user.userid)
    $actor_email = array_distinct($cloud.principal.user.email_addresses)

  condition:
    $cloud
}
