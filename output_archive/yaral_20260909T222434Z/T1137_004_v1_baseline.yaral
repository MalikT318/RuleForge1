/*
  MITRE Technique : T1137.004 - Outlook Home Page
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:44:22.509188+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_004_Outlook_Home_Page_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Outlook folder Home Page registry keys, which adversaries abuse to load a malicious URL whenever an Outlook folder is opened. The WebView registry subkeys under Outlook's folder configuration store the Home Page URL and an enabled flag. Writing to these keys outside of expected administrative tooling is a strong indicator of T1137.004 persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.004"
    mitre_technique_name = "Office Application Startup: Outlook Home Page"
    log_prerequisites = "Requires Windows endpoint EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION events. Sysmon Event ID 13 (RegistryEvent - Value Set) or equivalent EDR registry telemetry is required."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Outlook folder customisation by IT administrators; enterprise SharePoint or intranet portal integrations that configure Outlook folder home pages via GPO or deployment scripts."
    tuning_guidance = "Add authorised deployment or configuration management processes to %global_allowed_admin_tools. If GPO-based Outlook home page configuration is in use, add the responsible process (e.g., Group Policy client) to the exclusion list. Consider narrowing on the registry_value_name field to focus on 'URL' writes if noise from 'Flags' or 'Enabled' value writes is too high."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Outlook WebView registry path where Home Page URLs are stored.
    // Pattern covers all user SIDs (HKU\<SID>\...) and HKCU variants after UDM normalisation.
    // Matches: ...\Outlook\WebView\<FolderName> under any Office version (12.0 through 99.0).
    $reg.target.registry.registry_key = /(?i)\\Software\\Microsoft\\Office\\[0-9]+\.[0-9]+\\Outlook\\WebView\\/

    // Focus on the value names that actually enable and configure the Home Page URL.
    //(?i) 'URL' stores the malicious page; 'Enabled' / 'Flags' activate the feature.
    $reg.target.registry.registry_value_name = /(?i)^(URL|Enabled|Flags)$/

    // Exclude known-good administrative and deployment tooling.
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service and automation accounts.
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $modified_registry_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
