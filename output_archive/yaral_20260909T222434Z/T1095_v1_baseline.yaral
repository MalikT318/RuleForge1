/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:37:09.000509+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_ESXi_VMCI_NonAppLayer_Protocol_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential abuse of non-application layer protocols on ESXi hosts, including VMCI socket usage, unexpected low-level network utilities, or processes that establish raw/ICMP/UDP communication channels outside normal ESXi management paths. Adversaries may use VMCI or raw sockets to create covert C2 channels invisible to external network monitoring."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised to UDM PROCESS_LAUNCH. ESXi shell must be enabled and shell command logging active (esxcli system syslog or equivalent)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "VMware Tools or open-vm-tools performing legitimate VMCI operations; authorised VMware support scripts; vSphere HA heartbeat processes; authorised network diagnostic utilities run by administrators."
    tuning_guidance = "Add known-good parent process paths (e.g., vmware-tools daemons, hostd, vpxa) to %global_allowed_admin_tools. Add authorised service accounts that run diagnostics to %global_allowed_service_accounts. Scope by principal.hostname if only specific hosts are managed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target processes associated with raw/non-application layer socket usage on ESXi:
    // vsock/vmci utilities, raw socket tools, nc/ncat variants, socat, python/perl
    // used to open raw or VMCI sockets, or low-level packet tools
    $proc.target.process.file.full_path = /\/(vsock-test|vmci_sockets|nc|ncat|socat|hping|ping|ping6|tcpdump|python[23]?|perl|busybox)$/ nocase

    // Require at least one of the following command-line indicators that suggest
    // non-application layer or covert channel usage rather than normal admin activity:
    // - VMCI/vsock socket family references
    // - raw socket flags (SOCK_RAW, AF_PACKET, IPPROTO_RAW, IPPROTO_ICMP)
    // - ICMP tunnel patterns (icmp, -p icmp, --icmp)
    // - socat with vsock or raw IP
    // - python/perl one-liners opening raw or vsock sockets
    // - unusual port 0 or protocol 255 usage
    $proc.target.process.command_line = /(?i)(vmci|vsock|SOCK_RAW|AF_PACKET|IPPROTO_RAW|IPPROTO_ICMP|icmp|vsock_stream|vsock_dgram|socat.*vsock|socat.*ip-proto|raw.*socket|socket\.SOCK_RAW|socket\.AF_PACKET|proto=255|proto=1\b|-p\s+icmp|--icmp|icmp-tunnel|icmptunnel)/

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggered_process = array_distinct($proc.target.process.file.full_path)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
