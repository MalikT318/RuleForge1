/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:25:42.344070+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_GAL_Enumeration_M365_Resource_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or repeated access to the Global Address List (GAL) or directory resources in Microsoft 365, which may indicate adversarial enumeration of email accounts and identities. Targets the USER_RESOURCE_ACCESS telemetry layer rather than command-line invocation, providing coverage that is additive to process-creation rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log ingested into Chronicle. Relevant operations include AddressBook, GlobalAddressList, OAB (Offline Address Book), and Directory access events normalised to USER_RESOURCE_ACCESS."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate mail clients performing initial directory sync (e.g., Outlook profile setup, GWSMO sync). Approved HR or IT tooling performing directory exports. Automated provisioning pipelines using service accounts."
    tuning_guidance = "Add known service and automation accounts to %global_allowed_service_accounts. Add approved admin users performing directory operations to %global_allowed_admin_users. Narrow the resource_name regex if the tenant uses a non-standard OAB or address book naming convention."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resources associated with address book / directory enumeration
    // Matches OAB (Offline Address Book), GlobalAddressList, AddressBook, Directory, and GAL resource names
    $cloud.target.resource.name = /(?i)(offline.?address.?book|global.?address.?list|address.?book|\/oab\/|\/ews\/|directory.*lookup|people.*search|contacts.*directory)/

    // Actor must be a real user principal (non-empty)
    $cloud.principal.user.userid != ""

    // Exclude known-good service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved admin users performing legitimate directory operations
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Exclude approved cloud service principals (e.g., provisioning pipelines)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
