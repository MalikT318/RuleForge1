/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:31:18.921191+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_Exfiltration_Over_Alternate_Network_Medium {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects large or sustained outbound network flows to external destinations over uncommon or unexpected ports, which may indicate exfiltration over an alternate network medium (e.g., cellular modem, Bluetooth bridge, rogue WiFi interface). Firewall telemetry is used to identify high-volume transfers to non-internal destinations on ports not associated with standard enterprise traffic."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Requires firewall or perimeter flow logs with bytes_sent/network.sent_bytes populated. Flows must be exported with per-session byte counts."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Backup jobs sending large datasets to cloud storage, video conferencing, software update mirrors, authorised bulk data transfers. Tune using %global_allowed_domains and %global_allowed_scanners."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Raise the bytes threshold if legitimate bulk transfers are common. Restrict to specific source subnets if the environment has well-defined egress zones."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Exclude RFC-1918 internal destinations - exfiltration over alternate medium targets external endpoints
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external domains (CDNs, update services, approved cloud)
    not $net.target.domain.name in %global_allowed_domains

    // Exclude authorised scanner sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude authorised management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Flag high-volume outbound transfers: threshold of 50 MB per session
    // is anomalous for most alternate-medium channels and non-standard ports
    $net.network.sent_bytes > 52428800

    // Target uncommon egress ports - standard enterprise ports (80, 443, 25, 587, 993, 22, 53)
    // are excluded to focus on alternate-medium bridging software and tunnels
    not $net.target.port = 80
    not $net.target.port = 443
    not $net.target.port = 25
    not $net.target.port = 587
    not $net.target.port = 993
    not $net.target.port = 22
    not $net.target.port = 53
    not $net.target.port = 123
    not $net.target.port = 8080
    not $net.target.port = 8443

    // Capture joining fields for outcome
    $net.principal.ip = $src_ip

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ips   = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
