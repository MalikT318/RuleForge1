/*
  MITRE Technique : T1074.002 - Remote Data Staging
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:35:52.306758+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_002_Remote_Data_Staging_Network_Exfil_Prep {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects large outbound data transfers to external destinations that are consistent with remote data staging prior to exfiltration. Adversaries aggregate collected data on a single system and then transfer it outward, often in bulk, to minimize C2 connections. This rule fires on high-volume outbound flows to non-internal destinations, which is the network-observable signature of staged data being exfiltrated from a Windows host."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.002"
    mitre_technique_name = "Data Staged: Remote Data Staging"
    log_prerequisites = "Requires firewall or perimeter flow logs with bytes_sent populated. NETWORK_FLOW or NETWORK_CONNECTION events with principal.ip, target.ip, network.sent_bytes, and target.port must be present."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorized backup jobs, cloud sync agents (OneDrive, Dropbox, SharePoint), large software deployments, approved data replication pipelines, vulnerability scanners, and CDN upload workflows."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add authorized backup or sync source IPs to %global_allowed_backup_processes equivalent network sources. Raise the bytes threshold if legitimate bulk transfers are common in the environment. Exclude scanner sources via %global_allowed_scanners."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Source must be an internal address (RFC1918 space)
    $net.principal.ip in %rfc1918_internal

    // Destination must NOT be internal - external staging destination
    not $net.target.ip in %rfc1918_internal

    // High-volume outbound transfer indicative of staged data movement
    // 50 MB threshold - tune upward for environments with legitimate bulk transfers
    $net.network.sent_bytes > 52428800

    // Exclude well-known authorized external destinations
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorized scanners initiating outbound flows
    not $net.principal.ip in %global_allowed_scanners

    // Exclude authorized remote management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Capture staging destination for outcome enrichment
    $net.target.ip = $dest_ip

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1074.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($dest_ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)
    $destination_hostname = array_distinct($net.target.hostname)

  condition:
    $net
}
