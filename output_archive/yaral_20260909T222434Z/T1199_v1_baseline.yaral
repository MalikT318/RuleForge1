/*
  MITRE Technique : T1199 - Trusted Relationship
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:48:22.971670+00:00
  Reference       : https://attack.mitre.org/techniques/T1199
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1199_Trusted_Relationship_External_Principal_Privileged_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful login by an external or federated principal (third-party contractor, partner, or delegated administrator) that is immediately associated with a privileged role or administrative group membership. Adversaries who compromise trusted third-party accounts exploit pre-existing delegated access to gain administrative control over victim tenants without triggering standard new-account alerts."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1199"
    mitre_technique_name = "Trusted Relationship"
    log_prerequisites = "Requires identity provider audit and sign-in logs normalised to UDM USER_LOGIN events. The log source must populate principal.user.userid, principal.user.email_addresses, network.auth.auth_details or extensions fields indicating external/federated identity, and target.resource.name or target.user.attribute.roles reflecting privileged role assignment at login time."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate managed service provider (MSP) or vendor accounts performing authorised administrative work. Break-glass or emergency admin accounts operated by approved third parties. Automated service principals used by approved integration partners."
    tuning_guidance = "Add known-good external admin account identifiers to %global_allowed_admin_users. Add approved service principal or automation account identifiers to %global_allowed_service_accounts. Add approved cloud principals to %global_allowed_cloud_principals. Scope the role regex to match only the highest-privilege roles relevant to the tenant (e.g. Global Administrator, Company Administrator, Super Admin)."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // External or federated identity signal: UPN contains a domain separator
    // indicating a guest, B2B, or cross-tenant federated account (#EXT#, _ext_, or
    // a domain that differs from the resource tenant). Regex matches common
    // Entra ID guest UPN format (user_domain.com#EXT#@tenant.onmicrosoft.com)
    // as well as generic cross-domain patterns.
    (
      $auth.principal.user.userid = /(?i)#ext#/ or
      $auth.principal.user.email_addresses = /(?i)#ext#/ or
      $auth.network.auth.auth_details = /(?i)(federated|external|guest|partner|delegated)/
    )

    // Privileged role or group context present at login time.
    // Matches common high-privilege role names across major identity providers
    // without hardcoding vendor-specific identifiers.
    $auth.target.resource.name = /(?i)(global.?admin|company.?admin|privileged.?role|super.?admin|tenant.?admin|directory.?admin|partner.?admin|delegated.?admin|security.?admin|exchange.?admin|sharepoint.?admin|helpdesk.?admin|billing.?admin|user.?admin|cloud.?app.?admin)/ nocase

    // Exclude approved external admin accounts and service principals
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = 80
    $mitre_technique_id = "T1199"
    $primary_entity = $auth.principal.user.userid
    $privileged_role_accessed = $auth.target.resource.name
    $source_ip = $auth.principal.ip
    $auth_mechanism = $auth.network.auth.auth_details

  condition:
    $auth
}
