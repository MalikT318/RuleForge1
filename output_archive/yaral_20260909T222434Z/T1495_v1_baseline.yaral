/*
  MITRE Technique : T1495 - Firmware Corruption
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:55:45.284641+00:00
  Reference       : https://attack.mitre.org/techniques/T1495
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1495_001_Firmware_Corruption_Network_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects potential firmware corruption or exfiltration activity observable at the network perimeter. Adversaries targeting firmware (T1495) may initiate unusual outbound connections from network devices or management hosts, particularly to external destinations over TFTP (UDP/69), FTP, or other file-transfer protocols commonly used to stage or exfiltrate firmware images. This rule fires on outbound connections from internal hosts to external IPs over firmware-transfer-relevant ports."
    mitre_tactic = "Impact"
    mitre_technique = "T1495"
    mitre_technique_name = "Firmware Corruption"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs with source IP, destination IP, destination port, and protocol fields normalised into UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised network device firmware upgrades via TFTP from a jump host or NMS; legitimate FTP-based backup jobs; vendor-managed device provisioning workflows."
    tuning_guidance = "Add authorised management source IPs to %global_allowed_mgmt_sources and approved external update destinations to %global_allowed_domains. Restrict the port list if TFTP is not used in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal address
    $net.principal.ip in %rfc1918_internal

    // Destination must NOT be an internal address (external egress)
    not $net.target.ip in %rfc1918_internal

    // Firmware-transfer-relevant ports:
    // UDP/69  = TFTP (primary firmware transfer protocol for network devices)
    // TCP/21  = FTP control (firmware staging)
    // TCP/20  = FTP data
    // TCP/69  = TFTP over TCP (some implementations)
    // TCP/4786 = Cisco Smart Install (abused for firmware replacement)
    (
        $net.target.port = 69 or
        $net.target.port = 20 or
        $net.target.port = 21 or
        $net.target.port = 4786
    )

    // Exclude authorised management sources (NMS, jump hosts, provisioning servers)
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude authorised scanners (vulnerability assessment platforms)
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1495")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
