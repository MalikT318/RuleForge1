/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:27:28.490849+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_ESXi_Bulk_VMDK_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Critical"
    description = "Detects bulk modification of VMDK files on ESXi datastore, indicative of ransomware encrypting virtual machine disks."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires ESXi hostd or vmkernel file operation logs normalized to UDM."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate VM cloning operations, storage migration, backup software modifying VMDK descriptors, snapshot consolidation."
    tuning_guidance = "Add authorized backup and VM management processes to %global_allowed_backup_processes. Adjust threshold based on typical VM count per host."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/vmfs\/volumes\/.*\.vmdk$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_vmdks = count_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file and $modified_vmdks > 5
}
