/*
  MITRE Technique : T1080 - Taint Shared Content
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:36:12.130413+00:00
  Reference       : https://attack.mitre.org/techniques/T1080
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1080_001_Taint_Shared_Content_Network_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification events on network-mounted shared directories from Linux endpoints. Adversaries performing T1080 (Taint Shared Content) write malicious scripts, binaries, or modified files into shared storage locations to achieve lateral movement when other users access the content. This rule fires on writes to common Linux shared mount paths (NFS, CIFS/SMB, SSHFS) that originate from unexpected processes or user contexts."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1080"
    mitre_technique_name = "Taint Shared Content"
    log_prerequisites = "Requires Linux EDR telemetry (e.g., Auditd with FILE_CREATION/FILE_MODIFICATION events, or an EDR agent normalising file write events to UDM). Auditd rules must watch shared mount points with -w <path> -p wa."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate deployment pipelines writing to shared NFS/CIFS mounts, backup agents, configuration management tools (Ansible, Puppet, Chef), and authorised software distribution processes."
    tuning_guidance = "Add authorised deployment and backup process paths to %global_allowed_backup_processes and %global_allowed_admin_tools. Add known-good service accounts performing scheduled writes to %global_allowed_service_accounts. Scope mount path regex to the specific shared directories used in each environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file must reside on a shared/network-mounted path common on Linux
    // Covers NFS mounts (/mnt, /media, /net, /srv/nfs), CIFS/SMB mounts,
    // and common shared data directories
    $file.target.file.full_path = /^\/(?:mnt|media|net|srv|home|data|shared|shares|nfs|cifs|smb|storage|export|remote|nas|san)\// nocase

    // Flag writes of executable or script file types into shared locations
    // Matches shell scripts, Python, Perl, ELF binaries, shared objects,
    // and common archive/payload types
    $file.target.file.full_path = /\.(?:sh|py|pl|rb|php|elf|so|bin|run|bash|ksh|zsh|csh|tcsh|jar|war|tar|gz|tgz|bz2|xz|zip|deb|rpm)$/ nocase

    // Exclude known-good backup and admin tooling
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing authorised writes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1080")
    $primary_entity = array_distinct($file.principal.hostname)
    $written_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
