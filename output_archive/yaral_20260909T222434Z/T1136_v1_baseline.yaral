/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:42:44.714881+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_ESXi_Cloud_Account_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects account creation events on ESXi hosts or associated cloud control plane via audit logs. Adversaries create accounts to establish persistent secondary access without deploying remote access tools. Targets cloud audit telemetry normalised to UDM USER_CREATION events, which captures API-level account provisioning on cloud-managed ESXi infrastructure."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136"
    mitre_technique_name = "Create Account"
    log_prerequisites = "Requires cloud provider audit logs (e.g. CloudTrail, Azure Activity Log, GCP Audit Log) normalised to Chronicle UDM. USER_CREATION events must be populated with principal.user.userid and target.user.userid."
    platform = "ESXi"
    log_source = "cloud_audit"
    false_positives = "Authorised provisioning workflows, infrastructure-as-code pipelines, IT onboarding automation, and break-glass account creation by approved administrators."
    tuning_guidance = "Add known automation and provisioning service principals to %global_allowed_cloud_principals. Add approved administrator accounts to %global_allowed_admin_users to suppress expected privileged provisioning activity."

  events:
    $cloud.metadata.event_type = "USER_CREATION"

    // Exclude known automation and provisioning service principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved administrator accounts performing expected provisioning
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Require a target user to have been created (populated field guard)
    $cloud.target.user.userid != ""

    // Require an acting principal to be identified (not anonymous/system noise)
    $cloud.principal.user.userid != ""

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1136")
    $primary_entity = array_distinct($cloud.principal.hostname)
    $created_account = array_distinct($cloud.target.user.userid)
    $acting_principal = array_distinct($cloud.principal.user.userid)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
