/*
  MITRE Technique : T1001.002 - Steganography
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:29:39.739895+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_002_ESXi_Steganography_C2_Indicators {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential steganography-based C2 activity on ESXi hosts by identifying shell processes invoking image/media manipulation utilities or transferring files with image/document extensions via network-capable tools. Adversaries embed C2 instructions in image or document files transferred to/from the ESXi management plane."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.002"
    mitre_technique_name = "Data Obfuscation: Steganography"
    log_prerequisites = "Requires ESXi shell process telemetry (hostd/shell logs) normalised to UDM PROCESS_LAUNCH. ESXi Shell must be enabled and Chronicle must ingest ESXi syslog or hostd logs."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate administrators using curl/wget to retrieve vendor patches or ISOs; backup agents transferring VM snapshots or OVF/OVA files; authorised image-based diagnostics scripts."
    tuning_guidance = "Add approved administrative scripts and their parent process paths to %global_allowed_admin_tools. Add authorised service accounts performing patch retrieval to %global_allowed_service_accounts. Narrow the file-extension regex if OVA/OVF transfers are common in the environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Execution must originate from an ESXi shell or busybox environment
    $proc.principal.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|busybox)\// nocase

    // Target process is a network transfer or file manipulation utility
    // commonly abused to exfiltrate steganographic payloads or retrieve C2 images
    $proc.target.process.file.full_path = /\/(curl|wget|python|python3|perl|sh|ash|busybox|nc|ncat|openssl|sftp|scp|ftp)\b/ nocase

    // Command line references image, document, or archive file extensions
    // that are typical steganography carriers, or explicit steganography tool flags
    $proc.target.process.command_line = /\.(png|jpg|jpeg|gif|bmp|tif|tiff|webp|pdf|docx?|xlsx?|pptx?|zip|tar|gz|bz2|7z|ova|ovf)\b/ nocase

    // Exclude processes spawned by known-good administrative tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1001.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $suspicious_command = array_distinct($proc.target.process.command_line)
    $initiating_process = array_distinct($proc.principal.process.file.full_path)
    $target_binary = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
