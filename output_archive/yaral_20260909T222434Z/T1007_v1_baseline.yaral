/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:30:42.284894+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1007_001_System_Service_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects execution of common Windows service enumeration commands used by adversaries to discover registered local services. Covers sc.exe query, net start, tasklist /svc, and PowerShell-based service enumeration. Adversaries use this information to identify security tools, running services, and potential targets for lateral movement or privilege escalation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with command-line logging enabled. PowerShell script-block logging (Event 4104) also surfaces Get-Service calls."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT administrators running service health checks, monitoring agents, RMM tools, software deployment scripts, and helpdesk tooling routinely enumerate services. Expect high volume from management hosts."
    tuning_guidance = "Add known administrative hosts or parent process paths to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Consider raising severity when this event is preceded by an unusual parent process (e.g., Office, browser, script interpreter spawned from a non-admin context)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the four canonical Windows service discovery binaries
    (
      // sc.exe query - direct service control manager query
      (
        $proc.target.process.file.full_path = /(?i)\\sc\.exe$/ and
        $proc.target.process.command_line = /(?i)(query|qc|qdescription|enumdepend)/
      )
      or
      // net.exe / net1.exe - net start lists running services
      (
        $proc.target.process.file.full_path = /(?i)\\net1?\.exe$/ and
        $proc.target.process.command_line = /(?i)\bstart\b/
      )
      or
      // tasklist.exe with /svc flag - maps PIDs to service names
      (
        $proc.target.process.file.full_path = /(?i)\\tasklist\.exe$/ and
        $proc.target.process.command_line = /(?i)\/svc/
      )
      or
      // PowerShell Get-Service or Get-WmiObject Win32_Service
      (
        $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh)\.exe$/ and
        $proc.target.process.command_line = /(?i)(Get-Service|Win32_Service|Get-CimInstance.*service|gwmi.*service)/
      )
    )

    // Exclude known administrative and security tooling parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $target_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
