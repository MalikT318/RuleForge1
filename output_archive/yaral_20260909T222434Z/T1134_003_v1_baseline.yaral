/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:41:41.651443+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_Make_And_Impersonate_Token {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects token creation and impersonation via LogonUser/SetThreadToken patterns. Adversaries create a new logon session for a user using LogonUser and then assign the resulting token to a thread via SetThreadToken to impersonate that user and escalate privileges. This rule targets the Windows Security logon event (type 9 - NewCredentials) generated when LogonUser is called with LOGON32_LOGON_NEW_CREDENTIALS, which is the most direct OS-level signal for this technique."
    mitre_tactic = "Privilege Escalation, Defense Evasion"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Requires Windows Security Event Log (Event ID 4624 logon type 9) normalised to UDM USER_LOGIN, or EDR telemetry capturing logon session creation. Audit Logon must be enabled in Advanced Audit Policy."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate applications using runas /netonly (which also generates logon type 9), credential delegation tools, some RMM agents performing network authentication with alternate credentials, and scheduled tasks running under alternate identities."
    tuning_guidance = "Add known-good service accounts that legitimately use alternate credentials to %global_allowed_service_accounts. Add approved administrative tools that use runas /netonly to %global_allowed_admin_tools. Narrow by principal.process.file.full_path to exclude known-good parent processes."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Logon type 9 (NewCredentials) is the direct OS signal for LogonUser
    // called with LOGON32_LOGON_NEW_CREDENTIALS - the primary mechanism
    // used by Make and Impersonate Token. This creates a new token while
    // retaining the caller's local identity but using new credentials for
    // outbound network access, or for SetThreadToken impersonation.
    $auth.extensions.auth.auth_details = /(?i)logon.?type.?9|newcredentials/

    // The logon must originate from a local process (not a remote host),
    // distinguishing programmatic token creation from normal network logons.
    // A non-empty principal process path indicates a local process initiated
    // the logon session rather than an inbound network authentication.
    $auth.principal.process.file.full_path != ""

    // Exclude processes that are known-good administrative tools
    not $auth.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service and automation accounts performing expected
    // credential operations
    not $auth.target.user.userid in %global_allowed_service_accounts

    // Exclude approved admin users performing legitimate impersonation
    not $auth.principal.user.userid in %global_allowed_admin_users

    //(?i) Exclude runas.exe itself as the initiating process - runas /netonly
    // is a common legitimate source of logon type 9 and is better handled
    // via the admin tools list; flag non-runas processes as higher suspicion
    not $auth.principal.process.file.full_path = /\\runas\.exe$/ nocase

    // Exclude SYSTEM-initiated logons which are normal OS behaviour
    not $auth.principal.user.userid = /(?i)^(SYSTEM|LOCAL SERVICE|NETWORK SERVICE)$/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity = array_distinct($auth.principal.hostname)
    $initiating_process = array_distinct($auth.principal.process.file.full_path)
    $impersonated_user = array_distinct($auth.target.user.userid)
    $source_user = array_distinct($auth.principal.user.userid)

  condition:
    $auth
}
