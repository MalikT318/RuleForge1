/*
  MITRE Technique : T1211 - Exploitation for Stealth
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:50:48.604472+00:00
  Reference       : https://attack.mitre.org/techniques/T1211
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1211_001_Linux_Logging_Suppression_Evasion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process launches consistent with exploitation for stealth on Linux: attempts to suppress, truncate, or manipulate audit/syslog/EDR logging pipelines. Covers truncation of log files via shell redirection, killing of logging daemons, unloading of audit kernel modules, and manipulation of auditd rules to blind the audit subsystem. These behaviors are the direct OS-level result of T1211 exploitation-for-stealth activity."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1211"
    mitre_technique_name = "Exploitation for Stealth"
    log_prerequisites = "Requires Linux EDR or auditd PROCESS_LAUNCH telemetry with command-line arguments populated in target.process.command_line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Log rotation daemons (logrotate) truncating logs on schedule; administrators stopping/restarting auditd for maintenance; kernel module management during OS upgrades; security team testing."
    tuning_guidance = "Add known log-rotation and maintenance service accounts to %global_allowed_service_accounts. Add approved admin tooling paths to %global_allowed_admin_tools. Scope by time-of-day if maintenance windows are predictable."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the union of stealth-enabling behaviors via a single broad anchor,
    // then refine with per-behavior sub-patterns below.
    // Pattern group A: truncation of audit/syslog/EDR log files via shell builtins
    // Pattern group B: stopping or killing logging daemons
    // Pattern group C: removing or flushing auditd rules (auditctl -D / --delete)
    // Pattern group D: unloading audit kernel module
    // Pattern group E: disabling systemd journal or syslog units
    // Pattern group F: writing to /dev/null to redirect log output

    (
      // A: Truncating log files - dd, truncate, or shell redirect targets
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(truncate|dd)$/ nocase
        and (
          $proc.target.process.command_line = /\/(var\/log|var\/audit|run\/log)\// nocase
          or $proc.target.process.command_line = /audit\.log/ nocase
          or $proc.target.process.command_line = /syslog/ nocase
          or $proc.target.process.command_line = /messages/ nocase
          or $proc.target.process.command_line = /secure/ nocase
        )
      )
      or
      // B: Killing logging daemons by name
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(kill|killall|pkill)$/ nocase
        and $proc.target.process.command_line = /(?i)(auditd|syslogd|rsyslogd|syslog-ng|journald|systemd-journald|osqueryd|falcod|filebeat|fluentd|td-agent)/ nocase
      )
      or
      // C: Flushing or deleting all auditd rules
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/auditctl$/ nocase
        and (
          $proc.target.process.command_line = /\-D/ nocase
          or $proc.target.process.command_line = /\-\-delete/ nocase
          or $proc.target.process.command_line = /\-e\s*0/ nocase
        )
      )
      or
      // D: Unloading audit kernel module
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(rmmod|modprobe)$/ nocase
        and $proc.target.process.command_line = /(?i)(audit|kauditd)/ nocase
        and (
          $proc.target.process.command_line = /\-r/ nocase
          or $proc.target.process.command_line = /--remove/ nocase
          or $proc.target.process.file.full_path = /rmmod$/ nocase
        )
      )
      or
      // E: Disabling systemd logging units
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/systemctl$/ nocase
        and (
          $proc.target.process.command_line = /(?i)(stop|disable|mask)/ nocase
          and $proc.target.process.command_line = /(?i)(auditd|rsyslog|syslog|systemd-journald|filebeat|fluentd|osqueryd)/ nocase
        )
      )
      or
      // F: Redirecting audit or syslog output to /dev/null via tee or explicit redirect
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/tee$/ nocase
        and $proc.target.process.command_line = /\/dev\/null/ nocase
        and (
          $proc.target.process.command_line = /(?i)(audit|syslog|journal|messages|secure)/ nocase
        )
      )
    )

    // Exclude known-good service and admin accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1211")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_observed = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
