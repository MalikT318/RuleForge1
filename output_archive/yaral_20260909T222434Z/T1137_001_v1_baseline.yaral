/*
  MITRE Technique : T1137.001 - Office Template Macros
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:43:52.579163+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_001_Office_Template_Macro_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification or upload of Office template files (Normal.dotm, Personal.xlsb, or other macro-enabled templates) via Microsoft 365 audit logs. Adversaries abuse these templates to embed VBA macros that execute on every Office application launch, achieving persistence without traditional malware installation."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.001"
    mitre_technique_name = "Office Application Startup: Office Template Macros"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log with SharePoint, OneDrive, and Office file activity events ingested into Chronicle. FileModified, FileUploaded, and FileSyncUploadedFull operations must be enabled."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate IT administrators deploying standardised Office templates across the organisation. Users customising their own Normal.dotm for approved macro workflows. Template management via SCCM or Intune."
    tuning_guidance = "Add known template-management service accounts to %global_allowed_service_accounts. Add approved admin users who routinely deploy templates to %global_allowed_admin_users. Scope further by correlating with user risk signals if available."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Match macro-enabled Office template file extensions
    // dotm = Word macro-enabled template, xltm = Excel macro-enabled template
    // xlsb = Excel binary workbook (used for PERSONAL.XLSB persistence)
    // potm = PowerPoint macro-enabled template
    $file.target.file.full_path = /(?i)\.(dotm|xltm|xlsb|potm|dotx|xltx)$/

    // Specifically flag high-risk template names associated with T1137.001
    // Normal.dotm (Word), PERSONAL.XLSB (Excel), Book.xltm, Sheet.xltm
    $file.target.file.full_path = /(?i)(normal\.dotm|personal\.xlsb|book\.xlt[mx]|sheet\.xlt[mx]|startup|xlstart|templates)/

    // Exclude known-good service and automation accounts
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.001")
    $primary_entity = array_distinct($file.principal.user.userid)
    $modified_template = array_distinct($file.target.file.full_path)

  condition:
    $file
}
