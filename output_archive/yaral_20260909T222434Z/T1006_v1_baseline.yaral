/*
  MITRE Technique : T1006 - Direct Volume Access
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:30:19.089408+00:00
  Reference       : https://attack.mitre.org/techniques/T1006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1006_Direct_Volume_Access_Exfil_Via_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects large-volume or anomalous outbound flows from internal hosts to external destinations that may indicate direct volume access and subsequent data exfiltration. Adversaries who bypass file system controls via direct volume access often stage and exfiltrate bulk data; this rule catches the network-observable result: unusually large outbound transfers to non-internal destinations on common exfiltration ports or non-standard high ports."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1006"
    mitre_technique_name = "Direct Volume Access"
    log_prerequisites = "Requires firewall or perimeter flow logs with bytes_sent/bytes_out populated. NetFlow, IPFIX, or stateful firewall session logs are suitable."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised backup jobs, large software deployments, CDN origin pulls, approved cloud sync agents, vulnerability scanners. Tune using %global_allowed_backup_processes, %global_allowed_scanners, and %global_allowed_domains."
    tuning_guidance = "Raise the bytes threshold if legitimate bulk transfers are common in the environment. Add known-good external destinations to %global_allowed_domains and approved source addresses to %global_allowed_mgmt_sources. Consider narrowing to specific destination port ranges if the environment has well-defined egress policy."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Source must be an internal address; exclude known-good internal management sources
    $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Destination must be external (not RFC-1918)
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external destinations (CDN, update services, approved cloud)
    not $net.target.domain in %global_allowed_domains

    // Exclude authorised scanners reaching out
    not $net.principal.ip in %global_allowed_scanners

    // Large outbound byte count - indicative of bulk data movement
    // 100 MB threshold; tune per environment
    $net.network.sent_bytes > 104857600

    // Target ports: common exfiltration vectors or non-standard high ports
    // Port 443 (HTTPS), 80 (HTTP), 8080, 8443, or high ephemeral ports > 1024
    // Exclude well-known internal service ports (e.g., 53, 123, 389, 636)
    $net.target.port != 53
    $net.target.port != 123
    $net.target.port != 389
    $net.target.port != 636
    $net.target.port != 88
    $net.target.port > 79

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_out = max($net.network.sent_bytes)

  condition:
    $net
}
