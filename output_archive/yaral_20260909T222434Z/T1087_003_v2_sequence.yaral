/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:26:00.957359+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_EmailAccountDiscovery_AuthThenDirectoryEnum {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with email account enumeration via identity provider: an interactive or programmatic authentication event followed by a directory or group read/enumeration event within a short window. This is additive coverage over process-launch command-line rules, focusing on identity-plane signals such as Entra ID / Okta / AD audit logs rather than endpoint telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Requires identity provider audit and sign-in logs normalised to Chronicle UDM. Covers Entra ID, Okta, and on-premises Active Directory audit events. USER_LOGIN events must populate principal.user.userid and principal.ip. USER_RESOURCE_ACCESS events must populate target.resource.name or target.application."
    platform = "Windows"
    log_source = "identity"
    false_positives = "IT administrators performing routine directory audits, HR tooling that reads the global address list, automated provisioning pipelines, directory synchronisation service accounts, and legitimate Exchange hybrid connector accounts."
    tuning_guidance = "Add known service and automation accounts to %global_allowed_service_accounts. Add approved admin users to %global_allowed_admin_users. Add approved cloud principals to %global_allowed_cloud_principals. Narrow the target.resource.name regex if the tenant uses a non-standard naming convention for directory or address-list resources."

  events:
    // Event 1: Successful interactive or non-interactive sign-in from a user
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %rfc1918_internal
    $auth.principal.user.userid = $userid

    // Event 2: Directory or address-list enumeration access event following the login
    $dir.metadata.event_type = "USER_RESOURCE_ACCESS"
    $dir.principal.user.userid = $userid
    (
      $dir.target.resource.name = /(?i)(global.?address.?list|GAL|address.?book|directory|mailbox|exchange.*recipient|all.?users|all.?contacts|distribution.?group)/ nocase
      or
      $dir.target.application = /(?i)(exchange|outlook|microsoft.?365|office.?365|entra|azure.?ad|active.?directory)/ nocase
    )
    not $dir.principal.user.userid in %global_allowed_service_accounts
    not $dir.principal.user.userid in %global_allowed_cloud_principals

    // Chronological ordering: login must precede the directory access
    $auth.metadata.event_timestamp.seconds <= $dir.metadata.event_timestamp.seconds

  match:
    $userid over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($userid)
    $source_ips = array_distinct($auth.principal.ip)
    $accessed_resources = array_distinct($dir.target.resource.name)
    $accessed_applications = array_distinct($dir.target.application)
    $auth_event_count = count($auth.metadata.id)
    $dir_access_count = count($dir.metadata.id)

  condition:
    $auth and $dir
}
