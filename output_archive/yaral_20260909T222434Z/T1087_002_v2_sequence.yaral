/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:25:25.816012+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_LDAP_Enumeration_Followed_By_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects LDAP enumeration queries followed by external network connections from the same source, indicating potential domain account reconnaissance with data exfiltration or C2 communication."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires firewall or proxy logs with LDAP protocol visibility and outbound connection tracking."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate directory synchronization tools, monitoring systems querying LDAP then reporting to external SaaS platforms, backup solutions with cloud destinations."
    tuning_guidance = "Add known directory sync sources to %global_allowed_service_accounts or approved external destinations to %global_allowed_domains."

  events:
    $ldap.metadata.event_type = "NETWORK_CONNECTION"
    $ldap.target.port = 389 or $ldap.target.port = 636 or $ldap.target.port = 3268 or $ldap.target.port = 3269
    $ldap.principal.ip = $source_ip
    not $ldap.principal.ip in %rfc1918_internal

    $external.metadata.event_type = "NETWORK_CONNECTION"
    not $external.target.ip in %rfc1918_internal
    $external.principal.ip = $source_ip
    $external.target.port = 443 or $external.target.port = 80 or $external.target.port = 8080 or $external.target.port = 53
    
    $ldap.metadata.event_timestamp.seconds <= $external.metadata.event_timestamp.seconds

  match:
    $source_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($ldap.principal.ip)
    $ldap_targets = array_distinct($ldap.target.ip)
    $external_destinations = array_distinct($external.target.ip)
    $connection_count = count($external.metadata.id)

  condition:
    $ldap and $external and #external >= 3
}
