/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:50:02.252988+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Socket_Filter_Backdoor_Network_Trigger {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable behaviour consistent with T1205.002 socket filter (BPF/WinPcap) backdoors on Windows. Adversaries install packet filters on raw sockets; activation requires sending a crafted trigger packet to the victim. This rule identifies anomalous inbound connections that match common trigger patterns: non-standard high ports, unusual protocol/port combinations, or repeated low-payload probes from external sources to a single internal host - all without a corresponding established session. Excludes known-good scanner and management sources."
    mitre_tactic    = "Defense Evasion, Persistence, Command and Control"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Requires perimeter firewall or network flow logs with per-flow byte counts, packet counts, and connection state. Flows must include source/destination IP, port, protocol, and byte/packet counters."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "Legitimate port-knocking implementations, authorised network monitoring probes, vulnerability scanners, IoT keep-alive packets, UDP health checks from load balancers."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners. Add approved remote management source ranges to %global_allowed_mgmt_sources. Raise the packet-count threshold if legitimate low-payload UDP traffic is common in the environment. Narrow target port ranges to those observed in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Inbound direction only - socket filter triggers arrive from external sources
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal

    // Exclude authorised scanning and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Socket filter triggers are characteristically tiny - a crafted magic packet
    // BPF/WinPcap triggers are typically single-packet or very low byte-count probes
    // Threshold: fewer than 3 packets and fewer than 200 bytes total in the flow
    $net.network.sent_packets < 3
    $net.network.sent_bytes < 200

    // Target high/unusual ports commonly used for covert trigger channels.
    // Legitimate services rarely listen on ephemeral or obscure ports without
    // established sessions. Port 0 is a strong anomaly indicator.
    (
      $net.target.port > 49151 or
      $net.target.port = 0 or
      // ICMP-type traffic repurposed as trigger (protocol 1 mapped to port 0 in UDM)
      // Raw socket listeners on uncommon low ports not associated with standard services
      ($net.target.port > 1024 and $net.target.port < 1100)
    )

    // Protocol anomalies: UDP is preferred for passive socket filter triggers
    // because it is connectionless and leaves minimal state on firewalls
    $net.network.ip_protocol = "UDP"

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)
    $packets_sent = max($net.network.sent_packets)

  condition:
    $net
}
