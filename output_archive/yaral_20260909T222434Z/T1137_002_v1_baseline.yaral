/*
  MITRE Technique : T1137.002 - Office Test
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:44:04.608333+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_002_Office_Test_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of the Microsoft Office Test registry key used to load arbitrary DLLs on Office application startup. Adversaries abuse this undocumented key to achieve persistence by specifying a malicious DLL path under HKCU or HKLM Software\\Microsoft\\Office test\\Special\\Perf."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.002"
    mitre_technique_name = "Office Application Startup: Office Test"
    log_prerequisites = "Requires Windows registry telemetry from EDR or Sysmon (Event ID 13). UDM event types REGISTRY_CREATION or REGISTRY_MODIFICATION must be populated with target.registry.registry_key."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Microsoft Office developers or QA engineers running internal debug builds; enterprise software packaging tools that pre-configure Office registry settings during deployment."
    tuning_guidance = "Add known-good software deployment or Office packaging parent processes to %global_allowed_admin_tools. If the registry key is legitimately used in your environment, scope exclusions to specific hosts via %global_allowed_script_hosts."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"

    $reg.target.registry.registry_key = /(?i)\\Software\\Microsoft\\Office test\\Special\\Perf/

    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1137.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)
    $parent_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
