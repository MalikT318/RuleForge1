/*
  MITRE Technique : T1216 - System Script Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:51:05.794612+00:00
  Reference       : https://attack.mitre.org/techniques/T1216
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_001_System_Script_Proxy_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects abuse of Microsoft-signed system scripts (e.g. SyncAppvPublishingServer.vbs, pubprn.vbs, manage-bde.wsf, winrm.vbs, slmgr.vbs) to proxy execution of attacker-controlled payloads. These scripts are trusted by AppLocker and SRP but can be passed arbitrary arguments to launch unsigned code."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1216"
    mitre_technique_name = "System Script Proxy Execution"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate SCCM/Intune software deployment using SyncAppvPublishingServer; volume licensing activation scripts using slmgr.vbs; WinRM configuration by administrators using winrm.vbs."
    tuning_guidance = "Add known-good parent processes (e.g. SCCM client, deployment agents) to %global_allowed_admin_tools. Narrow the command-line regex if specific script names generate noise in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Script host must be a Windows built-in interpreter
    $proc.target.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase

    // One of the known Microsoft-signed proxy scripts is being invoked
    $proc.target.process.command_line = /(?i)(syncappvpublishingserver\.vbs|pubprn\.vbs|manage-bde\.wsf|winrm\.vbs|slmgr\.vbs|appsyncpublishingserver\.vbs|inetsrv\\adsutil\.vbs|syncappvpublishingserver\.ps1)/ nocase

    // Command line contains a suspicious argument pattern:
    // a remote URI, an unusual file extension, or a path outside System32/SysWOW64
    $proc.target.process.command_line = /(?i)(https?:\/\/|\\\\[^\\]+\\[^\\]+|\.ps1|\.bat|\.cmd|\.hta|\.js|\.vbe|\.jse|%temp%|%appdata%|\\users\\[^\\]+\\(appdata|downloads|desktop|temp))/ nocase

    // Exclude approved administrative and deployment tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service and automation accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1216")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $command_line      = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $user              = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
