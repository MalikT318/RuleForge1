/*
  MITRE Technique : T1220 - XSL Script Processing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:51:55.481244+00:00
  Reference       : https://attack.mitre.org/techniques/T1220
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1220_001_XSL_Script_Processing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects XSL script processing abuse via msxsl.exe or wmic.exe with XSL/XML arguments, a technique used to execute arbitrary scripts embedded in XSL files while bypassing application control. Covers both the standalone msxsl.exe utility and the built-in wmic.exe /format switch which also processes XSL."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1220"
    mitre_technique_name = "XSL Script Processing"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (Process Create) normalised to UDM PROCESS_LAUNCH with command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate use of msxsl.exe for XML/XSL transformations by developers or build pipelines; wmic.exe with /format for legitimate WMI output formatting in admin scripts."
    tuning_guidance = "Add known-good parent processes (e.g., build servers, CI/CD agents) to %global_allowed_admin_tools. Scope by principal.hostname to exclude developer workstations if needed. Consider narrowing on remote URL patterns in the command line for higher fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match msxsl.exe (may be dropped anywhere) or wmic.exe abusing /format with XSL
    (
      $proc.target.process.file.full_path = /(?i)\\msxsl\.exe$/ or
      (
        $proc.target.process.file.full_path = /(?i)\\wmic\.exe$/ and
        $proc.target.process.command_line = /(?i)\/format/ and
        $proc.target.process.command_line = /(?i)\.(xsl|xml|xslt)/
      )
    )

    // For msxsl.exe: command line references an XSL or XML file (including remote URLs)
    // This covers both local file and remote URL invocation patterns
    (
      $proc.target.process.file.full_path = /(?i)\\wmic\.exe$/ or
      $proc.target.process.command_line = /(?i)\.(xsl|xml|xslt)/
    )

    // Exclude approved administrative tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1220")
    $primary_entity = array_distinct($proc.principal.hostname)
    $process_command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
