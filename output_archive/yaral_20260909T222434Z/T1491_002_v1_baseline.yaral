/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:55:29.445898+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_External_Defacement_Web_Content_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects high-volume or anomalous HTTP responses from externally-facing web infrastructure that may indicate website defacement. Looks for large numbers of HTTP error responses (403, 404, 500) or unexpected successful responses to paths associated with web root content modification, as seen when an adversary replaces or alters publicly-served web content."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires firewall or perimeter proxy logs with HTTP method, response code, URI path, and source/destination IP fields normalised into UDM NETWORK_HTTP events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate content management system (CMS) deployments, authorised web developers publishing updates, automated deployment pipelines pushing new web content, vulnerability scanners probing web roots."
    tuning_guidance = "Add authorised deployment source IPs or subnets to %global_allowed_scanners and %global_allowed_admin_tools. Add known-good external CDN or update domains to %global_allowed_domains. Narrow the URI path regex to match only the web root paths relevant to each client's web stack (e.g., index.html, index.php, default.aspx)."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Traffic must originate from outside internal address space
    not $net.principal.ip in %rfc1918_internal

    // Target must be an internal server (web server on perimeter)
    $net.target.ip in %rfc1918_internal

    // Focus on standard web ports
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )

    // Detect HTTP methods used to write or replace web content
    (
      $net.network.http.method = "PUT" or
      $net.network.http.method = "POST" or
      $net.network.http.method = "DELETE" or
      $net.network.http.method = "PATCH"
    )

    // URI paths targeting web root index or common defacement targets
    $net.target.url = /(?i)\/(index\.(html?|php|asp|aspx|jsp|cfm)|default\.(html?|asp|aspx)|home\.(html?|php)|wp-login\.php|xmlrpc\.php|admin|shell|webshell|upload)(\?.*)?$/

    // Exclude known-good external domains and approved scanners
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity = array_distinct($net.target.ip)
    $http_method = array_distinct($net.network.http.method)
    $targeted_url = array_distinct($net.target.url)
    $source_ip = array_distinct($net.principal.ip)

  condition:
    $net
}
