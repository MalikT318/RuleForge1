/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:53:34.466749+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Execution_Guardrails_Env_Check_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes on Linux that perform environment fingerprinting consistent with execution guardrails - checking hostname, domain membership, IP configuration, filesystem mounts, or hardware identifiers before proceeding. Adversaries use these checks to ensure payloads only execute on intended targets, reducing collateral exposure. Detected via shell or interpreter commands that chain environment-probing utilities with conditional logic."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with full command-line capture (execve syscall auditing). Auditd rule: -a always,exit -F arch=b64 -S execve."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate configuration management tools (Ansible, Puppet, Chef) that probe environment before applying changes; system initialisation scripts; cloud-init; container entrypoint scripts performing environment validation; monitoring agents."
    tuning_guidance = "Add known configuration management and orchestration parent processes to %global_allowed_admin_tools. Suppress alerts from known automation service accounts via %global_allowed_service_accounts. Narrow scope by requiring the suspicious command to be followed by a network or file event within a short window."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target interpreters and shells commonly used to implement guardrail logic
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|node)$/ nocase

    // Command line must contain environment-probing patterns chained with conditional execution
    // Matches: hostname, domainname, ip addr/route, uname, dmesg, dmidecode, lscpu, lshw,
    // /etc/machine-id, /proc/net, mount, df checks combined with conditional operators
    $proc.target.process.command_line = /(?i)(hostname|domainname|dnsdomainname|hostnamectl|ip\s+(addr|route|link)|ifconfig|uname|dmidecode|lscpu|lshw|lsblk|blkid|cat\s+\/proc\/(net|cpuinfo|meminfo|version|sys)|cat\s+\/etc\/(machine-id|hostname|os-release|resolv\.conf)|mount|df\s+-|getent\s+(hosts|passwd)|ldapsearch|realm\s+list|sssd|adcli)/ nocase

    // Must also contain conditional execution logic indicating guardrail pattern
    $proc.target.process.command_line = /(\|\||&&|;\s*if\s|then\s|case\s|\[\s|\[\[|test\s+-[a-z]|\$\(|\`[^\`]+\`)/ nocase

    // Exclude known-good automation and admin tooling parents
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known automation service accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude known script hosts approved for environment probing
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_observed = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
