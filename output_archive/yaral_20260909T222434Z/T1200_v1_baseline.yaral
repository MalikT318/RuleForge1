/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:48:43.835326+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_Hardware_Addition_New_Network_Device_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable signals of a newly introduced hardware device on the perimeter: unexpected internal source IPs communicating outbound that do not belong to known managed hosts, or new internal sources appearing for the first time making external connections. Hardware additions such as rogue wireless access points, network taps, or implants often generate distinctive outbound traffic patterns shortly after being connected - small bursts to external IPs on non-standard ports, or beaconing to external destinations from an IP not previously seen in the environment. This rule flags outbound connections from internal addresses to external destinations on ports commonly abused by hardware implants and rogue AP management channels."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs with source IP, destination IP, destination port, and bytes transferred normalised into UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Newly provisioned legitimate servers, IoT devices, printers, or network appliances making their first outbound connection. VPN concentrators, DHCP-assigned endpoints cycling addresses. Authorised wireless access points phoning home to cloud management platforms."
    tuning_guidance = "Add known-good internal management source IPs to %global_allowed_mgmt_sources. Add approved external management domains/CDNs to %global_allowed_domains. Narrow the port list to ports not used by any approved internal appliance in the environment. Consider raising the threshold on bytes_out if bulk-transfer appliances are present."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal RFC1918 address
    $net.principal.ip = $src_ip
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not RFC1918)
    not $net.target.ip in %rfc1918_internal

    // Ports commonly associated with hardware implant C2, rogue AP management,
    // passive tap exfiltration, or out-of-band management channels.
    // Covers: non-standard SSH variants, common implant beaconing ports,
    // rogue AP cloud management (Meraki/Ubiquiti/TP-Link style), DNS-over-HTTPS
    // alternatives, and raw TCP beaconing ranges used by commercial implants.
    (
        $net.target.port = 4444 or
        $net.target.port = 4445 or
        $net.target.port = 1194 or
        $net.target.port = 8291 or
        $net.target.port = 8443 or
        $net.target.port = 8880 or
        $net.target.port = 8888 or
        $net.target.port = 9090 or
        $net.target.port = 9443 or
        $net.target.port = 2222 or
        $net.target.port = 2223 or
        $net.target.port = 6667 or
        $net.target.port = 6697 or
        $net.target.port = 31337 or
        $net.target.port = 1337 or
        $net.target.port = 5555 or
        $net.target.port = 7777
    )

    // Exclude known authorised management sources (e.g. jump hosts, scanners)
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude known authorised scanners that may probe external ranges
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
