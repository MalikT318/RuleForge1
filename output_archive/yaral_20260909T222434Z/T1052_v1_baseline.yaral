/*
  MITRE Technique : T1052 - Exfiltration Over Physical Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:34:43.565388+00:00
  Reference       : https://attack.mitre.org/techniques/T1052
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_Exfiltration_Over_Removable_Media {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects bulk file copy operations targeting removable media drive letters, a primary indicator of exfiltration over physical medium. Monitors process command lines referencing removable drive paths (D:\ through Z:\) combined with copy, move, or archiving utilities. This targets the OS-level file transfer mechanism adversaries use to stage data on USB drives or external storage before physical removal."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052"
    mitre_technique_name = "Exfiltration Over Physical Medium"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture, or Sysmon Event ID 1. Command-line logging must be enabled in Windows audit policy."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate backup operations to external drives, IT imaging workflows, authorized data transfers to removable media, software deployment via USB."
    tuning_guidance = "Add authorized backup process paths to %global_allowed_backup_processes. Add known IT admin accounts to %global_allowed_admin_users. Consider scoping by time-of-day if removable media use is restricted to business hours. Narrow the drive letter regex if specific drive letters are reserved for approved use."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target known file copy, move, and archiving utilities used to stage data on removable media
    $proc.target.process.file.full_path = /\\(cmd\.exe|powershell\.exe|pwsh\.exe|robocopy\.exe|xcopy\.exe|copy\.exe|move\.exe|7z\.exe|winrar\.exe|wzip\.exe|tar\.exe|compact\.exe|bitsadmin\.exe)$/ nocase

    // Command line must reference a removable/external drive letter path (D: through Z:)
    // Excludes C: (system) and A:/B: (legacy floppy) to focus on removable media
    $proc.target.process.command_line = /[D-Zd-z]:\\/ nocase

    // Command line must contain a copy, move, compress, or transfer verb
    $proc.target.process.command_line = /(\bcopy\b|\bmove\b|\brobocopy\b|\bxcopy\b|\bmv\b|\bcp\b|\bcompress\b|\badd\b|\ba\b|\bTransfer\b|\bSend\b|\bOut-File\b|\bSet-Content\b|\bAdd-Content\b)/ nocase

    // Exclude authorized backup and admin processes
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1052")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_observed = array_distinct($proc.target.process.command_line)
    $initiating_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
