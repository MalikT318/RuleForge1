/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:34:26.104597+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_001_Network_Share_Data_Collection_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes reading or copying data from mounted network shares on Linux. Adversaries enumerate and stage files from SMB/NFS/CIFS mounts under /mnt, /media, /run/user, or /tmp as part of collection prior to exfiltration. The rule fires on process launches that combine a file-staging or copy utility with a source path consistent with a network share mount point."
    mitre_tactic    = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with full command-line capture (execve syscall arguments). Auditd rule: -a always,exit -F arch=b64 -S execve -k network_share_collection."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Backup agents reading from NFS/SMB mounts, legitimate sysadmin rsync/cp jobs, software deployment pipelines staging packages from shared storage, container orchestration pulling artifacts from shared volumes."
    tuning_guidance = "Add authorised backup or deployment process paths to %global_allowed_backup_processes. Add known service accounts performing scheduled share reads to %global_allowed_service_accounts. Narrow the mount-path regex if your environment uses non-standard mount points."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target a file-staging, copy, archive, or enumeration utility
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin)\/(cp|rsync|scp|tar|zip|find|ls|cat|dd|mv|curl|wget|python[23]?|perl|ruby|bash|sh|dash|zsh|ksh)$/ nocase

    // Command line references a path consistent with a network share mount point:
    // /mnt/*, /media/*, /run/user/*/gvfs/*, /var/run/user/*/gvfs/*,
    // /net/*, /srv/*, or explicit smb/nfs/cifs path fragments
    $proc.target.process.command_line = /(\/(mnt|media|net|srv)\/[^\s]+|\/(run|var\/run)\/user\/[0-9]+\/gvfs\/[^\s]+|\/\/([\w\-\.]+)\/[^\s]+|smb:\/\/|nfs:\/\/|cifs:\/\/)/ nocase

    // Exclude known-good backup and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity = array_distinct($proc.principal.hostname)
    $actor_userid = array_distinct($proc.principal.user.userid)
    $share_cmdline = array_distinct($proc.target.process.command_line)
    $spawning_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
