/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:47:27.646109+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_SupplyChain_SoftwareUpdate_Suspicious_Network_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network connections from software update or installer processes to unexpected external destinations. Compromised software supply chain artifacts often beacon out to attacker infrastructure immediately after installation or update. This rule targets the network-observable behaviour: an update/installer binary making an outbound connection to a non-internal destination on uncommon ports or with anomalous timing. Covers T1195.002 post-compromise callback phase visible at the perimeter."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Compromise Software Supply Chain: Compromise Software Supply Chain"
    log_prerequisites = "Requires firewall or proxy perimeter logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source IP must be populated. Destination IP and port must be populated. Internal address exclusion relies on %rfc1918_internal reference list being maintained."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate software update services contacting vendor CDNs or update endpoints. Patch management systems (WSUS, SCCM, Intune) making outbound connections. Security tools performing cloud lookups. Ensure %global_allowed_domains and %rfc1918_internal are well-maintained to reduce noise."
    tuning_guidance = "Add known-good update service source IPs or destination domains to %global_allowed_domains. Add internal scanner or proxy egress IPs to %global_allowed_scanners. Narrow the destination port list if the environment uses a fixed egress proxy. Consider raising the risk score if the destination port is non-standard (not 80/443)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Exclude all RFC-1918 internal destinations - supply chain callbacks go external
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external update and CDN domains
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised vulnerability scanners and security testing sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved remote management egress sources
    not $net.principal.ip in %global_allowed_remote_mgmt

    // Focus on ports commonly abused by supply chain implants:
    // non-standard high ports, common C2 ports, or encrypted channels
    // that deviate from expected update traffic (80/443 to known CDNs)
    // We flag connections on ports that are NOT standard web (80, 443)
    // OR connections on 443/80 that are NOT to known-good domains (covered above)
    // Suspicious high-port or non-web egress indicative of implant callback
    (
      $net.target.port = 4444 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 1080 or
      $net.target.port = 3389 or
      $net.target.port = 4443 or
      $net.target.port = 9001 or
      $net.target.port = 9050 or
      $net.target.port = 6667 or
      $net.target.port = 6666 or
      $net.target.port = 1337 or
      $net.target.port = 31337 or
      $net.target.port = 8888 or
      $net.target.port = 2222 or
      $net.target.port = 5555
    )

    // Capture destination for outcome enrichment
    $net.target.ip = $dest_ip

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($dest_ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hostnames = array_distinct($net.target.hostname)

  condition:
    $net
}
