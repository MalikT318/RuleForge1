/*
  MITRE Technique : T1491.001 - Internal Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:55:10.142045+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_001_ESXi_Internal_Defacement {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of ESXi host configuration files commonly targeted for internal defacement, including the DCUI welcome banner, /etc/motd, /etc/issue, and the hostd welcome message. Adversaries modify these files to intimidate users or signal compromise after achieving their primary objectives."
    mitre_tactic    = "Impact"
    mitre_technique = "T1491.001"
    mitre_technique_name = "Defacement: Internal Defacement"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised to UDM PROCESS_LAUNCH, capturing command-line arguments. ESXi shell logging must be enabled (esxcli system settings advanced set -o /UserVars/SuppressShellWarning)."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised ESXi administrators updating MOTD or login banners via change-management processes. Automated configuration management tools (Ansible, Puppet) applying baseline hardening."
    tuning_guidance = "Add approved automation service accounts to %global_allowed_service_accounts. Add approved management hosts to %global_allowed_mgmt_sources. Scope to known-bad write patterns if banner updates are routine in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target shell utilities used to write or overwrite files on ESXi
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(vi|vim|sed|tee|cp|mv|echo|printf|busybox)$/ nocase

    // Match writes to ESXi banner, MOTD, issue, or DCUI configuration paths
    $proc.target.process.command_line = /(?i)(\/etc\/motd|\/etc\/issue|\/etc\/vmware\/welcome|\/etc\/vmware\/hostd\/config\.xml|\/etc\/vmware\/rhttpproxy|\/etc\/banner|dcui|\/usr\/lib\/vmware\/hostd\/docroot)/ nocase

    // Exclude known-good service and automation accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved admin tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1491.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $actor_userid      = array_distinct($proc.principal.user.userid)
    $command_observed  = array_distinct($proc.target.process.command_line)
    $process_path      = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
