/*
  MITRE Technique : T1129 - Shared Modules
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:40:15.119782+00:00
  Reference       : https://attack.mitre.org/techniques/T1129
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1129_001_Suspicious_Shared_Module_Load_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network connections originating from processes that may be loading and executing shared modules (.so files) from suspicious or writable paths on Linux. On the network perimeter, this manifests as unexpected outbound connections from hosts that have recently loaded shared objects from non-standard locations such as /tmp, /dev/shm, or user home directories. This rule targets the C2 callback phase that commonly follows shared module execution on Linux endpoints."
    mitre_tactic = "Execution"
    mitre_technique = "T1129"
    mitre_technique_name = "Shared Modules"
    log_prerequisites = "Requires firewall or perimeter flow logs with source IP, destination IP, destination port, and byte counts. Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate software update services, telemetry agents, and monitoring daemons making outbound connections on uncommon ports. Cloud-native workloads with dynamic plugin architectures may trigger this rule."
    tuning_guidance = "Add known-good internal source addresses to %rfc1918_internal exclusions. Add approved external destinations to %global_allowed_domains. Narrow the destination port range if your environment has a well-defined egress policy. Raise the risk score if the destination port is in the range 4444-4445, 1337, or 31337."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Exclude connections to known internal address space - shared module C2 callbacks go external
    not $net.target.ip in %rfc1918_internal

    // Exclude connections to approved external destinations
    not $net.target.domain.name in %global_allowed_domains

    // Exclude connections from approved scanners and security tooling sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude connections from approved remote management sources
    not $net.principal.ip in %global_allowed_remote_mgmt

    // Focus on non-standard high ports commonly used by implants loaded via dlopen/dlsym
    // Exclude well-known service ports (80, 443, 53, 22, 25, 123, 8080, 8443)
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 22
    $net.target.port != 25
    $net.target.port != 123
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 67
    $net.target.port != 68
    $net.target.port != 514
    $net.target.port != 161
    $net.target.port != 162

    // Target ephemeral and implant-typical port ranges
    // Shared module implants frequently beacon on high ports or low non-service ports
    (
      ($net.target.port >= 1024 and $net.target.port <= 65535) or
      ($net.target.port >= 1 and $net.target.port <= 1023)
    )

    // Require a source host to be identifiable for entity tracking
    $net.principal.hostname != ""

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1129")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_domains = array_distinct($net.target.domain.name)

  condition:
    $net
}
