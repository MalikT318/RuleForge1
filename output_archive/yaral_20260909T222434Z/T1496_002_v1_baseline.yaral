/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:56:48.258171+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_Bandwidth_Hijacking_High_Volume_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential bandwidth hijacking (proxyjacking, botnet relay, or internet-wide scanning) by identifying hosts generating anomalously high volumes of outbound connections to non-internal destinations on a wide spread of destination ports. This pattern is consistent with proxyware abuse, cryptomining pool relay, or scanning activity leveraging a co-opted host's bandwidth."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Bandwidth Hijacking"
    log_prerequisites = "Requires firewall or perimeter flow logs with per-flow byte counts, connection counts, or summarised session records normalised into UDM NETWORK_FLOW or NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate CDN edge nodes, backup appliances performing large transfers, authorised vulnerability scanners, video conferencing infrastructure, and software update distribution points."
    tuning_guidance = "Add known-good high-bandwidth source IPs or subnets to %global_allowed_scanners for authorised scanners. Add approved CDN or update service destinations to %global_allowed_domains. Add backup appliance source addresses to %global_allowed_backup_processes. Raise the bytes_sent threshold if the environment legitimately generates large outbound flows."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Outbound only - source is internal, destination is external
    $net.principal.ip = $src_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude approved remote management tooling destinations
    not $net.target.hostname in %global_allowed_domains
    not $net.target.hostname in %global_allowed_remote_mgmt

    // Flag flows with very high outbound byte volume - indicative of
    // bandwidth relay, proxyjacking, or bulk scanning traffic.
    // network.sent_bytes is populated by perimeter flow exporters.
    $net.network.sent_bytes > 104857600

    // Exclude well-known legitimate high-bandwidth ports (HTTP/S, DNS)
    // by targeting unusual or high-numbered destination ports commonly
    // used by proxyware and botnet C2 relay services.
    $net.target.port > 1024
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 3128

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $total_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
