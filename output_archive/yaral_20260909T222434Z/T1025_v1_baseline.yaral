/*
  MITRE Technique : T1025 - Data from Removable Media
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:32:21.378599+00:00
  Reference       : https://attack.mitre.org/techniques/T1025
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1025_001_Data_Collection_Removable_Media {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects processes enumerating or reading files from removable media drive letters (D:-Z:) via command-line tools. Adversaries commonly use cmd, PowerShell, or scripting hosts to list and copy files from USB drives or optical media connected to a compromised host."
    mitre_tactic    = "Collection"
    mitre_technique = "T1025"
    mitre_technique_name = "Data from Removable Media"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1)."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate backup software reading from USB drives, IT imaging workflows, authorized data migration tasks, antivirus scanning removable media."
    tuning_guidance = "Add known backup or imaging parent process paths to %global_allowed_backup_processes. Add authorized admin accounts to %global_allowed_admin_users. Narrow the drive-letter regex if your environment assigns fixed letters to approved removable devices."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target one of the common shell or scripting interpreters used for interactive collection
    $proc.target.process.file.full_path = /\\(cmd\.exe|powershell\.exe|pwsh\.exe|wscript\.exe|cscript\.exe|mshta\.exe)$/ nocase

    // Command line references a removable-media drive letter (D: through Z:) with
    // collection-oriented verbs: dir/ls listings, copy/move/xcopy/robocopy, type/cat reads,
    // Get-ChildItem/Get-Content PowerShell cmdlets, or wildcard glob patterns.
    $proc.target.process.command_line = /(?i)[d-z]:\\/ 

    $proc.target.process.command_line = /(?i)(dir\s|ls\s|copy\s|xcopy\s|robocopy\s|move\s|type\s|get-childitem|get-content|gc\s|cat\s|cp\s|mv\s|\*\.[a-z]{2,4})/

    // Exclude approved backup and administrative tooling parents
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorized admin accounts performing expected operations
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1025")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
