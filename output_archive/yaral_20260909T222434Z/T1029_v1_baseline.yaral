/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:32:42.219029+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_001_Scheduled_Transfer_Periodic_Outbound {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects periodic outbound network flows to external destinations that may indicate scheduled data exfiltration. The rule flags repeated, evenly-timed outbound connections to the same external IP on non-standard or high-numbered ports during off-hours, a pattern consistent with adversaries blending exfiltration into scheduled intervals. Internal address space is excluded via reference list."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Requires firewall or perimeter network flow logs normalised into Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION events. Logs must populate principal.ip, target.ip, target.port, and network.sent_bytes."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "Backup agents performing scheduled uploads to cloud storage, telemetry and monitoring agents, software update services, legitimate scheduled ETL jobs, CDN health-check beacons."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add approved scanner or backup source IPs to %global_allowed_scanners or %global_allowed_backup_processes. Raise the sent_bytes threshold to reduce noise from heartbeat-style connections. Restrict the off-hours window (timestamp.get_hour) to match the customer's business hours."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Exclude traffic to internal address space
    not $net.target.ip in %rfc1918_internal

    // Exclude approved external destinations
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanner sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude authorised backup process sources
    not $net.principal.ip in %global_allowed_backup_processes

    // Focus on non-trivial data transfers - filter out near-zero-byte keepalives
    $net.network.sent_bytes > 50000

    // Target high-numbered or non-standard ports commonly used for covert channels
    // Excludes well-known web (80, 443, 8080, 8443) and mail ports
    (
      $net.target.port >= 1024 and
      $net.target.port != 8080 and
      $net.target.port != 8443 and
      $net.target.port != 3128 and
      $net.target.port != 3389
    )

    // Off-hours detection: flag connections outside typical business hours (UTC)
    // 00:00-06:00 or 20:00-23:59 UTC - tune per customer timezone
    (
      timestamp.get_hour($net.metadata.event_timestamp, "UTC") < 6 or
      timestamp.get_hour($net.metadata.event_timestamp, "UTC") >= 20
    )

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
