/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:26:37.956720+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_Rapid_Cloud_Account_Enumeration_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a principal performing multiple cloud account enumeration operations within a short time window, indicating reconnaissance activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail, Azure Activity, GCP Audit) and identity provider logs."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Automated security scanning tools, IAM auditing scripts, identity governance platforms, administrator troubleshooting sessions."
    tuning_guidance = "Add service principals and automation accounts to %global_allowed_cloud_principals. Exclude known security scanning sources."

  events:
    $enum1.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $enum1.target.resource.name = /(?i)(list.*user|get.*user|describe.*user|list.*account|get.*account|list.*role|get.*role|list.*service.*account|get.*iam.*policy|msolrolemember|az\s+ad\s+user)/
      or $enum1.target.resource.attribute.labels.value = /(?i)(list.*user|get.*user|describe.*user|list.*account|get.*account|list.*role|get.*role|list.*service.*account|get.*iam.*policy)/
      or $enum1.metadata.description = /(?i)(list.*user|get.*user|describe.*user|list.*account|get.*account|list.*role|get.*role|list.*service.*account|get.*iam.*policy)/
    )
    not $enum1.principal.user.userid in %global_allowed_cloud_principals
    $enum1.principal.user.userid = $userid

    $enum2.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $enum2.target.resource.name = /(?i)(list.*user|get.*user|describe.*user|list.*account|get.*account|list.*role|get.*role|list.*service.*account|get.*iam.*policy|msolrolemember|az\s+ad\s+user)/
      or $enum2.target.resource.attribute.labels.value = /(?i)(list.*user|get.*user|describe.*user|list.*account|get.*account|list.*role|get.*role|list.*service.*account|get.*iam.*policy)/
      or $enum2.metadata.description = /(?i)(list.*user|get.*user|describe.*user|list.*account|get.*account|list.*role|get.*role|list.*service.*account|get.*iam.*policy)/
    )
    not $enum2.principal.user.userid in %global_allowed_cloud_principals
    $enum2.principal.user.userid = $userid

    $enum1.metadata.event_timestamp.seconds < $enum2.metadata.event_timestamp.seconds

  match:
    $userid over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($userid)
    $enumeration_count = count($enum2.metadata.id)
    $target_resources = array_distinct($enum2.target.resource.name)
    $source_ips = array_distinct($enum2.principal.ip)

  condition:
    $enum1 and #enum2 >= 3
}
