/*
  MITRE Technique : T1052.001 - Exfiltration over USB
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:34:55.922466+00:00
  Reference       : https://attack.mitre.org/techniques/T1052/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_Large_File_Copy_To_USB_Mount {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects large file copy operations to USB-mounted filesystems, indicating potential data exfiltration over removable media."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052.001"
    mitre_technique_name = "Exfiltration Over Physical Medium: Exfiltration over USB"
    log_prerequisites = "Requires Linux EDR or auditd file creation/modification events with full path visibility."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate backups to USB drives, authorized data transfers, system administrators copying logs or diagnostic data, software installation from USB media."
    tuning_guidance = "Add approved backup processes to %global_allowed_backup_processes. Exclude service accounts performing authorized transfers via %global_allowed_service_accounts. Adjust file path patterns to exclude non-sensitive data directories."

  events:
    ($file.metadata.event_type = "FILE_CREATION" or $file.metadata.event_type = "FILE_MODIFICATION")
    $file.target.file.full_path = /^\/media\// nocase or
    $file.target.file.full_path = /^\/mnt\// nocase or
    $file.target.file.full_path = /^\/run\/media\// nocase
    $file.target.file.size >= 10485760
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.target.file.full_path = /\/(lost\+found|\.Trash|System Volume Information)\// nocase

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1052.001")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
