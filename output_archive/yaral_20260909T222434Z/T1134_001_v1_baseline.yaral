/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:40:55.490081+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_Token_Impersonation_Theft {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process-open events where a process acquires a handle to another process with TOKEN_DUPLICATE or TOKEN_IMPERSONATE access rights, which are the prerequisite OS operations for token impersonation/theft via DuplicateToken, ImpersonateLoggedOnUser, or SetThreadToken. The rule focuses on non-privileged or unexpected parent processes opening handles to high-value system processes (lsass, winlogon, svchost) with impersonation-capable access masks."
    mitre_tactic    = "Privilege Escalation, Defense Evasion"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires EDR or Sysmon process-open (handle acquisition) telemetry normalised to UDM PROCESS_OPEN events. Sysmon Event ID 10 (ProcessAccess) is the canonical source. The access mask field must be populated in target.process.access_mask or an equivalent UDM field."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Security tooling (EDR agents, AV), authorised privilege management software, Windows Credential Guard, LSASS protection drivers, and some backup agents legitimately open handles to system processes. Debuggers and profilers may also trigger this rule."
    tuning_guidance = "Add known-good security agent and backup process paths to %global_allowed_security_tools and %global_allowed_backup_processes. Narrow the target process list if high-volume false positives arise from a specific system process. Consider adding the principal process path to %global_allowed_admin_tools for approved RMM tooling."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be a high-value system process commonly holding privileged tokens
    $open.target.process.file.full_path = /\\(lsass|winlogon|svchost|services|csrss|wininit)\.exe$/ nocase

    // The opening (principal) process must NOT itself be a known system binary
    // Legitimate OS components opening handles to each other are expected;
    // unexpected openers from user-space or scripting hosts are the signal.
    not $open.principal.process.file.full_path = /\\(lsass|winlogon|svchost|services|csrss|wininit|smss|ntoskrnl)\.exe$/ nocase

    // Scripting hosts, shells, and interpreted runtimes opening handles to
    // privileged processes is a strong indicator of token theft tooling.
    // Also catches compiled payloads spawned from these parents.
    $open.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msbuild|csc|installutil|wmic|python|ruby|perl|node)\.exe$/ nocase

    // Exclude approved security tooling and backup agents
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing legitimate privileged operations
    not $open.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
