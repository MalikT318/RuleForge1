/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:28:15.618435+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_001_CloudStorage_BulkResourceAccess {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects anomalous bulk access to cloud storage resources (OneDrive/SharePoint/Google Drive) from a single user session. Adversaries who have compromised credentials or OAuth tokens may enumerate and download large volumes of files directly via cloud APIs or the web interface. This rule fires on USER_RESOURCE_ACCESS events where the accessed resource path indicates cloud document storage and the operation reflects a download or export action, providing coverage at the audit-log layer rather than the process/command-line layer."
    mitre_tactic = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log (UAL) ingested into Chronicle via the M365 connector. Relevant workloads: SharePoint, OneDrive, MicrosoftTeams. Operations: FileDownloaded, FileSyncDownloadedFull, FileAccessed, FilePreviewed, FileCheckedOut."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Authorised backup agents, migration projects, data-loss-prevention scanning services, and power users performing legitimate bulk downloads before device refresh. Service accounts performing scheduled sync operations."
    tuning_guidance = "Add known backup and migration service account identifiers to %global_allowed_backup_processes. Add approved service principals to %global_allowed_cloud_principals. Consider raising the threshold or scoping to sensitive site collections if false-positive volume is high."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match cloud storage resource paths - OneDrive, SharePoint document libraries, Google Drive
    (
      $cloud.target.resource.name = /(?i)(onedrive|sharepoint|\/sites\/|\/personal\/|\/drives\/|\/documents\/|google.*drive|my.drive|shared.*drive)/
      or
      $cloud.target.url = /(?i)(sharepoint\.com\/(sites|personal)|onedrive\.live\.com|drive\.google\.com\/(drive|file|open))/
    )

    // Match download, sync, or bulk-access operations normalised into the operation field
    (
      $cloud.metadata.product_event_type = /(?i)(FileDownloaded|FileSyncDownloadedFull|FileAccessed|FilePreviewed|FileCheckedOut|DriveItemDownloaded|download|export|sync_download)/
    )

    // Require an authenticated user principal - exclude anonymous/unauthenticated
    $cloud.principal.user.userid != ""
    $cloud.principal.user.userid != /(?i)^(anonymous|guest|unauthenticated)/

    // Exclude known-good service and backup accounts
    not $cloud.principal.user.userid in %global_allowed_backup_processes
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1530")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)
    $operation = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
