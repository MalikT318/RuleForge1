/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:39:34.202867+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_001_Linux_Audio_Capture_Process_Launch {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes commonly abused for audio capture on Linux, including ALSA utilities, PulseAudio record tools, FFmpeg, SoX, and arecord invocations that write audio output to disk. Adversaries use these tools to silently record microphone input and stage audio files for later exfiltration."
    mitre_tactic    = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events, including command-line arguments."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate conferencing software (Zoom, Teams, WebEx daemons), voice-over-IP applications, accessibility tools (speech-to-text), audio testing by system administrators, recording studios or media production workflows, automated QA test harnesses."
    tuning_guidance = "Add known-good parent process paths (conferencing daemons, accessibility agents) to %global_allowed_admin_tools. Scope exclusions to specific hosts running media production workloads via %global_allowed_script_hosts. Review command-line output paths: recordings to /tmp or /dev/shm are higher risk than to user home directories."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match audio capture binaries by process name or full path
    (
      $proc.target.process.file.full_path = /\/(arecord|aplay|parecord|parec|ffmpeg|sox|rec|avconv|alsactl|pacat)$/ nocase
      or
      $proc.target.process.command_line = /(?i)(arecord|parecord|parec|pacat|sox\s|rec\s|ffmpeg\s|avconv\s)/ nocase
    )

    // Must reference an audio input device or audio capture flag to reduce noise
    (
      // ALSA/PulseAudio device references
      $proc.target.process.command_line = /(?i)(\/dev\/snd|hw:[0-9]|plughw:|pulse|default|alsa|dsnoop)/
      or
      // FFmpeg/avconv audio input flags
      $proc.target.process.command_line = /(?i)-f\s+(alsa|pulse|oss|sndio|avfoundation)/
      or
      // SoX / rec capturing from microphone
      $proc.target.process.command_line = /(?i)(--input-buffer|--buffer|-t\s+(wav|mp3|flac|ogg|raw|au))/
      or
      // parecord / parec writing to file
      $proc.target.process.command_line = /(?i)(--file-format|--channels|--rate|--record)/
    )

    // Output directed to a file (not just stdout) - key indicator of staging
    (
      $proc.target.process.command_line = /(?i)\.(wav|mp3|flac|ogg|raw|au|aac|opus|pcm)\b/
      or
      $proc.target.process.command_line = /(?i)(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/)/
    )

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
