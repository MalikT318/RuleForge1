/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:52:34.154558+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_Linux_File_Permission_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects chmod or chown invocations targeting sensitive Linux paths or using permissive/world-writable mode flags. Adversaries modify file and directory permissions to bypass ACLs, enable persistence, or facilitate privilege escalation."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events with command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers (apt, yum, rpm) adjusting file ownership post-install; configuration management tools (Ansible, Puppet, Chef); container entrypoint scripts; legitimate admin operations on /etc files."
    tuning_guidance = "Add known-good parent processes (package managers, CM agents) to %global_allowed_admin_tools. Narrow the sensitive path regex if broad /etc coverage generates noise. Consider raising severity when the target path matches /etc/shadow, /etc/sudoers, or /etc/cron.*."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match chmod or chown as the launched binary
    $proc.target.process.file.full_path = /\/(usr\/bin\/|usr\/local\/bin\/|bin\/)(chmod|chown|chattr)$/ nocase

    // Detect permissive mode flags OR sensitive target paths
    (
      // World-writable or SUID/SGID bit manipulation via chmod
      $proc.target.process.command_line = /chmod\s+.*(777|a\+w|o\+w|[0-9]*[2367][0-9]{2}|[ugo]\+s|[+]s)/ nocase
      or
      // Targeting sensitive system paths
      $proc.target.process.command_line = /\/(etc\/(shadow|sudoers|passwd|cron|ssh|pam\.d|security|ld\.so)|var\/(spool\/cron|log)|proc\/|dev\/shm|tmp\/|lib\/(systemd|security)|usr\/(lib\/systemd|local\/bin|bin)|home\/[^/]+\/\.(bash|profile|ssh|zsh|config))/ nocase
      or
      // chattr removing immutable flag to allow subsequent modification
      $proc.target.process.command_line = /chattr\s+.*-i/ nocase
      or
      // Recursive permission changes - high risk of broad impact
      $proc.target.process.command_line = /chmod\s+.*-[rR]/ nocase
    )

    // Exclude known-good administrative tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing routine operations
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_executed = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
