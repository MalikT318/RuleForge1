/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:25:10.735531+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_Domain_Account_Enum_LDAP_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound LDAP or LDAPS connections from non-domain-controller Windows hosts to internal infrastructure, characteristic of domain account enumeration via LDAP queries (e.g., ldapsearch, PowerShell ADSI, .NET DirectorySearcher). Adversaries performing T1087.002 frequently issue LDAP queries directly to enumerate domain users and groups. This rule provides network-side coverage complementary to process-launch detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires firewall or network perimeter logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source and destination IP, destination port, and connection metadata must be populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Domain controllers communicating with each other (DC-to-DC replication), legitimate directory-integrated applications (HR systems, ITSM tools, identity governance platforms), vulnerability scanners, approved LDAP monitoring agents."
    tuning_guidance = "Add known LDAP-querying application source IPs to %global_allowed_scanners. Add approved service account source addresses to %global_allowed_service_accounts. If DC-to-DC traffic is noisy, restrict the rule to source IPs outside the known DC subnet range using net.ip_in_range_cidr() exclusions."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target LDAP (389) and LDAPS (636) ports; also GC (3268) and GC-SSL (3269)
    // which are used for forest-wide enumeration
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )

    // Source must be an internal host (traffic originates inside the perimeter)
    $net.principal.ip in %rfc1918_internal

    // Destination must also be internal (LDAP to a DC is internal-to-internal);
    // exclude known-good scanners and remote management sources
    $net.target.ip in %rfc1918_internal

    // Exclude authorised scanners and management tooling by source address
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
