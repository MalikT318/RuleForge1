/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:43:00.667157+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_Domain_Account_Creation_Network_Observable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable domain account creation activity via firewall/perimeter logs. Adversaries may create domain accounts over LDAP (389/636) or Kerberos (88) from unexpected internal sources, or exfiltrate credentials to external destinations. This rule flags outbound LDAP/LDAPS connections to non-internal destinations, which may indicate rogue domain account provisioning or credential relay attacks targeting domain controllers."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Requires firewall or network perimeter flow logs with source/destination IP, port, and protocol. Ensure LDAP (389), LDAPS (636), and Kerberos (88) traffic is captured in flow telemetry."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate LDAP synchronisation to cloud identity providers (Azure AD Connect, Okta LDAP agent). Authorised directory services replication between domain controllers. Vulnerability scanners probing LDAP ports."
    tuning_guidance = "Add known-good LDAP sync destinations to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Add approved service accounts performing directory operations to %global_allowed_service_accounts. If internal DC-to-DC replication generates noise, ensure %rfc1918_internal exclusion covers all internal subnets."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target LDAP (389), LDAPS (636), or Kerberos (88) - protocols used for domain account operations
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 88
    )

    // Destination must be external - internal DC-to-DC replication is expected on RFC1918
    not $net.target.ip in %rfc1918_internal

    // Source must be internal (traffic originating from inside the perimeter)
    $net.principal.ip in %rfc1918_internal

    // Exclude known-good external LDAP/directory sync destinations (e.g., cloud IdP endpoints)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised vulnerability scanners probing directory ports
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $destination_hostname = array_distinct($net.target.hostname)

  condition:
    $net
}
