/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:44:58.046525+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_Addin_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registration of Office add-ins (XLL, WLL, COM, VSTO, Outlook) via registry modification in known Office add-in persistence paths. Adversaries abuse add-in registration to execute code each time an Office application starts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry producing REGISTRY_MODIFICATION or REGISTRY_CREATION events with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office add-in installations by software deployment tools, IT management agents, or end-user-installed productivity add-ins (e.g., Grammarly, Adobe Acrobat, Zoom). Developer workstations building VSTO or COM add-ins will also trigger this rule."
    tuning_guidance = "Add known-good installer and deployment process paths to %global_allowed_admin_tools. Add approved service accounts that perform software deployment to %global_allowed_service_accounts. Consider scoping to non-IT hosts if add-in deployment is centralised."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    //(?i) Target the well-known Office add-in registry paths across all Office versions and both HKCU/HKLM hives
    //(?i) Covers: Excel XLL/COM add-ins, Word WLL/COM add-ins, PowerPoint, Outlook COM add-ins, and generic Office add-in paths
    $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Office\\(Word|Excel|PowerPoint|Outlook|OneNote|Access)(\\[0-9]+\.[0-9]+)?\\(Addins|Add-ins|AddInLoadTimes|Excel\\Options|Options|Resiliency\\DisabledItems)/

    //(?i) Also catch HKCU and HKLM VSTO/COM add-in registration paths
    // and the generic Office trusted add-in locations
    // Using a broad regex to cover version-agnostic and version-specific paths

    // Exclude known-good administrative and deployment tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
