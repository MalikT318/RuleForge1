/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:26:55.204449+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_001_C2_Exfil_Large_Outbound_Connection {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects potential data exfiltration over a C2 channel by identifying large outbound network flows to external destinations. Adversaries encoding stolen data within existing C2 communications typically produce sustained or high-volume outbound connections to non-internal addresses on common or uncommon ports. This rule targets the network-observable signature: large bytes-sent values to external IPs, complementing existing process-launch detections."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "Requires firewall or perimeter flow logs with bytes_sent/bytes_out populated in UDM network.sent_bytes. Sessions must be logged at close/end rather than only at open."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "Legitimate large uploads to cloud storage, backup services, software update distribution, video conferencing, and CDN traffic. Tune by adding known-good external domains or approved scanner sources."
    tuning_guidance = "Raise the sent_bytes threshold if high-volume legitimate upload traffic causes noise. Add approved external destinations to %global_allowed_domains. Add authorised scanner sources to %global_allowed_scanners. Adjust the 50 MB threshold to match the environment's baseline upload profile."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Exclude traffic destined for internal address space
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external domains (CDNs, update services, cloud storage)
    not $net.target.domain.name in %global_allowed_domains

    // Exclude authorised vulnerability scanners and security testing sources
    not $net.principal.ip in %global_allowed_scanners

    // Large outbound data volume threshold: 50 MB sent in a single session
    // C2 exfiltration encodes stolen data in the outbound direction
    $net.network.sent_bytes >= 52428800

    // Restrict to sessions where the internal host is the initiator (principal)
    // and the external host is the destination (target) - outbound direction
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)
    $destination_domain = array_distinct($net.target.domain.name)

  condition:
    $net
}
