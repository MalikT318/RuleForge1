/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:35:14.384428+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_Data_Staged_Bulk_Copy_To_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects data staging behaviour on Windows where built-in copy utilities (cmd copy/xcopy/robocopy) or PowerShell copy cmdlets write files into directories commonly used as staging locations (temp, recycle bin, public, appdata, or user-created archive-like folders). Adversaries stage collected data in a central location prior to exfiltration to reduce C2 connections and evade detection."
    mitre_tactic = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup software, software deployment agents, IT admin scripts performing legitimate bulk copies, robocopy-based replication jobs."
    tuning_guidance = "Add known-good parent processes (backup agents, deployment tools) to %global_allowed_backup_processes. Add authorised admin accounts to %global_allowed_admin_users. Narrow the staging path regex to exclude known-good destinations in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match native Windows copy utilities and PowerShell as the launched process
    $proc.target.process.file.full_path = /\\(cmd\.exe|xcopy\.exe|robocopy\.exe|powershell\.exe|pwsh\.exe)$/ nocase

    // Command line must contain a copy-like operation
    // cmd /c copy, xcopy, robocopy, PowerShell Copy-Item / cp
    $proc.target.process.command_line = /(\bcopy\b|\bxcopy\b|\brobocopy\b|\bCopy-Item\b|\bcp\b)/ nocase

    // Destination must resolve to a known staging-friendly location:
    // %TEMP%, %TMP%, Recycle Bin, Public, AppData, ProgramData, or
    // suspiciously named flat directories (dump, stage, collect, exfil, out, archive, backup)
    $proc.target.process.command_line = /(?i)(\\temp\\|\\tmp\\|\\\$recycle\.bin\\|\\public\\|\\appdata\\|\\programdata\\|\\dump\\|\\stage\\|\\collect\\|\\exfil\\|\\out\\|\\archive\\|\\backup\\)[^\s]*/

    // Exclude known-good backup and deployment processes as the parent
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known-good admin tooling as the parent
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised admin accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $staging_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
