/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:54:42.258835+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_ESXi_Defacement_Config_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of ESXi host configuration files commonly targeted during defacement activity, including DCUI welcome banners, hostd configuration, and other files that control visual or operational presentation of the hypervisor management plane. Adversaries may alter these to deliver messaging, claim credit for intrusion, or intimidate operators."
    mitre_tactic    = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised into Chronicle UDM. ESXi syslog forwarding must be enabled and shell activity logging active (esxcli system syslog config set). PROCESS_LAUNCH events from /bin/sh, /bin/busybox, or vi/sed/cp invocations on ESXi are required."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised VMware administrators applying banner policy changes, patching workflows that update hostd.conf or motd, configuration management tooling (Ansible, vSphere Lifecycle Manager) running against the host."
    tuning_guidance = "Add known-good administrative service accounts to %global_allowed_service_accounts. Add approved automation principals to %global_allowed_admin_users. Scope to change-window hours using timestamp.get_hour() if your environment has predictable maintenance windows."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Shell or editor process executing on the ESXi host
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin)\/(sh|ash|busybox|vi|vim|sed|awk|cp|mv|tee|echo|printf|python|python3|perl)$/ nocase

    // Command line touches files that control ESXi visual/management presentation:
    // /etc/motd                  - message of the day shown at login
    // /etc/vmware/hostd/         - hostd daemon configuration directory
    // /etc/vmware/welcome        - DCUI welcome screen content
    // /etc/issue                 - pre-login banner
    // /etc/vmware/config         - global VMware config
    // /etc/vmware/esx.conf       - host-level ESXi configuration
    // /bootbank/                 - persistent boot configuration
    $proc.target.process.command_line = /\/etc\/(motd|issue|vmware\/(hostd|welcome|config|esx\.conf|vmkiscsid\.conf)|vmware\/config)|\/bootbank\/|\/etc\/vmware\// nocase

    // Exclude known-good automation accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

    // Exclude approved admin tooling parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
