/*
  MITRE Technique : T1137.005 - Outlook Rules
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:44:40.693344+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_005_Outlook_Malicious_Rule_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of Outlook mailbox rules that may indicate persistence via T1137.005. Adversaries create inbox rules to trigger actions (e.g., run application, redirect, delete) when a specially crafted email arrives. Suspicious signals include rules that move, delete, or redirect mail combined with unusual conditions, or rules created outside business hours by non-service accounts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.005"
    mitre_technique_name = "Office Application Startup: Outlook Rules"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log with Exchange mailbox audit events enabled. Operations: New-InboxRule, Set-InboxRule, UpdateInboxRules must be captured and normalized to UDM SETTING_MODIFICATION."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate users creating inbox rules for mail organization, IT helpdesk configuring rules on behalf of users, mail flow automation via approved service accounts."
    tuning_guidance = "Add known-good service and automation accounts to %global_allowed_service_accounts. Add approved administrative users who routinely manage mailbox rules to %global_allowed_admin_users. Consider narrowing to rules that include redirect/forward/delete actions if false-positive volume is high."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Target the mailbox rule management operations normalized from M365 UAL
    // Matches New-InboxRule, Set-InboxRule, UpdateInboxRules operation names
    $cloud.metadata.product_event_type = /(?i)(new-inboxrule|set-inboxrule|updateinboxrules)/

    // Rule must be associated with a real user principal, not an empty actor
    $cloud.principal.user.userid != ""

    // Exclude known-good service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative users who legitimately manage mailbox rules
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Detect suspicious rule actions: redirect, forward, delete, move to specific
    // folders, or run application - all common persistence/exfiltration patterns.
    // The target resource name carries the rule parameters as normalized by Chronicle.
    (
      $cloud.target.resource.name = /(?i)(redirectto|forwardto|forwardasattachmentto|deletemessage|movetofolderpath|runapplication|stopprocessingrules)/ nocase
      or
      $cloud.security_result.description = /(?i)(redirectto|forwardto|forwardasattachmentto|deletemessage|movetofolderpath|runapplication)/ nocase
    )

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1137.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $affected_mailbox = array_distinct($cloud.target.user.userid)
    $rule_operation = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
