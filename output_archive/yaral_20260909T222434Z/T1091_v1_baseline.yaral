/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:36:28.781603+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Replication_Through_Removable_Media {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects executable or script files written directly to a removable/USB drive root or common drop locations. Adversaries copy malware to removable media to achieve lateral movement or initial access, often disguising payloads as legitimate files. This rule fires on FILE_CREATION events where the target path resolves to a drive letter associated with removable media (D:\ through Z:\) and the file extension is executable or script-based."
    mitre_tactic         = "Lateral Movement, Initial Access"
    mitre_technique      = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites    = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11) normalised into Chronicle UDM FILE_CREATION events with target.file.full_path populated."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Software deployment tools writing installers to USB drives; IT staff staging bootable media; backup agents writing to external drives; legitimate portable application installers."
    tuning_guidance      = "Add known deployment or backup parent process paths to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the drive-letter regex if your environment consistently assigns specific letters to removable media. Consider adding a process lineage filter to exclude known-good imaging tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target path must start with a non-system drive letter (D-Z) followed by :\
    // System drive is typically C:\; A:\ and B:\ are legacy floppy
    $file.target.file.full_path = /^[D-Zd-z]:\\/

    // Match executable, script, and shortcut file types commonly abused for
    // removable-media propagation. Case-insensitivity handled via inline flag.
    $file.target.file.full_path = /(?i)\.(exe|dll|scr|bat|cmd|ps1|vbs|vbe|js|jse|hta|lnk|pif|com|cpl|msi|msp|inf|reg)$/

    // Exclude processes that are authorised to write to removable media
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Capture the writing process path for outcome enrichment
    $writing_process = $file.principal.process.file.full_path

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dropped_file      = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($writing_process)

  condition:
    $file
}
