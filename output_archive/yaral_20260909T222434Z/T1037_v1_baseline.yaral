/*
  MITRE Technique : T1037 - Boot or Logon Initialization Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:33:16.762708+00:00
  Reference       : https://attack.mitre.org/techniques/T1037
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_ESXi_Boot_Logon_Init_Script_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi boot or logon initialization scripts such as /etc/rc.local.d/, /etc/profile.d/, or local.sh. Adversaries plant scripts in these locations to achieve persistence or privilege escalation that survives reboots on ESXi hosts."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037"
    mitre_technique_name = "Boot or Logon Initialization Scripts"
    log_prerequisites = "Requires ESXi shell/hostd telemetry forwarded to Chronicle via syslog or ESXi log shipping. FILE_CREATION or FILE_MODIFICATION events must be generated for shell activity on the ESXi host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorized VMware administrators deploying configuration scripts via vSphere Lifecycle Manager, Ansible, or approved change management tooling. Vendor-supplied patches that update rc.local.d entries."
    tuning_guidance = "Add approved administrative service accounts to %global_allowed_service_accounts. Add approved management hosts or automation principals to %global_allowed_mgmt_sources. Scope by principal.hostname if only specific ESXi hosts are managed via automation."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /\/etc\/rc\.local\.d\// nocase
      or
      $file.target.file.full_path = /\/etc\/profile\.d\// nocase
      or
      $file.target.file.full_path = /\/etc\/rc\.d\// nocase
      or
      $file.target.file.full_path = /\/scratch\/etc\/rc\.local\.d\// nocase
      or
      $file.target.file.full_path = /\/vmfs\/volumes\/[^\/]+\/.*\/(local|init|boot)\.sh$/ nocase
      or
      $file.target.file.full_path = /\/etc\/vmware\/firewall\// nocase
    )
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_path = array_distinct($file.target.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)
    $actor_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
