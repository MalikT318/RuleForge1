/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:53:12.956019+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_Linux_Permissions_Modification_Sensitive_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects chmod or chown execution targeting sensitive system paths, configuration files, or user directories that may indicate defense evasion or persistence preparation."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve syscall logging."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers (apt, yum, dnf), configuration management tools (Ansible, Puppet, Chef), container runtime operations, legitimate system administration, software installation scripts."
    tuning_guidance = "Add approved automation tools and package manager parent processes to %global_allowed_admin_tools. Exclude service account identifiers to %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /\/chmod$/ nocase or
      $proc.target.process.file.full_path = /\/chown$/ nocase or
      $proc.target.process.file.full_path = /\/chgrp$/ nocase
    )
    (
      $proc.target.process.command_line = /\/etc\// nocase or
      $proc.target.process.command_line = /\/root\// nocase or
      $proc.target.process.command_line = /\/home\/[^\/]+\/\.ssh\// nocase or
      $proc.target.process.command_line = /\/home\/[^\/]+\/\.bash/ nocase or
      $proc.target.process.command_line = /\/home\/[^\/]+\/\.profile/ nocase or
      $proc.target.process.command_line = /\/var\/spool\/cron/ nocase or
      $proc.target.process.command_line = /\/etc\/cron/ nocase or
      $proc.target.process.command_line = /\/lib\/systemd/ nocase or
      $proc.target.process.command_line = /\/usr\/lib\/systemd/ nocase or
      $proc.target.process.command_line = /\/etc\/systemd/ nocase or
      $proc.target.process.command_line = /\/etc\/init\.d\// nocase or
      $proc.target.process.command_line = /\/etc\/rc\.d\// nocase or
      $proc.target.process.command_line = /\/usr\/local\/bin\// nocase or
      $proc.target.process.command_line = /\/usr\/bin\// nocase or
      $proc.target.process.command_line = /\/bin\// nocase or
      $proc.target.process.command_line = /\/sbin\// nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
