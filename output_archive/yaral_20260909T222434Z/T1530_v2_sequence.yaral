/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:28:36.936291+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_002_Cloud_Storage_Access_After_Suspicious_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern where a user authenticates from an unusual context (e.g., new location, MFA anomaly, or risk-flagged sign-in) and then performs bulk or sensitive cloud storage resource access within a short window. This correlation targets adversarial collection of cloud-stored data following account compromise, providing additive coverage beyond process-creation detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Requires identity provider audit/sign-in logs normalised to UDM USER_LOGIN with risk or MFA fields populated, and SaaS application audit logs producing USER_RESOURCE_ACCESS events for cloud storage objects (e.g., OneDrive, SharePoint, Google Drive, Dropbox). Both log sources must be ingested into Chronicle."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate users accessing large volumes of files after travelling (new geography), automated sync clients performing bulk reads, migration tooling, and approved backup processes. Service accounts performing scheduled exports may also trigger this rule."
    tuning_guidance = "Add known service and automation accounts to %global_allowed_service_accounts. Add approved backup and sync processes to %global_allowed_backup_processes. Raise the threshold on the outcome risk_score or narrow the resource_access_count threshold if false-positive volume is high. Consider excluding known-good source IPs via %global_allowed_mgmt_sources."

  events:
    // Event 1: Risk-flagged or MFA-challenged login from the identity provider
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $userid
    // Target a login that carries a risk signal: either MFA was required/challenged
    // or the authentication result indicates a conditional-access or risk evaluation.
    // Chronicle normalises risk signals into security_result fields.
    $auth.security_result.severity = "HIGH"
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Event 2: Cloud storage resource access following the suspicious login
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid = $userid
    // Narrow to cloud storage resource types to avoid joining on unrelated SaaS activity.
    // UDM target.resource.resource_type is populated by Chronicle parsers for storage objects.
    $access.target.resource.resource_type = "STORAGE_OBJECT"
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_backup_processes

    // Chronological ordering: login must precede the storage access
    $auth.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $userid over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1530")
    $primary_entity = array_distinct($userid)
    $login_source_ips = array_distinct($auth.principal.ip)
    $accessed_resources = array_distinct($access.target.resource.name)
    $resource_access_count = count($access.target.resource.name)
    $auth_severity = array_distinct($auth.security_result.severity)

  condition:
    $auth and $access
}
