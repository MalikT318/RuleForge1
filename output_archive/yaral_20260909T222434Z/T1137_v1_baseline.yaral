/*
  MITRE Technique : T1137 - Office Application Startup
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:43:35.625195+00:00
  Reference       : https://attack.mitre.org/techniques/T1137
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_Office_Application_Startup_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects persistence mechanisms abusing Microsoft Office application startup paths, including modification of Office add-in registry keys, trusted template locations, and Outlook home page/form registry values. Adversaries write to these locations to execute code whenever an Office application starts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137"
    mitre_technique_name = "Office Application Startup"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (Event ID 13 or equivalent UDM REGISTRY_MODIFICATION events)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office add-in installations, Group Policy deploying Office templates, IT software deployment agents installing Office plugins, Office updates modifying add-in registry entries."
    tuning_guidance = "Add known-good software deployment and Office management parent processes to %global_allowed_admin_tools. Scope by principal.process.file.full_path to exclude trusted installers. Consider narrowing to interactive user sessions if deployment tooling generates noise."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target Office startup persistence registry locations:
    // 1. Office add-in registration (HKCU and HKLM) - LoadBehavior, manifest paths
    // 2. Outlook home page (WebView) persistence
    //(?i) 3. Office trusted templates / startup folder overrides
    // 4. Outlook forms and rules persistence paths
    $reg.target.registry.registry_key = /(?i)\\Software\\(Wow6432Node\\)?Microsoft\\Office\\[0-9]+\.[0-9]+\\(Word|Excel|PowerPoint|Outlook|Access)\\(Addins|AddInLoadTimes|Security\\Trusted|Options\\WebView|WebView|Resiliency|Today)/

    // Exclude writes originating from Office applications themselves performing
    //(?i) legitimate self-configuration during normal startup/update
    not $reg.principal.process.file.full_path = /(?i)\\(WINWORD|EXCEL|POWERPNT|OUTLOOK|MSACCESS|OfficeClickToRun|OfficeC2RClient|msiexec|TrustedInstaller)\.exe$/

    // Exclude known administrative and deployment tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service accounts performing automated configuration
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1137")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
