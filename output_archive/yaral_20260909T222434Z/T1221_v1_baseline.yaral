/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:52:14.037392+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_001_Office_Template_Remote_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Office applications (Word, Excel, PowerPoint) spawning network-capable child processes or script interpreters that are characteristic of remote template injection. When a malicious OOXML document loads, it fetches a remote template which may execute code via a spawned child process. This rule targets the process lineage signal: Office parent spawning shells, script hosts, or download utilities shortly after document open."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires EDR process telemetry with parent-child process lineage (Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, or equivalent). Parent process path and child command line must be populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office add-ins or macros that invoke PowerShell for approved automation; IT management tools that use Office COM automation; document workflows that legitimately call script hosts. Tune by adding known-good parent paths to %global_allowed_script_hosts."
    tuning_guidance = "Add approved Office automation parent processes to %global_allowed_script_hosts. If specific child process names generate noise in a given environment, narrow the child process regex to the subset most relevant to observed attacker behaviour. Consider pairing with a network event rule to confirm outbound connection."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Office application acting as parent - template injection starts with a document open
    $proc.principal.process.file.full_path = /\\(WINWORD|EXCEL|POWERPNT|MSACCESS|MSPUB|VISIO)\.exe$/

    // Child process is a shell, script interpreter, or download utility
    // These are the processes a fetched malicious template would spawn
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|wget|msiexec|wmic|forfiles|pcalua|sdbinst|odbcconf|ieexec|msdt|control)\.exe$/

    // Exclude known-good script host parents (approved automation pipelines)
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

    // Exclude approved admin tools acting as the child
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($proc.principal.hostname)
    $office_parent = array_distinct($proc.principal.process.file.full_path)
    $spawned_child = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
