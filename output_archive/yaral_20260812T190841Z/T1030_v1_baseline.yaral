/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:13:29.310609+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_001_Chunked_Exfil_Small_Repeated_Flows {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects a pattern consistent with data-transfer-size-limit exfiltration: a single outbound connection to a non-internal destination carrying an unusually small but non-trivial byte count. Adversaries deliberately chunk data into fixed small transfers to stay below DLP and threshold-based alerting. A single event is low-fidelity; pair with a threshold rule counting repeated small flows to the same destination for higher confidence."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites = "Requires firewall or perimeter flow logs that populate network_bytes_sent (bytes out per connection) and target.ip / target.port. Logs must be normalised to UDM NETWORK_FLOW or NETWORK_CONNECTION with byte counters."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "Heartbeat / keepalive traffic, health-check probes, IoT telemetry, streaming protocols that naturally produce small fixed-size frames, CDN prefetch requests, DNS-over-HTTPS clients."
    tuning_guidance = "Raise the lower bound of the byte-range filter if heartbeat traffic dominates. Add known-good CDN and SaaS egress ranges to %global_allowed_egress_cidrs. Add sanctioned cloud-storage destinations to %global_allowed_cloud_storage_hosts. Adjust the upper bound (currently 65535 bytes) to match your organisation's typical minimum file-transfer size."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Outbound only - source port is ephemeral (>1023), destination port is
    // a service port. Firewall logs do not carry process context.
    $net.principal.port > 1023
    $net.target.port > 0
    $net.target.port < 65536

    // Byte window that is characteristic of deliberate chunking:
    // large enough to carry real data, small enough to evade threshold alerts.
    // Tune the upper bound to your environment's baseline transfer sizes.
    $net.network.sent_bytes > 512
    $net.network.sent_bytes < 65536

    // Exclude destinations that are known-internal or approved egress.
    not $net.target.ip in %global_allowed_egress_cidrs
    not $net.target.hostname in %global_allowed_cloud_storage_hosts

    // Exclude common low-risk service ports that naturally produce small frames
    // (DNS=53, NTP=123, ICMP echo handled separately by most firewalls).
    not $net.target.port = 53
    not $net.target.port = 123
    not $net.target.port = 443

  outcome:
    $risk_score        = max(45)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
