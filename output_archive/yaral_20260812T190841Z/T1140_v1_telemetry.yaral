/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:09:20.808729+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_001_macOS_Decoded_Artifact_File_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation of decoded or deobfuscated artifacts on macOS by monitoring for files written to sensitive or staging locations with extensions and path patterns consistent with payload delivery. Attackers decode hidden payloads (base64, openssl, xxd, python) and write the result to disk; this rule catches the resulting file artifact rather than the decoding command line, providing a complementary detection layer that is harder to evade."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Requires macOS EDR or unified log telemetry that records FILE_CREATION events with target.file.full_path and principal.process.file.full_path populated. Tested against CrowdStrike Falcon and SentinelOne macOS agents normalised to Chronicle UDM."
    platform        = "macOS"
    log_source      = "macos_endpoint"
    false_positives = "Software update agents writing temporary binaries, Xcode build pipelines, legitimate package managers (Homebrew, MacPorts) extracting archives, developer tools decoding test fixtures."
    tuning_guidance = "Add trusted parent process paths (e.g. Homebrew, Xcode, MDM agents) to %macos_allowed_file_writers. Add known-safe staging directories to %macos_allowed_staging_paths. Narrow the file extension regex if dylib or Mach-O false positives dominate."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File lands in a user-writable or world-writable staging location
    // typical of decoded payload drop: /tmp, /var/folders, /Users/*/Downloads,
    // /Users/*/Library/Application Support, /Users/*/Library/Caches,
    // /private/tmp, or the root of a user home directory.
    $file.target.file.full_path = /^(\/private)?\/tmp\//  nocase or
    $file.target.file.full_path = /^\/var\/folders\//     nocase or
    $file.target.file.full_path = /^\/Users\/[^\/]+\/(Downloads|Desktop|Library\/(Application Support|Caches|Containers))\// nocase

    // File extension consistent with a decoded executable or script artifact:
    // Mach-O dylib, generic binary (.bin), shell script, Python script,
    // Perl script, Ruby script, or no extension (raw Mach-O drop).
    // Deliberately excludes common document types to reduce noise.
    $file.target.file.full_path = /\.(dylib|so|bin|sh|py|pl|rb|command|pkg|dmg|app|o|out)$/ nocase

    // Parent process is a scripting runtime or shell — the process that
    // performed the decode step and is now writing the result.
    // Matches: bash, zsh, sh, python3, python, perl, ruby, osascript,
    // node, curl (piped decode), openssl.
    $file.principal.process.file.full_path = /\/(bash|zsh|sh|python3?|perl|ruby|osascript|node|openssl|curl|php)$/ nocase

    // Exclude known-safe parent processes added by the MSSP tuning list
    not $file.principal.process.file.full_path in %macos_allowed_file_writers

    // Exclude known-safe destination paths (e.g. Homebrew cellar, Xcode DerivedData)
    not $file.target.file.full_path in %macos_allowed_staging_paths

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
