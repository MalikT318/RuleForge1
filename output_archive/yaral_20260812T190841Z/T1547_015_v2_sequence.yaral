/*
  MITRE Technique : T1547.015 - Login Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:12:41.826679+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_015_LoginItem_File_Then_LaunchServices_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a login item plist or LSSharedFileList entry written to a user Library path followed by a process launched via LaunchServices or loginwindow within the same time window. This correlation provides additive coverage beyond command-line detection by joining the file-write event to the resulting process execution, catching both scripted (AppleScript/osascript) and API-based (SMLoginItemSetEnabled) persistence mechanisms."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.015"
    mitre_technique_name = "Boot or Logon Autostart Execution: Login Items"
    log_prerequisites = "Requires macOS EDR or unified log telemetry producing FILE_CREATION and PROCESS_LAUNCH UDM events with principal.process and target.process populated. Tested against CrowdStrike Falcon and SentinelOne macOS agents normalised to Chronicle UDM."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate applications that register login items at install time (e.g. cloud sync clients, communication apps, licensed software helpers). Managed deployment tools (Jamf, Munki) writing login item plists. User-initiated System Preferences changes."
    tuning_guidance = "Add known-good parent process paths to %macos_allowed_loginitem_writers. Add known-good application bundle paths to %macos_allowed_loginitem_targets. Scope by hostname list for managed fleets where login items are expected."

  events:
    // Leg 1: a file is created in a user or system login item location
    // Covers LSSharedFileList plist writes and SMLoginItemSetEnabled helper drops
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/Application Support\/com\.apple\.backgroundtaskmanagementagent/ nocase
      or
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/Preferences\/ByHost\/com\.apple\.loginitems/ nocase
      or
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/LaunchAgents\/.*\.plist$/ nocase
      or
      $file.target.file.full_path = /\/Library\/LaunchAgents\/.*\.plist$/ nocase
      or
      $file.target.file.full_path = /\/Library\/Application Support\/.*\.plist$/ nocase
    )
    not $file.principal.process.file.full_path in %macos_allowed_loginitem_writers
    $file.principal.hostname = $hostname

    // Leg 2: a process is subsequently launched by loginwindow, launchd, or
    // LaunchServices — the canonical parents for login item execution on macOS
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.principal.process.file.full_path = /\/sbin\/launchd$/ nocase
      or
      $proc.principal.process.file.full_path = /\/System\/Library\/CoreServices\/loginwindow\.app/ nocase
      or
      $proc.principal.process.file.full_path = /\/usr\/libexec\/lsd$/ nocase
      or
      $proc.principal.process.file.full_path = /\/System\/Library\/Frameworks\/CoreServices\.framework/ nocase
    )
    not $proc.target.process.file.full_path in %macos_allowed_loginitem_targets
    $proc.principal.hostname = $hostname

    // Chronological ordering: file write must precede the process launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.015")
    $primary_entity = array_distinct($hostname)
    $loginitem_files_written = array_distinct($file.target.file.full_path)
    $loginitem_writer_process = array_distinct($file.principal.process.file.full_path)
    $launched_process = array_distinct($proc.target.process.file.full_path)
    $launched_process_cmdline = array_distinct($proc.target.process.command_line)
    $launchd_parent = array_distinct($proc.principal.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
