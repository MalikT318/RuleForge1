/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:11:13.024885+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSASS_Driver_Priv_Escalation_After_Auth_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a privilege escalation or permission change event on an account shortly after an anomalous authentication event (e.g., failed then succeeded, or login from unusual context). This correlation targets the identity-plane side of LSASS driver persistence: adversaries who implant an LSASS driver often need to first elevate or re-authenticate to gain the privileges required to write into LSA-protected paths or modify LSA registry keys. Additive coverage over process-creation rules by focusing on the identity provider audit trail rather than endpoint command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires identity provider sign-in logs and directory audit logs normalised to UDM USER_LOGIN and USER_CHANGE_PERMISSIONS events. Both event types must be ingested and correlated in Chronicle."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate IT administrators performing planned privilege assignments immediately after logging in; automated provisioning pipelines; break-glass account usage; service accounts with scheduled permission rotations."
    tuning_guidance = "Add known privileged admin accounts to %global_allowed_priv_admin_accounts and known provisioning service principals to %global_allowed_provisioning_principals. Narrow the match window if false-positive rate is high in environments with frequent just-in-time access workflows."

  events:
    // Leg 1: anomalous or elevated-risk authentication event
    $auth.metadata.event_type = "USER_LOGIN"
    // Target accounts that are not excluded service/provisioning principals
    not $auth.target.user.userid in %global_allowed_provisioning_principals
    not $auth.target.user.userid in %global_allowed_priv_admin_accounts
    // Capture the authenticated user as the join key
    $auth.target.user.userid = $userid

    // Leg 2: a permission or privilege change applied to or by the same user
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    // The same user is the subject of the privilege change (target side)
    $priv.target.user.userid = $userid
    // Exclude known automated provisioning principals on the actor side as well
    not $priv.principal.user.userid in %global_allowed_provisioning_principals
    not $priv.target.user.userid in %global_allowed_priv_admin_accounts

    // Chronological ordering: authentication must precede the privilege change
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $userid over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($userid)
    $auth_event_count = count($auth.metadata.id)
    $priv_change_count = count($priv.metadata.id)
    $auth_principal_hosts = array_distinct($auth.principal.hostname)
    $priv_actor_users = array_distinct($priv.principal.user.userid)
    $priv_target_users = array_distinct($priv.target.user.userid)

  condition:
    $auth and $priv
}
