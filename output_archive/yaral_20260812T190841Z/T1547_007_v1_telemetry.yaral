/*
  MITRE Technique : T1547.007 - Re-opened Applications
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:10:36.910714+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_007_LoginWindow_Plist_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of com.apple.loginwindow UUID plist files under ~/Library/Preferences/ByHost. Adversaries abuse this mechanism (T1547.007) to persist malicious application paths that are automatically reopened on next user login. This rule targets the resulting file artifact rather than process command-line arguments, providing coverage orthogonal to process-creation detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.007"
    mitre_technique_name = "Boot or Logon Autostart Execution: Re-opened Applications"
    log_prerequisites = "Requires macOS EDR or unified log telemetry with file event visibility into user Library directories. The EDR agent must report FILE_CREATION and FILE_MODIFICATION events with target.file.full_path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate macOS session restore when a user selects 'Reopen windows when logging back in' at logout. System-level plist updates by WindowServer or loginwindow during normal logout/restart cycles."
    tuning_guidance = "Scope exclusions by principal.process.file.full_path: add /System/Library/CoreServices/loginwindow.app and WindowServer to %macos_allowed_loginwindow_writers. Consider suppressing events where the writing process is codesign-verified Apple system software if your EDR surfaces that attribute. Alert fidelity improves significantly when correlated with non-Apple process ancestry."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/Preferences\/ByHost\/com\.apple\.loginwindow\.[0-9A-Fa-f\-]+\.plist$/ nocase
    not $file.principal.process.file.full_path = /\/System\/Library\// nocase
    not $file.principal.process.file.full_path = /\/usr\/libexec\// nocase
    not $file.principal.process.file.full_path in %macos_allowed_loginwindow_writers

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1547.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $affected_plist = array_distinct($file.target.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
