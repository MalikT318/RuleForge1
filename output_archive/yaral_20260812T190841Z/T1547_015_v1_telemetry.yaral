/*
  MITRE Technique : T1547.015 - Login Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:12:18.839707+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_015_Login_Item_Plist_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of plist files in macOS Login Items directories used by the Service Management Framework or shared file list mechanism. Adversaries abuse these locations to persist across user logins without appearing in System Preferences. This rule targets the resulting file artifact rather than the process command line, providing coverage orthogonal to process-creation detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.015"
    mitre_technique_name = "Boot or Logon Autostart Execution: Login Items"
    log_prerequisites = "Requires macOS EDR or unified log telemetry that emits FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated. Verified with CrowdStrike Falcon for Mac, SentinelOne macOS agent, and Jamf Protect."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate application installers writing their own login item plists (e.g., cloud sync clients, communication apps, licensed software). Software update agents may also write to these paths during upgrades."
    tuning_guidance = "Populate %macos_allowed_login_item_writers with full paths of known-good parent processes (e.g., /Library/Application Support/<vendor>/updater). Populate %macos_allowed_login_item_paths with specific plist paths belonging to approved applications. Consider scoping alerts to non-standard bundle identifiers or plists written by processes outside /Applications."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target the canonical macOS Login Items plist storage locations:
    // 1. Per-user shared file list (visible in System Preferences / Login Items)
    // 2. System-wide LaunchAgents used by SMLoginItemSetEnabled
    // 3. Per-user LaunchAgents written by SMF-backed helpers
    // 4. Application bundle Contents/Library/LoginItems (SMF helper location)
    $file.target.file.full_path = /\/(Users\/[^\/]+\/Library\/(Application Support\/com\.apple\.backgroundtaskmanagementagent\/backgrounditems\.btm|LaunchAgents)|Library\/(LaunchAgents|LaunchDaemons)|Applications\/[^\/]+\.app\/Contents\/Library\/LoginItems)\/[^\/]+\.plist$/ nocase

    // Exclude writes originating from known macOS system processes
    not $file.principal.process.file.full_path = /^\/(System\/Library|usr\/libexec|usr\/sbin\/cfprefsd|usr\/bin\/plutil)/ nocase

    // Exclude writes from known-good admin tooling and approved application installers
    not $file.principal.process.file.full_path in %macos_allowed_login_item_writers

    // Exclude known-approved plist paths (e.g., licensed software)
    not $file.target.file.full_path in %macos_allowed_login_item_paths

    // Exclude Apple-signed system update processes by path convention
    not $file.principal.process.file.full_path = /\/System\/Library\/CoreServices\// nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1547.015")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_user = array_distinct($file.principal.user.userid)
    $written_plist = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
