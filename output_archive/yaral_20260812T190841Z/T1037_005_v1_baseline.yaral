/*
  MITRE Technique : T1037.005 - Startup Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:13:54.267493+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_005_StartupItems_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation within /Library/StartupItems, indicating an adversary may be registering a legacy startup item for persistence. Startup items execute as root during the final boot phase. This mechanism is deprecated but still functional on some macOS versions."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.005"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Startup Items"
    log_prerequisites = "Requires macOS EDR or unified log telemetry with file creation events normalized to UDM FILE_CREATION. The EDR agent must capture file system activity under /Library/StartupItems."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy third-party software installers (e.g., older printer drivers, VPN clients) that still use the deprecated StartupItems mechanism. Authorized IT provisioning scripts during initial system setup."
    tuning_guidance = "Add known-good installer parent process paths to %macos_allowed_startup_item_writers. Consider scoping to non-admin user contexts or correlating with unsigned file creation for higher fidelity."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/StartupItems\// nocase
    not $file.principal.process.file.full_path in %macos_allowed_startup_item_writers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
