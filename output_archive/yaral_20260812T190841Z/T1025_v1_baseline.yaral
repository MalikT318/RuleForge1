/*
  MITRE Technique : T1025 - Data from Removable Media
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:13:09.942339+00:00
  Reference       : https://attack.mitre.org/techniques/T1025
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1025_001_Removable_Media_Data_Collection_macOS {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects processes reading files from macOS removable media mount points (/Volumes/) using common data-collection utilities. Adversaries enumerate and stage sensitive files from USB drives, optical disks, or other removable media attached to a compromised host."
    mitre_tactic    = "Collection"
    mitre_technique = "T1025"
    mitre_technique_name = "Data from Removable Media"
    log_prerequisites = "Requires macOS EDR telemetry that records PROCESS_LAUNCH events with full command-line arguments, including access to paths under /Volumes/."
    platform        = "macOS"
    log_source      = "macos_endpoint"
    false_positives = "Backup agents (Time Machine, Carbon Copy Cloner), legitimate media import tools (Photos, iTunes/Music), IT asset management scripts, developer build pipelines copying from mounted disk images."
    tuning_guidance = "Add known backup or media-management process paths to %macos_allowed_removable_media_readers. Narrow scope by excluding specific volume names used for sanctioned backup media if those are predictable in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target process must be operating on a path under /Volumes/ — the canonical
    // macOS mount point for all removable and network-attached volumes.
    // This covers USB drives, optical media, SD cards, and mounted disk images.
    $proc.target.process.command_line = /\/Volumes\// nocase

    // Match common data-collection and file-staging utilities used on macOS.
    // Detect by the binary name rather than full path to survive relocation.
    // Covers: cp, mv, rsync, tar, zip, find, cat, python3, python, perl, ruby,
    // osascript (AppleScript automation), ditto (macOS archive/copy tool),
    // dd (raw copy), and curl/wget used to exfiltrate directly.
    $proc.target.process.file.full_path = /\/(cp|mv|rsync|tar|zip|find|cat|ditto|dd|curl|wget|python3?|perl|ruby|osascript)$/ nocase

    // Exclude the process itself being launched FROM /Volumes/ (installer scenario)
    // by requiring the executable to live outside removable media.
    not $proc.target.process.file.full_path = /^\/Volumes\// nocase

    // Exclude known-good backup and media management processes by parent lineage.
    not $proc.principal.process.file.full_path in %macos_allowed_removable_media_readers

    // Exclude system-level orchestration that legitimately mounts and reads volumes.
    not $proc.principal.process.file.full_path = /\/(diskarbitrationd|fseventsd|mds|mdworker|Spotlight)$/ nocase

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1025")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $collecting_process = array_distinct($proc.target.process.file.full_path)
    $volume_path       = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
