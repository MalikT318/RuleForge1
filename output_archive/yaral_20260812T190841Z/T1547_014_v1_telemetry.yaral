/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:11:54.723222+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_ActiveSetup_StubPath_Registry_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of a StubPath value under the Active Setup Installed Components registry key. Adversaries abuse this mechanism to persist a payload that executes under the user context at each logon. This rule pivots on the registry state change rather than process command-line arguments, providing coverage that is complementary to process-creation detections."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_CREATION / REGISTRY_MODIFICATION events. Sysmon Event ID 12/13 or equivalent EDR registry events must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers (e.g., Microsoft Office, Visual Studio, .NET runtime) that register components under Active Setup during installation or update. Group Policy-driven software deployment may also write StubPath values."
    tuning_guidance = "Populate %active_setup_allowed_components with GUIDs of known-good software components observed in your environment. Populate %global_allowed_admin_tools with paths of approved deployment tools that legitimately write these keys. Consider adding a parent-process filter once baseline is established."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\/i nocase
    $reg.target.registry.registry_value_name = /^StubPath$/ nocase
    not $reg.target.registry.registry_key in %active_setup_allowed_components
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_registry_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $stubpath_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
