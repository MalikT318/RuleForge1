/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:11:40.177038+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_PrintProcessor_RegistryThenPrivilegedLogin {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a print-processor registry key being written under the Windows Print Environments path, followed within 10 minutes by an interactive or remote login from the same host. Adversaries register a malicious DLL as a print processor via the registry, then trigger the spooler (or reboot) to load it under SYSTEM. The subsequent login may represent the attacker validating persistence or the system returning from a forced restart. This rule provides identity-plane coverage additive to process-creation rules."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires Windows registry audit telemetry (Sysmon Event ID 13 or equivalent EDR) AND identity provider / Windows Security authentication logs normalised to UDM USER_LOGIN. Both sources must be ingested and normalised into Chronicle UDM."
    platform        = "Windows"
    log_source      = "identity"
    false_positives = "Legitimate print driver deployment via GPO or software packaging tools (e.g., PaperCut, Printix, Lexmark Universal Print). Print server administrators installing new print environments. Automated OS patching that touches print spooler registry keys."
    tuning_guidance = "Add known print-management service accounts to %global_allowed_print_admin_users. Add authorised print-server hostnames to %global_allowed_print_servers. Raise severity to Critical if the subsequent login is from an external IP or uses a privileged account."

  events:
    // Event 1: Registry write to the Print Processors path
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Control\\Print\\Environments\\.*\\Print Processors\\/i nocase
    $reg.target.registry.registry_value_name = /driver/ nocase
    not $reg.principal.user.userid in %global_allowed_print_admin_users
    not $reg.principal.hostname in %global_allowed_print_servers
    $reg.principal.hostname = $hostname

    // Event 2: A login event on the same host shortly after
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.user.userid in %global_allowed_print_admin_users

    // Chronological ordering: registry write must precede the login
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1547.012")
    $primary_entity      = array_distinct($hostname)
    $modified_reg_keys   = array_distinct($reg.target.registry.registry_key)
    $reg_value_names     = array_distinct($reg.target.registry.registry_value_name)
    $writing_user        = array_distinct($reg.principal.user.userid)
    $login_user          = array_distinct($auth.principal.user.userid)
    $login_count         = count($auth.metadata.event_timestamp.seconds)

  condition:
    $reg and $auth
}
