/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:10:20.491274+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_Kext_File_Drop_macOS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a kernel extension bundle (.kext) on macOS at the file-artifact layer. Adversaries load malicious kexts to achieve kernel-level persistence and privilege escalation (Ring 0). This rule fires on the resulting file state change rather than the kextload command line, providing coverage against command-line log evasion."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires macOS EDR file telemetry (FILE_CREATION or FILE_MODIFICATION events) with target.file.full_path populated. Verified against CrowdStrike Falcon, SentinelOne, and Jamf Protect UDM normalisation."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate third-party hardware drivers (audio interfaces, USB adapters, VPN clients, virtualisation software such as Parallels or VMware Fusion), Apple system updates, developer testing of signed kexts."
    tuning_guidance = "Populate %macos_allowed_kext_paths with known-good kext bundle paths (e.g. /Library/Extensions/CrowdStrike.kext). Populate %macos_allowed_kext_writers with authorised installer process paths (e.g. /usr/sbin/installer, /Library/Apple/usr/bin/kmutil). Reduce severity for hosts in the %macos_developer_workstations reference list."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be inside a .kext bundle - covers both system and user extension directories
    $file.target.file.full_path = /\/(System\/Library\/Extensions|Library\/Extensions|Users\/[^\/]+\/Library\/Extensions)\/[^\/]+\.kext\// nocase

    // The written file is the binary or Info.plist inside the bundle - both are meaningful
    $file.target.file.full_path = /\/(Contents\/(MacOS\/[^\/]+|Info\.plist)|_CodeSignature\/CodeResources)$/ nocase

    // Exclude known-good kext paths confirmed by the MSSP reference list
    not $file.target.file.full_path in %macos_allowed_kext_paths

    // Exclude authorised installer and update processes
    not $file.principal.process.file.full_path in %macos_allowed_kext_writers

    // Exclude Apple-signed system update paths writing into System/Library
    not $file.principal.process.file.full_path = /\/System\/Library\/CoreServices\// nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $kext_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
