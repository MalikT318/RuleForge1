/*
  MITRE Technique : T1547.007 - Re-opened Applications
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:10:54.593572+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_007_LoginwindowPlist_Modified_Then_Process_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects modification or creation of a com.apple.loginwindow ByHost plist file followed by a process launch from a user Library path, indicating potential persistence via the Re-opened Applications mechanism (T1547.007). Adversaries write a malicious application path into the loginwindow UUID plist so their payload executes on next user login."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.007"
    mitre_technique_name = "Boot or Logon Autostart Execution: Re-opened Applications"
    log_prerequisites = "Requires macOS EDR or unified log telemetry producing FILE_CREATION or FILE_MODIFICATION events for plist writes under ~/Library/Preferences/ByHost, and PROCESS_LAUNCH events with full process path and parent process information."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate macOS session restore on logout/login when the user has 'Reopen windows when logging back in' checked. Applications that legitimately register themselves via this mechanism (e.g., productivity suites). macOS system daemons writing session state."
    tuning_guidance = "Populate %macos_allowed_loginwindow_writers with known-good application bundle paths (e.g., /Applications/Safari.app). Populate %macos_allowed_session_restore_processes with expected session-restore process paths. Narrow the plist regex if only specific UUID patterns are observed in your environment."

  events:
    // Leg 1: plist file written under the ByHost directory for loginwindow session restore
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/Preferences\/ByHost\/com\.apple\.loginwindow\.[0-9A-Fa-f\-]+\.plist$/ nocase
    not $file.principal.process.file.full_path in %macos_allowed_loginwindow_writers
    $file.principal.user.userid = $userid

    // Leg 2: process launched from a user Library path shortly after the plist write
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/Users\/[^\/]+\/Library\// nocase
    not $proc.target.process.file.full_path in %macos_allowed_session_restore_processes
    $proc.principal.user.userid = $userid

    // Chronological ordering: plist write must precede the process launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $userid over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_plist_paths = array_distinct($file.target.file.full_path)
    $launched_process_paths = array_distinct($proc.target.process.file.full_path)
    $plist_writer_process = array_distinct($file.principal.process.file.full_path)
    $affected_userids = array_distinct($userid)

  condition:
    $file and $proc
}
