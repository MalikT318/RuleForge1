/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:14:16.918596+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Local_Email_Collection_Outlook_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes other than Outlook itself reading or accessing Outlook local data files (.ost/.pst) from user profile directories. Adversaries collect these files to harvest email content offline without needing live Outlook access."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires EDR file telemetry (FILE_READ or FILE_OPEN events) capturing the accessing process path and target file path. CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon with file access auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup agents (Veeam, Acronis, Windows Backup), antivirus on-access scanning, PST migration tools, authorised archiving solutions, Outlook itself during normal operation."
    tuning_guidance = "Add known backup agent and archiving tool paths to %global_allowed_email_backup_tools. Add authorised admin or migration process paths to the same list. Consider scoping to non-business hours if backup windows are predictable."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target must be an Outlook local data file
    $file.target.file.full_path = /\\(AppData\\Local\\Microsoft\\Outlook|Documents\\Outlook Files)\\[^\\]+\.(ost|pst)$/ nocase

    // The accessing process must NOT be Outlook itself
    not $file.principal.process.file.full_path = /\\OUTLOOK\.EXE$/ nocase

    // Exclude known-safe backup and system processes
    not $file.principal.process.file.full_path in %global_allowed_email_backup_tools

    // Exclude Windows system paths that legitimately touch these files (indexing, search)
    not $file.principal.process.file.full_path = /\\(SearchIndexer|SearchProtocolHost|MsMpEng|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $target_file = array_distinct($file.target.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
