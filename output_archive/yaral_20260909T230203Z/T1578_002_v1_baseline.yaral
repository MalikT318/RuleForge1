/*
  MITRE Technique : T1578.002 - Create Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:20:02.204446+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_002_Cloud_Instance_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation of a new cloud compute instance or virtual machine via cloud provider audit logs. Adversaries create new instances to bypass existing firewall rules, security policies, and monitoring controls applied to existing instances, enabling data collection or staging in a less-restricted environment."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1578.002"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Cloud Instance"
    log_prerequisites = "Requires cloud provider control-plane audit logs (e.g., AWS CloudTrail RunInstances, Azure Activity CreateOrUpdate VirtualMachines, GCP Audit compute.instances.insert) normalised into Chronicle UDM RESOURCE_CREATION events."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Authorised DevOps pipelines, auto-scaling groups, infrastructure-as-code deployments (Terraform, CloudFormation, Pulumi), and CI/CD systems creating instances as part of normal build or test workflows."
    tuning_guidance = "Add known automation and deployment service principals to %global_allowed_cloud_principals. Add known scanner or deployment source identities to %global_allowed_scanners. Consider narrowing by time-of-day or correlating with a preceding snapshot creation event (T1578.001) to raise fidelity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Match compute instance / virtual machine creation API actions across
    // normalised cloud providers. Chronicle UDM maps the provider-specific
    // API call name into target.resource.resource_subtype or
    // metadata.product_event_type. We match both to maximise coverage.
    (
      $cloud.target.resource.resource_subtype = /(?i)(instance|virtual.?machine|vm)/ or
      $cloud.metadata.product_event_type = /(?i)(RunInstances|CreateVirtualMachine|compute\.instances\.insert|instances\.insert)/
    )

    // Exclude known automation and deployment principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known scanner / security-testing identities
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1578.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_name  = array_distinct($cloud.target.resource.name)
    $resource_type  = array_distinct($cloud.target.resource.resource_subtype)
    $source_ip      = array_distinct($cloud.principal.ip)
    $event_action   = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
