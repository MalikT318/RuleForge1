/*
  MITRE Technique : T1559.002 - Dynamic Data Exchange
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:15:14.538667+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_002_DDE_Office_Child_Process {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects Dynamic Data Exchange (DDE) abuse in Microsoft Office applications. DDE allows Office documents to spawn arbitrary child processes without VBA macros. This rule fires when a Microsoft Office application (Word, Excel, PowerPoint, Outlook) directly spawns a command interpreter, scripting host, or other execution utility - the canonical indicator of DDE payload execution triggered from a poisoned document or email."
    mitre_tactic    = "Execution"
    mitre_technique = "T1559.002"
    mitre_technique_name = "Inter-Process Communication: Dynamic Data Exchange"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (Process Create) with parent process tracking. Parent process field must be populated in UDM (principal.process.file.full_path)."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate Office automation scripts, mail-merge workflows invoking shell commands, developer tooling that launches interpreters from Office add-ins, or RMM agents that integrate with Office applications."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools. Scope exclusions to specific hosts using %global_allowed_script_hosts. If a specific Office application generates persistent FPs (e.g., Outlook with an approved add-in), narrow the parent regex to exclude it."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent must be a Microsoft Office application
    $proc.principal.process.file.full_path = /\\(WINWORD|EXCEL|POWERPNT|OUTLOOK|MSACCESS|MSPUB|ONENOTE)\.exe$/  nocase

    // Child process must be a command interpreter, scripting host, or execution utility
    // commonly abused via DDE payloads
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|certutil|bitsadmin|wmic|conhost|bash|sh)\.exe$/ nocase

    // Exclude known-good administrative tooling and script hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1559.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $office_parent = array_distinct($proc.principal.process.file.full_path)
    $child_process  = array_distinct($proc.target.process.file.full_path)
    $child_cmdline  = array_distinct($proc.target.process.command_line)
    $affected_user  = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
