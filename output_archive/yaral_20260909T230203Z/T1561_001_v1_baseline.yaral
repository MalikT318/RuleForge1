/*
  MITRE Technique : T1561.001 - Disk Content Wipe
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:15:59.718265+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_001_Disk_Content_Wipe_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects process launches consistent with direct disk content wiping on Windows. Adversaries use built-in utilities or invoke raw disk access patterns (e.g., writing to physical drive paths, using cipher with overwrite flags, or format with no-prompt flags) to overwrite arbitrary disk sectors, rendering data irrecoverable. This targets the OS mechanism of direct disk access rather than file-level deletion."
    mitre_tactic = "Impact"
    mitre_technique = "T1561.001"
    mitre_technique_name = "Disk Wipe: Disk Content Wipe"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Security Event 4688 with full command-line logging enabled."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorized disk sanitization by IT asset disposal teams, cipher.exe scheduled runs for free-space wiping, format operations during OS deployment, disk benchmarking tools."
    tuning_guidance = "Add authorized disk-wiping parent processes or service accounts to %global_allowed_admin_tools and %global_allowed_service_accounts. Scope by hostname or user if disk-sanitization workflows are known and scheduled."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match known Windows built-in and LOLBin disk-wipe invocation patterns.
    // cipher /w overwrites free space; format /q /y suppresses prompts for rapid destructive use;
    // diskpart with script flags enables scripted partition/volume destruction.
    // Each branch targets the COMBINATION of binary + destructive flag, not just the binary name.
    (
      // cipher.exe used to overwrite free space on a volume
      (
        $proc.target.process.file.full_path = /\\cipher\.exe$/ nocase
        and $proc.target.process.command_line = /\/w:/ nocase
      )
      or
      // format.exe invoked non-interactively (suppressed prompts = scripted destruction)
      (
        $proc.target.process.file.full_path = /\\format\.com$/ nocase
        and $proc.target.process.command_line = /\/q/ nocase
        and $proc.target.process.command_line = /\/y/ nocase
      )
      or
      // diskpart.exe invoked with a script file (enables automated partition/volume wipe)
      (
        $proc.target.process.file.full_path = /\\diskpart\.exe$/ nocase
        and $proc.target.process.command_line = /\/s\s+\S+/ nocase
      )
      or
      // PowerShell or cmd writing directly to a physical drive path (\\.\PhysicalDriveN)
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd)\.exe$/ nocase
        and $proc.target.process.command_line = /\\\\\.\\.*(PhysicalDrive|HarddiskVolume)/ nocase
      )
      or
      // wmic or PowerShell invoking Win32_DiskDrive or storage WMI classes for raw access
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and $proc.target.process.command_line = /Win32_DiskDrive/ nocase
      )
    )

    // Exclude known-good administrative and deployment tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1561.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
