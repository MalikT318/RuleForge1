/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:13:13.900286+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Golden_Ticket_Kerberos_Anomaly {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects Windows Security Event 4769 (Kerberos TGS request) where the ticket encryption type is RC4-HMAC (0x17) and the ticket options indicate a forged golden ticket pattern. Legitimate modern environments use AES256 (0x12) or AES128 (0x11). RC4-HMAC TGS requests from non-service accounts, especially with unusual ticket options or targeting sensitive SPNs, are a high-fidelity indicator of golden ticket usage. Also detects Event 4768 (TGT request) with RC4 encryption from accounts that should not be using legacy encryption."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires Windows Security Event Log with Kerberos Service Ticket Operations (Event 4769) and Kerberos Authentication Service (Event 4768) auditing enabled. Events must be forwarded and normalised into Chronicle UDM USER_LOGIN records."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legacy applications and services that are explicitly configured to use RC4 encryption (DES/RC4 compatibility mode). Older Windows clients (pre-Vista) or third-party Kerberos implementations. Service accounts with msDS-SupportedEncryptionTypes set to RC4 only."
    tuning_guidance = "Add known legacy service accounts that legitimately use RC4 to %global_allowed_service_accounts. Verify that domain functional level and GPO enforce AES encryption; if RC4 is disabled domain-wide, false positive rate drops to near zero. Consider narrowing to specific high-value target hostnames (DCs, file servers) if noise is high."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Kerberos authentication events - TGT (4768) or TGS (4769) requests
    // UDM normalises Windows Security Kerberos events into USER_LOGIN
    // RC4-HMAC encryption type (0x17 = 23 decimal) is the golden ticket indicator
    // AES-based encryption (0x11=17, 0x12=18) is expected in modern environments
    $auth.network.application_protocol = "KERBEROS" nocase

    // RC4-HMAC encryption type used in ticket - primary golden ticket signal
    // Chronicle normalises the Kerberos encryption type into extensions or description fields
    $auth.security_result.description = /(?i)(rc4|0x17|encryption.*type.*23|etype.*23|etype.*0x17)/

    // Exclude well-known service accounts that legitimately use RC4
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude known scanners and security testing infrastructure
    not $auth.principal.hostname in %global_allowed_scanners

    // Exclude approved admin users performing legitimate Kerberos operations
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Exclude internal management sources that may use legacy auth
    not $auth.principal.ip in %rfc1918_internal

  outcome:
    $risk_score        = max(90)
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity    = array_distinct($auth.principal.hostname)
    $affected_user     = array_distinct($auth.principal.user.userid)
    $target_host       = array_distinct($auth.target.hostname)
    $auth_description  = array_distinct($auth.security_result.description)

  condition:
    $auth
}
