/*
  MITRE Technique : T1615 - Group Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:27:53.682092+00:00
  Reference       : https://attack.mitre.org/techniques/T1615
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1615_Group_Policy_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Group Policy discovery activity via gpresult.exe, PowerShell GPO enumeration functions (Get-DomainGPO, Get-GPO, Get-GPResultantSetOfPolicy), or direct SYSVOL policy path access. Adversaries enumerate GPO settings to identify privilege escalation paths and security controls."
    mitre_tactic = "Discovery"
    mitre_technique = "T1615"
    mitre_technique_name = "Group Policy Discovery"
    log_prerequisites = "Requires EDR process telemetry or Windows Event ID 4688 with command-line auditing enabled. PowerShell script-block logging (Event ID 4104) also surfaces this activity."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "IT administrators running gpresult for troubleshooting, Group Policy management tools (GPMC), software deployment agents querying GPO state, monitoring and compliance tooling."
    tuning_guidance = "Add known administrative hosts to %global_allowed_admin_tools and known admin accounts to %global_allowed_admin_users. Consider raising severity if the initiating process is an Office application, script interpreter spawned from a non-admin context, or a remote management tool not in %global_allowed_remote_mgmt."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match gpresult.exe directly or PowerShell invoking GPO discovery cmdlets/functions
    (
      $proc.target.process.file.full_path = /\\gpresult\.exe$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /Get-DomainGPO/ nocase
          or
          $proc.target.process.command_line = /Get-DomainGPOLocalGroup/ nocase
          or
          $proc.target.process.command_line = /Get-DomainGPOComputerLocalGroupMapping/ nocase
          or
          $proc.target.process.command_line = /Get-DomainGPOUserLocalGroupMapping/ nocase
          or
          $proc.target.process.command_line = /Get-GPO/ nocase
          or
          $proc.target.process.command_line = /Get-GPResultantSetOfPolicy/ nocase
          or
          $proc.target.process.command_line = /Get-GPOReport/ nocase
          or
          $proc.target.process.command_line = /SYSVOL/ nocase
        )
      )
    )

    // Exclude known administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1615")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
