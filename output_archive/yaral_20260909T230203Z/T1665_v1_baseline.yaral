/*
  MITRE Technique : T1665 - Hide Infrastructure
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:32:01.062058+00:00
  Reference       : https://attack.mitre.org/techniques/T1665
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1665_001_DNS_High_Entropy_Long_Subdomain_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS queries exhibiting characteristics of hidden C2 infrastructure: abnormally long subdomain labels, high-entropy algorithmically generated domain components, or abuse of uncommon record types (TXT, NULL) commonly used for DNS tunneling and C2 channel concealment. Adversaries use these techniques to blend malicious traffic with legitimate DNS and evade infrastructure detection."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1665"
    mitre_technique_name = "Hide Infrastructure"
    log_prerequisites = "Requires DNS query/resolver logs normalized to UDM NETWORK_DNS events. Fields needed: network.dns.questions.name, network.dns.questions.type, principal.hostname or principal.ip."
    platform = "Network Devices"
    log_source = "dns"
    false_positives = "CDN providers with long subdomain labels, legitimate TXT record lookups (SPF/DKIM validation), cloud service discovery endpoints, some telemetry and analytics platforms using encoded subdomains."
    tuning_guidance = "Add known-good high-entropy domains (CDNs, analytics, cloud services) to %global_allowed_domains. Adjust subdomain length threshold based on environment baseline. Consider excluding internal resolver sources via %global_allowed_mgmt_sources."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Exclude known-good domains
    not $dns.network.dns.questions.name in %global_allowed_domains

    // Exclude internal management sources (authorised scanners, resolvers)
    not $dns.principal.ip in %global_allowed_mgmt_sources

    (
      // Long subdomain label indicative of DGA or DNS tunneling
      // Matches queries where the leftmost label exceeds ~40 characters
      $dns.network.dns.questions.name = /^[a-zA-Z0-9\-]{40,}\.[a-zA-Z0-9\-]+\.[a-zA-Z]{2,}$/ nocase

      or

      // Multi-level deeply nested subdomain (4+ labels) with encoded-looking segments
      // Common in DNS tunneling tools that encode data across subdomain levels
      $dns.network.dns.questions.name = /^[a-zA-Z0-9\-]{8,}\.[a-zA-Z0-9\-]{8,}\.[a-zA-Z0-9\-]{8,}\.[a-zA-Z0-9\-]+\.[a-zA-Z]{2,}$/ nocase

      or

      // High-entropy hex or base32/base64-like subdomain segments
      // Matches labels composed entirely of hex characters (length >= 16) suggesting encoded payloads
      $dns.network.dns.questions.name = /^[a-f0-9]{16,}\.[a-zA-Z0-9\-]+\.[a-zA-Z]{2,}$/ nocase

      or

      // Abuse of TXT record type for C2 channel (DNS-over-TXT tunneling)
      // TXT queries to non-allowlisted domains are rare in legitimate traffic
      $dns.network.dns.questions.type = 16

      or

      // NULL record type (type 10) - almost exclusively used for DNS tunneling
      $dns.network.dns.questions.type = 10
    )

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = "T1665"
    $primary_entity = $dns.principal.ip

  condition:
    $dns
}
