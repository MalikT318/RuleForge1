/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:16:37.986255+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Remote_Session_Hijack_Suspicious_SSH_Lateral {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable indicators of SSH session hijacking or lateral movement via remote services. Specifically targets repeated short-lived or high-frequency SSH connections from an internal source to multiple internal destinations, or SSH connections originating from unexpected external sources toward internal management ports (22, 23, 3389). Session hijacking often produces anomalous connection patterns distinct from normal interactive SSH use, such as rapid sequential connections or connections from hosts not normally acting as SSH clients."
    mitre_tactic         = "Lateral Movement"
    mitre_technique      = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites    = "Requires firewall or perimeter flow logs with source/destination IP, port, and protocol. Connections must be logged at session establishment."
    platform             = "Linux"
    log_source           = "firewall"
    false_positives      = "Authorized jump hosts, bastion servers, and SSH proxy infrastructure performing legitimate fan-out connections. Vulnerability scanners and authorized pen-test sources. Automated deployment pipelines using SSH for configuration management (Ansible, Fabric). Backup agents connecting over SSH."
    tuning_guidance      = "Add known bastion/jump-host source IPs to %global_allowed_remote_mgmt. Add authorized scanner sources to %global_allowed_scanners. Add internal management subnets to %rfc1918_internal exclusions where appropriate. Adjust destination port list if non-standard SSH ports are in use."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target remote service session ports: SSH (22), Telnet (23), RDP (3389)
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 3389
    )

    // Source must be an internal address (lateral movement originates internally)
    $net.principal.ip in %rfc1918_internal

    // Destination must also be internal (lateral movement target)
    $net.target.ip in %rfc1918_internal

    // Exclude connections where the source is a known approved management or jump host
    not $net.principal.ip in %global_allowed_remote_mgmt

    // Exclude authorized scanners
    not $net.principal.ip in %global_allowed_scanners

    // Exclude known admin users/service accounts if principal user is populated
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)
    $source_user       = array_distinct($net.principal.user.userid)

  condition:
    $net
}
