/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:18:07.504104+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_Transmitted_Data_Manipulation_Intercept {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process launches consistent with in-transit data manipulation on Linux: tools capable of intercepting, modifying, or replaying network streams or IPC data (e.g., ncat, socat, iptables NFQUEUE/REDIRECT, tc with netem/mirred, mitmproxy, bpf-based interceptors, named pipes used as proxies). These are the OS mechanisms an adversary must invoke to manipulate data between processes or across the network."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH. Auditd syscall rules for execve are sufficient."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Authorised network engineers running socat/ncat for diagnostics, security teams running mitmproxy for authorised testing, iptables rules applied by firewall management scripts, tc rules applied by QoS automation, packet capture tools used by authorised scanners."
    tuning_guidance = "Add authorised parent processes (e.g., Ansible, Chef, Puppet, firewall management daemons) to %global_allowed_admin_tools. Add authorised service accounts that manage iptables/tc to %global_allowed_service_accounts. Add authorised scanner hosts to %global_allowed_scanners."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the set of Linux binaries and tools that can intercept or
    // manipulate in-transit data at the OS level. We target the binary
    // name via the full path to avoid matching unrelated processes that
    // happen to share a substring.
    $proc.target.process.file.full_path = /\/(socat|ncat|netcat|nc|mitmproxy|mitmdump|mitmweb|tcpreplay|tcprepair|nfqueue|scapy|ettercap|bettercap|ssldump|sslstrip|proxychains|proxychains4|tpcdump|hping3|hping|nemesis|packeth|fragroute|fragrouter)$/ nocase

    // Exclude processes launched by known-good administrative tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $actor_user = array_distinct($proc.principal.user.userid)
    $interceptor_binary = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
