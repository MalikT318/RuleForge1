/*
  MITRE Technique : T1651 - Cloud Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:29:35.364660+00:00
  Reference       : https://attack.mitre.org/techniques/T1651
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1651_Cloud_Admin_Command_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects use of cloud management services (e.g., AWS SSM SendCommand, Azure RunCommand, GCP OS Config) to execute commands inside virtual machines via cloud control plane APIs. Adversaries with administrative cloud access can abuse these services to run arbitrary code on VMs without direct SSH/RDP access."
    mitre_tactic = "Execution"
    mitre_technique = "T1651"
    mitre_technique_name = "Cloud Administration Command"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM. AWS: CloudTrail with SSM API events. Azure: Activity Log with RunCommand operations. GCP: Cloud Audit Logs with osconfig or compute API events."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized DevOps automation, patch management pipelines, configuration management tooling (Ansible, Chef, Puppet via cloud APIs), incident response runbooks, and scheduled maintenance scripts executed by approved service accounts."
    tuning_guidance = "Add approved automation service account identifiers to %global_allowed_service_accounts. Add approved cloud management principals to %global_allowed_cloud_principals. Scope further by restricting to sensitive resource groups, accounts, or projects if the environment permits."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match cloud management command execution API operations across AWS SSM,
    // Azure RunCommand, and GCP OS Config / Compute using normalised UDM fields.
    // Chronicle normalises vendor-specific API method names into target.resource.name
    // or metadata.product_event_type; match the canonical operation patterns.
    (
      $cloud.metadata.product_event_type = /(?i)SendCommand/ or
      $cloud.metadata.product_event_type = /(?i)RunCommand/ or
      $cloud.metadata.product_event_type = /(?i)StartAutomationExecution/ or
      $cloud.metadata.product_event_type = /(?i)CreateRunCommand/ or
      $cloud.metadata.product_event_type = /(?i)runCommand/ or
      $cloud.metadata.product_event_type = /(?i)ExecuteCommand/ or
      $cloud.metadata.product_event_type = /(?i)osconfig\.googleapis\.com/ or
      $cloud.metadata.product_event_type = /(?i)patchJobs\.execute/ or
      $cloud.metadata.product_event_type = /(?i)instances\.setMetadata/ or
      $cloud.metadata.product_event_type = /(?i)StartSession/
    )

    // Exclude known-good automation and service principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1651")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)
    $api_operation = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
