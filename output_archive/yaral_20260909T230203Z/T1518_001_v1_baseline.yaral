/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:05:44.059420+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_Cloud_Security_Agent_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of cloud-native security monitoring agents and configurations via cloud provider APIs. Adversaries query installed agents (CloudWatch, Azure Monitor, GCP Cloud Monitor) to identify defensive tooling before deciding whether to proceed with further actions. Signals include Describe/List/Get API calls targeting security agent resources, monitoring configurations, or security hub findings."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM: AWS CloudTrail, Azure Activity Log, or GCP Audit Log. The target.resource.name or target.application fields must be populated with the API action or resource type."
    platform = "IaaS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate monitoring pipelines, compliance scanners, CSPM tools, and DevOps automation that routinely enumerate monitoring agent status. Cloud security posture management (CSPM) service accounts are a common source."
    tuning_guidance = "Add known CSPM and automation service account identifiers to %global_allowed_cloud_principals. Add authorised scanner source IPs to %global_allowed_scanners. Narrow the rule to specific API actions if the broad pattern generates noise."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match API actions that enumerate security agents, monitoring configs, or security findings
    // Covers AWS (Describe/List/Get on GuardDuty, SecurityHub, CloudWatch, Inspector, Macie),
    // Azure (read on Microsoft.Security, Microsoft.Insights, MMA/AMA extensions),
    // GCP (list/get on monitoring agents, Security Command Center, Cloud Armor)
    $cloud.target.resource.name = /(?i)(describeinstances|describemonitoringagent|listdetectors|getdetector|listfindings|getfindings|listmembers|describeinstanceinformation|listagentstatuses|getinsightresults|listinsights|describeassessmenttargets|listassessmentruns|listcoverage|listenabledproductsforimport|getmasteraccount|listinvitations|describestandards|describehub|listpolicies|getpolicy|listassessments|listjobs|listclassificationjobs|getmaciesession|listorganizationadminaccounts|describeorganizationconfiguration|listdelegatedadministrators|getadministratoraccount)/ nocase

    // Also catch broad monitoring/security resource reads that indicate agent enumeration
    $cloud.target.resource.name = /(?i)(cloudwatch|guardduty|securityhub|inspector|macie|securitycenter|microsoft\.security|microsoft\.insights|monitoring\.googleapis|stackdriver|cloudarmor|securitycommandcenter|azuredefender|sentinelworkspace|loganalytics|monitoringagent|azuremonitor|vminsights|guestconfiguration|osconfig|patchmanagement)/ nocase

    // Exclude known-good cloud automation and security service principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
