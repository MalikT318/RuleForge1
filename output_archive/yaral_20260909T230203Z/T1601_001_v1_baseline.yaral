/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:23:18.750547+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Network_Device_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects outbound or inbound file transfer activity over protocols commonly used to stage or replace network device OS images (TFTP, FTP, SCP, SFTP). An adversary patching a system image will typically pull a replacement image or push a modified one using these management-plane protocols. A connection from a network device to an external or unexpected host over these ports is a high-fidelity signal for T1601.001."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs that record source/destination IP and destination port. Management-plane traffic from network device management interfaces must traverse or be visible to the firewall sensor."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized firmware upgrade sessions initiated by network operations teams, automated provisioning systems (ZTP/PnP), and vulnerability scanner probes against management ports. Scheduled backup jobs that SCP running configs to a jump host may also trigger this rule."
    tuning_guidance = "Add approved management jump hosts and provisioning servers to %global_allowed_mgmt_sources and exclude them. Add authorized scanner sources to %global_allowed_scanners. Consider narrowing the match to connections where the source IP belongs to the known network device management subnet range using net.ip_in_range_cidr() if that CIDR is stable across tenants."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match destination ports associated with image transfer protocols:
    // 69 = TFTP, 20/21 = FTP data/control, 22 = SSH/SCP/SFTP, 115 = SFTP (legacy)
    (
      $net.target.port = 69 or
      $net.target.port = 20 or
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 115
    )

    // Destination must be external (not internal RFC1918 space)
    // This catches exfil of images to attacker-controlled infrastructure
    // or pull from an external staging server
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good management sources (authorized jump hosts, provisioning servers)
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude authorized vulnerability scanners probing management ports
    not $net.principal.ip in %global_allowed_scanners

    // Exclude known-good external domains (vendor update services, CDNs)
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $source_ip = array_distinct($net.principal.ip)

  condition:
    $net
}
