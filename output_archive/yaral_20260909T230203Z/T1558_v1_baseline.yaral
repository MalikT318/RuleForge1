/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:12:52.250763+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_Kerberos_Ticket_Theft_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process launches on Linux indicative of Kerberos ticket theft or forging activity. Covers use of kinit with keytab files, klist enumeration of credential caches, ktutil manipulation of keytab files, and access to ccache files from suspicious locations such as /tmp, /dev/shm, or /var/tmp. These are the primary OS mechanisms exploited for Kerberos ticket theft on Linux."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events. Auditd rules should capture execve syscalls."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate Kerberos administration by sysadmins, automated service account kinit renewals, backup or monitoring agents that authenticate via keytab, HPC cluster job schedulers using Kerberos delegation."
    tuning_guidance = "Add authorised service account usernames to %global_allowed_service_accounts and approved parent processes (e.g. cron, systemd) to %global_allowed_admin_tools. Narrow the ccache path regex if your environment stores ccaches in a non-default location."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match Kerberos tooling: kinit, klist, ktutil, kvno, kadmin
    $proc.target.process.file.full_path = /\/(kinit|klist|ktutil|kvno|kadmin)(\.mit)?$/ nocase

    // Require at least one suspicious signal in the command line:
    // - keytab file usage (kinit -kt / --keytab)
    // - explicit ccache path in /tmp, /dev/shm, /var/tmp, /run
    // - ktutil read/write keytab operations
    // - klist -c pointing to non-standard cache
    // - kvno (service ticket enumeration)
    (
      $proc.target.process.command_line = /(\-k|\-\-keytab|\-kt)\s/ nocase or
      $proc.target.process.command_line = /\/tmp\/krb5cc/ nocase or
      $proc.target.process.command_line = /\/dev\/shm\// nocase or
      $proc.target.process.command_line = /\/var\/tmp\// nocase or
      $proc.target.process.command_line = /\/run\/user\// nocase or
      $proc.target.process.command_line = /rkt|wkt|read_kt|write_kt/ nocase or
      $proc.target.process.file.full_path = /\/kvno$/
    )

    // Exclude known-good service accounts performing routine Kerberos operations
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative tooling parents (e.g. Ansible, deployment agents)
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_user = array_distinct($proc.principal.user.userid)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
