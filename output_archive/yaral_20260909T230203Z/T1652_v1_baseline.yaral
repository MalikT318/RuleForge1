/*
  MITRE Technique : T1652 - Device Driver Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:29:54.042174+00:00
  Reference       : https://attack.mitre.org/techniques/T1652
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1652_001_Device_Driver_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects enumeration of local device drivers on Windows via driverquery.exe, PowerShell Get-WmiObject Win32_SystemDriver, or direct registry queries targeting the HKLM\\SYSTEM\\CurrentControlSet\\Services driver hive. Adversaries use driver enumeration to identify security tools, virtualisation artefacts, or exploitable vulnerable drivers for privilege escalation."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1652"
    mitre_technique_name = "Device Driver Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with command_line populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "IT asset inventory tools, vulnerability scanners, driver management software, system health monitoring agents, and legitimate administrator troubleshooting sessions."
    tuning_guidance = "Add known-good parent processes (e.g., RMM agents, inventory tools) to %global_allowed_admin_tools. Add authorised admin accounts to %global_allowed_admin_users to suppress expected administrative activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match driverquery.exe directly, or PowerShell/cmd invoking driver enumeration
    (
      // Native driverquery binary - any invocation enumerates drivers
      $proc.target.process.file.full_path = /(?i)\\driverquery\.exe$/

      or

      // PowerShell querying Win32_SystemDriver WMI class
      (
        $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh)\.exe$/
        and
        (
          $proc.target.process.command_line = /(?i)Win32_SystemDriver/
          or
          $proc.target.process.command_line = /(?i)Get-WmiObject.*driver/
          or
          $proc.target.process.command_line = /(?i)Get-CimInstance.*driver/
          or
          $proc.target.process.command_line = /(?i)EnumDeviceDrivers/
        )
      )

      or

      // reg.exe querying the driver services hive
      (
        $proc.target.process.file.full_path = /(?i)\\reg\.exe$/
        and
        $proc.target.process.command_line = /(?i)CurrentControlSet\\(Services|Control\\Class)/
        and
        $proc.target.process.command_line = /(?i)(query|export)/
      )

      or

      // sc.exe broad service/driver enumeration
      (
        $proc.target.process.file.full_path = /(?i)\\sc\.exe$/
        and
        $proc.target.process.command_line = /(?i)(query\s+type=\s*(kernel|filesys|all)|queryex)/
      )
    )

    // Exclude known-good administrative and security tooling parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised administrator accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score        = max(45)
    $mitre_technique_id = array_distinct("T1652")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
