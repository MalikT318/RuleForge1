/*
  MITRE Technique : T1657 - Financial Theft
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:30:47.439717+00:00
  Reference       : https://attack.mitre.org/techniques/T1657
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1657_001_SaaS_Mass_File_Access_Financial_Theft {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects anomalous mass file access or download activity in M365 that may indicate financial theft via compromised accounts or insider threat. Adversaries performing BEC or financial fraud frequently enumerate and exfiltrate financial documents (invoices, payment records, banking details) from SharePoint, OneDrive, or Exchange to facilitate fraudulent transfers. This rule fires when a single user accesses a large number of resources in a short window, which is a strong behavioural signal for data staging prior to financial fraud."
    mitre_tactic         = "Impact"
    mitre_technique      = "T1657"
    mitre_technique_name = "Financial Theft"
    log_prerequisites    = "Requires Microsoft 365 Unified Audit Log ingested into Chronicle UDM. Relevant workloads: SharePoint, OneDrive, Exchange. Ensure audit logging is enabled for all M365 workloads."
    platform             = "SaaS"
    log_source           = "m365"
    false_positives      = "Automated backup or sync agents, migration tooling, bulk reporting scripts, data loss prevention scanning services, authorised eDiscovery operations."
    tuning_guidance      = "Add known service accounts and migration principals to %global_allowed_service_accounts. Add approved backup or sync processes to %global_allowed_backup_processes. Raise the threshold if baseline user activity is high. Scope to specific sensitive SharePoint sites or document libraries containing financial data to reduce noise."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource must be a document or file type commonly associated
    // with financial data - invoices, spreadsheets, PDFs, payment records.
    // Match on file extensions and common financial naming patterns.
    (
      $access.target.resource.name = /(?i)\.(xlsx|xls|csv|pdf|docx|doc)$/
      or
      $access.target.resource.name = /(?i)(invoice|payment|bank|wire|transfer|finance|payroll|remittance|account|billing|receipt|purchase.?order)/
    )

    // Require an authenticated user principal - exclude anonymous/system actors.
    $access.principal.user.userid != ""
    not $access.principal.user.userid = /(?i)(system|anonymous|sharepoint\s*app|onedrive\s*app)/

    // Exclude known-good service and automation accounts.
    not $access.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good backup and sync processes.
    not $access.principal.user.email_addresses in %global_allowed_backup_processes

    // Exclude internal administrative users expected to perform bulk operations.
    not $access.principal.user.userid in %global_allowed_admin_users

    // Capture the acting user for grouping and outcome.
    $access.principal.user.userid = $userid

  match:
    $userid over 10m

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1657")
    $primary_entity    = array_distinct($access.principal.user.userid)
    $accessed_resources = array_distinct($access.target.resource.name)
    $source_ips        = array_distinct($access.principal.ip)
    $resource_count    = count($access.target.resource.name)

  condition:
    // Require at least 20 distinct financial file access events within the
    // 10-minute window to distinguish bulk enumeration from normal browsing.
    #access >= 20
}
