/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:10:15.536735+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_ROMMONkit_TFTP_Firmware_Transfer {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects potential ROMMONkit activity by identifying TFTP traffic (UDP/69) originating from or destined to network device management-plane addresses from sources not in the approved management source list. Adversaries abuse TFTP to remotely overwrite the ROMMON boot image with malicious firmware, providing persistent, difficult-to-detect access. TFTP is the canonical delivery mechanism for ROMMON firmware updates and should be tightly controlled."
    mitre_tactic    = "Persistence, Defense Evasion"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Requires firewall or perimeter flow logs capturing UDP/69 (TFTP) traffic. Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION events with target.port populated."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorized network operations teams performing scheduled firmware upgrades via TFTP from approved jump hosts or management servers. Automated provisioning systems using TFTP for legitimate device imaging."
    tuning_guidance = "Add approved TFTP server source addresses to %global_allowed_mgmt_sources to suppress authorized firmware management traffic. Consider restricting this rule to production network segments only by excluding known lab or staging address ranges via the same list."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // TFTP uses UDP port 69 - the canonical transport for ROMMON firmware delivery
    $net.target.port = 69

    // Exclude known-good management sources such as authorized TFTP servers and jump hosts
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude purely internal-to-internal flows that are already covered by internal controls
    // External or unexpected internal sources reaching TFTP are the high-risk signal
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score       = max(90)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity   = array_distinct($net.principal.ip)

  condition:
    $net
}
