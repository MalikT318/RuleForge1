/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:08:58.855174+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_PreOS_Boot_Firmware_Modification_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects network-observable indicators of Pre-OS Boot firmware manipulation (T1542). Firmware update utilities, UEFI/BIOS flashing tools, and bootkit implants frequently beacon to external infrastructure to retrieve payloads or exfiltrate data during or after the boot process. This rule flags outbound connections on ports and protocols commonly associated with firmware update channels (TFTP/UDP 69, HTTP/S on non-standard ports) from internal hosts to external destinations, which may indicate a compromised bootloader or firmware implant establishing C2 contact. Internal-to-internal traffic is excluded via reference list."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Requires firewall or perimeter flow/session logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Logs must include source IP, destination IP, destination port, and protocol."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate PXE boot infrastructure using TFTP (UDP 69) for OS deployment; authorised firmware update servers reached via non-standard ports; network device management using TFTP for config backup. Exclude known-good management sources via %global_allowed_mgmt_sources."
    tuning_guidance = "Add authorised PXE/TFTP servers and firmware update destinations to %global_allowed_mgmt_sources. Add known-good external update domains to %global_allowed_domains. Reduce false positives by narrowing the non-standard port range to ports observed in your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal host
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not internal)
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Detect TFTP (UDP port 69) - primary firmware/PXE delivery protocol
    // OR non-standard high-risk ports associated with firmware C2 channels
    // TFTP is almost never legitimately initiated from a workstation to the internet
    (
      $net.target.port = 69 or
      $net.target.port = 4011 or
      $net.target.port = 6666 or
      $net.target.port = 6667 or
      $net.target.port = 6668 or
      $net.target.port = 6669 or
      $net.target.port = 1337 or
      $net.target.port = 31337
    )

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
