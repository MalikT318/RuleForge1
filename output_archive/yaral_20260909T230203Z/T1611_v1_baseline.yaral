/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:26:27.342315+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_001_Container_Escape_To_Host {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects container escape to host via privileged process execution patterns: processes running inside a container that invoke host-level mechanisms such as nsenter, unshare, cgroup release_agent manipulation, or execution of binaries from host-mounted paths. These are primary behavioral signals for T1611 on Linux container runtimes."
    mitre_tactic    = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "Requires container runtime EDR telemetry or Kubernetes audit logs normalised to UDM PROCESS_LAUNCH. The container runtime must emit process lineage including the parent container context and command-line arguments."
    platform        = "Linux"
    log_source      = "container"
    false_positives = "Legitimate container debugging sessions using nsenter by authorised SRE/platform teams; Kubernetes node-level DaemonSets that intentionally run with host PID or host network namespace; privileged init containers performing node bootstrapping; security scanning agents that inspect host namespaces."
    tuning_guidance = "Add authorised parent process paths (e.g., node bootstrap agents, approved DaemonSet binaries) to %global_allowed_admin_tools. Add known privileged service accounts performing node operations to %global_allowed_service_accounts. Scope by cluster namespace label if the SIEM enriches events with namespace metadata."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the primary host-escape execution patterns:
    // 1. nsenter - explicitly enters host namespaces from within a container
    // 2. unshare - creates new namespaces or re-enters host namespaces
    // 3. Direct cgroup release_agent write via shell redirection (shell spawned with cgroup path args)
    // 4. Execution of binaries from a host-mounted path (e.g., /host, /mnt/host, /hostroot)
    // 5. docker/kubectl exec patterns that pivot to host socket
    (
      $proc.target.process.file.full_path = /\/(usr\/bin\/|usr\/sbin\/|bin\/|sbin\/)?nsenter$/ nocase
      or
      $proc.target.process.file.full_path = /\/(usr\/bin\/|usr\/sbin\/|bin\/|sbin\/)?unshare$/ nocase
      or
      $proc.target.process.command_line = /\/sys\/fs\/cgroup.*release_agent/ nocase
      or
      $proc.target.process.file.full_path = /^\/(host|hostroot|mnt\/host|rootfs)\// nocase
      or
      $proc.target.process.command_line = /\/var\/run\/docker\.sock/ nocase
    )

    // Narrow to invocations that carry host-namespace targeting flags or
    // suspicious argument combinations to reduce noise from legitimate tooling
    (
      $proc.target.process.command_line = /--target\s+1\b/ nocase
      or $proc.target.process.command_line = /\-\-mount\s*=?\/proc\/1/ nocase
      or $proc.target.process.command_line = /\-t\s+1\b/ nocase
      or $proc.target.process.command_line = /release_agent/ nocase
      or $proc.target.process.file.full_path = /^\/(host|hostroot|mnt\/host|rootfs)\//
      or $proc.target.process.command_line = /\/var\/run\/docker\.sock/
    )

    // Exclude approved administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $escaped_process   = array_distinct($proc.target.process.file.full_path)
    $command_line      = array_distinct($proc.target.process.command_line)
    $initiating_user   = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
