/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:26:04.902804+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_001_Privileged_Container_Deployment {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation of a new container or pod resource via Kubernetes or container runtime APIs, particularly those configured with privileged settings, host namespace access, or sensitive volume mounts that are commonly abused for host escape or malicious workload execution."
    mitre_tactic    = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires Kubernetes API server audit logs or container runtime audit telemetry normalised to Chronicle UDM RESOURCE_CREATION events. The audit policy must capture create/apply verbs on pods, deployments, daemonsets, replicasets, and statefulsets."
    platform        = "Containers"
    log_source      = "container"
    false_positives = "Legitimate CI/CD pipelines deploying new workloads, cluster autoscalers, operators and controllers creating pods as part of normal reconciliation, infrastructure-as-code tooling (Helm, Terraform), and authorised cluster administrators."
    tuning_guidance = "Add known CI/CD service accounts and cluster automation identities to %global_allowed_service_accounts. Add approved cluster management principals to %global_allowed_cloud_principals. Narrow the rule by requiring the privileged or hostPID/hostNetwork indicators in the command line or resource spec fields if your UDM normalisation surfaces them."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target resource must be a pod-bearing Kubernetes workload type
    $cloud.target.resource.resource_type = /(?i)(pod|deployment|daemonset|replicaset|statefulset|job|cronjob)/

    // Detect privileged or host-access indicators surfaced in the resource
    // name, labels, or the initiating command - covers both direct pod creation
    // and higher-level workload objects that spawn privileged containers.
    // We match on any of: privileged flag, hostPID, hostNetwork, hostIPC,
    // or sensitive host path mounts that are common in container escape chains.
    (
      $cloud.target.resource.name = /(?i)(privileged|hostpid|hostnetwork|hostipc|hostpath|host-path)/
      or
      $cloud.target.process.command_line = /(?i)(privileged|hostpid|hostnetwork|hostipc|hostpath)/
      or
      $cloud.network.http.user_agent = /(?i)(kubectl|curl|python-requests|go-http)/
    )

    // Exclude known automation and service accounts performing routine deploys
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved administrative users performing authorised operations
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $resource_type   = array_distinct($cloud.target.resource.resource_type)
    $source_ip       = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
