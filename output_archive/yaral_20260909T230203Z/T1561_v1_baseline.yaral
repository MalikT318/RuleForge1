/*
  MITRE Technique : T1561 - Disk Wipe
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:15:37.307768+00:00
  Reference       : https://attack.mitre.org/techniques/T1561
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_Disk_Wipe_Linux_Destructive_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects execution of commands commonly used to wipe or overwrite disk data on Linux systems, including direct writes to block devices, MBR destruction, and filesystem-level wiping utilities. Adversaries use these techniques to destroy data and interrupt system availability."
    mitre_tactic    = "Impact"
    mitre_technique = "T1561"
    mitre_technique_name = "Disk Wipe"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd syscall/execve logs normalised to UDM PROCESS_LAUNCH. The command_line field must be populated."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate disk imaging tools (dd for backups), secure erase utilities run by storage admins, disk provisioning automation, and forensic tooling. Backup processes listed in %global_allowed_backup_processes should be excluded."
    tuning_guidance = "Add authorised disk management parent processes to %global_allowed_admin_tools and backup agents to %global_allowed_backup_processes. Narrow scope by requiring the target device path to match /dev/sd[a-z] or /dev/nvme patterns if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match destructive disk utilities by process name or full path
    (
      // dd writing directly to a block device
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/dd$/ nocase
        and $proc.target.process.command_line = /of=\/dev\/(sd[a-z]|hd[a-z]|nvme[0-9]|vd[a-z]|xvd[a-z]|disk)/ nocase
      )
      or
      // shred targeting block devices or entire filesystems
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/shred$/ nocase
        and $proc.target.process.command_line = /\/dev\/(sd[a-z]|hd[a-z]|nvme[0-9]|vd[a-z]|xvd[a-z])/ nocase
      )
      or
      // wipefs - wipes filesystem signatures from a device
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/wipefs$/ nocase
        and $proc.target.process.command_line = /(-a|--all)/ nocase
      )
      or
      // wipe utility
      $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/wipe$/ nocase
      or
      // hdparm secure erase
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/hdparm$/ nocase
        and $proc.target.process.command_line = /--security-erase/ nocase
      )
      or
      // blkdiscard - discards all blocks on a device
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/blkdiscard$/ nocase
        and $proc.target.process.command_line = /\/dev\/(sd[a-z]|hd[a-z]|nvme[0-9]|vd[a-z])/ nocase
      )
      or
      // badblocks with write mode - destructive surface scan
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/badblocks$/ nocase
        and $proc.target.process.command_line = /(-w|-n)/ nocase
      )
      or
      // openssl or python piped to /dev/sd* via shell - indirect wipe pattern
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(bash|sh|dash|zsh)$/ nocase
        and $proc.target.process.command_line = /\/dev\/(sd[a-z]|hd[a-z]|nvme[0-9]|vd[a-z])/ nocase
        and $proc.target.process.command_line = /(\/dev\/zero|\/dev\/urandom|\/dev\/null|if=\/dev\/zero|if=\/dev\/urandom)/ nocase
      )
    )

    // Exclude authorised backup and admin tooling
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1561")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $actor_user        = array_distinct($proc.principal.user.userid)
    $command_observed  = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
