/*
  MITRE Technique : T1578 - Modify Cloud Compute Infrastructure
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:19:33.059820+00:00
  Reference       : https://attack.mitre.org/techniques/T1578
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_Modify_Cloud_Compute_Infrastructure {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of cloud compute infrastructure components such as instance creation, deletion, snapshot operations, disk detachment, or image manipulation. Adversaries abuse these API actions to evade defenses, bypass access controls, or destroy forensic evidence."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1578"
    mitre_technique_name = "Modify Cloud Compute Infrastructure"
    log_prerequisites = "Requires cloud provider control-plane audit logs (e.g., AWS CloudTrail, Azure Activity Log, GCP Audit Logs) normalised into Chronicle UDM. API-level compute resource events must be ingested."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Authorized DevOps pipelines, infrastructure-as-code automation (Terraform, Ansible), auto-scaling groups, scheduled snapshot jobs, and approved DR runbooks. Tune using %global_allowed_cloud_principals and %global_allowed_service_accounts."
    tuning_guidance = "Add known automation service principals and CI/CD identities to %global_allowed_cloud_principals. Add service accounts performing scheduled snapshots or scaling to %global_allowed_service_accounts. Consider narrowing to specific sensitive resource types or regions if alert volume is high."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"

    // Target a broad set of compute infrastructure resource types via regex
    // Covers: instances, virtual machines, snapshots, disks, images, volumes, AMIs
    $cloud.target.resource.resource_type = /(?i)(instance|virtual.?machine|snapshot|disk|volume|image|ami|boot.?disk|machine.?image)/

    // Exclude known-good automation principals and service accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1578")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $resource_type     = array_distinct($cloud.target.resource.resource_type)
    $source_ip         = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
