/*
  MITRE Technique : T1578.003 - Delete Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:20:17.683867+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_003_Delete_Cloud_Instance {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of cloud compute instances (virtual machines) via cloud provider audit logs. Adversaries delete instances post-compromise to destroy forensic evidence and evade detection. Covers AWS TerminateInstances, Azure VM delete operations, and GCP instance deletion API calls as normalised into UDM RESOURCE_DELETION events."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.003"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Delete Cloud Instance"
    log_prerequisites = "Requires cloud provider audit logs ingested into Chronicle UDM. AWS CloudTrail (EC2 TerminateInstances), Azure Activity Log (Microsoft.Compute/virtualMachines/delete), or GCP Audit Log (compute.instances.delete) must be enabled and forwarded."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorised auto-scaling scale-in events, infrastructure-as-code teardown pipelines (Terraform destroy), scheduled ephemeral instance cleanup, CI/CD build agents terminating after job completion."
    tuning_guidance = "Add known automation and service principals that perform scheduled teardowns to %global_allowed_cloud_principals. Add known scanner or deployment accounts to %global_allowed_scanners. Consider raising severity if the deleting principal has no prior instance-creation history or if deletion occurs outside business hours."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"

    // Target resource must be a compute instance / virtual machine class.
    // Chronicle normalises AWS EC2, Azure VM, and GCP Compute Engine instance
    // deletion into resource type strings containing "instance" or "virtual_machine"
    // or "virtualmachine". The pattern is intentionally broad to cover all three
    // providers without hardcoding vendor-specific strings.
    $cloud.target.resource.resource_type = /(?i)(instance|virtual.?machine|compute.node)/

    // Exclude known automation principals that legitimately terminate instances.
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Capture the acting principal and resource for outcome enrichment.
    $cloud.principal.user.userid = $actor
    $cloud.target.resource.name = $resource_name

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1578.003")
    $primary_entity = array_distinct($actor)
    $deleted_resource = array_distinct($resource_name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
