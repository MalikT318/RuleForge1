/*
  MITRE Technique : T1496.004 - Cloud Service Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:02:35.114569+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_004_Cloud_Service_Hijacking_Bulk_Messaging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential cloud service hijacking via bulk use of messaging or AI inference APIs (e.g., SES, SNS, LLM endpoints). Adversaries who compromise cloud credentials may immediately invoke high-volume send or inference operations to abuse quotas, send phishing at scale, or monetise AI model access. This rule fires on a single USER_RESOURCE_ACCESS event whose target resource path matches known messaging or AI inference service namespaces, providing an early-warning signal before quota exhaustion or billing anomalies surface."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.004"
    mitre_technique_name = "Cloud Service Hijacking"
    log_prerequisites = "Requires cloud provider audit logs normalised to Chronicle UDM. The log source must populate metadata.event_type = USER_RESOURCE_ACCESS, target.resource.name or target.url with the API action path, and principal.user.userid. Verified against AWS CloudTrail (SES SendEmail, SNS Publish, Bedrock InvokeModel), GCP Audit (aiplatform.predict, pubsub.publish), and Azure Activity (cognitiveservices/accounts/deployments/completions)."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate marketing automation pipelines, transactional email services, authorised AI inference workloads, and CI/CD pipelines that call LLM APIs. Service accounts used by approved SaaS integrations will also trigger this rule."
    tuning_guidance = "Add known-good service account identifiers to %global_allowed_service_accounts. Add approved cloud principals (e.g., automation roles, CI service principals) to %global_allowed_cloud_principals. Narrow the resource regex if only a subset of messaging services is in scope. Consider pairing with a threshold rule that counts invocations per user per hour to reduce noise from low-volume legitimate callers."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match API actions associated with bulk messaging (email/SMS) or AI inference abuse.
    // Covers: SES SendEmail/SendRawEmail/SendBulkEmail, SNS Publish,
    //         Bedrock InvokeModel/InvokeModelWithResponseStream,
    //         GCP aiplatform predict/generateContent, Azure cognitive completions,
    //         SendGrid/Twilio normalised resource paths, and generic LLM proxy patterns.
    $cloud.target.resource.name = /(?i)(ses[:\-\/]send|sns[:\-\/]publish|bedrock[:\-\/]invoke|aiplatform[:\-\/](predict|generatecontent)|cognitiveservices[:\-\/].*completions|openai[:\-\/](completions|chat)|llm[:\-\/](invoke|infer|predict|proxy)|sendgrid[:\-\/](mail\/send|messages)|twilio[:\-\/](messages|sms))/ nocase

    // Exclude approved service accounts and cloud principals performing expected automation.
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1496.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
