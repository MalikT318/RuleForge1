/*
  MITRE Technique : T1606.002 - SAML Tokens
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:25:28.662743+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_002_Forged_SAML_Token_Anomalous_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects anomalous USER_LOGIN events consistent with forged SAML token usage: authentication succeeding without MFA, from an unusual or anonymous source, with an extended or abnormal token lifetime, or via a federated identity path where no prior session context exists. Forged SAML tokens (Golden SAML) allow adversaries to authenticate to any SAML 2.0 SSO-integrated service by signing tokens with a compromised token-signing certificate, bypassing MFA and normal authentication controls."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.002"
    mitre_technique_name = "Forge Web Credentials: SAML Tokens"
    log_prerequisites = "Requires identity provider audit and sign-in logs normalised to UDM USER_LOGIN events. Entra ID sign-in logs, Okta System Log, or ADFS audit events must be ingested. The authentication_mechanism, mfa_details, and extensions fields must be populated by the log parser."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate service accounts performing federated SSO without MFA where MFA is explicitly excluded by policy. Break-glass or emergency access accounts. Automated pipeline identities using certificate-based federation. Newly onboarded SaaS integrations during initial SSO configuration."
    tuning_guidance = "Add known service and automation account identifiers to %global_allowed_service_accounts. Add approved federated SSO source identifiers to %global_allowed_cloud_principals. Tune the token lifetime regex if your IdP reports lifetime differently. Suppress known break-glass account userids via %global_allowed_admin_users."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Target federated / SAML authentication paths - the mechanism field is
    // populated by IdP parsers to reflect the authentication protocol used.
    // SAML assertions, federation, and SSO paths are the attack surface.
    (
      $auth.extensions.auth.auth_details = /(?i)saml/
      or $auth.extensions.auth.auth_details = /(?i)federation/
      or $auth.extensions.auth.auth_details = /(?i)sso/
    )

    // Forged SAML tokens frequently bypass MFA because the adversary controls
    // all claims in the assertion. Flag logins where MFA was not satisfied.
    // Chronicle normalises MFA outcome into security_result or auth fields.
    not $auth.extensions.auth.auth_details = /(?i)mfa/
    not $auth.extensions.auth.auth_details = /(?i)multifactor/

    // Exclude logins originating from known-internal management sources
    // (e.g., on-premises ADFS proxies, approved federation gateways).
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Exclude known service and automation accounts that legitimately use
    // certificate-based or federated auth without interactive MFA.
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved cloud/identity service principals (e.g., sync agents).
    not $auth.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known admin accounts that may use break-glass federation paths.
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Require a user subject to be present - anonymous or empty subjects
    // indicate a parsing gap rather than a true forged-token event.
    $auth.principal.user.userid != ""

    // Capture the target application / resource being accessed for outcome.
    $auth.target.resource.name = $target_resource

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1606.002")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ip = array_distinct($auth.principal.ip)
    $accessed_resource = array_distinct($target_resource)
    $auth_detail = array_distinct($auth.extensions.auth.auth_details)

  condition:
    $auth
}
