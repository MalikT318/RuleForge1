/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:09:19.185798+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_Network_Device_Firmware_Update_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects anomalous firmware-related traffic on network devices observable at the firewall/perimeter layer. Firmware update protocols (TFTP, SCP on non-standard ports, HTTP/HTTPS to unexpected destinations) initiated from or toward network device management IPs may indicate unauthorized firmware modification. Targets the network-observable behaviour of firmware staging and delivery rather than the endpoint action itself."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs with source/destination IP, port, and protocol. TFTP (UDP/69), SCP (TCP/22), HTTP (TCP/80), and HTTPS (TCP/443) flows must be captured. Management-plane traffic should be visible to the sensor."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized network operations center (NOC) firmware upgrades via TFTP or SCP, vendor-initiated maintenance windows, automated configuration management platforms (e.g., RANCID, Oxidized), vulnerability scanners probing management interfaces."
    tuning_guidance = "Add authorized firmware management source IPs to %global_allowed_mgmt_sources. Add authorized scanner IPs to %global_allowed_scanners. Schedule-based suppression during approved maintenance windows should be applied in the SOAR playbook consuming $risk_score."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // TFTP (UDP/69) is the canonical firmware transfer protocol on network devices.
    // SCP (TCP/22) and HTTP/HTTPS are also used for firmware staging.
    // Match any of these transport signatures.
    (
      $net.target.port = 69
      or
      (
        $net.target.port = 22 and
        $net.network.ip_protocol = "TCP"
      )
      or $net.target.port = 80
      or $net.target.port = 443
    )

    // Destination must be external (not internal management space).
    // Internal-to-internal firmware pulls from authorized servers are excluded
    // via %global_allowed_mgmt_sources on the source side below.
    not $net.target.ip in %rfc1918_internal

    // Source must not be an authorized management or scanner address.
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // HTTP/HTTPS flows carrying firmware-related URI patterns.
    // When the firewall logs HTTP metadata, match on firmware-indicative paths.
    // This is an OR-optional enrichment; the port match above is the primary signal.
    (
      $net.target.url = /(?i)(firmware|upgrade|flash|image|bin|rom|bios|uefi|efi|ios|nxos|junos|eos)/ nocase
      or $net.target.port = 69
    )

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $destination_url = array_distinct($net.target.url)

  condition:
    $net
}
