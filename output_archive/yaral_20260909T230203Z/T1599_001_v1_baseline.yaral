/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:21:46.659717+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_NAT_Config_Modification_Bypass {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of NAT configuration on network boundary devices. Adversaries with control of a firewall or router may alter NAT rules to bridge trusted and untrusted network segments, bypass routing restrictions, or obscure traffic flows. This rule fires on management-plane configuration change events that reference NAT-related constructs."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Address Translation Traversal"
    log_prerequisites = "Requires firewall or router management-plane syslog normalised to UDM SETTING_MODIFICATION. The configuration change message must be present in target.resource.attribute.labels or security_result.description. Tested against Cisco IOS/ASA, Palo Alto, Juniper SRX, and Fortinet syslog normalised by Chronicle parsers."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network engineers performing planned NAT changes, automated provisioning systems, firewall policy deployment pipelines, and change-window maintenance activity."
    tuning_guidance = "Add authorised administrator accounts to %global_allowed_admin_users and approved automation service accounts to %global_allowed_service_accounts. Consider adding a time-window condition aligned to approved change windows if your SOAR can supply that context."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Match NAT-related configuration keywords in the description or resource label.
    // Covers: nat, pat, overload, static nat, dynamic nat, nat pool, nat rule,
    // ip nat inside/outside, nat policy, nat translation, masquerade.
    (
      $cfg.security_result.description = /(?i)(nat\s+(rule|pool|policy|table|translation|inside|outside|overload|exemption)|static\s+nat|dynamic\s+nat|ip\s+nat|pat\s+(rule|pool)|masquerade|source\s+nat|destination\s+nat|dnat|snat)/ nocase
      or
      $cfg.target.resource.name = /(?i)(nat|pat|masquerade|snat|dnat)/ nocase
    )

    // Restrict to management-plane initiated changes (interactive or API sessions).
    // Exclude known-good automation accounts.
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users

    // Exclude changes originating from approved management sources (jump hosts, NMS).
    not $cfg.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $actor_user = array_distinct($cfg.principal.user.userid)
    $source_ip = array_distinct($cfg.principal.ip)
    $changed_resource = array_distinct($cfg.target.resource.name)
    $change_description = array_distinct($cfg.security_result.description)

  condition:
    $cfg
}
