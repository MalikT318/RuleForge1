/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:17:48.459996+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Database_File_Modification_By_Unexpected_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of database files by processes other than the database engine itself, indicating potential stored data manipulation."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Stored Data Manipulation"
    log_prerequisites = "Requires EDR file modification telemetry or Windows Security event log file auditing."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database backup utilities, ETL tools, database migration scripts, administrative maintenance tasks, antivirus scanning database files."
    tuning_guidance = "Add approved backup and maintenance processes to %global_allowed_backup_processes. Add database administration tools to %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    (
      $file.target.file.full_path = /\.mdf$/ nocase or
      $file.target.file.full_path = /\.ldf$/ nocase or
      $file.target.file.full_path = /\.ndf$/ nocase or
      $file.target.file.full_path = /\.ibd$/ nocase or
      $file.target.file.full_path = /\.frm$/ nocase or
      $file.target.file.full_path = /\.dbf$/ nocase or
      $file.target.file.full_path = /\.accdb$/ nocase or
      $file.target.file.full_path = /\.mdb$/ nocase or
      $file.target.file.full_path = /\.sqlite$/ nocase or
      $file.target.file.full_path = /\.db$/ nocase or
      $file.target.file.full_path = /\.pst$/ nocase or
      $file.target.file.full_path = /\.ost$/ nocase
    )
    not $file.principal.process.file.full_path = /\\sqlservr\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\mysqld\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\postgres\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\oracle\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\mongod\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\msaccess\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
