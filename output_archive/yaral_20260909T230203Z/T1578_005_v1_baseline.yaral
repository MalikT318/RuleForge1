/*
  MITRE Technique : T1578.005 - Modify Cloud Compute Configurations
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:20:48.710328+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_005_Cloud_Compute_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modifications to cloud compute configurations including quota increases, tenant-wide policy changes, VM size policy modifications, and region/zone enablement. Adversaries abuse these controls to expand available compute resources for cryptomining or other resource hijacking without exhausting victim quotas."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.005"
    mitre_technique_name = "Modify Cloud Compute Configurations: Modify Cloud Compute Configurations"
    log_prerequisites = "Requires cloud provider audit logs normalized to Chronicle UDM. AWS CloudTrail, Azure Activity Log, or GCP Audit Logs with SETTING_MODIFICATION or RESOURCE_PERMISSIONS_CHANGE events covering compute quota, policy, and configuration APIs."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate capacity planning by cloud administrators requesting quota increases, authorized infrastructure scaling events, approved policy changes by cloud ops teams, automated provisioning pipelines."
    tuning_guidance = "Add authorized cloud administrator identities to %global_allowed_admin_users and approved service principals to %global_allowed_cloud_principals. Scope by target.resource.name patterns matching known quota or policy resource types if alert volume is high."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Target compute quota, policy, or configuration resources
    // Matches GCP quota adjustments, Azure policy assignments, AWS service quota requests
    (
      $cloud.target.resource.name = /(?i)(quota|limit|policy|compute.*config|vm.*size|instance.*type|region.*enable|zone.*enable|subscription.*policy|tenant.*policy|resource.*policy|service.*quota)/ nocase
      or
      $cloud.security_result.rule_name = /(?i)(quota|limit|policy|compute.*config|vm.*size|instance.*type|region.*enable|zone.*enable|subscription.*policy|tenant.*policy|resource.*policy|service.*quota)/ nocase
    )

    // Exclude approved cloud principals and admin users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1578.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $modified_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
