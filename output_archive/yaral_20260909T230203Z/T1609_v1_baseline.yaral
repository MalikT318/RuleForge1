/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:25:45.902494+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_Container_Admin_Command_Exec {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects interactive command execution inside a running container via container administration services such as docker exec or kubectl exec. Adversaries abuse these mechanisms to run arbitrary commands within container workloads, bypassing host-level controls. This rule fires on USER_RESOURCE_ACCESS events that represent exec-style API calls targeting container resources."
    mitre_tactic    = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Requires Kubernetes API server audit logs or container runtime audit logs normalised to Chronicle UDM. The exec sub-resource verb must be captured in target.resource.name or target.resource.resource_subtype, and the requesting principal must be populated."
    platform        = "Containers"
    log_source      = "container"
    false_positives = "Legitimate DevOps workflows using kubectl exec for debugging, CI/CD pipelines that exec into containers for health checks, authorised SRE runbooks, and monitoring agents that exec into containers to collect metrics."
    tuning_guidance = "Add known automation service accounts to %global_allowed_service_accounts. Add known CI/CD or monitoring source principals to %global_allowed_cloud_principals. Consider scoping to non-production namespaces or alerting only when the requesting user is interactive (not a service account)."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match exec sub-resource calls on pods (Kubernetes API) or exec commands
    // against container resources (Docker/runtime APIs).
    // The Kubernetes API server records exec as verb=create on pods/exec sub-resource.
    // Chronicle normalises the sub-resource or operation into target.resource.name.
    (
      $cloud.target.resource.name = /\/exec$/ nocase or
      $cloud.target.resource.name = /pods\/[^\/]+\/exec/ nocase or
      $cloud.target.resource.resource_subtype = /exec/ nocase or
      $cloud.network.http.method = /(?i)POST/ and
      $cloud.target.url = /\/exec(\?|$)/
    )

    // Exclude approved automation and service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known security and monitoring tooling
    not $cloud.principal.application in %global_allowed_security_tools

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $target_resource   = array_distinct($cloud.target.resource.name)
    $source_ip         = array_distinct($cloud.principal.ip)
    $http_method       = array_distinct($cloud.network.http.method)

  condition:
    $cloud
}
