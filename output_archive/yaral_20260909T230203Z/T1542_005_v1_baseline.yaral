/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:10:30.978487+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_TFTP_Boot_Netboot_Anomaly {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects TFTP traffic (UDP/69) originating from or destined to a network device that is not sourced from an approved management address. Adversaries abuse TFTP netbooting to load a malicious OS image onto a network device by pointing the boot configuration at an unauthorized TFTP server. A network device initiating or receiving TFTP outside of the approved management plane is a high-fidelity signal for T1542.005."
    mitre_tactic    = "Persistence, Defense Evasion"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs that record UDP port 69 traffic. Ensure the firewall is configured to log permitted as well as denied flows so legitimate management-plane TFTP is visible for baselining."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorized network operations center (NOC) or management servers performing scheduled image pushes or configuration backups via TFTP. Vulnerability scanners probing UDP/69. Legacy PXE boot infrastructure sharing the same segment."
    tuning_guidance = "Populate %global_allowed_mgmt_sources with all approved TFTP server and management-plane source addresses. After baselining, consider tightening to alert only when the TFTP source is external (not in %rfc1918_internal) for higher fidelity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // TFTP uses UDP port 69 exclusively
    $net.network.ip_protocol = "UDP"
    $net.target.port = 69

    // Exclude flows where the source is an approved management/NOC address
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude flows where the destination is an approved management/NOC address
    // (covers device-initiated TFTP to a known-good server)
    not $net.target.ip in %global_allowed_mgmt_sources

    // Exclude known-good scanner sources to reduce noise
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity    = array_distinct($net.principal.ip)
    $tftp_destination  = array_distinct($net.target.ip)
    $src_hostname      = array_distinct($net.principal.hostname)

  condition:
    $net
}
