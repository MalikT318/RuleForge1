/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:27:01.927447+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_Container_Resource_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of container and Kubernetes resources via API calls or in-container CLI commands. Adversaries query pods, nodes, deployments, services, secrets, and cluster configuration to inform lateral movement and execution decisions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Requires Kubernetes audit logs or container runtime telemetry normalised to UDM USER_RESOURCE_ACCESS. The resource_type or target.resource.name fields must be populated with the Kubernetes API resource path."
    platform = "Containers"
    log_source = "container"
    false_positives = "Kubernetes operators, controllers, CI/CD pipelines, monitoring agents (Prometheus, Datadog), and cluster autoscalers routinely enumerate cluster resources. Service accounts used by legitimate orchestration tooling will generate high volumes of matching events."
    tuning_guidance = "Add known CI/CD and monitoring service accounts to %global_allowed_service_accounts. Add approved scanner identities to %global_allowed_scanners. Consider raising severity if the calling identity is a human user account rather than a service account, or if the request originates from outside the cluster network."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match Kubernetes API resource paths that expose cluster topology and configuration.
    // Covers: pods, nodes, deployments, replicasets, daemonsets, statefulsets,
    //         services, endpoints, namespaces, secrets, configmaps, serviceaccounts,
    //         roles, clusterroles, rolebindings, clusterrolebindings, ingresses,
    //         persistentvolumes, persistentvolumeclaims, events, and generic list/watch verbs.
    $cloud.target.resource.name = /\/(api|apis)\// nocase
    $cloud.target.resource.name = /(?i)(pods|nodes|deployments|replicasets|daemonsets|statefulsets|services|endpoints|namespaces|secrets|configmaps|serviceaccounts|roles|clusterroles|rolebindings|clusterrolebindings|ingresses|persistentvolumes|persistentvolumeclaims|events)/ nocase

    // Restrict to read/enumeration verbs - list, watch, get - not mutating operations.
    $cloud.target.resource.attribute.labels["verb"] = /(?i)^(list|watch|get)$/

    // Exclude known-good service accounts performing routine orchestration.
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved security scanners.
    not $cloud.principal.user.userid in %global_allowed_scanners

    // Exclude approved cloud/identity principals (operators, controllers).
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_hostname = array_distinct($cloud.principal.hostname)

  condition:
    $cloud
}
