/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:13:59.245745+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_ASREP_Roasting_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects execution of tools or PowerShell commands associated with AS-REP Roasting - the enumeration of accounts with Kerberos pre-authentication disabled and subsequent offline cracking of AS-REP encrypted material. Matches on command-line patterns that request AS-REP tickets without pre-authentication, enumerate DONT_REQ_PREAUTH user attributes, or invoke known AS-REP roasting module names."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Authorised red-team or penetration testing engagements; security tooling that audits Kerberos account configuration; AD health-check scripts run by identity teams."
    tuning_guidance = "Add approved security-assessment parent processes to %global_allowed_security_tools and approved admin accounts to %global_allowed_admin_users. Scope by principal.hostname to exclude dedicated security-testing jump hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match PowerShell or common script hosts invoking AS-REP roasting logic,
    // OR standalone tooling (renamed binaries caught by command-line content).
    // We do NOT rely on the binary name alone to survive renaming.
    (
      // PowerShell-based AS-REP roasting: Get-ASREPHash, Invoke-ASREPRoast,
      // Rubeus asreproast, or direct LDAP filter for DONT_REQ_PREAUTH (UAC 0x400000)
      $proc.target.process.command_line = /(?i)(Get-ASREPHash|Invoke-ASREPRoast|asreproast|DONT_REQ_PREAUTH|UF_DONT_REQUIRE_PREAUTH|4194304|0x400000)/ nocase
      or
      // Rubeus-style command: rubeus.exe asreproast (binary may be renamed, catch by subcommand)
      $proc.target.process.command_line = /(?i)asreproast/ nocase
      or
      // Impacket GetNPUsers equivalent invoked via Python on Windows
      $proc.target.process.command_line = /(?i)GetNPUsers/ nocase
      or
      // LDAP filter querying for accounts without pre-auth via PowerShell AD module
      $proc.target.process.command_line = /(?i)userAccountControl.*4194304|4194304.*userAccountControl/ nocase
      or
      // kerbrute userenum / asreproast mode
      $proc.target.process.command_line = /(?i)kerbrute.*asreproast|asreproast.*kerbrute/ nocase
    )

    // Exclude approved security tooling and admin accounts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $initiating_user   = array_distinct($proc.principal.user.userid)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
