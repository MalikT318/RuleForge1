/*
  MITRE Technique : T1525 - Implant Internal Image
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:06:17.164817+00:00
  Reference       : https://attack.mitre.org/techniques/T1525
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1525_Implant_Internal_Container_Image {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects container image push or import operations to an internal registry via cloud audit logs. Adversaries implant backdoored images into victim-controlled registries to establish persistence, particularly when infrastructure tooling is configured to pull the latest image on deployment."
    mitre_tactic = "Persistence"
    mitre_technique = "T1525"
    mitre_technique_name = "Implant Internal Image"
    log_prerequisites = "Requires cloud control-plane audit logs with container registry API activity (e.g., image push, tag, import, or upload events normalised into UDM RESOURCE_CREATION)."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines pushing new application images, authorised base-image updates, security scanning tools importing images for analysis, and infrastructure-as-code deployments."
    tuning_guidance = "Populate %global_allowed_cloud_principals with CI/CD service accounts and automation identities that routinely push images. Consider adding a match block over a short window to correlate pushes from principals that have not previously pushed to the same repository."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target resource must be a container image or registry artifact.
    // Cloud audit logs normalise registry push/import/tag operations as
    // resource creation events; the resource type field identifies the object.
    $cloud.target.resource.resource_type = /(?i)(container.?image|image|artifact|repository|registry)/

    // The operation name must reflect an image write action.
    // Covers push, import, tag, upload, and put-image variants across providers.
    $cloud.target.resource.name = /(?i)(push|import|upload|put.?image|tag)/

    // Exclude known-good automation and CI/CD service principals.
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved cloud-native scanner or security tooling accounts.
    not $cloud.principal.user.userid in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1525")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_registry = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
