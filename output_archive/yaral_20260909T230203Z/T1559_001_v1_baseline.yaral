/*
  MITRE Technique : T1559.001 - Component Object Model
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:14:58.173629+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Abuse_Suspicious_Host_Spawns_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects COM-based local code execution abuse where a known COM host process (dllhost.exe, mmc.exe, wscript.exe, cscript.exe, rundll32.exe, regsvr32.exe) spawns an unexpected child process such as a shell, interpreter, or reconnaissance tool. Adversaries abuse COM interfaces to invoke arbitrary execution while hiding behind legitimate COM surrogate or scripting host processes."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires EDR process telemetry with parent-child process lineage (principal = parent, target = child). Sysmon Event ID 1 or equivalent EDR process creation events normalised to UDM PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative scripts invoking COM objects via wscript/cscript; software installers using rundll32 or regsvr32; MMC snap-ins spawning helper processes; SCCM/Intune deployment agents."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools. Add authorised script hosts to %global_allowed_script_hosts. Narrow scope by requiring the child process to also match a secondary suspicious indicator such as encoded command lines or network-facing binaries."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent is a known COM host or scripting engine commonly abused for COM execution
    $proc.principal.process.file.full_path = /\\(dllhost|mmc|wscript|cscript|rundll32|regsvr32|mshta|svchost)\.exe$/ nocase

    // Child process is a shell, interpreter, or commonly abused LOLBin
    // that would not normally be a direct child of these COM hosts
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|certutil|bitsadmin|wmic|msiexec|regsvr32|rundll32|cmstp|installutil|msbuild|csc|vbc|jsc|bash|explorer)\.exe$/ nocase

    // Exclude cases where the parent and child are the same binary (self-invocation by installers)
    not $proc.principal.process.file.full_path = $proc.target.process.file.full_path

    // Exclude approved administrative and deployment tooling parents
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved script host contexts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
