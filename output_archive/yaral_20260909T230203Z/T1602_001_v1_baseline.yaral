/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:24:06.979866+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_SNMP_MIB_Bulk_Query_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects high-volume SNMP queries targeting network devices, indicative of MIB dumping or reconnaissance activity. Attackers use SNMP walks to enumerate device configurations, routing tables, and network topology."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Requires firewall or network flow logs capturing SNMP traffic (UDP/161, UDP/162)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized network monitoring systems, SNMP-based inventory tools, network management platforms (SolarWinds, PRTG, Nagios), vulnerability scanners performing discovery."
    tuning_guidance = "Add approved monitoring sources to %global_allowed_scanners. Adjust byte threshold based on baseline SNMP query volume in your environment. Exclude known management subnets using %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 161 or $net.target.port = 162
    $net.network.ip_protocol = "UDP"
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %rfc1918_internal or $net.principal.ip in %rfc1918_internal
    $net.network.sent_bytes >= 5000

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
