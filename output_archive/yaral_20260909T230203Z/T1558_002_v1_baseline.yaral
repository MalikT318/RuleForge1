/*
  MITRE Technique : T1558.002 - Silver Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:13:36.459240+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_002_Silver_Ticket_Anomalous_Service_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential Silver Ticket usage by identifying Kerberos service ticket authentication events (Event ID 4624 logon type 3) where the ticket was issued without a corresponding TGT request from the KDC. Silver tickets are forged TGS tickets that allow access to a specific service without KDC interaction. Key indicators include a Kerberos authentication with no preceding AS-REQ, anomalous ticket encryption types, or a service account logon where the authenticating domain does not match the target domain."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.002"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Silver Ticket"
    log_prerequisites = "Requires Windows Security Event Log forwarded to Chronicle. Specifically Event ID 4624 (successful logon) with Kerberos authentication package, and Event ID 4627 or enriched UDM auth fields. Kerberos audit policy must be enabled: Audit Logon Events and Audit Account Logon Events."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate service accounts authenticating across domain trusts; cross-forest authentication scenarios; some third-party SSO integrations that use Kerberos constrained delegation."
    tuning_guidance = "Add known cross-domain service accounts to %global_allowed_service_accounts. Add authorised cross-domain source hosts to %global_allowed_mgmt_sources. Narrow the encryption type filter if your environment standardises on AES256 (etype 18) to reduce noise from legacy RC4 (etype 23) legitimate use."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Kerberos authentication - Silver tickets use Kerberos service ticket (TGS) directly
    $auth.extensions.auth.auth_details = /(?i)kerberos/

    // Logon type 3 = Network logon; Silver tickets are used for network service access
    $auth.extensions.auth.mechanism = "NETWORK"

    // The authenticating user must be a service account pattern or the
    // target resource account - silver tickets impersonate access to specific services.
    // Detect where the claimed domain in the ticket differs from the
    // authentication domain (a forged ticket may carry a mismatched realm).
    $auth.target.user.userid = /./

    // Silver ticket logins often show the source domain as empty or mismatched
    // because no KDC interaction occurred - the ticket was self-signed.
    // Detect logins where principal (source) domain is absent or does not
    // match the target resource domain.
    $auth.principal.administrative_domain != $auth.target.administrative_domain

    // Exclude machine accounts performing normal inter-host Kerberos (computer$)
    not $auth.target.user.userid = /\$$/ nocase

    // Exclude known authorised service and automation accounts
    not $auth.target.user.userid in %global_allowed_service_accounts

    // Exclude known authorised admin users performing cross-domain work
    not $auth.target.user.userid in %global_allowed_admin_users

    // Exclude known management source addresses (jump hosts, PAM systems)
    not $auth.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.002")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ip = array_distinct($auth.principal.ip)
    $source_domain = array_distinct($auth.principal.administrative_domain)
    $target_domain = array_distinct($auth.target.administrative_domain)
    $target_hostname = array_distinct($auth.target.hostname)

  condition:
    $auth
}
