/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:11:28.435686+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Install_Root_Certificate {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects installation of a root certificate on Windows via certutil, certmgr, PowerShell, or direct registry modification of the certificate trust store. Adversaries install rogue root CAs to silently intercept TLS traffic and suppress browser security warnings."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (process creation) with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise PKI administrators deploying internal CA certificates, MDM/GPO-based certificate provisioning, legitimate SSL inspection appliance onboarding, software installers that bundle trusted CAs."
    tuning_guidance = "Add authorised certificate management processes or service accounts to %global_allowed_admin_tools or %global_allowed_service_accounts. Scope by principal.hostname to known PKI management hosts if the environment has a dedicated CA workstation."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the four primary Windows mechanisms for root certificate installation
    (
      // certutil -addstore targeting Root or AuthRoot stores
      (
        $proc.target.process.file.full_path = /\\certutil\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /\-addstore/ nocase
          or
          $proc.target.process.command_line = /\/addstore/ nocase
        )
        and
        $proc.target.process.command_line = /(?i)(root|authroot|trustedpublisher|trustedpeople)/ nocase
      )
      or
      // certmgr importing into root stores
      (
        $proc.target.process.file.full_path = /\\certmgr\.exe$/ nocase
        and
        $proc.target.process.command_line = /\-add/ nocase
        and
        $proc.target.process.command_line = /(?i)(root|authroot|trustedpublisher|trustedpeople)/ nocase
      )
      or
      // PowerShell Import-Certificate or X509Store targeting root stores
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /(?i)Import\-Certificate/
          or
          $proc.target.process.command_line = /(?i)X509Store/
          or
          $proc.target.process.command_line = /(?i)StoreName\.Root/
          or
          $proc.target.process.command_line = /(?i)CertStoreLocation.*Root/
        )
      )
      or
      // certreq accepting a certificate into the root store
      (
        $proc.target.process.file.full_path = /\\certreq\.exe$/ nocase
        and
        $proc.target.process.command_line = /\-accept/ nocase
      )
    )

    // Exclude known-good administrative and deployment tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
