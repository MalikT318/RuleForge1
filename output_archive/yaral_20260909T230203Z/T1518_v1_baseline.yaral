/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:05:19.089240+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_ESXi_Software_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects software discovery activity on ESXi hosts via shell commands that enumerate installed VIBs, packages, or software versions. Adversaries who gain shell access to an ESXi host commonly run esxcli, vmkchkboot, or similar utilities to inventory installed software and identify exploitable versions or absent security controls before proceeding with follow-on actions."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "Requires ESXi shell command telemetry forwarded to Chronicle via syslog (hostd or shell audit). PROCESS_LAUNCH events must be generated for interactive or scripted shell sessions on the ESXi host."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorized administrators performing routine VIB audits, patch compliance checks, or baseline inventory. Vulnerability scanners with ESXi shell access. Configuration management automation (Ansible, Salt) targeting ESXi hosts."
    tuning_guidance = "Add known-good administrator accounts to %global_allowed_admin_users and approved scanner source hosts to %global_allowed_scanners. Consider narrowing the match window or raising severity if combined with a preceding USER_LOGIN from an unusual source."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target known ESXi software enumeration binaries or command patterns.
    // esxcli software vib list/get is the canonical VIB inventory command.
    // vmkchkboot, esxupdate, and localcli are equivalent enumeration paths.
    (
      $proc.target.process.command_line = /esxcli\s+(--server\s+\S+\s+)?software\s+(vib|profile)\s+(list|get|info)/ nocase
      or
      $proc.target.process.command_line = /localcli\s+software\s+(vib|profile)\s+(list|get|info)/ nocase
      or
      $proc.target.process.file.full_path = /\/bin\/vmkchkboot$/
      or
      $proc.target.process.command_line = /esxupdate\s+(query|info|status)/ nocase
      or
      $proc.target.process.command_line = /esxcli\s+(--server\s+\S+\s+)?system\s+version\s+get/ nocase
      or
      $proc.target.process.command_line = /esxcli\s+(--server\s+\S+\s+)?network\s+firewall\s+ruleset\s+list/ nocase
    )

    // Restrict to processes launched from interactive or scripted shell contexts
    // on the ESXi host itself (busybox sh, ash, or python automation wrappers).
    $proc.principal.process.file.full_path = /\/(bin|sbin)\/(sh|ash|busybox|python[\d.]*)$/

    // Exclude approved administrator accounts performing routine operations.
    not $proc.principal.user.userid in %global_allowed_admin_users

    // Exclude approved scanner and automation sources.
    not $proc.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($proc.principal.hostname)
    $actor_user = array_distinct($proc.principal.user.userid)
    $enumeration_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
