/*
  MITRE Technique : T1606.001 - Web Cookies
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:25:04.656292+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_001_Web_Cookie_Forgery_Suspicious_Process {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes commonly used to forge web authentication cookies on Windows. Adversaries forge session cookies by extracting secret material (private keys, SAML signing certs, token seeds) and generating new cookies to bypass MFA and authentication controls. This rule targets the process-level signal: scripting engines or credential-access tools invoking cryptographic or HTTP-session libraries with arguments consistent with cookie generation or token forging."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1606.001"
    mitre_technique_name = "Forge Web Credentials: Web Cookies"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1). PowerShell script-block logging (Event 4104) also surfaces this activity."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate web developers testing session management, OAuth/OIDC tooling during CI/CD pipelines, penetration testing frameworks, and identity platform SDKs generating tokens for authorized applications."
    tuning_guidance = "Add known-good parent processes (build agents, approved dev tools) to %global_allowed_admin_tools. Add authorized service accounts performing token operations to %global_allowed_service_accounts. Narrow the command-line regex to exclude specific approved application paths."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Scripting engines and shells commonly used to forge cookies
    $proc.target.process.file.full_path = /\\(powershell|pwsh|python[0-9.]*|ruby|node|wscript|cscript|mshta|cmd)\.exe$/ nocase

    // Command-line patterns associated with cookie/token forging:
    // - JWT construction keywords (header.payload.signature pattern)
    // - SAML assertion or golden-cookie generation
    // - Explicit cookie crafting via HTTP session objects
    // - Base64 encoding of JSON structures typical of cookie payloads
    // - Invocation of cryptographic signing with HMAC/RSA for token generation
    (
      $proc.target.process.command_line = /(?i)(jwt|json.web.token|saml.assertion|golden.cookie|forge.cookie|set-cookie|sessiontoken|authtoken|access.token)/ nocase
      or
      $proc.target.process.command_line = /(?i)(hmacsha(256|384|512)|rsa\.sign|ecdsa\.sign|System\.Security\.Cryptography)/ nocase
      or
      $proc.target.process.command_line = /(?i)(invoke-webrequest|invoke-restmethod|webclient|httpclient).{0,120}(cookie|token|session)/ nocase
      or
      $proc.target.process.command_line = /(?i)\[convert\]::tobase64string.{0,80}(auth|token|session|cookie)/ nocase
      or
      $proc.target.process.command_line = /(?i)(oidc|oauth).{0,60}(token|cookie|forge|craft|generate|sign)/ nocase
    )

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1606.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_user     = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
