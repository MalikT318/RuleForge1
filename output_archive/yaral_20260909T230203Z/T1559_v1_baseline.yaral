/*
  MITRE Technique : T1559 - Inter-Process Communication
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:14:39.256737+00:00
  Reference       : https://attack.mitre.org/techniques/T1559
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Object_Abuse_Script_Host {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects abuse of Windows Component Object Model (COM) IPC by script interpreters or Office applications invoking COM automation to execute commands or spawn child processes. Adversaries use COM as an execution primitive to bypass application whitelisting and evade process-lineage detections. This rule fires when a known COM-capable host (wscript, cscript, mshta, powershell, rundll32, regsvr32, or an Office application) launches a shell or command interpreter as a child process, indicating COM-mediated lateral execution or payload staging."
    mitre_tactic    = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with parent-child process lineage (principal = parent, target = child). Windows Security Event 4688 with command-line auditing enabled is also sufficient if normalised to UDM PROCESS_LAUNCH."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate Office macros invoking shells for approved automation; IT scripting frameworks (Ansible WinRM, SCCM); developer tooling that uses COM for build pipelines."
    tuning_guidance = "Add approved parent process paths to %global_allowed_admin_tools and approved script-host machines to %global_allowed_script_hosts. Narrow further by requiring the child command line to contain suspicious flags (e.g., -enc, -nop, /c, /k) if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent: a COM-capable host or Office application
    $proc.principal.process.file.full_path = /\\(wscript|cscript|mshta|powershell|pwsh|rundll32|regsvr32|winword|excel|powerpnt|outlook|onenote|msaccess|mspub)\.exe$/ nocase

    // Child: a shell, command interpreter, or secondary script host
    // that would not normally be a direct child of these parents
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|certutil|bitsadmin|wmic|cmstp|installutil|msbuild|regasm|regsvcs|ieexec|pcalua|forfiles|bash|wsl)\.exe$/ nocase

    // Exclude cases where the parent IS the same binary as the child
    // (e.g., powershell spawning powershell is handled by other rules)
    // and exclude approved administrative tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
