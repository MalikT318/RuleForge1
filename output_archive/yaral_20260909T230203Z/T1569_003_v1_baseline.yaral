/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:19:05.322959+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Systemctl_Suspicious_Service_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects systemctl being used to start or enable a service from a suspicious parent process or from a non-standard working path, indicating potential abuse of systemd for execution or persistence. Focuses on systemctl invocations spawned by shells, interpreters, or processes running from world-writable directories."
    mitre_tactic    = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events, including parent process path and command-line fields."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate administrators starting or enabling services via shell scripts, configuration management tools (Ansible, Puppet, Chef), container entrypoints, and software package post-install scripts."
    tuning_guidance = "Add known-good parent process paths (e.g. configuration management agents, package managers) to %global_allowed_admin_tools. Add authorised service accounts that routinely manage services to %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be systemctl
    $proc.target.process.file.full_path = /\/systemctl$/

    // Restrict to subcommands that cause immediate execution or persistence
    $proc.target.process.command_line = /\b(start|enable|restart|daemon-reload|link)\b/ nocase

    // Suspicious parent: interactive shells, scripting interpreters, or processes
    // running from world-writable or temporary locations
    (
      $proc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|fish|ash)$/ nocase
      or
      $proc.principal.process.file.full_path = /\/(python[0-9.]*|perl|ruby|php|node|lua)$/ nocase
      or
      $proc.principal.process.file.full_path = /\/(curl|wget)$/
      or
      $proc.principal.process.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/shm\/)/ nocase
    )

    // Exclude service unit names that are clearly standard system services
    // (units referencing /etc/systemd paths are less suspicious than ad-hoc names)
    not $proc.target.process.command_line = /\/etc\/systemd\/system\/(cron|ssh|rsyslog|NetworkManager|auditd|snapd)\.service/ nocase

    // Exclude approved admin tooling parents
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved service accounts performing routine service management
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $command_line      = array_distinct($proc.target.process.command_line)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
