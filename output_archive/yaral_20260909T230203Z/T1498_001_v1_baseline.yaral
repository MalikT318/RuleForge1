/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:04:42.637214+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Direct_Network_Flood_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential direct network flood (DoS/DDoS) activity observed at the perimeter. Triggers when a single external source generates an anomalously high volume of network flows to a single destination within a short observation window, consistent with UDP, ICMP, or TCP flood patterns. Stateless protocol abuse (UDP/ICMP) is weighted more heavily as it is the most common flood vector."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Requires firewall or perimeter flow telemetry with per-flow records including source IP, destination IP, protocol, bytes sent, and packets sent. NetFlow/IPFIX or stateful firewall session logs are ideal."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate high-volume data transfers (backup replication, video streaming, large file transfers), authorised load testing or vulnerability scanning from known sources, CDN or anycast traffic patterns, misconfigured applications generating burst traffic."
    tuning_guidance = "Add known authorised scanner source IPs to %global_allowed_scanners. Add known high-volume internal sources to %global_allowed_mgmt_sources. Raise the bytes_sent threshold if legitimate bulk transfer sources trigger the rule. Consider narrowing to specific destination ports or protocols if the environment has a known attack surface."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Source must be external - exclude RFC1918 internal address space
    not $net.principal.ip in %rfc1918_internal

    // Destination must be internal (protecting internal assets)
    $net.target.ip in %rfc1918_internal

    // Exclude authorised scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // High-volume byte transfer indicative of flood - threshold tunable
    // 50 MB per flow record is anomalous for most protocols
    $net.network.sent_bytes >= 52428800

    // Target stateless or connection-oriented flood protocols
    // UDP (17), ICMP (1), TCP (6) - most common flood vectors
    (
      $net.network.ip_protocol = "UDP" or
      $net.network.ip_protocol = "ICMP" or
      $net.network.ip_protocol = "TCP"
    )

    // Capture key fields for outcome
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip

  outcome:
    $risk_score = max(
      if($net.network.ip_protocol = "UDP", 85,
      if($net.network.ip_protocol = "ICMP", 80,
      75))
    )
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $protocols_observed = array_distinct($net.network.ip_protocol)
    $total_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
