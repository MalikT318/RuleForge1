/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:12:11.727607+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_Code_Signing_Policy_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of Windows code signing enforcement policies, including Driver Signature Enforcement (DSE) disablement via bcdedit, enabling TESTSIGNING mode, or registry changes that weaken code integrity requirements. Adversaries disable these controls to load unsigned or self-signed drivers and DLLs."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (process creation) with full command-line logging enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Kernel/driver developers legitimately enabling test signing on development workstations; OEM imaging pipelines; some hardware vendor installers that temporarily disable DSE during driver installation."
    tuning_guidance = "Scope exclusions to known developer hosts or build servers via %global_allowed_admin_tools. Consider raising severity to Critical if observed on servers or production endpoints. Correlate with subsequent unsigned driver load events for higher-confidence detections."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match bcdedit used to disable Driver Signature Enforcement or enable test signing
    // OR powershell/reg used to weaken code integrity registry controls
    (
      (
        $proc.target.process.file.full_path = /(?i)\\bcdedit\.exe$/
        and
        (
          // Disable DSE entirely via nointegritychecks
          $proc.target.process.command_line = /(?i)nointegritychecks\s+(on|yes)/
          or
          // Enable TESTSIGNING boot mode
          $proc.target.process.command_line = /(?i)testsigning\s+(on|yes)/
          or
          // Load options that bypass integrity checks
          $proc.target.process.command_line = /(?i)\/set\s+.*loadoptions\s+disable_integrity_checks/
        )
      )
      or
      (
        // PowerShell or reg.exe modifying code integrity registry values
        $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh|reg)\.exe$/
        and
        (
          // CI policy registry key modifications
          $proc.target.process.command_line = /(?i)CodeIntegrity/
          or
          // Disabling Hypervisor-Protected Code Integrity (HVCI)
          $proc.target.process.command_line = /(?i)HypervisorEnforcedCodeIntegrity/
          or
          // Disabling secure boot or integrity enforcement via policy registry
          $proc.target.process.command_line = /(?i)\\Control\\DeviceGuard/
          or
          // Disabling DLL signing enforcement
          $proc.target.process.command_line = /(?i)RequireSignedAppInit_DLLs/
        )
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_user     = array_distinct($proc.principal.user.userid)
    $command_executed  = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
