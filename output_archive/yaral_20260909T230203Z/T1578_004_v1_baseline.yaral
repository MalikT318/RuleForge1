/*
  MITRE Technique : T1578.004 - Revert Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:20:34.241335+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_004_Revert_Cloud_Instance_Snapshot_Restore {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud instance revert activity via snapshot restore or disk/volume restoration API calls. Adversaries may restore a VM or storage snapshot to erase evidence of malicious activity and evade detection. Covers snapshot restore, disk image creation from snapshot, and instance replacement from snapshot across cloud providers."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.004"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Revert Cloud Instance"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs) ingested into Chronicle via the cloud_audit log source. API-level compute and storage events must be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized disaster recovery operations, scheduled backup restoration by automation accounts, infrastructure-as-code pipelines performing blue/green deployments, and approved incident response runbooks that restore known-good snapshots."
    tuning_guidance = "Add authorized automation and service account identifiers to %global_allowed_service_accounts. Add approved cloud management principals to %global_allowed_cloud_principals. Consider narrowing the match to off-hours activity or correlating with a preceding suspicious API call on the same instance."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Match snapshot restore, disk restore, and instance revert API operations
    // across AWS, Azure, and GCP as normalized into UDM target.resource fields.
    // Patterns cover: RestoreSnapshot, CreateVolume (from snapshot), CreateDisk (from snapshot),
    // RestoreVirtualMachine, CreateRestorePoint, applySnapshot, restoreInstance, etc.
    $cloud.target.resource.name = /(?i)(restore|revert|rollback|apply.?snapshot|create.*from.?snapshot|create.*restore.?point|snapshot.*restore)/

    // Scope to compute and storage resource types to avoid matching unrelated
    // resource creation events that happen to contain the word "restore".
    $cloud.target.resource.resource_type = /(?i)(instance|virtual.?machine|vm|volume|disk|snapshot|compute|storage)/

    // Exclude known-good automation and service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1578.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $resource_type = array_distinct($cloud.target.resource.resource_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
