/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:22:43.457722+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_Disable_Crypto_Hardware {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects configuration changes on network devices that disable or remove dedicated hardware encryption (crypto engine, hardware accelerator, or IPsec hardware offload). Adversaries who have gained control of a network device may disable hardware crypto to force software-based encryption, weakening cipher strength and facilitating traffic interception or manipulation."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Weaken Encryption: Disable Crypto Hardware"
    log_prerequisites = "Requires network device management-plane or syslog events normalised into Chronicle UDM as SETTING_MODIFICATION. The device must log configuration changes including crypto engine, hardware accelerator, or IPsec offload setting modifications."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Planned maintenance windows where hardware crypto modules are intentionally disabled for diagnostics; authorised firmware upgrades that temporarily disable hardware acceleration; RMA/replacement procedures for crypto hardware modules."
    tuning_guidance = "Add authorised change-management service accounts to %global_allowed_service_accounts. Add approved management source addresses to %global_allowed_mgmt_sources. Correlate with change-management tickets to suppress planned maintenance activity."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Match configuration changes referencing hardware crypto, crypto engine,
    // hardware accelerator, or IPsec hardware offload being disabled or removed.
    // Covers common normalised syslog patterns from routers, switches, and firewalls.
    (
      $cfg.target.resource.name = /(?i)(crypto.engine|hardware.accelerat|hw.crypto|ipsec.offload|crypto.hardware|encryption.hardware|crypto.module)/
      or
      $cfg.security_result.description = /(?i)(crypto.engine|hardware.accelerat|hw.crypto|ipsec.offload|crypto.hardware|encryption.hardware|crypto.module)/
    )

    // The change must indicate disabling, removal, or shutdown of the component
    (
      $cfg.target.resource.name = /(?i)(disable|no\s+crypto|shutdown|removed|deactivat)/
      or
      $cfg.security_result.description = /(?i)(disable|no\s+crypto|shutdown|removed|deactivat)/
      or
      $cfg.target.resource.attribute.labels.value = /(?i)(disable|removed|deactivated|off)/
    )

    // Exclude authorised service and automation accounts
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    // Exclude authorised management source addresses
    not $cfg.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity    = array_distinct($cfg.principal.hostname)
    $affected_device   = array_distinct($cfg.target.hostname)
    $actor_user        = array_distinct($cfg.principal.user.userid)
    $source_ip         = array_distinct($cfg.principal.ip)

  condition:
    $cfg
}
