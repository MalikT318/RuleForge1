/*
  MITRE Technique : T1654 - Log Enumeration
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:30:27.141652+00:00
  Reference       : https://attack.mitre.org/techniques/T1654
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1654_001_Log_Enumeration_Windows {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects log enumeration activity on Windows using built-in utilities such as wevtutil.exe or PowerShell cmdlets to query, export, or clear Windows event logs. Adversaries use this technique to identify authentication records, security posture, and installed software during discovery phases."
    mitre_tactic = "Discovery"
    mitre_technique = "T1654"
    mitre_technique_name = "Log Enumeration"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SIEM agents, log forwarding services, backup tools, IT operations scripts, and monitoring platforms that legitimately query Windows event logs. Administrators using wevtutil or PowerShell for troubleshooting."
    tuning_guidance = "Add known-good parent processes (e.g., monitoring agents, SIEM collectors) to %global_allowed_security_tools. Add authorized service accounts performing log collection to %global_allowed_service_accounts. Scope by parent process path to reduce noise from RMM tooling."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match wevtutil.exe invocations performing log query, export, or enumeration
    // OR PowerShell/pwsh invoking Get-EventLog / Get-WinEvent / wevtutil
    (
      (
        $proc.target.process.file.full_path = /\\wevtutil(\.exe)?$/ nocase
        and
        $proc.target.process.command_line = /\b(el|enum-logs|gl|get-log|qe|query-events|epl|export-log|gli|get-log-info)\b/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)(\.exe)?$/ nocase
        and
        (
          $proc.target.process.command_line = /Get-EventLog/ nocase
          or
          $proc.target.process.command_line = /Get-WinEvent/ nocase
          or
          $proc.target.process.command_line = /wevtutil/ nocase
        )
      )
    )

    // Exclude known-good security tooling and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1654")
    $primary_entity = array_distinct($proc.principal.hostname)
    $target_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
