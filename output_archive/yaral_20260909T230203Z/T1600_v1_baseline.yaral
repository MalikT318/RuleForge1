/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:22:04.479513+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Weaken_Encryption_Plaintext_Mgmt_Traffic {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network connections to management-plane ports (Telnet, HTTP, TFTP, FTP, SNMPv1/v2) on network devices from external sources. Adversaries who weaken or disable encryption on network devices often cause management traffic to revert to cleartext protocols. Observing cleartext management protocols from non-internal sources is a high-fidelity signal for T1600 - Weaken Encryption."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Requires firewall or perimeter flow logs that capture inbound and outbound connections to network device management ports. Connections must be normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW with target.port populated."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Legacy out-of-band management networks using Telnet or SNMPv1 by design; authorised TFTP-based firmware provisioning from jump hosts; network monitoring platforms polling via SNMPv2. Tune by adding approved management source addresses to %global_allowed_mgmt_sources."
    tuning_guidance = "Add all authorised management source IPs and subnets to %global_allowed_mgmt_sources. If internal RFC-1918 management traffic is expected on these ports, add an additional exclusion on principal.ip using net.ip_in_range_cidr() for the management VLAN range. Raise severity to Critical if the destination is a known core routing or firewall asset."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Cleartext management-plane protocols:
    // 23   = Telnet
    // 80   = HTTP management interface
    // 69   = TFTP (firmware/config transfer)
    // 21   = FTP (config backup/restore)
    // 161  = SNMP (v1/v2c - cleartext community strings)
    // 162  = SNMP trap receiver
    (
      $net.target.port = 23  or
      $net.target.port = 80  or
      $net.target.port = 69  or
      $net.target.port = 21  or
      $net.target.port = 161 or
      $net.target.port = 162
    )

    // Exclude known-good internal management sources
    not $net.principal.ip in %rfc1918_internal

    // Exclude approved management source addresses (jump hosts, NMS, etc.)
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude approved scanners that may probe management ports
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity = array_distinct($net.target.ip)
    $cleartext_port = array_distinct($net.target.port)
    $source_ip = array_distinct($net.principal.ip)

  condition:
    $net
}
