/*
  MITRE Technique : T1669 - Wi-Fi Networks
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:33:53.278717+00:00
  Reference       : https://attack.mitre.org/techniques/T1669
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1669_Wireless_Network_Connection_From_Suspicious_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network connections originating from wireless network segments to internal resources, potentially indicating adversary Wi-Fi network access for initial access or lateral movement."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1669"
    mitre_technique_name = "Wi-Fi Networks"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with source interface or SSID metadata."
    platform = "Linux"
    log_source = "ips"
    false_positives = "Legitimate wireless users accessing internal resources, BYOD devices, guest network users with authorized access, wireless IoT devices, mobile device management traffic."
    tuning_guidance = "Add authorized wireless network segments to %global_allowed_mgmt_sources, exclude known wireless service accounts from detection, tune based on wireless network architecture and segmentation policies."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.network.session_id = /(?i)wifi/ or
      $net.network.session_id = /(?i)wireless/ or
      $net.network.session_id = /(?i)wlan/ or
      $net.network.session_id = /(?i)802\.11/ or
      $net.about.labels.value = /(?i)wifi/ or
      $net.about.labels.value = /(?i)wireless/ or
      $net.about.labels.value = /(?i)wlan/ or
      $net.intermediary.labels.value = /(?i)wifi/ or
      $net.intermediary.labels.value = /(?i)wireless/ or
      $net.intermediary.labels.value = /(?i)wlan/ or
      $net.network.application_protocol = /(?i)wifi/ or
      $net.principal.asset.hardware.model = /(?i)wireless/ or
      $net.principal.asset.hardware.model = /(?i)wifi/
    )
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.port in [53, 67, 68, 123, 137, 138, 139, 161, 162, 389, 636, 88]
    $net.network.sent_bytes > 1024

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1669")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
