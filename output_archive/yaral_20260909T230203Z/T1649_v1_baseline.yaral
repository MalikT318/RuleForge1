/*
  MITRE Technique : T1649 - Steal or Forge Authentication Certificates
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:29:18.017047+00:00
  Reference       : https://attack.mitre.org/techniques/T1649
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1649_Suspicious_Certificate_Auth_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects user authentication events where a certificate was used as the credential material from an identity provider audit log. Adversaries who steal or forge authentication certificates (T1649) will produce login events where the authentication method is certificate-based, potentially from unexpected users, locations, or service principals. This rule flags certificate-based logins from accounts not expected to use certificate authentication, enabling analysts to identify stolen or forged certificate abuse."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1649"
    mitre_technique_name = "Steal or Forge Authentication Certificates"
    log_prerequisites = "Requires identity provider audit and sign-in logs normalised to UDM USER_LOGIN events. The authentication method or credential type field must be populated. Compatible with Entra ID sign-in logs, ADFS audit events, and Okta system log events forwarded to Chronicle."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Smart-card or certificate-based authentication configured for specific privileged or service accounts. Device certificate logins from compliant Entra ID joined devices. PKI-integrated VPN or application SSO flows. Automated service principals using certificate credentials for app-only authentication."
    tuning_guidance = "Add expected service accounts and automation identities that legitimately use certificate authentication to %global_allowed_service_accounts. Add known-good cloud or app service principals to %global_allowed_cloud_principals. Consider narrowing by target application or resource if certificate auth is only expected for specific workloads."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Match certificate-based authentication methods as normalised in UDM
    // Covers smart card, x509 certificate, and certificate-based auth descriptors
    (
      $auth.extensions.auth.auth_details = /(?i)certificate/ or
      $auth.extensions.auth.auth_details = /(?i)x509/ or
      $auth.extensions.auth.auth_details = /(?i)smart.?card/ or
      $auth.extensions.auth.auth_details = /(?i)cert.?based/ or
      $auth.network.http.user_agent = /(?i)certificate/
    )

    // Exclude well-known service and automation accounts expected to use certificates
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved cloud and app service principals
    not $auth.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved admin users who are known to use certificate auth
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Require a user identifier to be present to avoid noise from anonymous events
    $auth.principal.user.userid != ""

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1649")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $auth_method = array_distinct($auth.extensions.auth.auth_details)
    $source_ip = array_distinct($auth.principal.ip)
    $target_resource = array_distinct($auth.target.resource.name)

  condition:
    $auth
}
