/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:08:42.061343+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_Impossible_Travel_Session_Reuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects authentication from a geographically distant location within an impossible timeframe, indicating stolen session cookie reuse."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace unified audit logs with geolocation enrichment."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "VPN switching, mobile users on cellular networks, legitimate travel with active sessions, geolocation database inaccuracies, cloud proxy services."
    tuning_guidance = "Add service accounts and known mobile users to %global_allowed_service_accounts. Adjust distance threshold based on organizational travel patterns."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.summary = /(?i)(success|logon)/ nocase
    $auth.principal.location.country_or_region != ""
    $auth.target.location.country_or_region != ""
    $auth.principal.location.country_or_region != $auth.target.location.country_or_region
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    not $auth.network.session_id = ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_country = array_distinct($auth.principal.location.country_or_region)
    $target_country = array_distinct($auth.target.location.country_or_region)
    $session_id = array_distinct($auth.network.session_id)

  condition:
    $auth
}
