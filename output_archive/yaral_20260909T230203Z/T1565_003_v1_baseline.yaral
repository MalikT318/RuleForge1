/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:18:30.248748+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_Runtime_Data_Manipulation_FileAssoc_Hijack {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects registry modifications that redirect file associations or application command verbs to unexpected executables, a core mechanism for T1565.003 Runtime Data Manipulation. Attackers alter the handler for a file type or URL scheme so that when a user opens a document or link, a trojanised binary is invoked instead of the legitimate application, silently manipulating the data presented at runtime."
    mitre_tactic    = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Runtime Data Manipulation"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION events. Sysmon Event ID 13 or equivalent EDR registry write events must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers legitimately registering file associations; browser or media player updates; application repair operations; RMM tools deploying software."
    tuning_guidance = "Add known-good installer and deployment parent processes to %global_allowed_admin_tools. Scope the command-verb path regex more tightly if specific file types generate noise. Consider adding a parent-process exclusion for msiexec.exe and setup.exe patterns during maintenance windows."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the shell\open\command and shell\<verb>\command subkeys under
    // HKCR (file-type handlers) and HKCU ProgID overrides.
    // These are the canonical locations Windows consults at runtime to
    // resolve which binary handles a given file type or URL scheme.
    $reg.target.registry.registry_key = /(?i)\\shell\\[^\\]+\\command$/

    // The key must live under a file-association or ProgID path.
    // HKCR\.<ext>, HKCR\<ProgID>, HKCU\Software\Classes, or
    // HKLM\SOFTWARE\Classes are all valid manipulation targets.
    $reg.target.registry.registry_key = /(?i)(HKEY_CLASSES_ROOT|HKCR|HKEY_CURRENT_USER\\Software\\Classes|HKEY_LOCAL_MACHINE\\SOFTWARE\\Classes)/

    // The new handler value must reference an executable path.
    // We look for the value data containing a path to a binary,
    // particularly ones outside standard system directories or
    // referencing scripting hosts, which are common manipulation vectors.
    $reg.target.registry.registry_value_data = /(?i)\.(exe|bat|cmd|ps1|vbs|js|hta|scr|com|pif)/

    // Exclude modifications where the value data points to well-known
    // system application paths (e.g. C:\Windows\system32\, Program Files).
    // Attackers typically point handlers at user-writable or temp locations.
    not $reg.target.registry.registry_value_data = /(?i)C:\\Windows\\(system32|SysWOW64)\\[^\\]+\.(exe|dll)/

    // Exclude known-good administrative and deployment tooling as the
    // process making the registry write.
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved service accounts performing software deployment.
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $new_handler = array_distinct($reg.target.registry.registry_value_data)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
