/*
  MITRE Technique : T1671 - Cloud Application Integration
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:34:06.654888+00:00
  Reference       : https://attack.mitre.org/techniques/T1671
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1671_001_OAuth_App_Consent_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects OAuth application consent grants in Microsoft 365, a primary persistence mechanism where adversaries register or co-opt an application and grant it delegated or application-level permissions. Consent grants can survive account disablement and bypass MFA, making them a high-fidelity persistence signal."
    mitre_tactic = "Persistence"
    mitre_technique = "T1671"
    mitre_technique_name = "Cloud Application Integration"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log with AzureActiveDirectory workload enabled. Relevant operations: Add delegated permission grant, Consent to application, Add app role assignment to service principal."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate IT-approved OAuth application onboarding, enterprise software integrations deployed by administrators, automated provisioning pipelines using service accounts."
    tuning_guidance = "Add known-approved service account identifiers to %global_allowed_service_accounts and known-approved cloud principals to %global_allowed_cloud_principals. Consider scoping high-severity alerts to non-admin users or applications requesting broad scopes such as Mail.ReadWrite or Files.ReadWrite.All."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    (
      $cloud.metadata.description = /(?i)consent to application/ or
      $cloud.metadata.description = /(?i)add delegated permission grant/ or
      $cloud.metadata.description = /(?i)add app role assignment/ or
      $cloud.metadata.description = /(?i)add oauth2permissiongrant/
    )
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1671")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $consenting_user = array_distinct($cloud.principal.user.userid)

  condition:
    $cloud
}
