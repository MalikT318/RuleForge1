/*
  MITRE Technique : T1619 - Cloud Storage Object Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:28:11.306134+00:00
  Reference       : https://attack.mitre.org/techniques/T1619
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1619_001_Cloud_Storage_Object_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects enumeration of objects within cloud storage buckets or blob containers via cloud provider audit APIs (e.g., ListObjectsV2, List Blobs, objects.list). A single high-volume listing event or repeated listing calls from an unexpected principal may indicate adversarial discovery activity intended to identify data for exfiltration or further targeting."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1619"
    mitre_technique_name = "Cloud Storage Object Discovery"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM. AWS CloudTrail s3:ListObjectsV2 / s3:ListBucketMultipartUploads, Azure Storage List Blobs, or GCP storage.objects.list events must be ingested and mapped to USER_RESOURCE_ACCESS with metadata.product_event_type populated."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Backup agents, data pipeline services, ETL jobs, authorised security scanners, and cloud-native monitoring tools routinely enumerate storage objects. CI/CD pipelines accessing artifact buckets will also trigger this rule."
    tuning_guidance = "Add known automation and service account identifiers to %global_allowed_service_accounts. Add approved scanner principals to %global_allowed_scanners. Narrow the product_event_type regex if only one cloud provider is in scope. Consider promoting to a Threshold rule to suppress single-event noise from legitimate batch jobs."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match normalised API operation names for object listing across AWS, Azure, and GCP.
    // AWS: ListObjectsV2, ListObjects, ListBucketMultipartUploads
    // Azure: ListBlobs, BlobList, listblobs
    // GCP: storage.objects.list
    $cloud.metadata.product_event_type = /(?i)(listobjects|list_objects|listbucketmultipart|listblobs|blob.*list|storage\.objects\.list|list.*blob)/

    // Require a principal identity to be present - anonymous enumeration is higher risk.
    $cloud.principal.user.userid != ""

    // Exclude known-good automation and service accounts.
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved security scanners.
    not $cloud.principal.user.userid in %global_allowed_scanners

    // Exclude approved cloud principals (e.g., authorised data pipelines).
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Capture the target resource for outcome enrichment.
    $cloud.target.resource.name != ""

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1619")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $storage_resource  = array_distinct($cloud.target.resource.name)
    $api_operation     = array_distinct($cloud.metadata.product_event_type)
    $source_ip         = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
