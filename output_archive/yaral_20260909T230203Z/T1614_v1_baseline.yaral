/*
  MITRE Technique : T1614 - System Location Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:27:19.728627+00:00
  Reference       : https://attack.mitre.org/techniques/T1614
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_System_Location_Discovery_GeoIP_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP/HTTPS connections to well-known IP geolocation and location-discovery services. Adversaries query these services to determine the geographic location of a victim host before deciding whether to proceed with full infection or specific follow-on actions (T1614). Firewall and proxy logs capture this network-observable behaviour regardless of the initiating process."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614"
    mitre_technique_name = "System Location Discovery"
    log_prerequisites = "Requires firewall or proxy logs with URL/hostname visibility (layer-7 inspection or DNS-based logging). UDM event type NETWORK_HTTP or NETWORK_DNS with target.hostname populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate applications performing geolocation for UX purposes (weather apps, CDN routing, VPN clients), browser-based geolocation APIs, and authorised network monitoring tools. Cloud-hosted endpoints may query metadata services for similar purposes."
    tuning_guidance = "Add known-good internal proxy egress IPs to %global_allowed_mgmt_sources. Add approved geolocation service domains used by sanctioned applications to %global_allowed_domains. Narrow scope by correlating with unusual source hosts or off-hours timing."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

    // Match hostnames associated with IP geolocation lookup services using
    // inline case-insensitive flag since nocase is not valid inside re.regex()
    $net.target.hostname = /(?i)(ipinfo\.io|ip-api\.com|ipapi\.co|ipgeolocation\.io|geoip\.com|freegeoip\.(app|net|io)|api\.ipify\.org|checkip\.|whatismyip\.|myexternalip\.com|ipecho\.net|icanhazip\.com|ident\.me|ifconfig\.(me|co|io)|ip\.sb|ipstack\.com|geolocation\.onetrust\.com|geoiplookup\.net|ip2location\.com|maxmind\.com\/geoip|ipwhois\.io|abstractapi\.com\/v1\/ip)/

    // Restrict to standard web ports to reduce noise from unrelated traffic
    $net.target.port >= 80
    $net.target.port <= 443

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1614")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hostname = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
