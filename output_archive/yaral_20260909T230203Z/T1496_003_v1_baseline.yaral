/*
  MITRE Technique : T1496.003 - SMS Pumping
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:02:15.129594+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_003_SMS_Pumping_High_Volume_Messaging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects high-volume SMS or messaging API calls from a single source, indicative of SMS pumping fraud targeting messaging infrastructure."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.003"
    mitre_technique_name = "Resource Hijacking: SMS Pumping"
    log_prerequisites = "Requires cloud provider audit logs capturing messaging service API calls (SNS, Twilio, Cognito, etc.)."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate bulk messaging campaigns, marketing automation, multi-factor authentication during peak login periods, automated notification systems."
    tuning_guidance = "Add authorized bulk messaging service principals to %global_allowed_cloud_principals. Adjust threshold based on baseline messaging volume for legitimate services."

  events:
    $event.metadata.event_type = "USER_RESOURCE_ACCESS"
    $event.target.resource.name = /(?i)(sms|message|publish|sendmessage|sendsms|notification)/ 
    $event.security_result.summary = /(?i)(success|allowed|granted)/
    not $event.principal.user.userid in %global_allowed_cloud_principals
    not $event.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1496.003")
    $primary_entity = array_distinct($event.principal.user.userid)

  condition:
    $event
}
