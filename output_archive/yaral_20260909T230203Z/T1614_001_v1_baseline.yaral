/*
  MITRE Technique : T1614.001 - System Language Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:27:38.076152+00:00
  Reference       : https://attack.mitre.org/techniques/T1614/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_Linux_System_Language_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects processes querying system locale, language, or keyboard layout configuration on Linux. Adversaries enumerate locale settings to determine geographic location and decide whether to proceed with infection or tailor follow-on behavior. Covers reads of /etc/locale.conf, /etc/default/locale, /etc/locale.gen, /etc/vconsole.conf, and execution of locale/localectl utilities from suspicious parent contexts."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1614.001"
    mitre_technique_name = "System Location Discovery: System Language Discovery"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH. Parent-child process relationships must be populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "System administrators running locale/localectl interactively, configuration management tools (Ansible, Puppet, Chef), OS installers, desktop environment startup scripts, and monitoring agents that collect system inventory."
    tuning_guidance = "Add known-good automation parent processes (e.g. ansible, puppet, chef-client) to %global_allowed_admin_tools. Add authorised service accounts that perform inventory collection to %global_allowed_service_accounts. Narrow the rule by requiring the parent process to be a shell or interpreter if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match execution of locale query utilities OR access to locale config files via shell commands
    (
      // Direct invocation of locale enumeration utilities
      $proc.target.process.file.full_path = /\/(locale|localectl)$/ nocase
      or
      // Shell or interpreter reading locale configuration files via cat/grep/awk/sed/head/tail/less/more
      (
        $proc.target.process.file.full_path = /\/(cat|grep|awk|sed|head|tail|less|more|strings|python[23]?|perl|ruby|bash|sh|dash|zsh|ksh)$/ nocase
        and
        $proc.target.process.command_line = /\/(etc\/(locale(\.conf|\.gen|\/)?|default\/locale|vconsole\.conf)|proc\/sys\/kernel\/(ostype|version)|usr\/share\/i18n)/ nocase
      )
    )

    // Exclude known-good administrative tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude expected script hosts (e.g. configuration management, monitoring)
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1614.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
