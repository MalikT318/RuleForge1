/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:23:38.836016+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Network_Device_Image_Downgrade {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects potential network device OS image downgrade activity observed at the firewall/perimeter layer. An adversary may transfer an older firmware or OS image file to a network device to weaken encryption or bypass security controls. This rule fires on large outbound or inbound transfers over management-plane-adjacent protocols (TFTP/FTP/SCP/HTTP) that carry filenames or URI patterns consistent with network device OS image files, originating from or destined to non-internal addresses. Firewall telemetry captures the flow-level signal without requiring endpoint process visibility."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Modify System Image: Downgrade System Image"
    log_prerequisites = "Requires firewall or perimeter flow/proxy logs normalised to UDM NETWORK_HTTP or NETWORK_FLOW, including target.url, network.sent_bytes / network.received_bytes, and target.port."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorised firmware upgrade workflows initiated by network operations teams, automated patch management systems, vendor-managed device provisioning, and TFTP-based PXE boot infrastructure."
    tuning_guidance = "Add authorised management source addresses to %global_allowed_mgmt_sources and approved scanner/automation accounts to %global_allowed_scanners. Raise the byte-count threshold if legitimate large transfers are common. Scope target.port to only TFTP (69), FTP (20/21), SCP (22), or HTTP (80/443) as appropriate for your environment."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Match URI patterns consistent with network OS image files:
    // .bin, .img, .tar, .pkg, .iosxe, .iosxr, .iso, .swi, .spa, .smu
    $net.target.url = /(?i)\.(bin|img|tar|pkg|iso|swi|spa|smu|iosxe|iosxr|firmware|system-image)(\?|$|#|\/)/ nocase

    // Restrict to protocols commonly used for device image transfer
    (
      $net.target.port = 69   or   // TFTP
      $net.target.port = 20   or   // FTP data
      $net.target.port = 21   or   // FTP control
      $net.target.port = 22   or   // SCP/SFTP
      $net.target.port = 80   or   // HTTP
      $net.target.port = 443       // HTTPS
    )

    // Require a meaningful transfer size - OS images are large (>5 MB)
    $net.network.received_bytes > 5000000

    // Exclude traffic from known-good internal management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude known authorised scanner/automation sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude traffic destined to or sourced from known-good domains
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score        = max(90)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_host  = array_distinct($net.target.hostname)
    $destination_port  = array_distinct($net.target.port)
    $bytes_received    = max($net.network.received_bytes)
    $image_url         = array_distinct($net.target.url)

  condition:
    $net
}
