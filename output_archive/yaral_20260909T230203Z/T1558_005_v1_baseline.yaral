/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:14:18.220237+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Ccache_File_Access_Or_Exfil {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects suspicious access to or copying of Kerberos credential cache (ccache) files on Linux. Adversaries read /tmp/krb5cc_* or krb5.ccache files to steal Kerberos tickets for Pass-the-Ticket attacks without needing the user's password."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that captures process launches with command-line arguments, including file path arguments. Auditd rules should monitor open/read syscalls on /tmp/krb5cc_* and /tmp/krb5.ccache."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate kinit/klist invocations by Kerberos-aware applications, PAM modules, SSSD, or authorized administrators checking ticket status. Backup agents reading /tmp may also trigger this."
    tuning_guidance = "Add known-good Kerberos management processes (sssd, pam_krb5, authorized admin scripts) to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the scope by also requiring the process to be unexpected (e.g., not kinit/klist themselves) if your environment generates high volume from those binaries."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target: processes whose command line references ccache file paths
    // Covers /tmp/krb5cc_<UID>, /tmp/krb5.ccache, and custom KRB5CCNAME paths
    $proc.target.process.command_line = /\/tmp\/krb5(cc_[0-9]+|\.ccache)/ nocase

    // Suspicious process categories: copy/move utilities, archive tools,
    // scripting interpreters, network transfer tools, and generic file readers
    // that have no legitimate reason to directly reference ccache files
    $proc.target.process.file.full_path = /\/(cp|mv|cat|dd|tar|zip|gzip|base64|xxd|od|strings|curl|wget|scp|rsync|nc|ncat|python[23]?|perl|ruby|bash|sh|dash|zsh|awk|sed|tee|xargs|find|install|openssl)$/ nocase

    // Exclude known-good administrative and backup tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $actor_process     = array_distinct($proc.target.process.file.full_path)
    $actor_cmdline     = array_distinct($proc.target.process.command_line)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
