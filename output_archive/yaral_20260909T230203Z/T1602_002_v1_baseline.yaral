/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:24:23.498027+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_Network_Device_Config_Dump {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects potential network device configuration dump activity observable at the firewall/perimeter layer. Flags inbound SNMP (UDP 161/162), Smart Install (TCP 4786), TFTP (UDP 69), and SCP/SFTP (TCP 22) sessions originating from external (non-RFC1918) addresses to internal network device management addresses. Adversaries abuse these protocols to retrieve running or startup configurations from network devices."
    mitre_tactic    = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Network Device Configuration Dump"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW. Sessions must include source/destination IP and destination port."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorised NMS/SNMP polling from management stations, legitimate TFTP-based config backups, approved SCP-based config archival jobs, vulnerability scanner activity."
    tuning_guidance = "Add authorised SNMP polling sources and management station IPs to %global_allowed_scanners or %global_allowed_mgmt_sources. Add approved backup processes to %global_allowed_backup_processes to suppress scheduled config archival."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target ports associated with config-dump protocols:
    // UDP 69  = TFTP (config transfer)
    // UDP 161 = SNMP queries
    // UDP 162 = SNMP traps / bulk walk
    // TCP 4786 = Cisco Smart Install (SMI) - unauthenticated config retrieval
    // TCP 22  = SSH/SCP/SFTP used to pull configs
    (
        $net.target.port = 69   or
        $net.target.port = 161  or
        $net.target.port = 162  or
        $net.target.port = 4786 or
        $net.target.port = 22
    )

    // Source must be external (not RFC1918 internal space)
    not $net.principal.ip in %rfc1918_internal

    // Destination must be internal (management plane of a network device)
    $net.target.ip in %rfc1918_internal

    // Exclude authorised management sources (NMS, jump hosts, scanners)
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity    = array_distinct($net.target.ip)
    $source_ips        = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
