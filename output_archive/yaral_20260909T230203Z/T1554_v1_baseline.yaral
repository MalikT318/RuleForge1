/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:12:32.518317+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_001_Host_Software_Binary_Compromise {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of host software binaries in trusted system and program directories by unexpected processes. Adversaries patch or replace legitimate executables (browsers, SSH clients, FTP clients, email clients) to establish persistence or harvest credentials. This rule fires when a non-system, non-installer process writes or overwrites an executable file under common trusted application directories."
    mitre_tactic    = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "Requires EDR or Sysmon file-write telemetry normalised to FILE_MODIFICATION or FILE_CREATION UDM events with principal process path and target file path populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software updaters (e.g., auto-update services), patch management agents, software installers running from Program Files, Windows Update components (TrustedInstaller), and package managers such as winget or Chocolatey."
    tuning_guidance = "Add known-good updater and installer process paths to %global_allowed_admin_tools. Add authorised deployment service accounts to %global_allowed_service_accounts. Scope further by excluding parent processes that are signed update orchestrators."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target must be an executable or library in a trusted application directory
    $file.target.file.full_path = /(?i)^[A-Za-z]:\\(Program Files|Program Files \(x86\)|Windows\\System32|Windows\\SysWOW64|Windows\\System|ProgramData)\\.*\.(exe|dll|sys|ocx|cpl|scr|msi|com)$/

    // The writing process must NOT itself reside in a trusted system or installer location
    not $file.principal.process.file.full_path = /(?i)^[A-Za-z]:\\(Windows\\System32|Windows\\SysWOW64|Windows\\WinSxS|Windows\\servicing|Windows\\Installer)\\.*\.(exe|dll)$/

    // Exclude known-good update and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service accounts performing patch/deployment operations
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude backup agents that legitimately touch binaries
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude security tooling (EDR agents writing quarantine copies, etc.)
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // The writing process must not be a child of a trusted Windows update orchestrator
    not $file.principal.process.file.full_path = /(?i)\\(TrustedInstaller\.exe|msiexec\.exe|wusa\.exe|wuauclt\.exe|svchost\.exe|MpSigStub\.exe|MpCmdRun\.exe)$/

    // Exclude processes running from user temp/download paths that are installers
    // (these are handled by the admin-tools list; this catches common staging paths)
    not $file.principal.process.file.full_path = /(?i)\\(Windows\\Temp|Temp|AppData\\Local\\Temp)\\.*setup.*\.exe$/

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
