/*
  MITRE Technique : T1667 - Email Bombing
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:33:10.654233+00:00
  Reference       : https://attack.mitre.org/techniques/T1667
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1667_001_Email_Bombing_High_Volume_Inbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a high volume of inbound email messages delivered to a single recipient mailbox within a short window, consistent with email bombing. Adversaries flood a target inbox to bury legitimate security alerts or business communications, often as a precursor to vishing or fraud."
    mitre_tactic = "Impact"
    mitre_technique = "T1667"
    mitre_technique_name = "Email Bombing"
    log_prerequisites = "Requires Microsoft 365 unified audit logs with Exchange Online message trace or mail flow events normalised to UDM EMAIL_TRANSACTION. Each inbound delivery must produce a discrete event."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Bulk marketing campaigns to shared mailboxes, mailing list digests, automated notification systems, newsletter subscriptions, and high-volume shared service desk inboxes."
    tuning_guidance = "Add known bulk-sender domains to %global_allowed_domains. Add shared or service mailbox identifiers to %global_allowed_service_accounts. Raise the threshold count or shorten the window for high-volume environments. Consider scoping to individual user mailboxes rather than shared inboxes."

  events:
    $mail.metadata.event_type = "EMAIL_TRANSACTION"

    // Inbound mail only - sender domain must differ from recipient domain
    // to focus on external bombing campaigns rather than internal noise
    $mail.network.email.from = /^.+@.+\..+$/
    $mail.network.email.to = /^.+@.+\..+$/

    // Exclude known-good bulk senders and service accounts
    not $mail.network.email.from in %global_allowed_domains
    not $mail.network.email.to in %global_allowed_service_accounts

    // Capture the recipient as the grouping entity
    $mail.network.email.to = $recipient

  match:
    $recipient over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1667")
    $primary_entity = array_distinct($recipient)
    $sender_count = count(distinct $mail.network.email.from)
    $message_count = count($mail.network.email.from)
    $sample_senders = array_distinct($mail.network.email.from)

  condition:
    // Fire when a single recipient receives more than 100 messages in 10 minutes
    // from more than 5 distinct senders, indicating automated list-bombing
    #mail > 100 and $sender_count > 5
}
