/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:19:19.948753+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_ESXi_Management_Service_Nonstandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi management service ports (hostd, vpxa) to non-standard values, enabling C2 over unexpected ports."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "Requires ESXi hostd or shell command logs capturing configuration changes."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorized port changes for security hardening, network segmentation requirements, compliance-driven reconfigurations."
    tuning_guidance = "Add authorized management source IPs to %global_allowed_mgmt_sources if port changes originate from known bastion hosts or orchestration systems."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /vim-cmd\s+hostsvc\/advopt\/update/ nocase or
      $proc.target.process.command_line = /esxcli\s+system\s+settings\s+advanced\s+set/ nocase or
      $proc.target.process.command_line = /vim-cmd\s+proxysvc\/service_stop/ nocase or
      $proc.target.process.command_line = /vim-cmd\s+proxysvc\/service_start/ nocase
    )
    (
      $proc.target.process.command_line = /config\.hostgateway\.port/ nocase or
      $proc.target.process.command_line = /config\.hostgateway\.httpsport/ nocase or
      $proc.target.process.command_line = /vpxa\.httpport/ nocase or
      $proc.target.process.command_line = /vpxa\.httpsport/ nocase or
      $proc.target.process.command_line = /\/etc\/vmware\/hostd\/config\.xml/ nocase
    )
    not (
      $proc.target.process.command_line = /\s+443\s*$/ or
      $proc.target.process.command_line = /\s+902\s*$/ or
      $proc.target.process.command_line = /\s+8089\s*$/
    )
    not $proc.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
