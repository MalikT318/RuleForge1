/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:16:54.533088+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_SSH_Agent_Socket_Hijack_Network {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable SSH lateral movement consistent with SSH session hijacking. An adversary who has compromised an SSH agent socket or obtained root access can forward connections through an existing authenticated session, producing SSH traffic from an internal host to another internal host on port 22 that does not match expected management-plane sources. This rule flags internal-to-internal SSH connections originating from hosts that are not approved management sources, which is the network signature of agent-forwarding abuse or ProxyJump-style hijacking."
    mitre_tactic         = "Lateral Movement"
    mitre_technique      = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites    = "Requires firewall or network perimeter flow logs with source/destination IP, destination port, and protocol. Logs must be normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform             = "Linux"
    log_source           = "firewall"
    false_positives      = "Legitimate jump-host or bastion infrastructure performing authorised SSH forwarding; automated configuration management tools (Ansible, Fabric) running from non-standard hosts; vulnerability scanners performing SSH reachability checks."
    tuning_guidance      = "Add approved bastion/jump-host source addresses to %global_allowed_mgmt_sources. Add authorised scanner source addresses to %global_allowed_scanners. If internal RFC-1918 SSH traffic is expected in bulk (e.g., container orchestration), narrow the rule by restricting principal.ip to specific sensitive subnets."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Destination port 22 — the SSH service port
    $net.target.port = 22

    // Source must be an internal address (internal-to-internal lateral movement)
    $net.principal.ip in %rfc1918_internal

    // Destination must also be internal — hijacking pivots to another internal host
    $net.target.ip in %rfc1918_internal

    // Exclude approved management sources (bastions, jump hosts, RMM)
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude authorised scanners performing SSH reachability checks
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_host  = array_distinct($net.target.ip)
    $destination_port  = max($net.target.port)

  condition:
    $net
}
