/*
  MITRE Technique : T1535 - Unused/Unsupported Cloud Regions
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:07:56.171093+00:00
  Reference       : https://attack.mitre.org/techniques/T1535
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1535_Resource_Creation_Unusual_Cloud_Region {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud resource creation events originating from regions that are atypical or rarely used. Adversaries compromise cloud accounts and spin up resources in unused geographic regions to evade monitoring, often for cryptomining or C2 infrastructure. This rule fires on any resource creation where the target cloud region matches patterns associated with non-primary or exotic regions, and the principal is not a known-good service account."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1535"
    mitre_technique_name = "Unused/Unsupported Cloud Regions"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM. AWS CloudTrail, Azure Activity Logs, or GCP Audit Logs must be ingested. The target.cloud.environment and target.location.country_or_region fields must be populated by the UDM parser."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate disaster recovery or data residency expansion into new regions. Authorised DevOps pipelines deploying to new regions for the first time. Cloud provider managed services that automatically replicate resources globally."
    tuning_guidance = "Add approved service principals to %global_allowed_cloud_principals. Add approved regions to the exclusion regex as your organisation's baseline region footprint becomes known. Lower severity if the principal is a known deployment pipeline account."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target a cloud resource creation API action
    $cloud.target.resource.resource_type != ""

    // The region field must be populated and must NOT match common primary regions.
    // Adjust the exclusion regex to reflect the organisation's approved region baseline.
    // Pattern covers AWS us-east-1/2, us-west-1/2, eu-west-1/2/3, eu-central-1,
    // ap-southeast-1/2, ap-northeast-1, Azure eastus/westus/westeurope/northeurope,
    // GCP us-central1, us-east1, europe-west1, asia-east1.
    $cloud.target.location.country_or_region != ""
    not $cloud.target.location.country_or_region = /(?i)^(us-east-[12]|us-west-[12]|eu-west-[123]|eu-central-1|ap-southeast-[12]|ap-northeast-1|eastus|eastus2|westus|westus2|westeurope|northeurope|us-central1|us-east1|europe-west1|asia-east1)$/

    // Exclude known-good cloud service principals (automation, deployment pipelines)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known-good service accounts by display name pattern (e.g. managed identities)
    not $cloud.principal.user.user_display_name = /(?i)(backup|scanner|monitoring|patchmgmt)/

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1535")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $region_observed = array_distinct($cloud.target.location.country_or_region)
    $resource_type = array_distinct($cloud.target.resource.resource_type)

  condition:
    $cloud
}
