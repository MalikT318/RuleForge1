/*
  MITRE Technique : T1561.002 - Disk Structure Wipe
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:16:21.328931+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_002_Disk_Structure_Wipe_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects direct writes to raw disk devices or partition table structures on Linux, which is the primary mechanism used by disk-wiping malware to destroy the MBR, GPT, or partition table and render a system unbootable. Matches process launches targeting block devices (/dev/sd*, /dev/hd*, /dev/nvme*, /dev/vd*) via dd, shred, or similar utilities, as well as direct writes using low-level tools."
    mitre_tactic = "Impact"
    mitre_technique = "T1561.002"
    mitre_technique_name = "Disk Structure Wipe"
    log_prerequisites = "Requires Linux EDR telemetry or auditd process execution logs normalised to UDM PROCESS_LAUNCH. Auditd rules should capture execve syscalls with arguments. EDR agents (e.g. Falcon, SentinelOne, Elastic Endpoint) provide equivalent coverage."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate disk imaging operations (cloning, forensic acquisition), authorised disk benchmarking tools, OS installation or provisioning pipelines, backup agents writing to raw devices."
    tuning_guidance = "Add authorised imaging or provisioning process paths to %global_allowed_backup_processes. Add known provisioning service accounts to %global_allowed_service_accounts. Consider scoping to non-provisioning hours or adding a parent-process filter for known deployment orchestrators."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match utilities commonly abused to overwrite disk structures
    $proc.target.process.file.full_path = /\/(dd|shred|wipe|dcfldd|dc3dd|hdparm|sgdisk|gdisk|fdisk|parted|wipefs|blkdiscard|badblocks)$/ nocase

    // Command line must reference a raw block device (MBR/GPT target)
    // Covers /dev/sda, /dev/hda, /dev/nvme0, /dev/vda, /dev/xvda etc.
    // Also catches /dev/disk/by-id/ and /dev/disk/by-path/ references
    $proc.target.process.command_line = /\/dev\/(sd[a-z]|hd[a-z]|nvme[0-9]+n[0-9]+|vd[a-z]|xvd[a-z]|disk\/)/ nocase

    // For dd specifically, require output-to-device or zero/random input patterns
    // This broad match covers: of=/dev/sda, if=/dev/zero, if=/dev/urandom
    // The regex is intentionally broad to catch obfuscated spacing
    $proc.target.process.command_line = /(of=\/dev\/|if=\/dev\/(zero|urandom|null)|seek=0|bs=[0-9]+(M|G|K|m|g|k))/ nocase

    // Exclude authorised backup and imaging processes
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude authorised service accounts (provisioning, deployment)
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1561.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_command = array_distinct($proc.target.process.command_line)
    $triggering_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
