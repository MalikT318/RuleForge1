/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:07:10.194795+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_IaaS_Account_Access_Removal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects bulk or targeted account access removal actions in identity provider audit logs, including account disablement, credential resets, permission revocations, and group membership removals that could indicate adversarial account lockout as part of an Impact operation."
    mitre_tactic = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "Requires identity provider audit logs (e.g., Entra ID Audit Logs, Okta System Log) normalised to UDM. Events must include USER_CHANGE_PASSWORD, USER_CHANGE_PERMISSIONS, or GROUP_MODIFICATION event types with actor and target user context."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate IT helpdesk password resets, offboarding automation, bulk provisioning scripts, and access reviews performed by IAM teams. Service accounts performing scheduled credential rotations may also trigger this rule."
    tuning_guidance = "Add known helpdesk and provisioning service accounts to %global_allowed_service_accounts. Add approved IAM automation principals to %global_allowed_admin_users. Consider raising the threshold or adding a match block if volume of legitimate resets is high."

  events:
    // Target the core identity audit event types that represent account access removal
    $auth.metadata.event_type in [
      "USER_CHANGE_PASSWORD",
      "USER_CHANGE_PERMISSIONS",
      "GROUP_MODIFICATION"
    ]

    // The actor performing the action must differ from the target user,
    // indicating an administrative or adversarial action rather than a self-service reset
    $auth.principal.user.userid != $auth.target.user.userid

    // Exclude empty actor identities (system-generated events with no human/principal context)
    $auth.principal.user.userid != ""

    // Exclude known service and automation accounts performing legitimate privileged actions
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrators performing expected IAM operations
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Exclude approved cloud/identity service principals (e.g., provisioning apps)
    not $auth.principal.user.email_addresses in %global_allowed_cloud_principals

    // Target user must be populated - filter noise from malformed events
    $auth.target.user.userid != ""

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $actor_userid = array_distinct($auth.principal.user.userid)
    $target_userid = array_distinct($auth.target.user.userid)
    $event_type = array_distinct($auth.metadata.event_type)

  condition:
    $auth
}
