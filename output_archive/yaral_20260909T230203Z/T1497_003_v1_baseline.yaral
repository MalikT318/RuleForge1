/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:04:07.600490+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Time_Based_Sandbox_Evasion_Via_Script {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects process command lines that invoke time-based sandbox evasion techniques on Windows. Adversaries use sleep calls, uptime queries, and system-time sampling (GetTickCount, GetSystemTimeAsFileTime equivalents) via scripting hosts or native utilities to detect analysis environments that accelerate or manipulate time. This rule targets the observable command-line patterns produced by such checks rather than API calls directly, catching PowerShell, WScript, and cmd-based implementations."
    mitre_tactic    = "Defense Evasion, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture. PowerShell script-block logging (Event 4104) is complementary but not required for this rule."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate monitoring scripts that poll system uptime or time; software installers that use Start-Sleep for retry logic; IT automation runbooks; performance benchmarking tools."
    tuning_guidance = "Add known-good parent process paths (deployment agents, RMM tools) to %global_allowed_admin_tools. Narrow the match by also requiring an unusual parent process (e.g., Office applications, browser child processes) if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting hosts and native utilities commonly used to implement
    // time-based checks in malware droppers and loaders.
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|cmd)\.exe$/ nocase

    // Match time-based evasion patterns:
    // 1. Sleep / Start-Sleep with a meaningful delay (any numeric argument)
    // 2. Uptime enumeration via WMI (LastBootUpTime, Win32_OperatingSystem)
    // 3. Explicit time-delta sampling patterns referencing tick counts or file times
    // 4. [System.DateTime]::Now / UtcNow used in before/after comparisons
    // 5. ping -n as a sleep substitute (classic cmd sleep trick)
    (
      $proc.target.process.command_line = /Start-Sleep\s+-[Ss]econds?\s+\d/ nocase or
      $proc.target.process.command_line = /\[System\.Threading\.Thread\]::Sleep/ nocase or
      $proc.target.process.command_line = /Win32_OperatingSystem.*LastBootUpTime/ nocase or
      $proc.target.process.command_line = /Get-Date.*UtcNow|UtcNow.*Get-Date/ nocase or
      $proc.target.process.command_line = /\[System\.DateTime\]::(Now|UtcNow)/ nocase or
      $proc.target.process.command_line = /GetTickCount|GetSystemTime/ nocase or
      $proc.target.process.command_line = /ping\s+.*-n\s+\d+\s+127\.0\.0\.1/ nocase or
      $proc.target.process.command_line = /timeout\s+\/t\s+\d+/ nocase or
      $proc.target.process.command_line = /Measure-Command\s*\{/ nocase
    )

    // Exclude approved administrative and scripting sources
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $spawned_process   = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
