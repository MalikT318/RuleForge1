/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:05:00.027546+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_Reflection_Amplification_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential reflection amplification attack participation: a single internal host sending high volumes of traffic to well-known amplification protocol ports (DNS/53, NTP/123, SSDP/1900, Memcached/11211, SNMP/161, LDAP/389, mDNS/5353, CharGen/19, QOTD/17) on UDP. A single host generating large numbers of flows to these ports may indicate it is acting as a reflector receiving spoofed-source packets, or as a botnet node directing amplified traffic. Excludes known scanners and internal management sources."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Requires firewall or perimeter flow logs with per-flow UDP records including source/destination IP, port, and protocol. Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate DNS resolvers, NTP servers, SNMP monitoring infrastructure, LDAP directory servers, and multicast-enabled network devices will generate traffic on these ports. Authorised vulnerability scanners may probe these ports at volume."
    tuning_guidance = "Add authorised DNS/NTP/SNMP server source addresses to %global_allowed_scanners or %global_allowed_mgmt_sources. Add known internal management subnets to %global_allowed_mgmt_sources. Raise the port-match threshold or restrict to external destinations only if internal amplification services are common in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match UDP traffic to known amplification protocol ports
    $net.network.ip_protocol = "UDP"

    (
      $net.target.port = 53    or   // DNS
      $net.target.port = 123   or   // NTP
      $net.target.port = 1900  or   // SSDP/UPnP
      $net.target.port = 11211 or   // Memcached
      $net.target.port = 161   or   // SNMP
      $net.target.port = 389   or   // LDAP/CLDAP
      $net.target.port = 5353  or   // mDNS
      $net.target.port = 19    or   // CharGen
      $net.target.port = 17         // QOTD
    )

    // Traffic must be destined for an external (non-RFC1918) address
    // to represent outbound amplification or reflector-to-victim flows
    not $net.target.ip in %rfc1918_internal

    // Exclude authorised scanning infrastructure
    not $net.principal.ip in %global_allowed_scanners

    // Exclude authorised management sources (NTP servers, DNS resolvers, SNMP pollers)
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
