/*
  MITRE Technique : T1526 - Cloud Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:06:33.479810+00:00
  Reference       : https://attack.mitre.org/techniques/T1526
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1526_001_Cloud_Service_Discovery_IDP_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or broad enumeration of cloud directory resources (users, groups, applications, service principals, policies, roles) via identity provider audit logs. Adversaries who gain initial access frequently enumerate available cloud services and directory objects to understand the environment and identify targets for lateral movement or privilege escalation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1526"
    mitre_technique_name = "Cloud Service Discovery"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM USER_RESOURCE_ACCESS events. Entra ID, Okta, and similar IdPs emit directory read/list operations that map to this event type."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate IT automation, provisioning pipelines, HR sync jobs, and security tooling that enumerate directory objects. SIEM/SOAR connectors and approved MDM solutions may also trigger this rule."
    tuning_guidance = "Add known automation and service account identifiers to %global_allowed_service_accounts. Add approved security and admin tooling to %global_allowed_security_tools. Raise the threshold or narrow target.resource.resource_type patterns if the environment has heavy legitimate directory automation."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource types that represent cloud service/directory enumeration:
    // users, groups, applications, service principals, roles, policies, devices
    $cloud.target.resource.resource_type = /(?i)(user|group|application|serviceprincipal|approleassignment|directoryrole|policy|device|oauth2permissiongrant|subscription|tenant|domain)/

    // Read/list operations are the hallmark of enumeration - not write or delete
    $cloud.target.resource.attribute.labels.key = /(?i)(operation|action|activity)/
    $cloud.target.resource.attribute.labels.value = /(?i)(list|get|read|enumerate|search|query|find|discover)/

    // Must have an authenticated principal performing the action
    $cloud.principal.user.userid != ""

    // Exclude known service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved security tooling principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1526")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $enumerated_resource_types = array_distinct($cloud.target.resource.resource_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
