/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:21:29.166163+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_Network_Boundary_Bridging_Policy_Bypass {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network flows traversing a perimeter firewall on ports or protocols that are typically blocked by policy. An adversary who has compromised a boundary device (router, firewall) may reconfigure ACLs or routing to pass prohibited traffic across trust boundaries, enabling C2 or exfiltration. This rule fires on NETWORK_FLOW events where traffic is observed on high-risk non-standard ports from external sources reaching internal RFC-1918 space, which should not traverse the perimeter under normal policy."
    mitre_tactic    = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Requires perimeter firewall flow/session logs normalised to UDM NETWORK_FLOW, including principal.ip, target.ip, target.port, network.ip_protocol, and network.sent_bytes."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorised VPN concentrators, SD-WAN overlays, approved tunnelling solutions, and penetration testing engagements. Vulnerability scanners listed in %global_allowed_scanners may also trigger this rule."
    tuning_guidance = "Add approved management source IPs to %global_allowed_mgmt_sources. Add known scanner sources to %global_allowed_scanners. Adjust the port list or byte-volume threshold to match the organisation's permitted egress policy. Exclude known-good external domains via %global_allowed_domains."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Traffic must originate from outside RFC-1918 space (external source)
    not $net.principal.ip in %rfc1918_internal

    // Traffic must be destined for internal RFC-1918 space (crossing the boundary inbound)
    $net.target.ip in %rfc1918_internal

    // Exclude authorised management and scanning sources
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // Focus on high-risk ports commonly used for tunnelling, C2, or policy bypass:
    // 4444 (Meterpreter), 1080 (SOCKS), 8080/8443 (alt HTTP/S proxy),
    // 3128 (Squid proxy), 9050 (Tor SOCKS), 6667/6697 (IRC C2),
    // 4500 (IKE NAT-T - unexpected inbound), 1194 (OpenVPN unexpected inbound),
    // 1723 (PPTP), 500 (IKE unexpected inbound from untrusted source)
    $net.target.port in [
      4444, 1080, 8080, 8443, 3128, 9050,
      6667, 6697, 4500, 1194, 1723, 500,
      8888, 9001, 9030, 2222, 31337
    ]

    // Require meaningful data transfer to reduce noise from port scans
    $net.network.sent_bytes > 1024

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = "T1599"
    $primary_entity    = $net.target.ip
    $source_ip         = $net.principal.ip
    $destination_port  = $net.target.port
    $bytes_transferred = $net.network.sent_bytes

  condition:
    $net
}
