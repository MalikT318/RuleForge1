/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:09:41.143887+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Component_Firmware_Access_Tool_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects execution of processes associated with direct hardware/firmware access utilities that could be used to read or write component firmware on storage controllers, network adapters, or other peripheral devices. Adversaries abuse legitimate vendor firmware tools or low-level OS interfaces to implant persistent firmware-level code that survives OS reinstallation and evades host-based defenses."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Requires EDR process telemetry with command-line capture (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1). Parent-child process relationships and full command lines must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate firmware update utilities run by IT operations during scheduled maintenance windows. OEM diagnostic tools (e.g., drive health checks). Vendor-supplied firmware update packages executed by patch management systems. Security researchers running firmware analysis tooling."
    tuning_guidance = "Add authorised firmware update parent processes (e.g., patch management agents, OEM update services) to %global_allowed_admin_tools. Add service accounts used by OEM update services to %global_allowed_service_accounts. Scope suppression narrowly to specific hosts undergoing maintenance rather than broad exclusions."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target processes that interact with hardware/firmware at a low level:
    // - devcon / pnputil: device driver and firmware management
    // - diskpart: disk-level operations that can interact with drive firmware
    // - fwupd / fwupdmgr: Linux-origin but sometimes present via WSL or ported tools
    // - PowerShell with firmware-related namespaces
    // - wmic with firmware/disk queries
    // - StorageCraft / vendor CLI tools pattern: match on command-line content rather than binary name
    (
      $proc.target.process.file.full_path = /\\(devcon|pnputil)\.exe$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\\powershell\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /(?i)(Get-WmiObject|gwmi|Get-CimInstance)\s.*(Win32_DiskDrive|MSFT_Disk|StorageController|Win32_PnPEntity)/ nocase
          or
          $proc.target.process.command_line = /(?i)(firmware|UpdateFirmware|flash|FlashFirmware)/ nocase
        )
      )
      or
      (
        $proc.target.process.file.full_path = /\\(wmic|wbemtest)\.exe$/ nocase
        and
        $proc.target.process.command_line = /(?i)(diskdrive|storagecontroller|pnpentity|firmware)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\diskpart\.exe$/ nocase
        and
        $proc.target.process.command_line = /(?i)(script|\/s\s)/ nocase
      )
    )

    // Exclude known-good administrative and patch management tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing automated firmware updates
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $process_command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
