/*
  MITRE Technique : T1600.001 - Reduce Key Space
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:22:26.858066+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_001_Weak_Cipher_Negotiation_Detected {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network connections negotiating weak or export-grade cipher suites, short key lengths, or deprecated encryption protocols (e.g., SSLv2, SSLv3, TLS 1.0 with export ciphers) on perimeter devices. This pattern is consistent with T1600.001 where an adversary has reduced the key space on a compromised network device, causing it to negotiate weaker encryption than expected. Firewall and proxy logs that record TLS negotiation metadata or protocol anomalies are the primary signal."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1600.001"
    mitre_technique_name = "Weaken Encryption: Reduce Key Space"
    log_prerequisites = "Requires firewall or proxy logs that record TLS/SSL negotiation metadata, cipher suite names, or protocol version fields in UDM network events. Palo Alto, Fortinet, Check Point, Squid, and Zscaler all populate these fields after normalization."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy IoT devices or embedded systems that only support older TLS versions; internal test environments; vulnerability scanners probing cipher support; some older VPN clients."
    tuning_guidance = "Add known legacy device source IPs or scanner sources to %global_allowed_scanners. Add approved management sources to %global_allowed_mgmt_sources. Narrow the cipher regex to match only the weakest grades if the environment has many TLS 1.0 clients."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match weak, export-grade, null, or anonymous cipher suites recorded in
    // the TLS negotiation metadata. Chronicle normalizes cipher suite names
    // into network.tls.cipher or security_result.description depending on
    // the parser; we check both common UDM landing spots via the description
    // field which is reliably populated by most firewall parsers.
    (
      $net.security_result.description = /(?i)(export|null|anon|rc4|des(?!3)|md5|rc2|idea|seed|camellia_128|dhe_export|ecdhe_export|ssl_?v?2|ssl_?v?3|tls_?1_?0.*export|enc=none|auth=none|kx=none|kx=rsa\(512\)|kx=rsa\(1024\)|kx=dh\(512\)|kx=dh\(1024\))/
      or
      $net.network.tls.cipher = /(?i)(export|null|anon|rc4|des(?!3)|md5|rc2|idea|seed|camellia_128|dhe_export|ecdhe_export)/
      or
      $net.network.tls.version = /(?i)(ssl_?v?2|ssl_?v?3|tls_?1_?0)/
    )

    // Exclude traffic originating from approved vulnerability scanners
    // that legitimately probe weak cipher support.
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved management plane sources which may use legacy
    // protocols for out-of-band management of older devices.
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude purely internal traffic; focus on externally observable
    // cipher negotiation which is the adversary-relevant signal.
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1600.001")
    $primary_entity = array_distinct($net.principal.ip)
    $weak_cipher_detail = array_distinct($net.security_result.description)
    $tls_version = array_distinct($net.network.tls.version)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
