/*
  MITRE Technique : T1666 - Modify Cloud Resource Hierarchy
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:32:54.932146+00:00
  Reference       : https://attack.mitre.org/techniques/T1666
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1666_Cloud_Resource_Hierarchy_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of cloud resource hierarchy including organization/subscription changes, account transfers, or management group modifications that may be used to evade defenses or hijack resources."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1666"
    mitre_technique_name = "Modify Cloud Resource Hierarchy"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail, Azure Activity, GCP Audit)."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate organizational restructuring, subscription transfers during M&A activity, authorized cloud governance changes by platform teams."
    tuning_guidance = "Add authorized cloud governance service principals to %global_allowed_cloud_principals. Monitor for changes outside business hours or from unexpected geographic locations."

  events:
    (
      $cloud.metadata.event_type = "RESOURCE_CREATION" or
      $cloud.metadata.event_type = "RESOURCE_DELETION" or
      $cloud.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE" or
      $cloud.metadata.event_type = "SETTING_MODIFICATION"
    )
    (
      $cloud.target.resource.attribute.labels.key = /(?i)(organization|subscription|management.?group|account|tenant|hierarchy|parent|folder)/ or
      $cloud.target.resource.name = /(?i)(organization|subscription|management.?group|account|tenant|hierarchy|parent|folder)/ or
      $cloud.target.resource.resource_type = /(?i)(organization|subscription|management.?group|account|tenant|hierarchy|parent|folder)/
    )
    (
      $cloud.security_result.action_details = /(?i)(leaveorganization|createsubscription|transfersubscription|movesubscription|createmanagementgroup|deletemanagementgroup|updatemanagementgroup|detachpolicy|movefolder|createfolder|deletefolder|setparent|changeparent)/ or
      $cloud.target.resource.attribute.labels.value = /(?i)(leave|transfer|move|detach|hijack|migrate)/
    )
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1666")
    $primary_entity = array_distinct($cloud.principal.user.userid)

  condition:
    $cloud
}
