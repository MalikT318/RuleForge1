/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:10:00.924556+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_Bootkit_Raw_Disk_Or_ESP_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects bootkit installation attempts on Linux via raw disk writes to MBR/VBR (e.g. /dev/sda, /dev/nvme0) or file creation/modification within the EFI System Partition mount point. Adversaries with root access may overwrite the first 512 bytes of a block device or plant malicious EFI binaries to persist below the OS layer."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_MODIFICATION or FILE_CREATION. Auditd rules should watch /dev/sd*, /dev/nvme*, /dev/vd*, /boot/efi/, and /efi/ with -p wa."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate bootloader installers (grub-install, efibootmgr, shim updates), OS upgrade scripts writing to /boot/efi, disk imaging tools, and authorised backup agents."
    tuning_guidance = "Add known-good bootloader management processes (grub-install, efibootmgr, update-grub, dracut) to %global_allowed_backup_processes or %global_allowed_admin_tools and exclude them. Scope exclusions to expected maintenance windows where possible."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Raw block device writes (MBR/VBR) OR EFI System Partition writes
    (
      // Raw writes to block devices that contain the MBR/VBR
      $file.target.file.full_path = /^\/dev\/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|xvd[a-z]|mmcblk[0-9]+)$/ nocase

      or

      // Writes to EFI System Partition mount points
      $file.target.file.full_path = /^\/boot\/efi\// nocase

      or

      $file.target.file.full_path = /^\/efi\// nocase

      or

      // EFI binary drops anywhere under /boot
      $file.target.file.full_path = /^\/boot\/.*\.(efi|EFI)$/

      or

      // Writes to partition device nodes (e.g. /dev/sda1 used for VBR)
      $file.target.file.full_path = /^\/dev\/(sd[a-z][0-9]+|nvme[0-9]+n[0-9]+p[0-9]+|vd[a-z][0-9]+|mmcblk[0-9]+p[0-9]+)$/
    )

    // Must be executed by a process - exclude kernel threads with no process path
    $file.principal.process.file.full_path = /^\//

    // Exclude known-good administrative and backup tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known-good service accounts performing legitimate maintenance
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $target_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
