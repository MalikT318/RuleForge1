/*
  MITRE Technique : T1553.003 - SIP and Trust Provider Hijacking
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:11:09.230635+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Hijacking {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of registry keys that define Subject Interface Packages (SIPs) or trust providers used by WinVerifyTrust. Adversaries overwrite these keys to redirect signature validation to a malicious DLL, bypassing Authenticode checks and application control."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry producing REGISTRY_MODIFICATION or REGISTRY_CREATION events with target.registry.registry_key populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate security software, cryptographic library installers, or Windows updates that register new SIPs or trust providers. Rare in practice outside of software installation."
    tuning_guidance = "Scope exclusions to known-good installer parent processes via %global_allowed_admin_tools. Monitor for DLL paths outside of System32 as a higher-fidelity signal."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the canonical SIP and trust provider registry hives
    // SIP DLL registrations live under CryptSIPDll* keys
    // Trust providers live under Trust\Providers and CryptSIPDll
    $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Cryptography\\OID\\EncodingType\s*0\\CryptSIPDll/ nocase
    $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Cryptography\\Providers\\Trust\\/ nocase

    // Flag writes to the DLL value names that redirect validation logic
    $reg.target.registry.registry_value_name = /^(Dll|FuncName|InitializationFunction|CryptSIPDllVerifyIndirectData|CryptSIPDllGetSignedDataMsg|CryptSIPDllCreateIndirectData|CryptSIPDllIsMyFileType2?)$/ nocase

    // Exclude writes originating from approved administrative or security tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude the Windows installer and trusted system paths performing legitimate registration
    not $reg.principal.process.file.full_path = /\\Windows\\(System32|SysWOW64)\\msiexec\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\(System32|SysWOW64)\\regsvr32\.exe$/ nocase

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity    = array_distinct($reg.principal.hostname)
    $modified_key      = array_distinct($reg.target.registry.registry_key)
    $modified_value    = array_distinct($reg.target.registry.registry_value_name)
    $actor_process     = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
