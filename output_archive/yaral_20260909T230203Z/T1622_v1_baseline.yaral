/*
  MITRE Technique : T1622 - Debugger Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:28:43.981694+00:00
  Reference       : https://attack.mitre.org/techniques/T1622
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1622_Process_Debugger_Detection_Via_Proc_Status {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects process reading /proc/self/status to check TracerPID field, indicating debugger detection evasion technique commonly used by malware."
    mitre_tactic = "Defense Evasion, Discovery"
    mitre_technique = "T1622"
    mitre_technique_name = "Debugger Evasion"
    log_prerequisites = "Requires Linux EDR or auditd file access telemetry."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debugging tools, security software performing self-checks, development environments, application crash handlers."
    tuning_guidance = "Add known development tools and security agents to %global_allowed_security_tools. Monitor for processes reading /proc/self/status combined with subsequent suspicious behavior."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/proc\/self\/status$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\/usr\/bin\/(gdb|strace|ltrace|valgrind)/ nocase
    not $file.principal.process.file.full_path = /\/opt\/.*\/(monitoring|agent|edr)/ nocase

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1622")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
