/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:10:49.796610+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_Subvert_Trust_Controls_MOTW_Removal {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects attempts to subvert Windows trust controls by removing or suppressing the Mark-of-the-Web (Zone.Identifier) alternate data stream, disabling SmartScreen via registry modification, or using tools known to strip MOTW from downloaded files. Adversaries remove MOTW to prevent Windows from warning users about untrusted content and to bypass SmartScreen and Protected View controls."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1553"
    mitre_technique_name = "Subvert Trust Controls"
    log_prerequisites = "Requires EDR process telemetry or Sysmon with command-line logging enabled (Event ID 1). Registry modification events required for SmartScreen registry variant (Sysmon Event ID 13 or equivalent EDR telemetry)."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software deployment tools that unblock files in bulk (e.g., Chocolatey, Ansible, SCCM), developer workstations running Unblock-File as part of build pipelines, IT administrators legitimately managing SmartScreen policy via GPO."
    tuning_guidance = "Add known deployment and build automation parent processes to %global_allowed_admin_tools. Add authorised administrator accounts to %global_allowed_admin_users. Scope by hostname if noisy on developer endpoints."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Detect PowerShell Unblock-File (removes Zone.Identifier ADS)
    // or streams.exe / attrib usage to strip MOTW
    // or PowerShell directly deleting the Zone.Identifier ADS
    (
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /Unblock-File/ nocase
          or
          $proc.target.process.command_line = /Zone\.Identifier/ nocase
          or
          $proc.target.process.command_line = /Remove-Item.*:Zone\.Identifier/ nocase
        )
      )
      or
      (
        // cmd.exe or PowerShell deleting the ADS directly via del or Remove-Item
        $proc.target.process.file.full_path = /\\cmd\.exe$/ nocase
        and
        $proc.target.process.command_line = /Zone\.Identifier/ nocase
      )
      or
      (
        // streams.exe (Sysinternals) used to delete alternate data streams
        $proc.target.process.file.full_path = /\\streams\.exe$/ nocase
        and
        $proc.target.process.command_line = /(-|\/)(d|delete)/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1553")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
