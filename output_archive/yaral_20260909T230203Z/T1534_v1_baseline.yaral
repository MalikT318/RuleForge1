/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:07:37.213208+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_001_Internal_Spearphishing_Mail_Tool_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a compromised internal account using command-line mail transfer tools (sendmail, mail, mutt, msmtp, swaks, curl with SMTP) to send messages to internal recipients, a primary behavioral signal for internal spearphishing on Linux. Adversaries who have compromised a Linux account or system use these tools to distribute phishing lures or malicious attachments to other users within the same organization, leveraging the trusted sender identity to increase success rates."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalized to UDM PROCESS_LAUNCH. Auditd rules must capture execve syscalls. EDR must record command-line arguments."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate cron-driven notification scripts, monitoring alerting pipelines, application-generated mail (e.g., logwatch, fail2ban), authorized DevOps automation sending internal reports."
    tuning_guidance = "Add known-good automation parent processes (e.g., crond, logwatch, monitoring agents) to %global_allowed_script_hosts. Scope by principal.user.userid to exclude service accounts via %global_allowed_service_accounts. Consider narrowing on attachment flags (-a, --attach) or bulk recipient patterns if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match command-line mail transfer agents and SMTP-capable tools commonly
    // abused for internal spearphishing on Linux. Regex targets the binary
    // name at the end of any path to survive renaming into /tmp or /dev/shm.
    (
      $proc.target.process.file.full_path = /\/(sendmail|mail|mailx|mutt|msmtp|swaks|ssmtp|s-nail|nail)$/ nocase
      or
      // curl or wget invoked against an smtp:// or smtps:// scheme
      (
        $proc.target.process.file.full_path = /\/(curl|wget)$/ nocase
        and
        $proc.target.process.command_line = /smtps?:\/\// nocase
      )
      or
      // Python/Perl/Ruby one-liners invoking smtplib or Net::SMTP inline
      (
        $proc.target.process.file.full_path = /\/(python[23]?|perl|ruby)$/ nocase
        and
        $proc.target.process.command_line = /(?i)(smtplib|Net::SMTP|smtp\.sendmail|MIME::Lite)/
      )
    )

    // Require at least one recipient argument pattern: -t, -r, To:, or an
    // @-sign in the argument list indicating an email address target.
    $proc.target.process.command_line = /(?i)(\s-[trb]\s|\bTo:\s*\S+@\S+|\s\S+@\S+\.\S+)/

    // Exclude known-good automation parent processes and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude root-owned monitoring and alerting daemons that legitimately
    // send mail (crond, logwatch, fail2ban-server, alertmanager).
    not $proc.principal.process.file.full_path = /\/(crond?|logwatch|fail2ban-server|alertmanager|prometheus)$/

    // Flag executions originating from suspicious staging directories,
    // interactive shells, or web-server worker processes as higher-risk
    // parent contexts - captured for outcome scoring below.
    $proc.principal.process.file.full_path = $parent_path

  outcome:
    // Elevate score when the parent is a shell, web worker, or staging dir
    $risk_score = max(
      if(
        $parent_path = /(?i)\/(bash|sh|zsh|dash|ksh|python[23]?|perl|ruby|php|node)$/,
        85,
        if(
          $parent_path = /(?i)(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/)/,
          90,
          65
        )
      )
    )
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggered_user = array_distinct($proc.principal.user.userid)
    $mail_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($parent_path)

  condition:
    $proc
}
