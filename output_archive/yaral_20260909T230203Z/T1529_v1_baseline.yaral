/*
  MITRE Technique : T1529 - System Shutdown/Reboot
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:06:53.491462+00:00
  Reference       : https://attack.mitre.org/techniques/T1529
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1529_001_Linux_System_Shutdown_Reboot {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects execution of system shutdown or reboot commands on Linux hosts. Adversaries use shutdown, reboot, halt, poweroff, or systemctl with shutdown/reboot/halt/poweroff targets to disrupt access, destroy evidence, or impair incident response. This rule targets the direct process-launch signal for these OS-native commands."
    mitre_tactic    = "Impact"
    mitre_technique = "T1529"
    mitre_technique_name = "System Shutdown/Reboot"
    log_prerequisites = "Requires Linux EDR telemetry (e.g., Auditd execve syscall events, CrowdStrike Falcon, SentinelOne, or equivalent) normalised to UDM PROCESS_LAUNCH with target.process.file.full_path and target.process.command_line populated."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Scheduled maintenance windows, automated patch management reboots, configuration management tools (Ansible, Puppet, Chef), cloud-init lifecycle hooks, and authorised administrator activity."
    tuning_guidance = "Add known maintenance service accounts to %global_allowed_service_accounts. Add approved automation parent processes (e.g., ansible, puppet, chef-client) to %global_allowed_admin_tools. Consider narrowing scope to production or sensitive-tier hostnames if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the canonical shutdown/reboot/halt/poweroff binaries on Linux
    // Covers /sbin, /usr/sbin, /bin, /usr/bin locations
    $proc.target.process.file.full_path = /(?i)\/(s?bin|usr\/(s?bin))\/(shutdown|reboot|halt|poweroff|init)$/

    // Exclude systemctl used for non-shutdown purposes by requiring shutdown-related subcommands
    // Also catch systemctl poweroff/reboot/halt/shutdown
    // We use a broad OR-style regex across the binary name and command line
    // For init, only flag runlevel 0 (poweroff) or 6 (reboot)
    $proc.target.process.command_line = /(?i)(shutdown|reboot|halt|poweroff|poweroff|runlevel\s+[06]|\s+[06]\s*$|\-r\b|\-h\b|\-P\b|\-p\b|\-H\b|now\b|systemctl\s+(poweroff|reboot|halt|shutdown))/

    // Exclude known-good service and automation accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good admin tooling parent processes (e.g., patch managers, config mgmt)
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1529")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_user = array_distinct($proc.principal.user.userid)
    $triggering_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
