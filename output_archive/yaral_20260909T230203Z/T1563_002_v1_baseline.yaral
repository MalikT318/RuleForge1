/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:17:13.520853+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Session_Hijack_TSCon {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects RDP session hijacking via tscon.exe, the native Windows Terminal Services console utility. Adversaries with SYSTEM privileges invoke tscon.exe with a session ID to silently steal a disconnected or active RDP session without requiring credentials. The critical behavioral signal is tscon.exe being launched by a privileged parent (cmd, powershell, services.exe, or a service wrapper) rather than through a legitimate interactive RDS workflow."
    mitre_tactic         = "Lateral Movement"
    mitre_technique      = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites    = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH. Command-line capture must be enabled."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Legitimate RDS administrators using tscon.exe for session management; helpdesk tooling that programmatically reconnects sessions; some RMM agents that manage terminal sessions."
    tuning_guidance      = "Add authorised administrator accounts to %global_allowed_admin_users and approved parent processes to %global_allowed_admin_tools. Consider narrowing by requiring the /dest: flag to be absent (hijack without specifying destination console) or by correlating with a preceding privilege-escalation event."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be tscon.exe - the only native binary that can reassign RDP sessions
    $proc.target.process.file.full_path = /(?i)\\tscon\.exe$/

    // Must carry a numeric session ID argument - the core hijack mechanic.
    // Legitimate administrative use always specifies a session number.
    // Pattern: tscon.exe <digits> or tscon <digits> /dest:console
    $proc.target.process.command_line = /(?i)tscon(\.exe)?\s+[0-9]+/

    // High-risk parent processes: shells, service host, or task schedulers
    // used to run tscon with SYSTEM context
    $proc.principal.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|services|svchost|mmc|wscript|cscript|taskeng|taskhost|taskhostw)\.exe$/

    // Exclude approved admin tools and service accounts performing legitimate session management
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $actor_user        = array_distinct($proc.principal.user.userid)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $full_cmdline      = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
