/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:03:24.537410+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_VM_Sandbox_Environment_Checks {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes querying multiple registry keys, WMI classes, or command-line patterns commonly used by malware to fingerprint virtual machine or sandbox environments (CPUID, BIOS vendor, VM-specific hardware strings, hypervisor presence). A single process issuing several of these queries in one command line is a strong indicator of automated VM-evasion logic."
    mitre_tactic    = "Defense Evasion, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Hypervisor management agents (VMware Tools, VirtualBox Guest Additions), IT asset-inventory scripts, hardware-audit tooling, and some legitimate system-information utilities that query BIOS or hardware identifiers."
    tuning_guidance = "Add known-good parent processes (e.g., VMware Tools, VirtualBox service host) to %global_allowed_admin_tools. Add authorised inventory or audit service accounts to %global_allowed_service_accounts. Narrow the regex if specific WMI class names generate noise from approved tooling."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting hosts, WMI clients, and query utilities commonly
    // abused to perform VM/sandbox fingerprinting.
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wmic|wbemtest|cscript|wscript|mshta|cmd)\.exe$/ nocase

    // Match command lines that reference VM/hypervisor artefacts:
    // - WMI classes: Win32_ComputerSystem, Win32_BIOS, Win32_VideoController,
    //   Win32_BaseBoard, Win32_DiskDrive
    // - Known VM vendor strings: VMware, VirtualBox, VBOX, QEMU, Hyper-V,
    //   Xen, Parallels
    // - Registry paths used for VM detection: HKLM\SOFTWARE\VMware, VBOX,
    //   HARDWARE\ACPI\DSDT
    // - Hypervisor-presence flags: hypervisorpresent, cpuid, systeminfo
    $proc.target.process.command_line = /(?i)(Win32_ComputerSystem|Win32_BIOS|Win32_VideoController|Win32_BaseBoard|Win32_DiskDrive|Win32_PhysicalMemory)/ nocase

    $proc.target.process.command_line = /(?i)(vmware|virtualbox|vbox|qemu|hyper.?v|xen|parallels|bochs|innotek|virt|sandboxie|cuckoo|anubis|joebox|threatexpert)/ nocase

    // Exclude approved administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity    = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
