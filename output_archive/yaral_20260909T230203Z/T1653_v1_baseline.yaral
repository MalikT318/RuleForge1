/*
  MITRE Technique : T1653 - Power Settings
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:30:11.300293+00:00
  Reference       : https://attack.mitre.org/techniques/T1653
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1653_Power_Settings_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects abuse of powercfg.exe to disable sleep, hibernate, standby, or lock screen timeouts, which adversaries use to prevent infected machines from entering dormant states that would terminate malicious activity."
    mitre_tactic = "Persistence"
    mitre_technique = "T1653"
    mitre_technique_name = "Power Settings"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 capturing process launches with full command lines."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Kiosk configuration scripts, digital signage setup, IT deployment automation, gaming or media server configuration, and some RMM tools that tune power settings for managed endpoints."
    tuning_guidance = "Add known-good parent processes (deployment agents, RMM tools) to %global_allowed_admin_tools. Add authorised service accounts performing power configuration to %global_allowed_service_accounts. Consider narrowing to suspicious parent processes such as script interpreters if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)\\powercfg(\.exe)?$/
    (
      // Disable hibernate entirely
      $proc.target.process.command_line = /(?i)\/hibernate\s+(off|no)/ or
      // Set sleep/standby/hibernate/monitor/disk timeout to zero (never)
      $proc.target.process.command_line = /(?i)\/change\s+.{0,80}\s+0\b/ or
      // Set specific timeout sub-settings to zero via /setacvalueindex or /setdcvalueindex
      $proc.target.process.command_line = /(?i)\/(setacvalueindex|setdcvalueindex)\s+.{0,120}\s+0\b/ or
      // Disable lock screen / console lock timeout via powercfg scheme
      $proc.target.process.command_line = /(?i)\/x\s+.{0,80}\s+0\b/ or
      // Import a custom power scheme (could replace restrictive defaults)
      $proc.target.process.command_line = /(?i)\/import\s+/
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1653")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
