/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:23:54.432480+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_Config_Repository_Exfil_Via_SNMP_TFTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound connections on ports commonly used to exfiltrate network device configuration repositories (SNMP bulk reads on UDP/161, TFTP on UDP/69, and NETCONF on TCP/830). Adversaries abuse these management-plane protocols to harvest running configs, routing tables, and credentials from network devices at scale. A connection from an internal device to an external destination on these ports is a strong indicator of T1602 activity."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Requires firewall or perimeter flow logs with source/destination IP and port visibility. UDP/161 (SNMP), UDP/69 (TFTP), and TCP/830 (NETCONF) must not be blocked at the perimeter for this rule to fire on exfiltration attempts."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners polling SNMP from external management hosts; legitimate TFTP firmware transfers to/from vendor update servers; managed NETCONF sessions from approved orchestration platforms."
    tuning_guidance = "Add approved external management source IPs to %global_allowed_scanners and %global_allowed_mgmt_sources. Add known-good external orchestration domains to %global_allowed_domains. If SNMP polling is exclusively internal, alert on any external destination on UDP/161 regardless of source."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Traffic must be leaving the internal address space toward an external destination
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal

    // Target ports associated with configuration repository protocols:
    // UDP 69  = TFTP  (config file transfer)
    // UDP 161 = SNMP  (bulk MIB / config walk)
    // TCP 830 = NETCONF over SSH
    // TCP 161 = SNMP over TCP (less common but used by some platforms)
    (
      $net.target.port = 69   or
      $net.target.port = 161  or
      $net.target.port = 830
    )

    // Exclude authorised management sources and scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
