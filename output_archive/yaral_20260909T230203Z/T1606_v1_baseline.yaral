/*
  MITRE Technique : T1606 - Forge Web Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:24:42.549268+00:00
  Reference       : https://attack.mitre.org/techniques/T1606
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_Forge_Web_Credentials_Network_Observable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable indicators of forged web credential usage: repeated authentication attempts to web services from external sources using anomalous token or session patterns, or high-frequency access to authentication/token endpoints from a single external source. Forged credentials (SAML tokens, JWT, OAuth tokens) often produce distinctive access patterns against identity and federation endpoints."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606"
    mitre_technique_name = "Forge Web Credentials"
    log_prerequisites = "Requires firewall or proxy logs with HTTP metadata including URI path, response codes, and connection volume. Perimeter logs must capture destination URL or URI path fields."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Automated service accounts performing legitimate token refresh cycles, load testing tools, CI/CD pipelines authenticating to SaaS APIs, vulnerability scanners."
    tuning_guidance = "Add known automation source IPs or service account source ranges to %global_allowed_scanners or %global_allowed_service_accounts. Narrow the URI path regex to match only the identity providers in scope for each client. Raise the response-code filter to exclude expected 401s from password-spray detections."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Target authentication, token, federation, and SSO endpoints
    // that are the primary targets for forged credential submission
    $net.target.url = /\/(oauth|token|saml|sso|auth|federation|adfs|sts|login|signin|openid|connect|assertion|wsfed|jwt|session)(\/|$|\?)/  nocase

    // Focus on HTTP success responses - forged credentials that work
    // will return 200/302 rather than 401/403; filter for successful
    // authentications which are more suspicious than failures
    $net.network.http.response_code >= 200
    $net.network.http.response_code <= 302

    // Only examine inbound connections from external sources
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude known-good domains initiating federated auth flows
    not $net.principal.hostname in %global_allowed_domains

    // POST method is characteristic of credential/token submission
    $net.network.http.method = "POST"

    // Flag unusually large HTTP request bodies which may carry
    // forged SAML assertions or oversized JWT payloads
    $net.network.sent_bytes >= 2048

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1606")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_auth_url = array_distinct($net.target.url)
    $http_response_code = max($net.network.http.response_code)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
