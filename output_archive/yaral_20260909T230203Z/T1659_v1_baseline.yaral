/*
  MITRE Technique : T1659 - Content Injection
  Tactic(s)       : Initial Access, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:31:09.784455+00:00
  Reference       : https://attack.mitre.org/techniques/T1659
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1659_001_Content_Injection_Suspicious_HTTP_Response_Anomaly {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable indicators of content injection attacks at the perimeter. Adversaries performing man-in-the-middle or man-on-the-side attacks inject malicious content into legitimate HTTP/S traffic flows. This rule identifies anomalous HTTP responses and connection patterns consistent with injected content: unexpected redirects from non-CDN external destinations, suspicious response codes paired with large payload sizes on non-standard ports, and connections to external destinations that deviate from established traffic baselines. Targets firewall and proxy telemetry where injected responses would be visible as anomalous HTTP transactions."
    mitre_tactic    = "Initial Access, Command and Control"
    mitre_technique = "T1659"
    mitre_technique_name = "Content Injection"
    log_prerequisites = "Requires firewall or forward proxy logs with HTTP metadata including response codes, bytes transferred, destination IP, port, and URL or host fields normalised into UDM NETWORK_HTTP events."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate CDN redirects, software update services returning large payloads, load balancers issuing 302 redirects, captive portals on guest networks, misconfigured reverse proxies."
    tuning_guidance = "Add known-good external domains (CDNs, update services, SaaS vendors) to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Raise the bytes threshold if large legitimate downloads trigger the rule. Narrow the port list if your environment uses non-standard ports legitimately."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Exclude internal-to-internal traffic - content injection originates from external network paths
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal

    // Exclude known-good external destinations (CDNs, update services, approved SaaS)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanners that may generate anomalous HTTP patterns
    not $net.principal.ip in %global_allowed_scanners

    // Detect anomalous HTTP redirect responses from external destinations
    // Injected content frequently arrives as a 302/301 redirect racing the legitimate response,
    // or as a 200 OK with injected payload on a non-standard port
    (
      // Suspicious redirect from external host on non-standard port
      // Standard web ports (80, 443) are excluded to reduce noise; injection often uses
      // alternate ports to avoid inspection or to deliver secondary payloads
      (
        $net.network.http.response_code >= 300
        $net.network.http.response_code <= 399
        $net.target.port != 80
        $net.target.port != 443
      )
      or
      // Large payload delivered over non-standard port - consistent with injected tool transfer
      // following initial content injection (T1105 chained with T1659)
      (
        $net.network.received_bytes >= 500000
        $net.target.port != 80
        $net.target.port != 443
        $net.target.port != 8080
        $net.target.port != 8443
      )
      or
      // HTTP 200 response on port 80 with unusually large payload to an external destination
      // Man-on-the-side injection races a large fake response to the client
      (
        $net.network.http.response_code = 200
        $net.network.received_bytes >= 2000000
        $net.target.port = 80
      )
    )

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1659")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_host = array_distinct($net.target.hostname)
    $destination_port = array_distinct($net.target.port)
    $http_response_code = array_distinct($net.network.http.response_code)
    $bytes_received = max($net.network.received_bytes)

  condition:
    $net
}
