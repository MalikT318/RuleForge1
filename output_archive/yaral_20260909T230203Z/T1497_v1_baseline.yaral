/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:03:04.258050+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_Linux_Sandbox_VM_Enumeration {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects processes performing virtualization and sandbox environment discovery on Linux by reading hypervisor artifacts, DMI/SMBIOS tables, container runtime indicators, or VM-specific device nodes. Malware commonly enumerates these artifacts to detect analysis environments and alter behaviour accordingly."
    mitre_tactic    = "Discovery, Defense Evasion"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with command-line arguments captured (execve syscall auditing). Auditd rules should include -a always,exit -F arch=b64 -S execve."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "System inventory agents, configuration management tools (Ansible, Puppet, Chef), cloud-init, hardware discovery daemons (fwupd, dmidecode in provisioning pipelines), and security compliance scanners."
    tuning_guidance = "Add known inventory or configuration management parent processes to %global_allowed_admin_tools. Add authorised scanner source hosts to %global_allowed_scanners. Narrow by requiring an unusual parent process (e.g., shell spawned from a downloaded binary) if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target: processes that read hypervisor/VM/container detection artifacts
    // Group 1 - DMI/SMBIOS table readers (dmidecode, biosdecode)
    // Group 2 - cpuid-based hypervisor detection via system utilities
    // Group 3 - direct /proc and /sys virtual filesystem enumeration
    // Group 4 - container runtime detection (cgroup, .dockerenv, overlay mounts)
    // Group 5 - VM-specific device probing (vboxguest, vmware, virtio, kvm)
    (
      // DMI/SMBIOS enumeration - primary hypervisor fingerprint source
      $proc.target.process.file.full_path = /\/(s?bin|usr\/(s?bin|local\/(s?bin|bin)))\/dmidecode$/ nocase
      or
      $proc.target.process.file.full_path = /\/(s?bin|usr\/(s?bin|local\/(s?bin|bin)))\/biosdecode$/ nocase
      or
      // virt-what: explicit VM detection tool
      $proc.target.process.file.full_path = /\/(s?bin|usr\/(s?bin|local\/(s?bin|bin)))\/virt-what$/ nocase
      or
      // systemd-detect-virt: explicit virtualisation detection
      $proc.target.process.file.full_path = /\/(s?bin|usr\/(s?bin|local\/(s?bin|bin)))\/systemd-detect-virt$/ nocase
      or
      // Reading /proc/cpuinfo for hypervisor flag or vendor strings
      (
        $proc.target.process.file.full_path = /\/(usr\/)?bin\/(grep|awk|sed|cat|strings)$/ nocase
        and $proc.target.process.command_line = /\/proc\/cpuinfo/ nocase
        and (
          $proc.target.process.command_line = /hypervisor/ nocase
          or $proc.target.process.command_line = /vmware/    nocase
          or $proc.target.process.command_line = /virtualbox/ nocase
          or $proc.target.process.command_line = /kvm/       nocase
          or $proc.target.process.command_line = /xen/       nocase
          or $proc.target.process.command_line = /qemu/      nocase
        )
      )
      or
      // Reading /sys/class/dmi/id for vendor/product strings
      (
        $proc.target.process.file.full_path = /\/(usr\/)?bin\/(grep|awk|sed|cat|strings)$/ nocase
        and $proc.target.process.command_line = /\/sys\/class\/dmi\/id/ nocase
      )
      or
      // Probing VM-specific device nodes
      (
        $proc.target.process.file.full_path = /\/(usr\/)?bin\/(ls|stat|test|file|cat)$/ nocase
        and (
          $proc.target.process.command_line = /\/dev\/vboxguest/  nocase
          or $proc.target.process.command_line = /\/dev\/vmware/   nocase
          or $proc.target.process.command_line = /\/dev\/virtio/   nocase
          or $proc.target.process.command_line = /\/dev\/kvm/      nocase
          or $proc.target.process.command_line = /\/dev\/hvc0/     nocase
        )
      )
      or
      // Container escape / sandbox detection via cgroup inspection
      (
        $proc.target.process.file.full_path = /\/(usr\/)?bin\/(grep|cat|awk)$/ nocase
        and (
          $proc.target.process.command_line = /\/proc\/1\/cgroup/ nocase
          or $proc.target.process.command_line = /\/proc\/self\/cgroup/ nocase
          or $proc.target.process.command_line = /\.dockerenv/ nocase
          or $proc.target.process.command_line = /\/proc\/self\/mountinfo/ nocase
        )
      )
      or
      // lscpu / lshw querying hypervisor details
      (
        $proc.target.process.file.full_path = /\/(usr\/)?bin\/(lscpu|lshw)$/ nocase
        and (
          $proc.target.process.command_line = /hypervisor/ nocase
          or $proc.target.process.command_line = /virtualization/ nocase
        )
      )
    )

    // Exclude known-good administrative and inventory tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $detected_command  = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
