/*
  MITRE Technique : T1580 - Cloud Infrastructure Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:21:09.150134+00:00
  Reference       : https://attack.mitre.org/techniques/T1580
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1580_001_Cloud_Infrastructure_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects broad cloud infrastructure enumeration activity via read-only discovery API calls targeting compute instances, storage buckets, snapshots, databases, and related IaaS resources. Adversaries use these APIs to map available resources before lateral movement or data exfiltration. Fires on a burst of distinct discovery operations from a single principal within the detection window."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1580"
    mitre_technique_name = "Cloud Infrastructure Discovery"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). USER_RESOURCE_ACCESS events must include metadata.product_event_type or target.resource.resource_type populated by the Chronicle ingestion parser."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Cloud management platforms, infrastructure-as-code pipelines (Terraform, Pulumi), CSPM tools, authorised vulnerability scanners, and DevOps automation that routinely enumerate resources. Service accounts used by monitoring or orchestration systems will also trigger this rule."
    tuning_guidance = "Add known automation service account identifiers to %global_allowed_service_accounts. Add approved scanner source identities to %global_allowed_scanners. Add approved cloud management principals to %global_allowed_cloud_principals. Raise the threshold or narrow target.resource.resource_type if the environment has heavy IaC activity."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match discovery-oriented API verbs normalised into product_event_type.
    // Covers AWS (Describe*, List*, Get*, Head*), Azure (list, get, read),
    // and GCP (list, get, aggregatedList) patterns after UDM normalisation.
    $cloud.metadata.product_event_type = /(?i)(describe|list|get|head|aggregatedlist)[a-z]*(instance|bucket|snapshot|volume|disk|database|cluster|subnet|vpc|network|securitygroup|storageaccount|virtualmachine|container|registry|function|secret|key|blob|table|queue|topic|subscription|loadbalancer|autoscaling|image|ami|stack|resource)/

    // Scope to IaaS resource types where populated by the parser.
    // This is an OR-style broad match; parsers vary in how they populate this.
    $cloud.target.resource.resource_type = /(?i)(compute|storage|database|network|container|serverless|snapshot|volume|bucket|virtual_machine|instance|disk|registry|secret|key_vault|function)/

    // Exclude known-good automation identities.
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1580")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $resource_types    = array_distinct($cloud.target.resource.resource_type)
    $api_calls         = array_distinct($cloud.metadata.product_event_type)
    $source_ips        = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
