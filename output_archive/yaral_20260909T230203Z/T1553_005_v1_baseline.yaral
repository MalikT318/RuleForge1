/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:11:51.598500+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_MOTW_Bypass_Container_Mount_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of processes whose parent is a container-mounting or archive-extraction utility (ISO, VHD, IMG, ZIP, RAR, 7z, etc.). Files extracted or mounted from these containers do not inherit the Mark-of-the-Web Zone.Identifier ADS, bypassing SmartScreen and Office Protected View. Suspicious child processes (scripting engines, shells, Office apps, msiexec) launched directly from such parents are a strong indicator of MOTW bypass abuse."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires EDR process-launch telemetry with parent-child lineage (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1). Parent process path and child command line must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software distributed as ISO/VHD (e.g., Visual Studio, Windows ADK installers). Developers mounting disk images for testing. Authorized archive extraction by IT deployment tooling."
    tuning_guidance = "Add known-good parent process paths (e.g., deployment agents, software distribution tools) to %global_allowed_admin_tools. Scope by hostname or user group if broad software distribution causes noise. Consider requiring the child process to also match a high-risk binary before alerting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent is a container-mounting or archive-extraction utility
    // Covers: Windows Explorer mounting ISO/IMG/VHD via shell, 7-Zip, WinRAR, WinZip,
    // built-in Expand-Archive (powershell), msiexec extracting MSI containers,
    // and the Windows virtual disk service host
    $proc.principal.process.file.full_path = /(?i)(\\explorer\.exe|\\7z\.exe|\\7zG\.exe|\\7zFM\.exe|\\WinRAR\.exe|\\WinZip[0-9]*\.exe|\\WinZip[0-9]*M\.exe|\\peazip\.exe|\\bandizip\.exe|\\powershell\.exe|\\pwsh\.exe|\\vdsldr\.exe|\\vds\.exe|\\diskpart\.exe|\\isoburn\.exe)$/

    // Child process is a high-risk execution target - scripting engines, shells,
    // Office applications, loaders, or living-off-the-land binaries
    $proc.target.process.file.full_path = /(?i)(\\cmd\.exe|\\powershell\.exe|\\pwsh\.exe|\\wscript\.exe|\\cscript\.exe|\\mshta\.exe|\\rundll32\.exe|\\regsvr32\.exe|\\msiexec\.exe|\\certutil\.exe|\\bitsadmin\.exe|\\wmic\.exe|\\winword\.exe|\\excel\.exe|\\powerpnt\.exe|\\outlook\.exe|\\mspub\.exe|\\visio\.exe|\\msaccess\.exe|\\svchost\.exe|\\installutil\.exe|\\regasm\.exe|\\regsvcs\.exe|\\forfiles\.exe|\\pcalua\.exe|\\odbcconf\.exe|\\xwizard\.exe|\\appsyncpublishingserver\.exe)$/

    // Exclude known-good administrative and deployment tooling parents
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing automated software distribution
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
