/*
  MITRE Technique : T1668 - Exclusive Control
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:33:37.770817+00:00
  Reference       : https://attack.mitre.org/techniques/T1668
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1668_001_Exclusive_Control_Competitor_Eviction {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects behaviors consistent with T1668 Exclusive Control - an adversary attempting to evict competing threat actors or close access vectors after compromise. Signals include: removal of cron jobs or systemd units belonging to other processes, mass killing of processes via shell one-liners, stripping SUID/SGID bits from binaries, disabling or masking systemd services, and deletion of files from common malware staging directories (/tmp, /dev/shm, /var/tmp). These actions in isolation may be benign; in context they indicate an adversary locking down a compromised host."
    mitre_tactic    = "Persistence"
    mitre_technique = "T1668"
    mitre_technique_name = "Exclusive Control"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry normalised to UDM PROCESS_LAUNCH. Auditd rules should capture execve syscalls with full argv."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "System administrators running cleanup scripts, configuration management tools (Ansible, Puppet, Chef), container orchestration agents, and legitimate security hardening automation may trigger this rule."
    tuning_guidance = "Add known configuration management and admin tool paths to %global_allowed_admin_tools. Add authorised service accounts to %global_allowed_service_accounts. Consider narrowing to interactive sessions (non-service account principals) if noise is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the combination of commands and arguments that indicate
    // competitor eviction or access-vector closure. We target the
    // OS mechanisms directly rather than specific tool names.

    (
      // 1. Disabling or masking a systemd service to close a backdoor
      //    or remove a competing implant's persistence mechanism.
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/systemctl$/ nocase
        and
        (
          $proc.target.process.command_line = /\b(disable|mask|stop)\b/ nocase
        )
      )

      or

      // 2. Removing cron entries - wiping a competing actor's scheduled
      //    persistence from crontab or cron.d directories.
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/crontab$/ nocase
        and $proc.target.process.command_line = /\-r\b/ nocase
      )

      or

      // 3. Stripping SUID/SGID bits from binaries - hardening against
      //    privilege escalation paths a competing actor might use.
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/chmod$/ nocase
        and $proc.target.process.command_line = /\b(u-s|g-s|a-s|0[0-7]{3})\b/ nocase
        and $proc.target.process.command_line = /\/(bin|sbin|usr)/ nocase
      )

      or

      // 4. Bulk process termination via kill/pkill/killall targeting
      //    broad process groups - evicting competing malware processes.
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/(pkill|killall)$/ nocase
        and $proc.target.process.command_line = /\-9\b/ nocase
      )

      or

      // 5. Deletion of files from common malware staging directories
      //    using rm with recursive/force flags - removing competing
      //    implants or their drop zones.
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/rm$/ nocase
        and $proc.target.process.command_line = /\-[a-zA-Z]*f[a-zA-Z]*/ nocase
        and $proc.target.process.command_line = /\/(tmp|dev\/shm|var\/tmp)\// nocase
      )

      or

      // 6. Patching or replacing a binary in-place using dd or install
      //    targeting system paths - overwriting a vulnerable or
      //    competitor-modified binary.
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/(dd|install)$/ nocase
        and $proc.target.process.command_line = /\/(bin|sbin|usr\/bin|usr\/sbin|lib)\// nocase
      )

      or

      // 7. Removing SSH authorized_keys entries to lock out other actors
      //    who may have planted their own public keys.
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/(sed|awk|truncate)$/ nocase
        and $proc.target.process.command_line = /authorized_keys/ nocase
      )
    )

    // Exclude known-good administrative and automation tooling.
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1668")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $actor_userid      = array_distinct($proc.principal.user.userid)
    $command_executed  = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
