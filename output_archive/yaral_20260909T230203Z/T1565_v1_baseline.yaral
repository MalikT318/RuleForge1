/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:17:33.631091+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Critical_File_Manipulation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification or creation of critical Linux system files that adversaries commonly manipulate to alter system behaviour, hide activity, or influence business processes. Targets high-integrity paths including /etc/passwd, /etc/shadow, /etc/sudoers, /etc/crontab, cron directories, systemd unit files, PAM configuration, and shell profile files. Unexpected writes to these paths are a strong indicator of data manipulation for persistence, privilege escalation, or impact."
    mitre_tactic         = "Impact"
    mitre_technique      = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites    = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_MODIFICATION or FILE_CREATION events with target.file.full_path populated."
    platform             = "Linux"
    log_source           = "linux_endpoint"
    false_positives      = "Package managers (apt, yum, dnf, rpm) performing legitimate system updates; configuration management agents (Ansible, Puppet, Chef, Salt); authorised admin scripts; initial OS provisioning."
    tuning_guidance      = "Add known-good parent process paths (e.g. package manager binaries, CM agent paths) to %global_allowed_admin_tools. Add authorised service accounts that perform scheduled config updates to %global_allowed_service_accounts."

  events:
    $file.metadata.event_type in ["FILE_MODIFICATION", "FILE_CREATION"]

    // Target high-integrity Linux system paths that adversaries manipulate
    $file.target.file.full_path = /^\/etc\/(passwd|shadow|gshadow|group|sudoers|sudoers\.d\/.+|crontab|cron\.(d|daily|hourly|weekly|monthly)\/.+|pam\.d\/.+|ld\.so\.conf|ld\.so\.conf\.d\/.+|profile|profile\.d\/.+|bash\.bashrc|environment|hosts|hostname|resolv\.conf|nsswitch\.conf|ssh\/sshd_config|ssh\/authorized_keys)$/ nocase

    // Also catch systemd unit file manipulation and at-job directories
    $file.target.file.full_path = /^(\/etc\/systemd\/.+\.service|\/lib\/systemd\/.+\.service|\/usr\/lib\/systemd\/.+\.service|\/var\/spool\/cron\/.+|\/var\/spool\/at\/.+|\/root\/(\.bashrc|\.bash_profile|\.profile|\.ssh\/authorized_keys)|\/home\/[^\/]+\/(\.bashrc|\.bash_profile|\.profile|\.ssh\/authorized_keys))$/ nocase

    // Exclude known-good administrative tooling and service accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude package manager processes performing legitimate updates
    not $file.principal.process.file.full_path = /^\/(usr\/bin\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper|pacman)|bin\/(rpm|dpkg))/

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity    = array_distinct($file.principal.hostname)
    $modified_path     = array_distinct($file.target.file.full_path)
    $actor_process     = array_distinct($file.principal.process.file.full_path)
    $actor_user        = array_distinct($file.principal.user.userid)

  condition:
    $file
}
