/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:26:44.796333+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_Build_Image_On_Host {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects container image build operations executed directly on a host via the container runtime API or CLI. Adversaries use this technique to construct malicious images locally, bypassing registry-based defenses that inspect pulled images. Signals include invocation of container build tooling with Dockerfile-related arguments, or API-level resource creation events representing image build activity."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires container runtime process telemetry (e.g., Docker daemon audit logs, containerd events, or Kubernetes audit logs) normalised to Chronicle UDM PROCESS_LAUNCH or RESOURCE_CREATION events. The container runtime must emit child-process or API-call telemetry."
    platform        = "Containers"
    log_source      = "container"
    false_positives = "Legitimate CI/CD pipeline agents (Jenkins, GitLab Runner, Tekton, Buildkite) building images as part of automated workflows; developer workstations with Docker installed; image scanning or hardening tooling that rebuilds images in-place."
    tuning_guidance = "Add known CI/CD service account identifiers to %global_allowed_service_accounts and approved build host names to %global_allowed_admin_tools. Scope the rule to unexpected hosts or non-pipeline user accounts. Consider correlating with subsequent RESOURCE_CREATION (container deploy) events for higher fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match container build CLI invocations: docker build, buildah bud/build, kaniko executor, podman build
    $proc.target.process.file.full_path = /\/(docker|buildah|podman|executor)$/ nocase

    // The command line must reference a build sub-command or Dockerfile argument
    // Covers: docker build, buildah bud, buildah build, podman build, kaniko --dockerfile
    $proc.target.process.command_line = /(\bbuild\b|\bbud\b|--dockerfile\b|-f\s+[^\s]*[Dd]ockerfile)/ nocase

    // Exclude known-good CI/CD service accounts performing authorised builds
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved build tooling registered as admin tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $build_command     = array_distinct($proc.target.process.command_line)
    $initiating_user   = array_distinct($proc.principal.user.userid)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
