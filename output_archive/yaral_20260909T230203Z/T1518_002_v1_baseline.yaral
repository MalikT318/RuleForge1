/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:06:01.533502+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Linux_Backup_Software_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects process execution patterns consistent with backup software discovery on Linux. Adversaries enumerate installed backup agents, configurations, and service status to identify targets for data destruction, ransomware, or inhibiting system recovery. Signals include querying package managers, listing backup-related service units, or reading backup configuration directories."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1518.002"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events, including full command-line arguments."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "System administrators auditing backup configurations, configuration management tools (Ansible, Puppet, Chef), monitoring agents performing health checks, backup agents performing self-checks."
    tuning_guidance = "Add known automation and monitoring service account names to %global_allowed_service_accounts. Add approved admin hosts or parent processes to %global_allowed_admin_tools. Narrow scope by correlating with other discovery events on the same host."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match process names used for discovery: package managers, service queries, find, ls, cat, grep
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(dpkg|rpm|yum|dnf|apt|apt-cache|systemctl|service|find|ls|cat|grep|ps|which|locate)$/ nocase

    // Command line must reference backup-related software keywords
    $proc.target.process.command_line = /(?i)(veeam|acronis|bacula|amanda|backuppc|duplicati|restic|borg|rsnapshot|commvault|netbackup|arcserve|tsm|tivoli|deja.?dup|timeshift|clonezilla|rclone|duplicity|bareos|zmanda|backup.?ninja|s3cmd|awscli.*s3|gsutil)/ nocase

    // Exclude known-good service and automation accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved admin tooling parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggered_command = array_distinct($proc.target.process.command_line)
    $acting_user       = array_distinct($proc.principal.user.userid)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
