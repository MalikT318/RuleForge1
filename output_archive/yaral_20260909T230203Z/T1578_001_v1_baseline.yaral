/*
  MITRE Technique : T1578.001 - Create Snapshot
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:19:46.438156+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_001_Cloud_Snapshot_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of cloud compute snapshots (VM, disk, or volume) via cloud provider audit logs. Adversaries may create snapshots to bypass access restrictions on existing compute infrastructure, mount them to attacker-controlled instances, and exfiltrate data or escalate privileges without touching the original resource."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.001"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Snapshot"
    log_prerequisites = "Requires cloud provider audit logs ingested into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). The snapshot creation API call must be captured as a RESOURCE_CREATION event."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized backup and DR automation, scheduled snapshot policies, infrastructure-as-code pipelines, and approved admin operations. Service accounts performing routine backup jobs will trigger this rule."
    tuning_guidance = "Add known backup automation service accounts to %global_allowed_backup_processes and approved cloud service principals to %global_allowed_cloud_principals. Consider adding a threshold variant to suppress single isolated events from known-good accounts. Scope by target.resource.resource_type if the environment uses consistent resource tagging."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.target.resource.resource_subtype = /(?i)(snapshot|disk[\-_]?snapshot|volume[\-_]?snapshot|machine[\-_]?image|ami|backup[\-_]?image)/
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_backup_processes
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1578.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $snapshot_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
