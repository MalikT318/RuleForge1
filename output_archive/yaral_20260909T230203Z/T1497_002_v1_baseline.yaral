/*
  MITRE Technique : T1497.002 - User Activity Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:03:46.075717+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_002_User_Activity_Recon_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects processes performing user-activity reconnaissance characteristic of sandbox/VME evasion on Linux. Adversaries enumerate shell history files, browser profile directories, recently accessed files, or desktop/home directory contents to determine whether a real user is present before activating a payload. This rule fires when a non-interactive, non-shell process reads or lists these artefacts in a single launch event."
    mitre_tactic    = "Defense Evasion, Discovery"
    mitre_technique = "T1497.002"
    mitre_technique_name = "Virtualization/Sandbox Evasion: User Activity Based Checks"
    log_prerequisites = "Requires Linux EDR or auditd process-launch telemetry normalised to UDM PROCESS_LAUNCH, including full command-line arguments."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Backup agents, dotfile managers, shell configuration scripts, IT inventory tools, and legitimate shell scripts that inspect home directories. Security scanners may also trigger this rule."
    tuning_guidance = "Add known backup or inventory parent process paths to %global_allowed_backup_processes. Add approved scanner sources to %global_allowed_scanners. Narrow the rule by requiring the parent process to be a non-interactive daemon (e.g. exclude bash/sh parents) if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be a scripting interpreter or common recon binary
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|node|find|ls|stat|wc|du|cat|head|tail|awk|grep|xargs)$/ nocase

    // Command line must reference user-activity artefacts:
    // shell history, browser profiles, recently-used files, desktop/home contents,
    // or .local/share (XDG recent documents)
    (
      $proc.target.process.command_line = /\/\.bash_history/ nocase
      or
      $proc.target.process.command_line = /\/\.zsh_history/ nocase
      or
      $proc.target.process.command_line = /\/\.sh_history/ nocase
      or
      $proc.target.process.command_line = /\/\.local\/share\/recently-used/ nocase
      or
      $proc.target.process.command_line = /\/\.config\/(google-chrome|chromium|firefox|mozilla)/ nocase
      or
      $proc.target.process.command_line = /\/\.mozilla\/firefox/ nocase
      or
      $proc.target.process.command_line = /\/Desktop\// nocase
      or
      $proc.target.process.command_line = /\/Downloads\// nocase
      or
      $proc.target.process.command_line = /\/\.recently-used/ nocase
      or
      $proc.target.process.command_line = /\/\.thumbnails/ nocase
      or
      $proc.target.process.command_line = /\/\.cache\/thumbnails/ nocase
    )

    // Exclude known-good parent processes (backup, security, admin tooling)
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude interactive login shells as parents - legitimate user sessions
    // are expected to read their own history; suspicious when parent is a daemon
    not $proc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh)$/ nocase

    // Exclude root-owned system maintenance processes running from standard paths
    not $proc.principal.process.file.full_path = /\/(cron|anacron|systemd|init|run-parts)$/ nocase

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1497.002")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
