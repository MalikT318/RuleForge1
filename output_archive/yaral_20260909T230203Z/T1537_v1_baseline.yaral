/*
  MITRE Technique : T1537 - Transfer Data to Cloud Account
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:08:14.007852+00:00
  Reference       : https://attack.mitre.org/techniques/T1537
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1537_001_Cloud_Data_Transfer_External_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud audit events indicating data transfer, sharing, or backup operations targeting an external or adversary-controlled cloud account. Covers API-level actions such as cross-account snapshot copies, SAS URI generation, anonymous share link creation, and bucket/storage replication to external destinations. These are primary behavioral signals for T1537 - Transfer Data to Cloud Account."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1537"
    mitre_technique_name = "Transfer Data to Cloud Account"
    log_prerequisites = "Requires cloud provider audit logs (e.g., AWS CloudTrail, Azure Activity Log, GCP Audit Log) normalised into Chronicle UDM. Must capture storage, snapshot, and sharing API calls."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized cross-account backup jobs, disaster recovery replication, approved data migration projects, legitimate SAS URI generation by storage administrators."
    tuning_guidance = "Add approved service principals and automation accounts to %global_allowed_service_accounts. Add approved cloud admin users to %global_allowed_admin_users. Add approved cloud principals performing replication to %global_allowed_cloud_principals. Narrow the operation regex to the specific cloud provider verbs observed in your environment."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match cloud API operations associated with cross-account data transfer:
    // snapshot copy, replication, SAS/presigned URL generation, share link creation,
    // backup export, object copy to external bucket, or storage account replication.
    $cloud.target.resource.name = /(?i)(copy|replicate|export|backup|snapshot|share|sas|presigned|sync|transfer|clone|restore|put.?replication|create.?snapshot|create.?image|modify.?snapshot.?attribute|share.?object|generate.?shared.?access|create.?shared.?link|anonymous)/

    // The destination or target resource attribute should reference an external
    // account, tenant, or principal - not the same account as the actor.
    // We detect this by requiring the target resource attribute to differ from
    // the principal's cloud account/project, or to contain an external account indicator.
    $cloud.target.resource.attribute.labels.key = "destination_account"

    // Exclude known-good service accounts performing authorized replication.
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1537")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_hostname = array_distinct($cloud.principal.hostname)
    $target_ip = array_distinct($cloud.target.ip)

  condition:
    $cloud
}
