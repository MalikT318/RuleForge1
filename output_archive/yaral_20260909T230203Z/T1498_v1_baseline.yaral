/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:04:24.436354+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_Network_DoS_High_Volume_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential Network Denial of Service activity originating from IaaS-hosted resources by identifying abnormally high outbound byte volumes or connection counts in a single flow record. Adversaries may leverage cloud compute instances as amplification or botnet nodes to exhaust target bandwidth. This rule targets the network-observable behaviour: extreme data volume or packet counts toward external destinations."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Requires firewall or perimeter flow logs with bytes_sent, packets_sent, or connection metadata normalised into UDM NETWORK_FLOW events. VPC flow logs (AWS, GCP, Azure NSG) forwarded to Chronicle satisfy this requirement."
    platform = "IaaS"
    log_source = "firewall"
    false_positives = "Legitimate large data transfers such as backup jobs, CDN origin pulls, media streaming egress, or bulk data exports. Authorised load testing or performance benchmarking. Vulnerability scanners listed in %global_allowed_scanners."
    tuning_guidance = "Raise the network.sent_bytes threshold to reduce noise from high-throughput legitimate workloads. Add known backup or replication source IPs to %global_allowed_backup_processes reference list. Add authorised scanner sources to %global_allowed_scanners. Exclude internal-to-internal traffic by verifying target.ip is not in %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Source must be an internal (cloud-hosted) address - traffic egressing from IaaS
    $net.principal.ip = /./
    not $net.principal.ip in %rfc1918_internal

    // Destination must be external - not internal RFC1918 space
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external destinations such as CDN or update services
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanners and security tooling generating high-volume traffic
    not $net.principal.ip in %global_allowed_scanners

    // Core signal: extremely high outbound byte volume in a single flow record
    // Threshold of 500 MB per flow is indicative of flood-class traffic
    $net.network.sent_bytes > 524288000

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
