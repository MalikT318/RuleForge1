/*
  MITRE Technique : T1569 - System Services
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:18:47.337836+00:00
  Reference       : https://attack.mitre.org/techniques/T1569
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_Linux_System_Service_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects abuse of Linux system service mechanisms to execute commands or programs. Covers direct invocation of systemctl/service to start or enable units, as well as systemd-run for transient unit execution - the primary OS mechanisms adversaries use under T1569 on Linux."
    mitre_tactic    = "Execution"
    mitre_technique = "T1569"
    mitre_technique_name = "System Services"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry normalised to UDM PROCESS_LAUNCH events, capturing command_line and parent process fields."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate administrators starting or enabling services via systemctl/service; configuration management tools (Ansible, Puppet, Chef); package post-install scripts; monitoring agents restarting daemons."
    tuning_guidance = "Populate %global_allowed_admin_tools with paths of approved configuration management and deployment agents. Populate %global_allowed_service_accounts with automation accounts expected to invoke systemctl. Narrow the command_line regex if specific service names used by attackers are known."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be a Linux service management binary
    $proc.target.process.file.full_path = /\/(systemctl|systemd-run|service)$/ nocase

    // Match execution patterns that run or enable a unit/service
    // systemctl: start|restart|enable|daemon-reload with a unit argument
    // service: <name> start|restart
    // systemd-run: transient unit execution (always suspicious outside automation)
    (
      $proc.target.process.command_line = /systemctl\s+(start|restart|enable|daemon-reload|link)/ nocase
      or
      $proc.target.process.command_line = /service\s+\S+\s+(start|restart)/ nocase
      or
      $proc.target.process.file.full_path = /\/systemd-run$/
    )

    // Suspicious parent processes: shells, interpreters, or unknown parents
    // Legitimate service management typically originates from init, package managers, or known admin tools
    $proc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|php|node|curl|wget|nc|ncat|socat|awk|lua)$/

    // Exclude known approved administrative tooling and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1569")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
