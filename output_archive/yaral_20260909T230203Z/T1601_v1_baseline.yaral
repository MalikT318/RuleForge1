/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:23:00.518778+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Network_Device_Image_Transfer_Detected {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects large or protocol-specific file transfers to/from network devices that are consistent with firmware or OS image replacement. Adversaries targeting T1601 typically transfer a modified monolithic OS image via TFTP, FTP, SCP, or HTTP to overwrite the device image in storage or memory. This rule fires on outbound or inbound connections using those protocols from non-approved management sources, which is the network-observable signal of an image push or pull."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Requires firewall or perimeter flow logs with protocol/port visibility and byte counts. Ensure NETWORK_FLOW or NETWORK_CONNECTION events are ingested with network.application_protocol or target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized firmware upgrade windows initiated by network operations teams, automated backup jobs pulling device images to a management server, vulnerability scanner probes against management ports."
    tuning_guidance = "Add approved management source IPs or subnets to %global_allowed_mgmt_sources. Add authorized scanner sources to %global_allowed_scanners. Schedule-based suppression during approved maintenance windows should be applied in the SOAR playbook triggered by this alert."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target ports associated with firmware/image transfer protocols:
    // 69 = TFTP, 21 = FTP control, 20 = FTP data, 22 = SCP/SFTP, 80 = HTTP, 443 = HTTPS
    (
      $net.target.port = 69 or
      $net.target.port = 21 or
      $net.target.port = 20 or
      $net.target.port = 22 or
      $net.target.port = 80 or
      $net.target.port = 443
    )

    // Exclude connections originating from approved management plane sources.
    // Legitimate firmware upgrades should always come from known management hosts.
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude authorized scanners that probe management ports
    not $net.principal.ip in %global_allowed_scanners

    // Exclude purely internal RFC1918 management traffic that is already
    // covered by the management source allowlist above; this catches any
    // internal address not yet added to the allowlist.
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
