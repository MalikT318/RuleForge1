/*
  MITRE Technique : T1648 - Serverless Execution
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:29:00.181968+00:00
  Reference       : https://attack.mitre.org/techniques/T1648
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1648_001_Serverless_Function_Creation_Or_Update {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or update of serverless automation functions (e.g. Power Automate flows, Logic Apps, or equivalent SaaS automation resources) via M365 unified audit logs. Adversaries abuse serverless execution to run arbitrary code, escalate privileges, or establish persistence within cloud environments without managing underlying infrastructure."
    mitre_tactic = "Execution"
    mitre_technique = "T1648"
    mitre_technique_name = "Serverless Execution"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log (UAL) ingested into Chronicle. Relevant workloads: MicrosoftFlow, PowerApps, AzureActiveDirectory, or equivalent SaaS automation audit events normalised to UDM."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate business automation developers creating or updating approved flows and logic apps. IT administrators deploying sanctioned integrations. Low-code/no-code platform users building approved workflows."
    tuning_guidance = "Add known automation developer accounts to %global_allowed_service_accounts. Add approved automation management hosts or principals to %global_allowed_admin_users. Consider narrowing on target.resource.type or target.resource.name patterns that match your tenant's naming conventions for approved flows."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"

    // Target a serverless or automation resource type - flows, functions, logic apps
    $cloud.target.resource.name = /(?i)(flow|logic.?app|function|automation|trigger|connector|webhook|runbook|playbook)/

    // The operation must be a create or update action
    $cloud.metadata.product_event_type = /(?i)(create|update|modify|deploy|publish|enable|set|write|upsert)/

    // Exclude known service and automation accounts performing expected operations
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known admin users performing approved automation management
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Exclude known cloud principals (service principals, managed identities)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1648")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_name = array_distinct($cloud.target.resource.name)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
