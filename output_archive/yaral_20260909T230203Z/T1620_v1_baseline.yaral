/*
  MITRE Technique : T1620 - Reflective Code Loading
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:28:31.831923+00:00
  Reference       : https://attack.mitre.org/techniques/T1620
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1620_001_Reflective_Code_Loading_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects indicators of reflective code loading on Linux by identifying processes that execute payloads from memory-backed anonymous or volatile paths such as /dev/shm, /proc/self/fd, /tmp, and memfd-style file descriptors. Adversaries use these mechanisms to load and execute ELF binaries or shellcode entirely in RAM, leaving no persistent file on disk."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1620"
    mitre_technique_name = "Reflective Code Loading"
    log_prerequisites = "Requires Linux EDR or auditd telemetry producing PROCESS_LAUNCH events with command_line and file path fields populated. auditd execve syscall rules or EDR process telemetry recommended."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Container runtimes (runc, containerd) staging payloads in /dev/shm; JVM and .NET runtimes using anonymous memory mappings; legitimate use of memfd_create by monitoring agents; some backup and deployment tools staging in /tmp."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools or %global_allowed_security_tools. Narrow scope by excluding specific container orchestration parent processes. Consider raising severity if the parent is an interpreter (python, perl, ruby, bash)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Execution originating from volatile, anonymous, or RAM-backed paths
    // that are characteristic of reflective/fileless loading on Linux
    (
      // Execution directly from shared memory segment
      $proc.target.process.file.full_path = /^\/dev\/shm\// nocase
      or
      // Execution via proc self file descriptor (memfd_create pattern)
      $proc.target.process.file.full_path = /^\/proc\/self\/fd\// nocase
      or
      // Execution via another process's file descriptor (cross-process memfd)
      $proc.target.process.file.full_path = /^\/proc\/[0-9]+\/fd\// nocase
      or
      // Command line references memfd or anonymous execution patterns
      $proc.target.process.command_line = /memfd/ nocase
      or
      // Interpreter loading a payload piped from stdin or /dev/stdin (fileless)
      $proc.target.process.command_line = /\/dev\/stdin/ nocase
      or
      // Python/perl/ruby executing base64-decoded or inline payloads from /dev/shm or /tmp
      $proc.target.process.command_line = /\/dev\/shm\// nocase
      or
      // Execution of a file under /run/user or /run/shm (tmpfs-backed)
      $proc.target.process.file.full_path = /^\/run\/(shm|user)\/[^\/]+$/ nocase
    )

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1620")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggered_process = array_distinct($proc.target.process.file.full_path)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
