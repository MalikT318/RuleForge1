/*
  MITRE Technique : T1538 - Cloud Service Dashboard
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:08:28.259909+00:00
  Reference       : https://attack.mitre.org/techniques/T1538
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1538_Office_Suite_Dashboard_Access_From_Anomalous_Location {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects access to Office 365 admin portal or dashboard from a geographic location not previously seen for the user, indicating potential credential compromise and reconnaissance activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1538"
    mitre_technique_name = "Cloud Service Dashboard"
    log_prerequisites = "Requires Microsoft 365 unified audit logs with sign-in and admin portal access events."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate administrator travel, VPN usage, remote work from new locations, newly onboarded administrators."
    tuning_guidance = "Add known service accounts to %global_allowed_service_accounts. Exclude expected admin users accessing dashboards from %global_allowed_admin_users. Monitor for repeated access from the same anomalous location to reduce false positives."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.application = /(?i)(exchange\s*admin|security\s*&\s*compliance|microsoft\s*365\s*admin|azure\s*active\s*directory|admin\.microsoft\.com|admin\.exchange\.com|protection\.office\.com|compliance\.microsoft\.com|portal\.azure\.com)/
    $access.metadata.product_event_type = /(?i)(userloggedin|adminloggedin|azureactivedirectorysigninevent|officeactivity)/
    $access.security_result.summary = /(?i)(success|succeeded)/
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    $access.principal.location.country_or_region != ""

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1538")
    $primary_entity = array_distinct($access.principal.user.userid)
    $accessed_dashboard = array_distinct($access.target.application)
    $source_country = array_distinct($access.principal.location.country_or_region)
    $source_ip = array_distinct($access.principal.ip)

  condition:
    $access
}
