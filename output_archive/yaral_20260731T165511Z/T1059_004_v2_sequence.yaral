/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:04:38.001873+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_Shell_Spawns_Outbound_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Unix shell process (bash, sh, zsh, ash, dash, ksh, csh, tcsh, or busybox) that spawns a child process which subsequently establishes an outbound network connection. This pattern is indicative of interactive C2 shells, reverse shells, or shell scripts downloading and executing payloads. Complements existing T1059.004 command-line rules by correlating process lineage with network behaviour rather than inspecting command content."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires EDR or auditd telemetry providing PROCESS_LAUNCH events with parent/child process paths, and NETWORK_CONNECTION events with the initiating process path. Sysmon for Linux, Falco, or CrowdStrike Falcon satisfy this requirement."
    platform = "Linux, macOS, ESXi"
    false_positives = "Package managers (apt, yum, dnf, brew) invoked from shell scripts making legitimate update connections; CI/CD pipeline agents; monitoring agents launched via shell wrappers; developer toolchains fetching dependencies."
    tuning_guidance = "Add known-good child process paths to %global_allowed_shell_children (e.g. package manager binaries, monitoring agent paths). Add known-good destination CIDRs or IPs to %rfc1918_internal. Add authorised CI/CD hostnames to %global_allowed_cicd_hosts."

  events:
    // Event 1: A Unix shell spawns a child process (non-shell, non-trivial utility)
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(bash|sh|zsh|ash|dash|ksh|csh|tcsh|busybox)$/ nocase
    // Exclude the shell simply spawning another shell (handled by existing rules)
    not $proc.target.process.file.full_path = /\/(bash|sh|zsh|ash|dash|ksh|csh|tcsh|busybox)$/ nocase
    // Exclude known-safe child processes to reduce Cartesian join surface
    not $proc.target.process.file.full_path in %global_allowed_shell_children
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $child_path

    // Event 2: That same child process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $child_path
    not $net.target.ip in %rfc1918_internal
    // Exclude loopback - Chronicle represents as string match on ip field
    not $net.target.ip = "127.0.0.1"
    not $net.target.ip = "::1"
    not $net.principal.hostname in %global_allowed_cicd_hosts
    $net.principal.hostname = $hostname

    // Chronological ordering: shell spawns child before child connects out
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $child_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $parent_shell = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $proc and $net
}
