/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:57:39.196636+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_Process_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious process handle acquisition targeting GUI/graphical processes that are commonly abused for Extra Window Memory (EWM) injection. Attackers open a handle to a target process hosting a registered window class, write shellcode into a shared section, update the EWM pointer via SetWindowLong/SetWindowLongPtr, and redirect execution. This rule pivots on the PROCESS_OPEN telemetry layer rather than command-line arguments, providing additive coverage orthogonal to process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires EDR telemetry that records process handle open events (e.g., Sysmon Event ID 10 / CrowdStrike process open telemetry). The access rights bitmask must be populated in the UDM field target.process.access_mask or an equivalent mapped field. Sysmon must be configured with ProcessAccess rules targeting GUI host processes."
    platform = "Windows"
    false_positives = "Legitimate accessibility tools (e.g., screen readers, magnifiers), remote desktop agents, UI automation frameworks (e.g., Selenium, WinAppDriver), debugging tools (WinDbg, x64dbg), and some AV/EDR self-protection handles. Correlate with parent process lineage and time-of-day before escalating."
    tuning_guidance = "Add known-good automation or accessibility tool paths to %global_allowed_process_openers. Narrow scope by requiring the opening process to originate outside %global_allowed_admin_tool_paths. Consider pairing with a subsequent REGISTRY_MODIFICATION or NETWORK_CONNECTION rule for higher-fidelity sequencing."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be a GUI host process commonly registered with window classes
    // and therefore carrying EWM. Regex covers the canonical targets without
    // hardcoding a single binary name, surviving attacker renaming of injector.
    $open.target.process.file.full_path = /\\(explorer|dwm|winlogon|csrss|lsass|svchost|RuntimeBroker|ShellExperienceHost|SearchHost|StartMenuExperienceHost|sihost|taskhostw|ctfmon|dllhost)\.exe$/ nocase

    // Opening process must NOT be a known-good system parent.
    // Legitimate OS components opening handles to these processes use
    // well-known, stable paths; suspicious openers typically live in
    // user-writable or temp directories.
    $open.principal.process.file.full_path = /\\(users|appdata|temp|tmp|programdata|public)/i nocase

    // Exclude known-good opener paths supplied via reference list.
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Exclude known-good admin tool paths (RMM agents, AV, EDR self-handles).
    not $open.principal.process.file.full_path in %global_allowed_admin_tool_paths

    // The opening process must not itself be a recognised system binary
    // (prevents noisy OS-internal handle traffic from firing).
    not $open.principal.process.file.full_path = /\\(svchost|services|wininit|smss|lsass|csrss|winlogon|explorer|MsMpEng|SenseIR|SenseCncProxy)\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $target_pid = array_distinct($open.target.process.pid)

  condition:
    $open
}
