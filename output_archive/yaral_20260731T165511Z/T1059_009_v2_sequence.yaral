/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:07:44.068918+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_CloudAPI_Exec_After_Anomalous_Auth {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud API execution event (resource creation or modification via a cloud management plane) occurring shortly after an anomalous or first-seen authentication event for the same user principal. This targets adversaries who obtain credentials and immediately invoke cloud APIs to execute malicious actions, covering CLI, SDK, and browser-based Cloud Shell vectors without relying on process command-line matching."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires cloud identity provider authentication logs (e.g., Azure AD / Entra ID Sign-In logs, AWS CloudTrail ConsoleLogin, GCP Cloud Audit Logs) and cloud resource/management-plane audit logs (e.g., Azure Activity Log, AWS CloudTrail management events, GCP Admin Activity) ingested into Chronicle UDM. Both must populate principal.user.userid."
    platform = "IaaS, Identity Provider, Office Suite, SaaS"
    false_positives = "Legitimate administrators authenticating from new locations and immediately provisioning resources. Automated service accounts performing scheduled deployments. CI/CD pipeline service principals. Break-glass account usage during incidents."
    tuning_guidance = "Add known automation service account userids to %global_allowed_cloud_automation_accounts. Add approved CI/CD principal userids to the same list. Consider narrowing $cloud_exec event filtering to high-impact API categories (compute, IAM, networking) by adjusting the target.resource.resource_type filter. Raise severity threshold for accounts in %global_privileged_cloud_accounts."

  events:
    // Leg 1: A cloud user login event - pre-filter to cloud/SaaS auth only
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    // Exclude known automation and service accounts
    not $auth.principal.user.userid in %global_allowed_cloud_automation_accounts
    // Bind the user as the join key
    $auth.principal.user.userid = $userid

    // Leg 2: A cloud resource creation or update (management-plane API call)
    // occurring after the auth event on the same user identity
    $cloud_exec.metadata.event_type = "RESOURCE_CREATION"
    $cloud_exec.principal.user.userid != ""
    not $cloud_exec.principal.user.userid in %global_allowed_cloud_automation_accounts
    // Target resource-level API actions - exclude trivial read-only resource types
    $cloud_exec.target.resource.resource_type != ""
    // Exclude known-safe resource types (e.g., pure read/list operations surfaced as resource events)
    not $cloud_exec.target.resource.resource_type in %global_allowed_readonly_resource_types
    // Join on the same user
    $cloud_exec.principal.user.userid = $userid

    // Chronological ordering: auth must precede the API execution
    $auth.metadata.event_timestamp.seconds <= $cloud_exec.metadata.event_timestamp.seconds

  match:
    $userid over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($userid)
    $auth_event_count = count($auth.metadata.id)
    $api_actions_taken = array_distinct($cloud_exec.target.resource.name)
    $api_resource_types = array_distinct($cloud_exec.target.resource.resource_type)
    $auth_source_ip = array_distinct($auth.principal.ip)
    $cloud_exec_source_ip = array_distinct($cloud_exec.principal.ip)

  condition:
    $auth and $cloud_exec
}
