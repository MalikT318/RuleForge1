/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:56:36.226654+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injection_Process_Opens_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-debugger process opening another running process (PROCESS_OPEN, consistent with ptrace attach) followed by an outbound network connection from the same host within 5 minutes. This two-stage pattern is characteristic of ptrace-based code injection where the injector attaches to a victim process and then establishes C2 connectivity. Complements the existing PROCESS_LAUNCH / command-line rule for T1055.008."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events on ptrace(PTRACE_ATTACH) calls (e.g., Falco with syscall rules, Sysdig, or a Chronicle-integrated Linux EDR). Also requires NETWORK_CONNECTION events from the same agent."
    platform = "Linux"
    false_positives = "Legitimate debuggers (gdb, lldb, strace, ltrace), performance profilers (perf, valgrind), Java/Python runtimes that self-attach, container runtimes performing health checks, and security agents that inspect peer processes."
    tuning_guidance = "Add known debugger and profiler binary paths to %linux_allowed_ptrace_binaries. Add internal monitoring subnets to %rfc1918_internal to suppress internal-only connections. Narrow $open.target.process.file.full_path exclusions for specific monitored daemons if needed."

  events:
    // Leg 1: A process opens/attaches to another running process (ptrace attach surface)
    $open.metadata.event_type = "PROCESS_OPEN"
    // The attaching process must not be a known legitimate debugger
    not $open.principal.process.file.full_path in %linux_allowed_ptrace_binaries
    // Exclude kernel threads and empty principal paths
    $open.principal.process.file.full_path = /.+/ nocase
    // The target of the open must be a real process (not self-open)
    $open.target.process.file.full_path = /.+/ nocase
    // Exclude cases where a process opens itself (legitimate runtime behaviour)
    $open.principal.process.pid != $open.target.process.pid
    $open.principal.hostname = $hostname

    // Leg 2: An outbound network connection from the same host shortly after
    $net.metadata.event_type = "NETWORK_CONNECTION"
    // Must be an external destination (not loopback or RFC-1918)
    not $net.target.ip in %rfc1918_internal
    // Exclude DNS (port 53) and NTP (port 123) to reduce noise
    $net.target.port != 53
    $net.target.port != 123
    // The connecting process must not be a known-safe network binary
    not $net.principal.process.file.full_path in %linux_allowed_ptrace_binaries
    $net.principal.process.file.full_path = /.+/ nocase
    $net.principal.hostname = $hostname

    // Chronological ordering: process open must precede the network connection
    $open.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($open.principal.hostname)
    $attaching_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $network_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $open_event_count = count($open.metadata.id)
    $net_event_count = count($net.metadata.id)

  condition:
    $open and $net
}
