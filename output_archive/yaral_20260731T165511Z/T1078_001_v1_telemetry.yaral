/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:11:01.433313+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_Default_Account_Enabled_Via_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications that re-enable built-in default accounts (Administrator, Guest) on Windows systems. Adversaries abuse default accounts for persistence and privilege escalation. This rule targets the resulting registry state change rather than the command line used to make it, providing coverage that evades process-creation log gaps."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation, Defense Evasion"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires Windows registry auditing (Sysmon Event ID 13, or EDR registry telemetry). Audit Object Access must be enabled for HKLM\\SAM or equivalent registry hive monitoring."
    platform = "Windows"
    false_positives = "IT provisioning scripts that legitimately re-enable the built-in Administrator account during imaging or deployment. Domain Group Policy refreshes that manage account state. RMM agents performing baseline configuration. Authorized break-glass procedures."
    tuning_guidance = "Add known provisioning or imaging host names to %global_allowed_provisioning_hosts. Add authorized admin tool paths to %global_allowed_admin_tools. Consider scoping to production OU segments only and excluding known imaging subnets."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the SAM registry keys that control built-in account active/disabled state.
    // The 'Attributes' DWORD under each account key encodes the disabled bit (0x0001 = disabled).
    // Setting it to 0x0000 or removing the disabled flag re-enables the account.
    // Both the Administrator (RID 500) and Guest (RID 501) accounts are covered.
    $reg.target.registry.registry_key = /HKLM\\SAM\\SAM\\Domains\\Account\\Users\\(000001F4|000001F5)\\/ nocase

    // The value being written is 'F' (account flags blob) or 'V' (account data blob),
    // which contain the account-enabled/disabled state. Matching either covers both
    // direct SAM edits and tooling that writes the full account structure.
    $reg.target.registry.registry_value_name = /^(F|V)$/ nocase

    // Exclude known provisioning and imaging hosts to reduce noise in managed environments.
    not $reg.principal.hostname in %global_allowed_provisioning_hosts

    // Exclude known authorized administrative tools (e.g., deployment agents, GPO engines).
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
