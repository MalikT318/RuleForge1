/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:59:50.978860+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Doppelganging_TxF_Write_Then_ProcessOpen {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a behavioral sequence consistent with Process Doppelgänging: a suspicious process opens a transacted file write handle (FILE_CREATION or FILE_MODIFICATION targeting an executable path) followed shortly by that same process opening a handle to another live process (PROCESS_OPEN). This two-stage pattern mirrors the TxF-based injection workflow where malicious code is written into a transacted file section and then mapped into a victim process, without the malicious image ever being committed to disk."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelgänging"
    log_prerequisites = "Requires EDR telemetry that emits FILE_CREATION or FILE_MODIFICATION events for executable-path writes AND PROCESS_OPEN events (e.g., Sysmon Event ID 10, CrowdStrike, SentinelOne, or Microsoft Defender for Endpoint via Chronicle ingestion). Both event types must carry principal.process.file.full_path and principal.hostname."
    platform = "Windows"
    false_positives = "Legitimate software installers that write PE files and subsequently inspect running processes (e.g., update agents, AV engines, software deployment tools). Security tooling performing process enumeration after writing temporary files. Debugging tools such as WinDbg or Visual Studio."
    tuning_guidance = "Add known-good installer and security-tool paths to %global_allowed_doppelgang_writers. Narrow the file path regex if your environment only uses specific temp directories. Consider raising severity only when the principal process is not in %global_allowed_admin_tools."

  events:
    // Stage 1: A non-system process writes or creates a file at an executable
    // path (PE staging step of the TxF transaction). We restrict to paths
    // commonly abused for transacted writes: temp directories and user-writable
    // locations. System32 writers are excluded to suppress installer noise.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(exe|dll|sys)$/i nocase
    $file.target.file.full_path = /(\\Temp\\|\\AppData\\|\\ProgramData\\|\\Users\\)/i nocase
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|wuauclt|svchost)\.exe$/i nocase
    not $file.principal.process.file.full_path in %global_allowed_doppelgang_writers
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $writer_process

    // Stage 2: The SAME process (matched via hostname + process path) opens a
    // handle to another live process shortly after the transacted write.
    // PROCESS_OPEN is the UDM event type emitted for OpenProcess() calls
    // (Sysmon EID 10 / EDR equivalent). We require a non-trivial target PID
    // by ensuring the target process path is populated and differs from the
    // principal, indicating cross-process handle acquisition.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = $writer_process
    not $open.target.process.file.full_path = $writer_process
    not $open.target.process.file.full_path = /\\(conhost|csrss|smss|werfault)\.exe$/i nocase
    not $open.principal.process.file.full_path in %global_allowed_doppelgang_writers
    $open.principal.hostname = $hostname

    // Chronological ordering: file write must precede process open
    $file.metadata.event_timestamp.seconds <= $open.metadata.event_timestamp.seconds

  match:
    $hostname, $writer_process over 5m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $injecting_process = array_distinct($writer_process)
    $written_file_paths = array_distinct($file.target.file.full_path)
    $target_process_paths = array_distinct($open.target.process.file.full_path)
    $event_count = count($open.metadata.event_timestamp.seconds)

  condition:
    $file and $open
}
