/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:05:10.336077+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_VBScript_Spawns_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a VBScript or HTA host process spawning a child process that subsequently makes an outbound network connection. This sequence is characteristic of VB-based malware using wscript/cscript/mshta as a dropper or C2 beaconing mechanism, and is additive to existing command-line-only detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) with principal.process populated on network events. Windows Sysmon (Event IDs 1 and 3) or a commercial EDR satisfies both requirements."
    platform = "Windows"
    false_positives = "Legitimate administrative scripts using wscript/cscript that contact internal update servers or monitoring endpoints. Software deployment tools that use HTA installers. SCCM/Intune provisioning workflows. Antivirus or DLP agents that use VBScript health checks."
    tuning_guidance = "Add known-good parent script paths to %vbscript_allowed_script_paths. Add approved internal destinations to %global_allowed_internal_destinations. Narrow scope further by restricting target.port to high-risk ports (e.g., 443, 80, 4444, 8080) if noise is high."

  events:
    // Leg 1: VBScript or HTA host spawns any child process
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(wscript|cscript|mshta)\.exe$/ nocase
    not $proc.target.process.file.full_path = /\\(wscript|cscript|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %vbscript_allowed_script_paths
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $child_process_path

    // Leg 2: That same child process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $child_process_path
    not $net.target.ip in %global_allowed_internal_destinations
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname

    // Enforce chronological ordering: process launch before network connection
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $vbscript_parent = array_distinct($proc.principal.process.file.full_path)
    $spawned_child = array_distinct($child_process_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $proc and $net
}
