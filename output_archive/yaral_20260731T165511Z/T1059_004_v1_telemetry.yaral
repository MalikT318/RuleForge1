/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:04:20.566531+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_Shell_Script_Written_To_Disk {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects shell script artifacts written to disk outside of expected package-manager and system paths. Adversaries frequently drop shell scripts as a staging mechanism for execution, persistence, or lateral movement payloads. This rule targets the FILE_CREATION state change rather than process command-line arguments, providing coverage that is orthogonal to existing PROCESS_LAUNCH detections and harder for attackers to suppress."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires EDR file-creation telemetry (e.g. CrowdStrike Falcon, SentinelOne, Sysdig, or auditd with file-watch rules). The agent must populate target.file.full_path and principal.process.file.full_path on FILE_CREATION events."
    platform = "Linux, macOS, ESXi"
    false_positives = "Legitimate DevOps pipelines writing build scripts, configuration management tools (Ansible, Chef, Puppet) deploying scripts, software package post-install hooks, developer workstations, CI/CD runners."
    tuning_guidance = "Add trusted parent process paths (e.g. /usr/bin/ansible, /opt/chef/bin/ruby) to %global_allowed_script_writers. Add approved destination directories (e.g. /opt/deploy/scripts) to %global_allowed_script_dirs. Raise severity for ESXi hosts by tagging them in a separate reference list."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match files with shell script extensions or the common extensionless pattern
    // where the file lands in a temp, home, or world-writable location
    (
      $file.target.file.full_path = /\.(sh|bash|zsh|ksh|csh|tcsh|ash|dash|fish)$/ nocase
      or
      (
        $file.target.file.full_path = /\/(tmp|dev\/shm|var\/tmp|run\/shm|home\/[^\/]+|root|Users\/[^\/]+)\/[^\/]+$/ nocase
        and
        $file.target.file.full_path = /\/[^.\/]+$/ nocase
      )
    )

    // Exclude writes originating from known safe package-manager and system paths
    not $file.principal.process.file.full_path = /\/(usr\/bin\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper|brew|pip[0-9]?)|usr\/lib\/(apt|dpkg)|var\/lib\/(dpkg|rpm)|usr\/local\/bin\/(pip|conda|gem|cargo|npm|yarn))/ nocase

    // Exclude writes into canonical system-managed script directories
    not $file.target.file.full_path = /^\/(usr\/(bin|sbin|lib|share|local\/(bin|sbin|lib|share))|etc\/(cron\.(d|daily|hourly|monthly|weekly)|profile\.d|bash_completion\.d|init\.d|rc[0-9S]\.d)|lib\/(systemd|udev)|opt\/(homebrew|local))/ nocase

    // Reference-list exclusions for MSSP multi-tenant tuning
    not $file.principal.process.file.full_path in %global_allowed_script_writers
    not $file.target.file.full_path in %global_allowed_script_dirs

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_script_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
