/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:00:37.483466+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_VDSO_Hijack_ProcOpen_Then_AnonExecMap {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a likely VDSO hijacking sequence: a process opens another process's memory (PROCESS_OPEN, consistent with ptrace or /proc/<pid>/mem access) followed shortly after by an anonymous executable memory mapping event on the same host. VDSO hijacking redirects syscall stubs in the target process's vdso region and typically requires opening the victim process before patching the GOT or vdso stubs. The anonymous exec-map event is surfaced by EDR sensors that audit mmap/mprotect calls creating PROT_EXEC regions backed by no file (anonymous). Together these two signals form a high-fidelity behavioural indicator that does not rely on command-line strings and therefore provides additive coverage over existing PROCESS_LAUNCH rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events for cross-process memory access (e.g., SentinelOne, CrowdStrike Falcon, Sysdig Falco via UDM ingestion) AND FILE_READ or PROCESS_MODULE_LOAD events annotated with anonymous/memfd executable mappings. Auditd rules for ptrace and mmap syscalls forwarded through the Chronicle Auditd parser also satisfy this requirement."
    platform = "Linux"
    false_positives = "Debuggers (gdb, lldb, strace, perf), JVM/JIT runtimes creating anonymous executable trampolines, Valgrind, sanitizer-instrumented binaries, legitimate profiling agents (Datadog, Dynatrace), and container runtimes that use memfd_create for code generation. Tune using the reference lists below."
    tuning_guidance = "Add known debugger and profiler binary paths to %linux_allowed_proc_openers. Add known JIT runtime binary paths to %linux_allowed_anon_exec_mappers. Scope by principal.hostname to specific high-risk segments if false-positive volume remains elevated."

  events:
    // Leg 1: A process opens another live process's address space.
    // PROCESS_OPEN is emitted by EDR sensors when one process acquires a
    // handle/descriptor to another process (ptrace attach, /proc/<pid>/mem open,
    // process_vm_readv/writev). Pre-filter to non-self opens by requiring
    // distinct process image paths and excluding known-safe openers.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\// nocase
    // Exclude self-opens (process opening itself, common in JVM startup)
    not $open.principal.process.file.full_path = $open.target.process.file.full_path
    // Exclude known legitimate cross-process openers (debuggers, profilers, RMM)
    not $open.principal.process.file.full_path in %linux_allowed_proc_openers
    // Anchor the join on the originating host
    $open.principal.hostname = $hostname

    // Leg 2: Shortly after, an anonymous executable memory region is created
    // on the same host. Chronicle EDR parsers surface this as PROCESS_MODULE_LOAD
    // with a target file path of "[anon]", "memfd:", or "/dev/shm/" indicating
    // a file-less executable mapping — the hallmark of VDSO/GOT patching that
    // loads a malicious shared object without touching disk.
    $anon.metadata.event_type = "PROCESS_MODULE_LOAD"
    // Match anonymous or memfd-backed executable mappings
    $anon.target.process.file.full_path = /(\[anon\]|memfd:|\/dev\/shm\/|\/proc\/[0-9]+\/fd\/)/ nocase
    // Exclude known JIT runtimes that legitimately create anonymous exec regions
    not $anon.principal.process.file.full_path in %linux_allowed_anon_exec_mappers
    $anon.principal.hostname = $hostname

    // Chronological ordering: process open must precede the anonymous exec mapping
    $open.metadata.event_timestamp.seconds <= $anon.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity = array_distinct($hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $opened_target_process = array_distinct($open.target.process.file.full_path)
    $anon_map_process = array_distinct($anon.principal.process.file.full_path)
    $anon_map_path = array_distinct($anon.target.process.file.full_path)
    $open_event_count = count($open.metadata.id)
    $anon_map_event_count = count($anon.metadata.id)

  condition:
    $open and $anon
}
