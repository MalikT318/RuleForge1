/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:59:27.613715+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Doppelganging_TxF_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process doppelgänging at the PROCESS_OPEN abstraction layer. Process doppelgänging abuses Windows Transactional NTFS (TxF) to load a malicious image into a legitimate process section. A key observable is a non-privileged or unexpected process opening a handle to another process with VM_WRITE or PROCESS_VM_WRITE access rights, which is required to overwrite the target process memory with the transacted (malicious) image. This rule fires when a process outside of known system and security tooling opens a handle to a remote process, providing coverage orthogonal to command-line / PROCESS_LAUNCH detections."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelgänging"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target process path and access rights (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint via MDE advanced hunting forwarded to Chronicle, or Sysmon Event ID 10 with GrantedAccess field mapped to UDM)."
    platform = "Windows"
    false_positives = "Security software (AV/EDR agents), debuggers (WinDbg, x64dbg), process monitoring utilities (Process Explorer, Process Hacker), software installers performing in-memory patching, JIT compilers, and legitimate virtualisation or sandboxing products."
    tuning_guidance = "Populate %global_allowed_process_open_sources with full paths of approved security tools, debuggers, and deployment agents (e.g., /windows/system32/msiexec.exe, EDR agent paths). Populate %global_allowed_system_processes with paths of OS processes that legitimately open cross-process handles. Narrow further by correlating with the absence of a signed parent or by restricting to non-system sessions."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The requesting (principal) process must NOT be a known Windows system binary
    // that legitimately opens cross-process handles. Regex anchors to the filename
    // to avoid path-manipulation bypasses.
    not $open.principal.process.file.full_path = /\\(lsass|csrss|smss|wininit|services|svchost|MsMpEng|SenseIr|MsSense|SecurityHealthService)\.exe$/i nocase
    not $open.principal.process.file.full_path = /\\(WerFault|werfaultsecure|taskmgr|msiexec|TiWorker|TrustedInstaller)\.exe$/ nocase

    // Target process is a legitimate Windows executable - doppelgänging hijacks
    // a real process image to hide malicious code inside it.
    $open.target.process.file.full_path = /\\windows\\/  nocase

    // The target process is NOT the same as the requesting process (no self-open).
    // We approximate this by requiring the target to be a different binary name.
    // Self-opens are common and benign; cross-process opens with write access are not.
    not $open.target.process.file.full_path = $open.principal.process.file.full_path

    // Access rights field: detect VM_WRITE-class access. Chronicle maps Sysmon
    // GrantedAccess into target.process.access_mask (hex string) where available.
    // 0x0020 = PROCESS_VM_WRITE, 0x0008 = PROCESS_VM_OPERATION.
    // We match on the presence of these bits expressed as common combined masks
    // seen in injection tooling (0x1fffff = all-access, 0x0028, 0x1f0fff, etc.).
    // Regex covers the most common combined access masks used by injection frameworks.
    $open.target.process.access_mask = /0x(001f0fff|0028|0020|1fffff|00[0-9a-f]{2}2[08])/  nocase

    // Exclude processes whose full path is in the MSSP-managed allow-list.
    not $open.principal.process.file.full_path in %global_allowed_process_open_sources

    // Exclude known-good target processes that are routinely opened by system components.
    not $open.target.process.file.full_path in %global_allowed_system_processes

    // Requesting process must not reside in the canonical Windows system directories
    // to catch masquerading binaries living outside System32/SysWOW64.
    // NOTE: legitimate injectors (AV) DO live in system32; this filter is intentionally
    // inverted - we KEEP events where the opener is NOT in system32 to reduce FP volume.
    not $open.principal.process.file.full_path = /\\(windows\\system32|windows\\syswow64|windows\\sysnative)\\/  nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($open.principal.hostname)
    $requesting_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $access_mask_observed = array_distinct($open.target.process.access_mask)

  condition:
    $open
}
