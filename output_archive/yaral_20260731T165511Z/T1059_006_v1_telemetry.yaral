/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:05:32.414775+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_Python_Script_Drop_In_Suspicious_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Python script files (.py, .pyc, .pyo, .pyw) written to suspicious or high-value filesystem locations (temp directories, user home staging areas, web roots, cron directories, admin shares) by processes other than known package managers or IDEs. Attackers frequently drop Python payloads to disk as a staging step before or instead of interactive execution, making file-creation telemetry an additive detection layer that is harder to suppress than command-line logging."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Requires EDR file-creation telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11) forwarded to Chronicle via UDM. target.file.full_path and principal.process.file.full_path must be populated."
    platform = "Linux, macOS, Windows, ESXi"
    false_positives = "Legitimate Python package installers (pip, conda, poetry), IDE auto-save operations (VS Code, PyCharm), CI/CD pipeline agents writing test scripts, configuration management tools (Ansible, Salt), software deployment agents."
    tuning_guidance = "Add trusted parent process paths to %global_allowed_python_script_writers. Add approved staging directories to %global_allowed_python_drop_paths. Consider raising severity to High when the writing process is a network-facing service (e.g., web server, mail agent)."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match Python script and bytecode extensions across all platforms
    $file.target.file.full_path = /\.(py|pyc|pyo|pyw)$/ nocase

    // Suspicious destination paths: temp dirs, cron dirs, web roots, home staging,
    // named pipes area, ESXi scratch, world-writable common locations
    $file.target.file.full_path = /(
      [\/\\](tmp|temp|var\/tmp|dev\/shm)[\/\\]|
      [\/\\](www|htdocs|html|webroot|public_html|srv\/http)[\/\\]|
      [\/\\](cron\.(d|daily|hourly|weekly|monthly))[\/\\]|
      [\/\\](etc\/cron)[\/\\]|
      [\/\\]AppData[\/\\](Local|Roaming)[\/\\]Temp[\/\\]|
      [\/\\]Users[\/\\][^\/\\]+[\/\\](Downloads|Desktop|AppData[\/\\]Local[\/\\]Temp)[\/\\]|
      [\/\\]home[\/\\][^\/\\]+[\/\\]\.(config|cache|local)[\/\\]|
      [\/\\]vmfs[\/\\]volumes[\/\\]|
      [\/\\]scratch[\/\\]|
      [\/\\](ProgramData|Windows)[\/\\]Temp[\/\\]|
      [\/\\]var[\/\\](spool|www|log)[\/\\]
    )/ nocase

    // Exclude known-good package managers, IDEs, and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_python_script_writers

    // Exclude paths explicitly approved for Python artifact staging
    not $file.target.file.full_path in %global_allowed_python_drop_paths

    // Exclude Python's own standard tooling writing bytecode caches (__pycache__)
    not $file.target.file.full_path = /[\/\\]__pycache__[\/\\]/ nocase

    // Exclude pip/conda/poetry internal cache and dist-info writes
    not $file.target.file.full_path = /[\/\\](site-packages|dist-info|egg-info|\.pip|conda-meta)[\/\\]/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
