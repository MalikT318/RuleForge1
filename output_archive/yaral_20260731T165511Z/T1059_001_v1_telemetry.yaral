/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:02:24.251812+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_ScriptBlock_Registry_Logging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of PowerShell script block logging and module logging registry keys. Adversaries frequently disable or tamper with these keys to suppress PowerShell telemetry before executing malicious scripts. Conversely, some offensive frameworks enable verbose logging to a controlled path. Either direction of change from a non-administrative process is suspicious. This rule targets the registry state change produced by PowerShell abuse rather than the command line, providing coverage even when powershell.exe is not directly invoked (e.g., via System.Management.Automation hosted in a custom process)."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires Windows Registry auditing (Sysmon Event ID 13 / 12) or EDR registry telemetry ingested into Chronicle UDM as REGISTRY_MODIFICATION events. Ensure HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell is in the audit scope."
    platform = "Windows"
    false_positives = "Group Policy application (lsass.exe, svchost.exe applying GPO), PowerShell DSC configuration management, enterprise security baselines enabling script block logging via GPO, SCCM/Intune policy enforcement agents."
    tuning_guidance = "Add authorised policy-management parent processes (e.g., svchost.exe under TrustedInstaller, gpupdate.exe) to %global_allowed_registry_policy_writers. Scope the exclusion to the specific registry path if needed. Consider raising severity to Critical if the modification disables logging (EnableScriptBlockLogging = 0 or EnableModuleLogging = 0)."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the PowerShell policy registry hive - covers both HKLM and HKCU paths
    $reg.target.registry.registry_key = /\\SOFTWARE\\(Policies\\Microsoft\\Windows\\PowerShell|Microsoft\\PowerShell)/i nocase

    // Match the specific value names that control logging and execution policy
    // EnableScriptBlockLogging, EnableScriptBlockInvocationLogging, EnableModuleLogging,
    // ModuleNames, ExecutionPolicy, ScriptBlockLogging, ModuleLogging, Transcription
    $reg.target.registry.registry_value_name = /^(Enable(ScriptBlock(Invocation)?|Module)Logging|ModuleNames|ExecutionPolicy|ScriptBlockLogging|ModuleLogging|OutputDirectory|EnableTranscripting)$/ nocase

    // The modifying process should not be a known policy-enforcement binary
    not $reg.principal.process.file.full_path = /\\(gpupdate|gpscript|svchost|TiWorker|TrustedInstaller|msiexec|WmiPrvSE)\.exe$/ nocase

    // Exclude authorised policy writers maintained per-customer
    not $reg.principal.process.file.full_path in %global_allowed_registry_policy_writers

    // Exclude known endpoint security products that legitimately configure these keys
    not $reg.principal.process.file.full_path in %global_allowed_edr_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_modified = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $actor_userid = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
