/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:03:15.590853+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_AppleScript_Spawn_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-interactive AppleScript host process (osascript, Automator, or a mach-O embedding NSAppleScript/OSAScript) spawning a child process that subsequently makes an outbound network connection. This correlation catches post-execution lateral movement and C2 staging that pure command-line rules miss, because the network event fires after the process tree is already established."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "Requires macOS EDR telemetry (e.g. CrowdStrike Falcon, SentinelOne, or Jamf Protect) providing PROCESS_LAUNCH and NETWORK_CONNECTION UDM events with principal/target process lineage populated."
    platform = "macOS"
    false_positives = "Automator workflows performing legitimate data retrieval, IT management scripts using osascript to open URLs, software update helpers, developer tooling invoking osascript during build pipelines."
    tuning_guidance = "Add known-good parent binaries to %macos_allowed_applescript_parents. Add approved internal CIDR ranges to %macos_allowed_internal_cidrs. Narrow the child process filter if specific shells or interpreters are not expected in your environment."

  events:
    // Leg 1: AppleScript host spawns a child shell or network-capable binary
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    // Parent must be an AppleScript execution vehicle
    $proc.principal.process.file.full_path = /\/(osascript|Automator|Script\ Editor|osacompile)$/ nocase
    // Child must be a shell, curl, wget, python, ruby, perl, or ssh - common post-execution pivots
    $proc.target.process.file.full_path = /\/(bash|sh|zsh|fish|curl|wget|python[23]?|ruby|perl|ssh|nc|ncat|socat)$/ nocase
    not $proc.principal.process.file.full_path in %macos_allowed_applescript_parents
    $proc.principal.hostname = $hostname

    // Leg 2: That same child process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    // Match on the same child binary that was launched in leg 1
    $net.principal.process.file.full_path = /\/(bash|sh|zsh|fish|curl|wget|python[23]?|ruby|perl|ssh|nc|ncat|socat)$/ nocase
    // Exclude RFC-1918 and loopback to focus on external/C2 traffic
    not $net.target.ip in %macos_allowed_internal_cidrs
    $net.principal.hostname = $hostname

    // Enforce chronological ordering: spawn must precede the network event
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $applescript_host = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $proc and $net
}
