/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:01:02.132054+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_Process_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process opening a handle to another process with VM_WRITE and VM_OPERATION access rights, which is a prerequisite for ListPlanting injection. The attacker must write shellcode into the target process memory space before sending the LVM_SORTITEMS message to trigger execution via the SysListView32 callback. This rule pivots on the PROCESS_OPEN telemetry layer rather than command-line arguments, providing additive coverage orthogonal to process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires EDR telemetry that records process handle open events with access mask details (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, or Sysmon Event ID 10). The principal.process and target.process fields must be populated with file paths and the target.process.access_mask or equivalent field must be captured."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), process monitoring tools (Process Hacker, Process Explorer), RMM agents performing memory inspection, AV/EDR self-protection reads, and some game anti-cheat engines. Exclude known admin and security tooling paths via reference lists."
    tuning_guidance = "Populate %global_allowed_process_injection_sources with full paths of approved debuggers, RMM agents, and security tools. Populate %global_allowed_injection_targets with paths of processes that legitimately receive cross-process writes (e.g., browser helper processes under vendor management). Narrow scope by also requiring the target process to host a SysListView32 window (e.g., explorer.exe, taskmgr.exe, mmc.exe) if your EDR surfaces window class information."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Requesting process must not be a known-safe tool
    not $open.principal.process.file.full_path in %global_allowed_process_injection_sources

    // Target process is a GUI application likely to host SysListView32 controls.
    // Common hosts: explorer, taskmgr, mmc, regedit, eventvwr, compmgmt, dfrgui.
    // Regex matches the executable name at the end of any path to avoid hardcoded dirs.
    $open.target.process.file.full_path = /\\(explorer|taskmgr|mmc|regedit|eventvwr|compmgmt|dfrgui|resmon|perfmon|diskmgmt|devmgmt|services|lusrmgr|gpedit|wmimgmt|fsmgmt|certmgr|dsa|dsac|azman|odbcad32|odbcconf|colorcpl|iexplore|msedge|chrome|firefox)\.exe$/ nocase

    // Target must not be an approved injection destination
    not $open.target.process.file.full_path in %global_allowed_injection_targets

    // The requesting process must not be the same binary as the target
    // (self-opens are normal for process introspection)
    // Expressed by requiring the principal path to differ from the target path pattern above:
    // We exclude cases where the opener IS the same well-known GUI host opening itself.
    not $open.principal.process.file.full_path = /\\(explorer|taskmgr|mmc|regedit|eventvwr|compmgmt|dfrgui|resmon|perfmon|diskmgmt|devmgmt|services|lusrmgr|gpedit|wmimgmt|fsmgmt|certmgmt|dsa|dsac|azman|odbcad32|odbcconf|colorcpl)\.exe$/ nocase

    // Opener must not be a Microsoft-signed system process performing routine IPC.
    // Exclude common benign openers by path prefix pattern.
    not $open.principal.process.file.full_path = /\\(svchost|lsass|csrss|wininit|winlogon|smss|services|spoolsv|SearchIndexer|MsMpEng|SgrmBroker|SecurityHealthService)\.exe$/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opener_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
