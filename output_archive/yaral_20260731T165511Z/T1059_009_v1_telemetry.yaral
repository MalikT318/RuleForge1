/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:07:24.275237+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_Cloud_API_Credential_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of cloud SDK/CLI credential and configuration files outside of expected installer or home-directory paths. Adversaries who abuse cloud APIs (T1059.009) via SDKs or CLIs leave credential artifacts on disk (e.g. AWS ~/.aws/credentials, Azure ~/.azure/accessTokens.json, GCP ~/.config/gcloud/credentials.db). Writing these files from unexpected parent processes or in non-standard locations is a strong indicator of programmatic cloud API abuse or credential staging."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires EDR file-event telemetry (e.g. CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11) forwarded to Chronicle via UDM. FILE_CREATION and FILE_MODIFICATION events must be enabled."
    platform = "Windows, Linux, macOS"
    false_positives = "Legitimate developer workstations running 'aws configure', 'az login', or 'gcloud auth login'. CI/CD pipeline agents writing ephemeral credentials. Cloud SDK auto-update processes. IT provisioning scripts."
    tuning_guidance = "Add known CI/CD agent process paths to %global_allowed_cloud_sdk_parents. Add approved provisioning hostnames to %global_allowed_cloud_sdk_hosts. Narrow severity for developer subnets if asset tagging is available."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match cloud CLI/SDK credential and token artifact file names across AWS, Azure, GCP, and generic SDK patterns
    $file.target.file.full_path = /[\/\\](credentials|accessTokens\.json|azureProfile\.json|clouds\.config|application_default_credentials\.json|credentials\.db|legacy_credentials|adc\.json|service_account\.json|token_cache\.json|msal_token_cache\.json|TokenCache\.dat|sts-credentials\.json|cloud-credentials)$/ nocase

    // Restrict to paths that look like cloud SDK config directories to reduce noise from unrelated credential files
    $file.target.file.full_path = /[\/\\](\.aws|\.azure|\.config[\/\\]gcloud|\.config[\/\\]doctl|\.config[\/\\]op|AppData[\/\\]Roaming[\/\\]\.?azure|AppData[\/\\]Local[\/\\]\.?azure|\.oci|\.aliyun|\.kube)[\/\\]/ nocase

    // Exclude writes originating from known legitimate SDK installer or update parent processes
    not $file.principal.process.file.full_path = /[\/\\](Installer|Setup|install|update|Updater|msiexec|uninstall)/ nocase

    // Exclude known allowed cloud SDK parent processes and provisioning hosts
    not $file.principal.process.file.full_path in %global_allowed_cloud_sdk_parents
    not $file.principal.hostname in %global_allowed_cloud_sdk_hosts

    // Flag writes from scripting engines, shells, and remote execution frameworks - high-risk parents
    $file.principal.process.file.full_path = /[\/\\](powershell|pwsh|cmd|bash|sh|zsh|python[23]?|python3\.[0-9]+|ruby|perl|node|wscript|cscript|mshta|regsvr32|rundll32|curl|wget|certutil|bitsadmin|psexec|wmic|winrm|ssh|scp|sftp|nc|ncat|socat)\.exe$/ nocase

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)
    $actor_userid = array_distinct($file.principal.user.userid)

  condition:
    $file
}
