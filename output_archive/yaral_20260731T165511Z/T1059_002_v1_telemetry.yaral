/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:02:58.465222+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_AppleScript_Compiled_Artifact_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of compiled AppleScript artifacts (.scpt, .scptd, .osas) outside of expected developer and system paths. Adversaries compile AppleScript payloads to evade command-line inspection; the resulting file artifact is harder to suppress than process telemetry. This rule targets the file-system state change produced by osascript, Script Editor, or NSAppleScript/OSAScript Native API calls."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "Requires macOS EDR file telemetry (e.g., CrowdStrike Falcon, SentinelOne, or Jamf Protect) reporting FILE_CREATION and FILE_MODIFICATION events with full target path and principal process path."
    platform = "macOS"
    false_positives = "Legitimate developer workflows using Script Editor or Xcode; Automator workflows saving compiled scripts; IT automation tools (Jamf, Munki) deploying .scpt payloads; macOS system components under /System/Library."
    tuning_guidance = "Add known developer home directories or IT tooling paths to %macos_allowed_script_writers. Add approved parent process paths (e.g., Script Editor, Automator) to %macos_allowed_applescript_parents. Scope by principal.user.userid to exclude dedicated automation service accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target compiled AppleScript file extensions
    $file.target.file.full_path = /\.(scpt|scptd|osas)$/ nocase

    // Exclude well-known legitimate system and application bundle paths
    not $file.target.file.full_path = /^\/System\/Library\// nocase
    not $file.target.file.full_path = /^\/Library\/Application Support\/Apple\// nocase
    not $file.target.file.full_path = /^\/Applications\/Script Editor\.app\// nocase
    not $file.target.file.full_path = /^\/Applications\/Automator\.app\// nocase
    not $file.target.file.full_path = /^\/Applications\/Xcode\.app\// nocase

    // Flag writes into high-risk staging locations
    // (temp dirs, user caches, hidden dirs, /tmp, /var/folders)
    $file.target.file.full_path = /(\/(tmp|var\/folders|private\/tmp)|\/\.[^\/]+\/|\/Library\/Caches\/|\/Downloads\/|\/Desktop\/)/ nocase

    // Exclude known legitimate parent writers; tunable via reference list
    not $file.principal.process.file.full_path in %macos_allowed_applescript_parents

    // Exclude known safe writer paths by full path prefix
    not $file.principal.process.file.full_path = /^\/Applications\/Script Editor\.app\// nocase
    not $file.principal.process.file.full_path = /^\/Applications\/Automator\.app\// nocase
    not $file.principal.process.file.full_path = /^\/usr\/local\/jamf\// nocase
    not $file.principal.process.file.full_path = /^\/usr\/local\/munki\// nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
