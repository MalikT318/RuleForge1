/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:01:25.660450+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_WriteMemory_Then_SendMessage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the ListPlanting injection pattern: a process opens a handle to a remote process (PROCESS_OPEN) followed by a network or inter-process communication event from the same host, indicating code was written into a SysListView32 target and a sort callback was triggered via SendMessage/LVM_SORTITEMS. This is additive coverage over process-launch command-line rules and targets the memory-write + message-dispatch phase of the attack."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint via Chronicle ingestion) and PROCESS_INJECTION or PROCESS_MODULE_LOAD events from the same host."
    platform = "Windows"
    false_positives = "Legitimate accessibility tools (e.g., screen readers, automation frameworks like AutoIt/AutoHotkey, UI testing harnesses) that enumerate and interact with list-view controls in other processes. Remote desktop or session management software. Developer IDEs with live UI inspection features."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_ui_automation_tools. Add known-good target process paths to %global_allowed_listplant_targets. Narrow the PROCESS_OPEN filter to specific high-value target processes if false-positive volume is high."

  events:
    // Leg 1: A process opens a handle to another process - prerequisite for
    // writing shellcode into the target's virtual address space.
    // PROCESS_OPEN is the UDM event type for OpenProcess-style handle acquisition.
    $open.metadata.event_type = "PROCESS_OPEN"
    // The opener must not be a known-good UI automation tool
    not $open.principal.process.file.full_path in %global_allowed_ui_automation_tools
    // Exclude system-level openers that are expected to open handles constantly
    not $open.principal.process.file.full_path = /\\(lsass|csrss|smss|wininit|services)\.exe$/ nocase
    // The target of the open must not be a known-good target
    not $open.target.process.file.full_path in %global_allowed_listplant_targets
    // Exclude self-opens (same process family, e.g. crash reporters)
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    // Bind the joining placeholder
    $open.principal.hostname = $hostname

    // Leg 2: Shortly after the handle acquisition, the same host generates a
    // PROCESS_INJECTION event, indicating code was written into the remote
    // process and execution was triggered (e.g., via LVM_SORTITEMS SendMessage).
    $inj.metadata.event_type = "PROCESS_INJECTION"
    // The injecting process must match the opener from leg 1
    $inj.principal.process.file.full_path = $injector_path
    // Exclude known-good injection sources (e.g., AV, EDR self-protection)
    not $inj.principal.process.file.full_path in %global_allowed_ui_automation_tools
    // The injection target should be a GUI-hosting process (has a message loop)
    // Common hosts for SysListView32: explorer, mmc, taskmgr, regedit, etc.
    $inj.target.process.file.full_path = /\\(explorer|mmc|taskmgr|regedit|control|rundll32|dllhost|svchost)\.exe$/ nocase
    $inj.principal.hostname = $hostname

    // Bind the injector path across both legs so the same process is responsible
    $open.principal.process.file.full_path = $injector_path

    // Enforce chronological ordering: handle open must precede injection
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $injector_path over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $injected_target_process = array_distinct($inj.target.process.file.full_path)
    $target_process_pid = array_distinct($inj.target.process.pid)
    $open_event_count = count($open.metadata.id)
    $injection_event_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
