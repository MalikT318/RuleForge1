/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:03:34.307142+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_BatchFile_Drop_Suspicious_Location {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of batch files (.bat / .cmd) in locations commonly abused by adversaries: temp directories, user profile roots, ProgramData, and web-accessible paths. Adversaries stage batch scripts as a second-stage payload or persistence mechanism after initial access. This rule pivots on the FILE_CREATION artifact rather than process command-line arguments, providing coverage when command-line logging is disabled or tampered with."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Shell Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR file-creation telemetry (e.g., Microsoft Defender for Endpoint, CrowdStrike, Carbon Black, Sysmon Event ID 11). Chronicle UDM FILE_CREATION events must populate target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    false_positives = "Software installers writing temporary batch scripts during setup; RMM agents (e.g., ConnectWise, Kaseya) deploying scripts; legitimate DevOps pipelines; build systems writing .bat wrappers. Tune by adding known-good parent processes to %global_allowed_batch_writers and known-good paths to %global_allowed_batch_paths."
    tuning_guidance = "1) Add installer / RMM parent process full paths to %global_allowed_batch_writers. 2) Add approved staging directories to %global_allowed_batch_paths. 3) Lower severity to Medium in environments with heavy software deployment activity and correlate with subsequent PROCESS_LAUNCH of cmd.exe reading the same file."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a batch file by extension
    $file.target.file.full_path = /\.(bat|cmd)$/i nocase

    // Restrict to high-risk write locations:
    // %TEMP%, %TMP%, Windows\Temp, ProgramData root, user profile root,
    // Recycle Bin staging, web roots (inetpub / wwwroot), and Downloads
    $file.target.file.full_path = /(?:\\Temp\\|\\tmp\\|\\Windows\\Temp\\|\\ProgramData\\[^\\]+\.(bat|cmd)$|\\Users\\[^\\]+\\[^\\]+\.(bat|cmd)$|\\inetpub\\|\\wwwroot\\|\\Downloads\\|\\AppData\\Local\\Temp\\|\\AppData\\Roaming\\[^\\]+\.(bat|cmd)$|\\\$Recycle\.Bin\\)/ nocase

    // Exclude known-good parent processes via reference list
    not $file.principal.process.file.full_path in %global_allowed_batch_writers

    // Exclude known-good destination paths via reference list
    not $file.target.file.full_path in %global_allowed_batch_paths

    // Exclude Windows system processes that legitimately write batch files
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|svchost|WerFault|wuauclt|TiWorker)\.exe$/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
