/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:09:27.493246+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_CLI_Spawns_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an ESXi hypervisor CLI tool (esxcli, vim-cmd, esxcfg-*, vmkfstools) spawning a child process that subsequently initiates an outbound network connection. This sequence is consistent with adversaries using hypervisor CLIs to stage or exfiltrate data, download tools, or establish C2 channels. Variant 2 of 2 for T1059.012 - focuses on the post-execution network behaviour rather than command-line argument patterns."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "Requires ESXi process telemetry (e.g., Carbon Black, CrowdStrike Falcon for ESXi, or syslog-based process auditing forwarded to Chronicle). Requires network flow or connection telemetry from the ESXi host."
    platform = "ESXi"
    false_positives = "Legitimate administrator sessions using esxcli or vim-cmd to pull updates, check licensing servers, or push configuration to remote syslog targets. Automated health-check scripts that invoke esxcli and then contact a monitoring endpoint."
    tuning_guidance = "Populate %esxi_allowed_mgmt_destinations with known vCenter, update, and monitoring server IPs/CIDRs. Populate %esxi_allowed_cli_parents with approved orchestration process paths. Reduce severity for connections to RFC-1918 space if internal-only management is expected."

  events:
    // Leg 1: ESXi hypervisor CLI tool launches a child process
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(esxcli|vim-cmd|esxcfg-[a-z]+|vmkfstools|esxcfg|vmware-cmd)(\.sh)?$/ nocase
    not $proc.principal.process.file.full_path in %esxi_allowed_cli_parents
    $proc.principal.hostname = $esxi_host

    // Leg 2: A process on the same host makes an outbound network connection
    // shortly after the CLI invocation - the connecting process is either the
    // CLI tool itself or a child it spawned (shell, python, wget, curl, etc.)
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $esxi_host
    $net.principal.process.file.full_path = /\/(esxcli|vim-cmd|esxcfg-[a-z]+|vmkfstools|sh|ash|busybox|python[0-9.]*|wget|curl|nc|ncat|socat)(\.sh)?$/ nocase
    not $net.target.ip in %esxi_allowed_mgmt_destinations
    not $net.principal.process.file.full_path in %esxi_allowed_cli_parents

    // Enforce chronological ordering: process launch must precede network event
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $esxi_host over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $cli_tools_observed = array_distinct($proc.principal.process.file.full_path)
    $connecting_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $proc and $net
}
