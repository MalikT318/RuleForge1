/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:08:33.570000+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of Lua script files (.lua) or Lua bytecode files (.luac) in suspicious filesystem locations such as temp directories, user writable paths, or non-standard application directories. Adversaries drop Lua scripts as a staging mechanism or as payloads executed by embedded interpreters, bypassing command-line logging entirely."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires EDR file telemetry (e.g., CrowdStrike Falcon, Microsoft Defender for Endpoint, SentinelOne, Sysmon EventID 11) reporting FILE_CREATION or FILE_MODIFICATION events with full target file paths."
    platform = "Linux, Windows, macOS"
    false_positives = "Game engines (e.g., World of Warcraft addons, Roblox), legitimate software using embedded Lua (e.g., Wireshark, Nginx with OpenResty, Redis scripting), developer workstations building Lua-based applications, configuration management tools deploying Lua configs to network devices."
    tuning_guidance = "Add known-good parent process paths (e.g., game launchers, IDE processes) to %global_allowed_lua_writers. Add approved directories to %global_allowed_lua_directories. Raise severity to High for server or network device asset groups where Lua is not expected."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target Lua source scripts and compiled bytecode
    $file.target.file.full_path = /\.(lua|luac)$/ nocase

    // Suspicious write locations: temp dirs, user-writable paths, hidden dirs,
    // web roots, and common staging locations across Windows, Linux, macOS
    $file.target.file.full_path = /(\\Temp\\|\\tmp\\|\/tmp\/|\/var\/tmp\/|\\AppData\\|\\ProgramData\\|\/dev\/shm\/|\\Users\\[^\\]+\\Downloads\\|\/home\/[^\/]+\/\.|\/.hidden\/|\\Windows\\Temp\\|\/Library\/Application Support\/|\\inetpub\\|\/var\/www\/|\/srv\/|\\Downloads\\)/ nocase

    // Exclude known-good Lua-writing processes and directories
    not $file.principal.process.file.full_path in %global_allowed_lua_writers
    not $file.target.file.full_path in %global_allowed_lua_directories

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
