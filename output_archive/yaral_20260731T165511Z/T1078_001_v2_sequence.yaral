/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:11:18.413745+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_Default_Account_Auth_Then_Privileged_Action {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a successful login by a well-known default account (e.g., root, administrator, guest, admin, sa, vagrant, pi, ubuntu, ec2-user, ansible) followed by a privileged resource access or creation event on the same host within 1 hour. This correlation catches post-authentication abuse of default credentials without relying on command-line matching."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires authentication logs (Windows Security Event 4624/4648, Linux PAM/sshd, cloud provider auth logs) and resource access or creation events forwarded to Chronicle UDM. Both event types must populate principal.user.userid and principal.hostname."
    platform = "Windows, Linux, macOS, IaaS, SaaS, Network Devices, ESXi, Containers"
    false_positives = "Legitimate use of shared admin accounts in break-glass scenarios, automated provisioning pipelines using service accounts named 'admin' or 'root', cloud provider managed services authenticating as root equivalents, legacy applications using 'sa' for SQL Server."
    tuning_guidance = "Add approved default-named service accounts to %allowed_default_account_names. Add known automation hostnames to %allowed_automation_hosts. Narrow the userid regex to only the default account names observed in your environment."

  events:
    // Leg 1: Successful login by a default/well-known account name
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = /^(root|administrator|admin|guest|vagrant|pi|ubuntu|ec2\-user|ansible|sa|oracle|postgres|hadoop|tomcat|www\-data|nobody|daemon|sync|operator|default)$/ nocase
    not $auth.principal.user.userid in %allowed_default_account_names
    not $auth.principal.hostname in %allowed_automation_hosts
    $auth.principal.hostname = $hostname
    $auth.principal.user.userid = $default_userid

    // Leg 2: Privileged resource creation or access event on the same host
    // by the same default account, occurring after the login
    $res.metadata.event_type = "USER_RESOURCE_ACCESS"
    $res.principal.user.userid = $default_userid
    $res.principal.hostname = $hostname
    not $res.principal.hostname in %allowed_automation_hosts

    // Enforce chronological ordering: login must precede the resource access
    $auth.metadata.event_timestamp.seconds <= $res.metadata.event_timestamp.seconds

  match:
    $hostname, $default_userid over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($auth.principal.hostname)
    $default_account_used = array_distinct($auth.principal.user.userid)
    $resources_accessed = array_distinct($res.target.resource.name)
    $auth_count = count($auth.metadata.id)
    $resource_access_count = count($res.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth and $res
}
