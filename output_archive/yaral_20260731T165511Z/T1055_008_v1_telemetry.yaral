/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:56:17.232040+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injection_Process_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-debugger process opening a handle to another running process with ptrace-compatible access, which is the OS-level artifact produced when ptrace system call injection occurs. An attacker attaches to a live process to write shellcode into its address space. This rule fires on the PROCESS_OPEN event rather than command-line telemetry, providing a distinct detection layer that survives binary renaming and argument obfuscation."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires an EDR or eBPF-based sensor that emits PROCESS_OPEN (process handle acquisition) events on Linux, e.g. Elastic Defend, Falco with Chronicle forwarder, or CrowdStrike Falcon with process-open telemetry enabled."
    platform = "Linux"
    false_positives = "Legitimate debuggers (gdb, lldb, strace, ltrace), Java/Python profilers, crash-dump collectors (breakpad, sentry-native), container runtimes performing live introspection, and security agents that self-inspect. Tune via %linux_allowed_ptrace_parents."
    tuning_guidance = "Populate %linux_allowed_ptrace_parents with full paths of approved debuggers and profiling agents (e.g. /usr/bin/gdb, /usr/bin/strace). Add monitoring/observability service accounts to %linux_allowed_ptrace_users. Consider scoping to interactive user sessions by excluding principal.user.userid matching service account patterns."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opening (attaching) process must NOT be a known legitimate debugger.
    // Regex matches common debugger/tracer binary names; exclusion list handles
    // site-specific approved tools.
    not $open.principal.process.file.full_path = /\/(gdb|lldb|strace|ltrace|perf|valgrind|rr|gdbserver|lldb-server|debuginfod|java|python[23]?|ruby|node|dotnet)$/ nocase
    not $open.principal.process.file.full_path in %linux_allowed_ptrace_parents

    // Exclude kernel threads and init (pid 1 / kthreadd patterns).
    not $open.principal.process.file.full_path = /^\[/ nocase

    // The target process must be a different process (cross-process open).
    // Exclude self-opens: principal and target process paths differ.
    // We cannot compare two fields directly in YARA-L, so we exclude the
    // common self-open pattern where the target is the same binary.
    not $open.target.process.file.full_path = $open.principal.process.file.full_path

    // Exclude root-to-root opens that are part of normal system management
    // only when the opener is a known system daemon path.
    not $open.principal.process.file.full_path = /^\/(usr\/)?s?bin\/(systemd|dockerd|containerd|kubelet|snapd|auditd|sshd|crond|rsyslogd)$/ nocase

    // Exclude approved service account users performing legitimate introspection.
    not $open.principal.user.userid in %linux_allowed_ptrace_users

    // Require a real user context - filter out pure kernel-space events.
    $open.principal.user.userid != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($open.principal.hostname)
    $attaching_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
