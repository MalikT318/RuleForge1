/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:10:06.466167+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_Exec_Then_Network_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process executing inside a container (via docker exec or kubectl exec) followed by an outbound network connection from that same container host within 5 minutes. This pattern is consistent with adversaries using container CLI/API to run commands inside a running container and then establishing C2 or exfiltrating data. Complements existing PROCESS_LAUNCH command-line rules by correlating the execution event with subsequent network egress."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Requires EDR or container runtime telemetry providing PROCESS_LAUNCH events with parent process context, and NETWORK_CONNECTION events from the same host. Sysdig, Falco-forwarded UDM, or endpoint agents on container hosts are suitable sources."
    platform = "Containers, Linux"
    false_positives = "Legitimate container health checks, CI/CD pipeline agents running docker exec for build steps, authorized SRE interactive debugging sessions, monitoring agents that exec into containers to collect metrics."
    tuning_guidance = "Add known CI/CD agent parent process paths to %container_allowed_exec_parents. Add internal orchestration IP ranges to %container_allowed_egress_ips. Narrow $net.target.port to high-risk ports if noise is excessive."

  events:
    // Leg 1: A container runtime CLI tool spawns a child process inside a container.
    // We detect the exec-into-container pattern by the container runtime binary acting as parent.
    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.principal.process.file.full_path = /\/(docker|kubectl|nerdctl|crictl|podman)$/ nocase
    $exec.target.process.command_line = /exec/ nocase
    not $exec.principal.process.file.full_path in %container_allowed_exec_parents
    $exec.principal.hostname = $container_host

    // Leg 2: An outbound network connection from the same host shortly after.
    // Pre-filtered to non-RFC1918 destinations to avoid internal orchestration noise.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $container_host
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %container_allowed_egress_ips
    // Exclude common benign high-volume ports that are rarely attacker C2 in this context
    // (DNS port 53 handled separately; 443/80 retained as adversaries abuse HTTPS/HTTP)
    $net.target.port != 53

    // Chronological ordering: exec must precede the network connection
    $exec.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $container_host over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($exec.principal.hostname)
    $exec_command_lines = array_distinct($exec.target.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $container_runtime_used = array_distinct($exec.principal.process.file.full_path)

  condition:
    $exec and $net
}
