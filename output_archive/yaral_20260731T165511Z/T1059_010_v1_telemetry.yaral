/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:07:58.161375+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoHotKey_AutoIT_Script_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of AutoHotKey (.ahk) or AutoIT (.au3) script files on disk. Adversaries use these scripting languages to execute payloads, implement keyloggers, and deliver phishing implants. This rule targets the file artifact produced by the technique rather than the process launch, providing coverage when command-line logging is absent or evaded."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires EDR file telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11) forwarded to Chronicle."
    platform = "Windows"
    false_positives = "Legitimate automation developers writing AHK or AutoIT scripts; IT helpdesk teams using AutoIT-based deployment wrappers; software installers that unpack AutoIT scripts during setup (e.g., NSIS-based installers)."
    tuning_guidance = "Add known-good parent process paths (e.g., installer engines, approved automation tooling) to %global_allowed_script_writers. Add approved directories such as dedicated automation shares to %global_allowed_script_directories. Consider raising severity if the creating process is a browser, email client, or document reader."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match .ahk (AutoHotKey) and .au3 (AutoIT) script extensions
    $file.target.file.full_path = /\.(ahk|au3)$/ nocase

    // Focus on user-writable and high-risk drop locations: user profiles, temp dirs,
    // public folders, and appdata. Broad regex to survive username variation.
    $file.target.file.full_path = /\\(Users|Temp|Tmp|AppData|Public|ProgramData|Downloads|Desktop|Documents|Roaming|Local)\\/ nocase

    // Exclude known-good automation tooling parent processes
    not $file.principal.process.file.full_path in %global_allowed_script_writers

    // Exclude known-good directories (e.g., approved automation shares, dev workstations)
    not $file.target.file.full_path in %global_allowed_script_directories

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
