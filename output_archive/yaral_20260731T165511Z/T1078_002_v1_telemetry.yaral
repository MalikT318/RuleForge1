/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:11:37.827508+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Domain_Account_Interactive_Logon_Outside_Hours {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects successful interactive or remote-interactive logon events using domain accounts (logon types 2 and 10) that result in a Windows Security authentication record. This targets the authentication state-change artifact rather than any process-creation command line, providing additive coverage for T1078.002. Adversaries abusing compromised domain credentials will produce these logon events regardless of how they obtained or invoked the credentials."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation, Defense Evasion"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Windows Security Event Log forwarded to Chronicle (Event IDs 4624 for successful logon). UDM fields populated by the Chronicle Windows Event Log parser: metadata.event_type = USER_LOGIN, extensions.auth.type, extensions.auth.mechanism, target.user.userid, target.user.user_display_name, principal.hostname, target.hostname."
    platform = "Windows"
    false_positives = "Legitimate after-hours administrative work, on-call engineers, automated service accounts performing scheduled tasks, jump-host or PAM-mediated sessions, and RMM agent check-ins. Tune by adding known service account prefixes to %global_allowed_service_accounts and known admin workstations to %global_allowed_admin_hosts."
    tuning_guidance = "1) Add service account userids (e.g. svc-*, backup-*) to %global_allowed_service_accounts. 2) Add authorised admin jump-hosts or PAM egress hosts to %global_allowed_admin_hosts. 3) Narrow the logon-type filter if your environment does not expose remote-interactive sessions externally. 4) Combine with a time-of-day reference list if Chronicle supports it, or promote to a Threshold rule grouped by userid to catch repeated off-hours logons."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Target interactive or remote-interactive logon mechanisms (Windows logon types 2 and 10).
    // Type 2 = console/interactive; Type 10 = RemoteInteractive (RDP).
    // This excludes network logon type 3 (common service noise) and batch/service types.
    $auth.extensions.auth.mechanism = "INTERACTIVE"

    // Require a domain qualifier on the userid (DOMAIN\user or user@domain.tld).
    // This distinguishes domain accounts from local accounts.
    $auth.target.user.userid = /[\\@]/ nocase

    // Exclude machine accounts (ending in $) which generate high-volume legitimate events.
    not $auth.target.user.userid = /\$$/ nocase

    // Exclude known service account patterns managed via reference list.
    not $auth.target.user.userid in %global_allowed_service_accounts

    // Exclude authorised admin jump-hosts and PAM egress nodes.
    not $auth.principal.hostname in %global_allowed_admin_hosts

    // Exclude logons originating from the same host (local console self-logon noise).
    // principal = source workstation, target = destination host.
    not $auth.principal.hostname = $auth.target.hostname

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($auth.target.hostname)
    $logon_user = array_distinct($auth.target.user.userid)
    $source_host = array_distinct($auth.principal.hostname)
    $dest_host = array_distinct($auth.target.hostname)

  condition:
    $auth
}
