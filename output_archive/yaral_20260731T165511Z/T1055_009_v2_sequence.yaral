/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:57:17.027398+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Proc_Maps_Read_Then_Mem_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage /proc filesystem memory injection pattern on Linux: a process first reads the memory map of a target process via /proc/[pid]/maps (to enumerate gadgets and stack offsets), then writes to /proc/[pid]/mem of the same target process within a short window. This behavioural sequence is characteristic of ROP-based proc memory injection (T1055.009) and is additive to existing process-launch/command-line detections."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux file-access telemetry with FILE_READ and FILE_MODIFICATION events populated for /proc filesystem paths. Auditd with -a always,exit -F arch=b64 -S open,openat,write rules targeting /proc/*/maps and /proc/*/mem, or an EDR agent (e.g. Falco, CrowdStrike, SentinelOne) that emits UDM FILE_READ and FILE_MODIFICATION events for procfs paths."
    platform = "Linux"
    false_positives = "Legitimate debuggers (gdb, lldb, strace, ptrace-based tools) reading /proc/[pid]/maps before attaching. Security scanners and memory forensics agents. Java/JVM runtimes that inspect their own /proc/self/maps. Container runtimes performing introspection. Profiling tools such as perf, valgrind, and sanitizers."
    tuning_guidance = "Add known debugger and profiler binary paths to %linux_allowed_proc_readers. Add monitoring agent service accounts to %linux_allowed_proc_writers. Consider narrowing by requiring the reading and writing process to differ from the target PID embedded in the path (cross-process injection) if your EDR populates that field."

  events:
    // Stage 1: process reads /proc/[pid]/maps to enumerate memory layout
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\/proc\/[0-9]+\/maps$/ nocase
    not $read.principal.process.file.full_path in %linux_allowed_proc_readers
    $read.principal.hostname = $hostname
    // Capture the target PID from the path to correlate with the write stage
    $read.target.file.full_path = $maps_path

    // Stage 2: same host writes to /proc/[pid]/mem (the actual injection)
    $write.metadata.event_type = "FILE_MODIFICATION"
    $write.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase
    not $write.principal.process.file.full_path in %linux_allowed_proc_writers
    $write.principal.hostname = $hostname

    // Enforce chronological ordering: map read must precede memory write
    $read.metadata.event_timestamp.seconds <= $write.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($hostname)
    $injecting_process_read = array_distinct($read.principal.process.file.full_path)
    $injecting_process_write = array_distinct($write.principal.process.file.full_path)
    $maps_paths_accessed = array_distinct($read.target.file.full_path)
    $mem_paths_written = array_distinct($write.target.file.full_path)
    $reading_user = array_distinct($read.principal.user.userid)
    $writing_user = array_distinct($write.principal.user.userid)

  condition:
    $read and $write
}
