/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:03:53.682614+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_CmdShell_Spawns_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects cmd.exe spawning a child process that subsequently establishes an outbound network connection. This pattern is consistent with interactive C2 shell usage, batch-file-driven lateral movement, or post-exploitation download cradles executed via the Windows command shell. Complements existing PROCESS_LAUNCH command-line rules by correlating process lineage with observed network activity."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Script Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) with principal.process.file.full_path populated. Sysmon Event IDs 1 and 3, or equivalent EDR events ingested into Chronicle UDM."
    platform = "Windows"
    false_positives = "Legitimate administrative batch scripts that invoke network utilities (ping, nslookup, curl, certutil for patching). Software deployment tools that chain cmd.exe to network calls. RMM agents that use cmd.exe as a wrapper. Developer toolchains running build scripts."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_cmd_parents. Add approved child process paths to %global_allowed_cmd_net_children. Add internal RFC-1918 ranges to %rfc1918_internal to suppress internal-only connections. Narrow scope further by requiring target.port to match high-risk ports (e.g., 4444, 8080) if false-positive volume remains high."

  events:
    // Event 1: cmd.exe is launched by a potentially suspicious parent
    // (non-interactive shells, scripting hosts, office apps, services)
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\cmd\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(wscript|cscript|mshta|winword|excel|powerpnt|outlook|onenote|acrord32|svchost|services|wmiprvse|wsmprovhost|msiexec|regsvr32|rundll32|wmic|msbuild|installutil)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_cmd_parents
    $proc.principal.hostname = $hostname
    $proc.target.process.pid = $cmd_pid

    // Event 2: a child process of that cmd.exe session makes an outbound
    // network connection to a non-RFC-1918 address
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\.(exe|bat|cmd)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_cmd_net_children
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname
    $net.principal.process.parent_pid = $cmd_pid

    // Enforce chronological ordering: process launch must precede network event
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $cmd_pid over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $cmd_parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process_making_connection = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $proc and $net
}
