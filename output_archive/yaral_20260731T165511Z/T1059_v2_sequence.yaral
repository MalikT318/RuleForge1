/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:02:03.446365+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_Shell_Spawns_Outbound_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a scripting interpreter or command shell that launches a child process which subsequently establishes an outbound network connection. This pattern is additive to process-launch command-line rules and targets the post-execution network behaviour of abused interpreters, covering living-off-the-land lateral movement, C2 beaconing, and payload staging across Windows, Linux, and macOS."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) with process context. Both event types must carry principal.hostname and principal.process.file.full_path."
    platform = "Windows, Linux, macOS"
    false_positives = "Package managers (pip, npm, brew, apt, yum) fetching updates; IDE terminals running build tools; CI/CD agents executing test pipelines; legitimate admin scripts using curl or wget; RMM agents spawned under a shell parent."
    tuning_guidance = "Add known-good child process paths to %global_allowed_shell_children. Add approved internal CIDR ranges to %rfc1918_internal. Add approved admin hostnames to %global_allowed_admin_hosts. Narrow the interpreter regex if only specific shells are relevant in your environment."

  events:
    // Event 1: A scripting interpreter or shell spawns a child process
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(bash|sh|zsh|ksh|dash|csh|tcsh|fish|python[23]?|ruby|perl|node|pwsh|powershell)$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_shell_children
    not $proc.principal.hostname in %global_allowed_admin_hosts
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $child_path

    // Event 2: The same child process (matched by hostname and process path) makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $child_path
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname
    $net.target.port > 0

    // Enforce chronological ordering: process launch must precede network connection
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $child_path over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($proc.principal.hostname)
    $interpreter_path = array_distinct($proc.principal.process.file.full_path)
    $child_process_path = array_distinct($proc.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $proc and $net
}
