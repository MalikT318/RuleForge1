/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:02:39.928444+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_Network_Then_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a PowerShell process making an outbound network connection followed by a file creation event on the same host within 5 minutes. This pattern is consistent with PowerShell downloading and staging a payload from the internet, covering both disk-based and in-memory-staging scenarios where a file is ultimately written. Complements existing process-launch/command-line rules by correlating network and file-system telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires EDR network telemetry (NETWORK_CONNECTION) and file-system telemetry (FILE_CREATION) with process context populated on both event types. Sysmon EventIDs 3 and 11 with process name populated are ideal sources."
    platform = "Windows"
    false_positives = "Legitimate PowerShell-based software deployment tools (SCCM, Chocolatey, Ansible WinRM), Windows Update components, monitoring agents that use PowerShell to pull configs, developer workstations running package managers."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_ps_network_parents. Add approved destination CIDRs to %rfc1918_internal and %global_allowed_ps_destinations. Add known-good drop directories (e.g. software staging paths) to %global_allowed_ps_drop_paths."

  events:
    // Leg 1: PowerShell makes an outbound network connection to a non-internal address
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_ps_destinations
    not $net.principal.process.file.full_path in %global_allowed_ps_network_parents
    $net.principal.hostname = $hostname

    // Leg 2: A file is created by a PowerShell process on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    // Focus on executable and script extensions commonly staged by downloaders
    $file.target.file.full_path = /\.(exe|dll|ps1|bat|cmd|vbs|js|hta|msi|lnk|scr|cpl|jar)$/ nocase
    not $file.target.file.full_path in %global_allowed_ps_drop_paths
    $file.principal.hostname = $hostname

    // Chronological ordering: network connection precedes file creation
    $net.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $files_created = array_distinct($file.target.file.full_path)
    $ps_process_paths = array_distinct($net.principal.process.file.full_path)

  condition:
    $net and $file
}
