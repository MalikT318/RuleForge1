/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:06:23.111782+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_JS_Engine_Spawns_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a JavaScript/JScript/JXA runtime engine (wscript, cscript, node, osascript, mshta) spawning a child process that subsequently makes an outbound network connection. This correlation catches post-execution C2 beaconing and tool download behaviour that process-launch command-line rules miss."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) with principal.process.file.full_path populated. Windows Event 4688 alone is insufficient for the network leg."
    platform = "Linux, macOS, Windows"
    false_positives = "Legitimate Node.js web applications, Electron-based desktop apps, developer toolchains (npm, webpack), macOS automation scripts using osascript for approved workflows, browser-based update checks spawned via mshta."
    tuning_guidance = "Add approved parent process paths to %global_allowed_js_engines and approved destination CIDRs/IPs to %global_allowed_js_net_destinations. Scope further by excluding known developer workstation hostnames or service account usernames."

  events:
    // Leg 1: A recognised JS engine launches a child process
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(\\|\/)((wscript|cscript|mshta|node|nodejs|osascript|osacompile)(\.exe)?)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_js_engines
    // Capture the child process path so we can join to the network leg
    $proc.target.process.file.full_path = $child_proc_path
    $proc.principal.hostname = $hostname

    // Leg 2: The same child process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $child_proc_path
    $net.principal.hostname = $hostname
    not $net.target.ip in %global_allowed_js_net_destinations
    // Exclude RFC-1918 / loopback to focus on external connections
    not $net.target.ip in %rfc1918_internal

    // Enforce chronological ordering: process launch must precede network event
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $child_proc_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $js_engine_path = array_distinct($proc.principal.process.file.full_path)
    $child_process_paths = array_distinct($proc.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $net
}
