/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:56:58.829512+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Proc_Mem_Map_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read access to /proc/<pid>/mem or /proc/<pid>/maps by a process other than the target process itself, which is the core artifact of proc memory injection on Linux. Adversaries read /proc/[pid]/maps to enumerate memory layout (ASLR offsets, gadgets) and then write to /proc/[pid]/mem or use dd to overwrite the target stack. This rule fires on the FILE_READ event produced by EDR/audit telemetry when a process opens these pseudo-files belonging to a different PID."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR telemetry (e.g., Falco, CrowdStrike Falcon, SentinelOne) or auditd with file-open syscall rules (openat on /proc/*/mem and /proc/*/maps) forwarded to Chronicle as FILE_READ events. Auditd rule example: -a always,exit -F arch=b64 -S openat -F dir=/proc -F key=proc_mem_access"
    platform = "Linux"
    false_positives = "Debuggers (gdb, lldb, strace, ltrace), legitimate profilers (perf, valgrind, heaptrack), container runtimes performing introspection, security agents performing memory scanning, Java/JVM JIT diagnostics, Python multiprocessing forks reading parent maps."
    tuning_guidance = "Add known debugger and profiler paths to %linux_allowed_proc_mem_readers. Add security agent process paths (e.g., CrowdStrike sensor, SentinelOne agent) to the same list. Consider narrowing by requiring the reading process to NOT be a child of the target process. Raise severity if the reading process is a shell or interpreter."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target the /proc/<pid>/mem or /proc/<pid>/maps pseudo-files
    // /proc/<pid>/mem  - direct memory read/write interface
    // /proc/<pid>/maps - virtual memory map (used to enumerate gadgets and ASLR offsets)
    // /proc/<pid>/smaps - extended maps with permissions detail
    $file.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|smaps|smaps_rollup|pagemap)$/ nocase

    // The accessing process must not be a known legitimate memory inspection tool
    not $file.principal.process.file.full_path in %linux_allowed_proc_mem_readers

    // Exclude kernel threads and processes with no path (kthreads show as empty or [kthread])
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /^\[/ nocase

    // Exclude self-inspection: a process reading its own /proc/self/* or its own PID
    // Chronicle EDR typically populates principal.pid; exclude /proc/<own_pid>/
    not $file.target.file.full_path = /\/proc\/self\// nocase

    // Exclude common system monitoring paths that legitimately read proc maps
    not $file.principal.process.file.full_path = /\/(ps|top|htop|atop|glances|sysdig|bpftrace|systemd|dockerd|containerd|runc)$/ nocase

    // Exclude package managers and system update processes
    not $file.principal.process.file.full_path = /\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper|snap|flatpak)$/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $target_proc_path = array_distinct($file.target.file.full_path)
    $accessing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
