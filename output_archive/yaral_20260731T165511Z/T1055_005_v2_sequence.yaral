/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:55:53.246861+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Injection_CrossProcess_Memory_Then_RemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a likely TLS callback injection sequence: a non-system process opens a handle to a remote process (PROCESS_OPEN) and subsequently creates a remote thread (PROCESS_INJECTION) in that target within 5 minutes. TLS callback injection typically requires writing to the target's PE header region and manipulating TLS directory pointers, which necessitates cross-process memory access before thread creation. This rule targets the OS-level mechanism rather than any specific tool name or payload."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., Sysmon Event ID 10 / CrowdStrike process handle grants) and PROCESS_INJECTION events (e.g., Sysmon Event ID 8 CreateRemoteThread). Both event types must be ingested into Chronicle UDM."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), profiling tools (VTune, dotTrace), AV/EDR self-protection modules opening handles to monitored processes, JIT compilers, and some RMM agents that inject helper DLLs."
    tuning_guidance = "Populate %global_allowed_injection_sources with full paths of approved debuggers, profilers, and RMM agent binaries. Populate %global_allowed_injection_targets with paths of processes legitimately targeted by approved tooling (e.g., browser helper processes). Narrow further by excluding known-good parent process trees."

  events:
    // Leg 1: Cross-process handle open - attacker process acquires a handle to a victim process.
    // Pre-filter: exclude common system paths that legitimately open handles at high volume.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path != ""
    not $open.principal.process.file.full_path = /\\(svchost|lsass|csrss|smss|wininit|services|MsMpEng|SenseIr|SenseCncProxy)\.exe$/i nocase
    not $open.principal.process.file.full_path in %global_allowed_injection_sources
    // The target must be a running user-mode process (not the opener itself).
    $open.target.process.file.full_path != ""
    not $open.target.process.file.full_path in %global_allowed_injection_targets
    // Bind the shared join key: the hostname where both events occur.
    $open.principal.hostname = $hostname
    // Bind the attacker process path so we can correlate it to the injection leg.
    $open.principal.process.file.full_path = $attacker_proc_path

    // Leg 2: Remote thread creation in a target process - the injection event.
    // Pre-filter: same attacker process must be the principal.
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = $attacker_proc_path
    not $inj.principal.process.file.full_path in %global_allowed_injection_sources
    $inj.target.process.file.full_path != ""
    not $inj.target.process.file.full_path in %global_allowed_injection_targets
    $inj.principal.hostname = $hostname

    // Chronological ordering: handle open must precede thread injection.
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $attacker_proc_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($hostname)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $target_processes_opened = array_distinct($open.target.process.file.full_path)
    $target_processes_injected = array_distinct($inj.target.process.file.full_path)
    $injecting_pid = array_distinct($open.principal.process.pid)
    $open_event_count = count($open.metadata.id)
    $injection_event_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
