/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:11:55.210201+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Domain_Account_Logon_Then_Lateral_Movement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a domain account interactive or network logon followed by a remote authentication event to a different host within 1 hour, indicating potential lateral movement using compromised domain credentials. Covers Windows, Linux (PAM/SSSD), and macOS environments joined to Active Directory."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Windows Security Event Log (Event IDs 4624, 4648) or equivalent UDM USER_LOGIN events from EDR/SIEM forwarders. Both source and destination host telemetry must be ingested."
    platform = "Windows, Linux, macOS, ESXi"
    false_positives = "Legitimate administrators performing routine remote management, service accounts performing scheduled cross-host operations, RMM tools authenticating on behalf of users, SSO/Kerberos ticket renewals, backup agents."
    tuning_guidance = "Add known service account userids to %global_allowed_service_accounts. Add known admin jump-host hostnames to %global_allowed_admin_sources. Narrow the logon_type filter if your environment uses only specific authentication methods."

  events:
    // First event: domain account logs on to a source host (interactive or network logon)
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid != ""
    // Domain account indicator: UPN format or DOMAIN\user format
    (
      $auth.target.user.userid = /^[^@]+@[^@]+\.[^@]+$/ nocase or
      $auth.target.user.user_display_name = /^[a-zA-Z0-9\-]+\\[a-zA-Z0-9\.\-_]+$/ nocase
    )
    // Exclude local/machine accounts and well-known service accounts
    not $auth.target.user.userid = /\$$/ nocase
    not $auth.target.user.userid = /^(NT AUTHORITY|ANONYMOUS LOGON|LOCAL SERVICE|NETWORK SERVICE)/i nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.hostname in %global_allowed_admin_sources
    $auth.target.hostname != ""
    $auth.target.user.userid = $domain_user
    $auth.target.hostname = $source_host

    // Second event: same domain account authenticates to a DIFFERENT host
    $lateral.metadata.event_type = "USER_LOGIN"
    $lateral.target.user.userid = $domain_user
    $lateral.target.hostname != ""
    // Must be a different destination host than the first logon target
    $lateral.target.hostname != $source_host
    not $lateral.target.user.userid in %global_allowed_service_accounts
    not $lateral.principal.hostname in %global_allowed_admin_sources
    $lateral.target.hostname = $dest_host

    // Chronological ordering: first logon precedes lateral logon
    $auth.metadata.event_timestamp.seconds <= $lateral.metadata.event_timestamp.seconds

  match:
    $domain_user over 1h

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($domain_user)
    $source_hosts = array_distinct($source_host)
    $destination_hosts = array_distinct($dest_host)
    $logon_count = count($lateral.metadata.id)

  condition:
    $auth and $lateral
}
