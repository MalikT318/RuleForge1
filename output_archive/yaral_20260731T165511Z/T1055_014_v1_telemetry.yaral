/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:00:10.391472+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_VDSO_Hijacking_Proc_Mem_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects VDSO hijacking attempts by identifying unexpected processes opening /proc/<pid>/mem for write access, which is the mechanism used to patch the global offset table or VDSO stubs in a live process without ptrace. Legitimate use of /proc/<pid>/mem for write is extremely rare outside of debuggers and specific system tools."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR telemetry that emits FILE_OPEN or FILE_READ events for procfs paths, such as Sysdig Falco, Auditd with file-open syscall rules (openat/open on /proc/*/mem), or an eBPF-based sensor forwarded to Chronicle via the UDM ingestion pipeline."
    platform = "Linux"
    false_positives = "Legitimate debuggers (gdb, lldb, strace), memory sanitizers, JVM/JIT runtimes performing self-inspection, crash dump collectors (breakpad, crashpad), and some container runtimes. Exclude known debugger paths and CI/CD agent paths via the reference lists."
    tuning_guidance = "Add approved debugger and profiler binary paths to %linux_allowed_procmem_readers. Add known CI/CD and monitoring agent paths to %linux_allowed_system_agents. Scope further by correlating with parent process lineage if the EDR provides it."

  events:
    $open.metadata.event_type = "FILE_READ"
    // Target the procfs mem interface used to read/write another process address space
    $open.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase
    // The accessing process must not be a kernel thread (no path) - require a userspace binary path
    $open.principal.process.file.full_path = /^\// nocase
    // Exclude self-reads (pid matches own pid) - approximated by excluding paths that
    // reference the process's own well-known self symlink
    not $open.target.file.full_path = /\/proc\/self\/mem$/ nocase
    // Exclude known legitimate debugger and profiler binaries
    not $open.principal.process.file.full_path in %linux_allowed_procmem_readers
    // Exclude known monitoring and system agents
    not $open.principal.process.file.full_path in %linux_allowed_system_agents
    // Exclude kernel and init paths that legitimately inspect process memory
    not $open.principal.process.file.full_path = /\/(usr\/)?s?bin\/(systemd|init|kthreadd)$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity = array_distinct($open.principal.hostname)
    $accessing_process = array_distinct($open.principal.process.file.full_path)
    $target_mem_path = array_distinct($open.target.file.full_path)
    $actor_userid = array_distinct($open.principal.user.userid)

  condition:
    $open
}
