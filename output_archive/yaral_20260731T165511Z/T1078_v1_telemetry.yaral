/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:10:26.314325+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_Dormant_Account_Interactive_Login_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a SETTING_MODIFICATION event that re-enables or unlocks a previously disabled/locked user account. Adversaries abusing valid accounts frequently reactivate dormant or disabled accounts to establish persistence while evading detection tied to newly created accounts. This rule fires on the resulting identity-store state change rather than on any command-line invocation, providing coverage orthogonal to process-creation rules."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation, Defense Evasion"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires Windows Security Event 4722 (account enabled), 4767 (account unlocked), Active Directory audit logs, Azure AD / Entra ID audit logs, or equivalent IdP audit events forwarded to Chronicle via the relevant ingestion feed. The UDM event_type must be SETTING_MODIFICATION."
    platform = "Windows, Linux, macOS, Identity Provider, SaaS, IaaS"
    false_positives = "Legitimate IT helpdesk re-enabling accounts after password resets or return from leave. Automated provisioning systems (e.g., Workday, ServiceNow ITSM) that re-enable accounts as part of onboarding workflows. Scheduled scripts that manage account lifecycle."
    tuning_guidance = "Populate %global_allowed_account_mgmt_principals with the service accounts and admin principals used by your authorised provisioning and helpdesk tooling. Add known-good target userids (service accounts that are routinely cycled) to %global_allowed_reenabled_accounts. Consider narrowing scope to privileged groups by adding a regex match on target.user.userid for naming conventions used by admin or service accounts."

  events:
    $auth.metadata.event_type = "SETTING_MODIFICATION"

    // Account enable or unlock state change - covers AD 4722/4767 and IdP equivalents
    (
      $auth.target.resource.attribute.labels["account_enabled"] = "true"
      or
      $auth.target.resource.attribute.labels["account_locked"] = "false"
      or
      $auth.security_result.description = /account.*(enabled|unlocked|re-?activated)/i nocase
      or
      $auth.metadata.description = /account.*(enabled|unlocked|re-?activated)/i nocase
    )

    // Target must be a user account object
    $auth.target.user.userid != ""

    // Exclude machine/computer accounts (trailing $) and well-known service identities
    not $auth.target.user.userid = /\$$/ nocase
    not $auth.target.user.userid in %global_allowed_reenabled_accounts

    // Exclude authorised provisioning principals performing the change
    not $auth.principal.user.userid in %global_allowed_account_mgmt_principals

    // Exclude automated system context (e.g., SYSTEM re-enabling its own service accounts)
    not $auth.principal.user.userid = /^(nt authority\\system|system|root)$/i nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($auth.target.user.userid)
    $acting_principal = array_distinct($auth.principal.user.userid)
    $target_hostname = array_distinct($auth.target.hostname)
    $source_hostname = array_distinct($auth.principal.hostname)

  condition:
    $auth
}
