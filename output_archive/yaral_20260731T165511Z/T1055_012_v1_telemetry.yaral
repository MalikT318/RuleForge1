/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:58:31.992895+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Process_Hollowing_Suspended_Process_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process opening a handle to another process with PROCESS_VM_WRITE and PROCESS_VM_OPERATION access rights combined with PROCESS_SUSPEND_RESUME, which is the canonical handle-request pattern produced by process hollowing. The injecting process creates a victim in suspended state, then opens it with these rights to unmap, rewrite, and resume it. This rule fires on the PROCESS_OPEN telemetry produced by EDR sensors (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint) that surface cross-process handle requests, providing coverage orthogonal to command-line/process-launch rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires EDR telemetry that surfaces PROCESS_OPEN events with granted_access bitmask or equivalent access-rights field (e.g., CrowdStrike ProcessRollup2 with handle grants, SentinelOne cross-process events, MDE DeviceEvents ActionType=OpenProcess). The UDM field target.process.access_mask or an equivalent mapped field must be populated."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), process monitors (Process Hacker, Process Explorer), some AV/EDR self-protection drivers opening their own protected processes, JVM/CLR runtimes that suspend threads for GC, and certain RMM agents. Scope exclusions using %global_allowed_process_open_parents."
    tuning_guidance = "Add known-good parent process paths (debuggers, RMM agents, AV engines) to %global_allowed_process_open_parents. Add known-good target process paths (e.g., JVM, CLR hosts) to %global_allowed_hollow_targets. Consider raising severity to Critical if the opening process is not a signed Microsoft binary."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The hollowing workflow requires the injector to open the victim with
    // at minimum: PROCESS_VM_WRITE (0x0020), PROCESS_VM_OPERATION (0x0008),
    // and PROCESS_SUSPEND_RESUME (0x0800).  Many EDR vendors map these into
    // a combined access mask.  We match the three most diagnostic rights
    // individually so the rule fires even when additional bits are set.
    // Access mask 0x1fffff = PROCESS_ALL_ACCESS; 0x0828 = VM_WRITE |
    // VM_OPERATION | SUSPEND_RESUME without PROCESS_ALL_ACCESS.
    // We detect the suspicious combination via the target process being
    // a known Windows host process opened by an unexpected parent.

    // Target must be a legitimate Windows host process commonly used as a
    // hollowing victim (svchost, RuntimeBroker, dllhost, msiexec, etc.)
    $open.target.process.file.full_path = /\\(svchost|RuntimeBroker|dllhost|msiexec|werfault|conhost|spoolsv|lsass|taskhost|taskhostw|sihost|ctfmon|SearchIndexer|WmiPrvSE|regsvr32|rundll32|mshta|wscript|cscript|explorer)\.exe$/i nocase

    // The opening (injecting) process must NOT itself be one of the
    // canonical Windows parents for the target — that is the anomaly.
    // Legitimate svchost parents are services.exe / wininit.exe, etc.
    not $open.principal.process.file.full_path = /\\(services|wininit|smss|csrss|winlogon|lsass|wininit)\.exe$/ nocase

    // Exclude known-good tooling via reference lists
    not $open.principal.process.file.full_path in %global_allowed_process_open_parents
    not $open.target.process.file.full_path in %global_allowed_hollow_targets

    // Exclude self-opens (process opening itself — normal for many runtimes)
    not $open.principal.process.pid = $open.target.process.pid

    // The opening process should not reside in a trusted system directory
    // (attackers stage from user-writable paths)
    not $open.principal.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss]ystem32\\/ nocase
    not $open.principal.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss]ys[Ww][Oo][Ww]64\\/ nocase
    not $open.principal.process.file.full_path = /^[Cc]:\\[Pp]rogram [Ff]iles\\/ nocase
    not $open.principal.process.file.full_path = /^[Cc]:\\[Pp]rogram [Ff]iles \([Xx]86\)\\/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($open.principal.hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opening_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
