/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:07:02.834360+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_CLI_Auth_Then_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a successful interactive login to a network device (SSH/Telnet) followed by a configuration modification event on the same device within 5 minutes. This pattern is consistent with adversaries using the network device CLI to alter startup configuration, disable logging, or manipulate traffic flows after authenticating. Complements existing process-launch CLI command-line rules by correlating authentication telemetry with configuration-change audit events."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Script Interpreter: Network Device CLI"
    log_prerequisites = "Requires network device syslog or SNMP trap ingestion into Chronicle (Cisco IOS/IOS-XE, Juniper Junos, Arista EOS, Palo Alto PAN-OS, or equivalent). Authentication events must surface as USER_LOGIN UDM events. Configuration change events must surface as SETTING_MODIFICATION UDM events. Both event types must carry the device hostname in principal.hostname."
    platform = "Network Devices (Cisco IOS/IOS-XE, Juniper Junos, Arista EOS, Palo Alto PAN-OS)"
    false_positives = "Authorized network engineers performing scheduled maintenance windows. Automated configuration management tools (Ansible, Terraform, NAPALM, Cisco NSO). NOC staff responding to alerts. Change-management-approved firmware upgrades."
    tuning_guidance = "Add authorized management userids to %network_device_allowed_admin_users. Add authorized jump-host or management-plane source IPs to %network_mgmt_plane_sources. Scope %network_device_hostnames to known network infrastructure to avoid matching server or workstation login events. Consider restricting the rule to after-hours windows if maintenance is always scheduled."

  events:
    // Leg 1: Successful interactive login to a network device via SSH or Telnet
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $device_hostname
    // Restrict to network-device management protocols only
    (
      $auth.network.application_protocol = "SSH" or
      $auth.network.application_protocol = "TELNET"
    )
    // Exclude known authorized management source IPs
    not $auth.principal.ip in %network_mgmt_plane_sources
    // Exclude known authorized admin accounts
    not $auth.target.user.userid in %network_device_allowed_admin_users
    // Restrict to known network device hostnames to avoid Cartesian explosion
    $auth.principal.hostname in %network_device_hostnames

    // Leg 2: Configuration modification on the same device after the login
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname = $device_hostname
    // Restrict to known network device hostnames on both sides
    $cfg.principal.hostname in %network_device_hostnames
    // Exclude changes made by known authorized admin accounts
    not $cfg.principal.user.userid in %network_device_allowed_admin_users

    // Chronological ordering: login must precede the config change
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $device_hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($auth.principal.hostname)
    $authenticating_user = array_distinct($auth.target.user.userid)
    $source_ip = array_distinct($auth.principal.ip)
    $auth_protocol = array_distinct($auth.network.application_protocol)
    $config_change_count = count($cfg.metadata.id)
    $changed_setting = array_distinct($cfg.target.resource.name)
    $cfg_actor = array_distinct($cfg.principal.user.userid)

  condition:
    $auth and $cfg
}
