/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:01:46.272078+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_Script_Artifact_Drop_In_Sensitive_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of script artifacts (PowerShell, VBScript, JScript, Python, Bash, batch) in sensitive or unusual filesystem locations such as temp directories, user profile roots, ProgramData, and web-accessible paths. Attackers staging or dropping scripts for later execution leave a file artifact that is harder to suppress than command-line telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires EDR file telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11) reporting FILE_CREATION or FILE_MODIFICATION with target.file.full_path populated."
    platform = "Windows, Linux, macOS"
    false_positives = "Software installers writing legitimate scripts to temp directories, developer toolchains (npm, pip, conda), RMM agents deploying scripts, CI/CD pipeline runners, configuration management tools (Ansible, Chef, Puppet)."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_script_writers. Add approved staging directories to %global_allowed_script_staging_paths. Consider raising severity if the writing process is a browser, document reader, or email client."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Script file extensions covering major interpreter families
    $file.target.file.full_path = /\.(ps1|psm1|psd1|vbs|vbe|js|jse|wsf|wsh|hta|bat|cmd|sh|bash|zsh|py|pyw|rb|pl|php|lua)$/ nocase

    // Sensitive or attacker-favoured staging paths (Windows and Unix)
    (
      // Windows temp and user-writable locations
      $file.target.file.full_path = /\\(temp|tmp)\\/  nocase or
      $file.target.file.full_path = /\\AppData\\(Local|Roaming|LocalLow)\\/  nocase or
      $file.target.file.full_path = /\\ProgramData\\/  nocase or
      $file.target.file.full_path = /\\Users\\[^\\]+\\(Desktop|Downloads|Documents|Music|Videos|Pictures)\\/  nocase or
      $file.target.file.full_path = /\\Windows\\(Temp|Tasks|System32\\Tasks)\\/  nocase or
      $file.target.file.full_path = /\\inetpub\\/  nocase or
      $file.target.file.full_path = /\\wwwroot\\/  nocase or
      // Linux / macOS world-writable and staging paths
      $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\//  nocase or
      $file.target.file.full_path = /^\/home\/[^\/]+\/(\.config|\.local|Downloads|Desktop)\//  nocase or
      $file.target.file.full_path = /^\/(var\/www|srv\/www|opt\/lampp)\//  nocase or
      $file.target.file.full_path = /^\/private\/tmp\//  nocase
    )

    // Exclude known-good script-writing processes via reference list
    not $file.principal.process.file.full_path in %global_allowed_script_writers

    // Exclude known-good staging paths approved per environment
    not $file.target.file.full_path in %global_allowed_script_staging_paths

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($file.principal.hostname)
    $script_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
