/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:58:02.217092+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_OpenHandle_Then_RemoteWrite {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process opening a handle to a remote process (PROCESS_OPEN) followed by a cross-process memory write (PROCESS_INJECTION) on the same host within 5 minutes. This sequence is consistent with Extra Window Memory (EWM) injection where an attacker opens a target process, writes shellcode into a shared section, then plants a pointer in EWM to redirect execution. Additive coverage over existing PROCESS_LAUNCH / command-line rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., Sysmon Event ID 10 / CrowdStrike process handle telemetry) and PROCESS_INJECTION events (e.g., Sysmon Event ID 8 CreateRemoteThread or equivalent EDR write-process-memory telemetry)."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), AV/EDR self-protection handles, JIT compilers (Java, .NET CLR), RMM agents performing process inspection, and some DRM software."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_process_open_sources. Add known-good target process paths to %global_allowed_injection_targets. Narrow scope further by excluding processes whose principal.user.userid matches service accounts in %global_service_account_exclusions."

  events:
    // Leg 1: A non-privileged or unexpected process opens a handle to a remote process.
    // PROCESS_OPEN is emitted by EDRs when OpenProcess() is called targeting another PID.
    $open.metadata.event_type = "PROCESS_OPEN"
    // Exclude processes that are well-known legitimate handle openers
    not $open.principal.process.file.full_path in %global_allowed_process_open_sources
    // Exclude self-opens (process opening itself is benign)
    $open.principal.process.pid != $open.target.process.pid
    // Anchor the join on the hostname
    $open.principal.hostname = $hostname
    // Capture the opening process path for outcome enrichment
    $open.principal.process.file.full_path = $opener_path

    // Leg 2: A cross-process memory write / injection event on the same host,
    // originating from the same process that performed the handle open.
    $inj.metadata.event_type = "PROCESS_INJECTION"
    not $inj.principal.process.file.full_path in %global_allowed_process_open_sources
    not $inj.target.process.file.full_path in %global_allowed_injection_targets
    $inj.principal.hostname = $hostname
    // The injecting process must be the same binary that opened the handle
    $inj.principal.process.file.full_path = $opener_path

    // Chronological ordering: handle open must precede the memory write
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $opener_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $target_process = array_distinct($inj.target.process.file.full_path)
    $injecting_user = array_distinct($inj.principal.user.userid)
    $open_event_count = count($open.metadata.id)
    $inj_event_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
