/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:06:06.779125+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_JS_Dropper_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation of JavaScript-based execution artifacts (WSF, HTA, JSE, JXA compiled scripts) in user-writable or temporary directories. Adversaries staging or dropping these files represent a state change that is harder to evade than command-line logging. Covers JScript (Windows), WSH scripts, and JXA compiled artifacts (macOS)."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires EDR file telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11). File creation events must include full target path."
    platform = "Linux, macOS, Windows"
    false_positives = "Web development toolchains writing build artifacts, Node.js package managers (npm/yarn) extracting modules, legitimate software installers dropping HTA setup wizards, macOS Automator workflows compiling JXA applets."
    tuning_guidance = "Add known-good parent process paths (e.g., installer engines, IDE processes) to %global_allowed_js_dropper_parents. Add approved staging directories to %global_allowed_js_staging_dirs. Consider raising severity if the creating process is a browser, document reader, or email client."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match JavaScript-family execution artifact extensions
    // Covers: .js (bare), .jse (encoded JScript), .wsf (Windows Script File),
    //         .hta (HTML Application), .scpt (compiled JXA/AppleScript bundle),
    //         .app bundles compiled via osacompile, .wsh (WSH config)
    $file.target.file.full_path = /\.(js|jse|wsf|hta|wsh|scpt)$/i nocase

    // Restrict to high-risk writable locations across all three platforms:
    // Windows: %TEMP%, %APPDATA%, %PUBLIC%, Downloads, user profile root
    // macOS:   /tmp, /var/folders, ~/Library/Application Support, ~/Downloads
    // Linux:   /tmp, /var/tmp, /dev/shm, home subdirs
    $file.target.file.full_path = /(\\Temp\\|\\AppData\\|\\Downloads\\|\\Public\\|\/tmp\/|\/var\/tmp\/|\/var\/folders\/|\/dev\/shm\/|\/Downloads\/|Library\/Application Support\/)/ nocase

    // Exclude known-good parent processes (build tools, package managers, IDEs)
    not $file.principal.process.file.full_path in %global_allowed_js_dropper_parents

    // Exclude known-good staging directories (e.g., approved software depots)
    not $file.target.file.full_path in %global_allowed_js_staging_dirs

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
