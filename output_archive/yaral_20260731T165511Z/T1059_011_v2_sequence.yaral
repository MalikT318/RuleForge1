/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:08:48.344728+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Exec_Then_Network_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Lua interpreter process that launches and subsequently makes an outbound network connection within 5 minutes. This pattern is additive to command-line detection and targets the post-execution network behaviour that indicates C2 beaconing, data exfiltration, or tool download following Lua-based execution. Covers both standalone lua/lua5.x interpreters and embedded Lua runtimes."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) with process context on the network event. Both events must carry principal.hostname for correlation."
    platform = "Linux, Windows, macOS"
    false_positives = "Game engines (e.g. World of Warcraft, Roblox clients), embedded Lua in monitoring agents (e.g. Datadog, Fluentd), network device management tools, legitimate automation scripts using LuaSocket, CI/CD pipeline test runners."
    tuning_guidance = "Add known-good Lua parent processes to %lua_allowed_parent_processes. Add approved internal destinations to %lua_allowed_egress_hosts. Add sanctioned Lua binary paths to %lua_approved_interpreter_paths. Narrow the time window if false-positive rate is high in environments with frequent Lua-based tooling."

  events:
    // Event 1: Lua interpreter process launch
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(lua[0-9.]*|luajit|luac)$/ nocase
    not $proc.target.process.file.full_path in %lua_approved_interpreter_paths
    not $proc.principal.process.file.full_path in %lua_allowed_parent_processes
    $proc.principal.hostname = $hostname

    // Event 2: Outbound network connection from a Lua-related process
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(lua[0-9.]*|luajit|luac)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %lua_allowed_egress_hosts
    $net.principal.hostname = $hostname

    // Chronological ordering: process launch must precede network connection
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $lua_binary_path = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hostnames = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $proc and $net
}
