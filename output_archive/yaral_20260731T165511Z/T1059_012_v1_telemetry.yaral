/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:09:09.325996+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Hypervisor_CLI_Config_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of ESXi hypervisor configuration artifacts that are commonly manipulated by adversaries abusing esxcli or vim-cmd. Attackers using hypervisor CLIs frequently alter firewall rules, log forwarding configuration, VM state files, or persistent configuration stores. This rule targets the resulting file-system state change rather than the command line, providing coverage when process telemetry is suppressed or evaded."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "Requires ESXi file-integrity or audit telemetry forwarded to Chronicle (e.g., via VMware vSphere syslog, Carbon Black Cloud for ESXi, or a compatible EDR agent that surfaces FILE_CREATION / FILE_MODIFICATION UDM events from ESXi hosts)."
    platform = "ESXi"
    false_positives = "Legitimate administrator changes to firewall rules or log forwarding via vCenter/vSphere UI (which also invokes esxcli internally); automated configuration management tools (Ansible, Puppet) managing ESXi hosts; VMware Update Manager applying patches; backup agents writing to /vmfs/."
    tuning_guidance = "Add known-good management hostnames or service accounts to %esxi_allowed_config_principals. Narrow the path regex if only specific config directories are relevant in your environment. Consider pairing with a time-of-day condition if changes outside maintenance windows are the primary concern."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target the ESXi configuration and state directories most commonly
    // manipulated via hypervisor CLIs. Covers:
    //   /etc/vmware/firewall/   - firewall ruleset XML files
    //   /etc/vmware/            - general ESXi config (syslog.conf, etc.)
    //   /var/run/vmware/        - runtime state files modified by vim-cmd
    //   /vmfs/volumes/          - datastore-level VM config (.vmx, .vmsd)
    //   /scratch/log/           - log forwarding configuration
    (
      $file.target.file.full_path = /^\/etc\/vmware\/(firewall|ssl|vmkiscsid|pam\.d|syslog\.conf|logging\.conf)/ nocase or
      $file.target.file.full_path = /^\/etc\/vmware\/firewall\/[^\/]+\.xml$/ nocase or
      $file.target.file.full_path = /^\/var\/run\/vmware\// nocase or
      $file.target.file.full_path = /^\/vmfs\/volumes\/[^\/]+\/[^\/]+\/[^\/]+\.(vmx|vmsd|vmxf|nvram)$/ nocase or
      $file.target.file.full_path = /^\/scratch\/log\// nocase or
      $file.target.file.full_path = /^\/etc\/rc\.local\.d\// nocase
    )

    // Exclude writes originating from known VMware system daemons that
    // legitimately own these paths during normal hypervisor operation.
    not $file.principal.process.file.full_path = /\/(hostd|vpxa|vmkiscsid|sfcbd|rhttpproxy|vmsyslogd|vmware-fdm)$/ nocase

    // Exclude writes from known-good management principals supplied per tenant.
    not $file.principal.user.userid in %esxi_allowed_config_principals

    // Exclude writes from known-good management host paths.
    not $file.principal.process.file.full_path in %esxi_allowed_config_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
