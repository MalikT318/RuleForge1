/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:58:57.023997+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Hollowed_Process_Anomalous_Network_After_Suspend {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a hallmark of process hollowing: a legitimate Windows binary is launched suspended (PROCESS_OPEN targeting a known-good host process) and then that same process makes an outbound network connection shortly after. The combination of a cross-process handle acquisition followed by unexpected network activity from a normally non-networking binary is a strong behavioral indicator of a hollowed process being used as a network beachhead."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires EDR telemetry that logs PROCESS_OPEN (cross-process handle) events and NETWORK_CONNECTION events with process context. Sysmon EventID 10 (ProcessAccess) and EventID 3 (NetworkConnect) satisfy this. CrowdStrike Falcon and SentinelOne also emit equivalent UDM events."
    platform = "Windows"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg) opening handles to child processes. Software update agents that spawn helper processes. JIT compilers (CLR, JVM) that manipulate child process memory. Crash-reporting tools. Security products performing process inspection."
    tuning_guidance = "Add known-safe parent processes (e.g. Visual Studio devenv.exe, JetBrains IDEs, crash reporters) to %hollowing_allowed_openers. Add known-safe network-capable binaries that may be legitimately hollowed by benign tooling to %hollowing_allowed_network_hosts. Scope by environment: developer workstations will generate more FPs than servers."

  events:
    // Leg 1: A process opens a handle to a victim process that is a known
    // Windows host binary (these are the canonical hollowing targets because
    // they are signed, trusted, and blend in). PROCESS_OPEN captures the
    // cross-process handle acquisition that precedes memory unmapping.
    $open.metadata.event_type = "PROCESS_OPEN"
    // Target must be a canonical hollowing victim: a signed Windows binary
    // that would normally not initiate network connections on its own.
    $open.target.process.file.full_path = /\\(svchost|RuntimeBroker|dllhost|taskhost|taskhostw|werfault|SearchIndexer|spoolsv|lsass|services|explorer|notepad|calc|mspaint|msiexec|regsvr32|rundll32|wscript|cscript|conhost|sihost|ctfmon)\.exe$/ nocase
    // The opener must NOT be a known-safe system parent (e.g. services.exe
    // legitimately opens svchost). Exclude the most common benign openers.
    not $open.principal.process.file.full_path = /\\(services|wininit|smss|csrss|lsass|svchost|MsMpEng|SenseIR|SenseCncProxy|CylanceSvc|CbDefense|falconctl|bdagent)\.exe$/ nocase
    not $open.principal.process.file.full_path in %hollowing_allowed_openers
    $open.principal.hostname = $hostname

    // Leg 2: The same victim binary (now hollowed) makes an outbound network
    // connection. We match on the target process path to tie back to the
    // same binary that was opened in leg 1.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    // The networking process must be one of the same canonical victim binaries.
    $net.principal.process.file.full_path = /\\(svchost|RuntimeBroker|dllhost|taskhost|taskhostw|werfault|SearchIndexer|spoolsv|lsass|services|explorer|notepad|calc|mspaint|msiexec|regsvr32|rundll32|wscript|cscript|conhost|sihost|ctfmon)\.exe$/ nocase
    // Exclude RFC-1918 and loopback to focus on external C2 connections.
    // svchost legitimately connects internally; external connections are suspicious.
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %hollowing_allowed_network_hosts
    $net.principal.hostname = $hostname

    // Chronological ordering: handle acquisition must precede network activity.
    $open.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $open and $net
}
