/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:10:42.973946+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_Valid_Account_Auth_Then_Impossible_Travel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a successful authentication from one source IP followed by a second successful authentication for the same user from a different source IP within 1 hour - a classic impossible-travel / credential-sharing signal indicative of compromised valid accounts. Targets the authentication event layer rather than process creation, providing additive coverage for T1078 across cloud, SaaS, VPN, and on-premises identity providers."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation, Defense Evasion"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires USER_LOGIN events with principal.user.userid and principal.ip populated. Compatible with Azure AD / Entra ID, Okta, Google Workspace, Windows Security Event 4624, and VPN/firewall authentication logs forwarded to Chronicle."
    platform = "Windows, Linux, macOS, IaaS, SaaS, Identity Provider, Network Devices, Office Suite"
    false_positives = "VPN split-tunneling causing IP churn, corporate NAT pools with multiple egress IPs, mobile users switching between Wi-Fi and cellular, shared service accounts used by automation from multiple hosts, load-balanced authentication proxies presenting different source IPs."
    tuning_guidance = "Add known multi-IP service account userids to %global_allowed_shared_accounts. Add known NAT egress ranges or authentication proxy CIDRs to %global_allowed_auth_proxy_ips. Raise risk_score threshold in SOAR if the two IPs resolve to the same ASN or country."

  events:
    // First authentication event - anchor
    $auth1.metadata.event_type = "USER_LOGIN"
    $auth1.principal.user.userid != ""
    $auth1.principal.ip != ""
    not $auth1.principal.user.userid in %global_allowed_shared_accounts
    not $auth1.principal.ip in %global_allowed_auth_proxy_ips

    // Second authentication event - must be same user, different source IP
    $auth2.metadata.event_type = "USER_LOGIN"
    $auth2.principal.user.userid != ""
    $auth2.principal.ip != ""
    not $auth2.principal.user.userid in %global_allowed_shared_accounts
    not $auth2.principal.ip in %global_allowed_auth_proxy_ips

    // Join on the same user identity
    $auth1.principal.user.userid = $userid

    $auth2.principal.user.userid = $userid

    // The two events must originate from different source IPs
    $auth1.principal.ip != $auth2.principal.ip

    // Enforce chronological ordering - auth1 precedes auth2
    $auth1.metadata.event_timestamp.seconds <= $auth2.metadata.event_timestamp.seconds

  match:
    $userid over 1h

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($userid)
    $first_source_ip = array_distinct($auth1.principal.ip)
    $second_source_ip = array_distinct($auth2.principal.ip)
    $auth_event_count = count($auth2.metadata.event_timestamp.seconds)
    $target_resources = array_distinct($auth2.target.resource.name)

  condition:
    $auth1 and $auth2
}
