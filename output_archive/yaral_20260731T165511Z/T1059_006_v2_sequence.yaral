/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:05:49.652741+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_Python_Spawns_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Python interpreter spawning a child process (shell or system utility) which subsequently makes an outbound network connection. This sequence is characteristic of Python-based downloaders, reverse shells, and post-exploitation frameworks that use Python to stage additional tooling. Variant 2 of 2 for T1059.006 - additive coverage beyond command-line argument inspection."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) with process context populated on the network event. Tested against CrowdStrike Falcon, SentinelOne, and Carbon Black Cloud UDM feeds."
    platform = "ESXi, Linux, macOS, Windows"
    false_positives = "Legitimate Python-based automation tools (Ansible, Fabric, SaltStack) that invoke shell helpers and make outbound API calls. CI/CD pipeline agents running Python build scripts. Package managers (pip) fetching dependencies. Data science notebooks (Jupyter) executing system commands."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_python_parents. Add approved internal orchestration hosts to %python_allowed_orchestration_hosts. Add approved destination CIDR ranges or IPs to %python_allowed_egress_destinations. Narrow the child process regex if only specific shells are seen in your environment."

  events:
    // Leg 1: Python interpreter launches a child process (shell, curl, wget, or similar utility)
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(python[23]?|python\d+\.\d+)$/ nocase
    $proc.target.process.file.full_path = /(\/|\\)(sh|bash|zsh|dash|ksh|cmd\.exe|powershell\.exe|pwsh\.exe|curl|wget|busybox)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_python_parents
    not $proc.principal.hostname in %python_allowed_orchestration_hosts
    $proc.principal.hostname = $hostname

    // Leg 2: The spawned child process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(\/|\\)(sh|bash|zsh|dash|ksh|cmd\.exe|powershell\.exe|pwsh\.exe|curl|wget|busybox)$/ nocase
    not $net.target.ip in %python_allowed_egress_destinations
    $net.target.port > 0
    $net.principal.hostname = $hostname

    // Enforce chronological ordering: process launch must precede network connection
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $python_binary = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.target.ip)

  condition:
    $proc and $net
}
