/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:55:32.322705+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Injection_Process_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious cross-process handle acquisition with VM_WRITE and VM_OPERATION access rights, a prerequisite for TLS callback injection. Attackers must open a handle to the target process with these rights before manipulating PE memory structures to redirect TLS callbacks. This rule fires on the PROCESS_OPEN event rather than command-line telemetry, providing a lower-level and harder-to-evade signal."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with requested access rights (e.g., CrowdStrike Falcon, Microsoft Defender for Endpoint, Carbon Black, Sysmon Event ID 10). The access_mask or equivalent field must be populated. Chronicle UDM field: target.process.access_mask or security_result.rule_labels."
    platform = "Windows"
    false_positives = "Debuggers (WinDbg, x64dbg, Visual Studio), legitimate process monitoring tools, AV/EDR self-protection, RMM agents performing process inspection, crash dump utilities (ProcDump), and software installers that inject into running processes for patching."
    tuning_guidance = "Populate %global_allowed_process_openers with full paths of approved debuggers, RMM agents, and AV/EDR binaries. Populate %global_allowed_target_processes with paths of processes that are legitimately opened by admin tooling. Narrow scope further by correlating with unusual parent lineage or non-standard install paths."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must NOT be a known system process performing legitimate cross-process work.
    // Match processes opening from non-standard or user-writable locations.
    // Legitimate system openers (lsass, csrss, services.exe) are excluded via reference list.
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Target should be a running host process - exclude self-opens and kernel paths.
    // Attackers target long-lived host processes (explorer, svchost, etc.) for TLS injection.
    $open.target.process.file.full_path != ""
    not $open.target.process.file.full_path in %global_allowed_target_processes

    // Opener originates from a user-writable or non-standard path, a strong signal of
    // a dropped/injected binary performing the handle request.
    // Match paths under Users, Temp, AppData, ProgramData, or with no fixed install root.
    $open.principal.process.file.full_path = /\\(users|temp|tmp|appdata|programdata|downloads|public)\\/ nocase

    // The target process should be a commonly abused host process for injection.
    // Broad regex to catch svchost, explorer, lsass, RuntimeBroker, etc.
    $open.target.process.file.full_path = /\\(svchost|explorer|lsass|RuntimeBroker|dllhost|taskhost|taskhostw|spoolsv|winlogon|csrss|wininit|services)\.exe$/ nocase

    // Exclude cases where opener and target are the same binary (self-open is benign).
    $open.principal.process.file.full_path != $open.target.process.file.full_path

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opener_pid = array_distinct($open.principal.process.pid)
    $target_pid = array_distinct($open.target.process.pid)

  condition:
    $open
}
