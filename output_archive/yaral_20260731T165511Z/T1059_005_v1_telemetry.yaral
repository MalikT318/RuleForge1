/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:04:54.272192+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_VBScript_File_Drop_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of VBScript (.vbs/.vbe) and HTA files in user-writable or suspicious directories. Adversaries frequently drop VBScript payloads to disk as a staging step before execution. This rule targets the file artifact rather than the process launch, providing coverage when command-line logging is absent or evaded."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires EDR file telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11). FILE_CREATION and FILE_MODIFICATION events must be ingested into Chronicle."
    platform = "Windows"
    false_positives = "Legitimate software installers that drop .vbs helper scripts, Group Policy logon/logoff scripts written to SYSVOL, RMM agents that deploy VBScript-based inventory collectors, developer workstations authoring VBScript intentionally."
    tuning_guidance = "Add known-good parent process paths (e.g., installer engines, RMM agents) to %global_allowed_vbs_writers. Add approved directories (e.g., SYSVOL, software staging paths) to %global_allowed_vbs_directories. Consider reducing severity to Medium on endpoints where scripting is common."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target VBScript, encoded VBScript, and HTA file extensions
    $file.target.file.full_path = /\.(vbs|vbe|hta)$/i nocase

    // Focus on user-writable and commonly abused staging locations:
    // %TEMP%, %APPDATA%, %LOCALAPPDATA%, %PUBLIC%, Downloads, Desktop,
    // root of C:\, ProgramData (non-standard subdirs), and WebDAV/network paths
    $file.target.file.full_path = /(\\Temp\\|\\AppData\\|\\ProgramData\\|\\Users\\Public\\|\\Downloads\\|\\Desktop\\|\\Windows\\Temp\\|^[A-Za-z]:\\[^\\]+\.(vbs|vbe|hta)$)/ nocase

    // Exclude known-good writer processes (e.g., Group Policy, SYSVOL replication)
    not $file.principal.process.file.full_path in %global_allowed_vbs_writers

    // Exclude known-good directories (e.g., SYSVOL, approved software staging)
    not $file.target.file.full_path in %global_allowed_vbs_directories

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
