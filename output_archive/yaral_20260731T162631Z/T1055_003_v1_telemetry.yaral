/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:29:01.889084+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_Process_Open_Suspicious_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where a process acquires a handle to another process with rights consistent with thread execution hijacking (OpenThread/SuspendThread/WriteProcessMemory/ResumeThread chain). The handle request itself is the state change that is harder to evade than command-line logging. Suspicious openers are non-system processes opening handles to processes they would not normally need to manipulate."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR telemetry that records PROCESS_OPEN events with target process path and principal process path (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint via MDE advanced hunting forwarded to Chronicle, or Sysmon Event ID 10 with GrantedAccess). The principal.process.file.full_path and target.process.file.full_path fields must be populated."
    platform = "Windows"
    false_positives = "Debuggers (WinDbg, x64dbg, Visual Studio devenv), legitimate AV/EDR self-protection handles, crash-reporting agents (WerFault), process monitoring tools (Process Explorer, Process Hacker), JIT compilers opening their own child processes."
    tuning_guidance = "Add known-good opener paths to %global_allowed_process_openers (e.g., debuggers, AV engines, RMM agents). Add known-good target process paths to %global_allowed_process_open_targets. Narrow scope further by restricting to non-system32 openers if noise is high."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // Opener is NOT a known Windows system binary - lives outside system32/syswow64/sysmon paths
    // Regex intentionally broad to catch renamed binaries by excluding only the OS-managed directories
    not $proc.principal.process.file.full_path = /\\(windows\\system32|windows\\syswow64|windows\\winsxs|program files\\windows defender|program files \(x86\)\\windows defender)/i nocase

    // Opener is not an empty/unpopulated path (avoids noisy kernel events)
    $proc.principal.process.file.full_path = /.+/ nocase

    // Target is a high-value process - a legitimate process whose thread context
    // would be useful to hijack for privilege or stealth purposes
    $proc.target.process.file.full_path = /\\(lsass|svchost|explorer|winlogon|csrss|services|spoolsv|taskhost|taskhostw|RuntimeBroker|SearchIndexer|dllhost|wininit|smss)\.exe$/i nocase

    // Opener itself is not one of the blessed high-value system processes opening peers
    not $proc.principal.process.file.full_path = /\\(lsass|svchost|csrss|wininit|smss|services)\.exe$/i nocase

    // Exclude known-good opener paths supplied per-customer via reference list
    not $proc.principal.process.file.full_path in %global_allowed_process_openers

    // Exclude known-good target paths if a customer has a legitimate tool that opens these
    not $proc.target.process.file.full_path in %global_allowed_process_open_targets

    // Exclude paths that are clearly under Program Files for signed vendor software
    // (tunable - remove if vendor EDR/AV opens these targets legitimately in your env)
    not $proc.principal.process.file.full_path = /\\program files(\\| \(x86\)\\)(symantec|mcafee|sophos|crowdstrike|sentinelone|cylance|carbon black|trend micro|kaspersky|bitdefender|eset|malwarebytes)/i nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
