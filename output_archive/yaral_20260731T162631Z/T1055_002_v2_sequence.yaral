/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:28:39.638733+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_ProcessOpen_Then_RemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the two-stage behavioral signature of PE injection: a process opening a handle to a remote process (PROCESS_OPEN) followed by a remote thread creation event (PROCESS_INJECTION) in the same victim process within 5 minutes. This covers the VirtualAllocEx/WriteProcessMemory/CreateRemoteThread pattern without relying on command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events for cross-process handle acquisition and PROCESS_INJECTION events for remote thread creation (e.g., CrowdStrike Falcon, SentinelOne, Microsoft Defender for Endpoint via Chronicle ingestion)."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg), profilers (VTune, dotTrace), AV/EDR self-protection modules, JIT compilers (CLR, V8), and RMM agents that inject helper DLLs. Tune using the exclusion lists below."
    tuning_guidance = "Add known-good injecting process paths to %global_allowed_injection_sources. Add known-good victim process paths to %global_allowed_injection_targets. Consider raising severity to Critical when the victim process is a high-value target such as lsass.exe or winlogon.exe."

  events:
    // Stage 1: Attacker process opens a handle to a remote (victim) process.
    // Narrowly pre-filtered: exclude self-opens and known-good tooling.
    $proc_open.metadata.event_type = "PROCESS_OPEN"
    $proc_open.principal.process.file.full_path != ""
    $proc_open.target.process.file.full_path != ""
    // Exclude self-open (process opening itself - normal for many runtimes)
    $proc_open.principal.process.file.full_path != $proc_open.target.process.file.full_path
    // Exclude known-good injecting processes (debuggers, AV, RMM)
    not $proc_open.principal.process.file.full_path in %global_allowed_injection_sources
    // Exclude known-good victim processes that are routinely opened by legitimate tools
    not $proc_open.target.process.file.full_path in %global_allowed_injection_targets
    // Bind the victim process path as the join key
    $proc_open.target.process.file.full_path = $victim_process_path
    // Bind the host as the second join key to prevent cross-host false joins
    $proc_open.principal.hostname = $hostname

    // Stage 2: Remote thread / injection event targeting the same victim process path
    // on the same host, occurring after the handle acquisition.
    $injection.metadata.event_type = "PROCESS_INJECTION"
    $injection.principal.process.file.full_path != ""
    $injection.target.process.file.full_path != ""
    // Exclude known-good injecting processes
    not $injection.principal.process.file.full_path in %global_allowed_injection_sources
    // Exclude known-good victim processes
    not $injection.target.process.file.full_path in %global_allowed_injection_targets
    // Join on victim process path: same binary is being injected into
    $injection.target.process.file.full_path = $victim_process_path
    // Join on host
    $injection.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the injection event
    $proc_open.metadata.event_timestamp.seconds <= $injection.metadata.event_timestamp.seconds

  match:
    $hostname, $victim_process_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($hostname)
    $injecting_process = array_distinct($injection.principal.process.file.full_path)
    $victim_process = array_distinct($injection.target.process.file.full_path)
    $injecting_process_pid = array_distinct($injection.principal.process.pid)
    $victim_process_pid = array_distinct($injection.target.process.pid)
    $open_event_count = count($proc_open.metadata.event_timestamp.seconds)
    $injection_event_count = count($injection.metadata.event_timestamp.seconds)

  condition:
    $proc_open and $injection
}
