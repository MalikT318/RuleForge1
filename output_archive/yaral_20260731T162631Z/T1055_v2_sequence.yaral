/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:27:09.624873+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_ProcessInjection_OpenThenRemoteWrite {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a classic cross-process injection sequence: a process opens a handle to a remote process (PROCESS_OPEN) and, within 5 minutes on the same host, a network connection originates from the victim process rather than the injector. This catches the post-injection C2 beacon pattern where the injected shellcode communicates out through the hijacked process, providing additive coverage beyond command-line heuristics."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., Sysmon EventID 10 / CrowdStrike process handle telemetry) AND network connection telemetry. The PROCESS_OPEN event must populate principal.process.file.full_path (injector) and target.process.file.full_path (victim)."
    platform        = "Windows, Linux, macOS"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg, gdb, lldb), JVM/CLR runtimes attaching to child processes, RMM agents performing process inspection, AV/EDR self-protection hooks, crash-reporting tools (WerFault, Breakpad), and profiling tools (dotTrace, VTune)."
    tuning_guidance = "Add known-good injector paths (debuggers, RMM agents, AV binaries) to %global_allowed_process_open_sources. Add known-good victim processes that legitimately receive external connections to %global_allowed_injected_process_net. Narrow further by restricting target.ip to non-RFC1918 ranges if internal beaconing is not a concern."

  events:
    // Leg 1: A process opens a handle to a DIFFERENT process on the same host.
    // Narrow pre-filter: exclude self-opens and known-safe openers.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path != ""
    $open.target.process.file.full_path != ""
    // Injector and victim must be distinct binaries
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    // Exclude known-safe openers (debuggers, RMM, AV) via reference list
    not $open.principal.process.file.full_path in %global_allowed_process_open_sources
    // Capture the victim process path as a join key
    $open.target.process.file.full_path = $victim_proc_path
    $open.principal.hostname = $hostname

    // Leg 2: A network connection originates from the SAME binary that was the
    // victim of the handle-open above, on the same host.
    // This is the post-injection beacon: the injected code communicates through
    // the hijacked process rather than the injector itself.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $victim_proc_path
    $net.principal.hostname = $hostname
    // Exclude known-good processes that legitimately make external connections
    not $net.principal.process.file.full_path in %global_allowed_injected_process_net
    // Target port must be a plausible C2 port (exclude ephemeral loopback noise)
    $net.target.port > 0
    // Exclude loopback to reduce intra-host IPC false positives
    not $net.target.ip = "127.0.0.1"
    not $net.target.ip = "::1"

    // Chronological ordering: handle open must precede the network connection
    $open.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $victim_proc_path over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1055")
    $primary_entity      = array_distinct($net.principal.hostname)
    $injector_process    = array_distinct($open.principal.process.file.full_path)
    $victim_process      = array_distinct($net.principal.process.file.full_path)
    $destination_ips     = array_distinct($net.target.ip)
    $destination_ports   = array_distinct($net.target.port)

  condition:
    $open and $net
}
