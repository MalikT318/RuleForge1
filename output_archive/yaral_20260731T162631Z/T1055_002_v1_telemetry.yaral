/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:28:21.138488+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_Process_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious cross-process handle acquisition consistent with PE injection preparation. Adversaries performing T1055.002 must open a handle to the target process with PROCESS_VM_WRITE and PROCESS_CREATE_THREAD access rights before calling VirtualAllocEx/WriteProcessMemory/CreateRemoteThread. This rule fires on PROCESS_OPEN events where a non-privileged or unexpected process requests write+execute access into another process, which is the prerequisite state change that precedes the actual injection and is harder to suppress than command-line telemetry."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR telemetry that records PROCESS_OPEN events with requested access masks (e.g., CrowdStrike Falcon, Microsoft Defender for Endpoint, Carbon Black, Sysmon Event ID 10). The principal.process and target.process fields must be populated. Access mask should surface in security_result.description or a mapped UDM field."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), profiling tools (VTune, dotTrace), AV/EDR self-protection hooks opening handles to monitored processes, RMM agents performing memory inspection, and some DRM software. Exclude known-good tooling via reference lists."
    tuning_guidance = "Populate %global_allowed_process_open_sources with full paths of approved debuggers, profilers, and RMM agents. Populate %global_allowed_process_open_targets with paths of processes that legitimately receive cross-process handles (e.g., monitoring daemons). Narrow scope further by restricting to cases where the principal process parent is an interactive user shell rather than a system service."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // The requesting (injector) process must NOT be a known system component
    // performing routine cross-process operations. Exclude core Windows processes
    // that legitimately open handles to children (e.g., csrss, werfault, lsass self-open).
    not $proc.principal.process.file.full_path = /\\(csrss|werfault|werFaultSecure|lsass|smss|services|svchost|MsMpEng|SenseIr|SenseCncProxy)\.exe$/i nocase

    // Target must not be the same process (self-open is benign)
    // Expressed by requiring the target process path to differ from the principal process path.
    // We detect cross-process opens where the target is a high-value host process
    // commonly abused for PE injection: long-running, trusted, network-capable processes.
    $proc.target.process.file.full_path = /\\(svchost|explorer|lsass|RuntimeBroker|spoolsv|dllhost|taskhost|taskhostw|SearchIndexer|SearchHost|sihost|ctfmon|winlogon|wininit|dwm|msiexec|regsvr32|rundll32|mshta|wscript|cscript|powershell|pwsh|cmd)\.exe$/ nocase

    // The requesting process must not be a known-good administrative tool
    not $proc.principal.process.file.full_path in %global_allowed_process_open_sources

    // The target process must not be on the approved list of processes that
    // legitimately receive cross-process handles from varied callers
    not $proc.target.process.file.full_path in %global_allowed_process_open_targets

    // The requesting process must not reside in standard Windows system directories.
    // Legitimate system-to-system handle opens originate from System32/SysWOW64.
    // Injection tools typically run from user-writable locations.
    // We flag openers that do NOT originate from protected system paths.
    not $proc.principal.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss][Yy][Ss][Tt][Ee][Mm]32\\/
    not $proc.principal.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss][Yy][Ss][Ww][Oo][Ww]64\\/
    not $proc.principal.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ww][Ii][Nn][Ss][Xx][Ss]\\/

    // Require the principal hostname to be populated (data quality gate)
    $proc.principal.hostname != ""

    // Require a user context — system-to-system handle opens without a user
    // are lower fidelity; user-context opens into privileged processes are higher risk
    $proc.principal.user.userid != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $requesting_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $requesting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
