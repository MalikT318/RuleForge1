/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:29:20.330353+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_OpenProcess_Then_RemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects thread execution hijacking by correlating a process opening a handle to a remote process (PROCESS_OPEN) followed by a remote thread creation (PROCESS_INJECTION) from the same source process on the same host within 5 minutes. This covers the OpenThread/SuspendThread/WriteProcessMemory/ResumeThread API chain used in T1055.003 without relying on command-line strings."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events for cross-process handle acquisition and PROCESS_INJECTION events for remote thread creation (e.g., CrowdStrike Falcon, SentinelOne, Microsoft Defender for Endpoint via Chronicle ingestion)."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), profiling tools (VTune, dotTrace), AV/EDR self-protection threads, JVM/CLR runtimes injecting helper threads into managed processes, RMM agents performing process inspection."
    tuning_guidance = "Add known-good injecting process paths (debuggers, JVM, CLR hosts) to %global_allowed_process_open_sources. Add known-good target process paths to %global_allowed_injection_targets. Raise severity to Critical if the target process is a high-value system binary (lsass, svchost, winlogon)."

  events:
    // Leg 1: source process acquires an open handle to a remote (victim) process
    $proc1.metadata.event_type = "PROCESS_OPEN"
    $proc1.principal.process.file.full_path != ""
    $proc1.target.process.file.full_path != ""
    // Exclude self-opens (same process opening itself is benign)
    $proc1.principal.process.pid != $proc1.target.process.pid
    // Exclude known-good sources of cross-process handle acquisition
    not $proc1.principal.process.file.full_path in %global_allowed_process_open_sources
    // Exclude common system paths that legitimately open child handles
    not $proc1.principal.process.file.full_path = /\\(csrss|smss|wininit|services|lsass)\.exe$/i nocase
    $proc1.principal.hostname = $hostname
    $proc1.principal.process.file.full_path = $injector_path

    // Leg 2: same source process creates a thread in a remote process (injection event)
    $proc2.metadata.event_type = "PROCESS_INJECTION"
    $proc2.principal.process.file.full_path != ""
    $proc2.target.process.file.full_path != ""
    // Exclude known-good injection targets (e.g., JVM managed process pairs)
    not $proc2.target.process.file.full_path in %global_allowed_injection_targets
    // Exclude known-good injecting processes
    not $proc2.principal.process.file.full_path in %global_allowed_process_open_sources
    $proc2.principal.hostname = $hostname
    $proc2.principal.process.file.full_path = $injector_path

    // Enforce chronological ordering: handle open must precede thread injection
    $proc1.metadata.event_timestamp.seconds <= $proc2.metadata.event_timestamp.seconds

  match:
    $hostname, $injector_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($proc1.principal.hostname)
    $injecting_process = array_distinct($proc2.principal.process.file.full_path)
    $victim_processes = array_distinct($proc2.target.process.file.full_path)
    $open_handle_targets = array_distinct($proc1.target.process.file.full_path)
    $injection_count = count($proc2.metadata.event_timestamp.seconds)

  condition:
    $proc1 and $proc2
}
