/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:27:33.101444+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_Process_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process opening a handle to another process with permissions consistent with DLL injection preparation (PROCESS_VM_WRITE + PROCESS_CREATE_THREAD). This targets the PROCESS_OPEN event produced by EDR telemetry when VirtualAllocEx/WriteProcessMemory/CreateRemoteThread call chains are initiated, catching the technique at the OS handle-request layer rather than at command-line creation. Covers classic DLL injection, reflective injection, and module stomping variants."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target.process.access_mask or equivalent handle-rights field (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint via Chronicle ingestion). Windows Sysmon Event ID 10 (ProcessAccess) also satisfies this requirement."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), profiling tools (VTune, dotTrace), AV/EDR self-protection modules opening their own agent processes, RMM agents performing memory diagnostics, JVM/CLR runtimes performing cross-process JIT operations."
    tuning_guidance = "Add known-good opener process paths (debuggers, AV agents, RMM tools) to %global_allowed_process_openers. Add known-good target process paths (monitoring agents, JVM processes) to %global_allowed_injection_targets. Consider scoping to cross-session or cross-user handle requests for higher fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // The opener must not be a known-good administrative or security tool
    not $proc.principal.process.file.full_path in %global_allowed_process_openers

    // The target must not be a known-good process that legitimately receives such handles
    not $proc.target.process.file.full_path in %global_allowed_injection_targets

    // Exclude self-opens: same process opening itself (common in legitimate runtimes)
    $proc.principal.process.pid != $proc.target.process.pid

    // Opener is NOT a system-native process that routinely opens other processes
    // Exclude lsass, csrss, smss, wininit which legitimately open processes at high privilege
    not $proc.principal.process.file.full_path = /\\(lsass|csrss|smss|wininit|services|svchost)\.exe$/ nocase

    // Target is a running user-space or system process (not a child the opener just created)
    // Focus on processes that are not direct children of the opener
    $proc.target.process.file.full_path = /\.exe$/i nocase

    // Detect access mask values consistent with DLL injection:
    // PROCESS_VM_WRITE (0x0020) | PROCESS_VM_OPERATION (0x0008) | PROCESS_CREATE_THREAD (0x0002)
    // Combined mask 0x043A or superset (PROCESS_ALL_ACCESS = 0x1FFFFF) also covers this.
    // Match on the hex access mask string as populated by Sysmon/EDR parsers.
    // 0x1fffff = PROCESS_ALL_ACCESS; 0x43a and 0x1f3fff are common injection masks.
    $proc.target.process.access_mask = /^(0x1f[0-9a-f]{4}|0x0*43[0-9a-f]|0x0*1f3f[0-9a-f]{2})$/i nocase

    // Exclude openers running from system-managed paths that are expected to hold these rights
    not $proc.principal.process.file.full_path = /\\(MsMpEng|MpCmdRun|SenseIR|SenseCncProxy)\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $opener_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $access_mask_observed = array_distinct($proc.target.process.access_mask)

  condition:
    $proc
}
