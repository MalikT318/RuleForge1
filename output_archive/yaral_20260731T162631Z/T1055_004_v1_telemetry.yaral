/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:29:45.054863+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where a process requests thread-level access rights consistent with APC injection (OpenThread followed by QueueUserAPC patterns). Specifically, a non-system process opens a handle to a thread in a different process with THREAD_SET_CONTEXT or combined suspicious access masks. This targets the handle-acquisition step of APC injection rather than command-line telemetry, providing additive coverage that is harder for adversaries to evade."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR telemetry that logs PROCESS_OPEN / thread-open events with access mask fields, such as Microsoft Sysmon Event ID 10 (ProcessAccess) or CrowdStrike process handle telemetry ingested into Chronicle UDM as PROCESS_OPEN events. The target.process.access_mask field must be populated."
    platform = "Windows"
    false_positives = "Debuggers (WinDbg, x64dbg, Visual Studio), profilers (VTune, dotTrace), legitimate AV/EDR products performing thread inspection, RMM agents, and Windows Error Reporting (WerFault.exe). Exclude known-good tooling via reference lists."
    tuning_guidance = "Add trusted security tooling and debugger paths to %global_allowed_thread_openers. Add known-good parent process paths to %global_allowed_admin_tools. Consider narrowing by target process (e.g., only alert when target is a browser, lsass, or svchost) once baseline noise is understood per environment."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // The opening (injecting) process must not be a known system binary.
    // Exclude Windows kernel and core OS paths that legitimately open threads.
    not $proc.principal.process.file.full_path = /\\(ntoskrnl|lsass|csrss|smss|wininit|services|svchost|WerFault|MsMpEng|SenseIr|SenseCncProxy)\.exe$/i nocase

    // Exclude processes running from core Windows system directories
    // (system32, syswow64) that are well-known OS components.
    not $proc.principal.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss][Yy][Ss][Tt][Ee][Mm]32\\/ nocase

    // Access mask patterns consistent with APC injection:
    // 0x0010 = THREAD_SET_CONTEXT  (required for QueueUserAPC)
    // 0x001F03FF = THREAD_ALL_ACCESS (overly broad, common in injection tooling)
    // 0x0020 = THREAD_QUERY_INFORMATION combined with SET_CONTEXT
    // Match on access masks that include THREAD_SET_CONTEXT (bit 0x10)
    // or THREAD_ALL_ACCESS. Chronicle stores access_mask as a decimal or hex string.
    $proc.target.process.access_mask = /^(0x001[Ff]03[Ff]{2}|0x0*10|0x0*30|0x0*12|0x0*1[0-9a-fA-F])$/ nocase

    // The opener and target must be different processes (cross-process handle).
    // Use process IDs to confirm this is not self-handle acquisition.
    $proc.principal.process.pid != $proc.target.process.pid

    // Exclude known-good thread openers (debuggers, AV, RMM) via reference list.
    not $proc.principal.process.file.full_path in %global_allowed_thread_openers

    // Exclude known-good admin tools.
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $opener_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $access_mask_observed = array_distinct($proc.target.process.access_mask)
    $opener_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
