/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:30:06.963851+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Suspended_Process_Then_Remote_Thread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the Early Bird APC injection pattern: a process is launched in suspended state (CREATE_SUSPENDED flag visible via debugger/EDR telemetry as a short-lived suspended child), followed by a PROCESS_INJECTION event on the same host within 5 minutes. This sequence is characteristic of APC queue injection where malicious code is written into a suspended process before its entry point executes. Complements existing T1055.004 process-launch/command-line rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_LAUNCH events with suspended-state indicators AND PROCESS_INJECTION events (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint via Chronicle ingestion). Windows Sysmon Event ID 8 (CreateRemoteThread) also satisfies the injection leg."
    platform = "Windows"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg) launching targets in suspended state; some application virtualization products; JIT compilers that use suspended process bootstrapping; certain installers using process hollowing legitimately."
    tuning_guidance = "Add known-good parent processes (e.g., devenv.exe, msbuild.exe, installer frameworks) to %apc_injection_allowed_parents. Add known-good suspended child targets (e.g., conhost.exe spawned by terminal emulators) to %apc_injection_allowed_targets. Scope by environment type if developer workstations generate high FP volume."

  events:
    // Leg 1: A non-system process spawns a child that EDR flags as suspended
    // (principal is the spawning process, target is the suspended child).
    // We narrow on suspicious spawning parents - scripting hosts, Office apps,
    // browsers, and generic LOLBins that have no legitimate reason to create
    // suspended children in production.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /CREATE_SUSPENDED|\/suspended|suspended/i nocase
    not $proc.principal.process.file.full_path = /\\(devenv|msbuild|dbghost|windbg|cdb|ntsd|vsjitdebugger)\.exe$/i nocase
    not $proc.principal.process.file.full_path in %apc_injection_allowed_parents
    not $proc.target.process.file.full_path in %apc_injection_allowed_targets
    $proc.principal.hostname = $hostname

    // Leg 2: A PROCESS_INJECTION event on the same host shortly after,
    // indicating code was queued into the suspended (or now-resumed) process.
    // Pre-filter: exclude injections where the injector is a known-good security
    // or monitoring tool to avoid AV/EDR self-injection FPs.
    $inj.metadata.event_type = "PROCESS_INJECTION"
    not $inj.principal.process.file.full_path = /\\(MsMpEng|SenseCntr|CSFalconService|SentinelAgent|CylanceSvc|cb\.exe|cbsensor)\.exe$/i nocase
    not $inj.principal.process.file.full_path in %apc_injection_allowed_parents
    $inj.principal.hostname = $hostname

    // Chronological ordering: suspended launch must precede the injection event
    $proc.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $spawning_process = array_distinct($proc.principal.process.file.full_path)
    $suspended_target = array_distinct($proc.target.process.file.full_path)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $injection_target = array_distinct($inj.target.process.file.full_path)
    $suspended_cmdline = array_distinct($proc.target.process.command_line)

  condition:
    $proc and $inj
}
