/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:26:49.408278+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_ProcessInjection_ProcessHandleOpen {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious PROCESS_OPEN events where an unexpected process requests a handle to a high-value system process (e.g. lsass, winlogon, svchost, csrss). Legitimate code rarely needs to open handles to these processes with broad access rights. This rule targets the OS-level handle acquisition step of process injection, which is harder to evade than command-line logging."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target process name and requesting process path (e.g. CrowdStrike Falcon, Microsoft Defender for Endpoint, Carbon Black, SentinelOne). Windows Security Event 4656/4663 with Object Type = Process can supplement."
    platform = "Windows"
    false_positives = "Security tooling (AV/EDR agents), system management utilities, debuggers (WinDbg, x64dbg), performance monitoring tools (Process Monitor, Process Hacker), and some legitimate backup or DLP agents that inspect process memory."
    tuning_guidance = "Add known-good security and admin tool paths to %global_allowed_process_openers. Consider narrowing by access rights bitmask if your EDR surfaces that field. Exclude dedicated monitoring hosts by adding their hostnames to a reference list."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // Target must be a high-value system process commonly abused for injection
    $proc.target.process.file.full_path = /\\(lsass|winlogon|csrss|wininit|services|svchost|explorer|dwm|smss)\.exe$/i nocase

    // Requesting process must NOT itself be a known system binary in its canonical location
    // Catches renamed or relocated copies of legitimate tools used as injection loaders
    not $proc.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csagent|csfalconservice|cbdefense|SentinelAgent|cylancesvc|bdservicehost)\.exe$/i nocase

    // Exclude canonical Windows system paths for the opener to reduce noise from
    // legitimate OS components opening handles to sibling processes
    not $proc.principal.process.file.full_path = /^[Cc]:\\[Ww]indows\\[Ss]ystem32\\/

    // Exclude known-good admin and security tooling via reference list
    not $proc.principal.process.file.full_path in %global_allowed_process_openers

    // Require a populated requesting process path; anonymous/kernel handles are
    // a separate detection surface and would generate excessive noise here
    $proc.principal.process.file.full_path = /.+/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($proc.principal.hostname)
    $opener_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $requesting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
