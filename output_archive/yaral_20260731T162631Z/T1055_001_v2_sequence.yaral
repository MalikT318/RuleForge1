/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:27:53.353792+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_WriteMemory_Then_RemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the two-stage DLL injection pattern: a process opens a handle to a remote process (PROCESS_OPEN) and subsequently a new remote thread is created in that same target process (PROCESS_INJECTION). This covers the VirtualAllocEx/WriteProcessMemory/CreateRemoteThread injection chain without relying on command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (cross-process handle acquisition) and PROCESS_INJECTION events (remote thread creation). Sysmon Event IDs 10 (ProcessAccess) and 8 (CreateRemoteThread) satisfy this requirement when ingested via the Chronicle Sysmon parser."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio), profiling tools (dotTrace, VTune), AV/EDR agents performing self-injection, JVM/CLR runtimes, and some RMM agents that inject helper DLLs."
    tuning_guidance = "Add known-good injecting processes (debuggers, AV engines, RMM agents) to %global_allowed_injection_sources. Add known-good target processes (e.g. JVM, CLR hosts) to %global_allowed_injection_targets. Raise severity if the injecting process is not signed or resides outside System32/Program Files."

  events:
    // Stage 1: A process acquires a cross-process handle to a remote process.
    // EDRs surface this as PROCESS_OPEN with the injecting process as principal
    // and the victim process as target.
    $open.metadata.event_type = "PROCESS_OPEN"
    // Exclude self-opens (same PID) - legitimate for many runtimes
    $open.principal.process.pid != $open.target.process.pid
    // Injecting process must not be a known-good tool
    not $open.principal.process.file.full_path in %global_allowed_injection_sources
    // Target process must not be a known-good injection target
    not $open.target.process.file.full_path in %global_allowed_injection_targets
    // Exclude kernel/system processes as principal (pid 0 and 4 on Windows)
    $open.principal.process.pid > 4
    // Bind the injecting process path and the victim process path as join keys
    $open.principal.process.file.full_path = $injector_path
    $open.target.process.pid = $victim_pid
    $open.principal.hostname = $hostname

    // Stage 2: A remote thread is created inside the same victim process PID,
    // indicating the injector followed through with CreateRemoteThread / NtCreateThreadEx.
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = $injector_path
    $inj.target.process.pid = $victim_pid
    $inj.principal.hostname = $hostname
    not $inj.principal.process.file.full_path in %global_allowed_injection_sources

    // Enforce chronological ordering: handle open must precede thread creation
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $injector_path, $victim_pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $victim_process_pid = max($open.target.process.pid)
    $injecting_user = array_distinct($open.principal.user.userid)

  condition:
    $open and $inj
}
