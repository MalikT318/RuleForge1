/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T18:59:09.562945+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Stripped_Payload_File_Drop_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file creation events logged via identity provider audit trails where a new executable or script artifact is written to disk by a service principal, application identity, or non-interactive account. Stripped payloads (binaries lacking symbols/strings) are commonly staged via automated identities after initial access. This rule pivots on the file artifact state change rather than command-line telemetry, providing additive coverage for T1027.008."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Requires identity provider audit logs (Entra ID / Okta / AD) that surface file or resource creation events attributed to service principals, managed identities, or application accounts. Chronicle UDM normalises these as FILE_CREATION with principal.user fields populated from the IdP audit stream."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate CI/CD pipelines deploying signed binaries, software distribution service accounts, MDM/RMM agents pushing updates, authorized DevOps automation."
    tuning_guidance = "Add known deployment service-principal UPNs or application IDs to %global_allowed_deploy_identities. Add approved staging paths to %global_allowed_staging_paths. Narrow severity based on target path sensitivity (e.g., system32 vs. user temp)."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file has an executable or script extension associated with stripped payload delivery
    $file.target.file.full_path = /\.(exe|dll|sys|bin|scr|ps1|vbs|js|hta|bat|cmd|msi|cpl|ocx)$/ nocase

    // File written to a high-risk staging or writable location on Windows
    $file.target.file.full_path = /(\\Temp\\|\\AppData\\|\\ProgramData\\|\\Users\\Public\\|\\Windows\\Temp\\|\\Downloads\\)/ nocase

    // Event attributed to a non-interactive or service-type identity
    // Service principals, managed identities, and app accounts typically carry these patterns
    $file.principal.user.userid = /(svc[-_]|app[-_]|spm[-_]|bot[-_]|automation|pipeline|deploy|ci[-_]|cd[-_]|agent|daemon|managed|service)/ nocase

    // Exclude known-good deployment identities managed per-tenant
    not $file.principal.user.userid in %global_allowed_deploy_identities

    // Exclude known-good staging paths approved per-tenant
    not $file.target.file.full_path in %global_allowed_staging_paths

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.008")
    $primary_entity = array_distinct($file.principal.user.userid)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $acting_identity = array_distinct($file.principal.user.userid)

  condition:
    $file
}
