/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:32:59.617360+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_TimeProvider_DllName_Registry_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification or creation of the DllName registry value under the W32Time TimeProviders subkeys, which is the mechanism adversaries use to register a malicious DLL as a time provider for persistence. The DLL is loaded by svchost at boot in the Local Service context. This rule fires on the registry state change rather than the process command line, providing coverage that survives command-line evasion."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 or equivalent EDR registry events) normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate NTP client or server software (e.g., Meinberg NTP, VMware Tools time sync) that registers a custom time provider DLL during installation or update. Windows cumulative updates that patch the built-in NtpClient or NtpServer DllName values."
    tuning_guidance = "Populate %allowed_timeprovider_dll_paths with the full paths of approved time-provider DLLs (e.g., /windows/system32/w32time.dll). Add the installer process paths to %allowed_timeprovider_writers if you need to suppress installation-time noise rather than suppressing by DLL path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the W32Time TimeProviders key tree - any subkey, any depth
    $reg.target.registry.registry_key = /\\System\\CurrentControlSet\\Services\\W32Time\\TimeProviders\\/i nocase

    // Only care about the DllName value - this is what loads the DLL at boot
    $reg.target.registry.registry_value_name = /^DllName$/ nocase

    // Flag DLL paths that do NOT live under the canonical Windows system directories.
    // Legitimate providers ship to system32 or syswow64; anything else is suspicious.
    not $reg.target.registry.registry_value_data = /^[a-z]:\\windows\\(system32|syswow64)\\/i nocase

    // Exclude known-good writer processes (populated per client)
    not $reg.principal.process.file.full_path in %allowed_timeprovider_writers

    // Exclude known-good DLL paths (populated per client)
    not $reg.target.registry.registry_value_data in %allowed_timeprovider_dll_paths

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity    = array_distinct($reg.principal.hostname)
    $modified_key      = array_distinct($reg.target.registry.registry_key)
    $dll_value_written = array_distinct($reg.target.registry.registry_value_data)
    $writing_process   = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
