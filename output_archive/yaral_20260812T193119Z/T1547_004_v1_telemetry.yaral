/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:33:20.397150+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Helper_Registry_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects registry modifications to Winlogon helper keys (Userinit, Shell, Notify) that are abused to load malicious DLLs or executables at logon. This rule fires on the resulting registry state change rather than the process command line, providing coverage that is harder for attackers to evade."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION events. Sysmon Event ID 13 or equivalent EDR registry write events must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers that modify Userinit or Shell (rare but possible). Group Policy or MDM tooling applying baseline shell settings. AV/EDR agents registering Winlogon notification packages."
    tuning_guidance = "Add trusted parent process paths (e.g. Group Policy client, MDM agent) to %winlogon_allowed_modifier_processes. Add known-good Userinit/Shell values to %winlogon_allowed_values if your environment uses a non-default shell."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Winlogon key in both HKLM and HKCU, including Wow6432Node variant
    $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Windows NT\\CurrentVersion\\Winlogon$/ nocase

    // Focus on the specific value names known to be abused
    $reg.target.registry.registry_value_name = /^(Userinit|Shell|Notify)$/ nocase

    // Flag values that reference paths outside the expected Windows system directories,
    // or that append additional executables/DLLs beyond the canonical defaults.
    // Canonical Userinit: C:\Windows\system32\userinit.exe,
    // Canonical Shell:    explorer.exe
    // Any value containing a UNC path, temp dir, user-writable dir, or extra comma-separated entry is suspicious.
    $reg.target.registry.registry_value_data = /(%temp%|\\AppData\\|\\Temp\\|\\ProgramData\\|\\Users\\[^\\]+\\|\\Downloads\\|\\Desktop\\|\\Public\\|\\Windows\\Temp|\\tmp\\|\.dll|\\cmd\.exe|\\powershell|\\pwsh|\\wscript|\\cscript|\\mshta|\\rundll32|\\regsvr32|\\certutil|\\bitsadmin|\\wmic)/ nocase

    // Exclude modifications made by known-good administrative processes
    not $reg.principal.process.file.full_path in %winlogon_allowed_modifier_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $modified_value_data = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $actor_userid = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
