/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:33:35.479203+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_SSP_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the LSA Security Packages registry keys used to register Security Support Providers (SSPs). Adversaries add malicious DLL names to these keys so they are loaded into lsass.exe at boot or via AddSecurityPackage(), gaining access to plaintext credentials. This rule fires on the registry state change itself, providing coverage orthogonal to process-creation detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION events. Sysmon Event ID 13 or equivalent EDR registry write events must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security software (e.g., smart-card middleware, third-party authentication providers, enterprise SSO agents) that registers a new SSP DLL. Domain controller software and some VPN clients may also write to these keys during installation or update."
    tuning_guidance = "Populate %ssp_allowed_writers with the full paths of known-good installer or security-software processes (e.g., domain controller setup, approved smart-card drivers). Populate %ssp_allowed_packages with DLL names that are authorised in your environment. Alert volume should be very low in steady state; any unexpected write warrants investigation."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\(OSConfig\\)?Security Packages$/ nocase
    not $reg.principal.process.file.full_path in %ssp_allowed_writers
    not $reg.target.registry.registry_value_data in %ssp_allowed_packages

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $new_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
