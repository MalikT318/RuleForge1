/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:33:55.207352+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_LNK_Startup_Then_Suspicious_Child {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a .lnk file written into a Windows Startup folder followed by a suspicious process launched from that same host within 10 minutes. This correlation provides additive coverage beyond command-line matching by linking the file-creation artefact to subsequent execution, indicating a shortcut-based persistence mechanism was triggered."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (FILE_CREATION) and process-launch telemetry (PROCESS_LAUNCH) normalised into UDM. Both event types must be present for the correlation to fire."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers that drop shortcuts into Startup folders (e.g. chat clients, VPN agents, RMM tools). Authorised IT deployment scripts. User-created shortcuts for convenience applications."
    tuning_guidance = "Add known-good parent process paths that legitimately write Startup shortcuts to %global_allowed_lnk_writers. Add known-good child process paths launched from Startup to %global_allowed_startup_children. Narrow the suspicious child process regex if the environment uses non-standard scripting runtimes."

  events:
    // Event 1: a .lnk file is created inside any user or common Startup folder
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\.+\.lnk$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_lnk_writers
    $file.principal.hostname = $hostname

    // Event 2: a suspicious interpreter or shell process launches on the same host
    // after the shortcut was written - targets the execution phase, not the write phase
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msiexec|certutil|bitsadmin|wmic)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_startup_children
    not $proc.principal.process.file.full_path in %global_allowed_startup_children
    $proc.principal.hostname = $hostname

    // Chronological ordering: file write must precede process launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1547.009")
    $primary_entity      = array_distinct($hostname)
    $lnk_paths_written   = array_distinct($file.target.file.full_path)
    $lnk_writer_process  = array_distinct($file.principal.process.file.full_path)
    $child_processes     = array_distinct($proc.target.process.file.full_path)
    $child_cmdlines      = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
