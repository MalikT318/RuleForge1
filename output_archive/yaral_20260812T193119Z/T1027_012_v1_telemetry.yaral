/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:31:40.533767+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_File_Creation_Suspicious_Location {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation of .LNK shortcut files in user-writable or staging directories commonly abused for LNK Icon Smuggling (T1027.012). Attackers craft LNK files with malicious icon location fields pointing to external UNC or URL paths to trigger credential capture or payload download when the shortcut is rendered. This rule fires on the file artifact rather than the process command line, providing additive coverage that survives command-line evasion."
    mitre_tactic         = "Defense Evasion"
    mitre_technique      = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites    = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event) normalised into Chronicle UDM FILE_CREATION events with target.file.full_path populated."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Legitimate software installers dropping shortcuts to user Desktop or Start Menu; RMM agents creating managed shortcuts; user-initiated 'Send To Desktop' actions; application auto-update routines writing LNK files to AppData."
    tuning_guidance      = "Add known-good parent process paths (e.g., installer engines, RMM agents) to %global_allowed_lnk_creators. Narrow scope further by excluding paths under well-known vendor subdirectories if noise is high. Consider raising severity to High when combined with a subsequent NETWORK_CONNECTION from explorer.exe or a shell process."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target a .lnk file being written
    $file.target.file.full_path = /\.lnk$/  nocase

    // Focus on user-writable and staging paths commonly abused for phishing delivery
    // Matches: Downloads, Temp, AppData\Local\Temp, AppData\Roaming, Desktop, Public
    $file.target.file.full_path = /\\(Downloads|Temp|AppData\\(Local\\Temp|Roaming)|Desktop|Public|Users\\Public)/  nocase

    // Exclude system-level processes that legitimately create shortcuts at scale
    // (e.g., Windows Explorer shell operations, known installer engines)
    not $file.principal.process.file.full_path = /\\(explorer|msiexec|setup|install|update|uninstall)\.exe$/  nocase

    // Exclude paths that are clearly vendor-managed shortcut directories
    not $file.target.file.full_path = /\\Microsoft\\Windows\\Start Menu\\/  nocase

    // MSSP multi-tenant exclusion: allow-list for approved parent processes
    not $file.principal.process.file.full_path in %global_allowed_lnk_creators

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity    = array_distinct($file.principal.hostname)
    $lnk_path          = array_distinct($file.target.file.full_path)
    $creating_process  = array_distinct($file.principal.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
