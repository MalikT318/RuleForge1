/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:32:03.785499+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Encoded_Payload_File_Artifact {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation of files with extensions or naming patterns strongly associated with encoded/encrypted payload staging on Windows hosts. Adversaries commonly drop Base64-encoded blobs, XOR-encrypted payloads, or obfuscated script containers to disk before decoding and executing them in memory. This rule pivots on the resulting file artifact rather than the encoding command line, providing coverage when command-line logging is absent or evaded."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write events must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers writing encoded resource blobs; backup agents staging compressed archives; developer toolchains emitting encoded build artefacts; password managers writing encrypted vaults."
    tuning_guidance = "Add trusted parent process paths (e.g. software deployment agents, backup clients) to %global_allowed_encoded_file_writers. Add known-safe staging directories (e.g. approved software cache paths) to %global_allowed_encoded_file_paths. Raise severity for drops into user-writable system paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target suspicious staging locations: user-writable temp/appdata paths,
    // web-accessible directories, and common attacker drop zones.
    // Regex covers: %TEMP%, %APPDATA%, %LOCALAPPDATA%, ProgramData, Public,
    // Windows\Temp, and web root equivalents.
    $file.target.file.full_path = /\\(Users\\[^\\]+\\(AppData\\(Local\\Temp|Roaming)|Desktop|Downloads|Documents)|Windows\\Temp|ProgramData|inetpub\\wwwroot|xampp\\htdocs)\\/ nocase

    // File extensions and naming patterns associated with encoded/encrypted staging:
    // .b64  - explicit Base64 blobs
    // .enc  - generic encrypted file convention
    // .dat  - opaque binary/data blobs frequently used for payload hiding
    // .bin  - raw binary payloads
    // .pak  - packed/encrypted resource containers
    // .tmp with a hex-like name pattern is handled via the name regex below
    // .cfg / .config dropped in temp paths - obfuscated config containers
    // .key  - encoded key material staged alongside payloads
    $file.target.file.full_path = /\.(b64|enc|pak|key)$/ nocase

    // Exclude known-safe parent processes (software deployment, AV, backup)
    not $file.principal.process.file.full_path in %global_allowed_encoded_file_writers

    // Exclude known-safe staging directories
    not $file.target.file.full_path in %global_allowed_encoded_file_paths

    // Exclude Windows system processes that legitimately write encoded blobs
    not $file.principal.process.file.full_path = /\\(svchost|MsMpEng|TiWorker|WmiPrvSE|SearchIndexer|OneDrive|Teams|msedge|chrome|firefox)\.exe$/ nocase

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $affected_user     = array_distinct($file.principal.user.userid)

  condition:
    $file
}
