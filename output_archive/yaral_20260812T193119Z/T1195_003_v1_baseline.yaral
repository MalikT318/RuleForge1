/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:35:15.449630+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_Suspicious_Firmware_Or_Hardware_Interface_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes accessing low-level hardware or firmware interfaces on macOS that may indicate a compromised hardware supply chain implant activating. Targets use of ioreg, system_profiler, nvram, and similar utilities in combinations or from unexpected parent processes that suggest programmatic hardware enumeration or firmware manipulation rather than legitimate admin activity."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Compromise Hardware Supply Chain"
    log_prerequisites = "Requires macOS EDR telemetry providing PROCESS_LAUNCH events with parent process path, child process path, and full command line. Unified log forwarding via osquery or a commercial EDR agent is sufficient."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "System administrators running hardware diagnostics, Apple Configurator, MDM enrollment workflows, legitimate firmware update utilities (e.g., softwareupdate), and IT asset inventory tools such as Jamf or Mosyle may trigger this rule."
    tuning_guidance = "Add known MDM agent paths and IT inventory tool paths to %macos_allowed_hw_enum_parents. Add approved admin user accounts to %macos_allowed_hw_enum_users. Narrow the command_line regex if only specific hardware interfaces are relevant to your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target hardware/firmware enumeration and manipulation utilities native to macOS
    $proc.target.process.file.full_path = /\/(ioreg|nvram|system_profiler|hidutil|iokit|ioclasscount|iomediabsdclient|diskutil|spctl|codesign|xattr|lsregister)$/ nocase

    // Look for command-line arguments that indicate active hardware probing or firmware access
    // rather than passive listing - covers nvram writes, ioreg deep traversal, spctl assessment bypass
    $proc.target.process.command_line = /(nvram\s+.*=|ioreg\s+-[a-z]*r|system_profiler\s+SP(USB|Thunderbolt|NVMe|Storage|Hardware|Bluetooth)DataType|hidutil\s+property\s+--set|spctl\s+--master-disable|xattr\s+-d\s+com\.apple\.quarantine|codesign\s+--remove-signature)/ nocase

    // Flag when the parent is an unexpected launcher - scripting runtimes, shells, or
    // user-space agents rather than launchd, loginwindow, or known MDM frameworks
    $proc.principal.process.file.full_path = /\/(bash|zsh|sh|python3?|ruby|perl|osascript|node|curl|launchctl)$/ nocase

    // Exclude known-good administrative parent paths
    not $proc.principal.process.file.full_path in %macos_allowed_hw_enum_parents

    // Exclude known-good users performing authorized hardware management
    not $proc.principal.user.userid in %macos_allowed_hw_enum_users

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line_observed = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
