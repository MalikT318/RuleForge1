/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:32:23.911182+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_RunKey_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects direct registry state changes to Windows Run/RunOnce/RunOnceEx keys used for persistence. This rule pivots on the resulting registry artifact rather than the process command line, providing coverage against attackers who evade command-line logging via direct API calls, WMI, or reflective techniques."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION events. Sysmon Event ID 12/13/14 or equivalent EDR registry events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers adding legitimate autostart entries, RMM agents, antivirus products, and enterprise software deployment tools. Baseline known-good value names per environment."
    tuning_guidance = "Populate %global_allowed_run_key_writers with full paths of known-good installer and management processes (e.g. msiexec.exe, deployment agents). Populate %global_allowed_run_key_values with approved autostart value names. Consider scoping to non-SYSTEM writers for lower-noise operation."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the canonical Run/RunOnce/RunOnceEx key paths under both HKLM and HKCU
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Windows\\CurrentVersion\\Run(Once(Ex)?)?$/ nocase

    // Exclude writes to sub-keys that are not the root run key itself (e.g. RunOnceEx dependency sub-keys are still in scope via the regex above)
    // Require a value name to be present - empty value writes are noise
    $reg.target.registry.registry_value_name != ""

    // Exclude known-good writing processes
    not $reg.principal.process.file.full_path in %global_allowed_run_key_writers

    // Exclude known-good autostart value names (populated per environment)
    not $reg.target.registry.registry_value_name in %global_allowed_run_key_values

    // Exclude writes originating from Windows system directories for common OS-level writers
    not $reg.principal.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss]ystem32\\(msiexec|TrustedInstaller|svchost)\.exe$/ nocase

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1547.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $user_context = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
