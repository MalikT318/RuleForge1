/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:34:35.750578+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_Rootkit_Driver_Load_And_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects suspicious kernel driver registration via registry modification of the HKLM\\SYSTEM\\CurrentControlSet\\Services path with a kernel-mode driver type (Type=1) and a start value indicating boot or system start (Start=0 or Start=1). Rootkits commonly register themselves as kernel drivers to intercept OS API calls and hide malicious activity. This rule targets the registry write that persists the rootkit driver configuration."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13 or equivalent EDR registry write events) normalised into UDM REGISTRY_MODIFICATION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate kernel driver installations by hardware vendors, Windows Update, antivirus products, and VPN clients. Security software and hypervisor agents may also register kernel drivers at boot."
    tuning_guidance = "Populate %global_allowed_driver_installers with full paths of known-good installer processes (e.g. Windows Update, vendor setup executables, approved AV installers). Populate %global_allowed_driver_service_names with approved kernel driver service names. Narrow scope by correlating with unsigned driver loads if your EDR surfaces image-load events."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Services hive where drivers are registered
    $reg.target.registry.registry_key = /\\SYSTEM\\(CurrentControlSet|ControlSet[0-9]+)\\Services\\/i nocase

    // Match on the ImagePath value being set - rootkits write their driver path here
    (
      $reg.target.registry.registry_value_name = /^ImagePath$/ nocase or
      $reg.target.registry.registry_value_name = /^Type$/ nocase or
      $reg.target.registry.registry_value_name = /^Start$/ nocase
    )

    // Driver image paths pointing to suspicious locations outside System32\drivers
    // Legitimate drivers almost always live in System32\drivers or a vendor subdirectory
    $reg.target.registry.registry_value_data = /\.(sys)$/ nocase
    not $reg.target.registry.registry_value_data = /\\Windows\\System32\\drivers\\/i nocase
    not $reg.target.registry.registry_value_data = /\\Windows\\SysWOW64\\drivers\\/i nocase

    // Exclude known-good installer processes
    not $reg.principal.process.file.full_path in %global_allowed_driver_installers

    // Exclude known-good service names
    not $reg.target.registry.registry_key in %global_allowed_driver_service_names

    // Exclude Windows-signed system processes performing driver management
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\drvinst\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\services\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\msiexec\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\wuauclt\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\TiWorker\.exe$/ nocase

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $driver_path = array_distinct($reg.target.registry.registry_value_data)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
