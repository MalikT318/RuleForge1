/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:34:15.145621+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_macOS_Bluetooth_Exfiltration_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes on macOS that interact with Bluetooth subsystems in ways consistent with data exfiltration. Monitors for command-line invocations of Bluetooth utilities, blueutil, or IOBluetooth framework consumers spawned by non-standard parent processes, which may indicate an adversary staging or transferring data over a Bluetooth channel rather than the primary network."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Bluetooth"
    log_prerequisites = "Requires macOS EDR process telemetry or Apple Unified Log ingestion with process launch events. EDR must capture full command-line arguments and parent process paths."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate Bluetooth management tools used by IT administrators, blueutil invoked by MDM agents, accessibility software, audio device pairing utilities, and developer testing of Bluetooth APIs."
    tuning_guidance = "Add known MDM agent paths and approved Bluetooth management tool paths to %macos_allowed_bluetooth_tools. Narrow scope by also requiring an unusual parent process (e.g., scripting engines) if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target Bluetooth-related binaries and frameworks on macOS
    // blueutil is the most common CLI Bluetooth tool; bluetoothd is the system daemon
    // IOBluetoothExtras and PacketLogger are framework/diagnostic tools
    (
      $proc.target.process.file.full_path = /\/(blueutil|bluetoothd|bluetoothaudiod|IOBluetoothExtras|PacketLogger)$/ nocase
      or
      $proc.target.process.command_line = /bluetooth/ nocase
      or
      $proc.target.process.command_line = /IOBluetooth/ nocase
    )

    // Exclude the standard system Bluetooth daemon launching itself via launchd
    not $proc.principal.process.file.full_path = /\/(launchd|launchctl|bluetoothd)$/ nocase

    // Exclude known MDM and system management parent processes
    not $proc.principal.process.file.full_path = /\/(jamf|munki|puppet|chef|ansible|osquery)$/ nocase

    // Flag when spawned by scripting engines, shells, or unusual parents
    // that have no legitimate reason to invoke Bluetooth subsystems
    (
      $proc.principal.process.file.full_path = /\/(bash|zsh|sh|fish|python[0-9.]*|ruby|perl|osascript|node|curl|wget)$/ nocase
      or
      $proc.principal.process.file.full_path = /\/Users\/.+\/Library\// nocase
      or
      $proc.principal.process.file.full_path = /\/tmp\// nocase
      or
      $proc.principal.process.file.full_path = /\/var\/folders\// nocase
    )

    // Exclude paths in the approved Bluetooth tools reference list
    not $proc.target.process.file.full_path in %macos_allowed_bluetooth_tools

    // Exclude known system framework paths for legitimate Bluetooth operations
    not $proc.target.process.file.full_path = /^\/System\/Library\// nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $spawning_process = array_distinct($proc.principal.process.file.full_path)
    $bluetooth_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
