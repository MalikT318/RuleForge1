/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:32:39.367833+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_AuthPackage_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the LSA Authentication Packages registry value under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa. Adversaries plant a rogue DLL reference here so that LSA loads it at boot, achieving persistence and potential SYSTEM-level code execution. This rule fires on the registry state change rather than the process that made it, providing a layer of coverage that is harder to evade than command-line detection."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION events. Sysmon Event ID 13 (RegistryEvent - Value Set) or equivalent EDR registry write events must be enabled and ingested."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security software (e.g., smart-card middleware, third-party MFA agents, enterprise SSO solutions) that register custom authentication packages. Domain controller promotion may also touch this key."
    tuning_guidance = "Populate %lsa_authpkg_allowed_writers with the full paths of known-good processes (e.g., domain controller setup binaries, approved security software installers). Scope alerts by correlating the writing process path against your software inventory. Consider suppressing events where the registry value data matches the Windows default ('msv1_0')."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Lsa$/ nocase
    $reg.target.registry.registry_value_name = /^Authentication Packages$/ nocase
    not $reg.target.registry.registry_value_data = /^msv1_0$/ nocase
    not $reg.principal.process.file.full_path in %lsa_authpkg_allowed_writers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
