/*
  MITRE Technique : T1052 - Exfiltration Over Physical Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:34:55.110617+00:00
  Reference       : https://attack.mitre.org/techniques/T1052
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_macOS_Removable_Media_Exfiltration {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation or copy activity targeting macOS removable media mount points under /Volumes, which is the standard macOS path for externally attached drives, USB sticks, and other removable storage. Adversaries use this mechanism to exfiltrate data from air-gapped or restricted systems via physical media."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1052"
    mitre_technique_name = "Exfiltration Over Physical Medium"
    log_prerequisites = "Requires macOS EDR telemetry capable of reporting FILE_CREATION events with target.file.full_path and principal.process.file.full_path. Unified log alone is insufficient; an EDR agent (e.g. CrowdStrike Falcon, SentinelOne, Jamf Protect) must be deployed."
    platform        = "macOS"
    log_source      = "macos_endpoint"
    false_positives = "Time Machine backups to external drives, authorized IT imaging workflows, legitimate user backups via Carbon Copy Cloner or similar, software developers writing disk images, media production workflows copying large files to external drives."
    tuning_guidance = "Populate %macos_allowed_backup_processes with backup agent process paths (e.g. /usr/libexec/backupd, /Applications/Carbon Copy Cloner.app). Populate %macos_allowed_removable_volume_prefixes with known-good volume name prefixes used by IT (e.g. CORP_BACKUP). Narrow the rule further by restricting principal.user.userid to non-service accounts if your EDR populates that field reliably."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be under the macOS removable media mount namespace
    $file.target.file.full_path = /^\/Volumes\// nocase

    // Exclude the system Time Machine volume which mounts under /Volumes
    not $file.target.file.full_path = /^\/Volumes\/MobileBackups\// nocase
    not $file.target.file.full_path = /^\/Volumes\/com\.apple\.TimeMachine/ nocase

    // Exclude macOS internal synthetic mounts that appear under /Volumes
    not $file.target.file.full_path = /^\/Volumes\/Recovery\// nocase
    not $file.target.file.full_path = /^\/Volumes\/Preboot\// nocase
    not $file.target.file.full_path = /^\/Volumes\/VM\// nocase
    not $file.target.file.full_path = /^\/Volumes\/Update\// nocase

    // Require a user-space process to be responsible (exclude kernel/launchd)
    $file.principal.process.file.full_path = /.+/ nocase
    not $file.principal.process.file.full_path = /^\/sbin\// nocase
    not $file.principal.process.file.full_path = /^\/usr\/libexec\/backupd/ nocase

    // Exclude known-good backup and imaging processes via reference list
    not $file.principal.process.file.full_path in %macos_allowed_backup_processes

    // Exclude system-level user accounts performing legitimate disk operations
    not $file.principal.user.userid in %macos_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1052")
    $primary_entity    = array_distinct($file.principal.hostname)
    $acting_process    = array_distinct($file.principal.process.file.full_path)
    $target_volume     = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
