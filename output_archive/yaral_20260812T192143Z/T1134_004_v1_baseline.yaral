/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:24:22.609370+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_PPID_Spoofing_Suspicious_Lineage {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects likely Parent PID (PPID) spoofing by identifying high-value interpreter or LOLBin processes whose reported parent is an implausible or high-privilege host process. Attackers use CreateProcess with PROC_THREAD_ATTRIBUTE_PARENT_PROCESS to make a child appear to descend from a benign parent (e.g. explorer.exe) while the true caller is a malicious or unexpected process. This rule catches the inverse: a shell or LOLBin whose claimed parent is a system service that would never legitimately spawn it interactively, which is the fingerprint left when spoofing is used to impersonate those services."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry that populates both principal.process.file.full_path (parent) and target.process.file.full_path (child) with command-line arguments. Sysmon Event ID 1 or equivalent EDR process-creation events."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "UAC elevation flows (svchost/consent spawning elevated processes), legitimate RMM agents, software deployment tools, Windows Update workers, and some antivirus remediation workflows may trigger this rule."
    tuning_guidance = "Add known-good parent paths to %ppid_spoof_allowed_parents and known-good child paths to %ppid_spoof_allowed_children. Scope further by adding the specific hostname or user account to an exclusion list if a persistent false positive is identified."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child process is a high-value interpreter, shell, or LOLBin
    // commonly used as the spoofed child in PPID-spoofing attacks
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|certutil|bitsadmin|installutil|cmstp|msbuild|regasm|regsvcs|ieexec|pcalua|forfiles|bash|wsl)\.exe$/ nocase

    // Claimed parent is a system service host or privileged process
    // that would not interactively spawn shells under normal conditions.
    // Legitimate UAC flows are handled by the exclusion list below.
    $proc.principal.process.file.full_path = /\\(svchost|lsass|services|smss|csrss|winlogon|wininit|spoolsv|dllhost|taskhost|taskhostw|searchindexer|searchprotocolhost|wsmprovhost|wmiprvse|msdtc|vssvc|ntoskrnl)\.exe$/ nocase

    // Exclude cases where the child is itself a known system binary
    // that these parents legitimately launch (e.g. svchost -> cmd for
    // Windows internal maintenance). Tuned via reference list.
    not $proc.target.process.file.full_path in %ppid_spoof_allowed_children
    not $proc.principal.process.file.full_path in %ppid_spoof_allowed_parents

    // Exclude the well-known UAC consent/elevation path:
    // consent.exe and svchost legitimately appear as parents of
    // elevated processes during UAC prompts.
    not $proc.target.process.command_line = /\/k\s+echo\s+[0-9a-f]{8}/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $spoofed_parent = array_distinct($proc.principal.process.file.full_path)
    $child_process  = array_distinct($proc.target.process.file.full_path)
    $child_cmdline  = array_distinct($proc.target.process.command_line)
    $affected_user  = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
