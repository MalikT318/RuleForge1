/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:23:32.735471+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_001_macOS_Clipboard_Access_pbpaste {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects execution of pbpaste or osascript-based clipboard access on macOS, which adversaries use to collect clipboard contents containing credentials, tokens, or sensitive data copied by users."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires macOS EDR or unified log telemetry providing PROCESS_LAUNCH events with command-line and parent process fields."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Password managers, clipboard manager utilities, developer scripts, and productivity automation tools that legitimately read clipboard contents."
    tuning_guidance = "Add known-good parent process paths (e.g., approved automation tools, password managers) to %macos_allowed_clipboard_parents. Narrow scope by also requiring a suspicious parent such as a shell or scripting interpreter if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match pbpaste (native macOS clipboard read utility) or osascript invoking clipboard
    (
      $proc.target.process.file.full_path = /\/pbpaste$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/osascript$/ nocase
        and
        $proc.target.process.command_line = /clipboard/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/(python[23]?|ruby|perl|node)$/ nocase
        and
        $proc.target.process.command_line = /pasteboard|clipboard|pbpaste/ nocase
      )
    )

    // Suspicious parent context: shell, scripting engine, or unknown binary outside standard app paths
    $proc.principal.process.file.full_path = /\/(bash|zsh|sh|fish|dash|python[23]?|ruby|perl|osascript|curl|wget)$/ nocase

    // Exclude known-good parent processes via reference list
    not $proc.principal.process.file.full_path in %macos_allowed_clipboard_parents

    // Exclude standard interactive terminal parents that are explicitly approved
    not $proc.target.process.command_line in %macos_allowed_clipboard_cmdlines

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
