/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:23:11.262508+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_Network_Logon_Script_Assignment {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the scriptPath or scriptName attribute on an Active Directory user object, which is the primary mechanism for assigning a network logon script via AD. Adversaries abuse this to achieve persistence by ensuring a script executes every time the targeted user authenticates to the domain."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires Active Directory audit logs with directory service changes enabled (Event ID 5136) or an identity provider that surfaces AD object attribute modifications in UDM as USER_RESOURCE_UPDATE_CONTENT or USER_CHANGE_PERMISSIONS events."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate IT provisioning workflows that assign logon scripts to new or existing users, Group Policy management tools, HR-driven onboarding automation, and identity governance platforms."
    tuning_guidance = "Add authorised provisioning service accounts to %global_allowed_logon_script_provisioners. Scope further by restricting to changes made outside business hours or to privileged accounts."

  events:
    $auth.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    (
      $auth.target.resource.attribute.labels.key = /scriptpath/ nocase or
      $auth.target.resource.attribute.labels.key = /scriptname/ nocase or
      $auth.target.resource.attribute.labels.key = /logonscript/ nocase
    )
    not $auth.principal.user.userid in %global_allowed_logon_script_provisioners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($auth.target.user.userid)
    $actor_userid = array_distinct($auth.principal.user.userid)
    $modified_attribute = array_distinct($auth.target.resource.attribute.labels.key)

  condition:
    $auth
}
