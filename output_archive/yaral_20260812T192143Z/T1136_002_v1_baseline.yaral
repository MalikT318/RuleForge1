/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:24:42.412420+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_macOS_Domain_Account_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects attempts to create a domain account on macOS via dscl, sysadminctl, or dsimport targeting a network domain or Active Directory node. Adversaries with sufficient privileges may add accounts to a bound AD domain or local directory service to establish persistent credentialed access without deploying remote-access tooling."
    mitre_tactic    = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Requires macOS EDR or Unified Log telemetry that captures PROCESS_LAUNCH events with full command-line arguments. Verified sources include CrowdStrike Falcon, SentinelOne, and Jamf Protect normalised to Chronicle UDM."
    platform        = "macOS"
    log_source      = "macos_endpoint"
    false_positives = "IT provisioning scripts that legitimately bind and create AD accounts; MDM-driven user creation workflows; directory services administrators running authorised onboarding automation."
    tuning_guidance = "Add authorised provisioning parent processes (e.g. MDM agent paths) to %macos_allowed_account_mgmt_parents. Add known-good admin user IDs to %macos_allowed_directory_admins. Narrow the domain node regex if your environment uses a non-standard AD mount point."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the macOS directory-management utilities used to create domain accounts
    $proc.target.process.file.full_path = /\/(dscl|sysadminctl|dsimport)$/ nocase

    // dscl: target an Active Directory or network domain node and issue a -create
    // sysadminctl: -addUser with -useSharedKerberosPrincipal or explicit domain flags
    // dsimport: bulk import into a non-local node
    (
      // dscl /Active Directory/... -create /Users/<name>
      $proc.target.process.command_line = /\/Active\s+Directory\// nocase or
      $proc.target.process.command_line = /\/LDAPv3\// nocase or
      $proc.target.process.command_line = /\/Bsd\// nocase or
      // sysadminctl domain-join style account creation
      $proc.target.process.command_line = /-addUser/ nocase or
      // dsimport targeting a non-local node
      $proc.target.process.command_line = /dsimport/ nocase
    )

    // Confirm a creation action is present (dscl -create / dsimport import verb)
    (
      $proc.target.process.command_line = /-create/ nocase or
      $proc.target.process.command_line = /-addUser/ nocase or
      $proc.target.process.command_line = /\.dsimport/ nocase
    )

    // Exclude authorised provisioning parent processes
    not $proc.principal.process.file.full_path in %macos_allowed_account_mgmt_parents

    // Exclude authorised directory administrators by user ID
    not $proc.principal.user.userid in %macos_allowed_directory_admins

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $acting_user       = array_distinct($proc.principal.user.userid)
    $command_observed  = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
