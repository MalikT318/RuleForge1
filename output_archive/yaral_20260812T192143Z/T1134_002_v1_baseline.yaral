/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:23:55.268429+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_CreateProcessWithToken_Privilege_Escalation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process creation where the launched process runs under a different user context than the parent process, which is the core OS behaviour of CreateProcessWithTokenW / runas-style token abuse. Specifically targets non-interactive shell or scripting engines spawned under a mismatched user identity, indicating a token was duplicated or stolen and used to create a new process for privilege escalation."
    mitre_tactic    = "Privilege Escalation, Defense Evasion"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry that populates both principal.user.userid (parent/spawning user) and target.user.userid (child process effective user). Windows Security Event 4688 with process creator subject and new process token subject also satisfies this requirement when normalised to UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate runas.exe usage by administrators, RMM agents (e.g. running tasks as SYSTEM), software deployment tools, scheduled tasks configured to run as a different user, and privilege-management PAM solutions."
    tuning_guidance = "Add known-good parent process paths (e.g. RMM agents, deployment tools) to %global_allowed_token_spawn_parents. Add authorised service accounts that routinely spawn processes under alternate identities to %global_allowed_impersonation_accounts. Narrow scope by requiring target.user.userid to match high-value accounts (Domain Admins, SYSTEM) if noise is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child process is a shell, scripting engine, or common LOLBin
    // that adversaries use after obtaining an elevated token
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic|msiexec|certutil|bitsadmin|explorer)\.exe$/ nocase

    // Parent and child user contexts must both be populated and differ,
    // which is the direct OS signal of CreateProcessWithTokenW behaviour
    $proc.principal.user.userid != ""
    $proc.target.user.userid    != ""
    $proc.principal.user.userid != $proc.target.user.userid

    // Exclude SYSTEM spawning SYSTEM (normal service behaviour)
    not $proc.principal.user.userid = /^(nt authority\\system|system)$/ nocase
    not $proc.target.user.userid    = /^(nt authority\\system|system)$/ nocase

    // Exclude LOCAL SERVICE / NETWORK SERVICE cross-spawns (normal Windows)
    not $proc.principal.user.userid = /^nt authority\\(local service|network service)$/ nocase
    not $proc.target.user.userid    = /^nt authority\\(local service|network service)$/ nocase

    // Exclude machine accounts (trailing $) which legitimately impersonate
    not $proc.principal.user.userid = /\$$/ nocase

    // Exclude known-good parent processes that legitimately use token APIs
    not $proc.principal.process.file.full_path in %global_allowed_token_spawn_parents

    // Exclude authorised service/admin accounts known to impersonate
    not $proc.principal.user.userid in %global_allowed_impersonation_accounts
    not $proc.target.user.userid    in %global_allowed_impersonation_accounts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $spawning_user     = array_distinct($proc.principal.user.userid)
    $effective_user    = array_distinct($proc.target.user.userid)
    $child_process     = array_distinct($proc.target.process.file.full_path)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $cmdline           = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
