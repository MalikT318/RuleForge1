/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:25:22.042252+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_IDE_Extension_Suspicious_Child_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects IDE processes (VS Code, IntelliJ, Eclipse) spawning suspicious child processes that are consistent with malicious extension execution - shells, scripting engines, or network utilities. Malicious IDE extensions execute arbitrary code in the context of the IDE host process every time the IDE launches."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "IDE Extensions"
    log_prerequisites = "Requires EDR process telemetry with parent-child process lineage (e.g., Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, SentinelOne). Principal process must be the parent."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate IDE extensions that invoke shells for build tasks, linting, or test runners (e.g., ESLint, Prettier, CMake Tools). Developer workflows that run PowerShell or cmd from within the IDE terminal are expected and high-volume."
    tuning_guidance = "Add known-good IDE extension host paths or specific developer machine hostnames to %global_allowed_ide_child_processes. Consider narrowing by requiring additional suspicious command-line arguments (e.g., encoded commands, download cradles, reverse shell patterns) to reduce terminal-based false positives. Scope to non-developer asset groups where possible."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match IDE host processes as the parent - covers VS Code, IntelliJ family, Eclipse, and generic JetBrains IDEs
    $proc.principal.process.file.full_path = /\\(code|code - insiders|cursor|windsurf|idea|idea64|pycharm|pycharm64|webstorm|webstorm64|goland|goland64|clion|clion64|rider|rider64|datagrip|datagrip64|phpstorm|phpstorm64|rubymine|rubymine64|eclipse|eclipsec)\.exe$/ nocase

    // Match suspicious child processes: shells, scripting engines, network/download utilities, and process injection helpers
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|wget|msiexec|wmic|cmstp|installutil|regasm|regsvcs|msbuild|xwizard|forfiles|pcalua|bash|wsl|wslhost)\.exe$/ nocase

    // Exclude known-good extension host wrapper processes that legitimately spawn shells
    not $proc.target.process.file.full_path in %global_allowed_ide_child_processes

    // Exclude the IDE's own extension host subprocess spawning another IDE instance (normal VS Code multi-process model)
    not $proc.target.process.command_line = /--type=extensionHost/ nocase
    not $proc.target.process.command_line = /--ms-enable-electron-run-as-node/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_ide_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
