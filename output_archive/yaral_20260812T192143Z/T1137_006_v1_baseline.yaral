/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:25:00.371370+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_Addin_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications that register a new Office add-in (WLL, XLL, COM, VSTO, VBA, or Outlook add-in) under known Office add-in registry paths. Adversaries abuse these keys to achieve persistence by executing code each time an Office application starts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION events. Sysmon Event ID 13 or equivalent EDR registry write events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office add-in installations by software deployment tools (e.g., Adobe Acrobat PDF add-in, Grammarly, enterprise productivity suites). IT admin scripted deployments. Software update processes for Office-integrated products."
    tuning_guidance = "Add known-good parent process paths (e.g., msiexec.exe, setup.exe from approved software) to %global_allowed_addin_installers. Add approved add-in registry key substrings to %global_allowed_addin_keys. Scope by principal.user.userid to exclude service accounts used by software deployment systems."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the well-known Office add-in registry hive paths (HKCU and HKLM variants)
    // Covers: COM add-ins, WLL/XLL, Outlook add-ins, VSTO, automation add-ins
    $reg.target.registry.registry_key = /\\Software\\(Wow6432Node\\)?Microsoft\\Office\\[^\\]+\\(Word|Excel|Outlook|PowerPoint|Access)\\(Addins|Add-ins|AddInLoadTimes|Resiliency\\DisabledItems|Options\\WordMail)/ nocase

    // Exclude registry writes by known-good Office processes themselves (e.g., self-registration during install)
    not $reg.principal.process.file.full_path in %global_allowed_addin_installers

    // Exclude writes originating from the Office application's own update/repair mechanisms
    not $reg.principal.process.file.full_path = /\\(OfficeClickToRun|OfficeC2RClient|setup)\.exe$/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $modified_registry_key = array_distinct($reg.target.registry.registry_key)
    $modified_registry_value = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $parent_process = array_distinct($reg.principal.process.parent_process.file.full_path)

  condition:
    $reg
}
