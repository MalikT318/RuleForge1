/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:38:15.200677+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_M365_AuditBypass_Then_MailboxAccess {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage Office Suite audit-evasion pattern: first, a mailbox audit bypass or Advanced Auditing downgrade is applied to a target account (SETTING_MODIFICATION), then that same account is accessed or its mail is read within 10 minutes. The sequence suggests an adversary suppressing audit trails before harvesting mailbox content, consistent with T1685.002 in M365 environments."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Logs"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log (UAL) ingested into Chronicle via the M365 connector. Relevant operations: Set-MailboxAuditBypassAssociation, Disable-OrganizationCustomization, license-downgrade events, and MailItemsAccessed / FolderBind operations normalised to SETTING_MODIFICATION and USER_RESOURCE_ACCESS respectively."
    platform        = "Office Suite"
    log_source      = "m365"
    false_positives = "Legitimate IT helpdesk staff applying audit-bypass for service accounts; automated provisioning pipelines that modify audit settings before accessing mailboxes; license management scripts that downgrade then immediately re-access accounts."
    tuning_guidance = "Add known service and automation account identifiers to %global_allowed_service_accounts. Add approved admin principals to %global_allowed_admin_users. Narrow the target.user.userid join to high-value accounts if volume is high."

  events:
    // Event 1: Audit bypass or Advanced Auditing modification applied to a target user
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    // Audit-bypass operations normalise into the operation/resource name fields
    (
      $cfg.target.resource.name = /(?i)mailboxauditbypass/ or
      $cfg.target.resource.name = /(?i)auditlog/ or
      $cfg.target.resource.name = /(?i)advancedaudit/ or
      $cfg.target.resource.name = /(?i)unifiedauditlog/
    )
    // The account whose audit settings are being changed
    $cfg.target.user.userid = $target_user
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users

    // Event 2: Mailbox or resource access against the same target account shortly after
    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    // Restrict to mail-related resource access (MailItemsAccessed, FolderBind, etc.)
    (
      $acc.target.resource.name = /(?i)mail/ or
      $acc.target.resource.name = /(?i)inbox/ or
      $acc.target.resource.name = /(?i)folder/ or
      $acc.target.resource.name = /(?i)message/
    )
    // The accessed account must be the same one whose auditing was suppressed
    $acc.target.user.userid = $target_user
    not $acc.principal.user.userid in %global_allowed_service_accounts
    not $acc.principal.user.userid in %global_allowed_admin_users

    // Chronological ordering: audit suppression must precede mailbox access
    $cfg.metadata.event_timestamp.seconds <= $acc.metadata.event_timestamp.seconds

  match:
    $target_user over 10m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1685.002")
    $primary_entity      = array_distinct($target_user)
    $suppressing_actor   = array_distinct($cfg.principal.user.userid)
    $accessing_actor     = array_distinct($acc.principal.user.userid)
    $modified_settings   = array_distinct($cfg.target.resource.name)
    $accessed_resources  = array_distinct($acc.target.resource.name)

  condition:
    $cfg and $acc
}
