/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:30:16.075963+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_Credential_Manager_Vault_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects unexpected processes opening or reading Windows Credential Manager vault files (.vcrd) or the vault encryption key (Policy.vpol). Legitimate access to these files is performed by LSASS and a small set of system processes. Access by scripting engines, shells, or other user-space processes is a strong indicator of credential harvesting from the Windows Credential Manager (T1555.004)."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR file-read/(?i)file-open telemetry (e.g., CrowdStrike, SentinelOne, Defender for Endpoint, or Sysmon Event ID 11/23 normalised to FILE_READ or FILE_CREATION). The EDR must capture access to files under AppData\\Local\\Microsoft\\Vault and AppData\\Local\\Microsoft\\Credentials."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Backup (wbengine.exe), authorised backup agents, LSASS during normal credential operations, Windows Defender credential guard components."
    tuning_guidance = "Add authorised backup and security tooling parent process paths to %global_allowed_backup_processes and %global_allowed_security_tools. If LSASS generates noise, add it to %global_allowed_security_tools. Scope by principal.hostname if a specific host generates persistent FPs."

  events:
    $open.metadata.event_type = "FILE_READ"

    // Target the vault credential files and the encryption key file
    $open.target.file.full_path = /\\AppData\\Local\\Microsoft\\(Vault|Credentials)\\/ nocase
    $open.target.file.full_path = /(?i)\.(vcrd|vpol|vsch)$/

    // Flag access by scripting engines, shells, and common attacker-leveraged binaries
    // rather than the narrow set of system processes that legitimately touch these files
    $open.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|wmic|python|python3|ruby|perl|bash|curl|certutil|bitsadmin|msbuild|csc|vbc|installutil)\.exe$/ nocase

    // Exclude authorised backup and security tooling
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($open.principal.hostname)
    $accessing_process = array_distinct($open.principal.process.file.full_path)
    $vault_file_accessed = array_distinct($open.target.file.full_path)
    $user_context = array_distinct($open.principal.user.userid)

  condition:
    $open
}
