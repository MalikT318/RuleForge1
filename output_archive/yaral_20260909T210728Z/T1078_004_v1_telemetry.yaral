/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:21:29.669451+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_SaaS_Cloud_Account_Privilege_Escalation_Via_Role_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects privilege escalation or persistence via cloud account role or permission changes in identity provider audit logs. Adversaries who have compromised a cloud account may elevate its privileges by assigning administrative roles or modifying group memberships, producing a directory audit event rather than a process-creation event. This rule targets the resulting state change rather than the command used to invoke it."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION events. Entra ID, Okta, and Google Workspace directory audit logs all produce these events on role or group membership changes."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate IT administrators assigning roles during onboarding or access reviews. Automated provisioning pipelines using service accounts. Break-glass account activation during incidents."
    tuning_guidance = "Add known provisioning service accounts to %global_allowed_service_accounts. Add approved admin users performing routine role assignments to %global_allowed_admin_users. Consider narrowing the target role regex to only the highest-privilege roles relevant to each client environment."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // The actor performing the change must not be a known-good service account
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // The actor performing the change must not be a known-good admin user
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Target role or permission must be a high-privilege designation.
    // Matches common privileged role names across Entra ID, Okta, and Google Workspace
    // without hardcoding vendor-specific strings.
    (
      $auth.target.resource.name = /(?i)(global.?admin|company.?admin|super.?admin|privileged.?role|directory.?role|owner|billing.?admin|security.?admin|exchange.?admin|sharepoint.?admin|teams.?admin|application.?admin|cloud.?application.?admin|privileged.?auth|org.?admin|domain.?admin|group.?admin|user.?admin|it.?admin|system.?admin)/ nocase
      or
      $auth.target.user.attribute.roles = /(?i)(global.?admin|company.?admin|super.?admin|privileged.?role|directory.?role|owner|billing.?admin|security.?admin|exchange.?admin|sharepoint.?admin|teams.?admin|application.?admin|cloud.?application.?admin|privileged.?auth|org.?admin|domain.?admin|group.?admin|user.?admin|it.?admin|system.?admin)/
    )

    // The target of the role change must be a different account than the actor
    // (self-escalation is especially suspicious but also catches lateral movement)
    $auth.principal.user.userid != $auth.target.user.userid

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $target_account = array_distinct($auth.target.user.userid)
    $assigned_role = array_distinct($auth.target.resource.name)
    $actor_ip = array_distinct($auth.principal.ip)

  condition:
    $auth
}
