/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:17:40.464610+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Hypervisor_Config_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi hypervisor configuration files that are commonly altered by adversaries abusing esxcli, vim-cmd, or direct shell access. Attackers using hypervisor CLIs to configure firewall rules, disable logging, or alter host settings produce file-system state changes in well-known ESXi configuration paths. This rule targets the resulting artifact rather than the command line, providing coverage that survives command-line log evasion."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "Requires ESXi file-system audit telemetry forwarded to Chronicle via syslog or a security agent capable of emitting FILE_MODIFICATION UDM events from the ESXi host (e.g., hostd/vmkernel log enrichment or an ESXi-compatible EDR agent)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate administrator configuration changes via vCenter or direct host management, VMware Update Manager patching cycles, automated configuration management tools (Ansible, PowerCLI scripts run by authorised service accounts)."
    tuning_guidance = "Add authorised service account identifiers to %global_allowed_service_accounts. Add approved management source hosts to %global_allowed_mgmt_sources. Scope the file path regex further if only a subset of config paths are relevant to the environment."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target well-known ESXi hypervisor configuration and state paths
    // that are commonly manipulated via esxcli / vim-cmd / direct shell
    $file.target.file.full_path = /^\/etc\/vmware\// nocase or
    $file.target.file.full_path = /^\/etc\/vmware\/firewall\// nocase or
    $file.target.file.full_path = /^\/etc\/vmware\/hostd\// nocase or
    $file.target.file.full_path = /^\/etc\/vmware\/ssl\// nocase or
    $file.target.file.full_path = /^\/etc\/vmware\/pam\.d\// nocase or
    $file.target.file.full_path = /^\/scratch\/log\// nocase or
    $file.target.file.full_path = /^\/var\/run\/vmware\// nocase or
    $file.target.file.full_path = /\/esx\.conf$/ nocase or
    $file.target.file.full_path = /\/config\.xml$/ nocase or
    $file.target.file.full_path = /\/vmkernel\.log$/ nocase or
    $file.target.file.full_path = /\/syslog\.conf$/ nocase

    // Exclude authorised service and automation accounts
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude authorised management source hosts
    not $file.principal.hostname in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
