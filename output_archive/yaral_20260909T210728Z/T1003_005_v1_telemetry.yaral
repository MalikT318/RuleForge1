/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:25:19.453460+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_Linux_Cached_Domain_Cred_DB_Access {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-read or file-open access to Linux cached domain credential databases maintained by SSSD or Quest Authentication Services. Adversaries with root/sudo access read these LDB or VDB files to extract cached AD credential hashes for offline cracking. This rule fires on the file artifact access rather than on command-line telemetry, providing additive coverage over process-creation rules."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires Linux EDR or auditd file-access telemetry normalised into Chronicle UDM FILE_READ or FILE_OPEN events. Auditd rules must include '-w /var/lib/sss/db/ -p r -k sssd_cache_read' and '-w /var/opt/quest/vas/authcache/ -p r -k quest_cache_read'."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "SSSD daemon itself reading its own cache during normal operation; Quest VAS daemon performing scheduled cache refresh; backup agents reading /var/lib/sss/db/ as part of system backup; monitoring agents performing integrity checks."
    tuning_guidance = "Add the SSSD daemon process path (/usr/sbin/sssd), Quest daemon (/opt/quest/sbin/vasd), and authorised backup process paths to %global_allowed_backup_processes. Add authorised security scanning processes to %global_allowed_security_tools."

  events:
    $open.metadata.event_type = "FILE_READ"

    // Target the SSSD cached credential LDB files or Quest VAS auth cache VDB files.
    // SSSD stores per-domain caches as cache_<domain>.ldb under /var/lib/sss/db/
    // Quest stores its auth cache at /var/opt/quest/vas/authcache/vas_auth.vdb
    $open.target.file.full_path = /(?i)(\/var\/lib\/sss\/db\/cache[^\/]*\.ldb|\/var\/opt\/quest\/vas\/authcache\/vas_auth\.vdb)/

    // Exclude the legitimate daemons that own these files
    not $open.principal.process.file.full_path = /(?i)(\/usr\/sbin\/sssd|\/opt\/quest\/sbin\/vasd|\/usr\/lib\/sssd\/)/

    // Exclude authorised backup and security tooling via reference lists
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity    = array_distinct($open.principal.hostname)
    $accessing_process = array_distinct($open.principal.process.file.full_path)
    $accessed_file     = array_distinct($open.target.file.full_path)
    $acting_user       = array_distinct($open.principal.user.userid)

  condition:
    $open
}
