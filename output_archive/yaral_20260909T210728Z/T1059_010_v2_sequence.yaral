/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:16:45.145495+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoScript_FileCreation_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an AutoIT or AutoHotKey interpreter spawning a child process that subsequently creates a file in a user-writable or temp directory. This two-stage sequence (interpreter -> file drop) is characteristic of malicious AHK/AU3 scripts used as droppers or loaders, and is additive to process-launch command-line rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires EDR or Sysmon telemetry normalised to UDM PROCESS_LAUNCH and FILE_CREATION events. Both event types must include principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate AutoIT-packaged installers or enterprise automation scripts that write files during normal operation. AutoHotKey productivity scripts that save output to temp directories."
    tuning_guidance = "Add known-good AutoIT/AHK wrapper executables or parent process paths to %global_allowed_script_hosts. Add approved automation service accounts to %global_allowed_service_accounts to suppress noise from sanctioned automation pipelines."

  events:
    // Stage 1: AutoIT or AutoHotKey interpreter (or compiled stub) launches a child process.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(?i)(\\AutoIt3(GUI)?\.exe|\\AutoHotkey(U32|U64|32|64)?\.exe|\\Aut2Exe\.exe)$/
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Stage 2: A process on the same host creates a file in a user-writable or staging location.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\\Temp\\|\\AppData\\|\\ProgramData\\|\\Users\\Public\\|\\Downloads\\)/
    $file.target.file.full_path = /(?i)\.(exe|dll|bat|ps1|vbs|js|hta|cmd|scr|pif|com)$/
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Chronological ordering: process launch must precede file creation
    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $autoscript_interpreter = array_distinct($proc.principal.process.file.full_path)
    $child_process_launched = array_distinct($proc.target.process.file.full_path)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
