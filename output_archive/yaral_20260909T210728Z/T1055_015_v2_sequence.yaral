/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:09:49.809017+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_Process_Open_Then_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process opening a handle to a process with a GUI window followed by process injection into that same target, consistent with ListPlanting message-passing injection."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires EDR telemetry capturing PROCESS_OPEN and PROCESS_INJECTION events with handle access rights."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debugging tools, accessibility software, screen readers, UI automation frameworks, RMM agents performing process inspection."
    tuning_guidance = "Add approved debugging and accessibility tools to %global_allowed_security_tools. Exclude known automation frameworks from %global_allowed_admin_tools."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\.exe$/ nocase
    $open.target.process.file.full_path = /\\(explorer|taskmgr|mmc|notepad|calc|control|regedit|services|eventvwr)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.target.process.pid = $target_pid

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\.exe$/ nocase
    $inj.target.process.file.full_path = /\\(explorer|taskmgr|mmc|notepad|calc|control|regedit|services|eventvwr)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    $inj.principal.hostname = $hostname
    $inj.target.process.pid = $target_pid

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $target_pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($open.principal.hostname)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $target_process = array_distinct($inj.target.process.file.full_path)

  condition:
    $open and $inj
}
