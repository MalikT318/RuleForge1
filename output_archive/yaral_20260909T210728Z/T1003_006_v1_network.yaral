/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:26:04.084238+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_Network_Replication_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects network-side indicators of DCSync attacks by identifying MS-DRSR (Directory Replication Service Remote Protocol) traffic originating from non-domain-controller hosts. DCSync abuses the DRS API over RPC (typically port 135 and high ephemeral ports) to pull credential data from Active Directory. This rule flags NETWORK_CONNECTION events where a non-DC internal host initiates outbound connections to a domain controller on ports associated with RPC endpoint mapping and DRSUAPI replication. Excludes known internal ranges via reference list to reduce noise from legitimate DC-to-DC replication."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires firewall or network perimeter logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source and destination IP, port, and protocol must be populated. Internal DC IP ranges should be added to %global_allowed_mgmt_sources for tuning."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate domain controller replication between DCs (DC-to-DC DRSR traffic). Azure AD Connect / AD synchronisation services. Backup and identity management tools performing directory reads. Vulnerability scanners probing RPC endpoints."
    tuning_guidance = "Add known DC-to-DC replication source IPs to %global_allowed_mgmt_sources. Add authorised AD sync service source IPs to %global_allowed_scanners or %global_allowed_backup_processes as appropriate. Consider narrowing to specific destination IP ranges representing your DC subnet if those are stable."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target port 135 (RPC Endpoint Mapper) - the initial handshake for DRSUAPI
    // OR high RPC dynamic ports commonly used for DRSUAPI after endpoint negotiation
    // OR port 389/636 (LDAP/LDAPS) used in some replication-adjacent enumeration
    (
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269 or
      ($net.target.port >= 49152 and $net.target.port <= 65535)
    )

    // Protocol must be TCP - DRSUAPI runs over TCP
    $net.network.ip_protocol = "TCP"

    // Source must be an internal host (not already excluded as a known-good mgmt source)
    // Exclude known legitimate DC replication sources and authorised sync tools
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_backup_processes

    // Destination must NOT be an external address - DCSync targets internal DCs
    // Exclude traffic destined for external IPs (DCSync is always internal)
    $net.target.ip in %rfc1918_internal

    // Source must also be internal (prevents external scanner noise)
    $net.principal.ip in %rfc1918_internal

    // Exclude known authorised scanners probing RPC
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
