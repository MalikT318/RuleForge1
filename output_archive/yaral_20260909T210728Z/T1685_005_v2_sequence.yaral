/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:40:24.844964+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_EventLog_File_Deletion_After_Privilege_Escalation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage defense impairment pattern: a process opens or modifies the Windows Event Log service registry configuration (disabling or reconfiguring audit logging), followed within 10 minutes by file deletion or modification of .evtx log files under the winevt logs directory on the same host. This correlation provides additive coverage beyond command-line wevtutil/PowerShell detections by targeting the registry tamper-then-file-wipe sequence used by post-exploitation frameworks."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires EDR or Sysmon telemetry normalised to UDM REGISTRY_MODIFICATION and FILE_MODIFICATION or FILE_DELETION events. Registry auditing must be enabled for HKLM\\SYSTEM\\CurrentControlSet\\Services\\EventLog. File system auditing or EDR file telemetry must cover C:\\Windows\\System32\\winevt\\logs\\."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Update or servicing stack rotating event log files; backup agents archiving .evtx files; SIEM/log-forwarding agents that truncate logs on schedule; authorised security tooling performing log management."
    tuning_guidance = "Add backup and log-management service account names to %global_allowed_service_accounts. Add approved backup process paths to %global_allowed_backup_processes. If a specific host runs scheduled log rotation, suppress by hostname via the %global_allowed_admin_tools exclusion on the registry event side."

  events:
    // First event: registry modification targeting the EventLog service configuration,
    // indicating an attempt to disable, reconfigure, or tamper with audit log settings.
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Services\\EventLog/
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    // Second event: file modification or deletion of .evtx files in the winevt logs path,
    // indicating the actual log file is being wiped or overwritten after the registry tamper.
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\winevt\\[Ll]ogs\\.*\.evtx$/
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: registry tamper must precede file wipe.
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1685.005")
    $primary_entity = array_distinct($hostname)
    $tampered_registry_keys = array_distinct($reg.target.registry.registry_key)
    $wiped_log_files = array_distinct($file.target.file.full_path)
    $offending_processes_reg = array_distinct($reg.principal.process.file.full_path)
    $offending_processes_file = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $file
}
