/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:20:13.449906+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Domain_Account_SSH_AuthorizedKeys_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation or modification of SSH authorized_keys files outside of expected administrative tooling. Adversaries who have obtained domain account credentials on Linux systems frequently persist by writing their own public key into ~/.ssh/authorized_keys or /root/.ssh/authorized_keys, enabling future passwordless access. This rule targets the resulting file artifact rather than the command used to write it, providing a detection layer that survives command-line obfuscation."
    mitre_tactic    = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events. Auditd rules should watch -w /root/.ssh -p wa and -w /home -p wa with sufficient recursion depth, or equivalent EDR file-monitoring coverage."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate SSH key provisioning by configuration management tools (Ansible, Puppet, Chef, Salt), authorised admin scripts, cloud-init on first boot, and jump-host automation. Baseline expected writers and add them to %global_allowed_admin_tools or %global_allowed_service_accounts."
    tuning_guidance = "Exclude known provisioning processes via %global_allowed_admin_tools. Exclude service accounts that legitimately rotate SSH keys via %global_allowed_service_accounts. Consider narrowing to high-value accounts (root, sudo-capable users) if volume is high. Correlate with preceding authentication events from external IPs for higher-confidence alerting."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION" or
    $file.metadata.event_type = "FILE_CREATION"

    // Target the authorized_keys artifact in any user home directory or root
    $file.target.file.full_path = /\/\.ssh\/authorized_keys$/ nocase

    // Exclude expected provisioning and security tooling from triggering
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity    = array_distinct($file.principal.hostname)
    $modified_key_path = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
