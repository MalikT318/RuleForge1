/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:39:25.947320+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Auditd_Config_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of Linux Audit system configuration and rules files (/etc/audit/audit.rules, /etc/audit/auditd.conf, /etc/audit/rules.d/*). Adversaries with root access may tamper with these files to disable or weaken audit logging, hiding subsequent malicious activity. This rule fires on the resulting file artifact rather than the command line, providing coverage that evades process-creation-only detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR or auditd file-watch telemetry normalised to Chronicle UDM FILE_CREATION or FILE_MODIFICATION events. Auditd must have a -w watch on /etc/audit/ with -p wa permissions."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate auditd rule deployments by configuration management tools (Ansible, Puppet, Chef, Salt), security hardening scripts, OS package upgrades (auditd package post-install scripts), and authorised security engineers updating audit policy."
    tuning_guidance = "Add authorised configuration-management service accounts to %global_allowed_service_accounts and authorised admin users to %global_allowed_admin_users. Consider narrowing severity based on the specific file modified (audit.rules vs rules.d drop-ins)."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target the canonical auditd configuration and rules files
    // Covers: /etc/audit/auditd.conf, /etc/audit/audit.rules,
    //         /etc/audit/rules.d/<anything>, /etc/audit/audit.rules.d/<anything>
    $file.target.file.full_path = /^\/etc\/audit\// nocase

    // Restrict to meaningful auditd config and rules file extensions/names
    $file.target.file.full_path = /\/(auditd\.conf|audit\.rules|.*\.rules)$/ nocase

    // Exclude authorised service and admin accounts performing legitimate config management
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

    // Exclude known authorised security tooling performing policy deployment
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)
    $actor_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
