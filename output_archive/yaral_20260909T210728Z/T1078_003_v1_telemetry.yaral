/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:20:52.096115+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Local_Account_Auth_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects successful authentication events from local accounts (non-domain, non-service) that are not expected to authenticate interactively or remotely. Adversaries abusing local accounts for persistence, lateral movement, or privilege escalation will produce authentication events at the identity layer even when command-line logging is suppressed or evaded. This rule targets the resulting authentication state change rather than the process that triggered it."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires identity provider or Windows Security Event Log authentication events normalised to UDM USER_LOGIN. Windows Event IDs 4624 (logon type 3/10), 4648 are ideal sources. Chronicle must ingest and normalise these to the identity UDM schema."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate local administrator accounts used by IT staff for break-glass access, helpdesk tooling using local service accounts, authorised RMM agents authenticating with local credentials, scheduled maintenance windows."
    tuning_guidance = "Add approved local service and admin account identifiers to %global_allowed_service_accounts. Add approved remote management source addresses to %global_allowed_mgmt_sources. Reduce severity for accounts already in %global_allowed_admin_users."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Target a local account: UPN or domain portion absent or matches the
    // hostname itself (local account convention: HOSTNAME\username or .\username).
    // A local account's domain field equals the machine name, not a directory domain.
    // We match where the user domain equals the target hostname (local SAM account).
    $auth.target.user.userid = $userid
    $auth.target.hostname = $hostname

    // Exclude well-known built-in system accounts that generate high-volume
    // benign local auth events.
    not $auth.target.user.userid = /(?i)^(system|local service|network service|anonymous logon|iis apppool)$/

    // Exclude accounts already approved as service or admin accounts.
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

    // Exclude authentications originating from approved remote management sources.
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Exclude internal-only traffic that is expected (e.g. local loopback / internal mgmt).
    // We intentionally keep internal lateral movement in scope, so we do NOT
    // blanket-exclude RFC1918 - only approved mgmt sources above are excluded.

    // Require a non-empty source IP to focus on network/remote authentications
    // (logon type 3 / remote interactive) rather than purely local console logons,
    // which are lower risk and higher volume.
    $auth.principal.ip != ""

    // Capture source IP for outcome enrichment.
    $auth.principal.ip = $src_ip

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($hostname)
    $authenticated_user = array_distinct($userid)
    $source_ip = array_distinct($src_ip)

  condition:
    $auth
}
