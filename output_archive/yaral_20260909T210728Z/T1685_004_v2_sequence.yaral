/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:39:45.085575+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_004_Auditd_Config_Tamper_Then_Service_Stop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage Linux Audit system impairment: first a modification to an auditd configuration or rules file, followed by a process action consistent with stopping or disabling the auditd service on the same host within 10 minutes. This sequence is strongly indicative of an adversary attempting to blind the audit subsystem before or after malicious activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR or auditd FILE_MODIFICATION and PROCESS_LAUNCH telemetry normalised to UDM. The EDR agent must capture file write events on /etc/audit/ and process launches for systemctl/service."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate auditd rule updates by configuration management tools (Ansible, Puppet, Chef), OS patching pipelines, or authorised security hardening scripts. Service restarts during OS upgrades may also trigger this sequence."
    tuning_guidance = "Add configuration management service accounts to %global_allowed_service_accounts and automation hosts to %global_allowed_admin_tools. Consider narrowing the time window if false-positive rates are high in heavily automated environments."

  events:
    // Event 1: Modification of an auditd configuration or rules file
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/audit\/(audit\.rules|audit\.conf|rules\.d\/.+|auditd\.conf)$/
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Event 2: Process launch consistent with stopping or disabling auditd
    $svc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $svc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/systemctl$/
        and $svc.target.process.command_line = /(?i)(stop|disable|mask)\s+auditd/
      )
      or
      (
        $svc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/service$/
        and $svc.target.process.command_line = /(?i)auditd\s+stop/
      )
      or
      (
        $svc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/kill(all)?$/
        and $svc.target.process.command_line = /(?i)auditd/
      )
    )
    not $svc.principal.user.userid in %global_allowed_service_accounts
    $svc.principal.hostname = $hostname

    // Chronological ordering: config tamper must precede service disruption
    $file.metadata.event_timestamp.seconds <= $svc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($svc.principal.user.userid)
    $service_command = array_distinct($svc.target.process.command_line)

  condition:
    $file and $svc
}
