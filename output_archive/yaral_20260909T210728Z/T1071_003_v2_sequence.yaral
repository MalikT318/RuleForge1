/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:34:14.662351+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_NetDev_MailProto_C2_Flow_Sequence {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a network device (router, switch, firewall) initiating an outbound connection on a mail protocol port (SMTP 25/465/587, POP3 110/995, IMAP 143/993) to an external host, followed within 5 minutes by a second outbound mail-protocol flow from the same device. Network devices have no legitimate reason to originate mail-protocol sessions; repeated flows suggest C2 beaconing over mail protocols."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires firewall or flow telemetry (NetFlow/IPFIX/sFlow) that records source IP, destination port, and protocol for connections originating from network infrastructure devices. Both events must be normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Network devices with embedded mail-alerting features (e.g., SNMP-trap-to-email gateways, out-of-band management appliances that send health alerts via SMTP). Authorised network monitoring systems that relay mail through a managed device."
    tuning_guidance = "Add the management-plane source addresses of approved mail-relay appliances to %global_allowed_mgmt_sources. Add known-good external mail relay domains to %global_allowed_domains. Narrow the rule to specific device subnets by adjusting the principal.ip exclusion against %rfc1918_internal if internal mail servers must be excluded."

  events:
    // First event: network device originates an outbound mail-protocol connection
    $flow1.metadata.event_type = "NETWORK_CONNECTION"
    (
        $flow1.target.port = 25 or
        $flow1.target.port = 465 or
        $flow1.target.port = 587 or
        $flow1.target.port = 110 or
        $flow1.target.port = 995 or
        $flow1.target.port = 143 or
        $flow1.target.port = 993
    )
    // Destination must be external (not RFC-1918)
    not $flow1.target.ip in %rfc1918_internal
    // Source must not be an approved management source
    not $flow1.principal.ip in %global_allowed_mgmt_sources
    // Bind the originating device IP as the join key
    $flow1.principal.ip = $device_ip

    // Second event: same device makes another outbound mail-protocol connection
    $flow2.metadata.event_type = "NETWORK_CONNECTION"
    (
        $flow2.target.port = 25 or
        $flow2.target.port = 465 or
        $flow2.target.port = 587 or
        $flow2.target.port = 110 or
        $flow2.target.port = 995 or
        $flow2.target.port = 143 or
        $flow2.target.port = 993
    )
    not $flow2.target.ip in %rfc1918_internal
    not $flow2.principal.ip in %global_allowed_mgmt_sources
    $flow2.principal.ip = $device_ip

    // Chronological ordering: first flow precedes second flow
    $flow1.metadata.event_timestamp.seconds <= $flow2.metadata.event_timestamp.seconds

    // Ensure the two events are distinct (different destination or different timestamp)
    $flow1.metadata.event_timestamp.seconds < $flow2.metadata.event_timestamp.seconds

  match:
    $device_ip over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1071.003")
    $primary_entity      = array_distinct($device_ip)
    $destination_ips     = array_distinct($flow2.target.ip)
    $destination_ports   = array_distinct($flow2.target.port)
    $flow_count          = count($flow2.metadata.event_timestamp.seconds)

  condition:
    $flow1 and $flow2
}
