/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:39:05.134560+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_SecurityTool_UI_Spoof_RegThenProcess {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage UI-spoofing pattern: a registry modification that suppresses or disables Windows Security Center / Defender notification and status reporting, followed within 10 minutes by the launch of a process that renders a window or tray icon from an unexpected parent or path. Adversaries disable the real security UI via registry and then spawn a fake replacement to maintain the appearance of normal protection."
    mitre_tactic    = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires EDR or Sysmon registry-modification telemetry (REGISTRY_MODIFICATION) and process-launch telemetry (PROCESS_LAUNCH) normalised to UDM. Both event types must be present for the correlation to fire."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate security-product installers or updaters that temporarily modify Security Center registry keys; enterprise GPO pushes that configure notification suppression; AV/EDR self-update processes that briefly restart their tray agent."
    tuning_guidance = "Add known-good security-product update binaries to %global_allowed_security_tools. Add authorised service accounts that perform GPO-driven registry changes to %global_allowed_service_accounts. Narrow the registry key regex if only specific sub-keys are relevant in your environment."

  events:
    //(?i) --- Leg 1: Registry modification suppressing Security Center / Defender UI ---
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\(Windows Defender|SecurityCenter|SecurityCenter2|Windows Security|Notifications|SystemTray)/
    (
        $reg.target.registry.registry_value_name = /(?i)(DisableNotifications|HideNotifications|UILockdown|DisableAntiSpyware|DisableAntiVirus|DisableRealtimeMonitoring|ShowNotifications|EnableLUA|DisableWindowsSecurityCenter)/
    )
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    //(?i) --- Leg 2: A process launches that presents a UI / tray icon from a suspicious location ---
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    //(?i) Target process renders a window or tray: look for processes outside expected system/security-product paths
    // that reference security-UI-related strings in their command line or path
    (
        $proc.target.process.command_line = /(?i)(SecurityHealth|WindowsDefender|WinDefend|TrayIcon|systray|notify|balloon|toast|shield|protected|secure|antivirus|antimalware)/
    )
    // Must NOT originate from the canonical Windows Security Health path
    not $proc.target.process.file.full_path = /(?i)\\Windows\\(System32|SysWOW64)\\SecurityHealth/
    not $proc.target.process.file.full_path = /(?i)\\Program Files\\Windows Defender/
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname

    // --- Chronological ordering: registry tamper precedes fake UI launch ---
    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1685.003")
    $primary_entity      = array_distinct($hostname)
    $modified_reg_keys   = array_distinct($reg.target.registry.registry_key)
    $modified_reg_values = array_distinct($reg.target.registry.registry_value_name)
    $spoofing_process    = array_distinct($proc.target.process.file.full_path)
    $spoofing_cmdline    = array_distinct($proc.target.process.command_line)
    $actor_user          = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $proc
}
