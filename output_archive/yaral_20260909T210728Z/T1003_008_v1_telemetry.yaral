/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:27:24.272663+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_File_Read_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read access to /etc/shadow by processes other than approved system utilities, indicating potential credential harvesting."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux EDR or auditd file access telemetry with FILE_READ events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup software, configuration management tools (Ansible, Puppet, Chef), security scanners, password management utilities, system monitoring agents."
    tuning_guidance = "Add approved backup and configuration management processes to %global_allowed_backup_processes. Add security tooling to %global_allowed_security_tools."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = "/etc/shadow"
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /^\/(usr\/)?s?bin\/(useradd|usermod|userdel|passwd|chpasswd|pwck|grpck|vipw|vigr|chage|newusers|pam_tally2|faillock)$/ nocase
    not $file.principal.process.file.full_path = /^\/(usr\/)?s?bin\/(systemd-logind|login|sshd|su|sudo|polkitd)$/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $reading_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
