/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:31:54.047079+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_SecretsManager_BulkAccess_After_Recon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud identity that first enumerates secrets (list/describe operations) and then performs bulk secret retrieval within a short window. This pattern is consistent with an adversary who has obtained sufficient cloud privileges and is systematically harvesting credentials from a managed secrets store (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault). The rule is vendor-agnostic via UDM normalisation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Requires cloud provider audit logs normalised to Chronicle UDM (CloudTrail, GCP Audit Logs, or Azure Activity Logs). Both USER_RESOURCE_ACCESS events for list/describe and secret-value retrieval operations must be ingested."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Automated secret rotation pipelines, CI/CD systems performing bulk secret reads at deployment time, authorised security scanning tools, and backup processes that enumerate secrets vaults."
    tuning_guidance = "Add known automation and service account identifiers to %global_allowed_service_accounts. Add approved scanner principals to %global_allowed_scanners. Add approved cloud principals to %global_allowed_cloud_principals. Raise the threshold on the retrieval event if bulk reads are expected in your environment."

  events:
    // Event 1: Secrets enumeration - list or describe operations against a secrets store
    $recon.metadata.event_type = "USER_RESOURCE_ACCESS"
    $recon.target.resource.resource_type = "CREDENTIAL"
    (
      $recon.metadata.product_event_type = /(?i)(listsecrets|list.secrets|listsecretversions|list.secret|getsecret$|describesecret|list_secrets|list-secrets|getSecretMetadata|vaults\/secrets$)/
      or
      $recon.target.resource.attribute.labels.key = /(?i)(action|operation)/ and
      $recon.target.resource.attribute.labels.value = /(?i)(list|describe|enumerate)/
    )
    not $recon.principal.user.userid in %global_allowed_service_accounts
    not $recon.principal.user.userid in %global_allowed_cloud_principals
    not $recon.principal.user.userid in %global_allowed_scanners
    $recon.principal.user.userid = $cloud_identity

    // Event 2: Actual secret value retrieval - get-secret-value / access operations
    $retrieve.metadata.event_type = "USER_RESOURCE_ACCESS"
    $retrieve.target.resource.resource_type = "CREDENTIAL"
    (
      $retrieve.metadata.product_event_type = /(?i)(getsecretvalue|get.secret.value|accesssecretversion|access.secret.version|getsecret.value|keyvault.secrets.get|GetSecret|getSecretValue|secrets\/versions\/access)/
      or
      $retrieve.target.resource.attribute.labels.key = /(?i)(action|operation)/ and
      $retrieve.target.resource.attribute.labels.value = /(?i)(get|access|retrieve|read)/
    )
    not $retrieve.principal.user.userid in %global_allowed_service_accounts
    not $retrieve.principal.user.userid in %global_allowed_cloud_principals
    not $retrieve.principal.user.userid in %global_allowed_backup_processes
    $retrieve.principal.user.userid = $cloud_identity

    // Chronological ordering: enumeration must precede retrieval
    $recon.metadata.event_timestamp.seconds <= $retrieve.metadata.event_timestamp.seconds

  match:
    $cloud_identity over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity = array_distinct($cloud_identity)
    $recon_operations = array_distinct($recon.metadata.product_event_type)
    $retrieval_operations = array_distinct($retrieve.metadata.product_event_type)
    $secrets_accessed = array_distinct($retrieve.target.resource.name)
    $source_ips = array_distinct($retrieve.principal.ip)
    $recon_count = count($recon.metadata.id)
    $retrieval_count = count($retrieve.metadata.id)

  condition:
    $recon and $retrieve
}
