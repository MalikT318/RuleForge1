/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:16:06.424431+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_CloudAPI_ServicePrincipal_Login_Then_PrivilegedAction {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a service principal or non-interactive identity authenticating via cloud API (application token login) followed within 5 minutes by a privileged IAM or permissions-change action from the same principal. This pattern is consistent with adversaries abusing application access tokens or compromised service principals to invoke cloud APIs for privilege escalation or lateral movement."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires identity provider audit logs (Entra ID, Okta, or equivalent) normalised to Chronicle UDM. USER_LOGIN events must populate principal.user.userid and network.application_protocol or security_result fields indicating non-interactive/service-principal authentication. USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION events must populate target.user.userid and principal.user.userid."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate automation pipelines, CI/CD service accounts, and approved IAM provisioning workflows that authenticate programmatically and then modify permissions. Approved service accounts should be added to %global_allowed_service_accounts."
    tuning_guidance = "Add known-good automation service principals to %global_allowed_service_accounts. Narrow the permissions-change filter to specific high-risk operations (e.g., role assignments, policy attachments) if the rule generates volume from routine provisioning. Increase the risk score if the target user is a privileged or admin account."

  events:
    // Event 1: Non-interactive / service-principal / application login via cloud API
    $auth.metadata.event_type = "USER_LOGIN"
    // Application or service-principal logins are typically flagged by auth type
    // UDM normalises these into the authentication details; filter on programmatic/API auth
    $auth.extensions.auth.auth_details = /(?i)(service.?principal|application|client.?credential|non.?interactive|api.?key|managed.?identity|workload.?identity)/
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    $auth.principal.user.userid = $actor_userid

    // Event 2: Privileged permissions or group change immediately following the login
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    not $priv.principal.user.userid in %global_allowed_service_accounts
    not $priv.principal.user.userid in %global_allowed_cloud_principals
    $priv.principal.user.userid = $actor_userid

    // Enforce chronological ordering: login must precede the privileged action
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $actor_userid over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $auth_details = array_distinct($auth.extensions.auth.auth_details)
    $target_users_modified = array_distinct($priv.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $privileged_action_count = count($priv.metadata.event_timestamp.seconds)

  condition:
    $auth and $priv
}
