/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:23:09.876893+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Dump_File_After_Process_Open {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a non-system process opening a handle to lsass.exe (PROCESS_OPEN) followed within 10 minutes by creation of a minidump-style file on the same host. This two-stage signal catches memory-dump workflows (comsvcs.dll MiniDump, procdump, custom loaders) without relying on command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN events with target process name and FILE_CREATION events with full file paths. Sysmon Event IDs 10 (ProcessAccess) and 11 (FileCreate) both normalise to these UDM types."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate crash-dump collection by Windows Error Reporting (WerFault.exe), authorised memory-forensics tooling, backup agents that snapshot process state, and some AV/EDR self-diagnostics."
    tuning_guidance = "Add authorised dump-collection binaries (e.g. WerFault.exe paths) to %global_allowed_security_tools. Add backup or forensics service accounts to %global_allowed_backup_processes. Narrow the dump-file regex if your environment uses a fixed dump directory."

  events:
    // Stage 1: a process opens a handle to lsass.exe
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /(?i)\\lsass\.exe$/
    // Exclude known-good security tooling from triggering the open side
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    // Capture the host for the join
    $open.principal.hostname = $hostname

    // Stage 2: a dump-style file is created on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\.(dmp|mdmp|dump|bin)$/
    // Exclude Windows built-in crash dump directories to reduce WER noise
    not $file.target.file.full_path = /(?i)\\Windows\\(Minidump|LiveKernelReports|MEMORY\.DMP)/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    // Chronological ordering: handle open must precede file creation
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity    = array_distinct($hostname)
    $opener_process    = array_distinct($open.principal.process.file.full_path)
    $dump_files        = array_distinct($file.target.file.full_path)
    $dump_writer       = array_distinct($file.principal.process.file.full_path)

  condition:
    $open and $file
}
