/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:11:49.262070+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_CmdShell_Drops_File_Then_Executes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage sequence where cmd.exe creates a file in a suspicious writable location and then a new process is launched from that same location within 5 minutes. This indicates cmd.exe being used to stage and execute a payload, providing additive coverage beyond simple command-line matching."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (FILE_CREATION) and process-launch telemetry (PROCESS_LAUNCH). Both event types must be normalised into UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that unpack to TEMP and self-execute; build pipelines writing and running scripts; RMM agents deploying patches via cmd.exe."
    tuning_guidance = "Add known-good parent processes (e.g. installer frameworks) to %global_allowed_admin_tools. Add authorised service accounts that perform deployment tasks to %global_allowed_service_accounts."

  events:
    // Event 1: cmd.exe creates a file in a user-writable or staging directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /(?i)\\cmd\.exe$/
    $file.target.file.full_path = /(?i)\\(temp|tmp|appdata\\local\\temp|users\\public|programdata|windows\\temp)\\/
    $file.target.file.full_path = /(?i)\.(exe|bat|cmd|ps1|vbs|js|hta|scr|com|pif)$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $dropped_path

    // Event 2: a new process is launched from the same dropped file path
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $dropped_path
    $proc.principal.hostname = $hostname
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

    // Enforce chronological ordering: file must be created before execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $dropped_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($hostname)
    $dropped_file_paths = array_distinct($proc.target.process.file.full_path)
    $cmd_parent_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
