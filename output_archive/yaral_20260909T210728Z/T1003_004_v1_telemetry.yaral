/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:24:40.876827+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Registry_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects registry read or modification access to HKLM\\SECURITY\\Policy\\Secrets, where LSA secrets including service account credentials and cached domain credentials are stored. Legitimate access to this key is extremely rare outside of the SYSTEM account performing internal OS operations. This rule targets the registry state-change layer rather than process command lines, providing coverage orthogonal to process-creation detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires EDR or Sysmon registry event telemetry (Sysmon Event ID 12/13/14 or equivalent EDR registry events) normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION. Windows Security audit policy for registry object access (Event 4663) also satisfies this requirement when normalised."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows LSASS performing internal credential refresh operations (typically under SYSTEM context); some backup agents that snapshot the registry hive; domain join or GPO application operations. These are rare and should be validated against the principal process and user context."
    tuning_guidance = "Add known-good backup or security agent process paths to %global_allowed_backup_processes or %global_allowed_security_tools. If SYSTEM-context access from lsass.exe generates noise, add a secondary filter on principal.process.file.full_path excluding lsass.exe after validating the environment. Scope by principal.user.userid to exclude the SYSTEM account if internal OS operations are confirmed benign."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)HKEY_LOCAL_MACHINE\\SECURITY\\Policy\\Secrets/
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $accessing_process = array_distinct($reg.principal.process.file.full_path)
    $accessing_user = array_distinct($reg.principal.user.userid)
    $registry_key_accessed = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
