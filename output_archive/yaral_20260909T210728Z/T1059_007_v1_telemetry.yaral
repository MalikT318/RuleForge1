/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:14:28.850877+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_JS_Script_File_Drop_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation of JavaScript/JScript artifacts (.js, .jse, .wsf, .hta) in user-writable or suspicious directories on Windows. Adversaries executing T1059.007 must write a script file to disk before or during execution; this rule catches the resulting file artifact rather than the command-line invocation, providing coverage that survives command-line obfuscation or logging gaps."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write telemetry."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web developers writing .js files under project directories; Node.js package managers (npm/(?i)yarn) unpacking modules; legitimate HTA-based admin tools; software installers dropping .wsf/.js setup scripts."
    tuning_guidance = "Add known-good parent processes (IDE launchers, package managers, deployment agents) to %global_allowed_admin_tools. Scope the path regex more narrowly if high-volume hits occur in specific directories such as node_modules. Consider raising severity if the creating process is a browser, document reader, or email client."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    //(?i) Target file must be a JavaScript/JScript-family script extension
    $file.target.file.full_path = /\.(js|jse|wsf|hta)$/ nocase

    // File written into user-writable or staging locations commonly abused by adversaries
    // Covers: %TEMP%, %APPDATA%, %LOCALAPPDATA%, Downloads, Public, ProgramData, and root of C:\
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData\\(Local\\Temp|Local|Roaming)|Downloads|Desktop)|\\Windows\\Temp|\\ProgramData|^[A-Za-z]:\\[^\\]+\.(js|jse|wsf|hta)$)/

    // Creating process is a high-risk parent: document readers, browsers, email clients,
    // script hosts themselves spawning child writes, or living-off-the-land binaries
    $file.principal.process.file.full_path = /(?i)\\(winword|excel|powerpnt|outlook|msaccess|onenote|acrord32|acrobat|chrome|msedge|firefox|iexplore|mshta|wscript|cscript|powershell|pwsh|cmd|msiexec|regsvr32|rundll32|certutil|bitsadmin|wmic|msbuild|cmstp|installutil)\.exe$/

    // Exclude known-good administrative and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude backup and imaging processes that may stage script files
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
