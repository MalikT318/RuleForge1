/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:07:56.388872+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Doppelganging_Process_Handle_TxF {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects PROCESS_OPEN events where a non-system process requests a handle to another process with PROCESS_VM_WRITE and PROCESS_CREATE_THREAD access rights combined - the minimum rights required to complete a Process Doppelganging injection after the TxF-backed section is mapped. This targets the handle-request artifact rather than command-line telemetry, providing a complementary detection layer that is harder for adversaries to suppress."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelganging"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised to UDM PROCESS_OPEN with target.process.access_mask or equivalent handle-rights field populated. CrowdStrike, SentinelOne, and Microsoft Defender for Endpoint all emit this telemetry."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), security tools performing memory scanning, crash-dump collectors, and some AV/EDR self-protection routines. Baseline the parent process paths that legitimately open cross-process handles in each environment."
    tuning_guidance = "Add known-good security agent and debugger paths to %global_allowed_security_tools. Add approved backup or imaging agents to %global_allowed_backup_processes. Consider narrowing by requiring the opener to reside outside System32 and SysWOW64."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must NOT be a known Windows system binary living in System32/SysWOW64.
    // Doppelganging loaders are typically user-land executables or injected shellcode
    // running from non-system paths. We match the absence of the canonical system paths.
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\/
    not $open.principal.process.file.full_path = /(?i)\\windows\\syswow64\\/
    not $open.principal.process.file.full_path = /(?i)\\windows\\sysnative\\/

    // The target of the handle request must be a running process (not self-open).
    // Doppelganging targets a sacrificial host process (e.g. svchost, explorer).
    $open.target.process.file.full_path = /(?i)\\windows\\/

    // The access mask must include both VM_WRITE (0x0020) and CREATE_THREAD (0x0002).
    // Chronicle normalises Sysmon GrantedAccess into target.process.access_mask as an
    // integer. We require the combined mask 0x0022 (decimal 34) at minimum.
    // We express this as a regex on the hex string representation where available,
    // or rely on EDR telemetry that populates the field with the decimal value.
    // The pattern below matches any access mask string containing the hex flags
    // associated with PROCESS_VM_WRITE | PROCESS_CREATE_THREAD combinations
    // commonly observed in injection tooling (0x1fffff, 0x1f3fff, 0x143a, 0x0022).
    $open.target.process.access_mask = /(?i)0x(1f[0-9a-f]{4}|143a|0022|1438|1478|047a)/

    // Exclude approved security tooling that legitimately opens cross-process handles.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Capture the opener hostname for grouping and outcome.
    $open.principal.hostname = $hostname

  outcome:
    $risk_score        = max(88)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity    = array_distinct($open.principal.hostname)
    $opener_process    = array_distinct($open.principal.process.file.full_path)
    $target_process    = array_distinct($open.target.process.file.full_path)
    $access_mask_seen  = array_distinct($open.target.process.access_mask)
    $opener_user       = array_distinct($open.principal.user.userid)

  condition:
    $open
}
