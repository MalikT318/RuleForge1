/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:35:11.907598+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_PubSub_Protocol_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections to external destinations on ports commonly associated with publish/subscribe messaging protocols (MQTT 1883/8883, AMQP 5671/5672, STOMP 61613/61614, XMPP 5222/5269). Adversaries abuse these protocols to blend C2 traffic with legitimate messaging infrastructure. This rule covers the network-observable behaviour from firewall/perimeter telemetry and is additive to endpoint process-launch detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW with target.port populated. Internal RFC1918 exclusions applied via reference list."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "IoT device management platforms, legitimate MQTT brokers (AWS IoT, Azure IoT Hub, HiveMQ), enterprise messaging middleware (RabbitMQ, ActiveMQ), XMPP-based chat clients (Jabber), CI/CD pipeline event buses."
    tuning_guidance = "Add known-good external broker FQDNs or IPs to %global_allowed_domains. Add internal scanner or monitoring hosts to %global_allowed_scanners. If the environment legitimately uses cloud IoT services, consider scoping by source subnet or adding approved destination IPs to %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match on pub/sub protocol ports: MQTT (1883, 8883), AMQP (5672, 5671), STOMP (61613, 61614), XMPP client (5222), XMPP server (5269)
    (
      $net.target.port = 1883 or
      $net.target.port = 8883 or
      $net.target.port = 5672 or
      $net.target.port = 5671 or
      $net.target.port = 61613 or
      $net.target.port = 61614 or
      $net.target.port = 5222 or
      $net.target.port = 5269
    )

    // Exclude internal/RFC1918 destinations - firewall logs see the destination IP
    not $net.target.ip in %rfc1918_internal

    // Exclude approved source addresses (scanners, authorised mgmt)
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude known-good external messaging/broker domains if DNS name is populated
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $destination_hostname = array_distinct($net.target.hostname)

  condition:
    $net
}
