/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:35:31.930761+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_PubSub_External_Burst_Then_Sustained_Flow {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a Linux host making an initial outbound connection to a non-standard external destination on a pub/sub protocol port (MQTT 1883/8883, AMQP 5672/5671, STOMP 61613/61614, XMPP 5222/5269), followed within 5 minutes by a sustained flow to the same destination. This pattern is consistent with C2 over pub/sub messaging protocols where an implant subscribes to a broker topic and then maintains a persistent session. The rule fires on network-observable behaviour only and does not require endpoint telemetry."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW events with principal.ip, target.ip, target.port, and network.sent_bytes populated."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate IoT gateways using MQTT, enterprise middleware using AMQP (RabbitMQ, ActiveMQ), chat infrastructure using XMPP, authorised message bus integrations. Add known-good internal sources to %global_allowed_mgmt_sources and known-good external brokers to %global_allowed_domains."
    tuning_guidance = "Narrow the rule by adding approved pub/sub broker destinations to %global_allowed_domains. If internal broker IPs are used, add them to %rfc1918_internal. Raise the network.sent_bytes threshold on the sustained-flow event to reduce noise from keep-alive-only sessions."

  events:
    // Event 1: Initial outbound connection to an external IP on a pub/sub port.
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
        $conn.target.port = 1883 or
        $conn.target.port = 8883 or
        $conn.target.port = 5672 or
        $conn.target.port = 5671 or
        $conn.target.port = 61613 or
        $conn.target.port = 61614 or
        $conn.target.port = 5222 or
        $conn.target.port = 5269
    )
    not $conn.target.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_mgmt_sources
    not $conn.target.hostname in %global_allowed_domains
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip
    $conn.target.port = $dst_port

    // Event 2: Sustained flow to the same external destination on the same port,
    // confirming a persistent pub/sub session rather than a one-off probe.
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.target.port = $dst_port
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_mgmt_sources
    not $flow.target.hostname in %global_allowed_domains
    $flow.network.sent_bytes > 512
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip

    // Enforce chronological ordering: initial connection precedes sustained flow.
    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip, $dst_port over 5m

  outcome:
    $risk_score          = max(72)
    $mitre_technique_id  = array_distinct("T1071.005")
    $primary_entity      = array_distinct($src_ip)
    $destination_ips     = array_distinct($dst_ip)
    $destination_ports   = array_distinct($dst_port)
    $total_bytes_sent    = max($flow.network.sent_bytes)
    $destination_hosts   = array_distinct($flow.target.hostname)

  condition:
    $conn and $flow
}
