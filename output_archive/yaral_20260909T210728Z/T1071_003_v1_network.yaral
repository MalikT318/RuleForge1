/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:33:54.790519+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_Mail_Protocol_C2_Network_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound connections on mail protocol ports (SMTP/S, POP3/S, IMAP/S) from internal Linux hosts to external destinations. Adversaries abuse mail protocols for C2 to blend with legitimate email traffic. Firewall/perimeter telemetry provides additive coverage beyond endpoint process-launch rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW. Source IP must be populated from internal address space."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate mail clients, mail transfer agents (Postfix, Sendmail, Exim), mail relay servers, and newsletter/notification services sending outbound email. Authorised mail gateways will generate high volumes of matches."
    tuning_guidance = "Add known mail relay and MTA source IPs to %global_allowed_mgmt_sources. Add approved external mail domains to %global_allowed_domains. Consider narrowing to non-standard mail ports or unusual source hosts that are not expected to send email directly."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Mail protocol ports: SMTP(25), Submission(587), SMTPS(465), POP3(110), POP3S(995), IMAP(143), IMAPS(993)
    (
      $net.target.port = 25 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 110 or
      $net.target.port = 995 or
      $net.target.port = 143 or
      $net.target.port = 993
    )

    // Source must be an internal host (firewall sees the originating internal IP)
    $net.principal.ip = $src_ip
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not internal RFC1918 space)
    not $net.target.ip in %rfc1918_internal

    // Exclude approved mail relay sources and management infrastructure
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
