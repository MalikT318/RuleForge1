/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : SaaS
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:10:24.062495+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_ESXi_Shell_Enable_Then_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects ESXi SSH or shell service enablement followed by a shell login within 5 minutes, indicating potential attacker preparation for command execution on the hypervisor."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires ESXi hostd and authentication logs forwarded to Chronicle."
    platform = "SaaS"
    log_source = "vmware_esxi"
    false_positives = "Legitimate administrator enabling SSH for troubleshooting or maintenance; automated configuration management tools; vendor support sessions."
    tuning_guidance = "Add authorized management service accounts to %global_allowed_service_accounts and approved admin users to %global_allowed_admin_users."

  events:
    $enable.metadata.event_type = "SETTING_MODIFICATION"
    $enable.target.resource.attribute.labels["service_name"] = /(?i)(ssh|shell|esxishell|tss)/
    $enable.target.resource.attribute.labels["service_state"] = /(?i)(start|enable|running|true)/
    $enable.principal.hostname = $hostname
    not $enable.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_type = "USER_LOGIN"
    $login.target.application = /(?i)(ssh|shell|esxi)/
    $login.security_result.summary = /(?i)(success|accepted|authenticated)/
    $login.principal.hostname = $hostname
    not $login.principal.user.userid in %global_allowed_admin_users

    $enable.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($enable.principal.hostname)
    $enabling_user = array_distinct($enable.principal.user.userid)
    $login_user = array_distinct($login.principal.user.userid)
    $login_source_ip = array_distinct($login.principal.ip)

  condition:
    $enable and $login
}
