/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:33:23.165755+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_FTP_Outbound_Non_Standard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound FTP connections to non-standard ports, indicating potential C2 channel over file transfer protocol on unusual infrastructure."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires firewall or proxy logs with protocol detection and port visibility."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legacy applications using FTP on custom ports, vendor appliances with non-standard FTP configurations, development/test environments."
    tuning_guidance = "Add known legitimate FTP destinations to %global_allowed_domains or source addresses to %global_allowed_scanners if security testing."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.application_protocol = /(?i)ftp/
    not $net.target.port in [20, 21, 989, 990]
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
