/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:19:35.471238+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_Container_Default_Account_API_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud audit log events where a well-known container or Kubernetes default service account (e.g., default, system:serviceaccount:default, root, kube-system service accounts) performs resource access or creation actions via the cloud control plane. Adversaries abuse default accounts to gain initial access or escalate privileges without needing to compromise a named user credential."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires cloud provider audit logs (e.g., GCP Audit Logs, AWS CloudTrail, Azure Activity Logs) normalised into Chronicle UDM. Kubernetes API server audit logs forwarded to the cloud audit pipeline are also applicable."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate workloads intentionally running under the default service account in non-production namespaces. Cluster bootstrapping operations during initial setup. Managed Kubernetes add-ons that use default service accounts before being reconfigured."
    tuning_guidance = "Add known-good automation principals that legitimately use default accounts to %global_allowed_service_accounts. Scope the rule to production namespaces by refining the principal.user.userid regex. Consider raising severity if the target resource type is a secret, role binding, or cluster-admin binding."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match well-known default and built-in container/Kubernetes account identifiers.
    // Covers: Kubernetes default service account, system:serviceaccounts in default/kube-system
    // namespaces, generic 'root' and 'default' identities normalised by UDM.
    re.regex($cloud.principal.user.userid, /(?i)(^default$|^root$|system:serviceaccount:(default|kube-system):|^service-account-default)/)

    // Exclude known-good automation and service accounts approved for this pattern.
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved cloud/identity principals (e.g., managed add-ons, operators).
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Require that an actual resource target is present to reduce noise from
    // metadata-only or health-check calls.
    $cloud.target.resource.name != ""

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
