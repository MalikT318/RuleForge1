/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:26:28.633236+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_Network_Replication_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects DCSync attacks by correlating anomalous MS-DRSR (Directory Replication Service Remote Protocol) network traffic observed by an IDS/IPS with a subsequent or concurrent suspicious replication-pattern connection from a non-DC source. DCSync abuses the DRS API to pull credential material including NTLM hashes and Kerberos keys without touching LSASS locally. This rule targets the network-layer signature of the replication protocol being invoked from an unexpected host."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires IDS/IPS network telemetry normalised to UDM NETWORK_CONNECTION and NETWORK_FLOW events. The sensor must be positioned to observe east-west traffic between domain members and domain controllers (typically TCP 135 RPC endpoint mapper followed by a high ephemeral port for DRSUAPI). Alerts or flow records flagging MS-DRSR / DRSUAPI protocol activity are required."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Legitimate domain controllers replicating with each other (ensure DC-to-DC pairs are excluded via %global_allowed_admin_tools or network segmentation). Azure AD Connect / AD synchronisation services communicating with DCs. Third-party identity management products (e.g., identity governance platforms) that use DRS APIs."
    tuning_guidance = "Populate %global_allowed_admin_tools with the hostnames or IP addresses of known AD sync services and legitimate secondary DCs. Narrow the rule further by restricting $dc_port to the specific ephemeral RPC port range observed in your environment. If your IDS enriches events with a protocol label, add a filter on that field."

  events:
    // Event 1: IDS/IPS observes an RPC endpoint-mapper probe (TCP 135) toward
    // what is likely a domain controller from a non-approved source.
    // This is the first step of DRSUAPI negotiation.
    $rpc.metadata.event_type = "NETWORK_CONNECTION"
    $rpc.target.port = 135
    $rpc.network.ip_protocol = "TCP"
    not $rpc.principal.ip in %global_allowed_mgmt_sources
    not $rpc.target.ip in %rfc1918_internal
    $rpc.principal.ip = $src_ip

    // Event 2: Shortly after, the same source establishes a high-port RPC
    // channel consistent with DRSUAPI / MS-DRSR dynamic port binding.
    // Legitimate DC replication uses ephemeral ports negotiated via port 135.
    $drsr.metadata.event_type = "NETWORK_FLOW"
    $drsr.network.ip_protocol = "TCP"
    $drsr.target.port >= 49152
    $drsr.target.port <= 65535
    not $drsr.principal.ip in %global_allowed_mgmt_sources
    not $drsr.target.ip in %rfc1918_internal
    $drsr.principal.ip = $src_ip

    // Chronological ordering: RPC endpoint mapper probe precedes DRSUAPI channel
    $rpc.metadata.event_timestamp.seconds <= $drsr.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($src_ip)
    $targeted_dc_ips = array_distinct($drsr.target.ip)
    $rpc_target_ips = array_distinct($rpc.target.ip)
    $drsr_ports_observed = array_distinct($drsr.target.port)
    $event_count = count($drsr.metadata.event_timestamp.seconds)

  condition:
    $rpc and $drsr
}
