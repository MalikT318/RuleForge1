/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:26:48.703181+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Mem_Maps_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file-read or file-open access to /proc/<PID>/mem or /proc/<PID>/maps for a process other than the reader's own PID, which is the core artifact of T1003.007 credential scraping from the proc filesystem. Attackers read these pseudo-files to extract credentials from process memory without spawning additional child processes, evading command-line-only detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux EDR or auditd with file-open/read syscall auditing enabled (auditd rules on -a always,exit -F arch=b64 -S open,openat,read -F path=/proc). The EDR or auditd must normalise these events into UDM FILE_READ or FILE_OPEN events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers (gdb, strace, ltrace), legitimate profiling tools (perf, valgrind), JVM/JIT runtimes reading their own /proc entries, container runtimes inspecting child processes, security agents performing memory scanning."
    tuning_guidance = "Add known-good profiling and debugging parent process paths to %global_allowed_security_tools. Add authorised backup or forensic processes to %global_allowed_backup_processes. Consider scoping the rule to cross-PID access only if the EDR populates both the reader PID and the target PID in the path."

  events:
    $open.metadata.event_type = "FILE_READ"

    // Target must be a /proc/<numeric-PID>/mem or /proc/<numeric-PID>/maps pseudo-file.
    // The pattern anchors on /proc/ followed by one or more digits (a real PID),
    // then exactly /mem or /maps. This excludes /proc/self/ (own-process reads)
    // and /proc/net/, /proc/sys/, etc. which are not credential-bearing.
    $open.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps)$/

    // Exclude reads where the accessing process is a known security or backup agent.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude reads originating from known-good script hosts (e.g., monitoring agents
    // implemented as shell scripts that legitimately inspect /proc).
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($open.principal.hostname)
    $accessing_process = array_distinct($open.principal.process.file.full_path)
    $target_proc_path = array_distinct($open.target.file.full_path)
    $accessing_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
