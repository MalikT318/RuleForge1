/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:30:36.711612+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_CredMgr_VaultFile_Read_Then_Network {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a non-system process opening or reading Windows Credential Manager vault files (.vcrd / Policy.vpol) followed by an outbound network connection from the same process on the same host within 10 minutes. This pattern is consistent with credential harvesting and exfiltration from the Windows Credential Locker, and is additive to existing process-launch / command-line detections."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR or Sysmon file-read/open telemetry (FILE_READ or FILE_OPEN events on vault paths) and network connection telemetry (NETWORK_CONNECTION). Both must be normalised to UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Windows Backup (wbengine.exe), DPAPI-aware backup agents, credential sync tools, Windows Defender credential scanning. Approved backup processes are excluded via %global_allowed_backup_processes."
    tuning_guidance = "Add approved backup or credential-sync binaries to %global_allowed_backup_processes. If legitimate security tooling triggers this, add it to %global_allowed_security_tools. Narrow the network filter further by restricting to non-RFC1918 destinations if internal exfil is not a concern."

  events:
    // Event 1: A process reads a Windows Credential Manager vault file
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /(?i)\\AppData\\Local\\Microsoft\\(Vault|Credentials)\\/ 
    (
      $file.target.file.full_path = /(?i)\.vcrd$/ or
      $file.target.file.full_path = /(?i)Policy\.vpol$/
    )
    // Exclude SYSTEM-context reads (lsass, svchost doing normal DPAPI operations)
    not $file.principal.process.file.full_path = /(?i)\\Windows\\System32\\lsass\.exe$/
    not $file.principal.process.file.full_path = /(?i)\\Windows\\System32\\svchost\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $vault_reader

    // Event 2: The same process makes a network connection after reading vault files
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $vault_reader
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_security_tools

    // Chronological ordering: file read must precede network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $vault_reader over 10m

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity    = array_distinct($hostname)
    $vault_files_read  = array_distinct($file.target.file.full_path)
    $destination_ips   = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $reading_process   = array_distinct($vault_reader)
    $affected_user     = array_distinct($file.principal.user.userid)

  condition:
    $file and $net
}
