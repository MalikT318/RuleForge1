/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:35:51.595637+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_ESXi_Ingress_Tool_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of new files in ESXi scratch, tmp, or datastore paths that are commonly used by adversaries to stage ingress tool transfers. Targets the file artifact produced by wget, curl, scp, or sftp rather than the command line, providing coverage that is harder to evade than process-creation logging."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires ESXi shell/hostd file-creation telemetry forwarded to Chronicle via syslog or ESXi audit log integration. FILE_CREATION events must be normalised into UDM with target.file.full_path populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate VMware patch bundles or VIB files staged by administrators, backup agents writing to datastores, authorised configuration management tooling."
    tuning_guidance = "Add known-good administrative process names to %global_allowed_admin_tools and known-good service accounts to %global_allowed_service_accounts. Narrow the datastore path regex if specific datastore names are known to be used exclusively for authorised staging."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target writable ESXi paths used for staging: /tmp, /var/tmp, scratch
    // volumes, VMFS datastore roots, and the ESXi shell home directory.
    // Regex anchored to known ESXi filesystem layout - no Windows paths.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/scratch\/|\/vmfs\/volumes\/|\/store\/|\/bootbank\/|\/altbootbank\/|\/root\/)/ nocase

    // Restrict to file extensions or naming patterns associated with
    // transferred tools: executables, scripts, archives, and raw binaries.
    // Legitimate VMware VIBs (.vib) are excluded via the reference list below.
    $file.target.file.full_path = /\.(sh|py|pl|rb|elf|bin|tar|gz|tgz|zip|bz2|xz|so|out|run|vib|img|iso|vmdk|raw)$/ nocase

    // Exclude processes that are expected to write to these paths legitimately.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing authorised staging.
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file_path = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
