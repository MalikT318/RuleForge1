/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:19:55.930290+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_DefaultAccount_Login_Then_Config_Change_NetworkDevice {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a successful login from an external source using a well-known default account name on a network device, followed by a configuration change within the same session window. This pattern is consistent with adversaries exploiting unchanged factory credentials to gain privileged access and modify device settings."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires firewall/perimeter device syslog forwarded to Chronicle with UDM normalization. USER_LOGIN and SETTING_MODIFICATION events must be produced by the network device management plane."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized network engineers using vendor default accounts during initial device provisioning or RMA replacement. Vulnerability scanners testing default credential exposure. Automated configuration management tools using service accounts that share names with common defaults."
    tuning_guidance = "Add authorized provisioning source IPs to %global_allowed_mgmt_sources. Add approved service account identifiers to %global_allowed_service_accounts. Consider narrowing the default account name regex to match only the specific vendors deployed in the environment."

  events:
    // Event 1: Successful login to a network device management plane from an external source
    // using a username that matches common default account names across major network vendors
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = /^(admin|administrator|cisco|enable|root|guest|operator|manager|support|service|default|netscreen|superuser|ubnt|pi|vyos|cumulus|ec2-user|nfvis|apic|acsadmin|apc|setup|tech|user1|monitor)$/  nocase
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.user.userid in %global_allowed_service_accounts
    $auth.target.hostname = $device_hostname

    // Event 2: Configuration change on the same device following the login
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.hostname = $device_hostname
    not $cfg.principal.ip in %global_allowed_mgmt_sources
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    // Enforce chronological ordering: login must precede config change
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $device_hostname over 1h

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($auth.target.hostname)
    $default_accounts_observed = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $config_change_count = count($cfg.metadata.id)
    $modified_settings = array_distinct($cfg.target.resource.name)

  condition:
    $auth and $cfg
}
