/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:36:56.211480+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_Container_Security_Tool_Tampering_Cloud_Audit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage container security tool tampering sequence via cloud audit logs: first, a privileged or security-relevant container workload configuration is modified (e.g., DaemonSet, SecurityContext, admission webhook), followed by a deletion or disabling of a monitoring/logging resource within the same namespace and time window. This pattern indicates an adversary attempting to blind defensive tooling deployed as container workloads before or after gaining access."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "Requires cloud control plane audit logs (Kubernetes API server audit logs normalised to Chronicle UDM). Events must include resource kind, namespace, principal user, and verb fields. Ensure audit policy captures PATCH/UPDATE on DaemonSets and DELETE on ConfigMaps, Services, and related resources."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate security tool upgrades rolling out new DaemonSet versions; GitOps pipelines applying configuration changes; authorised cluster administrators performing maintenance; Helm chart upgrades that delete and recreate monitoring resources."
    tuning_guidance = "Add CI/CD service accounts and GitOps automation identities to %global_allowed_service_accounts. Add approved cluster admin users to %global_allowed_admin_users. Narrow the resource_type regex if only specific security tools (e.g., Falco, Datadog, Sysdig) are deployed in your environment."

  events:
    // Event 1: Modification of a security-relevant container workload resource
    // Targets PATCH/UPDATE of DaemonSets, admission webhooks, or security policy objects
    // which are the typical deployment mechanism for in-cluster security agents
    $mod.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $mod.target.resource.resource_type = /(?i)(daemonset|mutatingwebhookconfiguration|validatingwebhookconfiguration|podsecuritypolicy|clusterrolebinding|clusterrole)/
    not $mod.principal.user.userid in %global_allowed_service_accounts
    not $mod.principal.user.userid in %global_allowed_admin_users
    not $mod.principal.ip in %global_allowed_mgmt_sources
    $mod.principal.user.userid = $actor

    // Event 2: Deletion or disabling of a monitoring/logging resource in the same cluster context
    // Targets deletion of ConfigMaps (agent config), Services (scrape endpoints),
    // or entire namespaced resources associated with observability stacks
    $del.metadata.event_type = "RESOURCE_DELETION"
    $del.target.resource.resource_type = /(?i)(configmap|service|deployment|daemonset|namespace|secret)/
    $del.target.resource.name = /(?i)(monitor|logging|log|audit|falco|sysdig|datadog|agent|sensor|collector|fluentd|fluent|promtail|filebeat|metricbeat|telegraf|otel|opentelemetry)/
    not $del.principal.user.userid in %global_allowed_service_accounts
    not $del.principal.user.userid in %global_allowed_admin_users
    $del.principal.user.userid = $actor

    // Chronological ordering: modification precedes deletion
    $mod.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($mod.principal.user.userid)
    $modified_resource_types = array_distinct($mod.target.resource.resource_type)
    $deleted_resource_names = array_distinct($del.target.resource.name)
    $deleted_resource_types = array_distinct($del.target.resource.resource_type)
    $source_ips = array_distinct($mod.principal.ip)
    $deletion_count = count($del.target.resource.name)

  condition:
    $mod and $del
}
