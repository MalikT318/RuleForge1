/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:18:18.366605+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_API_Exec_Audit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects container exec/attach API calls recorded in cloud audit logs that indicate an adversary is executing commands inside a running container via the container runtime API or Kubernetes exec endpoint. This is a control-plane signal distinct from process-launch telemetry and catches API-level abuse even when command-line logging is suppressed or unavailable."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Requires cloud provider audit logs (e.g., Kubernetes API server audit, GKE/EKS/AKS control-plane audit) normalised into Chronicle UDM. The exec and attach sub-resource calls must be captured at the API server level."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Authorised SRE/DevOps engineers performing live debugging, CI/CD pipeline health checks that exec into containers, monitoring agents that attach to containers for metric collection."
    tuning_guidance = "Add known automation service accounts to %global_allowed_service_accounts. Add approved administrative users to %global_allowed_admin_users. Consider narrowing to non-production namespaces or adding a threshold wrapper if exec activity is high-volume in your environment."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match Kubernetes exec or attach sub-resource API calls, or equivalent
    // container runtime API paths. The pattern covers:
    //   /api/v1/namespaces/<ns>/pods/<pod>/exec
    //   /api/v1/namespaces/<ns>/pods/<pod>/attach
    //   /apis/.../pods/<pod>/exec  (aggregated API groups)
    // Chronicle normalises the request URI into target.resource.name.
    $cloud.target.resource.name = /\/pods\/[^\/]+\/(exec|attach)/ nocase

    // Exclude known-good service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Exclude internal scanner/security tooling sources
    not $cloud.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
