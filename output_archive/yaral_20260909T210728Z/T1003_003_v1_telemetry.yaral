/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:24:01.907178+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_File_Access_Outside_System_Directory {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects creation or modification of NTDS.dit file outside the protected system directory, indicating extraction of the Active Directory database for credential theft."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires EDR file telemetry or Windows file auditing."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorized domain controller backup operations, disaster recovery procedures, authorized AD migration tooling."
    tuning_guidance = "Add approved backup process paths to %global_allowed_backup_processes. Exclude authorized backup destinations if necessary."

  events:
    ($file.metadata.event_type = "FILE_CREATION" or $file.metadata.event_type = "FILE_MODIFICATION")
    $file.target.file.full_path = /(?i)ntds\.dit$/
    not $file.target.file.full_path = /(?i)^[a-z]:\\windows\\ntds\\ntds\.dit$/
    not $file.target.file.full_path = /(?i)^[a-z]:\\windows\\system32\\ntds\.dit$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
