/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:36:10.542774+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_002_Firewall_ExternalDownload_ThenLargeTransfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with ingress tool transfer observed at the network perimeter: an outbound HTTP/HTTPS connection to an external host followed within 5 minutes by a large inbound data transfer from the same external IP. This network-observable sequence is characteristic of a tool or payload being pulled from an adversary-controlled server, without relying on endpoint process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP and NETWORK_FLOW events, including bytes_in/bytes_out fields (network.sent_bytes / network.received_bytes) and source/destination IP."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software update services, CDN-hosted installers, large file downloads from SaaS platforms, backup agents pulling data from cloud storage, vulnerability scanners."
    tuning_guidance = "Add known-good external domains and CDN addresses to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Raise the bytes threshold if legitimate large downloads are common in the environment. Add approved remote management sources to %global_allowed_remote_mgmt."

  events:
    // First event: outbound HTTP/HTTPS request to an external host
    $http.metadata.event_type = "NETWORK_HTTP"
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    // Restrict to common tool-transfer ports (80, 443, 8080, 8443)
    $http.target.port >= 80
    $http.target.port <= 8443
    $http.target.ip = $external_ip
    $http.principal.ip = $internal_host

    // Second event: large inbound flow from the same external IP shortly after
    $flow.metadata.event_type = "NETWORK_FLOW"
    not $flow.principal.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    not $flow.principal.hostname in %global_allowed_domains
    // Inbound transfer exceeds 500 KB - indicative of a binary or archive payload
    $flow.network.received_bytes >= 512000
    $flow.principal.ip = $external_ip
    $flow.target.ip = $internal_host

    // Chronological ordering: HTTP request precedes the large flow completion
    $http.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $external_ip, $internal_host over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($flow.target.ip)
    $external_destination = array_distinct($flow.principal.ip)
    $external_hostname = array_distinct($flow.principal.hostname)
    $max_bytes_received = max($flow.network.received_bytes)
    $http_target_ports = array_distinct($http.target.port)

  condition:
    $http and $flow
}
