/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:36:32.205793+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_IaaS_Security_Monitoring_Config_Tampered {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification or deletion of cloud security monitoring configurations via IaaS control-plane audit logs. Covers disabling CloudTrail trails, Azure Monitor diagnostic settings, GCP log sinks, GuardDuty detectors, Security Hub, Defender for Cloud, and similar guardrail resources. Attackers tamper with these to reduce visibility before or during an intrusion."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "Requires cloud provider control-plane audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, GCP Cloud Audit Logs). Events must populate metadata.event_type, principal.user.userid, target.resource.name, and metadata.product_event_type."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorised infrastructure-as-code pipelines rotating or replacing monitoring configurations; security team maintenance windows; legitimate log sink migrations."
    tuning_guidance = "Add automation service principals and break-glass admin accounts to %global_allowed_cloud_principals. Add approved CI/CD source IPs to %global_allowed_mgmt_sources. Reduce severity for accounts in %global_allowed_service_accounts."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Match API operations that disable, delete, or modify security monitoring resources.
    // Pattern covers multi-cloud normalised product_event_type values:
    //   AWS:   StopLogging, DeleteTrail, UpdateTrail, DisableImportFindings,
    //          DeleteDetector, DisableSecurityHub, DeleteFlowLogs, PutEventSelectors (exclusion)
    //   Azure: microsoft.insights/diagnosticsettings/delete,
    //          microsoft.security/pricings/write (downgrade),
    //          microsoft.operationalinsights/workspaces/delete
    //   GCP:   logging.sinks.delete, logging.sinks.update,
    //          securitycenter.notificationConfigs.delete
    $cloud.metadata.product_event_type = /(?i)(stop.?logging|delete.?trail|update.?trail|delete.?detector|disable.?security|delete.?flow.?log|put.?event.?selector|diagnosticsettings.?delete|pricings.?write|workspaces.?delete|sinks.?delete|sinks.?update|notificationconfigs.?delete|delete.?insight|disable.?finding|delete.?subscription.?filter|delete.?metric.?filter|delete.?alert.?policy|delete.?notification.?channel)/

    // Scope to resources that are clearly security or monitoring infrastructure.
    // Covers trail, detector, sink, workspace, diagnostic, hub, flow-log, alert, sensor.
    $cloud.target.resource.name = /(?i)(trail|detector|guardduty|securityhub|security.?center|log.?sink|log.?workspace|diagnostic.?setting|flow.?log|alert.?rule|notification.?channel|metric.?filter|subscription.?filter|siem|sentinel|defender|monitor|audit.?log|cloudwatch|stackdriver)/

    // Exclude approved automation principals and service accounts.
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known authorised management source addresses.
    not $cloud.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
