/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:41:01.212539+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_006_Log_Truncation_Then_Deletion_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage log destruction pattern on Linux: a process truncates or zeroes a file under /var/log/ (FILE_MODIFICATION with zero or near-zero size) followed by deletion of a file in the same log directory within 10 minutes. This correlation catches adversaries who first empty log files to destroy evidence and then remove them, providing additive coverage beyond command-line process-launch detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. FILE_MODIFICATION events must include target.file.full_path and principal.process.file.full_path. FILE_DELETION events must include target.file.full_path and principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Log rotation daemons (logrotate, newsyslog) that truncate and remove old logs; rsyslog or syslog-ng housekeeping; backup agents archiving and pruning logs; monitoring agents compressing log files."
    tuning_guidance = "Add logrotate, rsyslog, syslog-ng, and backup agent binary paths to %global_allowed_backup_processes. Add authorised log-management service accounts to %global_allowed_service_accounts. Narrow the /var/log/ regex if only specific sub-paths are relevant."

  events:
    // Event 1: A process modifies (truncates/overwrites) a file under /var/log/
    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.target.file.full_path = /^\/var\/log\// nocase
    // Exclude known-good log management binaries
    not $mod.principal.process.file.full_path in %global_allowed_backup_processes
    not $mod.principal.user.userid in %global_allowed_service_accounts
    $mod.principal.hostname = $hostname

    // Event 2: A file under /var/log/ is deleted on the same host
    $del.metadata.event_type = "FILE_DELETION"
    $del.target.file.full_path = /^\/var\/log\// nocase
    not $del.principal.process.file.full_path in %global_allowed_backup_processes
    not $del.principal.user.userid in %global_allowed_service_accounts
    $del.principal.hostname = $hostname

    // Enforce chronological ordering: truncation precedes deletion
    $mod.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.006")
    $primary_entity = array_distinct($mod.principal.hostname)
    $modified_log_paths = array_distinct($mod.target.file.full_path)
    $deleted_log_paths = array_distinct($del.target.file.full_path)
    $actor_processes = array_distinct($mod.principal.process.file.full_path)
    $actor_users = array_distinct($mod.principal.user.userid)
    $deletion_count = count($del.target.file.full_path)

  condition:
    $mod and $del
}
