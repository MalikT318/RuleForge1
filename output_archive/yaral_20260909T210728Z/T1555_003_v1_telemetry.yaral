/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:29:36.141576+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Browser_Credential_DB_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read or open access to browser credential store files on Linux (e.g., Chrome/Chromium Login Data SQLite DB, Firefox key4.db, logins.json). Accessing these files from outside the browser process itself is a strong indicator of credential harvesting. This rule targets the file artifact layer rather than process command-line arguments, providing additive coverage over process-creation detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Web Browsers"
    log_prerequisites = "Requires Linux EDR or auditd with file open/read syscall auditing (auditd rules on -a always,exit -F arch=b64 -S open,openat -F exit=-EACCES or equivalent, or EDR file telemetry). FILE_READ or FILE_OPEN events must be normalised into UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Browser sync daemons, backup agents reading profile directories, security scanners, password managers with legitimate browser integration, automated testing frameworks."
    tuning_guidance = "Add legitimate backup or sync process paths to %global_allowed_backup_processes. Add approved security tooling to %global_allowed_security_tools. Scope further by requiring the accessing process to differ from known browser binaries (chrome, chromium, firefox, firefox-esr)."

  events:
    $open.metadata.event_type = "FILE_READ"

    // Match browser credential store files across common Linux profile paths
    // Chrome/Chromium: Login Data, Cookies, Web Data
    // Firefox: key4.db, logins.json, cert9.db
    // Brave, Edge (Linux), Opera share similar structures
    $open.target.file.full_path = /\/\.config\/(google-chrome|chromium|BraveSoftware|microsoft-edge|opera)\/[^\/]+\/(Default|Profile [0-9]+)\/(Login Data|Cookies|Web Data|Login Data-journal)$/ nocase

    // Firefox and derivatives
    $open.target.file.full_path = /\/\.mozilla\/firefox\/[^\/]+\/(key4\.db|logins\.json|cert9\.db|cookies\.sqlite|signons\.sqlite)$/ nocase

    // Exclude the browser processes themselves accessing their own credential stores
    not $open.principal.process.file.full_path = /\/(chrome|chromium|brave|msedge|opera|firefox|firefox-esr|geckodriver)$/ nocase

    // Exclude approved backup and security tooling
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($open.principal.hostname)
    $accessing_process = array_distinct($open.principal.process.file.full_path)
    $credential_file_accessed = array_distinct($open.target.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
