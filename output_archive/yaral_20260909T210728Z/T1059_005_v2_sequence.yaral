/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:13:25.996888+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_VB_Script_Drop_Then_Execute_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a VBScript or VBA-related file written to a suspicious Linux path (tmp, dev/shm, var) followed by a script interpreter or macro-capable process launching from the same host within 5 minutes. On Linux, VB execution typically occurs via Mono, LibreOffice macro runners, or cross-platform .NET Core hosting vbrun-equivalent tooling. This sequence of file drop then execution is a strong indicator of malicious VB payload staging."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM FILE_CREATION and PROCESS_LAUNCH events. Auditd rules must capture open/write syscalls and execve."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "LibreOffice macro testing by developers, Mono-based application deployment pipelines, automated test frameworks running VB.NET unit tests, legitimate .NET Core cross-platform applications."
    tuning_guidance = "Add known-good parent processes to %global_allowed_script_hosts. Add approved staging directories or CI/CD runner hostnames if false positives arise from build pipelines. Narrow the file extension regex if .vb matches non-malicious source files in dev environments."

  events:
    // Event 1: A VBScript or VB-related file is written to a suspicious staging path
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(?:tmp|var\/tmp|dev\/shm|run\/shm|var\/run)\/.+\.(?:vbs|vbe|vb|bas|cls|frm|mac)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Event 2: A macro-capable or VB-runtime process launches on the same host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(?:mono|mono-sgen|dotnet|soffice|soffice\.bin|python[23]?|perl|ruby|bash|sh|dash|zsh)$/
    $proc.target.process.command_line = /(?:\.vbs|\.vbe|\.vb|\.bas|macro|vbrun|vbscript|LibreOffice|--headless|--norestore|--invisible)/
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Chronological ordering: file must be created before execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($hostname)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $executing_process = array_distinct($proc.target.process.file.full_path)
    $executing_cmdline = array_distinct($proc.target.process.command_line)
    $file_writer_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $proc
}
