/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:25:42.853310+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_CachedCreds_RegRead_Then_FileWrite {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage cached domain credential harvesting pattern on Windows: first, a non-standard process opens or modifies the LSA Secrets / NL$KM registry key where DCC2 hashes are stored, followed within 10 minutes by that same host writing a file to a staging or temp location. This sequence is consistent with tools that dump the HKLM\\SECURITY hive and then write the extracted hashes to disk for offline cracking. Variant 2 of 2 for T1003.005 - additive coverage over process command-line rules."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 12/13) and file-creation telemetry (Event ID 11) normalised to UDM REGISTRY_MODIFICATION and FILE_CREATION. Both event types must be present for the join to fire."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Backup agents that snapshot the registry hive; some AV/EDR products that read LSA keys during health checks; authorised red-team exercises."
    tuning_guidance = "Add backup and security agent process paths to %global_allowed_backup_processes and %global_allowed_security_tools. If specific admin accounts routinely touch these keys, add them to %global_allowed_admin_users."

  events:
    // --- Event 1: registry access to the SECURITY hive key that stores DCC2 hashes ---
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SECURITY\\(Cache|Policy\\Secrets|NL\$KM)/
    // Exclude well-known system processes that legitimately own these keys
    not $reg.principal.process.file.full_path = /\\(lsass|svchost|services|winlogon|wininit)\.exe$/
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    // --- Event 2: file written to a staging/temp path on the same host ---
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\\temp\\|\\tmp\\|\\appdata\\local\\temp\\|\\windows\\temp\\|\\programdata\\)/
    // Narrow to file extensions commonly used to stage dumped credential data
    $file.target.file.full_path = /(?i)\.(txt|log|csv|dmp|out|bin|dat|ldb|vdb)$/
    not $file.principal.process.file.full_path = /\\(svchost|msiexec|tiworker|trustedinstaller)\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    // --- Chronological ordering: registry access must precede the file write ---
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1003.005")
    $primary_entity      = array_distinct($hostname)
    $reg_keys_accessed   = array_distinct($reg.target.registry.registry_key)
    $files_written       = array_distinct($file.target.file.full_path)
    $dumping_processes   = array_distinct($reg.principal.process.file.full_path)
    $writing_processes   = array_distinct($file.principal.process.file.full_path)
    $event_count         = count($file.metadata.event_timestamp.seconds)

  condition:
    $reg and $file
}
