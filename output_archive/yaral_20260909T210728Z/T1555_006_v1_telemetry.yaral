/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:31:31.684191+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_Cloud_Secret_BulkAccess_AuditLog {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects bulk or anomalous read access to cloud secrets management stores (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault) via cloud audit logs. Focuses on the API-level resource access event rather than command-line invocation, providing coverage that is harder to evade. Fires when a principal accesses a secret value resource — the state-change artifact produced by credential harvesting — rather than on the tool used to harvest it."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM: AWS CloudTrail (GetSecretValue, BatchGetSecretValue), GCP Audit Logs (accessSecretVersion), Azure Activity Logs (SecretGet / getSecret). Events must be ingested and normalised to USER_RESOURCE_ACCESS with target.resource.type and metadata.product_event_type populated."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Legitimate application deployments that retrieve secrets at startup, CI/CD pipelines, secrets rotation automation, authorised cloud-native services (Lambda, Cloud Functions, App Service) fetching credentials at runtime."
    tuning_guidance = "Add known automation and service principals to %global_allowed_cloud_principals. Add known CI/CD source addresses to %global_allowed_scanners. Narrow the resource_type regex if your environment uses a consistent naming convention for secrets resources."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match the normalised API operation names across AWS, GCP, and Azure.
    // AWS: GetSecretValue, BatchGetSecretValue
    // GCP: accessSecretVersion
    // Azure: SecretGet, getSecret, VaultGet (key vault secret read)
    // Chronicle normalises these into metadata.product_event_type.
    $cloud.metadata.product_event_type = /(?i)(GetSecretValue|BatchGetSecretValue|accessSecretVersion|SecretGet|getSecret|VaultGet)/

    // Confirm the target resource is a secrets-management resource type.
    // Chronicle normalises the resource type from the provider-specific ARN/path.
    $cloud.target.resource.resource_type = /(?i)(secret|vault|key.?vault|secretversion)/

    // Exclude known-good automation and service principals.
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known-good source addresses (e.g., internal scanners, approved mgmt hosts).
    not $cloud.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $accessed_secret   = array_distinct($cloud.target.resource.name)
    $source_ip         = array_distinct($cloud.principal.ip)
    $api_operation     = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
