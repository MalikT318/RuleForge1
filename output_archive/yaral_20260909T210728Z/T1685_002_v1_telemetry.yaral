/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:37:53.958341+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_M365_Mailbox_Audit_Bypass_Or_Audit_Disable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects configuration changes in Microsoft 365 that disable or bypass mailbox auditing, downgrade audit licensing, or suppress audit log collection for specific users. Adversaries with sufficient permissions may use these mechanisms to suppress audit telemetry before or during malicious activity, covering actions such as mail collection, exfiltration, or privilege abuse."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Logs"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log ingested into Chronicle. Relevant operations include Set-MailboxAuditBypassAssociation, Set-AdminAuditLogConfig, Set-OrganizationConfig, and license assignment changes. Ensure tenant-level audit logging is enabled and forwarded."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Authorized IT administrators performing bulk license reassignment during cost optimisation projects; automated provisioning pipelines that legitimately adjust audit settings; break-glass account operations performed by documented change management."
    tuning_guidance = "Add known administrative service principals and automation accounts to %global_allowed_service_accounts. Add approved admin user identities to %global_allowed_admin_users. Scope exclusions narrowly to avoid suppressing genuine attacker activity."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Match audit-suppression operations by targeting the operation name or
    // resource path. M365 UAL normalises the operation name into the target
    // resource or the command field. We match broadly on patterns that indicate
    // audit bypass, audit config changes, or audit-relevant license downgrades.
    (
      $cloud.target.resource.name = /(?i)mailboxauditbypass/ or
      $cloud.target.resource.name = /(?i)adminauditlog/ or
      $cloud.target.resource.name = /(?i)auditlog/ or
      $cloud.target.resource.name = /(?i)unifiedauditlog/ or
      $cloud.target.resource.name = /(?i)organizationconfig/
    )

    // Require an acting principal so we can attribute the change
    $cloud.principal.user.userid != ""

    // Exclude known-good automation and service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $modified_resource = array_distinct($cloud.target.resource.name)
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
