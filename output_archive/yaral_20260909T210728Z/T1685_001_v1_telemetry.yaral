/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:37:13.867783+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Service_Registry_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications that disable or reconfigure the Windows EventLog service start type, indicating an adversary attempting to suppress event logging at the OS level. Targets the resulting registry state change rather than the command line used to produce it, providing coverage against process-creation log evasion."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (e.g., Sysmon Event ID 13) normalised to UDM REGISTRY_MODIFICATION. The registry key HKLM\\SYSTEM\\CurrentControlSet\\Services\\EventLog must be monitored."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Highly unlikely in production; forensic imaging tools or OS repair utilities may touch service keys. Authorised hardening scripts run by approved service accounts are the most plausible benign source."
    tuning_guidance = "Add approved automation or hardening service accounts to %global_allowed_service_accounts. If a specific RMM or deployment tool legitimately modifies this key, add its process path to %global_allowed_admin_tools."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the EventLog service control key - covers both ControlSet001 and CurrentControlSet
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Services\\EventLog$/

    // The Start value controls service startup: 4 = Disabled, 3 = Manual (abnormal for EventLog)
    $reg.target.registry.registry_value_name = "Start" nocase

    // Value data of 4 (disabled) or 3 (manual) is anomalous for the EventLog service
    $reg.target.registry.registry_value_data = /(?i)^[34]$/

    // Exclude approved service accounts performing authorised operations
    not $reg.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $new_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
