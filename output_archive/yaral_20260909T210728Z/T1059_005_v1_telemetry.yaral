/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:12:57.108784+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_VBScript_Artifact_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation of VBScript or VBA-related artifacts in suspicious locations such as user temp directories, AppData, ProgramData, or the root of the system drive. Adversaries frequently drop .vbs, .vbe, .wsf, or .hta files as staging payloads before or after execution. This rule pivots on the file artifact rather than the command line to catch evasion via renamed interpreters or indirect execution chains."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION telemetry normalised into UDM. Sysmon Event ID 11 or equivalent EDR file-write events must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers dropping .vbs helper scripts, Group Policy logon scripts written to SYSVOL or local policy paths, some RMM agents that stage VBScript-based inventory collectors."
    tuning_guidance = "Add known-good parent processes (e.g., installer engines, RMM agents) to %global_allowed_admin_tools. Add known-good script host processes to %global_allowed_script_hosts. Consider scoping to specific high-risk directories if volume is high."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match VBScript, encoded VBScript, Windows Script File, or HTA extensions
    $file.target.file.full_path = /(?i)\.(vbs|vbe|wsf|hta)$/

    // Restrict to high-risk write locations: user temp, AppData, ProgramData, system drive root, Downloads, Public
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\AppData\\|\\Users\\[^\\]+\\Downloads\\|\\Users\\[^\\]+\\Desktop\\|\\Temp\\|\\TMP\\|\\ProgramData\\|^[A-Za-z]:\\[^\\]+\.(vbs|vbe|wsf|hta)$|\\Windows\\Temp\\|\\Public\\)/

    // Exclude known-good script host parents and admin tooling
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
