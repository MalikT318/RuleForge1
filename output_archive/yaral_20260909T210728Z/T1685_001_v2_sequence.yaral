/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:37:34.763927+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Service_Disabled_Then_Audit_Policy_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects Windows EventLog service being stopped or disabled followed by audit policy modification, indicating defense evasion."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Impair Defenses: Disable or Modify Windows Event Log"
    log_prerequisites = "Requires Windows EDR process telemetry and registry monitoring."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "System maintenance scripts, GPO deployment, authorized security configuration changes, imaging/deployment processes."
    tuning_guidance = "Add approved maintenance accounts to %global_allowed_service_accounts and approved parent processes to %global_allowed_admin_tools."

  events:
    $svc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $svc.target.process.file.full_path = /\\(sc|net)\.exe$/ nocase and
        $svc.target.process.command_line = /eventlog/ nocase and
        (
          $svc.target.process.command_line = /stop/ nocase or
          $svc.target.process.command_line = /config.*start\s*=\s*disabled/ nocase
        )
      ) or
      (
        $svc.target.process.file.full_path = /\\powershell\.exe$/ nocase and
        $svc.target.process.command_line = /(?i)set-service/ and
        $svc.target.process.command_line = /(?i)eventlog/ and
        (
          $svc.target.process.command_line = /(?i)status.*stopped/ or
          $svc.target.process.command_line = /(?i)startuptype.*disabled/
        )
      )
    )
    not $svc.principal.user.userid in %global_allowed_service_accounts
    not $svc.principal.process.file.full_path in %global_allowed_admin_tools
    $svc.principal.hostname = $hostname

    $audit.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $audit.target.process.file.full_path = /\\auditpol\.exe$/ nocase and
        (
          $audit.target.process.command_line = /\/set/ nocase or
          $audit.target.process.command_line = /\/clear/ nocase or
          $audit.target.process.command_line = /\/remove/ nocase
        )
      ) or
      (
        $audit.target.process.file.full_path = /\\wevtutil\.exe$/ nocase and
        (
          $audit.target.process.command_line = /(?i)clear-log/ or
          $audit.target.process.command_line = /(?i)set-log.*enabled.*false/
        )
      ) or
      (
        $audit.target.process.file.full_path = /\\reg\.exe$/ nocase and
        $audit.target.process.command_line = /(?i)hklm\\system\\currentcontrolset\\services\\eventlog/
      )
    )
    $audit.principal.hostname = $hostname

    $svc.metadata.event_timestamp.seconds <= $audit.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($svc.principal.hostname)
    $service_modifier_user = array_distinct($svc.principal.user.userid)
    $audit_modifier_user = array_distinct($audit.principal.user.userid)
    $service_command = array_distinct($svc.target.process.command_line)
    $audit_command = array_distinct($audit.target.process.command_line)

  condition:
    $svc and $audit
}
