/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:14:47.688653+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_JS_Runtime_Drops_File_To_Writable_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a JavaScript runtime process (node, deno, bun) that launches and is shortly followed by file creation in a world-writable or staging directory on the same host. This two-event sequence indicates a JS payload that downloads or writes a secondary artifact, a common post-exploitation pattern distinct from simple command-line execution."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM PROCESS_LAUNCH and FILE_CREATION events with principal.hostname, principal.process.file.full_path, and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CI/CD pipelines running npm build steps that emit artifacts to /tmp; legitimate Node.js application servers writing to /var/tmp; developer workstations running local JS tooling."
    tuning_guidance = "Add known CI/CD runner hostnames or service account usernames to %global_allowed_service_accounts. Add approved parent process paths to %global_allowed_script_hosts to suppress build-system noise."

  events:
    // Event 1: JavaScript runtime launches
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(node|nodejs|deno|bun)$/
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Event 2: File created in a world-writable or staging path shortly after
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/var\/run\/shm\/)/
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    $file.principal.hostname = $hostname

    // Chronological ordering: runtime must start before file is written
    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $js_runtime_path = array_distinct($proc.target.process.file.full_path)
    $js_runtime_cmdline = array_distinct($proc.target.process.command_line)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $initiating_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
