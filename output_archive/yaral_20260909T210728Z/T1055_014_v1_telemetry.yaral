/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:08:47.238068+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_VDSO_Hijack_Shared_Object_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation or modification of shared object (.so) files in world-writable or temporary memory-backed locations (e.g. /dev/shm, /tmp, /run/shm, /var/tmp, /proc/<pid>/mem). VDSO hijacking requires staging a malicious shared library that is subsequently mapped into a target process via redirected GOT/PLT entries. Legitimate software rarely drops .so files into these paths at runtime; detection at the file-artifact layer is significantly harder to evade than command-line logging."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events. Auditd rules should include -a always,exit -F arch=b64 -S openat,open,creat -F dir=/dev/shm -k vdso_stage and equivalent rules for /tmp, /var/tmp, /run/shm."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "JVM / JIT compilers writing temporary native libraries to /tmp; container runtimes extracting bundled .so files on first run; legitimate IPC libraries using /dev/shm; build systems running make install into staging directories."
    tuning_guidance = "Add known-good parent processes (e.g. java, gradle, docker) to %global_allowed_admin_tools. Scope the rule to interactive user sessions by filtering on principal.user.userid not matching service accounts in %global_allowed_service_accounts. Consider narrowing to /dev/shm and /proc paths only for highest-fidelity alerting."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: a shared object file written into a volatile, world-writable,
    // or memory-backed path. These locations have no legitimate reason to
    // receive .so files outside of exploitation or staging activity.
    $file.target.file.full_path = /(?i)(\/dev\/shm\/|\/run\/shm\/|\/tmp\/|\/var\/tmp\/|\/proc\/[0-9]+\/)(.*\.so(\.[0-9]+)*)$/

    // Exclude known-good administrative and build tooling that legitimately
    // extracts native libraries at runtime.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service/automation accounts that may perform legitimate
    // library staging (e.g. container orchestration agents).
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude backup agents that may stage files in temp paths.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity    = array_distinct($file.principal.hostname)
    $staged_so_path    = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
