/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:30:55.297301+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Password_Manager_Database_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects unauthorized file access to password manager database files on Linux systems, indicating potential credential harvesting."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires Linux EDR or auditd file access telemetry."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup software, security scanning tools, legitimate password manager sync processes, system administrators performing forensic analysis."
    tuning_guidance = "Add approved backup processes to %global_allowed_backup_processes and security tools to %global_allowed_security_tools."

  events:
    ($file.metadata.event_type = "FILE_READ" or
     $file.metadata.event_type = "FILE_CREATION" or
     $file.metadata.event_type = "FILE_MODIFICATION")
    
    (re.regex($file.target.file.full_path, /(?i)\.kdbx$/) or
     re.regex($file.target.file.full_path, /(?i)\.kdb$/) or
     re.regex($file.target.file.full_path, /(?i)\/\.password-store\//) or
     re.regex($file.target.file.full_path, /(?i)\/\.gnupg\//) or
     re.regex($file.target.file.full_path, /(?i)\/\.local\/share\/keyrings\//) or
     re.regex($file.target.file.full_path, /(?i)\/\.mozilla\/firefox\/.*\.default.*\/logins\.json/) or
     re.regex($file.target.file.full_path, /(?i)\/\.config\/google-chrome\/.*\/login\s+data/) or
     re.regex($file.target.file.full_path, /(?i)\/\.config\/chromium\/.*\/login\s+data/) or
     re.regex($file.target.file.full_path, /(?i)\/\.lastpass\//) or
     re.regex($file.target.file.full_path, /(?i)\/\.1password\//) or
     re.regex($file.target.file.full_path, /(?i)\/\.bitwarden\//) or
     re.regex($file.target.file.full_path, /(?i)\/\.enpass\//) or
     re.regex($file.target.file.full_path, /(?i)\/snap\/.*\/\.local\/share\/keyrings\//))
    
    not re.regex($file.principal.process.file.full_path, /(?i)\/(keepassxc|keepass2|pass|gpg|gnome-keyring-daemon|chrome|chromium|firefox|lastpass|1password|bitwarden|enpass)$/)
    
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
