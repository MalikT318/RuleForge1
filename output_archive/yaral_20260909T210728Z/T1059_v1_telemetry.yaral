/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Office Suite
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:10:08.852408+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_Office_Suite_Script_Execution_Via_Macro_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of macro or script execution settings in Office Suite environments (Microsoft 365 / Google Workspace). Adversaries enabling macros, disabling protected view, or enabling script execution at the tenant or user level create a configuration state change that precedes or enables T1059 abuse via embedded scripts. This rule targets the SETTING_MODIFICATION artifact rather than process-level command execution, providing coverage orthogonal to process-launch rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log or Google Workspace Admin/Drive audit events normalised to Chronicle UDM. Relevant operations include macro policy changes, Apps Script enablement, and protected-view policy modifications."
    platform = "Office Suite"
    log_source = "vmware_esxi"
    false_positives = "Legitimate IT administrators enabling macros for approved business applications, automated deployment pipelines configuring tenant policies, change-management windows for Office add-in rollouts."
    tuning_guidance = "Add known administrator accounts that routinely manage macro/script policies to %global_allowed_admin_users. Add service principals used by deployment automation to %global_allowed_service_accounts. Reduce false positives further by correlating with change-management ticket windows if available."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"

    // Target settings related to macro, script, or interpreter enablement
    // Covers M365 macro policy, protected view, Apps Script, and similar controls
    (
      $setting.target.resource.name = /(?i)(macro|vba|script|appsscript|apps.script|protected.view|trust.center|automation|powerapps|flow|connector|add.?in|plugin|extension.?policy|execution.?policy|allow.?script|enable.?script|run.?script)/ nocase
      or
      $setting.security_result.description = /(?i)(macro|vba|script|appsscript|apps.script|protected.view|trust.center|automation|powerapps|flow|connector|add.?in|plugin|extension.?policy|execution.?policy|allow.?script|enable.?script|run.?script)/ nocase
    )

    // Exclude known-good admin and service accounts performing routine policy management
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $modified_setting = array_distinct($setting.target.resource.name)
    $actor_user = array_distinct($setting.principal.user.userid)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
