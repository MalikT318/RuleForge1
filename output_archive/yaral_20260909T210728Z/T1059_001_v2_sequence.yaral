/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:11:05.562364+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_ScriptBlock_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a PowerShell process writing a script file to disk followed by an outbound network connection from the same host within 5 minutes. This two-stage pattern is characteristic of PowerShell-based download-and-execute tradecraft where a script is staged to disk before initiating C2 or tool-retrieval activity. Complements existing command-line detection rules by focusing on the file-creation-to-network sequence rather than command-line flags alone."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Event ID 11) and network-connection telemetry (Event ID 3 or equivalent EDR network events). Both must be normalised to UDM FILE_CREATION and NETWORK_CONNECTION respectively."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate PowerShell scripts that write configuration or log files and then contact update or telemetry endpoints. Software deployment tools (SCCM, Ansible, Chocolatey) running under PowerShell. Security tooling that stages scripts during remediation."
    tuning_guidance = "Add approved administrative hosts to %global_allowed_admin_tools. Add known-good external destinations to %global_allowed_domains. Narrow the file extension regex if ps1 matches are too broad in your environment. Consider raising severity to Critical if the destination IP is non-RFC1918 and the writing process is not in %global_allowed_script_hosts."

  events:
    // Event 1: PowerShell writes a script or encoded payload to disk
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $file.target.file.full_path = /\.(ps1|psm1|psd1|bat|vbs|js|hta|tmp)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    $file.principal.hostname = $hostname

    // Event 2: A PowerShell process (or child) makes an outbound non-internal connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 0
    $net.principal.hostname = $hostname

    // Chronological ordering: file written before network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $written_files = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $ps_process_path = array_distinct($net.principal.process.file.full_path)

  condition:
    $file and $net
}
