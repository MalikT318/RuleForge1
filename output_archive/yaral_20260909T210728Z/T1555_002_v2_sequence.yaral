/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:29:16.414172+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Securityd_Memory_ProcMem_Then_FileWrite {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage credential harvesting pattern on Linux: a process reads /proc/<pid>/mem or /proc/<pid>/maps of a security daemon (e.g. gnome-keyring-daemon, dbus-daemon, or pam-related processes) followed by a file write to a world-writable or temporary location within the same time window. This pattern is consistent with T1555.002 where an adversary with root access reads a security daemon's memory to extract cached credentials and then stages the output."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with file-open/read events normalised to FILE_READ and file-creation events normalised to FILE_CREATION. Auditd rules must include -a always,exit -F arch=b64 -S open,openat,read -F dir=/proc and -a always,exit -F arch=b64 -S openat,creat -F dir=/tmp."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debugging tools (gdb, strace, valgrind) run by authorised developers against security daemons; security scanners; EDR agents performing memory inspection; crash dump collectors."
    tuning_guidance = "Add authorised debugging and security tooling parent process paths to %global_allowed_security_tools. Add authorised service account names to %global_allowed_service_accounts. Narrow the proc_mem read filter to specific daemon PIDs if your EDR enriches /proc path targets with process names."

  events:
    // Stage 1: A process reads /proc/<pid>/mem or /proc/<pid>/maps of a
    // security-relevant daemon. This is the memory-scraping step.
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|smaps|pagemap|environ)$/
    // The reading process must itself be running as root or a privileged context;
    // filter to processes whose command line or path suggests a non-standard tool
    // (not a known kernel thread or the daemon reading its own maps).
    $open.principal.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin|tmp|dev\/shm|var\/tmp)\//
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.user.userid in %global_allowed_service_accounts
    $open.principal.hostname = $hostname

    // Stage 2: Within the same window the same host writes a new file to a
    // staging location (tmp, dev/shm, var/tmp, or a hidden dot-file under /root
    // or /home). This represents the adversary dumping extracted credentials.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm)\//
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Chronological ordering: memory read must precede the file write
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $reading_process = array_distinct($open.principal.process.file.full_path)
    $proc_mem_targets = array_distinct($open.target.file.full_path)
    $staged_files = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open and $file
}
