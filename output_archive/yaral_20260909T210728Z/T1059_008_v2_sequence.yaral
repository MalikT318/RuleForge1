/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:15:22.727734+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_NetDevice_Login_Then_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a management-plane login to a network device followed by a configuration modification within a short window. Adversaries abusing the network device CLI (T1059.008) typically authenticate via SSH or Telnet and then issue configuration commands to alter routing, ACLs, startup config, or disable logging. This correlation captures that two-step pattern as observed in firewall and perimeter management logs."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites = "Requires management-plane authentication events (USER_LOGIN) and configuration change events (SETTING_MODIFICATION) from network devices forwarded to Chronicle via syslog or a normalised connector."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network engineers performing scheduled maintenance, automated configuration management platforms (e.g., TACACS-authenticated orchestration), and change-window activities."
    tuning_guidance = "Add known automation service accounts to %global_allowed_service_accounts and approved management source addresses to %global_allowed_mgmt_sources to suppress authorised activity. Consider raising severity if the source IP is external (not in %rfc1918_internal)."

  events:
    // Event 1: Management-plane login to the network device
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $device_hostname
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Event 2: Configuration modification on the same device shortly after
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.hostname = $device_hostname
    $cfg.principal.user.userid != ""
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: login must precede the config change
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $device_hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($device_hostname)
    $triggering_users = array_distinct($auth.principal.user.userid)
    $modifying_users = array_distinct($cfg.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $config_targets = array_distinct($cfg.target.resource.name)
    $login_count = count($auth.metadata.event_timestamp.seconds)
    $change_count = count($cfg.metadata.event_timestamp.seconds)

  condition:
    $auth and $cfg
}
