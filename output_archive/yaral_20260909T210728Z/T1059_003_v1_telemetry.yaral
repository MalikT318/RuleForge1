/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:11:26.828371+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_Batch_File_Drop_Artifact {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation of batch script files (.bat / .cmd) in user-writable or suspicious locations by processes that are not known software installers or build systems. Adversaries frequently stage batch files as a persistence or execution artifact after gaining initial access, and this file-creation event is harder to suppress than command-line logging."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write telemetry must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers, build pipelines (MSBuild, Gradle, Maven), RMM agents writing maintenance scripts, developer toolchains, and legitimate admin scripts deployed via GPO or SCCM."
    tuning_guidance = "Add known installer or build-tool parent process paths to %global_allowed_admin_tools. Add authorised script-staging hosts to %global_allowed_script_hosts. Narrow scope by restricting target paths to the most sensitive directories if noise is high."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Batch file extension written to disk
    $file.target.file.full_path = /(?i)\.(bat|cmd)$/

    // Written into user-writable or attacker-favoured directories
    // Matches: %TEMP%, %APPDATA%, %LOCALAPPDATA%, %PUBLIC%, Downloads,
    //          Desktop, root of C:\, ProgramData sub-dirs, and Windows\Temp
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData\\(Local\\Temp|Local|Roaming)|Desktop|Downloads|Documents)|\\Windows\\Temp|\\ProgramData\\(?!Microsoft\\Windows\\(Start Menu|Defender))[^\\]+|^[A-Za-z]:\\[^\\]+\.(bat|cmd)$)/

    // Parent process is not a known-good administrative or deployment tool
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised script-staging hosts
    not $file.principal.hostname in %global_allowed_script_hosts

    // Exclude backup and imaging processes that may stage scripts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known software installer parent processes by pattern
    // (msiexec, setup helpers, update engines)
    not $file.principal.process.file.full_path = /(?i)\\(msiexec|setup|install|update|deploy|patch|unins\d*|redist).*\.exe$/

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $writing_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
