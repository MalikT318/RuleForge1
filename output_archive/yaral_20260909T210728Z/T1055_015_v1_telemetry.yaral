/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:09:32.981239+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events consistent with ListPlanting (T1055.015), where a process acquires a handle to another process hosting a SysListView32 control. Attackers must open a handle to the victim process to write shellcode into its address space before hijacking the LVM_SORTITEMS callback. This rule pivots on the handle-acquisition artifact rather than command-line telemetry, providing additive coverage over process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised to UDM PROCESS_OPEN. The target process must host a SysListView32 window (e.g. explorer.exe, taskmgr.exe, mmc.exe, regedit.exe). Access rights PROCESS_VM_WRITE | PROCESS_VM_OPERATION | PROCESS_VM_READ must be captured."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate accessibility tools, screen readers, UI automation frameworks, and some AV/EDR agents that enumerate or inspect process windows. Backup and imaging software may also open handles to GUI processes."
    tuning_guidance = "Add known-good parent processes (accessibility tools, approved RMM agents, EDR sensors) to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow further by requiring the principal process to reside outside of known system directories if false-positive volume is high."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be a process commonly hosting SysListView32 controls
    // (explorer, taskmgr, mmc, regedit, control panel hosts, etc.)
    $open.target.process.file.full_path = /\\(explorer|taskmgr|mmc|regedit|control|rundll32|dllhost|svchost)\.exe$/  nocase

    // Principal (opener) must NOT itself be a known system process opening
    // its own child - flag cross-process handle acquisition from unexpected parents
    not $open.principal.process.file.full_path = /\\(explorer|taskmgr|mmc|regedit|control|rundll32|dllhost|svchost|csrss|winlogon|services|lsass|smss|wininit)\.exe$/ nocase

    // Principal must not reside in a trusted system directory
    // (attackers typically run from user-writable or temp paths)
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss]ystem32\\/
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss]ys[Ww][Oo][Ww]64\\/
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Pp]rogram [Ff]iles\\/
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Pp]rogram [Ff]iles \([Xx]86\)\\/

    // Exclude approved security and admin tooling
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Principal hostname must be populated
    $open.principal.hostname != ""

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opener_pid = array_distinct($open.principal.process.pid)
    $target_pid = array_distinct($open.target.process.pid)

  condition:
    $open
}
