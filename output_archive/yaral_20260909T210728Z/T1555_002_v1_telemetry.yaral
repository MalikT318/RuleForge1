/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:28:52.957564+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Securityd_Memory_Proc_Read_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read or creation artifacts consistent with a process attempting to access another process's memory via /proc/<pid>/mem or /proc/<pid>/maps on Linux. While securityd is a macOS concept, adversaries on Linux use analogous techniques against credential-caching daemons (e.g., gnome-keyring-daemon, kwallet, lsass equivalents) by reading /proc/<pid>/mem to extract plaintext credentials from memory. This rule fires when a non-root-expected process creates or reads a file artifact under /proc that targets memory or memory-mapped regions of another process, or when a suspicious process dumps /proc/<pid>/mem content to a world-writable staging path such as /tmp or /dev/shm."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux EDR or auditd FILE_READ/FILE_CREATION telemetry normalised to UDM. Auditd rules must include -a always,exit -F arch=b64 -S open,openat,read -F path=/proc and output to Chronicle via a syslog or Ops Agent pipeline."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace) run by developers; security scanners performing memory analysis; backup agents reading /proc for system state; monitoring agents such as Prometheus node_exporter."
    tuning_guidance = "Add authorised security and monitoring tool paths to %global_allowed_security_tools. Add approved backup agent paths to %global_allowed_backup_processes. Scope the rule further by requiring the target path to match a specific credential daemon PID resolved via prior telemetry."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a memory artifact written to a world-writable staging area,
    // indicating a process dumped /proc/<pid>/mem content for offline analysis.
    // Alternatively, match direct open of /proc/<pid>/mem or /proc/<pid>/maps
    // as a file creation event (some EDR agents surface these as FILE_CREATION
    // when the handle is opened for write/read with O_CREAT or equivalent).
    (
      $file.target.file.full_path = /^\/proc\/[0-9]+\/(mem|maps|smaps|pagemap|environ)$/ nocase
      or
      $file.target.file.full_path = /^\/tmp\/.*(mem|dump|cred|key|pass|secret).*$/ nocase
      or
      $file.target.file.full_path = /^\/dev\/shm\/.*(mem|dump|cred|key|pass|secret).*$/ nocase
      or
      $file.target.file.full_path = /^\/run\/shm\/.*(mem|dump|cred|key|pass|secret).*$/ nocase
    )

    // The acting process must NOT be a known-good security or backup tool.
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude kernel threads and known safe system paths.
    // Kernel threads have no meaningful process path; EDR agents typically
    // populate this field for userspace processes only.
    $file.principal.process.file.full_path != ""

    // Exclude standard debugger and tracing binaries that are explicitly
    // approved via the security tools list; catch unexpected processes
    // that are NOT typical system utilities.
    not $file.principal.process.file.full_path = /^\/(usr\/)?bin\/(ps|top|htop|cat|ls|stat|file)$/ nocase

    // Exclude the process reading its own /proc entry (self-inspection).
    // We cannot compare PID fields directly in YARA-L, but we can exclude
    // the canonical self-reference path.
    not $file.target.file.full_path = /^\/proc\/self\// nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $target_artifact = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
