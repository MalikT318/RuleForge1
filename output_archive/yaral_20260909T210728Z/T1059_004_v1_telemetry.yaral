/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:12:15.298522+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_ESXi_Shell_Script_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of shell script files in sensitive ESXi filesystem locations. Adversaries abusing Unix shell on ESXi frequently drop shell scripts to /tmp, /scratch, /vmfs, or datastore paths as staging artifacts for execution, persistence, or lateral movement. This rule targets the file artifact produced by shell abuse rather than the command-line invocation, providing coverage orthogonal to process-creation rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires ESXi file activity telemetry normalised into Chronicle UDM FILE_CREATION or FILE_MODIFICATION events. Typically sourced from ESXi hostd/shell logs or an EDR agent capable of monitoring ESXi file system events (e.g. Carbon Black, CrowdStrike Falcon for ESXi, or a syslog forwarder with inotify-equivalent coverage)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate VMware patch bundles and VIB installations writing scripts to /tmp or /scratch. Authorised administrator maintenance scripts deployed via vSphere Lifecycle Manager. Backup agents writing staging scripts to datastore paths."
    tuning_guidance = "Add known-good parent processes (e.g. vmware-visorfs, esxcli wrapper scripts) to %global_allowed_admin_tools. Scope the datastore path regex more narrowly if specific datastore naming conventions are known. Exclude %global_allowed_backup_processes for backup-agent parent processes."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /^\/tmp\// nocase
      or
      $file.target.file.full_path = /^\/scratch\// nocase
      or
      $file.target.file.full_path = /^\/vmfs\// nocase
      or
      $file.target.file.full_path = /^\/store\// nocase
      or
      $file.target.file.full_path = /^\/var\/run\// nocase
    )
    (
      $file.target.file.full_path = /\.(sh|ash|bash|py|pl|rb|tcl)$/ nocase
      or
      $file.target.file.mime_type = /shell/ nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_script_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
