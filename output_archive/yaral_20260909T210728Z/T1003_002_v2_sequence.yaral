/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:23:49.526516+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Registry_Export_Then_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects the two-stage SAM database extraction pattern: a process opens or reads the HKLM\\SAM or HKLM\\SYSTEM registry hive (registry read/access event), followed by creation of a suspicious output file on the same host within 10 minutes. This covers adversaries using reg.exe, PowerShell, or other tools to save SAM/SYSTEM hive contents to disk for offline cracking, without relying on command-line string matching."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires EDR or Sysmon telemetry normalised to UDM. Event 1 requires REGISTRY_MODIFICATION or REGISTRY_CREATION events for HKLM\\SAM or HKLM\\SYSTEM. Event 2 requires FILE_CREATION events. Both must populate principal.hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup software saving registry hives, authorised IT imaging tools, Windows VSS operations, domain join or provisioning scripts."
    tuning_guidance = "Add backup and imaging process paths to %global_allowed_backup_processes. Add authorised admin accounts to %global_allowed_admin_users. Narrow the file path regex if the environment uses a known safe staging directory."

  events:
    // Event 1: A process writes/creates a registry key under HKLM\SAM or HKLM\SYSTEM
    // This fires when reg.exe, PowerShell, or any tool touches these sensitive hives.
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)^HKEY_LOCAL_MACHINE\\(SAM|SYSTEM)(\\|$)/
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.user.userid in %global_allowed_admin_users
    $reg.principal.hostname = $hostname

    // Event 2: A file is created with a name or path pattern consistent with
    // hive export output (e.g., sam, system, ntds, hive dumps) on the same host.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\\|\/)(sam|system|ntds|security|hive|dump|cred)[^\\\/]{0,30}$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_admin_users
    $file.principal.hostname = $hostname

    // Chronological ordering: registry access must precede file creation
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($hostname)
    $reg_keys_accessed = array_distinct($reg.target.registry.registry_key)
    $files_created = array_distinct($file.target.file.full_path)
    $offending_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $file
}
