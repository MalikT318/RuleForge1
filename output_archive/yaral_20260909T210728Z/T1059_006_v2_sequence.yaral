/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:14:07.219745+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_ESXi_Python_After_Interactive_Shell_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive shell session established on an ESXi host followed by Python interpreter execution within a short window. Adversaries who gain shell access to ESXi (via SSH or the DCUI) may invoke Python to execute payloads, manipulate VM configurations, or exfiltrate data using built-in Python libraries. This correlation rule provides additive coverage beyond simple command-line matching by requiring the shell login precursor event."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Requires ESXi shell/SSH session login events (hostd or shell audit) and process launch telemetry from the ESXi host normalised into Chronicle UDM. Both USER_LOGIN and PROCESS_LAUNCH events must be ingested from the same host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised VMware administrators running Python-based management scripts, VMware vSphere lifecycle management automation, monitoring agents that authenticate and invoke Python health checks."
    tuning_guidance = "Add known automation and service accounts to %global_allowed_service_accounts. Add approved management source hosts to %global_allowed_mgmt_sources. Narrow the rule to specific high-value ESXi hosts if noise is excessive across large fleets."

  events:
    // Leg 1: Interactive shell or SSH login to the ESXi host
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $esxi_host
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Leg 2: Python interpreter launched on the same ESXi host after login
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $esxi_host
    $proc.target.process.file.full_path = /\/python[0-9.]*$/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Chronological ordering: login must precede Python execution
    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $esxi_host over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($esxi_host)
    $triggering_user = array_distinct($auth.target.user.userid)
    $python_binary = array_distinct($proc.target.process.file.full_path)
    $python_cmdline = array_distinct($proc.target.process.command_line)
    $login_source_ip = array_distinct($auth.principal.ip)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $auth and $proc
}
