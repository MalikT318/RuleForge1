/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:27:08.317028+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Mem_Read_Then_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process reading /proc/<PID>/mem or /proc/<PID>/maps (credential scraping from process memory) followed by a file write on the same host within 10 minutes. This pattern is consistent with tools like MimiPenguin that dump credentials from process memory and stage them to disk. Additive coverage over command-line rules: focuses on the FILE_READ of proc pseudo-files and subsequent FILE_CREATION of a staging artifact."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM with FILE_READ and FILE_CREATION events. Auditd rules must include -a always,exit -F arch=b64 -S open,openat -F dir=/proc and file write syscalls."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace) reading /proc/<PID>/mem for attached processes. Security scanners and EDR agents inspecting process memory. Kernel developers and performance profiling tools. Backup agents reading process state."
    tuning_guidance = "Add known debugger and security tool parent process paths to %global_allowed_security_tools. Add authorised scanner source hosts to %global_allowed_scanners. Narrow the file write destination regex to exclude known-good staging directories used by your backup tooling via %global_allowed_backup_processes."

  events:
    // Event 1: A process reads /proc/<PID>/mem or /proc/<PID>/maps
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|environ|cmdline)$/
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    $read.principal.hostname = $hostname

    // Event 2: The same host writes a new file to a suspicious staging location
    $write.metadata.event_type = "FILE_CREATION"
    $write.target.file.full_path = /^\/(tmp|dev\/shm|var\/tmp|run\/shm|run\/user\/[0-9]+)\//
    not $write.principal.process.file.full_path in %global_allowed_security_tools
    not $write.principal.process.file.full_path in %global_allowed_backup_processes
    $write.principal.hostname = $hostname

    // Chronological ordering: proc read must precede the file write
    $read.metadata.event_timestamp.seconds <= $write.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($read.principal.hostname)
    $reading_process = array_distinct($read.principal.process.file.full_path)
    $proc_paths_accessed = array_distinct($read.target.file.full_path)
    $staged_file_paths = array_distinct($write.target.file.full_path)
    $writing_process = array_distinct($write.principal.process.file.full_path)
    $actor_userid = array_distinct($read.principal.user.userid)

  condition:
    $read and $write
}
