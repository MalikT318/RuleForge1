/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:32:11.459422+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_AppLayerProtocol_HighFreqExternalConnections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects high-frequency outbound connections from a single internal source to external destinations on common application-layer protocol ports (HTTP, HTTPS, DNS, FTP, SMTP, etc.). Adversaries abuse these protocols to blend C2 traffic with legitimate application traffic. This rule operates on firewall/perimeter telemetry and provides additive coverage beyond endpoint process-launch detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Fields required: principal.ip, target.ip, target.port, network.ip_protocol."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "CDN-heavy SaaS clients, software update services, monitoring agents, backup solutions, and high-throughput web servers may generate similar volumes. Vulnerability scanners listed in %global_allowed_scanners will also trigger."
    tuning_guidance = "Add known-good internal scanner IPs to %global_allowed_scanners. Add approved external domains/IPs to %global_allowed_domains. Raise the threshold window or connection count if the environment has legitimate high-frequency egress patterns. Narrow target.port list if specific protocols are not in use."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal address (RFC1918 space)
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not RFC1918)
    not $net.target.ip in %rfc1918_internal

    // Target common application-layer protocol ports used for C2 blending:
    // 80 HTTP, 443 HTTPS, 53 DNS-over-TCP, 21 FTP, 25 SMTP, 587 SMTP-submission,
    // 8080 alt-HTTP, 8443 alt-HTTPS, 110 POP3, 143 IMAP, 993 IMAPS, 995 POP3S
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 53 or
      $net.target.port = 21 or
      $net.target.port = 25 or
      $net.target.port = 587 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 110 or
      $net.target.port = 143 or
      $net.target.port = 993 or
      $net.target.port = 995
    )

    // Exclude approved scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $net.principal.ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.event_timestamp.seconds)

  condition:
    #net > 200
}
