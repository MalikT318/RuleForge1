/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:31:11.802849+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Password_Manager_Process_Then_Credential_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a password manager process launch followed by suspicious file access to credential databases by a different process, indicating potential credential harvesting."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires EDR process and file telemetry with command-line and file path visibility."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup software accessing password manager databases, antivirus scanning, cloud sync clients (Dropbox, OneDrive), authorized forensic tools."
    tuning_guidance = "Add approved backup processes to %global_allowed_backup_processes. Exclude cloud sync parent processes via %global_allowed_admin_tools."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)\\(keepass|1password|lastpass|bitwarden|dashlane|roboform|passwordsafe|enpass).*\.exe$/ nocase
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /(?i)\\(keepass\.kdbx|1password\.sqlite|lastpass\.db|data\.json|vault\.db|passwordsafe\.psafe3|enpass\.walletx|login data|logins\.json)$/ nocase
    not $file.principal.process.file.full_path = /(?i)\\(keepass|1password|lastpass|bitwarden|dashlane|roboform|passwordsafe|enpass).*\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $password_manager_launched = array_distinct($proc.target.process.file.full_path)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $credential_files_accessed = array_distinct($file.target.file.full_path)

  condition:
    $proc and $file
}
