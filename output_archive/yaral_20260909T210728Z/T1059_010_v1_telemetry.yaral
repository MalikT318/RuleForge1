/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:16:26.813711+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoHotKey_AutoIT_Script_File_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation of AutoHotKey (.ahk) or AutoIT (.au3) script files on disk. Adversaries use these scripting languages to automate malicious tasks, execute payloads, and implement keyloggers. Pivoting on the file artifact provides coverage that is resilient to command-line evasion and interpreter renaming."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write telemetry must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate automation engineers, QA teams, and IT operations staff who author AHK or AutoIT scripts for approved tooling. Software installers that bundle AutoIT scripts during setup. RMM agents that deploy AutoIT-based helpers."
    tuning_guidance = "Add known-good parent process paths (e.g., IDE executables, approved RMM agents) to %global_allowed_admin_tools. Add authorised script-hosting machines to %global_allowed_script_hosts. Consider raising severity if the creating process is not a known editor or installer."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match .ahk (AutoHotKey) or .au3 (AutoIT) script extensions anywhere on disk
    $file.target.file.full_path = /\.(ahk|au3)$/ nocase

    // Exclude files written under common legitimate development and installer paths.
    // Regex anchored to typical user-profile and temp installer locations is intentionally
    // broad so it fires on unusual drop locations (e.g., ProgramData, AppData\Roaming,
    // system32, or web-server roots).
    not $file.target.file.full_path = /(?i)\\(Program Files|Program Files \(x86\))\\/ nocase

    // Exclude approved administrative and scripting tool parents
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

    // Capture the creating process for context
    $creating_process = $file.principal.process.file.full_path
    $script_path      = $file.target.file.full_path
    $hostname         = $file.principal.hostname

  outcome:
    $risk_score          = max(60)
    $mitre_technique_id  = array_distinct("T1059.010")
    $primary_entity      = array_distinct($file.principal.hostname)
    $dropped_script_path = array_distinct($script_path)
    $creating_proc       = array_distinct($creating_process)
    $affected_host       = array_distinct($hostname)

  condition:
    $file
}
