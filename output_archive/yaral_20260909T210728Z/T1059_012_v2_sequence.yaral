/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:18:00.777720+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Shell_Enabled_Then_Privileged_Command {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects ESXi shell or SSH service enablement followed by execution of privileged hypervisor management commands, indicating potential abuse of hypervisor CLI for malicious purposes."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "Requires ESXi hostd and shell audit logs forwarded to Chronicle."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate administrator troubleshooting, authorized maintenance windows, automated configuration management tools."
    tuning_guidance = "Add authorized management service accounts to %global_allowed_service_accounts and approved remote management sources to %global_allowed_mgmt_sources."

  events:
    $enable.metadata.event_type = "SETTING_MODIFICATION"
    (
      $enable.target.resource.attribute.labels["setting_name"] = /(?i)(ssh|shell|esxishell|tss)/ or
      $enable.target.resource.name = /(?i)(ssh|shell|esxishell|tss)/ or
      $enable.about.labels["service_name"] = /(?i)(ssh|shell|esxishell|tss)/
    )
    (
      $enable.target.resource.attribute.labels["new_value"] = /(?i)(true|enabled|running|start)/ or
      $enable.security_result.summary = /(?i)(enabled|started)/
    )
    $enable.principal.hostname = $hostname
    not $enable.principal.user.userid in %global_allowed_service_accounts

    $cmd.metadata.event_type = "PROCESS_LAUNCH"
    (
      $cmd.target.process.file.full_path = /\/(esxcli|vim-cmd|esxcfg-|localcli)/ or
      $cmd.target.process.command_line = /\/(esxcli|vim-cmd|esxcfg-|localcli)/
    )
    (
      $cmd.target.process.command_line = /(?i)(firewall|network|storage|vmsvc|hostsvc|solo|vimsvc)/ or
      $cmd.target.process.command_line = /(?i)(vm\.(power|destroy|unregister)|datastore\.(add|remove)|system\.(shutdown|reboot))/ or
      $cmd.target.process.command_line = /(?i)(syslog|coredump|acceptancelevel|maintenancemode)/
    )
    $cmd.principal.hostname = $hostname
    not $cmd.principal.user.userid in %global_allowed_service_accounts
    not $cmd.principal.ip in %global_allowed_mgmt_sources

    $enable.metadata.event_timestamp.seconds <= $cmd.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($hostname)
    $enabled_services = array_distinct($enable.target.resource.name)
    $executed_commands = array_distinct($cmd.target.process.command_line)
    $user_accounts = array_distinct($cmd.principal.user.userid)
    $source_ips = array_distinct($cmd.principal.ip)

  condition:
    $enable and $cmd
}
