/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:18:35.925257+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_API_Exec_Then_Sensitive_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud audit sequence where a container exec/attach API call is followed by access to sensitive resources (secrets, credentials, environment configuration) within the same container context and time window. This indicates adversarial use of container CLI/API to execute commands and harvest sensitive data, without relying on process command-line telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Requires cloud provider audit logs (Kubernetes API server audit, Docker API audit) normalised into Chronicle UDM. Kubernetes audit policy must log request-level events for pods/exec, pods/attach, and secrets resources."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Authorised CI/CD pipelines performing health checks or log collection via exec; SRE/platform teams debugging live containers; monitoring agents reading secrets via the API."
    tuning_guidance = "Add approved service accounts to %global_allowed_service_accounts. Add approved CI/CD source principals to %global_allowed_cloud_principals. Narrow the resource_name regex if specific namespaces or workloads are known-good."

  events:
    // Event 1: Container exec or attach API call (interactive command execution via API)
    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.resource.name = /\/pods\/[^\/]+\/(exec|attach|portforward)/ nocase
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_cloud_principals
    $exec.principal.user.userid = $actor

    // Event 2: Sensitive resource access following the exec (secrets, configmaps with credentials, env data)
    $sens.metadata.event_type = "USER_RESOURCE_ACCESS"
    $sens.target.resource.name = /\/(secrets|configmaps|serviceaccounts\/[^\/]+\/token)/ nocase
    not $sens.principal.user.userid in %global_allowed_service_accounts
    not $sens.principal.user.userid in %global_allowed_cloud_principals
    $sens.principal.user.userid = $actor

    // Chronological ordering: exec must precede sensitive resource access
    $exec.metadata.event_timestamp.seconds <= $sens.metadata.event_timestamp.seconds

  match:
    $actor over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($actor)
    $exec_targets = array_distinct($exec.target.resource.name)
    $sensitive_resources_accessed = array_distinct($sens.target.resource.name)
    $source_ips = array_distinct($exec.principal.ip)

  condition:
    $exec and $sens
}
