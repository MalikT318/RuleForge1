/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:12:39.106643+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_Shell_Script_Drop_Then_Outbound_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a shell script or executable dropped into a world-writable or staging directory on Linux (FILE_CREATION) followed within 5 minutes by an outbound network connection from the same host to a non-internal destination. This pattern is consistent with a Unix shell payload being staged and then beaconing out or downloading additional tooling, providing network-layer coverage additive to existing process-launch detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires Linux EDR or auditd FILE_CREATION telemetry AND firewall/perimeter NETWORK_CONNECTION or NETWORK_FLOW logs, both normalised to UDM. The host identifier must be consistent across both log sources."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Package managers writing scripts to /tmp during install, legitimate software update agents, CI/CD pipeline runners, container build processes, backup agents staging scripts."
    tuning_guidance = "Add known-good source hosts to %global_allowed_backup_processes or %global_allowed_admin_tools. Add approved external destinations to %global_allowed_domains. Narrow the file path regex if staging directories differ per environment. Raise the destination port filter to exclude well-known update ports if needed."

  events:
    // Event 1: A shell script or executable is created in a world-writable or
    // common staging directory. Narrowly pre-filtered to avoid high-volume joins.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/|\/var\/run\/)/ nocase
    $file.target.file.full_path = /(\.sh|\.bash|\.py|\.pl|\.rb|\.elf|[^.]{1,32})$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $src_host

    // Event 2: Outbound network connection from the same host to a non-internal
    // destination, on a suspicious or uncommon port. Firewall/perimeter telemetry.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains
    // Exclude common benign high-volume ports (80, 443) to reduce noise;
    // focus on non-standard ports indicative of C2 or reverse shells.
    // Port 0 guard: ensure port is populated and not a standard web port.
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port > 0
    $net.principal.hostname = $src_host

    // Chronological ordering: file drop must precede the outbound connection.
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_host over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($src_host)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hostnames = array_distinct($net.target.hostname)

  condition:
    $file and $net
}
