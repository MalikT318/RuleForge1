/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:10:44.862317+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_ScriptBlock_Artifact_Written {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects PowerShell script-block logging artifacts written to disk under the Windows PowerShell event log or AppData transcript directories. When PowerShell executes code, Windows writes script-block log entries (Event 4104) and optional transcript files to predictable paths. Detecting the FILE_CREATION of these artifacts at the storage layer catches PowerShell execution even when command-line telemetry is suppressed, obfuscated, or the powershell.exe binary is replaced by a CLR-hosted alternative (e.g. System.Management.Automation loaded in-process)."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION telemetry. PowerShell Script Block Logging must be enabled (GPO: Turn on PowerShell Script Block Logging). Transcript logging is optional but increases coverage."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate administrative PowerShell automation, software deployment agents, patch management tools, and security tooling that intentionally invoke PowerShell. Transcript files written by authorised IT runbooks will also match."
    tuning_guidance = "Add known-good parent process paths (e.g. deployment agents, RMM tools) to %global_allowed_admin_tools. Add authorised service accounts that routinely run PowerShell to %global_allowed_service_accounts to suppress expected automation noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Script-block log cache files written by the PowerShell engine under ProgramData
    // OR transcript files written to user AppData or a custom transcript path.
    // Both paths are produced by the OS/CLR, not by the attacker-controlled binary name.
    (
      $file.target.file.full_path = /(?i)\\Microsoft\\Windows\\PowerShell\\/ or
      $file.target.file.full_path = /(?i)\\AppData\\(Roaming|Local)\\.*\\PowerShell_transcript/ or
      $file.target.file.full_path = /(?i)\\Transcripts\\.*\.txt$/
    )

    // Restrict to file extensions associated with script-block cache blobs or transcripts
    (
      $file.target.file.full_path = /(?i)\.(txt|log|blk)$/ or
      // Script-block cache files have no extension but live under a GUID-named subfolder
      $file.target.file.full_path = /(?i)\\PowerShell\\[0-9a-fA-F\-]{36}\\/
    )

    // Exclude known-good administrative tooling by the writing process
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)
    $user_context = array_distinct($file.principal.user.userid)

  condition:
    $file
}
