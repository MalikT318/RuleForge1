/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:22:47.623113+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Memory_Dump_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects creation of a memory dump file in paths or with names consistent with LSASS process dumping. Attackers using procdump, comsvcs.dll MiniDump, Task Manager, or WerFault silent-exit abuse all produce a dump file artifact on disk. This rule pivots on the resulting FILE_CREATION event rather than the process command line, providing coverage orthogonal to process-launch detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file-write event) normalised to UDM FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate crash dumps written by Windows Error Reporting (WerFault.exe) to C:\\ProgramData\\Microsoft\\Windows\\WER\\; memory dumps created by authorised incident-response or forensic tooling; application crash dumps written by debuggers during development. Tune using %global_allowed_backup_processes and %global_allowed_security_tools."
    tuning_guidance = "Add authorised dump-writing processes (e.g. approved IR tooling, WER paths) to %global_allowed_backup_processes. Narrow the file path regex if the environment uses a known, fixed dump output directory. Raise severity to Critical and lower threshold if the environment has LSA Protection (RunAsPPL) enabled, as any successful dump is highly anomalous."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match dump file extensions commonly produced by LSASS dumping techniques
    $file.target.file.full_path = /(?i)\.(dmp|mdmp|dump|bin)$/

    // Match on file names or paths that reference lsass, or generic dump names
    // written to suspicious locations (temp, user profile, root of drive)
    (
      $file.target.file.full_path = /(?i)lsass/ or
      $file.target.file.full_path = /(?i)\\(windows\\)?temp\\/  or
      $file.target.file.full_path = /(?i)\\users\\[^\\]+\\(appdata\\(local|roaming)\\|desktop\\|documents\\|downloads\\)/ or
      $file.target.file.full_path = /(?i)^[a-z]:\\[^\\]+\.(dmp|mdmp|dump|bin)$/
    )

    // Exclude known-good backup and security tooling writing dump files
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude the canonical WER crash dump output directory to reduce noise
    // from legitimate Windows Error Reporting
    not $file.target.file.full_path = /(?i)\\ProgramData\\Microsoft\\Windows\\WER\\/

    //(?i) Exclude kernel/system crash dumps written to Windows root
    not $file.target.file.full_path = /(?i)^[a-z]:\\(windows\\)?memory\.dmp$/

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $dump_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
