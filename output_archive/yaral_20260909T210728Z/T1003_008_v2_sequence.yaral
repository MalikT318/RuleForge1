/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:27:41.002552+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_File_Read_Then_External_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects reading of /etc/shadow followed by writing to a user-writable location or external transfer, indicating credential harvesting preparation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux EDR or auditd file access telemetry with read and write events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup software reading shadow files, configuration management tools (Ansible, Puppet, Chef), system imaging utilities, authorized security auditing."
    tuning_guidance = "Add approved backup processes to %global_allowed_backup_processes. Exclude known admin automation parent processes to %global_allowed_service_accounts."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = "/etc/shadow"
    $read.principal.user.userid = $userid
    $read.principal.hostname = $hostname
    not $read.principal.process.file.full_path in %global_allowed_backup_processes

    $write.metadata.event_type = "FILE_CREATION"
    (
      $write.target.file.full_path = /^\/tmp\// nocase or
      $write.target.file.full_path = /^\/var\/tmp\// nocase or
      $write.target.file.full_path = /^\/dev\/shm\// nocase or
      $write.target.file.full_path = /^\/home\/[^\/]+\// nocase or
      $write.target.file.full_path = /^\/root\// nocase
    )
    $write.principal.user.userid = $userid
    $write.principal.hostname = $hostname
    not $write.principal.process.file.full_path in %global_allowed_backup_processes

    $read.metadata.event_timestamp.seconds <= $write.metadata.event_timestamp.seconds

  match:
    $userid, $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($hostname)
    $suspicious_user = array_distinct($userid)
    $read_process = array_distinct($read.principal.process.file.full_path)
    $write_process = array_distinct($write.principal.process.file.full_path)
    $output_file = array_distinct($write.target.file.full_path)

  condition:
    $read and $write
}
