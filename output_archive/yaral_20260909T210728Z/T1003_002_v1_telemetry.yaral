/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:23:28.515044+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Registry_Hive_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects file creation events consistent with dumping the SAM, SYSTEM, or SECURITY registry hives to disk. Adversaries export these hives to extract credential material offline. This rule fires on the resulting file artifact rather than the command line, providing coverage against process-creation log gaps and renamed tooling."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write events must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised backup software exporting registry hives for system imaging; Windows built-in repair and recovery operations writing hive snapshots; some enterprise configuration management tools."
    tuning_guidance = "Add backup and imaging process paths to %global_allowed_backup_processes. Scope exclusions to specific destination directories used by approved tooling (e.g., Windows Repair folders). Monitor for files written outside expected system backup paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match hive export filenames: sam, system, security, ntds with optional extension
    // Covers: sam, sam.hive, sam.bak, system, system.hive, security, security.bak, etc.
    $file.target.file.full_path = /(?i)(\\|\/)(sam|system|security|ntds)(\.hive|\.bak|\.save|\.dmp|\.dat|\.tmp)?$/ nocase

    // Exclude writes to canonical Windows registry hive locations (live hive files)
    // Legitimate live hives live under System32\config - exports go elsewhere
    not $file.target.file.full_path = /(?i)\\windows\\system32\\config\\(sam|system|security|software|default)(\.log[12]?|\.sav)?$/ nocase

    // Exclude known backup and imaging processes
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude writes originating from approved admin tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $hive_file_path = array_distinct($file.target.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
