/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:17:22.974087+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Drop_Then_Outbound_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Lua script file written to a world-writable or staging directory on a Linux host, followed within 5 minutes by an outbound network connection from that same host to a non-internal destination. This pattern is consistent with adversaries staging and executing Lua-based payloads that beacon or exfiltrate data. Coverage is additive to process-launch rules by correlating file-drop telemetry with perimeter-observable network behaviour."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires Linux EDR or auditd FILE_CREATION events AND firewall/perimeter NETWORK_CONNECTION or NETWORK_FLOW events normalised into Chronicle UDM. Both sources must populate principal.hostname consistently so the join resolves."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate software deployments writing Lua configuration or plugin files (e.g., Neovim, Redis, Wireshark plugins, game servers). Automated provisioning pipelines that write scripts to /tmp before executing them. Monitoring agents that make outbound calls after configuration updates."
    tuning_guidance = "Populate %global_allowed_admin_tools with known Lua-using application paths. Add authorised management source hosts to %global_allowed_mgmt_sources. Add known-good update or telemetry domains to %global_allowed_domains to reduce noise from legitimate software phoning home after config changes."

  events:
    // Event 1: A Lua script file is created in a suspicious staging location on Linux
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/|\/home\/[^\/]+\/\.(config|cache|local)\/)[^\s]+\.lua$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Event 2: Outbound network connection from the same host to a non-internal destination
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    // Enforce chronological ordering: file drop precedes network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($hostname)
    $dropped_lua_paths = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hostnames = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $file and $net
}
