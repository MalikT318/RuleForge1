/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:15:06.517597+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_Network_Device_CLI_Remote_Mgmt_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects inbound management-plane connections to network devices over CLI-capable protocols (SSH, Telnet, raw console ports) originating from addresses outside approved management sources. Adversaries abusing T1059.008 must first establish a CLI session; detecting unexpected source addresses for these protocols provides network-side coverage complementary to any endpoint process-launch rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs that record inbound sessions to network device management addresses on ports 22 (SSH), 23 (Telnet), 830 (NETCONF), 4786 (Cisco Smart Install), or 179 (BGP used as a management vector). Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events with target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network engineers connecting from jump hosts or management subnets not yet added to %global_allowed_mgmt_sources. Automated monitoring tools (SNMP pollers, NMS platforms) that also open TCP sessions on these ports. Legitimate BGP peering sessions on port 179."
    tuning_guidance = "Add all approved management source addresses and jump-host subnets to %global_allowed_mgmt_sources. If BGP port 179 generates excessive noise from legitimate peers, add a secondary filter on target.port to exclude it or scope the rule to ports 22, 23, 830, and 4786 only."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target ports associated with CLI or management-plane access on network devices:
    // 22  = SSH, 23 = Telnet, 830 = NETCONF over SSH, 4786 = Cisco Smart Install (unauthenticated CLI vector)
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 830 or
      $net.target.port = 4786
    )

    // Source must not be an approved management address
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Source must not be internal RFC-1918 space (catches lateral movement from internal but non-approved hosts)
    not $net.principal.ip in %rfc1918_internal

    // Destination must not be an approved management address (avoids alerting on mgmt-to-mgmt flows)
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
