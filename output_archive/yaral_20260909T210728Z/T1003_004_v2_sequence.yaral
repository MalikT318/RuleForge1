/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:24:59.036247+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Registry_Access_Then_File_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage LSA secrets harvesting pattern: first, a suspicious process opens or modifies the HKLM\\SECURITY\\Policy\\Secrets registry hive (indicating credential access), followed within 10 minutes by creation of a file in a writable or temp-like location on the same host. This additive coverage targets the registry-access-to-file-staging sequence rather than command-line indicators."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 12/13) and file-creation telemetry (Event ID 11) normalised to UDM REGISTRY_MODIFICATION and FILE_CREATION. SACL auditing on HKLM\\SECURITY is recommended to increase registry event fidelity."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup agents reading the SECURITY hive, domain-join operations, some AV/EDR products performing credential hygiene checks, Windows LSASS during normal policy refresh."
    tuning_guidance = "Add known backup and security agent process paths to %global_allowed_backup_processes and %global_allowed_security_tools. Narrow the file-creation path regex if staging locations differ from observed attacker behaviour in your environment."

  events:
    // Event 1: Registry access to LSA Secrets key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SECURITY\\Policy\\Secrets/
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    //(?i) Event 2: File creation in a staging/temp-like location on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\\Temp\\|\\AppData\\|\\ProgramData\\|\\Users\\Public\\|\\Windows\\Temp\\)/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    // Chronological ordering: registry access precedes file staging
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($hostname)
    $reg_keys_accessed = array_distinct($reg.target.registry.registry_key)
    $files_created = array_distinct($file.target.file.full_path)
    $accessing_processes = array_distinct($reg.principal.process.file.full_path)
    $staging_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
