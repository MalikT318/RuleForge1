/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:40:01.767366+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_EventLog_EVTX_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects direct deletion or truncation of Windows Event Log (.evtx) files under the canonical winevt log directory. Attackers who bypass command-line logging can still be caught at the file-system layer when they delete or overwrite the raw log files stored in C:\\Windows\\System32\\winevt\\Logs\\."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires EDR or Sysmon file-deletion/modification telemetry (Sysmon Event ID 23 for file delete, or equivalent EDR FILE_DELETION / FILE_MODIFICATION events). The EDR must be configured to capture file events in system directories."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Event Log service itself rotating or archiving logs (process: svchost.exe hosting EventLog service). Backup agents archiving .evtx files. Log collection agents (SIEM forwarders) that copy and then remove log files. Authorised forensic imaging tools."
    tuning_guidance = "Add the full path of approved backup or log-collection processes to %global_allowed_backup_processes. If the EventLog svchost generates noise, scope the exclusion to the specific service host command line. Consider raising severity to Critical if the deleting process is not svchost.exe."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\winevt\\Logs\\.*\.evtx$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path = /(?i)\\Windows\\system32\\svchost\.exe$/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_log_file = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
