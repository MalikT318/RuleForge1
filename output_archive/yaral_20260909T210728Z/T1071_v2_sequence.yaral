/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:32:33.693832+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_NetDevice_AppLayer_C2_Beacon_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network device initiating repeated outbound connections to an external destination on an application-layer protocol port, followed by sustained data flow to the same destination. This pattern is consistent with C2 beaconing over application-layer protocols (HTTP, HTTPS, DNS-over-TCP, etc.) originating from a network device management plane or data plane. Adversaries abuse these protocols to blend C2 traffic with legitimate traffic."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires firewall flow/connection logs with source and destination IP, port, and byte counts normalised into UDM NETWORK_CONNECTION and NETWORK_FLOW events. Both event types must populate principal.ip, target.ip, target.port, and network.sent_bytes."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate network device telemetry exports (NetFlow, syslog forwarding), NTP, SNMP traps to external collectors, authorised cloud management controllers, software update checks from network OS."
    tuning_guidance = "Add authorised external management and telemetry collector addresses to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Raise the sent_bytes threshold in the flow event filter if bulk legitimate exports are triggering the rule."

  events:
    // Event 1: Network device establishes an outbound connection to an external
    // destination on a common application-layer protocol port.
    // Pre-filter: must be an outbound connection (target not internal),
    // on a well-known app-layer port, from a device that is NOT an approved mgmt source.
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.target.port = 80 or
    $conn.target.port = 443 or
    $conn.target.port = 8080 or
    $conn.target.port = 8443 or
    $conn.target.port = 53
    not $conn.target.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_mgmt_sources
    not $conn.principal.ip in %global_allowed_scanners
    $conn.principal.ip = $device_ip
    $conn.target.ip = $ext_ip

    // Event 2: A sustained flow record to the same external destination from the
    // same device, indicating data was actually transferred (not just a probe).
    // Pre-filter: non-trivial byte count to exclude empty keepalives.
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.sent_bytes > 512
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_mgmt_sources
    not $flow.principal.ip in %global_allowed_cloud_principals
    $flow.principal.ip = $device_ip
    $flow.target.ip = $ext_ip

    // Chronological ordering: connection attempt precedes or coincides with flow record
    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_ip, $ext_ip over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($conn.principal.ip)
    $destination_ip = array_distinct($flow.target.ip)
    $destination_ports = array_distinct($conn.target.port)
    $total_bytes_sent = max($flow.network.sent_bytes)
    $flow_count = count($flow.target.ip)

  condition:
    $conn and $flow
}
