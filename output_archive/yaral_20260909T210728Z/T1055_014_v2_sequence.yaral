/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:09:08.741501+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_VDSO_Hijack_ProcMem_Then_SharedLib {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage VDSO hijacking pattern: a non-standard process opens /proc/<pid>/mem (or /proc/<pid>/maps) to inspect or patch a target process's address space, followed within 5 minutes by the creation or modification of a shared object (.so) file in a world-writable or user-temp location on the same host. Together these events indicate an adversary reading the VDSO mapping of a victim process and staging a malicious shared library for injection via GOT/PLT redirection."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. Auditd rules must include -a always,exit -F arch=b64 -S open,openat,read,write -F dir=/proc and file-watch rules on /tmp, /dev/shm, /var/tmp."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Debuggers (gdb, lldb, strace), legitimate profilers (perf, valgrind), container runtimes inspecting /proc, and security agents that read process maps. Shared-library staging by package managers or build systems in /tmp."
    tuning_guidance = "Add trusted debugger and profiler parent process paths to %global_allowed_security_tools. Add authorised build-system accounts to %global_allowed_service_accounts. Narrow the .so path regex if your environment never writes shared objects to /dev/shm."

  events:
    // Stage 1: a process reads /proc/<pid>/mem or /proc/<pid>/maps
    // to inspect the virtual address space of another process.
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|pagemap)$/
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.user.userid in %global_allowed_service_accounts
    $open.principal.hostname = $hostname

    // Stage 2: a shared object is created or modified in a
    // world-writable or temporary location on the same host.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(tmp|dev\/shm|var\/tmp|run\/user\/[0-9]+)\/.*\.so(\.[0-9]+)*$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: proc-mem read must precede .so staging.
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1055.014")
    $primary_entity      = array_distinct($hostname)
    $reading_process     = array_distinct($open.principal.process.file.full_path)
    $proc_mem_path       = array_distinct($open.target.file.full_path)
    $staged_library      = array_distinct($file.target.file.full_path)
    $acting_user         = array_distinct($open.principal.user.userid)

  condition:
    $open and $file
}
