/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:24:23.445943+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_VSS_Shadow_Then_NTDS_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage NTDS credential theft pattern: a Volume Shadow Copy is created or manipulated by a Windows built-in utility, followed by a file creation or copy event targeting the NTDS.dit database within a 10-minute window on the same host. This is additive coverage over command-line detections, focusing on the file-system artefact produced after the VSS operation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires EDR or Sysmon telemetry normalised to UDM PROCESS_LAUNCH and FILE_CREATION events. Sysmon Event IDs 1 and 11, or equivalent EDR process and file telemetry, must be ingested."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate backup software (Windows Server Backup, Veeam, Commvault) that creates VSS snapshots and reads NTDS.dit as part of AD-aware backup jobs. Domain controller patching pipelines that snapshot the volume before applying updates."
    tuning_guidance = "Add authorised backup process paths to %global_allowed_backup_processes. Add authorised service accounts that run backup jobs to %global_allowed_service_accounts. Scope the rule to domain controller asset groups if your SIEM supports asset-based filtering."

  events:
    // Stage 1: VSS snapshot creation or manipulation via a Windows built-in
    // Matches vssadmin, wmic, diskshadow, or ntdsutil invoking shadow-copy operations
    $vss.metadata.event_type = "PROCESS_LAUNCH"
    $vss.target.process.file.full_path = /\\(vssadmin|wmic|diskshadow|ntdsutil)\.exe$/  nocase
    (
      $vss.target.process.command_line = /shadow/ nocase or
      $vss.target.process.command_line = /shadowcopy/ nocase or
      $vss.target.process.command_line = /snapshot/ nocase or
      $vss.target.process.command_line = /create/ nocase
    )
    not $vss.principal.process.file.full_path in %global_allowed_backup_processes
    not $vss.principal.user.userid in %global_allowed_service_accounts
    $vss.principal.hostname = $dc_host

    // Stage 2: NTDS.dit file appears in a non-standard location (copied out of NTDS\)
    // A legitimate DC keeps NTDS.dit under %SystemRoot%\NTDS\ - a copy elsewhere is suspicious
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)ntds\.dit/
    not $file.target.file.full_path = /(?i)\\Windows\\NTDS\\ntds\.dit/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $dc_host

    // Chronological ordering: VSS operation must precede the file creation
    $vss.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $dc_host over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($dc_host)
    $vss_process = array_distinct($vss.target.process.file.full_path)
    $vss_commandline = array_distinct($vss.target.process.command_line)
    $ntds_copy_path = array_distinct($file.target.file.full_path)
    $initiating_user = array_distinct($vss.principal.user.userid)
    $file_creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $vss and $file
}
