/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:40:44.265615+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_006_Linux_Log_File_Truncation_Or_Zeroing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects truncation or zeroing of Linux system log files under /var/log/ by monitoring for FILE_MODIFICATION events that reduce a log file to zero or near-zero size, or direct writes to canonical log paths from unexpected processes. This targets the file-artifact layer rather than command-line invocation, providing coverage against attackers who clear logs via syscalls, scripts, or redirects that bypass process-creation logging."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM FILE_MODIFICATION events, including target.file.full_path and target.file.size. Auditd rules must watch /var/log/ with -w /var/log -p wa."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Log rotation daemons (logrotate, newsyslog) that truncate and recreate log files as part of scheduled rotation. Backup agents reading and rewriting log archives. Authorised log management tooling."
    tuning_guidance = "Add the full paths of approved log rotation or log management processes to %global_allowed_backup_processes. If logrotate runs under a predictable parent, exclude that parent path. Consider narrowing the file path regex to only the highest-value logs (auth.log, secure, wtmp) if noise is high."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target must be a canonical Linux system log file or directory
    $file.target.file.full_path = /^\/var\/log\// nocase

    // Match well-known sensitive log files by name pattern
    (
      $file.target.file.full_path = /\/(auth\.log|secure|messages|syslog|kern\.log|wtmp|btmp|utmp|lastlog|faillog|cron\.log|maillog|dpkg\.log|audit\/audit\.log|httpd\/access_log|httpd\/error_log|nginx\/access\.log|nginx\/error\.log)(\.?\d*)?$/ nocase
    )

    // File size at or near zero signals truncation/zeroing
    // Size 0 = classic truncation via > /var/log/auth.log or truncate -s 0
    $file.target.file.size <= 1024

    // Exclude approved backup and log rotation processes
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known log rotation binary paths
    not $file.principal.process.file.full_path = /\/(logrotate|newsyslog|rsyslog|syslog-ng|journald|systemd)(d)?$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_log_file = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
