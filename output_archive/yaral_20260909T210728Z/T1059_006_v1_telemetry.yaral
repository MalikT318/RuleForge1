/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:13:45.766662+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_Python_Script_Written_To_Suspicious_Path {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects Python script files (.py, .pyc, .pyo) or Python-related artifacts written to world-writable, temporary, or other suspicious directories on Linux. Adversaries frequently stage Python payloads in /tmp, /dev/shm, /var/tmp, or hidden dot-directories to evade command-line detection. This rule pivots on the file-creation artifact rather than process command-line arguments, providing coverage orthogonal to process-launch rules."
    mitre_tactic         = "Execution"
    mitre_technique      = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites    = "Requires Linux EDR or auditd file-creation telemetry normalised into Chronicle UDM FILE_CREATION events. Auditd rule: -a always,exit -F arch=b64 -S openat,open_by_handle_at -F a1&0100 -k python_write"
    platform             = "Linux"
    log_source           = "linux_endpoint"
    false_positives      = "Package managers (pip, conda, apt) installing Python packages; build systems compiling .pyc files; legitimate developer workflows writing scripts to /tmp during testing; CI/CD pipelines staging scripts transiently."
    tuning_guidance      = "Add known-good parent processes (pip, conda, ansible, puppet) to %global_allowed_admin_tools. Add authorised service accounts that deploy Python code to %global_allowed_service_accounts. Narrow scope by excluding specific subdirectories under /tmp used by approved build pipelines."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a Python script or bytecode artifact
    $file.target.file.full_path = /\.(py|pyc|pyo)$/ nocase

    // Written into a suspicious or world-writable location on Linux
    // Covers: /tmp, /var/tmp, /dev/shm, /run/shm, hidden dot-dirs anywhere,
    //         /proc/<pid>/fd staging, or any path component starting with a dot
    (
      $file.target.file.full_path = /^\/tmp\// nocase or
      $file.target.file.full_path = /^\/var\/tmp\// nocase or
      $file.target.file.full_path = /^\/dev\/shm\// nocase or
      $file.target.file.full_path = /^\/run\/shm\// nocase or
      $file.target.file.full_path = /^\/proc\// nocase or
      $file.target.file.full_path = /\/\.[^\/]+\// nocase or
      $file.target.file.full_path = /^\/var\/www\// nocase or
      $file.target.file.full_path = /^\/srv\// nocase
    )

    // Exclude known-good administrative and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service and automation accounts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_path      = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $actor_user        = array_distinct($file.principal.user.userid)

  condition:
    $file
}
