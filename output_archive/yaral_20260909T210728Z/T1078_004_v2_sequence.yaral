/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:21:46.172871+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_Cloud_Login_Then_Privilege_Escalation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud account login from an external (non-internal) source followed by a privilege or permissions change within 1 hour on the same user identity. This pattern is consistent with an adversary using a compromised cloud account to escalate privileges or establish persistence in an IaaS or identity provider environment."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires identity provider sign-in logs and directory audit logs normalised to UDM USER_LOGIN and USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION events. Suitable sources include Entra ID (Azure AD) sign-in and audit logs, Okta system logs, or equivalent IdP telemetry ingested into Chronicle."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate administrators performing planned privilege changes shortly after logging in. Automated provisioning pipelines using service accounts. On-call engineers responding to incidents. Scheduled identity governance workflows."
    tuning_guidance = "Add known automation and provisioning service accounts to %global_allowed_service_accounts. Add approved admin users who routinely perform privilege changes to %global_allowed_admin_users. Narrow the time window if false-positive volume is high in environments with frequent admin activity."

  events:
    // Event 1: Cloud account login from an external source
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = $cloud_user
    not $auth.principal.ip in %rfc1918_internal
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

    // Event 2: Privilege or permissions change on the same user identity
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $priv.principal.user.userid = $cloud_user
    not $priv.principal.user.userid in %global_allowed_service_accounts
    not $priv.principal.user.userid in %global_allowed_admin_users

    // Chronological ordering: login must precede the privilege change
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $cloud_user over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($cloud_user)
    $login_source_ips = array_distinct($auth.principal.ip)
    $privilege_change_targets = array_distinct($priv.target.user.userid)
    $login_count = count($auth.metadata.event_timestamp.seconds)
    $priv_change_count = count($priv.metadata.event_timestamp.seconds)

  condition:
    $auth and $priv
}
