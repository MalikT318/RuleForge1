/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:22:04.965370+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a non-system process opening a handle to lsass.exe with permissions consistent with memory reading (credential dumping). Attackers must request a process handle to read LSASS memory regardless of the tool used - this targets the OS-level state change rather than the command line, providing coverage that evades process-creation logging bypass."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised to UDM PROCESS_OPEN. The source must populate target.process.file.full_path with the opened process path and principal.process.file.full_path with the requesting process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents reading LSASS for tamper protection, authorised security tools, Windows Error Reporting (WerFault.exe), Task Manager opened by administrators, some backup agents."
    tuning_guidance = "Add legitimate security agent binaries to %global_allowed_security_tools. Add approved backup processes to %global_allowed_backup_processes. Consider scoping by principal.user.userid to exclude known service accounts via %global_allowed_service_accounts."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be lsass.exe - the credential store process
    $open.target.process.file.full_path = /(?i)\\lsass\.exe$/

    // The requesting process must NOT itself be lsass (self-handle) or the system idle process
    not $open.principal.process.file.full_path = /(?i)\\lsass\.exe$/
    not $open.principal.process.file.full_path = /(?i)\\system32\\werfault\.exe$/
    not $open.principal.process.file.full_path = /(?i)\\system32\\taskmgr\.exe$/

    // Exclude known-good security and backup tooling
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude approved service accounts performing legitimate operations
    not $open.principal.user.userid in %global_allowed_service_accounts

    // Requesting process must not reside in expected Windows system paths
    // (catches tools running from user-writable or temp locations)
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss][Yy][Ss][Tt][Ee][Mm]32\\/

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($open.principal.hostname)
    $requesting_process = array_distinct($open.principal.process.file.full_path)
    $requesting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
