/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:34:55.336179+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_DNS_Tunneling_High_Volume_Then_Long_Label {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects DNS-based C2 tunneling by correlating two network-observable signals on the same source host within a 5-minute window: (1) an anomalously high volume of DNS queries to a single domain (beaconing pattern), followed by (2) a DNS query containing an unusually long subdomain label (data exfiltration via DNS encoding). Both signals are sourced from firewall/perimeter DNS telemetry and require no endpoint process context."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Requires firewall or DNS resolver logs normalised to UDM NETWORK_DNS events. Fields required: principal.ip, network.dns.questions.name, metadata.event_timestamp."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "CDN-heavy applications performing many DNS lookups; legitimate software update services with long domain labels; internal DNS resolvers forwarding queries in bulk; vulnerability scanners."
    tuning_guidance = "Add known-good high-query domains (CDNs, update services) to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Raise the subdomain length threshold if legitimate internal tooling uses long labels."

  events:
    // Event 1: High-frequency DNS queries from a single internal source
    // to a non-internal domain - indicative of DNS beaconing.
    $beacon.metadata.event_type = "NETWORK_DNS"
    not $beacon.principal.ip in %rfc1918_internal
    not $beacon.network.dns.questions.name in %global_allowed_domains
    // Anchor on the queried apex-like domain segment to group beaconing bursts.
    // Capture the last two labels (e.g. evil.com) as the join key.
    re.regex($beacon.network.dns.questions.name, `^.+\.[a-z0-9\-]+\.[a-z]{2,}$`)
    $beacon.principal.ip = $src_ip

    // Event 2: DNS query with an excessively long subdomain label from the
    // same source - characteristic of data encoded into DNS query names.
    $tunnel.metadata.event_type = "NETWORK_DNS"
    not $tunnel.principal.ip in %rfc1918_internal
    not $tunnel.network.dns.questions.name in %global_allowed_domains
    // Long label heuristic: total query name exceeds 60 characters,
    // which is unusual for legitimate hostnames but common in DNS tunneling
    // where data is base32/base64-encoded into subdomains.
    re.regex($tunnel.network.dns.questions.name, `^[a-zA-Z0-9+/=_\-]{60,}\.`)
    $tunnel.principal.ip = $src_ip

    // Chronological ordering: beaconing burst precedes or coincides with
    // the long-label exfiltration query.
    $beacon.metadata.event_timestamp.seconds <= $tunnel.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($src_ip)
    $beacon_domains_queried = array_distinct($beacon.network.dns.questions.name)
    $tunnel_query_names = array_distinct($tunnel.network.dns.questions.name)
    $beacon_event_count = count($beacon.metadata.event_timestamp.seconds)

  condition:
    $beacon and $tunnel
}
