/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:38:40.623299+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Security_Tool_Config_Tamper_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file modification or creation of security tool configuration, status, or UI-facing files on Linux that could indicate an adversary spoofing or manipulating the apparent health state of a security agent. Attackers who disable an EDR or logging agent often overwrite its status socket, configuration, or reporting file to maintain the appearance of normal operation. This rule pivots on the resulting file artifact rather than the command line used to produce it."
    mitre_tactic    = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_MODIFICATION or FILE_CREATION events, including target.file.full_path and principal.process.file.full_path."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate security agent self-updates, package manager upgrades of security software (apt/yum/dnf/rpm), configuration management tools (Ansible, Puppet, Chef, Salt), and authorised admin scripts performing agent reconfiguration."
    tuning_guidance = "Add known-good parent processes (package managers, CM agents) to %global_allowed_admin_tools. Add authorised service accounts performing agent management to %global_allowed_service_accounts. Narrow the path regex if a specific agent path generates excessive noise."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target: configuration, status, socket, or UI-facing files belonging to
    // common Linux security agents (EDR, AV, logging, IDS, FIM agents).
    // Paths cover: CrowdStrike Falcon, OSSEC/Wazuh, auditd, osquery,
    // Sysdig Falco, Trend Micro, Sophos, ClamAV, AIDE, Tripwire, syslog-ng,
    // rsyslog, and generic /etc/security paths.
    $file.target.file.full_path = /(?i)(\/etc\/(crowdstrike|falcon|ossec|wazuh|auditd|osquery|falco|sophos|clamav|aide|tripwire|syslog-ng|rsyslog|security|audit)\b|\/opt\/(crowdstrike|falcon|ossec|wazuh|osquery|falco|sophos|trendmicro|cylance|carbonblack|sentinelone|sysdig)\b|\/var\/(ossec|wazuh|log\/audit|log\/clamav|log\/falco|log\/osquery)\b|\/run\/(crowdstrike|falcon|ossec|wazuh|osquery|falco|sophos)\b)/

    // The writing process is NOT the security agent itself and NOT a known
    // authorised admin tool or package manager.
    not $file.principal.process.file.full_path = /(?i)(\/usr\/(bin|sbin|local\/bin|local\/sbin)\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper|pacman|pip|pip3|ansible|puppet|chef|salt|saltstack|cfengine|chef-client|puppet-agent)\b|\/bin\/(rpm|dpkg)\b)/

    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude the security agent processes updating their own files
    // (self-signed writes from the agent binary directory).
    not $file.principal.process.file.full_path = /(?i)(\/opt\/(crowdstrike|falcon|ossec|wazuh|osquery|falco|sophos|trendmicro|cylance|carbonblack|sentinelone|sysdig)\/)/

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity    = array_distinct($file.principal.hostname)
    $modified_path     = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $writing_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
