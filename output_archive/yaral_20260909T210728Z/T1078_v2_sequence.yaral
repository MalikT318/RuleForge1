/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:19:16.610241+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_IaaS_Dormant_Account_Reactivation_Then_Privilege_Escalation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user account with no recent authentication activity successfully logging in, followed by privilege escalation actions within the same session. Indicates potential compromise of dormant or inactive accounts."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires identity provider authentication logs and cloud audit logs showing permission changes or role assignments."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Returning employees after extended leave, reactivated service accounts for legitimate projects, administrator account rotation activities."
    tuning_guidance = "Add known service accounts undergoing planned reactivation to %global_allowed_service_accounts. Adjust the dormancy threshold if your environment has different baseline activity patterns."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.security_result.summary = "SUCCESS" nocase
    $login.target.user.userid = $userid
    $login.principal.ip = $source_ip
    not $login.target.user.userid in %global_allowed_service_accounts
    not $login.target.user.userid in %global_allowed_cloud_principals

    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $priv.target.user.userid = $userid
    $priv.principal.ip = $source_ip
    (
      $priv.target.resource.attribute.labels.key = /role|permission|privilege|group/ nocase or
      $priv.security_result.summary = /grant|assign|elevate|add/ nocase
    )
    not $priv.principal.user.userid in %global_allowed_admin_users

    $login.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $userid, $source_ip over 1h

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($userid)
    $source_addresses = array_distinct($source_ip)
    $privilege_changes = count_distinct($priv.target.resource.name)
    $first_login_time = min($login.metadata.event_timestamp.seconds)
    $privilege_escalation_time = max($priv.metadata.event_timestamp.seconds)

  condition:
    $login and $priv
}
