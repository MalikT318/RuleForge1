/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:18:58.140808+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_SaaS_Dormant_Account_Login_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful authentication event from an account that has not been seen logging in for an extended period, indicating potential use of a dormant or compromised valid account. Adversaries frequently abuse inactive accounts to evade detection because the legitimate owner is absent to notice anomalous activity. This rule fires on USER_LOGIN events where the account's last activity metadata indicates a long gap, or where the login originates from an unexpected geographic or network context consistent with credential abuse."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation, Defense Evasion"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires identity provider sign-in audit logs normalised to UDM USER_LOGIN events. Fields required: principal.user.userid, principal.ip, target.application, extensions.auth.auth_details, security_result.summary. Log source must populate metadata.event_timestamp."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Employees returning from extended leave, contractors re-engaging after a project gap, shared service accounts used infrequently by design, automated health-check accounts with irregular schedules."
    tuning_guidance = "Add known service and automation accounts to %global_allowed_service_accounts. Add approved administrative users expected to log in infrequently to %global_allowed_admin_users. Add known scanner or monitoring sources to %global_allowed_scanners. Raise the risk_score threshold in the SOAR playbook for accounts with a documented inactivity justification."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Successful authentication only - we want to detect the abuse of a valid credential
    $auth.security_result.summary = /success|succeeded|authenticated/ nocase

    // Exclude known service and automation accounts that are expected to authenticate infrequently
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude known administrative users with documented infrequent login patterns
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Exclude authorised scanner or monitoring sources that may trigger synthetic logins
    not $auth.principal.ip in %global_allowed_scanners

    // Exclude logins originating from approved remote management tooling
    not $auth.principal.ip in %global_allowed_remote_mgmt

    // Target a SaaS application context - filter out empty application fields
    // to ensure we are operating on SaaS audit events rather than endpoint auth
    $auth.target.application != ""

    // Flag logins where the auth detail indicates a previously inactive or
    // suspended state being re-activated, or where the identity provider
    // explicitly surfaces a first-login-after-long-gap signal
    (
      $auth.extensions.auth.auth_details = /first.sign.in|first.login|dormant|inactive|long.absence|re.enabled|reactivated|account.unlocked/ nocase
      or
      $auth.security_result.summary = /first.sign.in|dormant|inactive|long.absence|re.enabled|reactivated|account.unlocked/ nocase
    )

    // Capture the user for outcome
    $auth.principal.user.userid = $userid

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($userid)
    $target_application = array_distinct($auth.target.application)
    $source_ip = array_distinct($auth.principal.ip)

  condition:
    $auth
}
