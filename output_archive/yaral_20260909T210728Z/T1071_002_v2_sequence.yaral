/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:33:40.069486+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_NetDev_FTP_Login_Then_Exfil_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a successful management-plane login to a network device followed within 5 minutes by an outbound FTP/TFTP flow to an external destination. Adversaries abuse file-transfer protocols for C2 by authenticating to a network device and then staging or exfiltrating data via FTP (TCP 21), FTPS (TCP 990), or TFTP (UDP 69). The correlation of an authenticated session with a subsequent file-transfer flow to a non-RFC1918 address is a strong indicator of abuse."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires network device syslog or management-plane authentication logs normalised to UDM USER_LOGIN, and firewall/flow telemetry normalised to UDM NETWORK_FLOW or NETWORK_CONNECTION. Both must share a common principal.hostname or principal.ip for the network device."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network engineers performing firmware upgrades via TFTP, scheduled configuration backups to external SFTP/FTP servers, vulnerability scanner activity from approved sources."
    tuning_guidance = "Add approved external FTP/TFTP destinations to %global_allowed_domains. Add authorised management source addresses to %global_allowed_mgmt_sources. Add service accounts used for automated backups to %global_allowed_service_accounts."

  events:
    // Event 1: Successful login to the network device management plane
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $device_hostname
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Event 2: Outbound file-transfer protocol flow originating from the same device
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $device_hostname
    (
      $flow.target.port = 21 or
      $flow.target.port = 20 or
      $flow.target.port = 69 or
      $flow.target.port = 990 or
      $flow.target.port = 989
    )
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.hostname in %global_allowed_domains

    // Chronological ordering: login precedes the file-transfer flow
    $auth.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($device_hostname)
    $authenticated_user = array_distinct($auth.target.user.userid)
    $auth_source_ip = array_distinct($auth.principal.ip)
    $ftp_destination_ip = array_distinct($flow.target.ip)
    $ftp_destination_port = array_distinct($flow.target.port)
    $bytes_transferred = max($flow.network.sent_bytes)

  condition:
    $auth and $flow
}
