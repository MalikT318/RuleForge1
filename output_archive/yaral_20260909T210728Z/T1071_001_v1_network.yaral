/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:32:55.934093+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_CnC_Web_Protocol_Suspicious_Outbound_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network-observable indicators of C2 over web protocols from firewall/proxy telemetry. Looks for outbound HTTP/HTTPS connections on non-standard web ports, connections to rare or newly-seen external destinations, or anomalous user-agent strings that may indicate beaconing or C2 tunnelling over HTTP/S. Excludes internal address space and known-good domains."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires firewall, proxy, or perimeter network logs normalised to Chronicle UDM NETWORK_HTTP or NETWORK_CONNECTION events. User-agent and URL fields should be populated by the proxy/NGFW for best fidelity."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Custom enterprise applications using non-standard ports for HTTPS, IoT or OT devices with unusual user-agents, legitimate software update mechanisms, developer tools making direct HTTP calls on alternate ports."
    tuning_guidance = "Add approved external destinations to %global_allowed_domains. Add approved scanner or monitoring source IPs to %global_allowed_scanners. Narrow the non-standard port list if specific business applications are generating noise. Consider raising severity if combined with threat-intel enrichment on the destination."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Exclude internal-to-internal traffic; C2 callbacks go outbound
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external domains (CDNs, update services, vendors)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanners
    not $net.principal.ip in %global_allowed_scanners

    // Detect HTTP/HTTPS on non-standard ports - a common C2 evasion technique
    // Standard web ports (80, 443, 8080, 8443) are excluded; anything else is suspicious
    // We match ports that are NOT the four common web ports
    (
      $net.target.port != 80 and
      $net.target.port != 443 and
      $net.target.port != 8080 and
      $net.target.port != 8443
    )

    // Require the application protocol to be HTTP-family to avoid matching
    // unrelated high-port traffic; many NGFWs/proxies populate network.application_protocol
    $net.network.application_protocol = "HTTP"

    // Suspicious or generic user-agent patterns commonly used by C2 frameworks
    // Matches blank/missing UA, curl, python, go-http, or very short UA strings
    // that are atypical of browser-originated traffic
    $net.network.http.user_agent = /(?i)(^$|curl\/|python-|go-http-client|libwww|lwp-|java\/|wget\/|powershell|winhttp|microsoft-cryptoapi)/ nocase

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $user_agent_observed = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
