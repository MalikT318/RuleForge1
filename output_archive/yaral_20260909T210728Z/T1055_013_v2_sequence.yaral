/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:08:25.690117+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Doppelganging_Hollow_Process_Then_Network {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a potential Process Doppelganging pattern: a legitimate Windows host process (e.g. svchost, lsass, explorer) is opened by an unusual parent (PROCESS_OPEN with cross-process handle), followed shortly by an outbound network connection originating from that same host process on the same endpoint. TxF-based doppelganging replaces the image of a legitimate process in memory; the resulting process then communicates externally. This rule provides additive coverage beyond command-line detection by correlating handle-open telemetry with subsequent network activity."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelganging"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_OPEN events (cross-process handle acquisition) and NETWORK_CONNECTION events with process context. Sysmon Event ID 10 (ProcessAccess) and Event ID 3 (NetworkConnect) satisfy this requirement when normalised to UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Security tooling (EDR agents, AV) legitimately opens handles to system processes. Authorised remote management software may open handles and then connect externally. Windows Update and WMI infrastructure may exhibit similar patterns."
    tuning_guidance = "Add known-good security and management tool paths to %global_allowed_security_tools and %global_allowed_remote_mgmt. Scope the network filter further by restricting to specific target ports (e.g. 443, 80, 8080) if noise is high. Consider adding internal subnets to %rfc1918_internal exclusions."

  events:
    // Event 1: A non-system process opens a handle to a canonical Windows host process.
    // This is the cross-process handle acquisition step characteristic of process injection
    // techniques including doppelganging, hollowing, and similar TxF-abuse methods.
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener (principal) must NOT itself be a known system binary - flag unusual parents.
    // Legitimate system processes opening each other is normal; a non-system binary doing so is suspicious.
    not $open.principal.process.file.full_path = /(?i)\\(svchost|lsass|csrss|wininit|services|smss|winlogon|explorer|spoolsv|taskhostw|sihost|fontdrvhost|dwm|audiodg|SearchIndexer|MsMpEng|NisSrv|SecurityHealthService)\.exe$/
    not $open.principal.process.file.full_path = /(?i)^C:\\Windows\\(System32|SysWOW64|WinSxS)\\/
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

    // The target (victim) process IS a canonical Windows host process - these are the
    // processes whose image doppelganging replaces.
    $open.target.process.file.full_path = /(?i)\\(svchost|lsass|explorer|RuntimeBroker|dllhost|taskhost|taskhostw|conhost|werfault|WerFaultSecure|spoolsv|msiexec|regsvr32|rundll32|wscript|cscript|mshta|wmic)\.exe$/

    // Bind the hostname for the join.
    $open.principal.hostname = $hostname

    // Event 2: The canonical Windows host process (now potentially doppelganged) makes
    // an outbound network connection to an external (non-RFC1918) destination.
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // The connecting process is the same class of host process that was targeted above.
    $net.principal.process.file.full_path = /(?i)\\(svchost|lsass|explorer|RuntimeBroker|dllhost|taskhost|taskhostw|conhost|werfault|WerFaultSecure|spoolsv|msiexec|regsvr32|rundll32|wscript|cscript|mshta|wmic)\.exe$/

    // Exclude internal destinations - doppelganged processes typically beacon externally.
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good domains and management sources.
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

    $net.principal.hostname = $hostname

    // Enforce chronological ordering: handle open must precede the network connection.
    $open.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(90)
    $mitre_technique_id  = array_distinct("T1055.013")
    $primary_entity      = array_distinct($hostname)
    $opener_process      = array_distinct($open.principal.process.file.full_path)
    $targeted_process    = array_distinct($open.target.process.file.full_path)
    $destination_ips     = array_distinct($net.target.ip)
    $destination_hosts   = array_distinct($net.target.hostname)
    $destination_ports   = array_distinct($net.target.port)
    $connecting_process  = array_distinct($net.principal.process.file.full_path)

  condition:
    $open and $net
}
