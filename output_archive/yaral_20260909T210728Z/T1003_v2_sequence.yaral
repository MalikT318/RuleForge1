/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:22:24.523189+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_Linux_CredDump_ProcMem_Then_StagedFile {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage Linux credential dumping pattern: a process opens /proc/<pid>/mem or /proc/<pid>/maps (memory scraping) followed within 10 minutes by creation of a file in a world-writable staging directory on the same host. This sequence is characteristic of in-memory credential extraction tools that dump scraped material to disk for exfiltration, without relying on command-line string matching."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. Auditd rules must capture openat/open syscalls on /proc filesystem paths and file creation events. EDR must emit FILE_READ and FILE_CREATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace) reading /proc/<pid>/mem during authorised debugging sessions. Security scanners and EDR agents inspecting process memory. Java/JVM diagnostics writing heap dumps to /tmp. Performance profilers (perf, valgrind). Crash dump collectors writing to /tmp or /var/tmp."
    tuning_guidance = "Add authorised debugger and profiler parent process paths to %global_allowed_security_tools. Add approved backup or diagnostic processes to %global_allowed_backup_processes. Narrow the staging-file path regex if your environment uses /tmp legitimately at high volume. Consider adding a minimum file size threshold if your EDR populates file size fields reliably."

  events:
    // Event 1: Process reads from /proc/<pid>/mem or /proc/<pid>/maps
    // This is the memory-scraping phase of credential dumping.
    $mem.metadata.event_type = "FILE_READ"
    $mem.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|environ|status)$/
    not $mem.principal.process.file.full_path in %global_allowed_security_tools
    not $mem.principal.process.file.full_path in %global_allowed_backup_processes
    $mem.principal.hostname = $hostname

    // Event 2: File creation in a world-writable or temporary staging directory
    // on the same host, after the memory read - the dump-to-disk phase.
    $stage.metadata.event_type = "FILE_CREATION"
    $stage.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm)\//
    not $stage.principal.process.file.full_path in %global_allowed_security_tools
    not $stage.principal.process.file.full_path in %global_allowed_backup_processes
    $stage.principal.hostname = $hostname

    // Chronological ordering: memory read must precede the staged file creation
    $mem.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($mem.principal.hostname)
    $scraping_process = array_distinct($mem.principal.process.file.full_path)
    $proc_mem_paths_read = array_distinct($mem.target.file.full_path)
    $staged_file_paths = array_distinct($stage.target.file.full_path)
    $staging_process = array_distinct($stage.principal.process.file.full_path)
    $affected_user = array_distinct($mem.principal.user.userid)

  condition:
    $mem and $stage
}
