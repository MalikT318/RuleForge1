/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:28:25.168731+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Cloud_Secret_Access_Then_Exfil_Attempt {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud identity accessing secrets/credentials from a managed secrets store (e.g., AWS Secrets Manager, Azure Key Vault, GCP Secret Manager) followed by an attempt to access or enumerate additional resources within the same time window. This two-stage pattern is consistent with credential harvesting from cloud password stores, where an adversary first retrieves stored secrets and then pivots to use or enumerate further resources."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM. AWS CloudTrail (GetSecretValue, DescribeSecret), Azure Activity (Key Vault secret GET), or GCP Audit (accessSecretVersion) events must be ingested. A second USER_RESOURCE_ACCESS event from the same principal is required for correlation."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate application deployments retrieving secrets at startup, CI/CD pipelines, secrets rotation automation, and authorised DevOps tooling. Service accounts performing scheduled secret retrieval will also match."
    tuning_guidance = "Add known automation and deployment service principals to %global_allowed_cloud_principals. Add known scanner or security-tooling principals to %global_allowed_security_tools. Narrow the second event filter to specific high-value resource types if noise is high."

  events:
    // Event 1: Principal accesses a secret or credential from a cloud secrets store.
    // UDM target.resource.name or target.resource.resource_type will reflect
    // secrets-manager / key-vault / secret-version nomenclature after normalisation.
    $secret.metadata.event_type = "USER_RESOURCE_ACCESS"
    $secret.target.resource.resource_type = /(?i)(secret|vault|credential|key)/
    (
        $secret.target.resource.name = /(?i)(secret|password|credential|key|token|cert)/ or
        $secret.metadata.description = /(?i)(GetSecretValue|accessSecretVersion|SecretGet|getSecret|KeyVaultSecret)/
    )
    not $secret.principal.user.userid in %global_allowed_cloud_principals
    not $secret.principal.user.userid in %global_allowed_service_accounts
    $secret.principal.user.userid = $cloud_principal

    // Event 2: Same principal accesses additional cloud resources shortly after,
    // suggesting use or enumeration of the harvested credentials.
    $pivot.metadata.event_type = "USER_RESOURCE_ACCESS"
    not $pivot.target.resource.resource_type = /(?i)(secret|vault|credential|key)/
    not $pivot.principal.user.userid in %global_allowed_cloud_principals
    not $pivot.principal.user.userid in %global_allowed_service_accounts
    $pivot.principal.user.userid = $cloud_principal

    // Enforce chronological ordering: secret access must precede the pivot.
    $secret.metadata.event_timestamp.seconds <= $pivot.metadata.event_timestamp.seconds

  match:
    $cloud_principal over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($cloud_principal)
    $secret_resources_accessed = array_distinct($secret.target.resource.name)
    $pivot_resources_accessed = array_distinct($pivot.target.resource.name)
    $pivot_resource_types = array_distinct($pivot.target.resource.resource_type)
    $source_ips = array_distinct($secret.principal.ip)

  condition:
    $secret and $pivot
}
