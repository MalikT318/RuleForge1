/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:20:29.228155+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_ESXi_Domain_Account_Login_Then_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a domain account authenticating to an ESXi host followed by a host-level setting or configuration change within one hour. Domain accounts performing ESXi management-plane changes are unusual and may indicate credential abuse, lateral movement, or persistence via a compromised privileged account."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires ESXi hostd and shell authentication logs normalised to UDM USER_LOGIN and SETTING_MODIFICATION event types via the vmware_esxi log source."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised vSphere administrators using domain credentials for scheduled maintenance. Automated orchestration pipelines (vCenter, Ansible, Terraform) authenticating with domain service accounts. Patch management workflows."
    tuning_guidance = "Add known automation and orchestration service account identifiers to %global_allowed_service_accounts. Add approved management source IPs to %global_allowed_mgmt_sources to suppress expected management-plane activity."

  events:
    // Event 1: Domain account login to ESXi host
    $auth.metadata.event_type = "USER_LOGIN"
    // Domain accounts appear as DOMAIN\user or user@domain - match the separator
    $auth.target.user.userid = /[@\\]/
    // Exclude known-good service accounts
    not $auth.target.user.userid in %global_allowed_service_accounts
    // Exclude approved management sources
    not $auth.principal.ip in %global_allowed_mgmt_sources
    $auth.target.hostname = $esxi_host

    // Event 2: Host-level configuration or setting change on the same ESXi host
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.ip in %global_allowed_mgmt_sources
    $cfg.target.hostname = $esxi_host

    // Enforce chronological ordering: login precedes config change
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $esxi_host over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($esxi_host)
    $domain_accounts_seen = array_distinct($auth.target.user.userid)
    $config_actors = array_distinct($cfg.principal.user.userid)
    $auth_source_ips = array_distinct($auth.principal.ip)
    $cfg_source_ips = array_distinct($cfg.principal.ip)
    $login_count = count($auth.metadata.event_timestamp.seconds)
    $cfg_change_count = count($cfg.metadata.event_timestamp.seconds)

  condition:
    $auth and $cfg
}
