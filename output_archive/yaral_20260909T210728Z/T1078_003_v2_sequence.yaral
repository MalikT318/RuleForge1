/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:21:09.220977+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Local_Account_Created_Then_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a new local user account created on a Linux host followed by an interactive or remote login from that same account within one hour. This sequence indicates potential abuse of a freshly provisioned local account for persistence or privilege escalation."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM. FILE_MODIFICATION events for /etc/passwd or /etc/shadow, and USER_LOGIN events with principal.user.userid populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Automated provisioning pipelines, configuration management tools (Ansible, Puppet, Chef), cloud-init on first boot, legitimate sysadmin account creation followed by immediate testing."
    tuning_guidance = "Add provisioning service accounts to %global_allowed_service_accounts. Add authorised management sources to %global_allowed_mgmt_sources. Narrow the rule to non-business hours if provisioning is scheduled."

  events:
    // Event 1: local account database modified - new account written to /etc/passwd or /etc/shadow
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(passwd|shadow|gshadow|group)$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Event 2: interactive or remote login succeeds on the same host
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Chronological ordering: account file modified before login occurs
    $file.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)
    $login_user = array_distinct($auth.principal.user.userid)
    $login_source_ip = array_distinct($auth.principal.ip)
    $login_count = count($auth.metadata.event_timestamp.seconds)

  condition:
    $file and $auth
}
