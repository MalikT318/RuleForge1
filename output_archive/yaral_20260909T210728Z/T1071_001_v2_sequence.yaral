/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:33:11.570950+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Beaconing_HTTP_Pattern_From_Linux_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects periodic HTTP/S connections from a Linux host to the same external destination with consistent timing intervals, indicative of C2 beaconing behavior."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires firewall or proxy logs with HTTP/S connection metadata and timestamps."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Monitoring agents, update services, cloud sync clients, scheduled health checks, API polling applications."
    tuning_guidance = "Add known monitoring endpoints to %global_allowed_domains or approved service IPs to a custom exclusion list."

  events:
    $conn1.metadata.event_type = "NETWORK_HTTP"
    $conn1.principal.hostname = /^(?!.*\.windows\.|.*win-|.*dc-).*/ nocase
    not $conn1.target.ip in %rfc1918_internal
    $conn1.target.port = 80 or $conn1.target.port = 443 or $conn1.target.port = 8080 or $conn1.target.port = 8443
    not $conn1.target.hostname in %global_allowed_domains
    $conn1.principal.hostname = $hostname
    $conn1.target.ip = $dest_ip

    $conn2.metadata.event_type = "NETWORK_HTTP"
    $conn2.principal.hostname = /^(?!.*\.windows\.|.*win-|.*dc-).*/ nocase
    not $conn2.target.ip in %rfc1918_internal
    $conn2.target.port = 80 or $conn2.target.port = 443 or $conn2.target.port = 8080 or $conn2.target.port = 8443
    not $conn2.target.hostname in %global_allowed_domains
    $conn2.principal.hostname = $hostname
    $conn2.target.ip = $dest_ip

    $conn1.metadata.event_timestamp.seconds < $conn2.metadata.event_timestamp.seconds

  match:
    $hostname, $dest_ip over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($hostname)
    $destination_ips = array_distinct($dest_ip)
    $connection_count = count_distinct($conn1.metadata.event_timestamp.seconds, $conn2.metadata.event_timestamp.seconds)
    $ports_contacted = array_distinct($conn1.target.port, $conn2.target.port)

  condition:
    $conn1 and $conn2 and #conn1 >= 3 and #conn2 >= 3
}
