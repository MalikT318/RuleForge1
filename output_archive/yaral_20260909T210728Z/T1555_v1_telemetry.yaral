/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:28:05.556148+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Password_Store_File_Read_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read or open access to common Linux password store locations (browser credential databases, password manager vaults, SSH private keys, GPG keyrings, credential helper configs, and application secret stores) by processes outside of expected security tooling. Targets the file-access artifact rather than command-line invocation to catch evasion via renamed or obfuscated binaries."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires Linux EDR or auditd with file open/read syscall auditing (auditd rules on -a always,exit -F arch=b64 -S open,openat -F exit=-EACCES or equivalent EDR file telemetry). UDM event type FILE_READ or FILE_CREATION must be populated by the normalisation layer."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup agents reading home directories, password manager applications accessing their own vaults, SSH clients reading their own key files, legitimate secret scanning tools, developer IDEs with credential helpers, CI/CD pipeline agents."
    tuning_guidance = "Add backup and security agent process paths to %global_allowed_backup_processes and %global_allowed_security_tools. Add approved automation accounts to %global_allowed_service_accounts. Narrow scope by also filtering on principal.user.userid if specific service accounts are noisy."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target: common Linux password store file paths
    // Browser credential databases
    (
      $file.target.file.full_path = /\/\.config\/google-chrome\/[^\/]+\/Login Data$/ nocase or
      $file.target.file.full_path = /\/\.config\/chromium\/[^\/]+\/Login Data$/ nocase or
      $file.target.file.full_path = /\/\.mozilla\/firefox\/[^\/]+\/logins\.json$/ nocase or
      $file.target.file.full_path = /\/\.mozilla\/firefox\/[^\/]+\/key[34]\.db$/ nocase or
      $file.target.file.full_path = /\/snap\/chromium\/[^\/]+\/\.config\/chromium\/[^\/]+\/Login Data$/ nocase or

      // Password manager vaults
      $file.target.file.full_path = /\/\.password-store\// nocase or
      $file.target.file.full_path = /\/\.gnupg\/private-keys-v1\.d\// nocase or
      $file.target.file.full_path = /\/\.gnupg\/secring\.gpg$/ nocase or
      $file.target.file.full_path = /\/\.local\/share\/keyrings\// nocase or
      $file.target.file.full_path = /\/\.config\/keepassxc\// nocase or
      $file.target.file.full_path = /\/\.keepass\// nocase or

      // SSH private keys
      $file.target.file.full_path = /\/\.ssh\/id_(rsa|dsa|ecdsa|ed25519|xmss)$/ nocase or
      $file.target.file.full_path = /\/\.ssh\/id_(rsa|dsa|ecdsa|ed25519|xmss)_[^\/]+$/ nocase or

      // Git credential helpers and stored tokens
      $file.target.file.full_path = /\/\.git-credentials$/ nocase or
      $file.target.file.full_path = /\/\.netrc$/ nocase or

      // AWS, GCP, Azure CLI credential files
      $file.target.file.full_path = /\/\.aws\/credentials$/ nocase or
      $file.target.file.full_path = /\/\.config\/gcloud\/credentials\.db$/ nocase or
      $file.target.file.full_path = /\/\.config\/gcloud\/legacy_credentials\// nocase or
      $file.target.file.full_path = /\/\.azure\/accessTokens\.json$/ nocase or
      $file.target.file.full_path = /\/\.azure\/msal_token_cache\.json$/ nocase or

      // Docker and container registry credentials
      $file.target.file.full_path = /\/\.docker\/config\.json$/ nocase or

      // System-level credential stores
      $file.target.file.full_path = /\/etc\/shadow$/ nocase or
      $file.target.file.full_path = /\/etc\/gshadow$/ nocase or
      $file.target.file.full_path = /\/var\/lib\/extrausers\/shadow$/ nocase
    )

    // Exclude processes that legitimately access these files
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $credential_file_accessed = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
