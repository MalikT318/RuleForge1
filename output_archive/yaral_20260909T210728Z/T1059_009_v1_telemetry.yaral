/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:15:45.251442+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_CloudAPI_ServicePrincipal_Anomalous_Resource_Access {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a non-interactive service principal or application identity accessing cloud resources in a pattern consistent with programmatic Cloud API abuse. Adversaries with stolen application tokens or OAuth credentials may invoke cloud APIs to enumerate or modify tenant resources without triggering interactive sign-in alerts. This rule pivots on the USER_RESOURCE_ACCESS audit event produced by identity provider logs when an application or service principal performs resource operations, filtering for non-human actor types and suspicious resource categories (IAM, compute, storage, security policies) that are high-value Cloud API targets."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires identity provider audit logs (e.g. Entra ID, Okta) normalised to Chronicle UDM. USER_RESOURCE_ACCESS events must include principal.user.user_display_name or principal.user.userid, target.resource.name, and target.application fields. Service principal / application actor type must be populated."
    platform        = "SaaS"
    log_source      = "identity"
    false_positives = "Legitimate automation pipelines, CI/CD service principals, backup agents, and monitoring tools that use application identities to access cloud resources. Approved service accounts should be added to %global_allowed_service_accounts and approved cloud principals to %global_allowed_cloud_principals."
    tuning_guidance = "Add known-good automation service principal identifiers to %global_allowed_service_accounts and %global_allowed_cloud_principals. Narrow the target.resource.type regex to the specific resource categories relevant to each client environment. Raise risk_score for principals that have never previously accessed the matched resource type."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Actor must be a non-interactive application or service principal identity.
    // Identity providers surface these with characteristic suffixes or type markers
    // in the userid or display name field. Match common patterns across Entra ID and Okta.
    (
      $cloud.principal.user.userid = /(?i)@.*\.onmicrosoft\.com$/ or
      $cloud.principal.user.user_display_name = /(?i)(service.?principal|app.?registration|managed.?identity|automation|pipeline|ci.?cd|daemon|svc[-_]|bot[-_])/ or
      $cloud.principal.user.attribute.roles = /(?i)(application|service.?principal|workload.?identity)/
    )

    // Target must be a high-value cloud resource category commonly abused via Cloud APIs:
    // IAM/directory objects, compute instances, storage, network, or security configuration.
    $cloud.target.resource.name = /(?i)(role.?assign|policy|permission|group|member|compute|vm|instance|storage|blob|bucket|secret|keyvault|key.?vault|network|firewall|security.?group|subscription|tenant|directory|application|credential|certificate)/

    // Exclude known-good automation service accounts and approved cloud principals.
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known internal scanner or security tooling identities.
    not $cloud.principal.user.user_display_name in %global_allowed_security_tools

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $target_application = array_distinct($cloud.target.application)
    $source_ip         = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
