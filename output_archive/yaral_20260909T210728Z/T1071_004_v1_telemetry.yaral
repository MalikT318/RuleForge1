/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:34:33.555158+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_ESXi_DNS_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi DNS configuration files or network resolver settings that may indicate an adversary redirecting DNS resolution to attacker-controlled infrastructure for DNS tunneling or C2 over DNS. Targets the file artifact produced by DNS configuration tampering rather than the command line used to make the change."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Requires ESXi shell/hostd file activity telemetry normalised into Chronicle UDM. File creation and modification events must be forwarded from the ESXi host via syslog or an agent capable of capturing hostd/shell activity."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate administrator changes to DNS resolver configuration during host provisioning, network reconfiguration, or planned maintenance. Automated configuration management tools (Ansible, vSphere Lifecycle Manager) may also write these files."
    tuning_guidance = "Add authorised configuration management service accounts to %global_allowed_service_accounts. Add approved administrative hosts to %global_allowed_mgmt_sources. Scope alerts to changes outside approved maintenance windows using timestamp.get_hour() if your environment has predictable change windows."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // ESXi DNS resolver and network configuration files that control name resolution.
    // Modification of these files is the state change produced by DNS tunneling setup
    // or C2 infrastructure redirection - harder to evade than command-line logging.
    re.regex($file.target.file.full_path, `/etc/(resolv\.conf|hosts|nsswitch\.conf|vmware/netconfig|vmware/esx\.conf)$`) nocase

    // Exclude the ESXi kernel and hostd themselves performing routine writes
    // during normal boot or scheduled config sync operations.
    not $file.principal.process.file.full_path = /\/bin\/hostd/ nocase
    not $file.principal.process.file.full_path = /\/sbin\/hostd/ nocase

    // Exclude known-good service accounts performing authorised configuration management.
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude authorised administrative tooling (e.g. vSphere Lifecycle Manager agents).
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
