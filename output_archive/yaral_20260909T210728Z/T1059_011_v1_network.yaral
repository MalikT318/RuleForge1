/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:17:05.459688+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Execution_Network_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound network connections to non-internal destinations on ports commonly used by Lua-based malware for C2 or data exfiltration. Lua interpreters embedded in malicious tools frequently initiate direct TCP connections to external hosts on uncommon high ports or well-known ports (HTTP/HTTPS/DNS) from hosts where such outbound patterns are anomalous. This rule provides network-side coverage complementary to existing Lua process-launch detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires firewall or perimeter network flow logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Source IP must be resolvable to an internal Windows host."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Game engines and embedded applications (e.g., World of Warcraft, Redis, Wireshark) that legitimately use Lua and make outbound connections. Authorised security tooling with embedded Lua scripting. Vulnerability scanners originating from approved scanner addresses."
    tuning_guidance = "Add approved scanner source IPs to %global_allowed_scanners. Add known-good external update or CDN domains to %global_allowed_domains. Add approved remote management source addresses to %global_allowed_remote_mgmt. Narrow the port set if your environment has a known-good baseline for high-port egress."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Traffic must originate from an internal host (principal) going outward
    not $net.principal.ip in %rfc1918_internal

    // Destination must be external (not RFC1918)
    not $net.target.ip in %rfc1918_internal

    // Exclude approved scanner sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved remote management sources
    not $net.principal.ip in %global_allowed_remote_mgmt

    // Focus on ports characteristic of Lua C2 patterns observed in the wild:
    // PoetRat used port 8080; EvilBunny and Sunseed variants used 443/80 with
    // non-standard TLS SNI or direct-IP connections; high ephemeral ports used
    // for custom Lua socket C2. We flag direct-IP connections (no hostname) on
    // HTTP/HTTPS/high ports as the network-observable signal.
    (
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 4444 or
      $net.target.port = 1337 or
      $net.target.port = 9999 or
      $net.target.port = 6666 or
      $net.target.port = 7777
    )

    // The distinguishing network signal: connection to a bare external IP
    // (no resolved hostname), which is typical of Lua socket library usage
    // where the script hard-codes an IP rather than a domain. Legitimate
    // enterprise software almost always connects to a hostname.
    $net.target.hostname = ""

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
