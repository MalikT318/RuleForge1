/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:47:26.707782+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_Mail_Protocol_C2_Network_Outbound {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects outbound connections to non-standard or external mail protocol ports (SMTP, SMTPS, POP3, POP3S, IMAP, IMAPS) from internal hosts to external destinations. Adversaries abuse mail protocols for C2 by blending malicious traffic with legitimate email flows. Firewall/perimeter telemetry is used; no endpoint process context is required."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires firewall, perimeter, or proxy flow logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events with destination port populated."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate mail clients or servers sending email to external MX hosts; marketing automation platforms; CI/CD pipelines with email notification; mail relay appliances."
    tuning_guidance = "Add known-good external mail relay IPs or CIDRs to %approved_external_mail_destinations. Add internal mail gateway IPs to %internal_mail_gateways to suppress authorised relay traffic. Narrow the port list if your environment does not use all mail protocol variants."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match standard and alternate mail protocol ports
    // SMTP=25, Submission=587, SMTPS=465, POP3=110, POP3S=995, IMAP=143, IMAPS=993
    (
      $net.target.port = 25  or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 110 or
      $net.target.port = 995 or
      $net.target.port = 143 or
      $net.target.port = 993
    )

    // Destination must be external (not RFC-1918 / internal space)
    not $net.target.ip in %rfc1918_internal

    // Exclude approved external mail relays and known-good MX infrastructure
    not $net.target.ip in %approved_external_mail_destinations

    // Exclude traffic originating from authorised internal mail gateways
    // (those are expected to send outbound mail)
    not $net.principal.ip in %internal_mail_gateways

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
