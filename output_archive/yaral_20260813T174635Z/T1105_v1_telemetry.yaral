/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:49:33.220278+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_ESXi_Ingress_Tool_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation events on ESXi hosts in locations commonly abused for staging ingress tool transfers: writable directories outside normal datastore paths such as /tmp, /var/run, /scratch, and home directories. Adversaries transferring tools via wget, curl, scp, or sftp produce a FILE_CREATION artifact regardless of how command-line logging is configured. This rule pivots on the resulting file artifact rather than the process invocation, providing coverage orthogonal to process-launch detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires ESXi file-system telemetry forwarded to Chronicle via hostd or shell audit logging. FILE_CREATION events must be normalised into UDM by the ESXi/syslog ingestion pipeline."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate administrator file transfers for patching or VIB installation, automated backup agents writing to scratch space, VMware Tools updates writing to /tmp."
    tuning_guidance = "Add known-good parent process paths (e.g., vmware-install, esxcli) to %esxi_allowed_file_writers. Add approved staging directories to %esxi_approved_staging_paths. Narrow the file extension regex to exclude .log and .vmdk if noise is high."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target writable ESXi directories commonly used for tool staging.
    // Excludes normal datastore paths (/vmfs/volumes) to reduce noise from
    // legitimate VM disk and snapshot operations.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/run\/|\/var\/tmp\/|\/scratch\/|\/store\/|\/root\/|\/home\/[^\/]+\/)/ nocase

    // Exclude obviously benign extensions: logs, vmdk, vmx, nvram, vmsd, vswp.
    // Focus on executable, archive, and script artifacts indicative of tool staging.
    not $file.target.file.full_path = /\.(log|vmdk|vmx|nvram|vmsd|vswp|lck)$/ nocase

    // Flag file types commonly transferred as tools or payloads:
    // ELF binaries (no extension), shell scripts, Python scripts, archives,
    // and generic binary blobs.
    $file.target.file.full_path = /(\.(sh|py|pl|rb|tar|gz|tgz|zip|bz2|xz|elf|bin|run|so|out)$|\/[^\/\.]+$)/ nocase

    // Exclude known-good file writers (patch agents, authorised admin tools).
    not $file.principal.process.file.full_path in %esxi_allowed_file_writers

    // Exclude known-good staging paths approved per-client.
    not $file.target.file.full_path in %esxi_approved_staging_paths

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $target_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
