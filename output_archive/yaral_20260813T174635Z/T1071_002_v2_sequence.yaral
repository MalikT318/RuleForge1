/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:47:10.846609+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_NetDev_FTP_Login_Then_Outbound_Transfer {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a successful management-plane or data-plane login to a network device followed within 5 minutes by an outbound FTP/TFTP/FTPS flow to an external destination. Adversaries abuse file-transfer protocols for C2 by blending into legitimate transfer traffic; this correlation catches the login-then-exfil pattern observable in firewall and flow telemetry without relying on endpoint process data."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires firewall or perimeter flow logs that record USER_LOGIN events (AAA/TACACS/RADIUS accepted) and NETWORK_FLOW or NETWORK_CONNECTION records with destination port and byte counts. Both event types must be normalised to Chronicle UDM."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Scheduled configuration backups via TFTP/FTP to authorised jump hosts, automated firmware upgrade workflows, network management systems polling devices, and legitimate file-transfer appliances. Add known management hosts to %allowed_mgmt_transfer_hosts and known internal ranges to %rfc1918_internal."
    tuning_guidance = "Populate %allowed_mgmt_transfer_hosts with authorised backup/NMS server IPs. Raise the minimum byte threshold in the flow filter if low-volume polling triggers false positives. Narrow the login event filter to specific device roles (e.g. core routers) if noise is high from access-layer devices."

  events:
    // --- Leg 1: Successful login to the network device management plane ---
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $device_hostname
    // Only accepted/successful logins; reject noise from failed attempts
    $auth.security_result.action = "ALLOW"
    not $auth.principal.ip in %rfc1918_internal

    // --- Leg 2: Outbound file-transfer protocol flow originating from the same device ---
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $device_hostname
    // FTP control (21), FTP data (20), TFTP (69 UDP), FTPS explicit (21), FTPS implicit (990)
    (
      $flow.target.port = 21  or
      $flow.target.port = 20  or
      $flow.target.port = 69  or
      $flow.target.port = 990
    )
    // Destination must be external (not a known internal management host)
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.ip in %allowed_mgmt_transfer_hosts
    // Require a non-trivial byte count to exclude empty control-channel probes
    $flow.network.sent_bytes > 1024

    // Chronological ordering: login must precede the outbound transfer
    $auth.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1071.002")
    $primary_entity      = array_distinct($device_hostname)
    $login_source_ips    = array_distinct($auth.principal.ip)
    $transfer_dest_ips   = array_distinct($flow.target.ip)
    $transfer_dest_ports = array_distinct($flow.target.port)
    $total_bytes_sent    = max($flow.network.sent_bytes)
    $login_userids       = array_distinct($auth.principal.user.userid)

  condition:
    $auth and $flow
}
