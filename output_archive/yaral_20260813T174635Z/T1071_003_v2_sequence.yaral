/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:47:48.858705+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_NetDev_Mail_Protocol_C2_Flow_Sequence {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a network device (router, switch, firewall, or similar) initiating outbound SMTP/POP3/IMAP connections to an external host, followed shortly by a second flow to the same external destination. This two-flow pattern is consistent with C2 beaconing over mail protocols from a device that should never originate mail traffic. Network devices do not send or receive email in normal operations; any such flow is anomalous."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires firewall or perimeter flow/session logs normalised to UDM NETWORK_FLOW or NETWORK_CONNECTION. Both the initiating device IP and the destination IP must be captured. Log source must record destination port."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Network monitoring appliances that relay alerts via SMTP; out-of-band management servers co-located with network gear; misconfigured NAT causing a server's mail traffic to appear sourced from a network device IP."
    tuning_guidance = "Add known mail-relay management IPs to %netdev_allowed_mail_sources. Add sanctioned external mail relay IPs to %netdev_allowed_mail_destinations. Narrow $src_device by populating %netdev_infrastructure_cidrs with your device management subnets."

  events:
    // First event: network device originates an outbound mail-protocol connection
    $flow1.metadata.event_type = "NETWORK_FLOW"
    $flow1.target.port in [25, 465, 587, 110, 995, 143, 993]
    not $flow1.principal.ip in %netdev_allowed_mail_sources
    not $flow1.target.ip in %netdev_allowed_mail_destinations
    not $flow1.target.ip in %rfc1918_internal
    $flow1.principal.ip = $src_device
    $flow1.target.ip = $dst_external

    // Second event: same device makes another connection to the same external IP
    // within the window - consistent with a beacon or command-response pattern
    $flow2.metadata.event_type = "NETWORK_FLOW"
    $flow2.target.port in [25, 465, 587, 110, 995, 143, 993]
    not $flow2.principal.ip in %netdev_allowed_mail_sources
    not $flow2.target.ip in %netdev_allowed_mail_destinations
    not $flow2.target.ip in %rfc1918_internal
    $flow2.principal.ip = $src_device
    $flow2.target.ip = $dst_external

    // Enforce chronological ordering so the join is directional
    $flow1.metadata.event_timestamp.seconds <= $flow2.metadata.event_timestamp.seconds

  match:
    $src_device, $dst_external over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1071.003")
    $primary_entity      = array_distinct($src_device)
    $destination_ips     = array_distinct($flow2.target.ip)
    $observed_ports      = array_distinct($flow2.target.port)
    $flow_count          = count($flow2.metadata.event_timestamp.seconds)

  condition:
    $flow1 and $flow2
}
