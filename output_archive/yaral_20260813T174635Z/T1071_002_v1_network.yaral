/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:46:50.261678+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_FileTransferProtocol_Outbound_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections on file transfer protocol ports (FTP/21, FTPS/990, TFTP/69, SFTP-over-SSH/22 when anomalous) from internal Linux hosts to external destinations. Adversaries abuse these protocols for C2 traffic blended with legitimate file transfer activity. This rule operates on firewall/perimeter telemetry and does not require endpoint visibility."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source and destination IP, destination port, and byte counts must be populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate FTP/FTPS backup jobs, software update mirrors, managed file transfer (MFT) appliances, TFTP for PXE boot or network device provisioning, authorised SFTP data pipelines."
    tuning_guidance = "Add known-good external FTP/FTPS/TFTP destinations to %allowed_file_transfer_destinations. Add internal source IPs for authorised MFT servers to %allowed_file_transfer_sources. Raise severity to High if the source host is a sensitive server tier."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match file transfer protocol ports: FTP control (21), FTPS implicit (990), TFTP (69/UDP), FTP data (20)
    (
      $net.target.port = 21 or
      $net.target.port = 20 or
      $net.target.port = 990 or
      $net.target.port = 69
    )

    // Destination must be external - exclude RFC1918 and other internal ranges via reference list
    not $net.target.ip in %rfc1918_and_internal_ranges

    // Exclude known-good authorised file transfer destinations
    not $net.target.ip in %allowed_file_transfer_destinations

    // Exclude authorised internal MFT source hosts
    not $net.principal.ip in %allowed_file_transfer_sources

    // Principal (source) must be an internal host - must have a source IP
    $net.principal.ip != ""

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
