/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:48:07.141271+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_ESXi_DNS_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi DNS resolver configuration files or network configuration settings that could indicate an adversary redirecting DNS resolution to an attacker-controlled server to enable DNS tunneling or C2 over DNS. Targets the configuration state change rather than the command that caused it, providing coverage orthogonal to process-launch rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Requires ESXi hostd or shell audit telemetry normalised into Chronicle UDM SETTING_MODIFICATION events. Ensure ESXi syslog forwarding is enabled and Chronicle ingestion is configured for vmware_esxi log source."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised network re-configuration by infrastructure teams, DHCP-driven DNS updates, automated provisioning scripts, vCenter orchestrated host configuration changes."
    tuning_guidance = "Add known-good administrator userids to %esxi_allowed_config_admins. Add approved automation service accounts to the same list. If DHCP-assigned DNS changes are common, consider narrowing the rule to changes made outside a maintenance window using a scheduled suppression."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Target the ESXi network/DNS configuration paths that control resolver behaviour.
    // /etc/resolv.conf is the live resolver config; /etc/vmware/esx.conf holds
    // persistent host-level network settings including DNS server assignments.
    // /etc/hosts modifications can redirect specific names without touching DNS.
    (
      $cfg.target.file.full_path = /\/etc\/resolv\.conf$/ nocase or
      $cfg.target.file.full_path = /\/etc\/hosts$/ nocase or
      $cfg.target.file.full_path = /\/etc\/vmware\/esx\.conf$/ nocase or
      $cfg.target.file.full_path = /\/etc\/vmware\/hostd\/config\.xml$/ nocase or
      $cfg.target.file.full_path = /\/etc\/vmware\/rhttpproxy\/config\.xml$/ nocase
    )

    // Exclude known-good automation accounts and authorised admins.
    not $cfg.principal.user.userid in %esxi_allowed_config_admins

    // Exclude changes attributed to the VMware hostd management daemon itself
    // performing routine internal updates (e.g. DHCP lease renewals).
    not $cfg.principal.process.file.full_path = /\/sbin\/hostd$/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $modified_config_path = array_distinct($cfg.target.file.full_path)
    $actor_userid = array_distinct($cfg.principal.user.userid)
    $actor_process = array_distinct($cfg.principal.process.file.full_path)

  condition:
    $cfg
}
