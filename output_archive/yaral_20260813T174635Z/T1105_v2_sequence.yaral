/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:49:55.514414+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_002_Firewall_LargeOutboundThenInboundFile {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a Windows host first making an outbound connection to a non-internal destination on a suspicious port (common tool-download ports: HTTP/S, FTP, TFTP, non-standard high ports), followed within 5 minutes by a significant inbound data transfer from the same external IP. This network-observable pattern is consistent with ingress tool transfer: the host reaches out, then receives a payload. Firewall/proxy telemetry only - no endpoint process context required."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events with bytes_sent/bytes_received populated. Both legs of the session must be visible (bidirectional flow records or separate inbound/outbound records)."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "Software update services (WSUS, Windows Update CDN, vendor patch delivery), large file downloads from sanctioned SaaS, backup agents writing to cloud storage, legitimate FTP/SFTP transfers."
    tuning_guidance = "Add approved external update and CDN destinations to %global_allowed_download_destinations. Add internal RFC-1918 and loopback ranges to %rfc1918_internal. Raise the bytes_received threshold if update traffic is noisy. Scope by target.port to exclude well-known update ports if needed."

  events:
    // Leg 1: host initiates outbound connection to an external IP on a
    // port commonly used for tool delivery (80, 443, 21, 69, or high ports
    // above 1024 that are not ephemeral-only noise).
    $out.metadata.event_type = "NETWORK_CONNECTION"
    $out.target.port > 20
    not $out.target.ip in %rfc1918_internal
    not $out.target.ip in %global_allowed_download_destinations
    // Bind the external IP and the internal host for the join.
    $out.target.ip = $ext_ip
    $out.principal.ip = $src_ip

    // Leg 2: a NETWORK_FLOW record from the same external IP back to the
    // same internal host carrying a meaningful payload (>= 100 KB received
    // by the internal host, i.e. bytes_sent from the external perspective
    // or network_http.response_body_length proxy equivalent).
    // Chronicle UDM: network.received_bytes on the flow record represents
    // bytes received by principal (the internal host).
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.received_bytes >= 102400
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.ip in %global_allowed_download_destinations
    $flow.target.ip = $ext_ip
    $flow.principal.ip = $src_ip

    // Chronological ordering: outbound connection precedes the completed flow.
    $out.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $ext_ip, $src_ip over 5m

  outcome:
    $risk_score          = max(72)
    $mitre_technique_id  = array_distinct("T1105")
    $primary_entity      = array_distinct($src_ip)
    $external_ips        = array_distinct($ext_ip)
    $destination_ports   = array_distinct($out.target.port)
    $max_bytes_received  = max($flow.network.received_bytes)
    $flow_count          = count($flow.metadata.id)

  condition:
    $out and $flow
}
