/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:49:12.120506+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_PubSub_Protocol_Spike_Then_External_Broker {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a Linux host that first establishes a connection on a pub/sub protocol port (MQTT 1883/8883, AMQP 5671/5672, XMPP 5222/5269, STOMP 61613/61614) to an external broker, then sustains an anomalous volume of outbound flows on the same port within a short window. This pattern is consistent with C2 beaconing over pub/sub messaging infrastructure. Firewall/perimeter telemetry only - additive to any endpoint process-launch rule."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires perimeter firewall or network flow logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events with principal.ip, target.ip, target.port, and metadata.event_timestamp populated."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate IoT gateways, industrial SCADA systems, internal CI/CD pipelines using RabbitMQ/ActiveMQ, monitoring agents publishing metrics via MQTT, and authorised cloud messaging services (AWS IoT, Azure Service Bus)."
    tuning_guidance = "Add known-good external broker IPs or CIDRs to %allowed_pubsub_brokers. Add internal source IPs of authorised IoT or messaging hosts to %allowed_pubsub_sources. Raise the flow-count threshold in the outcome comment if the environment legitimately generates high pub/sub volume."

  events:
    // First event: initial outbound connection to an external host on a
    // well-known pub/sub protocol port. Pre-filtered to pub/sub ports only
    // so the join anchor is narrow.
    $first.metadata.event_type = "NETWORK_CONNECTION"
    (
        $first.target.port = 1883  or   // MQTT plaintext
        $first.target.port = 8883  or   // MQTT TLS
        $first.target.port = 5672  or   // AMQP plaintext
        $first.target.port = 5671  or   // AMQP TLS
        $first.target.port = 5222  or   // XMPP client
        $first.target.port = 5269  or   // XMPP server federation
        $first.target.port = 61613 or   // STOMP plaintext
        $first.target.port = 61614      // STOMP TLS/WebSocket
    )
    not $first.target.ip in %allowed_pubsub_brokers
    not $first.principal.ip in %allowed_pubsub_sources
    $first.principal.ip = $src_ip
    $first.target.port = $pub_sub_port

    // Second event: a subsequent flow on the SAME port from the SAME source,
    // confirming sustained/repeated pub/sub activity rather than a one-off
    // connection. Pre-filtered identically to prevent Cartesian explosion.
    $flow.metadata.event_type = "NETWORK_FLOW"
    (
        $flow.target.port = 1883  or
        $flow.target.port = 8883  or
        $flow.target.port = 5672  or
        $flow.target.port = 5671  or
        $flow.target.port = 5222  or
        $flow.target.port = 5269  or
        $flow.target.port = 61613 or
        $flow.target.port = 61614
    )
    not $flow.target.ip in %allowed_pubsub_brokers
    not $flow.principal.ip in %allowed_pubsub_sources
    $flow.principal.ip = $src_ip
    $flow.target.port = $pub_sub_port

    // Chronological ordering: initial connection must precede the flow burst
    $first.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $pub_sub_port over 5m

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity    = array_distinct($src_ip)
    $destination_ips   = array_distinct($flow.target.ip)
    $observed_ports    = array_distinct($flow.target.port)
    $flow_count        = count($flow.metadata.event_timestamp.seconds)
    $first_seen_ts     = min($first.metadata.event_timestamp.seconds)
    $last_seen_ts      = max($flow.metadata.event_timestamp.seconds)

  condition:
    $first and $flow
}
