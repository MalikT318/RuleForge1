/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:48:46.446273+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_PubSub_Protocol_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections to external destinations on ports commonly associated with publish/subscribe messaging protocols (MQTT 1883/8883, AMQP 5671/5672, STOMP 61613/61614, XMPP 5222/5269). Adversaries abuse these protocols to blend C2 traffic with legitimate messaging infrastructure. Firewall/perimeter telemetry only - no process context required."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires firewall or perimeter flow logs with destination IP and destination port populated in UDM. Internal RFC-1918 and approved cloud messaging endpoints should be added to reference lists for tuning."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate IoT device management platforms, industrial SCADA/ICS systems using MQTT, enterprise messaging middleware (RabbitMQ, ActiveMQ), cloud IoT services (AWS IoT, Azure IoT Hub), and CI/CD pipeline event buses using AMQP."
    tuning_guidance = "Add known-good internal broker IPs to %pubsub_allowed_internal_ranges. Add approved external cloud messaging service IPs/CIDRs to %pubsub_allowed_external_brokers. Narrow scope by pairing with asset inventory if IoT/OT devices are expected to use these ports legitimately."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match destination ports associated with pub/sub protocols:
    // MQTT: 1883 (plaintext), 8883 (TLS)
    // AMQP: 5672 (plaintext), 5671 (TLS)
    // STOMP: 61613 (plaintext), 61614 (TLS/WebSocket)
    // XMPP client-to-server: 5222, server-to-server: 5269
    (
      $net.target.port = 1883 or
      $net.target.port = 8883 or
      $net.target.port = 5672 or
      $net.target.port = 5671 or
      $net.target.port = 61613 or
      $net.target.port = 61614 or
      $net.target.port = 5222 or
      $net.target.port = 5269
    )

    // Exclude known internal/approved ranges via reference lists
    not $net.target.ip in %pubsub_allowed_internal_ranges
    not $net.target.ip in %pubsub_allowed_external_brokers

    // Require a source host to be identifiable (reduces noise from unresolved flows)
    $net.principal.hostname != ""

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_port = max($net.target.port)
    $destination_ip = array_distinct($net.target.ip)

  condition:
    $net
}
