/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-13T17:48:29.828246+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_DNS_Tunnel_Beacon_Then_HighVolume_Query {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects DNS tunneling / beaconing via two correlated network-observable signals on the same source host: (1) an anomalously long DNS query name indicative of data exfiltration or C2 encoding, followed within 5 minutes by (2) a burst of DNS queries to the same destination domain, consistent with beaconing or chunked data transfer. Both events are sourced from firewall/perimeter DNS telemetry with no endpoint process fields required."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Requires perimeter firewall or DNS forwarder logs normalised to UDM NETWORK_DNS events, including principal.hostname or principal.ip, network.dns.questions.name, and metadata.event_timestamp."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "CDN health-check clients, DKIM/SPF TXT record lookups, legitimate DNS-over-HTTPS fallback resolvers, automated certificate validation (ACME DNS-01 challenges), and some enterprise software update mechanisms that encode version metadata in DNS labels."
    tuning_guidance = "Add known-good high-query-volume resolvers (e.g. internal recursive resolvers, monitoring agents) to %dns_allowed_high_volume_sources. Add approved long-label domains (e.g. ACME challenge domains, DKIM selectors) to %dns_allowed_long_label_domains. Raise the query-length threshold or tighten the burst count to reduce noise in environments with heavy CDN usage."

  events:
    // --- Leg 1: Single DNS query with an anomalously long encoded label ---
    // Long subdomains (>50 chars in a single label) are a strong indicator of
    // base32/base64-encoded data being tunnelled through DNS.
    $long_q.metadata.event_type = "NETWORK_DNS"
    $long_q.network.dns.questions.name = /([a-z0-9\-]{50,}\.)/ nocase
    not $long_q.network.dns.questions.name in %dns_allowed_long_label_domains
    not $long_q.principal.ip in %dns_allowed_high_volume_sources
    $long_q.principal.hostname = $src_host

    // --- Leg 2: High-frequency DNS queries from the same host within the window ---
    // Beaconing produces repeated queries; we capture any DNS event from the
    // same source so Chronicle's aggregation can count them in outcome.
    $burst_q.metadata.event_type = "NETWORK_DNS"
    not $burst_q.network.dns.questions.name in %dns_allowed_long_label_domains
    not $burst_q.principal.ip in %dns_allowed_high_volume_sources
    $burst_q.principal.hostname = $src_host

    // Chronological ordering: long-label query must precede or coincide with burst
    $long_q.metadata.event_timestamp.seconds <= $burst_q.metadata.event_timestamp.seconds

  match:
    $src_host over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($src_host)
    $suspicious_query_names = array_distinct($long_q.network.dns.questions.name)
    $burst_query_names = array_distinct($burst_q.network.dns.questions.name)
    $total_burst_queries = count($burst_q.network.dns.questions.name)
    $source_ips = array_distinct($long_q.principal.ip)

  condition:
    $long_q and $burst_q
}
