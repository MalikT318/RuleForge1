/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:45:12.654468+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_SID_History_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects SID-History injection attempts via PowerShell or LDAP-based tooling that modify the SID-History attribute on Active Directory user objects. Adversaries with Domain Admin rights inject privileged SIDs (e.g., Enterprise Admins S-1-5-21-*-519) into SID-History to silently escalate privileges and bypass access controls without changing group membership."
    mitre_tactic = "Privilege Escalation, Defense Evasion"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, or SentinelOne). Windows Security Event 4765/4766 (SID History added/failed) also surfaces this if AD auditing is enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Active Directory domain migration tooling (ADMT), authorized identity consolidation projects, domain trust establishment by AD administrators."
    tuning_guidance = "Add authorized migration service accounts to %sid_history_allowed_principals. Add approved migration tool parent process paths to %sid_history_allowed_tools. Scope to non-migration maintenance windows if possible."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target PowerShell, cmd, or AD management binaries used to manipulate SID-History
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|dsamain|ldifde|csvde|dsmod|ntdsutil)\.exe$/ nocase

    // Match command-line patterns that reference SID-History attribute manipulation
    // Covers: Set-ADUser -Replace @{sIDHistory=...}, direct LDAP attribute writes,
    // Mimikatz sid::patch / sid::add, and PowerView Set-DomainObject targeting sIDHistory
    $proc.target.process.command_line = /(sIDHistory|sid-history|sidhistory|sid\\:\\:add|sid\\:\\:patch|Set\-DomainObject.*sIDHistory|Set\-ADUser.*sIDHistory|Replace.*sIDHistory|Add\-ADGroupMember.*sIDHistory)/ nocase

    // Exclude known-good migration service accounts and approved tooling
    not $proc.principal.process.file.full_path in %sid_history_allowed_tools
    not $proc.principal.user.userid in %sid_history_allowed_principals

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
