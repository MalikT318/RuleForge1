/*
  MITRE Technique : T1216.001 - PubPrn
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:53:04.307442+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_001_PubPrn_Script_Proxy_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects abuse of PubPrn.vbs to proxy execution of remote scriptlets via the script: moniker. Adversaries pass a script:http(s):// URI as the second argument to cscript.exe executing PubPrn.vbs, bypassing application control and signature validation. Windows 10+ restricts this to LDAP:// only, so any script: usage is highly suspicious."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1216.001"
    mitre_technique_name = "System Script Proxy Execution: PubPrn"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture normalised to UDM PROCESS_LAUNCH."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate printer publishing to Active Directory using the LDAP:// parameter; this rule specifically targets the script: moniker so legitimate AD printer publishing should not trigger it."
    tuning_guidance = "If internal tooling legitimately invokes PubPrn.vbs with a script: URI (extremely unlikely), add the parent process path to %global_allowed_pubprn_parents. Scope by hostname or OU if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // cscript.exe must be the executing interpreter
    $proc.target.process.file.full_path = /\\cscript\.exe$/ nocase

    // PubPrn.vbs must appear in the command line (handles full path or relative invocation)
    $proc.target.process.command_line = /pubprn\.vbs/ nocase

    // The malicious second parameter uses the script: moniker (http or https remote scriptlet)
    $proc.target.process.command_line = /script\s*:/ nocase

    // Exclude known-good parent processes that legitimately manage printers
    not $proc.principal.process.file.full_path in %global_allowed_pubprn_parents

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1216.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_user     = array_distinct($proc.principal.user.userid)
    $command_line      = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
