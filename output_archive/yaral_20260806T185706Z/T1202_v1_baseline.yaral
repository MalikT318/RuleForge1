/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:50:39.825590+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_001_Indirect_Command_Execution_LOLBin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects indirect command execution via Windows utilities that can invoke programs or shell commands without directly calling cmd.exe or powershell.exe. Covers forfiles.exe, pcalua.exe, scriptrunner.exe, ssh.exe (ProxyCommand/LocalCommand), and similar LOLBins abused to bypass command-line restrictions and security controls."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, or equivalent). Command-line logging must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate forfiles.exe usage in batch maintenance scripts; pcalua.exe invoked by compatibility shims during software installation; scriptrunner.exe used by authorized deployment tooling; ssh.exe ProxyCommand in developer or DevOps workflows."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_indirect_exec_parents. Add authorized script paths to %global_allowed_indirect_exec_scripts. Consider scoping to non-IT-admin user populations first. Tune forfiles /c matches to exclude known backup or cleanup job patterns."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the indirect execution utilities by binary name
    $proc.target.process.file.full_path = /\\(forfiles|pcalua|scriptrunner|wsl|wslhost|bash|ssh)\.exe$/ nocase

    // Require at least one indicator of command invocation intent:
    // forfiles /c, pcalua -a/-args, scriptrunner -appcompat, ssh -o ProxyCommand/LocalCommand
    $proc.target.process.command_line = /(\/c\s+|\/cmd\s+|-a\s+|-args\s+|-appcompat|-o\s+(ProxyCommand|LocalCommand)|--exec\s+|ProxyCommand|LocalCommand)/ nocase

    // Exclude known-good parent processes (software deployment, RMM, patch management)
    not $proc.principal.process.file.full_path in %global_allowed_indirect_exec_parents

    // Exclude known-good script invocations
    not $proc.target.process.command_line in %global_allowed_indirect_exec_scripts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($proc.principal.hostname)
    $indirect_exec_binary = array_distinct($proc.target.process.file.full_path)
    $indirect_exec_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
