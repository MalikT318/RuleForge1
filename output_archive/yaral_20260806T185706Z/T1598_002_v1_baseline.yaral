/*
  MITRE Technique : T1598.002 - Spearphishing Attachment
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:26:40.358746+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_002_Spearphishing_Attachment_Credential_Harvest {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound HTTP/S connections to external destinations exhibiting patterns consistent with credential harvesting or document-based phishing lures - specifically file submissions or form posts to newly observed or low-reputation external hosts. Targets the network-observable side of spearphishing-with-attachment campaigns including HTML smuggling portals and file-return lures."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.002"
    mitre_technique_name = "Phishing for Information: Spearphishing Attachment"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_HTTP with populated network.http.method, target.url, and network.http.user_agent fields. Full URL logging must be enabled on the proxy."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate cloud file-sharing services (SharePoint, Dropbox, Box), HR or finance portals accepting document uploads, web-based email clients, CRM form submissions."
    tuning_guidance = "Add approved external file-upload destinations to %global_allowed_upload_domains. Add known internal egress proxies to %global_internal_proxy_hosts. Narrow by department or VLAN if credential-harvesting campaigns target specific business units."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"

    // Outbound POST - the primary mechanism for credential or document submission
    $http.network.http.method = "POST"

    // Target must be an external host - exclude RFC-1918 and loopback via reference list
    not $http.target.hostname in %global_allowed_upload_domains
    not $http.target.ip in %rfc1918_internal

    // URL patterns associated with phishing portals, document return endpoints,
    // and HTML-smuggling credential collectors
    (
      $http.target.url = /\/(upload|submit|collect|harvest|login|signin|auth|verify|validate|confirm|update|secure|account|credential|document|form|response|reply|feedback|survey)/ nocase
      or $http.target.url = /\.(php|aspx|ashx|cfm|jsp)\?/ nocase
      or $http.target.url = /\/wp-(login|admin|content\/uploads)/ nocase
    )

    // Suspicious or absent user-agent strings common in scripted or weaponised
    // document macro callbacks and HTML-smuggling page submissions
    (
      $http.network.http.user_agent = /^(curl|python|go-http|libwww|lwp|wget|okhttp|java\/|ruby|perl)/ nocase
      or $http.network.http.user_agent = /Microsoft Office/ nocase
      or $http.network.http.user_agent = /Word|Excel|PowerPoint/ nocase
    )

    // Exclude well-known legitimate SaaS upload endpoints
    not $http.target.hostname in %global_saas_upload_allowlist

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1598.002")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_host = array_distinct($http.target.hostname)
    $destination_url = array_distinct($http.target.url)
    $http_method = array_distinct($http.network.http.method)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
