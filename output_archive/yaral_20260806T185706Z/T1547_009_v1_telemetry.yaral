/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:22:26.410109+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_LNK_Shortcut_Created_In_Startup {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of a .lnk shortcut file inside a Windows Startup folder (per-user or All Users). Adversaries plant or replace shortcuts in these locations to achieve persistence at user login without spawning a detectable process at write time. This rule fires on the file artifact itself, providing coverage orthogonal to command-line rules."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires EDR or Sysmon file-creation/modification telemetry normalised into UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers writing shortcuts to Startup (e.g. chat clients, VPN agents, RMM tools). Authorised IT deployment scripts. User-created convenience shortcuts."
    tuning_guidance = "Add known-good parent process paths (e.g. installer engines, software update processes) to %global_allowed_shortcut_writers. Add known-good shortcut names to %global_allowed_startup_lnk_names to suppress specific approved entries."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a .lnk file
    $file.target.file.full_path = /\.lnk$/ nocase

    // Must reside inside a Startup folder:
    //   Per-user:  C:\Users\<any>\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\
    //   All Users: C:\ProgramData\Microsoft\Windows\Start Menu\Programs\StartUp\
    $file.target.file.full_path = /\\(Users\\[^\\]+\\AppData\\Roaming|ProgramData)\\Microsoft\\Windows\\Start Menu\\Programs\\Start[Uu]p\\/i nocase

    // Exclude known-good writers supplied per-client
    not $file.principal.process.file.full_path in %global_allowed_shortcut_writers

    // Exclude known-good shortcut names supplied per-client
    not $file.target.file.full_path in %global_allowed_startup_lnk_names

    // Exclude Windows Explorer itself writing shortcuts (user drag-and-drop)
    not $file.principal.process.file.full_path = /\\explorer\.exe$/ nocase

    // Exclude Windows Installer / msiexec writing shortcuts during legitimate installs
    not $file.principal.process.file.full_path = /\\msiexec\.exe$/ nocase

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity    = array_distinct($file.principal.hostname)
    $shortcut_path     = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $writing_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
