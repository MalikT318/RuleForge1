/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:50:22.623373+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_Hardware_Addition_Network_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network traffic patterns consistent with rogue hardware additions such as passive network taps, unauthorized wireless access points, or adversary-in-the-middle implants. Focuses on IDS/IPS alerts flagging unexpected new network participants, ARP anomalies, or traffic from unrecognized MAC OUI ranges that may indicate physically introduced hardware. Targets the network-layer visibility that IDS/IPS appliances provide as the most reliable signal for hardware additions on a Windows-centric network segment."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalized to UDM NETWORK_FLOW or NETWORK_CONNECTION events. Appliance must log new or anomalous host observations, ARP inspection alerts, or rogue device detections. Security result category fields must be populated by the normalizer."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Newly provisioned legitimate workstations or servers appearing on the network for the first time. IT-managed network switches or access points being deployed. DHCP scope expansions introducing new subnets. Guest Wi-Fi clients. VPN concentrators presenting new virtual interfaces."
    tuning_guidance = "Populate %approved_network_segments with known-good CIDR ranges. Populate %known_managed_hosts with asset inventory hostnames or IPs. Tune the port and protocol filters to match your environment's baseline. Consider raising severity if the source IP is outside %approved_network_segments and no asset record exists."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match IDS/IPS category signals associated with rogue or anomalous hardware
    // Use nocase regex on security_result fields as supplementary signal only,
    // not as sole gating logic, to tolerate inconsistent vendor normalization
    (
      $net.security_result.category_details = /rogue|unauthorized.*(device|host|ap|access.point)|arp.*(spoof|poison|anomal)|new.*host|unknown.*device|hardware.*addition|mac.*anomal|dhcp.*rogue|port.*security/ nocase
      or
      $net.security_result.summary = /rogue|unauthorized.*(device|host|ap|access.point)|arp.*(spoof|poison|anomal)|new.*host|unknown.*device|hardware.*addition|mac.*anomal|dhcp.*rogue|port.*security/ nocase
    )

    // Require a source IP to be present - rogue hardware must communicate
    $net.principal.ip != ""

    // Require a destination IP to be present
    $net.target.ip != ""

    // Exclude known-approved network segments and managed hosts to reduce noise
    not $net.principal.ip in %approved_network_segments
    not $net.principal.hostname in %known_managed_hosts

    // Exclude loopback and link-local self-communication
    not $net.principal.ip = "127.0.0.1"
    not $net.principal.ip = "::1"
    not $net.target.ip = "127.0.0.1"

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($net.principal.ip)
    $alert_summary = array_distinct($net.security_result.summary)
    $alert_category = array_distinct($net.security_result.category_details)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
