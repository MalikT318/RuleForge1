/*
  MITRE Technique : T1199 - Trusted Relationship
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:50:02.086968+00:00
  Reference       : https://attack.mitre.org/techniques/T1199
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1199_Delegated_Admin_Relationship_Granted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects when delegated administrator permissions are granted to an external partner or third-party account in an M365 tenant. Adversaries who compromise a Microsoft partner or reseller account can leverage or create delegated admin relationships to gain administrative control over victim tenants, a key abuse vector for T1199 Trusted Relationship."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1199"
    mitre_technique_name = "Trusted Relationship"
    log_prerequisites = "Requires M365 unified audit logs with AzureActiveDirectory and PartnerCenter workload events ingested into Chronicle. Delegated admin offer and acceptance events must be enabled."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Legitimate onboarding of new managed service providers, authorized IT outsourcing arrangements, or sanctioned Microsoft partner relationships. These should be rare and pre-approved."
    tuning_guidance = "Populate %approved_delegated_admin_partners with known-good partner tenant IDs or principal user IDs. Add authorized admin accounts performing bulk permission grants to %global_allowed_admin_accounts. Alert volume should be very low; any unexpected firing warrants investigation."

  events:
    $cloud.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    // Target a delegated admin or partner relationship grant operation
    // M365 audit operations for delegated admin: AddDelegatedAdminRelationship,
    // PartnerRelationshipAccepted, Set-MsolPartnerInformation, or role assignment
    // to a cross-tenant or partner principal
    $cloud.metadata.product_event_type = /delegat|partner.*admin|reseller.*admin|grantor.*admin|AdminRelationship/ nocase
    // The target receiving elevated permissions should be an external/partner account
    // External accounts typically carry a cross-tenant UPN suffix or partner domain
    $cloud.target.user.userid = /.+#ext#|partner\.|onmicrosoft\.com/ nocase
    // Ensure the permission change targets a high-privilege role
    $cloud.target.resource.name = /global.?admin|company.?admin|partner.?admin|privileged.?role|exchange.?admin|sharepoint.?admin|teams.?admin|billing.?admin|delegated/ nocase
    not $cloud.principal.user.userid in %global_allowed_admin_accounts
    not $cloud.target.user.userid in %approved_delegated_admin_partners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1199")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_partner_account = array_distinct($cloud.target.user.userid)
    $permission_granted = array_distinct($cloud.target.resource.name)
    $operation = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
