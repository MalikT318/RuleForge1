/*
  MITRE Technique : T1008 - Fallback Channels
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:35:21.873331+00:00
  Reference       : https://attack.mitre.org/techniques/T1008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1008_001_Fallback_Channel_Repeated_Outbound_Port_Rotation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single host making outbound connections across multiple uncommon destination ports in a short window, consistent with a C2 implant probing fallback channels after primary channel failure. Firewall/proxy telemetry only - no endpoint process context required."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1008"
    mitre_technique_name = "Fallback Channels"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Source IP must be populated. Internal RFC-1918 exclusion list %rfc1918_internal must be maintained."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Software update clients that contact CDN edge nodes on non-standard ports, VPN concentrators performing health checks, load-balanced SaaS services with rotating egress IPs, legitimate peer-to-peer applications."
    tuning_guidance = "Populate %global_allowed_egress_ports with approved non-standard ports (e.g. 8443, 8080). Add known-good external IP ranges to %rfc1918_internal or a dedicated %global_allowed_egress_destinations list. Raise the threshold or narrow the port range if noisy in environments with heavy CDN usage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal host (not itself an external IP)
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not RFC-1918, loopback, or link-local)
    not $net.target.ip in %rfc1918_internal

    // Focus on non-standard ports that C2 frameworks commonly rotate through
    // Excludes well-known service ports (80, 443, 53, 22, 25, 587, 993, 995)
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 22
    $net.target.port != 25
    $net.target.port != 587
    $net.target.port != 993
    $net.target.port != 995
    $net.target.port != 123
    $net.target.port > 1024

    // Exclude approved non-standard egress ports defined per customer
    not $net.target.port in %global_allowed_egress_ports

    // Bind the source host for grouping
    $net.principal.ip = $src_ip
    $net.target.port = $dst_port

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1008")
    $primary_entity = array_distinct($net.principal.ip)
    $distinct_destination_ports = array_distinct($dst_port)
    $distinct_destination_ips = array_distinct($net.target.ip)
    $connection_count = count($net.target.port)

  condition:
    // Require at least 5 distinct non-standard destination ports from the same
    // source within the 10-minute window - strong signal of port-rotation
    // fallback behaviour rather than a single misconfigured application
    #dst_port >= 5
}
