/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:00:26.690830+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_NDev_Encoded_Payload_Then_Anomalous_Flow {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a network device receiving an inbound HTTP/HTTPS connection carrying a high-entropy or encoded payload signature (e.g. base64-dense URI or body patterns indicative of obfuscated content), followed within 5 minutes by an anomalous outbound flow from the same device — consistent with obfuscated payload delivery to a network appliance leading to C2 beaconing or data exfiltration."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "Requires IDS/IPS HTTP inspection logs capturing URI and content-type metadata, plus flow records (NETWORK_FLOW) for the same device. Both event types must be normalised into Chronicle UDM with principal/target IP fields populated."
    platform        = "Network Devices"
    log_source      = "ips"
    false_positives = "Legitimate encrypted management-plane traffic (RESTCONF, NETCONF over TLS), software update downloads with encoded filenames, monitoring systems polling device APIs with base64-encoded credentials in URIs."
    tuning_guidance = "Populate %ndev_allowed_mgmt_sources with known management station CIDRs. Populate %ndev_allowed_update_destinations with vendor update server ranges. Raise the minimum bytes threshold in the outbound flow filter if legitimate bulk transfers trigger the rule."

  events:
    // Stage 1: Inbound HTTP/HTTPS to the network device carrying an
    // obfuscated / high-entropy payload — detected by IDS/IPS inspection.
    // We match on URI patterns that are dense with base64 characters
    // (long runs of alphanumeric + /+= with no readable path segments)
    // or on content-type mismatches that IDS engines flag for encoded bodies.
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.port >= 80
    (
      $http.network.http.request_params = /[A-Za-z0-9+\/]{60,}={0,2}/ nocase
      or
      $http.network.http.request_params = /(%[0-9A-Fa-f]{2}){20,}/ nocase
      or
      $http.network.http.user_agent = /[A-Za-z0-9+\/]{40,}/ nocase
    )
    not $http.principal.ip in %ndev_allowed_mgmt_sources
    $http.target.ip = $device_ip

    // Stage 2: Outbound flow from the same device IP within the window,
    // to a non-RFC1918 destination, with non-trivial byte count —
    // consistent with a compromised appliance beaconing or exfiltrating.
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.ip = $device_ip
    not $flow.target.ip in %ndev_allowed_update_destinations
    not $flow.target.ip in %rfc1918_internal
    $flow.network.sent_bytes > 0
    $flow.target.port >= 1

    // Chronological ordering: encoded inbound request precedes outbound flow
    $http.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_ip over 5m

  outcome:
    $risk_score          = max(82)
    $mitre_technique_id  = array_distinct("T1027")
    $primary_entity      = array_distinct($device_ip)
    $inbound_source_ips  = array_distinct($http.principal.ip)
    $outbound_dest_ips   = array_distinct($flow.target.ip)
    $outbound_dest_ports = array_distinct($flow.target.port)
    $bytes_sent          = max($flow.network.sent_bytes)
    $http_user_agents    = array_distinct($http.network.http.user_agent)

  condition:
    $http and $flow
}
