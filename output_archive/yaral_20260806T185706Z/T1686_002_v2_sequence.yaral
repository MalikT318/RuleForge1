/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T18:57:25.244544+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Firewall_Rule_Change_Then_Anomalous_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a firewall policy or ACL modification followed within 10 minutes by a new network flow that traverses the modified device, suggesting the rule change was made to permit previously blocked traffic. This pattern is consistent with adversaries disabling or weakening firewall controls to enable C2 or lateral movement."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Requires firewall management-plane syslog (config change events) and firewall flow/session logs normalised to UDM SETTING_MODIFICATION and NETWORK_FLOW respectively."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised change-window firewall rule updates followed by legitimate traffic; automated policy orchestration tools; network management platforms that push rule sets on a schedule."
    tuning_guidance = "Add authorised change-management accounts to %fw_authorized_change_accounts. Add known management source IPs or subnets to %fw_authorized_mgmt_sources. Add approved destination networks to %fw_approved_destination_networks. Narrow the time window if false-positive rate remains high."

  events:
    // Event 1: A firewall policy / ACL setting is modified
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.resource.name = /acl|access.list|firewall|policy|rule|zone|filter|permit|deny/ nocase
    not $cfg.principal.user.userid in %fw_authorized_change_accounts
    not $cfg.principal.ip in %fw_authorized_mgmt_sources
    $cfg.principal.hostname = $device_hostname

    // Event 2: A network flow observed on the same device shortly after
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $device_hostname
    not $flow.target.ip in %fw_approved_destination_networks
    $flow.network.sent_bytes > 0

    // Chronological ordering: config change must precede the flow
    $cfg.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($device_hostname)
    $changing_user = array_distinct($cfg.principal.user.userid)
    $change_source_ip = array_distinct($cfg.principal.ip)
    $modified_resource = array_distinct($cfg.target.resource.name)
    $flow_destination_ips = array_distinct($flow.target.ip)
    $flow_destination_ports = array_distinct($flow.target.port)
    $total_bytes_sent = max($flow.network.sent_bytes)

  condition:
    $cfg and $flow
}
