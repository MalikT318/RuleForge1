/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:07:29.868383+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Linux_Root_Certificate_Install {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects installation of a root certificate on Linux via common certificate management utilities (update-ca-certificates, update-ca-trust, certutil) or direct writes to system certificate trust stores. Adversaries install rogue root CAs to silently intercept TLS traffic without browser warnings."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry producing PROCESS_LAUNCH events with command-line arguments, or FILE_CREATION/FILE_MODIFICATION events for certificate store paths."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate PKI deployments, enterprise CA bootstrapping via configuration management (Ansible, Puppet, Chef), OS package manager installing CA bundles during system updates, corporate SSL inspection appliance onboarding."
    tuning_guidance = "Add authorised automation account userids to %linux_allowed_ca_installers. Add known-good parent process paths (e.g. package manager, CM agent) to %linux_allowed_ca_parent_procs. Scope by hostname group if a subset of hosts performs routine CA management."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the OS-level certificate management binaries or direct certutil invocation
    (
      $proc.target.process.file.full_path = /\/(update-ca-certificates|update-ca-trust|certutil)$/ nocase
      or
      (
        // Direct invocation of openssl to add a cert to a trust store
        $proc.target.process.file.full_path = /\/openssl$/ nocase
        and $proc.target.process.command_line = /x509/ nocase
        and $proc.target.process.command_line = /-(out|CAfile|CApath|trustout|addtrust)/ nocase
      )
      or
      (
        // cp / install / mv of a .crt or .pem file into a system trust directory
        $proc.target.process.file.full_path = /\/(cp|install|mv)$/ nocase
        and $proc.target.process.command_line = /\.(crt|pem|cer|der)/ nocase
        and $proc.target.process.command_line = /\/(etc\/(ssl\/certs|ca-certificates|pki\/(ca-trust|tls))|usr\/local\/share\/ca-certificates|usr\/share\/ca-certificates)/ nocase
      )
    )

    // Exclude known-good automation accounts and parent processes
    not $proc.principal.user.userid in %linux_allowed_ca_installers
    not $proc.principal.process.file.full_path in %linux_allowed_ca_parent_procs

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $acting_user       = array_distinct($proc.principal.user.userid)
    $command_line      = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
