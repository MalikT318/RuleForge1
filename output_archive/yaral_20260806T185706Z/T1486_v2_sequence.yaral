/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:32:21.577439+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_002_Linux_Mass_File_Modification_Then_Ransom_Note {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a ransomware-style impact pattern on Linux: a burst of file modifications across user or data directories (indicative of in-place encryption) followed within 1 hour by creation of a ransom note file. This correlation avoids command-line matching and instead focuses on filesystem behaviour - mass FILE_MODIFICATION events followed by FILE_CREATION of a file whose name matches common ransom note naming conventions."
    mitre_tactic    = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires Linux EDR or auditd file-event telemetry normalised to UDM FILE_MODIFICATION and FILE_CREATION events. Auditd rules must include -w on /home, /var, /srv, /opt, /data, /backup paths with -p wa permissions."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Backup agents performing bulk compression/encryption (e.g. Bacula, Amanda, Duplicati), package managers updating many files simultaneously, configuration management tools (Ansible, Puppet, Chef), large-scale log rotation, database compaction jobs."
    tuning_guidance = "Add known backup or CM agent process paths to %linux_allowed_bulk_file_writers. Raise the threshold in the match window if backup jobs trigger false positives. Narrow the ransom note regex if internal tooling creates files with similar naming patterns."

  events:
    // Leg 1: a process modifying files in common data directories at volume
    // Pre-filtered to data-bearing paths only to avoid Cartesian explosion
    $fmod.metadata.event_type = "FILE_MODIFICATION"
    $fmod.target.file.full_path = /^\/(home|root|var\/www|srv|opt|data|backup|mnt|media)\// nocase
    not $fmod.target.file.full_path = /\.(log|tmp|lock|pid|sock)$/ nocase
    not $fmod.principal.process.file.full_path in %linux_allowed_bulk_file_writers
    $fmod.principal.hostname = $hostname

    // Leg 2: creation of a file whose name matches ransom note conventions
    // Common patterns: README_DECRYPT, HOW_TO_RESTORE, RECOVER_FILES, !!!HELP!!!, etc.
    $fnote.metadata.event_type = "FILE_CREATION"
    $fnote.target.file.full_path = /\/(README|HOW_TO|RESTORE|RECOVER|DECRYPT|HELP|LOCKED|RANSOM|YOUR_FILES|ATTENTION|IMPORTANT)[^\/]*\.(txt|html|hta|htm|md|pdf|url)$/  nocase
    not $fnote.principal.process.file.full_path in %linux_allowed_bulk_file_writers
    $fnote.principal.hostname = $hostname

    // Chronological ordering: mass modification must precede ransom note drop
    $fmod.metadata.event_timestamp.seconds <= $fnote.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score          = max(95)
    $mitre_technique_id  = array_distinct("T1486")
    $primary_entity      = array_distinct($fmod.principal.hostname)
    $modifying_processes = array_distinct($fmod.principal.process.file.full_path)
    $note_paths          = array_distinct($fnote.target.file.full_path)
    $note_drop_processes = array_distinct($fnote.principal.process.file.full_path)
    $affected_dirs       = array_distinct($fmod.target.file.full_path)
    $modification_count  = count($fmod.target.file.full_path)

  condition:
    $fmod and $fnote
}
