/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:44:13.992436+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_Token_Impersonation_Theft {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process-open events where a process acquires a handle to another process with rights consistent with token duplication and impersonation (PROCESS_QUERY_INFORMATION and/or PROCESS_QUERY_LIMITED_INFORMATION combined with PROCESS_DUP_HANDLE). This combination of access rights is the prerequisite OS mechanism for DuplicateToken/DuplicateTokenEx followed by ImpersonateLoggedOnUser or SetThreadToken. The rule focuses on non-system processes opening handles to high-value system or privileged processes."
    mitre_tactic    = "Privilege Escalation, Defense Evasion"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised into Chronicle UDM PROCESS_OPEN events with target.process.file.full_path and principal.process.file.full_path populated. Windows Security Event 4656/4663 (object access) can supplement."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate security software (AV/EDR agents), system management tools, debuggers, and RMM agents that routinely open handles to system processes for monitoring purposes. Backup agents and performance monitoring tools may also trigger this."
    tuning_guidance = "Add known-good security and management tool paths to %global_allowed_token_openers. Consider narrowing the target process list to only LSASS and privileged service processes if noise is high. Correlate with subsequent PROCESS_LAUNCH events from the same principal to increase fidelity."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Principal (opener) must not itself be a core OS process
    not $open.principal.process.file.full_path = /\\(System32|SysWOW64)\\(lsass|services|svchost|csrss|wininit|smss|lsm)\.exe$/ nocase
    not $open.principal.process.file.full_path = /^$/ nocase

    // Target must be a privileged process worth stealing a token from:
    // lsass (SYSTEM token), winlogon (interactive session tokens),
    // services.exe, or any SYSTEM-context svchost
    $open.target.process.file.full_path = /\\(lsass|winlogon|services|svchost|wininit|csrss)\.exe$/ nocase

    // Principal process must not be a known OS binary performing legitimate handle operations
    not $open.principal.process.file.full_path = /\\(MsMpEng|SenseIR|SenseCncProxy|MsSense|csagent|csfalconservice)\.exe$/ nocase

    // Exclude common Windows OS paths for the opener - legitimate OS components
    // opening handles to each other are expected; focus on user-space openers
    not $open.principal.process.file.full_path = /\\Windows\\(System32|SysWOW64)\\/ nocase

    // Exclude known-good admin and security tooling via reference list
    not $open.principal.process.file.full_path in %global_allowed_token_openers

    // Exclude common RMM and management agent paths
    not $open.principal.process.file.full_path = /\\(TeamViewer|AnyDesk|ConnectWise|Kaseya|ScreenConnect)/ nocase

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity    = array_distinct($open.principal.hostname)
    $opener_process    = array_distinct($open.principal.process.file.full_path)
    $target_process    = array_distinct($open.target.process.file.full_path)
    $opener_user       = array_distinct($open.principal.user.userid)

  condition:
    $open
}
