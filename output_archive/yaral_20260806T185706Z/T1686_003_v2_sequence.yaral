/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T18:58:14.849644+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Disable_Then_Network_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage defense impairment pattern: a process disables or modifies the Windows host firewall (via netsh, PowerShell, or registry), followed within 10 minutes by an outbound network connection from the same host. The combination strongly suggests an adversary clearing the path for C2 or lateral movement traffic."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Windows Host Firewall"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) normalised into UDM. Both event types must be present for the correlation to fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT administrators running firewall policy resets via GPO or RMM tools; software installers that temporarily open firewall rules; security scanning products that enumerate firewall state; VPN clients that modify firewall profiles on connect."
    tuning_guidance = "Add known-good admin tool paths to %global_allowed_firewall_admin_tools. Add trusted internal management subnets to %global_trusted_mgmt_subnets. Narrow the PowerShell command-line regex if Set-NetFirewallProfile is used legitimately in your environment."

  events:
    // --- Event 1: Firewall disable / modification command ---
    $fw.metadata.event_type = "PROCESS_LAUNCH"

    // Match netsh advfirewall or PowerShell firewall cmdlets
    (
      (
        $fw.target.process.file.full_path = /\\netsh\.exe$/ nocase
        and
        (
          $fw.target.process.command_line = /advfirewall/ nocase
          and
          (
            $fw.target.process.command_line = /set\s+(all|domain|private|public)profile.*state\s+off/ nocase
            or
            $fw.target.process.command_line = /firewall\s+add\s+rule/ nocase
            or
            $fw.target.process.command_line = /firewall\s+delete\s+rule/ nocase
            or
            $fw.target.process.command_line = /firewall\s+set\s+rule/ nocase
          )
        )
      )
      or
      (
        $fw.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        (
          $fw.target.process.command_line = /Set-NetFirewallProfile/ nocase
          or
          $fw.target.process.command_line = /New-NetFirewallRule/ nocase
          or
          $fw.target.process.command_line = /Remove-NetFirewallRule/ nocase
          or
          $fw.target.process.command_line = /Set-NetFirewallRule/ nocase
          or
          $fw.target.process.command_line = /Disable-NetFirewallRule/ nocase
        )
      )
    )

    not $fw.target.process.file.full_path in %global_allowed_firewall_admin_tools
    $fw.principal.hostname = $hostname

    // --- Event 2: Outbound network connection from the same host ---
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $hostname

    // Exclude RFC-1918 and loopback to focus on external egress
    not $net.target.ip in %global_trusted_mgmt_subnets

    // Exclude common benign high-volume ports to reduce noise
    not $net.target.port = 80
    not $net.target.port = 443
    not $net.target.port = 53

    // Chronological ordering: firewall change must precede the connection
    $fw.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(82)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($fw.principal.hostname)
    $firewall_cmd_process = array_distinct($fw.target.process.file.full_path)
    $firewall_cmd_line = array_distinct($fw.target.process.command_line)
    $outbound_destination_ip = array_distinct($net.target.ip)
    $outbound_destination_port = array_distinct($net.target.port)
    $outbound_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $fw and $net
}
