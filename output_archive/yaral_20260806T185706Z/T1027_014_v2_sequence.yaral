/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:10:10.608017+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Polymorphic_Repeated_Blocked_Outbound_Then_New_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with polymorphic malware on macOS: repeated IDS/IPS blocked outbound connection attempts from a host followed by a successful outbound connection from the same host within a short window. Polymorphic code mutates between attempts to evade signature-based blocking, so the pattern of block-then-succeed from the same source is a strong behavioural indicator."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events, including security_result fields indicating block/alert verdicts and allowed flows. Both blocked and allowed events must be ingested."
    platform = "macOS"
    log_source = "ips"
    false_positives = "Misconfigured applications repeatedly retrying blocked destinations; VPN clients cycling through endpoints; legitimate software updaters hitting CDN nodes that are intermittently blocked by policy; security scanners."
    tuning_guidance = "Add known-good source IP ranges (e.g. corporate update servers, MDM agents) to %macos_allowed_outbound_sources. Add approved external destination CIDRs to %macos_allowed_external_destinations. Raise the blocked-attempt threshold in the match window if false-positive volume is high."

  events:
    // Leg 1: IDS/IPS blocks repeated outbound attempts from the same macOS host.
    // Pre-filter: must be a blocked/alerted verdict, not an internal destination.
    $blocked.metadata.event_type = "NETWORK_CONNECTION"
    (
      $blocked.security_result.action_details = /block/ nocase or
      $blocked.security_result.summary = /block/ nocase or
      $blocked.security_result.severity = /high/ nocase
    )
    not $blocked.target.ip in %macos_allowed_external_destinations
    not $blocked.principal.ip in %macos_allowed_outbound_sources
    $blocked.principal.ip = $src_ip

    // Leg 2: A successful outbound connection from the same host shortly after.
    // Pre-filter: must be an allowed/established flow to an external destination.
    $allowed.metadata.event_type = "NETWORK_CONNECTION"
    not $allowed.security_result.action_details = /block/ nocase
    not $allowed.security_result.summary = /block/ nocase
    not $allowed.target.ip in %macos_allowed_external_destinations
    not $allowed.principal.ip in %macos_allowed_outbound_sources
    $allowed.principal.ip = $src_ip

    // Chronological ordering: blocks precede the successful connection.
    $blocked.metadata.event_timestamp.seconds <= $allowed.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity = array_distinct($src_ip)
    $blocked_destination_ips = array_distinct($blocked.target.ip)
    $allowed_destination_ips = array_distinct($allowed.target.ip)
    $blocked_destination_ports = array_distinct($blocked.target.port)
    $allowed_destination_ports = array_distinct($allowed.target.port)
    $block_count = count($blocked.metadata.id)

  condition:
    $blocked and $allowed
}
