/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:01:22.954878+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Backup_Software_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects enumeration of backup software installations on Windows via process command-line patterns consistent with T1518.002. Adversaries query installed backup products (Veeam, Acronis, Veritas, Backup Exec, Windows Server Backup, etc.) using reg query, wmic, tasklist, dir, or PowerShell Get-WmiObject/Get-CimInstance to identify targets for ransomware pre-staging, data destruction, or inhibiting system recovery."
    mitre_tactic         = "Discovery"
    mitre_technique      = "T1518.002"
    mitre_technique_name = "Software Discovery: Security Software Discovery - Backup Software"
    log_prerequisites    = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "IT administrators auditing backup agent health, backup product self-inventory routines, RMM agents (e.g. ConnectWise, Kaseya) performing asset discovery, SCCM/Intune compliance scans."
    tuning_guidance      = "Add known-good parent processes (backup agent services, RMM agent paths) to %global_allowed_backup_discovery_parents. Scope by principal.user.userid to exclude service accounts that legitimately enumerate backup software."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Enumerate the native discovery binaries most commonly abused for this technique
    $proc.target.process.file.full_path = /\\(reg|wmic|tasklist|cmd|powershell|pwsh|wbadmin|vssadmin)\.exe$/ nocase

    // Match command-line patterns that reference backup product names or backup-related registry/WMI namespaces.
    // Uses alternation so a single regex covers all relevant product families.
    $proc.target.process.command_line = /(veeam|acronis|veritas|backup\s*exec|arcserve|commvault|dpm|windows\s*server\s*backup|wbadmin|vssadmin|shadowcopy|backupassist|paragon|carbonite|idrive|backblaze|cobian|macrium|aomei|storagecraft|shadowprotect|barracuda\s*backup|druva|zerto|cohesity|rubrik|nakivo|unitrends|altaro|cloudberry|msp360|backuppc|ntbackup|wbengine|obengine|veeamtransport|veeamsvc|beserver|pvlsvr|backupagent|afcdpsrv|backupexec|backupservice)/ nocase

    // Exclude known-good parent processes via reference list
    not $proc.principal.process.file.full_path in %global_allowed_backup_discovery_parents

    // Exclude common software deployment / patch management parents that legitimately query installed software
    not $proc.principal.process.file.full_path = /\\(msiexec|trustedinstaller|svchost|services|ccmexec|csc\.exe|msbuild)\.exe$/ nocase

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
