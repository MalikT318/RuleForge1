/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:42:34.001714+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_001_Peripheral_Device_Discovery_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Low"
    description     = "Detects execution of Linux utilities commonly used to enumerate peripheral and hardware devices (USB, PCI, block devices, input devices, cameras, smart card readers). Adversaries use these tools during discovery to profile attached hardware before lateral movement or data exfiltration."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with command-line arguments captured. Auditd syscall rules for execve are sufficient."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "System administrators performing hardware audits, asset inventory scripts, IT support tooling, hardware monitoring daemons (udevadm triggered by udev rules), and software installers probing device capabilities."
    tuning_guidance = "Add known asset-inventory or monitoring parent processes to %linux_allowed_hw_enum_parents. Add authorised admin user accounts to %linux_allowed_hw_enum_users. Raise severity if the executing user is non-interactive or if the parent process is a shell spawned from a web service."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match peripheral/hardware enumeration utilities by binary name or full path.
    // Covers USB (lsusb), PCI (lspci), block/storage (lsblk, blkid, fdisk -l),
    // input devices (xinput, evtest), camera (v4l2-ctl), smart card (pcsc_scan, opensc-tool),
    // general hardware (lshw, dmidecode, hwinfo, inxi), and udev query (udevadm).
    $proc.target.process.file.full_path = /\/(lsusb|lspci|lsblk|blkid|lshw|dmidecode|hwinfo|inxi|udevadm|xinput|evtest|v4l2-ctl|pcsc_scan|opensc-tool)$/ nocase

    // Exclude known benign parent processes that legitimately invoke these tools
    // (udev event handlers, package managers, hardware-monitoring daemons).
    not $proc.principal.process.file.full_path in %linux_allowed_hw_enum_parents

    // Exclude authorised admin or service accounts performing scheduled inventory.
    not $proc.principal.user.userid in %linux_allowed_hw_enum_users

  outcome:
    $risk_score        = max(35)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $executing_user    = array_distinct($proc.principal.user.userid)
    $command_line      = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
