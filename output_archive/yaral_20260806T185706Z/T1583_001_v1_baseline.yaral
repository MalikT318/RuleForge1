/*
  MITRE Technique : T1583.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:18:09.758606+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_001_Lookalike_Domain_Connection_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound network connections to newly observed or lookalike domains exhibiting characteristics consistent with adversary-acquired infrastructure: IDN/punycode encoding, excessive subdomain depth, algorithmically generated hostnames, or single-use domain patterns. These are common traits of domains acquired for phishing, drive-by compromise, or C2 staging."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.001"
    mitre_technique_name = "Acquire Infrastructure: Domains"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with full SNI/hostname visibility on outbound connections. TLS inspection or SNI logging must be enabled for HTTPS traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate internationalized domain names used by global businesses, CDN providers with algorithmically generated edge hostnames, newly registered marketing domains, A/B testing infrastructure."
    tuning_guidance = "Populate %global_allowed_domains with approved business partner and CDN domains. Populate %global_trusted_tlds with approved TLD allowlist if your environment restricts to known-good TLDs. Adjust subdomain depth regex to match your environment's baseline."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match punycode/IDN encoded hostnames (xn-- prefix indicates internationalized label)
    // OR algorithmically generated hostnames (high consonant density, random-looking labels)
    // OR excessive subdomain depth (4+ labels suggesting DGA or single-use domains)
    // OR newly registered TLD abuse patterns
    (
      $net.target.hostname = /xn--/ nocase
      or
      $net.target.hostname = /^[a-z0-9]{12,}\.(com|net|org|info|biz|xyz|top|club|online|site|live|icu|tk|ml|ga|cf|gq)$/ nocase
      or
      $net.target.hostname = /([a-z0-9\-]+\.){4,}/ nocase
      or
      $net.target.hostname = /\.(xyz|top|club|online|site|live|icu|tk|ml|ga|cf|gq|pw|cc|su|ws|mobi|name|biz)$/ nocase
    )

    // Exclude well-known internal and trusted infrastructure
    not $net.target.hostname in %global_allowed_domains

    // Exclude RFC1918 and loopback targets - IPS should not flag internal traffic
    not $net.target.ip in %rfc1918_internal

    // Exclude connections on standard non-web ports that are unlikely to be domain-driven C2
    // Focus on HTTP/HTTPS/DNS-over-HTTPS and common C2 ports
    (
      $net.target.port = 80
      or $net.target.port = 443
      or $net.target.port = 8080
      or $net.target.port = 8443
      or $net.target.port = 53
    )

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $suspicious_destination = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
