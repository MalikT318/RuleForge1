/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:12:00.581403+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Smuggling_Container_File_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects SVG files written to world-writable or temporary directories inside a container workload. SVG smuggling delivers malicious JavaScript payloads embedded in SVG XML; the file artifact (FILE_CREATION) is harder to suppress than command-line arguments. A container writing an SVG to /tmp, /var/tmp, /dev/shm, or a user download staging path is anomalous and warrants investigation."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires container runtime file-activity telemetry forwarded to Chronicle via a Kubernetes or container runtime integration. The integration must populate target.file.full_path and principal.process.file.full_path for FILE_CREATION events originating inside container namespaces."
    platform        = "Linux"
    log_source      = "container"
    false_positives = "Web application containers that legitimately serve or cache SVG assets (e.g., icon libraries, UI frameworks). Data-pipeline containers that process user-uploaded SVG content. CI/CD build containers generating SVG reports or badges."
    tuning_guidance = "Add known-good container image names or workload namespaces to %container_allowed_svg_writers. Narrow the path regex to exclude application-specific asset directories if the false-positive rate is high. Consider raising severity to Critical when the writing process is a shell or interpreter rather than an application binary."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // SVG file written to a world-writable or staging path inside the container
    $file.target.file.full_path = /\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+|home\/[^\/]+\/(Downloads|\.cache|\.local\/share))\/[^\/]*\.svg$/ nocase

    // The writing process is a shell, interpreter, browser engine, or downloader —
    // all common delivery mechanisms for smuggled SVG payloads.
    // Matching on process category rather than a specific binary name survives renames.
    $file.principal.process.file.full_path = /(\/usr\/bin\/|\/usr\/local\/bin\/|\/bin\/|\/opt\/)(bash|sh|dash|zsh|ksh|python[0-9.]*|ruby|perl|node|nodejs|curl|wget|fetch|php|lua[0-9.]*)$/ nocase

    // Exclude known-good container workloads registered by the MSSP
    not $file.principal.process.file.full_path in %container_allowed_svg_writers

    // Exclude paths that are clearly static asset directories (build artefacts)
    not $file.target.file.full_path = /\/(static|assets|public|dist|build)\// nocase

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.017")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dropped_svg_path  = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
