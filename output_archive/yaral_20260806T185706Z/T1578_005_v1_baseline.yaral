/*
  MITRE Technique : T1578.005 - Modify Cloud Compute Configurations
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:17:11.189565+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_005_Cloud_Compute_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modifications to cloud compute configurations that could enable defense evasion or resource abuse, including quota increases, VM size policy changes, region/zone policy relaxations, and subscription-level compute policy modifications. Adversaries abuse these controls to expand available compute for cryptomining or other resource hijacking without exhausting victim quotas."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.005"
    mitre_technique_name = "Modify Cloud Compute Configurations: Modify Cloud Compute Configurations"
    log_prerequisites = "Requires cloud provider audit logs normalized to Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). Events must populate metadata.event_type, principal.user.userid, target.resource.name, and security_result.action_details or target.resource.attribute fields."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate capacity planning requests, authorized infrastructure scaling by cloud ops teams, automated quota management tooling, and approved policy changes during provisioning workflows."
    tuning_guidance = "Add authorized cloud admin user IDs to %cloud_allowed_quota_admins. Add approved automation service accounts to %cloud_allowed_service_accounts. Scope by target.resource.type if your environment uses consistent resource type labeling. Consider raising severity to Critical if the modifying principal is not a known infrastructure account."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Target resource name patterns covering quota, policy, VM size, region, and subscription-level compute config changes
    (
      $cloud.target.resource.name = /quota/ nocase or
      $cloud.target.resource.name = /compute.*policy/ nocase or
      $cloud.target.resource.name = /vm.*size.*policy/ nocase or
      $cloud.target.resource.name = /allowed.*location/ nocase or
      $cloud.target.resource.name = /allowed.*region/ nocase or
      $cloud.target.resource.name = /subscription.*policy/ nocase or
      $cloud.target.resource.name = /tenant.*policy/ nocase or
      $cloud.target.resource.name = /resource.*limit/ nocase or
      $cloud.target.resource.name = /capacity.*reservation/ nocase or
      $cloud.target.resource.name = /service.*limit/ nocase
    )

    // Require an authenticated principal - anonymous modifications are extremely suspicious
    $cloud.principal.user.userid != ""

    // Exclude known authorized quota/policy administrators
    not $cloud.principal.user.userid in %cloud_allowed_quota_admins

    // Exclude known automation service accounts performing routine scaling
    not $cloud.principal.user.userid in %cloud_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1578.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $modified_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
