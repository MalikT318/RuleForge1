/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:31:59.318751+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_1_Ransomware_Mass_File_Extension_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects mass file modification events where files are written with extensions commonly associated with ransomware encryption artifacts, or where known document/data file types are overwritten in rapid succession. This targets the file-system artifact layer rather than process command-line arguments, providing coverage that survives attacker evasion of process-creation logging. Ransomware consistently produces a distinctive pattern of FILE_MODIFICATION events against user-owned document extensions or appends novel encrypted-file extensions."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires EDR or Sysmon file-write telemetry normalised to UDM FILE_MODIFICATION events, including target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate archiving or compression tools (7-Zip, WinRAR) processing large file sets; backup agents writing encrypted vault files; DLP agents renaming files during quarantine; software installers rewriting application data."
    tuning_guidance = "Add known backup agent and archiving process paths to %global_allowed_encryption_writers. Add approved encrypted-vault directories to %global_allowed_encrypted_paths. If a specific extension pattern causes noise from a sanctioned tool, add that process to the exclusion list rather than weakening the extension regex."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target file path must be in a user-writable location typical of ransomware impact zones.
    // Matches paths under Users\<any username>\ or common shared/data directories.
    $file.target.file.full_path = /\\(Users|Public|Shared|Documents|Desktop|Downloads|AppData\\Roaming|AppData\\Local)\\/ nocase

    // Detect either:
    //   (a) Files whose extension has been replaced with a novel encrypted-blob extension
    //       (ransomware appended or replaced extension - common pattern across families),
    //   OR
    //   (b) High-value document types being overwritten in place (encrypted in-situ).
    // Encrypted-blob extensions: generic patterns ransomware families use (.enc, .locked,
    // .crypt, .crypted, .encrypted, .pay2decrypt, .ransom, .ryk, .conti, .hive,
    // .blackcat, .zeppelin, .phobos, .dharma, .stop, .djvu, .lck, .WNCRY, .wcry,
    // .wncryt, .onion, .fun, .sage, .globe, .cerber, .locky, .zepto, .odin,
    // .thor, .aesir, .zzzzz, .osiris, .diablo6, .wallet, .arena, .java, .arrow,
    // .bip, .combo, .gamma, .monro, .boost, .audit, .cezar, .cesar, .java,
    // .id-*, .readme, .ReadMe, .HELP, .HOW_TO, .DECRYPT, .RESTORE).
    // We use a broad regex covering the structural pattern rather than enumerating
    // every known extension, so the rule survives new ransomware families.
    (
      $file.target.file.full_path = /\.(enc|locked|crypt|crypted|encrypted|ransom|lck|wncry|wcry|wncryt|onion|fun|sage|cerber|locky|zepto|odin|thor|aesir|osiris|wallet|arena|bip|combo|gamma|boost|audit|cezar|cesar|ryk|hive|zeppelin|phobos|djvu|stop|pay2decrypt|readme|DECRYPT|RESTORE|HOW_TO|HELP)$/ nocase
      or
      // In-situ overwrite of high-value document types by a non-owning process
      $file.target.file.full_path = /\.(docx?|xlsx?|pptx?|pdf|jpg|jpeg|png|bmp|gif|tiff?|mp4|mov|avi|mkv|zip|rar|7z|tar|gz|bak|sql|mdb|accdb|pst|ost|vhd|vhdx|vmdk|vmx|csv|txt|xml|json|py|js|cs|cpp|java|rb|php|go|rs|ts|sh|ps1|psm1|psd1)$/ nocase
    )

    // The writing process must NOT be a known legitimate system process.
    // Exclude Windows own file-system components and indexing services.
    not $file.principal.process.file.full_path = /\\(SearchIndexer|MsMpEng|SenseIR|WerFault|svchost|TiWorker|TrustedInstaller|msiexec|OneDrive|Dropbox|GoogleDriveFS|BackupService|robocopy|xcopy|expand)\.exe$/ nocase

    // Exclude known-good backup and archiving writers via reference list.
    not $file.principal.process.file.full_path in %global_allowed_encryption_writers

    // Exclude known-good encrypted-vault or backup output directories.
    not $file.target.file.full_path in %global_allowed_encrypted_paths

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $affected_file = array_distinct($file.target.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
