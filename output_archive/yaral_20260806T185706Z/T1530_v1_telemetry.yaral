/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:32:43.128240+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_001_CloudStorage_BulkFileAccess_OfficeSuite {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Threshold"
    severity        = "High"
    description     = "Detects a single user accessing an unusually large number of cloud storage objects (OneDrive / SharePoint / Google Drive) within a short window. Bulk file access is a strong indicator of data collection from cloud storage, particularly when the accessing account is not a known service account or backup agent. This rule fires at the USER_RESOURCE_ACCESS layer rather than on process creation, providing coverage that is orthogonal to command-line-based detections."
    mitre_tactic    = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Requires Microsoft 365 unified audit log events normalised to UDM USER_RESOURCE_ACCESS. SharePoint / OneDrive FileAccessed and FileDownloaded operations must be ingested. Google Workspace Drive audit events also satisfy this rule when normalised to the same UDM event type."
    platform        = "Office Suite"
    log_source      = "m365"
    false_positives = "Backup agents, DLP scanning services, migration tooling, bulk-download scripts run by IT administrators, and e-discovery jobs. Exclude known service accounts and approved admin identities via reference lists."
    tuning_guidance = "Lower the threshold count if the environment has strict DLP controls. Raise it for organisations with heavy legitimate bulk-download workflows. Add known backup or migration service account UPNs to %cloud_storage_allowed_bulk_accounts. Add approved internal application identifiers to %cloud_storage_allowed_app_ids."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target must be a cloud storage resource (OneDrive, SharePoint, Drive)
    // Match on resource type or URL patterns that indicate file/document objects
    (
      $access.target.resource.resource_type = "STORAGE_OBJECT"
      or
      $access.target.url = /\/(personal|sites|drives|documents|files)\// nocase
      or
      $access.target.resource.name = /\.(docx?|xlsx?|pptx?|pdf|csv|zip|tar|gz|json|xml|txt|msg|eml)$/ nocase
    )

    // Must have an authenticated user identity
    $access.principal.user.userid != ""
    $access.principal.user.userid = $userid

    // Exclude known bulk-access service accounts and approved applications
    not $access.principal.user.userid in %cloud_storage_allowed_bulk_accounts
    not $access.principal.application in %cloud_storage_allowed_app_ids

    // Exclude internal automation that legitimately reads many files
    not $access.principal.user.userid = /svc[-_]|bot[-_]|backup[-_]|scan[-_]|dlp[-_]/ nocase

  match:
    $userid over 10m

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1530")
    $primary_entity    = array_distinct($access.principal.user.userid)
    $accessed_resources = count($access.target.resource.name)
    $distinct_resources = array_distinct($access.target.resource.name)
    $source_ips        = array_distinct($access.principal.ip)
    $user_agent        = array_distinct($access.network.http.user_agent)

  condition:
    // Require at least 50 distinct file-access events in the 10-minute window
    // to distinguish bulk collection from normal browsing
    #access >= 50
}
