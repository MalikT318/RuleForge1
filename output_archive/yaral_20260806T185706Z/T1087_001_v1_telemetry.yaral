/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:28:25.847676+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_ESXi_Account_File_Read_Enumeration {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects access to ESXi local account configuration files (passwd, shadow, local.sh) that an adversary would read to enumerate local user accounts. This targets the file-read artifact produced by account enumeration rather than the command line, providing coverage that survives command-line log evasion."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "Requires ESXi shell/hostd file-access telemetry normalised into Chronicle UDM FILE_READ events. Syslog forwarding from ESXi hostd or auditd-equivalent must be enabled and ingested via the vmware_esxi log source."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "ESXi health-check scripts, authorised configuration management agents (e.g. vSphere Lifecycle Manager), backup agents reading host configuration, and scheduled compliance audits."
    tuning_guidance = "Add known-good automation service accounts to %esxi_allowed_config_readers. If a specific monitoring process path is noisy, add it to %esxi_allowed_monitor_processes. Raise severity to High if the reading process is an interactive shell session rather than a known daemon."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target the canonical ESXi local account and authentication files.
    // /etc/passwd  - local account list
    // /etc/shadow  - local password hashes (deeper enumeration)
    // /etc/local.sh and /etc/vmware/config - may contain embedded credentials or account config
    // /etc/pam.d/  - PAM configuration revealing auth stack
    $file.target.file.full_path = /^\/(etc\/(passwd|shadow|group|gshadow|local\.sh)|etc\/vmware\/(config|hostd\/localAccounts\.xml)|etc\/pam\.d\/)/ nocase

    // Restrict to processes that are not the expected system daemons.
    // Legitimate ESXi daemons (hostd, authd, crond) read these files at startup;
    // interactive or scripted enumeration typically comes from shell interpreters,
    // esxcli wrappers, or Python/Perl interpreters invoked ad-hoc.
    $file.principal.process.file.full_path = /(sh|bash|ash|python[23]?|perl|esxcli|busybox)$/ nocase

    // Exclude known-good automation accounts and monitoring processes.
    not $file.principal.user.userid in %esxi_allowed_config_readers
    not $file.principal.process.file.full_path in %esxi_allowed_monitor_processes

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity    = array_distinct($file.principal.hostname)
    $accessed_file     = array_distinct($file.target.file.full_path)
    $reading_process   = array_distinct($file.principal.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
