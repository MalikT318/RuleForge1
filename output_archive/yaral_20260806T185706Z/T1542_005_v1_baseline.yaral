/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:05:56.552661+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_TFTP_Boot_Unauthorized_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects TFTP traffic (UDP/69) originating from or destined to a network device that is not an approved management server. Adversaries abuse TFTP netbooting to load a modified or malicious OS image onto network devices at boot time, enabling persistent backdoors and configuration tampering. This rule fires on any TFTP flow observed by an IDS/IPS sensor where the source or destination is not in the approved TFTP server reference list."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Requires IDS/IPS or network security appliance flow/connection telemetry with UDP port visibility. TFTP uses UDP/69. Sensor must be positioned to observe management-plane traffic between network devices and management servers."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Legitimate network device image deployments from authorized TFTP servers during scheduled maintenance windows. PXE boot infrastructure for servers sharing the same UDP/69 port. Authorized network operations center (NOC) provisioning workflows."
    tuning_guidance = "Populate %approved_tftp_servers with all authorized TFTP/netboot server IPs used in each client environment. Populate %approved_network_device_subnets to restrict the rule to management-plane address space. Consider time-windowing alerts to flag TFTP outside approved maintenance windows."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.principal.ip in %approved_tftp_servers
    not $net.target.ip in %approved_tftp_servers
    $net.principal.ip in %approved_network_device_subnets

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity = array_distinct($net.principal.ip)
    $tftp_target_ip = array_distinct($net.target.ip)
    $observed_port = max($net.target.port)

  condition:
    $net
}
