/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:08:20.274061+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_Code_Signing_Policy_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Windows code signing policy settings via registry changes. Adversaries disable Driver Signature Enforcement (DSE) or enable test-signing mode to permit execution of unsigned or self-signed drivers and code. Key registry indicators include enabling TESTSIGNING, disabling DSE via BCD-equivalent registry values, or weakening DLL signing enforcement policies."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires Windows registry modification telemetry from EDR (e.g., Sysmon Event ID 13) or equivalent endpoint agent normalised to UDM REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Kernel/driver developers enabling test-signing on development workstations, software vendors running signed driver test pipelines, IT administrators configuring application control policies via GPO."
    tuning_guidance = "Add known developer or build-server hostnames to %global_allowed_testsigning_hosts. Add authorised admin accounts to %global_allowed_codesign_policy_modifiers. Scope to servers or production endpoints first for highest fidelity."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Match registry keys governing code signing enforcement on Windows.
    // Covers: TESTSIGNING BCD policy, DSE CodeIntegrity policy, DLL signing enforcement,
    // and WHQL/driver signing policy under Windows NT.
    (
      // BCD-equivalent: TESTSIGNING or NOINTEGRITYCHECKS boot options stored in registry
      $reg.target.registry.registry_key = /\\BCD00000000\\Objects\\.*\\Elements\\/i nocase or

      // Code Integrity policy - controls DSE and HVCI enforcement
      $reg.target.registry.registry_key = /\\CurrentControlSet\\Control\\CI\\/ nocase or

      // System-wide code integrity / driver signing policy
      $reg.target.registry.registry_key = /\\CurrentControlSet\\Control\\Session Manager\\/ nocase or

      // Windows NT policy for driver signing behaviour
      $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\(Winlogon|Image File Execution Options)/ nocase or

      // Application control / DLL signing enforcement
      $reg.target.registry.registry_key = /\\Policies\\Microsoft\\Windows\\(SrpV2|SAFER|DeviceGuard)/ nocase
    )

    // Match value names or data that indicate weakening of signing enforcement
    (
      $reg.target.registry.registry_value_name = /TestSigning/ nocase or
      $reg.target.registry.registry_value_name = /NoIntegrityChecks/ nocase or
      $reg.target.registry.registry_value_name = /HypervisorEnforcedCodeIntegrity/ nocase or
      $reg.target.registry.registry_value_name = /EnableVirtualizationBasedSecurity/ nocase or
      $reg.target.registry.registry_value_name = /CodeIntegrity/ nocase or
      $reg.target.registry.registry_value_name = /DriverSigningPolicy/ nocase or
      $reg.target.registry.registry_value_name = /NonDriverSigningPolicy/ nocase or
      $reg.target.registry.registry_value_name = /BehaviorOnFailedVerification/ nocase or
      $reg.target.registry.registry_value_name = /EnforceKernelModeCodeIntegrity/ nocase
    )

    // Exclude known authorised hosts and accounts performing legitimate policy management
    not $reg.principal.hostname in %global_allowed_testsigning_hosts
    not $reg.principal.user.userid in %global_allowed_codesign_policy_modifiers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)
    $acting_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
