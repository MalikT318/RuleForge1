/*
  MITRE Technique : T1553.001 - Gatekeeper Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:06:33.279805+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_001_Gatekeeper_Bypass_Quarantine_Xattr_Removal {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects DNS queries consistent with command-and-control or exfiltration activity on macOS endpoints that may be associated with Gatekeeper bypass operations. Adversaries who bypass Gatekeeper (T1553.001) by stripping the com.apple.quarantine extended attribute from downloaded payloads frequently establish C2 channels shortly after execution. This rule targets high-entropy subdomains, abnormally long labels, and uncommon DNS record types (TXT/NULL) that are hallmarks of DNS-based C2 and data exfiltration, regardless of the initiating process."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1553.001"
    mitre_technique_name = "Subvert Trust Controls: Gatekeeper Bypass"
    log_prerequisites = "Requires DNS query and resolver logs normalised into Chronicle UDM NETWORK_DNS events. Recursive resolver or DNS security gateway logs are preferred. No endpoint process telemetry is required."
    platform        = "macOS"
    log_source      = "dns"
    false_positives = "CDN health-check subdomains, cloud-provider internal resolvers, legitimate analytics beaconing, DGA-style subdomains used by some SaaS vendors, encrypted DNS providers with long labels."
    tuning_guidance = "Add known-good high-entropy domains (CDN, SaaS, analytics) to %global_allowed_dns_domains. Raise the subdomain length threshold or restrict to TXT/NULL record types only if false-positive volume is high. Consider pairing with endpoint telemetry showing xattr removal via xattr -d or com.apple.quarantine manipulation."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Target suspicious DNS record types used for C2 tunnelling (TXT=16, NULL=10)
    // OR match on structural anomalies in the queried name regardless of record type
    (
      $dns.network.dns.questions.type = 16 or   // TXT
      $dns.network.dns.questions.type = 10       // NULL
    )

    // Detect abnormally long subdomain labels (>= 45 chars before the first dot)
    // which are characteristic of DNS tunnelling and DGA beaconing
    $dns.network.dns.questions.name = /^[a-z0-9\-]{45,}\./  nocase

    // Exclude known-good domains tracked in the MSSP reference list
    not $dns.network.dns.questions.name in %global_allowed_dns_domains

    // Exclude common internal / RFC-reserved TLDs that would never be C2
    not $dns.network.dns.questions.name = /\.(local|internal|corp|lan|arpa)$/ nocase

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1553.001")
    $primary_entity    = array_distinct($dns.principal.hostname)
    $queried_domains   = array_distinct($dns.network.dns.questions.name)
    $dns_record_types  = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
