/*
  MITRE Technique : T1584.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:20:55.358343+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_004_Compromised_Server_C2_Beacon_Pattern {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network connection patterns consistent with compromised third-party servers being used for C2 staging or relay. Focuses on high-frequency, low-variance outbound connections to non-standard ports on external hosts, a hallmark of beaconing through a compromised intermediary server. IDS/IPS telemetry is used to identify repeated blocked or alerted connections that suggest an adversary leveraging a compromised server as infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.004"
    mitre_technique_name = "Compromise Infrastructure: Server"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalized to UDM NETWORK_CONNECTION events. Appliance must log repeated connection attempts including destination port and alert/block verdicts."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate high-frequency polling applications, monitoring agents, CDN health checks, software update services connecting to non-standard ports, and VPN concentrators."
    tuning_guidance = "Add known-good external polling destinations to %global_allowed_external_polling_hosts. Add approved non-standard service ports to %global_allowed_nonstandard_ports. Raise the threshold or narrow the port range if false-positive volume is high in environments with heavy SaaS usage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target non-standard ports commonly abused for C2 relay through compromised servers.
    // Excludes well-known service ports (80, 443, 22, 25, 53, 8080, 8443) to reduce noise.
    // Focuses on high-numbered or unusual ports indicative of adversary-controlled listeners.
    (
      $net.target.port >= 1024 and
      $net.target.port <= 65535 and
      not $net.target.port = 8080 and
      not $net.target.port = 8443 and
      not $net.target.port = 3389 and
      not $net.target.port = 5985 and
      not $net.target.port = 5986
    )

    // Exclude RFC1918 private address space - compromised servers are external infrastructure.
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external destinations approved for this port range.
    not $net.target.ip in %global_allowed_external_polling_hosts

    // Exclude approved non-standard service ports (e.g., custom SaaS, approved VPN endpoints).
    not $net.target.port in %global_allowed_nonstandard_ports

    // Require a source host to anchor the detection to an internal asset.
    $net.principal.hostname != ""

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
