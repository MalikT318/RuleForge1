/*
  MITRE Technique : T1496 - Resource Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:56:42.747377+00:00
  Reference       : https://attack.mitre.org/techniques/T1496
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_SaaS_Resource_Hijacking_Compute_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects anomalous cloud resource creation activity consistent with resource hijacking - specifically the rapid or bulk creation of compute, messaging, or network resources via cloud control-plane APIs. Adversaries who compromise cloud credentials frequently spin up large numbers of instances, enable messaging services, or provision bandwidth-heavy resources to mine cryptocurrency, proxy traffic, or send spam at scale."
    mitre_tactic = "Impact"
    mitre_technique = "T1496"
    mitre_technique_name = "Resource Hijacking"
    log_prerequisites = "Requires cloud provider audit logs (e.g. CloudTrail, Azure Activity Log, GCP Audit Log) normalised into Chronicle UDM. RESOURCE_CREATION events must be populated with target.resource.type and principal.user.userid."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate infrastructure-as-code pipelines (Terraform, Pulumi, CDK), auto-scaling events, CI/CD deployment jobs, and authorised bulk provisioning by cloud admins."
    tuning_guidance = "Add known automation service accounts and CI/CD principals to %cloud_allowed_provisioning_principals. Add approved resource types to %cloud_allowed_bulk_resource_types. Narrow target.resource.type regex to the resource families observed in your environment."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target high-cost or abuse-prone resource types: compute instances,
    // GPU/accelerator instances, messaging topics/queues, VPN/NAT gateways.
    // Regex is intentionally broad to survive vendor normalisation differences.
    $cloud.target.resource.type = /instance|vm|compute|gpu|accelerat|function|lambda|messaging|topic|queue|gateway|nat|vpn|relay|sms|email|send/ nocase

    // Require an authenticated principal - anonymous creation is a separate signal.
    $cloud.principal.user.userid != ""

    // Exclude known-good automation accounts and deployment pipelines.
    not $cloud.principal.user.userid in %cloud_allowed_provisioning_principals

    // Exclude resource types explicitly approved for bulk provisioning.
    not $cloud.target.resource.type in %cloud_allowed_bulk_resource_types

    // Exclude activity originating from known internal CIDR ranges / jump hosts
    // (reference list contains approved source IPs in CIDR notation).
    not $cloud.principal.ip in %cloud_trusted_admin_ips

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1496")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_type_created = array_distinct($cloud.target.resource.type)
    $source_ip = array_distinct($cloud.principal.ip)
    $target_resource_name = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
