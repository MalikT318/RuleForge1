/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:51:45.382670+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Socket_Filter_Backdoor_Traffic_Anomaly {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network traffic patterns consistent with socket-filter-based backdoors (T1205.002) observed at the IDS/IPS layer. Adversaries using libpcap or SO_ATTACH_FILTER install BPF socket filters that listen for a crafted trigger packet on a raw or promiscuous socket. The resulting traffic is characterised by unusual protocol/port combinations, unexpected ICMP payloads, or low-volume single-packet flows to non-standard ports that match known trigger-packet profiles. This rule targets the network-observable side of that mechanism: anomalous inbound flows to macOS hosts that an IDS/IPS flags as suspicious or that exhibit the structural hallmarks of a knock/trigger packet."
    mitre_tactic    = "Defense Evasion, Persistence, Command and Control"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised into Chronicle UDM. The appliance must inspect layer-3/4 traffic and generate flow or connection records. Deep-packet inspection improves fidelity."
    platform        = "macOS"
    log_source      = "ips"
    false_positives = "Network monitoring tools performing ICMP probes, legitimate raw-socket applications (Wireshark, tcpdump on management hosts), custom health-check packets from load balancers, ICMP-based VPN keepalives."
    tuning_guidance = "Add known management source CIDRs to %allowed_raw_socket_sources. Add sanctioned monitoring host IPs to %allowed_network_probe_hosts. Raise the threshold or restrict to inbound direction if internal scanners generate noise."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target must be an internal macOS endpoint (non-routable destination
    // indicates the IDS is inspecting traffic destined for an internal host).
    $net.target.ip in %internal_mac_endpoints

    // Source must not be a known-good probe or management system.
    not $net.principal.ip in %allowed_raw_socket_sources
    not $net.principal.ip in %allowed_network_probe_hosts

    // Socket-filter backdoors are commonly triggered via:
    //   - ICMP with non-standard type/code combinations (knock packets)
    //   - UDP to high/ephemeral ports with minimal payload
    //   - TCP SYN to ports that are not in the host's legitimate service list
    // IDS/IPS appliances normalise the IP protocol number into network.ip_protocol.
    // Match ICMP (1), raw UDP (17), or TCP (6) trigger-style flows.
    $net.network.ip_protocol = /^(ICMP|UDP|TCP)$/ nocase

    // Trigger packets are characteristically tiny - a single crafted frame.
    // network.sent_bytes captures payload bytes reported by the appliance.
    // Legitimate bulk flows are excluded; knock packets are typically < 128 bytes.
    $net.network.sent_bytes < 128

    // Restrict to high-numbered or non-standard destination ports that are
    // not associated with well-known services. Ports 0-1023 are excluded
    // because legitimate services there are easier to baseline.
    // Ports in the ephemeral range (32768-60999) are common trigger targets.
    $net.target.port >= 1024

    // Exclude common high-volume legitimate high ports to reduce noise.
    // 8080/8443 = web proxies, 5900 = VNC, 3389 = RDP (unlikely on macOS but
    // included for portability), 5000 = AirPlay, 7000 = AirPlay alternate.
    not $net.target.port in [8080, 8443, 5900, 3389, 5000, 7000, 443, 80]

    // The IDS/IPS should have raised at least an informational alert or
    // anomaly verdict. We avoid relying solely on security_result.action
    // (inconsistently mapped) but use security_result.severity as a
    // secondary signal when populated.
    // This predicate is intentionally loose (>= LOW) to remain portable
    // across vendors whose UDM mapping varies.
    $net.security_result.severity >= "LOW"

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity    = array_distinct($net.target.ip)
    $source_ip         = array_distinct($net.principal.ip)
    $destination_port  = array_distinct($net.target.port)
    $ip_protocol       = array_distinct($net.network.ip_protocol)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
