/*
  MITRE Technique : T1136.003 - Cloud Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:45:49.822870+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_003_Cloud_Account_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new cloud user or service account in an identity provider directory. Adversaries create cloud accounts to establish persistent secondary access without deploying remote access tools. Fires on USER_CREATION events from M365 unified audit logs, covering both user accounts and service principals."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.003"
    mitre_technique_name = "Create Account: Cloud Account"
    log_prerequisites = "Requires Microsoft 365 unified audit logs with AzureActiveDirectory workload enabled. Audit log category: UserManagement / ServicePrincipalManagement."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Legitimate IT provisioning workflows, HR onboarding automation, service account creation by authorized DevOps pipelines, break-glass account creation by identity administrators."
    tuning_guidance = "Add authorized provisioning service accounts and admin user IDs to %m365_allowed_account_provisioners. Add known automation principals to %m365_allowed_automation_principals. Consider scoping to off-hours creation or creation by non-admin roles for higher fidelity."

  events:
    $cloud.metadata.event_type = "USER_CREATION"
    // Require a principal actor - suppress system-initiated provisioning noise
    $cloud.principal.user.userid != ""
    // Newly created account must have an identity
    $cloud.target.user.userid != ""
    // Exclude self-registration flows (principal and target are the same account)
    $cloud.principal.user.userid != $cloud.target.user.userid
    // Exclude known authorized provisioning actors and automation service accounts
    not $cloud.principal.user.userid in %m365_allowed_account_provisioners
    not $cloud.principal.user.email_addresses in %m365_allowed_automation_principals
    // Optionally exclude guest/external account creation if those are expected at volume
    // (remove this line if guest account creation should also alert)
    not $cloud.target.user.account_type = "CLOUD_ACCOUNT_TYPE_UNSPECIFIED"

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1136.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $created_account = array_distinct($cloud.target.user.userid)
    $created_account_email = array_distinct($cloud.target.user.email_addresses)
    $actor_email = array_distinct($cloud.principal.user.email_addresses)

  condition:
    $cloud
}
