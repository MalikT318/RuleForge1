/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:34:21.425173+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_ESXi_Protocol_Impersonation_Suspicious_Network_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes on ESXi hosts that are not expected network daemons but are initiating outbound connections on well-known protocol ports (443, 80, 53, 25), which may indicate C2 traffic disguised as legitimate protocol traffic via protocol or service impersonation."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised into Chronicle UDM PROCESS_LAUNCH events, including command_line and parent process fields. ESXi syslog forwarding to Chronicle must be enabled."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate ESXi management agents (hostd, vpxa, sfcbd) making outbound connections; authorised vSphere automation scripts; backup agents using HTTPS; VMware update processes."
    tuning_guidance = "Add known-good ESXi management process paths to %esxi_allowed_network_processes. Add authorised automation script paths to %esxi_allowed_admin_scripts. Narrow the port list if specific protocol impersonation variants are observed in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target processes that are shells, scripting runtimes, or generic binaries
    // on ESXi that should not be initiating protocol-level outbound connections
    $proc.target.process.file.full_path = /\/(sh|ash|busybox|python|perl|nc|ncat|socat|openssl|wget|curl|esxcli|vim-cmd)$/ nocase

    // Command line contains connection-oriented flags or protocol-mimicking arguments
    // targeting well-known service ports used for impersonation
    (
      $proc.target.process.command_line = /\b(443|8443|80|8080|53|25|587|993|995)\b/ nocase or
      $proc.target.process.command_line = /(-connect|-ssl|-tls|s_client|starttls|https?:\/\/|smtps?:\/\/|imaps?:\/\/)/ nocase
    )

    // Exclude known legitimate ESXi management parent processes
    not $proc.principal.process.file.full_path = /\/(hostd|vpxa|sfcbd|rhttpproxy|vmsyslogd|esxupdate|vmware-fdm)$/ nocase

    // Exclude known-good process paths via reference list for multi-tenant tuning
    not $proc.target.process.file.full_path in %esxi_allowed_network_processes

    // Exclude authorised admin scripts
    not $proc.principal.process.file.full_path in %esxi_allowed_admin_scripts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $suspicious_process = array_distinct($proc.target.process.file.full_path)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
