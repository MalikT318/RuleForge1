/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:55:59.699266+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_Container_Webroot_Defacement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of web-served content (HTML, JS, CSS, images) inside a running container, which is a strong indicator of web defacement. Legitimate containers should not write to webroot at runtime; content should be baked into the image or mounted read-only."
    mitre_tactic = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "Requires container runtime file-activity telemetry normalised into Chronicle UDM FILE_MODIFICATION or FILE_CREATION events with target.file.full_path and principal.process populated."
    platform = "Linux"
    log_source = "container"
    false_positives = "CMS platforms (WordPress, Drupal) that write theme or plugin files at runtime; CI/CD build containers that compile static assets in-place; content-management sidecars that legitimately update web assets."
    tuning_guidance = "Add known CMS or build container image names / namespaces to %allowed_webroot_writers. Scope further by excluding specific Kubernetes namespaces used for CI/CD workloads."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target web-served content extensions commonly defaced
    $file.target.file.full_path = /\.(html?|php|js|css|svg|png|jpg|jpeg|gif|ico|xml|json|txt)$/ nocase

    // Match common Linux webroot paths used in containerised web servers
    $file.target.file.full_path = /(\/var\/www\/|\/usr\/share\/nginx\/|\/usr\/local\/apache2\/htdocs\/|\/srv\/www\/|\/app\/public\/|\/app\/static\/|\/opt\/app\/|\/home\/[^\/]+\/public_html\/)/ nocase

    // The writing process should not be a known legitimate package manager or init process
    not $file.principal.process.file.full_path = /\/(apt|dpkg|rpm|yum|dnf|pip|npm|yarn|composer|cargo|gem|go)$/ nocase

    // Exclude known safe orchestration and init paths
    not $file.principal.process.file.full_path = /\/(systemd|init|containerd|dockerd|runc|crio|kubelet)$/ nocase

    // Exclude allowed writer processes defined per-client
    not $file.principal.process.file.full_path in %allowed_webroot_writers

    // Exclude allowed namespaces or container labels surfaced in resource name
    not $file.principal.namespace in %allowed_webroot_namespaces

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
