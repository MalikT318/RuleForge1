/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:15:13.582069+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Systemctl_Service_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects suspicious use of systemctl to start, enable, or reload services from anomalous parent processes such as shells, scripting interpreters, or processes running from world-writable directories. Adversaries abuse systemctl to execute malicious systemd service units for persistence or lateral execution."
    mitre_tactic    = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events, including parent process path and full command line."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate system administrators running systemctl interactively, configuration management tools (Ansible, Puppet, Chef), software package post-install scripts, container orchestration agents, monitoring daemons."
    tuning_guidance = "Add trusted parent process paths (e.g. configuration management agent binaries) to %linux_allowed_systemctl_parents. Add known-good service unit names to %linux_allowed_service_units to suppress package-manager-driven starts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be systemctl
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/systemctl$/ nocase

    // Restrict to subcommands that cause execution or persistence changes
    $proc.target.process.command_line = /(start|enable|restart|reload|daemon-reload|link)/ nocase

    // Suspicious parent: interactive shells, scripting interpreters, or binaries
    // running from world-writable or temporary locations
    $proc.principal.process.file.full_path = /(\/bin\/(bash|sh|dash|zsh|ksh|fish)|\/usr\/bin\/(python[23]?|perl|ruby|php|node|lua)|\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/user\/)/ nocase

    // Exclude known-safe parent processes and service unit names via reference lists
    not $proc.principal.process.file.full_path in %linux_allowed_systemctl_parents
    not $proc.target.process.command_line in %linux_allowed_service_units

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line   = array_distinct($proc.target.process.command_line)
    $target_user    = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
