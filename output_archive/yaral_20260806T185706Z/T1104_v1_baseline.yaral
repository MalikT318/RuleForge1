/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:41:11.445478+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_MultiStage_C2_Sequential_External_Connections {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable behaviour consistent with multi-stage C2 channels: a host makes repeated outbound connections to distinct external destinations over non-standard or dual-use ports within a short window. Multi-stage implants typically beacon to a first-stage server, receive a second-stage payload URL, then pivot to a new external host. This rule fires on a single high-volume or high-distinct-destination flow event that matches the pattern, relying solely on firewall/perimeter telemetry."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Logs must populate principal.ip, target.ip, target.port, and network.sent_bytes or network.received_bytes."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Software update services (e.g., CDN-backed update infrastructure), cloud sync clients, video conferencing tools, legitimate SaaS agents that contact multiple endpoints. Tune by adding known-good source IPs or destination port ranges to the reference lists."
    tuning_guidance = "Add approved internal source subnets to %firewall_internal_src_exclusions. Add sanctioned high-fan-out service IPs to %firewall_allowed_external_destinations. Raise the sent_bytes threshold if update traffic triggers false positives."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal host (not itself an external IP)
    not $net.principal.ip in %firewall_internal_src_exclusions

    // Destination must be external - exclude RFC-1918 and loopback ranges
    not $net.target.ip in %rfc1918_internal_ranges

    // Target port: focus on ports commonly abused by multi-stage implants
    // (443, 80 are included because stage-2 pivots often reuse HTTPS/HTTP;
    //  non-standard ports 4444, 8080, 8443, 1080, 8888 are also common)
    (
      $net.target.port = 443  or
      $net.target.port = 80   or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 4444 or
      $net.target.port = 1080 or
      $net.target.port = 8888
    )

    // Payload size heuristic: small outbound bytes typical of a beacon/check-in
    // followed by a larger inbound transfer (stage-2 download).
    // A single flow with low sent bytes but meaningful received bytes
    // suggests a command poll that retrieved a payload.
    $net.network.sent_bytes > 0
    $net.network.received_bytes >= 50000

    // Exclude known-good high-fan-out destinations (CDNs, update servers, etc.)
    not $net.target.ip in %firewall_allowed_external_destinations

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity    = array_distinct($net.principal.ip)

  condition:
    $net
}
