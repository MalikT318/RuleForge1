/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:06:15.181935+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_001_macOS_Quarantine_Attribute_Removal_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable behaviour consistent with macOS Gatekeeper/quarantine subversion: outbound connections to uncommon high ports or non-standard protocols that may deliver unsigned or quarantine-stripped payloads. Adversaries bypassing macOS trust controls often stage payloads via direct TCP/UDP to high ports, avoiding standard HTTP/HTTPS inspection. This rule flags high-volume or high-port outbound flows from internal hosts to external destinations that are not in the approved egress list."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553"
    mitre_technique_name = "Subvert Trust Controls"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised to Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION. Logs must populate target.port, target.ip, network.ip_protocol, and network.sent_bytes."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Legitimate developer tooling (Homebrew, Xcode), VPN clients using non-standard ports, authorised software update channels, CDN delivery over alternate ports."
    tuning_guidance = "Add approved high-port egress destinations to %macos_approved_egress_destinations. Add known developer or update service IP ranges to %macos_approved_update_ranges. Lower the sent_bytes threshold if you observe smaller payload staging in your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Outbound only - principal is the internal initiating host
    not $net.principal.ip in %macos_approved_update_ranges
    not $net.target.ip in %macos_approved_update_ranges
    not $net.target.ip in %rfc1918_internal

    // Exclude approved egress destinations (CDN, known update services)
    not $net.target.ip in %macos_approved_egress_destinations

    // Focus on non-standard ports commonly used to stage payloads
    // bypassing Gatekeeper inspection (not 80/443/8080/8443)
    (
      $net.target.port >= 1024 and
      $net.target.port != 8080 and
      $net.target.port != 8443 and
      $net.target.port != 8888 and
      $net.target.port != 9090
    )

    // Exclude well-known trusted service ports
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 22
    $net.target.port != 21
    $net.target.port != 25
    $net.target.port != 53
    $net.target.port != 123
    $net.target.port != 587
    $net.target.port != 993
    $net.target.port != 995

    // Payload staging typically involves meaningful data transfer
    // Filter noise from keepalives and empty SYN-only flows
    $net.network.sent_bytes > 50000

    // Restrict to TCP - unsigned binary delivery is not UDP-based
    $net.network.ip_protocol = "TCP"

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1553")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
