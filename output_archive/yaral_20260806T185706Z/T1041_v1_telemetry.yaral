/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:31:08.599395+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_001_C2_Exfil_Sustained_Outbound_Flow {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects sustained high-volume outbound network flows to non-internal destinations that are consistent with data exfiltration over an existing C2 channel. Adversaries encoding stolen data into C2 traffic produce anomalously large outbound byte counts on long-lived connections to external hosts. This rule fires on a single flow record whose outbound bytes exceed a threshold, providing coverage orthogonal to process-creation detections."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "Requires firewall or perimeter flow logs that populate network_bytes_sent (or equivalent UDM field) per flow record. Ensure the log source exports per-session byte counters, not just connection allow/deny events."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Legitimate cloud backup agents (Time Machine to cloud, Backblaze, Carbonite), software update distribution, large file uploads to SaaS platforms (Dropbox, OneDrive, Google Drive), video-conferencing screen-share sessions, CI/CD artifact pushes."
    tuning_guidance = "Add known-good external destination CIDRs or IP ranges to %global_allowed_exfil_destinations. Raise the bytes_sent threshold in %global_flow_bytes_threshold or adjust the port list to match the environment's approved egress ports. Add approved high-upload source hosts to %global_allowed_backup_hosts."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Outbound direction: source is internal, destination is external
    not $net.principal.ip in %global_rfc1918_internal
    not $net.target.ip in %global_rfc1918_internal

    // Exclude known-good destinations explicitly approved for bulk egress
    not $net.target.ip in %global_allowed_exfil_destinations

    // Exclude known backup/upload hosts by source
    not $net.principal.ip in %global_allowed_backup_hosts

    // Large outbound byte count indicative of bulk data transfer
    // Chronicle UDM: network.sent_bytes (total bytes sent by principal in flow)
    $net.network.sent_bytes > 10000000

    // Focus on ports commonly abused for C2 exfiltration:
    // 443 (HTTPS), 80 (HTTP), 8080, 8443, 53 (DNS-over-TCP edge case),
    // 22 (SSH tunnels), 4444, 1080 (SOCKS proxy)
    $net.target.port in [80, 443, 8080, 8443, 22, 53, 1080, 4444]

    // Capture join fields for outcome
    $net.principal.ip = $src_ip
    $net.target.ip   = $dst_ip

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity    = array_distinct($src_ip)
    $destination_ips   = array_distinct($dst_ip)
    $destination_ports = array_distinct($net.target.port)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
