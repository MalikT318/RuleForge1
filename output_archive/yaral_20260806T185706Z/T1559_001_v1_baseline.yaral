/*
  MITRE Technique : T1559.001 - Component Object Model
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:10:52.142932+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Abuse_Suspicious_Host_Spawns_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects COM-based local code execution where a known COM host process (dllhost, mshta, wscript, cscript, rundll32, regsvr32, or the MMC host) spawns an unexpected child process. Adversaries abuse COM interfaces to invoke arbitrary code by instantiating COM objects through these hosts, causing them to launch shells, scripting engines, or other execution vehicles."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires EDR process telemetry with parent-child process lineage (e.g., Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, SentinelOne). Parent and child process full paths must be populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers using COM automation, Office macros invoking COM for document processing, RMM agents, software deployment tools, and administrative scripts using WScript/CScript for sanctioned tasks."
    tuning_guidance = "Add known-good parent-child combinations to %com_allowed_parent_child_pairs. Add approved administrative scripts to %global_allowed_admin_tools. Scope by principal.hostname to high-value asset groups if noise is high in specific environments."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // COM host processes commonly abused to instantiate COM objects
    $proc.principal.process.file.full_path = /\\(dllhost|mshta|wscript|cscript|rundll32|regsvr32|mmc|svchost)\.exe$/ nocase

    // Suspicious child processes spawned via COM abuse
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|certutil|bitsadmin|msiexec|regsvr32|rundll32|wmic|cmstp|installutil|msbuild|csc|vbc|jsc|explorer|werfault|pcalua)\.exe$/ nocase

    // Exclude cases where the COM host spawns itself (reduces noise from legitimate COM chaining)
    not $proc.principal.process.file.full_path = $proc.target.process.file.full_path

    // Exclude known-good administrative parent-child combinations
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %com_allowed_parent_child_pairs

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_commandline = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
