/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:44:45.637252+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_Make_And_Impersonate_Token {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a new logon session created programmatically via LogonUser-style API calls, evidenced by a Windows Security logon event with logon type 9 (NewCredentials) or type 2 (Interactive) originating from a non-interactive process. Logon type 9 is the canonical footprint of LogonUserW/LogonUserExW used to manufacture a token for impersonation without the user being physically present. The resulting token is then typically assigned to a thread via SetThreadToken or ImpersonateLoggedOnUser."
    mitre_tactic    = "Privilege Escalation, Defense Evasion"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Requires Windows Security Event Log (Event ID 4624) forwarded and normalized to UDM, or EDR telemetry that surfaces logon type and logon process fields. Logon type 9 (NewCredentials) must be present in the normalized event."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "RunAs /netonly usage by administrators, credential delegation tools, some RMM agents that use alternate credentials, and automated deployment frameworks (Ansible WinRM, SCCM). Privileged Access Workstation tooling may also trigger this."
    tuning_guidance = "Add known-good parent process paths (e.g., RMM agents, deployment tools) to %global_allowed_token_creators. Add known service accounts that legitimately use LogonUser to %global_allowed_impersonation_accounts. Consider scoping to non-server assets if the environment has heavy automation on servers."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Logon type 9 = NewCredentials - the direct result of LogonUserW with
    // LOGON32_LOGON_NEW_CREDENTIALS, used to manufacture a token while
    // keeping the caller's existing token for local access.
    // Logon process "seclogo" or "Advapi" indicates a programmatic logon
    // rather than an interactive desktop or network logon.
    $auth.extensions.auth.auth_details = /logon_type=(9|2)/ nocase

    // The logon was initiated by a process rather than the Windows logon UI.
    // Legitimate interactive logons arrive via "User32" or "NtLmSsp".
    // Programmatic token creation arrives via "Advapi" or "seclogo".
    $auth.network.application_protocol_version = /advapi|seclogo/ nocase

    // The authenticating user must not be a machine account (ends in $).
    // Machine account logons of this type are normal Kerberos behaviour.
    not $auth.target.user.userid = /\$$/ nocase

    // The subject (caller) process must not be a known-good privileged binary.
    not $auth.principal.process.file.full_path = /\\(lsass|services|wininit|winlogon|svchost)\.exe$/ nocase

    // Exclude known-good parent processes and service accounts via reference lists.
    not $auth.principal.process.file.full_path in %global_allowed_token_creators
    not $auth.target.user.userid in %global_allowed_impersonation_accounts

    // Capture join fields for outcome.
    $auth.principal.hostname = $hostname
    $auth.target.user.userid = $userid

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity    = array_distinct($hostname)
    $impersonated_user = array_distinct($userid)
    $caller_process    = array_distinct($auth.principal.process.file.full_path)
    $logon_detail      = array_distinct($auth.extensions.auth.auth_details)

  condition:
    $auth
}
