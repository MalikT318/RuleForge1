/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:06:15.175968+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Stripped_ELF_Exfil_Network_Sequence {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage network pattern consistent with stripped ELF payload staging: an outbound HTTP/S connection to a non-standard high port (common for payload hosting) followed within 5 minutes by a second outbound connection from the same source IP on a raw/non-standard port, suggesting the stripped binary was fetched and then called back. Firewall-observable only; no process context required."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised into Chronicle UDM NETWORK_HTTP and NETWORK_FLOW events. Both events must carry principal.ip and target.port."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Software update agents using non-standard ports, legitimate CDN or SaaS products on high ports, internal scanning tools, load-balancer health checks, developer CI/CD pipelines pulling build artefacts."
    tuning_guidance = "Add known-good high-port destinations to %allowed_highport_download_destinations. Add internal scanner IPs to %internal_scanner_ips. Narrow target.port ranges if your environment uses specific high ports legitimately."

  events:
    // Stage 1: outbound HTTP/S fetch on a non-standard high port (>1024, excluding 8080/8443 which are common legitimate ports)
    // This models a stripped ELF being downloaded from a staging server
    $fetch.metadata.event_type = "NETWORK_HTTP"
    $fetch.target.port > 1024
    $fetch.target.port != 8080
    $fetch.target.port != 8443
    $fetch.target.port != 3000
    $fetch.target.port != 9090
    not $fetch.target.ip in %allowed_highport_download_destinations
    not $fetch.principal.ip in %internal_scanner_ips
    $fetch.principal.ip = $src_ip

    // Stage 2: subsequent outbound raw TCP/UDP flow on a non-standard port
    // consistent with a stripped binary establishing C2 after execution
    $cb.metadata.event_type = "NETWORK_FLOW"
    $cb.target.port > 1024
    $cb.target.port != 8080
    $cb.target.port != 8443
    $cb.target.port != 3000
    $cb.target.port != 9090
    not $cb.target.ip in %allowed_highport_download_destinations
    not $cb.principal.ip in %internal_scanner_ips
    $cb.principal.ip = $src_ip

    // Enforce chronological ordering: fetch must precede callback
    $fetch.metadata.event_timestamp.seconds <= $cb.metadata.event_timestamp.seconds

    // The two flows must reach DIFFERENT external destinations,
    // ruling out simple keep-alive retransmissions to the same host
    $fetch.target.ip != $cb.target.ip

  match:
    $src_ip over 5m

  outcome:
    $risk_score          = max(72)
    $mitre_technique_id  = array_distinct("T1027.008")
    $primary_entity      = array_distinct($src_ip)
    $fetch_destinations  = array_distinct($fetch.target.ip)
    $fetch_ports         = array_distinct($fetch.target.port)
    $callback_destinations = array_distinct($cb.target.ip)
    $callback_ports      = array_distinct($cb.target.port)

  condition:
    $fetch and $cb
}
