/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:59:34.085125+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_Container_DoS_Resource_Exhaustion_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious cloud control-plane API calls consistent with container-based Network DoS staging: bulk creation or modification of container workloads (Pods, Deployments, DaemonSets, Jobs) at scale, which adversaries abuse to spin up high-bandwidth egress pods for DDoS amplification or traffic flooding. A single audit event creating a large replica count or a privileged network-capable workload in an unexpected namespace is the primary signal."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Requires cloud provider Kubernetes API server audit logs normalised into Chronicle UDM. The audit log must capture resource type, namespace, and the calling principal for control-plane write operations (create/update/patch on Pods, Deployments, DaemonSets, ReplicaSets, Jobs, CronJobs)."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines performing large-scale rollouts, autoscalers adjusting replica counts, infrastructure-as-code tooling (Terraform, Helm) deploying new workloads, and cluster bootstrap automation."
    tuning_guidance = "Add known CI/CD service accounts to %allowed_k8s_deploy_principals. Add approved namespaces to %allowed_k8s_namespaces. Raise the replica threshold or restrict to specific resource types if the environment routinely deploys large replica sets via automation."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target a Kubernetes workload resource type that can generate network traffic at scale
    $cloud.target.resource.resource_subtype = /^(pod|deployment|daemonset|replicaset|statefulset|job|cronjob)$/ nocase

    // Restrict to write verbs that instantiate or scale workloads
    $cloud.target.resource.name = /\/(create|apply|patch|update|scale)/ nocase

    // Flag workloads created outside well-known system namespaces - adversaries prefer
    // default or custom namespaces to avoid scrutiny
    not $cloud.target.resource.attribute.labels.key = /^namespace$/ nocase

    // Exclude known-good automation principals
    not $cloud.principal.user.userid in %allowed_k8s_deploy_principals

    // Exclude approved namespaces (populated per-client)
    not $cloud.target.resource.attribute.labels.value in %allowed_k8s_namespaces

    // Exclude system service accounts used by the cluster itself
    not $cloud.principal.user.userid = /^system:(serviceaccount:kube-system:|node:|masters)/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_type = array_distinct($cloud.target.resource.resource_subtype)
    $resource_name = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
