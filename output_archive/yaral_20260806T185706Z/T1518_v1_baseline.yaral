/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:00:40.861565+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_Container_Software_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects software discovery activity inside a container or Kubernetes pod. An adversary who has exec'd into a running container commonly enumerates installed packages, kernel versions, and security tooling using package managers (dpkg, rpm, apk, pip, gem, npm) or /proc inspection. Rapid sequential invocation of these tools from a container process is a strong signal of reconnaissance."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "Requires container runtime process telemetry (e.g., from a container-aware EDR or Kubernetes audit log source) that populates PROCESS_LAUNCH events with command-line and process path fields for workloads running inside pods or containers."
    platform = "Linux"
    log_source = "container"
    false_positives = "Container init scripts that run package audits at startup, CI/CD pipeline steps that inventory dependencies, security scanning sidecars (e.g., Trivy, Grype), configuration management agents."
    tuning_guidance = "Add known CI/CD service-account names to %container_allowed_sa_users and known scanner image names or parent process paths to %container_allowed_scanner_paths. Narrow the match window or raise the threshold if the environment runs frequent automated audits."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target process must be a package manager, interpreter package lister,
    // or /proc-based software enumeration tool.
    // Matches: dpkg, rpm, apk, pip/pip3, gem, npm, yum, dnf, zypper, pacman,
    //          snap, flatpak, conda, cargo, go (version), java -version, etc.
    $proc.target.process.file.full_path = /\/(dpkg|rpm|apk|pip3?|gem|npm|yum|dnf|zypper|pacman|snap|flatpak|conda|cargo)$/ nocase

    // Restrict to enumeration-style invocations (list, query, show, version flags).
    // Avoids firing on install/remove operations which are separate behaviours.
    $proc.target.process.command_line = /(--list|--query|-qa|-l|list|show|info|version|--version|-V|search|freeze|outdated|audit)/ nocase

    // The parent process must be a shell or container entrypoint, indicating
    // interactive or scripted execution inside the container rather than a
    // legitimate package-manager daemon invocation.
    $proc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash|python3?|ruby|node|perl)$/ nocase

    // Exclude known-good scanner and CI paths.
    not $proc.principal.process.file.full_path in %container_allowed_scanner_paths
    not $proc.principal.user.userid in %container_allowed_sa_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($proc.principal.hostname)
    $discovered_tool = array_distinct($proc.target.process.file.full_path)
    $cmdline_sample = array_distinct($proc.target.process.command_line)
    $actor_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
