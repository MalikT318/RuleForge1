/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:54:15.117509+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_ESXi_File_Permission_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of chmod or chown on ESXi to modify file or directory permissions, a common adversary technique to bypass ACLs and enable follow-on activity such as persistence, binary hijacking, or configuration tampering."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised into Chronicle UDM PROCESS_LAUNCH events. ESXi shell logging must be enabled and forwarded to Chronicle."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate ESXi administration scripts, VMware patch/upgrade processes, authorised storage or datastore reconfiguration tasks, backup agents running as root."
    tuning_guidance = "Add known-good parent process paths (e.g. VMware update scripts) to %esxi_allowed_permission_tools. Narrow scope further by restricting to sensitive ESXi paths such as /vmfs/, /etc/, /bin/, /sbin/ via the command_line regex if noise is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match chmod or chown as the launched binary on ESXi
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(chmod|chown)$/ nocase

    // Must have a command-line argument indicating permission change activity
    // Broad match: any invocation with a path argument targeting ESXi-relevant directories
    $proc.target.process.command_line = /(chmod|chown)/ nocase

    // Focus on sensitive ESXi filesystem areas to reduce noise from routine ops
    $proc.target.process.command_line = /(\/(vmfs|etc|bin|sbin|scratch|store|bootbank|altbootbank|locker|tmp)|\.vmx|\.vmdk|authorized_keys|shadow|passwd|rc\.local|inetd\.conf|vmkernel)/ nocase

    // Exclude known-good administrative parent processes via reference list
    not $proc.principal.process.file.full_path in %esxi_allowed_permission_tools

    // Exclude empty hostnames to avoid noisy unresolved events
    $proc.principal.hostname != ""

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_executed = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
