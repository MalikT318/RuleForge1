/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:08:33.170566+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Container_Fileless_SharedMem_Exec_Sequence {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a two-stage fileless storage attack pattern inside containers: a file is written to a RAM-backed shared-memory or volatile path (/dev/shm, /run/shm, /var/run, /var/lock, /tmp) and then a process is launched from that same path within the same container workload. Writing executables to these directories bypasses disk-based AV and read-only filesystem protections. This rule targets container/Kubernetes telemetry and is additive to process-launch command-line rules."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires container runtime audit logs normalised to Chronicle UDM. FILE_CREATION events must populate target.file.full_path. PROCESS_LAUNCH events must populate target.process.file.full_path and principal.hostname or principal.namespace."
    platform        = "Linux"
    log_source      = "container"
    false_positives = "Package managers or init scripts that stage binaries in /tmp during container startup; JVM/Node runtimes that write JIT artifacts to /tmp; legitimate use of /dev/shm for IPC by databases (PostgreSQL, Redis). Tune via %container_allowed_shm_writers."
    tuning_guidance = "Add known-good container image names or workload namespaces to %container_allowed_shm_writers. Narrow the file-write filter to exclude extensions such as .sock, .pid, .lock if those generate noise. Consider raising severity to Critical only when the namespace is kube-system or the pod is privileged."

  events:
    // Stage 1: file written into a RAM-backed or volatile directory inside a container
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/dev\/shm\/|\/run\/shm\/|\/var\/run\/|\/var\/lock\/|\/tmp\/)/ nocase
    // Exclude obvious non-executable artifacts (sockets, pid files, lock files)
    not $file.target.file.full_path = /\.(sock|pid|lock|log)$/ nocase
    not $file.principal.user.userid in %container_allowed_shm_writers
    $file.principal.hostname = $container_host

    // Stage 2: process launched from the same RAM-backed path on the same host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^(\/dev\/shm\/|\/run\/shm\/|\/var\/run\/|\/var\/lock\/|\/tmp\/)/ nocase
    not $proc.target.process.file.full_path = /\.(sock|pid|lock|log)$/ nocase
    not $proc.principal.user.userid in %container_allowed_shm_writers
    $proc.principal.hostname = $container_host

    // Chronological ordering: write must precede execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $container_host over 5m

  outcome:
    $risk_score          = max(92)
    $mitre_technique_id  = array_distinct("T1027.011")
    $primary_entity      = array_distinct($container_host)
    $written_paths       = array_distinct($file.target.file.full_path)
    $executed_paths      = array_distinct($proc.target.process.file.full_path)
    $writing_user        = array_distinct($file.principal.user.userid)
    $executing_user      = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
