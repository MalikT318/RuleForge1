/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:29:29.977104+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_MacOS_DomainEnum_LDAP_Burst_Then_External {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a burst of LDAP/LDAPS connections from a macOS host to a directory service, followed by an outbound connection to a non-internal destination within 10 minutes. This pattern is consistent with domain account enumeration (e.g., dscacheutil, ldapsearch, or similar tooling) followed by exfiltration or C2 staging of harvested account data. Firewall telemetry only - no process context required."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires perimeter or host-based firewall/proxy flow logs that record source IP, destination IP, destination port, and connection counts. LDAP (389) and LDAPS (636) flows must be visible."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Directory-integrated applications performing legitimate bulk LDAP queries (e.g., identity providers, MDM agents, backup tools). Adjust %allowed_ldap_sources to suppress known-good hosts."
    tuning_guidance = "Add known MDM, IdP, or directory-sync source IPs to %allowed_ldap_sources. Add known corporate LDAP server IPs to %known_ldap_servers. Raise the connection-count threshold in the match window if the environment has high-volume directory traffic."

  events:
    // Leg 1: burst of LDAP or LDAPS flows from the same internal source
    $ldap.metadata.event_type = "NETWORK_CONNECTION"
    (
      $ldap.target.port = 389 or
      $ldap.target.port = 636 or
      $ldap.target.port = 3268 or
      $ldap.target.port = 3269
    )
    $ldap.target.ip in %known_ldap_servers
    not $ldap.principal.ip in %allowed_ldap_sources
    $ldap.principal.ip = $src_ip

    // Leg 2: outbound connection to a non-internal destination after the LDAP burst
    $out.metadata.event_type = "NETWORK_CONNECTION"
    not $out.target.ip in %rfc1918_internal
    not $out.target.ip in %known_ldap_servers
    not $out.target.ip in %allowed_egress_destinations
    $out.principal.ip = $src_ip

    // Chronological ordering: LDAP activity precedes the outbound connection
    $ldap.metadata.event_timestamp.seconds <= $out.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score          = max(78)
    $mitre_technique_id  = array_distinct("T1087.002")
    $primary_entity      = array_distinct($src_ip)
    $ldap_dest_ips       = array_distinct($ldap.target.ip)
    $ldap_ports_seen     = array_distinct($ldap.target.port)
    $outbound_dest_ips   = array_distinct($out.target.ip)
    $outbound_dest_ports = array_distinct($out.target.port)
    $ldap_flow_count     = count($ldap.metadata.id)

  condition:
    $ldap and $out
}
