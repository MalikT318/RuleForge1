/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:04:10.370975+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_MacOS_Firewall_ToolRetool_ExfilAfterQuarantine {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a network-observable pattern consistent with indicator removal from tools on macOS: an initial outbound connection to an uncommon high port (likely C2 beacon or tool download) is followed within 5 minutes by a second outbound connection to the same external destination, suggesting the tool was modified and re-deployed. Firewall logs capture both legs without requiring endpoint process visibility. This provides additive coverage beyond process-launch command-line rules."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Both inbound-blocked and outbound-allowed events must be ingested. Session-level logs (5-tuple + bytes) are preferred."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Software update services that retry after a failed download; CDN-hosted applications that reconnect to the same edge node; VPN clients re-establishing tunnels; legitimate developer tools fetching build artefacts."
    tuning_guidance = "Add known-good external IP ranges (CDN, update servers, SaaS) to %global_allowed_external_destinations. Add internal RFC-1918 and link-local ranges to %rfc1918_internal. Raise the minimum bytes threshold in outcome comments to reduce noise from keep-alive traffic. Narrow the high-port range if your environment uses a specific ephemeral range."

  events:
    // First leg: outbound connection to an external host on a suspicious high port
    // (non-standard, non-well-known service port - consistent with C2 or tool staging)
    $first.metadata.event_type = "NETWORK_CONNECTION"
    $first.target.port >= 1024
    $first.target.port <= 65535
    // Exclude common legitimate high ports: HTTPS-alt, common SaaS, etc.
    not $first.target.port = 8080
    not $first.target.port = 8443
    not $first.target.port = 443
    not $first.target.port = 80
    not $first.target.ip in %rfc1918_internal
    not $first.target.ip in %global_allowed_external_destinations
    $first.principal.ip = $src_ip
    $first.target.ip = $dst_ip

    // Second leg: a follow-up connection from the SAME internal source to the SAME
    // external destination within the window - consistent with a re-tooled payload
    // reconnecting after the first attempt was blocked or quarantined
    $second.metadata.event_type = "NETWORK_CONNECTION"
    $second.principal.ip = $src_ip
    $second.target.ip = $dst_ip
    not $second.target.ip in %rfc1918_internal
    not $second.target.ip in %global_allowed_external_destinations
    // Second connection must arrive after the first
    $first.metadata.event_timestamp.seconds <= $second.metadata.event_timestamp.seconds
    // Require a meaningful gap (at least 30 seconds) so we do not match TCP retransmits
    $second.metadata.event_timestamp.seconds >= $first.metadata.event_timestamp.seconds + 30

  match:
    $src_ip, $dst_ip over 5m

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity    = array_distinct($src_ip)
    $destination_ip    = array_distinct($dst_ip)
    $first_seen_port   = min($first.target.port)
    $second_seen_port  = max($second.target.port)
    $connection_count  = count($second.metadata.event_timestamp.seconds)

  condition:
    $first and $second
}
