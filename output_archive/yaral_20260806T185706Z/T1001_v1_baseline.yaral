/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:33:19.110912+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_Obfuscated_C2_High_Entropy_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects potential data obfuscation in C2 traffic by identifying outbound network flows from macOS hosts that exhibit characteristics consistent with obfuscated communications: non-standard high ports, unusually large or periodic connection volumes, or connections to non-internal destinations over uncommon protocols. Firewall/proxy telemetry only - no process context available."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Requires firewall or perimeter proxy logs normalised into Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION events. Fields required: principal.ip, target.ip, target.port, network.sent_bytes, network.application_protocol."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "CDN traffic, software update services, VPN clients, backup agents, video conferencing tools, developer toolchains making large outbound transfers."
    tuning_guidance = "Populate %firewall_allowed_high_ports with approved high-port destinations (e.g. SaaS, CDN ranges). Populate %firewall_internal_destinations with RFC-1918 and internal CIDR ranges. Populate %firewall_approved_applications with known-good application protocol strings. Raise the sent_bytes threshold if backup or sync traffic generates false positives."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Exclude internal/RFC-1918 destinations - obfuscated C2 targets external infrastructure
    not $net.target.ip in %firewall_internal_destinations

    // Focus on high ephemeral or non-standard ports commonly abused for obfuscated C2
    // Excludes well-known service ports (80, 443, 53, 25, 587, 993, 995, 22, 21)
    $net.target.port > 1024
    not $net.target.port = 8080
    not $net.target.port = 8443
    not $net.target.port = 443
    not $net.target.port = 80

    // Large outbound payload is a signal for data exfiltration with obfuscation,
    // or periodic beaconing with padded/junk data inflating transfer size
    $net.network.sent_bytes > 500000

    // Exclude destinations and ports explicitly approved for high-volume traffic
    not $net.target.ip in %firewall_allowed_high_ports

    // Exclude known-good application protocols that legitimately produce large flows
    not $net.network.application_protocol in %firewall_approved_applications

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
