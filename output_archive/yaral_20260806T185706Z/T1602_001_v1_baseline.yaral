/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:30:00.395078+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_SNMP_MIB_Dump_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects SNMP traffic (UDP/161 or UDP/162) originating from external, non-management-plane sources toward network devices. Adversaries performing MIB dumps send bulk SNMP GET/GETBULK/GETNEXT queries to enumerate device configuration, routing tables, interface details, and software inventory. This rule fires on SNMP connections where the source is not in the approved management address space."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Requires firewall or perimeter flow logs that record UDP sessions including source/destination IP and destination port. NetFlow, IPFIX, or stateful firewall session logs are sufficient."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate NMS/SNMP polling platforms (SolarWinds, PRTG, Zabbix, Nagios, LibreNMS) querying managed devices. Authorized network discovery scans. Cloud-based monitoring services with fixed egress IPs."
    tuning_guidance = "Add all authorized SNMP management station IPs and subnets to %approved_snmp_management_sources. Add known internal monitoring subnets to %rfc1918_internal. Raise severity to Critical if the source IP is also observed in threat intelligence feeds."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 162
    )
    $net.network.ip_protocol = "UDP"
    not $net.principal.ip in %approved_snmp_management_sources
    not $net.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
