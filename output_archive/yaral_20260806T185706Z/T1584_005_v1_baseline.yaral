/*
  MITRE Technique : T1584.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:21:15.969606+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_005_Botnet_DGA_DNS_Indicators {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS query patterns consistent with botnet command-and-control activity: algorithmically generated or high-entropy domain names, abnormal DNS record types (TXT, NULL), and excessively long subdomain labels commonly used for DNS tunneling or DGA-based C2 beaconing. These patterns are characteristic of compromised hosts communicating with botnet infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.005"
    mitre_technique_name = "Compromise Infrastructure: Botnet"
    log_prerequisites = "Requires DNS resolver or recursive DNS query logs normalized to UDM NETWORK_DNS events. Fields needed: network.dns.questions.name, network.dns.questions.type, network.dns.response_code."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN providers using long randomized subdomains (e.g., Akamai, Cloudflare), legitimate software update services with versioned subdomains, analytics platforms with session-encoded subdomains, internal split-horizon DNS with long labels."
    tuning_guidance = "Add known-good high-entropy domains and CDN apex domains to %dns_allowed_domains. Adjust subdomain label length threshold if legitimate internal services trigger. Consider pairing with a threshold rule to require repeated queries from the same source before alerting."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Exclude known-good domains via reference list
    not $dns.network.dns.questions.name in %dns_allowed_domains

    // Detect suspicious DNS patterns using OR-equivalent multi-condition approach:
    // Pattern 1: Abnormal record types used for C2/tunneling (TXT=16, NULL=10, ANY=255)
    // Pattern 2: Excessively long subdomain labels (>50 chars before first dot) indicating DGA or tunneling
    // Pattern 3: High-entropy-looking labels - long total FQDN with many subdomains
    // We use a single event block targeting the most portable signal: long subdomain labels
    // combined with suspicious record types, which together have very high fidelity

    (
      // Suspicious record types: TXT (16), NULL (10), or ANY (255) - commonly abused for tunneling
      $dns.network.dns.questions.type = 16
      or
      $dns.network.dns.questions.type = 10
      or
      $dns.network.dns.questions.type = 255
    )

    // Long subdomain label pattern: total FQDN length > 50 characters with multiple labels,
    // characteristic of DGA domains or DNS-tunneled data encoded in subdomains
    $dns.network.dns.questions.name = /^[a-z0-9][a-z0-9\-]{15,}\.[a-z0-9][a-z0-9\-\.]{20,}\.[a-z]{2,}$/ nocase

    // Exclude common internal/reserved TLDs and localhost
    not $dns.network.dns.questions.name = /\.(local|localhost|internal|corp|lan|test|example|invalid)(\.|$)/ nocase

    // Exclude common legitimate high-volume TXT query sources (SPF, DKIM lookups)
    not $dns.network.dns.questions.name = /^(default\._domainkey|_dmarc|_domainkey|v=spf)/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1584.005")
    $primary_entity = array_distinct($dns.principal.hostname)

  condition:
    $dns
}
