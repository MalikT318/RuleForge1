/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:14:38.283485+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_At_Job_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation events in the Windows Task Scheduler legacy job store (C:\\Windows\\System32\\Tasks or C:\\Windows\\SysWOW64\\Tasks) that match the naming pattern used by the legacy 'at' utility (AtN.job where N is a numeric job ID). The 'at' command and Win32_ScheduledJob WMI class write .job files directly to disk; detecting the artifact is harder to evade than suppressing command-line logging."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event) normalised into Chronicle UDM FILE_CREATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative use of the legacy 'at' command by IT operations teams; some third-party job-scheduling products that write .job files with numeric names. Rare in modern Windows environments because 'at' is deprecated."
    tuning_guidance = "Add known-good parent process paths (e.g. authorised RMM agents) to %global_allowed_at_job_creators. If the environment has a documented legacy scheduler, add its service account hostname to %global_allowed_at_job_hosts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\Windows\\(System32|SysWOW64)\\Tasks\\At[0-9]+\.job$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_at_job_creators
    not $file.principal.hostname in %global_allowed_at_job_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $job_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
