/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:55:17.880957+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Execution_Guardrails_Env_Check_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes on Linux that perform environment-fingerprinting checks characteristic of execution guardrails: reading hostname, domain membership, network configuration, or hardware identifiers immediately before or as part of a payload decision chain. The pattern targets shell or interpreter invocations that chain environment-discovery commands (hostname, domainname, ip, ifconfig, uname, dmidecode, hostnamectl) with conditional logic (&&, ||, test, [ ]) in a single command line, which is the canonical guardrail pattern - execute only if the environment matches an expected target fingerprint."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with full command-line capture (execve syscall arguments). auditd rule: -a always,exit -F arch=b64 -S execve."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate configuration management scripts (Ansible, Chef, Puppet) that gate actions on hostname or domain checks; cloud-init bootstrap scripts; container entrypoint scripts that validate environment variables before starting services; monitoring agents performing self-identification."
    tuning_guidance = "Add known automation tool parent process paths (e.g. /usr/bin/ansible, /opt/chef/bin/ruby) to %linux_allowed_env_check_parents. Add known CI/CD runner paths to the same list. Narrow the hostname/domain regex to exclude your known naming conventions if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target: shell or scripting interpreter launching the guardrail check
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|node)$/ nocase

    // Command line must contain at least one environment-fingerprinting primitive
    // combined with conditional execution syntax - the hallmark of a guardrail
    $proc.target.process.command_line = /(hostname|domainname|hostnamectl|uname|dmidecode|ip\s+addr|ifconfig|dnsdomainname|realm\s+list|sssd|getent\s+hosts|cat\s+\/etc\/(hostname|resolv\.conf|machine-id)|systemd-detect-virt)/ nocase

    // Must also contain conditional logic operators or test constructs
    // indicating the discovery result gates further execution
    $proc.target.process.command_line = /(\&\&|\|\||;\s*if\s|\btest\b|\[\s|\bcase\b.*\bin\b|\$\(.*\)\s*(==|!=|=~|-eq|-ne))/ nocase

    // Exclude known safe automation parent processes
    not $proc.principal.process.file.full_path in %linux_allowed_env_check_parents

    // Exclude interactive login shells (tty-attached sessions are lower risk)
    // by requiring the command line to contain a non-trivial payload indicator:
    // base64, curl/wget fetch, chmod +x, or execution of a file in /tmp /dev/shm /var/tmp
    $proc.target.process.command_line = /(base64|curl|wget|\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|chmod\s+[+]?x|eval\s*\$|exec\s+\/)/ nocase

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
