/*
  MITRE Technique : T1584.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:20:35.172454+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_002_DNS_Hijack_Anomalous_Record_Change_Traffic {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network connections to DNS management ports (TCP 53, 853, 5353, 8053) from external or unexpected source addresses that may indicate adversary interaction with a DNS server infrastructure. Compromised DNS servers are used to alter records and redirect victim traffic. This rule targets IDS/IPS-observed connection attempts to DNS service ports from non-standard initiators, which is a strong signal of DNS server compromise or reconnaissance activity consistent with T1584.002."
    mitre_tactic         = "Resource Development"
    mitre_technique      = "T1584.002"
    mitre_technique_name = "Compromise Infrastructure: DNS Server"
    log_prerequisites    = "Requires IDS/IPS or network security appliance telemetry with visibility into DNS management plane traffic (TCP 53, 853, 5353, 8053). Appliance must log connection-level metadata including source/destination IP and port."
    platform             = "PRE"
    log_source           = "ips"
    false_positives      = "Legitimate DNS-over-TLS (DoT) clients on port 853, authoritative DNS zone transfers between known secondaries, monitoring systems polling DNS health, and managed DNS providers performing legitimate updates."
    tuning_guidance      = "Add known secondary DNS server IPs and authoritative resolver IPs to %allowed_dns_management_sources. Add known DNS monitoring infrastructure to the same list. Consider narrowing to TCP-only to reduce mDNS noise on 5353."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target DNS management or alternate DNS service ports
    $net.target.port in [53, 853, 5353, 8053]

    // Restrict to TCP — zone transfers and DNS management plane use TCP;
    // UDP 53 is high-volume legitimate resolver traffic and too noisy for this angle
    $net.network.ip_protocol = "TCP"

    // Source must not be a known RFC1918 private address range —
    // external sources initiating TCP DNS connections are anomalous
    not $net.principal.ip in %rfc1918_internal

    // Exclude known legitimate DNS management sources (secondary resolvers,
    // monitoring probes, managed DNS provider egress ranges)
    not $net.principal.ip in %allowed_dns_management_sources

    // Exclude known legitimate DNS infrastructure destinations to focus on
    // unexpected targets (e.g., internal authoritative servers being probed externally)
    not $net.target.ip in %allowed_dns_infrastructure_targets

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1584.002")
    $primary_entity    = array_distinct($net.target.ip)
    $source_ips        = array_distinct($net.principal.ip)
    $target_ports      = array_distinct($net.target.port)

  condition:
    $net
}
