/*
  MITRE Technique : T1561.002 - Disk Structure Wipe
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:12:17.033643+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_002_Disk_Structure_Wipe_Container {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects processes inside a container or on a Linux host that attempt to overwrite disk structures (MBR, partition table, boot sectors) by writing directly to raw block devices (/dev/sd*, /dev/hd*, /dev/vd*, /dev/nvme*, /dev/xvd*) or by invoking utilities capable of destroying disk layout. In a container context this requires the container to have been launched with elevated privileges or a host device mount. Disk structure wipes render systems unbootable and are a high-confidence indicator of destructive malware or insider sabotage."
    mitre_tactic    = "Impact"
    mitre_technique = "T1561.002"
    mitre_technique_name = "Disk Wipe: Disk Structure Wipe"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry forwarded to Chronicle, or container runtime audit logs (e.g., containerd/CRI-O exec events). The command line and target file path must be populated in UDM. Auditd rules should include -a always,exit -F arch=b64 -S open,openat -F path=/dev/sda and equivalent for other block devices."
    platform        = "Linux"
    log_source      = "container"
    false_positives = "Disk imaging tools run by authorised storage administrators (dd, ddrescue), OS provisioning pipelines that legitimately write bootloaders (grub-install, syslinux), bare-metal provisioning systems (Foreman, Cobbler, Ironic), and forensic acquisition workflows."
    tuning_guidance = "Add authorised provisioning process paths to %linux_allowed_disk_write_procs. Add known-safe parent process paths (e.g., provisioning agents) to %linux_allowed_disk_parent_procs. Scope by principal.hostname or namespace label if the rule fires on a dedicated imaging host."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target raw block devices that contain MBR / partition table / boot sectors.
    // Matches /dev/sda, /dev/sdb, /dev/hda, /dev/vda, /dev/nvme0, /dev/xvda, etc.
    // Also matches explicit byte-offset writes to the first sectors via seek=0 or skip=0.
    (
      $proc.target.process.command_line = /\/dev\/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|xvd[a-z])[0-9]{0,2}(\s|$|'|"|\x00)/ nocase
      or
      // dd writing to a raw block device with count or seek targeting sector 0
      (
        $proc.target.process.command_line = /\bdd\b/ nocase
        and $proc.target.process.command_line = /of=\/dev\/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|xvd[a-z])/ nocase
      )
      or
      // shred, wipe, or wipefs targeting a block device
      (
        $proc.target.process.file.full_path = /\/(shred|wipefs|wipe|sgdisk|gdisk|fdisk|parted|sfdisk)$/ nocase
        and $proc.target.process.command_line = /\/dev\/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|xvd[a-z])/ nocase
      )
      or
      // Explicit MBR overwrite: writing 512 bytes or zeroes to offset 0 of a disk
      (
        $proc.target.process.command_line = /bs=512/ nocase
        and $proc.target.process.command_line = /seek=0/ nocase
        and $proc.target.process.command_line = /of=\/dev\// nocase
      )
      or
      // Python/Perl/shell one-liners opening a block device for writing
      (
        $proc.target.process.file.full_path = /\/(python[23]?|perl|ruby|bash|sh|zsh|ksh)$/ nocase
        and $proc.target.process.command_line = /open\s*\(\s*['"]\/dev\/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|xvd[a-z])/ nocase
      )
    )

    // Exclude authorised provisioning and imaging processes
    not $proc.target.process.file.full_path in %linux_allowed_disk_write_procs
    not $proc.principal.process.file.full_path in %linux_allowed_disk_parent_procs

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1561.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_cmdline  = array_distinct($proc.target.process.command_line)
    $spawning_process  = array_distinct($proc.principal.process.file.full_path)
    $target_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
