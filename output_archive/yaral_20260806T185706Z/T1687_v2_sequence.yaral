/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T18:59:19.574260+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_002_Firewall_Defense_Impairment_Exfil_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with defense impairment exploitation on macOS: an initial outbound connection to a non-internal destination on a sensitive management or security-tool port, followed within 10 minutes by a high-volume or anomalous outbound flow from the same source IP. This two-stage pattern is consistent with an adversary exploiting a vulnerability in a security component (e.g., EDR, AV, firewall agent) to weaken defenses and then exfiltrate data or beacon to C2. Detected purely from firewall/perimeter telemetry."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW. Both inbound and outbound sessions must be logged with byte counts and destination port."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Legitimate security-tool cloud telemetry uploads, MDM enrollment traffic, software update services contacting vendor infrastructure on high ports, VPN split-tunnel reconnects."
    tuning_guidance = "Add known-good security-vendor cloud egress IPs or CIDRs to %global_allowed_security_vendor_destinations. Add approved high-volume backup or update source IPs to %global_allowed_bulk_egress_sources. Raise the bytes_out threshold in the second event filter if baseline telemetry uploads are large."

  events:
    // Stage 1: outbound connection to an external destination on a port
    // commonly associated with security-tool management, agent callbacks,
    // or exploitation payloads (443, 8443, 8080, 4443, 9000, 10443).
    // Pre-filtered narrowly: only non-RFC-1918 destinations, only the
    // sensitive port set, and not in the approved vendor destination list.
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.network.direction = "OUTBOUND"
    (
        $conn.target.port = 8443 or
        $conn.target.port = 4443 or
        $conn.target.port = 9000 or
        $conn.target.port = 10443 or
        $conn.target.port = 8080
    )
    not $conn.target.ip in %global_allowed_security_vendor_destinations
    not $conn.principal.ip in %global_allowed_bulk_egress_sources
    $conn.principal.ip = $src_ip

    // Stage 2: within the same window, the same source IP generates a
    // high-volume outbound flow (>= 5 MB transferred outbound), which is
    // anomalous for a security-tool callback and consistent with bulk
    // exfiltration or a large payload delivery after defense impairment.
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.direction = "OUTBOUND"
    $flow.network.sent_bytes >= 5000000
    not $flow.target.ip in %global_allowed_security_vendor_destinations
    not $flow.principal.ip in %global_allowed_bulk_egress_sources
    $flow.principal.ip = $src_ip

    // Enforce chronological ordering: the suspicious management-port
    // connection must precede the high-volume flow.
    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($src_ip)
    $suspicious_dest_ports = array_distinct($conn.target.port)
    $suspicious_conn_destinations = array_distinct($conn.target.ip)
    $flow_destinations = array_distinct($flow.target.ip)
    $max_bytes_sent = max($flow.network.sent_bytes)
    $event_count = count($flow.metadata.id)

  condition:
    $conn and $flow
}
