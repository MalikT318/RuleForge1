/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:27:48.080523+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_SaaS_Bulk_Account_Enumeration_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or repeated user/account listing API calls in cloud audit logs that indicate account discovery activity. Adversaries abuse cloud IAM list-users, list-accounts, or directory enumeration APIs to harvest valid identities for follow-on attacks such as credential stuffing, spear-phishing, or account takeover. This rule fires on a single high-volume listing event or a listing API call from an unusual context, providing coverage at the cloud control-plane layer rather than the process/command-line layer."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (e.g., AWS CloudTrail, Azure Activity Log, GCP Audit Log). The USER_RESOURCE_ACCESS event type must be populated with the target.resource.name or target.resource.resource_type reflecting IAM / directory / user-management API calls."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Authorised identity governance tools, HR provisioning pipelines, SIEM/SOAR connectors performing scheduled user sync, cloud security posture management (CSPM) scanners, and break-glass admin accounts performing legitimate audits."
    tuning_guidance = "Add approved service account user IDs to %cloud_allowed_iam_readers. Add approved source IP ranges to %cloud_allowed_admin_cidrs. Raise the threshold or scope to specific sensitive tenants if the base rate is too noisy."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match IAM / directory listing API operations across normalised cloud providers.
    // Covers AWS (ListUsers, ListAccounts, ListRoles), Azure (Users - List, Members - List),
    // GCP (users.list, serviceAccounts.list, projects.list) and generic directory reads.
    (
      $cloud.target.resource.name = /list.*user/ nocase or
      $cloud.target.resource.name = /list.*account/ nocase or
      $cloud.target.resource.name = /list.*member/ nocase or
      $cloud.target.resource.name = /list.*role/ nocase or
      $cloud.target.resource.name = /list.*group/ nocase or
      $cloud.target.resource.name = /list.*principal/ nocase or
      $cloud.target.resource.name = /list.*identity/ nocase or
      $cloud.target.resource.name = /users\.list/ nocase or
      $cloud.target.resource.name = /serviceaccounts\.list/ nocase or
      $cloud.target.resource.name = /directory.*read/ nocase
    )

    // Restrict to resource types that represent identity / IAM surfaces.
    (
      $cloud.target.resource.resource_type = /iam/ nocase or
      $cloud.target.resource.resource_type = /directory/ nocase or
      $cloud.target.resource.resource_type = /user/ nocase or
      $cloud.target.resource.resource_type = /identity/ nocase or
      $cloud.target.resource.resource_type = /account/ nocase or
      $cloud.target.resource.resource_type = /role/ nocase or
      $cloud.target.resource.resource_type = /group/ nocase
    )

    // Exclude known-good automated service accounts and approved readers.
    not $cloud.principal.user.userid in %cloud_allowed_iam_readers

    // Exclude calls originating from approved administrative IP ranges.
    not $cloud.principal.ip in %cloud_allowed_admin_cidrs

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)
    $resource_type = array_distinct($cloud.target.resource.resource_type)

  condition:
    $cloud
}
