/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:14:23.074636+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_LaunchAgent_Then_Outbound_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a LaunchAgent or LaunchDaemon plist file created in a user or system Library path followed by an outbound network connection from the same host within 1 hour. This pattern is consistent with a scheduled persistence mechanism (launchd job) beaconing out after installation. The file-creation event is sourced from EDR; the network event is sourced from firewall/perimeter logs joined on the originating host."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053"
    mitre_technique_name = "Scheduled Task/Job"
    log_prerequisites = "Requires EDR file-creation telemetry for the plist write event AND firewall/perimeter flow logs that populate principal.hostname or principal.ip on outbound connections."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Legitimate software installers that register LaunchAgents and immediately phone home for license checks or updates (e.g., cloud backup agents, endpoint management tools, developer SDKs). Software update daemons writing new plists during patch cycles."
    tuning_guidance = "Add known-good installer parent processes to %macos_allowed_plist_writers. Add approved SaaS update destinations or internal proxy egress ranges to %macos_allowed_update_destinations. Narrow the file path regex if only user-space LaunchAgents are in scope."

  events:
    // Leg 1: EDR file-creation of a launchd plist in a Library path
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(Library\/LaunchAgents|Library\/LaunchDaemons|Users\/[^\/]+\/Library\/LaunchAgents)\/.+\.plist$/ nocase
    not $file.principal.process.file.full_path in %macos_allowed_plist_writers
    $file.principal.hostname = $hostname

    // Leg 2: Outbound network connection from the same host observed by firewall
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $hostname
    not $net.target.ip in %macos_allowed_update_destinations
    not $net.target.ip in %rfc1918_internal

    // Chronological ordering: plist written before outbound connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053")
    $primary_entity = array_distinct($net.principal.hostname)
    $plist_paths_written = array_distinct($file.target.file.full_path)
    $outbound_destination_ips = array_distinct($net.target.ip)
    $outbound_destination_ports = array_distinct($net.target.port)
    $plist_writer_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $net
}
