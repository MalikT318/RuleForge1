/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:03:49.259117+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_Stripped_ELF_Written_To_Staging_Path {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-write events where an ELF binary is created or modified inside common staging or world-writable directories on Linux. Adversaries strip symbols, patch magic bytes, or repack ELF payloads to evade signature detection, then drop the modified artifact to /tmp, /dev/shm, /var/tmp, or similar paths before execution. This rule pivots on the resulting file artifact rather than the command line used to produce it, providing coverage that survives command-line log-evasion techniques."
    mitre_tactic         = "Defense Evasion"
    mitre_technique      = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites    = "Requires Linux EDR or auditd FILE_CREATION / FILE_MODIFICATION events with target.file.full_path and, where available, target.file.mime_type or target.file.file_type populated. Auditd rules -a always,exit -F arch=b64 -S openat,open_by_handle_at -F exit=0 -k file_write should be active."
    platform             = "Linux"
    log_source           = "linux_endpoint"
    false_positives      = "Package managers (apt, yum, rpm, dpkg) writing binaries to /tmp during installation; build systems (make, cmake, cargo, go build) emitting intermediate ELF objects to temp directories; container image build steps; legitimate software update agents; developer workstations compiling code locally."
    tuning_guidance      = "Add trusted build-system process paths (e.g. /usr/bin/dpkg, /usr/bin/rpm, /usr/bin/cargo) to %linux_allowed_elf_writers. Add approved staging directories used by your software deployment pipeline to %linux_allowed_staging_paths. Narrow severity for hosts tagged as build servers."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must reside in a world-writable or non-standard staging path
    // commonly abused to drop modified payloads
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/run\/user\/[0-9]+\/|\/proc\/[0-9]+\/fd\/)/ nocase

    // File name must not look like a benign temp file pattern (e.g. pure
    // dot-files, lock files, or files with common archive/text extensions).
    // We want files that could be ELF executables: no extension OR
    // extensions associated with compiled output.
    not $file.target.file.full_path = /\.(txt|log|conf|cfg|json|xml|yaml|yml|sh|py|rb|pl|lock|pid|sock|tmp|swp|bak|gz|xz|bz2|zip|tar)$/ nocase

    // Exclude writes by well-known package and build tooling
    not $file.principal.process.file.full_path in %linux_allowed_elf_writers

    // Exclude writes originating from known-safe staging directories
    not $file.target.file.full_path in %linux_allowed_staging_paths

    // The writing process must not itself live in a standard system binary
    // directory — narrows to unusual or user-space writers
    not $file.principal.process.file.full_path = /^\/usr\/(bin|sbin|lib|libexec)\/(dpkg|rpm|apt|yum|dnf|zypper|cargo|go|gcc|g\+\+|clang|make|cmake|ninja|pip|pip3|python|python3|ruby|perl|node|npm)$/ nocase

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_path      = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $writing_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
