/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:23:22.221794+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_Print_Processor_Registry_Key_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a registry key under the Print Processors path, which is the mechanism used by T1547.012 to register a malicious DLL that will be loaded by spoolsv.exe at boot with SYSTEM privileges. Legitimate print processor registrations are rare and typically occur only during printer driver installation."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14) normalised to UDM REGISTRY_CREATION or REGISTRY_MODIFICATION. Registry auditing must be enabled for HKLM\\SYSTEM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver installation packages (e.g., vendor print drivers deployed via GPO or SCCM) may create keys under this path. Printer management software and print server configuration tools may also trigger this rule."
    tuning_guidance = "Add known-good printer driver installer processes (e.g., msiexec.exe invoked by approved software deployment) to %global_allowed_print_processor_installers. Consider scoping by principal.user.userid to exclude dedicated print-server service accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Control\\Print\\Environments\\.*\\Print Processors\\/i nocase
    not $reg.principal.process.file.full_path in %global_allowed_print_processor_installers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
