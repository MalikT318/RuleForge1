/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:00:54.371073+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_BinaryPadding_LargeExecutableDropped {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation of suspiciously large executable files in user-writable or temporary directories on Windows. Binary padding inflates file size to evade hash-based blocklists and bypass tools with file-size scanning limits. This rule pivots on the FILE_CREATION artifact rather than command-line telemetry, providing additive coverage over process-launch rules."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised into UDM FILE_CREATION events with target.file.full_path and target.file.size populated. Sysmon Event ID 11 or equivalent EDR file-write telemetry."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate large installers dropped to TEMP by software deployment tools (SCCM, Intune, PDQ), game launchers, or developer build pipelines writing large binaries to user directories. Patch management agents may also write large executables transiently."
    tuning_guidance = "Add known-good parent processes (e.g. msiexec.exe, setup.exe paths used by approved deployment tools) to %global_allowed_large_file_writers. Raise the size threshold if the environment routinely deploys very large legitimate installers via user-writable paths. Scope exclusions to specific directories used by approved software distribution."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a Windows executable by extension
    $file.target.file.full_path = /\.(exe|dll|sys|scr|com|cpl|ocx)$/ nocase

    // File dropped into user-writable or staging directories commonly abused
    // Matches: %TEMP%, %APPDATA%, %LOCALAPPDATA%, %PUBLIC%, Downloads, Desktop
    $file.target.file.full_path = /\\(Temp|AppData|Local\\Temp|Roaming|Public|Downloads|Desktop)\\/i nocase

    // File size threshold: flag executables larger than 50 MB (52428800 bytes).
    // Binary padding commonly inflates binaries well beyond this to defeat scanners.
    // VirusTotal caps uploads at ~650 MB; padded samples often target 100-500 MB.
    $file.target.file.size > 52428800

    // Exclude known-good large-file writers (deployment agents, patch tools, etc.)
    not $file.principal.process.file.full_path in %global_allowed_large_file_writers

    // Exclude system-owned write paths that are legitimately large
    not $file.target.file.full_path = /\\Windows\\(Installer|SoftwareDistribution|WinSxS)\\/i nocase

    // Exclude files written by system-level processes running from System32/SysWOW64
    not $file.principal.process.file.full_path = /\\Windows\\(System32|SysWOW64)\\/i nocase

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $file_size_bytes   = max($file.target.file.size)

  condition:
    $file
}
