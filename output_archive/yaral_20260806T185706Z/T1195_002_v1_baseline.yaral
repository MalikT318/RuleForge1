/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:49:42.304527+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_Supply_Chain_Package_Tamper_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects post-install or post-upgrade file modifications to system package binaries and libraries outside of a legitimate package manager process. A compromised software supply chain often manifests as unexpected writes to /usr/bin, /usr/lib, /usr/local/bin, or /lib directories by processes that are not the system package manager (apt, dpkg, rpm, yum, dnf, zypper, pacman). This targets the OS-level result of supply chain compromise: a trusted binary or shared library being silently replaced or patched on disk."
    mitre_tactic    = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Compromise Software Supply Chain: Compromise Software Supply Chain"
    log_prerequisites = "Requires Linux EDR or auditd FILE_MODIFICATION / FILE_CREATION telemetry with principal process path populated. Auditd rules should watch -w /usr/bin -p wa, -w /usr/lib -p wa, -w /usr/local/bin -p wa, -w /lib -p wa, -w /lib64 -p wa."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate package manager upgrades (apt, dpkg, rpm, yum, dnf, zypper, pacman, snap, flatpak), configuration management agents (Ansible, Puppet, Chef, Salt), container image build processes, and developer workstation toolchain installs."
    tuning_guidance = "Add approved configuration-management or build-system process paths to %linux_allowed_package_writers. Scope to production server asset groups to reduce developer workstation noise. If snap or flatpak are in use, add their runtime paths to the exclusion list."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target: writes to directories that hold system executables and shared libraries
    $file.target.file.full_path = /^\/(usr\/(local\/)?(bin|sbin|lib(exec|64)?)|lib(64)?|sbin|bin)\// nocase

    // Exclude legitimate package managers and their helper processes
    not $file.principal.process.file.full_path = /\/(apt|apt-get|apt-cache|dpkg|rpm|yum|dnf|zypper|pacman|snap|flatpak|pip3?|gem|cargo|npm|yarn|go)\s*$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg-deb|dpkg-query|rpm2cpio|yumdownloader|dnf-automatic|zypper-log|makepkg|snapd|flatpak-builder)$/ nocase

    // Exclude kernel and initrd update helpers
    not $file.principal.process.file.full_path = /\/(update-initramfs|dracut|ldconfig|install-info|update-alternatives|mandb|gtk-update-icon-cache|glib-compile-schemas|systemctl|dbus-daemon)$/ nocase

    // Exclude root-owned configuration management agents
    not $file.principal.process.file.full_path = /\/(ansible|puppet|chef-client|salt-minion|cfengine|chef|ohai)$/ nocase

    // Exclude processes from the reference-list of approved writers (per-client tuning)
    not $file.principal.process.file.full_path in %linux_allowed_package_writers

    // Require a principal process to be populated (avoids noisy kernel-attributed events)
    $file.principal.process.file.full_path = /.+/

    // Capture key fields for outcome
    $file.principal.hostname = $hostname

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity    = array_distinct($file.principal.hostname)
    $modified_path     = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $actor_userid      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
