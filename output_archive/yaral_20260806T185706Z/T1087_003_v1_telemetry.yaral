/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:29:48.952066+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_GAL_Enumeration_M365_Resource_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or repeated access to the Global Address List (GAL) or directory resources in Microsoft 365 / Exchange Online via unified audit logs. Adversaries authenticated to M365 may enumerate the GAL to harvest email addresses and account metadata for phishing, lateral movement, or further targeting. This rule fires on USER_RESOURCE_ACCESS events targeting known GAL and directory API endpoints, providing artifact-layer coverage complementary to any existing process-creation detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log ingestion into Chronicle. Ensure Exchange Online and Azure AD audit logging are enabled and forwarded. Relevant operations include AddressBook, GlobalAddressList, and directory read events normalised to USER_RESOURCE_ACCESS."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate mail clients syncing the GAL on first connection, IT administrators auditing directory contents, HR or helpdesk tooling that queries the directory, and third-party integration services (e.g. GWSMO, CRM connectors)."
    tuning_guidance = "Add known service accounts and admin UPNs to %m365_allowed_gal_readers. Add approved application display names or resource paths to %m365_allowed_directory_apps. Raise the threshold or narrow the target.resource.name regex if the environment has heavy legitimate GAL sync traffic."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource must match GAL, address book, or directory enumeration paths
    // Covers Exchange Online OAB/GAL endpoints and Azure AD / Graph directory reads
    $cloud.target.resource.name = /global.?address.?list|address.?book|oab|\/users\?|directory\.read|people\.read|contacts\.read/ nocase

    // Exclude known-good automated service principals and approved readers
    not $cloud.principal.user.userid in %m365_allowed_gal_readers
    not $cloud.target.resource.name in %m365_allowed_directory_apps

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
