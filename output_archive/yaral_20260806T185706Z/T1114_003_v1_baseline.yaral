/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:42:09.985616+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_Email_Forwarding_Rule_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of email forwarding rules via PowerShell cmdlets (New-InboxRule, Set-InboxRule, New-TransportRule, Set-TransportRule) or the Exchange Management Shell. Adversaries with valid credentials use these cmdlets to silently forward mailbox contents to external or internal collection addresses, enabling persistent email collection even after credential resets."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 capturing PowerShell/cmd command lines. PowerShell Script Block Logging (Event 4104) also surfaces this activity when normalised into UDM PROCESS_LAUNCH events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate IT administrators configuring mail flow rules, compliance archiving solutions, helpdesk automation scripts, and migration tooling that creates transport rules."
    tuning_guidance = "Add authorised admin accounts to %email_rule_admin_allowlist and approved parent process paths to %global_allowed_admin_tools. Consider scoping to off-hours execution or non-admin user contexts for higher fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be a PowerShell host capable of running Exchange cmdlets
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase

    // Match forwarding-related cmdlets: inbox rules or transport/mail-flow rules
    (
      $proc.target.process.command_line = /New-InboxRule|Set-InboxRule/ nocase
      or
      $proc.target.process.command_line = /New-TransportRule|Set-TransportRule/ nocase
      or
      $proc.target.process.command_line = /New-MailboxRule|Set-MailboxRule/ nocase
    )

    // Must include a forwarding-related parameter to reduce noise from unrelated rule operations
    (
      $proc.target.process.command_line = /ForwardTo|ForwardAsAttachmentTo|RedirectTo|ForwardingAddress|ForwardingSMTPAddress/ nocase
    )

    // Exclude known-good administrative accounts and tooling
    not $proc.principal.user.userid in %email_rule_admin_allowlist
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $actor_userid = array_distinct($proc.principal.user.userid)
    $cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
