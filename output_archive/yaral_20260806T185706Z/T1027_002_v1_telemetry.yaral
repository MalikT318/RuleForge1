/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:01:42.799074+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Packed_ELF_Written_To_Suspicious_Path {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of an ELF binary that carries a known software-packer header magic (UPX, MPRESS, or generic packed-ELF indicators) in a world-writable or staging path on Linux. Packing changes the on-disk file artifact before execution; catching the write event provides earlier coverage than process-launch telemetry and is harder for an attacker to suppress."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires Linux EDR or auditd FILE_CREATION / FILE_MODIFICATION events with target.file.full_path and, where available, target.file.magic_bytes or target.file.mime_type populated. Auditd rules must include -a always,exit -F arch=b64 -S openat,open_by_handle_at -F exit=-EACCES and equivalent write-close watches on /tmp, /dev/shm, /var/tmp, and common staging directories."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate software distribution that ships pre-packed ELF binaries (some game engines, proprietary firmware updaters, commercial AV agents). Build pipelines that compress release binaries into /tmp before installation. Container image layer extraction."
    tuning_guidance = "Add known-good parent process paths (e.g. package-manager helpers, CI/CD agents) to %linux_allowed_packer_parents. Add approved staging directories to %linux_allowed_staging_paths. Narrow severity by correlating with the writing process's parent lineage."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be in a world-writable, memory-backed, or non-standard
    // staging location commonly abused for dropping packed payloads.
    // Legitimate package managers write to /var/cache or /usr, not these paths.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/run\/user\/[0-9]+\/|\/proc\/[0-9]+\/fd\/)/ nocase

    // The file must have an ELF-like extension or no extension at all
    // (packed binaries are frequently dropped without a .elf suffix).
    // Exclude clearly non-binary extensions to reduce noise.
    not $file.target.file.full_path = /\.(py|sh|pl|rb|js|txt|log|conf|json|xml|yaml|yml|csv|gz|tar|zip|deb|rpm)$/ nocase

    // Detect UPX packer signature in the file name or label field where
    // the EDR surfaces magic-byte derived metadata.
    // UPX stores "UPX!" at offset 0 and "UPX0"/"UPX1" section names.
    // Some EDRs surface this as a file type label or content tag.
    (
      $file.target.file.full_path = /upx/ nocase
      or
      $file.target.file.mime_type = /application\/x-executable/ nocase
      or
      $file.target.file.mime_type = /application\/x-elf/ nocase
      or
      $file.target.file.mime_type = /application\/octet-stream/ nocase
    )

    // The writing process must NOT be a known-good package manager or
    // authorised deployment tool.
    not $file.principal.process.file.full_path in %linux_allowed_packer_parents

    // Exclude writes originating from root-owned system paths that are
    // part of normal OS update workflows.
    not $file.principal.process.file.full_path = /^\/(usr\/bin\/(apt|dpkg|rpm|yum|dnf|zypper)|bin\/(rpm|dpkg))$/ nocase

    // Exclude known-good staging directories added per-client.
    not $file.target.file.full_path in %linux_allowed_staging_paths

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity    = array_distinct($file.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $file_mime_type    = array_distinct($file.target.file.mime_type)

  condition:
    $file
}
