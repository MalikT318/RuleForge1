/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:30:15.813815+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_Network_Config_Dump_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network flows consistent with SNMP bulk reads or Smart Install (SMI) protocol activity targeting network device management ports, which adversaries use to dump device configuration files. Focuses on traffic patterns to management-plane ports (SNMP UDP/161, TFTP UDP/69, SMI TCP/4786) from unexpected external or non-management sources."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Network Device Configuration Dump: Network Device Configuration Repository"
    log_prerequisites = "Requires IDS/IPS or network security appliance flow/connection telemetry normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Source and destination IP, port, and protocol fields must be populated."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Authorised NMS (Network Management Station) polling via SNMP, legitimate TFTP-based config backups from approved orchestration systems, authorised Smart Install deployments. Tune by adding approved management source IPs to %approved_mgmt_sources."
    tuning_guidance = "Populate %approved_mgmt_sources with the IP ranges of authorised NMS, TACACS/RADIUS servers, and config-backup systems. Populate %rfc1918_internal with internal RFC-1918 ranges if not already a platform list. Consider narrowing target.port to the specific protocol of concern (SNMP, TFTP, or SMI) if alert volume is high."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target management-plane ports used for config retrieval:
    // UDP 161  = SNMP (polling / bulk GET)
    // UDP 69   = TFTP (config file transfer)
    // TCP 4786 = Cisco Smart Install (SMI)
    (
      $net.target.port = 161 or
      $net.target.port = 69  or
      $net.target.port = 4786
    )

    // Exclude known-approved management sources
    not $net.principal.ip in %approved_mgmt_sources

    // Exclude purely internal RFC-1918 management traffic
    // (remove this exclusion if internal lateral movement is also in scope)
    not $net.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $target_port = array_distinct($net.target.port)

  condition:
    $net
}
