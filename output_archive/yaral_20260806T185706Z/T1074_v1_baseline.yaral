/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:38:49.097852+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_macOS_Data_Staging_Bulk_File_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects bulk file creation activity in macOS temporary or hidden staging directories commonly used by adversaries to aggregate collected data prior to exfiltration. Looks for file writes into world-writable, hidden, or user-library paths that are atypical for normal application behaviour and consistent with data staging (T1074)."
    mitre_tactic    = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "Requires macOS EDR telemetry with file creation events (e.g., CrowdStrike Falcon, SentinelOne, or Jamf Protect) normalised into Chronicle UDM FILE_CREATION events with target.file.full_path and principal.process.file.full_path populated."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Backup agents (Time Machine, Backblaze), developer build pipelines writing to /tmp, package managers (Homebrew), legitimate archiving utilities, cloud sync clients (Dropbox, OneDrive) staging local caches."
    tuning_guidance = "Add known backup/sync agent process paths to %macos_allowed_staging_processes. Add approved staging directories to %macos_allowed_staging_paths. Raise severity if the same host triggers this rule repeatedly within a short window."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: staging-indicative directories on macOS
    // Matches /tmp/, /var/tmp/, /private/tmp/, /private/var/tmp/,
    // hidden dot-directories under /Users/<any>/, and
    // /Users/<any>/Library/Caches/ or /Users/<any>/Library/Application Support/
    $file.target.file.full_path = /^(\/private)?\/(tmp|var\/tmp)\// nocase or
    $file.target.file.full_path = /^\/Users\/[^\/]+\/\.[^\/]+\// nocase or
    $file.target.file.full_path = /^\/Users\/[^\/]+\/Library\/(Caches|Application Support|Containers)\// nocase or
    $file.target.file.full_path = /^\/var\/folders\// nocase

    // Exclude macOS system processes that legitimately write to these paths
    not $file.principal.process.file.full_path = /\/(mds|mdworker|Spotlight|softwareupdated|installd|pkgd|cfprefsd|nsurlsessiond|trustd|syspolicyd)$/ nocase

    // Exclude known legitimate backup and sync agents
    not $file.principal.process.file.full_path in %macos_allowed_staging_processes

    // Exclude known approved staging paths (e.g., CI/CD build dirs)
    not $file.target.file.full_path in %macos_allowed_staging_paths

    // Focus on archive-like or data-collection-indicative file extensions
    // zip, tar, gz, bz2, 7z, rar, dmg, iso, db, sqlite, csv, json, xml, plist, log
    $file.target.file.full_path = /\.(zip|tar|gz|bz2|tgz|7z|rar|dmg|iso|db|sqlite3?|csv|json|xml|plist|log|txt|dat|out)$/ nocase

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity    = array_distinct($file.principal.hostname)

  condition:
    $file
}
