/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:06:56.846286+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_EmbeddedPayload_FileWrite_Then_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a suspicious file written to a user-writable or temp-like directory by a document/script host process, followed within 5 minutes by execution of that same file. This pattern is consistent with an embedded payload being extracted from a carrier document and then launched - a core T1027.009 behaviour. Complements existing command-line rules by correlating the file-drop event to the subsequent process launch."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION events (Sysmon Event ID 11) and PROCESS_LAUNCH events (Sysmon Event ID 1 / EDR equivalent). Both event types must be normalised into Chronicle UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers that self-extract to TEMP and immediately run; legitimate macro-enabled Office templates that drop helper binaries; RMM agents that stage executables before running them."
    tuning_guidance = "Add known-good parent processes (e.g. installer frameworks) to %global_allowed_dropper_parents. Add approved staging directories to %global_allowed_staging_paths. Narrow the file extension regex if PE-only coverage is sufficient."

  events:
    // --- Leg 1: a document/script host drops an executable-class file into a user-writable path ---
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|mspub|onenote|outlook|wscript|cscript|mshta|powershell|pwsh|cmd)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata\\(local\\temp|roaming)|downloads|desktop)|windows\\temp|programdata\\[^\\]+\\temp)/ nocase
    $file.target.file.full_path = /\.(exe|dll|scr|com|bat|ps1|vbs|js|hta|msi|cpl|pif)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_dropper_parents
    not $file.target.file.full_path in %global_allowed_staging_paths
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $dropped_path

    // --- Leg 2: the dropped file is subsequently launched as a process ---
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $dropped_path
    $proc.principal.hostname = $hostname

    // --- Chronological ordering: file must be written before it is executed ---
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $dropped_path over 5m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1027.009")
    $primary_entity      = array_distinct($file.principal.hostname)
    $dropper_process     = array_distinct($file.principal.process.file.full_path)
    $dropped_file        = array_distinct($file.target.file.full_path)
    $child_command_line  = array_distinct($proc.target.process.command_line)
    $child_process       = array_distinct($proc.target.process.file.full_path)

  condition:
    $file and $proc
}
