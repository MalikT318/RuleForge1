/*
  MITRE Technique : T1583.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:19:42.675250+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_007_Serverless_C2_Proxy_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects repeated outbound HTTP/HTTPS connections to serverless cloud provider subdomains commonly abused as C2 proxies or redirectors (e.g., Cloudflare Workers, AWS Lambda URLs, Google Apps Script endpoints). Adversaries leverage these platforms to blend malicious traffic with legitimate cloud provider traffic and obscure infrastructure attribution."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.007"
    mitre_technique_name = "Acquire Infrastructure: Serverless"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with HTTP/HTTPS flow visibility including target hostname or SNI fields. Proxy or SSL inspection logs improve coverage."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate use of Cloudflare Workers for SaaS applications, AWS Lambda function URLs for internal tooling, Google Apps Script automations, and developer testing of serverless functions."
    tuning_guidance = "Add known-good serverless hostnames used by your organisation to %allowed_serverless_endpoints. Raise the threshold or add a frequency match block if single-event fidelity is too low. Correlate with threat intel on specific worker/function subdomains for higher confidence."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.hostname = /\.(workers\.dev|cloudflarestorage\.com|pages\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|script\.google\.com|cloudfunctions\.net|azurewebsites\.net|azurestaticapps\.net|netlify\.app|vercel\.app|run\.app)$/ nocase
    not $net.target.hostname in %allowed_serverless_endpoints
    not $net.principal.hostname in %excluded_internal_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hostname = array_distinct($net.target.hostname)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
