/*
  MITRE Technique : T1583.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:18:25.849201+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_002_DNS_C2_Infrastructure_Indicators {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS query patterns consistent with adversary-controlled DNS C2 infrastructure: high-entropy subdomains, abnormal record types (TXT/NULL), excessively long subdomain labels, and algorithmically generated domain patterns. These are hallmarks of DNS tunneling or beaconing through attacker-operated resolvers."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.002"
    mitre_technique_name = "Acquire Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS resolver or recursive query logs normalized to UDM NETWORK_DNS. Fields needed: network.dns.questions.name, network.dns.questions.type, principal.hostname or principal.ip."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN providers using long CNAME chains, legitimate TXT record lookups for SPF/DKIM/DMARC validation, cloud service discovery using generated subdomains, monitoring and telemetry agents using encoded hostnames."
    tuning_guidance = "Populate %dns_allowlisted_domains with known-good base domains (CDN, cloud providers, internal resolvers). Adjust subdomain length threshold or entropy regex patterns based on observed baseline. Consider adding %dns_allowlisted_query_sources for trusted internal resolvers."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    (
      // Abnormal DNS record types used for C2 tunneling: TXT (16), NULL (10), ANY (255)
      $dns.network.dns.questions.type = 16 or
      $dns.network.dns.questions.type = 10 or
      $dns.network.dns.questions.type = 255
    )

    // Long subdomain labels indicative of data encoding or DGA
    // Matches subdomains with labels exceeding ~40 characters before the second-level domain
    $dns.network.dns.questions.name = /^[a-z0-9\-]{40,}\.[a-z0-9\-]+\.[a-z]{2,}$/ nocase

    // Exclude known-good domains from triggering
    not $dns.network.dns.questions.name in %dns_allowlisted_domains

    // Exclude known-good internal resolver sources
    not $dns.principal.hostname in %dns_allowlisted_query_sources

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1583.002")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domain = array_distinct($dns.network.dns.questions.name)
    $query_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
