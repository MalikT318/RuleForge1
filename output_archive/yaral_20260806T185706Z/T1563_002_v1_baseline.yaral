/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:13:18.227423+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Session_Hijack_Via_Identity_Login {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects RDP session hijacking activity via identity provider telemetry. When an adversary hijacks a disconnected RDP session using tscon.exe under SYSTEM context, the legitimate session owner may be forcibly disconnected and a new authentication event may appear for that account from an unexpected source or with anomalous characteristics. This rule targets interactive RDP logins that originate from internal infrastructure accounts or service-like principals, which is a common post-hijack authentication pattern visible in identity provider sign-in logs."
    mitre_tactic         = "Lateral Movement"
    mitre_technique      = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites    = "Requires identity provider sign-in audit logs normalised into Chronicle UDM. Events must populate metadata.event_type = USER_LOGIN, target.user.userid, principal.ip, and network.application_protocol or extensions.auth.auth_details fields indicating RDP/RemoteInteractive logon type."
    platform             = "Windows"
    log_source           = "identity"
    false_positives      = "Legitimate IT administrators performing remote support via RDP from jump hosts; automated RMM tooling authenticating on behalf of users; shared service accounts used for remote administration; helpdesk staff accessing disconnected sessions for troubleshooting."
    tuning_guidance      = "Add known jump-host IP ranges to %rdp_approved_jump_hosts. Add authorised service account prefixes to %rdp_allowed_service_accounts. Narrow the logon_type filter if your identity provider populates a more specific field. Consider pairing with a threshold rule to suppress single-occurrence noise from approved admin hosts."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // RDP / RemoteInteractive logon type - identity providers normalise
    // Windows logon type 10 (RemoteInteractive) into auth_details or
    // the application_protocol field; match both common normalisations.
    (
      $auth.extensions.auth.auth_details = /remoteinteractive|logon.?type.?10|rdp/ nocase
      or
      $auth.network.application_protocol = /rdp/ nocase
    )

    // The authenticating account name matches patterns typical of
    // SYSTEM-context hijack: the session is taken over and the original
    // user's token is presented, but the source is anomalous.
    // Exclude clearly interactive human-named accounts from approved hosts.
    not $auth.principal.ip in %rdp_approved_jump_hosts

    // Flag logins where the user account carries service/admin naming
    // conventions that should never initiate an interactive RDP session,
    // OR where the source IP is non-RFC1918 (external), which is unusual
    // for a hijacked internal session pivot.
    (
      $auth.target.user.userid = /^(svc_|svc-|adm_|adm-|sa_|sa-|_svc|system)/ nocase
      or
      not $auth.principal.ip in %rfc1918_internal
    )

    // Exclude known-good service accounts explicitly allowed to RDP.
    not $auth.target.user.userid in %rdp_allowed_service_accounts

    // Exclude machine accounts (dollar-suffix) which generate noise from
    // legitimate Kerberos computer authentication events.
    not $auth.target.user.userid = /\$$/ nocase

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity    = array_distinct($auth.target.user.userid)
    $source_ip         = array_distinct($auth.principal.ip)
    $target_user       = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
