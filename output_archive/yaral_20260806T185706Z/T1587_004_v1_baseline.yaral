/*
  MITRE Technique : T1587.004 - Exploits
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:22:49.225565+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_004_Exploit_Dev_Recon_Probe_Patterns {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects network-observable patterns consistent with exploit development reconnaissance: sequential or rapid HTTP probing of known vulnerability-related URI paths, error-triggering payloads, and fuzzing-style request patterns against external-facing assets. Adversaries developing custom exploits commonly probe targets with crafted requests to identify vulnerable parameters, version banners, and error conditions prior to weaponisation."
    mitre_tactic    = "Resource Development"
    mitre_technique = "T1587.004"
    mitre_technique_name = "Develop Capabilities: Exploits"
    log_prerequisites = "Requires perimeter firewall or reverse-proxy HTTP logs normalised to UDM NETWORK_HTTP, including target.url, network.http.method, network.http.response_code, and principal.ip."
    platform        = "PRE"
    log_source      = "firewall"
    false_positives = "Legitimate vulnerability scanners (Qualys, Tenable, Rapid7) run by the customer's own security team; web application penetration tests; bug-bounty automated scanners; CDN health-check probes."
    tuning_guidance = "Add authorised scanner source IPs to %approved_vuln_scanners. Add internal RFC-1918 ranges to %rfc1918_internal to suppress internal traffic. Raise the response-code threshold or restrict to specific URI patterns if false-positive volume is high."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Source must not be an approved internal or scanner address
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %approved_vuln_scanners

    // Probe patterns: URI paths commonly targeted during exploit development recon
    // Covers path traversal attempts, common CVE-targeted endpoints, fuzzing delimiters,
    // and version-disclosure probes - all observable at the perimeter without endpoint context
    (
      $net.target.url = /\/(\.\.[\/\\]){2,}/ nocase or
      $net.target.url = /\/(phpinfo|server-status|server-info|elmah\.axd|trace\.axd|web\.config|\.env|\.git\/|\.svn\/|WEB-INF\/)/ nocase or
      $net.target.url = /[?&][^=]+=.*(%27|%22|%3c|%3e|%00|%0a|%0d|%3b|%7c|%60|%5c)/ nocase or
      $net.target.url = /\/(cgi-bin|scripts|bin)\// nocase or
      $net.target.url = /(union.*select|select.*from|insert.*into|drop.*table|exec\(|eval\(|system\(|passthru\()/ nocase or
      $net.target.url = /(\$\{.*\}|#\{.*\}|\{\{.*\}\})/ nocase or
      $net.target.url = /\/(actuator|swagger-ui|api-docs|graphql|_profiler|debug\/default\/view)/ nocase
    )

    // Focus on server-side error responses that indicate the probe reached application logic
    // 4xx/5xx responses are strong indicators the payload triggered abnormal handling
    (
      $net.network.http.response_code >= 400
    )

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1587.004")
    $primary_entity    = array_distinct($net.principal.ip)

  condition:
    $net
}
