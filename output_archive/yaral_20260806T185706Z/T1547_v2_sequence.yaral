/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:18:12.568364+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_NetDev_Config_Change_Then_Exfil_Flow {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a network device configuration or startup-file modification (SETTING_MODIFICATION) followed within 10 minutes by an outbound flow to an external destination from the same device. On network devices, adversaries may alter startup-config, boot variables, or autostart scripts to achieve persistence; the subsequent outbound connection may represent exfiltration of the modified config or a callback to a staging server. This rule provides additive coverage beyond process-launch / command-line detections by operating purely on management-plane and flow telemetry."
    mitre_tactic         = "Persistence, Privilege Escalation"
    mitre_technique      = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites    = "Requires network device syslog normalised to UDM SETTING_MODIFICATION (config-change events) and NETWORK_FLOW or NETWORK_CONNECTION records from the same device. Both must be ingested into the same Chronicle instance."
    platform             = "Network Devices"
    log_source           = "firewall"
    false_positives      = "Scheduled configuration backups that push config to an authorised TFTP/SCP server; NMS polling after a change window; automated compliance tools that read running-config after every commit."
    tuning_guidance      = "Add authorised management-plane destinations (TFTP servers, NMS collectors, jump hosts) to %allowed_mgmt_destinations. Add authorised admin accounts that routinely modify startup config to %allowed_config_admin_users. Narrow the destination port filter if your environment only uses specific exfil-risk ports."

  events:
    // Leg 1: configuration or startup-file modification on the network device
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname  = $device_hostname
    // Exclude changes made by known authorised admin accounts
    not $cfg.principal.user.userid in %allowed_config_admin_users
    // Anchor on keywords that indicate startup / boot persistence targets
    (
      $cfg.target.resource.name = /startup-config/    nocase or
      $cfg.target.resource.name = /boot/              nocase or
      $cfg.target.resource.name = /autostart/         nocase or
      $cfg.target.resource.name = /nvram/             nocase or
      $cfg.target.resource.name = /running-config/    nocase
    )

    // Leg 2: outbound network flow originating from the same device
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname  = $device_hostname
    // Must be destined outside trusted management space
    not $flow.target.ip in %allowed_mgmt_destinations
    // Focus on ports commonly abused for config exfiltration or C2 callbacks
    (
      $flow.target.port = 69   or   // TFTP (unexpected external destination)
      $flow.target.port = 21   or   // FTP
      $flow.target.port = 22   or   // SSH to unknown external host
      $flow.target.port = 443  or   // HTTPS
      $flow.target.port = 80   or   // HTTP
      $flow.target.port = 4444 or   // Common reverse-shell port
      $flow.target.port = 8080      // Alternate HTTP
    )

    // Chronological ordering: config change must precede the outbound flow
    $cfg.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 10m

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity    = array_distinct($device_hostname)
    $modified_resource = array_distinct($cfg.target.resource.name)
    $admin_user        = array_distinct($cfg.principal.user.userid)
    $destination_ips   = array_distinct($flow.target.ip)
    $destination_ports = array_distinct($flow.target.port)
    $flow_bytes_out    = max($flow.network.sent_bytes)

  condition:
    $cfg and $flow
}
