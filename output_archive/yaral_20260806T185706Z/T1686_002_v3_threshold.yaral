/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T18:57:38.820204+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Repeated_Firewall_Policy_Bypass_Attempts {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a high volume of network connections from a single source host that are permitted through a network device in a short window, suggesting firewall rules may have been modified to allow previously blocked traffic. Individual permitted flows are benign; a sudden burst from one source toward diverse internal destinations is anomalous and consistent with ACL or policy tampering enabling unrestricted inbound/outbound connectivity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Requires IDS/IPS or network security appliance flow/connection logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Logs must include principal.ip and target.ip fields."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Legitimate bulk data transfers, backup jobs, network scanning tools operated by the security team, CDN or load-balancer fan-out, and newly provisioned hosts performing initial synchronisation."
    tuning_guidance = "Add known bulk-transfer source IPs to %ips_allowed_bulk_sources. Raise the count threshold if baseline traffic from monitored segments is naturally high. Narrow target.port to sensitive management ports (22, 23, 443, 8443) to reduce noise from general internet traffic."

  events:
    $flow.metadata.event_type = "NETWORK_CONNECTION"
    $flow.principal.ip != ""
    $flow.target.ip != ""
    not $flow.principal.ip in %ips_allowed_bulk_sources
    not $flow.target.ip in %ips_allowed_bulk_sources
    $flow.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($src_ip)
    $distinct_destinations = count(distinct $flow.target.ip)
    $distinct_ports = count(distinct $flow.target.port)
    $total_connections = count($flow.target.ip)

  condition:
    #flow >= 200 and $distinct_destinations >= 10
}
