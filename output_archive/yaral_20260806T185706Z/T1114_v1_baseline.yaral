/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:41:27.981930+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Email_Exfil_IDS_Anomalous_Mail_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects anomalous email-protocol traffic patterns on non-standard ports or to unexpected destinations that may indicate email collection or exfiltration from macOS endpoints. Targets IDS/IPS observations of IMAP, POP3, SMTP, or MAPI sessions exhibiting suspicious characteristics such as large data transfers, unusual port usage, or cleartext credential exposure flagged by network sensors."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM. Sensor must inspect layer-7 traffic and generate NETWORK_CONNECTION or NETWORK_FLOW events with application-layer metadata including destination port and bytes transferred."
    platform = "macOS"
    log_source = "ips"
    false_positives = "Legitimate bulk email clients, mail migration tools, authorised mail archiving appliances, and backup agents that transfer large volumes of mail data. Mobile device management (MDM) solutions syncing mail profiles may also trigger this rule."
    tuning_guidance = "Add known mail-relay and archiving appliance IPs to %global_allowed_mail_relays. Add authorised mail-migration source hosts to %global_allowed_mail_migration_hosts. Raise the bytes threshold if bulk-mail workflows are common in the environment."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Match email protocols on both standard and non-standard ports
    // Standard: SMTP 25/587/465, IMAP 143/993, POP3 110/995
    // Non-standard ports carrying these protocols are higher fidelity
    (
      $net.target.port = 25 or
      $net.target.port = 110 or
      $net.target.port = 143 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 993 or
      $net.target.port = 995 or
      $net.target.port = 2525 or
      $net.target.port = 8025
    )

    // Large outbound data volume is a key signal for bulk email collection/exfil
    // 10 MB threshold balances sensitivity vs noise; tune via outcome comment
    $net.network.sent_bytes > 10485760

    // Exclude known-good internal mail infrastructure
    not $net.principal.hostname in %global_allowed_mail_migration_hosts
    not $net.target.ip in %global_allowed_mail_relays

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
