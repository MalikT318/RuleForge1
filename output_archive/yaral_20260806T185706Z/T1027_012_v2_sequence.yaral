/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:08:59.196909+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_Icon_Smuggling_File_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects LNK Icon Smuggling: a .lnk file is created in a user-writable or temp location, followed within 5 minutes by a network connection from a scripting interpreter or shell process on the same host. This pattern indicates the LNK icon location field may have triggered an outbound payload retrieval."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Event ID 11) and network-connection telemetry (Event ID 3) normalised to UDM FILE_CREATION and NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that create shortcuts and immediately phone home for updates; RMM agents that deploy shortcuts and check licensing servers; browser-based file downloads that create .lnk files in Downloads."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_lnk_creators. Add internal update server IPs/ranges to %rfc1918_internal or a dedicated allow-list. Narrow the file path regex if only specific user directories are relevant in your environment."

  events:
    // Leg 1: A .lnk file is created in a user-writable or staging location
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(lnk)$/ nocase
    $file.target.file.full_path = /(\\Users\\|\\Temp\\|\\AppData\\|\\Downloads\\|\\Desktop\\|\\Public\\|\\ProgramData\\)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_lnk_creators
    $file.principal.hostname = $hostname

    // Leg 2: A scripting or shell process makes an external network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(\\cmd\.exe|\\powershell\.exe|\\pwsh\.exe|\\wscript\.exe|\\cscript\.exe|\\mshta\.exe|\\explorer\.exe|\\rundll32\.exe|\\regsvr32\.exe)$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.target.port != 0
    $net.principal.hostname = $hostname

    // Chronological ordering: file creation precedes network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $lnk_file_paths = array_distinct($file.target.file.full_path)
    $lnk_creating_process = array_distinct($file.principal.process.file.full_path)
    $network_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $file and $net
}
