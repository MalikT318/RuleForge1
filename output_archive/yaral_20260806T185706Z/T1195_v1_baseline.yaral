/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:48:59.661024+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_Supply_Chain_New_ServicePrincipal_Consent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new service principal or OAuth application consent grant in an identity provider directory. Supply chain attackers who compromise a software vendor's identity may register rogue service principals or consent to broad OAuth scopes to establish persistent access into downstream customer tenants. This rule fires on the directory audit event that records such a creation, which is a high-fidelity signal when the actor or application is not pre-approved."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires identity provider directory audit logs (e.g. Entra ID / Azure AD audit log category DirectoryManagement or ApplicationManagement) normalised into Chronicle UDM. The USER_RESOURCE_CREATION event type must be populated with target.resource.type and principal.user.userid."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate DevOps pipelines registering new service principals, IT administrators onboarding approved SaaS integrations, automated provisioning workflows."
    tuning_guidance = "Populate %approved_service_principal_creators with the user IDs or service accounts authorised to register applications in your tenants. Populate %approved_application_display_names with known-good app names if your environment has a fixed catalogue. Alert volume can be reduced by scoping to high-privilege OAuth scopes (e.g. Directory.ReadWrite.All) if the identity provider surfaces scope in the audit payload."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_CREATION"
    // Target resource must be a service principal, application registration, or OAuth consent grant
    $cloud.target.resource.type = /service.?principal|application|oauth.*consent|app.*registr/ nocase
    // Exclude pre-approved automation accounts and known provisioning identities
    not $cloud.principal.user.userid in %approved_service_principal_creators
    // Exclude known-good application display names registered by the organisation
    not $cloud.target.resource.name in %approved_application_display_names
    // Capture the acting user for join / grouping
    $cloud.principal.user.userid = $actor

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $created_resource_name = array_distinct($cloud.target.resource.name)
    $created_resource_type = array_distinct($cloud.target.resource.type)
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
