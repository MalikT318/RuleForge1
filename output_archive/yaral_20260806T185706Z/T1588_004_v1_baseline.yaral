/*
  MITRE Technique : T1588.004 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:23:34.545090+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_004_Suspicious_Cert_Authority_DNS_Queries {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries to certificate authority issuance, ACME challenge, and certificate transparency endpoints that may indicate adversary acquisition of SSL/TLS certificates for use in C2 infrastructure or adversary-in-the-middle operations. Focuses on high-frequency or anomalous query patterns to CA validation infrastructure from a single source."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.004"
    mitre_technique_name = "Obtain Capabilities: Digital Certificates"
    log_prerequisites = "Requires DNS query/resolver logs forwarded to Chronicle. Recursive resolver or DNS firewall logs with per-query visibility (query name, type, source IP) are required."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate DevOps pipelines using Let's Encrypt or ZeroSSL for automated certificate renewal (certbot, acme.sh). Web servers performing OCSP stapling. Security scanners performing certificate transparency lookups. CDN providers validating domain ownership."
    tuning_guidance = "Add known-good source IP ranges (CI/CD infrastructure, web server egress IPs) to %global_allowed_cert_automation_sources. Add approved CA validation domains to %global_allowed_ca_domains. Raise the threshold or narrow to specific query types (TXT, CAA) if volume is high in environments with heavy Let's Encrypt automation."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Target CA issuance, ACME challenge validation, OCSP, CRL, and
    // certificate transparency log infrastructure - all domains an
    // adversary must interact with to obtain or validate a certificate.
    // Matches patterns like:
    //   acme-v02.api.letsencrypt.org
    //   _acme-challenge.<domain>
    //   ocsp.digicert.com, ocsp.pki.goog
    //   crl.comodoca.com, crl3.digicert.com
    //   crt.sh, censys.io (CT log search used for recon)
    //   api.zerossl.com, acme.zerossl.com
    //   sectigo.com OCSP/CRL endpoints
    (
      $dns.network.dns.questions.name = /acme[-\.]/ nocase
      or $dns.network.dns.questions.name = /_acme-challenge\./ nocase
      or $dns.network.dns.questions.name = /letsencrypt\.org$/ nocase
      or $dns.network.dns.questions.name = /zerossl\.com$/ nocase
      or $dns.network.dns.questions.name = /buypass\.com$/ nocase
      or $dns.network.dns.questions.name = /ocsp\.(digicert|comodoca|sectigo|pki\.goog|usertrust)/ nocase
      or $dns.network.dns.questions.name = /crl\d*\.(digicert|comodoca|sectigo|usertrust|globalsign)/ nocase
      or $dns.network.dns.questions.name = /crt\.sh$/ nocase
      or $dns.network.dns.questions.name = /api\.certspotter\.com$/ nocase
    )

    // Exclude known-good automation sources (CI/CD, web server egress)
    not $dns.principal.ip in %global_allowed_cert_automation_sources

    // Exclude known-good CA domains that are routine in the environment
    not $dns.network.dns.questions.name in %global_allowed_ca_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1588.004")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_ca_domain = array_distinct($dns.network.dns.questions.name)
    $dns_question_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
