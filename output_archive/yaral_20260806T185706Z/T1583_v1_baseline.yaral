/*
  MITRE Technique : T1583 - Acquire Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:17:51.147959+00:00
  Reference       : https://attack.mitre.org/techniques/T1583
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_Acquire_Infrastructure_Suspicious_Hosting_Recon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP/HTTPS connections to cloud hosting, VPS, domain registrar, or infrastructure-as-a-service provider APIs that are consistent with adversary infrastructure acquisition activity. Adversaries frequently query hosting provider APIs, domain registration endpoints, or bulk-provisioning portals as part of T1583 pre-compromise resource development. This rule fires on connections from internal hosts to known infrastructure provisioning URL patterns, which are rarely accessed by normal enterprise users."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583"
    mitre_technique_name = "Acquire Infrastructure"
    log_prerequisites = "Requires perimeter firewall or web proxy logs with full URL visibility (HTTP Host header or TLS SNI decryption). Proxy must forward target.hostname and network.http.request_url to Chronicle UDM."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "DevOps engineers provisioning legitimate cloud resources, IT staff purchasing domains, automated CI/CD pipelines interacting with cloud provider APIs, SaaS management tooling."
    tuning_guidance = "Add known-good source IPs (DevOps subnets, CI/CD runners) to %global_allowed_infra_provisioning_sources. Add approved cloud management hostnames to %global_allowed_cloud_mgmt_hosts. Scope to non-DevOps user segments to reduce noise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Target hostname matches infrastructure provisioning or domain registration patterns
    // Covers VPS providers, domain registrars, bulletproof hosting APIs, and residential proxy services
    $net.target.hostname = /\b(api\.|console\.|portal\.|dashboard\.|register\.|checkout\.|order\.|billing\.|account\.)/ nocase
    $net.target.hostname = /(vultr|linode|digitalocean|hetzner|ovh|contabo|hostinger|namecheap|godaddy|porkbun|dynadot|namesilo|njalla|epik|spaceship|buyvm|frantech|psychz|sharktech|serverius|combahton|servermania|packetframe|lunanode|racknerd|hostwinds|ionos|1and1|hostgator|bluehost|dreamhost|a2hosting|siteground|cloudways|kamatera|exoscale|upcloud|scaleway|gcore|aeza|vdsina|ahost|serverastra|cheapwindowsvps|proxyrack|brightdata|oxylabs|smartproxy|netnut|iproyal|rayobyte|soax|webshare)/ nocase

    // HTTP method consistent with API provisioning calls (POST for creation, GET for enumeration)
    $net.network.http.method = /^(POST|GET|PUT)$/ nocase

    // Exclude connections originating from known internal management ranges
    not $net.principal.ip in %global_allowed_infra_provisioning_sources

    // Exclude connections to approved cloud management destinations
    not $net.target.hostname in %global_allowed_cloud_mgmt_hosts

    // Exclude connections to major hyperscaler management planes that are broadly used
    // (AWS, Azure, GCP console traffic is extremely high volume and handled separately)
    not $net.target.hostname = /\.(amazonaws\.com|azure\.com|googleapis\.com|microsoft\.com|google\.com)$/ nocase

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
