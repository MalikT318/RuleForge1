/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:53:22.385297+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_SyncAppvPublishingServer_PowerShell_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects abuse of SyncAppvPublishingServer.vbs to proxy PowerShell command execution, bypassing PowerShell execution restrictions. Adversaries invoke wscript.exe with SyncAppvPublishingServer.vbs and embed PowerShell commands in the argument string to evade defenses while living off the land."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line logging enabled."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate App-V publishing synchronization initiated by SCCM, Intune, or enterprise application virtualization infrastructure. Rare in environments that do not deploy App-V."
    tuning_guidance = "Add known App-V management hosts to %global_allowed_appv_principals. Scope by parent process if SCCM/Intune agents are triggering false positives. Environments not using App-V should see near-zero false positives."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // wscript.exe is the canonical launcher for this LOLBin technique
    $proc.target.process.file.full_path = /\\wscript\.exe$/ nocase

    // The script must be SyncAppvPublishingServer.vbs, typically from System32
    $proc.target.process.command_line = /SyncAppvPublishingServer\.vbs/ nocase

    // The defining malicious signal: PowerShell commands embedded after the script argument
    // Matches patterns like: "n; Get-Process" or "n; IEX(...)" or "n; Invoke-Expression"
    $proc.target.process.command_line = /;\s*(powershell|iex|invoke-expression|invoke-command|invoke-webrequest|downloadstring|downloadfile|net\.webclient|start-process|new-object|bypass|encodedcommand|-enc\s)/ nocase

    // Exclude known legitimate App-V management tooling parent processes
    not $proc.principal.process.file.full_path in %global_allowed_appv_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $initiating_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
