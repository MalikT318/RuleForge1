/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:24:28.571308+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_ActiveSetup_Registry_Then_UserLogin {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects Active Setup persistence: a StubPath value is written under HKLM\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\ followed by an interactive user login on the same host within 10 minutes. The sequence indicates the registry entry was staged immediately before a logon that would trigger it."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 13 / REGISTRY_MODIFICATION) and Windows Security logon events (Event ID 4624) or equivalent EDR session-start telemetry normalised to USER_LOGIN."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers (Office, Visual Studio, Adobe) that register Active Setup components during installation; Windows Update; enterprise software deployment tools (SCCM, Intune) that write Active Setup keys as part of per-user configuration."
    tuning_guidance = "Populate %active_setup_allowed_writers with full paths of known-good installer processes (e.g. msiexec.exe, setup.exe from approved software). Populate %active_setup_allowed_components with known-good GUID subkeys if specific GUIDs are noisy. Consider raising severity to Critical for non-interactive logon types."

  events:
    // Event 1: StubPath value written under Active Setup registry key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\/i nocase
    $reg.target.registry.registry_value_name = /^StubPath$/ nocase
    not $reg.principal.process.file.full_path in %active_setup_allowed_writers
    $reg.principal.hostname = $hostname

    // Event 2: Interactive user login on the same host shortly after
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.user.userid in %active_setup_allowed_service_accounts

    // Chronological ordering: registry write must precede the login
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1547.014")
    $primary_entity      = array_distinct($reg.principal.hostname)
    $modified_reg_key    = array_distinct($reg.target.registry.registry_key)
    $stub_path_value     = array_distinct($reg.target.registry.registry_value_data)
    $writing_process     = array_distinct($reg.principal.process.file.full_path)
    $logged_in_user      = array_distinct($auth.principal.user.userid)

  condition:
    $reg and $auth
}
