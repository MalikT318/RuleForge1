/*
  MITRE Technique : T1608.003 - Install Digital Certificate
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:32:24.916134+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_003_Suspicious_TLS_Cert_Install_Probe {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects inbound HTTPS connections to newly observed or low-reputation external hosts on port 443 that exhibit certificate-provisioning patterns consistent with adversary infrastructure staging. Specifically targets HTTP requests to well-known ACME/certificate-authority validation endpoints (e.g., /.well-known/acme-challenge/) originating from external IPs, which indicate an adversary is completing domain-validation challenges to install a trusted TLS certificate on attacker-controlled infrastructure. Also covers direct certificate-file fetch patterns over HTTP/S."
    mitre_tactic    = "Resource Development"
    mitre_technique = "T1608.003"
    mitre_technique_name = "Install Digital Certificate"
    log_prerequisites = "Requires perimeter firewall or proxy logs with HTTP request URI, source/destination IP, and destination port normalised into UDM NETWORK_HTTP events. SSL inspection or HTTP proxy visibility is required to observe URI paths."
    platform        = "PRE"
    log_source      = "firewall"
    false_positives = "Legitimate web servers renewing Let's Encrypt or ZeroSSL certificates via ACME HTTP-01 challenge; DevOps pipelines using certbot or acme.sh; CDN origin-validation probes."
    tuning_guidance = "Add known-good certificate-renewal source IPs (e.g., Let's Encrypt validation servers) to %allowed_acme_sources. Add approved internal server CIDRs to %internal_address_space. Raise severity if the destination IP has no prior connection history in your environment."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"

    // Target ACME HTTP-01 challenge path used to prove domain control
    // before a CA issues a certificate - core observable for T1608.003
    (
      $http.target.url = /\/\.well-known\/acme-challenge\// nocase
      or
      $http.target.url = /\.(crt|pem|cer|der|p7b|pfx|key)(\?|$)/ nocase
      or
      $http.network.http.request_headers = /acme-challenge/ nocase
    )

    // Restrict to standard TLS/HTTP ports where cert provisioning occurs
    (
      $http.target.port = 80
      or
      $http.target.port = 443
      or
      $http.target.port = 8080
      or
      $http.target.port = 8443
    )

    // Exclude traffic originating from known-good ACME validation sources
    not $http.principal.ip in %allowed_acme_sources

    // Exclude traffic to internal address space - focus on external infra staging
    not $http.target.ip in %internal_address_space

    // Exclude known-good certificate authority infrastructure
    not $http.target.hostname in %allowed_ca_infrastructure

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1608.003")
    $primary_entity    = array_distinct($http.principal.ip)
    $destination_host  = array_distinct($http.target.hostname)
    $destination_ip    = array_distinct($http.target.ip)
    $challenged_url    = array_distinct($http.target.url)

  condition:
    $http
}
