/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:50:55.889586+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_Traffic_Signaling_Auth_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects authentication events consistent with traffic signaling / port-knocking behavior: a successful login from an account with no prior recent activity, originating from an unusual source, potentially following a sequence of failed attempts that could represent a knock sequence. On identity provider logs this surfaces as a successful authentication after a burst of failures from the same source, which is a common pattern when adversaries use magic-value sequences to unlock access."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Requires identity provider sign-in logs normalized to UDM USER_LOGIN events, including authentication result, MFA details, and source IP/location fields."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate users who rarely authenticate, VPN or proxy users whose IPs change frequently, automated service accounts with irregular schedules, password-reset flows that generate failure-then-success patterns."
    tuning_guidance = "Add known service account userids to %global_allowed_service_accounts. Add approved automation source CIDRs to %global_allowed_automation_ips. Raise the failure threshold or narrow the time window if alert volume is high in environments with aggressive MFA retry policies."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Successful authentication - the 'open port' moment after the knock sequence
    $auth.security_result.summary = /success|succeeded|authenticated/ nocase

    // Exclude known service accounts and automation principals
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude known approved automation source IPs
    not $auth.principal.ip in %global_allowed_automation_ips

    // Target accounts that authenticated without MFA or with a bypassed MFA step,
    // which is consistent with signaling-based backdoor access that sidesteps
    // normal interactive authentication flows
    $auth.extensions.auth.auth_details = /no.?mfa|mfa.?bypass|mfa.?skipped|single.?factor|passwordless.?bypass/ nocase

    // Capture the user and source for outcome
    $auth.principal.user.userid = $userid

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_resource = array_distinct($auth.target.resource.name)
    $auth_mechanism = array_distinct($auth.extensions.auth.auth_details)

  condition:
    $auth
}
