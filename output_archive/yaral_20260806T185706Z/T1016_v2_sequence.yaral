/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:25:30.470112+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_NetConfig_Discovery_Burst_Then_Outbound {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Medium"
    description     = "Detects a burst of network-configuration discovery tool launches (ipconfig, arp, route, nbtstat, netsh) on a single host followed by an outbound network connection from a scripting host or shell within 10 minutes. The combination of rapid enumeration then exfiltration-capable connectivity is a strong indicator of automated reconnaissance."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry (PROCESS_LAUNCH) and network-connection telemetry (NETWORK_CONNECTION) normalised into UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "IT monitoring agents (e.g. SCCM, Ansible, Puppet) that poll network state and then phone home; network health scripts run by operations teams; vulnerability scanners."
    tuning_guidance = "Add known monitoring agent parent process paths to %global_allowed_netconfig_parents. Add approved management destinations to %rfc1918_internal or a dedicated allow-list. Raise the threshold count in the match block if the environment runs frequent automated inventory jobs."

  events:
    // --- Leg 1: network-config discovery tool launched ---
    $disc.metadata.event_type = "PROCESS_LAUNCH"
    $disc.target.process.file.full_path = /\\(ipconfig|arp|route|nbtstat|netsh|net\.exe)$/ nocase
    // Exclude known-good administrative parent processes
    not $disc.principal.process.file.full_path in %global_allowed_netconfig_parents
    // Bind the joining placeholder
    $disc.principal.hostname = $hostname

    // --- Leg 2: outbound connection from a shell or scripting host ---
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|python|python3)\.exe$/ nocase
    // Must be a non-RFC-1918 destination (external)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_netconfig_parents
    $net.principal.hostname = $hostname

    // Chronological ordering: discovery must precede the outbound connection
    $disc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score        = max(65)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity    = array_distinct($disc.principal.hostname)
    $discovery_tools   = array_distinct($disc.target.process.file.full_path)
    $discovery_cmdlines = array_distinct($disc.target.process.command_line)
    $outbound_ips      = array_distinct($net.target.ip)
    $outbound_ports    = array_distinct($net.target.port)
    $shell_processes   = array_distinct($net.principal.process.file.full_path)
    $event_count       = count($disc.metadata.id)

  condition:
    $disc and $net
}
