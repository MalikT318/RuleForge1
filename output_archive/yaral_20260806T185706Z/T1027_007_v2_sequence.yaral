/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:05:42.787487+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_DynAPI_SuspProc_Then_SuspModule_Load {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a suspicious process (non-standard parent, unusual binary location, or known LOLBin) that launches and then loads a low-level Windows module associated with manual API resolution (e.g. ntdll, kernel32, kernelbase). Adversaries performing dynamic API resolution via GetProcAddress/LdrGetProcedureAddress or API-hashing routines must load these modules at runtime; the combination of a suspicious process origin followed by an in-process module load of core NT libraries is a strong behavioural indicator of T1027.007."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires EDR or Sysmon image-load (Event ID 7) telemetry normalised to PROCESS_MODULE_LOAD, plus PROCESS_LAUNCH telemetry. Both must be present for the correlation to fire."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate .NET runtimes, JIT compilers, and scripting engines (Python, Node) that load ntdll/kernel32 dynamically. Security tooling (AV, EDR sensors) performing reflective operations. Custom in-house applications built with unusual linker flags."
    tuning_guidance = "Populate %global_allowed_module_loaders with full paths of known-good processes (e.g. dotnet.exe, node.exe, python.exe, security agent binaries). Populate %global_allowed_binary_dirs with approved non-standard directories. Narrow the module regex if kernel32 alone produces too many false positives."

  events:
    // --- Leg 1: suspicious process launch from a non-standard or LOLBin parent ---
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child process lives outside the standard Windows/Program Files hierarchy
    // OR is a scripting / living-off-the-land binary used as a loader
    (
      $proc.target.process.file.full_path = /\\(wscript|cscript|mshta|regsvr32|rundll32|regasm|regsvcs|installutil|msiexec|wmic|certutil|bitsadmin|forfiles|pcalua|syncappvpublishingserver)\.exe$/ nocase
      or
      not $proc.target.process.file.full_path = /^[Cc]:\\(Windows|Program Files|Program Files \(x86\))\\/ nocase
    )

    // Exclude known-good loaders via reference list
    not $proc.target.process.file.full_path in %global_allowed_module_loaders

    // Join anchor: hostname ties both legs together
    $proc.principal.hostname = $hostname

    // Capture the spawned process image for the join with the module-load leg
    $proc.target.process.file.full_path = $child_image

    // --- Leg 2: that same process loads a core NT library (dynamic API resolution target) ---
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"

    // The loading process matches the child spawned in leg 1
    $mod.principal.process.file.full_path = $child_image

    // Module being loaded is one of the canonical targets for API hashing / manual IAT walking
    $mod.target.process.file.full_path = /\\(ntdll|kernel32|kernelbase|advapi32|user32|ws2_32|wininet|winhttp)\.dll$/ nocase

    // Exclude known-good loaders
    not $mod.principal.process.file.full_path in %global_allowed_module_loaders

    $mod.principal.hostname = $hostname

    // Chronological ordering: process must launch before the module load
    $proc.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname, $child_image over 5m

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $suspicious_process = array_distinct($child_image)
    $loaded_modules    = array_distinct($mod.target.process.file.full_path)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $module_load_count = count($mod.target.process.file.full_path)

  condition:
    $proc and $mod
}
