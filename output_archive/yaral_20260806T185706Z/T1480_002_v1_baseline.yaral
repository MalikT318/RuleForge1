/*
  MITRE Technique : T1480.002 - Mutual Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:55:43.208998+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_002_Linux_Mutex_File_Lock_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation of mutex/lock files in world-writable or temporary directories commonly used by Linux malware to implement single-instance guards. Adversaries create a lock file in /tmp, /dev/shm, /var/lock, or /run and attempt to acquire an exclusive lock on it to prevent duplicate execution. Legitimate software uses similar patterns but typically under well-known, documented paths."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1480.002"
    mitre_technique_name = "Execution Guardrails: Mutual Exclusion"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (auditd -w rules on /tmp, /dev/shm, /var/lock, /run, or equivalent EDR file-event collection)."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Package managers (dpkg, rpm, apt) creating lock files under /var/lock or /run/lock; database engines (MySQL, PostgreSQL) using /var/run pid/lock files; init systems and systemd services; legitimate single-instance daemons."
    tuning_guidance = "Populate %linux_allowed_lock_paths with known-good lock file full paths (e.g. /var/lock/subsys/*, /run/systemd/*, /var/run/*.pid). Populate %linux_allowed_lock_procs with trusted parent process paths such as /usr/bin/apt, /usr/bin/dpkg, /usr/sbin/mysqld. Narrow severity for /tmp hits vs /dev/shm hits based on client risk appetite."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Lock/mutex file created in world-writable or runtime directories
    // commonly abused by malware for single-instance mutex guards
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/lock\/|\/var\/run\/|\/run\/)/ nocase

    // File name patterns consistent with mutex/lock semantics:
    // .lock, .lck, .pid, .mutex extensions OR names containing those keywords,
    // OR hidden dot-files (common malware concealment) in these directories
    $file.target.file.full_path = /(\.lock$|\.lck$|\.mutex$|\.pid$|\/\.[^\/]{1,64}$|lock[^\/]*$|mutex[^\/]*$)/ nocase

    // Exclude known-good lock file paths via reference list
    not $file.target.file.full_path in %linux_allowed_lock_paths

    // Exclude trusted system processes that legitimately create lock files
    not $file.principal.process.file.full_path in %linux_allowed_lock_procs

    // Exclude well-known package/init system parent paths
    not $file.principal.process.file.full_path = /^\/(usr\/bin\/(apt|dpkg|rpm|yum|dnf|zypper)|usr\/sbin\/(mysqld|postgres|nginx|apache2|httpd)|lib\/systemd\/systemd|usr\/lib\/systemd\/systemd|sbin\/init)$/ nocase

    // Exclude lock files created under clearly structured system subdirectories
    not $file.target.file.full_path = /^\/run\/(systemd|udev|NetworkManager|dbus|user\/[0-9]+\/)/ nocase
    not $file.target.file.full_path = /^\/var\/run\/(systemd|udev|NetworkManager|dbus|sshd|cron|rsyslog)/ nocase

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1480.002")
    $primary_entity    = array_distinct($file.principal.hostname)
    $lock_file_path    = array_distinct($file.target.file.full_path)
    $creating_process  = array_distinct($file.principal.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
