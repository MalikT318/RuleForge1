/*
  MITRE Technique : T1588 - Obtain Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:23:09.672060+00:00
  Reference       : https://attack.mitre.org/techniques/T1588
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_DNS_HighEntropy_Capability_Acquisition {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries exhibiting characteristics associated with adversary capability acquisition infrastructure: high-entropy algorithmically generated domains, abnormally long subdomain labels, suspicious TLD patterns, or uncommon DNS record types (TXT/NULL) that may indicate C2 beaconing, DGA-based tooling download, or exfiltration channels used during resource development and capability staging."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588"
    mitre_technique_name = "Obtain Capabilities"
    log_prerequisites = "Requires DNS query/resolver logs forwarded to Chronicle. Must include queried domain name, query type, and client IP. Recursive resolver or DNS firewall logs preferred."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN providers with long subdomain labels, legitimate software update services using DGA-like domains, cloud storage buckets with auto-generated names, telemetry and analytics endpoints."
    tuning_guidance = "Populate %dns_allowed_domains with known-good high-entropy domains (CDN, cloud storage, analytics). Populate %dns_allowed_resolvers with internal resolver IPs if needed. Adjust subdomain label length threshold and TXT query exclusions per environment baseline."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Exclude known-good domains via reference list
    not $dns.network.dns.questions.name in %dns_allowed_domains

    // Detection branch 1: Abnormally long subdomain label (>= 40 chars in a single label)
    // indicative of DGA, base64-encoded payloads, or data exfiltration tunneling
    // Branch 2: Suspicious record types used for C2 or capability staging (TXT=16, NULL=10)
    // Branch 3: High-entropy domain pattern - long random-looking second-level domain
    // with no vowel clusters (consonant-heavy = algorithmically generated)
    (
      $dns.network.dns.questions.name = /\.[a-z0-9]{40,}\./  nocase
      or
      $dns.network.dns.questions.type = 16
      or
      $dns.network.dns.questions.type = 10
      or
      $dns.network.dns.questions.name = /^[b-df-hj-np-tv-z0-9]{8,}\.[a-z]{2,6}$/ nocase
      or
      $dns.network.dns.questions.name = /^[a-z0-9]{12,}\.(top|xyz|pw|cc|tk|ml|ga|cf|gq|icu|cyou|bond|rest|hair|cfd|boats|lol)$/ nocase
    )

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1588")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domain = array_distinct($dns.network.dns.questions.name)
    $query_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
