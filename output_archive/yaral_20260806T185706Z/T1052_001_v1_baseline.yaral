/*
  MITRE Technique : T1052.001 - Exfiltration over USB
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:38:23.040357+00:00
  Reference       : https://attack.mitre.org/techniques/T1052/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_Linux_USB_Exfiltration_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification under a mounted USB/removable media path on Linux, which may indicate data exfiltration to a USB device. Removable media is typically auto-mounted under /media, /run/media, or /mnt on modern Linux distributions."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052.001"
    mitre_technique_name = "Exfiltration Over Physical Medium: Exfiltration over USB"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry capturing FILE_CREATION and FILE_MODIFICATION events with target.file.full_path populated. Auditd rules must include -w /media -p w and -w /run/media -p w and -w /mnt -p w."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate user file transfers to USB drives, backup scripts writing to external media, IT provisioning workflows mounting and writing to removable devices, package managers or installers writing to /mnt during OS deployment."
    tuning_guidance = "Add trusted process paths to %linux_allowed_usb_writers (e.g. backup agents, provisioning tools). Add known-good mount points to %linux_allowed_mount_paths if /mnt is used for non-removable purposes. Scope by user if only specific roles should be excluded."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /^\/media\// nocase or
      $file.target.file.full_path = /^\/run\/media\// nocase or
      $file.target.file.full_path = /^\/mnt\// nocase
    )
    not $file.principal.process.file.full_path in %linux_allowed_usb_writers
    not $file.principal.user.userid in %linux_allowed_usb_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1052.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $target_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
