/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:58:32.170333+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_Virtualization_Sandbox_Evasion_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process command lines that enumerate virtualization or sandbox artifacts commonly queried by malware performing environment checks. Covers WMI, registry, and process-based discovery of VM indicators such as hypervisor presence, VM-specific hardware strings, and known analysis-tool processes. Malware uses these checks to decide whether to execute its payload or remain dormant."
    mitre_tactic    = "Defense Evasion, Discovery"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture. PowerShell script-block logging (Event 4104) also surfaces this pattern when WMI is invoked via PowerShell."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "IT asset-management tools querying hardware inventory, hypervisor-aware software licensing checks, legitimate system-information utilities (msinfo32, systeminfo), and IT automation scripts enumerating environment details."
    tuning_guidance = "Add known-good parent process paths (e.g., SCCM, RMM agents, IT inventory tools) to %global_allowed_vm_enum_parents. Narrow scope by requiring the parent to be an untrusted or unusual process (e.g., spawned from a browser, document reader, or temp directory)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target: processes that perform VM/sandbox artifact enumeration
    // Pattern 1 – WMI queries for hypervisor, BIOS, or hardware strings
    // Pattern 2 – registry reads for VM-specific keys via reg.exe
    // Pattern 3 – process listing via tasklist looking for analysis tools
    // Pattern 4 – systeminfo / wmic bios / wmic computersystem queries
    (
      // WMI-based VM detection: querying Win32_ComputerSystem model, BIOS, or video controller
      (
        $proc.target.process.file.full_path = /\\(wmic|powershell|pwsh)\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /Win32_(BIOS|ComputerSystem|VideoController|DiskDrive|BaseBoard|OperatingSystem)/ nocase
          or
          $proc.target.process.command_line = /(vmware|virtualbox|vbox|qemu|xen|hyper.?v|parallels|bochs|innotek|virt|kvm)/  nocase
        )
      )
      or
      // Registry enumeration of VM-specific keys via reg.exe or PowerShell
      (
        $proc.target.process.file.full_path = /\\(reg|powershell|pwsh)\.exe$/ nocase
        and
        $proc.target.process.command_line = /(HKLM|HKEY_LOCAL_MACHINE).*(VMware|VirtualBox|VBOX|QEMU|Xen|VirtIO|Parallels|Bochs|ACPI\\\\DSDT)/ nocase
      )
      or
      // Process listing targeting known sandbox/analysis tool names
      (
        $proc.target.process.file.full_path = /\\(tasklist|powershell|pwsh)\.exe$/ nocase
        and
        $proc.target.process.command_line = /(wireshark|procmon|procexp|fiddler|ollydbg|x64dbg|x32dbg|windbg|idaq|idaq64|vboxservice|vmtoolsd|vmsrvc|vmusrvc|sandboxie|sbiesvc|cuckoo|python|perl)/ nocase
      )
      or
      // CPUID / timing checks via systeminfo or wmic for sandbox detection
      (
        $proc.target.process.file.full_path = /\\(systeminfo|wmic)\.exe$/ nocase
        and
        $proc.target.process.command_line = /(bios|computersystem|cpu|processor|baseboard|memorychip)/ nocase
      )
    )

    // Exclude known-good parent processes (IT management, deployment agents)
    not $proc.principal.process.file.full_path in %global_allowed_vm_enum_parents

    // Exclude processes launched from standard system management paths
    not $proc.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|svchost|services)\.exe$/ nocase

    // Exclude processes whose own image lives in well-known admin tool directories
    not $proc.target.process.file.full_path = /\\(Windows\\System32\\wbem\\WMIC|Windows\\System32\\systeminfo)\.exe$/ nocase

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $child_process     = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
