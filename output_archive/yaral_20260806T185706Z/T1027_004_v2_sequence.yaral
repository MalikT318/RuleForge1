/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:03:25.296523+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_Container_Source_Drop_Then_Compile {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage compile-after-delivery pattern inside a container: a source-code file (C, C++, Go, Python, Rust, or shell script) is written into a writable container path, then a compiler or interpreter is launched on the same container workload within 5 minutes. This combination is unusual in production container environments and is a strong indicator of in-container payload staging."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires container runtime audit logs or a Kubernetes-aware EDR agent that emits FILE_CREATION and PROCESS_LAUNCH events enriched with container/pod context. Both event types must carry a common workload identifier (e.g. container ID, pod name) surfaced in principal.hostname or a resource label."
    platform        = "Linux"
    log_source      = "container"
    false_positives = "CI/CD build containers that compile application code as part of a pipeline; developer workstations running containerised build environments; init containers that compile configuration at startup; JIT-compiled language runtimes (e.g. JVM, .NET) that write and compile temporary bytecode."
    tuning_guidance = "Add known CI/CD container image names or pod name prefixes to %allowed_build_containers. Add sanctioned compiler paths to %allowed_compiler_paths. Narrow the file-drop filter to only world-writable or /tmp paths if the false-positive rate is high."

  events:
    // Stage 1: source-code file written inside a container to a suspicious path
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(tmp|var\/tmp|dev\/shm|run|home\/[^\/]+|root)\// nocase
    $file.target.file.full_path = /\.(c|cc|cpp|cxx|go|rs|py|sh|rb|pl)$/ nocase
    not $file.target.file.full_path in %allowed_build_containers
    $file.principal.hostname = $container_id

    // Stage 2: compiler or interpreter launched in the same container
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(gcc|g\+\+|cc|c\+\+|clang|clang\+\+|go|rustc|python[0-9.]*|ruby|perl|bash|sh|ash|dash|node)$/ nocase
    not $proc.target.process.file.full_path in %allowed_compiler_paths
    $proc.principal.hostname = $container_id

    // Chronological ordering: file drop must precede compilation
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $container_id over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1027.004")
    $primary_entity      = array_distinct($container_id)
    $dropped_files       = array_distinct($file.target.file.full_path)
    $compiler_invoked    = array_distinct($proc.target.process.file.full_path)
    $compiler_cmdline    = array_distinct($proc.target.process.command_line)
    $drop_count          = count($file.target.file.full_path)

  condition:
    $file and $proc
}
