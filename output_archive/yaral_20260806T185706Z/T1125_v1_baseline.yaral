/*
  MITRE Technique : T1125 - Video Capture
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:43:16.675351+00:00
  Reference       : https://attack.mitre.org/techniques/T1125
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1125_001_Video_Capture_Webcam_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes attempting to access webcam or video capture devices on Windows via command-line arguments or process names associated with video capture APIs and tools. Targets the OS mechanism of launching processes that interact with DirectShow, Media Foundation, or WIA device interfaces to capture video from peripheral cameras."
    mitre_tactic = "Collection"
    mitre_technique = "T1125"
    mitre_technique_name = "Video Capture"
    log_prerequisites = "Requires EDR process telemetry with command-line capture (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate video conferencing applications (Teams, Zoom, WebEx), OBS Studio, security camera software, driver installation utilities, and authorized IT asset management tools that enumerate devices."
    tuning_guidance = "Add known-good parent process paths (e.g., video conferencing installers, approved monitoring agents) to %global_allowed_video_capture_parents. Add approved process paths to %global_allowed_video_capture_processes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match processes interacting with Windows video/webcam capture mechanisms:
    // DirectShow (directx/dshow), Media Foundation (mf), Windows Image Acquisition (wia),
    // or PowerShell/scripting engines invoking capture-related APIs or device paths.
    (
      // PowerShell or scripting invoking video/webcam capture APIs or device monikers
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /DirectShow|dshow|VideoCapture|VideoCaptureDevice|MFCreateSourceReaderFromMediaSource|WIA|ImageAcquisition/ nocase
          or
          $proc.target.process.command_line = /vid_[0-9a-f]{4}&pid_[0-9a-f]{4}/ nocase
          or
          $proc.target.process.command_line = /\\\\\.\\video/ nocase
        )
      )
      or
      // ffmpeg-style or capture utilities launched from suspicious parent locations
      (
        $proc.target.process.command_line = /(-f\s+(dshow|vfwcap|avfoundation)|video=|vcodec|webcam)/  nocase
        and
        $proc.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|explorer|rundll32|regsvr32|mshta|svchost)\.exe$/ nocase
      )
      or
      // Processes accessing Windows device namespace paths for video capture devices
      (
        $proc.target.process.command_line = /\\\\\.\\(video|capture|cam|webcam|uvc)/  nocase
      )
      or
      // rundll32 or regsvr32 loading video/capture related COM objects or DLLs
      (
        $proc.target.process.file.full_path = /\\(rundll32|regsvr32)\.exe$/ nocase
        and
        $proc.target.process.command_line = /(qcap|vfwcap|dshow|capture|webcam|vidcap)/  nocase
      )
    )

    not $proc.target.process.file.full_path in %global_allowed_video_capture_processes
    not $proc.principal.process.file.full_path in %global_allowed_video_capture_parents

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1125")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
