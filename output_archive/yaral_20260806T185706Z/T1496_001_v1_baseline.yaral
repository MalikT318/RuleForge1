/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:57:02.061230+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_IaaS_Compute_Hijacking_Suspicious_GPU_Instance_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of high-compute or GPU-optimized cloud instances commonly abused for cryptocurrency mining. Adversaries provision large GPU or compute-optimized instance types to perform resource-intensive mining workloads. This rule fires on cloud audit events where a compute resource is created with an instance type matching GPU or high-core-count families, particularly in regions or accounts where such resources are unexpected."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Requires cloud provider audit logs normalized to Chronicle UDM. AWS CloudTrail RunInstances, GCP compute.instances.insert, or Azure Microsoft.Compute/virtualMachines/write events must be ingested."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate ML/AI workloads, rendering pipelines, HPC batch jobs, and authorized data science teams provisioning GPU instances. Large-scale authorized compute provisioning by DevOps or infrastructure teams."
    tuning_guidance = "Add approved service accounts and IAM principals to %cloud_allowed_gpu_provisioners. Add approved regions to %cloud_allowed_compute_regions. Scope by account or project ID if GPU usage is expected in specific environments. Consider correlating with time-of-day baselines to reduce noise from scheduled batch jobs."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Match GPU, high-compute, and accelerator-optimized instance families across AWS, GCP, and Azure
    // AWS: p2, p3, p4, g3, g4, g5 (GPU); c5n, c6i, hpc (compute-optimized)
    // GCP: a2 (A100), n1 with accelerators, g2 (L4 GPU)
    // Azure: NC, ND, NV series (GPU VMs)
    $cloud.target.resource.name = /\b(p2\.|p3\.|p4d\.|p4de\.|g3\.|g4dn\.|g4ad\.|g5\.|g5g\.|a2-|n1-|g2-|Standard_NC|Standard_ND|Standard_NV|Standard_HB|Standard_HC)/ nocase

    // Ensure this is a compute/virtual machine resource type
    $cloud.target.resource.resource_type = /(instance|virtualmachine|vm|compute)/ nocase

    // Capture the acting principal for join and outcome
    $cloud.principal.user.userid = $actor

    // Exclude approved GPU provisioners
    not $cloud.principal.user.userid in %cloud_allowed_gpu_provisioners

    // Exclude approved regions if populated
    not $cloud.target.resource.attribute.labels["region"] in %cloud_allowed_compute_regions

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_name = array_distinct($cloud.target.resource.name)
    $resource_type = array_distinct($cloud.target.resource.resource_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
