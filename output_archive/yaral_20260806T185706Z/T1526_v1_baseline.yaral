/*
  MITRE Technique : T1526 - Cloud Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:02:03.822848+00:00
  Reference       : https://attack.mitre.org/techniques/T1526
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1526_001_SaaS_Cloud_Service_Enumeration_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a burst of cloud service discovery operations via M365 audit logs. Adversaries who gain access to a SaaS tenant frequently enumerate available services, applications, management groups, and policy definitions using APIs such as Microsoft Graph to map the environment before follow-on actions. This rule fires when a single user performs a high volume of read/list operations against cloud service resources within a short window, which is a strong behavioral indicator of automated enumeration tooling."
    mitre_tactic = "Discovery"
    mitre_technique = "T1526"
    mitre_technique_name = "Cloud Service Discovery"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log (UAL) ingested into Chronicle. Operations must include service/application/directory read events normalised to USER_RESOURCE_ACCESS."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "IT administrators performing legitimate tenant audits, provisioning scripts, CSPM tools performing scheduled assessments, and authorised third-party SaaS management platforms."
    tuning_guidance = "Add known administrative service accounts and approved automation identities to %m365_allowed_enum_accounts. Raise the threshold if CSPM or governance tooling generates high baseline volumes. Narrow resource_type filters to the specific service categories most relevant to each client."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource must be a cloud service, application, directory, or policy object
    // rather than a user document or mailbox item - this distinguishes service discovery
    // from normal productivity access patterns
    (
      $cloud.target.resource.resource_type = "DIRECTORY" or
      $cloud.target.resource.resource_type = "APPLICATION" or
      $cloud.target.resource.resource_type = "SETTING" or
      $cloud.target.resource.resource_type = "ROLE" or
      $cloud.target.resource.resource_type = "POLICY" or
      $cloud.target.resource.name = /serviceprincipal/ nocase or
      $cloud.target.resource.name = /application/ nocase or
      $cloud.target.resource.name = /directoryobject/ nocase or
      $cloud.target.resource.name = /managementgroup/ nocase or
      $cloud.target.resource.name = /subscription/ nocase or
      $cloud.target.resource.name = /roledefinition/ nocase or
      $cloud.target.resource.name = /conditionalaccesspolic/ nocase or
      $cloud.target.resource.name = /authorizationpolic/ nocase or
      $cloud.target.resource.name = /identityprovider/ nocase or
      $cloud.target.resource.name = /domain/ nocase
    )

    // Bind the acting user identity for grouping
    $cloud.principal.user.userid = $userid

    // Exclude known approved enumeration accounts and automation identities
    not $cloud.principal.user.userid in %m365_allowed_enum_accounts

    // Exclude known CSPM and governance service principals by display name pattern
    not $cloud.principal.user.userid = /svc[-_]cspm/ nocase
    not $cloud.principal.user.userid = /svc[-_]governance/ nocase

  match:
    $userid over 10m

  outcome:
    // Elevated score: automated enumeration of cloud services is a strong
    // pre-attack reconnaissance signal; score reflects medium-high confidence
    $risk_score = max(68)
    $mitre_technique_id = array_distinct("T1526")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)
    $event_count = count($cloud.metadata.event_type)

  condition:
    // Require at least 20 distinct service-discovery read operations within
    // the 10-minute window to suppress single accidental lookups while
    // catching automated enumeration tooling (Stormspotter, Pacu, Graph Explorer scripts)
    #cloud >= 20
}
