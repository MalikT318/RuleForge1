/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:01:15.970321+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_BinaryPadding_WriteToExecLocation_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects binary padding activity on Linux: a process that appends or writes bulk data to a file (dd, truncate, fallocate, or similar) is followed within 5 minutes by that same file being marked executable or moved into a world-accessible execution path. This two-stage pattern is characteristic of padding a payload to evade size-based AV/sandbox limits without relying on command-line string matching alone."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. PROCESS_LAUNCH events must populate target.process.command_line and principal.hostname. FILE_MODIFICATION events must populate target.file.full_path and principal.hostname."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate disk-image creation (dd if=/dev/zero), database pre-allocation (fallocate for PostgreSQL/MySQL data files), container image layer construction, backup tooling writing large archives to /tmp or /var."
    tuning_guidance = "Add known-good parent process paths to %linux_allowed_padding_parents. Add approved staging directories to %linux_allowed_staging_paths. Narrow the file path regex if the environment uses a fixed staging directory. Raise severity to Critical if the destination path falls under /usr/local/bin, /usr/bin, or a cron directory."

  events:
    // Stage 1: a bulk-write / padding utility writes to a file in a
    // world-writable or staging location. We match on the PROCESS_LAUNCH
    // of the padding tool rather than its command-line payload to avoid
    // duplicating the existing command-line rule.
    $pad.metadata.event_type = "PROCESS_LAUNCH"
    $pad.target.process.file.full_path = /\/(dd|truncate|fallocate|shred|split|cat|tee)$/ nocase
    // Must be writing to a suspicious staging path
    $pad.target.process.command_line = /(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/home\/[^\/]+\/\.)/ nocase
    not $pad.principal.process.file.full_path in %linux_allowed_padding_parents
    $pad.principal.hostname = $hostname

    // Stage 2: within the same window the target file is modified
    // (chmod, chown, or content write) in the same staging area,
    // indicating the padded binary is being prepared for execution.
    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.target.file.full_path = /(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/home\/[^\/]+\/\.)/ nocase
    not $mod.target.file.full_path in %linux_allowed_staging_paths
    $mod.principal.hostname = $hostname

    // Chronological ordering: padding write must precede the file modification
    $pad.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity    = array_distinct($pad.principal.hostname)
    $padding_tool_used = array_distinct($pad.target.process.file.full_path)
    $staging_file_path = array_distinct($mod.target.file.full_path)
    $initiating_user   = array_distinct($pad.principal.user.userid)
    $parent_process    = array_distinct($pad.principal.process.file.full_path)

  condition:
    $pad and $mod
}
