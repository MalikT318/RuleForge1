/*
  MITRE Technique : T1583.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:19:07.076357+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_005_Botnet_HighVolume_Distributed_Inbound_Sweep {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects inbound connection sweeps from a large number of distinct external source IPs to a single destination port within a short window, consistent with botnet-coordinated scanning, DDoS probing, or credential-stuffing campaigns. Botnets distribute requests across many nodes to evade per-source rate limits. A high cardinality of distinct external sources hitting the same service port is a strong network-observable signal of botnet activity."
    mitre_tactic         = "Resource Development"
    mitre_technique      = "T1583.005"
    mitre_technique_name = "Acquire Infrastructure: Botnet"
    log_prerequisites    = "Requires perimeter firewall or network flow logs with source IP, destination IP, destination port, and connection counts. Logs must be ingested into Chronicle UDM as NETWORK_CONNECTION or NETWORK_FLOW events."
    platform             = "PRE"
    log_source           = "firewall"
    false_positives      = "Legitimate high-traffic services (CDN origins, public APIs, large-scale web properties) may receive connections from many distinct IPs. Search engine crawlers, vulnerability scanners operated by the organization, and load-testing exercises can also trigger this rule."
    tuning_guidance      = "Add known CDN egress ranges and authorized scanner IPs to %allowed_external_scanner_ips. Add internal destination IPs hosting public-facing services with expected high fan-in to %allowed_high_fanin_destinations. Raise the threshold or narrow the destination port list if false-positive volume is high in specific environments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be external (not in RFC-1918 / internal ranges)
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %allowed_external_scanner_ips

    // Destination must be an internal asset (protected perimeter)
    $net.target.ip in %internal_protected_assets

    // Focus on ports commonly abused by botnet activity:
    // HTTP(S), SSH, RDP, SIP, SMTP, Telnet, common IoT management ports
    $net.target.port in [
      21, 22, 23, 25, 80, 443, 445, 465, 587,
      1194, 3306, 3389, 5060, 5061, 8080, 8443,
      8888, 9200, 9443
    ]

    // Capture grouping fields for threshold aggregation
    $net.target.ip = $dest_ip
    $net.target.port = $dest_port

    // Exclude destinations explicitly allow-listed as high fan-in services
    not $net.target.ip in %allowed_high_fanin_destinations

  match:
    $dest_ip, $dest_port over 5m

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1583.005")
    $primary_entity    = array_distinct($net.target.ip)
    $distinct_sources  = count(distinct $net.principal.ip)
    $targeted_port     = array_distinct($net.target.port)
    $sample_source_ips = array_distinct($net.principal.ip)

  condition:
    // Fire only when a large number of distinct external IPs hit the same
    // destination IP:port - the hallmark of a distributed botnet sweep.
    // Threshold of 200 distinct sources in 5 minutes is conservative;
    // tune downward for lower-traffic environments.
    #net >= 200 and $net
}
