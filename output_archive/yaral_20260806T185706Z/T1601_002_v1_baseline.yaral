/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:29:31.309904+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Network_Device_Image_Downgrade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects potential network device OS image downgrade activity observed via IDS/IPS telemetry. Adversaries may transfer an older firmware or OS image to a network device to weaken encryption and reduce defensive capability. This rule targets anomalous file transfer patterns (TFTP, FTP, SCP, HTTP) to network device management interfaces that are consistent with image staging, as well as IDS/IPS alerts flagging firmware-related protocol anomalies or known downgrade-associated traffic signatures."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Modify System Image: Downgrade System Image"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW events. Appliance must inspect management-plane traffic (TFTP UDP/69, FTP TCP/21, SCP TCP/22, HTTP/HTTPS to device management ports). Security result fields should carry alert category or signature name where available."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Authorised firmware upgrade workflows initiated by network operations teams, automated provisioning systems (e.g. ZTP/POAP), scheduled maintenance windows, and jump-host management servers performing routine image pushes."
    tuning_guidance = "Add authorised management server IPs to %approved_network_mgmt_sources. Add known firmware distribution hosts to %approved_firmware_servers. Scope by target port to reduce noise from general SSH traffic. Consider correlating with a SETTING_MODIFICATION event for higher fidelity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target management-plane file-transfer protocols used to stage OS images:
    // TFTP (69/UDP), FTP (21/TCP), FTP-data (20/TCP), SCP/SSH (22/TCP),
    // HTTP (80/TCP), HTTPS (443/TCP) to device management interfaces.
    (
      $net.target.port = 69   or
      $net.target.port = 20   or
      $net.target.port = 21   or
      $net.target.port = 22   or
      $net.target.port = 80   or
      $net.target.port = 443
    )

    // IDS/IPS security result category or summary must carry a signal
    // consistent with firmware/image transfer or downgrade activity.
    // Matching on category/summary text normalised into UDM security_result
    // fields - use nocase and broad regex to survive vendor normalisation
    // differences. Core logic is the PORT + SIGNATURE combination, not
    // security_result.action alone.
    (
      $net.security_result.category_details = /firmware|bootflash|system.?image|ios|nxos|junos|rommon|boot.?image|\.bin|\.img|\.tar|\.pkg/ nocase or
      $net.security_result.summary = /firmware|bootflash|system.?image|ios|nxos|junos|rommon|boot.?image|downgrade|older.?version|image.?transfer/ nocase or
      $net.security_result.description = /firmware|bootflash|system.?image|ios|nxos|junos|rommon|boot.?image|downgrade|older.?version|image.?transfer/ nocase
    )

    // Exclude known-good authorised management sources
    not $net.principal.ip in %approved_network_mgmt_sources
    not $net.principal.ip in %approved_firmware_servers

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)
    $alert_summary = array_distinct($net.security_result.summary)

  condition:
    $net
}
