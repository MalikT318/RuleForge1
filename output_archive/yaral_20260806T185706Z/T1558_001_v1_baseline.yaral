/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:09:24.394905+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Golden_Ticket_Anomalous_Kerberos_TGT {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects anomalous Kerberos TGT usage consistent with a Golden Ticket attack. Golden tickets are forged TGTs signed with the KRBTGT hash, allowing arbitrary account impersonation. Key indicators include TGT lifetimes exceeding domain policy maximums, use of non-existent or privileged accounts, and Kerberos pre-authentication anomalies surfaced by identity provider audit logs."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires identity provider / Active Directory authentication audit logs normalised to UDM USER_LOGIN events. Windows Security Event IDs 4768 (TGT request), 4769 (TGS request), and 4771 (pre-auth failure) are the primary sources. Chronicle must ingest and normalise these events."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Service accounts with legitimately long ticket lifetimes configured by AD administrators; smart-card or certificate-based Kerberos flows; privileged access workstation (PAW) accounts; monitoring or identity governance tools performing synthetic authentication tests."
    tuning_guidance = "Add known service accounts with extended ticket lifetimes to %allowed_long_lifetime_accounts. Add known privileged accounts that legitimately authenticate from unusual hosts to %allowed_privileged_roaming_accounts. Adjust the encryption type filter if your environment standardises on RC4 for legacy compatibility."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Kerberos TGT request (Event 4768) or TGS request (Event 4769)
    // Golden tickets are used to request TGS tickets; both event types are relevant.
    // UDM normalises Kerberos ticket type into the authentication mechanism field.
    $auth.extensions.auth.auth_details = /kerberos/ nocase

    // Golden tickets are frequently forged with RC4-HMAC (0x17) encryption
    // rather than the domain default AES256, because the KRBTGT RC4 hash is
    // easier to obtain. Detect the downgrade signal.
    $auth.extensions.auth.auth_details = /rc4|0x17|arcfour/ nocase

    // Ticket lifetime anomaly: forged golden tickets often carry lifetimes of
    // 10 years (the mimikatz default) or other values far exceeding the domain
    // maximum of 10 hours. Chronicle normalises ticket lifetime into
    // security_result.detection_fields where available; alternatively the raw
    // event description carries it. We match on the known-bad lifetime strings.
    (
      $auth.security_result.description = /renew.{0,30}(876[0-9][0-9]|8760|87[7-9][0-9]|[9-9][0-9]{3}|[1-9][0-9]{4,})\s*(hour|hr|minute|min)/ nocase
      or
      $auth.security_result.description = /ticket.{0,30}life.{0,30}(876[0-9][0-9]|8760|87[7-9][0-9]|[1-9][0-9]{4,})/ nocase
      or
      // Mimikatz default: 10 years expressed in minutes (5256000) or hours (87600)
      $auth.security_result.description = /5256000|87600/ nocase
    )

    // Exclude accounts explicitly allow-listed for extended lifetimes
    not $auth.principal.user.userid in %allowed_long_lifetime_accounts

    // Exclude known privileged accounts that legitimately roam
    not $auth.principal.user.userid in %allowed_privileged_roaming_accounts

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_hostname = array_distinct($auth.principal.hostname)
    $auth_mechanism = array_distinct($auth.extensions.auth.auth_details)
    $result_description = array_distinct($auth.security_result.description)

  condition:
    $auth
}
