/*
  MITRE Technique : T1211 - Exploitation for Stealth
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:52:33.793918+00:00
  Reference       : https://attack.mitre.org/techniques/T1211
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1211_001_Linux_Audit_Log_Suppression_Evasion {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process activity consistent with exploitation for stealth on Linux: processes that manipulate audit subsystem configuration, suppress syslog/journald, tamper with /proc/self/mem or kernel module loading paths, or interact with LD_PRELOAD-style injection points in ways that evade telemetry. Specifically targets command-line patterns that disable auditd, flush audit rules, unload kernel modules associated with monitoring, or write to volatile memory-mapped paths used to hide activity."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1211"
    mitre_technique_name = "Exploitation for Defense Evasion"
    log_prerequisites = "Requires Linux EDR or auditd PROCESS_LAUNCH telemetry with full command-line capture. Auditd rules should capture execve syscalls."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate system administrators stopping auditd for maintenance, kernel module management by configuration management tools (Ansible, Puppet, Chef), security tool self-updates that temporarily disable logging."
    tuning_guidance = "Add trusted admin process paths to %linux_allowed_audit_managers. Add approved automation tool paths to %linux_allowed_config_mgmt_tools. Scope by principal.user.userid to exclude known service accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target processes that interact with audit/logging subsystems or kernel integrity mechanisms
    (
      // Disabling or stopping the audit daemon
      (
        $proc.target.process.command_line = /\bauditctl\b/ nocase and
        $proc.target.process.command_line = /(\-e\s*0|\-\-backlog-limit\s+0|\-D\b)/ nocase
      )
      or
      // Stopping auditd via service managers
      (
        $proc.target.process.file.full_path = /\/(systemctl|service|initctl)$/ nocase and
        $proc.target.process.command_line = /\b(stop|disable|mask)\b/ nocase and
        $proc.target.process.command_line = /\bauditd\b/ nocase
      )
      or
      // Flushing all audit rules (removes monitoring coverage)
      (
        $proc.target.process.file.full_path = /\/auditctl$/ nocase and
        $proc.target.process.command_line = /\-D\b/ nocase
      )
      or
      // Unloading kernel modules associated with security monitoring
      (
        $proc.target.process.file.full_path = /\/(rmmod|modprobe)$/ nocase and
        $proc.target.process.command_line = /\b(audit|apparmor|selinux|fanotify|inotify|netfilter|nf_conntrack)\b/ nocase
      )
      or
      // Stopping or disabling syslog / journald
      (
        $proc.target.process.file.full_path = /\/(systemctl|service)$/ nocase and
        $proc.target.process.command_line = /\b(stop|disable|mask|kill)\b/ nocase and
        $proc.target.process.command_line = /\b(rsyslog|syslog|syslogd|journald|systemd-journald)\b/ nocase
      )
      or
      // Direct manipulation of audit log files or configuration via shell builtins
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh)$/ nocase and
        $proc.target.process.command_line = /\/var\/log\/(audit|syslog|messages|kern\.log)/ nocase and
        $proc.target.process.command_line = /(\btruncate\b|\bdd\b|\bshred\b|>\s*\/var\/log|\becho\b.*>\s*\/var\/log)/ nocase
      )
      or
      // Writing to /proc/sys/kernel/perf_event_paranoid or disabling ftrace/kprobe monitoring
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|sysctl|tee)$/ nocase and
        $proc.target.process.command_line = /\/(proc\/sys\/kernel\/(perf_event_paranoid|ftrace_enabled|kptr_restrict)|sys\/kernel\/debug\/(tracing|kprobes))/ nocase
      )
    )

    // Exclude known legitimate management tools
    not $proc.principal.process.file.full_path in %linux_allowed_audit_managers
    not $proc.principal.process.file.full_path in %linux_allowed_config_mgmt_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1211")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user       = array_distinct($proc.principal.user.userid)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
