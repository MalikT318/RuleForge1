/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:23:45.547673+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_File_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of .desktop files in XDG Autostart directories (/etc/xdg/autostart or ~/.config/autostart). Adversaries abuse these files to achieve persistence by placing a malicious Exec directive that runs at desktop login. This rule fires on the file artifact rather than the creating process, providing coverage when command-line logging is absent or evaded."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events, with target.file.full_path populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate desktop application installers (e.g., package managers installing .desktop launchers), IT provisioning scripts deploying standard desktop shortcuts, user-installed GUI applications that register themselves at login."
    tuning_guidance = "Add known-good parent process paths (e.g., package manager binaries such as /usr/bin/dpkg, /usr/bin/rpm, /usr/bin/apt) to %linux_allowed_desktop_writers. Scope further by excluding specific .desktop filenames associated with approved software via an additional reference list."

  events:
    $file.metadata.event_type in ["FILE_CREATION", "FILE_MODIFICATION"]

    // Target must be a .desktop file in a recognised XDG Autostart directory
    $file.target.file.full_path = /\/(etc\/xdg\/autostart|\.config\/autostart)\/.+\.desktop$/ nocase

    // Exclude writes by known-good package management and provisioning processes
    not $file.principal.process.file.full_path in %linux_allowed_desktop_writers

    // Exclude writes originating from root-owned system package manager paths
    // (belt-and-suspenders: reference list is primary exclusion)
    not $file.principal.process.file.full_path = /\/(usr\/bin\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|snap|flatpak)|usr\/lib\/(apt|dpkg))/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
