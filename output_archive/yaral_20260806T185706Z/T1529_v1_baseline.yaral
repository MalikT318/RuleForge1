/*
  MITRE Technique : T1529 - System Shutdown/Reboot
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:02:19.160411+00:00
  Reference       : https://attack.mitre.org/techniques/T1529
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1529_001_macOS_System_Shutdown_Reboot {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects execution of macOS shutdown or reboot commands that may indicate an adversary attempting to disrupt system availability or impede incident response. Covers shutdown, reboot, halt, and poweroff invocations with flags consistent with forced or immediate shutdown."
    mitre_tactic    = "Impact"
    mitre_technique = "T1529"
    mitre_technique_name = "System Shutdown/Reboot"
    log_prerequisites = "Requires macOS EDR telemetry (e.g., CrowdStrike Falcon, SentinelOne, or Jamf Protect) providing PROCESS_LAUNCH events with command-line arguments and parent process context."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Legitimate administrator-initiated shutdowns or reboots via management tooling, MDM-triggered restarts for software updates, scheduled maintenance scripts, and IT automation frameworks (e.g., Jamf, Munki)."
    tuning_guidance = "Add known MDM or management process paths to %macos_allowed_shutdown_parents. Add authorized admin user IDs to %macos_allowed_shutdown_users. Narrow scope by requiring the parent process to be outside expected management tooling."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target the core macOS shutdown/reboot binaries
    $proc.target.process.file.full_path = /\/(shutdown|reboot|halt|poweroff)$/ nocase

    // Match flags that indicate forced, immediate, or scripted shutdown/reboot
    // -h (halt), -r (reboot), -s (sleep), now or +0 for immediate, -f for forced
    $proc.target.process.command_line = /(shutdown|reboot|halt|poweroff)/ nocase
    $proc.target.process.command_line = /(\-h|\-r|\-f|\-p|now|\+0)/ nocase

    // Exclude known legitimate management and MDM parent processes
    not $proc.principal.process.file.full_path in %macos_allowed_shutdown_parents

    // Exclude known authorized admin users
    not $proc.principal.user.userid in %macos_allowed_shutdown_users

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1529")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $initiating_user   = array_distinct($proc.principal.user.userid)
    $initiating_process = array_distinct($proc.principal.process.file.full_path)
    $shutdown_command  = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
