/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:59:15.078667+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Time_Based_Sandbox_Evasion_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects processes on Linux that read time-related pseudo-files or invoke time-enumeration utilities in a pattern consistent with sandbox/VM detection via time-based checks. Adversaries sample uptime, clock sources, or timer resolution before and after sleep to detect accelerated sandbox environments."
    mitre_tactic = "Defense Evasion, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Requires Linux EDR or auditd file-open/process-launch telemetry. Auditd rules should include -w /proc/uptime -p r and -w /proc/timer_list -p r, plus execve syscall auditing."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "System monitoring daemons (collectd, prometheus node_exporter, nagios plugins), NTP clients, uptime utilities invoked by shell scripts, performance benchmarking tools, container health checks."
    tuning_guidance = "Add known monitoring agent parent process paths to %linux_allowed_time_check_parents. Add authorised cron or systemd service names to %linux_allowed_time_services. Raise severity if the reading process was itself spawned from a suspicious parent (e.g. a downloaded script or interpreter)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target: processes that directly enumerate time-related kernel interfaces.
    // /proc/uptime   - system uptime and idle time
    // /proc/timer_list - high-resolution kernel timer state
    // /proc/timer_stats - timer statistics (older kernels)
    // clock_gettime / adjtimex wrappers exposed via: date, hwclock, timedatectl, uptime, sleep
    // We match the command line reading these sources or invoking time-probing utilities.
    (
      $proc.target.process.command_line = /\/proc\/uptime/ nocase
      or $proc.target.process.command_line = /\/proc\/timer_list/ nocase
      or $proc.target.process.command_line = /\/proc\/timer_stats/ nocase
      or $proc.target.process.command_line = /\/proc\/stat/ nocase
      or $proc.target.process.file.full_path = /\/(usr\/)?s?bin\/hwclock$/ nocase
      or $proc.target.process.file.full_path = /\/(usr\/)?bin\/timedatectl$/ nocase
    )

    // Restrict to processes whose parent is a script interpreter, shell, or
    // unknown binary - not a well-known system service launcher.
    // This narrows to adversary-controlled execution chains.
    $proc.principal.process.file.full_path = /(\/usr)?\/bin\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|node|php)$/ nocase

    // Exclude known-good monitoring and admin parent processes.
    not $proc.principal.process.file.full_path in %linux_allowed_time_check_parents

    // Exclude common benign invocation paths (cron, systemd service managers).
    not $proc.principal.process.command_line = /systemd|crond|cron\.d|anacron/ nocase

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
