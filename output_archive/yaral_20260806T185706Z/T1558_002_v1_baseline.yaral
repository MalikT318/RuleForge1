/*
  MITRE Technique : T1558.002 - Silver Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:09:47.147856+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_002_Silver_Ticket_Anomalous_Kerberos_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Silver Ticket usage via Windows Security Event 4624 logon events where Kerberos authentication succeeds but the Ticket Granting Service (TGS) was forged locally without KDC interaction. Key indicators are: logon type 3 (network), authentication package Kerberos, and a missing or anomalous Transited Services field combined with a non-machine account logging into a service host. Silver tickets bypass the KDC so no corresponding TGT request (4768) will precede the service ticket (4769) - this rule catches the resulting logon anomaly."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.002"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Silver Ticket"
    log_prerequisites = "Requires Windows Security Event Log forwarded to Chronicle. Event ID 4624 (successful logon) with Kerberos authentication detail fields populated. Ensure advanced audit policy: Audit Logon and Audit Kerberos Service Ticket Operations are enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate service-to-service Kerberos authentication on well-known service accounts; scheduled tasks running under service accounts; some RMM and monitoring agents authenticating via Kerberos to remote hosts."
    tuning_guidance = "Add known service account userids to %allowed_kerberos_service_accounts. Add known service hostnames that legitimately generate high-volume Kerberos network logons to %allowed_kerberos_service_hosts. Narrow the target.user.userid regex to match your environment's service account naming convention."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Network logon (type 3) - Silver tickets are used for network service access
    $auth.extensions.auth.auth_details = /logon\s*type.*3|type.*network/ nocase

    // Kerberos authentication package - silver tickets present as Kerberos
    $auth.extensions.auth.mechanism = "KERBEROS"

    // Target user is a service account pattern or accessing a service principal
    // Silver tickets are forged for specific service SPNs (CIFS, HTTP, MSSQL, etc.)
    $auth.target.user.userid = /\$|svc_|service|sql|sharepoint|http|cifs|iis|exchange/ nocase

    // The logon targets a hostname (service host), not a domain controller
    // Silver tickets grant access to the specific service host only
    $auth.target.hostname != ""

    // Exclude machine accounts performing routine computer authentication
    // (machine accounts end with $ but are expected for computer-to-computer auth)
    not $auth.principal.user.userid = /^[a-zA-Z0-9\-]{1,15}\$$/ nocase

    // Exclude known-good service accounts and service hosts
    not $auth.target.user.userid in %allowed_kerberos_service_accounts
    not $auth.target.hostname in %allowed_kerberos_service_hosts

    // Exclude domain controllers as targets - silver tickets target service hosts, not DCs
    // (DC names typically follow a naming convention; tune this regex per environment)
    not $auth.target.hostname = /^dc[0-9\-]|^pdc|^bdc|domaincontroller/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.002")
    $primary_entity = array_distinct($auth.principal.hostname)
    $target_service_host = array_distinct($auth.target.hostname)
    $target_service_account = array_distinct($auth.target.user.userid)
    $source_user = array_distinct($auth.principal.user.userid)

  condition:
    $auth
}
