/*
  MITRE Technique : T1220 - XSL Script Processing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:53:39.219689+00:00
  Reference       : https://attack.mitre.org/techniques/T1220
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1220_001_XSL_Script_Processing_MSXSL_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of msxsl.exe or wmic.exe with XSL stylesheet arguments, which adversaries abuse to execute arbitrary scripts embedded in XSL/XML files while bypassing application control. Covers both the standalone msxsl.exe utility and the built-in wmic.exe /format XSL abuse path."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1220"
    mitre_technique_name = "XSL Script Processing"
    log_prerequisites = "Requires EDR process telemetry or Windows Security Event 4688 with command-line auditing enabled (Sysmon Event ID 1 preferred for full command-line fidelity)."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate XSLT transformations by developers or build pipelines, SCCM/MECM inventory queries using wmic with format arguments, enterprise XML processing workflows."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_xsl_parents and known-good XSL stylesheet directories to %global_allowed_xsl_paths. Consider scoping by OU or host group for developer workstations."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match msxsl.exe (not installed by default - high signal on its own)
    // OR wmic.exe abused with /format pointing to an XSL file (LOLBin path)
    (
      $proc.target.process.file.full_path = /\\msxsl\.exe$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase
        and
        $proc.target.process.command_line = /\/format\s*:/ nocase
        and
        $proc.target.process.command_line = /\.(xsl|xslt|xml)/ nocase
      )
    )

    // Exclude known-good parent processes (e.g., authorised build systems)
    not $proc.principal.process.file.full_path in %global_allowed_xsl_parents

    // Exclude known-good XSL stylesheet paths (e.g., approved pipeline dirs)
    not $proc.target.process.command_line in %global_allowed_xsl_paths

  outcome:
    // msxsl.exe presence alone is high-fidelity; wmic /format is slightly lower
    $risk_score = max(
      if($proc.target.process.file.full_path = /\\msxsl\.exe$/ nocase, 85, 70)
    )
    $mitre_technique_id = array_distinct("T1220")
    $primary_entity = array_distinct($proc.principal.hostname)
    $spawned_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
