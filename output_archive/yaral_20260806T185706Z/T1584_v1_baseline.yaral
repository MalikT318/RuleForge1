/*
  MITRE Technique : T1584 - Compromise Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:20:04.972695+00:00
  Reference       : https://attack.mitre.org/techniques/T1584
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_Compromised_Infra_DNS_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS query patterns consistent with compromised infrastructure abuse: abnormal record types (TXT, NULL, ANY), excessively long subdomain labels, or high-entropy subdomain strings that may indicate C2 beaconing or DNS tunneling through hijacked resolvers or domains. Adversaries leveraging compromised infrastructure often blend into legitimate DNS traffic using trusted domains as proxies."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584"
    mitre_technique_name = "Compromise Infrastructure"
    log_prerequisites = "Requires DNS query/resolver logs normalised into Chronicle UDM NETWORK_DNS events. Fields used: network.dns.questions.name, network.dns.questions.type, network.dns.response_code."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate TXT queries for SPF/DKIM/DMARC validation, ACME certificate challenges, cloud provider health checks using long subdomains, CDN edge nodes with encoded hostnames, monitoring tools performing ANY queries."
    tuning_guidance = "Add known-good domains (mail providers, CDN roots, certificate authorities) to %dns_allowed_domains. Add known-good query sources to %dns_allowed_resolvers. Raise the subdomain length threshold if your environment uses long auto-generated cloud hostnames."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Exclude known-good domains from detection scope
    not $dns.network.dns.questions.name in %dns_allowed_domains
    not $dns.principal.ip in %dns_allowed_resolvers

    (
      // Suspicious record types used for DNS tunneling or C2 over compromised infra
      $dns.network.dns.questions.type = 16 or   // TXT
      $dns.network.dns.questions.type = 10 or   // NULL
      $dns.network.dns.questions.type = 255 or  // ANY

      // Excessively long subdomain label - common in DNS tunneling and DGA
      // Matches a single label of 45+ characters before the first dot
      $dns.network.dns.questions.name = /^[a-z0-9\-]{45,}\./  nocase or

      // Multiple deeply nested subdomains (4+ labels) with encoded-looking segments
      // e.g. a1b2c3d4.x9y8z7.evil.compromised-domain.com
      $dns.network.dns.questions.name = /^[a-z0-9]{8,}\.[a-z0-9]{8,}\.[a-z0-9]{8,}\.[a-z0-9\-]+\.[a-z]{2,}$/ nocase or

      // High-entropy hex or base32/base64-like subdomain segments
      // Matches subdomains composed entirely of hex characters (16+ chars) - DGA indicator
      $dns.network.dns.questions.name = /^[0-9a-f]{16,}\.[a-z0-9\-]+\.[a-z]{2,}$/ nocase or

      // Subdomain with embedded base64-like padding characters encoded as hyphens
      // Long alphanum run with no vowels - consonant-heavy DGA pattern
      $dns.network.dns.questions.name = /^[b-df-hj-np-tv-z0-9]{20,}\./  nocase
    )

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domain = array_distinct($dns.network.dns.questions.name)
    $dns_record_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
