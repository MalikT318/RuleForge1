/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:09:00.950097+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_Kerberos_Ticket_Theft_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process launches on Linux indicative of Kerberos ticket theft or forging activity. Covers enumeration of credential caches (klist), extraction of keytab files, manipulation of ccache files in /tmp or /dev/shm, and use of tools that interact with Kerberos ticket material outside of expected service accounts. Adversaries use these primitives to perform Pass-the-Ticket attacks or forge Golden/Silver tickets in cross-realm environments."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with command-line arguments captured. Auditd rules should include execve syscall logging."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate Kerberos administrators running klist for diagnostics, automated service account keytab renewal scripts, Ansible/Puppet configuration management touching keytab files, SSSD or PAM Kerberos integration daemons."
    tuning_guidance = "Add authorised service account userids to %linux_kerberos_allowed_users. Add approved automation process paths to %linux_kerberos_allowed_processes. Scope klist detections to non-admin users if admin klist usage is routine."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match Kerberos-relevant process names or command lines
    (
      // klist used to enumerate cached tickets - high-fidelity when run by non-service accounts
      $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin)\/klist$/ nocase
      or
      // kinit used to request or renew tickets, especially with keytab flag
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin)\/kinit$/ nocase
        and $proc.target.process.command_line = /\-k\b|\-\-keytab/ nocase
      )
      or
      // ktutil used to manipulate keytab files - rarely needed outside provisioning
      $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin)\/ktutil$/ nocase
      or
      // kvno used to probe service principal version numbers (reconnaissance step)
      $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin)\/kvno$/ nocase
      or
      // Direct ccache file access via cp, mv, or cat targeting /tmp krb5cc files or /dev/shm
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/(cp|mv|cat|dd|install)$/ nocase
        and $proc.target.process.command_line = /\/tmp\/krb5cc_|\/dev\/shm\/krb5|\/var\/tmp\/krb5cc/ nocase
      )
      or
      // Python or scripting interpreters directly referencing ccache or keytab paths
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin|usr\/local\/bin)\/(python[0-9.]*|ruby|perl|bash|sh|zsh)$/ nocase
        and $proc.target.process.command_line = /krb5cc|\.keytab|ccache|KRB5CCNAME/ nocase
      )
    )

    // Exclude known-good authorised users and automation processes
    not $proc.principal.user.userid in %linux_kerberos_allowed_users
    not $proc.target.process.file.full_path in %linux_kerberos_allowed_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_user = array_distinct($proc.principal.user.userid)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $triggering_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
