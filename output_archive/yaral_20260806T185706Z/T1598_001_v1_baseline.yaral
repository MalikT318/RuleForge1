/*
  MITRE Technique : T1598.001 - Spearphishing Service
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:26:19.594703+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_001_Spearphishing_Service_DNS_Recon {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects DNS query patterns consistent with adversary reconnaissance infrastructure used in spearphishing-via-service campaigns. Signals include queries for high-entropy or algorithmically generated domains, abnormally long subdomain labels, and uncommon record types (TXT, NULL) that are frequently abused for credential harvesting or C2 staging pages hosted on third-party platforms. These patterns appear in DNS telemetry before any endpoint compromise occurs."
    mitre_tactic    = "Reconnaissance"
    mitre_technique = "T1598.001"
    mitre_technique_name = "Phishing for Information: Spearphishing Service"
    log_prerequisites = "Requires full DNS query/response logs forwarded to Chronicle (resolver or recursive DNS logs). Must include query name, query type, and client IP. No endpoint process telemetry required."
    platform        = "PRE"
    log_source      = "dns"
    false_positives = "Legitimate CDN or cloud services with long subdomain labels (e.g., AWS S3 presigned URLs, Azure blob storage). Marketing analytics platforms using TXT records. Automated certificate validation (ACME DNS-01 challenges). Add confirmed-safe domains to %dns_allowed_domains."
    tuning_guidance = "Populate %dns_allowed_domains with known-good high-entropy domains from your environment (CDN, cloud storage, ACME). Raise the subdomain label length threshold if CDN false positives persist. Scope to internal resolver IPs if external resolver logs are too noisy."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Exclude known-good domains via reference list
    not $dns.network.dns.questions.name in %dns_allowed_domains

    // Signal 1: Uncommon DNS record types abused for phishing infrastructure
    // TXT (16) used for credential-harvesting page verification, SPF spoofing setup;
    // NULL (10) used for covert C2 channels on staging infrastructure.
    // ANY (255) used for amplification and reconnaissance.
    (
      $dns.network.dns.questions.type = 16 or   // TXT
      $dns.network.dns.questions.type = 10 or   // NULL
      $dns.network.dns.questions.type = 255      // ANY
    )

    // Signal 2: Abnormally long subdomain label - common in phishing kits that
    // embed target organisation name or token in the subdomain to appear legitimate.
    // A single label exceeding 40 characters is unusual for organic traffic.
    re.capture($dns.network.dns.questions.name, /([^.]{40,})\.[^.]+\.[^.]+$/) != ""

    // Signal 3: Domain pattern consistent with algorithmically generated or
    // randomised names used by adversary-controlled infrastructure.
    // Matches labels composed of 8+ consecutive consonant/digit clusters with
    // no natural vowel rhythm - a lightweight entropy proxy without math ops.
    $dns.network.dns.questions.name = /\b[b-df-hj-np-tv-z0-9]{4,}[b-df-hj-np-tv-z0-9]{4,}\.[a-z]{2,6}$/ nocase

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1598.001")
    $primary_entity    = array_distinct($dns.principal.ip)
    $queried_domain    = array_distinct($dns.network.dns.questions.name)
    $query_type        = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
