/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:16:53.061124+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Timer_Unit_Created_Then_Enabled_Container {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a systemd .timer or paired .service unit file written inside a container or to a host-mounted systemd path, followed by a resource-access event indicating the unit was enabled or activated via the container control plane. This provides additive coverage beyond process-launch command-line rules by correlating the file-write artefact with the subsequent activation signal observed in container/Kubernetes audit telemetry."
    mitre_tactic    = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires container runtime or Kubernetes audit logs normalised to Chronicle UDM. FILE_CREATION events must capture target.file.full_path. USER_RESOURCE_ACCESS events must capture target.resource.name or target.process.command_line reflecting systemctl enable/start activity inside or against a container."
    platform        = "Linux"
    log_source      = "container"
    false_positives = "Legitimate container images that bundle systemd unit files at build time; infrastructure-as-code pipelines deploying systemd-based services; configuration-management tools (Ansible, Chef, Puppet) writing unit files to host-mounted volumes."
    tuning_guidance = "Add known CI/CD service-account names to %allowed_systemd_deploy_accounts. Add approved container image prefixes to %allowed_systemd_container_images. Narrow the file path regex if your environment only uses /etc/systemd/system/ and not /usr/lib/systemd/."

  events:
    // Leg 1: a systemd timer or service unit file is created inside a container
    // or on a host-mounted systemd path surfaced through container telemetry.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(etc|usr\/lib|run)\/systemd\/(system|user)\/[^\/]+\.(timer|service)$/ nocase
    not $file.principal.user.userid in %allowed_systemd_deploy_accounts
    not $file.target.file.full_path in %allowed_systemd_unit_paths
    $file.principal.hostname = $container_host

    // Leg 2: within the same time window the unit is enabled or started,
    // observed as a resource-access event on the same host (exec into container
    // or Kubernetes API call triggering systemctl).
    $act.metadata.event_type = "USER_RESOURCE_ACCESS"
    $act.target.resource.name = /systemd|systemctl|\.timer|\.service/ nocase
    not $act.principal.user.userid in %allowed_systemd_deploy_accounts
    $act.principal.hostname = $container_host

    // Chronological ordering: file write must precede activation.
    $file.metadata.event_timestamp.seconds <= $act.metadata.event_timestamp.seconds

  match:
    $container_host over 1h

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1053.006")
    $primary_entity      = array_distinct($container_host)
    $unit_files_written  = array_distinct($file.target.file.full_path)
    $activating_accounts = array_distinct($act.principal.user.userid)
    $activation_targets  = array_distinct($act.target.resource.name)

  condition:
    $file and $act
}
