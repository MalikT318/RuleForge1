/*
  MITRE Technique : T1561 - Disk Wipe
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:11:29.815150+00:00
  Reference       : https://attack.mitre.org/techniques/T1561
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_Linux_Disk_Wipe_Direct_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects processes writing directly to raw block devices or performing disk-wiping operations on Linux. Adversaries use tools such as dd, shred, or custom binaries to overwrite disk sectors, MBR, or entire block devices to destroy data and interrupt availability. The rule targets the combination of a known wipe-capable utility invoked with arguments that reference raw block device paths (/dev/sd*, /dev/hd*, /dev/nvme*, /dev/vd*, /dev/xvd*) or explicit zero/random fill sources, which is the fundamental OS mechanism for destructive disk wiping."
    mitre_tactic    = "Impact"
    mitre_technique = "T1561"
    mitre_technique_name = "Disk Wipe"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with full command-line capture (execve syscall auditing). Auditd rule: -a always,exit -F arch=b64 -S execve -k disk_wipe."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Authorized disk provisioning or secure erase operations by storage administrators; OS installation or imaging workflows; forensic workstation disk acquisition; benchmark or stress-test tooling against non-production devices."
    tuning_guidance = "Add authorized administrator user IDs to %linux_allowed_disk_admin_users and authorized parent process paths (e.g., provisioning agents) to %linux_allowed_disk_wipe_parents. Scope by hostname for known imaging hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match wipe-capable utilities by process name or full path using behavioral
    // characteristics rather than exact binary names, to survive renaming where
    // the binary is invoked via its canonical path or a common alias.
    (
      $proc.target.process.file.full_path = /\/(dd|shred|wipe|dcfldd|dc3dd|badblocks|hdparm|nvme|blkdiscard|wipefs|scrub)$/ nocase
      or
      $proc.target.process.command_line = /(^|\s)(dd|shred|wipe|dcfldd|dc3dd|badblocks|hdparm|nvme|blkdiscard|wipefs|scrub)\s/ nocase
    )

    // Command line must reference a raw block device path - the core OS mechanism
    // for direct disk access on Linux. This is the highest-fidelity signal.
    $proc.target.process.command_line = /\/dev\/(sd[a-z]+|hd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|xvd[a-z]+|sda|sdb|sdc|disk)/ nocase

    // Additionally require at least one wipe-indicative argument pattern:
    // zero/random fill sources, force flags, or explicit overwrite counts.
    (
      $proc.target.process.command_line = /(if=\/dev\/(zero|urandom|random)|of=\/dev\/(sd|hd|nvme|vd|xvd)|--zero|--remove|--iterations|--force|-n\s+[0-9]|count=[0-9]|seek=0|bs=[0-9]+(M|G|K))/ nocase
      or
      $proc.target.process.command_line = /(--wipe|--wipe-partitions|--wipe-signatures|--secure-erase|sanitize|format\s+--reset|-z\s+\/dev|erase\s+\/dev)/ nocase
    )

    // Exclude known authorized disk administration processes and users
    not $proc.principal.process.file.full_path in %linux_allowed_disk_wipe_parents
    not $proc.principal.user.userid in %linux_allowed_disk_admin_users

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1561")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_user     = array_distinct($proc.principal.user.userid)
    $wipe_command_line = array_distinct($proc.target.process.command_line)
    $wipe_binary       = array_distinct($proc.target.process.file.full_path)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
