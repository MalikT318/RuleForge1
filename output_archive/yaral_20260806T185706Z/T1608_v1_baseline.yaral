/*
  MITRE Technique : T1608 - Stage Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:31:45.237924+00:00
  Reference       : https://attack.mitre.org/techniques/T1608
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_Stage_Capabilities_Suspicious_Payload_Hosting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP/S requests from internal hosts to public PaaS, code-hosting, or paste-site platforms fetching content with characteristics consistent with staged capability delivery: executable MIME types, archive extensions, script extensions, or suspiciously long encoded paths. Adversaries stage malware, implants, and exploit resources on commodity cloud platforms (GitHub, Pastebin, Heroku, GCP, etc.) to blend with legitimate traffic and evade reputation-based controls."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608"
    mitre_technique_name = "Stage Capabilities"
    log_prerequisites = "Requires firewall or proxy logs with HTTP metadata: URL path, User-Agent, MIME type or Content-Type, and response codes normalised into UDM NETWORK_HTTP events."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate developer workflows pulling packages from GitHub releases, Heroku-hosted SaaS applications, Pastebin snippets used in automation, GCP Cloud Run services. Tune by adding approved destination hostnames to %allowed_paas_hosting_domains and approved internal source IPs to %allowed_developer_hosts."
    tuning_guidance = "Add known-good PaaS hostnames used by your organisation to %allowed_paas_hosting_domains. Add developer workstation subnets or CI/CD egress IPs to %allowed_developer_hosts. Raise severity to High if combined with a low-reputation domain age signal from a threat intel feed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"

    // Destination must be a public address - exclude RFC-1918 and loopback
    not $http.target.ip in %rfc1918_internal

    // Target hostname matches commodity PaaS, code-hosting, or paste platforms
    // commonly abused for capability staging
    $http.target.hostname = /\.(herokuapp\.com|herokussl\.com|github\.io|raw\.githubusercontent\.com|gist\.githubusercontent\.com|pastebin\.com|paste\.ee|hastebin\.com|run\.app|cloudfunctions\.net|appspot\.com|pages\.dev|workers\.dev|netlify\.app|vercel\.app|glitch\.me|repl\.co|replit\.com|000webhostapp\.com|weebly\.com|wixsite\.com|azurewebsites\.net|blob\.core\.windows\.net|s3\.amazonaws\.com|storage\.googleapis\.com)$/ nocase

    // Request targets a path consistent with a staged payload:
    // executable, archive, script, or encoded blob
    (
      $http.target.url = /\.(exe|dll|ps1|vbs|js|hta|bat|cmd|sh|elf|bin|msi|pkg|dmg|zip|gz|tar|7z|rar|iso|img|jar|war|py|rb|pl)(\?|$)/ nocase
      or
      $http.target.url = /\/(raw|releases\/download|download|payload|stage|drop|implant|agent|update|patch|install|setup|loader|stager|beacon|rat|c2|cnc)\// nocase
      or
      // Long base64-like or hex-encoded path segments often indicate encoded payload delivery
      $http.target.url = /\/[A-Za-z0-9+\/=_-]{60,}/ nocase
    )

    // Exclude known-good approved hosting domains and approved source hosts
    not $http.target.hostname in %allowed_paas_hosting_domains
    not $http.principal.ip in %allowed_developer_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)

  condition:
    $http
}
