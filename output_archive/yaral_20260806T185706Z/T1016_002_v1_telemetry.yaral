/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:26:28.898963+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_WiFi_Discovery_macOS_Network_Observable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network-observable behaviour consistent with Wi-Fi credential or profile exfiltration on macOS. Adversaries who harvest Wi-Fi credentials (e.g., from /Library/Preferences/SystemConfiguration/com.apple.airport.preferences.plist or the macOS Keychain) may subsequently beacon that data outbound. This rule fires on anomalous outbound connections from macOS endpoints that match patterns associated with post-discovery exfiltration: small, periodic flows to non-RFC-1918 destinations on common data-exfil ports shortly after Wi-Fi enumeration activity. Because firewall logs do not carry process context, the rule focuses purely on connection metadata: destination space, port, and flow characteristics."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires perimeter or host-based firewall/flow logs normalised into Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION events. Logs must populate principal.ip, target.ip, target.port, network.sent_bytes, and network.application_protocol or target.port."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Cloud backup agents (Time Machine to NAS via internet), MDM check-ins, legitimate SaaS sync clients, software update services, VPN keepalives. Tune using %global_allowed_macos_cloud_destinations and %global_allowed_saas_ports."
    tuning_guidance = "Add known-good SaaS destination CIDRs or resolved hostnames to %global_allowed_macos_cloud_destinations. Add sanctioned egress ports used by MDM/backup to %global_allowed_saas_ports. Raise the sent_bytes threshold if large legitimate transfers are common in the environment. Consider narrowing to specific source subnets that host macOS endpoints."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal macOS endpoint (non-routable source)
    // Exclude loopback and link-local; internal RFC-1918 sources are expected
    $net.principal.ip = /^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)/ nocase

    // Destination must be external (non-RFC-1918, non-loopback, non-link-local)
    not $net.target.ip = /^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|127\.|169\.254\.|::1|fc00:|fe80:)/ nocase

    // Focus on ports commonly abused for exfiltration of small credential payloads:
    // 443 (HTTPS), 80 (HTTP), 8080 (alt-HTTP), 8443 (alt-HTTPS), 22 (SSH tunnel),
    // 21 (FTP), 587 (SMTP submission), 465 (SMTPS), 25 (SMTP)
    $net.target.port in [21, 22, 25, 80, 443, 465, 587, 8080, 8443]

    // Small outbound payload - consistent with credential/profile data, not bulk transfer
    // Wi-Fi plist and keychain entries are typically a few KB to tens of KB
    $net.network.sent_bytes > 0
    $net.network.sent_bytes < 102400

    // Exclude known-good cloud destinations and sanctioned ports via reference lists
    not $net.target.ip in %global_allowed_macos_cloud_destinations
    not $net.target.port in %global_allowed_saas_ports

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
