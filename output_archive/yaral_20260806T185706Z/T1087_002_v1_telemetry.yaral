/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:29:10.316888+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_Domain_Account_Enum_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file artifacts produced by domain account enumeration on Linux. Tools such as ldapsearch, getent, and sssd/winbind dump domain user and group data to files in /tmp, /dev/shm, or world-writable directories. Detecting the resulting file artifact provides coverage that evades command-line log suppression."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires Linux EDR or auditd FILE_CREATION telemetry with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate IT automation scripts that cache LDAP query results, monitoring agents that periodically dump user lists, configuration management tools (Ansible, Puppet) performing inventory, and identity management platforms (FreeIPA, SSSD) writing cache files."
    tuning_guidance = "Add known automation service account userids to %linux_allowed_enum_users. Add approved parent process paths to %linux_allowed_ldap_parents. Narrow scope by excluding specific target directories if your environment legitimately writes domain data there."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File written to a staging or world-writable location commonly used
    // to exfiltrate or stage enumeration output
    (
      $file.target.file.full_path = /^\/tmp\// nocase or
      $file.target.file.full_path = /^\/dev\/shm\// nocase or
      $file.target.file.full_path = /^\/var\/tmp\// nocase or
      $file.target.file.full_path = /^\/run\/user\// nocase
    )

    // File name patterns consistent with domain account enumeration output:
    // ldap query dumps, user/group list exports, sssd/winbind cache exports
    (
      $file.target.file.full_path = /\/(ldap|domain.?user|domain.?group|ad.?user|ad.?group|getent|passwd.?dump|user.?list|group.?list|account.?enum)/ nocase or
      $file.target.file.full_path = /\.(ldif|ldap|csv|tsv|out|dump|txt)$/ nocase
    )

    // Process responsible for the write is a known domain enumeration tool
    // or a shell/interpreter that could be scripting one
    (
      $file.principal.process.file.full_path = /\/(ldapsearch|ldapwhoami|ldapquery|getent|wbinfo|net|adcli|realm|sssd|sss_cache|id|groups|finger|ldbsearch|python[23]?|perl|ruby|bash|sh|dash|zsh|ksh)$/ nocase
    )

    // Exclude known-safe automation parents
    not $file.principal.process.file.full_path in %linux_allowed_ldap_parents

    // Exclude known-safe service accounts performing legitimate enumeration
    not $file.principal.user.userid in %linux_allowed_enum_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
