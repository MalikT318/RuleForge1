/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:27:27.950819+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_002_SysInfo_Discovery_After_Auth_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a successful authentication event followed by a privileged directory or group enumeration action within a short window, suggesting an adversary performing system information discovery after gaining access. Identity provider logs surface the auth event; a subsequent directory audit event (e.g. reading privileged group membership or device detail queries) completes the sequence. This provides additive coverage beyond process-launch command-line rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Requires identity provider sign-in logs (USER_LOGIN) and directory audit logs (USER_RESOURCE_ACCESS or GROUP_MODIFICATION) normalised into Chronicle UDM. Entra ID / Okta / AD audit streams are typical sources."
    platform = "Windows"
    log_source = "identity"
    false_positives = "IT helpdesk staff performing routine device or group lookups after logging in; automated service accounts querying directory for provisioning; monitoring tools performing periodic health checks."
    tuning_guidance = "Add known service-account userids to %global_allowed_service_accounts. Add known admin workstation hostnames to %global_allowed_admin_hosts. Raise the risk score threshold in the SOAR playbook if the environment has frequent legitimate privileged lookups."

  events:
    // Leg 1: Successful authentication - narrowly filtered to avoid high-volume noise
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.summary = /success/ nocase
    not $auth.principal.user.userid in %global_allowed_service_accounts
    $auth.principal.user.userid = $userid

    // Leg 2: Directory/resource access event consistent with system or group enumeration
    // e.g. reading privileged group membership, device detail, or role assignment queries
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.resource.name = /device|computer|machine|system|hardware|os|operating.system|group.member|role.assign|directory.role/ nocase
    not $access.principal.user.userid in %global_allowed_service_accounts
    $access.principal.user.userid = $userid

    // Chronological ordering: auth must precede the enumeration access
    $auth.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $userid over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity = array_distinct($userid)
    $auth_source_ip = array_distinct($auth.principal.ip)
    $accessed_resources = array_distinct($access.target.resource.name)
    $access_count = count($access.metadata.event_timestamp.seconds)

  condition:
    $auth and $access
}
