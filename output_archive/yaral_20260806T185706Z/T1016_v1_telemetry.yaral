/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:25:08.154815+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_ESXi_Network_Config_Discovery_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file creation or modification of network configuration output files on ESXi hosts, indicative of an adversary staging the results of network configuration discovery (e.g. esxcli network nic list, esxcli network ip interface ipv4 get) to a file for exfiltration. Targets the file artifact produced by the discovery action rather than the command line, providing coverage that survives command-line logging evasion."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Requires ESXi shell/hostd file-activity telemetry normalised into Chronicle UDM FILE_CREATION or FILE_MODIFICATION events. EDR agents capable of monitoring ESXi file system activity (e.g. Carbon Black, CrowdStrike Falcon for ESXi) or syslog-forwarded shell audit logs are required."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised VMware administrators running scheduled health-check or capacity-planning scripts that redirect network enumeration output to files. Monitoring or SIEM agents that periodically collect host network state. VMware vSphere lifecycle management automation."
    tuning_guidance = "Add known administrative service account usernames to %esxi_allowed_admin_users and known automation script parent paths to %esxi_allowed_automation_paths. Narrow the file path regex if your environment uses a consistent scratch or log directory for legitimate output files."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File written to common ESXi writable locations used to stage discovery output:
    // /tmp, /scratch, /var/tmp, /vmfs/volumes subdirectories, or home directories under /root
    $file.target.file.full_path = /^(\/tmp\/|\/scratch\/|\/var\/tmp\/|\/vmfs\/volumes\/|\/root\/)/ nocase

    // File name patterns consistent with staged network enumeration output:
    // e.g. net_info.txt, nic_list.out, network_config.log, ipv4.txt, mac_addresses.csv
    $file.target.file.full_path = /(net|nic|ip|mac|addr|iface|interface|network|route|vswitch)([\w\-_]*)?\.(txt|log|out|csv|json|tmp)$/ nocase

    // Restrict to shell or esxcli-related processes writing the file
    // ESXi shell processes: sh, busybox (which provides sh), python, perl used in admin scripts
    $file.principal.process.file.full_path = /(\/bin\/sh|\/bin\/busybox|\/sbin\/esxcli|\/usr\/bin\/python|\/usr\/bin\/perl|\/bin\/bash)$/ nocase

    // Exclude known safe automation paths
    not $file.principal.process.file.full_path in %esxi_allowed_automation_paths

    // Exclude known administrative service accounts
    not $file.principal.user.userid in %esxi_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($file.principal.hostname)
    $written_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
