/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 3  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T18:58:57.575171+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_001_IaaS_Security_Policy_Disable_Via_Identity {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects identity-provider audit events where a security policy, MFA enforcement, conditional access policy, or authentication strength requirement is disabled or deleted. Adversaries exploiting defense-impairment vulnerabilities may abuse identity-plane misconfigurations or privilege escalation to weaken authentication controls, effectively blinding or bypassing cloud security boundaries without touching an endpoint."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires identity provider directory audit logs that record policy lifecycle events (create/update/delete on conditional access, MFA, authentication strength, or sign-in policies). Chronicle UDM normalization must populate metadata.event_type and target.resource.name."
    platform        = "IaaS"
    log_source      = "identity"
    false_positives = "Authorized security-team policy reviews, planned MFA policy migrations, break-glass account procedures, and automated policy-as-code pipelines that legitimately disable then re-enable policies during deployments."
    tuning_guidance = "Add known automation service-principal user IDs to %global_allowed_policy_automation_principals. Add approved policy names to %global_allowed_policy_names if specific policies are routinely toggled by automation. Narrow severity by correlating with off-hours or non-approved-country sign-in context."

  events:
    $auth.metadata.event_type = "SETTING_MODIFICATION"

    // Target a security-relevant policy resource by name pattern
    (
      $auth.target.resource.name = /conditional.?access/ nocase or
      $auth.target.resource.name = /mfa.?polic/ nocase or
      $auth.target.resource.name = /authentication.?strength/ nocase or
      $auth.target.resource.name = /sign.?in.?polic/ nocase or
      $auth.target.resource.name = /security.?default/ nocase or
      $auth.target.resource.name = /identity.?protection/ nocase or
      $auth.target.resource.name = /access.?polic/ nocase
    )

    // The modification must represent a disabling or deletion action
    (
      $auth.security_result.description = /disabled/ nocase or
      $auth.security_result.description = /deleted/ nocase or
      $auth.security_result.description = /set to disabled/ nocase or
      $auth.security_result.description = /enforcement.*off/ nocase or
      $auth.security_result.description = /report.?only/ nocase
    )

    // Actor must be a real user or service principal - exclude system accounts
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_policy_automation_principals
    not $auth.target.resource.name in %global_allowed_policy_names

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity    = array_distinct($auth.principal.user.userid)
    $affected_policy   = array_distinct($auth.target.resource.name)
    $actor_userid      = array_distinct($auth.principal.user.userid)

  condition:
    $auth
}
