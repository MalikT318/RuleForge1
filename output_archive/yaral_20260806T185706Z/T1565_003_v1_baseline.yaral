/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:14:44.275728+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_Runtime_Data_Manipulation_FileAssoc_Masquerade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects runtime data manipulation via modification of file association registry keys or replacement of application binaries used to display data. Adversaries alter these to intercept or corrupt data presented to end users, consistent with T1565.003 techniques observed in APT38/Lazarus campaigns."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Runtime Data Manipulation"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry normalised to UDM REGISTRY_MODIFICATION events. Sysmon Event ID 13 or equivalent EDR registry write events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers changing file associations, browser installations updating handler registrations, application updates replacing binaries in Program Files."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_fileassoc_writers. Scope to sensitive application paths (financial, industrial, display software) if noise is high. Consider pairing with a process lineage check for non-interactive parents."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target file association handler keys or shell open command overrides
    // These are the OS mechanisms adversaries abuse to redirect what binary
    // opens a given file type, enabling runtime data interception/manipulation
    (
      $reg.target.registry.registry_key = /\\SOFTWARE\\Classes\\[^\\]+\\shell\\open\\command/ nocase or
      $reg.target.registry.registry_key = /\\SOFTWARE\\Classes\\[^\\]+\\shell\\print\\command/ nocase or
      $reg.target.registry.registry_key = /\\SOFTWARE\\Classes\\[^\\]+\\shell\\edit\\command/ nocase or
      $reg.target.registry.registry_key = /\\SOFTWARE\\Classes\\Applications\\[^\\]+\\shell\\open\\command/ nocase or
      $reg.target.registry.registry_key = /\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\[^\\]+\\UserChoice/ nocase
    )

    // The new handler value must point to something suspicious:
    // a binary outside standard system/program directories, or a scripting host,
    // or a path containing user-writable locations - all hallmarks of manipulation
    (
      $reg.target.registry.registry_value_data = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe/ nocase or
      $reg.target.registry.registry_value_data = /\\(AppData|Temp|ProgramData|Users\\[^\\]+\\Downloads)/ nocase or
      $reg.target.registry.registry_value_data = /\\(wmic|certutil|bitsadmin|msiexec)\.exe/ nocase
    )

    // Exclude known-good installer and admin tooling parent processes
    not $reg.principal.process.file.full_path in %global_allowed_fileassoc_writers

    // Exclude system-level writers that legitimately manage associations
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|MsiExec|setup|install|update)\.exe$/ nocase

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_registry_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $new_handler_value = array_distinct($reg.target.registry.registry_value_data)
    $actor_userid = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
