/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:13:45.416924+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_002_ESXi_Shell_Decode_After_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive ESXi shell login followed within 5 minutes by execution of a native decode or deobfuscation utility (base64, openssl, python, perl, gzip, tar with uncompress flags). Adversaries who stage encoded payloads on ESXi datastores commonly authenticate via SSH or the ESXi shell and immediately decode the payload using built-in utilities, leaving no Windows-style artefacts. This correlation catches that two-step pattern without relying on command-line substring matching alone."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Requires ESXi shell/SSH authentication events (hostd or sshd via USER_LOGIN) and ESXi shell process telemetry (PROCESS_LAUNCH) forwarded to Chronicle. Both event types must share a normalised principal.hostname and principal.user.userid."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised ESXi administrators running scheduled backup or certificate rotation scripts that invoke openssl or base64. Automated monitoring agents that authenticate and invoke compression utilities. VMware lifecycle management tasks."
    tuning_guidance = "Add known-good service accounts to %esxi_allowed_shell_accounts. Add approved management hostnames to %esxi_allowed_mgmt_hosts. Narrow the decode-binary regex if specific utilities are universally safe in your environment."

  events:
    // Leg 1: interactive authentication to the ESXi shell or SSH service
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname != ""
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %esxi_allowed_shell_accounts
    not $auth.principal.hostname in %esxi_allowed_mgmt_hosts
    $auth.principal.hostname = $esxi_host
    $auth.target.user.userid = $shell_user

    // Leg 2: execution of a decode/deobfuscation-capable binary on the same host
    // by the same user shortly after login
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $esxi_host
    $proc.principal.user.userid = $shell_user
    // Match built-in ESXi/BusyBox utilities commonly abused for decoding:
    // base64, openssl, python, python3, perl, gzip, gunzip, tar, xxd, od
    $proc.target.process.file.full_path = /\/(base64|openssl|python[23]?|perl|gzip|gunzip|tar|xxd|od)$/ nocase
    not $proc.principal.process.file.full_path in %esxi_allowed_shell_accounts

    // Chronological ordering: login must precede the decode invocation
    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $esxi_host, $shell_user over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($proc.principal.hostname)
    $decoded_binary = array_distinct($proc.target.process.file.full_path)
    $decode_command_line = array_distinct($proc.target.process.command_line)
    $authenticated_user = array_distinct($shell_user)
    $event_count = count($proc.metadata.event_timestamp.seconds)

  condition:
    $auth and $proc
}
