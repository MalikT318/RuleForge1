/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:19:20.139219+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_AuthPkg_Registry_Then_DLL_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects the two-stage persistence pattern for T1547.002: first, a process modifies the LSA Authentication Packages registry key to register a new DLL name, then within 10 minutes a matching DLL file is created outside of expected Windows system directories. Together these events indicate an adversary staging a malicious authentication package that will be loaded by LSASS on next boot."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires EDR or Sysmon registry-modification telemetry (Event ID 13) and file-creation telemetry (Event ID 11) normalised into Chronicle UDM. Both event types must be present for the correlation to fire."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate security software (e.g., smart-card middleware, third-party MFA agents) that registers a custom LSA authentication package and drops its DLL during installation. Antivirus or EDR self-protection modules may also touch this key during updates."
    tuning_guidance = "Add known-good parent process paths (e.g., installer frameworks) to %global_allowed_authpkg_writers. Add approved DLL staging directories to %global_allowed_authpkg_dll_paths. Scope by hostname for high-noise environments."

  events:
    // Event 1: registry modification targeting the LSA Authentication Packages value
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Lsa$/ nocase
    $reg.target.registry.registry_value_name = /^Authentication Packages$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_authpkg_writers
    $reg.principal.hostname = $hostname

    // Event 2: DLL file creation that is NOT inside expected Windows system paths
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.dll$/ nocase
    not $file.target.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss]ystem32\\/
    not $file.target.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss]ys[Ww][Oo][Ww]64\\/
    not $file.target.file.full_path in %global_allowed_authpkg_dll_paths
    $file.principal.hostname = $hostname

    // Chronological ordering: registry write must precede the DLL drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(95)
    $mitre_technique_id  = array_distinct("T1547.002")
    $primary_entity      = array_distinct($hostname)
    $reg_key_modified    = array_distinct($reg.target.registry.registry_key)
    $reg_value_name      = array_distinct($reg.target.registry.registry_value_name)
    $writing_process     = array_distinct($reg.principal.process.file.full_path)
    $dll_path_created    = array_distinct($file.target.file.full_path)
    $file_writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
