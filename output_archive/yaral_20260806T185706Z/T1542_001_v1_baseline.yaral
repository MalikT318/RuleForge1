/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:04:43.840315+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_Network_Device_Firmware_Update_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects anomalous firmware update or boot image transfer activity on network devices as observed through IDS/IPS telemetry. Adversaries may push malicious firmware to network devices to achieve persistent, difficult-to-detect footholds. Signals include TFTP, SCP, or HTTP transfers targeting firmware/boot image paths, or management-plane connections to unexpected external destinations during firmware-related sessions."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM. Appliance must inspect management-plane traffic and flag file transfer sessions (TFTP port 69, SCP port 22, HTTP/HTTPS) involving firmware or boot image filenames."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Legitimate scheduled firmware upgrades performed by network operations teams, automated provisioning systems (e.g. ZTP/PnP), and authorised out-of-band management transfers."
    tuning_guidance = "Populate %approved_firmware_source_ips with authorised management jump hosts, TFTP/SCP servers, and provisioning systems. Populate %approved_firmware_dest_ips with known network device management IPs. Add maintenance window suppression via a reference list if your SOAR supports time-based filtering."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match firmware-related transfer ports: TFTP (69), SCP/SSH (22), HTTP (80), HTTPS (443)
    // Focus on TFTP as the highest-fidelity signal for unauthenticated firmware push
    (
      $net.target.port = 69 or
      $net.target.port = 22 or
      $net.target.port = 80 or
      $net.target.port = 443
    )

    // The URL or application path references firmware, boot image, or flash artifacts
    // Matches patterns like: /firmware/, /boot/, /flash/, /image/, /upgrade/, /rommon/
    (
      $net.network.http.request_url = /\/(firmware|boot|flash|image|upgrade|rommon|kickstart|system-image|iosxe|nxos|junos|arubaos|eos)/ nocase or
      $net.target.url = /\.(bin|img|tar|gz|tgz|pkg|swi|qcow2|vmdk|iso|rom|fw)$/ nocase or
      $net.network.application_protocol = /tftp/ nocase
    )

    // Source is NOT an approved firmware management server
    not $net.principal.ip in %approved_firmware_source_ips

    // Destination is NOT a known managed device receiving legitimate updates
    not $net.target.ip in %approved_firmware_dest_ips

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)
    $request_url = array_distinct($net.target.url)

  condition:
    $net
}
