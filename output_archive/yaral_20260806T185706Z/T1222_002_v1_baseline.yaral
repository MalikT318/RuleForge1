/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:54:52.548116+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_macOS_Suspicious_Permission_Change_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network flows or connections originating from hosts where suspicious permission-change activity is correlated via IDS/IPS telemetry. On macOS, adversaries use chmod/chown to weaken ACLs on sensitive paths (/Library, /Users/*/Library, launchd plists) before staging payloads or establishing persistence. This rule targets anomalous outbound traffic patterns flagged by network security appliances from macOS endpoints, which may indicate post-exploitation activity following permission manipulation."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised into Chronicle UDM. The appliance must generate NETWORK_FLOW or NETWORK_CONNECTION events with principal hostname and alert/signature metadata. Host-based context (macOS endpoint) should be enriched via UDM entity graph."
    platform = "macOS"
    log_source = "ips"
    false_positives = "Software update agents, MDM solutions (Jamf, Mosyle), developer toolchains performing legitimate outbound calls after package installs that involve permission changes. Backup agents (Time Machine, Backblaze) may trigger on large outbound flows."
    tuning_guidance = "Add known MDM and update agent source IPs or hostnames to %macos_allowed_mgmt_hosts. Add approved destination CIDRs to %macos_allowed_update_destinations. Raise the minimum byte threshold or restrict to non-standard high ports to reduce noise from legitimate software distribution traffic."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Target non-RFC1918 destinations to focus on exfiltration/C2 risk
    // following permission weakening on macOS hosts
    not $net.target.ip in %macos_allowed_update_destinations

    // Focus on high-risk destination ports commonly abused for C2 or
    // data staging after ACL manipulation; exclude well-known update ports
    not $net.target.port = 80
    not $net.target.port = 443
    not $net.target.port = 8080

    // IDS/IPS appliances surface signature or category metadata in
    // security_result fields; use as supplementary signal only
    // (not core logic) due to inconsistent vendor UDM mapping.
    // Primary logic relies on flow characteristics and host exclusions.

    // Restrict to flows with meaningful data volume suggesting staging
    // or exfiltration rather than simple probes
    $net.network.sent_bytes > 50000

    // Exclude known-safe management infrastructure
    not $net.principal.hostname in %macos_allowed_mgmt_hosts

    // Exclude internal RFC1918 destinations (lateral movement is a
    // separate detection; this rule targets external risk)
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
