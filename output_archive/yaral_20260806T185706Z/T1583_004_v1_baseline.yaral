/*
  MITRE Technique : T1583.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:18:46.947173+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_004_Adversary_Server_Infra_Recon_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects high-rate inbound connection bursts from a single external source across multiple destination ports, consistent with adversary-controlled server infrastructure conducting reconnaissance, capability staging, or C2 channel establishment. Adversaries operating their own servers often probe target networks in structured sweeps before or during operations."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.004"
    mitre_technique_name = "Acquire Infrastructure: Server"
    log_prerequisites = "Requires IDS/IPS or network security appliance flow telemetry with source/destination IP and port visibility. Blocked and allowed flows should both be present for highest fidelity."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate vulnerability scanners (Qualys, Tenable, Rapid7) operated by the customer, CDN health-check probes, authorized penetration testing infrastructure, internet-wide research scanners (Shodan, Censys)."
    tuning_guidance = "Add known authorized scanner IPs or CIDR ranges to %global_allowed_scanner_ips. Add internal pentest source ranges to %global_pentest_sources. Raise the port-count threshold or restrict to specific destination port ranges (e.g., 22, 80, 443, 3389, 8080) to reduce noise in high-traffic environments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be external (non-RFC1918) - adversary-controlled server
    not $net.principal.ip in %rfc1918_internal

    // Target must be within monitored network space
    $net.target.ip in %monitored_network_ranges

    // Focus on ports commonly associated with adversary staging, C2, and
    // initial access delivery - broad sweep across service ports
    (
      $net.target.port = 22   or   // SSH
      $net.target.port = 23   or   // Telnet
      $net.target.port = 25   or   // SMTP
      $net.target.port = 80   or   // HTTP
      $net.target.port = 443  or   // HTTPS
      $net.target.port = 445  or   // SMB
      $net.target.port = 3389 or   // RDP
      $net.target.port = 8080 or   // Alt HTTP
      $net.target.port = 8443 or   // Alt HTTPS
      $net.target.port = 4444 or   // Common C2/Metasploit default
      $net.target.port = 1080 or   // SOCKS proxy
      $net.target.port = 9001      // Tor/C2 common
    )

    // Exclude known authorized scanner sources
    not $net.principal.ip in %global_allowed_scanner_ips
    not $net.principal.ip in %global_pentest_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    $net
}
