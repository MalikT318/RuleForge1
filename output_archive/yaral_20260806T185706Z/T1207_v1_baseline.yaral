/*
  MITRE Technique : T1207 - Rogue Domain Controller
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:52:08.579943+00:00
  Reference       : https://attack.mitre.org/techniques/T1207
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1207_001_DCShadow_Rogue_DC_Registration {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects DCShadow-style rogue Domain Controller registration by identifying modifications to the AD Configuration partition registry keys or nTDSDSA-related registry paths that are written by non-standard processes. DCShadow registers a rogue DC by creating server and nTDSDSA objects; on the host this manifests as registry writes under the NTDS or replication configuration paths from unexpected processes such as lsass injectors or credential-dumping tooling."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1207"
    mitre_technique_name = "Rogue Domain Controller"
    log_prerequisites = "Requires EDR registry telemetry (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 13). The sensor must capture registry key path and the writing process image path."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate DC promotion (dcpromo / AD DS role installation), domain controller configuration management tools, authorised AD schema extensions performed by enterprise software installers."
    tuning_guidance = "Add authorised DC-promotion parent processes (e.g. dfsvc.exe, msiexec.exe during known change windows) to %global_allowed_dc_config_writers. Scope to domain controller assets only where possible using a reference list of DC hostnames (%dc_hostnames)."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the NTDS configuration and replication service registry paths
    // that a rogue DC registration must touch. nTDSDSA objects are reflected
    // in the NTDS\Parameters and replication topology keys.
    (
      $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Services\\NTDS\\Parameters/ nocase
      or
      $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Services\\Netlogon/ nocase
      or
      $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Services\\DFSR/ nocase
      or
      // DCShadow registers under the Configuration NC; Sysmon/EDR may surface
      // the local reflection of schema/config partition writes here
      $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Services\\NTDS\\Replication/ nocase
    )

    // The writing process must NOT be a known legitimate DC management binary.
    // Legitimate DC config is written by ntdsai.dll hosted in lsass.exe during
    // normal promotion, or by dcpromo / ServerManager. DCShadow injects into
    // or impersonates these paths from unexpected parent processes.
    not $reg.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\dcpromo\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\ServerManager\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\dfsvc\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\msiexec\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\TrustedInstaller\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\svchost\.exe$/ nocase

    // Exclude known-safe admin tooling via reference list
    not $reg.principal.process.file.full_path in %global_allowed_dc_config_writers

    // Optionally scope to known DC hostnames to reduce noise in large estates
    // (comment out if DC hostname list is not maintained)
    $reg.principal.hostname in %dc_hostnames

  outcome:
    $risk_score        = max(90)
    $mitre_technique_id = array_distinct("T1207")
    $primary_entity    = array_distinct($reg.principal.hostname)
    $writing_process   = array_distinct($reg.principal.process.file.full_path)
    $registry_key_hit  = array_distinct($reg.target.registry.registry_key)
    $actor_userid      = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
