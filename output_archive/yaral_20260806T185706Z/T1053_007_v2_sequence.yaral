/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:17:26.831991+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_K8s_CronJob_Created_Then_Job_Spawned {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Kubernetes CronJob or Job resource creation via the API plane followed by a subsequent resource access event consistent with the scheduled workload being dispatched. This two-stage correlation catches adversaries who create a CronJob or Job to achieve persistence or execution within a cluster without relying on in-container process telemetry."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes API server audit logs normalised into Chronicle UDM. The audit policy must capture create/get/list verbs for batch/v1 Job and CronJob resources. Cloud provider managed Kubernetes audit log forwarding must be enabled."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines that create Jobs or CronJobs programmatically, cluster autoscalers, backup operators, and monitoring agents that schedule periodic workloads."
    tuning_guidance = "Add known CI/CD service account principals to %k8s_allowed_job_creators. Add known automation namespaces to %k8s_allowed_job_namespaces. Raise severity if the creating principal is an interactive user rather than a service account."

  events:
    // Leg 1: A CronJob or Job resource is created via the Kubernetes API
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.resource.type = /cronjob|job/ nocase
    $create.target.resource.name != ""
    not $create.principal.user.userid in %k8s_allowed_job_creators
    not $create.target.resource.attribute.labels["namespace"] in %k8s_allowed_job_namespaces
    $create.principal.user.userid = $actor
    $create.target.resource.attribute.labels["namespace"] = $namespace

    // Leg 2: The cluster API is subsequently accessed to read or watch the
    // resulting Job or Pod resource, indicating the scheduler acted on the
    // definition and the workload was dispatched
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.resource.type = /pod|job/ nocase
    $access.target.resource.attribute.labels["namespace"] = $namespace
    not $access.principal.user.userid in %k8s_allowed_job_creators

    // Chronological ordering: creation must precede the access event
    $create.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $actor, $namespace over 1h

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($create.principal.user.userid)
    $created_resource_names = array_distinct($create.target.resource.name)
    $accessed_resource_names = array_distinct($access.target.resource.name)
    $affected_namespaces = array_distinct($namespace)
    $creating_principals = array_distinct($create.principal.user.userid)

  condition:
    $create and $access
}
