/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:25:50.276784+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_ESXi_NetProbe_File_Artifact {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects file creation of transient output artifacts produced when an adversary performs internet connectivity discovery on an ESXi host. Tools such as ping, wget, curl, or traceroute running in the ESXi shell commonly redirect results to a temporary file for later exfiltration or scripted parsing. Detecting the resulting file artifact provides coverage that survives command-line log evasion."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires ESXi shell file-system telemetry forwarded to Chronicle via syslog or a lightweight agent capable of emitting FILE_CREATION UDM events from the ESXi host (e.g., VMware vRealize Log Insight with UDM normalisation, or a Chronicle forwarder on the management plane). hostd and shell logs must be ingested."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised health-check scripts run by VMware administrators or monitoring agents (e.g., vROps, Zabbix) that redirect ping or wget output to /tmp. Automated patching workflows that test connectivity before downloading bundles."
    tuning_guidance = "Populate %esxi_allowed_netprobe_writers with the full paths of approved monitoring or patching processes. Narrow the file path regex if your environment uses a consistent temp directory other than /tmp or /var/run. Raise severity to High if combined with a preceding USER_LOGIN from an unexpected source IP."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File lands in a world-writable or shell-session scratch location on ESXi
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/scratch\/|\/var\/run\/)/ nocase

    // Filename patterns consistent with redirected connectivity-probe output:
    // ping results, wget/curl output, traceroute dumps, speed-test artefacts
    $file.target.file.full_path = /(ping|trace|route|wget|curl|conn(ect)?|reach|probe|net(check|test)|speed|latency|icmp|http_test)/  nocase

    // The writing process must be a shell or a network utility native to ESXi busybox
    $file.principal.process.file.full_path = /(\/bin\/sh|\/bin\/ash|\/bin\/busybox|\/sbin\/ping|\/usr\/bin\/wget|\/usr\/bin\/curl|\/bin\/traceroute|\/usr\/lib\/vmware\/busybox\/bin\/busybox)/ nocase

    // Exclude known-good authorised probe writers
    not $file.principal.process.file.full_path in %esxi_allowed_netprobe_writers

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity    = array_distinct($file.principal.hostname)
    $artifact_path     = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
