/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:34:43.848691+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_Container_Resource_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of container and Kubernetes resources via cloud audit API calls. Adversaries performing container and resource discovery will issue LIST or GET requests against pods, nodes, deployments, namespaces, secrets, and similar Kubernetes resource types. A burst of such read-only API calls from a single principal is a strong indicator of reconnaissance activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Requires cloud control-plane audit logs with Kubernetes API server audit events normalised into Chronicle UDM. The log source must capture verb (list/get/watch), resource kind, and principal identity."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Kubernetes controllers, operators, and CI/CD pipelines that legitimately enumerate cluster resources at startup or during reconciliation loops. Monitoring agents (e.g. Prometheus, Datadog) that scrape cluster state. Authorised cluster administrators running kubectl get/describe commands."
    tuning_guidance = "Add known service-account principals and CI/CD runner identities to %allowed_k8s_discovery_principals. Add approved namespaces to %allowed_k8s_namespaces. Raise the threshold or narrow the resource_type filter if the environment runs many operators."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match Kubernetes API read verbs used for enumeration
    $cloud.metadata.product_event_type = /^(list|get|watch)$/ nocase

    // Target Kubernetes resource types commonly enumerated during discovery
    $cloud.target.resource.resource_type = /^(pods|nodes|deployments|replicasets|daemonsets|statefulsets|namespaces|services|endpoints|configmaps|secrets|serviceaccounts|roles|rolebindings|clusterroles|clusterrolebindings|persistentvolumes|persistentvolumeclaims|ingresses|networkpolicies|cronjobs|jobs)$/ nocase

    // Exclude well-known automated service accounts and system components
    not $cloud.principal.user.userid = /^system:(serviceaccount:kube-system:|node:|masters|anonymous)/ nocase

    // Exclude approved enumeration principals defined per-tenant
    not $cloud.principal.user.userid in %allowed_k8s_discovery_principals

    // Exclude approved namespaces where automated discovery is expected
    not $cloud.target.resource.name = /\/(kube-system|kube-public|kube-node-lease)\// nocase

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource_type = array_distinct($cloud.target.resource.resource_type)
    $api_verb = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
