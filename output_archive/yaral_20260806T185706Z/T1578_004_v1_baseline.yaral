/*
  MITRE Technique : T1578.004 - Revert Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:16:53.341993+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_004_Cloud_Instance_Revert_Snapshot_Restore {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud instance revert activity via snapshot restore or disk/volume restore operations through cloud management APIs. Adversaries may restore VM or storage snapshots to erase evidence of malicious activity and evade detection. Covers AWS RestoreSnapshotTier/RestoreImageFromRecycleBin, Azure disk/VM restore, and GCP restoreSnapshot-equivalent API calls normalized to UDM."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.004"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Revert Cloud Instance"
    log_prerequisites = "Requires cloud provider audit logs normalized to Chronicle UDM. AWS CloudTrail, Azure Activity Log, or GCP Cloud Audit Logs must be ingested. API-level resource operations must be captured."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized disaster recovery runbooks, scheduled backup restoration tests, DevOps CI/CD pipeline teardown and restore workflows, cloud operations teams performing routine maintenance restores."
    tuning_guidance = "Add known automation service accounts and authorized DR principals to %cloud_allowed_restore_principals. Add approved resource projects or subscriptions to %cloud_allowed_restore_resource_namespaces. Narrow severity based on whether the restoring identity is human vs. service account."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match snapshot restore, disk restore, image restore, or instance revert
    // API operation names normalized into target.resource.name or metadata.description
    // Covers patterns across AWS (RestoreSnapshot, RestoreImageFromRecycleBin),
    // Azure (Microsoft.Compute/disks/write from snapshot, restorePoints/apply),
    // and GCP (compute.disks.createSnapshot restore / compute.instances.reset equivalents)
    (
      $cloud.target.resource.name = /restore/ nocase or
      $cloud.target.resource.name = /revert/ nocase or
      $cloud.target.resource.name = /snapshot/ nocase
    )

    // Restrict to compute or storage resource types to avoid matching unrelated restores
    (
      $cloud.target.resource.resource_type = /instance/ nocase or
      $cloud.target.resource.resource_type = /disk/ nocase or
      $cloud.target.resource.resource_type = /volume/ nocase or
      $cloud.target.resource.resource_type = /snapshot/ nocase or
      $cloud.target.resource.resource_type = /image/ nocase or
      $cloud.target.resource.resource_type = /vm/ nocase
    )

    // Require an authenticated principal - anonymous restores are extremely anomalous
    $cloud.principal.user.userid != ""

    // Exclude known authorized restore automation accounts and namespaces
    not $cloud.principal.user.userid in %cloud_allowed_restore_principals
    not $cloud.target.resource.name in %cloud_allowed_restore_resource_namespaces

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1578.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $acting_user = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $target_resource_type = array_distinct($cloud.target.resource.resource_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
