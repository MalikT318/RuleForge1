/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:28:03.020450+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Weaken_Encryption_Plaintext_Mgmt_Traffic {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network connections to management-plane ports (Telnet, HTTP, SNMP v1/v2c, FTP, TFTP, rsh, rlogin) on network devices from external or unexpected sources. Adversaries who weaken or disable encryption on network devices often cause management traffic to revert to cleartext protocols. Observing cleartext management-plane traffic to or from a network device is a high-fidelity indicator that encryption has been weakened or bypassed (T1600)."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs that capture destination port and protocol. Connections to management ports (23, 80, 21, 69, 161, 162, 513, 514) on internal network device management subnets must be visible."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Legacy monitoring systems using SNMPv1/v2c, authorized Telnet-based network management tools, TFTP-based firmware distribution systems, scheduled FTP backups of device configs. Validate against %allowed_cleartext_mgmt_sources."
    tuning_guidance = "Populate %allowed_cleartext_mgmt_sources with known-good management station IPs or subnets. Populate %network_device_mgmt_subnets with the IP ranges assigned to network device management interfaces. Raise severity to Critical if the source is external (non-RFC1918)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target must be a known network device management subnet
    $net.target.ip in %network_device_mgmt_subnets

    // Cleartext or weakly-authenticated management-plane protocols:
    // 21=FTP, 23=Telnet, 69=TFTP, 80=HTTP (mgmt), 161=SNMP, 162=SNMP trap,
    // 513=rlogin, 514=rsh
    (
        $net.target.port = 23   or   // Telnet
        $net.target.port = 21   or   // FTP
        $net.target.port = 69   or   // TFTP (UDP)
        $net.target.port = 80   or   // HTTP management plane
        $net.target.port = 161  or   // SNMP v1/v2c (UDP)
        $net.target.port = 162  or   // SNMP trap
        $net.target.port = 513  or   // rlogin
        $net.target.port = 514        // rsh
    )

    // Exclude known-good authorized management sources
    not $net.principal.ip in %allowed_cleartext_mgmt_sources

    // Exclude RFC1918 internal management jump hosts that are pre-approved
    // (handled via reference list above; this catches external sources explicitly)
    not $net.principal.ip in %rfc1918_internal

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity    = array_distinct($net.target.ip)
    $cleartext_port    = array_distinct($net.target.port)
    $source_ip         = array_distinct($net.principal.ip)

  condition:
    $net
}
