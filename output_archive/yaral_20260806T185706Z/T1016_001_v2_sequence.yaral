/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:26:06.289920+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_InternetConnCheck_LoginAfterDiscovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Medium"
    description     = "Detects a pattern where an identity-provider authentication event is followed by a second login from the same user within a short window, consistent with an adversary validating external connectivity via authentication probing before establishing C2. This rule targets identity-provider telemetry and is additive to existing process-launch command-line detections for T1016.001."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires identity provider sign-in logs normalised to UDM USER_LOGIN events. Both events must carry principal.user.userid and metadata.event_timestamp."
    platform        = "Windows"
    log_source      = "identity"
    false_positives = "Legitimate users authenticating from multiple devices or applications in quick succession, SSO token refresh flows, MFA step-up challenges, automated service accounts performing health checks."
    tuning_guidance = "Add known service-account userids to %global_allowed_service_accounts. Add approved application names to %global_allowed_sso_apps. Raise the risk score if the second login originates from a different country or IP range than the first."

  events:
    // First authentication event - initial sign-in
    $auth1.metadata.event_type = "USER_LOGIN"
    $auth1.principal.user.userid != ""
    not $auth1.principal.user.userid in %global_allowed_service_accounts
    $auth1.principal.user.userid = $userid

    // Second authentication event - rapid follow-on login from same user
    // Models the pattern of an adversary re-authenticating after confirming
    // external connectivity, or a compromised credential being exercised
    // against a second resource to validate reachability
    $auth2.metadata.event_type = "USER_LOGIN"
    $auth2.principal.user.userid = $userid
    not $auth2.principal.user.userid in %global_allowed_service_accounts

    // Enforce chronological ordering: first login precedes second login
    $auth1.metadata.event_timestamp.seconds < $auth2.metadata.event_timestamp.seconds

    // Require the two logins to target distinct resources or applications
    // to avoid matching a single SSO redirect counted twice
    $auth1.target.resource.name != $auth2.target.resource.name

  match:
    $userid over 10m

  outcome:
    $risk_score          = max(55)
    $mitre_technique_id  = array_distinct("T1016.001")
    $primary_entity      = array_distinct($userid)
    $first_target        = array_distinct($auth1.target.resource.name)
    $second_target       = array_distinct($auth2.target.resource.name)
    $login_count         = count($auth2.metadata.event_timestamp.seconds)

  condition:
    $auth1 and $auth2
}
