/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:49:20.531511+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Suspicious_Package_Manager_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects package manager invocations (pip, npm, yarn, nuget, gem, cargo) that install packages from suspicious sources, use typosquatting-prone flags, or exhibit characteristics consistent with supply chain compromise. Targets the core OS mechanism: a package manager child process launched with install/add commands combined with suspicious arguments such as --index-url overrides, --extra-index-url, pre-release flags, or execution from unusual parent processes such as CI runners, scripting engines, or Office applications."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1). Command-line logging must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate developer workflows installing packages from private registries, internal PyPI/npm mirrors, or pre-release channels. CI/CD pipelines using custom index URLs for internal artifact repositories."
    tuning_guidance = "Add known-good parent process paths (e.g., approved CI runner executables) to %global_allowed_package_manager_parents. Add approved custom index URL patterns to %global_allowed_package_index_urls. Consider scoping to non-developer workstations first."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target: package manager executables on Windows
    $proc.target.process.file.full_path = /\\(pip|pip3|npm|yarn|nuget|gem|cargo|conda|poetry|pipenv)\.exe$/ nocase

    // Must be an install/add/download operation - not list, show, search
    $proc.target.process.command_line = /(install|add|download|get|fetch|update|upgrade)/ nocase

    // Suspicious indicators: custom index URL override (common in dependency confusion attacks),
    // pre-release flags (used to serve malicious pre-release packages),
    // or --extra-index-url (fallback to attacker-controlled registry)
    $proc.target.process.command_line = /(--index-url|--extra-index-url|--pre\b|--allow-unverified|--trusted-host|--registry\s+http:|\/\/[^/]+\.[^/]+\/simple|file:\/\/)/ nocase

    // Suspicious parent processes: scripting engines, Office apps, browsers,
    // or other non-developer tooling spawning a package manager
    $proc.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|winword|excel|powerpnt|msaccess|outlook|iexplore|chrome|msedge|firefox|msiexec|wmic|certutil)\.exe$/ nocase

    // Exclude known-good parent processes (approved CI runners, IDEs, build tools)
    not $proc.principal.process.file.full_path in %global_allowed_package_manager_parents

    // Exclude known-good custom index configurations
    not $proc.target.process.command_line in %global_allowed_package_index_urls

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $package_manager_cmd = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
