/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:12:35.586544+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Remote_Service_Session_Hijacking {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects RDP session hijacking via tscon.exe, which allows an attacker to take over an existing disconnected RDP session without credentials. Adversaries commonly invoke tscon.exe directly or via a service/scheduled task to redirect a session to their own session ID, a core OS mechanism for T1563.002."
    mitre_tactic    = "Lateral Movement"
    mitre_technique = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 capturing full command-line arguments. Windows Security Event 4688 with command-line auditing enabled is also sufficient."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate IT administrators using tscon.exe for session management, remote support tooling (e.g., helpdesk software that programmatically reconnects sessions), and automated kiosk or VDI session management scripts."
    tuning_guidance = "Add known-good parent process paths (e.g., approved helpdesk agent executables) to %global_allowed_tscon_parents. Scope by hostname or user group if tscon usage is expected in specific VDI environments. Consider raising severity if the parent process is cmd.exe, powershell.exe, or a service host rather than an interactive management console."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target process must be tscon.exe - the built-in Windows session connector
    $proc.target.process.file.full_path = /\\tscon\.exe$/ nocase

    // Command line must reference a numeric session ID (tscon <ID> /dest:<session>)
    // This distinguishes active hijacking invocations from bare help/query calls
    $proc.target.process.command_line = /tscon(\.exe)?\s+[0-9]+/ nocase

    // High-fidelity signal: session redirect to a named destination session
    // OR invocation via a service context (SYSTEM-level parent) which is the
    // canonical no-credential hijack path documented in MITRE T1563.002
    (
      $proc.target.process.command_line = /\/dest:/ nocase
      or
      $proc.principal.process.file.full_path = /\\services\.exe$/ nocase
      or
      $proc.principal.process.file.full_path = /\\cmd\.exe$/ nocase
      or
      $proc.principal.process.file.full_path = /\\powershell\.exe$/ nocase
      or
      $proc.principal.process.file.full_path = /\\pwsh\.exe$/ nocase
    )

    // Exclude known-good administrative parent processes
    not $proc.principal.process.file.full_path in %global_allowed_tscon_parents

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $initiating_process = array_distinct($proc.principal.process.file.full_path)
    $command_line      = array_distinct($proc.target.process.command_line)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
