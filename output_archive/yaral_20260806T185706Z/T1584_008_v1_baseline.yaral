/*
  MITRE Technique : T1584.008 - Network Devices
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:21:51.851628+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_008_Compromised_Network_Device_Relay {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects inbound connections from external IPs on management ports commonly associated with network device exploitation (SSH, Telnet, SNMP, HTTP/S management, NETCONF, TR-069). Adversaries compromise SOHO and edge network devices to use them as proxy infrastructure or payload-hosting nodes. A high volume of inbound connections from a single external source to these ports may indicate a compromised device being used as a relay or staging host."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.008"
    mitre_technique_name = "Compromise Infrastructure: Network Devices"
    log_prerequisites = "Requires perimeter firewall or network flow logs with inbound connection visibility including source IP, destination port, and connection state."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate remote management by authorized administrators, ISP provisioning via TR-069, authorized VPN concentrators, network monitoring systems performing reachability checks."
    tuning_guidance = "Populate %allowed_mgmt_source_ips with authorized management source ranges (jump hosts, NOC ranges, ISP provisioning servers). Populate %internal_address_space to exclude RFC1918 sources. Adjust the target port list if your environment uses non-standard management ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Inbound connection from an external (non-internal) source
    not $net.principal.ip in %internal_address_space
    not $net.principal.ip in %allowed_mgmt_source_ips

    // Target ports associated with network device management planes:
    // 22=SSH, 23=Telnet, 161=SNMP, 162=SNMP trap, 443=HTTPS mgmt,
    // 80=HTTP mgmt, 830=NETCONF/SSH, 8080=alt HTTP mgmt,
    // 7547=TR-069 (CWMP), 8443=alt HTTPS mgmt, 8888=alt mgmt
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 80 or
      $net.target.port = 161 or
      $net.target.port = 162 or
      $net.target.port = 443 or
      $net.target.port = 830 or
      $net.target.port = 7547 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 8888
    )

    // Exclude connections destined for known internal space
    // (rule targets perimeter-facing assets, not internal pivots)
    not $net.target.ip in %internal_address_space

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1584.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
