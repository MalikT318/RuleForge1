/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:06:35.482726+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_Embedded_Payload_Exfil_Network_Anomaly {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable behaviour consistent with embedded-payload delivery or staging on macOS: large outbound transfers over uncommon high ports or protocol-port mismatches that are characteristic of payload retrieval or exfiltration. Attackers embedding payloads in benign files (T1027.009) frequently retrieve or stage those files via non-standard channels to evade content inspection on well-known ports. Detected at the firewall/perimeter layer, providing coverage orthogonal to endpoint process-creation rules."
    mitre_tactic         = "Defense Evasion"
    mitre_technique      = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites    = "Requires perimeter firewall or proxy flow logs normalised into Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION events with bytes_sent/received, destination port, and IP fields populated."
    platform             = "macOS"
    log_source           = "firewall"
    false_positives      = "Legitimate software update services using non-standard ports, CDN traffic on high ports (QUIC/HTTP3), large media uploads, developer tooling (Xcode, Homebrew) fetching large archives, VPN concentrators."
    tuning_guidance      = "Add known-good high-port destinations to %firewall_allowed_highport_destinations. Add internal RFC-1918 and corporate egress ranges to %rfc1918_internal. Raise the bytes threshold if large legitimate transfers are common in the environment. Narrow the port range if specific high ports are approved for business use."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Destination must be external (not RFC-1918 / internal)
    not $net.target.ip in %rfc1918_internal

    // High-numbered ephemeral or non-standard ports commonly abused for
    // payload staging: avoid well-known service ports (80, 443, 22, 25, 53)
    // Focus on ports above 1024 that are not standard application ports
    $net.target.port > 1024
    not $net.target.port = 8080
    not $net.target.port = 8443
    not $net.target.port = 3389

    // Large outbound byte count is a strong signal for payload staging or
    // embedded-file retrieval; threshold set to 5 MB to reduce noise while
    // catching meaningful transfers
    $net.network.sent_bytes > 5242880

    // Exclude known-good high-port destinations maintained per-client
    not $net.target.ip in %firewall_allowed_highport_destinations

    // Exclude approved internal egress proxies / jump hosts
    not $net.principal.ip in %approved_egress_proxies

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)
    $bytes_out         = max($net.network.sent_bytes)

  condition:
    $net
}
