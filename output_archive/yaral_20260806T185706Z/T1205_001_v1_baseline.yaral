/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:51:17.448426+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Port_Knocking_Sequence_Detection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential port knocking sequences observable at the firewall perimeter: a single source IP making rapid, sequential connection attempts to multiple distinct closed/rejected ports in a short window. This pattern is the network-observable signature of port knocking used to trigger a hidden listener for persistence or C2. Firewall logs record rejected/dropped connections; a burst of such attempts across varied ports from one external source is the primary behavioral signal."
    mitre_tactic = "Defense Evasion, Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Requires perimeter firewall or stateful packet inspection logs with per-connection records including source IP, destination port, and connection disposition (denied/dropped/rejected). Each attempted connection must be logged as a discrete event."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Misconfigured clients repeatedly probing services, vulnerability scanners, port scanners (Nmap, Masscan), penetration testing activity, misconfigured load balancer health checks hitting wrong ports."
    tuning_guidance = "Add known scanner IPs and authorized pen-test source ranges to %allowed_scanner_sources. Add internal RFC-1918 and trusted partner ranges to %trusted_internal_ranges to suppress internal noise. Raise the port diversity threshold or tighten the time window if scanner false positives persist. Consider correlating with a subsequent NETWORK_CONNECTION allow event from the same source to increase fidelity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Connection must have been denied or dropped - the hallmark of knocking on closed ports.
    // security_result.action_details captures firewall disposition strings across vendors.
    $net.security_result.action_details = /deny|drop|reject|block|refused|reset/ nocase

    // Source must be an external (non-trusted) address - exclude internal and known-safe ranges.
    not $net.principal.ip in %trusted_internal_ranges
    not $net.principal.ip in %allowed_scanner_sources

    // Destination port must be in a range consistent with knocking sequences.
    // Port knocking typically uses ports outside well-known service ranges or
    // deliberately targets high/ephemeral ports to avoid collateral noise.
    // We exclude port 0 (malformed) and focus on ports above 1024 to reduce
    // noise from routine service probes on well-known ports, while still
    // catching high-port knocking sequences.
    $net.target.port > 1024
    $net.target.port < 65535

    // Exclude ports commonly probed by legitimate scanners and health checks
    // to reduce scanner false positives on very common service ports.
    not $net.target.port = 3389
    not $net.target.port = 8080
    not $net.target.port = 8443

    // Protocol: port knocking is most commonly TCP (SYN-based) or UDP.
    // ICMP-based knocking is rarer; TCP/UDP covers the dominant implementations.
    $net.network.ip_protocol = /TCP|UDP/ nocase

    // Capture the source IP as the grouping entity for threshold correlation
    // and outcome reporting.
    $net.principal.ip = $src_ip

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($src_ip)
    $targeted_ports = array_distinct($net.target.port)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $protocol_observed = array_distinct($net.network.ip_protocol)

  condition:
    $net
}
