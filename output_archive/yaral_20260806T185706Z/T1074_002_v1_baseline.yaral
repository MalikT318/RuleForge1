/*
  MITRE Technique : T1074.002 - Remote Data Staging
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:39:24.729982+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_002_Remote_Data_Staging_Windows {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects remote data staging activity on Windows where a process copies or moves files into a central staging directory. Adversaries aggregate data from multiple systems into a single location prior to exfiltration, minimising C2 connections and evading detection. This rule targets the use of native Windows copy utilities writing into common staging paths such as temp directories, recycle bin, or user-created collection folders."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.002"
    mitre_technique_name = "Data Staged: Remote Data Staging"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (Process Create) with command-line logging enabled. Target process command lines must be captured."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup agents, software deployment tools (SCCM, Ansible), IT admin scripts performing legitimate bulk file operations, robocopy jobs for DR replication."
    tuning_guidance = "Add known backup or deployment parent process paths to %global_allowed_staging_parents. Add approved staging destination path patterns to %global_allowed_staging_paths. Consider narrowing by time-of-day or user context if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target native Windows copy/move utilities or scripting engines performing bulk file operations
    $proc.target.process.file.full_path = /\\(cmd\.exe|robocopy\.exe|xcopy\.exe|copy\.exe|powershell\.exe|pwsh\.exe|wscript\.exe|cscript\.exe)$/ nocase

    // Command line must reference a copy, move, or recursive collection operation
    $proc.target.process.command_line = /(\/s|\/e|\/mir|\/move|\-recurse|\-r\b|xcopy|robocopy|\bcopy\b|\bmove\b|\bcp\b|\bmv\b)/ nocase

    // Destination must match a suspicious staging path pattern:
    // temp directories, recycle bin, hidden root-level folders, or paths with staging/collect/exfil/dump/loot/archive keywords
    $proc.target.process.command_line = /(\\temp\\|\\tmp\\|\\\$recycle\.bin\\|\\windows\\temp\\|\\programdata\\|\\appdata\\local\\temp\\|staging|collect|exfil|dump|loot|archive|gather)/ nocase

    // Exclude known-good parent processes (backup agents, deployment tools)
    not $proc.principal.process.file.full_path in %global_allowed_staging_parents

    // Exclude known-good destination path patterns
    not $proc.target.process.command_line in %global_allowed_staging_paths

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1074.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $staging_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
