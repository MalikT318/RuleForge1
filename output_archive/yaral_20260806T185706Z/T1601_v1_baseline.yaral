/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:28:50.108242+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Network_Device_Image_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects network connections indicative of firmware or OS image transfer to/from a network device via management-plane protocols (TFTP, FTP, SCP, HTTP/S). Adversaries targeting T1601 must stage or exfiltrate the monolithic OS image file; the transfer itself is the highest-fidelity behavioral signal available from IDS/IPS telemetry."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM. The appliance must inspect management-plane traffic and generate flow or connection records for TFTP (UDP/69), FTP (TCP/20-21), SCP/SSH (TCP/22), and HTTP/S (TCP/80,443,8080,8443). Deep-packet inspection or protocol anomaly detection should be enabled."
    platform        = "Network Devices"
    log_source      = "ips"
    false_positives = "Authorized firmware upgrade windows initiated by network operations teams; automated configuration backup jobs using TFTP or SCP; vendor-managed device lifecycle tooling; jump-host initiated SCP sessions during change windows."
    tuning_guidance = "Populate %approved_mgmt_sources with the IP ranges of authorized management stations, jump hosts, and automation servers. Populate %approved_firmware_destinations with known firmware repositories. Restrict detections to out-of-window transfers by correlating with a change-window reference list if available."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match management-plane file-transfer protocols used to stage or retrieve OS images:
    // TFTP=69, FTP-data=20, FTP-control=21, SSH/SCP=22, HTTP=80, HTTPS=443, alt-HTTP=8080, alt-HTTPS=8443
    (
      $net.target.port = 69   or
      $net.target.port = 20   or
      $net.target.port = 21   or
      $net.target.port = 22   or
      $net.target.port = 80   or
      $net.target.port = 443  or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )

    // Require meaningful data volume - OS images are large (commonly tens to hundreds of MB).
    // A threshold of 5 MB (5,242,880 bytes) filters trivial keepalives and small config pulls.
    $net.network.sent_bytes > 5242880

    // Exclude transfers originating from approved management sources.
    not $net.principal.ip in %approved_mgmt_sources

    // Exclude transfers destined for approved firmware repositories.
    not $net.target.ip in %approved_firmware_destinations

  outcome:
    $risk_score        = max(88)
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = max($net.target.port)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
