/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:08:39.333610+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_ESXi_Host_Binary_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects modification of critical ESXi host software binaries in system directories. Adversaries may replace or patch legitimate ESXi binaries (e.g., SSH daemon, busybox utilities, hostd components) to establish persistent backdoor access or credential harvesting. This rule fires on file-write events targeting known ESXi system binary paths outside of expected patch/update processes."
    mitre_tactic    = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "Requires ESXi shell/hostd file activity telemetry normalised into Chronicle UDM FILE_MODIFICATION events. Syslog forwarding from ESXi hosts with shell audit enabled, or an EDR agent capable of monitoring ESXi file writes (e.g., VMware Carbon Black, Tanium on ESXi)."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Legitimate VMware patch bundles applied via esxcli or VUM/vLCM; authorised third-party VIB installations; vendor-supplied driver updates. These should originate from known update orchestration processes and can be excluded via reference list."
    tuning_guidance = "Add authorised patch management process names (e.g., esxcli, esxupdate, vibmgr) to %esxi_allowed_patch_processes. Add approved maintenance hostnames to %esxi_patch_maintenance_hosts. Narrow the binary path regex if only specific subsystems are in scope."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target must be a critical ESXi system binary directory
    // Covers: core binaries, sshd, busybox applets, hostd, vpxa, PAM modules,
    // Python/Perl interpreters used by management plane, and VIB staging paths
    $file.target.file.full_path = /^\/(bin|sbin|usr\/bin|usr\/sbin|usr\/lib\/vmware|usr\/lib64\/vmware|lib\/security|etc\/vmware|etc\/ssh|opt\/vmware\/bin|opt\/vmware\/sbin)\// nocase

    // Exclude known-safe file extensions that are not executable binaries
    // (logs, temp swap files, pid files, lock files)
    not $file.target.file.full_path = /\.(log|tmp|swp|pid|lock|bak)$/ nocase

    // The writing process must NOT be a recognised patch or update utility
    not $file.principal.process.file.full_path in %esxi_allowed_patch_processes

    // Exclude hosts undergoing authorised maintenance windows
    not $file.principal.hostname in %esxi_patch_maintenance_hosts

  outcome:
    $risk_score       = max(90)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity   = array_distinct($file.principal.hostname)
    $modified_binary  = array_distinct($file.target.file.full_path)
    $writing_process  = array_distinct($file.principal.process.file.full_path)
    $acting_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
