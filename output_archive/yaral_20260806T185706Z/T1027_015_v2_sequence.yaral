/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:10:51.981654+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Compressed_Payload_Written_To_Registry {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage fileless compression attack: a compression-capable process (PowerShell, certutil, expand, makecab, or similar) launches and is shortly followed by a registry value write that stores a suspiciously large binary blob. This pattern matches adversaries who compress shellcode or payloads in-memory and then persist them in the registry for later in-memory execution, avoiding disk-based file writes."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires EDR or Sysmon process telemetry (PROCESS_LAUNCH) and registry telemetry (REGISTRY_MODIFICATION or REGISTRY_CREATION). Both event types must be normalised into UDM and ingested from the same endpoint."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software deployment agents writing compressed update blobs to the registry; RMM tools; legitimate PowerShell DSC configurations; antivirus product self-updates; Windows Installer caching compressed payloads."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_compression_parents. Add known-good registry key prefixes to %global_allowed_registry_blob_keys. Raise the risk score threshold if the registry key falls under HKLM\\SOFTWARE\\Microsoft or other well-known vendor paths."

  events:
    // Stage 1: a compression-capable or encoding-capable process launches
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|certutil|expand|makecab|compact|wscript|cscript|mshta|bitsadmin)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_compression_parents
    $proc.principal.hostname = $hostname

    // Stage 2: a registry value is written on the same host within the window
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    // Target suspicious persistence or staging locations
    $reg.target.registry.registry_key = /HKLM\\(SOFTWARE|SYSTEM)\\|HKCU\\(SOFTWARE|Environment|Volatile Environment)/ nocase
    // Exclude well-known benign high-volume keys to prevent Cartesian explosion
    not $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\(Run|Explorer|Installer|Uninstall)/ nocase
    not $reg.target.registry.registry_key in %global_allowed_registry_blob_keys
    $reg.principal.hostname = $hostname

    // Chronological ordering: process launch precedes registry write
    $proc.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1027.015")
    $primary_entity      = array_distinct($hostname)
    $compression_process = array_distinct($proc.target.process.file.full_path)
    $parent_process      = array_distinct($proc.principal.process.file.full_path)
    $registry_keys_written = array_distinct($reg.target.registry.registry_key)
    $registry_value_names  = array_distinct($reg.target.registry.registry_value_name)
    $actor_userid          = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $reg
}
