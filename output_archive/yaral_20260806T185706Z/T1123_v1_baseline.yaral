/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:42:55.012273+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_001_Container_Audio_Capture_Process {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects execution of audio capture utilities inside a container or Kubernetes pod. Adversaries may abuse microphone-access tools (arecord, sox, ffmpeg, parecord, parec, alsarecord) within a container to capture audio from the host audio subsystem, particularly when the container is privileged or has /dev/snd mounted. Audio capture inside a container is almost never legitimate and is a strong signal of collection activity."
    mitre_tactic    = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires container runtime process telemetry normalised into Chronicle UDM PROCESS_LAUNCH events. The runtime must report the container/pod context and the full command line of spawned processes."
    platform        = "Linux"
    log_source      = "container"
    false_positives = "Automated audio testing pipelines, CI/CD jobs that validate audio hardware, multimedia processing containers with explicit business justification."
    tuning_guidance = "Add approved container image names or pod namespaces to %allowed_audio_capture_containers. Scope exclusions narrowly to specific namespaces rather than broad image patterns to avoid suppressing genuine threats."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match known Linux audio capture binaries by process name or full path.
    // Regex covers: arecord, sox, ffmpeg, parecord, parec, alsarecord, aplay (record mode), gst-launch variants.
    // nocase handles any case variation in container image entrypoints.
    (
      $proc.target.process.file.full_path = /\/(arecord|parec|parecord|alsarecord|sox|ffmpeg|ffprobe|gst-launch(-1\.0)?|aplay)$/ nocase
      or
      $proc.target.process.command_line = /(arecord|parec|parecord|alsarecord|sox|ffmpeg|gst-launch)/ nocase
    )

    // Audio capture flags: writing to a file, specifying a device, or piping raw audio.
    // arecord: -f, -r, -c, -d flags; sox: -t raw/wav; ffmpeg: -f alsa / -f pulse; parecord: --file-format
    (
      $proc.target.process.command_line = /(\-f\s+(alsa|pulse|s16le|wav|raw|avfoundation)|--file-format|\/dev\/snd|plughw:|hw:|pulse:)/ nocase
      or
      $proc.target.process.command_line = /\.(wav|raw|pcm|ogg|flac|mp3|aac)\b/ nocase
    )

    // Restrict to container context: principal process is a container runtime shim,
    // init, or shell that is characteristic of container workloads.
    (
      $proc.principal.process.file.full_path = /\/(containerd-shim|runc|crun|docker-init|tini|dumb-init|sh|bash|dash|python[23]?|node|ruby|perl)$/ nocase
      or
      $proc.principal.hostname = /^(pod|container|k8s)-/ nocase
    )

    // Exclude approved audio capture workloads identified by image or namespace context.
    not $proc.target.process.command_line in %allowed_audio_capture_containers

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $audio_command     = array_distinct($proc.target.process.command_line)
    $spawning_process  = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
