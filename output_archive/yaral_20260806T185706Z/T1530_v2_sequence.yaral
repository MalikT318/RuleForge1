/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:33:01.937436+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_002_Cloud_Storage_Bulk_Access_After_Login_Anomaly {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a pattern where a user authenticates to a cloud service and then performs a high volume of cloud storage object access events within a short window. This is consistent with adversarial enumeration or bulk exfiltration of data from cloud storage (e.g., S3, Azure Blob, GCS, OneDrive, Google Drive) via direct API calls rather than a front-end interface. The rule joins a login event to subsequent bulk resource access events on the same user identity."
    mitre_tactic    = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Requires cloud provider or SaaS platform audit logs normalised into Chronicle UDM. USER_LOGIN events must populate principal.user.userid. USER_RESOURCE_ACCESS events must populate principal.user.userid and target.resource.name or target.url. Both event types must be present for the same user identity."
    platform        = "SaaS"
    log_source      = "cloud_audit"
    false_positives = "Automated backup agents, data pipeline service accounts, bulk migration jobs, BI/analytics tools performing scheduled exports, and legitimate power users performing large downloads. Exclude known service account identities via %cloud_storage_allowed_service_accounts."
    tuning_guidance = "Lower the threshold count in the condition if the environment has strict data-access baselines. Add known automation service account userids to %cloud_storage_allowed_service_accounts. Add known internal storage resource name prefixes to %cloud_storage_allowed_resource_prefixes to suppress sanctioned bulk-access patterns."

  events:
    // Event 1: User login to the cloud/SaaS platform
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %cloud_storage_allowed_service_accounts
    $auth.principal.user.userid = $userid

    // Event 2: Bulk cloud storage object access following the login
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid = $userid
    not $access.principal.user.userid in %cloud_storage_allowed_service_accounts
    // Target must reference a storage object path (bucket, blob, drive file, etc.)
    $access.target.resource.name = /\.(pdf|docx?|xlsx?|pptx?|csv|json|zip|tar|gz|sql|bak|key|pem|env|conf|config|log)$/ nocase
    not $access.target.resource.name in %cloud_storage_allowed_resource_prefixes

    // Chronological ordering: login must precede the access events
    $auth.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $userid over 1h

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1530")
    $primary_entity      = array_distinct($userid)
    $accessed_resources  = array_distinct($access.target.resource.name)
    $access_event_count  = count($access.metadata.event_timestamp.seconds)
    $auth_event_time     = min($auth.metadata.event_timestamp.seconds)

  condition:
    $auth and #access >= 50
}
