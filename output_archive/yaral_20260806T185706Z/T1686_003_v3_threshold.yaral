/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T18:58:39.287257+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Rule_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of Windows firewall modification commands within a short window. Individual firewall changes are common; a high volume from a single host in 10 minutes is anomalous and consistent with an adversary systematically disabling or reconfiguring host firewall protections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Windows Host Firewall"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to PROCESS_LAUNCH UDM events. Command-line arguments must be captured."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment agents applying group policy firewall baselines, RMM tools performing bulk firewall configuration, security hardening scripts run by IT operations, and Windows Defender ATP remediation actions."
    tuning_guidance = "Add known-good parent processes (e.g., deployment agents, RMM service executables) to %global_allowed_firewall_admin_parents. Raise the threshold count if the environment has frequent legitimate bulk firewall changes. Consider scoping to non-server hosts if server hardening scripts trigger frequently."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match netsh advfirewall or PowerShell firewall cmdlets
    (
      (
        $proc.target.process.file.full_path = /\\netsh\.exe$/ nocase
        and $proc.target.process.command_line = /advfirewall/ nocase
        and (
          $proc.target.process.command_line = /set\s+(allprofiles|domainprofile|privateprofile|publicprofile)/ nocase
          or $proc.target.process.command_line = /firewall\s+(add|delete|set)\s+rule/ nocase
        )
      )
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and (
          $proc.target.process.command_line = /Set-NetFirewallProfile/ nocase
          or $proc.target.process.command_line = /New-NetFirewallRule/ nocase
          or $proc.target.process.command_line = /Remove-NetFirewallRule/ nocase
          or $proc.target.process.command_line = /Set-NetFirewallRule/ nocase
          or $proc.target.process.command_line = /Disable-NetFirewallRule/ nocase
        )
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_firewall_admin_parents

    $proc.principal.hostname = $hostname

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(
      if($proc.target.process.command_line = /state\s+off/ nocase, 90,
      if($proc.target.process.command_line = /disable/ nocase, 85,
      75))
    )
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $firewall_commands_observed = count($proc.metadata.id)
    $distinct_cmdlines = array_distinct($proc.target.process.command_line)
    $distinct_users = array_distinct($proc.principal.user.userid)
    $initiating_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 5
}
