/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:33:46.734470+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_001_Suspicious_Container_Deployment {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deployment of a new container or pod via cloud control-plane audit logs. Adversaries may deploy containers to execute malicious payloads, bypass network controls, or escape to the host node. This rule fires on container/pod creation events originating from unexpected or non-automated identities, particularly those creating privileged or unrestricted workloads."
    mitre_tactic = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires cloud provider audit logs (e.g. Kubernetes API server audit, GCP Audit Logs, AWS CloudTrail, Azure Activity Log) normalised into Chronicle UDM. Container/pod creation events must be present as RESOURCE_CREATION with target.resource.type and target.resource.name populated."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines, deployment automation, cluster autoscalers, Helm chart releases, and authorised DevOps engineers deploying workloads. Kubernetes controllers (e.g. ReplicaSet controller, DaemonSet controller) will generate high volumes of expected pod creation events."
    tuning_guidance = "Add known CI/CD service account principals to %allowed_container_deployers. Add approved namespaces to %allowed_k8s_namespaces. Consider raising severity if the deploying identity is interactive (human user) rather than a service account, or if the target namespace is kube-system."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target a container or pod resource type - normalised UDM resource type field
    $cloud.target.resource.resource_type = /pod|container|deployment|daemonset|replicaset|statefulset|job|cronjob/ nocase

    // The API method or operation must reflect a create/run/start action
    $cloud.target.resource.attribute.labels["operation"] = /create|run|start|apply/ nocase

    // Capture the principal (identity performing the deployment)
    $cloud.principal.user.userid = $deployer

    // Exclude well-known Kubernetes internal controllers that legitimately create pods
    not $cloud.principal.user.userid = /^system:serviceaccount:kube-system:/ nocase
    not $cloud.principal.user.userid = /^system:controller:/ nocase

    // Exclude known automated deployers defined in a customer-managed reference list
    not $cloud.principal.user.userid in %allowed_container_deployers

    // Exclude approved namespaces where routine deployments are expected
    not $cloud.target.resource.attribute.labels["namespace"] in %allowed_k8s_namespaces

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_name = array_distinct($cloud.target.resource.name)
    $resource_type = array_distinct($cloud.target.resource.resource_type)
    $target_namespace = array_distinct($cloud.target.resource.attribute.labels["namespace"])
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
