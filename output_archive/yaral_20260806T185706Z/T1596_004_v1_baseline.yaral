/*
  MITRE Technique : T1596.004 - CDNs
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:25:30.352702+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_004_CDN_Reconnaissance_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects potential CDN reconnaissance activity observed at the network perimeter. Adversaries enumerate CDN infrastructure by issuing rapid sequences of HTTP requests probing CDN-specific headers, edge node paths, cache-control directives, and origin-bypass techniques. This rule fires on a single HTTP request that combines CDN-probing URI patterns with suspicious header manipulation indicative of origin-server discovery or cache-poisoning reconnaissance."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.004"
    mitre_technique_name = "Search Open Technical Databases: CDNs"
    log_prerequisites = "Requires perimeter firewall or reverse-proxy HTTP logs normalised into Chronicle UDM NETWORK_HTTP events. Fields required: network.http.request_url, network.http.user_agent, network.http.method, target.hostname, principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate CDN health-check agents, synthetic monitoring tools, penetration testers operating under authorised scope, and CDN vendor diagnostic crawlers."
    tuning_guidance = "Add known monitoring and synthetic-check source IPs to %cdn_recon_allowed_sources. Add authorised scanner user-agent strings to %cdn_recon_allowed_agents. Raise the risk score if the source IP also appears in threat-intel feeds."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"

    // Source must not be an internally trusted scanner
    not $http.principal.ip in %cdn_recon_allowed_sources

    // Target must not be an internal address range (RFC-1918 / loopback excluded via list)
    not $http.target.ip in %rfc1918_internal

    // Probe patterns: CDN-specific URI paths, cache-bypass query strings,
    // or origin-server direct-access attempts.
    // Matches: /__cdn-cgi/, /cdn-probe, /cdn-check, /origin/, /edge/,
    //          query params like ?nocache=, ?bypass=, ?purge=, ?debug=cdn
    (
      $http.network.http.request_url = /\/__cdn[-_]cgi\// nocase
      or
      $http.network.http.request_url = /\/cdn[-_](probe|check|health|status|debug|test)/ nocase
      or
      $http.network.http.request_url = /\/origin\// nocase
      or
      $http.network.http.request_url = /\/edge\// nocase
      or
      $http.network.http.request_url = /[?&](nocache|bypass|purge|cdn[-_]debug|x[-_]cache[-_]bypass|no[-_]cache)=/ nocase
      or
      $http.network.http.request_url = /\/wp-content\/uploads\/.*\.(env|config|conf|bak|sql|json)$/ nocase
    )

    // Suspicious user-agent strings associated with recon tooling or
    // absent/minimal agents (curl, wget, python, go-http, empty)
    (
      $http.network.http.user_agent = /(curl|wget|python-requests|go-http-client|libwww|masscan|zgrab|nuclei|httpx|ffuf|dirsearch|gobuster|wfuzz|nikto|scrapy)/ nocase
      or
      $http.network.http.user_agent = /^-?$/ nocase
    )

    // Exclude known authorised monitoring agents
    not $http.network.http.user_agent in %cdn_recon_allowed_agents

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1596.004")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_host = array_distinct($http.target.hostname)
    $probed_url = array_distinct($http.network.http.request_url)
    $user_agent_observed = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
