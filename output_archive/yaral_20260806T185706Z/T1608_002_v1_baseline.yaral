/*
  MITRE Technique : T1608.002 - Upload Tool
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:32:05.161720+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_002_Staged_Tool_Download_DNS_Indicators {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects DNS queries that exhibit characteristics consistent with adversary-staged tool delivery infrastructure: queries for high-entropy hostnames under code-hosting or PaaS platforms, abnormally long subdomain labels, or rare TXT/NULL record types that may indicate C2 or tool-staging beaconing. T1608.002 adversaries frequently host tools on GitHub, Heroku, Azure App Service, or attacker-controlled servers and rely on DNS resolution as the first observable step before ingress tool transfer."
    mitre_tactic         = "Resource Development"
    mitre_technique      = "T1608.002"
    mitre_technique_name = "Stage Capabilities: Upload Tool"
    log_prerequisites    = "Requires DNS query/resolver logs forwarded to Chronicle UDM as NETWORK_DNS events. Fields required: network.dns.questions.name, network.dns.questions.type, principal.hostname or principal.ip."
    platform             = "PRE"
    log_source           = "dns"
    false_positives      = "Legitimate use of Heroku, GitHub Pages, Azure App Service, or other PaaS platforms by developers; CDN edge nodes with long hostnames; internal tooling that resolves high-entropy subdomains for load balancing."
    tuning_guidance      = "Add known-good PaaS hostnames and internal resolver IPs to %dns_allowed_paas_domains and %dns_trusted_resolvers. Raise the subdomain length threshold or restrict to specific record types (TXT, NULL) to reduce noise. Consider correlating with subsequent NETWORK_HTTP events to the same destination."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Exclude queries from trusted internal resolvers / known-good infrastructure
    not $dns.principal.ip in %dns_trusted_resolvers
    not $dns.network.dns.questions.name in %dns_allowed_paas_domains

    // Detection branch 1: Suspicious record types (TXT or NULL) often used for
    // C2 beaconing or tool-staging callbacks. DNS type 16 = TXT, type 10 = NULL.
    (
      $dns.network.dns.questions.type = 16 or
      $dns.network.dns.questions.type = 10
    )

    // Detection branch 2: Queries targeting known PaaS / code-hosting platforms
    // that adversaries abuse to stage tools, combined with a high-entropy or
    // unusually long leftmost subdomain label (>= 20 chars before the first dot),
    // which is atypical for legitimate app names.
    // The regex matches: <20+ char label>.<paas-platform-tld>
    $dns.network.dns.questions.name = /^[a-z0-9\-]{20,}\.(herokuapp\.com|azurewebsites\.net|github\.io|gitlab\.io|workers\.dev|pages\.dev|onrender\.com|fly\.dev|vercel\.app|netlify\.app|s3\.amazonaws\.com|blob\.core\.windows\.net)/ nocase

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1608.002")
    $primary_entity    = array_distinct($dns.principal.ip)
    $queried_domain    = array_distinct($dns.network.dns.questions.name)
    $dns_record_type   = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
