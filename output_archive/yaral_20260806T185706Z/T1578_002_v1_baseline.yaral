/*
  MITRE Technique : T1578.002 - Create Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:16:18.011077+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_002_Cloud_Instance_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new cloud compute instance or virtual machine via cloud provider audit logs. Adversaries may create new instances to evade existing firewall rules, security policies, or monitoring controls applied to existing instances, or to mount snapshots of existing volumes in a less-restricted context."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.002"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Cloud Instance"
    log_prerequisites = "Requires cloud provider control-plane audit logs normalised into Chronicle UDM (e.g. AWS CloudTrail RunInstances, Azure Activity Microsoft.Compute/virtualMachines/write, GCP Audit compute.instances.insert)."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate auto-scaling events, infrastructure-as-code pipelines (Terraform, CloudFormation, Deployment Manager), CI/CD build agents, authorized administrator provisioning."
    tuning_guidance = "Populate %cloud_allowed_instance_creators with service account principals and IAM roles used by approved automation pipelines. Populate %cloud_allowed_instance_regions with approved deployment regions to suppress expected provisioning. Consider raising severity when the creating principal has no prior instance-creation history or when the target region is outside the organisation baseline."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Match normalised API operation names for compute instance creation across
    // AWS (RunInstances), Azure (virtualMachines/write), and GCP (instances.insert).
    // Chronicle UDM normalises the vendor-specific API call into
    // target.resource.attribute.labels or metadata.product_event_type.
    // We match on the resource type to stay vendor-portable.
    $cloud.target.resource.resource_type = /instance|virtual.?machine|vm/ nocase

    // Require an authenticated human or service principal identity
    $cloud.principal.user.userid != ""

    // Exclude known-good automation principals and service accounts
    not $cloud.principal.user.userid in %cloud_allowed_instance_creators

    // Exclude expected deployment regions (populated per-client)
    not $cloud.target.cloud.availability_zone in %cloud_allowed_instance_regions

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1578.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource_name = array_distinct($cloud.target.resource.name)
    $target_region = array_distinct($cloud.target.cloud.availability_zone)
    $target_project = array_distinct($cloud.target.resource.attribute.labels.value)

  condition:
    $cloud
}
