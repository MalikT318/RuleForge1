/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:34:10.737261+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_001_Container_Escape_To_Host {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects container escape to host via privileged execution patterns: processes running inside a container context that invoke host-level OS mechanisms such as nsenter, unshare, or mount with dangerous flags, or that access the host filesystem through /proc/1/root or /host mount points. These are the primary behavioral signals for T1611 on Linux."
    mitre_tactic    = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with command-line arguments. Auditd rules should capture execve syscalls. EDR must record parent/child process lineage and full command lines."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate container orchestration agents (kubelet, containerd-shim) using nsenter for debugging; system administrators using nsenter/unshare for namespace management; Docker Desktop health checks; privileged init containers in Kubernetes."
    tuning_guidance = "Add known orchestration agent paths to %container_allowed_ns_tools. Add approved parent process paths (e.g. kubelet, containerd-shim) to %container_allowed_parents. Scope by principal.hostname if certain nodes are known privileged admin hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the core binaries and syscall wrappers used to escape namespaces
    // or pivot to the host filesystem from within a container.
    // nsenter: enters host namespaces directly
    // unshare: creates/escapes user/mount/pid namespaces
    // mount: bind-mounting host paths into container or re-mounting /proc
    // chroot: pivoting into /proc/1/root or a host bind-mount
    (
      $proc.target.process.file.full_path = /\/(s?bin|usr\/(s?bin|local\/(s?bin)))\/nsenter$/ nocase
      or
      $proc.target.process.file.full_path = /\/(s?bin|usr\/(s?bin|local\/(s?bin)))\/unshare$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(s?bin|usr\/(s?bin|local\/(s?bin)))\/mount$/ nocase
        and
        (
          $proc.target.process.command_line = /--bind/ nocase
          or
          $proc.target.process.command_line = /\/proc\/[0-9]+\/root/ nocase
          or
          $proc.target.process.command_line = /\/host\b/ nocase
          or
          $proc.target.process.command_line = /\/var\/lib\/docker/ nocase
        )
      )
      or
      (
        $proc.target.process.file.full_path = /\/(s?bin|usr\/(s?bin|local\/(s?bin)))\/chroot$/ nocase
        and
        (
          $proc.target.process.command_line = /\/proc\/[0-9]+\/root/ nocase
          or
          $proc.target.process.command_line = /\/host\b/ nocase
        )
      )
    )

    // High-confidence host-escape argument patterns for nsenter and unshare
    // nsenter -t 1 targets PID 1 (the host init process)
    // unshare --mount-proc or -r (--map-root-user) are escape primitives
    (
      $proc.target.process.command_line = /\-t\s*1\b/ nocase
      or
      $proc.target.process.command_line = /\-\-target\s+1\b/ nocase
      or
      $proc.target.process.command_line = /\-\-mount\-proc/ nocase
      or
      $proc.target.process.command_line = /\-r\b/ nocase
      or
      $proc.target.process.command_line = /\-\-map\-root\-user/ nocase
      or
      $proc.target.process.command_line = /\/proc\/1\/root/ nocase
      or
      $proc.target.process.command_line = /\/proc\/1\/ns\// nocase
      or
      $proc.target.process.command_line = /\-\-all\b/ nocase
    )

    // Exclude known-safe orchestration parents
    not $proc.principal.process.file.full_path in %container_allowed_parents

    // Exclude known-safe admin tool invocations
    not $proc.target.process.file.full_path in %container_allowed_ns_tools

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $escaped_command   = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
