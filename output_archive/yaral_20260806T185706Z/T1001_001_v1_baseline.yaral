/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:33:43.577317+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_Junk_Data_C2_Obfuscation_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes on Linux that exhibit behavioral indicators of junk-data C2 obfuscation: a scripting interpreter or network utility launching with command-line arguments that combine base64/encoding operations with high-entropy padding patterns, random data generation, or explicit noise-injection flags. This targets the OS-level mechanism (process execution with obfuscated payload construction) rather than specific tool names or hashes."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with full command-line capture (execve syscall arguments). Auditd rule: -a always,exit -F arch=b64 -S execve."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate data-science or cryptography workloads using dd/openssl with random padding; backup scripts using base64 with noise for integrity checks; security testing tools; some CI/CD pipeline steps that encode artifacts."
    tuning_guidance = "Add known-good parent process paths to %linux_allowed_encoding_parents. Add known-good script paths to %linux_allowed_encoding_scripts. Narrow scope by adding a net connection check via a sequence rule if false-positive rate remains high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting runtimes and network-capable utilities commonly
    // weaponised for junk-data C2 — matched on binary name only so
    // renaming the wrapper does not evade (the interpreter itself is the
    // OS mechanism).
    $proc.target.process.file.full_path = /\/(python[23]?|perl|ruby|bash|sh|dash|zsh|curl|wget|socat|ncat|nc|openssl|php|lua[0-9.]*)$/ nocase

    // The command line must show BOTH an encoding/obfuscation operation
    // AND a random/padding data source — this conjunction is the
    // high-fidelity signal.

    // Encoding or obfuscation operation present
    $proc.target.process.command_line = /(base64|b64encode|b64decode|binascii|codecs\.encode|pack\(|unpack\(|xxd|hexlify|urlencode|percent.encod|rot13|zlib|gzip|bz2|lzma)/ nocase

    // Random / junk / padding data generation present in the same invocation
    $proc.target.process.command_line = /(\/dev\/urandom|\/dev\/random|os\.urandom|random\.randint|rand\(|RAND_bytes|openssl rand|dd\s+if=\/dev\/(u?random)|secrets\.|uuid\.uuid|junk|padding|noise|filler|garbage|dummy_data|dummy_bytes|null_bytes|\\x00\s*\*|b\\x[0-9a-f]{2}\s*\*\s*[0-9]+)/ nocase

    // Exclude processes whose parent is a known-safe administrative tool
    not $proc.principal.process.file.full_path in %linux_allowed_encoding_parents

    // Exclude known-safe script paths (e.g. /usr/lib/*, /opt/monitoring/*)
    not $proc.target.process.file.full_path in %linux_allowed_encoding_scripts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $target_binary     = array_distinct($proc.target.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
