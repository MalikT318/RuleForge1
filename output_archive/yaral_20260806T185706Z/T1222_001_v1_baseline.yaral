/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:54:32.788497+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_Windows_Permission_Modification_Tools {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects use of built-in Windows permission modification utilities (icacls, cacls, takeown, attrib) with arguments indicative of granting broad access, removing restrictions, or taking ownership of files and directories. Adversaries abuse these tools to bypass DACLs and access protected resources."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires EDR process telemetry or Windows Security Event 4688 with command-line auditing enabled, or Sysmon Event ID 1."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "System administrators performing legitimate permission remediation, software installers adjusting ACLs during setup, backup agents taking ownership of files, RMM tools performing maintenance tasks."
    tuning_guidance = "Add known-good parent processes (e.g., installer frameworks, RMM agents) to %global_allowed_permission_tool_parents. Add known-good target paths to %global_allowed_permission_target_paths. Scope by time-of-day or change-window if applicable."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the core Windows DACL/ownership modification binaries
    $proc.target.process.file.full_path = /\\(icacls|cacls|takeown|attrib)\.exe$/ nocase

    // Detect argument patterns that indicate permission widening or ownership seizure:
    // icacls/cacls: /grant, /grant:r, Everyone, /inheritance:r (remove inheritance), /reset
    // takeown: /f (force take ownership)
    // attrib: -r (remove read-only), -s (remove system), -h (remove hidden)
    (
      $proc.target.process.command_line = /\/grant/ nocase or
      $proc.target.process.command_line = /everyone/  nocase or
      $proc.target.process.command_line = /\/inheritance:[rd]/ nocase or
      $proc.target.process.command_line = /\/reset/ nocase or
      $proc.target.process.command_line = /\/f\s/ nocase or
      $proc.target.process.command_line = /\-[rsh]/ nocase or
      $proc.target.process.command_line = /full\s*control/ nocase or
      $proc.target.process.command_line = /\/t\s/ nocase
    )

    // Exclude known-good parent processes (e.g., trusted installers, RMM agents)
    not $proc.principal.process.file.full_path in %global_allowed_permission_tool_parents

    // Exclude known-good target paths (e.g., sanctioned software directories)
    not $proc.target.process.command_line in %global_allowed_permission_target_paths

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $tool_used = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
