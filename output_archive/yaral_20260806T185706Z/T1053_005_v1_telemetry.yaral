/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:15:55.993218+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Scheduled_Task_XML_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of XML task definition files in the Windows Task Scheduler store directories. Adversaries creating scheduled tasks via schtasks, COM API, WMI, PowerShell New-ScheduledTask, or direct file writes all produce a .job or XML artifact under the Tasks directory. This rule targets the resulting file artifact rather than the command line, providing coverage against evasion of process-creation logging."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event). The sensor must monitor writes to the Windows Task Scheduler store paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers, RMM agents, Windows Update, Group Policy, and administrative scripts that create scheduled tasks as part of normal operation. Volume is expected to be low outside of software deployment windows."
    tuning_guidance = "Populate %global_allowed_task_writers with full paths of known-good parent processes (e.g. msiexec.exe, trustedinstaller.exe, deployment agent binaries). Add known-good task name patterns to %global_allowed_task_names if specific task names are consistently benign in your environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target the Windows Task Scheduler XML store and legacy .job store
    // Both paths are where the OS and tooling materialise task definitions
    (
      $file.target.file.full_path = /\\Windows\\System32\\Tasks\\/  nocase or
      $file.target.file.full_path = /\\Windows\\SysWOW64\\Tasks\\/ nocase or
      $file.target.file.full_path = /\\Windows\\Tasks\\.*\.job$/   nocase
    )

    // Restrict to task definition file extensions; XML is the modern format
    (
      $file.target.file.full_path = /\.(xml|job)$/  nocase or
      // Files written directly into the Tasks tree without extension are also valid task definitions
      $file.target.file.full_path = /\\Windows\\System32\\Tasks\\[^\\]+$/ nocase
    )

    // Exclude writes originating from known-good administrative parent processes
    not $file.principal.process.file.full_path in %global_allowed_task_writers

    // Exclude known-good task name patterns (populated per-client)
    not $file.target.file.full_path in %global_allowed_task_names

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $task_file_path = array_distinct($file.target.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
