/*
  MITRE Technique : T1606 - Forge Web Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:30:41.188712+00:00
  Reference       : https://attack.mitre.org/techniques/T1606
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_Forged_Web_Credentials_Impossible_Travel_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects authentication events bearing characteristics consistent with forged web credentials or tokens: successful logins where the authentication method is anomalous (e.g., token-based or federated assertion) combined with risk signals such as unfamiliar location, atypical user agent, or impossible travel indicators surfaced by the identity provider. Forged SAML assertions, stolen signing keys, or abused federation trust relationships typically produce logins that bypass MFA and originate from unexpected network locations."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606"
    mitre_technique_name = "Forge Web Credentials"
    log_prerequisites = "Requires identity provider sign-in audit logs normalized to UDM USER_LOGIN events. Entra ID Sign-In Logs, Okta System Log, or ADFS audit events. Fields required: security_result.detection_fields, network.http.user_agent, principal.ip, extensions.auth.auth_details, security_result.severity."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Legitimate federated SSO logins from new geographic regions during travel; service accounts using certificate-based or token authentication from cloud infrastructure; newly onboarded third-party SaaS integrations using delegated federation."
    tuning_guidance = "Add known federated service account userids to %global_allowed_federated_service_accounts. Add approved corporate egress IP ranges to %global_approved_egress_ips. Adjust the auth_details regex to match the specific federation protocol strings your IdP normalises into UDM."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Successful authentication - forged tokens produce valid sessions
    $auth.security_result.summary = /success|authenticated|sign.?in succeeded/ nocase

    // Token or federated assertion authentication - the primary mechanism for forged credentials
    // SAML assertions, OAuth tokens, and federation tokens are the artifacts adversaries forge
    (
      $auth.extensions.auth.auth_details = /saml|federation|token|assertion|oauth|oidc|kerberos.?s4u/ nocase
      or
      $auth.network.http.user_agent = /python|curl|wget|go-http|java|okhttp|axios|requests/ nocase
    )

    // MFA bypass or absence - forged tokens typically skip interactive MFA
    not $auth.extensions.auth.auth_details = /mfa|multifactor|otp|authenticator|push/ nocase

    // Risk signal: identity provider has flagged this login with elevated risk
    // Covers impossible travel, anonymous IP, malware-linked IP, unfamiliar location
    (
      $auth.security_result.severity = "HIGH"
      or
      $auth.security_result.severity = "CRITICAL"
      or
      $auth.security_result.detection_fields["riskLevelDuringSignIn"] = /high|medium/ nocase
      or
      $auth.security_result.detection_fields["riskEventTypes"] = /unfamiliarFeatures|anonymizedIPAddress|malwareLinkedIPAddress|impossibleTravel|tokenIssuerAnomaly/ nocase
    )

    // Exclude known approved federated service accounts
    not $auth.principal.user.userid in %global_allowed_federated_service_accounts

    // Exclude known approved egress IPs (corporate VPN, proxies)
    not $auth.principal.ip in %global_approved_egress_ips

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1606")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ip = array_distinct($auth.principal.ip)
    $auth_method = array_distinct($auth.extensions.auth.auth_details)
    $user_agent = array_distinct($auth.network.http.user_agent)
    $risk_level = array_distinct($auth.security_result.severity)

  condition:
    $auth
}
