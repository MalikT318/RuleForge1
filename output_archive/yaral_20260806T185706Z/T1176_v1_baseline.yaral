/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:47:34.040488+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Browser_Extension_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file creation of a browser or IDE extension manifest (manifest.json) written into a browser or IDE extension directory by an unexpected process. Adversaries install malicious extensions by dropping extension files directly into the application's extension profile directory, bypassing marketplace controls and achieving persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event). The creating process and target file path must be populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate browser or IDE updates writing extension files, enterprise software deployment agents (e.g., SCCM, Intune), developer workflows installing extensions from source, browser sync services."
    tuning_guidance = "Add known software deployment and browser update process paths to %global_allowed_extension_writers. Scope to specific user profile paths if enterprise-managed extension directories are known. Consider raising severity if the writing process is a scripting host (powershell.exe, wscript.exe, cscript.exe, mshta.exe)."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: manifest.json dropped inside a browser or IDE extension profile directory
    // Covers Chrome, Edge, Brave, Firefox (xpi staging), VSCode, and generic Chromium-family paths
    $file.target.file.full_path = /\\(Google\\Chrome|Microsoft\\Edge|BraveSoftware\\Brave-Browser|Chromium|Mozilla\\Firefox|Code\\User\\extensions|\.vscode\\extensions)\\.*\\manifest\.json$/ nocase

    // The writing process is NOT a known browser or IDE updater binary
    // Flags scripting hosts, document readers, archive tools, and other unexpected parents
    $file.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|msiexec|rundll32|regsvr32|certutil|bitsadmin|curl|wget|python|pythonw|node|wmic|explorer)\.exe$/ nocase

    // Exclude known-good extension management processes
    not $file.principal.process.file.full_path in %global_allowed_extension_writers

    // Exclude system and update service accounts performing legitimate installs
    not $file.principal.user.userid in %global_allowed_extension_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $extension_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
