/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:00:18.363765+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_ReflectionAmplification_CloudResourceAbuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud control-plane signals associated with reflection amplification attack staging: bulk creation or modification of network-facing resources (load balancers, DNS zones, UDP-capable firewall rules, open resolvers, NTP/memcached-style services) that an adversary may provision to act as amplifiers or to expose victim infrastructure. Focuses on the IaaS API actions that enable amplification infrastructure rather than the volumetric traffic itself, which is not visible in audit logs."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Cloud provider audit logs normalised to Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Log). Requires RESOURCE_CREATION events with target.resource.type and target.resource.name populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate DNS zone provisioning, load balancer deployments, CDN configuration, and network firewall rule changes by infrastructure-as-code pipelines or authorised network engineers."
    tuning_guidance = "Add approved service accounts and automation principals to %cloud_allowed_network_provisioning_principals. Add known-good resource name patterns to %cloud_allowed_network_resource_names. Narrow target.resource.type values to those observed in your environment."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target resource types associated with amplification-capable services:
    // DNS zones/resolvers, UDP load balancers, network firewall rules with
    // broad ingress, NTP or memcached-style managed services, anycast endpoints.
    (
      $cloud.target.resource.type = /dns/ nocase or
      $cloud.target.resource.type = /loadbalanc/ nocase or
      $cloud.target.resource.type = /firewall/ nocase or
      $cloud.target.resource.type = /network.*rule/ nocase or
      $cloud.target.resource.type = /security.*group/ nocase or
      $cloud.target.resource.type = /resolver/ nocase or
      $cloud.target.resource.type = /udp/ nocase or
      $cloud.target.resource.type = /ntp/ nocase or
      $cloud.target.resource.type = /memcach/ nocase or
      $cloud.target.resource.type = /elasticach/ nocase or
      $cloud.target.resource.type = /anycast/ nocase
    )

    // Resource name or description references amplification-relevant protocols
    // or open/public exposure keywords - broad ingress or open resolver signals.
    (
      $cloud.target.resource.name = /open/ nocase or
      $cloud.target.resource.name = /public/ nocase or
      $cloud.target.resource.name = /any/ nocase or
      $cloud.target.resource.name = /0\.0\.0\.0/ nocase or
      $cloud.target.resource.name = /udp/ nocase or
      $cloud.target.resource.name = /dns/ nocase or
      $cloud.target.resource.name = /ntp/ nocase or
      $cloud.target.resource.name = /amplif/ nocase or
      $cloud.target.resource.name = /reflect/ nocase
    )

    // Exclude known-good automation principals and resource names.
    not $cloud.principal.user.userid in %cloud_allowed_network_provisioning_principals
    not $cloud.target.resource.name in %cloud_allowed_network_resource_names

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_type = array_distinct($cloud.target.resource.type)
    $resource_name = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
