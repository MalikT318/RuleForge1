/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:17:50.817616+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_Linux_Autostart_File_Written {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation or modification in Linux boot/logon autostart locations: systemd unit directories, init.d, rc.local, cron directories, profile.d, and user-level autostart paths. Targets the resulting file artifact rather than the process command line, providing coverage that survives command-line obfuscation."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Package managers (apt, yum, dnf, rpm) installing or upgrading software; configuration management agents (Ansible, Puppet, Chef, Salt); container orchestration runtimes writing unit files; legitimate admin scripts deploying services."
    tuning_guidance = "Add trusted package-manager and CM-agent process paths to %linux_allowed_autostart_writers. Scope further by excluding known-good unit file name patterns via an additional reference list if noise remains high in a specific environment."

  events:
    $file.metadata.event_type = "FILE_CREATION" or
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Match writes to any recognised Linux autostart location
    (
      // Systemd system-wide unit directories
      $file.target.file.full_path = /^\/(etc|usr\/lib|lib|run)\/systemd\/system\// nocase or
      // Systemd user-level unit directories
      $file.target.file.full_path = /^\/etc\/systemd\/user\// nocase or
      $file.target.file.full_path = /^\/home\/[^\/]+\/\.config\/systemd\/user\// nocase or
      // SysV init scripts
      $file.target.file.full_path = /^\/etc\/init\.d\// nocase or
      // rc.local and rc*.d directories
      $file.target.file.full_path = /^\/etc\/rc(\d?\.d|_local|\.local)/ nocase or
      // Cron directories (system-wide)
      $file.target.file.full_path = /^\/etc\/cron\.(d|daily|hourly|weekly|monthly)\// nocase or
      $file.target.file.full_path = /^\/var\/spool\/cron\// nocase or
      // System-wide shell profile drop-ins
      $file.target.file.full_path = /^\/etc\/profile\.d\// nocase or
      $file.target.file.full_path = /^\/etc\/(bash\.bashrc|bashrc|profile|environment)$/ nocase or
      // User-level shell startup files (any home directory)
      $file.target.file.full_path = /^\/home\/[^\/]+\/\.(bashrc|bash_profile|bash_login|profile|zshrc|zprofile|zlogin|zshenv|kshrc|tcshrc|cshrc)$/ nocase or
      $file.target.file.full_path = /^\/root\/\.(bashrc|bash_profile|bash_login|profile|zshrc|zprofile|zlogin|zshenv)$/ nocase or
      // XDG autostart (desktop session persistence)
      $file.target.file.full_path = /^\/etc\/xdg\/autostart\// nocase or
      $file.target.file.full_path = /^\/home\/[^\/]+\/\.config\/autostart\// nocase or
      // ld.so preload (library injection persistence)
      $file.target.file.full_path = /^\/etc\/ld\.so\.(preload|conf)/ nocase or
      // PAM configuration (logon-time execution)
      $file.target.file.full_path = /^\/etc\/pam\.d\// nocase or
      // Kernel module auto-load configuration
      $file.target.file.full_path = /^\/etc\/modules(-load\.d\/|$)/ nocase or
      $file.target.file.full_path = /^\/etc\/modprobe\.d\// nocase
    )

    // Exclude trusted package managers and configuration management agents
    not $file.principal.process.file.full_path in %linux_allowed_autostart_writers

    // Exclude transient runtime paths written by the OS itself during boot
    not $file.principal.user.userid = "root" and
    $file.target.file.full_path = /^\/run\/systemd\// nocase

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity    = array_distinct($file.principal.hostname)
    $affected_file     = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $writing_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
