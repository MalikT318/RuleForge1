/*
  MITRE Technique : T1080 - Taint Shared Content
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:39:42.321044+00:00
  Reference       : https://attack.mitre.org/techniques/T1080
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1080_001_Taint_Shared_Content_LNK_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of .LNK shortcut files in network share paths or shared directories by processes that are not typical shell or explorer activity. This is a primary indicator of the T1080 directory share pivot technique where adversaries plant malicious shortcuts masquerading as legitimate directories to achieve lateral movement."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1080"
    mitre_technique_name = "Taint Shared Content"
    log_prerequisites = "Requires EDR file creation telemetry (Sysmon Event ID 11 or equivalent EDR file event). Must capture target.file.full_path and principal.process.file.full_path for file creation events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Explorer creating shortcuts to network shares, legitimate RMM tools deploying shortcuts, software deployment agents writing .LNK files to shared drives, Group Policy Preferences deploying shortcuts."
    tuning_guidance = "Add known-good deployment processes to %global_allowed_lnk_creators. Add approved share paths to %global_approved_share_paths. Scope by principal.hostname if noisy in environments with heavy software deployment."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a .LNK shortcut file
    $file.target.file.full_path = /\.lnk$/ nocase

    // File must be written to a UNC network share path or a mapped/shared directory
    // Matches \\server\share\ style UNC paths or common shared drive mount points
    (
      $file.target.file.full_path = /^\\\\/ nocase or
      $file.target.file.full_path = /\\(share|shares|shared|public|netlogon|sysvol|users|homes|data|files|documents|common|dept|department|team|groups?|projects?|collab|collaboration|transfer|drop|incoming|outgoing|upload|download)\\/i nocase
    )

    // Creating process is NOT a known legitimate shell or deployment process
    not $file.principal.process.file.full_path = /\\(explorer|msiexec|msi|setup|install|deploy|gpscript|gpsvc)\.exe$/ nocase

    // Exclude known-good LNK creators via reference list
    not $file.principal.process.file.full_path in %global_allowed_lnk_creators

    // Exclude approved share paths via reference list
    not $file.target.file.full_path in %global_approved_share_paths

    // Require a principal hostname to be present (filters out incomplete telemetry)
    $file.principal.hostname != ""

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1080")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $lnk_path = array_distinct($file.target.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
