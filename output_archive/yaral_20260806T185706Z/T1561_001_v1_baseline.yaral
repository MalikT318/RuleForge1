/*
  MITRE Technique : T1561.001 - Disk Content Wipe
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:11:50.285552+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_001_Disk_Content_Wipe_Windows {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects process launches consistent with direct disk content wiping on Windows. Covers native utilities (format, diskpart, cipher) invoked with destructive flags, as well as processes opening raw physical disk device paths (\\\\.\\ PhysicalDrive / \\\\.\\PHYSICALDRIVE) via command-line arguments. Disk Content Wipe (T1561.001) overwrites arbitrary disk sectors rather than individual files, making data irrecoverable through normal storage interfaces."
    mitre_tactic         = "Impact"
    mitre_technique      = "T1561.001"
    mitre_technique_name = "Disk Content Wipe"
    log_prerequisites    = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Authorized disk sanitisation by IT asset management tools, secure-erase utilities run by storage admins, cipher /w used for free-space wiping in approved workflows, diskpart used during OS imaging pipelines."
    tuning_guidance      = "Add authorised parent process paths (e.g. imaging agents, ITSM tools) to %global_allowed_disk_wipe_parents. Add approved host names running scheduled sanitisation to %global_disk_wipe_excluded_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Branch A – format.com with /fs or no interactive prompt (destructive invocation)
    // Branch B – diskpart scripted (silent wipe via script file)
    // Branch C – cipher /w (free-space overwrite, abused for sector wiping)
    // Branch D – any process referencing a raw physical disk device path in its command line
    (
      (
        $proc.target.process.file.full_path = /\\format\.com$/  nocase
        and (
          $proc.target.process.command_line = /\/p:/          nocase
          or $proc.target.process.command_line = /\/y/        nocase
        )
      )
      or
      (
        $proc.target.process.file.full_path = /\\diskpart\.exe$/ nocase
        and $proc.target.process.command_line = /\/s\s/          nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\cipher\.exe$/ nocase
        and $proc.target.process.command_line = /\/w:/          nocase
      )
      or
      // Raw device path access – any process passing \\.\PhysicalDriveN or
      // \\.\PHYSICALDRIVE on the command line indicates direct sector-level I/O
      $proc.target.process.command_line = /\\\\\.\\.*(PhysicalDrive|PHYSICALDRIVE|HarddiskVolume)/ nocase
    )

    // Exclude known-good parent processes (imaging agents, authorised admin tools)
    not $proc.principal.process.file.full_path in %global_allowed_disk_wipe_parents

    // Exclude authorised hosts running scheduled sanitisation workflows
    not $proc.principal.hostname in %global_disk_wipe_excluded_hosts

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1561.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_user     = array_distinct($proc.principal.user.userid)
    $wipe_command_line = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
