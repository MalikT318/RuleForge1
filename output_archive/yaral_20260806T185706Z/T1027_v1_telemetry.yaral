/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:00:02.906690+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Obfuscated_File_Written_Suspicious_Location {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of files with high-entropy or obfuscated-payload indicators (base64, packed, encoded blob extensions) in world-writable or staging directories on Linux. Targets the file artifact produced by obfuscation rather than the command line used to create it, providing coverage when command-line logging is absent or evaded."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised into Chronicle UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate package managers writing compressed archives to /tmp; backup agents staging encrypted blobs; container runtimes writing layer tarballs; developer toolchains (npm, pip, cargo) caching encoded artefacts."
    tuning_guidance = "Add trusted writer process paths to %linux_allowed_archive_writers. Add approved staging directories to %linux_allowed_staging_paths. Narrow the extension regex if specific archive types are authorised in your environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target world-writable, memory-backed, or common attacker staging paths
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/run\/user\/|\/var\/run\/|\/home\/[^\/]+\/(\.cache|\.config|\.local\/share|\.ssh)\/|\/opt\/|\/srv\/|\/usr\/local\/tmp\/)/ nocase

    // File extension or naming pattern consistent with encoded / packed payloads:
    // .b64  .enc  .dat  .bin  .blob  .pack  .gz  .bz2  .xz  .zst  .lz4
    // .tar  .tgz  .tbz2  .zip  .7z  .rar  .lzma  .lzo  .zlib  .aes
    // Also match files with no extension but a dot-prefixed (hidden) name
    $file.target.file.full_path = /(\.b64|\.enc|\.dat|\.bin|\.blob|\.pack|\.gz|\.bz2|\.xz|\.zst|\.lz4|\.tar|\.tgz|\.tbz2|\.zip|\.7z|\.rar|\.lzma|\.lzo|\.zlib|\.aes|\.pgp|\.gpg)$/ nocase

    // Exclude known-good writer processes (package managers, system agents)
    not $file.principal.process.file.full_path in %linux_allowed_archive_writers

    // Exclude approved staging paths populated per-client
    not $file.target.file.full_path in %linux_allowed_staging_paths

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_path      = array_distinct($file.target.file.full_path)
    $writer_process    = array_distinct($file.principal.process.file.full_path)
    $writer_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
