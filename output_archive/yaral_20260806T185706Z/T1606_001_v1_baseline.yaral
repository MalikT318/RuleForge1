/*
  MITRE Technique : T1606.001 - Web Cookies
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:31:00.770786+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_001_Forged_Web_Cookie_Generation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process command lines consistent with forged web cookie generation on Windows. Adversaries use scripting runtimes (PowerShell, Python, Node.js) or dedicated tools to craft signed or encrypted session cookies by supplying secret keys, private keys, or cryptographic seeds. This rule targets the combination of a scripting host invoking cookie/token construction patterns alongside key material references, which is the core OS-level behaviour for T1606.001 on Windows."
    mitre_tactic         = "Credential Access"
    mitre_technique      = "T1606.001"
    mitre_technique_name = "Forge Web Credentials: Web Cookies"
    log_prerequisites    = "Requires EDR process telemetry with full command-line capture, or Sysmon Event ID 1 with CommandLine logging enabled. PowerShell script-block logging (Event 4104) also surfaces this activity."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Legitimate web developers testing session cookie generation locally; CI/CD pipelines that sign tokens as part of automated testing; security tooling that validates cookie integrity."
    tuning_guidance      = "Add known developer or CI/CD process paths to %global_allowed_cookie_gen_processes. Narrow scope by adding parent process exclusions for approved build agents. Consider raising severity if the principal user is a service account."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Scripting runtimes commonly abused to forge cookies
    $proc.target.process.file.full_path = /\\(powershell|pwsh|python[0-9]*|node|wscript|cscript|mshta|ruby)\.exe$/ nocase

    // Cookie/token construction keywords in the command line
    // Matches patterns like: cookie, set-cookie, forge, sign, hmac, jwt, session_token
    $proc.target.process.command_line = /(cookie|set[\-_]cookie|forge|sign|hmac|jwt|session[\-_]token|auth[\-_]token|bearer)/ nocase

    // Presence of key material indicators alongside the above
    // Matches: secret, private_key, privatekey, signing_key, seed, passphrase, machinekey
    $proc.target.process.command_line = /(secret|private[\-_]?key|signing[\-_]?key|seed|passphrase|machine[\-_]?key|validationkey|decryptionkey)/ nocase

    // Exclude known-good administrative and developer tooling paths
    not $proc.principal.process.file.full_path in %global_allowed_cookie_gen_processes

    // Exclude common CI/CD and build agent parent processes by path pattern
    not $proc.principal.process.file.full_path = /\\(jenkins|bamboo|teamcity|gitlab[\-_]runner|azure[\-_]pipelines[\-_]agent)/ nocase

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1606.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_user     = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $spawning_process  = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
