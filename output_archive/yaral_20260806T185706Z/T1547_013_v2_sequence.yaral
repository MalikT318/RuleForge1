/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:24:04.304806+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_File_Then_Suspicious_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation or modification of an XDG Autostart .desktop file followed by execution of a process from a suspicious or world-writable path on the same host within 10 minutes. This two-stage correlation provides additive coverage beyond command-line matching by linking the file write event to the resulting process launch, indicating the autostart entry may have been triggered or tested by the adversary."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry (FILE_CREATION or FILE_MODIFICATION) and process-launch telemetry (PROCESS_LAUNCH) normalised into Chronicle UDM. Auditd rules must cover -w /etc/xdg/autostart -p wa and -w /home -p wa for .config/autostart paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate desktop application installers writing .desktop files (e.g., package managers, Snap/Flatpak post-install hooks). Developer workflows that test autostart entries from home directories. System administrators deploying kiosk or thin-client configurations."
    tuning_guidance = "Add trusted installer process paths to %xdg_allowed_writers (e.g., /usr/bin/dpkg, /usr/bin/rpm, /usr/bin/snap). Add approved execution paths to %xdg_allowed_exec_paths. Narrow the suspicious-path regex if /opt or /usr/local generate noise in your environment."

  events:
    // Leg 1: A .desktop file is written to an XDG Autostart directory
    $file.metadata.event_type = "FILE_CREATION" or $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/(etc\/xdg\/autostart|\.config\/autostart)\/.+\.desktop$/ nocase
    not $file.principal.process.file.full_path in %xdg_allowed_writers
    $file.principal.hostname = $hostname

    // Leg 2: A process launches from a suspicious or world-writable path on the same host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(^\/tmp\/|^\/var\/tmp\/|^\/dev\/shm\/|^\/run\/user\/|\/\.config\/|\/\.local\/share\/|\/\.cache\/)/ nocase
    not $proc.target.process.file.full_path in %xdg_allowed_exec_paths
    $proc.principal.hostname = $hostname

    // Chronological ordering: file write must precede the process launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $autostart_files_written = array_distinct($file.target.file.full_path)
    $suspicious_processes_launched = array_distinct($proc.target.process.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
