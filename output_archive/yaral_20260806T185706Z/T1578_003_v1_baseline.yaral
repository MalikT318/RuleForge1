/*
  MITRE Technique : T1578.003 - Delete Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:16:35.280797+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_003_Delete_Cloud_Instance {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of a cloud compute instance via cloud provider audit logs. Adversaries delete instances post-compromise to destroy forensic evidence and evade detection. Covers AWS TerminateInstances, Azure VM delete, and GCP instance delete operations as normalised into UDM RESOURCE_DELETION events."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.003"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Delete Cloud Instance"
    log_prerequisites = "Requires cloud provider audit logs ingested into Chronicle UDM: AWS CloudTrail (ec2:TerminateInstances), Azure Activity Log (Microsoft.Compute/virtualMachines/delete), or GCP Audit Log (compute.instances.delete). Events must normalise to RESOURCE_DELETION."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate autoscaling scale-in events, infrastructure-as-code teardown pipelines (Terraform destroy), CI/CD ephemeral build environments, scheduled cost-optimisation jobs, and authorised decommissioning workflows."
    tuning_guidance = "Populate %cloud_allowed_automation_principals with service account IDs and IAM roles used by autoscalers, IaC pipelines, and orchestration systems. Populate %cloud_allowed_instance_delete_users with approved admin identities. Consider adding a match block to correlate with a preceding CREATE event within a short window to flag create-then-delete evasion patterns."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"

    // Target resource must be a compute instance / virtual machine
    // Matches AWS instance IDs (i-*), Azure VM resource paths, GCP instance names
    (
      $cloud.target.resource.resource_type = "VIRTUAL_MACHINE" or
      $cloud.target.resource.resource_subtype = /instance/ nocase or
      $cloud.target.resource.name = /\/(instances|virtualMachines)\// nocase or
      $cloud.target.resource.name = /^i-[0-9a-f]{8,17}$/ nocase
    )

    // Actor must be a real user or non-expected automation principal
    $cloud.principal.user.userid != ""

    // Exclude known-good automation principals and approved admins
    not $cloud.principal.user.userid in %cloud_allowed_automation_principals
    not $cloud.principal.user.userid in %cloud_allowed_instance_delete_users

    // Capture key fields for outcome
    $cloud.principal.user.userid = $actor
    $cloud.target.resource.name = $instance_name

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1578.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $deleted_instance = array_distinct($instance_name)
    $actor_ip = array_distinct($cloud.principal.ip)
    $cloud_environment = array_distinct($cloud.target.resource.attribute.cloud.environment)
    $actor_user = array_distinct($actor)

  condition:
    $cloud
}
