/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Network Devices
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:14:06.553587+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_ScheduledTask_DNS_HighEntropy_NetworkDevice {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS queries from network devices exhibiting characteristics consistent with scheduled beaconing or C2 callbacks associated with scheduled task persistence: high-entropy domain labels, abnormal DNS record types (TXT/NULL), or excessively long subdomain chains. Network devices running scheduled malicious scripts often beacon out via DNS at regular intervals using algorithmically generated or encoded domain names."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053"
    mitre_technique_name = "Scheduled Task/Job"
    log_prerequisites = "Requires DNS query and resolver logs normalised into Chronicle UDM NETWORK_DNS events. Source IP must be attributed to a network device (router, switch, firewall, load balancer). Full query name and record type must be populated in network.dns.questions.name and network.dns.questions.type."
    platform = "Network Devices"
    log_source = "dns"
    false_positives = "Legitimate CDN or cloud services using long randomised subdomains (e.g. AWS S3 presigned URLs, Akamai edge nodes). Network monitoring agents performing automated health checks. Dynamic DNS clients on management interfaces. Vendor telemetry beacons using encoded hostnames."
    tuning_guidance = "Add known-good high-entropy domains and CDN apex domains to %dns_allowed_high_entropy_domains. Narrow the source IP scope to confirmed network device management subnets using a reference list %network_device_mgmt_subnets. Adjust the subdomain label length threshold regex if legitimate internal naming conventions trigger false positives."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Source must originate from a network device management plane address
    $dns.principal.ip in %network_device_mgmt_subnets

    // Exclude known-good domains from detection
    not $dns.network.dns.questions.name in %dns_allowed_high_entropy_domains

    (
      // Detect abnormal DNS record types used for C2 tunnelling or data exfiltration
      // TXT = 16, NULL = 10, ANY = 255
      $dns.network.dns.questions.type = 16 or
      $dns.network.dns.questions.type = 10 or
      $dns.network.dns.questions.type = 255 or

      // Detect excessively long subdomain labels indicative of DNS tunnelling or DGA
      // Labels exceeding 45 characters in the leftmost subdomain component
      $dns.network.dns.questions.name = /^[a-z0-9\-]{45,}\.[a-z0-9\-]+\.[a-z]{2,}$/ nocase or

      // Detect deeply nested subdomain chains (4+ labels) with encoded-looking segments
      // Pattern: multiple dot-separated segments where early labels look base32/base64 encoded
      $dns.network.dns.questions.name = /^[a-z0-9]{8,}\.[a-z0-9]{8,}\.[a-z0-9]{4,}\.[a-z0-9\-]+\.[a-z]{2,}$/ nocase or

      // Detect high-entropy hex or base32 encoded labels typical of DGA or beaconing
      $dns.network.dns.questions.name = /^[a-f0-9]{16,}\.[a-z0-9\-]+\.[a-z]{2,}$/ nocase or

      // Detect labels with mixed numeric-alpha patterns typical of algorithmically generated names
      $dns.network.dns.questions.name = /^[a-z]{1,3}[0-9]{4,}[a-z]{1,3}[0-9]{2,}\.[a-z0-9\-]+\.[a-z]{2,}$/ nocase
    )

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domain = array_distinct($dns.network.dns.questions.name)
    $dns_record_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
