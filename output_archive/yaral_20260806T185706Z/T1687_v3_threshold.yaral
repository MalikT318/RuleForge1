/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T18:59:42.986194+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_003_Security_Process_Termination_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of security-related process terminations from a single host within a short window. Individually, stopping a security service is often benign; repeated terminations of multiple distinct security processes within 10 minutes is a strong indicator of exploitation-driven defense impairment (T1687)."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 5 (process terminated) normalised to PROCESS_TERMINATION in UDM. Alternatively, PROCESS_LAUNCH events for taskkill/sc/net targeting security processes are captured."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Automated patch management or software update pipelines that restart security agents; RMM-driven agent upgrades; IT-initiated AV re-installation workflows."
    tuning_guidance = "Add authorised maintenance hosts to %global_allowed_maintenance_hosts and authorised service-management parent processes to %global_allowed_security_mgmt_parents. Raise the threshold count if the environment has frequent legitimate agent cycling."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match process-killing utilities commonly abused to stop security services
    $proc.target.process.file.full_path = /\\(taskkill|sc|net|net1|wmic|powershell|pwsh)\.exe$/ nocase

    // Command-line patterns that target security-related process or service names
    // Covers: taskkill /f / nocase <av/edr>.exe, sc stop <svc>, net stop <svc>, wmic process where ... delete
    $proc.target.process.command_line = /(taskkill|stop|delete|terminate|kill)/ nocase

    // Target must reference a security-related process or service keyword
    $proc.target.process.command_line = /(antivirus|defender|mssense|sense|csagent|csfalcon|sentinelone|cylance|carbonblack|cbdefense|symantec|sepmaster|mcafee|mfefire|mfemms|sophos|savservice|avast|avg|eset|ekrn|mbam|malwarebytes|crowdstrike|elastic|endpointprotection|fireeye|xagt|tanium|qualys|rapid7|tenable|nessus|splunk|sysmon|windefend|mpssvc|wscsvc|securityhealthservice|mssecflt)/ nocase

    // Exclude authorised maintenance hosts and management parent processes
    not $proc.principal.hostname in %global_allowed_maintenance_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_mgmt_parents

    $proc.principal.hostname = $hostname

  match:
    $hostname over 10m

  outcome:
    // Scale risk score based on volume - base 60, capped at 95
    $risk_score = max(
      if(count($proc.target.process.command_line) >= 8, 95,
      if(count($proc.target.process.command_line) >= 5, 80,
      60))
    )
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $killed_targets = array_distinct($proc.target.process.command_line)
    $killing_processes = array_distinct($proc.target.process.file.full_path)
    $event_count = count($proc.target.process.command_line)

  condition:
    // Require at least 4 distinct security-process kill attempts from the same host in 10 minutes
    #proc >= 4
}
