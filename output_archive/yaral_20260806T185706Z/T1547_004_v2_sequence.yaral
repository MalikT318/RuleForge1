/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:20:14.243457+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Registry_Then_Login_Sequence {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects modification of Winlogon helper registry keys (Notify, Userinit, Shell) followed by a user login on the same host within 10 minutes. This two-stage correlation provides higher-fidelity coverage than a registry-only alert by confirming the persistence mechanism is active at logon time."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 13/14) producing REGISTRY_MODIFICATION events, and Windows Security Event 4624 or equivalent EDR logon telemetry producing USER_LOGIN events. Both must be normalised into Chronicle UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Windows Updates patching Winlogon components, legitimate AV/EDR products registering notification packages, enterprise software deploying custom Userinit wrappers, domain GPO pushes that reset Shell or Userinit values."
    tuning_guidance = "Populate %winlogon_allowed_writers with full paths of known-good processes that legitimately touch these keys (e.g. Windows Update, software deployment agents). Populate %winlogon_allowed_values with approved DLL/EXE values for Userinit and Shell. Scope %winlogon_excluded_hosts for golden-image build systems."

  events:
    // --- Leg 1: Suspicious modification of a Winlogon helper registry key ---
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon$/ nocase
    $reg.target.registry.registry_value_name = /^(Notify|Userinit|Shell)$/ nocase

    // Exclude the canonical safe values for Userinit and Shell
    not $reg.target.registry.registry_value_data = /^(C:\\Windows\\system32\\userinit\.exe,?|explorer\.exe)$/ nocase

    // Exclude known-good writers (e.g. TrustedInstaller, Windows Update)
    not $reg.principal.process.file.full_path in %winlogon_allowed_writers

    // Exclude known-good value data (approved DLLs/EXEs)
    not $reg.target.registry.registry_value_data in %winlogon_allowed_values

    // Exclude known maintenance hosts
    not $reg.principal.hostname in %winlogon_excluded_hosts

    // Capture the join key
    $reg.principal.hostname = $hostname

    // --- Leg 2: A user login on the same host after the registry change ---
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname

    // Exclude machine/service accounts (dollar-sign suffix and common service SIDs)
    not $auth.principal.user.userid = /\$$/ nocase
    not $auth.principal.user.userid = /^(SYSTEM|LOCAL SERVICE|NETWORK SERVICE|DWM-\d+|UMFD-\d+)$/ nocase

    // Chronological ordering: registry write must precede the login
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1547.004")
    $primary_entity      = array_distinct($hostname)
    $modified_reg_key    = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $injected_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writing_process     = array_distinct($reg.principal.process.file.full_path)
    $logged_in_user      = array_distinct($auth.principal.user.userid)
    $login_count         = count($auth.metadata.event_timestamp.seconds)

  condition:
    $reg and $auth
}
