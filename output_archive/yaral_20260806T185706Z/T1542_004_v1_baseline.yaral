/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:05:42.224930+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_ROMMONkit_TFTP_Firmware_Transfer {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects TFTP traffic (UDP/69) traversing the perimeter that may indicate an unauthorized ROMMON firmware image being staged or transferred to a network device. Adversaries abuse TFTP to upload malicious ROMMON images to Cisco routers and switches, providing persistent, difficult-to-detect access. TFTP has no authentication and is rarely required across external boundaries."
    mitre_tactic    = "Persistence, Defense Evasion"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Requires perimeter firewall or flow telemetry that captures UDP/69 (TFTP) sessions, including source/destination IP and port. Inbound and outbound TFTP must be logged."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Legitimate TFTP-based provisioning systems (e.g., PXE boot infrastructure, authorized network device management platforms). Internal TFTP servers used for sanctioned firmware distribution may generate similar traffic if the firewall sees east-west flows."
    tuning_guidance = "Populate %approved_tftp_sources with the IP ranges of authorized firmware management servers. Populate %rfc1918_internal with all internal RFC-1918 ranges to suppress purely internal flows. If TFTP is never expected externally, set risk_score to 100 and remove the source exclusion."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %approved_tftp_sources

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
