/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:12:22.142974+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Smuggling_Download_Then_File_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects SVG smuggling on macOS by correlating a firewall-observed HTTP response delivering an SVG file (Content-Type image/svg or .svg URI) followed within 5 minutes by a new file creation in a user Downloads or temp directory on the same source IP. SVG files containing embedded scripts can silently drop payloads or redirect browsers; this rule catches the network-observable delivery leg paired with a subsequent file-drop signal from the same host."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires firewall or proxy logs normalised to Chronicle UDM NETWORK_HTTP with populated network.http.response_code, network.http.response_headers (or target.url), and principal.ip. Second event requires endpoint FILE_CREATION telemetry (EDR or macOS unified log) with target.file.full_path and principal.ip."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Legitimate SVG asset downloads from design tools (Figma, Sketch, Adobe XD), CDN-delivered SVG icons, browser-based SVG rendering for web apps, developer workflows fetching SVG sprites."
    tuning_guidance = "Populate %svg_smuggling_allowed_src_ips with known design-tool or CDN egress IPs. Populate %svg_smuggling_allowed_domains with approved asset hosts. Narrow $file event path regex if your EDR reports a different staging directory convention."

  events:
    // Leg 1: Firewall/proxy sees an HTTP response delivering an SVG resource
    $http.metadata.event_type = "NETWORK_HTTP"
    (
      $http.target.url = /\.svg(\?[^\s]*)?$/ nocase
      or
      $http.network.http.response_headers = /content-type\s*:\s*image\/svg/ nocase
    )
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.principal.ip in %svg_smuggling_allowed_src_ips
    not $http.target.hostname in %svg_smuggling_allowed_domains
    $http.principal.ip = $src_ip

    // Leg 2: Endpoint sees a new file created in a macOS user staging location
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/Users\/[^\/]+\/(Downloads|Library\/Caches|Library\/Application Support|\.Trash|Desktop)\// nocase
    (
      $file.target.file.full_path = /\.svg$/ nocase
      or
      $file.target.file.full_path = /\.html$/ nocase
      or
      $file.target.file.full_path = /\.zip$/ nocase
      or
      $file.target.file.full_path = /\.dmg$/ nocase
      or
      $file.target.file.full_path = /\.pkg$/ nocase
      or
      $file.target.file.full_path = /\.js$/ nocase
    )
    not $file.target.file.full_path in %svg_smuggling_allowed_file_paths
    $file.principal.ip = $src_ip

    // Chronological ordering: HTTP delivery precedes file drop
    $http.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score          = max(78)
    $mitre_technique_id  = array_distinct("T1027.017")
    $primary_entity      = array_distinct($src_ip)
    $svg_urls_observed   = array_distinct($http.target.url)
    $files_dropped       = array_distinct($file.target.file.full_path)
    $destination_hosts   = array_distinct($http.target.hostname)
    $http_response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http and $file
}
