/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:21:59.978602+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSASS_Driver_File_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation or modification of DLL/SYS artifacts inside the Windows System32 directory tree that are associated with LSA subsystem driver registration paths. Adversaries implementing T1547.008 must drop or overwrite a driver file that LSASS will load; detecting the resulting file artifact provides coverage that is orthogonal to process-creation / command-line rules and survives tool renaming."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires EDR or Sysmon file-creation/modification telemetry normalised into UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path and principal.process.file.full_path populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate Windows Update patching lsasrv.dll, msv1_0.dll, kerberos.dll, or other inbox LSA packages; third-party authentication providers (smart-card middleware, biometric drivers, VPN SSO shims) installing their LSA plug-in DLLs; AV/EDR kernel drivers dropped to System32\\drivers during product installation."
    tuning_guidance = "Populate %lsass_driver_allowed_writers with the full paths of known-good installer and update processes (e.g. TrustedInstaller, MsiExec, vendor-specific setup binaries). Populate %lsass_driver_allowed_filenames with the baseline set of inbox LSA DLL names present in your gold image so that Windows Update activity on those specific files is suppressed. Alert on any file not in the allowed-filename list regardless of writer."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a DLL or SYS binary inside the LSA-relevant System32 subtrees.
    // Covers: System32 root (lsasrv.dll, msv1_0.dll, kerberos.dll, etc.),
    //         System32\lsa\ (Security Package / Authentication Package DLLs),
    //         System32\drivers\ (kernel-mode LSA filter drivers).
    $file.target.file.full_path = /\\Windows\\System32\\(lsa\\|drivers\\)?[^\\]+\.(dll|sys)$/ nocase

    // The writing process must NOT be a known-good system updater.
    not $file.principal.process.file.full_path in %lsass_driver_allowed_writers

    // Exclude inbox LSA DLL names that are routinely patched by Windows Update.
    // Defenders should baseline their environment and extend this list.
    not $file.target.file.full_path = /\\(lsasrv|msv1_0|kerberos|wdigest|tspkg|livessp|cloudap|negoexts|pku2u|ntlmssp|schannel|credssp|samsrv|lsadb|lsapolicylookup|lsapolicy)\.dll$/ nocase

    // Exclude the Windows Update / CBS / DISM staging paths used during patching.
    not $file.target.file.full_path = /\\WinSxS\\/i nocase
    not $file.target.file.full_path = /\\CbsTemp\\/i nocase

    // Exclude files whose name is in the operator-maintained allowlist.
    not $file.target.file.full_path in %lsass_driver_allowed_filenames

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dropped_file      = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
