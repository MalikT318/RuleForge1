/*
  MITRE Technique : T1535 - Unused/Unsupported Cloud Regions
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:03:06.553740+00:00
  Reference       : https://attack.mitre.org/techniques/T1535
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1535_Resource_Creation_Unusual_Cloud_Region {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud resource creation events occurring in regions not typically used by the organization. Adversaries who compromise cloud management accounts may spin up compute, storage, or other resources in obscure or unsupported regions to evade monitoring and run workloads such as cryptomining undetected."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1535"
    mitre_technique_name = "Unused/Unsupported Cloud Regions"
    log_prerequisites = "Requires cloud provider audit logs normalized to Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). The target.location.country_or_region or target.cloud.availability_zone field must be populated by the UDM parser."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate expansion into new regions by cloud architects or DevOps teams, disaster recovery provisioning, compliance-driven region selection, or automated infrastructure-as-code pipelines deploying to new regions."
    tuning_guidance = "Populate %allowed_cloud_regions with the organization's approved region identifiers (e.g. us-east-1, eastus, us-central1). Add authorized automation service accounts to %allowed_cloud_automation_principals. Narrow the compute/storage API action regex to match only the resource types relevant to each client."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Match broad compute, storage, database, and container resource provisioning
    // API actions across AWS, Azure, and GCP as normalized into UDM
    $cloud.target.resource.attribute.labels["api_method_name"] = /^(run|create|insert|start|deploy|launch|provision)(instances?|vm|virtualmachine|cluster|bucket|disk|volume|function|container|database|instance|snapshot|image)/ nocase

    // The region where the resource is being created must be populated
    $cloud.target.location.country_or_region != ""

    // Exclude regions explicitly approved for this tenant
    not $cloud.target.location.country_or_region in %allowed_cloud_regions

    // Exclude known automation/pipeline service principals
    not $cloud.principal.user.userid in %allowed_cloud_automation_principals

    // Exclude known-safe resource types that legitimately span regions (e.g. global CDN)
    not $cloud.target.resource.resource_type in %allowed_global_resource_types

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1535")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $region_observed = array_distinct($cloud.target.location.country_or_region)
    $resource_name = array_distinct($cloud.target.resource.name)
    $api_action = array_distinct($cloud.target.resource.attribute.labels["api_method_name"])

  condition:
    $cloud
}
