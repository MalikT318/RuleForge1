/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:13:41.533241+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Suspicious_Critical_File_Modification_macOS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification or creation of critical macOS system and configuration files by unexpected processes, which may indicate data manipulation for persistence, integrity subversion, or impact. Targets writes to launchd plist directories, cron, sudoers, hosts file, and application support paths commonly abused to alter system behaviour."
    mitre_tactic = "Impact"
    mitre_technique = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites = "Requires macOS EDR telemetry with file event visibility (e.g., Jamf Protect, CrowdStrike Falcon, SentinelOne, or Endpoint Security Framework). FILE_CREATION and FILE_MODIFICATION events must be ingested into Chronicle UDM."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Software deployment tools (Jamf, Munki, Chef, Puppet), legitimate admin scripts, macOS software updates, developer tooling writing to Library paths, authorized configuration management."
    tuning_guidance = "Add trusted management process paths to %macos_allowed_config_writers. Add known-good parent process paths to %macos_allowed_admin_parents. Consider scoping by principal.user.userid to exclude known service accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target high-value macOS configuration and persistence paths
    (
      // LaunchDaemons and LaunchAgents - primary persistence and execution control
      $file.target.file.full_path = /^\/(Library\/LaunchDaemons|Library\/LaunchAgents|System\/Library\/LaunchDaemons|System\/Library\/LaunchAgents)\// nocase
      or
      // Per-user LaunchAgents
      $file.target.file.full_path = /^\/Users\/[^\/]+\/Library\/LaunchAgents\// nocase
      or
      // Sudoers and PAM configuration - privilege and auth manipulation
      $file.target.file.full_path = /^\/(etc\/sudoers|etc\/sudoers\.d\/|etc\/pam\.d\/)/ nocase
      or
      // Hosts file - DNS and network resolution manipulation
      $file.target.file.full_path = /^\/etc\/hosts$/ nocase
      or
      // Cron and periodic task directories
      $file.target.file.full_path = /^\/(etc\/cron|var\/at\/|private\/etc\/cron|private\/var\/at\/)/ nocase
      or
      // Shell profile and rc files for all users - command injection via shell init
      $file.target.file.full_path = /^\/Users\/[^\/]+\/(\.bash_profile|\.bashrc|\.zshrc|\.zprofile|\.profile|\.bash_login)$/ nocase
      or
      // System-wide shell profiles
      $file.target.file.full_path = /^\/(etc\/profile|etc\/zshrc|etc\/bashrc|private\/etc\/profile|private\/etc\/zshrc)$/ nocase
      or
      // Application support and preferences that control app behaviour
      $file.target.file.full_path = /^\/Users\/[^\/]+\/Library\/(Application Support|Preferences)\/.+\.(plist|json|db|sqlite)$/ nocase
      or
      // Login items and startup configuration
      $file.target.file.full_path = /^\/Users\/[^\/]+\/Library\/Application Support\/com\.apple\.backgroundtaskmanagementagent/ nocase
    )

    // Exclude known legitimate system writers and management tooling
    not $file.principal.process.file.full_path in %macos_allowed_config_writers

    // Exclude Apple system processes writing to their own paths
    not $file.principal.process.file.full_path = /^\/(usr\/bin\/sw_update|System\/Library\/CoreServices|usr\/sbin\/softwareupdate)/ nocase

    // Exclude known macOS package management and update paths
    not $file.principal.process.file.full_path = /^\/(usr\/local\/bin\/(brew|chef|puppet)|opt\/homebrew\/)/ nocase

    // Exclude root-owned management agents by parent path
    not $file.principal.process.file.full_path in %macos_allowed_admin_parents

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
