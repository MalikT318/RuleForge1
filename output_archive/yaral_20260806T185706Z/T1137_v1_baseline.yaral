/*
  MITRE Technique : T1137 - Office Application Startup
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:46:08.797857+00:00
  Reference       : https://attack.mitre.org/techniques/T1137
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_Office_Startup_Persistence_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications to Office application startup locations commonly abused for persistence, including add-in registration paths, trusted template locations, and Outlook home page/form settings. Adversaries write to these keys to load malicious code each time an Office application starts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137"
    mitre_technique_name = "Office Application Startup"
    log_prerequisites = "Requires EDR registry telemetry or Sysmon Event ID 13 (RegistryValueSet) covering HKCU and HKLM Office hives."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate Office add-in installations, enterprise software deployment agents (e.g., SCCM, Intune), Office update processes, and IT-managed Outlook configuration tools."
    tuning_guidance = "Add known-good parent processes (e.g., msiexec.exe, setup.exe from software deployment) to %global_allowed_office_reg_writers. Scope further by excluding known-good registry value names written by approved add-ins."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the canonical Office persistence registry paths:
    // - Add-ins (COM, VSTO, WLL, XLL) under HKCU and HKLM
    // - Outlook Home Page (WebView) per-folder persistence
    // - Outlook Security / Forms registration
    // - Word/Excel startup folder overrides
    // - Trusted Templates location overrides
    $reg.target.registry.registry_key = /\\Software\\(Wow6432Node\\)?Microsoft\\Office\\[0-9]+\.[0-9]+\\(Word|Excel|PowerPoint|Outlook|Access)\\(Addins|Resiliency|Security|WebView|Options|Common\\General|Common\\Open Find)/ nocase

    // Exclude writes originating from known-good Office binaries themselves
    // (e.g., Office update, first-run configuration)
    not $reg.principal.process.file.full_path = /\\(OFFICE[0-9]+|root\\Office[0-9]+)\\(WINWORD|EXCEL|POWERPNT|OUTLOOK|MSACCESS|MSIEXEC|OfficeClickToRun)\.exe$/ nocase

    // Exclude approved administrative tooling via reference list
    not $reg.principal.process.file.full_path in %global_allowed_office_reg_writers

    // Exclude system-level update and installer processes
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|MsiExec|wusa|wuauclt|svchost)\.exe$/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1137")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
