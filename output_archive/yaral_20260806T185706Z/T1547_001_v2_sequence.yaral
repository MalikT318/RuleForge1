/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:18:54.836080+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_RunKey_Write_Then_Logon_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a registry run-key modification followed by a user logon on the same host within 10 minutes. The sequence indicates that a persistence entry was written and the implanted payload is likely to execute at the next logon. This provides additive coverage beyond command-line-only detections by correlating the registry write event with the subsequent authentication event."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION) and Windows Security logon events (USER_LOGIN) normalised into UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers writing legitimate autostart entries, RMM agents, endpoint security products, and corporate software deployment tools that write run keys and trigger a logon in the same window."
    tuning_guidance = "Add trusted parent process paths to %global_allowed_runkey_writers. Add known-good registry value names (e.g. software updater entries) to %global_allowed_runkey_value_names. Narrow the match window if false-positive volume is high."

  events:
    // --- Leg 1: Registry run-key modification ---
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Windows\\CurrentVersion\\Run(Once(Ex)?)?$/ nocase
    // Exclude writes that point to known-good system locations
    not $reg.target.registry.registry_value_data = /\\Windows\\System32\\/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_runkey_writers
    not $reg.target.registry.registry_value_name in %global_allowed_runkey_value_names
    $reg.principal.hostname = $hostname

    // --- Leg 2: Interactive or remote user logon on the same host ---
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    // Restrict to interactive (2), RemoteInteractive (10), and network-interactive (3) logon types
    // represented in UDM via extensions.auth.auth_details containing the logon type
    $auth.extensions.auth.auth_details = /logon_type=(2|3|10)/ nocase

    // Chronological ordering: registry write must precede the logon
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1547.001")
    $primary_entity      = array_distinct($hostname)
    $modified_run_keys   = array_distinct($reg.target.registry.registry_key)
    $run_key_value_names = array_distinct($reg.target.registry.registry_value_name)
    $run_key_value_data  = array_distinct($reg.target.registry.registry_value_data)
    $writing_process     = array_distinct($reg.principal.process.file.full_path)
    $writing_user        = array_distinct($reg.principal.user.userid)
    $logon_user          = array_distinct($auth.target.user.userid)

  condition:
    $reg and $auth
}
