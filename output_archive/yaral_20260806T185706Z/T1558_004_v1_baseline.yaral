/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:10:09.067076+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_ASREP_Roasting_No_Preauth_Auth {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects Kerberos AS-REP responses issued without preauthentication (ETYPE_INFO2 / RC4 encrypted TGT returned without a prior encrypted timestamp). In Active Directory this corresponds to Windows Security Event 4768 where the account has the DONT_REQUIRE_PREAUTH flag set, indicated by a pre-authentication type of 0 and a successful ticket issuance. Adversaries enumerate such accounts and request AS-REP blobs for offline password cracking."
    mitre_tactic         = "Credential Access"
    mitre_technique      = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites    = "Requires Windows Security Event 4768 (Kerberos Authentication Service ticket request) forwarded to Chronicle via a SIEM or log collector. The event must be normalised into UDM USER_LOGIN with authentication fields populated, including the Kerberos pre-authentication type."
    platform             = "Windows"
    log_source           = "identity"
    false_positives      = "Legacy service accounts or application accounts that legitimately have Kerberos pre-authentication disabled for compatibility reasons. Authorised vulnerability scanners performing AD health checks. Scheduled AD audit scripts."
    tuning_guidance      = "Add known service-account userids that legitimately have DONT_REQUIRE_PREAUTH set to %asrep_allowed_no_preauth_accounts. Add authorised scanner hostnames to %asrep_allowed_scanner_hosts. Investigate any account not in the exclusion list immediately."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Kerberos AS-REQ without pre-authentication: pre-auth type 0
    // Chronicle normalises Windows 4768 pre-auth type into
    // network.session_id or extensions.auth.auth_details; the most
    // reliable cross-vendor field for the Kerberos pre-auth type value
    // is extensions.auth.auth_details which many parsers populate as
    // the raw pre-auth type string.
    $auth.extensions.auth.auth_details = /pre.?auth.*type.*\b0\b/ nocase

    // Kerberos ticket encryption type RC4 (0x17 / 23) or DES variants
    // indicates a weak cipher was negotiated - hallmark of AS-REP roasting
    $auth.extensions.auth.auth_details = /etype.*\b(0x17|23|0x3|3|0x1|1)\b/ nocase

    // Must be a successful ticket issuance (the AS-REP was returned)
    $auth.security_result.summary = /success|ticket granted|0x0/ nocase

    // Target account must be a user principal (not a machine account $)
    not $auth.target.user.userid = /\$$/ nocase

    // Exclude accounts explicitly approved for no-preauth operation
    not $auth.target.user.userid in %asrep_allowed_no_preauth_accounts

    // Exclude authorised scanner source hosts
    not $auth.principal.hostname in %asrep_allowed_scanner_hosts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity    = array_distinct($auth.target.user.userid)
    $source_host       = array_distinct($auth.principal.hostname)
    $encryption_detail = array_distinct($auth.extensions.auth.auth_details)

  condition:
    $auth
}
