/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:11:17.412533+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_Junk_Code_Insertion_Suspicious_PE_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects file-artifact evidence of junk-code-obfuscated PE payloads being written to disk by processes that have no legitimate reason to create executables in user-writable or temporary locations. Junk-code-padded binaries are disproportionately large relative to their apparent function and are frequently staged in temp, appdata, or public directories before execution. This rule targets the FILE_CREATION state change rather than command-line arguments, providing coverage that is orthogonal to process-launch detections."
    mitre_tactic         = "Defense Evasion"
    mitre_technique      = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites    = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file-write events) normalised into Chronicle UDM FILE_CREATION events with target.file.full_path and principal.process.file.full_path populated."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Software installers unpacking PE components to temp directories; self-updating applications (browsers, Electron apps); legitimate build pipelines running on developer workstations; RMM agents staging patches."
    tuning_guidance      = "Add known-good parent process paths (e.g. installer engines, update services) to %global_allowed_pe_drop_parents. Add approved staging directories to %global_allowed_staging_paths. Consider raising severity to High when the writing process is itself located in a user-writable path."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: a PE file (MZ-header extension) written to disk
    $file.target.file.full_path = /\.(exe|dll|sys|scr|cpl|ocx|drv)$/ nocase

    // Staged in user-writable or temporary locations commonly abused for
    // junk-padded payload staging - regex anchored to known suspicious roots
    $file.target.file.full_path = /^[A-Za-z]:\\(Users\\[^\\]+\\(AppData\\(Local\\Temp|Roaming)|Downloads|Desktop|Documents)|Windows\\Temp|ProgramData\\[^\\]+|Temp)/ nocase

    // Written by a process that is NOT a known installer or system binary.
    // Legitimate PE writers live in Program Files or Windows system dirs.
    // Flag when the writing process itself lives in a user-writable path,
    // or is a scripting / document-handling process.
    (
      $file.principal.process.file.full_path = /^[A-Za-z]:\\Users\\[^\\]+\\/i nocase
      or
      $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|wmic|certutil|bitsadmin|regsvr32|rundll32|msiexec|winword|excel|powerpnt|onenote|outlook|msaccess|mspub|acrord32|acrobat|foxit)\.exe$/ nocase
    )

    // Exclude known-good parent processes added by MSSP analysts per client
    not $file.principal.process.file.full_path in %global_allowed_pe_drop_parents

    // Exclude known-good staging paths approved per client
    not $file.target.file.full_path in %global_allowed_staging_paths

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity    = array_distinct($file.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $dropped_file      = array_distinct($file.target.file.full_path)

  condition:
    $file
}
