/*
  MITRE Technique : T1606.002 - SAML Tokens
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:31:22.274163+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_002_Forged_SAML_Token_Anomalous_Login {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects authentication events that exhibit characteristics of forged SAML token usage: successful logins where the authentication method is SAML/federation but the session originates from an unusual or anonymous network, the token lifetime is abnormally long, or the login bypasses MFA entirely despite tenant policy. Golden SAML attacks allow adversaries holding a stolen token-signing certificate to forge arbitrary SAML assertions and authenticate as any user without knowing their password."
    mitre_tactic         = "Credential Access"
    mitre_technique      = "T1606.002"
    mitre_technique_name = "Forge Web Credentials: SAML Tokens"
    log_prerequisites    = "Requires identity provider sign-in audit logs normalised into Chronicle UDM. Entra ID Sign-In logs, ADFS audit events, or Okta System Log must be ingested. Fields required: network.auth_mechanism, extensions.auth.auth_details, target.user.userid, principal.ip, security_result.summary."
    platform             = "Identity Provider"
    log_source           = "m365"
    false_positives      = "Legitimate federated SSO logins from corporate VPN or trusted IP ranges; service accounts using certificate-based federation; automated pipelines authenticating via SAML. Tune by adding known federated service account UPNs to %saml_allowed_service_accounts and trusted egress IP ranges to %saml_trusted_ip_ranges."
    tuning_guidance      = "Add approved federated service account identities to %saml_allowed_service_accounts. Add corporate egress and VPN IP ranges to %saml_trusted_ip_ranges. Reduce false positives further by scoping to privileged role holders (Global Admin, Security Admin) using a reference list %saml_privileged_accounts."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Authentication must be federated / SAML-based
    (
      $auth.network.auth_mechanism = "SSO" or
      $auth.extensions.auth.auth_details = /saml/ nocase or
      $auth.security_result.summary = /saml/ nocase or
      $auth.security_result.summary = /federation/ nocase
    )

    // Login succeeded - forged tokens produce successful authentications
    $auth.security_result.summary = /success/ nocase

    // MFA was NOT satisfied - forged SAML tokens bypass MFA because the
    // assertion is crafted directly; legitimate federated logins from
    // compliant devices typically carry an MFA claim
    not $auth.extensions.auth.auth_details = /mfa/ nocase
    not $auth.extensions.auth.auth_details = /multifactor/ nocase
    not $auth.security_result.summary = /mfa/ nocase

    // Exclude known-good federated service accounts
    not $auth.target.user.userid in %saml_allowed_service_accounts

    // Exclude logins from trusted corporate egress / VPN ranges
    not $auth.principal.ip in %saml_trusted_ip_ranges

    // Capture join fields for outcome
    $auth.target.user.userid = $userid
    $auth.principal.ip = $src_ip

  outcome:
    $risk_score        = max(90)
    $mitre_technique_id = array_distinct("T1606.002")
    $primary_entity    = array_distinct($userid)
    $source_ips        = array_distinct($src_ip)
    $auth_detail       = array_distinct($auth.extensions.auth.auth_details)
    $result_summary    = array_distinct($auth.security_result.summary)

  condition:
    $auth
}
