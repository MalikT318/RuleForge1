/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:14:24.159510+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_Transmitted_Data_Manipulation_Network_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network flow anomalies consistent with in-transit data manipulation on macOS endpoints. Looks for high-volume or repeated connections on sensitive application-layer ports (databases, APIs, internal services) from unexpected processes, which may indicate a man-in-the-middle proxy or traffic interception tool altering data in transit. Targets IDS/IPS telemetry flagging unusual traffic patterns or policy violations on these channels."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION events. Appliance must inspect application-layer traffic and generate alerts or flow records for internal east-west and outbound sessions."
    platform = "macOS"
    log_source = "ips"
    false_positives = "Legitimate reverse proxies, load balancers, API gateways, developer tools such as Charles Proxy or mitmproxy used for authorised testing, VPN clients performing split-tunnelling, and monitoring agents that relay telemetry over database ports."
    tuning_guidance = "Populate %allowed_internal_proxy_hosts with known proxy and gateway IPs. Populate %allowed_high_volume_src_hosts with approved monitoring agents and ETL hosts. Narrow the port list to only those relevant to the client environment. Consider raising the threshold on bytes_transferred if baseline traffic is legitimately high."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Target sensitive application-layer ports commonly abused for data interception:
    // 3306 MySQL, 5432 PostgreSQL, 1521 Oracle, 27017 MongoDB,
    // 6379 Redis, 8080/8443 internal HTTP APIs, 9200 Elasticsearch, 5044 Logstash
    (
      $net.target.port = 3306 or
      $net.target.port = 5432 or
      $net.target.port = 1521 or
      $net.target.port = 27017 or
      $net.target.port = 6379 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 9200 or
      $net.target.port = 5044
    )

    // Principal (source) must be a macOS host - enforce via hostname pattern
    // or rely on the IDS seeing the originating endpoint identity.
    // Exclude known approved proxy and gateway infrastructure.
    not $net.principal.hostname in %allowed_internal_proxy_hosts
    not $net.principal.ip in %allowed_internal_proxy_hosts

    // Exclude known high-volume approved monitoring/ETL sources
    not $net.principal.hostname in %allowed_high_volume_src_hosts

    // Flag sessions with unusually large byte transfers that may indicate
    // bulk data being intercepted and re-transmitted (manipulation in transit).
    // network.sent_bytes + received_bytes combined signal: use sent_bytes as proxy.
    $net.network.sent_bytes > 5000000

    // Optionally restrict to non-standard initiating ports to reduce noise
    // from well-known client tooling (ephemeral ports are > 1024).
    $net.principal.port > 1024

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $target_port = array_distinct($net.target.port)
    $target_ip = array_distinct($net.target.ip)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
