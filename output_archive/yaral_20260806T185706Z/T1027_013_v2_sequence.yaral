/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:09:29.712760+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Encoded_File_Written_To_Staging_Dir {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage pattern associated with T1027.013: a process performing base64/openssl encoding writes an output file into a world-writable or temporary staging directory within a short window. The first event captures the encoding process launch; the second captures the resulting file creation in a suspicious location. This provides additive coverage beyond command-line-only detections by correlating process behaviour with the artifact it produces."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM, providing PROCESS_LAUNCH events with command_line and FILE_CREATION events with target.file.full_path. Auditd rules must capture execve and file write syscalls."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate backup scripts using openssl or base64 to archive configs; package managers encoding metadata; CI/CD pipelines staging build artefacts; security tools generating encoded reports."
    tuning_guidance = "Add trusted parent process paths to %linux_allowed_encoding_parents. Add approved staging directories to %linux_allowed_staging_dirs. Narrow the file extension regex if your environment uses specific naming conventions for encoded payloads."

  events:
    // Stage 1: encoding tool invoked with output redirection or -out flag
    $enc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $enc.target.process.command_line = /\bbase64\b/ nocase
      or
      $enc.target.process.command_line = /\bopenssl\s+(enc|aes|des|bf|rc4|chacha)/ nocase
      or
      $enc.target.process.command_line = /\bpython[23]?\b.*\bb64encode\b/ nocase
      or
      $enc.target.process.command_line = /\bperl\b.*\bMIME::Base64\b/ nocase
    )
    // Must have an output destination (redirect or explicit flag)
    (
      $enc.target.process.command_line = /(\-out\s|\>\s*\/tmp\/|\>\s*\/dev\/shm\/|\>\s*\/var\/tmp\/|\>\s*\/run\/)/ nocase
    )
    not $enc.principal.process.file.full_path in %linux_allowed_encoding_parents
    $enc.principal.hostname = $hostname

    // Stage 2: a new file appears in a world-writable or staging directory
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /^\/tmp\// nocase
      or
      $file.target.file.full_path = /^\/var\/tmp\// nocase
      or
      $file.target.file.full_path = /^\/dev\/shm\// nocase
      or
      $file.target.file.full_path = /^\/run\/shm\// nocase
      or
      $file.target.file.full_path = /^\/run\/user\// nocase
    )
    // Exclude common benign extensions written to tmp by package managers etc.
    not $file.target.file.full_path = /\.(lock|pid|socket|sock|log|tmp\.dpkg)$/ nocase
    not $file.target.file.full_path in %linux_allowed_staging_dirs
    $file.principal.hostname = $hostname

    // Chronological ordering: encoding process must precede file creation
    $enc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(72)
    $mitre_technique_id  = array_distinct("T1027.013")
    $primary_entity      = array_distinct($enc.principal.hostname)
    $encoding_cmdlines   = array_distinct($enc.target.process.command_line)
    $staged_files        = array_distinct($file.target.file.full_path)
    $encoding_user       = array_distinct($enc.principal.user.userid)
    $parent_process      = array_distinct($enc.principal.process.file.full_path)

  condition:
    $enc and $file
}
