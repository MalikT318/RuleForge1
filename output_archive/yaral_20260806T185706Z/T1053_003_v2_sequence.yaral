/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:15:37.256800+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_ESXi_Crontab_Write_After_Login {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a suspicious sequence on ESXi hosts where an interactive shell login is followed by a modification to the crontab file within one hour. Adversaries targeting ESXi (e.g., ransomware families such as ESXiArgs) persist by writing directly to /var/spool/cron/crontabs/root because ESXi lacks the standard crontab(1) editor workflow. Correlating the login event with the file-modification event reduces noise from legitimate scheduled-task frameworks that modify cron files without a preceding interactive session."
    mitre_tactic    = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Requires ESXi shell/hostd authentication logs normalised to USER_LOGIN and ESXi file-activity or hostd configuration-change logs normalised to SETTING_MODIFICATION. Both event types must be ingested from the same ESXi host."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised ESXi backup agents (e.g., Veeam, Nakivo) that authenticate and then update cron schedules; infrastructure-as-code tooling (Ansible, Terraform VMware provider) running in a pipeline; VMware Lifecycle Manager performing host remediation."
    tuning_guidance = "Add known automation service accounts to %esxi_allowed_cron_accounts. Add known management hostnames or jump-host IPs to %esxi_allowed_mgmt_sources. Narrow the time window from 1h to 15m once baseline is established to reduce false-positive exposure."

  events:
    // Leg 1: interactive or SSH login to the ESXi shell
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $esxi_host
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %esxi_allowed_cron_accounts

    // Leg 2: crontab file modification on the same host
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname = $esxi_host
    $cfg.target.resource.name = /\/var\/spool\/cron\/crontabs\// nocase
    not $cfg.principal.user.userid in %esxi_allowed_cron_accounts

    // Chronological ordering: login must precede the crontab write
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $esxi_host over 1h

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity    = array_distinct($esxi_host)
    $triggering_users  = array_distinct($auth.target.user.userid)
    $modified_paths    = array_distinct($cfg.target.resource.name)
    $login_count       = count($auth.metadata.event_timestamp.seconds)
    $crontab_mod_count = count($cfg.metadata.event_timestamp.seconds)

  condition:
    $auth and $cfg
}
