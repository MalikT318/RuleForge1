/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:14:03.084942+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Container_Critical_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of sensitive files within a container or on a host-mounted volume that may indicate stored data manipulation. Targets writes to critical Linux paths (configuration, database, log, credential stores) originating from container runtime processes or exec sessions, which adversaries abuse to tamper with data at rest and influence downstream business processes or hide activity."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Data Manipulation: Stored Data Manipulation"
    log_prerequisites = "Requires container runtime audit logs or Kubernetes audit logs normalised to Chronicle UDM FILE_MODIFICATION events. EDR agents deployed on container hosts (e.g., Falco, Sysdig, or equivalent) that emit file-write telemetry with principal process context are required for full fidelity."
    platform = "Linux"
    log_source = "container"
    false_positives = "Legitimate application deployments writing config files during initialisation, database engines performing routine checkpoint writes, log rotation daemons, authorised CI/CD pipeline steps that update stored artefacts, and infrastructure-as-code tooling (Ansible, Terraform providers) applying configuration changes."
    tuning_guidance = "Populate %container_allowed_writer_processes with known-good container init processes and sidecar agents. Populate %container_allowed_target_paths with approved writable paths for your workloads. Narrow the target path regex to the specific directories relevant to your environment to reduce noise from high-write application containers."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target sensitive Linux paths commonly abused for stored data manipulation:
    // /etc (system config), /var/lib (databases, state), /var/log (log tampering),
    // /root and /home credential/config files, /proc/sys (kernel tunables via file),
    // application data dirs, and common database file extensions
    $file.target.file.full_path = /^(\/etc\/|\/var\/lib\/|\/var\/log\/|\/root\/|\/home\/[^\/]+\/\.(ssh|config|bash|profile|gnupg)|\/opt\/|\/srv\/|\/data\/|\/mnt\/|\/run\/secrets\/)/ nocase

    // Exclude purely transient tmp writes that are not persistent stored data
    not $file.target.file.full_path = /^\/tmp\// nocase
    not $file.target.file.full_path = /^\/var\/tmp\// nocase

    // The writing process must be a container runtime exec, shell, or
    // scripting interpreter - catches adversaries who exec into containers
    // and directly manipulate files
    $file.principal.process.file.full_path = /(\/sh$|\/bash$|\/dash$|\/zsh$|\/python[0-9.]*$|\/perl[0-9.]*$|\/ruby[0-9.]*$|\/awk$|\/sed$|\/tee$|\/dd$|\/cp$|\/mv$|\/truncate$|\/install$|\/rsync$|\/curl$|\/wget$)/ nocase

    // Exclude known-good writer processes for this environment
    not $file.principal.process.file.full_path in %container_allowed_writer_processes

    // Exclude known-good target paths approved for programmatic writes
    not $file.target.file.full_path in %container_allowed_target_paths

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
