/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:39:06.642390+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_ESXi_Local_Data_Staging {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects local data staging activity on ESXi hosts where a shell process copies, moves, or archives VM-related files (VMDKs, flat files, snapshots, configs) into a staging directory. Adversaries stage data in a central location prior to exfiltration."
    mitre_tactic    = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Local Data Staging"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised into Chronicle UDM PROCESS_LAUNCH events. Enable ESXi shell logging and forward via syslog to Chronicle."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised backup agents (Veeam, Commvault, Nakivo) running scheduled VM snapshots or exports; storage vMotion operations; authorised admin maintenance scripts."
    tuning_guidance = "Add known backup service account usernames to %esxi_allowed_backup_users and known backup process paths to %esxi_allowed_backup_processes. Narrow the staging path regex if your environment uses a fixed backup mount point."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Shell or archive/copy utilities commonly used for staging on ESXi
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|vmfs\/volumes)\/(sh|bash|ash|cp|mv|tar|gzip|bzip2|xz|dd|cat|rsync|vmkfstools)$/ nocase

    // Command line must reference VM data file types (VMDK, flat, snapshot, nvram, vmx, log)
    $proc.target.process.command_line = /\.(vmdk|flat|vmsn|vmss|nvram|vmx|vmxf|vmsd|log)/ nocase

    // Command line must also reference a staging-indicative destination:
    // a temp directory, /tmp, /var/tmp, a scratch volume, or a vmfs datastore path
    // that differs from the typical per-VM datastore folder pattern
    $proc.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/scratch\/|\/vmfs\/volumes\/[^\/]+\/(tmp|stage|staging|collect|exfil|archive|backup_stage))/ nocase

    // Exclude known authorised backup service accounts
    not $proc.principal.user.userid in %esxi_allowed_backup_users

    // Exclude known authorised backup process paths
    not $proc.target.process.file.full_path in %esxi_allowed_backup_processes

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $staging_command   = array_distinct($proc.target.process.command_line)
    $actor_user        = array_distinct($proc.principal.user.userid)
    $staging_process   = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
