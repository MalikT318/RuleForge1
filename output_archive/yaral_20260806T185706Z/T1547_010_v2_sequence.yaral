/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:23:07.171944+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_PortMonitor_RegWrite_Then_AuthAnomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a registry modification adding or changing a Driver value under the Print Monitors key, followed by an interactive or remote user login on the same host within 10 minutes. Port monitor DLLs are loaded by spoolsv.exe at SYSTEM privilege on boot; an attacker may authenticate to trigger or validate persistence. This rule provides additive coverage beyond process-launch command-line detections by correlating the registry write with a subsequent authentication event."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires Windows Security audit log (Event 4657 / 4663 for registry writes) or Sysmon Event ID 13 normalised to REGISTRY_MODIFICATION, plus Windows Security logon events (4624) normalised to USER_LOGIN. Both must be ingested into Chronicle."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate print driver installations by IT staff or software deployment systems (e.g., print management suites) that also trigger a concurrent admin login. Printer vendor installers that write custom port monitor DLLs during setup."
    tuning_guidance = "Add known-good print management service accounts to %global_allowed_print_admin_users. Add authorised software deployment hostnames to %global_allowed_deployment_hosts. Raise severity if the login type is network (type 3) or remote-interactive (type 10) rather than local."

  events:
    // Leg 1: Registry modification targeting the Print Monitors Driver value
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors\\/i nocase
    $reg.target.registry.registry_value_name = /^Driver$/ nocase
    not $reg.principal.hostname in %global_allowed_deployment_hosts
    $reg.principal.hostname = $hostname

    // Leg 2: User login on the same host shortly after the registry write
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.user.userid in %global_allowed_print_admin_users

    // Chronological ordering: registry write must precede the login
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_keys = array_distinct($reg.target.registry.registry_key)
    $driver_value_written = array_distinct($reg.target.registry.registry_value_name)
    $authenticating_users = array_distinct($auth.principal.user.userid)
    $auth_event_count = count($auth.metadata.event_timestamp.seconds)

  condition:
    $reg and $auth
}
