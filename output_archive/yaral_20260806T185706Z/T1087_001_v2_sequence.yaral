/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:28:50.007475+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_Local_Account_Enum_Then_Outbound_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a burst of local account enumeration processes (net user, wmic useraccount, Get-LocalUser, dsquery) followed within 10 minutes by an outbound network connection from the same host. This correlation pattern suggests reconnaissance data may be staged for exfiltration or used to guide lateral movement, and is additive to standalone process-launch rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) normalised into UDM. Both event types must be present for the correlation to fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT helpdesk scripts auditing local accounts, RMM agents performing asset inventory, SCCM/Intune compliance checks, domain-join health checks."
    tuning_guidance = "Add known IT-admin parent process paths to %global_allowed_account_enum_parents. Add approved management subnets or IPs to %global_allowed_mgmt_destinations. Raise the threshold or narrow the network filter if the environment has heavy RMM traffic."

  events:
    // --- Leg 1: local account enumeration process launch ---
    $enum.metadata.event_type = "PROCESS_LAUNCH"

    // Match the canonical Windows account-enumeration binaries and PowerShell
    // via their command-line arguments rather than binary name alone, so the
    // rule survives binary renaming where the command-line content still
    // reveals intent.
    (
      // net.exe / net1.exe querying local users or groups
      (
        $enum.target.process.file.full_path = /\\net1?\.exe$/ nocase
        and $enum.target.process.command_line = /(user|localgroup)/ nocase
      )
      or
      // WMIC querying the Win32_UserAccount class
      (
        $enum.target.process.file.full_path = /\\wmic\.exe$/ nocase
        and $enum.target.process.command_line = /useraccount/ nocase
      )
      or
      // PowerShell invoking Get-LocalUser or Get-LocalGroupMember
      (
        $enum.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and $enum.target.process.command_line = /Get-Local(User|Group)/ nocase
      )
      or
      // dsquery targeting the local SAM
      (
        $enum.target.process.file.full_path = /\\dsquery\.exe$/ nocase
        and $enum.target.process.command_line = /user/ nocase
      )
    )

    // Exclude known-good administrative parent processes
    not $enum.principal.process.file.full_path in %global_allowed_account_enum_parents

    // Bind the joining placeholder
    $enum.principal.hostname = $hostname

    // --- Leg 2: outbound network connection from the same host ---
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Restrict to connections leaving RFC-1918 space to reduce internal noise
    not $net.target.ip in %rfc1918_internal

    // Exclude loopback / link-local
    not $net.target.ip = /^(127\.|169\.254\.)/ nocase

    // Exclude connections from known management destinations
    not $net.target.ip in %global_allowed_mgmt_destinations

    // Bind the same host placeholder
    $net.principal.hostname = $hostname

    // Chronological ordering: enumeration must precede the network connection
    $enum.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($hostname)
    $enum_commands = array_distinct($enum.target.process.command_line)
    $enum_processes = array_distinct($enum.target.process.file.full_path)
    $outbound_destinations = array_distinct($net.target.ip)
    $outbound_ports = array_distinct($net.target.port)
    $enum_parent_processes = array_distinct($enum.principal.process.file.full_path)

  condition:
    $enum and $net
}
