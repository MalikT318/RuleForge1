/*
  MITRE Technique : T1585.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:22:14.597697+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_003_Cloud_Storage_DNS_Exfil_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries to well-known cloud storage and cloud provider domains commonly abused for exfiltration staging, tool upload, or C2 infrastructure acquisition (T1585.003). Focuses on high-volume or anomalous query patterns to cloud provider namespaces that may indicate adversary use of cloud accounts for resource development or data staging."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.003"
    mitre_technique_name = "Establish Accounts: Cloud Accounts"
    log_prerequisites = "Requires DNS query/resolver logs normalised into Chronicle UDM NETWORK_DNS events. Recursive resolver or DNS firewall logs preferred for full query visibility."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate business use of cloud storage (OneDrive, Dropbox, AWS S3, MEGA, GCP, Azure) for authorised file sharing or SaaS operations. Corporate backup solutions. Developer CI/CD pipelines."
    tuning_guidance = "Add approved cloud storage domains and known-good internal resolvers to %allowed_cloud_storage_domains. Scope by source IP subnet if internal resolvers are known. Raise risk_score for TXT or NULL record type queries to these domains, which are uncommon in legitimate use."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Match DNS queries targeting cloud storage and cloud provider namespaces
    // commonly abused for exfiltration staging, tool hosting, or C2 via cloud accounts
    $dns.network.dns.questions.name = /\.(s3[\.\-]|s3\.amazonaws\.com|blob\.core\.windows\.net|onedrive\.live\.com|1drv\.ms|dropbox\.com|dropboxapi\.com|mega\.nz|mega\.co\.nz|storage\.googleapis\.com|firebasestorage\.googleapis\.com|backblazeb2\.com|wasabisys\.com|digitaloceanspaces\.com|r2\.cloudflarestorage\.com)/ nocase

    // Exclude queries that match known-good approved cloud domains for this environment
    not $dns.network.dns.questions.name in %allowed_cloud_storage_domains

    // Exclude known internal resolver source IPs (populated per client)
    not $dns.principal.ip in %allowed_internal_resolvers

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1585.003")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domain = array_distinct($dns.network.dns.questions.name)
    $dns_record_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
