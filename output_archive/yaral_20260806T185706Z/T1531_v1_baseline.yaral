/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:02:33.620911+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_001_ESXi_Account_Access_Removal {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects use of esxcli to remove or modify local ESXi accounts via the 'system account remove' or 'system account set' subcommands. Adversaries targeting ESXi hosts may delete or alter accounts to inhibit incident response and lock out legitimate administrators, a common pre-ransomware impact behaviour."
    mitre_tactic    = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "Requires ESXi shell command logging via hostd or ESXi shell audit logs normalised into Chronicle UDM as PROCESS_LAUNCH events. The esxcli binary invocation and its arguments must be captured in target.process.command_line."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised ESXi administrators decommissioning service accounts, automated lifecycle management scripts, or configuration management tooling (e.g., Ansible, vSphere automation) that manages local ESXi accounts."
    tuning_guidance = "Add known automation service account usernames to %esxi_allowed_admin_users and known orchestration host names to %esxi_allowed_mgmt_hosts. Narrow the rule to off-hours execution or non-management-plane source hosts to reduce noise in environments with frequent account lifecycle activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target the esxcli binary as it appears on ESXi file systems
    $proc.target.process.file.full_path = /\/bin\/esxcli$/ nocase

    // Match the two account manipulation subcommand paths:
    // 'system account remove' deletes an account entirely
    // 'system account set' modifies account properties (password, description, lock)
    $proc.target.process.command_line = /system\s+account\s+(remove|set)/ nocase

    // Exclude known authorised automation principals by hostname
    not $proc.principal.hostname in %esxi_allowed_mgmt_hosts

    // Exclude known authorised automation user accounts
    not $proc.principal.user.userid in %esxi_allowed_admin_users

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $acting_user       = array_distinct($proc.principal.user.userid)
    $command_executed  = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
