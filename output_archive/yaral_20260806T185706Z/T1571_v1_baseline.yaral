/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:15:32.637430+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_001_NonStandard_Port_Protocol_Mismatch {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects outbound connections where a well-known application-layer protocol is observed on a non-standard port. For example, HTTPS traffic on ports other than 443, HTTP on ports other than 80, SSH on ports other than 22, or DNS on ports other than 53. Adversaries use this technique to bypass port-based firewall rules and evade protocol-aware inspection."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "Requires firewall or perimeter network flow logs with destination port and application/protocol identification fields normalised into UDM. Application-layer protocol identification (NGFW or proxy DPI) improves fidelity."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Legitimate SaaS services using non-standard ports (e.g. SMTP submission on 587, HTTPS on 8443 for dev/admin portals, custom VPN endpoints, CDN health-check ports). Internal test environments and developer tooling may also trigger this rule."
    tuning_guidance = "Populate %allowed_nonstandard_port_destinations with approved external hosts or CIDRs that legitimately use non-standard ports. Populate %allowed_nonstandard_ports with sanctioned non-standard port numbers (e.g. 8443, 587). Narrow the monitored port list in the events block to the highest-risk ports for your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Exclude internal/RFC-1918 source and destination space - handled via reference list
    not $net.target.ip in %rfc1918_and_loopback_ranges
    not $net.principal.ip in %rfc1918_and_loopback_ranges

    // Detect connections to ports that are non-standard for common C2-abused protocols.
    // HTTPS expected on 443 - flag on other high-numbered or unusual ports.
    // HTTP expected on 80 - flag on other ports.
    // SSH expected on 22 - flag on other ports.
    // DNS expected on 53 - flag on other ports.
    // RDP expected on 3389 - flag on other ports.
    // SMTP expected on 25 - flag on submission-abuse ports beyond 587.
    (
      $net.target.port = 8080  or
      $net.target.port = 8088  or
      $net.target.port = 8443  or
      $net.target.port = 8888  or
      $net.target.port = 9443  or
      $net.target.port = 4443  or
      $net.target.port = 2222  or
      $net.target.port = 2223  or
      $net.target.port = 4444  or
      $net.target.port = 1080  or
      $net.target.port = 1194  or
      $net.target.port = 5555  or
      $net.target.port = 6666  or
      $net.target.port = 7777  or
      $net.target.port = 9001  or
      $net.target.port = 9050  or
      $net.target.port = 9150  or
      $net.target.port = 10443 or
      $net.target.port = 65443 or
      $net.target.port = 587
    )

    // Exclude approved non-standard port destinations and sanctioned ports
    not $net.target.ip in %allowed_nonstandard_port_destinations
    not $net.target.port in %allowed_nonstandard_ports

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)

  condition:
    $net
}
