/*
  MITRE Technique : T1583.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:19:30.319019+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_006_DNS_Abuse_Of_Legitimate_Web_Services {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects DNS queries to well-known web service platforms (code repositories, paste sites, cloud storage, messaging APIs, and similar) that are commonly abused for C2 staging, exfiltration, or phishing infrastructure. A single query is low-signal; this rule is designed to feed a threshold or correlation layer. The detection focuses on the combination of a known-abusable service domain with anomalous query characteristics: unusually long subdomain labels (>= 40 chars), high-entropy-style subdomains, or uncommon DNS record types (TXT, NULL) that are rarely used for legitimate browsing but are favoured for DNS tunnelling and C2 beaconing over trusted platforms."
    mitre_tactic    = "Resource Development"
    mitre_technique = "T1583.006"
    mitre_technique_name = "Acquire Infrastructure: Web Services"
    log_prerequisites = "Requires full DNS query/response logs forwarded to Chronicle. Resolver must log the queried FQDN, record type, and client IP. No endpoint process fields are required or used."
    platform        = "PRE"
    log_source      = "dns"
    false_positives = "CDN health checks, automated CI/CD pipelines querying GitHub/GitLab APIs, legitimate SaaS integrations using TXT records for domain verification, security scanners, and monitoring agents polling cloud APIs."
    tuning_guidance = "Add known-good internal resolvers or CI/CD source IPs to %dns_allowed_internal_resolvers. Add approved high-volume service FQDNs to %dns_allowed_web_service_fqdns. Raise the subdomain-length threshold or restrict to TXT/NULL record types only to reduce volume in noisy environments."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Match queries to well-known web service platforms commonly abused for
    // C2, exfiltration, or phishing staging. Pattern covers apex and subdomains.
    $dns.network.dns.questions.name = /\.(github\.com|gitlab\.com|githubusercontent\.com|pastebin\.com|paste\.ee|hastebin\.com|ghostbin\.com|discord\.com|discordapp\.com|t\.me|telegram\.org|slack\.com|trello\.com|notion\.so|airtable\.com|workers\.dev|pages\.dev|glitch\.me|repl\.co|ngrok\.io|ngrok-free\.app|serveo\.net|portmap\.io|raw\.githubusercontent\.com|gist\.github\.com|api\.github\.com|drive\.google\.com|docs\.google\.com|forms\.gle|onedrive\.live\.com|1drv\.ms|dropbox\.com|dl\.dropboxusercontent\.com|box\.com|mega\.nz|transfer\.sh|file\.io|gofile\.io|anonfiles\.com|sendspace\.com|wetransfer\.com|storj\.io|backblazeb2\.com)$/ nocase

    // Trigger on at least one of:
    //   (a) an uncommon DNS record type used for tunnelling/C2 (TXT=16, NULL=10, ANY=255)
    //   (b) an unusually long subdomain label that may encode data or represent
    //       an algorithmically generated hostname used for C2 beaconing
    (
      $dns.network.dns.questions.type = 16 or   // TXT
      $dns.network.dns.questions.type = 10 or   // NULL
      $dns.network.dns.questions.type = 255 or  // ANY
      // Long subdomain label heuristic: full FQDN > 60 chars suggests
      // data encoding or DGA-style hostname prepended to a trusted domain
      re.capture($dns.network.dns.questions.name, /^([^.]{40,})\./,1) != ""
    )

    // Exclude known-good resolvers and approved FQDNs
    not $dns.principal.ip in %dns_allowed_internal_resolvers
    not $dns.network.dns.questions.name in %dns_allowed_web_service_fqdns

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1583.006")
    $primary_entity    = array_distinct($dns.principal.ip)
    $queried_fqdn      = array_distinct($dns.network.dns.questions.name)
    $dns_record_type   = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
