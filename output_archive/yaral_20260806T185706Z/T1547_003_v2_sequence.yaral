/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:19:44.766456+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_TimeProvider_Registry_Then_DLL_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage Time Provider persistence attempt: first a registry key is created or modified under the W32Time TimeProviders subkey to register a new DLL path, then a DLL file is written to disk within the same time window on the same host. This combination strongly indicates an adversary planting a malicious time provider for boot persistence running as Local Service."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires EDR or Sysmon registry and file telemetry normalised to UDM REGISTRY_MODIFICATION/REGISTRY_CREATION and FILE_CREATION events. Sysmon Event IDs 12/13 (registry) and 11 (file create) are sufficient."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate NTP client software (e.g., Meinberg NTP, VMware Tools time sync) that registers a custom time provider DLL during installation or update. Windows updates that refresh W32Time configuration."
    tuning_guidance = "Add known-good DLL paths written by authorised NTP software to %global_allowed_timeprovider_dll_paths. Add authorised installer process paths to %global_allowed_timeprovider_writers. Scope by hostname if a specific host runs a legitimate third-party time provider."

  events:
    // Stage 1: Registry modification registering a DLL under the W32Time TimeProviders key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\System\\CurrentControlSet\\Services\\W32Time\\TimeProviders\\/i nocase
    $reg.target.registry.registry_value_name = /DllName/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_timeprovider_writers
    $reg.principal.hostname = $hostname

    // Stage 2: A DLL file is created on disk within the same window on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.dll$/ nocase
    not $file.target.file.full_path in %global_allowed_timeprovider_dll_paths
    not $file.principal.process.file.full_path in %global_allowed_timeprovider_writers
    $file.principal.hostname = $hostname

    // Chronological ordering: registry write precedes or coincides with DLL drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys_modified = array_distinct($reg.target.registry.registry_key)
    $dll_paths_written = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $registry_actors = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg and $file
}
