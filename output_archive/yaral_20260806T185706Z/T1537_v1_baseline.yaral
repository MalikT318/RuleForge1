/*
  MITRE Technique : T1537 - Transfer Data to Cloud Account
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:03:24.860372+00:00
  Reference       : https://attack.mitre.org/techniques/T1537
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1537_001_SaaS_External_File_Share_Link_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of anonymous or externally-accessible sharing links in M365 (SharePoint/OneDrive) that could be used to exfiltrate data to an adversary-controlled cloud account. Adversaries abuse native sharing APIs to create anonymous access links or share resources with external accounts on the same cloud provider, bypassing traditional egress monitoring."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1537"
    mitre_technique_name = "Transfer Data to Cloud Account"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log ingestion with SharePoint and OneDrive audit events enabled. Operations: SharingLinkCreated, AnonymousLinkCreated, AddedToSecureLink, SharingSet."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate external collaboration, authorized anonymous link creation for public-facing content, marketing or IT teams sharing resources with partners."
    tuning_guidance = "Populate %m365_allowed_external_share_users with known-good service accounts and collaboration users. Populate %m365_allowed_share_domains with approved partner domains. Consider adding a threshold wrapper to suppress single isolated events from trusted users."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"

    // Target operations that create externally-accessible or anonymous sharing links
    // These map from M365 UAL operations normalized into UDM
    (
      $cloud.metadata.description = /SharingLinkCreated/ nocase or
      $cloud.metadata.description = /AnonymousLinkCreated/ nocase or
      $cloud.metadata.description = /AddedToSecureLink/ nocase or
      $cloud.metadata.description = /SharingSet/ nocase or
      $cloud.metadata.description = /SecureLinkCreated/ nocase
    )

    // Scope to SharePoint and OneDrive workloads where bulk data lives
    (
      $cloud.target.resource.resource_type = /SharePoint/ nocase or
      $cloud.target.resource.resource_type = /OneDrive/ nocase or
      $cloud.target.resource.name = /\.xlsx$|\.docx$|\.pptx$|\.pdf$|\.zip$|\.csv$|\.json$|\.bak$/ nocase
    )

    // Actor must be an authenticated user (not a system account)
    $cloud.principal.user.userid != ""

    // Exclude known-good sharing users and service accounts
    not $cloud.principal.user.userid in %m365_allowed_external_share_users

    // Exclude approved partner domains appearing in the target resource or recipient
    not $cloud.target.resource.name in %m365_allowed_share_domains

    // Flag sharing that targets external or anonymous recipients
    // Anonymous = no specific recipient bound; external = recipient outside tenant
    (
      $cloud.target.user.userid = /anonymous/ nocase or
      $cloud.target.user.userid = /everyone/ nocase or
      $cloud.target.user.user_display_name = /anonymous/ nocase or
      $cloud.metadata.description = /anonymous/ nocase or
      $cloud.metadata.description = /external/ nocase
    )

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1537")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $shared_resource = array_distinct($cloud.target.resource.name)
    $share_operation = array_distinct($cloud.metadata.description)
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
