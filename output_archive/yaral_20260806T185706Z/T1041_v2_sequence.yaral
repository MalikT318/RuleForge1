/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:31:26.702098+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_002_ESXi_Auth_Then_Large_Datastore_Access {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects an interactive ESXi shell or SSH login followed by anomalous datastore or VM-file access within one hour. An adversary who has established C2 on an ESXi host may authenticate interactively and then read or copy large VM disk images (VMDK/flat files) over the same session as an exfiltration channel. This rule joins a USER_LOGIN event to a subsequent FILE_READ event on datastore paths, providing coverage complementary to process-command-line rules."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "Requires ESXi hostd/shell authentication logs normalised to USER_LOGIN UDM events and ESXi datastore file-access events normalised to FILE_READ UDM events. Both must populate principal.hostname and principal.user.userid."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised backup agents (Veeam, Commvault, Nakivo) reading VMDK files; storage vMotion operations; authorised administrators performing manual VM exports; snapshot consolidation jobs."
    tuning_guidance = "Add known backup service accounts to %esxi_allowed_backup_users. Add authorised management hosts to %esxi_allowed_mgmt_hosts. Raise the risk score threshold or narrow the datastore path regex to specific sensitive datastores if alert volume is high."

  events:
    // Leg 1: interactive authentication to the ESXi shell or management plane
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $esxi_host
    // Exclude known non-interactive service accounts and backup agents
    not $auth.principal.user.userid in %esxi_allowed_backup_users
    not $auth.target.ip in %esxi_allowed_mgmt_hosts

    // Leg 2: file read on a datastore path (VMDK, flat, snapshot, or ISO)
    $file.metadata.event_type = "FILE_READ"
    $file.principal.hostname = $esxi_host
    // ESXi datastore paths follow /vmfs/volumes/<datastore>/<vm-name>/<file>
    $file.target.file.full_path = /^\/vmfs\/volumes\// nocase
    $file.target.file.full_path = /\.(vmdk|flat\.vmdk|vmsn|vmem|iso|nvram)$/ nocase
    not $file.principal.user.userid in %esxi_allowed_backup_users

    // Chronological ordering: login must precede the file read
    $auth.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $esxi_host over 1h

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1041")
    $primary_entity      = array_distinct($esxi_host)
    $authenticated_users = array_distinct($auth.principal.user.userid)
    $files_accessed      = array_distinct($file.target.file.full_path)
    $file_access_count   = count($file.target.file.full_path)
    $source_ips          = array_distinct($auth.principal.ip)

  condition:
    $auth and $file
}
