/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:21:14.950464+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_LKM_File_Drop_Then_Module_Load {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a kernel module file (.ko) written to a suspicious or non-standard path, followed within 10 minutes by a process that loads a kernel module (insmod/modprobe/kmod) on the same host. This two-stage sequence is characteristic of a rootkit or persistence implant being staged and then activated, and provides additive coverage beyond command-line-only detections by anchoring on the file-creation event."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces FILE_CREATION events for .ko files and PROCESS_LAUNCH events for module-loading utilities (insmod, modprobe, kmod). Auditd rules must watch -a always,exit -F arch=b64 -S finit_module,init_module and monitor writes to /tmp, /dev/shm, /var/tmp, and non-standard module paths."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate out-of-tree kernel module builds (DKMS), hardware vendor driver installers (GPU, NIC), kernel development workflows, automated CI/CD pipelines building and testing modules."
    tuning_guidance = "Add trusted staging directories (e.g., DKMS build paths under /var/lib/dkms) to %linux_allowed_ko_staging_paths. Add authorised module-loader parent processes (e.g., dkms, apt, rpm) to %linux_allowed_module_loader_parents. Narrow the file path regex if your environment always places legitimate .ko files under /lib/modules or /usr/lib/modules."

  events:
    // Stage 1: a .ko file is created in a suspicious or non-standard location
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(ko|ko\.xz|ko\.gz|ko\.zst)$/ nocase
    // Exclude the canonical kernel module tree; flag writes anywhere else
    not $file.target.file.full_path = /^\/lib\/modules\// nocase
    not $file.target.file.full_path = /^\/usr\/lib\/modules\// nocase
    not $file.target.file.full_path in %linux_allowed_ko_staging_paths
    $file.principal.hostname = $hostname

    // Stage 2: a module-loading utility is launched on the same host
    $load.metadata.event_type = "PROCESS_LAUNCH"
    $load.target.process.file.full_path = /\/(insmod|modprobe|kmod)$/ nocase
    not $load.principal.process.file.full_path = /\/(dkms|apt|apt-get|dpkg|rpm|yum|dnf|zypper)$/ nocase
    not $load.principal.process.file.full_path in %linux_allowed_module_loader_parents
    $load.principal.hostname = $hostname

    // Chronological ordering: file must be created before the load attempt
    $file.metadata.event_timestamp.seconds <= $load.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(92)
    $mitre_technique_id  = array_distinct("T1547.006")
    $primary_entity      = array_distinct($hostname)
    $staged_ko_paths     = array_distinct($file.target.file.full_path)
    $loader_processes    = array_distinct($load.target.process.file.full_path)
    $loader_cmdlines     = array_distinct($load.target.process.command_line)
    $staging_user        = array_distinct($file.principal.user.userid)
    $loading_user        = array_distinct($load.principal.user.userid)

  condition:
    $file and $load
}
