/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:17:09.055471+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_K8s_CronJob_Resource_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of Kubernetes CronJob or Job resources via cloud audit logs. Adversaries abuse container orchestration scheduling (T1053.007) to deploy malicious workloads on a recurring basis for persistence or execution. This rule pivots on the API-level resource creation event rather than process command-line telemetry, providing coverage at a different abstraction layer."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes API server audit logs ingested into Chronicle UDM. The audit log must capture resource creation events for batch/v1 CronJob and Job kinds. GKE, EKS, and AKS all emit these via their respective cloud audit pipelines."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines creating CronJobs for scheduled batch processing, database backups, certificate rotation, or log aggregation. Cluster operators deploying monitoring or maintenance jobs."
    tuning_guidance = "Populate %k8s_allowed_cronjob_principals with service accounts and users that routinely create CronJobs (e.g., CI/CD service accounts, cluster-admin automation). Populate %k8s_allowed_namespaces with namespaces where scheduled jobs are expected (e.g., 'batch', 'jobs', 'monitoring'). Raise severity if the creating principal is an interactive user rather than a service account."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Match Kubernetes CronJob or Job resource kinds as normalised into UDM
    // The resource type field captures the Kubernetes API group and kind
    $cloud.target.resource.resource_type = /cronjob|^job$/ nocase

    // Optionally match on the Kubernetes API verb 'create' surfaced in the method
    $cloud.network.http.method = /create/ nocase

    // Exclude known-good principals (service accounts, CI/CD automation)
    not $cloud.principal.user.userid in %k8s_allowed_cronjob_principals

    // Exclude known-safe namespaces where scheduled jobs are expected
    not $cloud.target.resource.attribute.labels.value in %k8s_allowed_namespaces

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_name = array_distinct($cloud.target.resource.name)
    $resource_type = array_distinct($cloud.target.resource.resource_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
