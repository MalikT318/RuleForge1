/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:14:59.596635+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_At_Job_File_Then_Execution_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects the two-stage pattern of Linux at(1) abuse: a job spool file is written under /var/spool/atjobs (or /var/spool/at) and then, within one hour, a process is launched whose parent is the atd daemon. This correlation provides additive coverage beyond command-line detection of the at binary itself by focusing on the artefacts atd produces and the child processes it spawns."
    mitre_tactic    = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. FILE_CREATION events must capture /var/spool/at* paths; PROCESS_LAUNCH events must populate principal.process.file.full_path with the parent executable path."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate system maintenance jobs submitted via at by administrators or automated tooling (backup scripts, monitoring agents). Batch-processing pipelines that use atd for job scheduling."
    tuning_guidance = "Add known-good submitting process paths to %linux_allowed_at_submitters. Add known-good hostnames running scheduled batch workloads to %linux_at_job_exclusion_hosts. Raise severity if the spawned child writes to /tmp, /dev/shm, or initiates a network connection in a subsequent rule."

  events:
    // Stage 1: a spool file is created in the atd job directory.
    // atd writes job files named with a hex timestamp prefix under these paths.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/var\/spool\/at(jobs)?\// nocase
    not $file.principal.process.file.full_path in %linux_allowed_at_submitters
    not $file.principal.hostname in %linux_at_job_exclusion_hosts
    $file.principal.hostname = $hostname

    // Stage 2: atd spawns a child process to execute the scheduled job.
    // The parent of any at-dispatched job is the atd daemon.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\batd$/ nocase
    // Exclude atd re-spawning itself (daemon reload / fork) and known benign shells
    // doing nothing but sourcing environment — focus on substantive child processes.
    not $proc.target.process.file.full_path = /\batd$/ nocase
    not $proc.target.process.file.full_path in %linux_allowed_at_submitters
    not $proc.principal.hostname in %linux_at_job_exclusion_hosts
    $proc.principal.hostname = $hostname

    // Chronological ordering: spool file must appear before atd launches the job.
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score          = max(72)
    $mitre_technique_id  = array_distinct("T1053.002")
    $primary_entity      = array_distinct($proc.principal.hostname)
    $spool_files_written = array_distinct($file.target.file.full_path)
    $spawned_processes   = array_distinct($proc.target.process.file.full_path)
    $spawned_cmdlines    = array_distinct($proc.target.process.command_line)
    $submitting_process  = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $proc
}
