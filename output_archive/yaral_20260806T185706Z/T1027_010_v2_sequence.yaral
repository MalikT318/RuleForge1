/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:07:38.062348+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Obfuscated_Script_Written_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage obfuscation pattern on Linux: a shell or interpreter process writes a script file to a world-writable or temporary directory (suggesting dynamic payload generation), followed by a shell or interpreter executing that same file. This sequence is characteristic of command obfuscation where the final payload is assembled and written at runtime to evade static analysis of the initial command line."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with file-creation and process-launch events. Auditd rules must include -a always,exit -F arch=b64 -S open,openat,creat for file writes and execve for process launches."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate build systems, package managers, or CI/CD pipelines that generate and execute scripts in /tmp or /dev/shm. Ansible, Chef, Puppet, and similar configuration management tools commonly write and execute temporary scripts."
    tuning_guidance = "Add known CI/CD runner process paths to %linux_allowed_script_writers. Add known automation parent process paths to %linux_allowed_automation_parents. Narrow the file path regex if /tmp activity from a specific tool is noisy."

  events:
    // Stage 1: A shell or interpreter writes a script file to a suspicious directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/proc\/[0-9]+\/fd\/)/ nocase
    $file.target.file.full_path = /\.(sh|py|pl|rb|php|lua|tcl|awk|bash|zsh|ksh)$/ nocase
    $file.principal.process.file.full_path = /(\/bin\/|\/usr\/bin\/|\/usr\/local\/bin\/)(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|php|lua|awk|tclsh)$/ nocase
    not $file.principal.process.file.full_path in %linux_allowed_script_writers
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $written_script

    // Stage 2: A shell or interpreter executes that same written file
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = $written_script
    $proc.principal.process.file.full_path = /(\/bin\/|\/usr\/bin\/|\/usr\/local\/bin\/)(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|php|lua|awk|tclsh)$/ nocase
    not $proc.principal.process.file.full_path in %linux_allowed_automation_parents
    $proc.principal.hostname = $hostname

    // Enforce chronological ordering: file written before it is executed
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $written_script over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $executing_process = array_distinct($proc.principal.process.file.full_path)
    $script_paths = array_distinct($written_script)
    $executing_user = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
