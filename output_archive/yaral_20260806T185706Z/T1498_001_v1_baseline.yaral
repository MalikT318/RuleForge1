/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:59:58.786102+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Direct_Network_Flood_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects execution of network flood or stress-testing utilities on Linux. Adversaries use these tools to launch direct network flood attacks (T1498.001) against targets, saturating bandwidth or exhausting connection state. The rule matches the process launch of common flood-capable binaries combined with flags indicative of high-volume packet generation, while excluding approved performance-testing hosts via reference list."
    mitre_tactic         = "Impact"
    mitre_technique      = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites    = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events. Auditd syscall execve rules or an EDR agent must capture full command-line arguments."
    platform             = "Linux"
    log_source           = "linux_endpoint"
    false_positives      = "Authorised network performance testing (iperf3, netperf), red-team exercises, ISP bandwidth validation, QA lab environments running stress tests."
    tuning_guidance      = "Add approved hostnames running sanctioned load tests to %linux_allowed_flood_hosts. Add approved tool paths to %linux_allowed_network_test_tools. Narrow the command-line regex if hping3 or nping are used legitimately in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match flood-capable tool names by process image path using Linux conventions.
    // Covers: hping3, nping, mz (mausezahn), packeth, ostinato, t50, udpflood,
    //         iperf/iperf3 (dual-use), netperf, ab (ApacheBench), wrk, siege,
    //         slowhttptest, goldeneye, xerxes, hulk, loic (via mono), trafgen.
    // Regex targets the binary name at the end of any filesystem path.
    $proc.target.process.file.full_path = /\/(hping3?|nping|mausezahn|mz|packeth|t50|udpflood|trafgen|xerxes|goldeneye|hulk|loic|slowhttptest|iperf3?|netperf|ab|wrk|siege)$/ nocase

    // Require at least one flag pattern that indicates high-volume or flood-mode operation.
    // --flood / -flood: hping3, nping native flood mode (sends packets as fast as possible)
    // -c <large_count>: packet count in the thousands or more
    // --rate / -rate: explicit rate specification (hping3, nping, trafgen)
    // -b / --bandwidth: bandwidth target (iperf3, netperf)
    // -n <large_count>: request count (ab, wrk)
    // -t <seconds> combined with concurrency flags: sustained attack window
    // --udp / -u / --icmp: stateless protocol selection amplifying flood impact
    $proc.target.process.command_line = /(--flood|-flood|--rate\s+[0-9]+|-rate\s+[0-9]+|-c\s+[1-9][0-9]{3,}|-n\s+[1-9][0-9]{3,}|-b\s+[0-9]+[MmGg]|--udp|-udp\s|--icmp|-icmp\s|--syn\s|--ack\s|--fin\s)/ nocase

    // Exclude hosts authorised for performance testing or red-team exercises.
    not $proc.principal.hostname in %linux_allowed_flood_hosts

    // Exclude approved tool paths (e.g. a controlled lab binary location).
    not $proc.target.process.file.full_path in %linux_allowed_network_test_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $flood_tool        = array_distinct($proc.target.process.file.full_path)
    $flood_cmdline     = array_distinct($proc.target.process.command_line)
    $initiating_user   = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
