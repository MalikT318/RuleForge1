/*
  MITRE Technique : T1596.001 - DNS/Passive DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:25:01.799553+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_001_Excessive_DNS_Enumeration_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a high volume of DNS query types associated with DNS reconnaissance against an organization's authoritative nameservers or perimeter DNS resolvers. Adversaries performing T1596.001 typically query for MX, NS, SOA, TXT, AXFR, and ANY record types in rapid succession to map subdomains, mail infrastructure, and internal network topology. This rule fires on a single DNS event carrying a high-risk query type (AXFR/ANY/SOA) originating from an external source, which is rarely legitimate from arbitrary external IPs."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.001"
    mitre_technique_name = "Gather Victim Network Information: DNS/Passive DNS"
    log_prerequisites = "Requires DNS query logs from a perimeter DNS resolver, authoritative nameserver, or firewall with DNS inspection. UDM event type NETWORK_DNS must be populated with network.dns.questions.type."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate DNS monitoring services (e.g. uptime checkers), authorized zone transfer partners, security scanners operated by the organization, and DNS health-check tools."
    tuning_guidance = "Add authorized zone-transfer partner IPs and internal monitoring service source IPs to %allowed_dns_recon_sources. Add internal resolver IP ranges to %rfc1918_internal to suppress internal-to-internal queries. Raise severity to High if query type is AXFR (252) and the source is not a known secondary nameserver."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Target high-risk DNS record types used in DNS enumeration:
    // AXFR=252 (zone transfer), ANY=255, SOA=6, NS=2, MX=15, TXT=16
    (
      $dns.network.dns.questions.type = 252 or   // AXFR - zone transfer
      $dns.network.dns.questions.type = 255 or   // ANY  - all records
      $dns.network.dns.questions.type = 6   or   // SOA  - start of authority
      $dns.network.dns.questions.type = 2   or   // NS   - nameserver records
      $dns.network.dns.questions.type = 15  or   // MX   - mail exchange
      $dns.network.dns.questions.type = 16        // TXT  - text records (SPF/DKIM recon)
    )

    // Source must be external (not a known internal or trusted resolver)
    not $dns.principal.ip in %rfc1918_internal
    not $dns.principal.ip in %allowed_dns_recon_sources

    // Destination should be a perimeter or authoritative resolver
    // (not filtered here to remain portable; tuned via exclusion lists)

    // Exclude known-good query names such as internal health-check domains
    not $dns.network.dns.questions.name in %allowed_internal_domains

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1596.001")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_record_type = array_distinct($dns.network.dns.questions.type)
    $queried_name = array_distinct($dns.network.dns.questions.name)
    $destination_resolver = array_distinct($dns.target.ip)

  condition:
    $dns
}
