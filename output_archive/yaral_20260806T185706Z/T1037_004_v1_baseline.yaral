/*
  MITRE Technique : T1037.004 - RC Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:37:36.153739+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_004_RC_Script_Persistence_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable configuration modification events on network devices that may indicate RC script tampering for persistence. On network devices (routers, switches, firewalls, IoT, ESXi management plane), legitimate RC script modifications are rare and should be change-controlled. This rule fires on SETTING_MODIFICATION events referencing startup/boot configuration paths commonly associated with RC script persistence (rc.local, rc.common, local.sh, etc.) observed via syslog or management-plane telemetry."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.004"
    mitre_technique_name = "Boot or Logon Initialization Scripts: RC Scripts"
    log_prerequisites = "Requires syslog or management-plane audit logs from network devices (routers, switches, firewalls, ESXi, IoT) forwarded to Chronicle. Device must log configuration change events with the affected file or configuration path. Syslog severity notice/warning or structured audit logs preferred."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized network device firmware upgrades, scheduled maintenance windows, automated configuration management (Ansible, NAPALM, Terraform), vendor-initiated remote support sessions."
    tuning_guidance = "Add authorized change management source IPs to %global_allowed_mgmt_sources. Add authorized admin user IDs to %global_allowed_network_admins. Scope to specific device hostnames if noise is high in large environments."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Target configuration path matches RC script locations common on Unix-like
    // network devices, ESXi, IoT, and embedded systems. Covers rc.local,
    // rc.common, rc.d directories, local.sh (ESXi), and generic rc script paths.
    (
      $cfg.target.resource.name = /rc\.local/ nocase or
      $cfg.target.resource.name = /rc\.common/ nocase or
      $cfg.target.resource.name = /\/etc\/rc\.d\// nocase or
      $cfg.target.resource.name = /local\.sh/ nocase or
      $cfg.target.resource.name = /rc\.sysinit/ nocase or
      $cfg.target.resource.name = /\/etc\/rc/ nocase or
      $cfg.target.file.full_path = /rc\.local/ nocase or
      $cfg.target.file.full_path = /rc\.common/ nocase or
      $cfg.target.file.full_path = /\/etc\/rc\.d\// nocase or
      $cfg.target.file.full_path = /local\.sh/ nocase or
      $cfg.target.file.full_path = /rc\.sysinit/ nocase or
      $cfg.target.file.full_path = /\/etc\/rc/ nocase
    )

    // Exclude authorized management source IPs (populated per customer)
    not $cfg.principal.ip in %global_allowed_mgmt_sources

    // Exclude authorized admin accounts performing change-controlled work
    not $cfg.principal.user.userid in %global_allowed_network_admins

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.004")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $affected_resource = array_distinct($cfg.target.resource.name)
    $actor_user = array_distinct($cfg.principal.user.userid)
    $source_ip = array_distinct($cfg.principal.ip)

  condition:
    $cfg
}
