/*
  MITRE Technique : T1137.005 - Outlook Rules
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:47:08.067459+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_005_Outlook_Malicious_Rule_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of Outlook mailbox rules that may indicate persistence via T1137.005. Adversaries create inbox rules to trigger actions (e.g., run a script, forward mail, redirect to a folder) when a specially crafted email arrives. This rule fires on mailbox rule creation or update events surfaced in M365 unified audit logs, focusing on rule conditions that suggest automated execution or exfiltration behavior such as forwarding to external addresses or redirect actions."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.005"
    mitre_technique_name = "Office Application Startup: Outlook Rules"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log with Exchange mailbox auditing enabled. Operations: New-InboxRule, Set-InboxRule, UpdateInboxRules must be captured and normalized into UDM SETTING_MODIFICATION events."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate users creating inbox rules to forward mail to a shared mailbox, legal hold rules, helpdesk automation, or IT-managed mail flow rules. Bulk rule creation by migration tooling."
    tuning_guidance = "Add known-good service accounts and migration identities to %m365_allowed_rule_creators. Add approved internal forwarding domains to %m365_allowed_forward_domains. Narrow scope by requiring the ForwardTo or RedirectTo target to be an external domain if your environment normalizes that into the target field."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /new\-inboxrule|set\-inboxrule|updateinboxrules/ nocase
    (
      $setting.target.resource.name = /forwardto|redirectto|forwardascopy|movetofolderpath|deletemessage|markasread|stopprocessingrules/ nocase
      or
      $setting.security_result.description = /forwardto|redirectto|forwardascopy|run\s*script|movetofolderpath/ nocase
    )
    not $setting.principal.user.userid in %m365_allowed_rule_creators

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1137.005")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $rule_target = array_distinct($setting.target.resource.name)
    $actor_user = array_distinct($setting.principal.user.userid)

  condition:
    $setting
}
