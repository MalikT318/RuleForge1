/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:45:27.292943+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_Network_Device_Account_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new local or management-plane account on a network device via firewall or perimeter management-plane syslog. Adversaries create accounts on network devices to establish persistent backdoor access without deploying remote access tools. Fires on USER_CREATION events normalised from device syslog, covering CLI-driven and API-driven account provisioning."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136"
    mitre_technique_name = "Create Account"
    log_prerequisites = "Requires syslog or management-plane audit logs from network devices (routers, switches, firewalls, load balancers) forwarded to Chronicle and normalised to UDM USER_CREATION events. Ensure AAA/TACACS+/RADIUS accounting and local audit logging are enabled on all managed devices."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network operations team provisioning new admin accounts; automated configuration management systems (Ansible, Terraform, NSO); break-glass account creation during incident response; scheduled account rotation by privileged access management (PAM) tooling."
    tuning_guidance = "Add approved automation service accounts to %global_allowed_network_mgmt_accounts. Add known management-plane source IPs or subnets to %global_allowed_mgmt_sources. Scope by target.hostname or target.ip to specific device tiers (core vs edge) if noise is high."

  events:
    $cloud.metadata.event_type = "USER_CREATION"
    // The account being created must have a non-empty userid
    $cloud.target.user.userid != ""
    // Exclude known-good automation accounts and PAM service identities
    not $cloud.target.user.userid in %global_allowed_network_mgmt_accounts
    // Exclude provisioning actions originating from approved management sources
    not $cloud.principal.ip in %global_allowed_mgmt_sources
    // Exclude empty principal to avoid noise from internally generated synthetic events
    $cloud.principal.ip != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1136")
    $primary_entity = array_distinct($cloud.target.hostname)
    $created_account = array_distinct($cloud.target.user.userid)
    $source_ip = array_distinct($cloud.principal.ip)
    $acting_user = array_distinct($cloud.principal.user.userid)

  condition:
    $cloud
}
