/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:33:28.957605+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_001_Container_Admin_Command_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects use of container administration APIs (Docker exec, Kubernetes exec, kubelet exec) to execute commands within a running container. Adversaries with sufficient permissions can abuse these control-plane APIs to achieve remote code execution inside containers without spawning a new container."
    mitre_tactic = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Requires cloud audit logs capturing Kubernetes API server audit events or Docker daemon API calls, normalised into Chronicle UDM. Kubernetes audit policy must log at Request or RequestResponse level for pods/exec, pods/attach, and pods/portforward sub-resources."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate DevOps workflows using kubectl exec for debugging, CI/CD pipeline health checks, authorised SRE troubleshooting sessions, container-native monitoring agents that exec into pods."
    tuning_guidance = "Populate %allowed_container_exec_principals with service accounts and human identities authorised to exec into containers (e.g. SRE break-glass accounts, CI service accounts). Populate %allowed_container_namespaces with non-production namespaces where exec is routine. Consider elevating severity when the target namespace is kube-system or when the principal is not a human user account."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match Kubernetes API exec, attach, portforward sub-resource verbs
    // and Docker daemon exec endpoint patterns as normalised in UDM
    (
      $cloud.target.resource.name = /\/exec$/ nocase or
      $cloud.target.resource.name = /\/attach$/ nocase or
      $cloud.target.resource.name = /\/portforward$/ nocase or
      $cloud.target.resource.name = /\/exec\?/ nocase or
      $cloud.target.resource.name = /containers\/exec/ nocase
    )

    // Restrict to pod or container resource types
    (
      $cloud.target.resource.resource_type = /pod/ nocase or
      $cloud.target.resource.resource_type = /container/ nocase
    )

    // Exclude approved principals performing authorised exec operations
    not $cloud.principal.user.userid in %allowed_container_exec_principals

    // Exclude approved namespaces where exec is routine (e.g. dev/test)
    not $cloud.target.resource.attribute.labels.value in %allowed_container_namespaces

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $target_resource_type = array_distinct($cloud.target.resource.resource_type)
    $principal_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
