/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:05:07.886925+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Component_Firmware_Tool_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects execution of known firmware interaction utilities or low-level hardware access tools that are commonly abused to read, write, or flash component firmware on Windows systems. Adversaries use these tools to implant persistent firmware-level code in HDDs, SSDs, NICs, or other peripheral controllers that survives OS reinstallation and evades host-based defenses."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (Process Create) with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate firmware update utilities from hardware vendors (e.g., drive management suites, NIC firmware updaters), IT asset management tools performing hardware inventory, authorized security researchers, and OEM provisioning workflows."
    tuning_guidance = "Add known-good firmware management parent processes or full paths to %global_allowed_firmware_tools. Scope by principal.hostname to known hardware maintenance hosts. Investigate any instance not originating from a vendor-signed update orchestrator."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target processes that interact with raw disk, ATA/NVMe, or peripheral firmware
    // Matches generic patterns for firmware flash, disk raw access, and IOCTL-based tools
    // without hardcoding specific tool names (attackers rename binaries)
    (
      // Command-line flags strongly associated with ATA IDENTIFY, SMART, or firmware download commands
      $proc.target.process.command_line = /\b(--flash|--firmware|--burn|--write-fw|--update-fw|--fwdl|--download-fw|--nvme-fw|--ata-fw)\b/ nocase
      or
      // Raw disk device path access patterns indicating direct hardware I/O bypass of the OS filesystem
      $proc.target.process.command_line = /\\\\\.\s*\\(PhysicalDrive|Scsi|NVMe|HarddiskVolume|USBSTOR|GLOBALROOT)/ nocase
      or
      // ATA pass-through or SCSI generic IOCTL invocation patterns in command lines
      $proc.target.process.command_line = /\b(ata\s*pass.?through|scsi\s*pass.?through|nvme\s*pass.?through|ioctl.?storage|ioctl.?ata)\b/ nocase
      or
      // Firmware image file extensions being passed as arguments, indicating a flash operation
      $proc.target.process.command_line = /\.(bin|rom|fw|fwpkg|fwupd|cap|hdr|img)\b/ nocase
    )

    // Exclude processes launched from standard Windows system paths performing routine operations
    not $proc.target.process.file.full_path = /^[Cc]:\\[Ww]indows\\[Ss]ystem32\\/ nocase
    not $proc.target.process.file.full_path = /^[Cc]:\\[Ww]indows\\[Ss]ys[Ww][Oo][Ww]64\\/ nocase

    // Exclude known-good firmware management orchestrators added by MSSP or client tuning
    not $proc.principal.process.file.full_path in %global_allowed_firmware_tools
    not $proc.target.process.file.full_path in %global_allowed_firmware_tools

    // Exclude standard Windows Update and trusted software distribution paths
    not $proc.principal.process.file.full_path = /\\[Ww]indows[Uu]pdate\.exe$/ nocase
    not $proc.principal.process.file.full_path = /\\[Tt]rusted[Ii]nstaller\.exe$/ nocase

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
