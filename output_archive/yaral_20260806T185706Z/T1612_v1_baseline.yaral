/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:34:27.351145+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_Build_Image_On_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects container image build requests submitted directly to the container runtime API on a host. Adversaries abuse the Docker/container build API to construct custom images containing malware downloaded from C2, bypassing registry-based defenses that only inspect pulled images."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires cloud audit logs capturing container API calls, such as Docker API audit events, Kubernetes audit logs, or cloud-provider container service audit trails (e.g., GCP Audit, Azure Activity, AWS CloudTrail for ECS/EKS). The build action must be surfaced as a resource creation or user resource access event in UDM."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines building images on container hosts, developer workstations with local Docker builds, authorized image baking pipelines for golden AMIs or base images, Kubernetes operators that build images as part of their reconciliation loop."
    tuning_guidance = "Populate %allowed_image_build_principals with service accounts and user identities belonging to approved CI/CD systems. Populate %allowed_image_build_resources with known build namespaces or project identifiers. Consider adding a time-window correlation to flag builds that are immediately followed by container deployment (T1610)."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target the container image build API action - normalised across providers
    // GCP: containers.images.build, cloudbuild.builds.create
    // AWS: CreateImage, StartBuild, BatchCreateImage
    // Azure: Microsoft.ContainerRegistry/registries/builds/write
    // Docker API: /build endpoint surfaced as image build operation
    $cloud.target.resource.name = /image|build/ nocase
    $cloud.metadata.product_event_type = /build|image.*build|build.*image/ nocase

    // Exclude known approved CI/CD build principals
    not $cloud.principal.user.userid in %allowed_image_build_principals

    // Exclude known approved build namespaces or resource groups
    not $cloud.target.resource.name in %allowed_image_build_resources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $build_resource = array_distinct($cloud.target.resource.name)
    $build_action = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
