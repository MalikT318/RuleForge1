/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:22:48.660126+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_PortMonitor_Registry_Driver_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to the Driver value under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors, which is the mechanism used by T1547.010 Port Monitors to load an arbitrary DLL via the print spooler (spoolsv.exe) at SYSTEM privilege on boot. This rule targets the resulting registry state change rather than the process command line, providing coverage that is harder to evade."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION events. Sysmon Event ID 13 (RegistryEvent - Value Set) or equivalent EDR registry telemetry."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver installation by vendor software (e.g., HP, Canon, Xerox installers), Windows Update applying print subsystem patches, enterprise print management solutions (PaperCut, PrinterLogic). These typically run from known installer paths and can be excluded via the reference list."
    tuning_guidance = "Add known-good parent process paths (e.g., printer vendor installer executables) to %global_allowed_print_monitor_writers. Consider also scoping by the registry subkey name - legitimate monitors have well-known names (Local Port, Standard TCP/IP Port, USB Monitor, WSD Port) and can be allowlisted if your environment is stable."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors\\/i nocase
    $reg.target.registry.registry_value_name = /^Driver$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_print_monitor_writers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $monitor_key = array_distinct($reg.target.registry.registry_key)
    $driver_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
