/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:05:17.327611+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_Suspicious_PE_Written_To_Temp_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PE files (executables or DLLs) written to user-writable or temporary directories by processes that are not typical software installers. Malware using dynamic API resolution (T1027.007) commonly unpacks or drops a resolved-API stage-two payload to disk before execution. Detecting the file artifact catches this technique at a layer that is harder to evade than command-line logging."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires EDR or Sysmon FileCreate events normalised to UDM FILE_CREATION. Sysmon Event ID 11 or equivalent EDR file-write telemetry must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers writing staged components to TEMP; self-extracting archives; JIT compilers writing native images; update agents. Tune by adding known-good parent process paths to %global_allowed_pe_drop_parents."
    tuning_guidance = "Add trusted installer or updater process full paths to %global_allowed_pe_drop_parents. Consider scoping to higher-risk parent processes (e.g. browsers, Office apps, script interpreters) if noise is high. Exclude known software staging directories via %global_allowed_staging_paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file has a PE-associated extension
    $file.target.file.full_path = /\.(exe|dll|sys|ocx|scr|cpl|drv)$/ nocase

    // Written into user-writable or temporary locations commonly abused by malware
    // Matches: %TEMP%, %TMP%, AppData\Local\Temp, AppData\Roaming, ProgramData subdirs,
    // and arbitrary user profile paths
    $file.target.file.full_path = /(\\Temp\\|\\tmp\\|\\AppData\\Local\\Temp\\|\\AppData\\Roaming\\|\\ProgramData\\|\\Users\\[^\\]+\\AppData\\)/ nocase

    // Parent process is a script interpreter, document renderer, browser, or other
    // high-risk process that should not be dropping PE files to temp locations.
    // This catches the unpacking / dropper stage of a dynamically-resolved payload.
    $file.principal.process.file.full_path = /(\\powershell\.exe|\\pwsh\.exe|\\wscript\.exe|\\cscript\.exe|\\mshta\.exe|\\rundll32\.exe|\\regsvr32\.exe|\\msiexec\.exe|\\wmic\.exe|\\cmd\.exe|\\explorer\.exe|\\winword\.exe|\\excel\.exe|\\powerpnt\.exe|\\outlook\.exe|\\msedge\.exe|\\chrome\.exe|\\firefox\.exe|\\iexplore\.exe|\\java\.exe|\\javaw\.exe)$/ nocase

    // Exclude known-good parent processes approved for staging PE artifacts
    not $file.principal.process.file.full_path in %global_allowed_pe_drop_parents

    // Exclude known-good staging directories (e.g. approved software deployment paths)
    not $file.target.file.full_path in %global_allowed_staging_paths

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
