/*
  MITRE Technique : T1037.001 - Logon Script (Windows)
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:36:46.430706+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_001_Logon_Script_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification or creation of the UserInitMprLogonScript registry value under HKCU\\Environment, which is the canonical Windows mechanism for per-user logon script persistence. Adversaries write a script path to this key so their payload executes automatically at every interactive logon."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.001"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Logon Script (Windows)"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 or equivalent EDR registry events) normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM tooling that legitimately configures logon scripts for managed users; some enterprise login-banner or drive-mapping solutions that write to this key."
    tuning_guidance = "Add known-good parent process paths (e.g. GPO client, MDM agent) to %global_allowed_logon_script_writers. Scope further by excluding specific user accounts via %global_allowed_logon_script_users if a subset of users legitimately uses this key."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment\\UserInitMprLogonScript$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_logon_script_writers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $script_value = array_distinct($reg.target.registry.registry_value_data)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
