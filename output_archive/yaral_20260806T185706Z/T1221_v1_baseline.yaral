/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:53:58.310877+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_001_Office_Template_Remote_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Office applications (Word, Excel, PowerPoint) spawning network-capable child processes or script interpreters that are characteristic of remote template injection. When a malicious OOXML document loads a remote template reference, Office fetches the payload and may execute embedded code via a child process. This rule targets the process-launch signal produced when that execution occurs."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised into UDM PROCESS_LAUNCH with parent/child process lineage and command-line fields populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office macros or add-ins that invoke PowerShell or scripting engines; automated document-processing pipelines; IT admin scripts launched from Office-based tooling."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_office_child_procs. Narrow scope by adding destination hostname or URL patterns if network telemetry is correlated. Consider suppressing hosts in %global_approved_office_automation_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent must be an Office application
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|msaccess|mspub|onenote)\.exe$/  nocase

    // Child process is a scripting engine, shell, or network-capable LOLBin
    // that Office should not normally spawn without user-triggered macro activity
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|msiexec|wmic|curl|wget)\.exe$/ nocase

    // Narrow to command lines that suggest remote retrieval or script execution
    // Matches: http/https URLs, UNC paths, encoded commands, or script file extensions
    $proc.target.process.command_line = /(https?:\/\/|\\\\[a-z0-9]|encodedcommand|frombase64|downloadstring|downloadfile|invoke-expression|iex\s|\.vbs|\.js|\.hta|\.ps1|\.bat|\.cmd)/  nocase

    // Exclude known-good parent paths (e.g., approved automation hosts)
    not $proc.principal.process.file.full_path in %global_allowed_office_child_procs

    // Exclude approved automation hosts
    not $proc.principal.hostname in %global_approved_office_automation_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
