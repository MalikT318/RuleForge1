/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:38:01.655151+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_001_Network_Share_Data_Collection_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes reading from mounted network shares (NFS, CIFS/SMB, SSHFS) on Linux. Adversaries enumerate and collect files from network-accessible shares after gaining access to a host. This rule fires when a process reads from a path under common Linux mount points for remote filesystems, which is the primary OS mechanism for T1039 on Linux."
    mitre_tactic    = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that captures file read/open events with the initiating process path and the target file path. Auditd rules must include -a always,exit -F arch=b64 -S open,openat,read -k network_share_access."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Backup agents (rsync, bacula, amanda) reading from mounted shares; legitimate data pipeline jobs; sysadmin scripts performing authorized audits; monitoring tools traversing NFS home directories."
    tuning_guidance = "Add authorized backup or ETL process paths to %linux_allowed_share_readers. Add approved mount-point prefixes to %linux_approved_share_paths if your environment uses non-standard mount points. Consider narrowing by target.file.full_path regex to specific sensitive directories."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target file must reside under a Linux network share mount point.
    // Common conventions: /mnt/<share>, /media/<share>, /net/<host>,
    // /srv/nfs, /home on NFS automount, /run/user/<uid>/gvfs (GVFS CIFS).
    $file.target.file.full_path = /^(\/mnt\/|\/media\/|\/net\/|\/srv\/nfs\/|\/run\/user\/[0-9]+\/gvfs\/|\/var\/autofs\/)/ nocase

    // Exclude kernel threads and empty process paths (kernel I/O).
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /^\[/

    // Exclude processes that are explicitly allow-listed for this environment.
    not $file.principal.process.file.full_path in %linux_allowed_share_readers

    // Exclude the file path itself if it is in an approved share path list.
    not $file.target.file.full_path in %linux_approved_share_paths

    // Focus on processes that are commonly used for bulk data collection:
    // shells, archivers, copy utilities, scripting runtimes, and find/grep.
    // This avoids firing on every single NFS read by any process.
    $file.principal.process.file.full_path = /\/(bash|sh|zsh|dash|ksh|fish|python[23]?|perl|ruby|php|find|grep|egrep|fgrep|ripgrep|rg|cat|less|more|head|tail|cp|rsync|scp|tar|zip|gzip|bzip2|xz|7z|rar|dd|curl|wget|nc|ncat|socat|awk|sed|xargs)$/ nocase

  outcome:
    $risk_score        = max(70)
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity    = array_distinct($file.principal.hostname)

  condition:
    $file
}
