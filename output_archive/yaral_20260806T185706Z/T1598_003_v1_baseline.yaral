/*
  MITRE Technique : T1598.003 - Spearphishing Link
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:27:01.341515+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_003_Spearphishing_Link_Credential_Harvest_Attempt {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects HTTP traffic patterns consistent with spearphishing link delivery or credential-harvesting page visits observed at the network perimeter. Signals include IDS/IPS alerts on phishing-category traffic, connections to newly-seen or lookalike domains over HTTP/HTTPS, and suspicious URL structures (encoded redirects, credential-capture paths, @-symbol obfuscation, hex/integer hostnames) that are characteristic of T1598.003 reconnaissance phishing infrastructure."
    mitre_tactic         = "Reconnaissance"
    mitre_technique      = "T1598.003"
    mitre_technique_name = "Phishing for Information: Spearphishing Link"
    log_prerequisites    = "Requires IDS/IPS or network security appliance HTTP/HTTPS inspection logs normalised to UDM NETWORK_HTTP. URL decryption (TLS inspection) improves coverage significantly."
    platform             = "PRE"
    log_source           = "ips"
    false_positives      = "Marketing redirect services (click-tracking URLs), legitimate SSO portals with complex redirect parameters, URL-shortening services used by internal tooling, penetration-testing infrastructure."
    tuning_guidance      = "Add approved redirect/click-tracking domains to %global_allowed_redirect_domains. Add sanctioned SSO and login portal hostnames to %global_allowed_login_portals. Raise severity if the destination domain was registered within the last 30 days (enrich externally)."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Target URL exhibits one or more structural patterns associated with
    // credential-harvesting or phishing-link obfuscation.
    // Pattern 1: @-symbol obfuscation in the URL (real destination hidden after @)
    // Pattern 2: Hex or integer-encoded hostname (e.g. http://0xC0A80001/ or http://3232235521/)
    // Pattern 3: URL contains a redirect/forwarding parameter pointing to an external resource
    // Pattern 4: Path segments commonly cloned from login portals
    (
      $net.network.http.request_url = /@[a-zA-Z0-9\-\.]+\// nocase
      or
      $net.network.http.request_url = /https?:\/\/0x[0-9a-fA-F]{6,8}(\/|$)/ nocase
      or
      $net.network.http.request_url = /https?:\/\/[0-9]{8,10}(\/|$)/ nocase
      or
      $net.network.http.request_url = /[?&](url|redirect|redir|next|return|returnurl|goto|target|dest|destination|continue|forward|link|ref|referer|r|u)=https?%3A/ nocase
      or
      $net.network.http.request_url = /\/(login|signin|sign-in|secure|verify|account|update|confirm|auth|oauth|sso|portal|webmail|credential|password|reset|validate)(\/|\.|\?|$)/ nocase
    )

    // Exclude known-good login portals and redirect services
    not $net.target.hostname in %global_allowed_login_portals
    not $net.target.hostname in %global_allowed_redirect_domains

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1598.003")
    $primary_entity    = array_distinct($net.principal.ip)
    $suspicious_urls   = array_distinct($net.network.http.request_url)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
