/*
  MITRE Technique : T1037 - Boot or Logon Initialization Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:36:32.199035+00:00
  Reference       : https://attack.mitre.org/techniques/T1037
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_NetDevice_Boot_Logon_Script_Exfil_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable behaviour consistent with a boot or logon initialization script on a network device establishing an outbound connection to an external host. Adversaries implant scripts in device startup or logon sequences to beacon out, exfiltrate configuration data, or download additional payloads. This rule fires on outbound flows from network device management-plane addresses to non-RFC1918 destinations on ports commonly abused for this purpose (TFTP, FTP, HTTP, HTTPS, SCP/SSH, DNS)."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037"
    mitre_technique_name = "Boot or Logon Initialization Scripts"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs that capture source IP, destination IP, destination port, and bytes transferred. Management-plane source addresses must be identifiable via reference list."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate NTP, SNMP trap, syslog forwarding, or software update checks from management-plane addresses. Authorized TFTP-based config backups. Scheduled NetFlow/IPFIX exports."
    tuning_guidance = "Populate %network_device_mgmt_plane_ips with known management-plane and loopback addresses for all managed devices. Populate %approved_mgmt_destinations with authorized NMS, syslog, TFTP, and update server IPs. Narrow the port list if certain protocols are not used in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be a known network device management-plane address
    $net.principal.ip in %network_device_mgmt_plane_ips

    // Destination must NOT be an approved management destination
    not $net.target.ip in %approved_mgmt_destinations

    // Destination must NOT be internal RFC1918 / link-local space
    not $net.target.ip in %rfc1918_internal

    // Ports commonly abused by boot/logon scripts for staging or exfil:
    // 69=TFTP, 20/21=FTP, 22=SSH/SCP, 80=HTTP, 443=HTTPS, 53=DNS
    $net.target.port in [20, 21, 22, 53, 69, 80, 443]

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1037")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
