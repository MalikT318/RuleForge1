/*
  MITRE Technique : T1614 - System Location Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:35:06.087535+00:00
  Reference       : https://attack.mitre.org/techniques/T1614
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_System_Location_Discovery_Windows {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects process command-line activity consistent with System Location Discovery on Windows. Adversaries enumerate locale, time zone, keyboard layout, and language settings to determine geographic location of a victim host before deciding whether to proceed with full compromise or region-specific payloads. This rule targets the most direct behavioral signals: querying locale/timezone via built-in Windows utilities and PowerShell."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1614"
    mitre_technique_name = "System Location Discovery"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1). Command-line logging must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "IT asset management tools, software deployment agents (SCCM, Intune), system inventory scripts, helpdesk automation, and legitimate PowerShell administration scripts that query locale or timezone for configuration purposes."
    tuning_guidance = "Add known-good parent processes (e.g., management agents, deployment tools) to %global_allowed_sysinfo_parents. Add known-good process paths to %global_allowed_locale_query_procs. Narrow scope by requiring an unusual parent (e.g., Office, browser, script interpreter) if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target built-in Windows utilities commonly abused for locale/timezone/language discovery,
    // OR PowerShell/cmd used to query the same information.
    // We match on the combination of binary AND discovery-oriented arguments/cmdlets.
    (
      // tzutil.exe / - query current time zone
      (
        $proc.target.process.file.full_path = /\\tzutil\.exe$/ nocase
        and $proc.target.process.command_line = /\/g/ nocase
      )
      or
      // w32tm /tz - query time zone via Windows Time service
      (
        $proc.target.process.file.full_path = /\\w32tm\.exe$/ nocase
        and $proc.target.process.command_line = /\/tz/ nocase
      )
      or
      // systeminfo.exe - broad system info including locale and time zone
      (
        $proc.target.process.file.full_path = /\\systeminfo\.exe$/ nocase
      )
      or
      // reg.exe querying keyboard layout or locale registry keys
      (
        $proc.target.process.file.full_path = /\\reg\.exe$/ nocase
        and $proc.target.process.command_line = /(keyboard layout|nls\\locale|international|currentlocale|localename)/ nocase
      )
      or
      // PowerShell querying locale, culture, timezone, or keyboard layout
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and $proc.target.process.command_line = /(get-culture|get-timezone|get-winsystemlocale|currentculture|currentuiculture|keyboard layout|localename|win32_timezone|win32_operatingsystem.*locale|getlocaleinfoW|cultureinfo)/ nocase
      )
      or
      // wmic querying locale or timezone
      (
        $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase
        and $proc.target.process.command_line = /(locale|timezone|os get|operatingsystem)/ nocase
      )
    )

    // Exclude known-good management and deployment parent processes
    not $proc.principal.process.file.full_path in %global_allowed_sysinfo_parents

    // Exclude known-good process paths for locale queries
    not $proc.target.process.file.full_path in %global_allowed_locale_query_procs

  outcome:
    $risk_score        = max(45)
    $mitre_technique_id = array_distinct("T1614")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $child_process     = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
