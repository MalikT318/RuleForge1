/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:28:07.062908+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_IaaS_Account_Discovery_Enumeration_Burst {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Medium"
    description     = "Detects a cloud identity enumeration pattern: a principal first performs a broad IAM/directory list-users or list-accounts API call, then within 10 minutes issues a targeted get-user or describe-user call on a specific account. This two-step recon pattern (enumerate then inspect) is characteristic of adversarial account discovery in IaaS environments and is additive to existing process-launch detections."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). USER_RESOURCE_ACCESS events must include metadata.product_event_type or target.resource.name populated with the API operation name."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Cloud security posture tools (CSPM), SIEM connectors, HR provisioning pipelines, and authorised IAM auditing scripts that enumerate accounts as part of normal operations."
    tuning_guidance = "Add known automation service accounts and CSPM principals to %cloud_allowed_iam_enumeration_principals. Narrow the list-operation regex if only one cloud provider is in scope."

  events:
    // Event 1: broad account/user listing API call
    $list.metadata.event_type = "USER_RESOURCE_ACCESS"
    $list.metadata.product_event_type = /^(ListUsers|ListAccounts|ListGroupsForUser|ListAllMyBuckets|users\.list|identities\.list|ListServiceAccounts|list_users|list_accounts|Get-AzureADUser|ListDirectoryUsers)$/ nocase
    $list.principal.user.userid != ""
    not $list.principal.user.userid in %cloud_allowed_iam_enumeration_principals
    $list.principal.user.userid = $actor

    // Event 2: targeted single-account inspection API call on the same principal
    $get.metadata.event_type = "USER_RESOURCE_ACCESS"
    $get.metadata.product_event_type = /^(GetUser|DescribeUser|GetAccount|GetGroup|users\.get|identities\.get|GetServiceAccount|get_user|describe_user|Get-AzureADUserDetail|GetDirectoryUser)$/ nocase
    $get.target.resource.name != ""
    not $get.principal.user.userid in %cloud_allowed_iam_enumeration_principals
    $get.principal.user.userid = $actor

    // Chronological ordering: listing must precede targeted inspection
    $list.metadata.event_timestamp.seconds <= $get.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score          = max(65)
    $mitre_technique_id  = array_distinct("T1087")
    $primary_entity      = array_distinct($actor)
    $list_operations     = array_distinct($list.metadata.product_event_type)
    $get_operations      = array_distinct($get.metadata.product_event_type)
    $inspected_resources = array_distinct($get.target.resource.name)
    $source_ips          = array_distinct($list.principal.ip)
    $event_count         = count($get.metadata.id)

  condition:
    $list and $get
}
