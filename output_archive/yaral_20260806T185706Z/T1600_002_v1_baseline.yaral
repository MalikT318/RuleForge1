/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:28:31.738840+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_Disable_Crypto_Hardware {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects management-plane configuration changes that disable or remove dedicated hardware encryption (crypto engine, hardware accelerator, or IPsec offload) on a network device. Adversaries who have gained control of a network device may disable hardware crypto to force software-based encryption, weakening cipher performance and enabling easier traffic manipulation or interception."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Weaken Encryption: Disable Crypto Hardware"
    log_prerequisites = "Requires network device management-plane syslog or configuration-change audit logs normalised into Chronicle UDM SETTING_MODIFICATION events. Devices must forward syslog to Chronicle or a syslog collector feeding Chronicle."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Planned maintenance windows where hardware crypto modules are intentionally disabled; vendor-directed firmware upgrades that temporarily disable the crypto engine; automated configuration management tools (Ansible, NAPALM, Terraform) applying approved baseline changes."
    tuning_guidance = "Add authorised change-management service accounts to %global_allowed_netdev_admin_users. Add known maintenance-window hostnames to %global_allowed_netdev_maintenance_hosts. Scope the command_line / description regex if your normalisation pipeline populates a different UDM field for the CLI command."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Match configuration commands that disable hardware crypto engines,
    // hardware accelerators, or IPsec hardware offload.
    // Covers common vendor CLI patterns: "no crypto engine", "no hardware-encryption",
    // "crypto engine software-only", "no ip ipsec hardware-accelerator", etc.
    // The regex is intentionally broad to survive vendor normalisation differences.
    (
      $cfg.target.resource.attribute.labels["config_command"] = /no\s+(crypto\s+engine|hardware[\-_]encrypt|ip\s+ipsec\s+hardware|crypto\s+accelerat)/ nocase
      or
      $cfg.target.resource.attribute.labels["config_command"] = /crypto\s+engine\s+software[\-_]only/ nocase
      or
      $cfg.security_result.description = /(disabled?|remov|deactivat).{0,40}(crypto\s+engine|hardware\s+encrypt|ipsec\s+offload|hw[\-_]accelerat)/ nocase
      or
      $cfg.target.resource.name = /(crypto[\-_]engine|hw[\-_]encrypt|hardware[\-_]accelerat)/ nocase
    )

    // Exclude authorised administrators performing approved changes
    not $cfg.principal.user.userid in %global_allowed_netdev_admin_users

    // Exclude known maintenance hosts
    not $cfg.principal.hostname in %global_allowed_netdev_maintenance_hosts

  outcome:
    $risk_score        = max(90)
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity    = array_distinct($cfg.principal.hostname)
    $acting_user       = array_distinct($cfg.principal.user.userid)
    $target_device     = array_distinct($cfg.target.hostname)
    $config_command    = array_distinct($cfg.target.resource.attribute.labels["config_command"])

  condition:
    $cfg
}
