/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:12:51.149989+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_Invisible_Unicode_Network_Exfil_Or_C2 {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network flows or HTTP transactions that carry payloads consistent with invisible Unicode steganography (T1027.018) on macOS endpoints. Adversaries embed zero-width spaces, variation selectors, or bidirectional control characters inside otherwise benign-looking text to conceal encoded payloads. At the network layer this manifests as HTTP/S traffic whose User-Agent, URI, or body contains high-density non-printing Unicode sequences, or as IDS/IPS verdicts flagging Unicode obfuscation patterns in application-layer content. The rule pivots on the IDS/IPS alert verdict and traffic metadata rather than process command-line arguments, providing additive coverage beyond existing PROCESS_LAUNCH detections."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised into Chronicle UDM. The appliance must perform application-layer (L7) inspection and generate alerts or flow records for Unicode obfuscation, bidirectional text anomalies, or zero-width character sequences in HTTP payloads. Unified threat management (UTM) or next-gen IPS with deep-packet inspection is required."
    platform        = "macOS"
    log_source      = "ips"
    false_positives = "Internationalised web applications that legitimately use Unicode variation selectors or RTL/LTR marks in API payloads; multilingual SaaS platforms; some CDN health-check beacons; Unicode-aware testing frameworks."
    tuning_guidance = "Add approved destination CIDRs or hostnames to %global_allowed_unicode_destinations. Add known-good macOS process names (e.g. Software Update daemons) to %global_allowed_macos_updaters. Raise the threshold or narrow the security_result.category_details regex if the IDS signature set generates excessive alerts for legitimate i18n traffic."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Restrict to macOS source hosts by matching macOS-typical user-agent strings
    // or macOS process paths reported by the IDS sensor in the principal fields.
    // The regex covers Safari, macOS curl, python on Darwin, and osascript-driven
    // HTTP calls without hardcoding any specific version string.
    (
      $net.network.http.user_agent = /Mac\s*OS\s*X/                nocase or
      $net.network.http.user_agent = /Darwin/                       nocase or
      $net.network.http.user_agent = /CFNetwork/                    nocase or
      $net.principal.process.file.full_path = /\/(usr\/bin\/curl|usr\/bin\/python[23]?|usr\/bin\/osascript|Applications\/.+\.app\/Contents\/MacOS\/)/ nocase
    )

    // Core detection: IDS/IPS verdict or signature name references Unicode
    // obfuscation, zero-width characters, bidirectional controls, or invisible
    // character steganography. We match the normalised category or alert name
    // fields that Chronicle populates from IDS alert metadata.
    (
      $net.security_result.summary = /zero.?width/                  nocase or
      $net.security_result.summary = /invisible.?unicode/           nocase or
      $net.security_result.summary = /unicode.?obfuscat/            nocase or
      $net.security_result.summary = /bidi.?(control|override|embed|isolate)/ nocase or
      $net.security_result.summary = /variation.?selector/          nocase or
      $net.security_result.summary = /non.?print(ing)?.?unicode/    nocase or
      $net.security_result.summary = /homoglyph/                    nocase or
      $net.security_result.category_details = /zero.?width/         nocase or
      $net.security_result.category_details = /invisible.?unicode/  nocase or
      $net.security_result.category_details = /unicode.?obfuscat/   nocase or
      $net.security_result.category_details = /bidi.?(control|override|embed|isolate)/ nocase or
      $net.security_result.category_details = /variation.?selector/ nocase or
      $net.security_result.category_details = /non.?print(ing)?.?unicode/ nocase
    )

    // Exclude destinations explicitly approved for Unicode-heavy traffic
    not $net.target.hostname in %global_allowed_unicode_destinations

    // Exclude known macOS system update and telemetry processes that may
    // trigger Unicode-related signatures on Apple CDN endpoints
    not $net.principal.process.file.full_path in %global_allowed_macos_updaters

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity    = array_distinct($net.principal.hostname)
    $destination_host  = array_distinct($net.target.hostname)
    $destination_ip    = array_distinct($net.target.ip)
    $alert_summary     = array_distinct($net.security_result.summary)
    $user_agent        = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
