/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:11:40.620892+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_JunkCode_Script_Write_Then_Execute {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage pattern associated with junk-code-obfuscated payload delivery on Linux: a script or binary is first written to a world-writable or temporary staging path (FILE_CREATION), then executed within a short window (PROCESS_LAUNCH). Junk-code-padded payloads frequently land in /tmp, /dev/shm, or /var/tmp before execution because those paths are writable without privilege. The correlation of write-then-execute on the same host and file path provides behavioral coverage that is additive to command-line-only detections."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that emits both FILE_CREATION events (with target.file.full_path) and PROCESS_LAUNCH events (with target.process.file.full_path and principal.process.file.full_path). Auditd rules for -a always,exit -F arch=b64 -S execve and inotify/fanotify file-write events must be active."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Package managers (apt, yum, dnf, rpm) extracting scripts to /tmp; legitimate build systems (cmake, make, gradle) writing and executing test binaries; container runtimes unpacking layers; configuration management agents (Ansible, Chef, Puppet) staging scripts; developer workflows running locally compiled binaries from /tmp."
    tuning_guidance = "Add trusted parent process paths to %linux_allowed_staging_parents (e.g. package manager paths). Add approved staging directories to %linux_allowed_staging_paths. Narrow the file extension regex if your environment never legitimately executes shell scripts from /tmp."

  events:
    // --- Leg 1: file written to a world-writable staging path ---
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/shm\/)/ nocase
    // Must look like an executable or script, not a random data file
    $file.target.file.full_path = /\.(sh|py|pl|rb|elf|bin|out|run|bash|zsh|ksh|csh|tcsh|fish|lua|php|js|ts)$|^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/shm\/)[^.\/]+$/ nocase
    not $file.principal.process.file.full_path in %linux_allowed_staging_parents
    $file.principal.hostname = $hostname
    // Capture the staged file path as a join key
    $file.target.file.full_path = $staged_path

    // --- Leg 2: the staged file is subsequently executed ---
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/shm\/)/ nocase
    not $proc.principal.process.file.full_path in %linux_allowed_staging_parents
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $staged_path

    // Chronological ordering: write must precede execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $staged_path over 5m

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $staged_file_paths = array_distinct($proc.target.process.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $executing_process = array_distinct($proc.principal.process.file.full_path)
    $executing_user    = array_distinct($proc.principal.user.userid)
    $event_count       = count($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
