/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:58:52.271560+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_macOS_VM_Detection_System_Checks {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes on macOS performing system checks commonly used to identify virtual machine or sandbox environments. Adversaries enumerate hardware model, hypervisor presence, CPU features, screen size, or VM-specific files via system_profiler, ioreg, sysctl, or similar utilities to decide whether to proceed with payload execution."
    mitre_tactic    = "Defense Evasion, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Requires macOS EDR telemetry with process command-line capture (e.g., CrowdStrike Falcon, SentinelOne, Jamf Protect, or macOS Endpoint Security Framework events normalised to UDM PROCESS_LAUNCH)."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "IT asset inventory scripts, MDM agents (Jamf, Mosyle), developer tooling (Vagrant, Docker Desktop), virtualisation management software, and security scanners that legitimately query hardware identifiers."
    tuning_guidance = "Add known-good parent process paths (MDM agents, approved admin tools) to %macos_allowed_sysinfo_parents. Add known-good process paths to %macos_allowed_sysinfo_binaries. Narrow the command-line regex if specific VM artifact strings generate noise in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target the macOS utilities most commonly abused for VM/sandbox fingerprinting
    $proc.target.process.file.full_path = /\/(system_profiler|ioreg|sysctl|sw_vers|uname|diskutil|vm_stat|hostinfo|hwprefs|system_info|scutil|nvram|kextstat|csrutil)$/ nocase

    // Command-line arguments that specifically probe VM/hypervisor/sandbox artefacts:
    // - ioreg: IOPlatformExpertDevice (model, serial), AppleHV, VMware, VirtualBox, Parallels
    // - sysctl: hw.model, kern.hv_vmm_present, machdep.cpu.features
    // - system_profiler: SPHardwareDataType, SPSoftwareDataType
    // - nvram: boot-args (hypervisor flags)
    // - kextstat: loaded kernel extensions (VMware, VirtualBox, Parallels kexts)
    $proc.target.process.command_line = /(IOPlatformExpertDevice|AppleHV|VMware|VirtualBox|Parallels|VBOX|hv_vmm_present|hw\.model|machdep\.cpu\.features|SPHardwareDataType|hypervisor|kern\.hv|boot\-args|com\.vmware|org\.virtualbox|prl_|parallels|sandbox|SandboxBroker|sbx|analysis|cuckoo|inetsim)/ nocase

    // Exclude known-good administrative parent processes and approved binaries
    not $proc.principal.process.file.full_path in %macos_allowed_sysinfo_parents
    not $proc.target.process.file.full_path in %macos_allowed_sysinfo_binaries

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_binary = array_distinct($proc.target.process.file.full_path)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
