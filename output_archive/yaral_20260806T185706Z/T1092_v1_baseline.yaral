/*
  MITRE Technique : T1092 - Communication Through Removable Media
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:40:27.247201+00:00
  Reference       : https://attack.mitre.org/techniques/T1092
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1092_Removable_Media_CnC_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation activity consistent with command-and-control staging via removable media. Adversaries compromise an air-gapped host, write commands or exfiltrated data to a removable drive, then retrieve them from an internet-connected host. This rule fires when a process writes files with command-staging or data-collection naming patterns to a removable-media drive letter path, which is the core OS mechanism T1092 depends on."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1092"
    mitre_technique_name = "Communication Through Removable Media"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file-write events) normalised into Chronicle UDM FILE_CREATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate backup software writing to USB drives, portable application installers, IT asset imaging tools, removable-media encryption agents (e.g. BitLocker To Go setup), and developer workflows copying build artefacts to USB."
    tuning_guidance = "Add trusted backup or imaging process paths to %global_allowed_removable_media_writers. Narrow the file-name regex if specific staging file patterns are known in your environment. Consider adding a parent-process filter to exclude known backup agents."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target a removable-media drive letter path.
    // Windows assigns drive letters E: through Z: for removable/external media.
    // The regex anchors to a single uppercase letter in the E-Z range followed
    // by a colon and backslash, covering the vast majority of USB/removable mounts.
    $file.target.file.full_path = /^[E-Z]:\\/  nocase

    // Match file names that suggest command staging, task queuing, data collection,
    // or covert relay artefacts. Patterns include: hidden-dot files, files named
    // cmd/task/job/order/collect/result/output/beacon/sync/relay/payload/stage,
    // and common script extensions dropped to removable media.
    (
      $file.target.file.full_path = /\\(cmd|task|job|order|collect|result|output|beacon|sync|relay|payload|stage|exfil|data|harvest|drop|signal|trigger|queue|inbox|outbox|transfer)[^\\]*\.(txt|dat|bin|tmp|log|csv|json|xml|ps1|bat|cmd|vbs|js|py|sh)$/ nocase
      or
      $file.target.file.full_path = /\\\.[^\\]+\.(txt|dat|bin|tmp|log|csv|json|xml|ps1|bat|cmd|vbs|js|py|sh)$/ nocase
    )

    // Exclude processes that are known-good writers to removable media.
    not $file.principal.process.file.full_path in %global_allowed_removable_media_writers

    // Exclude Windows system paths as the writing process - legitimate OS
    // components rarely write staging-named files to removable drives.
    not $file.principal.process.file.full_path = /^[Cc]:\\[Ww]indows\\[Ss]ystem32\\/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1092")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $staged_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
