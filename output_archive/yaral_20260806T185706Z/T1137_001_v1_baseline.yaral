/*
  MITRE Technique : T1137.001 - Office Template Macros
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:46:24.679728+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_001_Office_Template_Macro_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification or upload of Office template files (e.g. Normal.dotm, Personal.xlsb, *.dotm, *.xltm, *.xlsm) via Microsoft 365 unified audit logs. Adversaries abuse Office templates to embed persistent VBA macros that execute each time the Office application starts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.001"
    mitre_technique_name = "Office Application Startup: Office Template Macros"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log with SharePoint, OneDrive, and Exchange workload events normalised into Chronicle UDM. File operation events must be enabled in the M365 compliance portal."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate IT-managed Office template deployments, centralised template libraries managed by document management teams, OneDrive sync of user profile folders during device migrations."
    tuning_guidance = "Add known template-management service accounts to %m365_allowed_template_editors. Add approved SharePoint template library paths to %m365_allowed_template_paths. Scope to high-value user populations first."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"

    // Target file must match a macro-capable Office template extension
    $cloud.target.file.full_path = /\.(dotm|dotx|xltm|xlsm|xlsb|potm|pptm)$/ nocase

    // Catch the canonical persistent template filenames with high fidelity
    // OR any macro-enabled template write to a templates/startup path
    (
      $cloud.target.file.full_path = /Normal\.dotm$/ nocase
      or
      $cloud.target.file.full_path = /Personal\.xlsb$/ nocase
      or
      $cloud.target.file.full_path = /\/Templates\// nocase
      or
      $cloud.target.file.full_path = /\/XLSTART\// nocase
      or
      $cloud.target.file.full_path = /\/Startup\// nocase
      or
      $cloud.target.file.full_path = /\/AppData\// nocase
    )

    // Actor must be a real user principal (not a system/service account pattern)
    $cloud.principal.user.userid != ""

    // Exclude known approved template management accounts and paths
    not $cloud.principal.user.userid in %m365_allowed_template_editors
    not $cloud.target.file.full_path in %m365_allowed_template_paths

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $modified_template = array_distinct($cloud.target.file.full_path)
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
