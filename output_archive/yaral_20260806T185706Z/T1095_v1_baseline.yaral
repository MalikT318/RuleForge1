/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:40:51.674983+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_NonAppLayer_Protocol_Raw_Socket_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes on Linux that open raw sockets or invoke utilities commonly used to tunnel C2 traffic over non-application-layer protocols (ICMP, UDP, SOCKS). Adversaries use raw socket access or protocol-tunneling tools to bypass application-layer monitoring. The rule targets process launches that combine raw-socket-capable binaries with flags or invocation patterns consistent with covert channel establishment rather than legitimate diagnostic use."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "Requires Linux EDR or auditd process-execution telemetry normalised to UDM PROCESS_LAUNCH. Auditd syscall rules for execve are sufficient; EDR agents that capture full command lines are preferred."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Network engineers running legitimate ping/hping3 diagnostics, security teams running authorised penetration tests, monitoring agents using ICMP health checks, VPN daemons (e.g. OpenVPN, WireGuard) that legitimately use raw sockets."
    tuning_guidance = "Add known-good parent process paths (e.g. monitoring agent full paths) to %linux_allowed_raw_socket_parents. Add authorised tunnel binary paths to %linux_allowed_tunnel_binaries. Narrow the command-line regex if hping3 or nping are used legitimately in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match binaries commonly abused to establish raw-socket or protocol-tunnel C2 channels.
    // Targets the binary name rather than a fixed path to survive symlinks and /usr/local installs.
    // Covers: hping3 (raw ICMP/UDP), nping (raw packet crafting), ptunnel/ptunnel-ng (ICMP tunnel),
    //         icmptunnel, udptunnel, iodine (DNS-over-UDP), hans (ICMP VPN), socat (raw socket relay),
    //         ncat/nc with raw options, and python/perl one-liners invoking socket.SOCK_RAW.
    (
      $proc.target.process.file.full_path = /\/(hping3|hping2|nping|ptunnel|ptunnel-ng|icmptunnel|udptunnel|iodine|iodined|hans|socat)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(python[23]?|perl|ruby|bash|sh|dash)$/ nocase
        and
        $proc.target.process.command_line = /SOCK_RAW|IPPROTO_ICMP|IPPROTO_RAW|socket\.SOCK_RAW/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/(nc|ncat|netcat)$/ nocase
        and
        $proc.target.process.command_line = /\-u\s|\-\-udp\s|\-\-sctp/ nocase
      )
    )

    // Exclude known-good parent processes (e.g. authorised monitoring agents, CI pipelines).
    not $proc.principal.process.file.full_path in %linux_allowed_raw_socket_parents

    // Exclude known-good tunnel binary invocations (e.g. authorised VPN tooling).
    not $proc.target.process.file.full_path in %linux_allowed_tunnel_binaries

    // Exclude interactive diagnostic sessions launched directly from a terminal by ops users.
    // Processes with a controlling TTY and a short-lived parent shell are lower fidelity;
    // however we keep the rule broad and rely on the exclusion lists above for tuning.

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggered_binary  = array_distinct($proc.target.process.file.full_path)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
