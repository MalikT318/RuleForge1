/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:07:57.713268+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_MOTW_Bypass_Container_Mount_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of processes whose parent is a container-mounting or archive-extraction host process (Explorer, WScript, CScript, msiexec, or similar) where the child process is launched from a path consistent with a mounted disk image or extracted archive. This targets the MOTW bypass technique where payloads inside ISO, VHD, IMG, or archive containers do not inherit the Zone.Identifier ADS and therefore bypass SmartScreen and Office Protected View."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line and parent/child process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software distributed as ISO (e.g., Visual Studio, OS media). Developers mounting VHD/VHDX for testing. Corporate software packaged in disk images. Archive extraction by authorised deployment tools."
    tuning_guidance = "Populate %motw_bypass_allowed_parents with approved parent process paths (e.g., deployment agents). Populate %motw_bypass_allowed_exec_paths with known-good software installation paths inside mounted volumes. Narrow scope by adding business-unit exclusions for software distribution hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child process launched from a path that is characteristic of a mounted
    // disk image (drive letter assigned by Windows virtual disk service) or
    // a temp/user extraction directory - use a broad regex covering common
    // patterns without hardcoding specific usernames.
    (
      // Mounted ISO/VHD volumes are assigned a drive letter; processes launched
      // directly from the root or shallow path of such a volume are suspicious
      // when the parent is a shell or document host.
      $proc.target.process.file.full_path = /^[D-Zd-z]:\\[^\\]{1,64}\\[^\\]+\.(exe|dll|com|scr|bat|cmd|vbs|js|hta|ps1)$/ nocase
      or
      // Extraction to user temp or downloads directories
      $proc.target.process.file.full_path = /\\(Users|users)\\[^\\]+\\(AppData\\Local\\Temp|Downloads|Desktop)\\[^\\]+\.(exe|dll|com|scr|bat|cmd|vbs|js|hta|ps1)$/ nocase
    )

    // Parent process is a shell, document host, or archive handler -
    // these are the processes that mount/extract and then launch child content.
    $proc.principal.process.file.full_path = /\\(explorer|wscript|cscript|mshta|rundll32|regsvr32|msiexec|7z|winrar|winzip|peazip|bandizip|powershell|pwsh|cmd)\.exe$/ nocase

    // Child is a scripting engine, shell, or executable - not a known installer
    // subprocess. Catches payloads that immediately invoke a living-off-the-land binary.
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|msiexec|wmic|cmstp|installutil|regasm|regsvcs|msbuild|odbcconf|ieexec|pcalua|forfiles|scriptrunner|syncappvpublishingserver|appsyncpublishingserver|control|infdefaultinstall|presentationhost|xwizard|msiexec|expand|extrac32|esentutl|replace|makecab|desktopimgdownldr|finger|ftp|curl|wget)\.exe$/ nocase

    // Exclude approved parent processes and known-good execution paths
    not $proc.principal.process.file.full_path in %motw_bypass_allowed_parents
    not $proc.target.process.file.full_path in %motw_bypass_allowed_exec_paths

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
