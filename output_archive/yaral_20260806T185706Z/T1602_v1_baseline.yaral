/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:29:47.841518+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_Config_Repo_Exfil_via_DNS_TXT_Tunneling {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential exfiltration of network device configuration data via DNS tunneling. Adversaries abusing T1602 may exfiltrate SNMP community strings, device configs, or management credentials by encoding data in DNS TXT or NULL record queries. This rule flags anomalously long subdomain labels and TXT/NULL query types originating from network device management segments, which are strong indicators of DNS-based data exfiltration from configuration repositories."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Requires DNS query/resolver logs forwarded to Chronicle. Resolver must log query type, queried name, and source IP. Recursive resolver or network tap DNS visibility recommended."
    platform = "Network Devices"
    log_source = "dns"
    false_positives = "Legitimate TXT record lookups for SPF/DKIM validation from management hosts, automated certificate provisioning (ACME DNS-01 challenges), monitoring tools that use DNS TXT for health checks."
    tuning_guidance = "Add known-good management tool source IPs to %dns_allowed_mgmt_sources. Add approved domains that legitimately use TXT records to %dns_allowed_txt_domains. Raise the subdomain label length threshold if internal naming conventions use long labels."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Target anomalous DNS record types used for tunneling/exfiltration
    // TXT (16), NULL (10), and ANY (255) are commonly abused for data encoding
    (
      $dns.network.dns.questions.type = 16 or
      $dns.network.dns.questions.type = 10 or
      $dns.network.dns.questions.type = 255
    )

    // Detect long subdomain labels indicative of base64/hex-encoded config data
    // Legitimate hostnames rarely exceed 40 characters in a single label
    $dns.network.dns.questions.name = /[a-zA-Z0-9+\/=_\-]{45,}\.[a-zA-Z0-9\-]+\.[a-zA-Z]{2,}/ nocase

    // Exclude known-good domains that legitimately use TXT records
    not $dns.network.dns.questions.name in %dns_allowed_txt_domains

    // Exclude known-good management source IPs (e.g., authorised IPAM, monitoring)
    not $dns.principal.ip in %dns_allowed_mgmt_sources

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_name = array_distinct($dns.network.dns.questions.name)
    $query_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
