/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:29:09.502374+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Network_Device_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects outbound or inbound file transfer activity over protocols commonly used to stage or replace network device OS images (TFTP, FTP, SCP, SFTP). An adversary patching a system image will typically pull a modified image onto the device or push the current image out for offline modification using these management-plane protocols. A connection to or from a network device on these ports - especially to an external or unexpected host - is a high-fidelity indicator of T1601.001."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs that capture source/destination IP and destination port. Connections must be logged for management-plane protocols (TFTP UDP/69, FTP TCP/20-21, SCP/SFTP TCP/22 when originating from network device management addresses)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized network device OS upgrades performed by network operations teams, automated backup jobs using SCP/SFTP, jump-host initiated SCP sessions to managed devices. Port 22 will generate significant noise without management-subnet scoping."
    tuning_guidance = "Populate %allowed_image_transfer_sources with authorized management hosts and jump servers. Populate %allowed_image_transfer_destinations with approved TFTP/FTP/SCP servers. Narrow port 22 detections by also requiring the source to be in a known network device management subnet reference list. Consider raising severity to Critical when destination is not in %allowed_image_transfer_destinations."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target protocols used to transfer network device OS images:
    // TFTP (UDP 69), FTP control (TCP 21), FTP data (TCP 20),
    // SCP/SFTP (TCP 22) - included because SCP is the dominant
    // modern image-transfer method on network devices.
    (
      $net.target.port = 69 or
      $net.target.port = 20 or
      $net.target.port = 21 or
      $net.target.port = 22
    )

    // Source must originate from a known network device management address space.
    // This scopes port 22 away from general server-to-server SSH and focuses
    // the rule on management-plane initiated transfers.
    $net.principal.ip in %network_device_mgmt_subnets

    // Destination must NOT be an approved image-transfer server.
    // This catches transfers to unexpected or attacker-controlled hosts.
    not $net.target.ip in %allowed_image_transfer_destinations

    // Exclude known authorized management sources to reduce noise from
    // legitimate upgrade workflows initiated by the NOC.
    not $net.principal.ip in %allowed_image_transfer_sources

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
