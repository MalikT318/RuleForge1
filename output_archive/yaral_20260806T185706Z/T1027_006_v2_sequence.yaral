/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:04:56.445851+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_HTMLSmuggling_FileDropThenSuspiciousLogin {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a potential HTML Smuggling payload delivery chain observed through identity telemetry: a user account that authenticates successfully is followed within 5 minutes by a second authentication event from a different country or with an anomalous risk signal, suggesting the smuggled payload may have harvested credentials or established a foothold that triggered a suspicious sign-in. This provides additive coverage beyond process-launch command-line rules by pivoting on identity-plane anomalies rather than endpoint execution."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires identity provider sign-in logs normalised to UDM USER_LOGIN events. Risk signals, country/region fields, and MFA result fields must be populated by the identity provider. Tested against Entra ID and Okta sign-in log UDM normalisation."
    platform        = "Windows"
    log_source      = "identity"
    false_positives = "Legitimate users travelling internationally, VPN exit-node changes between sessions, split-tunnel configurations, users with multiple registered devices in different regions, automated service accounts with broad geographic footprints."
    tuning_guidance = "Add known service-account userids to %global_allowed_service_accounts. Add approved federated or VPN source countries to %global_approved_countries. Raise the time window if your identity provider batches events with delay."

  events:
    // First event: a successful interactive login (baseline session)
    $auth1.metadata.event_type = "USER_LOGIN"
    $auth1.security_result.summary = /success/ nocase
    $auth1.target.user.userid = $userid
    $auth1.principal.location.country_or_region = $country1
    not $auth1.target.user.userid in %global_allowed_service_accounts

    // Second event: another login for the same user from a DIFFERENT country
    // or carrying a risk/anomaly signal — indicative of credential abuse
    // following a smuggled payload execution
    $auth2.metadata.event_type = "USER_LOGIN"
    $auth2.target.user.userid = $userid
    $auth2.principal.location.country_or_region = $country2
    not $auth2.principal.location.country_or_region = $country1
    not $auth2.target.user.userid in %global_allowed_service_accounts
    not $auth2.principal.location.country_or_region in %global_approved_countries

    // Chronological ordering: baseline login precedes the anomalous login
    $auth1.metadata.event_timestamp.seconds <= $auth2.metadata.event_timestamp.seconds

  match:
    $userid over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1027.006")
    $primary_entity      = array_distinct($userid)
    $baseline_country    = array_distinct($auth1.principal.location.country_or_region)
    $anomalous_country   = array_distinct($auth2.principal.location.country_or_region)
    $baseline_ip         = array_distinct($auth1.principal.ip)
    $anomalous_ip        = array_distinct($auth2.principal.ip)
    $login_count         = count($auth2.metadata.event_timestamp.seconds)

  condition:
    $auth1 and $auth2
}
