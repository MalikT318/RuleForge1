/*
  MITRE Technique : T1525 - Implant Internal Image
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:01:42.133730+00:00
  Reference       : https://attack.mitre.org/techniques/T1525
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1525_Implant_Internal_Container_Image {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects container image push or import operations against an internal registry via cloud audit logs. Adversaries implant backdoored images into a victim-controlled registry to achieve persistence; every subsequent workload pull re-executes the malicious payload. This rule fires on the API call that writes a new image layer or tag to the registry."
    mitre_tactic    = "Persistence"
    mitre_technique = "T1525"
    mitre_technique_name = "Implant Internal Image"
    log_prerequisites = "Cloud provider audit logs must capture container registry write-plane API calls (e.g., image push, tag creation, import). Chronicle UDM event type: RESOURCE_CREATION."
    platform        = "Containers"
    log_source      = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines pushing build artifacts, authorized base-image updates, infrastructure-as-code automation, and container scanning tools that re-tag images."
    tuning_guidance = "Populate %allowed_cicd_service_accounts with known pipeline identities and %allowed_registry_namespaces with approved image repositories. Restrict the rule to production namespaces by tightening the target.resource.name regex."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Match registry image write operations across major cloud providers
    // normalised into UDM resource type strings
    (
      $cloud.target.resource.resource_type = "CONTAINER_IMAGE" or
      $cloud.target.resource.resource_subtype = /image|layer|manifest|tag/ nocase
    )

    // API method names that represent a push, import, or tag operation
    // Chronicle normalises vendor-specific method names into target.resource.attribute.labels
    // and/or metadata.description; match the common vocabulary
    (
      $cloud.target.resource.name = /push|import|upload|put.*image|create.*image|tag/ nocase or
      $cloud.metadata.description = /push|import|upload|put.*image|create.*image|tag/ nocase
    )

    // Exclude known-good CI/CD service accounts and automation identities
    not $cloud.principal.user.userid in %allowed_cicd_service_accounts

    // Exclude approved registry namespaces / repositories
    not $cloud.target.resource.name in %allowed_registry_namespaces

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1525")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $registry_target   = array_distinct($cloud.target.resource.name)
    $source_ip         = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
