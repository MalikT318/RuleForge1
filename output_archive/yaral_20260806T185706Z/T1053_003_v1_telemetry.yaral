/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:15:19.814472+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_Cron_Persistence_Network_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects periodic low-volume outbound connections from macOS hosts that are consistent with cron-scheduled beaconing. Cron jobs executing malicious payloads often produce highly regular, low-byte outbound connections to external destinations on non-standard ports. This rule fires on firewall/perimeter telemetry and is additive to process-creation detections for T1053.003."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised into Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION events. Logs must include bytes_sent, target.port, and target.ip."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Legitimate software update checks, telemetry agents, monitoring daemons, and cloud sync clients that poll on a fixed schedule. Tune using %global_allowed_beacon_destinations and %global_allowed_beacon_ports."
    tuning_guidance = "Add known-good external polling destinations to %global_allowed_beacon_destinations. Add approved scheduled-task destination ports to %global_allowed_beacon_ports. Raise the bytes threshold if legitimate agents in the environment send larger keepalives."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Exclude RFC-1918 and loopback - cron beacons phone home externally
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_beacon_destinations

    // Non-standard ports commonly abused by scheduled callback implants
    // Excludes well-known web (80, 443, 8080, 8443) to reduce noise from
    // legitimate update checks; analysts should create a companion rule for
    // those ports with tighter byte-count thresholds if needed
    not $net.target.port = 80
    not $net.target.port = 443
    not $net.target.port = 8080
    not $net.target.port = 8443
    not $net.target.port in %global_allowed_beacon_ports

    // Small outbound payload - characteristic of a cron-driven check-in
    // rather than a bulk data transfer or interactive session
    $net.network.sent_bytes > 0
    $net.network.sent_bytes < 2048

    // Firewall logs do not carry process context; match on source host only
    $net.principal.hostname != ""

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_port = array_distinct($net.target.port)
    $destination_ip = array_distinct($net.target.ip)
    $bytes_out = max($net.network.sent_bytes)

  condition:
    $net
}
