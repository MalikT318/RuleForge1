/*
  MITRE Technique : T1588.005 - Exploits
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:23:54.571295+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_005_Exploit_Delivery_Pattern_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network traffic patterns consistent with exploit delivery or exploit kit activity observed at the network perimeter. Focuses on repeated inbound connection attempts to sensitive service ports combined with IDS/IPS alert verdicts, which may indicate an adversary probing or delivering acquired exploits against externally facing assets. T1588.005 covers adversaries obtaining exploits for use in targeting."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.005"
    mitre_technique_name = "Obtain Capabilities: Exploits"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW events. Security result category and severity fields must be populated by the normalisation parser."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate vulnerability scanners (Qualys, Tenable, Rapid7) run by the customer or an authorised third party. Penetration testing engagements. Misconfigured load balancers generating repeated connection resets. Noisy internet background radiation against common ports."
    tuning_guidance = "Add authorised scanner source IPs or CIDR ranges to %global_allowed_scanners. Add internal pentest source ranges to %global_pentest_sources. Raise the target port list specificity if false-positive volume is high on non-sensitive ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target ports commonly associated with exploit delivery against
    // web-facing services, remote access, and application frameworks.
    // Covers HTTP, HTTPS, SMB, RDP, SSH, WinRM, Oracle, MSSQL, MySQL,
    // PostgreSQL, VNC, Telnet, FTP, and common alternate-web ports.
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 22 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 1521 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 5432 or
      $net.target.port = 5900 or
      $net.target.port = 23 or
      $net.target.port = 21 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 8888 or
      $net.target.port = 9200 or
      $net.target.port = 6379
    )

    // IDS/IPS must have flagged this traffic with an exploit or
    // attack-category verdict. Use category_details as primary signal
    // since security_result.action mapping is inconsistent across vendors.
    $net.security_result.category_details = /exploit|attack|intrusion|shellcode|overflow|injection|traversal|rce|lfi|rfi|sqli|xss|webshell|malicious/ nocase

    // Severity must indicate a meaningful alert, not informational noise.
    $net.security_result.severity = "HIGH" or
    $net.security_result.severity = "CRITICAL" or
    $net.security_result.severity = "MEDIUM"

    // Exclude authorised scanning and pentest sources.
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_pentest_sources

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1588.005")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $targeted_port = array_distinct($net.target.port)
    $alert_category = array_distinct($net.security_result.category_details)

  condition:
    $net
}
