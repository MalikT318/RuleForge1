/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:47:52.999116+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_MacOS_Browser_Extension_Network_Install {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network-layer signals consistent with browser extension installation or update activity from suspicious or anomalous sources on macOS endpoints. Targets HTTP/HTTPS flows to browser extension distribution paths (e.g., Chrome Web Store, Firefox AMO, Edge Add-ons) that may indicate silent or adversary-directed extension installs, including connections to non-canonical update endpoints that could represent a hijacked extension update URL pointing to an adversary-controlled server."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Browser Extensions"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM. HTTP metadata including URI path and user-agent must be populated. TLS SNI or HTTP Host header must be visible to the sensor."
    platform = "macOS"
    log_source = "ips"
    false_positives = "Legitimate browser extension installs from official stores, enterprise-managed extension deployments via MDM, automated browser update mechanisms, developer sideloading during testing."
    tuning_guidance = "Add approved extension distribution hostnames to %allowed_extension_hosts. Add known enterprise MDM source IPs to %allowed_mdm_sources. Narrow the rule to flag only non-store update endpoints by extending the hostname regex to exclude canonical store FQDNs."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Match URI paths characteristic of browser extension package downloads (.crx for Chromium, .xpi for Firefox, .nex for Edge legacy)
    // or extension update manifest requests, which are the mechanism adversaries hijack to redirect updates to attacker infrastructure
    (
      $net.target.url = /\.(crx|xpi|nex)(\?|$)/ nocase
      or
      $net.target.url = /\/updatecheck|\/update2|\/updates\.xml|\/update\.json/ nocase
      or
      $net.network.http.request_headers = /extensionid|x-client-data/ nocase
    )

    // Exclude connections to well-known, canonical browser extension distribution infrastructure
    // Adversary-controlled update servers will NOT match these official store hostnames
    not $net.target.hostname = /clients2\.google\.com$/ nocase
    not $net.target.hostname = /chrome\.google\.com$/ nocase
    not $net.target.hostname = /addons\.mozilla\.org$/ nocase
    not $net.target.hostname = /services\.addons\.mozilla\.org$/ nocase
    not $net.target.hostname = /versioncheck\.addons\.mozilla\.org$/ nocase
    not $net.target.hostname = /microsoftedge\.microsoft\.com$/ nocase
    not $net.target.hostname = /edge\.microsoft\.com$/ nocase
    not $net.target.hostname = /extensionwebstorebase\.googleapis\.com$/ nocase

    // Exclude approved enterprise-managed extension sources and known MDM infrastructure
    not $net.target.hostname in %allowed_extension_hosts
    not $net.principal.ip in %allowed_mdm_sources

  outcome:
    $risk_score = max(62)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($net.principal.ip)
    $suspicious_url = array_distinct($net.target.url)
    $destination_host = array_distinct($net.target.hostname)

  condition:
    $net
}
