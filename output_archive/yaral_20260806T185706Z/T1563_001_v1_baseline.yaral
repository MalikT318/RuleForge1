/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:12:54.745073+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_SSH_Agent_Socket_Hijack {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes accessing another user's SSH agent socket, a primary mechanism for SSH session hijacking. An adversary with root or elevated access can connect to a victim's SSH_AUTH_SOCK socket to impersonate that user's SSH keys and pivot laterally without knowing credentials. This rule fires when a non-ssh process opens or interacts with an SSH agent socket path owned by a different user context, or when a shell process is launched with SSH_AUTH_SOCK explicitly set to a path under another user's runtime directory."
    mitre_tactic         = "Lateral Movement"
    mitre_technique      = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites    = "Requires Linux EDR or auditd telemetry with process launch events including command-line arguments and environment variables, or file-open syscall events for /tmp/ssh-* and /run/user/*/gnupg/S.gpg-agent.ssh socket paths."
    platform             = "Linux"
    log_source           = "linux_endpoint"
    false_positives      = "Legitimate SSH multiplexing tools (e.g. ControlMaster configurations), authorized PAM modules, SSH agent forwarding by automation frameworks (Ansible, Fabric), and privileged monitoring daemons that inspect agent sockets."
    tuning_guidance      = "Add known automation service accounts to %ssh_hijack_allowed_users. Add approved orchestration tool paths to %ssh_hijack_allowed_processes. Narrow scope by requiring principal.user.userid = 'root' if your EDR reliably populates that field."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target: process command line references an SSH agent socket path
    // SSH agent sockets live under /tmp/ssh-<random>/ or /run/user/<uid>/
    (
      $proc.target.process.command_line = /\/tmp\/ssh-[A-Za-z0-9]+\/agent\.[0-9]+/ nocase
      or
      $proc.target.process.command_line = /\/run\/user\/[0-9]+\/.*ssh/ nocase
      or
      $proc.target.process.command_line = /SSH_AUTH_SOCK\s*=\s*\/tmp\/ssh-/ nocase
      or
      $proc.target.process.command_line = /SSH_AUTH_SOCK\s*=\s*\/run\/user\// nocase
    )

    // The launching process is a shell or common lateral movement enabler,
    // not the ssh-agent daemon itself
    not $proc.target.process.file.full_path = /\/usr\/(bin|sbin)\/ssh-agent$/ nocase
    not $proc.target.process.file.full_path = /\/usr\/(bin|sbin)\/ssh$/ nocase

    // Exclude known-safe orchestration process paths
    not $proc.principal.process.file.full_path in %ssh_hijack_allowed_processes

    // Exclude approved automation service accounts
    not $proc.principal.user.userid in %ssh_hijack_allowed_users

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $acting_user       = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
