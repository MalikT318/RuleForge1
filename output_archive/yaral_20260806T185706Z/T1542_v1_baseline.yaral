/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:04:25.899055+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_PreOS_Boot_Firmware_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects process launches indicative of Pre-OS Boot tampering on Windows, including tools that interact with UEFI/BIOS firmware, bootloader modification utilities, and BCDEdit invocations that alter boot configuration. Adversaries abuse these mechanisms to establish persistence below the OS layer, making detection by host-based defenses extremely difficult."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (Process Create) with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate OS updates (Windows Update, OEM firmware update utilities), dual-boot configuration by IT, BitLocker provisioning scripts, recovery environment setup by administrators."
    tuning_guidance = "Add known-good firmware update parent processes (e.g., Windows Update service host, OEM update agents) to %global_allowed_firmware_tools. Scope by principal.user.userid to exclude dedicated patch management service accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match processes that directly interact with boot/firmware mechanisms.
    // BCDEdit: Windows Boot Configuration Data editor - commonly abused to
    // disable recovery, alter boot order, or inject bootkit entries.
    // bootsect: rewrites the Master Boot Record or Volume Boot Record.
    // reagentc: modifies Windows Recovery Environment configuration.
    // bootcfg: legacy boot.ini editor still present on some systems.
    // manage-bde: BitLocker management, abused to disable boot protections.
    (
      $proc.target.process.file.full_path = /\\(bcdedit|bootsect|reagentc|bootcfg|manage\-bde)\.exe$/ nocase
      or
      // PowerShell or scripting hosts invoking firmware/boot-related COM objects
      // or WMI classes (e.g., BcdStore, Win32_ComputerSystem firmware queries).
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript)\.exe$/ nocase
        and
        $proc.target.process.command_line = /(bcdedit|BcdStore|firmware|uefi|bootmgr|bootsect|efi\\microsoft\\boot)/ nocase
      )
    )

    // Narrow to command-line arguments that indicate destructive or
    // persistence-oriented boot modifications rather than read-only queries.
    // BCDEdit /set, /create, /delete, /import alter boot entries.
    // bootsect /nt60 /mbr rewrites the MBR/VBR.
    // reagentc /disable disables WinRE, a common ransomware pre-step.
    (
      $proc.target.process.command_line = /(\/set|\/create|\/delete|\/import|\/export|\/copy|\/mbr|\/nt60|\/nt52|\/disable|\/enable)/ nocase
      or
      $proc.target.process.command_line = /(bootsequence|bootorder|safeboot|recoverysequence|testsigning|nointegritychecks)/ nocase
    )

    // Exclude known-good administrative parent processes via reference list.
    not $proc.principal.process.file.full_path in %global_allowed_firmware_tools

    // Exclude Windows Update and trusted system orchestrators as parents.
    not $proc.principal.process.file.full_path = /\\(TrustedInstaller|wuauclt|UsoClient|svchost|MoUsoCoreWorker)\.exe$/ nocase

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $boot_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
