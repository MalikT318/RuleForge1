/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:35:05.000065+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1007_001_macOS_Service_Discovery_DNS_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS query patterns consistent with service discovery data exfiltration on macOS: high-entropy subdomains, abnormally long labels, or suspicious record types (TXT/NULL) that adversaries use to tunnel or exfiltrate enumerated service information gathered via launchctl, launchd plist reads, or similar macOS service discovery commands."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Requires DNS query and resolver logs normalised into Chronicle UDM NETWORK_DNS events. No endpoint process telemetry required."
    platform = "macOS"
    log_source = "dns"
    false_positives = "Legitimate TXT record lookups (SPF, DKIM, DMARC validation), CDN health checks with long subdomains, internal service mesh DNS queries, automated certificate provisioning (ACME DNS-01 challenges)."
    tuning_guidance = "Add known-good parent domains to %global_allowed_dns_domains. Raise the subdomain length threshold if internal naming conventions use long labels. Restrict the TXT/NULL filter to external-facing resolvers if internal resolvers generate high false-positive volume."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Match on suspicious DNS record types used for tunneling/exfiltration (TXT=16, NULL=10)
    // or high-entropy / long subdomain labels indicative of encoded service enumeration output
    (
      $dns.network.dns.questions.type = 16 or
      $dns.network.dns.questions.type = 10 or
      // Long subdomain label: total FQDN exceeds 60 characters suggesting encoded payload
      $dns.network.dns.questions.name = /^[a-z0-9\-]{40,}\..+\..+$/ nocase or
      // High-entropy label pattern: long hex or base32/base64-like prefix before the registered domain
      $dns.network.dns.questions.name = /^[a-f0-9]{32,}\..+$/ nocase or
      $dns.network.dns.questions.name = /^[a-z2-7]{40,}\..+$/ nocase or
      $dns.network.dns.questions.name = /^[a-zA-Z0-9+\/]{30,}={0,2}\..+$/ nocase
    )

    // Exclude known-good domains to reduce noise across all tenants
    not $dns.network.dns.questions.name in %global_allowed_dns_domains

    // Exclude common legitimate TXT lookup patterns (SPF, DKIM, DMARC)
    not $dns.network.dns.questions.name = /^(_dmarc|_domainkey|_spf|_acme-challenge)\..+$/ nocase

    // Exclude internal/RFC-reserved TLDs
    not $dns.network.dns.questions.name = /\.(local|internal|corp|lan|test|example|invalid)$/ nocase

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($dns.principal.hostname)

  condition:
    $dns
}
