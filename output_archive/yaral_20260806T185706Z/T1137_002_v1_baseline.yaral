/*
  MITRE Technique : T1137.002 - Office Test
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:46:37.000976+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_002_Office_Test_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of the Microsoft Office Test registry key used to load arbitrary DLLs on every Office application launch. This key is not present in default Office installations and is a known persistence mechanism abused by adversaries to achieve code execution via Office applications."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.002"
    mitre_technique_name = "Office Application Startup: Office Test"
    log_prerequisites = "Requires Windows registry telemetry from EDR (CrowdStrike, Defender for Endpoint, SentinelOne) or Sysmon Event ID 13 (RegistryEvent - Value Set) normalised to UDM REGISTRY_CREATION or REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Microsoft Office developers or QA engineers running internal debug builds; automated Office deployment scripts that legitimately configure test hooks; unlikely in production enterprise environments."
    tuning_guidance = "Add known-safe parent process paths (e.g., authorised deployment tooling) to %global_allowed_registry_writers. If the HKCU variant generates noise from a specific user population, scope exclusions via %global_allowed_office_test_users."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Office test\\Special\\Perf/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_registry_writers

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1137.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
