/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:08:12.862599+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Fileless_Storage_Registry_Blob_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry value writes consistent with fileless payload storage: large or binary-encoded blobs written to non-standard registry paths commonly abused to persist shellcode, scripts, or encoded executables outside the filesystem. Targets the resulting registry state change rather than the process command line, providing additive coverage over process-creation rules."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent EDR registry events) normalised into Chronicle UDM REGISTRY_MODIFICATION events with target.registry.registry_key and target.registry.registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software licensing blobs, browser state storage, application configuration caches, Windows Defender definition updates, Group Policy client-side extensions writing policy blobs."
    tuning_guidance = "Add known-good registry key prefixes to %allowed_registry_blob_paths and known-good writer process paths to %allowed_registry_blob_writers. Narrow the rule further by correlating with unsigned or anomalous parent processes if EDR enrichment is available."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target non-standard registry hive locations commonly abused for fileless storage.
    // Covers HKCU\Software subtree (user-writable, no elevation needed),
    // HKLM\SOFTWARE\Classes (COM hijack staging), and environment/session keys.
    $reg.target.registry.registry_key = /\\(HKEY_CURRENT_USER|HKCU)\\Software\\/i nocase or
    $reg.target.registry.registry_key = /\\(HKEY_LOCAL_MACHINE|HKLM)\\SOFTWARE\\Classes\\/i nocase or
    $reg.target.registry.registry_key = /\\(HKEY_CURRENT_USER|HKCU)\\Environment\b/ nocase or
    $reg.target.registry.registry_key = /\\(HKEY_CURRENT_USER|HKCU)\\Volatile Environment\b/ nocase

    // Exclude well-known benign high-volume subkeys to reduce noise.
    not $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\(Explorer|Shell|Themes|Notifications)\\/i nocase
    not $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\(Winlogon|ProfileList|Fonts)\\/i nocase
    not $reg.target.registry.registry_key = /\\Microsoft\\Office\\/i nocase
    not $reg.target.registry.registry_key = /\\Google\\Chrome\\/i nocase
    not $reg.target.registry.registry_key = /\\Mozilla\\Firefox\\/i nocase

    // Value names that suggest encoded or binary payload storage:
    // generic blob names, base64-like names, or suspiciously short/random names
    // used by loaders to stash shellcode or scripts.
    (
      $reg.target.registry.registry_value_name = /^(blob|payload|data|cache|config|update|init|run|exec|stage|load|shell|sc|buf|raw|bin|obj|mod|drv|svc|task|key|val|tmp|store|persist|entry|item|chunk|seg|part|frag|token|ticket|cred|pass|hash|enc|dec|zip|gz|b64|hex|xor|rc4|aes|pk|pub|priv|cert|sig|stub|ldr|inj|hook|patch|mem|heap|stk|thr|pid|tid|uid|sid|acl|sd|sec|priv|tok|imp|dup|clr|net|http|tcp|udp|dns|url|uri|cmd|arg|opt|cfg|ini|reg|hkcu|hklm|run|svc|dll|exe|bat|ps1|vbs|js|hta|wsh|wmi|com|clsid|iid|guid|uuid)$/ nocase or
      $reg.target.registry.registry_value_name = /^[A-Za-z0-9+\/]{20,}={0,2}$/ nocase or
      $reg.target.registry.registry_value_name = /^[0-9a-fA-F]{32,}$/ nocase or
      $reg.target.registry.registry_value_name = /^\{[0-9a-fA-F\-]{36}\}$/ nocase
    )

    // Writer process is NOT a known-good system binary performing legitimate registry work.
    not $reg.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|svchost|WmiPrvSE|SearchIndexer|spoolsv|lsass|csrss|smss|wininit|services|winlogon|explorer|RuntimeBroker|sihost|taskhostw|ctfmon|dllhost|conhost|fontdrvhost|dwm|audiodg|MsMpEng|NisSrv|SgrmBroker|SecurityHealthService|wsmprovhost|wuauclt|UsoClient|MusNotification|OneDrive|Teams|Outlook|WINWORD|EXCEL|POWERPNT|mspaint|notepad|calc|mstsc|snippingtool|SnippingTool|SystemSettings|ShellExperienceHost|StartMenuExperienceHost|SearchApp|LockApp|ApplicationFrameHost|TextInputHost|YourPhone|PhoneExperienceHost|WinStore\.App|HxOutlook|HxCalendarAppImm|HxTsr|msedge|chrome|firefox|iexplore|MicrosoftEdge|MicrosoftEdgeCP|MicrosoftEdgeSH)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %allowed_registry_blob_writers
    not $reg.target.registry.registry_key in %allowed_registry_blob_paths

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writer_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
