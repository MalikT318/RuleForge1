/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:30:49.445092+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_Cloud_Account_Enum_Roles_Then_Users {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a cloud account enumeration pattern where a principal first queries IAM roles or groups and then queries user/account listings within a short window. This two-step discovery sequence (enumerate privilege structures, then enumerate accounts) is a common reconnaissance pattern in IaaS environments and is additive to command-line based detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM. AWS CloudTrail (ListRoles, ListUsers, ListGroups), Azure Activity (Microsoft.Authorization/roleAssignments/read, Microsoft.Graph/users/read), or GCP Audit (iam.roles.list, iam.serviceAccounts.list) must be ingested."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud security posture tools (CSPM), SIEM connectors performing periodic inventory, DevOps pipelines with IAM introspection, authorised cloud governance scripts."
    tuning_guidance = "Add known automation service accounts and CSPM principals to %cloud_allowed_iam_enum_principals. Narrow the match window if false-positive rate is high. Consider raising severity if the principal has no prior history of IAM API calls."

  events:
    // First event: principal queries IAM roles, groups, or policies
    $role_enum.metadata.event_type = "USER_RESOURCE_ACCESS"
    $role_enum.target.resource.attribute.labels["operation"] = /list.*(role|group|polic)/ nocase
    not $role_enum.principal.user.userid in %cloud_allowed_iam_enum_principals
    $role_enum.principal.user.userid = $actor
    $role_enum.principal.ip = $source_ip

    // Second event: same principal queries user or service-account listings
    $user_enum.metadata.event_type = "USER_RESOURCE_ACCESS"
    $user_enum.target.resource.attribute.labels["operation"] = /list.*(user|account|service.?account|member)/ nocase
    not $user_enum.principal.user.userid in %cloud_allowed_iam_enum_principals
    $user_enum.principal.user.userid = $actor
    $user_enum.principal.ip = $source_ip

    // Chronological ordering: role/group enumeration precedes user enumeration
    $role_enum.metadata.event_timestamp.seconds <= $user_enum.metadata.event_timestamp.seconds

  match:
    $actor, $source_ip over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($actor)
    $enumerated_role_operations = array_distinct($role_enum.target.resource.attribute.labels["operation"])
    $enumerated_user_operations = array_distinct($user_enum.target.resource.attribute.labels["operation"])
    $target_resources = array_distinct($user_enum.target.resource.name)
    $source_ips = array_distinct($source_ip)

  condition:
    $role_enum and $user_enum
}
