/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:48:42.828894+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_001_Forced_SMB_Auth_Outbound_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound SMB (TCP 445) or WebDAV (TCP 80/443) connections to non-internal destinations observed at the network perimeter. Forced authentication attacks (T1187) coerce Windows hosts into authenticating to adversary-controlled servers via SMB or WebDAV, leaking NTLM credential hashes. Perimeter firewall logs are the highest-fidelity source for this technique because the coerced connection must traverse the network boundary to reach the attacker infrastructure."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Requires perimeter firewall or network flow logs with source IP, destination IP, destination port, and protocol fields normalised into UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SMB to cloud file-share endpoints (e.g. Azure Files over port 445); WebDAV clients accessing approved SaaS services; VPN split-tunnel traffic that appears external at the perimeter sensor."
    tuning_guidance = "Populate %firewall_allowed_external_smb_destinations with approved external SMB endpoints (e.g. Azure Files FQDNs resolved to IPs). Populate %rfc1918_and_cgnat_ranges with 10/8, 172.16/12, 192.168/16, 100.64/10, 127/8, and 169.254/16 to suppress internal traffic. Reduce noise further by adding known-good WebDAV SaaS destination IPs to %firewall_allowed_webdav_destinations."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target SMB (445) or WebDAV fallback ports (80, 443)
    // Port 139 (NetBIOS session) included as secondary SMB coercion vector
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 80  or
      $net.target.port = 443
    )

    // Only flag connections where the destination is external (not RFC1918 / CGNAT / loopback)
    not $net.target.ip in %rfc1918_and_cgnat_ranges

    // Exclude approved external SMB destinations (e.g. Azure Files)
    not $net.target.ip in %firewall_allowed_external_smb_destinations

    // Exclude approved WebDAV SaaS destinations
    not $net.target.ip in %firewall_allowed_webdav_destinations

    // Exclude known-safe source hosts (e.g. dedicated file-transfer servers)
    not $net.principal.ip in %firewall_allowed_smb_source_hosts

    // For port 445/139: flag unconditionally - outbound SMB to the internet is
    // almost never legitimate and is a direct forced-auth indicator.
    // For port 80/443: narrow to WebDAV-characteristic patterns where available.
    // Chronicle normalises the application-layer protocol into network.application_protocol;
    // match "WebDAV" when populated, but do not require it so the rule fires even
    // when the field is absent (firewall logs rarely perform DPI).
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.network.application_protocol = /webdav/ nocase or
      $net.target.port = 80  or
      $net.target.port = 443
    )

  outcome:
    // SMB ports score higher (near-certain forced-auth signal); WebDAV ports
    // score slightly lower because 80/443 carry significant benign traffic.
    $risk_score = max(
      if($net.target.port = 445, 90,
        if($net.target.port = 139, 85,
          if($net.network.application_protocol = /webdav/ nocase, 80, 60)
        )
      )
    )
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
