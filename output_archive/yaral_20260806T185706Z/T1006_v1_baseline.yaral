/*
  MITRE Technique : T1006 - Direct Volume Access
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:34:43.338535+00:00
  Reference       : https://attack.mitre.org/techniques/T1006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1006_Direct_Volume_Access_Suspicious_Raw_Disk_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network flows or connections that match patterns consistent with direct volume or raw disk access exfiltration over the network, as observed from IDS/IPS telemetry. On network devices, this manifests as anomalous large-volume flows on storage or management protocols (iSCSI, NFS, SMB direct, FC-over-IP) originating from unexpected sources, or IDS signatures firing on raw disk read patterns traversing the network segment. This is a network-observable proxy for T1006 where data read via direct volume access is subsequently transferred across the wire."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1006"
    mitre_technique_name = "Direct Volume Access"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised into Chronicle UDM. Appliance must inspect or alert on storage protocol traffic (iSCSI port 3260, NFS 2049, SMB 445, FCoE/iFCP 3225) or generate flow records with byte counts."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Legitimate backup jobs using iSCSI or NFS, authorised SAN replication, scheduled snapshot transfers, storage migration tasks, and disaster recovery replication streams."
    tuning_guidance = "Add known backup server IPs to %global_allowed_backup_sources and known storage replication destinations to %global_allowed_storage_destinations. Raise the byte threshold if legitimate bulk transfers routinely exceed it. Scope by VLAN or network segment if storage traffic is confined to a dedicated fabric."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target storage-protocol ports associated with raw/volume-level access:
    // 3260 = iSCSI, 2049 = NFS, 445 = SMB (direct disk), 3225 = FCIP, 860 = iSCSI alt
    (
      $net.target.port = 3260 or
      $net.target.port = 2049 or
      $net.target.port = 445  or
      $net.target.port = 3225 or
      $net.target.port = 860
    )

    // Connection must originate from a host that is NOT a known storage/backup source.
    // This catches unexpected initiators attempting raw volume access.
    not $net.principal.ip in %global_allowed_backup_sources
    not $net.target.ip in %global_allowed_storage_destinations

    // Exclude RFC-1918 storage fabric traffic that is expected within the SAN VLAN.
    // Operators should tighten this to the specific storage VLAN prefix via the reference list.
    not $net.principal.ip in %global_allowed_storage_fabric_hosts

    // IDS/IPS alert context: prefer events where the appliance has flagged the session.
    // We use security_result.severity_details as a soft signal rather than
    // security_result.action alone (vendor mapping is inconsistent).
    (
      $net.security_result.summary = /raw.?disk|direct.?volume|iscsi.?unauth|nfs.?unauth|smb.?raw|volume.?read/ nocase or
      $net.security_result.category_details = /policy.?violation|anomaly|suspicious.?storage/ nocase or
      $net.security_result.severity = "HIGH" or
      $net.security_result.severity = "CRITICAL"
    )

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1006")
    $primary_entity = array_distinct($net.principal.ip)
    $target_storage_port = array_distinct($net.target.port)
    $destination_ip = array_distinct($net.target.ip)
    $alert_summary = array_distinct($net.security_result.summary)

  condition:
    $net
}
