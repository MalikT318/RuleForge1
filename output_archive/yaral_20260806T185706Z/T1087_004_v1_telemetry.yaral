/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:30:31.252205+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_M365_Bulk_Directory_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or repeated access to Microsoft 365 directory/user listing resources via audit logs. Adversaries with authenticated access enumerate cloud accounts by querying directory objects (users, groups, roles, service principals) through the M365 admin portal, Graph API, or Exchange admin center. This rule fires on USER_RESOURCE_ACCESS events targeting directory enumeration endpoints, providing coverage at the audit-log layer rather than the command-line layer."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log (UAL) ingested into Chronicle. Relevant workloads: AzureActiveDirectory, Exchange, MicrosoftTeams. Ensure audit logging is enabled for the tenant and that directory-read operations are captured."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "IT administrators performing routine user management, HR systems syncing directory data, identity governance tools (e.g., Saviynt, SailPoint), SIEM/SOAR connectors polling the Graph API, and helpdesk tooling that queries user attributes."
    tuning_guidance = "Add known service account userids to %m365_allowed_directory_readers. Add approved admin UPNs performing routine directory work. Consider raising the threshold or scoping to non-admin roles if noise is high. Correlate with off-hours access or unfamiliar source IPs for higher fidelity."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource must reference directory, user, group, role, or service-principal objects
    // This matches Graph API paths and M365 admin portal audit operation names
    (
      $cloud.target.resource.name = /\/(users|groups|roles|members|servicePrincipals|roleAssignments|directoryRoles|roleMembers)/ nocase or
      $cloud.target.resource.name = /directory/ nocase or
      $cloud.metadata.description = /(list.*user|list.*role|list.*member|list.*group|list.*service.?account|get.*msolrole|az\s+ad\s+user|directory.*read|user.*enumerat)/ nocase
    )

    // Exclude known-legitimate automated readers
    not $cloud.principal.user.userid in %m365_allowed_directory_readers

    // Exclude known service/sync accounts by pattern (e.g., sync service accounts often contain 'sync' or 'svc')
    not $cloud.principal.user.userid = /^(sync_|svc_|sa_|service_)/ nocase

    // Require an authenticated principal - anonymous or system-internal events are noise
    $cloud.principal.user.userid != ""

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
