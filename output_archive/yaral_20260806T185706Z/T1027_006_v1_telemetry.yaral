/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:04:36.610265+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_HTML_Smuggling_Suspicious_Download_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network HTTP traffic patterns consistent with HTML Smuggling on macOS endpoints. HTML Smuggling abuses JavaScript Blobs and HTML5 download attributes to deliver payloads embedded inside HTML/JS files served with benign MIME types (text/plain, text/html, application/octet-stream). This rule pivots on the network artifact layer - large responses served with mismatched or suspicious MIME types to macOS hosts - rather than process command-line telemetry, providing additive coverage over existing process-creation detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM NETWORK_HTTP events. The appliance must capture HTTP response metadata including Content-Type headers and response body size. Inline TLS inspection is required for HTTPS traffic."
    platform = "macOS"
    log_source = "ips"
    false_positives = "Legitimate large HTML/JS single-page applications, CDN-delivered web frameworks, online document editors (Google Docs, Office 365 web), software update portals delivering installers via browser redirect, developer tooling fetching large JS bundles."
    tuning_guidance = "Add approved CDN hostnames and internal web application FQDNs to %global_allowed_html_download_domains. Raise the response size threshold if SPA frameworks in the environment routinely exceed it. Consider scoping to macOS user-agent strings if the IDS normalises User-Agent into network.http.user_agent."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Target macOS hosts as the receiving endpoint
    $net.principal.hostname != ""

    // Focus on HTTP responses delivering content types commonly abused in HTML Smuggling:
    // text/html, text/plain, application/javascript, application/octet-stream
    // Attackers serve payloads under these benign MIME types to bypass content filters
    (
      $net.network.http.response_code = 200 or
      $net.network.http.response_code = 206
    )

    // Detect suspicious MIME types used to smuggle payloads
    // application/octet-stream served from an HTML/JS context is a strong signal
    // text/html or text/plain delivering large binary-sized responses is anomalous
    $net.network.http.response_code = 200

    // Match on content-type patterns associated with HTML Smuggling delivery
    // Blob URLs and data URLs are constructed client-side; the server delivers
    // the carrier document under these MIME types
    $net.target.url = /\.(html?|js|hta|shtml)(\?|$)/ nocase

    // Exclude known-safe domains and internal infrastructure
    not $net.target.hostname in %global_allowed_html_download_domains

    // Exclude standard browser navigation to top-level domains without suspicious path patterns
    // Flag responses where the URL path contains patterns associated with smuggling carriers:
    // encoded payloads, blob references, or download-triggering parameter names
    (
      $net.target.url = /[?&](download|blob|payload|file|attach|doc|invoice|order|shipment|dhl|fedex|ups)=/ nocase or
      $net.target.url = /\/(invoice|order|shipment|statement|document|receipt|notification|alert|secure|download)\// nocase or
      $net.target.url = /base64|atob|fromCharCode|unescape/ nocase
    )

    // Exclude internal RFC1918 destinations - smuggling originates externally
    not $net.target.ip in %rfc1918_internal

    // Exclude well-known update and software distribution infrastructure
    not $net.target.hostname in %global_allowed_software_update_domains

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $suspicious_url = array_distinct($net.target.url)
    $destination_host = array_distinct($net.target.hostname)
    $http_response_code = max($net.network.http.response_code)

  condition:
    $net
}
