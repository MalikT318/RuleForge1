/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:40:04.372337+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Replication_Through_Removable_Media {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation events on removable/USB-mounted drive letters (D:-Z:) that match executable or script extensions, indicating potential malware staging via removable media. This targets the core OS mechanism of T1091: writing a payload to removable media so it executes on insertion or user interaction."
    mitre_tactic    = "Lateral Movement, Initial Access"
    mitre_technique = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites = "Requires EDR file-creation telemetry (e.g., Sysmon Event ID 11) or equivalent endpoint agent that records target.file.full_path and principal.process.file.full_path for FILE_CREATION events."
    platform        = "Windows"
    log_source      = "identity"
    false_positives = "Legitimate software installers copied to USB drives by IT staff, portable application deployments, authorized backup agents writing executables to external drives."
    tuning_guidance = "Add trusted parent process paths (e.g., backup agents, IT deployment tools) to %global_allowed_removable_media_writers. Narrow the drive-letter regex if your environment consistently uses specific letters for removable media. Consider adding a volume GUID pattern match if your EDR normalises removable paths differently."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file must reside on a non-system drive letter (D-Z), which is the
    // typical Windows representation of a removable or USB-attached volume.
    // System drive (C:) and network UNC paths are intentionally excluded.
    $file.target.file.full_path = /^[D-Zd-z]:\\/

    // File extension must be executable or script-like - the payload types
    // adversaries stage on removable media for autorun or social-engineering execution.
    $file.target.file.full_path = /\.(exe|dll|bat|cmd|ps1|vbs|vbe|js|jse|hta|scr|pif|lnk|inf|msi|cpl|jar|wsf|wsh)$/ nocase

    // The writing process must itself be a user-space or shell process,
    // not a known OS component performing legitimate media formatting.
    // Exclude Windows Explorer only when it is NOT the direct writer
    // (Explorer legitimately copies files; we catch non-Explorer writers
    // and separately catch Explorer writing scripts/autorun-adjacent types).
    not $file.principal.process.file.full_path = /\\(svchost|smss|csrss|wininit|services|lsass|spoolsv|MsMpEng|TrustedInstaller)\.exe$/ nocase

    // Exclude known legitimate removable-media management tools
    not $file.principal.process.file.full_path in %global_allowed_removable_media_writers

    // Exclude Windows system directories as the source process location -
    // legitimate OS file operations originate from system32/syswow64
    // only for a narrow set of processes already excluded above.
    // This catches user-land processes (including renamed binaries) writing payloads.
    $file.principal.user.userid != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity = array_distinct($file.principal.hostname)
    $written_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
