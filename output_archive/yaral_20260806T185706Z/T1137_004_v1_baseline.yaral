/*
  MITRE Technique : T1137.004 - Outlook Home Page
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:46:52.429519+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_004_Outlook_Home_Page_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications that set or modify the Outlook Home Page URL for a mail folder. Adversaries abuse this legacy Outlook feature to load a malicious HTML page that executes code whenever the targeted folder is opened. The registry key WebView\\URL under the Outlook folder configuration stores the home page URL."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.004"
    mitre_technique_name = "Office Application Startup: Outlook Home Page"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry normalised to UDM REGISTRY_MODIFICATION events. Sysmon Event ID 13 or equivalent EDR registry write events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Outlook folder customisation by enterprise IT teams, SharePoint or intranet portal integrations that configure Outlook folder home pages, third-party Outlook add-ins that set folder views."
    tuning_guidance = "Add known-good home page URL patterns or the writing process paths to %outlook_homepage_allowed_writers. Scope further by excluding processes in %global_allowed_admin_tools. If the environment does not use Outlook Home Page at all, the false-positive rate should be near zero."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    // Target the Outlook WebView registry path where the Home Page URL is stored.
    // Path pattern: HKCU\Software\Microsoft\Office\<version>\Outlook\WebView\<FolderName>
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Office\\[0-9]+\.[0-9]+\\Outlook\\WebView\\/i nocase
    // The value being written is the URL that Outlook will load as the folder home page.
    $reg.target.registry.registry_value_name = /url/ nocase
    // Exclude writes originating from known-good Outlook administrative processes.
    not $reg.principal.process.file.full_path in %outlook_homepage_allowed_writers
    // Exclude known administrative tooling.
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $affected_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
