/*
  MITRE Technique : T1591.004 - Identify Roles
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:24:27.422926+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_004_Role_Recon_Staff_Page_Enumeration {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects external HTTP requests to victim-owned web pages commonly associated with organisational role and personnel enumeration (e.g. /about, /team, /leadership, /staff, /directory, /contact, /management, /executives, /board, /org-chart). A single external source making repeated requests to multiple such paths within a short window is a strong indicator of pre-compromise role identification activity consistent with T1591.004."
    mitre_tactic         = "Reconnaissance"
    mitre_technique      = "T1591.004"
    mitre_technique_name = "Gather Victim Org Information: Identify Roles"
    log_prerequisites    = "Requires perimeter firewall or web proxy logs normalised to UDM NETWORK_HTTP, including network.http.method, network.uri, principal.ip, and target.hostname."
    platform             = "PRE"
    log_source           = "firewall"
    false_positives      = "Search engine crawlers (Googlebot, Bingbot), legitimate HR/recruitment research, internal monitoring tools, link-checker utilities, and accessibility scanners."
    tuning_guidance      = "Populate %allowed_crawler_user_agents with known-good bot UA strings. Populate %internal_address_space to exclude RFC-1918 and trusted egress ranges. Raise the threshold or narrow the URI regex if the organisation hosts a public-facing directory that receives heavy legitimate traffic."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Request originates from an external (non-trusted) source
    not $net.principal.ip in %internal_address_space

    // Target URI matches paths commonly scraped for role/personnel information
    $net.network.http.request_url = /\/(about|team|leadership|staff|directory|contact[\-_]?us|management|executives|board|org[\-_]?chart|people|our[\-_]?team|who[\-_]?we[\-_]?are|bios?|profiles?|partners|advisors|governance)(\/|$|\?|#)/ nocase

    // Standard web methods only - filter noise from non-enumeration traffic
    $net.network.http.method = /^(GET|HEAD)$/ nocase

    // Exclude known-good automated crawlers and monitoring agents
    not $net.network.http.user_agent in %allowed_crawler_user_agents

  outcome:
    $risk_score        = max(45)
    $mitre_technique_id = array_distinct("T1591.004")
    $primary_entity    = array_distinct($net.principal.ip)
    $targeted_hostname = array_distinct($net.target.hostname)
    $matched_uri       = array_distinct($net.network.http.request_url)

  condition:
    $net
}
