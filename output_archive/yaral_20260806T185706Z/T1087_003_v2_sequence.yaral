/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:30:10.777520+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_GAL_Dump_File_Written_After_PowerShell_Exchange_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a file creation event consistent with an Exchange Global Address List (GAL) or address-book dump occurring within 10 minutes of a PowerShell process launch that loaded Exchange or EWS management modules. Adversaries use Get-GlobalAddressList or MailSniper-style tooling to harvest email accounts; the output is typically written to a CSV, TXT, or XLSX file. This correlation avoids command-line matching (covered by variant 1) and instead pivots on the artifact left on disk."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Event ID 11) and process-launch telemetry (Event ID 1 / EDR equivalent). Both must be ingested and normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Exchange administrators exporting address lists for directory synchronisation, HR tooling that exports user lists, mail-migration projects."
    tuning_guidance = "Add known admin PowerShell hosts to %global_allowed_exchange_admin_hosts. Add approved output directories to %global_allowed_gal_export_paths. Scope by principal.hostname to high-value targets if false-positive rate is high."

  events:
    // --- Leg 1: PowerShell process launch that loads Exchange / EWS context ---
    $ps.metadata.event_type = "PROCESS_LAUNCH"
    $ps.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    // Must be loading an Exchange or EWS-related module or snap-in
    // Matches: -PSConsoleFile, Import-Module ExchangeManagement, Add-PSSnapin, EWS, RemoteExchange
    $ps.target.process.command_line = /(exchange|ews|remoteexchange|microsoft\.exchange|snapin|globaladdress|addresslist|mailsniper)/  nocase
    not $ps.principal.hostname in %global_allowed_exchange_admin_hosts
    $ps.principal.hostname = $hostname

    // --- Leg 2: File creation of a likely address-list export artifact ---
    $file.metadata.event_type = "FILE_CREATION"
    // Process writing the file is PowerShell or a child it spawned
    $file.principal.process.file.full_path = /\\(powershell|pwsh|cmd)\.exe$/ nocase
    // Output file has an extension consistent with data exfiltration staging
    $file.target.file.full_path = /\.(csv|txt|tsv|xlsx|json|xml)$/ nocase
    // File path contains keywords suggesting address/email content
    $file.target.file.full_path = /(address|gal|email|mailbox|contact|user|account|export|dump)/ nocase
    not $file.target.file.full_path in %global_allowed_gal_export_paths
    $file.principal.hostname = $hostname

    // --- Chronological ordering: PowerShell must launch before the file is written ---
    $ps.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($ps.principal.hostname)
    $ps_command_lines = array_distinct($ps.target.process.command_line)
    $written_files = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $ps_parent_process = array_distinct($ps.principal.process.file.full_path)

  condition:
    $ps and $file
}
