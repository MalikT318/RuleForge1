/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:10:27.926253+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Ccache_File_Access_Or_Exfil {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects suspicious access to Kerberos credential cache (ccache) files on Linux. Adversaries read or copy ccache files from /tmp (krb5cc_* or krb5.ccache) to steal Kerberos tickets for Pass-the-Ticket attacks. The rule fires when a process that is NOT a known Kerberos management utility reads or opens a ccache file path, or when a ccache file is copied to an unusual destination."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with file-open/read syscall enrichment normalised into UDM FILE_READ or PROCESS_LAUNCH events. Auditd rules should watch /tmp/krb5cc_* and /tmp/krb5.ccache with -p r."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate Kerberos tooling (kinit, klist, kvno, kswitch, sssd, pam_krb5) reading their own ccache; backup agents archiving /tmp; monitoring agents performing file inventory."
    tuning_guidance = "Add authorised Kerberos-aware process paths to %linux_allowed_ccache_readers. Consider scoping by principal.user.userid to exclude service accounts that legitimately manage ccache files."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target process is reading, copying, or archiving ccache files
    // Match cp, cat, dd, tar, python, perl, ruby, nc, curl, scp, rsync, or any shell
    $proc.target.process.command_line = /\/tmp\/krb5(cc_[0-9]+|\.ccache)/ nocase

    // Exclude the standard Kerberos management binaries that legitimately touch ccache
    not $proc.target.process.file.full_path = /\/(kinit|klist|kdestroy|kvno|kswitch|krenew|kgetcred|sssd|krb5-child|pam_krb5)$/ nocase

    // Exclude known-good parent processes (sssd, pam, login stack)
    not $proc.principal.process.file.full_path = /\/(sssd|pam_krb5|login|sshd|gdm|lightdm|systemd)$/ nocase

    // Exclude paths explicitly allow-listed per client environment
    not $proc.target.process.file.full_path in %linux_allowed_ccache_readers

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $actor_process     = array_distinct($proc.target.process.file.full_path)
    $actor_cmdline     = array_distinct($proc.target.process.command_line)
    $actor_user        = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
