/*
  MITRE Technique : T1496.004 - Cloud Service Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:58:04.091269+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_004_Cloud_Service_Hijacking_Messaging_Abuse {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects anomalous high-volume or newly-enabled cloud messaging/email/AI service API actions that are characteristic of SaaS Cloud Service Hijacking (T1496.004). Adversaries who compromise cloud credentials frequently invoke bulk-send, model-invocation, or service-enable APIs to abuse SES, SNS, Twilio, SendGrid, or cloud-hosted LLM endpoints at scale, causing financial impact and quota exhaustion. This rule fires on resource-access events targeting messaging or AI inference service namespaces where the operation matches known abuse patterns (bulk send, enable service, create configuration)."
    mitre_tactic         = "Impact"
    mitre_technique      = "T1496.004"
    mitre_technique_name = "Cloud Service Hijacking"
    log_prerequisites    = "Requires cloud provider audit logs normalised into Chronicle UDM (e.g. AWS CloudTrail, GCP Audit Logs, Azure Activity Logs). Events must populate target.resource.name, target.resource.resource_type, and principal.user.userid."
    platform             = "SaaS"
    log_source           = "cloud_audit"
    false_positives      = "Legitimate bulk email campaigns via authorised marketing accounts; automated notification pipelines; ML/AI platform teams running large inference jobs; DevOps pipelines enabling services during provisioning."
    tuning_guidance      = "Add authorised service accounts and pipeline identities to %allowed_messaging_service_principals. Add known-good resource name patterns to %allowed_messaging_resources. Raise the threshold or narrow the operation regex if the environment runs high-volume legitimate messaging workloads."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target a messaging, notification, email, or AI/LLM service namespace.
    // Matches resource names or types that contain well-known service identifiers
    // without hardcoding vendor-specific product names.
    (
      $cloud.target.resource.name = /\b(ses|sns|email[\-_]?send|notification[\-_]?service|messaging|sms[\-_]?send|mail[\-_]?send|llm|inference|model[\-_]?invoke|ai[\-_]?platform|generative[\-_]?ai|bedrock|vertex[\-_]?ai|openai|anthropic|sagemaker)\b/ nocase
      or
      $cloud.target.resource.resource_type = /\b(email|messaging|notification|sms|ai[\-_]?model|llm|inference[\-_]?endpoint)\b/ nocase
    )

    // Operation matches abuse-relevant API actions: sending, enabling, creating
    // send configurations, or invoking models. Excludes read-only describe/list.
    $cloud.target.resource.attribute.labels["operation"] = /\b(send|publish|invoke|enable|create[\-_]?configuration|put[\-_]?identity|verify[\-_]?email|create[\-_]?topic|subscribe|unsubscribe|put[\-_]?sending[\-_]?authorization|invoke[\-_]?model|generate[\-_]?content|complete|chat)\b/ nocase

    // Exclude known-good principals (service accounts, pipelines, marketing tools)
    not $cloud.principal.user.userid in %allowed_messaging_service_principals

    // Exclude known-good resource name patterns
    not $cloud.target.resource.name in %allowed_messaging_resources

    // Exclude internal automation accounts by naming convention
    not $cloud.principal.user.userid = /\b(deploy[\-_]?bot|ci[\-_]?cd|pipeline[\-_]?svc|terraform[\-_]?svc)\b/ nocase

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1496.004")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $target_resource   = array_distinct($cloud.target.resource.name)
    $resource_type     = array_distinct($cloud.target.resource.resource_type)
    $operation         = array_distinct($cloud.target.resource.attribute.labels["operation"])
    $source_ip         = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
