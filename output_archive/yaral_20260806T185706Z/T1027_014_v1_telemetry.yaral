/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:09:51.882028+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Polymorphic_Repeated_Executable_Writes_Firewall {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable behaviour consistent with polymorphic or mutating malware: a single internal host making repeated short-lived outbound connections to the same external destination over a narrow time window, consistent with a mutating payload repeatedly beaconing or fetching updated code variants. Polymorphic malware frequently re-downloads or re-stages mutated copies of itself, producing a distinctive high-frequency, low-duration connection pattern to a single external endpoint."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised into Chronicle UDM NETWORK_FLOW or NETWORK_CONNECTION events. Each flow record must populate principal.ip, target.ip, target.port, and network.session_duration (seconds). Aggregate flow logging (NetFlow/IPFIX) is sufficient."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Software update daemons (apt, yum, dnf) polling a CDN; container orchestration pulling image layers; CI/CD agents fetching build artefacts; monitoring agents with high-frequency health checks; streaming media clients."
    tuning_guidance = "Add known-good internal source IPs (update servers, CI runners, monitoring agents) to %firewall_allowed_high_freq_sources. Add approved external CDN or update destination IPs to %firewall_allowed_update_destinations. Raise the connection_count threshold or widen the time window if legitimate workloads trigger this rule."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Source must be an internal host - exclude known-good high-frequency sources
    not $net.principal.ip in %firewall_allowed_high_freq_sources

    // Destination must be external - exclude RFC-1918 and approved update destinations
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %firewall_allowed_update_destinations

    // Target ports associated with payload staging: HTTP, HTTPS, and high ephemeral ports
    // commonly abused for C2 or payload retrieval
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      ($net.target.port >= 1024 and $net.target.port <= 65535)
    )

    // Short-lived connections: polymorphic stagers typically open, fetch, and close quickly
    // Sessions under 30 seconds are suspicious when repeated at high frequency
    $net.network.session_duration <= 30

    // Capture join fields for grouping
    $net.principal.ip = $src_ip
    $net.target.ip   = $dst_ip

  match:
    $src_ip, $dst_ip over 5m

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity    = array_distinct($src_ip)
    $destination_ip    = array_distinct($dst_ip)
    $observed_ports    = array_distinct($net.target.port)
    $connection_count  = count($net.metadata.id)
    $max_session_secs  = max($net.network.session_duration)
    $min_session_secs  = min($net.network.session_duration)

  condition:
    // Require at least 8 distinct short-lived flows from the same source to the same
    // external destination within 5 minutes - this threshold separates normal browsing
    // retries from the high-frequency re-staging pattern of polymorphic loaders
    #net >= 8
}
