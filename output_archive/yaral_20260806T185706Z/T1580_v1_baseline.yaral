/*
  MITRE Technique : T1580 - Cloud Infrastructure Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:17:28.997083+00:00
  Reference       : https://attack.mitre.org/techniques/T1580
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1580_001_Cloud_Infrastructure_Discovery_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects broad cloud infrastructure enumeration activity via cloud provider audit logs. Adversaries performing T1580 issue high volumes of read/list/describe API calls against compute, storage, and database resources to map the environment. This rule fires when a single principal issues multiple distinct resource-access events matching enumeration API patterns within a short window."
    mitre_tactic = "Discovery"
    mitre_technique = "T1580"
    mitre_technique_name = "Cloud Infrastructure Discovery"
    log_prerequisites = "Requires cloud provider control-plane audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). USER_RESOURCE_ACCESS events must be populated with metadata.product_event_type or target.resource.name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud management platforms, infrastructure-as-code pipelines (Terraform, Pulumi), CSPM tools, legitimate DevOps automation, and cloud-native monitoring agents that enumerate resources as part of normal operation."
    tuning_guidance = "Add known automation service account user IDs to %cloud_allowed_enumeration_principals. Add approved CIDR ranges or source IPs to %cloud_allowed_mgmt_sources. Raise the threshold or narrow the API pattern regex if CSPM tooling generates excessive noise."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match enumeration-style API verbs across AWS, Azure, and GCP
    // AWS: Describe*, List*, Get*, Head* on EC2/S3/RDS/EKS
    // Azure: Microsoft.Compute/virtualMachines/read, Microsoft.Storage/storageAccounts/read
    // GCP: compute.instances.list, storage.buckets.list
    $cloud.metadata.product_event_type = /^(Describe|List|Get|Head|compute\.instances|compute\.disks|compute\.snapshots|compute\.networks|storage\.buckets|storage\.objects\.list|Microsoft\.Compute\/virtualMachines\/read|Microsoft\.Storage\/storageAccounts\/read|Microsoft\.Sql\/servers\/read|Microsoft\.ContainerService\/managedClusters\/read|Microsoft\.Network\/virtualNetworks\/read|Microsoft\.KeyVault\/vaults\/read)/ nocase

    // Exclude known-good automation principals
    not $cloud.principal.user.userid in %cloud_allowed_enumeration_principals

    // Capture joining fields for outcome
    $cloud.principal.user.userid = $userid

  match:
    $userid over 5m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1580")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $enumerated_resource_types = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resources = array_distinct($cloud.target.resource.name)
    $event_count = count($cloud.metadata.product_event_type)

  condition:
    #cloud >= 10
}
