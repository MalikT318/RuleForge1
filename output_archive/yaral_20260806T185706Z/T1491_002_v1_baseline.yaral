/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:56:24.061842+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_External_Defacement_Suspicious_Outbound_HTTP {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable signals consistent with external website defacement: large outbound HTTP PUT or POST requests to external destinations on web ports, which may indicate an adversary uploading replacement web content to an externally-facing server. Firewall and proxy perimeter logs capture this without requiring endpoint visibility."
    mitre_tactic    = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires perimeter firewall or forward proxy logs normalised into Chronicle UDM with HTTP method, bytes_sent, target.port, and target.ip populated. Proxy logs must record the HTTP method (PUT/POST) and payload size."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Legitimate CMS publishing workflows (WordPress, Drupal), CI/CD pipeline deployments pushing web assets, CDN origin-push operations, authorised web-hosting control panels, large file upload services."
    tuning_guidance = "Add known-good publishing source IPs or CIDR ranges to %allowed_web_publish_sources. Add authorised external web-hosting destinations to %allowed_web_destinations. Raise the bytes_sent threshold if large legitimate uploads are common. Scope by principal.ip subnet to exclude dedicated deployment hosts."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Target web ports commonly used for externally-facing web servers
    $net.target.port in [80, 443, 8080, 8443]

    // HTTP methods used to upload or replace web content
    $net.network.http.method = /^(PUT|POST)$/ nocase

    // Large outbound payload - consistent with uploading replacement web content
    // Threshold: >500 KB sent; tune via %allowed_web_publish_sources exclusion
    $net.network.sent_bytes > 512000

    // Exclude internal RFC-1918 and loopback destinations
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good publishing sources (CI/CD hosts, authorised deployers)
    not $net.principal.ip in %allowed_web_publish_sources

    // Exclude known-good external web destinations (CDN origins, authorised hosts)
    not $net.target.ip in %allowed_web_destinations

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)
    $http_method       = array_distinct($net.network.http.method)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
