/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:01:01.684090+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_Cloud_Security_Agent_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of cloud-native security monitoring agents and services via cloud control-plane APIs. Adversaries query installed agents (CloudWatch, Azure Monitor, GCP Cloud Monitor) to identify defensive tooling before deciding whether to proceed with further actions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Log). USER_RESOURCE_ACCESS events for Describe/List/Get API calls against monitoring, security, and agent-related resource types."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud operations teams running inventory scripts, infrastructure-as-code pipelines (Terraform, Ansible), CSPM tools performing continuous compliance scans, cloud provider health checks, and authorised security posture assessments."
    tuning_guidance = "Add known automation service accounts and CSPM tool identities to %cloud_allowed_security_enumeration_principals. Narrow the resource_type regex if only one cloud provider is in scope. Raise severity if the calling identity is interactive (human user) rather than a service account."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match API operations that read/list security monitoring agents and services.
    // Covers AWS (Describe*, List*), Azure (GET operations), GCP (get, list verbs).
    $cloud.metadata.product_event_type = /^(Describe|List|Get|list|get|describe)/ nocase

    // Target resource types associated with cloud security and monitoring agents.
    // Matches: CloudWatch, SecurityHub, GuardDuty, Macie, Inspector, Defender,
    // Azure Monitor, Azure Security Center, GCP Security Command Center,
    // Cloud Monitor agent, VM extensions, SSM agent, etc.
    (
      $cloud.target.resource.resource_type = /cloud.?watch|cloud.?monitor|cloud.?trail|security.?hub|guard.?duty|macie|inspector|defender|sentinel|security.?center|command.?center|vm.?agent|vm.?extension|ssm.?agent|osconfig|cloud.?logging|stackdriver|log.?analytics|diagnostic/ nocase
      or
      $cloud.target.resource.name = /cloud.?watch|cloud.?monitor|cloud.?trail|security.?hub|guard.?duty|macie|inspector|defender|sentinel|security.?center|command.?center|vm.?agent|vm.?extension|ssm.?agent|osconfig|cloud.?logging|stackdriver|log.?analytics|diagnostic/ nocase
    )

    // Exclude known-good automation identities to reduce MSSP-wide noise.
    not $cloud.principal.user.userid in %cloud_allowed_security_enumeration_principals

    // Exclude cloud provider internal service principals performing health checks.
    not $cloud.principal.user.userid = /^(AWS|azure|gcp|google)\.internal\./ nocase

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource_type = array_distinct($cloud.target.resource.resource_type)
    $accessed_resource_name = array_distinct($cloud.target.resource.name)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
