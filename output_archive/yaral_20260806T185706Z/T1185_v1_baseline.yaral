/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:48:20.328638+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_001_Browser_Session_Hijacking_Process_Open {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a non-browser, non-debugger process opening a handle to a browser process. Browser session hijacking (T1185) requires a process to open the browser process with sufficient rights to read memory, inject code, or steal cookies and session tokens. Legitimate handle openers are narrow; any unexpected process acquiring PROCESS_VM_READ or PROCESS_ALL_ACCESS against a browser is high-fidelity."
    mitre_tactic    = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires EDR or Sysmon Event ID 10 (ProcessAccess) telemetry normalised to UDM PROCESS_OPEN. The source process path and target process path must be populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Security products (AV/EDR agents), crash reporters (WerFault.exe), legitimate debuggers (devenv.exe, windbg.exe), and some RMM agents open browser processes for legitimate reasons. Add those paths to the exclusion list."
    tuning_guidance = "Populate %browser_hijack_allowed_openers with full paths of approved security tools, crash reporters, and RMM agents that legitimately open browser processes. Narrow further by requiring specific access-right bitmasks if your EDR surfaces them in the command_line or a dedicated field."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be a browser process
    $open.target.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|opera|brave|vivaldi|chromium)\.exe$/ nocase

    // The opening process must NOT itself be a browser (tab/renderer isolation)
    not $open.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|opera|brave|vivaldi|chromium)\.exe$/ nocase

    // Exclude Windows OS components that legitimately open browser handles
    not $open.principal.process.file.full_path = /\\(WerFault|werfaultsecure|taskmgr|svchost|csrss|lsass|services|smss|wininit|dwm|conhost)\.exe$/ nocase

    // Exclude known legitimate debugger/IDE binaries
    not $open.principal.process.file.full_path = /\\(devenv|windbg|cdb|ntsd|msbuild)\.exe$/ nocase

    // Exclude paths under Windows Defender / Security Center directories
    not $open.principal.process.file.full_path = /\\(Windows Defender|Microsoft Defender|WindowsApps\\Microsoft\.Windows\.SecHealthUI)/ nocase

    // Multi-tenant exclusion list for approved openers
    not $open.principal.process.file.full_path in %browser_hijack_allowed_openers

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity    = array_distinct($open.principal.hostname)
    $opener_process    = array_distinct($open.principal.process.file.full_path)
    $target_browser    = array_distinct($open.target.process.file.full_path)
    $acting_user       = array_distinct($open.principal.user.userid)

  condition:
    $open
}
