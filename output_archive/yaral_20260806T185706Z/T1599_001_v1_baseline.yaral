/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:27:44.197342+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_NAT_Traversal_Anomalous_Cross_Boundary_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network flows that traverse a NAT boundary device between segments that should be isolated, which may indicate adversarial NAT configuration abuse to bridge trusted and untrusted networks. Focuses on flows where a non-routable (RFC1918) source reaches a non-routable destination across a boundary device, or where translated traffic patterns suggest unauthorized NAT traversal enabling access to protected segments."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Boundary Bridging: Network Address Translation Traversal"
    log_prerequisites = "Requires IDS/IPS or network security appliance flow telemetry with source/destination IP, port, bytes transferred, and network zone or interface context. NAT translation logs or flow records showing pre/post-NAT addresses improve fidelity."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Legitimate site-to-site VPN traffic, authorized inter-VLAN routing through a firewall, managed SD-WAN overlays, and sanctioned cloud-on-premises hybrid connectivity may produce similar cross-boundary flow patterns."
    tuning_guidance = "Populate %approved_nat_source_cidrs with known legitimate NAT source ranges and %approved_cross_boundary_destinations with authorized inter-segment destinations. Narrow the destination port list to ports observed in your environment that should never cross the boundary."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Source must be an RFC1918 private address (internal network)
    (
      $net.principal.ip = /^10\.\d{1,3}\.\d{1,3}\.\d{1,3}$/ or
      $net.principal.ip = /^172\.(1[6-9]|2[0-9]|3[01])\.\d{1,3}\.\d{1,3}$/ or
      $net.principal.ip = /^192\.168\.\d{1,3}\.\d{1,3}$/
    )

    // Destination must also be an RFC1918 private address in a DIFFERENT segment,
    // indicating cross-boundary traversal between isolated internal networks
    (
      $net.target.ip = /^10\.\d{1,3}\.\d{1,3}\.\d{1,3}$/ or
      $net.target.ip = /^172\.(1[6-9]|2[0-9]|3[01])\.\d{1,3}\.\d{1,3}$/ or
      $net.target.ip = /^192\.168\.\d{1,3}\.\d{1,3}$/
    )

    // Target ports associated with sensitive management-plane or lateral movement
    // across network segments that should not traverse a NAT boundary device
    (
      $net.target.port = 22   or   // SSH
      $net.target.port = 23   or   // Telnet
      $net.target.port = 161  or   // SNMP
      $net.target.port = 162  or   // SNMP trap
      $net.target.port = 179  or   // BGP
      $net.target.port = 443  or   // HTTPS management
      $net.target.port = 830  or   // NETCONF over SSH
      $net.target.port = 8443 or   // Alt HTTPS management
      $net.target.port = 3389 or   // RDP
      $net.target.port = 445  or   // SMB
      $net.target.port = 3306 or   // MySQL
      $net.target.port = 5432      // PostgreSQL
    )

    // Exclude flows from approved NAT source ranges (tuning list)
    not $net.principal.ip in %approved_nat_source_cidrs

    // Exclude flows to approved cross-boundary destinations (tuning list)
    not $net.target.ip in %approved_cross_boundary_destinations

    // Require meaningful data transfer to reduce noise from probe/scan events
    $net.network.sent_bytes > 1024

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
