/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:35:42.905164+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_Exfiltration_Alt_Network_Medium {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process launches consistent with exfiltration over an alternative network medium on Windows. Adversaries may enable or interact with Bluetooth, WiFi direct, mobile broadband, or ad-hoc wireless adapters to bypass monitored enterprise network paths. This rule targets command-line invocations of built-in Windows networking utilities used to configure or activate such interfaces."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (Process Create) with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate IT administrators configuring wireless adapters, Bluetooth pairing tools, mobile broadband management software, and enterprise MDM agents that manage network interfaces."
    tuning_guidance = "Add known-good parent processes (e.g., MDM agents, IT management tools) to %global_allowed_network_config_parents. Add known-good process paths to %global_allowed_netconfig_tools. Scope to sensitive asset groups if noise is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target built-in Windows utilities used to configure alternative network media:
    // netsh for wireless/Bluetooth profile manipulation,
    // net for adapter control,
    // devcon/pnputil for device enablement,
    // bthprops / fsquirt for Bluetooth file transfer,
    // MpCmdRun excluded - not relevant here
    (
      // netsh wlan / netsh winsock / netsh interface for wireless or ad-hoc config
      (
        $proc.target.process.file.full_path = /\\netsh\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /wlan\s+(add|set|connect|start)/ nocase
          or $proc.target.process.command_line = /hostednetwork/ nocase
          or $proc.target.process.command_line = /adhoc/ nocase
          or $proc.target.process.command_line = /mode=allow/ nocase
        )
      )
      or
      // pnputil used to add or enable a device driver (e.g., USB WiFi, Bluetooth dongle)
      (
        $proc.target.process.file.full_path = /\\pnputil\.exe$/ nocase
        and $proc.target.process.command_line = /(\/add-driver|\/enable-device|\/install)/ nocase
      )
      or
      // fsquirt is the Windows Bluetooth File Transfer Wizard
      (
        $proc.target.process.file.full_path = /\\fsquirt\.exe$/ nocase
      )
      or
      // PowerShell used to interact with wireless/Bluetooth APIs or enable adapters
      (
        $proc.target.process.file.full_path = /(\\powershell\.exe|\\pwsh\.exe)$/ nocase
        and
        (
          $proc.target.process.command_line = /Enable-NetAdapter/ nocase
          or $proc.target.process.command_line = /Set-NetAdapter/ nocase
          or $proc.target.process.command_line = /Add-VpnConnection/ nocase
          or $proc.target.process.command_line = /New-NetRoute/ nocase
          or $proc.target.process.command_line = /BluetoothDevice/ nocase
          or $proc.target.process.command_line = /InTheHand\.Net/ nocase
          or $proc.target.process.command_line = /32feet/ nocase
        )
      )
      or
      // netsh with mobile broadband context
      (
        $proc.target.process.file.full_path = /\\netsh\.exe$/ nocase
        and $proc.target.process.command_line = /mbn/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_network_config_parents
    not $proc.target.process.file.full_path in %global_allowed_netconfig_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggered_process = array_distinct($proc.target.process.file.full_path)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
