/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:16:33.309031+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Timer_Unit_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of systemd .timer unit files in privileged or user-level systemd directories. Adversaries abuse systemd timers as a persistence and execution mechanism by dropping .timer (and paired .service) unit files. This rule pivots on the file artifact rather than the command line, providing coverage when process-creation telemetry is absent or suppressed."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events, with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate software package installations (apt/yum/dnf/rpm) writing systemd timer units, configuration management tools (Ansible, Puppet, Chef, SaltStack), container orchestration agents, and authorised administrator maintenance tasks."
    tuning_guidance = "Add known-good parent process paths (e.g. package managers, CM agents) to %linux_allowed_unit_writers. Add known-good timer file paths to %linux_allowed_timer_paths. Consider scoping to non-package-manager parent processes first."

  events:
    $file.metadata.event_type in ["FILE_CREATION", "FILE_MODIFICATION"]

    // Match .timer unit files in all standard systemd locations:
    // - System-wide privileged: /etc/systemd/system/ and /usr/lib/systemd/system/
    // - Runtime: /run/systemd/system/
    // - User-level (any user home): ~/.config/systemd/user/
    $file.target.file.full_path = /\/(etc\/systemd\/system|usr\/lib\/systemd\/system|run\/systemd\/system|\.config\/systemd\/user)\/[^\/]+\.timer$/ nocase

    // Exclude known-good writers supplied via reference list (package managers, CM tools, etc.)
    not $file.principal.process.file.full_path in %linux_allowed_unit_writers

    // Exclude known-good timer file paths (e.g. vendor-shipped timers)
    not $file.target.file.full_path in %linux_allowed_timer_paths

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $timer_file_path = array_distinct($file.target.file.full_path)
    $actor_userid = array_distinct($file.principal.user.userid)

  condition:
    $file
}
