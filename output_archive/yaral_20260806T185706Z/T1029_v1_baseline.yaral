/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:36:15.090686+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_Scheduled_Transfer_Task_With_Network_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects scheduled task creation where the command line references both a scheduling mechanism and network transfer utilities (curl, wget, bitsadmin, certutil, ftp, robocopy with UNC paths, or PowerShell with web cmdlets). This pattern is consistent with T1029 Scheduled Transfer, where adversaries automate periodic exfiltration by embedding data-transfer commands inside scheduled tasks to blend with normal traffic patterns."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 capturing full command lines for schtasks.exe and at.exe. PowerShell script-block logging (Event 4104) is complementary but not required for this rule."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate backup agents scheduling BITS transfers, software update mechanisms using schtasks with curl/wget, IT automation scripts performing scheduled file sync to network shares, SCCM or Intune management tasks."
    tuning_guidance = "Add known-good parent process paths (e.g., deployment agents, backup software) to %global_allowed_task_creators. Add known-good task names or command fragments to %global_allowed_scheduled_transfer_tasks. Consider narrowing the network-transfer regex to exclude internal UNC paths if robocopy to internal shares generates noise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(schtasks|at)\.exe$/ nocase
    $proc.target.process.command_line = /\/create|\/add/ nocase
    $proc.target.process.command_line = /(curl|wget|bitsadmin|certutil|ftp\.exe|robocopy.*\\\\|Invoke-WebRequest|Invoke-RestMethod|Start-BitsTransfer|WebClient|DownloadFile|UploadFile|sftp|pscp|winscp)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_task_creators
    not $proc.target.process.command_line in %global_allowed_scheduled_transfer_tasks

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity = array_distinct($proc.principal.hostname)
    $task_command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $initiating_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
