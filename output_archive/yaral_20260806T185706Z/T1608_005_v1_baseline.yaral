/*
  MITRE Technique : T1608.005 - Link Target
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:33:10.256830+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_005_Phishing_Link_Target_Credential_Page {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound HTTP/HTTPS requests to newly observed or suspicious domains serving login-themed pages, consistent with adversaries staging phishing link targets (credential harvesting pages, cloned login portals). Signals include requests to paths containing authentication keywords combined with referrer anomalies or suspicious URI patterns indicative of cloned login infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.005"
    mitre_technique_name = "Stage Capabilities: Link Target"
    log_prerequisites = "Requires proxy or next-generation firewall HTTP/HTTPS inspection logs with URI, referrer, user-agent, and response code fields normalised into UDM NETWORK_HTTP events."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SSO portals, corporate VPN login pages, SaaS authentication flows, password manager autofill checks, security awareness training platforms simulating phishing."
    tuning_guidance = "Populate %global_allowed_login_domains with approved SSO, SaaS, and corporate authentication domains. Populate %global_internal_networks with RFC-1918 and corporate egress ranges. Tighten the URI regex to match patterns observed in threat intelligence for active campaigns."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"

    // Outbound request only - target must not be an internal/trusted destination
    not $http.target.hostname in %global_allowed_login_domains

    // URI path contains authentication or credential-harvesting keywords
    // typical of cloned login pages or staged phishing infrastructure
    (
      $http.network.http.request_url = /\/(login|signin|sign-in|account|auth|verify|secure|update|confirm|webmail|owa|portal|sso|oauth|saml|credential|password|reset|recover|unlock|validate|checkpoint)/ nocase
      or
      $http.network.http.request_url = /\/(wp-login|xmlrpc|admin\/login|user\/login|session\/new)/ nocase
    )

    // Suspicious URI structural patterns: excessive subpath depth or
    // query strings mimicking legitimate service redirects
    (
      $http.network.http.request_url = /\?.*redirect(_to|_uri|_url|Uri|URL)?=/ nocase
      or
      $http.network.http.request_url = /\?.*next=/ nocase
      or
      $http.network.http.request_url = /\?.*continue=/ nocase
      or
      $http.network.http.request_url = /\?.*returnUrl=/ nocase
      or
      // Deep path depth typical of cloned site directory mirroring
      $http.network.http.request_url = /\/[^\/]+\/[^\/]+\/[^\/]+\/(login|signin|auth)/ nocase
    )

    // Exclude known-safe internal source ranges via reference list
    not $http.principal.ip in %global_internal_networks

    // Exclude well-known high-volume benign user agents (bots, scanners)
    not $http.network.http.user_agent = /^(curl|wget|python-requests|go-http-client|libwww-perl|masscan|zgrab)/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1608.005")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hostname = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.network.http.request_url)
    $http_response_code = array_distinct($http.network.http.response_code)

  condition:
    $http
}
