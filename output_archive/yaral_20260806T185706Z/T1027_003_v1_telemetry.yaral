/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:02:24.266711+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Stego_DNS_Exfil_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS query patterns consistent with steganographic data exfiltration on macOS: abnormally long subdomain labels, high-entropy subdomains, or TXT/NULL record type queries that may carry hidden payloads embedded in image or media files. Steganography tooling on macOS frequently exfiltrates encoded data via DNS tunneling using TXT records or algorithmically generated subdomains."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires DNS query/resolver logs normalised into Chronicle UDM NETWORK_DNS events. Recursive resolver or endpoint DNS logging must be enabled."
    platform = "macOS"
    log_source = "dns"
    false_positives = "CDN providers using long token-based subdomains, legitimate DNS-over-HTTPS fallback probes, software update services with encoded query strings, telemetry beacons from analytics SDKs."
    tuning_guidance = "Add known-good high-entropy domains (CDN, analytics, update services) to %global_allowed_dns_domains. Raise the subdomain length threshold if CDN traffic generates false positives. Consider pairing with a FILE_CREATION rule detecting image writes from unusual parent processes for higher-fidelity correlation."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Target DNS query patterns indicative of steganographic exfiltration:
    // 1. TXT or NULL record queries (common DNS tunnel / stego exfil channels)
    // 2. Extremely long subdomain labels (encoded payload chunks)
    // 3. High subdomain depth combined with long labels
    (
      // TXT record queries (qtype 16) - primary channel for DNS stego exfil
      $dns.network.dns.questions.type = 16
      or
      // NULL record queries (qtype 10) - used by some DNS tunnel tools
      $dns.network.dns.questions.type = 10
      or
      // Long subdomain label pattern: label of 40+ chars before first dot
      // indicative of base64/hex encoded stego payload chunks
      $dns.network.dns.questions.name = /^[a-zA-Z0-9+\/=_\-]{40,}\.[^.]+\.[^.]+/ nocase
      or
      // Deep subdomain nesting with encoded-looking labels (3+ labels, long total)
      $dns.network.dns.questions.name = /^([a-zA-Z0-9+\/=_\-]{20,}\.){3,}/ nocase
    )

    // Exclude known-good domains via reference list
    not $dns.network.dns.questions.name in %global_allowed_dns_domains

    // Exclude common macOS system update and telemetry domains
    not $dns.network.dns.questions.name = /\.(apple\.com|icloud\.com|mzstatic\.com|akamaiedge\.net|akamaitechnologies\.com|cloudfront\.net|fastly\.net)$/ nocase

    // Require a resolving host to be present (filters out passive DNS feeds)
    $dns.principal.hostname != ""

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domain = array_distinct($dns.network.dns.questions.name)
    $dns_record_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
