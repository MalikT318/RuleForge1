/*
  MITRE Technique : T1037.002 - Login Hook
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:37:03.349230+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_002_Login_Hook_DNS_C2_Pattern {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS query patterns consistent with C2 or exfiltration activity that may follow macOS Login Hook persistence establishment. Targets high-entropy subdomains, abnormal DNS record types (TXT/NULL), and excessively long subdomain labels commonly used in DNS tunneling or beaconing. Login hooks execute with root privileges at logon, making post-persistence C2 via DNS a high-fidelity signal."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.002"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Login Hook"
    log_prerequisites = "Requires DNS query and resolver logs normalized to Chronicle UDM NETWORK_DNS events. No endpoint telemetry required."
    platform = "macOS"
    log_source = "dns"
    false_positives = "CDN providers using long subdomain labels, legitimate analytics or telemetry services using TXT records, split-horizon DNS configurations, some VPN or zero-trust DNS proxies."
    tuning_guidance = "Add known-good high-entropy domains (CDN, analytics, telemetry) to %global_allowed_dns_domains. Adjust subdomain label length threshold if legitimate internal services trigger. Exclude known corporate DNS resolvers from principal if needed."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Match on abnormal DNS record types used in tunneling/exfiltration (TXT=16, NULL=10)
    // OR long subdomain labels indicative of data encoding in DNS queries
    // OR high-entropy subdomain patterns (hex/base32/base64-like labels)
    (
      $dns.network.dns.questions.type = 16 or
      $dns.network.dns.questions.type = 10 or
      re.regex($dns.network.dns.questions.name, `^[a-z0-9]{30,}\.`) nocase or
      re.regex($dns.network.dns.questions.name, `^[a-f0-9]{20,}\.`) nocase or
      re.regex($dns.network.dns.questions.name, `^[a-z2-7]{25,}\.`) nocase or
      re.regex($dns.network.dns.questions.name, `(?:[^.]{50,})`) nocase
    )

    // Exclude known-good domains via reference list
    not $dns.network.dns.questions.name in %global_allowed_dns_domains

    // Exclude common internal/RFC-reserved TLDs and localhost patterns
    not re.regex($dns.network.dns.questions.name, `\.(local|internal|corp|lan|test|example|invalid)\.?$`) nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1037.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domain = array_distinct($dns.network.dns.questions.name)
    $dns_record_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
