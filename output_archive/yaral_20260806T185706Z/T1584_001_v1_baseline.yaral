/*
  MITRE Technique : T1584.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:20:18.017137+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_001_Suspicious_DNS_NX_Subdomain_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a burst of NXDOMAIN responses for subdomains of the same apex domain, which may indicate subdomain hijacking reconnaissance, domain shadowing activity, or dangling DNS record probing. Adversaries enumerate subdomains to identify deprovisioned resources they can take over, or to validate newly created shadow subdomains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.001"
    mitre_technique_name = "Acquire Infrastructure: Domains"
    log_prerequisites = "Requires DNS query/response logs forwarded from a perimeter firewall, DNS security gateway, or recursive resolver that records NXDOMAIN response codes. UDM event_type NETWORK_DNS with network.dns.response_code populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Misconfigured applications querying stale DNS records, CDN or SaaS platforms with many subdomains during provisioning, automated certificate transparency monitoring tools, legitimate subdomain enumeration by internal security teams."
    tuning_guidance = "Add known-good apex domains (CDN providers, SaaS platforms) to %allowed_apex_domains. Add known internal resolvers to %trusted_internal_resolvers. Raise the threshold or extend the window if the environment has high-volume DNS scanning tools. Exclude monitoring source IPs via %dns_monitoring_sources."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.response_code = 3
    $dns.network.dns.questions.name = /^[a-z0-9\-]{1,63}\.[a-z0-9\-]{1,63}\.[a-z]{2,}$/ nocase
    not $dns.principal.ip in %trusted_internal_resolvers
    not $dns.network.dns.questions.name in %allowed_apex_domains
    not $dns.principal.ip in %dns_monitoring_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.001")
    $primary_entity = array_distinct($dns.principal.ip)

  condition:
    $dns
}
