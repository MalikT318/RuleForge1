/*
  MITRE Technique : T1608.004 - Drive-by Target
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:32:49.660703+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_004_Driveby_Target_Staging_Detection {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-level indicators consistent with drive-by target staging: HTTP responses delivering content with characteristics of injected exploit code (e.g., obfuscated JavaScript, iframe injection, redirect chains) observed via IDS/IPS telemetry. Focuses on traffic-pattern anomalies such as suspicious MIME types, abnormal redirect depth, and IDS alert verdicts on web content delivery - all pre-compromise signals that an adversary may be staging a watering-hole or drive-by infrastructure."
    mitre_tactic          = "Resource Development"
    mitre_technique       = "T1608.004"
    mitre_technique_name  = "Stage Capabilities: Drive-by Target"
    log_prerequisites     = "Requires IDS/IPS HTTP inspection telemetry with decoded URI, referrer, response content-type, and security alert fields populated in UDM NETWORK_HTTP events."
    platform              = "PRE"
    log_source            = "ips"
    false_positives       = "Legitimate ad networks serving JavaScript redirects; CDN-hosted minified JS libraries; analytics platforms with obfuscated tracking code; A/B testing frameworks; legitimate iframe embeds."
    tuning_guidance       = "Add known-good domains and CDN hostnames to %global_allowed_web_domains. Add approved referrer domains to %global_allowed_referrer_domains. Raise risk_score threshold for hosts that also appear in threat-intel feeds."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Target inbound HTTP traffic where the server is delivering web content
    // that IDS/IPS has flagged or that exhibits redirect/injection patterns.
    // Focus on response characteristics rather than specific payload strings.

    // Detect suspicious content types commonly used in drive-by staging:
    // JavaScript, HTML with embedded scripts, or octet-stream masquerading as web content.
    (
      $net.network.http.response_code >= 200
      and $net.network.http.response_code < 400
    )

    // Suspicious URI patterns indicative of exploit kit landing pages or
    // injected redirect chains: deeply nested paths, encoded parameters,
    // or paths with high entropy naming conventions.
    (
      $net.target.url = /\/[a-z0-9]{8,}\?[a-z0-9%=&]{20,}$/  nocase
      or $net.target.url = /\.(php|aspx|jsp)\?[^=]+=.{30,}/   nocase
      or $net.target.url = /(gate|land|click|redir|go|out|track)\//  nocase
    )

    // Referrer anomalies: requests arriving without a referrer to dynamic
    // content pages, or referrer chains that cross domain boundaries
    // unexpectedly (common in watering-hole redirect chains).
    (
      $net.network.http.referral_url = /https?:\/\//  nocase
      or $net.network.http.referral_url = ""
    )

    // IDS/IPS security verdict: alert category names that indicate web
    // exploit, injection, or malicious redirect detection.
    // Using security_result.summary as a supplementary signal only -
    // not sole logic - due to inconsistent vendor UDM mapping.
    (
      $net.security_result.summary = /(exploit|inject|driveby|drive.by|malicious.redirect|iframe.inject|js.inject|obfuscat)/  nocase
      or $net.security_result.category_details = /(web.exploit|browser.exploit|malicious.content|suspicious.redirect)/  nocase
    )

    // Exclude known-good domains and approved web infrastructure
    not $net.target.hostname in %global_allowed_web_domains
    not $net.network.http.referral_url in %global_allowed_referrer_domains

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1608.004")
    $primary_entity    = array_distinct($net.principal.ip)
    $flagged_url       = array_distinct($net.target.url)
    $target_host       = array_distinct($net.target.hostname)
    $http_response     = max($net.network.http.response_code)
    $ids_summary       = array_distinct($net.security_result.summary)

  condition:
    $net
}
