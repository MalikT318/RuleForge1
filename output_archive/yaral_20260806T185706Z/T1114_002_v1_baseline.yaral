/*
  MITRE Technique : T1114.002 - Remote Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:41:52.441143+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_002_Remote_Email_Collection_Bulk_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects bulk or automated remote email collection activity in Microsoft 365, such as mass mailbox search, eDiscovery abuse, or high-volume email access from a single session. Adversaries with valid credentials or tokens may interact directly with Exchange Online to harvest email at scale."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.002"
    mitre_technique_name = "Email Collection: Remote Email Collection"
    log_prerequisites = "Requires Microsoft 365 unified audit logs (MailItemsAccessed, SearchQueryInitiated, or equivalent) normalised into Chronicle UDM USER_RESOURCE_ACCESS events."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate eDiscovery operations, compliance archiving tools, authorised mail migration services, and backup agents. Legal and compliance teams performing bulk searches will trigger this rule."
    tuning_guidance = "Add authorised service accounts and compliance tool identities to %m365_allowed_bulk_mail_accounts. Narrow the threshold or add a target.resource.name filter to scope to sensitive mailboxes only."

  events:
    $auth.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target must be a mailbox or mail resource
    $auth.target.resource.type = /mail/ nocase

    // Catch known high-volume or programmatic mail access operations:
    // MailItemsAccessed (throttled sync), SearchQueryInitiated, ExportMailbox,
    // New-MailboxExportRequest, and similar audit operations normalised into
    // the operation name field.
    $auth.metadata.product_event_type = /MailItemsAccessed|SearchQuery|ExportMailbox|MailboxExport|ContentSearch|eDiscovery|GetItem|SyncFolderItems/ nocase

    // Exclude interactive browser user agents - target programmatic/API access
    // patterns consistent with tools like MailSniper, MAPI clients, or REST API
    $auth.network.http.user_agent = /python|curl|powershell|requests|go-http|java|ruby|perl|axios|wget|libwww|okhttp|mailsniper|imapsync|thunderbird|davmail/ nocase

    // Must have an authenticated principal user
    $auth.principal.user.userid != ""

    // Exclude known-good bulk mail service accounts
    not $auth.principal.user.userid in %m365_allowed_bulk_mail_accounts

    // Exclude known-good source IP ranges (e.g. internal SIEM, archiving appliances)
    not $auth.principal.ip in %m365_allowed_mail_access_ips

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1114.002")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $accessed_resource = array_distinct($auth.target.resource.name)
    $source_ip = array_distinct($auth.principal.ip)
    $user_agent = array_distinct($auth.network.http.user_agent)
    $operation = array_distinct($auth.metadata.product_event_type)

  condition:
    $auth
}
