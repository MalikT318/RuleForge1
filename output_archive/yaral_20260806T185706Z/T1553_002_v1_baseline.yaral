/*
  MITRE Technique : T1553.002 - Code Signing
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:06:51.821989+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_002_Suspicious_Code_Signing_Cert_Import {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects attempts to import or install code-signing certificates into the Windows certificate store via command-line utilities. Adversaries use this to establish trust for malicious binaries by importing stolen or self-signed code-signing certificates, bypassing application whitelisting and execution policies that require signed code."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553.002"
    mitre_technique_name = "Subvert Trust Controls: Code Signing"
    log_prerequisites = "Requires EDR process telemetry with command-line capture (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment pipelines importing legitimate vendor certificates, PKI administrators managing enterprise CA certificates, developer workstations installing SDK signing certificates."
    tuning_guidance = "Add known-good parent processes (e.g., software installers, MDM agents) to %global_allowed_cert_import_parents. Add known-good user accounts performing PKI administration to %global_pki_admin_users."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target known Windows certificate management utilities
    $proc.target.process.file.full_path = /\\(certutil|certmgr|powershell|pwsh|signtool|CertReq)\.exe$/ nocase

    // Match certificate import/add operations across multiple tools
    (
      // certutil import patterns
      $proc.target.process.command_line = /\-(addstore|importpfx|addcert|import)/ nocase
      or
      // PowerShell certificate store manipulation
      $proc.target.process.command_line = /Import\-Certificate|X509Certificate|CertificateStore|StoreName\s*=\s*['"](My|Root|TrustedPublisher|CA)/ nocase
      or
      // certmgr add to store
      $proc.target.process.command_line = /\/(add|put)/ nocase
      or
      // signtool or certreq submission
      $proc.target.process.command_line = /\/(submit|accept|retrieve)/ nocase
    )

    // Specifically target code-signing relevant certificate stores or file extensions
    (
      $proc.target.process.command_line = /\.(cer|crt|pfx|p12|p7b|spc)/ nocase
      or
      $proc.target.process.command_line = /(TrustedPublisher|Root|AuthRoot|CA)\b/ nocase
      or
      $proc.target.process.command_line = /CodeSigning|code.sign/ nocase
    )

    // Exclude known-good parent processes and admin accounts
    not $proc.principal.process.file.full_path in %global_allowed_cert_import_parents
    not $proc.principal.user.userid in %global_pki_admin_users

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1553.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $initiating_process = array_distinct($proc.principal.process.file.full_path)
    $cert_command = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
