/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 3  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T18:57:54.088284+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Windows_Firewall_Disabled_Via_Netsh_Or_Profile {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects attempts to disable the Windows host firewall or suppress a firewall profile using netsh advfirewall or PowerShell Set-NetFirewallProfile. Adversaries disable the firewall to enable inbound C2 connectivity or lateral movement without triggering firewall blocks."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Windows Host Firewall"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Network configuration scripts run by IT operations, software deployment agents (e.g., SCCM/Intune), and some VPN clients that temporarily adjust firewall profiles during tunnel establishment."
    tuning_guidance = "Add known-good parent process paths (e.g., deployment agent executables) to %global_allowed_firewall_managers. Scope further by requiring the parent to be an interactive shell if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match either netsh or PowerShell as the launched binary
    (
      $proc.target.process.file.full_path = /\\netsh\.exe$/ nocase
      or
      $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    )

    // netsh advfirewall set ... state off  -OR-  PowerShell Set-NetFirewallProfile ... -Enabled False
    (
      // netsh: disable all profiles or a named profile
      (
        $proc.target.process.command_line = /advfirewall/ nocase
        and $proc.target.process.command_line = /set\s+(allprofiles|domainprofile|privateprofile|publicprofile)/ nocase
        and $proc.target.process.command_line = /state\s+off/ nocase
      )
      or
      // PowerShell: Set-NetFirewallProfile with -Enabled False
      (
        $proc.target.process.command_line = /Set-NetFirewallProfile/ nocase
        and $proc.target.process.command_line = /-Enabled\s+(False|\$false|0)/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_firewall_managers

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $actor_process     = array_distinct($proc.principal.process.file.full_path)
    $command_executed  = array_distinct($proc.target.process.command_line)
    $actor_user        = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
