/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:02:03.645290+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Packed_Binary_Beaconing_Firewall {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a pattern consistent with a packed/obfuscated binary executing on macOS and subsequently establishing an outbound network connection through the perimeter. The first event captures a suspicious file written to a user-writable or temp path (common drop location for unpacked payloads). The second event captures an outbound connection from the same source host shortly after, on a non-standard port, to a non-internal destination. Packed malware frequently unpacks to disk or memory and then beacons out; this rule correlates the file-drop observable with the network-observable across firewall telemetry."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires (1) an EDR or macOS unified log source producing FILE_CREATION events for user-writable paths, AND (2) a perimeter firewall/proxy log source producing NETWORK_CONNECTION or NETWORK_FLOW events. Both sources must populate principal.hostname so the join can be made."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Software update agents writing binaries to /tmp or ~/Library/Caches before phoning home for validation; developer toolchains (Homebrew, Xcode helpers); legitimate apps that self-update by dropping a new binary and then connecting to their update CDN."
    tuning_guidance = "Add known-good source hostnames to %macos_allowed_update_hosts. Add approved external CIDR ranges or destination ports to %macos_allowed_egress_ports. Narrow the file path regex if a specific staging directory is generating noise."

  events:
    // Leg 1: A new executable-like file is written to a user-writable or
    // temporary path on macOS - common staging area for unpacked payloads.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(private\/tmp|var\/folders|Users\/[^\/]+\/Library\/(Caches|Application Support|Containers)|tmp)\/[^\/]+$/ nocase
    not $file.target.file.full_path in %macos_allowed_staged_paths
    $file.principal.hostname = $src_host

    // Leg 2: Outbound network connection from the same host shortly after,
    // on a non-standard port (not 80/443/53), to a non-internal destination.
    // Firewall logs do not carry process context - match on host and port only.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port > 1024
    not $net.target.ip in %macos_internal_address_space
    not $net.principal.hostname in %macos_allowed_update_hosts
    $net.principal.hostname = $src_host

    // Chronological ordering: file drop must precede the outbound connection.
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_host over 5m

  outcome:
    $risk_score          = max(78)
    $mitre_technique_id  = array_distinct("T1027.002")
    $primary_entity      = array_distinct($src_host)
    $staged_file_paths   = array_distinct($file.target.file.full_path)
    $destination_ips     = array_distinct($net.target.ip)
    $destination_ports   = array_distinct($net.target.port)
    $connection_count    = count($net.metadata.event_timestamp.seconds)

  condition:
    $file and $net
}
