/*
  MITRE Technique : T1129 - Shared Modules
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:43:34.978066+00:00
  Reference       : https://attack.mitre.org/techniques/T1129
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1129_001_Suspicious_Shared_Object_Load_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes loading shared objects (.so files) from world-writable or non-standard paths such as /tmp, /dev/shm, /var/tmp, or user home directories. Adversaries abuse the Linux dynamic linker (dlopen/dlsym via ld.so) to execute malicious shared modules from arbitrary locations, bypassing standard library paths."
    mitre_tactic = "Execution"
    mitre_technique = "T1129"
    mitre_technique_name = "Shared Modules"
    log_prerequisites = "Requires Linux EDR or auditd telemetry capturing process launches with command-line arguments, or file open/load events. Auditd rules targeting openat/open syscalls on .so files in writable paths are ideal."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers testing shared libraries in /tmp; build systems compiling and immediately loading test objects; some legitimate JVM or Python native extension workflows that stage .so files in temp directories."
    tuning_guidance = "Add known build/CI process paths to %linux_allowed_so_loader_processes. Add approved staging directories to %linux_allowed_so_staging_paths. Consider narrowing to specific high-value parent processes (e.g., web servers, interpreters) if noise is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target process is a dynamic linker utility, interpreter, or generic loader
    // invoking a shared object from a suspicious writable path.
    // Match ld.so/ld-linux invocations, or processes whose command line references
    // a .so file from a non-standard writable location.
    (
      $proc.target.process.command_line = /\/(tmp|dev\/shm|var\/tmp|run\/shm)[^\s]*\.so(\.[0-9]+)*(\s|$)/ nocase
      or
      $proc.target.process.command_line = /\/home\/[^\/\s]+\/[^\s]*\.so(\.[0-9]+)*(\s|$)/ nocase
      or
      $proc.target.process.command_line = /\/proc\/[^\/\s]+\/[^\s]*\.so(\.[0-9]+)*(\s|$)/ nocase
    )

    // Exclude known legitimate loader binaries that are expected to reference .so paths
    not $proc.target.process.file.full_path in %linux_allowed_so_loader_processes

    // Exclude known safe staging directories approved per-client
    not $proc.target.process.command_line in %linux_allowed_so_staging_paths

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1129")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $loader_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
