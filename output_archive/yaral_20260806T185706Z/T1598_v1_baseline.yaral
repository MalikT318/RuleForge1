/*
  MITRE Technique : T1598 - Phishing for Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:25:58.781062+00:00
  Reference       : https://attack.mitre.org/techniques/T1598
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_Phishing_For_Information_Credential_Harvest_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects inbound HTTP/HTTPS traffic patterns consistent with credential harvesting or phishing-for-information pages. Looks for IDS/IPS-flagged connections to suspicious login-lookalike URIs, form submission patterns, and repeated access to newly observed or low-reputation external hosts on web ports. Targets pre-compromise reconnaissance activity where adversaries attempt to trick users into submitting credentials or sensitive data."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598"
    mitre_technique_name = "Phishing for Information"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_HTTP events. Security appliance must inspect HTTP metadata including URI, referrer, and user-agent fields. TLS inspection recommended for HTTPS coverage."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate password reset portals, SSO login pages, corporate webmail, SaaS authentication endpoints, penetration testing activity."
    tuning_guidance = "Add known-good internal and SaaS login domains to %global_allowed_login_domains. Add approved credential-collection services (e.g. survey tools) to %global_allowed_form_submission_hosts. Tune the URI regex if internal apps use similar path patterns."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Target external destinations only - not RFC1918 or loopback
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_login_domains

    // Match URI patterns strongly associated with credential harvesting pages:
    // login, signin, verify, account, secure, update, confirm, webmail, portal
    // combined with common phishing page path structures
    (
      $net.network.http.request_url = /\/(login|signin|sign-in|verify|account|secure|update|confirm|webmail|portal|credential|auth|authenticate|reset|recover|unlock|validate)/ nocase
      or
      $net.network.http.request_url = /\.(php|asp|aspx|html|htm)\?.*?(user|email|pass|token|code|key|id)=/  nocase
    )

    // HTTP POST submissions are the primary exfiltration vector for harvested credentials
    $net.network.http.method = "POST"

    // Exclude well-known high-volume legitimate referrers that would generate noise
    not $net.network.http.referral_url = /\.(google|microsoft|okta|ping|duo|salesforce|office365|live|outlook|azure)\.com/ nocase

    // Exclude known-safe source hosts (internal approved systems)
    not $net.principal.hostname in %global_allowed_form_submission_hosts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1598")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_host = array_distinct($net.target.hostname)
    $suspicious_uri = array_distinct($net.network.http.request_url)
    $http_method = array_distinct($net.network.http.method)

  condition:
    $net
}
