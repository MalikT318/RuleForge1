/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:27:23.598406+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_Network_Boundary_Bridging_DNS_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS-based network boundary bridging and exfiltration patterns consistent with T1599. Adversaries who compromise perimeter or segmentation devices may relay DNS queries carrying encoded data or C2 beaconing across trust boundaries. Signals include: high-entropy subdomain labels (algorithmically generated domains), abnormally long subdomain chains, suspicious record types (TXT, NULL, ANY) that are rarely used in legitimate traffic, and queries to domains not present in the known-good allowlist. These patterns indicate data exfiltration or C2 tunnelling through DNS, which boundary devices may be forced to permit once compromised."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Requires DNS query/resolver logs normalised into Chronicle UDM NETWORK_DNS events. Resolver must log full QNAME, QTYPE, source IP, and response code."
    platform = "Network Devices"
    log_source = "dns"
    false_positives = "CDN providers using long randomised hostnames (e.g. Akamai, Cloudflare), legitimate TXT record lookups for SPF/DKIM/DMARC validation, automated certificate provisioning (ACME DNS-01 challenges), cloud-provider health-check subdomains."
    tuning_guidance = "Populate %dns_allowlisted_domains with known-good apex domains (CDN, SaaS, internal). Populate %dns_allowlisted_resolvers with authorised recursive resolvers. Raise the subdomain-length threshold or restrict QTYPE matching if false-positive volume is high in a specific environment."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Suspicious record types used for tunnelling or exfiltration
    (
      $dns.network.dns.questions.type = 16 or   // TXT
      $dns.network.dns.questions.type = 10 or   // NULL
      $dns.network.dns.questions.type = 255 or  // ANY
      $dns.network.dns.questions.type = 28       // AAAA used as covert channel fallback
    )

    // Long subdomain label chain: full QNAME exceeding 50 characters before the apex
    // is a strong indicator of base64/hex-encoded payload in the label
    re.capture($dns.network.dns.questions.name, /^(.{50,})\.[^.]+\.[^.]+$/) != ""

    // High-entropy or algorithmically generated subdomain patterns:
    // labels composed predominantly of hex characters or long alphanumeric runs
    $dns.network.dns.questions.name = /^[0-9a-f]{16,}\./  nocase

    // Exclude known-good apex domains
    not $dns.network.dns.questions.name in %dns_allowlisted_domains

    // Exclude queries originating from authorised internal resolvers
    not $dns.principal.ip in %dns_allowlisted_resolvers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1599")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_name = array_distinct($dns.network.dns.questions.name)
    $query_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
