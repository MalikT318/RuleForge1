/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:13:12.778936+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_InvisibleUnicode_SuspiciousLoginThenPrivilegeChange {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a pattern consistent with invisible-Unicode-assisted credential or identity abuse: an anomalous authentication event (e.g. atypical user-agent string containing zero-width or bidirectional Unicode control characters, or a login flagged with a risk signal) followed within 5 minutes by a privilege or group change from the same principal. Adversaries embedding invisible Unicode in phishing lures or consent-grant flows may trigger this sequence after a victim authenticates and an automated post-auth action elevates the attacker-controlled identity."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires identity-provider sign-in logs and directory audit logs normalised into Chronicle UDM. Sign-in events must populate metadata.event_type = USER_LOGIN and include security_result.severity or risk signals. Directory audit events must populate metadata.event_type = USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION with principal.user.userid."
    platform        = "Windows"
    log_source      = "identity"
    false_positives = "Automated provisioning workflows that grant permissions immediately after a service-account login; break-glass account usage; legitimate IT admin activity during onboarding; SCIM-driven group sync jobs."
    tuning_guidance = "Add known provisioning service-account userids to %idp_allowed_provisioning_accounts. Add known admin group names to %idp_allowed_admin_groups if bulk group changes are expected. Raise the match window if provisioning pipelines are slower than 5 minutes."

  events:
    // Event 1: A login event carrying a risk or anomaly signal from the IdP.
    // Risk signals surface as HIGH/CRITICAL severity on the security_result,
    // which IdP normalisation populates when the provider flags the sign-in
    // (e.g. impossible travel, leaked credential, token anomaly, or a
    // user-agent string containing invisible Unicode code points that the
    // IdP flags as suspicious).
    $auth.metadata.event_type = "USER_LOGIN"
    (
        $auth.security_result.severity = "HIGH" or
        $auth.security_result.severity = "CRITICAL"
    )
    not $auth.principal.user.userid in %idp_allowed_provisioning_accounts
    $auth.principal.user.userid = $userid

    // Event 2: A privilege or group change originating from the same userid
    // within the time window, indicating post-authentication escalation.
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    not $priv.principal.user.userid in %idp_allowed_provisioning_accounts
    not $priv.target.group.group_display_name in %idp_allowed_admin_groups
    $priv.principal.user.userid = $userid

    // Chronological ordering: login must precede the privilege change.
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $userid over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1027.018")
    $primary_entity      = array_distinct($userid)
    $auth_severity       = array_distinct($auth.security_result.severity)
    $changed_permissions = array_distinct($priv.target.resource.name)
    $auth_count          = count($auth.metadata.id)
    $priv_change_count   = count($priv.metadata.id)

  condition:
    $auth and $priv
}
