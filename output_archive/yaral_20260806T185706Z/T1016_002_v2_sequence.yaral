/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:26:47.905492+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_WiFi_Discovery_Netsh_Then_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects Wi-Fi credential harvesting: a netsh wlan profile enumeration or key-clear dump is followed within 10 minutes by a file write on the same host, suggesting the output was redirected or staged to disk for exfiltration. Complements existing single-event command-line rules by requiring the downstream file-write artefact."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH with full command line) and file-creation telemetry (FILE_CREATION with target.file.full_path) from the same host. Sysmon Event IDs 1 and 11 or equivalent EDR events normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Network inventory scripts run by IT operations, MDM/RMM agents that audit Wi-Fi profiles, authorised penetration testing activity."
    tuning_guidance = "Add authorised admin parent processes to %global_allowed_wifi_enum_parents. Add known-safe output directories (e.g. IT tooling staging paths) to %global_allowed_wifi_output_dirs. Narrow the file extension filter if text/log writes are too noisy in your environment."

  events:
    // Event 1: netsh launched with wlan profile enumeration or key-clear arguments
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\netsh\.exe$/ nocase
    $proc.target.process.command_line = /wlan/ nocase
    $proc.target.process.command_line = /(show\s+profile|key\s*=\s*clear)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_wifi_enum_parents
    $proc.principal.hostname = $hostname

    // Event 2: a file is written on the same host shortly after
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(txt|log|csv|dat|tmp|out)$/ nocase
    not $file.target.file.full_path in %global_allowed_wifi_output_dirs
    $file.principal.hostname = $hostname

    // Chronological ordering: process launch must precede the file write
    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $netsh_command_lines = array_distinct($proc.target.process.command_line)
    $written_file_paths = array_distinct($file.target.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc and $file
}
