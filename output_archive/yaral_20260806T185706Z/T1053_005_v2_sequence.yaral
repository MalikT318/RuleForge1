/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:16:15.619724+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_ScheduledTask_Login_After_Privilege_Change {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a suspicious identity-plane sequence: a privileged role or group modification granting elevated rights (e.g. adding a user to a highly-privileged group) followed within 1 hour by a successful interactive login from that same account. This pattern is consistent with an adversary creating or modifying a scheduled task under an elevated account context after first elevating the account via directory manipulation. Covers the identity-provider angle not addressed by process-creation rules."
    mitre_tactic    = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires identity-provider audit logs (Entra ID / Okta / AD) normalised to UDM GROUP_MODIFICATION and USER_LOGIN events. Both event types must be ingested and parsed into UDM principal.user.userid and target.user.userid."
    platform        = "Windows"
    log_source      = "identity"
    false_positives = "Legitimate IT provisioning workflows where a helpdesk operator elevates an account and the user immediately logs in; automated service-account provisioning pipelines; onboarding automation."
    tuning_guidance = "Add known provisioning service accounts to %global_allowed_provisioning_accounts. Add known privileged-group names that are routinely managed by automation to %global_allowed_managed_groups. Narrow the match window if false-positive volume is high."

  events:
    // Leg 1: a privileged group modification targeting a specific user account
    $grp.metadata.event_type = "GROUP_MODIFICATION"
    // The group being modified must be a high-privilege group (admin, privileged, operator, etc.)
    $grp.target.group.group_display_name = /admin|privilege|operator|global.admin|domain.admin|schema|enterprise|backup.operator|account.operator|server.operator/ nocase
    // The subject being added to the group is the account we track
    $grp.target.user.userid != ""
    not $grp.target.user.userid in %global_allowed_provisioning_accounts
    not $grp.target.group.group_display_name in %global_allowed_managed_groups
    $grp.target.user.userid = $elevated_userid

    // Leg 2: a successful interactive login by that same account shortly after
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = $elevated_userid
    // Restrict to interactive / non-service login types where applicable
    not $auth.target.user.userid in %global_allowed_provisioning_accounts

    // Chronological ordering: privilege change must precede the login
    $grp.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $elevated_userid over 1h

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1053.005")
    $primary_entity      = array_distinct($elevated_userid)
    $modified_groups     = array_distinct($grp.target.group.group_display_name)
    $login_count         = count($auth.metadata.event_timestamp.seconds)
    $modifying_actor     = array_distinct($grp.principal.user.userid)

  condition:
    $grp and $auth
}
