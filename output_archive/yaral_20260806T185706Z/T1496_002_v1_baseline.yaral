/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:57:20.683455+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_Container_Bandwidth_Hijack_Workload_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of container workloads (Pods, Jobs, DaemonSets, Deployments) via cloud control-plane audit logs where the resource name or image reference contains patterns associated with proxyjacking, bandwidth-hijacking, or internet-scanning tooling. Adversaries deploy containers to abuse victim network bandwidth for proxyware services, botnet participation, or mass scanning (T1496.002). The rule targets the API-level resource creation event rather than binary names so it fires even if the attacker renames their tool."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Bandwidth Hijacking"
    log_prerequisites = "Requires cloud provider Kubernetes/container-platform audit logs normalised into Chronicle UDM. The audit log must capture the target.resource.name and/or target.resource.attribute.labels fields for workload creation API calls (e.g., pods/create, jobs/create, daemonsets/create)."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate network-testing workloads, authorised bandwidth-measurement jobs, approved proxy or VPN sidecar containers, security-scanning pipelines. Tune using %approved_container_workload_names and %approved_container_namespaces."
    tuning_guidance = "Add approved workload names to %approved_container_workload_names and approved Kubernetes namespaces to %approved_container_namespaces. Consider narrowing the image-pattern regex to your environment's known-bad naming conventions after initial baselining."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target resource must be a container workload type
    $cloud.target.resource.resource_subtype = /^(pod|job|cronjob|daemonset|deployment|replicaset|statefulset)$/ nocase

    // Detect suspicious workload names or image references indicative of
    // proxyjacking agents, bandwidth-resale software, or mass-scanning tools.
    // Pattern covers common naming conventions without hardcoding specific tool names.
    (
      $cloud.target.resource.name = /proxy|socks|tunnel|bandwidth|scan|crawler|spider|torrent|p2p|peer|relay|exit.?node|resid(ential)?|rotate|rotate.?ip|ip.?rotat/ nocase
      or
      $cloud.target.resource.attribute.labels["image"] = /proxy|socks|tunnel|bandwidth|scan|crawler|spider|torrent|p2p|peer|relay|exit.?node|resid(ential)?|rotate|rotate.?ip|ip.?rotat/ nocase
    )

    // Exclude approved workload names and namespaces
    not $cloud.target.resource.name in %approved_container_workload_names
    not $cloud.target.resource.attribute.labels["namespace"] in %approved_container_namespaces

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $workload_name = array_distinct($cloud.target.resource.name)
    $workload_type = array_distinct($cloud.target.resource.resource_subtype)
    $namespace = array_distinct($cloud.target.resource.attribute.labels["namespace"])
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
