/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:10:30.660891+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Compressed_Archive_Exfil_Network_Burst {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects large outbound network flows on ports commonly used for file transfer or web traffic originating from macOS endpoints. Adversaries using T1027.015 compress payloads before exfiltration; the resulting transfer produces an anomalously large single flow to an external destination. This rule pivots on the network-observable artifact of the compression technique rather than the compression command itself, providing additive coverage beyond process-creation detections."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires firewall or perimeter flow logs with bytes_sent populated. Flow records must include source/destination IP and port. Internal RFC-1918 and RFC-6598 ranges should be enumerated in %internal_address_ranges reference list."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Legitimate large file uploads (cloud backup agents, software update distribution, video conferencing screen share), CDN origin pushes, authorized data pipeline transfers. Tune by adding known-good destination CIDRs to %allowed_bulk_transfer_destinations and source hosts to %allowed_bulk_upload_hosts."
    tuning_guidance = "Lower the bytes threshold if the environment has strict DLP controls. Raise it if cloud backup traffic is heavy. Add sanctioned SaaS egress IPs to %allowed_bulk_transfer_destinations. Restrict to business hours using timestamp filters if after-hours exfil is the primary concern."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Outbound only - source is internal, destination is external
    $net.principal.ip in %internal_address_ranges
    not $net.target.ip in %internal_address_ranges
    not $net.target.ip in %allowed_bulk_transfer_destinations
    not $net.principal.ip in %allowed_bulk_upload_hosts

    // Ports commonly abused for compressed payload delivery or exfil:
    // 80 (HTTP), 443 (HTTPS), 8080 (alt-HTTP), 21 (FTP), 22 (SFTP/SCP),
    // 8443 (alt-HTTPS), 2222 (alt-SSH)
    $net.target.port in [21, 22, 80, 443, 2222, 8080, 8443]

    // Large single-flow transfer indicative of a compressed archive upload.
    // 5 MB threshold catches most compressed payload exfil while reducing
    // noise from normal browsing. Tune via tuning_guidance above.
    $net.network.sent_bytes > 5242880

    // Capture destination port for outcome enrichment
    $dest_port = $net.target.port

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($dest_port)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
