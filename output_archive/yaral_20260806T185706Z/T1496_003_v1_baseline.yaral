/*
  MITRE Technique : T1496.003 - SMS Pumping
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:57:41.863010+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_003_SMS_Pumping_Burst_Detection {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects anomalously high volumes of SMS send API calls within a short window, indicative of SMS pumping fraud. Adversaries abuse public-facing OTP or account-verification endpoints backed by cloud messaging services (e.g., SNS, Cognito, Twilio) to generate large quantities of SMS messages to attacker-controlled number ranges, earning telco revenue at the victim's expense. This rule fires when a single principal (user identity, API key, or unauthenticated session) triggers an unusually high count of SMS-dispatch resource-access events in the cloud audit log."
    mitre_tactic    = "Impact"
    mitre_technique = "T1496.003"
    mitre_technique_name = "Resource Hijacking: SMS Pumping"
    log_prerequisites = "Requires cloud provider audit logs capturing API-level calls to messaging or notification services (e.g., AWS SNS Publish, Cognito InitiateAuth with SMS MFA, or equivalent). Events must be normalised to UDM USER_RESOURCE_ACCESS with target.resource.name or target.application populated."
    platform        = "SaaS"
    log_source      = "cloud_audit"
    false_positives = "Legitimate bulk SMS campaigns (marketing, alerts), automated OTP flows during high-traffic events (product launches, elections), load-testing of messaging pipelines."
    tuning_guidance = "Add known bulk-send service accounts or CI/CD identities to %allowed_bulk_sms_principals. Raise the threshold in the match window if the customer runs high-volume legitimate OTP flows. Narrow target.resource.name regex to the specific SNS topic or Cognito user pool ARN patterns in use."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match API actions associated with SMS dispatch across cloud messaging services
    // Covers SNS Publish, Cognito SMS MFA triggers, and generic notification publish verbs
    $cloud.target.resource.name = /sms|sns|publish|notify|otp|verification|cognito|messaging/ nocase

    // Restrict to actions that actually send or initiate an SMS
    $cloud.metadata.product_event_type = /publish|send.*sms|initiate.*auth|resend.*code|send.*otp|send.*message|send.*notification/ nocase

    // Capture the calling principal for grouping; covers both authenticated and
    // unauthenticated (anonymous) callers normalised to a session/IP identifier
    $cloud.principal.user.userid = $caller_id

    // Exclude known legitimate bulk-send identities
    not $cloud.principal.user.userid in %allowed_bulk_sms_principals

    // Exclude internal automation accounts approved for high-volume messaging
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  match:
    $caller_id over 5m

  outcome:
    // High base score; SMS pumping causes direct financial harm
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1496.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $sms_api_call_count = count($cloud.metadata.id)
    $distinct_target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)
    $event_actions = array_distinct($cloud.metadata.product_event_type)

  condition:
    // Require at least 50 SMS-dispatch API calls from the same caller within 5 minutes
    // to distinguish pumping bursts from normal OTP flows
    #cloud >= 50
}
