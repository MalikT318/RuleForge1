/*
  MITRE Technique : T1578.001 - Create Snapshot
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:16:01.928768+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_001_Cloud_Snapshot_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of cloud compute snapshots (VM, volume, or disk) via cloud provider audit logs. Adversaries may create snapshots to bypass access restrictions on existing compute infrastructure, mount them to attacker-controlled instances, and exfiltrate data or escalate privileges."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.001"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Snapshot"
    log_prerequisites = "Requires cloud provider audit logs ingested into Chronicle (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). Snapshot creation API calls must be captured."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized backup jobs, disaster recovery automation, infrastructure-as-code pipelines (Terraform, Pulumi), scheduled maintenance snapshots, and cloud-native backup services."
    tuning_guidance = "Add approved service accounts and automation principals to %cloud_allowed_snapshot_principals. Add approved resource projects or accounts to %cloud_allowed_backup_accounts. Consider correlating with off-hours activity or unusual source IPs for higher fidelity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Match snapshot creation API operations across AWS, Azure, and GCP
    // AWS: CreateSnapshot, CreateSnapshots, CopySnapshot
    // Azure: Microsoft.Compute/snapshots/write
    // GCP: compute.disks.createSnapshot, compute.snapshots.insert
    $cloud.metadata.product_event_type = /snapshot/ nocase

    // Ensure the operation is a write/create action, not a read or list
    $cloud.metadata.product_event_type = /(creat|insert|write|copy)/ nocase

    // Capture the acting principal (user, service account, or assumed role)
    $cloud.principal.user.userid = $actor

    // Exclude known-good automation principals and backup service accounts
    not $cloud.principal.user.userid in %cloud_allowed_snapshot_principals

    // Exclude known-good cloud accounts or projects used for authorized backups
    not $cloud.target.resource.name in %cloud_allowed_backup_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1578.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $snapshot_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)
    $cloud_environment = array_distinct($cloud.principal.namespace)

  condition:
    $cloud
}
