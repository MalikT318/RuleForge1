/*
  MITRE Technique : T1553.003 - SIP and Trust Provider Hijacking
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:07:11.374180+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Registry_Hijack {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of registry keys that define Subject Interface Packages (SIPs) or Authenticode Trust Providers. Adversaries tamper with these keys to redirect signature validation to a malicious DLL, bypassing Windows code-integrity checks (T1553.003)."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires Windows registry auditing via EDR (e.g., Sysmon Event ID 13) or Windows Security Event 4657 normalised to UDM REGISTRY_MODIFICATION."
    platform        = "Windows"
    log_source      = "identity"
    false_positives = "Legitimate cryptographic library installations, Windows Update patching SIP components, security software registering custom trust providers."
    tuning_guidance = "Add known-good installer parent processes (e.g., msiexec.exe invoked by a software deployment system) to %global_allowed_sip_installers. Scope further by correlating with change-management windows."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // SIP registration hive — covers both 32-bit and 64-bit SIP GUID keys
    (
      $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Cryptography\\OID\\EncodingType 0\\CryptSIPDll/ nocase
      or
      $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Cryptography\\Providers\\Trust\\/ nocase
      or
      $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Cryptography\\OID\\EncodingType 0\\CryptSIPDllVerifyIndirectData/ nocase
      or
      $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Cryptography\\OID\\EncodingType 0\\CryptSIPDllGetSignedDataMsg/ nocase
      or
      $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Cryptography\\OID\\EncodingType 0\\CryptSIPDllPutSignedDataMsg/ nocase
      or
      $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Cryptography\\OID\\EncodingType 0\\CryptSIPDllCreateIndirectData/ nocase
    )

    // The value being written points to a DLL — catch both Dll and FuncName value names
    (
      $reg.target.registry.registry_value_name = /^(Dll|FuncName)$/  nocase
    )

    // Exclude processes that legitimately register SIP/trust-provider DLLs
    not $reg.principal.process.file.full_path in %global_allowed_sip_installers

    // Exclude writes originating from known Windows system directories
    // (system32 / syswow64 host the legitimate wintrust.dll, mssip*.dll, etc.)
    not $reg.principal.process.file.full_path = /\\Windows\\(System32|SysWOW64)\\/ nocase

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity    = array_distinct($reg.principal.hostname)
    $modified_key      = array_distinct($reg.target.registry.registry_key)
    $modified_value    = array_distinct($reg.target.registry.registry_value_name)
    $actor_process     = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
