/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:43:51.814612+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_Access_Token_Manipulation_Privilege_Elevation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects access token manipulation via identity provider audit logs. Specifically targets anomalous privilege elevation or role assignment events where a principal gains elevated permissions outside of normal provisioning workflows, consistent with token-based privilege escalation or impersonation resulting in directory-level privilege changes."
    mitre_tactic = "Privilege Escalation, Defense Evasion"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires identity provider audit logs capturing role assignment, privilege change, and permission modification events. Entra ID, Okta, or equivalent IdP audit stream must be ingested."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate IT helpdesk privilege grants, automated provisioning pipelines, break-glass account activations, scheduled access reviews, and role-based access control (RBAC) automation tools."
    tuning_guidance = "Add known provisioning service accounts to %global_allowed_provisioning_accounts. Add approved privileged role names to %global_approved_admin_roles. Scope to business hours if after-hours grants are rare in the environment."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // The actor performing the permission change must be a non-service principal
    // (i.e., a human or interactive session, not an approved automation account)
    not $auth.principal.user.userid in %global_allowed_provisioning_accounts

    // Target user is receiving a highly privileged role - match broad privilege keywords
    // rather than vendor-specific role names for portability across IdPs
    (
      $auth.target.user.attribute.roles.name = /global.admin/ nocase or
      $auth.target.user.attribute.roles.name = /privileged/ nocase or
      $auth.target.user.attribute.roles.name = /domain.admin/ nocase or
      $auth.target.user.attribute.roles.name = /enterprise.admin/ nocase or
      $auth.target.user.attribute.roles.name = /security.admin/ nocase or
      $auth.target.user.attribute.roles.name = /role.admin/ nocase or
      $auth.target.user.attribute.roles.name = /super.admin/ nocase or
      $auth.target.user.attribute.roles.name = /system.admin/ nocase
    )

    // Exclude approved role assignments defined in reference list
    not $auth.target.user.attribute.roles.name in %global_approved_admin_roles

    // The actor and target must be different users - self-elevation is the key signal
    // (actor granting themselves elevated permissions)
    $auth.principal.user.userid = $auth.target.user.userid

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $elevated_role = array_distinct($auth.target.user.attribute.roles.name)
    $target_user = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
