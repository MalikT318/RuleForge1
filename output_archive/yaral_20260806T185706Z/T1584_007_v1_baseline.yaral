/*
  MITRE Technique : T1584.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:21:35.030882+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_007_Serverless_Infra_C2_Proxy_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects repeated outbound HTTP/HTTPS connections to serverless cloud provider subdomains commonly abused as C2 proxies (e.g., Cloudflare Workers, AWS Lambda function URLs, Google Apps Script endpoints). Adversaries compromise or create serverless functions to proxy C2 traffic, making it blend with legitimate cloud provider traffic. This rule targets the traffic-pattern anomaly: high-frequency or beaconing-style connections to serverless runtime subdomains from internal hosts, as observed by network security appliances."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.007"
    mitre_technique_name = "Compromise Infrastructure: Serverless"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with HTTP/HTTPS flow visibility including target hostname and connection metadata normalized to UDM NETWORK_HTTP or NETWORK_CONNECTION."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate use of Cloudflare Workers for CDN/edge logic, AWS Lambda function URLs for application backends, Google Apps Script webhooks, CI/CD pipelines calling serverless endpoints, and SaaS products built on serverless infrastructure."
    tuning_guidance = "Add known-good serverless hostnames or source IP ranges to %allowed_serverless_destinations and %allowed_serverless_sources. Raise the threshold or narrow to specific URI path patterns (e.g., /api/, /webhook/) if false-positive volume is high. Consider correlating with threat-intel-flagged serverless subdomains."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.hostname = /\.(workers\.dev|cloudflarestorage\.com|pages\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|script\.google\.com|cloudfunctions\.net|azurewebsites\.net|azurefd\.net|run\.app|web\.app|firebaseapp\.com)$/ nocase
    not $net.target.hostname in %allowed_serverless_destinations
    not $net.principal.ip in %allowed_serverless_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.007")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
