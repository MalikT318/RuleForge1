/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:04:02.974460+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_001_MacOS_Browser_Cookie_Exfil_Network {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network connections to external destinations carrying HTTP Cookie headers with large or suspicious session token patterns, as observed in cookie-theft and session-hijacking campaigns. Adversaries exfiltrate stolen browser cookies over HTTP/HTTPS to attacker-controlled infrastructure. Firewall and proxy logs capture the outbound HTTP transaction including cookie header size and destination, providing a network-observable signal for T1539 on macOS endpoints."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Requires a TLS-inspecting proxy or firewall capable of logging HTTP headers, including Cookie request headers and their byte length. Full URI and referrer logging must be enabled."
    platform        = "macOS"
    log_source      = "firewall"
    false_positives = "Legitimate web applications that transmit large cookie payloads (e.g. SSO portals, analytics platforms, CDN-authenticated services). Automated testing frameworks. Browser sync services."
    tuning_guidance = "Add known-good external SaaS destinations that legitimately carry large cookie headers to %global_allowed_cookie_destinations. Raise the cookie byte-length threshold if the environment uses SSO solutions with large token payloads. Scope by principal.ip subnet if internal proxy IPs generate noise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Must be destined for an external host - internal ranges excluded via reference list
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_cookie_destinations

    // HTTP or HTTPS standard ports; adversaries occasionally use 443 to blend in
    $net.target.port in [80, 443, 8080, 8443]

    // Cookie header present and non-trivial in size (proxy logs surface this as
    // network.http.request_headers or the parsed cookie field)
    $net.network.http.request_headers = /cookie\s*:/ nocase
    $net.network.http.request_headers = /session|auth|token|sid|ssid|bearer|jwt|access_token|refresh_token/ nocase

    // Optionally flag unusually large cookie payloads (many proxies log byte length)
    // This regex matches cookie header values exceeding ~512 characters of base64/hex
    $net.network.http.request_headers = /[A-Za-z0-9+\/=_\-]{512,}/ nocase

    // Exclude well-known first-party browser update and telemetry endpoints
    not $net.network.http.user_agent = /GoogleUpdate|CrashReporter|SoftwareUpdate|MicrosoftUpdate/ nocase

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_host  = array_distinct($net.target.hostname)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)

  condition:
    $net
}
