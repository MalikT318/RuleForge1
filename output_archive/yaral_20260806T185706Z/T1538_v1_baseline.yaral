/*
  MITRE Technique : T1538 - Cloud Service Dashboard
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:03:42.656472+00:00
  Reference       : https://attack.mitre.org/techniques/T1538
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1538_001_Cloud_Dashboard_Enumeration_M365 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects broad enumeration of Microsoft 365 administrative and service dashboards, a key indicator of T1538 where adversaries use cloud management portals with stolen credentials to discover resources, services, and configurations without making direct API calls."
    mitre_tactic = "Discovery"
    mitre_technique = "T1538"
    mitre_technique_name = "Cloud Service Dashboard"
    log_prerequisites = "Requires Microsoft 365 unified audit logs normalised into Chronicle UDM. Covers activity from the M365 admin center, Azure portal, Security & Compliance center, and related management portals."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate IT administrators performing routine health checks, helpdesk staff reviewing tenant configuration, automated monitoring tools accessing dashboards, and onboarding activities for new administrators."
    tuning_guidance = "Add known administrator accounts to %m365_allowed_admin_users and known admin workstation source IPs to %m365_allowed_admin_sources. Consider raising the threshold or narrowing to off-hours access for lower-noise environments. Correlate with USER_LOGIN anomalies (impossible travel, new ASN) to increase fidelity."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target administrative and management portal resource paths
    // Covers M365 admin center, Security center, Compliance center, Exchange admin, SharePoint admin, Teams admin
    $cloud.target.resource.name = /admin\.microsoft\.com|security\.microsoft\.com|compliance\.microsoft\.com|protection\.office\.com|admin\.exchange\.microsoft\.com|admin\.teams\.microsoft\.com|admin\.sharepoint\.com|aad\.portal\.azure\.com|entra\.microsoft\.com|portal\.azure\.com/ nocase

    // Restrict to browser-based portal access (dashboard GUI usage, not API)
    // Dashboard access typically surfaces as PageViewed or equivalent resource access operations
    $cloud.metadata.product_event_type = /PageView|DashboardView|AdminPageView|PortalAccess|AdminCenterAccess|HomePageView/ nocase

    // Capture the acting user - must be a real user principal, not a service account pattern
    $cloud.principal.user.userid = /.+@.+\..+/ nocase

    // Exclude known service principals and non-interactive system accounts
    not $cloud.principal.user.userid = /^(service|svc|system|noreply|no-reply|mailer|daemon|bot)[-_@]/ nocase

    // Exclude known allowed administrators
    not $cloud.principal.user.userid in %m365_allowed_admin_users

    // Exclude known approved admin source IPs (e.g. corporate egress, PAW ranges)
    not $cloud.principal.ip in %m365_allowed_admin_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1538")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)
    $portal_action = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
