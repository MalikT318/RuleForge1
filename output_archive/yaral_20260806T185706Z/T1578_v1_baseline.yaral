/*
  MITRE Technique : T1578 - Modify Cloud Compute Infrastructure
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:15:46.490792+00:00
  Reference       : https://attack.mitre.org/techniques/T1578
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_Modify_Cloud_Compute_Infrastructure {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects high-risk modifications to cloud compute infrastructure including instance deletion, snapshot creation/deletion, disk detachment, and image creation. Adversaries abuse these operations to evade defenses, exfiltrate data via snapshots, or destroy evidence of compromise."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1578"
    mitre_technique_name = "Modify Cloud Compute Infrastructure"
    log_prerequisites = "Requires cloud provider control-plane audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). Events must populate metadata.event_type, principal.user.userid, target.resource.name, and target.resource.resource_type."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Authorized infrastructure automation (Terraform, Ansible, CloudFormation), scheduled snapshot backup jobs, auto-scaling lifecycle hooks, legitimate DR/BCP runbooks, and cloud-native managed services performing routine maintenance."
    tuning_guidance = "Add known automation service accounts and CI/CD principals to %cloud_allowed_infra_automation_principals. Add approved resource name patterns to %cloud_allowed_snapshot_resources. Consider narrowing to specific resource types if snapshot backups generate volume."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"

    // Target high-impact compute resource types: instances, snapshots, disks, images
    (
      $cloud.target.resource.resource_type = /instance/ nocase or
      $cloud.target.resource.resource_type = /snapshot/ nocase or
      $cloud.target.resource.resource_type = /disk/ nocase or
      $cloud.target.resource.resource_type = /image/ nocase or
      $cloud.target.resource.resource_type = /volume/ nocase or
      $cloud.target.resource.resource_type = /machine/ nocase
    )

    // Must have an attributed principal - anonymous deletions are highest risk
    $cloud.principal.user.userid != ""

    // Exclude known automation accounts and approved service principals
    not $cloud.principal.user.userid in %cloud_allowed_infra_automation_principals

    // Exclude approved snapshot/backup resource patterns
    not $cloud.target.resource.name in %cloud_allowed_snapshot_resources

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1578")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $resource_type     = array_distinct($cloud.target.resource.resource_type)
    $source_ip         = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
