/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:20:37.920422+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_SSP_Registry_Write_Then_DLL_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage SSP persistence pattern: a process modifies the LSA Security Packages registry key to register a new SSP, followed by a DLL being written to a system directory on the same host within 10 minutes. Together these events indicate an adversary staging a rogue SSP DLL that will be loaded by LSASS on next boot or via AddSecurityPackage."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires EDR or Sysmon registry-modification telemetry (Event ID 13) and file-creation telemetry (Event ID 11) normalised into Chronicle UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate security software (AV, DLP, PAM agents) that register custom SSPs; Windows cumulative updates that ship new LSA components; enterprise identity products such as smart-card middleware."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_ssp_writers and known-good DLL names to %global_allowed_ssp_dlls. Scope by principal.hostname for high-noise environments."

  events:
    // Stage 1 – registry modification of an LSA Security Packages key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\(OSConfig\\)?Security Packages$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_ssp_writers
    $reg.principal.hostname = $hostname

    // Stage 2 – DLL written to a Windows system directory on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss]ystem32\\.+\.dll$/ nocase
    not $file.target.file.full_path in %global_allowed_ssp_dlls
    not $file.principal.process.file.full_path in %global_allowed_ssp_writers
    $file.principal.hostname = $hostname

    // Chronological ordering: registry write precedes DLL drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1547.005")
    $primary_entity      = array_distinct($reg.principal.hostname)
    $modified_reg_keys   = array_distinct($reg.target.registry.registry_key)
    $dropped_dll_paths   = array_distinct($file.target.file.full_path)
    $writing_processes   = array_distinct($reg.principal.process.file.full_path)
    $dll_writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
