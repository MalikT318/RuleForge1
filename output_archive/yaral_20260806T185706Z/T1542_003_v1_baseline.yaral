/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:05:28.141279+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_Bootkit_Raw_Disk_Or_ESP_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects processes writing directly to raw block devices (MBR/VBR) or to EFI System Partition paths on Linux, which are the two primary mechanisms used by bootkits to achieve pre-OS persistence. Raw writes to /dev/sd*, /dev/nvme*, /dev/vd*, or /dev/hd* at offset zero overwrite the MBR or VBR. Writes to /boot/efi or /efi paths target UEFI bootloaders."
    mitre_tactic    = "Persistence, Defense Evasion"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry. Auditd rules must include '-a always,exit -F arch=b64 -S open,openat,write -F path=/dev/sda -k bootkit' style watches on raw block devices and /boot/efi. EDR agents that record FILE_MODIFICATION events on device nodes and EFI paths are also suitable."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate bootloader installers (grub-install, efibootmgr, shim updates), OS upgrade scripts, disk imaging tools (dd, clonezilla), and partition management utilities (parted, fdisk) may trigger this rule. These should be captured in the exclusion list after verification."
    tuning_guidance = "Add verified bootloader management binaries and their full paths to %linux_allowed_bootloader_writers. Consider also scoping by principal.user.userid to restrict exclusions to root-level package manager processes only. Alert on any match outside a known maintenance window."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Raw block device writes (MBR/VBR on BIOS systems) OR EFI System Partition writes (UEFI systems)
    (
      $file.target.file.full_path = /^\/dev\/(sd[a-z]+|hd[a-z]+|vd[a-z]+|nvme[0-9]+n[0-9]+|xvd[a-z]+)$/ nocase
      or
      $file.target.file.full_path = /^\/boot\/efi\// nocase
      or
      $file.target.file.full_path = /^\/efi\// nocase
      or
      $file.target.file.full_path = /^\/boot\/efi\/EFI\// nocase
    )

    // Exclude known legitimate bootloader management tools
    not $file.principal.process.file.full_path in %linux_allowed_bootloader_writers

    // Exclude package manager parent processes (apt, yum, dnf, rpm) as they orchestrate grub installs
    not $file.principal.process.file.full_path = /\/(apt|apt-get|dpkg|yum|dnf|rpm|zypper)$/ nocase

    // Require a process context - anonymous kernel writes without a process are not actionable
    $file.principal.process.file.full_path != ""

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity    = array_distinct($file.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $target_path       = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
