/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:03:05.721800+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_Compiled_Output_In_Suspicious_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of compiled executable artifacts (.exe, .dll, .pdb) in user-writable or temporary directories, which is a characteristic artifact of compile-after-delivery activity. Attackers deliver source code and compile it in-place using native compilers (csc.exe, ilasm.exe, vbc.exe, msbuild.exe) to evade signature-based controls. This rule pivots on the resulting file artifact rather than the compiler command line, providing a complementary detection layer."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised into UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write telemetry must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate developer workflows compiling in temp directories, CI/CD build agents writing to non-standard paths, .NET runtime JIT cache files, Visual Studio temporary build outputs, MSBuild project compilation in user profile directories."
    tuning_guidance = "Add known build-agent or developer host names to %global_allowed_build_hosts. Add approved parent process paths (e.g., devenv.exe, msbuild.exe under Program Files) to %global_allowed_compiler_parents. Narrow the path regex if your environment has a consistent temp directory structure."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Compiled binary artifact types produced by .NET / native compilers
    $file.target.file.full_path = /\.(exe|dll|pdb|netmodule)$/ nocase

    // File created inside user-writable or staging directories
    // Covers: %TEMP%, %APPDATA%, %LOCALAPPDATA%, %PUBLIC%, Downloads, Desktop,
    //         arbitrary user profile subdirs, and common staging roots
    $file.target.file.full_path = /\\(temp|tmp|appdata\\local\\temp|appdata\\roaming|appdata\\local|users\\[^\\]+\\(downloads|desktop|documents|music|pictures|videos|appdata)|programdata|windows\\temp|public\\)/ nocase

    // The process writing the file must be a known Windows compiler or build utility
    // This ties the artifact to a compiler lineage without relying on command-line content
    $file.principal.process.file.full_path = /\\(csc\.exe|vbc\.exe|ilasm\.exe|msbuild\.exe|jsc\.exe|cl\.exe|link\.exe|rc\.exe|ml\.exe|ml64\.exe|fsc\.exe|aspnet_compiler\.exe)$/ nocase

    // Exclude known legitimate build infrastructure hosts and approved compiler parents
    not $file.principal.hostname in %global_allowed_build_hosts
    not $file.principal.process.file.full_path in %global_allowed_compiler_parents

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $compiled_artifact = array_distinct($file.target.file.full_path)
    $compiler_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
