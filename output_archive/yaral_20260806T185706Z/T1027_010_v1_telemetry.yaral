/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:07:17.255086+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Obfuscated_Script_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation events in identity-adjacent script staging locations where the file extension or path pattern is consistent with obfuscated script artifacts dropped after phishing or drive-by delivery. Targets the file-system state change produced by command obfuscation rather than the command line itself, providing coverage orthogonal to process-creation rules. On Windows, obfuscated payloads are frequently written to temp, appdata, or public directories before execution."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires identity provider audit logs that surface file or resource creation events associated with authenticated user sessions (e.g., Entra ID / Azure AD audit logs capturing cloud-shell or OneDrive file writes, or AD-integrated EDR events correlated with identity context). UDM event type: USER_RESOURCE_CREATION."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate automation scripts deployed via MDM or software packaging tools; developer workflows writing encoded payloads for testing; base64-encoded configuration blobs written by approved SaaS connectors."
    tuning_guidance = "Add approved service principal display names or user IDs to %global_allowed_script_publishers. Narrow the path regex to exclude known-good deployment directories. Raise severity if the acting identity has no prior file-write history in the target path."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_CREATION"

    // The resource being created has a script-capable or encoded-blob extension
    // consistent with obfuscated payload staging
    $cloud.target.resource.name = /\.(ps1|vbs|vbe|js|jse|wsf|wsh|hta|bat|cmd|b64|enc|tmp)$/ nocase

    // Path patterns associated with obfuscated script staging on Windows:
    // %TEMP%, %APPDATA%, %PUBLIC%, %USERPROFILE%, cloud-shell scratch space
    (
      $cloud.target.resource.name = /[\\\/](temp|tmp)[\\\/]/                    nocase or
      $cloud.target.resource.name = /[\\\/]appdata[\\\/](local|roaming)[\\\/]/  nocase or
      $cloud.target.resource.name = /[\\\/]users[\\\/]public[\\\/]/             nocase or
      $cloud.target.resource.name = /[\\\/]programdata[\\\/]/                   nocase or
      $cloud.target.resource.name = /[\\\/]clouddrive[\\\/]/                    nocase
    )

    // Actor must be a human or service principal with a resolvable identity
    $cloud.principal.user.userid != ""

    // Exclude known-good automated publishers
    not $cloud.principal.user.userid in %global_allowed_script_publishers

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_written = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
