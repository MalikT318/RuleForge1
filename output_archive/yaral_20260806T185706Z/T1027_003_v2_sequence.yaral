/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:02:44.733198+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Stego_Exfil_Login_Then_Image_Access {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a pattern consistent with steganographic data exfiltration via an identity provider: a successful interactive login is followed within 5 minutes by a resource access event targeting image or media file types. Adversaries embedding payloads in image files (e.g. Invoke-PSImage, Duqu-style exfil) often authenticate to cloud storage or collaboration services immediately before uploading the carrier file. This rule correlates the authentication event with the subsequent resource access to surface that sequence without relying on endpoint process telemetry."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires identity provider sign-in logs (Entra ID / Okta / AD FS) normalised to UDM USER_LOGIN and USER_RESOURCE_ACCESS. The resource access event must populate target.resource.name or target.url with the file or object name so the image-extension filter can apply."
    platform        = "Windows"
    log_source      = "identity"
    false_positives = "Legitimate users uploading or accessing image assets (designers, marketing teams, SharePoint document libraries with embedded images). Cloud backup agents that authenticate and then write image snapshots. Automated CI/CD pipelines publishing build artefacts."
    tuning_guidance = "Add known service accounts to %idp_allowed_service_accounts. Add approved cloud storage application IDs or resource names to %idp_allowed_image_resources. Narrow the image extension regex if PNG/JPG alone are sufficient for your environment. Raise risk_score if the login originates from an unusual country (enrich with threat-intel reference lists)."

  events:
    // Leg 1: successful interactive login via the identity provider
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.summary = /success/ nocase
    $auth.principal.user.userid = $userid
    not $auth.principal.user.userid in %idp_allowed_service_accounts

    // Leg 2: resource access targeting an image or media file type
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $access.target.resource.name = /\.(png|jpg|jpeg|bmp|gif|tif|tiff|ico|webp|svg|mp3|mp4|wav|avi|mkv)$/ nocase
      or
      $access.target.url = /\.(png|jpg|jpeg|bmp|gif|tif|tiff|ico|webp|svg|mp3|mp4|wav|avi|mkv)(\?|$)/ nocase
    )
    $access.principal.user.userid = $userid
    not $access.target.resource.name in %idp_allowed_image_resources

    // Chronological ordering: login must precede resource access
    $auth.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $userid over 5m

  outcome:
    $risk_score          = max(72)
    $mitre_technique_id  = array_distinct("T1027.003")
    $primary_entity      = array_distinct($userid)
    $login_source_ip     = array_distinct($auth.principal.ip)
    $accessed_resources  = array_distinct($access.target.resource.name)
    $accessed_urls       = array_distinct($access.target.url)
    $login_count         = count($auth.metadata.id)
    $access_count        = count($access.metadata.id)

  condition:
    $auth and $access
}
