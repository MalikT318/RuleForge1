/*
  MITRE Technique : T1001.002 - Steganography
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:34:02.821519+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_002_Steganography_Suspicious_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects repeated or anomalous HTTP transfers of image or media files to external destinations that may indicate steganographic C2 traffic. Steganography embeds hidden commands inside image or document payloads; the network signature is high-frequency or large-volume transfers of image MIME types to non-CDN external hosts. Targets IDS/IPS telemetry observing HTTP flows on macOS endpoints."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.002"
    mitre_technique_name = "Data Obfuscation: Steganography"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM NETWORK_HTTP events. The appliance must decode HTTP request/response metadata including URI, content-type, and byte counts."
    platform = "macOS"
    log_source = "ips"
    false_positives = "Legitimate image-heavy web browsing, CDN traffic, photo-sharing applications, cloud backup tools uploading media, software update checks that return image assets."
    tuning_guidance = "Populate %global_allowed_image_destinations with known CDN and media-hosting FQDNs. Populate %global_allowed_internal_ranges with RFC-1918 and corporate egress prefixes. Raise the byte-count threshold or add a frequency match block if false-positive volume is high in a given environment."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Target must be an external host - not an internal/trusted destination
    not $net.target.hostname in %global_allowed_image_destinations
    not $net.principal.ip in %global_allowed_internal_ranges

    // HTTP method is GET or POST - both are used for steganographic C2
    // GET retrieves tasking images; POST exfiltrates responses embedded in images
    $net.network.http.method = /^(GET|POST)$/ nocase

    // URI or content-type suggests an image or document carrier file
    // Steganography most commonly abuses PNG, JPEG, GIF, BMP, TIFF, PDF, DOCX
    (
      $net.target.url = /\.(png|jpg|jpeg|gif|bmp|tiff?|webp|pdf|docx?)(\?|#|$)/ nocase
      or
      $net.network.http.response_code = 200
    )

    // Restrict to URI patterns consistent with image or document retrieval
    // Avoids matching generic API calls that happen to return 200
    $net.target.url = /\.(png|jpg|jpeg|gif|bmp|tiff?|webp|pdf|docx?)/ nocase

    // Destination port consistent with plain HTTP or HTTPS
    // Steganographic C2 often avoids non-standard ports to blend in
    (
      $net.target.port = 80
      or
      $net.target.port = 443
      or
      $net.target.port = 8080
      or
      $net.target.port = 8443
    )

    // Exclude well-known high-volume image CDN hostnames via reference list
    not $net.target.hostname in %global_allowed_image_destinations

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1001.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hostnames = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
