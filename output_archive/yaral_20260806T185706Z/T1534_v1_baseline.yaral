/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T20:02:50.122985+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_001_Internal_Spearphishing_Suspicious_Outbound_Auth {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable signals consistent with internal spearphishing on macOS: a high volume of outbound HTTPS connections to external destinations from a single internal source within a short window, particularly to credential-harvesting or phishing infrastructure patterns. Compromised internal accounts often generate anomalous outbound HTTP/S traffic as victims click embedded links or as the attacker exfiltrates captured credentials."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Requires firewall or proxy logs normalised to Chronicle UDM NETWORK_HTTP or NETWORK_CONNECTION events with principal.ip, target.ip, target.port, and network.http fields populated."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Software update services, cloud backup agents, browser telemetry, legitimate SaaS collaboration tools making bulk outbound HTTPS connections, marketing automation platforms."
    tuning_guidance = "Add known-good internal IP ranges to %internal_trusted_sources. Add approved SaaS and collaboration destinations to %allowed_saas_destinations. Raise the threshold if the environment has heavy legitimate HTTPS traffic. Narrow by target.port if only port 443 is relevant."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(GET|POST)$/ nocase
    $net.target.port = 443
    not $net.target.ip in %internal_trusted_sources
    not $net.target.ip in %allowed_saas_destinations
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 400
    $net.principal.ip = $src_ip

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($net.principal.ip)
    $distinct_destinations = count(distinct $net.target.ip)
    $http_methods_seen = array_distinct($net.network.http.method)
    $response_codes_seen = array_distinct($net.network.http.response_code)

  condition:
    $net and #net > 50
}
