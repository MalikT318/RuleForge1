/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-06T19:27:09.059940+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_001_ESXi_HostConfig_File_Enumeration {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects modification or creation of ESXi scratch/tmp files that are characteristic artifacts produced when esxcli or vim-cmd system-information utilities write their output to disk. Adversaries performing host reconnaissance on ESXi (e.g. querying hostname, version, hardware profile) frequently redirect output or trigger hostd to update state files. Detecting the resulting file artifact provides coverage orthogonal to command-line/process-launch rules."
    mitre_tactic         = "Discovery"
    mitre_technique      = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites    = "Requires ESXi file-activity telemetry forwarded to Chronicle via syslog or a host-based agent capable of reporting FILE_CREATION / FILE_MODIFICATION events from the ESXi shell layer (e.g. Carbon Black, Sysdig, or a custom hostd log parser that emits UDM)."
    platform             = "ESXi"
    log_source           = "vmware_esxi"
    false_positives      = "Legitimate VMware vCenter health checks, automated monitoring scripts (e.g. Nagios/Zabbix ESXi plugins), scheduled compliance scans, and VMware Update Manager operations that read or refresh host configuration files."
    tuning_guidance      = "Add known monitoring service accounts to %esxi_allowed_monitoring_users. Add approved automation process paths to %esxi_allowed_admin_processes. Raise severity to High if the acting user is not a known service account or if the event occurs outside a maintenance window."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target files written when esxcli/vim-cmd system queries materialise
    // output or when hostd refreshes cached host-info state on disk.
    // Covers: /tmp output redirects, /var/run hostd state files,
    // /scratch/log transient artefacts, and /etc/vmware host config writes
    // that are updated as a side-effect of system-info queries.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/run\/|\/scratch\/|\/etc\/vmware\/)/ nocase

    // Narrow to files whose names are consistent with system-info artefacts:
    // hostd cache dumps, esxcli output files, sysinfo temp files.
    $file.target.file.full_path = /(sysinfo|hostinfo|esxcli|hwconfig|version|hostname|visorfs|vmkctl)/ nocase

    // Exclude known VMware internal daemons that legitimately write these
    // paths during normal operation (e.g. hostd itself during startup).
    not $file.principal.process.file.full_path in %esxi_allowed_admin_processes

    // Exclude known monitoring/automation service accounts.
    not $file.principal.user.userid in %esxi_allowed_monitoring_users

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity    = array_distinct($file.principal.hostname)
    $acting_user       = array_distinct($file.principal.user.userid)
    $artifact_path     = array_distinct($file.target.file.full_path)
    $acting_process    = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
