/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-05T17:09:25.145835+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Repeated_Firewall_Disable_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single host repeatedly executing firewall disable or modification commands across multiple platforms (Windows netsh/Set-NetFirewallProfile, Linux iptables/ufw/firewalld, macOS pfctl, ESXi esxcli) within a 10-minute window. Individual invocations may be benign; repeated attempts from the same host indicate scripted or adversarial firewall suppression."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Requires EDR process telemetry (Windows Event 4688, Sysmon Event 1, CrowdStrike, Carbon Black, or equivalent) with full command-line logging enabled. ESXi requires shell audit logging."
    platform = "Windows, Linux, macOS, ESXi"
    false_positives = "Automated patch management or configuration management tools (Ansible, Chef, Puppet) that reconfigure firewall rules as part of a known change window; security scanning agents; cloud-init bootstrap scripts on new VM provisioning."
    tuning_guidance = "Add known automation service accounts to %global_allowed_firewall_mgmt_users and known orchestration hosts to %global_allowed_firewall_mgmt_hosts. Raise the threshold count if the environment has frequent legitimate firewall reconfiguration jobs. Scope to specific platforms by filtering target.process.file.full_path if cross-platform noise is excessive."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the union of firewall management binaries across all platforms
    // Windows: netsh, PowerShell firewall cmdlets
    // Linux: iptables, ip6tables, ufw, firewall-cmd, nft
    // macOS: pfctl
    // ESXi: esxcli
    $proc.target.process.file.full_path = /\\(netsh|powershell|pwsh|iptables|ip6tables|ufw|firewall\-cmd|nft|pfctl|esxcli)(\.(exe))?$/ nocase

    // Match command-line arguments that indicate firewall disablement or permissive modification
    // Windows netsh: advfirewall set ... state off / allprofiles state off
    // PowerShell: Set-NetFirewallProfile -Enabled False / -Profile * -Enabled False
    // Linux ufw: ufw disable / ufw allow
    // Linux firewall-cmd: --zone=... --add-port / --remove-rich-rule / --set-default-zone=trusted
    // Linux iptables: -F (flush) / -P INPUT ACCEPT / -P FORWARD ACCEPT
    // macOS pfctl: -d (disable) / -F all (flush all rules)
    // ESXi: esxcli network firewall set --enabled false / --ruleset-id ... --allowed-all true
    $proc.target.process.command_line = /(state\s+off|allprofiles|set\s+.*\-enabled\s+false|\-enabled\s+false|ufw\s+disable|ufw\s+allow|--add\-port|--remove\-rich\-rule|set\-default\-zone\s*=\s*trusted|\-F\s|\-P\s+(INPUT|FORWARD|OUTPUT)\s+ACCEPT|pfctl\s+\-d|pfctl\s+\-F\s+all|firewall\s+set\s+.*\-\-enabled\s+false|--allowed\-all\s+true)/ nocase

    // Exclude known legitimate firewall management principals
    not $proc.principal.user.userid in %global_allowed_firewall_mgmt_users
    not $proc.principal.hostname in %global_allowed_firewall_mgmt_hosts

    $proc.principal.hostname = $src_host

  match:
    $src_host over 10m

  outcome:
    // Conservative threshold: 5 distinct firewall-suppression commands from the same host
    // in 10 minutes is anomalous for any non-automation workload
    $risk_score = max(
      if(count($proc.metadata.id) >= 10, 90,
      if(count($proc.metadata.id) >= 7,  75,
      65))
    )
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($proc.principal.hostname)
    $firewall_cmd_count = count($proc.metadata.id)
    $distinct_commands = array_distinct($proc.target.process.command_line)
    $distinct_binaries = array_distinct($proc.target.process.file.full_path)
    $acting_users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 5
}
