/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-05T17:08:25.205869+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_006_Log_Clear_Then_Log_Dir_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process truncating or deleting a system log file followed by a second process accessing the /var/log/ directory tree on the same host within 10 minutes. The combination of a destructive log operation immediately followed by directory enumeration is a strong indicator of an adversary covering tracks and verifying the result."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1485.006"
    mitre_technique_name = "Data Destruction: Clear Linux or Mac System Logs"
    log_prerequisites = "Requires EDR file-activity telemetry (e.g., Crowdstrike Falcon, SentinelOne, Auditd with FILE_DELETION/FILE_MODIFICATION events) covering /var/log/ on Linux and macOS endpoints."
    platform = "Linux, macOS"
    false_positives = "Log rotation daemons (logrotate, newsyslog) that truncate and then re-open log files; centralised log-shipping agents (Fluentd, Filebeat) that read log directories after rotation; backup agents archiving /var/log/."
    tuning_guidance = "Add known log-rotation and log-shipping process paths to %global_allowed_log_managers. Add authorised admin user IDs to %global_allowed_log_admin_users. Raise severity if the acting user is not root or a known service account."

  events:
    // Leg 1: destructive operation against a file inside /var/log/
    $destroy.metadata.event_type = "FILE_DELETION"
    $destroy.target.file.full_path = /^\/var\/log\// nocase
    not $destroy.principal.process.file.full_path in %global_allowed_log_managers
    not $destroy.principal.user.userid in %global_allowed_log_admin_users
    $destroy.principal.hostname = $hostname

    // Leg 2: a process reads or lists the /var/log/ directory tree shortly after
    $access.metadata.event_type = "FILE_READ"
    $access.target.file.full_path = /^\/var\/log\// nocase
    not $access.principal.process.file.full_path in %global_allowed_log_managers
    not $access.principal.user.userid in %global_allowed_log_admin_users
    $access.principal.hostname = $hostname

    // Chronological ordering: destruction must precede the access
    $destroy.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1485.006")
    $primary_entity = array_distinct($destroy.principal.hostname)
    $destroyed_log_files = array_distinct($destroy.target.file.full_path)
    $accessed_log_paths = array_distinct($access.target.file.full_path)
    $destroying_processes = array_distinct($destroy.principal.process.file.full_path)
    $accessing_processes = array_distinct($access.principal.process.file.full_path)
    $acting_users = array_distinct($destroy.principal.user.userid)

  condition:
    $destroy and $access
}
