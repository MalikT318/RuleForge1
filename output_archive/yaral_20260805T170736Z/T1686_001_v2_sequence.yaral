/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-05T17:09:46.068376+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_CloudFirewall_PermissiveRuleFollowedByConnection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud firewall rule modification that opens broad ingress access (e.g., 0.0.0.0/0 on any port) followed within 10 minutes by an inbound network connection to the same cloud host. This sequence suggests an adversary created a permissive firewall rule and immediately exploited the new access path."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Cloud Firewall"
    log_prerequisites = "Requires cloud control-plane audit logs (AWS CloudTrail, GCP Cloud Audit Logs, or Azure Activity Logs) ingested into Chronicle UDM as SETTING_MODIFICATION or RESOURCE_PERMISSIONS_CHANGE events, plus VPC flow logs or cloud network telemetry as NETWORK_FLOW or NETWORK_CONNECTION events. The target.hostname or target.asset_id must be consistently populated across both log sources."
    platform = "IaaS (AWS, GCP, Azure)"
    false_positives = "Authorized infrastructure-as-code deployments (Terraform, CloudFormation) that open temporary ingress for bootstrapping; penetration testing activities; legitimate DevOps pipelines that modify security groups and immediately test connectivity; cloud load balancer health-check provisioning."
    tuning_guidance = "Add known automation service account user IDs to %cloud_allowed_firewall_automation_users. Add known CI/CD source IPs to %cloud_allowed_cicd_sources. Add approved cloud resource IDs or hostnames to %cloud_allowed_permissive_targets. Narrow the ingress CIDR regex if your environment uses a specific notation."

  events:
    // Event 1: Cloud firewall/security-group rule modified to allow broad ingress
    $fw.metadata.event_type = "SETTING_MODIFICATION"
    // Target a firewall, security group, or network ACL resource
    $fw.target.resource.name = /firewall|security.group|network.acl|ingress|sg\-/ nocase
    // The new rule permits traffic from any source (0.0.0.0/0 or ::/0)
    (
      $fw.target.resource.attribute.labels.value = /0\.0\.0\.0\/0/ nocase or
      $fw.target.resource.attribute.labels.value = /::\/0/ nocase or
      $fw.security_result.description = /0\.0\.0\.0\/0/ nocase or
      $fw.security_result.description = /::\/0/ nocase
    )
    // Exclude known automation accounts
    not $fw.principal.user.userid in %cloud_allowed_firewall_automation_users
    // Exclude approved resources
    not $fw.target.resource.name in %cloud_allowed_permissive_targets
    // Capture the cloud account/project as join key
    $fw.principal.cloud.project.id = $cloud_project_id

    // Event 2: Inbound network connection to a host in the same cloud project
    $net.metadata.event_type = "NETWORK_CONNECTION"
    // Must be inbound (external source reaching cloud resource)
    not $net.principal.ip in %rfc1918_internal
    // Exclude known CI/CD or approved external sources
    not $net.principal.ip in %cloud_allowed_cicd_sources
    $net.target.cloud.project.id = $cloud_project_id

    // Chronological ordering: firewall change must precede the connection
    $fw.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $cloud_project_id over 10m

  outcome:
    $risk_score = max(82)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($cloud_project_id)
    $firewall_modifier_user = array_distinct($fw.principal.user.userid)
    $modified_resource = array_distinct($fw.target.resource.name)
    $inbound_source_ips = array_distinct($net.principal.ip)
    $inbound_destination_ips = array_distinct($net.target.ip)
    $inbound_destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $fw and $net
}
