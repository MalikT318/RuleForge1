/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-05T17:08:10.959781+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_Bulk_EventLog_Clear_Threshold {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Threshold"
    severity        = "High"
    description     = "Detects a single host clearing multiple distinct Windows Event Log channels within a 10-minute window. Individual wevtutil cl, PowerShell Clear-EventLog/Remove-EventLog, or direct .evtx file deletion events may be routine; clearing three or more channels in rapid succession is a strong indicator of log-wiping activity associated with defense impairment."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Indicator Removal: Clear Windows Event Logs"
    log_prerequisites = "Requires EDR process telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint) or Windows Security Event 4688 with full command-line auditing enabled. Windows Event 1102 (Security log cleared) and 104 (System log cleared) are supplementary signals but are not required for this rule."
    platform        = "Windows"
    false_positives = "Automated log-rotation scripts run by monitoring agents (e.g., Splunk UF, Elastic Agent). Scheduled maintenance tasks that clear application logs before log archival. RMM platforms (ConnectWise, Kaseya) performing bulk remediation. SIEM on-boarding scripts that flush stale logs before deploying a new collector."
    tuning_guidance = "Add authorised maintenance account names to %global_allowed_log_clear_users and authorised parent process paths to %global_allowed_log_clear_parents. Raise the threshold from 3 to 5 if the environment runs aggressive log-rotation automation. Scope to business hours if after-hours clearing is always suspicious."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match wevtutil with a clear (cl) sub-command targeting any log channel
    (
      $proc.target.process.command_line = /wevtutil(\.exe)?\s+(cl|clear-log)\s+/ nocase
      or
      // PowerShell Clear-EventLog or Remove-EventLog cmdlets
      $proc.target.process.command_line = /(Clear|Remove)-EventLog\b/ nocase
      or
      // Direct deletion of .evtx files via cmd builtins or scripting hosts
      (
        $proc.target.process.command_line = /\.evtx/ nocase
        and
        $proc.target.process.command_line = /(del|erase|remove-item|rm)\b/ nocase
      )
    )

    // Exclude known-good maintenance accounts and parent processes
    not $proc.principal.user.userid in %global_allowed_log_clear_users
    not $proc.principal.process.file.full_path in %global_allowed_log_clear_parents

    // Bind grouping entity
    $proc.principal.hostname = $hostname

  match:
    $hostname over 10m

  outcome:
    // Scale risk with volume: base 55, capped at 95
    $risk_score = max(
      55 +
      (count($proc.metadata.event_timestamp.seconds) - 3) * 10
    )
    $mitre_technique_id  = array_distinct("T1685.005")
    $primary_entity      = array_distinct($proc.principal.hostname)
    $triggering_user     = array_distinct($proc.principal.user.userid)
    $cleared_log_targets = array_distinct($proc.target.process.command_line)
    $parent_processes    = array_distinct($proc.principal.process.file.full_path)
    $event_count         = count($proc.metadata.event_timestamp.seconds)

  condition:
    #proc >= 3
}
