/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-05T17:09:02.188870+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Firewall_Disabled_Then_Network_Exposure {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a firewall disable or modification command followed by an outbound network connection on a non-standard or sensitive port from the same host within 10 minutes. This two-stage correlation reduces false positives by requiring both the impairment action and subsequent network activity, indicating the firewall change may have been made to enable covert communication."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) from the same host. Windows: Event 4688 or Sysmon Event 1. Linux/macOS: auditd or EDR. ESXi: ESXi shell telemetry forwarded to Chronicle."
    platform = "Windows, Linux, macOS, ESXi"
    false_positives = "Authorized firewall management by IT operations or configuration management tools (Ansible, Chef, Puppet). Security scanning tools that temporarily open ports. RMM platforms performing maintenance. Cloud-init or bootstrap scripts on new instances."
    tuning_guidance = "Add authorized firewall management parent processes to %global_allowed_firewall_mgmt_parents. Add known-safe management hosts to %global_firewall_mgmt_hosts. Add approved destination ports to %global_allowed_mgmt_ports if your environment uses non-standard management ports legitimately."

  events:
    // Event 1: Firewall disable or modification command
    $fw.metadata.event_type = "PROCESS_LAUNCH"

    // Match firewall management binaries across platforms
    // Windows: netsh, Set-NetFirewallProfile, New-NetFirewallRule
    // Linux: iptables, ip6tables, ufw, firewall-cmd, nft
    // ESXi: esxcli
    // macOS: pfctl, socketfilterfw
    $fw.target.process.file.full_path = /\\(netsh|iptables|ip6tables|ufw|firewall\-cmd|nft|esxcli|pfctl|socketfilterfw)$/ nocase

    // Match command-line arguments that indicate disabling or permissive rule changes
    // netsh: advfirewall set ... state off / profile ... disable
    // iptables/ufw: -F (flush), --flush, disable, allow, -P ACCEPT
    // firewall-cmd: --remove-rich-rule, --add-port, --zone=... --add-service
    // esxcli: network firewall set --enabled false / ruleset set --enabled false
    // pfctl: -d (disable), -F all (flush all)
    // socketfilterfw: --setglobalstate off
    $fw.target.process.command_line = /(set\s+.*state\s+off|advfirewall\s+set|--enabled\s+false|\-F\b|--flush|disable|setglobalstate\s+off|\-d\b|\-P\s+ACCEPT|add\-port|add\-service|remove\-rich\-rule|ruleset\s+set|firewall\s+set)/ nocase

    not $fw.principal.process.file.full_path in %global_allowed_firewall_mgmt_parents
    not $fw.principal.hostname in %global_firewall_mgmt_hosts

    $fw.principal.hostname = $hostname

    // Event 2: Outbound network connection on a sensitive or non-standard port
    // following the firewall modification from the same host
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Exclude RFC1918 private ranges to focus on external exposure
    not $net.target.ip in %rfc1918_internal

    // Target sensitive or non-standard ports:
    // 3389 (RDP), 4444/4445 (common C2), 5985/5986 (WinRM),
    // 22 (SSH external), 23 (Telnet), 8080/8443 (alt HTTP/S),
    // 1080 (SOCKS), 6667 (IRC), 9001/9030 (Tor)
    $net.target.port in [22, 23, 3389, 4444, 4445, 1080, 5985, 5986, 6667, 8080, 8443, 9001, 9030]

    not $net.principal.hostname in %global_firewall_mgmt_hosts

    $net.principal.hostname = $hostname

    // Enforce chronological ordering: firewall change must precede network connection
    $fw.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($fw.principal.hostname)
    $firewall_commands = array_distinct($fw.target.process.command_line)
    $firewall_binary = array_distinct($fw.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $fw and $net
}
