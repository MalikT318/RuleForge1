/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-05T17:07:52.690108+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_005_Shell_Clears_EventLog_Then_Deletes_LogFile {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage defense impairment pattern: a shell or scripting process first clears Windows Event Logs via wevtutil or PowerShell, then deletes or overwrites a .evtx log file under the winevt\\logs directory. Both events on the same host within 10 minutes indicate deliberate log destruction."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1485.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH with command-line) and file-system telemetry (FILE_DELETION or FILE_MODIFICATION). Windows Event 4688 with command-line auditing enabled is an acceptable substitute for process telemetry."
    platform = "Windows"
    false_positives = "Authorized log rotation scripts run by SIEM/SYSLOG forwarders, backup agents that archive and truncate .evtx files, and enterprise log management tools (e.g., Splunk UF, NXLog) that periodically clear forwarded logs. Scheduled maintenance windows may also trigger this pattern."
    tuning_guidance = "Add authorized log-management process paths to %global_allowed_log_mgmt_processes. Add authorized service accounts that perform log rotation to %global_allowed_log_rotation_users. Raise severity to Critical if the clearing process is not a known admin tool."

  events:
    // Stage 1: A shell or scripting host clears event logs via wevtutil or PowerShell
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\wevtutil(\.exe)?$/ nocase
        and $proc.target.process.command_line = /\bcl\b/ nocase
        and $proc.target.process.command_line = /\b(system|application|security|setup|forwardedevents)\b/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)(\.exe)?$/ nocase
        and $proc.target.process.command_line = /Remove-EventLog|Clear-EventLog|wevtutil/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_log_mgmt_processes
    not $proc.principal.user.userid in %global_allowed_log_rotation_users
    $proc.principal.hostname = $hostname

    // Stage 2: A .evtx file under the winevt logs directory is deleted or modified on the same host
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /\\Windows\\System32\\winevt\\[Ll]ogs\\.*\.evtx$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_log_mgmt_processes
    $file.principal.hostname = $hostname

    // Chronological ordering: log-clear command must precede the file deletion
    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1485.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $clearing_process = array_distinct($proc.target.process.file.full_path)
    $clearing_cmdline = array_distinct($proc.target.process.command_line)
    $deleted_log_files = array_distinct($file.target.file.full_path)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc and $file
}
