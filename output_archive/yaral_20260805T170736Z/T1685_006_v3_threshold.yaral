/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-05T17:08:37.768044+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_006_Bulk_Log_Deletion_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a high volume of log file deletion or truncation events under /var/log/ within a short window from a single host. Individual deletions may be routine log rotation; repeated deletions across multiple log files within 10 minutes is anomalous and consistent with an adversary clearing evidence of intrusion."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1485.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux/macOS file-system audit telemetry: auditd with -w /var/log/ -p wa rules, Sysdig, Falco, or EDR file-event telemetry forwarded to Chronicle via UDM FILE_DELETION or FILE_MODIFICATION events."
    platform = "Linux, macOS"
    false_positives = "Automated log rotation daemons (logrotate, newsyslog) running as root on a schedule; log management agents (Splunk UF, Elastic Agent) compressing or archiving logs; container orchestration platforms recycling ephemeral log volumes."
    tuning_guidance = "Add known log-rotation process paths (e.g. /usr/sbin/logrotate) to %global_allowed_log_rotation_procs. Add authorised log-management service accounts to %global_allowed_log_mgmt_users. Raise the threshold count if baseline noise is high in a specific environment."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^\/var\/log\// nocase
    not $file.principal.process.file.full_path in %global_allowed_log_rotation_procs
    not $file.principal.user.userid in %global_allowed_log_mgmt_users
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $userid

  match:
    $hostname, $userid over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1485.006")
    $primary_entity = array_distinct($hostname)
    $acting_user = array_distinct($userid)
    $deleted_log_paths = array_distinct($file.target.file.full_path)
    $deletion_count = count($file.target.file.full_path)
    $initiating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 5
}
