/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-05T17:10:05.521527+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Cloud_Firewall_Bulk_Rule_Modifications {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single IAM principal performing a high volume of cloud firewall rule create, update, or delete operations within a short window. Individually these events are routine; the burst pattern indicates automated enumeration, mass-permissive rule injection, or defensive control removal consistent with T1686.001."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Cloud Firewall"
    log_prerequisites = "Requires cloud audit logs ingested into Chronicle UDM: AWS CloudTrail (AuthorizeSecurityGroupIngress, RevokeSecurityGroupIngress, CreateSecurityGroup, DeleteSecurityGroup, ModifyNetworkAcl, etc.), GCP Cloud Audit Logs (compute.firewalls.*), or Azure Activity Logs (Microsoft.Network/networkSecurityGroups/*)."
    platform = "IaaS (AWS, GCP, Azure)"
    false_positives = "Infrastructure-as-Code pipelines (Terraform, Pulumi, CloudFormation) applying large change sets; automated compliance remediation tools; authorized network provisioning scripts run by cloud operations teams."
    tuning_guidance = "Add known CI/CD service account user IDs to %global_allowed_cloud_automation_principals. Raise the threshold count for environments with frequent IaC deployments. Narrow the rule to specific cloud projects or AWS accounts by adding a target.resource.name filter if cross-tenant noise is observed."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Match firewall / security-group / network-ACL mutation operations across AWS, GCP, and Azure
    // AWS: AuthorizeSecurityGroupIngress, RevokeSecurityGroupIngress, CreateSecurityGroup,
    //      DeleteSecurityGroup, ModifyNetworkAclEntry, CreateNetworkAcl, DeleteNetworkAcl
    // GCP: compute.firewalls.insert, compute.firewalls.patch, compute.firewalls.delete
    // Azure: Microsoft.Network/networkSecurityGroups/securityRules/write,
    //        Microsoft.Network/networkSecurityGroups/securityRules/delete
    (
      $cloud.metadata.product_event_type = /AuthorizeSecurityGroup/ nocase or
      $cloud.metadata.product_event_type = /RevokeSecurityGroup/ nocase or
      $cloud.metadata.product_event_type = /CreateSecurityGroup/ nocase or
      $cloud.metadata.product_event_type = /DeleteSecurityGroup/ nocase or
      $cloud.metadata.product_event_type = /ModifyNetworkAcl/ nocase or
      $cloud.metadata.product_event_type = /CreateNetworkAcl/ nocase or
      $cloud.metadata.product_event_type = /DeleteNetworkAcl/ nocase or
      $cloud.metadata.product_event_type = /compute\.firewalls\.(insert|patch|delete)/ nocase or
      $cloud.metadata.product_event_type = /networkSecurityGroups.*securityRules/ nocase or
      $cloud.metadata.product_event_type = /firewalls\.(create|update|delete|patch)/ nocase
    )

    // Bind to the acting principal user for grouping
    $cloud.principal.user.userid = $actor_userid

    // Exclude known automation service accounts and CI/CD principals
    not $cloud.principal.user.userid in %global_allowed_cloud_automation_principals

    // Exclude known safe source IPs (e.g., internal build infrastructure)
    not $cloud.principal.ip in %global_allowed_cloud_admin_source_ips

  match:
    $actor_userid over 10m

  outcome:
    // Scale risk score based on volume - base score reflects threshold breach
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($actor_userid)
    $event_count = count($cloud.metadata.id)
    $distinct_operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $affected_resources = array_distinct($cloud.target.resource.name)

  condition:
    // Conservative threshold: 8 firewall mutations by one principal in 10 minutes
    // is unusual outside of IaC pipelines; tune upward for high-velocity environments
    #cloud >= 8
}
