/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:03:37.339164+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_File_Encryption_Then_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects file encryption/encoding utility creating a file followed by execution of that file, indicating potential staged payload deployment."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires Linux EDR or auditd telemetry capturing file creation and process execution events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate encrypted archive extraction (gpg, openssl for backup restoration), software deployment pipelines, container image extraction, package managers extracting encrypted packages."
    tuning_guidance = "Add approved automation processes to %global_allowed_backup_processes. Exclude known deployment directories if false positives occur in CI/CD environments."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.principal.process.file.full_path = /\/(openssl|gpg|base64|xxd|uudecode|gzip|gunzip|bzip2|bunzip2|xz|unxz|7z|unzip|tar)$/ nocase or
      $file.principal.process.command_line = /openssl\s+(enc|aes|des)/ nocase or
      $file.principal.process.command_line = /gpg\s+(--decrypt|-d)/ nocase or
      $file.principal.process.command_line = /base64\s+(-d|--decode)/ nocase or
      $file.principal.process.command_line = /(uudecode|xxd\s+-r)/ nocase
    )
    (
      $file.target.file.full_path = /^\/tmp\// nocase or
      $file.target.file.full_path = /^\/dev\/shm\// nocase or
      $file.target.file.full_path = /^\/var\/tmp\// nocase or
      $file.target.file.full_path = /^\/home\/[^\/]+\/\.(cache|local|config)\// nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $filepath

    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.target.process.file.full_path = $filepath
    $exec.principal.hostname = $hostname
    
    $file.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $hostname, $filepath over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity = array_distinct($exec.principal.hostname)
    $decryption_tool = array_distinct($file.principal.process.file.full_path)
    $executed_file = array_distinct($exec.target.process.file.full_path)
    $decryption_cmdline = array_distinct($file.principal.process.command_line)

  condition:
    $file and $exec
}
