/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:08:02.798133+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_002_Decode_Then_Write_Suspicious_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage deobfuscation pattern on Linux: a decoding utility (base64, openssl, xxd, python, perl, etc.) runs and is shortly followed by a file being written to a suspicious staging path (/tmp, /dev/shm, /var/tmp, /run). This additive coverage catches the file-system artefact of decode-and-drop rather than relying on command-line string matching alone."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM, producing PROCESS_LAUNCH and FILE_CREATION events with principal.hostname, principal.process.file.full_path, and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate use of base64/openssl for certificate management, developer tooling decoding build artefacts to /tmp, package managers extracting to staging directories, CI/CD pipelines."
    tuning_guidance = "Add known-good parent processes or orchestration accounts to %global_allowed_script_hosts or %global_allowed_service_accounts. Narrow the file-write path regex if /tmp writes from build systems are noisy."

  events:
    // Event 1: a decoding/deobfuscation utility is launched
    $dec.metadata.event_type = "PROCESS_LAUNCH"
    $dec.target.process.file.full_path = /\/(base64|openssl|xxd|python[23]?|perl|ruby|php|node|gzip|gunzip|zcat|unzip|tar|bzip2|xz|lzma|dd)$/
    not $dec.principal.process.file.full_path in %global_allowed_script_hosts
    not $dec.principal.user.userid in %global_allowed_service_accounts
    $dec.principal.hostname = $hostname

    // Event 2: a file is created in a world-writable or suspicious staging path
    $write.metadata.event_type = "FILE_CREATION"
    $write.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/run\/shm\/)/
    not $write.principal.process.file.full_path in %global_allowed_backup_processes
    not $write.principal.user.userid in %global_allowed_service_accounts
    $write.principal.hostname = $hostname

    // Chronological ordering: decode happens before the file is written
    $dec.metadata.event_timestamp.seconds <= $write.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($dec.principal.hostname)
    $decode_process = array_distinct($dec.target.process.file.full_path)
    $decode_cmdline = array_distinct($dec.target.process.command_line)
    $written_file = array_distinct($write.target.file.full_path)
    $acting_user = array_distinct($dec.principal.user.userid)
    $decode_parent = array_distinct($dec.principal.process.file.full_path)

  condition:
    $dec and $write
}
