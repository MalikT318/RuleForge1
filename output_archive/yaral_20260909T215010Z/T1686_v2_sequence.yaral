/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:50:51.815983+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_NetDev_Firewall_Change_Then_New_Flow {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a firewall policy or setting modification on a network device followed within 10 minutes by a new inbound or outbound flow on a port that is commonly associated with remote access or lateral movement. The sequence suggests an adversary disabled or loosened a firewall rule and immediately exploited the newly opened path. This is additive coverage over process-creation rules: it operates entirely on firewall/flow telemetry with no endpoint process fields."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Requires network device syslog or management-plane logs normalised to UDM SETTING_MODIFICATION, and firewall/flow logs normalised to UDM NETWORK_FLOW or NETWORK_CONNECTION. Both event types must share a common principal.hostname (the network device)."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorised network engineers applying planned firewall changes; automated change-management tooling; scheduled maintenance windows; vulnerability scanners opening connections immediately after a policy push."
    tuning_guidance = "Add authorised change-management service accounts to %global_allowed_service_accounts. Add authorised scanner source IPs to %global_allowed_scanners. Narrow the sensitive_ports regex to the specific ports relevant to each client environment. Increase the risk_score if the modifying user is not in %global_allowed_admin_users."

  events:
    // Event 1: A firewall setting or policy is modified on the network device.
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname != ""
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users
    $cfg.principal.hostname = $device_hostname

    // Event 2: A network flow is observed on a sensitive / high-risk port
    // originating from or destined to the same network device shortly after.
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $device_hostname
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners

    // Match on ports commonly abused after firewall rule relaxation:
    // 22 (SSH), 23 (Telnet), 3389 (RDP), 5900 (VNC), 4444/4445 (common RAT),
    // 8080/8443 (alt HTTP/S management), 1080 (SOCKS), 6667 (IRC C2).
    (
      $flow.target.port = 22 or
      $flow.target.port = 23 or
      $flow.target.port = 3389 or
      $flow.target.port = 5900 or
      $flow.target.port = 4444 or
      $flow.target.port = 4445 or
      $flow.target.port = 1080 or
      $flow.target.port = 6667 or
      $flow.target.port = 8080 or
      $flow.target.port = 8443
    )

    // Chronological ordering: config change must precede the suspicious flow.
    $cfg.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1686")
    $primary_entity      = array_distinct($device_hostname)
    $modifying_user      = array_distinct($cfg.principal.user.userid)
    $suspicious_ports    = array_distinct($flow.target.port)
    $external_dest_ips   = array_distinct($flow.target.ip)
    $flow_count          = count($flow.metadata.id)

  condition:
    $cfg and $flow
}
