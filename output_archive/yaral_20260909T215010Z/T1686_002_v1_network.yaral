/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:51:50.953573+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Firewall_Policy_Bypass_Network_Observable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable evidence of firewall policy bypass on network devices: connections to or from external addresses on ports or protocols that are typically blocked by perimeter controls, or high-volume flows suggesting newly permissive ACL rules. This complements process/command-line rules by catching the downstream network effect of firewall rule manipulation (T1686.002)."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Requires firewall flow or connection logs normalised into Chronicle UDM. NETWORK_FLOW or NETWORK_CONNECTION events must include source/destination IP, port, and protocol. Denied-then-allowed pattern is most useful when the firewall logs both permit and deny decisions."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised penetration tests, vulnerability scanner activity from approved sources, newly provisioned services with legitimate external connectivity requirements, VPN concentrators with broad split-tunnel policies."
    tuning_guidance = "Add approved scanner source IPs to %global_allowed_scanners. Add known-good external destinations to %global_allowed_domains. Add management source ranges to %global_allowed_mgmt_sources. Narrow the high-risk port list or byte threshold to match the environment's baseline."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Traffic must originate from or terminate at an external (non-RFC1918) address.
    // Exclude internal-to-internal flows - those are handled by lateral movement rules.
    not $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal

    // Exclude approved scanners and management sources from generating noise.
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Focus on ports and protocols that are commonly blocked at the perimeter
    // and whose sudden appearance in allowed traffic indicates a policy change.
    // High-risk management and lateral-movement ports:
    //   22   SSH
    //   23   Telnet
    //   3389 RDP
    //   445  SMB
    //   135  MSRPC
    //   5985 WinRM HTTP
    //   5986 WinRM HTTPS
    //   4444 Common reverse-shell default
    //   8080 Alternate HTTP (often used for C2)
    //   1080 SOCKS proxy
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 3389 or
      $net.target.port = 445 or
      $net.target.port = 135 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 4444 or
      $net.target.port = 8080 or
      $net.target.port = 1080
    )

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
