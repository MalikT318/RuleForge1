/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:05:08.290742+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Compress_Then_Exfil_Staging_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage compression-then-staging pattern on Linux: a compression utility creates an archive in a world-writable or temporary directory, followed within 5 minutes by a network connection originating from the same host. This combination suggests payload compression for exfiltration or C2 staging rather than routine archiving. Intentionally avoids command-line matching to provide additive coverage beyond existing process-launch rules."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM, producing FILE_CREATION events with principal.process.file.full_path populated and NETWORK_CONNECTION events with principal.process.file.full_path and target.ip populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate backup jobs (tar/gzip to /tmp before transfer), CI/CD pipelines compressing build artefacts, package managers staging compressed downloads, developer workflows using scp/rsync after archiving."
    tuning_guidance = "Add known backup or deployment process paths to %global_allowed_backup_processes. Add approved scanner or management source IPs to %global_allowed_scanners. Narrow the file path regex to exclude specific staging directories used legitimately in your environment."

  events:
    // Event 1: a compression utility creates a file in a world-writable or
    // temporary location. We match on the creating process path rather than
    // command-line arguments to avoid duplicating existing process-launch rules.
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(tar|gzip|bzip2|xz|zip|zstd|pigz|lz4|compress|7z|rar|zcat|pzstd)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm|var\/run|home\/[^/]+\/(\.cache|\.local\/share|tmp)|opt\/[^/]+\/tmp)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    // Event 2: within the same window, an outbound network connection is made
    // from the same host. We restrict to non-RFC-1918 destinations to focus on
    // external staging/exfiltration and exclude internal backup traffic.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    $net.principal.hostname = $hostname

    // Enforce chronological ordering: archive creation precedes the connection.
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(72)
    $mitre_technique_id  = array_distinct("T1027.015")
    $primary_entity      = array_distinct($hostname)
    $archive_paths       = array_distinct($file.target.file.full_path)
    $compressor_process  = array_distinct($file.principal.process.file.full_path)
    $destination_ips     = array_distinct($net.target.ip)
    $destination_ports   = array_distinct($net.target.port)
    $net_process         = array_distinct($net.principal.process.file.full_path)

  condition:
    $file and $net
}
