/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:08:41.821721+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_Container_Cron_File_Then_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cron or scheduled-task file written inside a running container followed by a process execution originating from that same container within one hour. Writing cron files or systemd unit files inside a container and then executing processes is a strong indicator of persistence establishment via scheduled task abuse in containerised environments."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053"
    mitre_technique_name = "Scheduled Task/Job"
    log_prerequisites = "Requires container runtime audit logs normalised to Chronicle UDM. FILE_CREATION and PROCESS_LAUNCH events must include principal.namespace or a container/pod identifier surfaced in principal.hostname or principal.resource.name."
    platform = "Linux"
    log_source = "container"
    false_positives = "Legitimate CI/CD pipelines that install cron jobs as part of image build steps executed at runtime; configuration management tooling (Ansible, Chef) running inside containers; monitoring agents that write systemd drop-ins."
    tuning_guidance = "Add known CI/CD service accounts to %global_allowed_service_accounts. Add approved container image names or pod prefixes to %global_allowed_admin_tools if they legitimately write cron files at runtime."

  events:
    // Event 1: A cron or systemd schedule file is created inside a container
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /\/etc\/cron(\.(d|daily|hourly|weekly|monthly))?\/[^\/]+$/ nocase
      or
      $file.target.file.full_path = /\/var\/spool\/cron\// nocase
      or
      $file.target.file.full_path = /\/etc\/crontab$/ nocase
      or
      $file.target.file.full_path = /\/run\/systemd\// nocase
      or
      $file.target.file.full_path = /\/etc\/systemd\/system\/[^\/]+\.(service|timer)$/ nocase
      or
      $file.target.file.full_path = /\/usr\/lib\/systemd\/system\/[^\/]+\.(service|timer)$/ nocase
    )
    // Narrow to container context: container runtimes surface namespace or pod name in principal.namespace
    $file.principal.namespace != ""
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.namespace = $container_ns

    // Event 2: A process is launched in the same container namespace after the file write
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.namespace != ""
    $proc.principal.namespace = $container_ns
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

    // Chronological ordering: file write must precede process launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $container_ns over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053")
    $primary_entity = array_distinct($file.principal.namespace)
    $written_schedule_files = array_distinct($file.target.file.full_path)
    $launched_processes = array_distinct($proc.target.process.file.full_path)
    $launched_cmdlines = array_distinct($proc.target.process.command_line)
    $acting_users = array_distinct($file.principal.user.userid)
    $source_hostnames = array_distinct($file.principal.hostname)

  condition:
    $file and $proc
}
