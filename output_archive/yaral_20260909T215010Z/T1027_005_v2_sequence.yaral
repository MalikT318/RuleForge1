/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:57:48.354187+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_AV_Quarantine_Then_Modified_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a sequence where an AV/EDR quarantine or remediation event is followed by a new executable file creation in a user-writable or suspicious directory on the same host within 5 minutes. This pattern is consistent with an adversary observing a detection, modifying their tool to evade the signature, and re-staging the updated binary."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires EDR or Sysmon telemetry normalised to UDM. The quarantine event must surface as a REGISTRY_MODIFICATION to the AV quarantine registry key (e.g., Windows Defender quarantine store) or equivalent. File creation events must be captured by the EDR sensor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software updates that write new executables after an AV false-positive quarantine; patch management tools; software installers that trigger heuristic detections before writing updated binaries."
    tuning_guidance = "Add known patch/deployment parent processes to %global_allowed_backup_processes. Add trusted software update paths to %global_allowed_admin_tools. Narrow the file path regex to specific high-risk directories if false-positive volume is high."

  events:
    // Event 1: AV/EDR quarantine action recorded in the Windows Defender
    // quarantine registry hive. Defender writes entries under this key when
    // it quarantines a file. Other EDR products write similar registry
    // artefacts normalised to REGISTRY_MODIFICATION by Chronicle UDM.
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows Defender\\Quarantine\\/  nocase
    $reg.principal.hostname = $hostname

    // Event 2: A new executable or script file is created on the same host
    // shortly after the quarantine event. The file lands in a user-writable
    // or staging directory, which is the typical re-drop location.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData|Downloads|Desktop|Documents)|\\ProgramData\\|\\Windows\\Temp\\|\\Temp\\|\\Public\\)/
    $file.target.file.full_path = /(?i)\.(exe|dll|ps1|bat|cmd|vbs|js|hta|scr|cpl|msi|jar)$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Chronological ordering: quarantine must precede the file drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($hostname)
    $quarantine_registry_key = array_distinct($reg.target.registry.registry_key)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $dropping_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
