/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:14:52.154416+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Registry_Modified_Then_User_Login {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects modification of Winlogon helper registry keys (Userinit, Shell, Notify) followed by a user login on the same host within 10 minutes. This sequence indicates that a persistence payload was staged in the Winlogon registry and then triggered at the next logon event, a hallmark of T1547.004 abuse."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION) and Windows Security logon events (USER_LOGIN) normalised into UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers or system management tools that update Userinit or Shell values; domain group-policy refreshes that touch Winlogon keys; security agents that monitor or restore these keys."
    tuning_guidance = "Add known-good installer or management processes to %global_allowed_admin_tools. Add authorised service accounts that perform registry writes to %global_allowed_service_accounts."

  events:
    // Event 1: Winlogon helper registry key is modified
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon$/
    $reg.target.registry.registry_value_name = /(?i)^(Userinit|Shell|Notify)$/
    // Exclude known-good administrative and security tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: A user logs in on the same host after the registry modification
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Enforce chronological ordering: registry write precedes the login
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1547.004")
    $primary_entity      = array_distinct($hostname)
    $modified_reg_key    = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writing_process     = array_distinct($reg.principal.process.file.full_path)
    $logged_in_user      = array_distinct($auth.principal.user.userid)
    $reg_event_count     = count($reg.metadata.event_timestamp.seconds)

  condition:
    $reg and $auth
}
