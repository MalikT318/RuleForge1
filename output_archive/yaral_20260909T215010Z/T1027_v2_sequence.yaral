/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:54:25.791777+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_ESXi_Login_Then_Datastore_Obfuscated_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive or SSH login to an ESXi host followed by a setting or configuration modification that writes to a datastore or scratch path, a pattern consistent with staging obfuscated payloads (encoded scripts, encrypted archives, or split-payload drops) on the hypervisor. This is additive coverage over command-line obfuscation rules by correlating the authentication event with a subsequent host configuration change rather than inspecting process arguments."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "Requires ESXi hostd and shell telemetry normalised into Chronicle UDM. USER_LOGIN events must populate principal.user.userid and principal.hostname. SETTING_MODIFICATION events must populate target.resource.name or target.file.full_path with the affected datastore or configuration path."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised VMware administrators deploying OVA/OVF templates, ISO uploads, or vSphere Lifecycle Manager patches. Backup agents writing to datastores. Automated provisioning pipelines using service accounts."
    tuning_guidance = "Add known administrative service accounts to %global_allowed_service_accounts. Add approved management source IPs to %global_allowed_mgmt_sources. Narrow the datastore path regex to exclude known-good staging directories if your environment uses a consistent naming convention."

  events:
    // Event 1: Interactive or SSH login to the ESXi management plane
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $esxi_host
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Event 2: A host setting or configuration modification targeting a
    // datastore, scratch space, or tmp path - common staging locations for
    // obfuscated payloads on ESXi
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname = $esxi_host
    $cfg.target.resource.name = /(?i)(\/vmfs\/volumes\/|\/scratch\/|\/tmp\/|\/store\/|\.vmdk|\.tar|\.gz|\.zip|\.b64|\.enc|\.bin|\.dat)/
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: login must precede the configuration change
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $esxi_host over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($auth.principal.hostname)
    $acting_user = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $modified_resources = array_distinct($cfg.target.resource.name)
    $event_count = count($cfg.metadata.event_timestamp.seconds)

  condition:
    $auth and $cfg
}
