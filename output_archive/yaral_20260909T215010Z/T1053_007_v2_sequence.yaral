/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:11:46.951131+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_CronJob_Creation_Followed_By_Suspicious_Container_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation of a Kubernetes CronJob or Job resource followed by execution into a container within the same namespace, indicating potential scheduled malicious task deployment."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes audit logs for resource creation and container exec events."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD pipelines creating jobs for automated testing, legitimate administrative exec sessions for troubleshooting, GitOps operators deploying scheduled workloads."
    tuning_guidance = "Add approved service accounts to %global_allowed_service_accounts and known CI/CD namespaces to exclusions."

  events:
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.resource.attribute.labels.key = /^(kind|resource)$/ nocase
    $create.target.resource.attribute.labels.value = /(?i)^(cronjob|job)$/
    $create.target.resource.name = /(?i).+/
    $create.target.namespace = $namespace
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid = /^system:serviceaccount:kube-system:/ nocase

    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.resource.attribute.labels.key = "verb"
    $exec.target.resource.attribute.labels.value = /(?i)^(exec|attach)$/
    $exec.target.resource.type = /(?i)pod/
    $exec.target.namespace = $namespace
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid = /^system:serviceaccount:kube-system:/ nocase

    $create.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $namespace over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($namespace)
    $job_names = array_distinct($create.target.resource.name)
    $exec_users = array_distinct($exec.principal.user.userid)
    $exec_pods = array_distinct($exec.target.resource.name)

  condition:
    $create and $exec
}
