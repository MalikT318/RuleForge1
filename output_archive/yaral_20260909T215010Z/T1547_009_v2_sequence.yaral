/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:17:26.003209+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_LNK_Startup_Then_Suspicious_Child_Process {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a .lnk file written into a Windows Startup folder followed by a suspicious process launched from that same host within 10 minutes. This correlation catches shortcut-based persistence where the LNK is planted and then immediately tested or triggered, without relying on command-line matching alone."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION telemetry capturing full target file paths, and PROCESS_LAUNCH telemetry with parent/child process lineage. Both event types must be normalised into UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers that legitimately place shortcuts in the Startup folder (e.g. collaboration tools, VPN clients, RMM agents). Automated deployment pipelines. User-created shortcuts for approved applications."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Add approved script hosts to %global_allowed_script_hosts. Narrow the child-process regex if specific interpreters are not relevant to the environment."

  events:
    // Event 1: A .lnk file is created inside a Windows Startup folder
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\[^\\]+\.lnk$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Event 2: A suspicious interpreter or shell process launches on the same host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic|msiexec|installutil)\.exe$/
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Chronological ordering: LNK creation precedes or coincides with process launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1547.009")
    $primary_entity      = array_distinct($file.principal.hostname)
    $lnk_paths_created   = array_distinct($file.target.file.full_path)
    $lnk_writer_process  = array_distinct($file.principal.process.file.full_path)
    $child_processes      = array_distinct($proc.target.process.file.full_path)
    $child_cmdlines       = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
