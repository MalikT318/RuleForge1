/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:09:25.167727+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_At_Job_File_Then_Process_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the Windows 'at' job scheduling mechanism by correlating a job file written to the legacy AT job directory (C:\\Windows\\System32\\Tasks\\At* or C:\\Windows\\SysWOW64\\Tasks\\At*) followed by a process launched from an unusual parent within the same host. This provides additive coverage beyond command-line matching by focusing on the artifact creation and subsequent child process execution pattern associated with T1053.002."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION telemetry for task job files and PROCESS_LAUNCH telemetry with parent process lineage. Windows Security Event 4688 with command-line auditing also satisfies the process event."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy enterprise scheduling software that still uses the AT job infrastructure. Backup or compliance tools that enumerate or recreate AT job files. Administrative scripts that programmatically manage AT jobs in older environments."
    tuning_guidance = "Add known scheduling service accounts to %global_allowed_service_accounts. Add approved administrative tooling that writes to the Tasks directory to %global_allowed_admin_tools. Narrow the child process regex if specific interpreters are approved in your environment."

  events:
    // Event 1: AT job file written to the legacy Windows AT job directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Windows\\(System32|SysWOW64)\\Tasks\\At\d+$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Event 2: A shell or scripting process launched - indicative of AT job payload execution
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|msiexec)\.exe$/
    // Parent should be the Task Scheduler service host or svchost, confirming AT-triggered launch
    $proc.principal.process.file.full_path = /(?i)\\(svchost|taskeng|taskhost|taskhostw)\.exe$/
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Chronological ordering: file written before process launched
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $at_job_files_written = array_distinct($file.target.file.full_path)
    $child_processes_launched = array_distinct($proc.target.process.file.full_path)
    $child_process_cmdlines = array_distinct($proc.target.process.command_line)
    $triggering_users = array_distinct($file.principal.user.userid)
    $executing_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
