/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:52:48.205950+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1562_003_Firewall_Rule_Creation_Then_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation of a Windows firewall rule followed by an external network connection from the same process, indicating potential firewall bypass for C2 or data exfiltration."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1562.003"
    mitre_technique_name = "Impair Defenses: Impair Command History Logging"
    log_prerequisites = "Requires EDR process and network telemetry or Sysmon Event IDs 1 and 3."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers creating firewall rules for legitimate applications, remote management tools, backup agents, database servers."
    tuning_guidance = "Add approved installer processes to %global_allowed_admin_tools and known-good destinations to %global_allowed_domains."

  events:
    $rule.metadata.event_type = "PROCESS_LAUNCH"
    (
      $rule.target.process.file.full_path = /\\netsh\.exe$/ nocase and
      $rule.target.process.command_line = /(?i)advfirewall/ and
      $rule.target.process.command_line = /(?i)firewall/ and
      $rule.target.process.command_line = /(?i)add\s+rule/
    ) or (
      $rule.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase and
      $rule.target.process.command_line = /(?i)new-netfirewallrule/
    )
    not $rule.principal.process.file.full_path in %global_allowed_admin_tools
    $rule.principal.hostname = $hostname
    $rule.principal.process.pid = $parent_pid

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.pid = $parent_pid
    not $net.target.ip in %rfc1918_internal
    not net.ip_in_range_cidr($net.target.ip, "127.0.0.0/8")
    not net.ip_in_range_cidr($net.target.ip, "169.254.0.0/16")
    $net.principal.hostname = $hostname

    $rule.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $parent_pid over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1562.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $firewall_command = array_distinct($rule.target.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $parent_process = array_distinct($rule.principal.process.file.full_path)

  condition:
    $rule and $net
}
