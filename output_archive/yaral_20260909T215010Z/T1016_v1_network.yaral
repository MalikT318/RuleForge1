/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:20:09.095521+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_Network_Config_Discovery_Outbound_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows host making an unusually high volume of outbound connections to external IP addresses in a short window, consistent with automated network configuration discovery or reconnaissance. Adversaries running tools such as arp, ipconfig, nbtstat, or route may subsequently probe discovered network ranges. This rule pivots to the network side to complement existing process-launch detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Each permitted flow must be represented as a distinct event."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Vulnerability scanners, backup agents performing inventory, software update services, and authorised network management tooling contacting many external endpoints."
    tuning_guidance = "Add known scanner source IPs to %global_allowed_scanners, approved admin tool source hosts to %global_allowed_admin_tools, and trusted external destinations to %global_allowed_domains. Raise the threshold if the environment has legitimate high-fan-out egress patterns."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.hostname in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_remote_mgmt
    $net.target.port != 80
    $net.target.port != 443
    $net.principal.hostname = $src_host

  match:
    $src_host over 2m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($net.principal.hostname)
    $distinct_external_destinations = count(distinct $net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net > 20
}
