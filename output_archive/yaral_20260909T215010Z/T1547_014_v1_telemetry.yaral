/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:19:37.235606+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_ActiveSetup_StubPath_Registry_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of a StubPath value under the Active Setup Installed Components registry key. Adversaries abuse this mechanism to achieve persistence by planting a malicious executable path that runs under the logged-on user context at each login. This rule fires on the registry state change rather than the process that wrote it, providing coverage orthogonal to command-line detections."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_CREATION or REGISTRY_MODIFICATION events. Sysmon Event ID 13 (RegistryEvent - Value Set) or equivalent EDR registry monitoring must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate Microsoft and third-party software installers that register components under Active Setup (e.g., Office, .NET, IE, Visual C++ redistributables). These typically write well-known GUIDs and point to signed system binaries."
    tuning_guidance = "Populate %global_allowed_admin_tools with full paths of known-good installer processes (msiexec.exe, setup.exe variants from approved software). Consider adding a secondary filter on the StubPath value pointing outside of System32/SysWOW64 to reduce noise from legitimate component registration."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Active Setup Installed Components key and specifically the StubPath value
    $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\/
    $reg.target.registry.registry_value_name = /(?i)^StubPath$/

    // Exclude StubPath values that point to canonical Windows system directories
    // Legitimate entries almost always resolve to system32, syswow64, or program files
    not $reg.target.registry.registry_value_data = /(?i)^[a-z]:\\windows\\(system32|syswow64)\\/
    not $reg.target.registry.registry_value_data = /(?i)^[a-z]:\\program files(?: \(x86\))?\\microsoft\//

    // Exclude known-good administrative and deployment tooling writing these keys
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity    = array_distinct($reg.principal.hostname)
    $writing_process   = array_distinct($reg.principal.process.file.full_path)
    $stubpath_value    = array_distinct($reg.target.registry.registry_value_data)
    $registry_key      = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
