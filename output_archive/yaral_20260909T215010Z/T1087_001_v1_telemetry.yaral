/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:23:53.754971+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_Local_Account_Enum_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file creation artifacts produced when adversaries redirect local account enumeration output to disk. Tools such as net user, wmic useraccount, and PowerShell Get-LocalUser are commonly piped to a file for offline review. This rule fires on the resulting FILE_CREATION event rather than the process launch, providing a complementary detection layer that survives command-line obfuscation and argument spoofing."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event). The creating process field must be populated by the sensor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT asset-inventory scripts, SCCM/Intune compliance checks, authorised audit tooling, and backup agents that enumerate accounts and write reports to disk."
    tuning_guidance = "Add known inventory and audit parent process paths to %global_allowed_admin_tools. Scope the path regex to exclude dedicated reporting directories used by approved tooling (e.g. C:\\ProgramData\\ManagementAgent\\)."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File written to a world-accessible or user-writable staging location
    // commonly used to exfiltrate enumeration output
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData\\(Local|Roaming)|Desktop|Documents|Downloads)|\\Windows\\Temp|\\Temp|\\ProgramData|\\Public)\\[^\\]+\.(txt|csv|log|out|dat|tmp)$/

    // The file was created by a process associated with account enumeration:
    // net.exe, wmic.exe, powershell.exe, pwsh.exe, cmd.exe (as a shell
    // orchestrating redirection), or nltest.exe
    $file.principal.process.file.full_path = /(?i)\\(net\.exe|net1\.exe|wmic\.exe|powershell\.exe|pwsh\.exe|cmd\.exe|nltest\.exe|dsquery\.exe)$/

    // Exclude approved administrative and security tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service and automation accounts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
