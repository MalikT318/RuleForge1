/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:56:22.955666+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Image_File_Created_Then_Exfil_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a steganography-related sequence: a scripting host or document reader creates an image file (potential payload embedding), followed by an outbound network connection from the same host to a non-RFC1918 destination. This pattern matches techniques such as Invoke-PSImage where PowerShell encodes data into a PNG before exfiltrating it."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires EDR or Sysmon telemetry providing FILE_CREATION events with process context and NETWORK_CONNECTION events with process and IP context. Both event types must be normalised into UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate screenshot tools, image editors, or reporting software that write image files and then upload them to cloud storage. Browser-based image downloads followed by sync agents. Security tools capturing screenshots for incident evidence."
    tuning_guidance = "Add known-good parent processes (e.g., screenshot utilities, backup agents) to %global_allowed_backup_processes. Add approved cloud storage or CDN destinations to %global_allowed_domains. Narrow the image extension regex if PNG-only coverage is sufficient for your environment."

  events:
    // Event 1: A scripting host, document reader, or shell creates an image file.
    // Narrow pre-filter: restrict to high-risk parent processes to avoid Cartesian explosion.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(png|bmp|jpg|jpeg|gif|tif|tiff)$/
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|winword|excel|powerpnt|cmd|wmic)\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    // Event 2: The same host makes an outbound connection to a non-internal IP
    // from a scripting or shell process shortly after the image write.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|winword|excel|powerpnt|cmd|wmic)\.exe$/
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    $net.principal.hostname = $hostname

    // Chronological ordering: image write must precede the network connection.
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $image_files_written = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $network_processes = array_distinct($net.principal.process.file.full_path)

  condition:
    $file and $net
}
