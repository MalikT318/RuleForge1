/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 3  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:53:05.348863+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_001_SaaS_Security_Policy_Bypass_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects anomalous modification or disabling of security-related policies, MFA enforcement, or conditional access controls via identity provider audit logs. Adversaries exploiting SaaS or IdP vulnerabilities may manipulate authentication enforcement, MFA requirements, or security group memberships to impair defensive visibility and bypass access controls - a SaaS-layer analog to T1687 defense impairment."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires identity provider audit logs (e.g., Entra ID, Okta) normalized to UDM. Must capture USER_CHANGE_PERMISSIONS and GROUP_MODIFICATION events including target resource names and operation details."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Authorized IT administrators performing planned MFA policy rollouts, conditional access policy updates during change windows, or security group restructuring. Break-glass account usage may also trigger this rule."
    tuning_guidance = "Add known change-management service accounts to %global_allowed_service_accounts. Add authorized admin users performing planned policy changes to %global_allowed_admin_users. Consider correlating with a change-management ticket system to suppress approved windows."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // Target resource must relate to security enforcement controls
    // Matches MFA policy, conditional access, authentication policy, security defaults, etc.
    $auth.target.resource.name = /(?i)(mfa|multi.?factor|conditional.?access|authentication.?policy|security.?default|identity.?protection|sign.?in.?risk|access.?policy|compliance.?policy|device.?compliance|password.?policy|smart.?lockout|legacy.?auth|baseline.?policy|zero.?trust|privileged.?access|pim|just.?in.?time)/

    // Operation must indicate a weakening or disabling action
    $auth.security_result.summary = /(?i)(disabl|remov|delet|bypass|exempt|exclud|turn.?off|deactivat|unassign|revok|reset|clear|suppress|skip)/

    // Exclude known authorized service accounts performing automated policy management
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude known authorized administrators
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $target_policy = array_distinct($auth.target.resource.name)
    $operation_summary = array_distinct($auth.security_result.summary)
    $target_user = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
