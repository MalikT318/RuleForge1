/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:59:37.997979+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Stripped_Payload_Network_Delivery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects network-observable characteristics consistent with delivery of stripped or obfuscated binary payloads to Linux hosts. Stripped ELF binaries and obfuscated payloads are commonly delivered over non-standard ports, to unusual external destinations, or via HTTP with anomalous content-type or user-agent patterns that bypass standard inspection. This rule pivots to the network perimeter to provide additive coverage beyond endpoint process-launch detections."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Requires firewall or proxy logs normalised into Chronicle UDM NETWORK_HTTP or NETWORK_CONNECTION events. HTTP inspection must capture response content-type and URI fields. Connection logs must capture destination port and IP."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate software update services delivering compressed binaries, CDN-hosted application packages, container image layer pulls over non-standard ports, authorised penetration testing infrastructure."
    tuning_guidance = "Add known-good software distribution domains to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Narrow the port list if your environment uses specific non-standard ports for legitimate services. Raise severity if combined with a concurrent endpoint alert on the same host."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Exclude traffic to known-good internal address space
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external domains (CDNs, package repos, update services)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanners
    not $net.principal.ip in %global_allowed_scanners

    // Detect HTTP responses advertising binary or octet-stream content types
    // that are characteristic of raw ELF / stripped binary delivery
    (
      $net.network.http.response_code = 200 and
      (
        $net.target.file.mime_type = /application\/octet-stream/ nocase or
        $net.target.file.mime_type = /application\/x-executable/ nocase or
        $net.target.file.mime_type = /application\/x-elf/ nocase or
        $net.target.file.mime_type = /application\/x-sharedlib/ nocase
      )
    )

    // Delivery over non-standard ports increases suspicion:
    // exclude well-known HTTP/HTTPS (80, 443, 8080, 8443) to focus on anomalous channels
    not $net.target.port = 80
    not $net.target.port = 443
    not $net.target.port = 8080
    not $net.target.port = 8443

    // URI patterns consistent with staged payload retrieval:
    // short random-looking paths, /tmp-style names, or no extension (stripped binaries have no .so/.py suffix)
    (
      $net.network.http.request_url = /\/[a-zA-Z0-9]{4,16}$/ nocase or
      $net.network.http.request_url = /\/(tmp|stage|drop|bin|elf|pay|load|srv|run|exec|agent|bot|implant)/ nocase or
      $net.network.http.request_url = /\/[a-f0-9]{8,}$/ nocase
    )

  outcome:
    $risk_score        = max(65)
    $mitre_technique_id = array_distinct("T1027.008")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_host  = array_distinct($net.target.hostname)
    $destination_port  = array_distinct($net.target.port)
    $request_url       = array_distinct($net.network.http.request_url)
    $mime_type         = array_distinct($net.target.file.mime_type)

  condition:
    $net
}
