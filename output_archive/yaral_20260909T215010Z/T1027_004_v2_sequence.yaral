/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:57:12.899144+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_CompileAfterDelivery_NetworkThenBinary {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects the network-observable pattern of Compile After Delivery on Linux: an outbound connection to a non-standard port or suspicious destination is followed shortly by a new executable file appearing in a world-writable or temporary directory. Adversaries download source code or a bundled compiler, compile it locally, and execute the resulting binary. This rule joins a firewall NETWORK_CONNECTION event with a FILE_CREATION event on the same internal host, providing coverage additive to process-launch command-line rules."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires firewall or perimeter flow logs (NETWORK_CONNECTION) correlated with endpoint FILE_CREATION telemetry (EDR or auditd). Both log sources must populate principal.hostname or principal.ip consistently so the join key resolves."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate software build pipelines that pull source from external repositories and compile on the host; developer workstations running make/cmake against public repos; package managers fetching and building from source (e.g., pip install with C extensions, gem native extensions); CI/CD agents."
    tuning_guidance = "Add known build-server hostnames or IPs to %global_allowed_scanners or %global_allowed_admin_tools. Add authorised external source-code repositories to %global_allowed_domains. Narrow the file path regex to exclude /opt/build or other sanctioned build directories. Raise the destination port filter to exclude well-known SCM ports (443, 22) if your environment fetches source exclusively over HTTPS/SSH."

  events:
    // Leg 1: outbound connection from an internal host to an external destination
    // on a port commonly used for raw source/payload delivery (not standard HTTPS/SSH).
    // Firewall logs do not carry process context; we match on network observables only.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.principal.ip in %rfc1918_internal
    // Exclude the scanner/mgmt sources that legitimately reach out externally
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    // Exclude known-good external domains (CDNs, update services, approved repos)
    not $net.target.domain.name in %global_allowed_domains
    // Target must be external (not RFC-1918)
    not $net.target.ip in %rfc1918_internal
    // Flag connections on ports that are atypical for normal web/SSH traffic
    // but common for ad-hoc payload staging: exclude 80, 443, 22, 21, 25, 53
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 22
    $net.target.port != 21
    $net.target.port != 25
    $net.target.port != 53
    // Capture the internal source IP as the join key
    $net.principal.ip = $src_ip

    // Leg 2: a new executable-like file is created in a world-writable or
    // staging directory on the same host shortly after the outbound connection.
    $file.metadata.event_type = "FILE_CREATION"
    // Match common world-writable / temporary / user-staging paths on Linux
    $file.target.file.full_path = /^\/(?:tmp|var\/tmp|dev\/shm|run\/shm|home\/[^\/]+\/\.cache|home\/[^\/]+\/\.local\/share|var\/www|srv|opt\/[^\/]+\/tmp)\// nocase
    // The created file must look like a compiled binary or shared object,
    // not a source file or script - this is the "after delivery" artefact.
    $file.target.file.full_path = /(?:\.so(?:\.\d+)*|\.o|\.out|\.elf|\.bin|[^.\/]{1,32})$/ nocase
    // Exclude backup processes that legitimately write binaries to temp paths
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    // Exclude security tools that may stage files for analysis
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    // Join key: same source IP
    $file.principal.ip = $src_ip

    // Chronological ordering: network connection precedes file creation
    $net.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score          = max(78)
    $mitre_technique_id  = array_distinct("T1027.004")
    $primary_entity      = array_distinct($src_ip)
    $external_dest_ips   = array_distinct($net.target.ip)
    $external_dest_ports = array_distinct($net.target.port)
    $created_file_paths  = array_distinct($file.target.file.full_path)
    $connection_count    = count($net.target.ip)

  condition:
    $net and $file
}
