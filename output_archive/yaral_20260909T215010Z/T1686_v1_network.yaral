/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:50:29.681056+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Firewall_Disabled_New_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects new or unusual inbound/outbound network connections reaching a Linux host on ports or protocols that are commonly blocked by host firewalls (e.g., raw management ports, high-risk service ports). A sudden appearance of previously unseen external connections to sensitive ports may indicate that a host firewall has been disabled or modified to permit previously blocked traffic. This rule provides network-side coverage complementary to endpoint process-launch detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Requires firewall, perimeter, or network flow logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. The log source must populate target.port, principal.ip, target.ip, and network.ip_protocol."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised penetration testing, newly provisioned services opening expected ports, legitimate remote management sessions from approved sources, vulnerability scanner activity."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. Narrow the port list to only those unexpected in your environment. Consider raising severity if the destination is a known sensitive server segment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Traffic must originate from an external (non-RFC1918) source
    not $net.principal.ip in %rfc1918_internal

    // Exclude approved management and scanner sources
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // Target must be an internal host (RFC1918 destination)
    $net.target.ip in %rfc1918_internal

    // Focus on ports that host firewalls commonly block inbound:
    // 22 SSH, 23 Telnet, 512-514 rsh/rlogin/syslog, 3389 RDP-equivalent,
    // 4444/4445 common reverse-shell defaults, 5900 VNC, 6379 Redis,
    // 8080/8443 alt-HTTP often blocked, 9200 Elasticsearch, 27017 MongoDB
    (
      $net.target.port = 23   or
      $net.target.port = 512  or
      $net.target.port = 513  or
      $net.target.port = 514  or
      $net.target.port = 4444 or
      $net.target.port = 4445 or
      $net.target.port = 5900 or
      $net.target.port = 6379 or
      $net.target.port = 9200 or
      $net.target.port = 27017
    )

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $external_source = array_distinct($net.principal.ip)

  condition:
    $net
}
