/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:16:50.036556+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSASS_Driver_File_Then_Registry_Correlation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage LSASS driver persistence attempt: a DLL or SYS file is written into a sensitive system directory, followed within 10 minutes by a registry modification to the LSA Security Packages or Authentication Packages keys on the same host. This combination strongly indicates an adversary registering a rogue LSASS driver for persistent code execution in the LSA subsystem."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION and REGISTRY_MODIFICATION events normalised to UDM. Sysmon Event IDs 11 (file create) and 13 (registry value set) are ideal sources."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security software (AV, EDR agents) installing LSA plugins; Microsoft patches updating authentication DLLs; third-party MFA or smart-card middleware registering SSP/AP packages."
    tuning_guidance = "Add known-good security product installation paths to %global_allowed_security_tools and known-good parent processes to %global_allowed_admin_tools. Scope the file path regex further if specific vendor directories generate noise."

  events:
    // Stage 1: A DLL or SYS file is written into a Windows system directory
    // that is the canonical location for LSA-loaded drivers and packages.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\(system32|syswow64)\\[^\\]+\.(dll|sys)$/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Stage 2: A registry write to the LSA Security Packages or Authentication
    // Packages values, which control which DLLs LSASS loads at startup.
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Control\\Lsa/
    $reg.target.registry.registry_value_name = /(?i)^(Security Packages|Authentication Packages|Notification Packages)$/
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    // Enforce chronological ordering: file drop must precede registry registration
    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($hostname)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $file_writer_process = array_distinct($file.principal.process.file.full_path)
    $registry_key_modified = array_distinct($reg.target.registry.registry_key)
    $registry_value_modified = array_distinct($reg.target.registry.registry_value_name)
    $reg_writer_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $file and $reg
}
