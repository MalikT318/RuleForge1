/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:10:18.400140+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Scheduled_Task_XML_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation of XML task definition files in the Windows Task Scheduler store directories. Adversaries writing scheduled tasks via APIs, WMI, .NET wrappers, or direct file writes produce XML artifacts in these directories regardless of whether command-line logging captures the originating process. This provides artifact-layer coverage complementary to process-creation rules."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event). The sensor must monitor %SystemRoot%\\System32\\Tasks and %SystemRoot%\\SysWOW64\\Tasks."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers, Windows Update, Group Policy, and RMM/deployment tools that register scheduled tasks as part of their installation or update routines. Security agents and backup software may also create tasks."
    tuning_guidance = "Add known-good parent process paths (e.g., installer engines, deployment agents) to %global_allowed_admin_tools. Add service accounts that routinely deploy tasks to %global_allowed_service_accounts. Consider narrowing on unusual parent processes (scripting hosts, Office applications, browsers) for higher-fidelity alerting."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Task XML files are written to the Windows Task Scheduler store
    // Match both System32\Tasks and SysWOW64\Tasks subtrees
    $file.target.file.full_path = /(?i)\\Windows\\(System32|SysWOW64)\\Tasks\\/

    // Task definitions are XML files; they may have no extension or .xml
    // Exclude known Windows-internal task paths that are always legitimate
    not $file.target.file.full_path = /(?i)\\Windows\\(System32|SysWOW64)\\Tasks\\Microsoft\\Windows\\/

    // Exclude approved administrative and deployment tooling as the writing process
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved service accounts performing routine task deployment
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude backup and imaging software
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $task_file_path = array_distinct($file.target.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
