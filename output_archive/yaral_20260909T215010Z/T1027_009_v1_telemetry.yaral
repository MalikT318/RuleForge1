/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:00:15.848429+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_Embedded_Payload_Appended_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file modification events where data is appended to executable files or scripts, indicating potential embedded payload injection. Focuses on file artifact changes rather than process command lines."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Requires Linux EDR or auditd file modification telemetry with file size tracking."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software updates appending to binaries, package managers modifying executables, legitimate build processes, log rotation appending to script files."
    tuning_guidance = "Add approved update processes to %global_allowed_admin_tools. Exclude package manager parent processes and known build directories."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    (
      $file.target.file.full_path = /\/bin\// nocase or
      $file.target.file.full_path = /\/sbin\// nocase or
      $file.target.file.full_path = /\/usr\/bin\// nocase or
      $file.target.file.full_path = /\/usr\/sbin\// nocase or
      $file.target.file.full_path = /\/usr\/local\/bin\// nocase or
      $file.target.file.full_path = /\/opt\/.*\/bin\// nocase or
      $file.target.file.full_path = /\/tmp\/.*\.(sh|py|pl|rb|elf)$/ nocase or
      $file.target.file.full_path = /\/dev\/shm\/.*\.(sh|py|pl|rb|elf)$/ nocase or
      $file.target.file.full_path = /\/var\/tmp\/.*\.(sh|py|pl|rb|elf)$/ nocase or
      $file.target.file.full_path = /\/home\/[^\/]+\/\.(sh|py|pl|rb)$/ nocase
    )
    not $file.principal.process.file.full_path = /\/(apt|yum|dnf|zypper|dpkg|rpm|pacman)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path = /\/usr\/bin\/install$/ nocase
    not $file.principal.process.file.full_path = /\/usr\/bin\/cp$/ nocase
    not $file.target.file.full_path = /\/var\/log\// nocase
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
