/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:09:59.489912+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_ESXi_Crontab_Write_After_Login {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects an interactive or SSH login to an ESXi host followed by a modification to the crontab file within one hour. Adversaries targeting ESXi (e.g., ransomware families such as ESXiArgs) write directly to /var/spool/cron/crontabs/root to establish persistence because the standard crontab binary is not available on ESXi. The sequence of authentication then crontab file modification is a strong indicator of malicious scheduling activity."
    mitre_tactic    = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Requires ESXi shell/hostd authentication events normalised to USER_LOGIN and file-write events for /var/spool/cron/crontabs/ normalised to FILE_MODIFICATION or SETTING_MODIFICATION. Both event types must be forwarded to Chronicle via syslog or the VMware ESXi log source."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised ESXi administrators performing scheduled maintenance via the shell; automated configuration management tools (Ansible, vSphere Lifecycle Manager) that legitimately update cron entries; backup agents that write scheduling configuration."
    tuning_guidance = "Add known-good administrator accounts to %global_allowed_admin_users. Add approved automation service accounts to %global_allowed_service_accounts. If a specific management host always performs these changes, add its source IP to %global_allowed_mgmt_sources."

  events:
    // Event 1: Interactive or SSH login to the ESXi host shell
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $esxi_host
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Event 2: Crontab file modification following the login
    $cron.metadata.event_type = "FILE_MODIFICATION"
    $cron.target.file.full_path = /\/var\/spool\/cron\/crontabs\// nocase
    $cron.target.hostname = $esxi_host
    not $cron.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: login must precede the file write
    $auth.metadata.event_timestamp.seconds <= $cron.metadata.event_timestamp.seconds

  match:
    $esxi_host over 1h

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1053.003")
    $primary_entity      = array_distinct($esxi_host)
    $actor_user          = array_distinct($auth.target.user.userid)
    $source_ip           = array_distinct($auth.principal.ip)
    $modified_crontab    = array_distinct($cron.target.file.full_path)
    $login_count         = count($auth.metadata.event_timestamp.seconds)
    $cron_write_count    = count($cron.metadata.event_timestamp.seconds)

  condition:
    $auth and $cron
}
