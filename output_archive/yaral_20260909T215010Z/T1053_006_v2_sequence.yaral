/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:11:13.530795+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Timer_File_Created_Then_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation of a systemd timer file followed by systemctl enable or start command, indicating persistence via scheduled execution."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires Linux EDR or auditd file and process telemetry."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate system administration, package installations, configuration management tools (Ansible, Puppet, Chef), containerized application deployments."
    tuning_guidance = "Add approved automation service accounts to %global_allowed_service_accounts or parent processes to %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /\/etc\/systemd\/system\/.*\.timer$/ nocase or
      $file.target.file.full_path = /\/usr\/lib\/systemd\/system\/.*\.timer$/ nocase or
      $file.target.file.full_path = /\/home\/[^\/]+\/\.config\/systemd\/user\/.*\.timer$/ nocase or
      $file.target.file.full_path = /\/root\/\.config\/systemd\/user\/.*\.timer$/ nocase
    )
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/systemctl$/ nocase
    (
      $proc.target.process.command_line = /(?i)\s(enable|start|daemon-reload)\s/ or
      $proc.target.process.command_line = /(?i)--user\s+(enable|start)/
    )
    $proc.target.process.command_line = /\.timer/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $timer_files = array_distinct($file.target.file.full_path)
    $systemctl_commands = array_distinct($proc.target.process.command_line)
    $user_accounts = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
