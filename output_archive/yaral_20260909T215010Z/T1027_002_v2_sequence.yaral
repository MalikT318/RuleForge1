/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:55:43.554605+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Packed_Binary_Written_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a suspicious binary written to a world-writable or staging directory followed by execution of that same file within a short window, a behavioural pattern consistent with a packed or obfuscated payload being dropped and run. This rule provides additive coverage beyond command-line packer invocation by focusing on the drop-then-execute lifecycle rather than packer tool arguments."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM, producing FILE_CREATION and PROCESS_LAUNCH events with full path information."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate software installers unpacking to /tmp; build pipelines writing compiled binaries; container entrypoint scripts; package managers staging files before installation."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Add authorised deployment service accounts to %global_allowed_service_accounts. Narrow the path regex if staging directories differ per environment."

  events:
    // Event 1: A file is created in a world-writable or staging directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/run\/shm\/)/ nocase
    // Exclude known-good backup and admin processes from writing here
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    // Capture the written file path as the join key
    $file.target.file.full_path = $dropped_path
    $file.principal.hostname = $hostname

    // Event 2: The same path is subsequently executed as a process
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $dropped_path
    $proc.principal.hostname = $hostname
    // Exclude authorised service accounts running legitimate staged binaries
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

    // Enforce chronological ordering: file must be created before execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $dropped_path over 5m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $dropped_file_paths = array_distinct($proc.target.process.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $execution_count = count($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
