/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:21:48.446759+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_WiFi_Profile_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file creation of Wi-Fi profile export artifacts outside of expected system management paths. Adversaries exporting Wi-Fi profiles via netsh or wlanAPI produce XML profile files containing SSIDs and cleartext pre-shared keys. This rule pivots on the resulting file artifact rather than the command line, providing coverage when process-creation telemetry is suppressed or the attacker uses a renamed binary."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event). The sensor must capture file paths and the creating process name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise Wi-Fi provisioning tools, MDM agents exporting profiles for backup, IT administrators running authorised network audits, Windows built-in diagnostics writing temporary WLAN state files."
    tuning_guidance = "Add authorised provisioning or MDM process paths to %global_allowed_admin_tools. If a specific staging directory is used by an approved backup workflow, consider scoping the path regex to exclude it. Raise severity to High if the creating process is not a known system binary."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Wi-Fi profile XML files written anywhere on disk.
    // netsh exports profiles as <ProfileName>.xml; malware may use arbitrary names
    // but the content structure and typical staging paths are characteristic.
    // We match on path patterns that indicate profile staging outside normal system dirs.
    (
      $file.target.file.full_path = /\\Wi-Fi-/ nocase
      or $file.target.file.full_path = /\\WLAN.*\.xml$/  nocase
      or $file.target.file.full_path = /\\wlan.*profile/  nocase
      or $file.target.file.full_path = /\\wifi.*\.xml$/ nocase
      or $file.target.file.full_path = /\\wireless.*profile.*\.xml$/ nocase
    )

    // Exclude the legitimate Windows WLAN service storage path where the OS
    // itself persists profiles - writes here are normal system behaviour.
    not $file.target.file.full_path = /(?i)\\ProgramData\\Microsoft\\Wlansvc\\Profiles\\Interfaces\\/ nocase

    // Exclude known authorised tooling.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude backup processes that legitimately read/write network state.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
