/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:02:16.267117+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Fileless_Storage_Shared_Memory_Exec_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects file creation in shared memory directories followed by execution from the same location, indicating fileless malware staging."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires Linux EDR or auditd telemetry capturing file creation and process execution events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate applications using shared memory for IPC, containerized workloads with tmpfs mounts, system initialization scripts, package managers during updates."
    tuning_guidance = "Add known-good parent processes to %global_allowed_script_hosts or exclude specific service account identifiers via %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(dev\/shm|run\/shm|var\/run|var\/lock)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $filepath

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $filepath
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path = /^\/(usr\/bin|bin|usr\/sbin|sbin)\// nocase

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $filepath over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $executed_file = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $proc
}
