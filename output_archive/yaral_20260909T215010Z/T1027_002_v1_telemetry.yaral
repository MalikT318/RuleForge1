/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:55:25.220433+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Packed_Executable_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of executable files in suspicious or user-writable locations that exhibit characteristics consistent with software packing: written by script interpreters, archive utilities, or download-capable processes rather than legitimate build toolchains. Packed executables are frequently dropped to temp, appdata, or public directories before execution. This rule targets the file artifact produced by packing activity rather than the packer command line, providing coverage that is harder to evade."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events with principal.process.file.full_path and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers unpacking to temp directories, self-extracting archives from known vendors, developer build pipelines writing compiled binaries, software update agents staging payloads."
    tuning_guidance = "Add known-good parent processes (update agents, installers) to %global_allowed_admin_tools. Add approved staging hosts to %global_allowed_script_hosts. Narrow scope by excluding specific target directory prefixes used by approved deployment tooling."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file must be a Windows executable or DLL written to disk
    $file.target.file.full_path = /(?i)\.(exe|dll|sys|scr|com|cpl|ocx)$/

    // File is written into a user-writable or temporary location
    // commonly used to stage packed payloads before execution
    $file.target.file.full_path = /(?i)^[A-Za-z]:\\(Users\\[^\\]+\\(AppData\\(Local\\Temp|Roaming)|Downloads|Desktop|Documents)|Windows\\Temp|ProgramData|Temp|Public)/

    // Parent process is a script host, browser, archive tool, or
    // download-capable binary - NOT a legitimate compiler or installer
    $file.principal.process.file.full_path = /(?i)\\(powershell\.exe|pwsh\.exe|wscript\.exe|cscript\.exe|mshta\.exe|cmd\.exe|certutil\.exe|bitsadmin\.exe|curl\.exe|wget\.exe|7z\.exe|winrar\.exe|winzip\.exe|python\.exe|pythonw\.exe|ruby\.exe|perl\.exe|node\.exe|msiexec\.exe|regsvr32\.exe|rundll32\.exe|wmic\.exe|explorer\.exe|msedge\.exe|chrome\.exe|firefox\.exe|iexplore\.exe)$/

    // Exclude known-good administrative and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved backup and imaging processes
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude hosts running approved script-based deployment workflows
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
