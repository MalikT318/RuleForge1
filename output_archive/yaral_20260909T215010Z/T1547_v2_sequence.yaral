/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:12:27.469593+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_Autostart_Registry_Write_Then_Logon_Exec {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a non-standard process writing to a common Windows autostart registry key (Run/(?i)RunOnce/Winlogon/LSA) followed by a user logon event on the same host within 10 minutes. This pattern indicates a newly planted autostart entry being exercised at logon, a hallmark of T1547 persistence. Complements existing process-launch command-line rules by pivoting on the registry write + logon sequence rather than command-line content."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION) and Windows Security logon events (USER_LOGIN) normalised into Chronicle UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers and updaters legitimately writing Run keys; Group Policy client-side extensions; RMM agents registering autostart entries; antivirus or EDR self-registration."
    tuning_guidance = "Add known-good installer and management tool paths to %global_allowed_admin_tools. Add authorised service accounts to %global_allowed_service_accounts. Narrow the registry key regex if only specific sub-keys are relevant."

  events:
    // Event 1: A non-standard process writes to a well-known autostart registry location.
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\(SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run(Once)?|SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\(Winlogon|Authentication Packages|LSA)|SYSTEM\\CurrentControlSet\\Control\\Session Manager\\(BootExecute|KnownDLLs))/
    // Exclude common legitimate writers
    not $reg.principal.process.file.full_path = /(?i)\\(msiexec|MsiExec|TrustedInstaller|svchost|WmiPrvSE|SearchIndexer|MsMpEng|SenseIR|csrss|wininit|services|lsass)\.exe$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    // Capture the hostname as the join key
    $reg.principal.hostname = $hostname

    // Event 2: A user logon occurs on the same host after the registry write.
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    //(?i) Exclude machine/service logon types (type 3 network, type 5 service, type 4 batch)
    // Focus on interactive and remote-interactive logons where autostart entries execute
    not $auth.principal.user.userid = /(?i)\$$/ // exclude computer accounts (end with $)
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: registry write must precede the logon
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(75)
    $mitre_technique_id  = array_distinct("T1547")
    $primary_entity      = array_distinct($hostname)
    $modified_reg_keys   = array_distinct($reg.target.registry.registry_key)
    $writing_process     = array_distinct($reg.principal.process.file.full_path)
    $writing_user        = array_distinct($reg.principal.user.userid)
    $logon_user          = array_distinct($auth.principal.user.userid)
    $reg_value_names     = array_distinct($reg.target.registry.registry_value_name)

  condition:
    $reg and $auth
}
