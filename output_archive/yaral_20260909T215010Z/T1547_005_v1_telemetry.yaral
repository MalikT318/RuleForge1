/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:15:06.994946+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_SSP_Registry_Key_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the LSA Security Packages registry keys used to register Security Support Providers (SSPs). Adversaries add malicious DLLs to these keys so they are loaded into lsass.exe at boot or via AddSecurityPackage, gaining access to plaintext credentials. This rule fires on the registry state change rather than the command line, providing coverage that is harder to evade."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION events. Sysmon Event ID 13 or equivalent EDR registry write events must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security software (e.g., smart-card middleware, third-party authentication providers) that registers a new SSP DLL. Domain controllers may modify these keys during OS or role updates. Patch Tuesday or Windows Feature Updates may also touch these keys."
    tuning_guidance = "Identify the principal process responsible for legitimate SSP registration in your environment (e.g., a known installer or Windows Update worker) and add it to %global_allowed_admin_tools. Alternatively, baseline the expected value of Security Packages in your environment and alert only on additions beyond that baseline."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Lsa(\\OSConfig)?\\Security Packages$/  nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
