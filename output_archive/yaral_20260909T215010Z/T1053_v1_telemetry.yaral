/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:08:22.293488+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_Scheduled_Task_XML_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of XML task definition files in the Windows Task Scheduler store directories. Adversaries who create scheduled tasks via COM objects, WMI, or direct API calls bypass command-line logging but still produce a task XML artifact on disk. This rule targets that resulting file-system state change rather than the process invocation, providing additive coverage over command-line rules."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053"
    mitre_technique_name = "Scheduled Task/Job"
    log_prerequisites = "Requires EDR or Sysmon file-creation/modification telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION. Sysmon Event ID 11 (FileCreate) or equivalent EDR file telemetry must be enabled and ingested."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers and update agents that register scheduled tasks (e.g., Windows Update, antivirus, backup agents). Administrative scripting that provisions tasks via PowerShell New-ScheduledTask. Group Policy preference-deployed tasks."
    tuning_guidance = "Add known-good parent process paths (e.g., TrustedInstaller, msiexec, software deployment agents) to %global_allowed_admin_tools. Add authorised service accounts that provision tasks to %global_allowed_service_accounts. Scope further by excluding known-good task name patterns via the target.file.full_path field."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target the Windows Task Scheduler XML store locations.
    // Tasks written here represent the persisted state of a scheduled task
    // regardless of how the task was created (schtasks.exe, COM, WMI, API).
    $file.target.file.full_path = /(?i)\\Windows\\System32\\Tasks\\.+/ nocase

    // Restrict to XML files - the native task definition format.
    // Attackers writing raw XML directly to this path bypass schtasks.exe entirely.
    $file.target.file.full_path = /(?i)\.xml$/ nocase

    // Exclude known-good administrative and deployment tooling as the writing process.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service accounts performing legitimate task provisioning.
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude backup and imaging software that may snapshot this directory.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1053")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $task_file_path = array_distinct($file.target.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
