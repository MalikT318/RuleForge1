/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:04:00.100730+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Polymorphic_Executable_Written_To_Volatile_Path {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects executable files written to volatile or world-writable directories on Linux (/tmp, /dev/shm, /run/shm, /var/tmp). Polymorphic malware frequently writes mutated copies of itself to these locations between execution cycles to evade signature-based detection. This rule targets the file artifact produced by the mutation engine rather than the command line used to invoke it, providing a complementary detection layer."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path and target.file.mime_type or target.process.file.full_path populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Build systems or CI/CD pipelines that compile and stage binaries in /tmp; container runtimes extracting layers to /tmp; legitimate JIT compilers (JVM, V8) writing native stubs to /tmp; package managers using /var/tmp as a staging area."
    tuning_guidance = "Add known build-system or CI runner parent process paths to %global_allowed_admin_tools. Add known service accounts that legitimately write binaries to volatile paths to %global_allowed_service_accounts. Consider narrowing to specific subdirectory patterns if a build system consistently uses a predictable prefix."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be inside a volatile or world-writable directory
    $file.target.file.full_path = /^\/tmp\// nocase or
    $file.target.file.full_path = /^\/dev\/shm\// nocase or
    $file.target.file.full_path = /^\/run\/shm\// nocase or
    $file.target.file.full_path = /^\/var\/tmp\//  nocase

    // The written file must look like an ELF executable or shared object,
    // or have no extension at all (common for dropped polymorphic payloads).
    // We match on path patterns rather than MIME type to maximise portability
    // across EDR normalisations.
    (
      $file.target.file.full_path = /\.(elf|so(\.\d+)*)$/ nocase or
      // No extension at all - filename contains no dot after the last slash
      $file.target.file.full_path = /\/[^\/\.]+$/
    )

    // Exclude known-good parent processes (backup agents, security tools, etc.)
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude known service accounts that legitimately stage binaries
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude package managers and common build tooling by parent path prefix
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|yum|dnf|make|cmake|gcc|g\+\+|clang|ld|as|strip|install)$/ nocase

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_path      = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
