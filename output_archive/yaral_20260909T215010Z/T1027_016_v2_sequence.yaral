/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:05:56.180962+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_JunkCode_SuspiciousFileWrite_Then_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage pattern associated with junk-code-obfuscated payloads on Windows: a script interpreter or compiler-adjacent process writes a new executable or script file to a user-writable or temp location, followed within 5 minutes by execution of that newly written file. Junk-code-padded binaries are frequently staged this way to evade static analysis before launch."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION and PROCESS_LAUNCH telemetry normalised into UDM. Sysmon Event IDs 11 (FileCreate) and 1 (ProcessCreate) are sufficient."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers that unpack and immediately run components; legitimate build pipelines (MSBuild, dotnet publish); developer IDEs compiling and running test binaries; update agents staging patches."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Add authorised build-system service accounts to %global_allowed_service_accounts. Narrow the file-write path regex if temp-directory staging is too broad for a given client."

  events:
    // --- Event 1: a script host or interpreter writes a new PE or script file
    //     into a user-writable or temporary location ---
    $file.metadata.event_type = "FILE_CREATION"

    // Parent process is a script host, shell, or downloader-adjacent binary
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|cmd|certutil|bitsadmin|regsvr32|rundll32|msiexec|wmic)\.exe$/  nocase

    // Written file is an executable, script, or dynamic library
    $file.target.file.full_path = /\.(exe|dll|ps1|vbs|js|hta|bat|cmd|scr|com)$/ nocase

    // Written into a user-writable or temporary path
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData|Desktop|Downloads|Documents)|\\Temp\\|\\Windows\\Temp\\|\\ProgramData\\|\\Public\\)/ nocase

    // Exclude known-good admin and backup tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Capture the written file path and host as join keys
    $file.target.file.full_path = $staged_path
    $file.principal.hostname    = $hostname

    // --- Event 2: the staged file is subsequently launched as a process ---
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // The launched binary matches the file that was just written
    $proc.target.process.file.full_path = $staged_path
    $proc.principal.hostname            = $hostname

    // Exclude service accounts expected to run staged installers
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: file write must precede execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $staged_path over 5m

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $executed_path     = array_distinct($proc.target.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
