/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:13:17.232216+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_AuthPackage_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the LSA Authentication Packages registry value under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa. Adversaries abuse this autostart mechanism to load a malicious DLL into the LSA process at boot, achieving persistence and potential privilege escalation. This rule targets the resulting registry state change rather than the process command line, providing coverage orthogonal to process-creation detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION events. Sysmon Event ID 13 or equivalent EDR registry write events must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party authentication providers (smart-card middleware, biometric software, enterprise SSO agents) may write to this key during installation. Security software and domain-joined systems may also modify LSA configuration during setup or policy application."
    tuning_guidance = "Identify the parent process responsible for the write (principal.process.file.full_path) and add approved installer or security agent paths to %global_allowed_security_tools or %global_allowed_admin_tools. Baseline the expected value of the Authentication Packages key in your environment and alert only on deviations."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Control\\Lsa$/
    $reg.target.registry.registry_value_name = /(?i)^Authentication Packages$/
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
