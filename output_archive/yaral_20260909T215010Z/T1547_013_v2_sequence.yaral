/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:19:18.772294+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_File_Write_Then_Suspicious_Exec {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a .desktop file written to an XDG Autostart directory followed by execution of a process whose parent is a desktop session launcher or shell, indicating the newly planted autostart entry may have been triggered. This provides additive coverage beyond command-line process-creation rules by correlating the file-write event with the subsequent execution on the same host."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR or auditd file-write and process-launch telemetry normalised to Chronicle UDM. FILE_CREATION and FILE_MODIFICATION events must include target.file.full_path. PROCESS_LAUNCH events must include principal.process.file.full_path and target.process.file.full_path."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate desktop application installers writing autostart entries (e.g., package managers, snap/flatpak post-install hooks). Software update agents that refresh .desktop files. User-initiated configuration of startup applications via desktop settings panels."
    tuning_guidance = "Add known-good installer or package-manager process paths to %global_allowed_admin_tools. Add authorised service accounts that perform software deployment to %global_allowed_service_accounts. Narrow the exec-side filter if specific desktop session binaries produce excessive noise in your environment."

  events:
    // Event 1: a .desktop file is written into an XDG Autostart directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\/etc\/xdg\/autostart\/|\/\.config\/autostart\/)[^\/]+\.desktop$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Event 2: a process is launched whose parent is a desktop session component
    // or a shell, on the same host, after the file write
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(?i)\/(gnome-session|xfce4-session|mate-session|lxsession|openbox|startx|xinit|bash|sh|dash|zsh|ksh|fish|python[23]?|perl|ruby|node)$/
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Chronological ordering: file write must precede the process launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1547.013")
    $primary_entity      = array_distinct($hostname)
    $written_desktop_files = array_distinct($file.target.file.full_path)
    $writing_process     = array_distinct($file.principal.process.file.full_path)
    $launched_process    = array_distinct($proc.target.process.file.full_path)
    $affected_users      = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
