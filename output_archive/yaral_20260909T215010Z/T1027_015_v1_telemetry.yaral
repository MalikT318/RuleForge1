/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:04:45.702599+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Compressed_Payload_Written_To_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects compressed or encoded binary payloads written to Windows Registry values. Adversaries store compressed shellcode or executables in registry keys to achieve fileless persistence and evade file-based detection. This rule pivots on the registry state change artifact rather than the process command line, providing additive coverage over process-creation rules."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry with registry value data captured (Sysmon Event ID 13, or equivalent EDR registry write events normalised to UDM REGISTRY_MODIFICATION). The sensor must populate target.registry.registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that cache compressed blobs in the registry (e.g., some MSI packages, browser extensions, update agents). Security tools that store compressed signatures or configuration. Group Policy client-side extensions."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools. Narrow the registry key path regex to exclude well-known software vendor subtrees (e.g., \\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer) if false-positive volume is high. Consider raising the minimum data length threshold if noisy."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target suspicious registry hive locations commonly abused for fileless storage.
    // Covers HKCU and HKLM Run keys, arbitrary software subkeys, and common persistence paths.
    $reg.target.registry.registry_key = /(?i)(\\SOFTWARE\\|\\SYSTEM\\CurrentControlSet\\|\\ENVIRONMENT\\|\\SessionManager\\|\\Run|\\RunOnce|\\Classes\\|\\Policies\\)/

    // Exclude well-known benign high-volume keys to reduce noise.
    not $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\(Installer|Uninstall|App Paths|Explorer\\RecentDocs)/

    // Detect compressed magic bytes or high-entropy encoded blobs stored as registry data.
    // ZIP magic: PK\x03\x04 -> base64 prefix "UEsD"
    // GZIP magic: \x1f\x8b -> base64 prefix "H4sI"
    // 7z magic: 7z\xbc\xaf -> base64 prefix "N3q8"
    // RAR magic: Rar! -> base64 prefix "UmFy"
    // MZ/PE header: MZ -> base64 prefix "TVo"
    // Also match raw hex-encoded compressed headers and long base64 blobs (80+ chars of b64 alphabet)
    $reg.target.registry.registry_value_data = /(?i)(UEsD|H4sI|N3q8|UmFy|TVoA|TVpA|TVpQ|7z\xBC\xAF|PK\x03\x04|\x1f\x8b|Rar!|[A-Za-z0-9+\/]{80,}={0,2}$)/

    // Exclude known-good service and automation accounts performing legitimate registry writes.
    not $reg.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative and security tooling.
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_registry_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $affected_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
