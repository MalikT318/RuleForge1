/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:56:01.367282+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Steganography_Suspicious_Media_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects FILE_CREATION or FILE_MODIFICATION of image, audio, or video files written to high-risk Linux directories (tmp, dev/shm, var/tmp, proc-adjacent paths, or hidden directories). Steganography payloads are commonly staged in these locations as media files to blend in with legitimate content while carrying hidden data or commands. This rule targets the file artifact produced by steganographic encoding rather than the encoding process itself."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires Linux EDR or auditd file-event telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate media processing pipelines writing to /tmp (e.g., ffmpeg transcoding, image thumbnail generation, browser cache writes). Web servers writing user-uploaded content. Container image build steps. Backup agents staging files."
    tuning_guidance = "Add known-good media processing parent processes to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the rule by adding a second condition on principal.process.file.full_path to exclude specific trusted binaries such as ffmpeg, ImageMagick convert, or browser processes. Consider raising severity if the writing process is also a shell or interpreter."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: media file extensions commonly used for steganographic payloads
    $file.target.file.full_path = /\.(png|jpg|jpeg|bmp|gif|tif|tiff|webp|ico|svg|mp3|mp4|wav|ogg|flac|avi|mkv|mov|wmv|wma|aac|m4a|m4v|flv|webm)$/

    // Written into high-risk staging directories or hidden paths on Linux
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/proc\/[0-9]+\/fd\/|\/var\/spool\/|\/var\/cache\/|\/home\/[^/]+\/\.[^/]+\/|\/root\/\.[^/]+\/)/

    // Exclude known-good backup and security tooling parent processes
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
