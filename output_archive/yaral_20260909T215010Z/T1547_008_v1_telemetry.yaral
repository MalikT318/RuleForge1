/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:16:29.813042+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSASS_Driver_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of DLL/SYS artifacts in LSA-related system directories that are consistent with LSASS driver implantation (T1547.008). Adversaries plant malicious drivers in paths loaded by LSASS to achieve persistence and privilege escalation. This rule fires on the resulting file artifact rather than the process command line, providing coverage that is harder to evade."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires EDR or Sysmon file-creation/modification telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Windows updates patching LSA DLLs (e.g., lsasrv.dll, msv1_0.dll), third-party MFA or smart-card middleware installing LSA notification packages, antivirus/EDR agents writing security provider DLLs, and enterprise PKI or credential-filter deployments."
    tuning_guidance = "Add known-good parent processes (e.g., TrustedInstaller, msiexec, software deployment agents) to %global_allowed_admin_tools. Add authorised security-product processes to %global_allowed_security_tools. Scope by principal.hostname if a specific host is a known exception."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a DLL or SYS binary - the only file types LSASS loads as drivers/packages
    $file.target.file.full_path = /(?i)\\.(dll|sys)$/

    // Restrict to paths where LSASS loads its drivers and security packages
    // Covers System32, SysWOW64, and the LSA-specific subdirectory
    $file.target.file.full_path = /(?i)\\Windows\\(System32|SysWOW64)(\\lsa)?\\[^\\]+\.(dll|sys)$/

    // Exclude the Windows component store and servicing stack - these are
    // legitimate update paths and would generate high false-positive volume
    not $file.target.file.full_path = /(?i)\\Windows\\(WinSxS|servicing|SoftwareDistribution)\\/

    // Exclude known-good parent processes: Windows Update / installer stack
    not $file.principal.process.file.full_path = /(?i)\\(TrustedInstaller|wuauclt|svchost|msiexec|MpSigStub|MpCmdRun)\.exe$/

    // Exclude approved security tooling and admin/deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
