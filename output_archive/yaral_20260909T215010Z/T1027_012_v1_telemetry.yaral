/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:02:33.611677+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_File_Creation_Suspicious_Location {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of LNK (Windows shortcut) files in suspicious or high-risk locations such as user temp directories, AppData, downloads, and startup folders. LNK Icon Smuggling abuses the icon location field of shortcut files to trigger downloads of malicious payloads. This rule pivots on the file artifact rather than process command-line to provide additive coverage beyond process-creation detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry normalised to UDM FILE_CREATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate application installers creating shortcuts in AppData or Startup; browser download managers; RMM tools deploying shortcuts; user-created shortcuts in Downloads."
    tuning_guidance = "Scope exclusions by adding known-good parent process paths to %global_allowed_admin_tools. If startup-folder LNK creation is noisy for a specific client, add the responsible installer process to %global_allowed_admin_tools. Raise severity to High if the creating process is a browser, email client, or document reader."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be an LNK file
    $file.target.file.full_path = /\.lnk$/  nocase

    // LNK created in suspicious high-risk locations:
    // - User temp directories
    // - AppData (Roaming/Local/LocalLow)
    // - Downloads folder
    // - Startup folders (both user and all-users)
    // - Public directories
    // - Recycle bin staging areas
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\AppData\\(Roaming|Local|LocalLow)\\|\\Users\\[^\\]+\\(Downloads|Desktop)\\|\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\|\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\StartUp\\|\\Users\\Public\\|\\Windows\\Temp\\|\\Temp\\|\\tmp\\)/

    // Exclude known-good administrative and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude backup and imaging processes that may legitimately create shortcuts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
