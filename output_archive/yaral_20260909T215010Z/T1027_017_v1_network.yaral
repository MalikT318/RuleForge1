/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:06:14.262527+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Smuggling_Network_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP responses delivering SVG files from external hosts to Windows endpoints via firewall/proxy telemetry. SVG Smuggling abuses the SVG/XML format to embed JavaScript payloads, malicious download triggers, or redirect logic inside what appears to be an image file. This rule fires on outbound HTTP requests that retrieve SVG content from external destinations, providing network-side coverage complementary to endpoint process-creation detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires firewall or forward-proxy logs normalised to UDM NETWORK_HTTP with populated network.http.response_code, network.http.request_url, and/or network.http.response_headers fields. SSL/TLS inspection must be enabled for HTTPS coverage."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SVG assets served by CDNs, web design tools, icon libraries, and SaaS dashboards. Marketing and analytics platforms frequently deliver SVG logos and charts."
    tuning_guidance = "Add known-good SVG-serving domains (CDNs, icon libraries, SaaS vendors) to %global_allowed_domains. Add approved internal scanner source IPs to %global_allowed_scanners. Consider raising severity if the destination is newly registered or uncategorised."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Request targets an SVG resource - match URL path or query string ending in .svg
    // or a content-type header indicating SVG delivery
    (
      $net.network.http.request_url = /(?i)\.svg(\?[^\s]*)?(\s|$|#|\/)/
      or
      $net.network.http.response_headers = /(?i)content-type:\s*image\/svg\+xml/
    )

    // Successful HTTP response - SVG was actually delivered
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300

    // Destination must be external - exclude RFC1918 and loopback
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

    // Exclude approved scanning infrastructure
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1027.017")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_host = array_distinct($net.target.hostname)
    $requested_url = array_distinct($net.network.http.request_url)
    $http_response_code = max($net.network.http.response_code)

  condition:
    $net
}
