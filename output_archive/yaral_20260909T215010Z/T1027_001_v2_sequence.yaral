/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:55:04.206776+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Large_File_Creation_Then_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation of an unusually large executable file followed by its execution within a short timeframe, indicative of binary padding to evade signature-based detection."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires EDR file creation and process launch telemetry."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers, development builds, software packaging tools, backup restoration, large legitimate applications."
    tuning_guidance = "Add known software deployment paths to %global_allowed_admin_tools or increase the file size threshold if environment has legitimate large binaries."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.exe$/ nocase
    $file.target.file.size >= 52428800
    not $file.target.file.full_path = /(?i)\\(program files|windows\\(system32|syswow64|winsxs))\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $filepath

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $filepath
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $filepath over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $file_size = max($file.target.file.size)
    $execution_user = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
