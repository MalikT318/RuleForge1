/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:04:22.200664+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Polymorphic_File_Write_Then_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with polymorphic code: a script interpreter or memory-manipulation process writes a new executable or script file to a user-writable or temp directory, followed shortly by execution of that newly written file from the same host. This two-stage sequence (write-then-execute from an unusual location) is a hallmark of polymorphic/self-mutating malware that rewrites itself before each run to evade static signatures."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (FILE_CREATION) and process-launch telemetry (PROCESS_LAUNCH) normalised into UDM. Both event types must carry principal.hostname and file path fields."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that extract and run embedded binaries; legitimate update agents (patch management, RMM); developer build pipelines that compile and immediately execute output; some AV/EDR self-update mechanisms."
    tuning_guidance = "Add known-good parent processes (update agents, build tools) to %global_allowed_admin_tools. Add authorised script hosts to %global_allowed_script_hosts. Narrow the file-write path regex if a specific temp directory pattern dominates false positives."

  events:
    // --- Event 1: A script host or suspicious process writes a PE or script to a user-writable / temp path ---
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\(temp|tmp|appdata|programdata|users\\[^\\]+\\(downloads|desktop|documents|appdata))\\.+\.(exe|dll|ps1|vbs|js|bat|cmd|hta|scr|pif)$/
    $file.principal.process.file.full_path = /(?i)\\(powershell|pwsh|wscript|cscript|mshta|cmd|python|ruby|perl|node|wmic|regsvr32|rundll32|msiexec|certutil|bitsadmin|curl|wget)\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $written_path

    // --- Event 2: The newly written file is subsequently launched as a process ---
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $written_path
    $proc.target.process.file.full_path = /(?i)\\(temp|tmp|appdata|programdata|users\\[^\\]+\\(downloads|desktop|documents|appdata))\\.+\.(exe|dll|ps1|vbs|js|bat|cmd|hta|scr|pif)$/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    $proc.principal.hostname = $hostname

    // --- Chronological ordering: file must be written before it is executed ---
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $written_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $executing_process = array_distinct($proc.target.process.file.full_path)
    $executing_parent = array_distinct($proc.principal.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
