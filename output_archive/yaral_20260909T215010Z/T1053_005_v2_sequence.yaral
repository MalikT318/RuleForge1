/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:10:37.976413+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Task_XML_Written_Then_Registered {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a suspicious scheduled task XML file written to the Windows Tasks directory followed by a SCHEDULED_TASK_CREATION event on the same host within one hour. Adversaries that bypass schtasks.exe (e.g. via WMI, .NET, or direct COM) still materialise a task XML under System32\\Tasks before the task is registered. This rule provides additive coverage beyond command-line schtasks detection."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION telemetry for the Tasks directory and SCHEDULED_TASK_CREATION events from Windows Security log (Event 4698) or equivalent EDR normalisation."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers, Group Policy-deployed tasks, Windows Update, RMM agents, and backup software that register scheduled tasks programmatically."
    tuning_guidance = "Add known-good parent processes to %global_allowed_admin_tools and known-good service accounts to %global_allowed_service_accounts. Consider scoping to non-SYSTEM principals if SYSTEM-created tasks dominate noise."

  events:
    // Leg 1: A file is created inside the Windows Tasks directory.
    // This fires for WMI, COM, .NET, and PowerShell task creation paths
    // that write the XML definition before registration.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\Tasks\\.+/
    not $file.target.file.full_path = /(?i)\\Windows\\System32\\Tasks\\Microsoft\\/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Leg 2: The task is subsequently registered on the same host.
    // SCHEDULED_TASK_CREATION is populated by Security Event 4698 or EDR equivalents.
    $task.metadata.event_type = "SCHEDULED_TASK_CREATION"
    $task.principal.hostname = $hostname
    not $task.principal.user.userid in %global_allowed_service_accounts
    not $task.principal.user.userid in %global_allowed_admin_users

    // Enforce chronological ordering: file write precedes task registration.
    $file.metadata.event_timestamp.seconds <= $task.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($hostname)
    $task_xml_paths = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $registering_users = array_distinct($task.principal.user.userid)
    $task_names = array_distinct($task.target.resource.name)

  condition:
    $file and $task
}
