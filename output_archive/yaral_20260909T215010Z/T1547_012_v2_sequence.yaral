/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:18:41.254426+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_PrintProcessor_Registry_Then_SpoolerRestart {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a print processor DLL registered in the Windows print spooler registry path followed by the print spooler service being restarted or a related process launch. Adversaries register malicious DLLs under HKLM\\SYSTEM\\*\\Control\\Print\\Environments\\*\\Print Processors to achieve persistence and SYSTEM-level code execution at boot."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (Event ID 13) and process launch telemetry (Event ID 1 or equivalent EDR). Both must be normalised to UDM REGISTRY_MODIFICATION and PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver installations by IT administrators, print management software, or OEM printer setup utilities that register custom print processors."
    tuning_guidance = "Add known-good printer management parent processes to %global_allowed_admin_tools. Add authorised service accounts performing driver deployment to %global_allowed_service_accounts. Scope by hostname if print server hosts are known."

  events:
    // Event 1: Registry key creation/modification under the Print Processors path
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\[^\\]+\\Control\\Print\\Environments\\[^\\]+\\Print Processors\\/
    $reg.target.registry.registry_value_name = /(?i)driver/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: Spooler service restart or net/sc command targeting spooler
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(?i)(spooler|spoolsv)/
    $proc.target.process.file.full_path = /(?i)\\(net\.exe|net1\.exe|sc\.exe|powershell\.exe|pwsh\.exe|cmd\.exe)$/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Chronological ordering: registry write must precede spooler restart
    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_value_names = array_distinct($reg.target.registry.registry_value_name)
    $spooler_restart_cmdline = array_distinct($proc.target.process.command_line)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $proc
}
