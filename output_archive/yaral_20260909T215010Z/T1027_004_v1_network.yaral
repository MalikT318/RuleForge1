/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:56:43.449251+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_CompileAfterDelivery_NetworkFetch {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable behaviour consistent with Compile After Delivery (T1027.004): an internal Windows host making an outbound connection to an external destination over ports commonly used to retrieve source-code payloads (HTTP/HTTPS/FTP/SFTP) shortly before or during compilation activity. On the network side this manifests as a workstation or server reaching an external host on these ports. Excludes known-good domains and internal address space."
    mitre_tactic         = "Defense Evasion"
    mitre_technique      = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites    = "Requires firewall or proxy perimeter logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source IP must be populated with the internal client address; destination IP must be the external endpoint."
    platform             = "Windows"
    log_source           = "firewall"
    false_positives      = "Developer workstations fetching NuGet packages, GitHub source archives, or build dependencies via CI/CD pipelines. Software update services pulling source distributions. Package managers (npm, pip, vcpkg) running on developer machines."
    tuning_guidance      = "Add approved developer hosts to %global_allowed_admin_tools exclusion or scope the rule to non-developer network segments. Add trusted external domains to %global_allowed_domains. Consider narrowing to destination ports 20/21 (FTP) if HTTP/HTTPS generates too many false positives in developer-heavy environments. Raise risk_score if the source host is a server rather than a workstation."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal address (RFC-1918 space)
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not RFC-1918)
    not $net.target.ip in %rfc1918_internal

    // Ports associated with source-code / payload retrieval:
    // 80 HTTP, 443 HTTPS, 20/21 FTP data+control, 22 SFTP/SCP, 8080/8443 alt HTTP/S
    (
        $net.target.port = 80  or
        $net.target.port = 443 or
        $net.target.port = 20  or
        $net.target.port = 21  or
        $net.target.port = 22  or
        $net.target.port = 8080 or
        $net.target.port = 8443
    )

    // Exclude approved external domains (CDNs, vendors, update services)
    not $net.target.hostname in %global_allowed_domains

    // Exclude known authorised scanners / security tooling sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved remote management sources (e.g. jump hosts pulling artefacts)
    not $net.principal.ip in %global_allowed_remote_mgmt

    // Restrict to connections that transferred a meaningful payload
    // (bytes_sent > 0 indicates an active upload/download, not a probe)
    $net.network.sent_bytes > 0

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)
    $destination_host  = array_distinct($net.target.hostname)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
