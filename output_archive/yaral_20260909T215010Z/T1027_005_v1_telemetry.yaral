/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:57:28.753206+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_Binary_Modification_After_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of an executable binary file shortly after it was executed, indicating potential indicator removal or tool modification to evade detection."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires Linux EDR or auditd file modification telemetry with executable file tracking."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software updates modifying binaries in-place, package managers updating tools, development environments with hot-reload, legitimate admin tools self-updating."
    tuning_guidance = "Add package manager paths and approved update tools to %global_allowed_admin_tools. Exclude development directories if false positives occur."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    (
      $file.target.file.full_path = /^\/tmp\// nocase or
      $file.target.file.full_path = /^\/dev\/shm\// nocase or
      $file.target.file.full_path = /^\/var\/tmp\// nocase or
      $file.target.file.full_path = /^\/home\/[^\/]+\/\./ nocase or
      $file.target.file.full_path = /^\/root\/\./ nocase
    )
    (
      $file.target.file.full_path = /\.elf$/ nocase or
      $file.target.file.full_path = /\.so(\.\d+)*$/ nocase or
      $file.target.file.full_path = /\.bin$/ nocase or
      $file.target.file.full_path = /\/(sh|bash|python|perl|ruby|php|node)$/ nocase or
      re.regex($file.target.file.full_path, /\/[^\/\.]+$/)
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path = /^\/(usr\/bin|bin)\/(apt|yum|dnf|zypper|pacman|dpkg|rpm)/ nocase
    not $file.principal.process.file.full_path = /^\/usr\/lib\/systemd\// nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
