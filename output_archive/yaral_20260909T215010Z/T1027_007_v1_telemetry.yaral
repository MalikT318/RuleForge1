/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:58:53.004811+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_Dynamic_API_Resolution_Suspicious_Module_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious in-memory module load events indicative of dynamic API resolution. Malware performing API hashing or manual PEB walking will load system DLLs (ntdll, kernel32, kernelbase) from unusual parent processes or from non-standard filesystem paths, bypassing the normal import address table. This rule pivots on PROCESS_MODULE_LOAD telemetry rather than command-line arguments to provide additive coverage beyond existing process-creation detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 7) module-load telemetry normalised into UDM PROCESS_MODULE_LOAD events with target.process.file.full_path and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Custom application loaders, legitimate packers (Themida, UPX-protected software), some JIT runtimes (JVM, .NET CLR), and security tools that perform reflective loading. Tune using %global_allowed_security_tools and %global_allowed_admin_tools."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_security_tools or %global_allowed_admin_tools. Consider narrowing the rule by requiring the loading process to reside outside of C:\\Windows and C:\\Program Files simultaneously, or by correlating with a subsequent NETWORK_CONNECTION event."

  events:
    $open.metadata.event_type = "PROCESS_MODULE_LOAD"

    // Core system DLLs that are targets for dynamic API resolution via PEB walking or API hashing
    $open.target.file.full_path = /\\(ntdll|kernel32|kernelbase|advapi32|user32|ws2_32|wininet|winhttp|crypt32)\.dll$/ nocase

    // The loading process lives outside the standard Windows and Program Files trees,
    // which is the state change produced by a dropped or injected payload resolving APIs at runtime.
    // Legitimate software loading these DLLs almost always resides in one of these two trees.
    not $open.principal.process.file.full_path = /(?i)^[A-Za-z]:\\Windows\\/
    not $open.principal.process.file.full_path = /(?i)^[A-Za-z]:\\Program Files/

    // Exclude processes with no recorded path (kernel/system) to avoid noise
    $open.principal.process.file.full_path != ""

    // Exclude known-good security and admin tooling that performs reflective loading legitimately
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude backup agents that may load modules from non-standard paths
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($open.principal.hostname)
    $loading_process = array_distinct($open.principal.process.file.full_path)
    $loaded_module = array_distinct($open.target.file.full_path)

  condition:
    $open
}
