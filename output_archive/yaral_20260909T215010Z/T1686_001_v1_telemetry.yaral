/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:51:11.562853+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Cloud_Firewall_Rule_Permissive_Ingress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a cloud firewall rule or security group that introduces overly permissive ingress access (e.g., allowing all TCP/UDP from any source). This targets the resulting configuration state change in cloud audit logs rather than the API call command line, providing coverage at a different abstraction layer than process-creation rules. Adversaries may modify cloud firewall rules to enable lateral movement or expose cloud-hosted resources."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Cloud Firewall"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). Events must populate metadata.event_type as SETTING_MODIFICATION or RESOURCE_CREATION with target.resource fields describing firewall or security group objects."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized infrastructure-as-code deployments (Terraform, CloudFormation, Deployment Manager) creating intentionally open rules in dev/test environments; approved network architecture changes by cloud platform teams; vulnerability scanner source ranges being added by security teams."
    tuning_guidance = "Add approved automation service principals to %global_allowed_cloud_principals. Add approved scanner source identities to %global_allowed_scanners. Scope exclusions to specific resource groups or projects if dev/test environments generate high volume. Consider narrowing to production environment labels if available in target.resource.attribute fields."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Target resource must be a firewall or security group object
    $cloud.target.resource.resource_type = /(?i)(firewall|security.?group|network.?acl|security.?rule|ingress.?rule|vpc.?rule)/

    // The configuration change must introduce a permissive ingress pattern:
    // wildcard CIDR (0.0.0.0/0 or ::/0), any-port (0 or *), or any-protocol
    (
      $cloud.target.resource.attribute.labels["source_range"] = /(?i)(0\.0\.0\.0\/0|::\/0|\*)/
      or
      $cloud.target.resource.attribute.labels["cidr_ip"] = /(?i)(0\.0\.0\.0\/0|::\/0|\*)/
      or
      $cloud.target.resource.attribute.labels["from_port"] = /^0$/
      or
      $cloud.target.resource.attribute.labels["protocol"] = /(?i)(all|\-1|\*)/
      or
      $cloud.target.resource.attribute.labels["direction"] = /(?i)ingress/
    )

    // Exclude approved cloud automation principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved scanner identities
    not $cloud.principal.user.userid in %global_allowed_scanners

    // Exclude internal management sources performing expected changes
    not $cloud.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $resource_type = array_distinct($cloud.target.resource.resource_type)
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
