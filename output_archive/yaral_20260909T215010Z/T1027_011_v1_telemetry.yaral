/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:01:59.892842+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Fileless_Storage_Registry_Blob {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry value writes that are characteristic of fileless payload storage: large binary blobs, base64-encoded content, or PE-header signatures written into non-standard registry keys. Adversaries abuse the Windows Registry as persistent, fileless storage for shellcode, encoded scripts, or full PE images to evade file-based AV scanning."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 13) registry value set telemetry normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and target.registry.registry_value_data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software licensing blobs, browser state storage, Windows Installer cached transforms, some AV products storing signatures in the registry."
    tuning_guidance = "Add known-good parent processes (e.g. installer engines, licensed software updaters) to %global_allowed_admin_tools. Narrow the key path regex to exclude vendor-specific subtrees that generate volume."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target keys that are not standard Windows OS hives used for fileless staging:
    // Run/RunOnce, Class roots, environment, and arbitrary user-created subkeys
    // Exclude well-known high-volume benign subtrees (Software\Microsoft\Windows\CurrentVersion\Explorer, etc.)
    $reg.target.registry.registry_key = /\\(CurrentVersion\\Run|Classes\\CLSID|Environment|Policies|Wow6432Node|Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options|Microsoft\\Windows\\CurrentVersion\\App Paths|Microsoft\\Windows\\CurrentVersion\\ShellServiceObjectDelayLoad|Microsoft\\Windows\\CurrentVersion\\Shell Extensions|Microsoft\\Windows\\CurrentVersion\\Explorer\\Browser Helper Objects|SOFTWARE\\[^\\]{1,64}\\[^\\]{1,64}\\[^\\]{1,64}$)/ nocase

    // Detect registry value DATA that looks like encoded or binary payload storage:
    // Match base64-encoded blobs (long runs of base64 chars), MZ/PE header markers
    // encoded as hex or literal, or PowerShell/script fragments stored as values
    $reg.target.registry.registry_value_data = /(?i)(TVQAAA|TVpQ|TVoA|TVpS|4d5a|4D5A|JAB|JABX|JABj|JABp|JABs|JABt|JABn|JABo|JABr|JABe|JABf|JABd|JABc|JABv|JABu|JABw|JABz|JABy|JABx|JABq|JABi|JABh|JABg|JABf|JABe|JABd|JABc|JABb|JABa|JABz|JABy|JABx|JABw|JABv|JABu|JABt|JABs|JABr|JABq|JABp|JABo|JABn|JABm|JABl|JABk|JABj|JABi|JABh|JABg|JABf|JABe|JABd|JABc|JABb|JABa|JABz|JABy|JABx|JABw|JABv|JABu|JABt|JABs|JABr|JABq|JABp|JABo|JABn|JABm|JABl|JABk|JABj|JABi|JABh|JABg|JABf|JABe|JABd|JABc|JABb|JABa|0x4d5a|\\\\x4d\\\\x5a|MZP|MZ\x90|powershell|invoke-expression|iex\(|frombase64|system\.reflection\.assembly|[A-Za-z0-9+\/]{200,}={0,2})/

    // Exclude known-good administrative and security tooling parent processes
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude service accounts performing expected privileged registry operations
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $affected_key = array_distinct($reg.target.registry.registry_key)
    $affected_value = array_distinct($reg.target.registry.registry_value_name)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
