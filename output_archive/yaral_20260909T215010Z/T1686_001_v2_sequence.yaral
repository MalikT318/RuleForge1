/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:51:32.389542+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Cloud_Firewall_Rule_Added_Then_Traffic_Permitted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a sequence where a cloud firewall rule is created or modified to permit broad inbound access, followed by a resource access event from an external source through the same principal or environment. This pattern indicates an adversary may have loosened firewall controls to enable lateral movement or data plane access from the cloud control plane."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Cloud Firewall"
    log_prerequisites = "Requires cloud provider audit logs normalised to UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). Events must include resource creation/modification and subsequent resource access events with principal user context."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized cloud engineers opening firewall rules during planned maintenance, infrastructure-as-code pipelines applying approved security group changes, cloud-native load balancer health check rule provisioning."
    tuning_guidance = "Add known automation service principals to %global_allowed_cloud_principals. Add known scanner source identifiers to %global_allowed_scanners. Narrow the resource_type filter if your environment uses a consistent naming convention for firewall/security-group resources."

  events:
    // Event 1: A firewall rule or security group is created or modified
    $fw.metadata.event_type = "RESOURCE_CREATION"
    // Target resource must be a firewall, security group, or network ACL
    $fw.target.resource.resource_type = /(?i)(firewall|security.group|network.acl|ingress|sg\-|nsg|vpc.firewall)/
    // The change must permit inbound traffic (broad allow - any source or wide CIDR)
    (
      $fw.target.resource.attribute.labels["source_ranges"] = /(?i)(0\.0\.0\.0\/0|::/0)/
      or
      $fw.target.resource.attribute.labels["direction"] = /(?i)ingress/
      or
      $fw.security_result.action_details = /(?i)(allow|permit|authorize)/
    )
    not $fw.principal.user.userid in %global_allowed_cloud_principals
    not $fw.principal.user.userid in %global_allowed_admin_users
    $fw.principal.user.userid = $cloud_user

  // Event 2: A resource access event follows from the same principal
  // indicating the actor then accesses or validates the newly exposed resource
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid = $cloud_user
    // The accessed resource should be a compute or network resource
    $access.target.resource.resource_type = /(?i)(instance|compute|vm|server|container|function|endpoint|network)/
    // Exclude known internal management sources
    not $access.principal.ip in %rfc1918_internal
    not $access.principal.user.userid in %global_allowed_cloud_principals

    // Chronological ordering: firewall change must precede the access event
    $fw.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $cloud_user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($cloud_user)
    $modified_firewall_resources = array_distinct($fw.target.resource.name)
    $accessed_resources = array_distinct($access.target.resource.name)
    $source_ips = array_distinct($access.principal.ip)
    $firewall_change_count = count($fw.metadata.id)
    $access_event_count = count($access.metadata.id)

  condition:
    $fw and $access
}
