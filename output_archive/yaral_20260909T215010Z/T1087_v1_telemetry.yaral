/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:23:14.342443+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_IaaS_Identity_Account_Enumeration_Audit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or repeated read-only directory/user enumeration operations in identity provider audit logs. Adversaries performing account discovery against cloud identity providers (Entra ID, Okta, etc.) generate a high volume of list/read API calls against user, group, or role objects. This rule fires on a single enumeration-class audit event and is intended to be paired with a threshold rule for volume-based detection. It targets the audit log artifact produced by the enumeration rather than any command-line invocation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Requires identity provider audit logs normalised into Chronicle UDM. Covers Entra ID (Azure AD) audit logs, Okta System Log, and equivalent IdP sources. Events must populate metadata.event_type = USER_RESOURCE_ACCESS with target.resource.type indicating a directory object (user, group, role, service principal)."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "HR/provisioning systems performing scheduled user sync, SCIM provisioning connectors, SIEM/SOAR integrations polling directory state, authorised identity governance tools, helpdesk automation querying user attributes."
    tuning_guidance = "Add known provisioning and automation service principals to %global_allowed_cloud_principals. Add known scanner/governance tool source identities to %global_allowed_scanners. Raise severity if the principal is not a service account and the access occurs outside business hours."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target must be a directory object type - user, group, role, or service principal
    // Chronicle normalises IdP resource types into target.resource.type
    $cloud.target.resource.type = /(?i)(user|group|role|service.?principal|directory.?object|account|member)/

    // The operation must be a read/list/get enumeration action, not a write
    // Chronicle normalises IdP operation names into target.resource.name or security_result.summary
    // Use metadata.product_event_type which carries the raw API operation name post-normalisation
    $cloud.metadata.product_event_type = /(?i)(list|get|read|search|query|find|enumerate|describe)(.*)(user|group|role|member|account|principal|identity)/

    // Exclude known automation and provisioning principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known authorised security and governance tooling
    not $cloud.principal.user.userid in %global_allowed_security_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource_type = array_distinct($cloud.target.resource.type)
    $operation_performed = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
