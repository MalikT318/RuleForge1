/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:03:16.207288+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Encoded_Payload_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of files with extensions or naming patterns strongly associated with encoded or encrypted payload staging on Windows hosts. Adversaries commonly drop Base64-encoded, XOR-encrypted, or otherwise obfuscated payloads to disk before decoding and executing them in a subsequent step. This rule targets the file artifact rather than the encoding command, providing coverage when command-line logging is absent or evaded."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION telemetry normalised to UDM. Sysmon Event ID 11 or equivalent EDR file-write events must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers writing encoded configuration blobs; backup agents writing encrypted data files; certificate management tools writing DER/PEM files; developer toolchains generating encoded resource files."
    tuning_guidance = "Add known-good parent processes (backup agents, installers, certificate tools) to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the path regex to exclude known software installation directories if false-positive volume is high. Consider raising severity if the writing process is an Office application or a script interpreter."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target suspicious staging locations: user-writable temp paths, AppData, ProgramData, and root of drives
    // Regex covers: C:\Users\<any>\AppData, C:\ProgramData, C:\Windows\Temp, C:\Temp, C:\Users\<any>\Desktop, C:\Users\<any>\Downloads
    $file.target.file.full_path = /(?i)^[A-Za-z]:\\(Users\\[^\\]+\\(AppData\\(Local|Roaming)|Desktop|Downloads)|ProgramData|Windows\\Temp|Temp)\\/ nocase

    // Match file extensions and naming patterns associated with encoded/encrypted payload staging:
    // .b64  - explicit Base64 staging files
    // .enc  - generic encrypted file convention
    // .dat  - generic data blob frequently used to hide payloads
    // .bin  - raw binary blobs used for shellcode staging
    // .pak  - packed/encrypted archive blobs
    // .tmp with encoded-looking names (long hex/base64 filenames)
    // .txt files with long random-looking names (encoded payloads stored as text)
    (
      $file.target.file.full_path = /(?i)\.(b64|enc|pak)$/ nocase
      or
      $file.target.file.full_path = /(?i)\\[A-Za-z0-9+\/]{20,}={0,2}\.(dat|bin|txt|tmp)$/ nocase
      or
      $file.target.file.full_path = /(?i)\\[0-9A-Fa-f]{32,}\.(dat|bin|tmp)$/ nocase
    )

    // Suspicious writing processes: script interpreters, Office apps, browsers, and download utilities
    // These are high-risk parents for encoded payload drops
    $file.principal.process.file.full_path = /(?i)\\(powershell|pwsh|wscript|cscript|mshta|certutil|bitsadmin|winword|excel|powerpnt|msaccess|outlook|msiexec|regsvr32|rundll32|wmic|curl|wget)\.exe$/ nocase

    // Exclude known-good administrative and backup tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($file.target.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
