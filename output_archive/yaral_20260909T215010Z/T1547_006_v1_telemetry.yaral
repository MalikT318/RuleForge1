/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:15:45.810045+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_Kernel_Module_File_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of a kernel module object file (.ko) outside of expected package-manager-managed paths, or within world-writable and temporary directories. Adversaries staging a malicious LKM will write the .ko artifact to disk before loading it; catching the file write provides coverage that survives command-line log evasion."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux EDR or auditd file-event telemetry normalised to Chronicle UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate kernel module compilation by developers (e.g., DKMS rebuilding drivers after a kernel update), custom out-of-tree driver packages installed by administrators. These typically write to /usr/src/ or /lib/modules/ and are spawned by package-manager processes."
    tuning_guidance = "Add known-good parent processes (e.g., dkms, make, dpkg, rpm) to %global_allowed_admin_tools. If a specific host runs frequent kernel builds, add it to %global_allowed_script_hosts. Narrow the path regex to exclude /lib/modules/<version>/kernel/ if package-manager writes are noisy."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a kernel module object file
    $file.target.file.full_path = /\.ko(\.xz|\.gz|\.zst)?$/ nocase

    // High-risk staging locations: temp dirs, home dirs, hidden dirs, /dev/shm, /var/tmp, /run
    // OR any path that is NOT under the canonical kernel module tree
    (
      $file.target.file.full_path = /(?i)^\/tmp\// or
      $file.target.file.full_path = /(?i)^\/var\/tmp\// or
      $file.target.file.full_path = /(?i)^\/dev\/shm\// or
      $file.target.file.full_path = /(?i)^\/run\// or
      $file.target.file.full_path = /(?i)^\/home\// or
      $file.target.file.full_path = /(?i)^\/root\// or
      $file.target.file.full_path = /(?i)\/\.[^\/]+\// or
      $file.target.file.full_path = /(?i)^\/opt\// or
      $file.target.file.full_path = /(?i)^\/usr\/local\/[^l]/ or
      $file.target.file.full_path = /(?i)^\/var\/www\//
    )

    // Exclude known-good parent processes (DKMS, package managers, kernel build tooling)
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude hosts designated as kernel build / development systems
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dropped_module    = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
