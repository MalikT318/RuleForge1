/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:09:42.210981+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_Cron_File_Artifact_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of cron-related paths on Linux, indicating a potential persistence mechanism. This rule targets the file-system artifact produced when an adversary installs a cron job, providing coverage orthogonal to process-creation/command-line rules. Monitored paths include system-wide cron directories, per-user crontab spools, and cron.d drop-in locations."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events. Auditd rules should watch -w /etc/cron* -p wa and -w /var/spool/cron -p wa."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate system administrators editing crontabs, configuration management tools (Ansible, Puppet, Chef), software package post-install scripts writing cron.d entries, backup agents scheduling jobs."
    tuning_guidance = "Add trusted automation and configuration-management process paths to %global_allowed_admin_tools. Add authorised service accounts that routinely write cron entries to %global_allowed_service_accounts. Scope by principal.hostname if specific hosts run scheduled deployment pipelines."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\/etc\/cron\.(d|daily|hourly|weekly|monthly|allow|deny)\/|\/etc\/crontab|\/var\/spool\/cron\/crontabs\/|\/var\/spool\/cron\/[^\/]+$)/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $cron_path_written = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
