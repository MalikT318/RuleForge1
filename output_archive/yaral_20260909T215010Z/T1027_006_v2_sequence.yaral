/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:58:32.176165+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_HTML_Smuggling_Suspicious_Download_Then_Exec {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects HTML Smuggling via network-observable behaviour: a browser or user-agent retrieves an HTML or JavaScript resource that returns a suspiciously large response (consistent with an embedded binary blob), followed within 5 minutes by an outbound connection from the same host to an external destination - suggesting the smuggled payload has been decoded and is now beaconing or staging. Covers the network-perimeter view of the attack chain without relying on endpoint process telemetry."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires firewall or proxy logs that record HTTP method, URI, response content-type, response bytes, and user-agent. Both events must be normalised to UDM NETWORK_HTTP or NETWORK_FLOW."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Large single-page applications (SPAs), legitimate software update portals serving large JS bundles, CDN-hosted web apps, online office suites. Tune by adding known-good domains to %global_allowed_domains and known-good source addresses to %global_allowed_scanners."
    tuning_guidance = "Lower the response-size threshold (currently 500 KB) if the environment has strict egress controls. Add internal proxy or jump-host IPs to %global_allowed_mgmt_sources to suppress scanner noise. Add trusted SaaS domains to %global_allowed_domains."

  events:
    // Event 1: Inbound HTTP response carrying a suspiciously large HTML/JS payload
    // (proxy or NGFW sees the server response with content-type text/html or
    //  text/javascript and a large body - hallmark of a blob-carrying smuggler page)
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.received_bytes > 512000
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    (
      $http.network.http.response_code = 200 or
      $http.network.http.response_code = 206
    )
    $http.target.url = /\.(html?|js|hta)(\?|$)/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %rfc1918_internal
    $http.principal.ip = $src_ip

    // Event 2: Subsequent outbound connection from the same source IP to an
    // external destination - consistent with a decoded payload phoning home
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src_ip

    // Enforce chronological ordering: large HTML/JS download precedes outbound connection
    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1027.006")
    $primary_entity      = array_distinct($src_ip)
    $smuggler_urls       = array_distinct($http.target.url)
    $smuggler_hosts      = array_distinct($http.target.hostname)
    $beacon_destinations = array_distinct($net.target.ip)
    $beacon_ports        = array_distinct($net.target.port)
    $max_response_bytes  = max($http.network.received_bytes)

  condition:
    $http and $net
}
