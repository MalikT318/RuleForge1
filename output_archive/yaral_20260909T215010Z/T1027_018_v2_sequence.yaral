/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:07:23.463794+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_InvisibleUnicode_ScriptFile_Then_ExternalBeacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage pattern associated with invisible Unicode abuse: a script or document file is written to disk (potentially containing hidden Unicode payloads), followed within 5 minutes by an outbound network connection from the same host to a non-RFC1918 destination. Firewall/proxy perimeter logs are used for the network leg, providing additive coverage beyond process command-line inspection."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires EDR/Sysmon FILE_CREATION telemetry for the first event and firewall or proxy perimeter logs (NETWORK_CONNECTION or NETWORK_FLOW) for the second event. Both must populate principal.hostname."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate Office macros or script-based automation that write temporary files and then call home for updates. Developer tooling (npm, pip, cargo) writing package manifests then fetching dependencies. Browser extensions writing local files before phoning home."
    tuning_guidance = "Add known-good script-writing processes to %global_allowed_script_hosts. Add approved external update/CDN destinations to %global_allowed_domains. Narrow the file extension regex if specific script types dominate false positives in the environment."

  events:
    // Leg 1: A script, document, or archive file is written to a user-accessible
    // or temp path on Windows. These are the file types most commonly used to
    // smuggle invisible Unicode payloads.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\.(ps1|vbs|js|hta|wsf|bat|cmd|docm|xlsm|pptm|html|htm|xml|json|txt|zip|7z|rar)$/
    $file.target.file.full_path = /(?i)(\\Users\\|\\Temp\\|\\AppData\\|\\Downloads\\|\\Desktop\\|\\Public\\)/
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    // Leg 2: Within the same time window, the same host makes an outbound
    // connection to a non-internal destination. Firewall/proxy telemetry only -
    // no process fields are referenced here.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.hostname = $hostname

    // Enforce chronological ordering: file write precedes the beacon.
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($hostname)
    $written_file_paths = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hostnames = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $file and $net
}
