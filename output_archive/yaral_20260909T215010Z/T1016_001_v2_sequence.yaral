/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:21:09.694149+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_ESXi_Shell_Login_Then_Network_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive shell login to an ESXi host followed by a network connectivity probe process within a short window. Adversaries who gain shell access to ESXi hosts frequently perform internet connectivity checks to validate C2 reachability before deploying payloads. This correlation joins a USER_LOGIN event (SSH or DCUI shell authentication) with a subsequent PROCESS_LAUNCH of a network probing utility, providing additive coverage beyond standalone command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires ESXi shell/hostd logs normalised to Chronicle UDM. USER_LOGIN events must be generated for SSH and DCUI sessions. PROCESS_LAUNCH events must be generated for ESXi shell process execution (hostd or shell audit logging enabled)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised ESXi administrators performing health checks, automated monitoring agents running connectivity tests, VMware lifecycle manager or vCenter orchestration tasks that probe network reachability."
    tuning_guidance = "Add known administrative service accounts to %global_allowed_service_accounts. Add approved management source IPs to %global_allowed_mgmt_sources. Narrow the probe process regex if specific utilities are approved in your environment."

  events:
    // Event 1: Interactive login to the ESXi shell (SSH or local DCUI)
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $esxi_host
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Event 2: Network probe process launched on the same ESXi host shortly after
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $esxi_host
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(ping|ping6|traceroute|traceroute6|nc|ncat|curl|wget|esxcli|vmkping)$/ nocase
    $proc.target.process.command_line = /(?i)(ping|traceroute|curl|wget|nc|vmkping|esxcli\s+network)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Chronological ordering: login must precede the probe
    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $esxi_host over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity = array_distinct($esxi_host)
    $actor_user = array_distinct($auth.principal.user.userid)
    $probe_commands = array_distinct($proc.target.process.command_line)
    $probe_binaries = array_distinct($proc.target.process.file.full_path)
    $login_source_ip = array_distinct($auth.principal.ip)

  condition:
    $auth and $proc
}
