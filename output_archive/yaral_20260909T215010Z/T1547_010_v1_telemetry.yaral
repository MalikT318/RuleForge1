/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:17:43.587487+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_Port_Monitor_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications to the Print Monitors key (HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors) that set or change a Driver value. Adversaries abuse this mechanism to load an arbitrary DLL via the print spooler service (spoolsv.exe) at SYSTEM privilege on next boot, achieving persistence and privilege escalation without spawning a suspicious process at install time."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION / REGISTRY_CREATION events. Sysmon Event ID 13 (RegistryEvent - Value Set) or equivalent EDR registry telemetry must be enabled and ingested."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver installation by vendor setup utilities (e.g., HP, Canon, Xerox installers), Windows Update applying print subsystem patches, enterprise print management software. These typically run from known installer paths and service accounts."
    tuning_guidance = "Add known-good printer driver installer paths to %global_allowed_admin_tools and known service accounts to %global_allowed_service_accounts. Consider narrowing on target.registry.registry_value_name = 'Driver' to reduce noise from benign subkey creation."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Print Monitors registry hive where port monitor DLL paths are registered
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors\\/  nocase

    // The Driver value is the specific entry that specifies the DLL to load;
    // also catch creation of new subkeys with any value that references a DLL
    (
      $reg.target.registry.registry_value_name = /^Driver$/  nocase
      or
      $reg.target.registry.registry_value_data = /\.dll$/  nocase
    )

    // Exclude modifications made by known-good administrative and print management tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service and automation accounts performing legitimate driver installs
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $modified_value_data = array_distinct($reg.target.registry.registry_value_data)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
