/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:59:58.410598+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_StrippedPayload_LoginThenLargeOutboundFlow {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a pattern consistent with exfiltration of a stripped/obfuscated payload from a network device: an authenticated management-plane login is followed within 5 minutes by an unusually large outbound flow to an external destination. Stripped payloads transferred over management channels are harder to inspect and may indicate adversarial staging or exfiltration activity."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Requires firewall/perimeter flow telemetry that captures bytes_out per flow and management-plane authentication events (e.g., SSH/HTTPS admin login syslog normalised to USER_LOGIN). Both event types must share a normalised principal.hostname or principal.ip."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Legitimate firmware upgrades, authorised configuration backups, bulk log exports, and scheduled SNMP/syslog transfers to internal collectors. Tune byte threshold and exclude known management sources."
    tuning_guidance = "Raise $large_flow_bytes threshold to reduce noise from authorised backup jobs. Add known management source IPs to %global_allowed_mgmt_sources. Add authorised remote management tools to %global_allowed_remote_mgmt. Narrow the destination port filter to ports actually observed in your environment."

  events:
    // Event 1: Management-plane login on the network device
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $device_hostname
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Event 2: Large outbound flow originating from the same device shortly after login
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $device_hostname
    not $flow.target.ip in %rfc1918_internal
    // Exclude known-good management and scanner sources on the target side
    not $flow.target.ip in %global_allowed_scanners
    // Require a substantial outbound byte count indicative of payload transfer (>= 500 KB)
    $flow.network.sent_bytes >= 512000
    // Focus on ports commonly used for management-plane or covert transfers
    $flow.target.port = /^(22|443|8443|8080|21|69|20|2222|4443)$/

    // Chronological ordering: login must precede the large flow
    $auth.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 5m

  outcome:
    $risk_score          = max(78)
    $mitre_technique_id  = array_distinct("T1027.008")
    $primary_entity      = array_distinct($device_hostname)
    $auth_user           = array_distinct($auth.principal.user.userid)
    $auth_src_ip         = array_distinct($auth.principal.ip)
    $flow_dest_ip        = array_distinct($flow.target.ip)
    $flow_dest_port      = array_distinct($flow.target.port)
    $max_bytes_sent      = max($flow.network.sent_bytes)
    $flow_count          = count($flow.target.ip)

  condition:
    $auth and $flow
}
