/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:54:48.221119+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Large_Executable_Written_To_Suspicious_Path {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation or modification of an unusually large file with executable characteristics written to world-writable or staging directories on Linux. Binary padding inflates file size to evade hash-based detection and bypass file-size limits on scanning services. This rule pivots on the resulting file artifact rather than the command line used to produce it, providing coverage orthogonal to process-creation rules."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates target.file.full_path, target.file.size, and target.file.mime_type (or equivalent) on FILE_CREATION and FILE_MODIFICATION events."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate large application bundles, container image layers, database dump files, or backup archives written to /tmp or /var/tmp by deployment pipelines. Java JARs, Python wheels, and AppImage bundles can also be large and land in staging directories."
    tuning_guidance = "Add known-good parent processes (package managers, CI agents, backup tools) to %global_allowed_backup_processes or %global_allowed_admin_tools. Raise the size threshold if the environment routinely deploys large legitimate binaries to these paths. Scope the path regex more narrowly if /var/tmp is heavily used by authorised tooling."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must reside in a world-writable, staging, or developer-writable
    // directory commonly abused for staging padded payloads on Linux.
    // /tmp, /var/tmp, /dev/shm, /run/shm, /var/run, home-relative hidden dirs,
    // and /opt subdirectories that are not standard package-managed paths.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/var\/run\/|\/home\/[^\/]+\/\.[^\/]+\/|\/opt\/[^\/]+\/tmp\/)/ nocase

    // File must have an ELF-like name pattern OR no extension at all
    // (padded binaries are often dropped without a recognisable extension).
    // Exclude clearly non-executable extensions to reduce noise.
    not $file.target.file.full_path = /\.(log|txt|json|xml|csv|gz|tar|zip|bz2|xz|deb|rpm|py|sh|conf|cfg|sql|dump)$/ nocase

    // Size threshold: files larger than 50 MB in these paths are anomalous
    // for genuine executables; padding routinely pushes binaries past this mark.
    // target.file.size is in bytes; 50 MB = 52428800 bytes.
    $file.target.file.size > 52428800

    // Exclude known-good parent processes (package managers, backup agents,
    // deployment tooling) that legitimately write large files to staging paths.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_path      = array_distinct($file.target.file.full_path)
    $file_size_bytes   = max($file.target.file.size)
    $writing_process   = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
