/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:23:34.230683+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_ESXi_Login_Then_Account_Enum {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects an interactive or SSH login to an ESXi host followed by rapid enumeration of local accounts or roles via the ESXi shell. The sequence — authentication success then account-listing activity — is a strong indicator of post-compromise discovery on the hypervisor management plane. This rule provides additive coverage beyond command-line process-launch detections by correlating the authentication event with subsequent shell-based account enumeration."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Requires ESXi hostd/shell UDM telemetry normalised into Chronicle. USER_LOGIN events must be emitted on SSH or DCUI authentication. PROCESS_LAUNCH events must be emitted for ESXi shell commands (esxcli, vim-cmd, localcli, cat /etc/passwd). Ensure the VMware ESXi log forwarder is configured to ship both hostd and shell logs."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised ESXi administrators performing routine health checks or audits. Automated configuration management tools (Ansible, vSphere automation scripts) that authenticate and then inspect host configuration. Monitoring agents that log in and query host state."
    tuning_guidance = "Add known administrative service accounts to %global_allowed_service_accounts. Add approved management source IPs to %global_allowed_mgmt_sources. Raise the threshold or extend the time window if legitimate automation triggers this rule frequently."

  events:
    // Event 1: Successful interactive or SSH login to the ESXi host
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $esxi_host
    $auth.target.user.userid != ""
    $auth.target.user.userid = $userid
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Event 2: Account enumeration via ESXi shell utilities or system files
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $esxi_host
    $proc.principal.user.userid = $userid
    (
      $proc.target.process.file.full_path = /\/(esxcli|vim-cmd|localcli|esxcfg-auth|esxcfg-advcfg)$/ nocase
      or
      $proc.target.process.command_line = /\/etc\/(passwd|shadow|group)/ nocase
      or
      $proc.target.process.command_line = /(?i)(esxcli\s+system\s+account|esxcli\s+system\s+permission|vim-cmd\s+vimsvc\/auth|localcli\s+system\s+account)/
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Chronological ordering: login must precede enumeration
    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $esxi_host, $userid over 10m

  outcome:
    $risk_score          = max(75)
    $mitre_technique_id  = array_distinct("T1087")
    $primary_entity      = array_distinct($esxi_host)
    $enumeration_commands = array_distinct($proc.target.process.command_line)
    $source_ips          = array_distinct($auth.principal.ip)
    $login_count         = count($auth.metadata.event_timestamp.seconds)
    $enum_event_count    = count($proc.metadata.event_timestamp.seconds)

  condition:
    $auth and $proc
}
