/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:13:03.137592+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_RunKey_Write_Then_Logon_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a registry run key modification followed by a user logon on the same host within 10 minutes. This sequence indicates a persistence mechanism was written and then triggered at logon, covering the full persistence lifecycle rather than just the write event."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION) and Windows Security logon events (USER_LOGIN) normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that write run keys and immediately trigger a logon (e.g., reboot-less install flows), RMM agents that persist via run keys, legitimate software update mechanisms."
    tuning_guidance = "Add known-good installer and RMM parent processes to %global_allowed_admin_tools. Add authorised service accounts that write run keys to %global_allowed_service_accounts."

  events:
    // Event 1: Registry run key or startup folder modification
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run(Once(Ex)?)?$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: Interactive or network logon on the same host shortly after
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: run key written before or at logon
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1547.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $run_key_path = array_distinct($reg.target.registry.registry_key)
    $run_key_value = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $writing_user = array_distinct($reg.principal.user.userid)
    $logon_user = array_distinct($auth.principal.user.userid)

  condition:
    $reg and $auth
}
