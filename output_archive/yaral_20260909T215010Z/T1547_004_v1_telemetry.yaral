/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:14:33.854707+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Helper_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Winlogon helper registry keys (Userinit, Shell, Notify) under HKLM or HKCU. Adversaries abuse these keys to load malicious DLLs or executables at logon, achieving persistence and potential privilege escalation. This rule fires on the registry state change itself, providing coverage orthogonal to process-creation detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION events. Sysmon Event ID 13 or equivalent EDR registry write events must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows in-place upgrades or feature updates may rewrite Userinit and Shell values. Legitimate security software or credential providers may register Notify packages. Group Policy application may touch these keys during domain join or policy refresh."
    tuning_guidance = "Add known-good parent process paths (e.g., TrustedInstaller, msiexec) to %global_allowed_admin_tools. If specific service accounts perform authorised modifications, add them to %global_allowed_service_accounts. Scope the Shell value exclusion to environments where custom shells are deployed."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Winlogon key under both HKLM and HKCU, including Wow6432Node variant
    $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Windows NT\\CurrentVersion\\Winlogon/

    //(?i) Match the specific value names known to be abused for DLL/executable injection
    (
      $reg.target.registry.registry_value_name = /(?i)^Userinit$/ or
      $reg.target.registry.registry_value_name = /(?i)^Shell$/ or
      $reg.target.registry.registry_value_name = /(?i)^Notify$/
    )

    // Exclude modifications made by known administrative tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    //(?i) Exclude known service/automation accounts performing authorised changes
    not $reg.principal.user.userid in %global_allowed_service_accounts

    // Flag modifications where the new value deviates from the canonical defaults:
    // Userinit default: userinit.exe (optionally with trailing comma)
    // Shell default: explorer.exe
    // Any Notify subkey value is suspicious unless from a known security tool
    not $reg.target.registry.registry_value_data = /(?i)^C:\\Windows\\system32\\userinit\.exe,?$/
    not $reg.target.registry.registry_value_data = /(?i)^explorer\.exe$/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $new_value_data = array_distinct($reg.target.registry.registry_value_data)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
