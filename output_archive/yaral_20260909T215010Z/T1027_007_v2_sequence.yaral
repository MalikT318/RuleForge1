/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:59:15.970341+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_DynAPI_SuspProc_Then_SensitiveDllLoad {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a suspicious unsigned or unusual process that launches and subsequently loads a sensitive Windows API DLL (ntdll, kernel32, kernelbase) via a module-load event. Dynamic API resolution malware commonly resolves exports from these DLLs at runtime by walking the PEB loader list, producing a characteristic pattern of an anomalous process followed by DLL load telemetry for core NT libraries. This is variant 2 of 2 for T1027.007 and provides coverage additive to command-line-based detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires EDR or Sysmon ImageLoad (Event ID 7) telemetry normalised to PROCESS_MODULE_LOAD in UDM, plus PROCESS_LAUNCH telemetry. Sysmon must have ImageLoad logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate .NET runtimes, JIT compilers, and scripting engines (node, python) that reflectively load core DLLs. Security tooling and AV engines performing in-memory scanning. Custom application loaders in enterprise software."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow the spawning-process regex to exclude your software deployment toolchain. Raise severity if the spawning process resides under a user-writable path such as AppData or Temp."

  events:
    // Event 1: A process launches from a suspicious or user-writable location.
    // Targets processes spawned from temp/appdata/downloads paths - common staging
    // areas for malware performing dynamic API resolution.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)(\\AppData\\|\\Temp\\|\\ProgramData\\|\\Users\\Public\\|\\Downloads\\)/ 
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.target.process.pid = $target_pid

    // Event 2: The same host subsequently generates a module-load event for a
    // core Windows API DLL. Malware using dynamic API resolution must load
    // ntdll/kernel32/kernelbase to walk exports and resolve function addresses.
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.principal.hostname = $hostname
    $mod.target.process.pid = $target_pid
    $mod.target.file.full_path = /(?i)\\(ntdll|kernel32|kernelbase|advapi32|user32)\.dll$/
    // Exclude loads originating from known-good system paths for the loading process
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools

    // Enforce chronological ordering: process must launch before the DLL load
    $proc.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname, $target_pid over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $suspicious_process_path = array_distinct($proc.target.process.file.full_path)
    $loaded_dlls = array_distinct($mod.target.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $event_count = count($mod.metadata.event_timestamp.seconds)

  condition:
    $proc and $mod
}
