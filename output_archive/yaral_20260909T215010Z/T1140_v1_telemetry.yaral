/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:07:44.456213+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_001_Decoded_Executable_Dropped_To_Disk {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the artifact of a deobfuscation/decoding operation: a PE-format executable or script file written to a suspicious staging location on disk. Attackers using certutil, PowerShell, or custom malware to decode hidden payloads must ultimately write the decoded artifact somewhere. This rule pivots on the resulting FILE_CREATION event rather than the command line, providing coverage when process telemetry is absent or tampered with."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events with target.file.full_path and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers unpacking to TEMP; developer toolchains writing build artifacts; update agents staging patches; backup/restore operations."
    tuning_guidance = "Add known-good installer and update parent processes to %global_allowed_admin_tools. Add known-good staging directories by extending the path exclusion regex. Raise severity if the writing process is also a script interpreter."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File lands in a high-risk staging or user-writable location
    // Covers: %TEMP%, %APPDATA%, %LOCALAPPDATA%, ProgramData, Public, Downloads, and root of C:\
    $file.target.file.full_path = /(?i)\\(windows\\temp|users\\[^\\]+\\appdata\\(local\\temp|roaming|local)|programdata|users\\public|users\\[^\\]+\\downloads|[A-Za-z]:\\[^\\]+\.(exe|dll|ps1|vbs|js|hta|bat|cmd|scr|cpl|msi|jar|py))/ nocase

    // File extension is an executable, script, or loader type
    $file.target.file.full_path = /(?i)\.(exe|dll|ps1|vbs|js|hta|bat|cmd|scr|cpl|msi|jar|py)$/

    // Written by a process that is a known decoder/interpreter or generic host
    // certutil, expand, extrac32, makecab, wscript, cscript, mshta, powershell, pwsh, cmd, explorer, rundll32, regsvr32, msiexec, wmic, bitsadmin
    $file.principal.process.file.full_path = /(?i)\\(certutil|expand|extrac32|makecab|wscript|cscript|mshta|powershell|pwsh|cmd|explorer|rundll32|regsvr32|msiexec|wmic|bitsadmin)\.exe$/

    // Exclude approved administrative and backup tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($file.target.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
