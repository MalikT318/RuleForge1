/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:14:13.677005+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_Time_Provider_DLL_Registration_And_Service_Restart {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation or modification of a W32Time time provider registry key followed by W32Time service restart, indicating potential time provider persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires Windows endpoint telemetry with registry modification and process launch events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate time synchronization software installation, NTP configuration changes by administrators, domain controller time service updates."
    tuning_guidance = "Add approved time provider DLL paths to %global_allowed_admin_tools and service accounts performing time configuration to %global_allowed_service_accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\system\\currentcontrolset\\services\\w32time\\timeproviders\\/ nocase
    (
      $reg.target.registry.registry_value_name = /dllname/ nocase or
      $reg.target.registry.registry_value_name = /enabled/ nocase
    )
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\net\.exe$/ nocase and
        $proc.target.process.command_line = /(?i)w32time/ and
        (
          $proc.target.process.command_line = /(?i)start/ or
          $proc.target.process.command_line = /(?i)stop/ or
          $proc.target.process.command_line = /(?i)restart/
        )
      ) or
      (
        $proc.target.process.file.full_path = /\\sc\.exe$/ nocase and
        $proc.target.process.command_line = /(?i)w32time/ and
        (
          $proc.target.process.command_line = /(?i)start/ or
          $proc.target.process.command_line = /(?i)stop/ or
          $proc.target.process.command_line = /(?i)config/
        )
      ) or
      (
        $proc.target.process.file.full_path = /\\powershell\.exe$/ nocase and
        (
          $proc.target.process.command_line = /(?i)restart-service.*w32time/ or
          $proc.target.process.command_line = /(?i)start-service.*w32time/ or
          $proc.target.process.command_line = /(?i)stop-service.*w32time/
        )
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys_modified = array_distinct($reg.target.registry.registry_key)
    $registry_values_modified = array_distinct($reg.target.registry.registry_value_name)
    $service_restart_commands = array_distinct($proc.target.process.command_line)
    $modifying_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $proc
}
