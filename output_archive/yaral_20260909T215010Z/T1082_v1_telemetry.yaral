/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:22:32.452692+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_001_IaaS_System_Info_Discovery_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects authenticated cloud API calls that enumerate instance or virtual machine metadata, system configuration, and platform details. Adversaries performing IaaS-based system information discovery issue describe/get/list API calls against compute resources to gather OS version, hardware, patch level, and architecture details before follow-on exploitation. This rule fires on the resulting audit log entry rather than any command-line invocation, providing coverage that is orthogonal to process-creation detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). The metadata.event_type must be USER_RESOURCE_ACCESS and target.resource.name or target.application must reflect compute/instance API operations."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate infrastructure automation, configuration management tools (Ansible, Terraform), cloud-native monitoring agents, and DevOps pipelines that routinely describe compute instances. Security scanners listed in %global_allowed_scanners will also trigger this rule."
    tuning_guidance = "Add authorised automation service principals to %global_allowed_service_accounts. Add approved scanner identities to %global_allowed_scanners. Add approved cloud principals (CI/CD, monitoring) to %global_allowed_cloud_principals. Narrow the rule by adding a threshold on distinct resource types queried per identity within a short window if volume is high."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match API method names that enumerate instance/VM system information.
    // Covers AWS (DescribeInstances, DescribeInstanceAttribute, DescribeImages,
    // GetConsoleOutput, DescribeInstanceTypes), Azure (virtualMachines/read,
    // virtualMachines/instanceView/read), and GCP (instances.get, instances.list,
    // machineTypes.list) as normalised into target.resource.attribute.labels or
    // network.http.method / target.application by Chronicle UDM parsers.
    (
      $cloud.target.resource.name = /(?i)(describeinstances|describeinstanceattribute|describeinstancetypes|describeimagebuilderversionedcontainerrecipe|getinstancemetadata|getconsoleoutput|describehosts|describeplatformversions)/ nocase
      or
      $cloud.target.resource.name = /(?i)(virtualmachines\/read|virtualmachines\/instanceview|virtualmachines\/extensions\/read|computervision|subscriptions.*\/providers\/microsoft\.compute)/ nocase
      or
      $cloud.target.resource.name = /(?i)(instances\.get|instances\.list|machinetypes\.list|machinetypes\.get|zones\.list|projects\.get|osconfig\.inventories\.get|osconfig\.inventories\.list)/ nocase
      or
      $cloud.target.application = /(?i)(describeinstances|describeinstanceattribute|describeinstancetypes|getconsoleoutput|instances\.get|instances\.list|machinetypes|instanceview|osconfig\.inventories)/ nocase
    )

    // Exclude known-good automation and scanner identities.
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
