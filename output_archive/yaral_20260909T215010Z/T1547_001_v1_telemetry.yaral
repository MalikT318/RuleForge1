/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:12:46.257801+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_RunKey_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects direct registry state changes to Windows Run/RunOnce/RunOnceEx keys used for persistence. This rule pivots on the resulting registry artifact rather than the process command line, providing coverage against attackers who evade command-line logging via direct API calls, WMI, or reflective techniques."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION events. Sysmon Event ID 12/13/14 or equivalent EDR registry events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers adding legitimate autostart entries, RMM agents, endpoint security products, and IT deployment tooling. Approved admin tools should be added to %global_allowed_admin_tools."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools. Consider scoping to non-SYSTEM writers if SYSTEM-context noise is high. Exclude known software installer paths by extending the reference list."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the canonical Run/RunOnce/RunOnceEx key paths under both HKLM and HKCU
    // Covers: Run, RunOnce, RunOnceEx (including Depend sub-keys), and Wow6432Node variants
    $reg.target.registry.registry_key = /\\Software\\(Wow6432Node\\)?Microsoft\\Windows\\CurrentVersion\\Run(Once(Ex)?)?(\\|$)/ nocase

    // Exclude writes to the key itself with no value (structural key creation noise)
    // Require that a value name is present, indicating an actual autostart entry is being set
    $reg.target.registry.registry_value_name != ""

    // Exclude known-good administrative and deployment tooling by parent process path
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved service accounts performing expected privileged operations
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1547.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $actor_userid = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
