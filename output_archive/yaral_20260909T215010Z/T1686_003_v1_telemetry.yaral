/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:52:30.503185+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Registry_State_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications to Windows Firewall profile state keys that indicate a firewall profile (Domain, Private, or Public) has been disabled or its policy altered. Attackers modify these keys directly to suppress firewall enforcement without invoking command-line utilities, bypassing process-creation detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Windows Host Firewall"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 13 or equivalent) normalised to UDM REGISTRY_MODIFICATION. Registry auditing must be enabled for HKLM\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy application of firewall settings by domain controllers, approved endpoint management agents, security baseline enforcement tools, and some AV/EDR products that manage firewall rules programmatically."
    tuning_guidance = "Add known management and GPO-applying processes (e.g., svchost.exe under SYSTEM applying GPO) to %global_allowed_admin_tools. Scope exclusions to the specific principal process path rather than the registry key to preserve detection coverage."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Windows Firewall policy registry hive for all three profiles
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy\\(DomainProfile|StandardProfile|PublicProfile)$/

    //(?i) Match value names that control firewall enablement or default inbound/outbound policy
    (
      $reg.target.registry.registry_value_name = /(?i)^EnableFirewall$/ or
      $reg.target.registry.registry_value_name = /(?i)^DefaultInboundAction$/ or
      $reg.target.registry.registry_value_name = /(?i)^DefaultOutboundAction$/ or
      $reg.target.registry.registry_value_name = /(?i)^DisableNotifications$/ or
      $reg.target.registry.registry_value_name = /(?i)^DoNotAllowExceptions$/
    )

    // Exclude approved administrative and management tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known security tooling that legitimately manages firewall state
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
