/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:17:07.578291+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_LNK_File_Created_In_Startup_Path {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of a .lnk shortcut file inside a Windows startup folder (per-user or all-users). Adversaries plant malicious shortcuts in these locations to achieve persistence at user login or system boot without requiring command-line activity that is easily logged and blocked."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires EDR or Sysmon file-creation/modification telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION. Sysmon Event ID 11 (FileCreate) or equivalent EDR file-write events must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers that place shortcuts in the startup folder (e.g. collaboration tools, VPN clients, accessibility software). Managed deployment tools (SCCM, Intune, PDQ) may also write startup shortcuts during provisioning."
    tuning_guidance = "Add known-good parent process paths (installer engines, deployment agents) to %global_allowed_admin_tools. Add authorised service accounts that perform software deployment to %global_allowed_service_accounts. Consider scoping to non-business hours or correlating with unusual parent processes to reduce installer noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a .lnk file
    $file.target.file.full_path = /\.lnk$/  nocase

    // File must reside inside a startup folder:
    //   - Per-user:   C:\Users\<any>\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\
    //   - All-users:  C:\ProgramData\Microsoft\Windows\Start Menu\Programs\StartUp\
    $file.target.file.full_path = /(?i)\\(Users\\[^\\]+\\AppData\\Roaming|ProgramData)\\Microsoft\\Windows\\Start Menu\\Programs\\Start[Uu]p\\/

    // Exclude known-good deployment and admin tooling by parent process
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service/automation accounts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity    = array_distinct($file.principal.hostname)
    $lnk_path          = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
