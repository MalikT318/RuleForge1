/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:53:22.736676+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_002_IaaS_Security_Policy_Disable_Then_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a sequence where a cloud identity principal first accesses or modifies a security policy or conditional access resource (potential exploitation of a defensive control) and then immediately escalates or modifies permissions — a pattern consistent with exploiting identity-plane defenses to impair detection and enforcement boundaries."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM. Events must include USER_RESOURCE_ACCESS for security/policy resource reads and USER_CHANGE_PERMISSIONS for subsequent privilege changes. Tested against Entra ID and Okta audit log feeds."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate security administrators performing planned policy reviews followed by role assignments. Automated provisioning pipelines that read policy state before granting access. Break-glass account usage during incidents."
    tuning_guidance = "Add known automation service principals to %global_allowed_cloud_principals. Add known admin accounts performing scheduled reviews to %global_allowed_admin_users. Narrow the match window below 10m if the environment has high-frequency legitimate provisioning."

  events:
    // Event 1: Principal accesses a security/conditional-access/policy resource
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.resource.name = /(?i)(conditional.?access|security.?policy|mfa.?policy|authentication.?policy|identity.?protection|access.?policy|compliance.?policy|defender.?policy|threat.?protection|security.?default)/
    not $access.principal.user.userid in %global_allowed_cloud_principals
    not $access.principal.user.userid in %global_allowed_admin_users
    $access.principal.user.userid = $actor

    // Event 2: Same principal modifies permissions shortly after
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.principal.user.userid in %global_allowed_admin_users
    $perm.principal.user.userid = $actor

    // Chronological ordering: policy access precedes permission change
    $access.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($access.principal.user.userid)
    $accessed_policy_resources = array_distinct($access.target.resource.name)
    $permission_targets = array_distinct($perm.target.user.userid)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $access and $perm
}
