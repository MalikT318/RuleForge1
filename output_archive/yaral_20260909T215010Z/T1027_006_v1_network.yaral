/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:58:09.538070+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_HTML_Smuggling_Network_HTTP_Delivery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential HTML smuggling delivery via network/proxy telemetry. HTML smuggling abuses JavaScript Blobs, Data URLs, and HTML5 download attributes to embed and reconstruct malicious payloads inside HTML or JS responses. This rule flags HTTP responses where the declared content-type is text/html or text/javascript but the response body size is unusually large, or where the URL or referrer patterns suggest inline data delivery. Covers the network-observable delivery phase not addressed by endpoint process-creation rules."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires proxy or next-generation firewall logs normalised to UDM NETWORK_HTTP events, including network.http.response_code, network.http.user_agent, target.url, network.received_bytes, and network.http.response_headers fields."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Large single-page applications (SPAs), CDN-delivered JavaScript bundles, legitimate file-download portals, web-based email clients rendering large HTML attachments, video streaming sites embedding large blobs."
    tuning_guidance = "Add known-good CDN and SaaS domains to %global_allowed_domains. Raise the received_bytes threshold if SPA traffic from approved vendors triggers the rule. Scope to specific user segments or network zones if broad deployment causes noise."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"

    // Response must be a successful delivery (2xx range covers 200-299)
    $http.network.http.response_code >= 200
    $http.network.http.response_code <= 299

    // Content-type is text/html or text/javascript - the MIME types abused by HTML smuggling
    // Attackers serve malicious blobs inside these benign-looking types to bypass content filters
    $http.network.http.response_content_type = /(?i)(text\/(html|javascript|plain)|application\/(javascript|x-javascript|octet-stream))/ nocase

    // Large response body is a strong indicator: legitimate HTML pages rarely exceed 5 MB;
    // smuggled payloads embedded as base64 blobs or Data URLs inflate response size significantly
    $http.network.received_bytes > 5000000

    // Exclude destinations known to legitimately serve large HTML/JS (CDNs, approved SaaS)
    not $http.target.hostname in %global_allowed_domains

    // Exclude internal destinations - HTML smuggling is an inbound/external delivery technique
    not $http.target.ip in %rfc1918_internal

    // Exclude approved scanners performing content inspection
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_host = array_distinct($http.target.hostname)
    $destination_url = array_distinct($http.target.url)
    $response_bytes = max($http.network.received_bytes)
    $content_type = array_distinct($http.network.http.response_content_type)
    $http_response_code = max($http.network.http.response_code)

  condition:
    $http
}
