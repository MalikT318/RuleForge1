/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:19:54.393481+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_ActiveSetup_Registry_Then_UserLogin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects Active Setup persistence: a new or modified StubPath value written under HKLM\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\ followed by a user login on the same host within 10 minutes. The sequence indicates an adversary planted a malicious StubPath that will execute under the next logged-in user's context."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_CREATION or REGISTRY_MODIFICATION on HKLM Active Setup keys) and Windows Security Event 4624 or equivalent user login telemetry normalised to USER_LOGIN."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers (Office, .NET, IE components) that write Active Setup keys during installation followed immediately by a user login. Software deployment tools (SCCM, Intune) may also trigger this pattern during provisioning."
    tuning_guidance = "Add known-good installer service accounts to %global_allowed_service_accounts. Add approved deployment tool process paths to %global_allowed_admin_tools. Consider raising the threshold or narrowing to non-SYSTEM user logins if noise is high in software-heavy environments."

  events:
    // Event 1: Registry write to Active Setup StubPath
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\/
    $reg.target.registry.registry_value_name = /(?i)StubPath/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: A user logs in on the same host shortly after
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: registry write precedes login
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $writing_user = array_distinct($reg.principal.user.userid)
    $login_user = array_distinct($auth.principal.user.userid)
    $login_count = count($auth.metadata.event_timestamp.seconds)

  condition:
    $reg and $auth
}
