/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:18:05.012325+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_PortMonitor_Registry_Then_DLL_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the two-stage port monitor persistence technique: a new subkey is written under the Print Monitors registry path, followed by a DLL being created in System32 on the same host within 10 minutes. The print spooler loads the registered DLL at SYSTEM privilege on next boot. This rule is additive to process-launch detections and focuses on the registry + file-drop artefacts."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires EDR or Sysmon registry-modification telemetry (Event ID 13/12) and file-creation telemetry (Event ID 11) normalised to UDM REGISTRY_MODIFICATION and FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver installations (e.g., HP Universal Print Driver, Xerox, Canon) that register a custom port monitor and drop a DLL into System32. Software deployment tools (SCCM, Intune) pushing print drivers may also trigger this."
    tuning_guidance = "Add known-good printer driver installer processes to %global_allowed_admin_tools. Add authorised software deployment service accounts to %global_allowed_service_accounts. If specific monitor subkey names are known-good, add them to %global_allowed_admin_tools as a proxy exclusion on the principal process."

  events:
    // Event 1: Registry modification creating or updating a Driver value under the Print Monitors path
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors\\/  nocase
    $reg.target.registry.registry_value_name = /^Driver$/  nocase
    // The Driver value should point to a DLL
    $reg.target.registry.registry_value_data = /\.dll$/  nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: A DLL file is created inside System32 (where spoolsv.exe will load it)
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\[^\\]+\.dll$/
    // Exclude well-known system processes that legitimately drop DLLs into System32
    not $file.principal.process.file.full_path = /(?i)\\Windows\\(System32|SysWOW64)\\(msiexec|TrustedInstaller|wusa|dism)\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Chronological ordering: registry write happens before or at the same time as the DLL drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $monitor_registry_key = array_distinct($reg.target.registry.registry_key)
    $monitor_driver_value = array_distinct($reg.target.registry.registry_value_data)
    $dropped_dll_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $dropping_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $file
}
