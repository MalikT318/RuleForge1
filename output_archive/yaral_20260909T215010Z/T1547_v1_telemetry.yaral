/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Network Devices
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:12:06.895471+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_Network_Device_Autostart_Config_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of boot or startup configuration on network devices via management-plane telemetry. Adversaries may alter startup-config, boot statements, or autostart references (e.g., Cisco IOS 'boot system', 'ip http server' persistence hooks, or equivalent on other NOS platforms) to survive reboots and maintain persistence. This rule targets the resulting SETTING_MODIFICATION event rather than the CLI command that produced it, providing coverage at a layer that is harder to suppress than command-line logging."
    mitre_tactic         = "Persistence, Privilege Escalation"
    mitre_technique      = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites    = "Requires network device management-plane syslog or SNMP trap events normalised to Chronicle UDM SETTING_MODIFICATION. Cisco IOS/NX-OS, Juniper Junos, Arista EOS, and Palo Alto PAN-OS all emit configuration-change syslog messages that Chronicle parsers map to this event type. Ensure AAA accounting or equivalent is enabled so that config writes are logged with the originating user."
    platform             = "Network Devices"
    log_source           = "macos_endpoint"
    false_positives      = "Authorised network engineers performing scheduled maintenance, automated configuration management tools (Ansible, Terraform, NAPALM), and change-window deployments. Backup/restore operations may also trigger this pattern."
    tuning_guidance      = "Add approved automation service accounts to %global_allowed_service_accounts. Add approved management source addresses to %global_allowed_mgmt_sources. Narrow the target.resource.name regex to the specific configuration sections relevant to your environment (e.g., exclude 'ntp' or 'snmp' sections if those are routinely modified by automation)."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Match configuration sections associated with boot/autostart persistence:
    // startup-config writes, boot system statements, autorun/kron job definitions,
    // EEM (Embedded Event Manager) applets, and equivalent constructs across NOS vendors.
    $cfg.target.resource.name = /(?i)(startup[\-_]config|boot[\-_]system|boot[\-_]image|autorun|kron|eem[\-_]applet|event[\-_]manager|rc\.local|init[\-_]script|autostart|persistent[\-_]config|nvram|flash[\-_]config)/

    // Restrict to management-plane sources; exclude known-good automation accounts
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved management source addresses (jump hosts, NMS, TACACS proxies)
    not $cfg.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity    = array_distinct($cfg.principal.hostname)
    $modified_setting  = array_distinct($cfg.target.resource.name)
    $actor_user        = array_distinct($cfg.principal.user.userid)
    $source_ip         = array_distinct($cfg.principal.ip)

  condition:
    $cfg
}
