/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:05:32.559621+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_Junk_Code_Insertion_Suspicious_Executable_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of executable files in world-writable or staging directories on Linux, which is a common artifact of junk-code-obfuscated malware being dropped to disk. Junk code insertion is used to evade static analysis; the resulting binary still must be written to the filesystem before execution. This rule pivots on the file artifact rather than process command-line arguments to provide additive coverage beyond process-creation detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers (apt, yum, rpm, dpkg) writing binaries to /tmp during install; build systems (make, cmake, gcc) compiling to staging directories; container runtimes extracting layers; legitimate software updaters writing to /var/tmp."
    tuning_guidance = "Add known build and package management processes to %global_allowed_admin_tools. Narrow the path regex to exclude specific subdirectories used by approved build pipelines. Consider raising severity if the writing process is itself running from a suspicious path."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file lands in a world-writable, staging, or runtime-writable directory
    // commonly abused to stage obfuscated payloads on Linux
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/|\/run\/shm\/|\/proc\/[0-9]+\/fd\/)/ nocase

    // The written file has an ELF-style name or no extension (common for compiled payloads)
    // OR has a shell-script extension that could wrap obfuscated code
    // We match files that do NOT look like ordinary data/log/config artifacts
    $file.target.file.full_path = /\/([\w\-\.]{4,})(\.elf|\.so|\.bin|\.out|\.sh|\.py|\.pl|\.rb|\.run|\.x86_64|\.amd64|\.arm|\.aarch64)?$/ nocase

    // The writing process is NOT a known package manager or system installer
    // (belt-and-suspenders before the reference list exclusion)
    not $file.principal.process.file.full_path = /\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper|snap|flatpak|pip[23]?|cargo|go|make|cmake|ninja|gradle|mvn|bazel|gcc|g\+\+|clang|ld|install|update-alternatives)$/ nocase

    // Exclude processes that are part of approved administrative tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude backup processes that may stage files in temp locations
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // The writing process itself originates from a suspicious or non-standard location,
    // OR is a scripting interpreter (which may be executing obfuscated dropper code)
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|node|php|curl|wget|nc|ncat|socat|busybox|xterm|python3\.[0-9]+)$/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $target_file_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
