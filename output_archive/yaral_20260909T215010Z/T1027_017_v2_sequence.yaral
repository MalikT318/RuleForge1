/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:06:34.585600+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Smuggling_Network_Then_File {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects SVG smuggling via network: an external HTTP response delivering an SVG file is followed by a file creation event in a world-writable or user-writable staging directory on the same Linux host within 5 minutes. SVG files served over HTTP that land in /tmp, /var/tmp, /dev/shm, or user download paths are a strong indicator of payload delivery via SVG smuggling."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires firewall or proxy HTTP logs normalised to UDM NETWORK_HTTP (with network.http.response_code, target.file.full_path or network.http.response_body_bytes, and principal.hostname populated). Requires Linux EDR or auditd FILE_CREATION events with target.file.full_path. Both log sources must share a common principal.hostname value."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate SVG asset downloads by browsers or design tools landing in user Downloads directories; CI/CD pipelines fetching SVG resources; web scraping jobs; package managers downloading SVG icons."
    tuning_guidance = "Add known-good SVG-serving domains to %global_allowed_domains. Add approved automation accounts to %global_allowed_service_accounts. Narrow the file path regex if /tmp writes from browsers are expected in your environment."

  events:
    // Event 1: External HTTP response delivering an SVG file observed at the firewall/proxy
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    (
      $net.target.url = /\.svg(\?[^\s]*)?$/ nocase or
      $net.network.http.response_body_bytes > 0 and
      $net.target.url = /\.svg/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    // Event 2: SVG file created in a staging or world-writable directory on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/|\/home\/[^\/]+\/(Downloads|\.cache|\.config|tmp)\/)[^\s]+\.svg$/
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Chronological ordering: network delivery precedes file creation
    $net.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(78)
    $mitre_technique_id  = array_distinct("T1027.017")
    $primary_entity      = array_distinct($hostname)
    $svg_urls            = array_distinct($net.target.url)
    $svg_files_created   = array_distinct($file.target.file.full_path)
    $external_ips        = array_distinct($net.target.ip)
    $initiating_user     = array_distinct($file.principal.user.userid)

  condition:
    $net and $file
}
