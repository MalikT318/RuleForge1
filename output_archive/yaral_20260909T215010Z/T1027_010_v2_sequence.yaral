/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:01:32.436159+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Obfuscated_Script_Drops_File_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage obfuscation pattern: a script interpreter (PowerShell, cmd, wscript, cscript, mshta) launches with indicators of command obfuscation (base64, environment variable expansion, string concatenation tokens, or escape character abuse), followed within 5 minutes by a file creation event on the same host. This additive coverage complements command-line signature rules by correlating the obfuscated execution with its artifact on disk, reducing false positives and raising confidence."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture and file-creation events (Sysmon Event ID 1 + 11, or equivalent EDR telemetry normalised to UDM PROCESS_LAUNCH and FILE_CREATION)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers using base64-encoded payloads; SCCM/Intune deployment scripts; developer toolchains that encode build artefacts; security tools performing self-tests."
    tuning_guidance = "Add known-good parent processes to %global_allowed_admin_tools. Add authorised script hosts to %global_allowed_script_hosts. Narrow the file-creation path regex to high-risk directories (Temp, AppData, ProgramData) if noise is high."

  events:
    // Event 1: Script interpreter launch with obfuscation indicators
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be a common script host abused for obfuscated execution
    $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/

    // Obfuscation indicators in the command line - base64 flag, env var expansion,
    // string-split concatenation tokens, or heavy escape character usage
    $proc.target.process.command_line = /(?i)(FromBase64String|encodedcommand|\-enc\s|\-e\s+[A-Za-z0-9+\/]{20}|%[A-Za-z_][A-Za-z0-9_]*%|\^[a-zA-Z]\^|\"[^\"]{1,6}\"\s*\+\s*\"[^\"]{1,6}\"|'[^']{1,6}'\s*\+\s*'[^']{1,6}'|iex\s*\(|invoke-expression)/

    // Exclude approved script hosts and admin tooling
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Capture the joining entity
    $proc.principal.hostname = $hostname

    // Event 2: File creation following the obfuscated execution on the same host
    $file.metadata.event_type = "FILE_CREATION"

    // Focus on high-risk drop locations used by obfuscated payloads
    $file.target.file.full_path = /(?i)\\(Users\\[^\\]+\\(AppData\\(Local|Roaming)|Downloads)|Windows\\Temp|Temp|ProgramData|Public)\\[^\\]+\.(exe|dll|bat|ps1|vbs|js|hta|cmd|scr|com|lnk|msi|jar|py|wsf)$/

    // Exclude backup and security tooling that legitimately write to these paths
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    $file.principal.hostname = $hostname

    // Chronological ordering: process launch must precede file creation
    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $obfuscated_cmdline = array_distinct($proc.target.process.command_line)
    $script_host_used = array_distinct($proc.target.process.file.full_path)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $initiating_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
