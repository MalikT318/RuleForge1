/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:18:22.543607+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_Print_Processor_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registration of a new print processor DLL via the Windows registry. Adversaries abuse the print spooler service (spoolsv.exe) by adding a registry key under the Print Processors path that points to a malicious DLL, which is then loaded at boot with SYSTEM privileges. This rule targets the resulting registry state change rather than the process command line, providing coverage that is harder to evade."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_CREATION or REGISTRY_MODIFICATION events. Sysmon Event ID 12/13 or equivalent EDR registry events must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver installations by vendor software (HP, Canon, Xerox, etc.), Windows Update applying print subsystem patches, enterprise print management solutions (PaperCut, PrinterLogic). These typically run from known installer parent processes."
    tuning_guidance = "Add known-good printer management parent process paths to %global_allowed_admin_tools. If a specific print management solution consistently triggers this rule, add its service account to %global_allowed_service_accounts. Scope further by requiring the writing process to be outside expected installer paths."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Control\\Print\\Environments\\.*\\Print Processors\\/
    $reg.target.registry.registry_value_name = /(?i)^driver$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_data)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
