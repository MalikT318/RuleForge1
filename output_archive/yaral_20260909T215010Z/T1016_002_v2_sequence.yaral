/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:22:08.922716+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_WiFi_Credential_File_Read_Then_Exfil_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process reading NetworkManager Wi-Fi credential files under /etc/NetworkManager/system-connections/ followed by creation of a file in a world-writable or staging directory on the same host within 10 minutes. This sequence is consistent with Wi-Fi credential harvesting and local staging for exfiltration, and provides additive coverage beyond simple command-line detection."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires Linux EDR or auditd telemetry producing FILE_READ and FILE_CREATION UDM events. Auditd rules must include -w /etc/NetworkManager/system-connections/ -p r -k wifi_creds and file creation watches on /tmp, /dev/shm, /var/tmp."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "NetworkManager daemon itself reading its own config on startup or reconnect; authorised configuration management tools (Ansible, Puppet) reading network profiles; backup agents traversing /etc."
    tuning_guidance = "Add the NetworkManager daemon path and authorised config-management tool paths to %global_allowed_backup_processes or %global_allowed_admin_tools. Add known-good service account names to %global_allowed_service_accounts."

  events:
    // Event 1: A non-privileged or unexpected process reads a NetworkManager
    // Wi-Fi profile file which contains SSID names and PSK credentials.
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\/etc\/NetworkManager\/system-connections\// nocase
    not $read.principal.process.file.full_path = /\/usr\/sbin\/NetworkManager/ nocase
    not $read.principal.process.file.full_path = /\/usr\/bin\/nmcli/ nocase
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.process.file.full_path in %global_allowed_admin_tools
    not $read.principal.user.userid in %global_allowed_service_accounts
    $read.principal.hostname = $hostname

    // Event 2: The same host creates a file in a world-writable or
    // temporary staging location shortly after the credential read.
    $stage.metadata.event_type = "FILE_CREATION"
    $stage.target.file.full_path = /^\/(tmp|dev\/shm|var\/tmp|run\/shm)\// nocase
    not $stage.principal.process.file.full_path in %global_allowed_backup_processes
    not $stage.principal.process.file.full_path in %global_allowed_admin_tools
    not $stage.principal.user.userid in %global_allowed_service_accounts
    $stage.principal.hostname = $hostname

    // Enforce chronological ordering: read must precede staging write.
    $read.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($read.principal.hostname)
    $reading_process = array_distinct($read.principal.process.file.full_path)
    $wifi_profile_accessed = array_distinct($read.target.file.full_path)
    $staging_file_created = array_distinct($stage.target.file.full_path)
    $staging_process = array_distinct($stage.principal.process.file.full_path)
    $acting_user = array_distinct($read.principal.user.userid)

  condition:
    $read and $stage
}
