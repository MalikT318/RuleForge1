/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:20:51.549261+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_Internet_Connectivity_Check_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file artifacts written to world-writable or temporary directories that are consistent with the output of internet connectivity discovery tools (ping, curl, wget, traceroute, nmap). Adversaries commonly redirect the output of connectivity checks to files in /tmp, /dev/shm, or /var/tmp to review results or pass them to subsequent stages. This rule targets the resulting file artifact rather than the process launch, providing coverage when command-line logging is absent or suppressed."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires Linux EDR or auditd FILE_CREATE/FILE_MODIFY events with target.file.full_path populated. Auditd requires -w rules on /tmp, /dev/shm, and /var/tmp with -p w, or equivalent EDR file telemetry."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate monitoring scripts, health-check automation, CI/CD pipeline probes, and network diagnostic tooling that writes output to temporary directories. Backup or deployment agents may also write transient files to these paths."
    tuning_guidance = "Add the parent process paths of approved monitoring or deployment agents to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the filename pattern regex if specific naming conventions are observed in the environment. Consider raising severity if the writing process is an interactive shell (bash, sh, zsh) rather than a known automation agent."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File written into a world-writable or staging directory commonly used
    // to capture tool output on Linux. Covers /tmp, /var/tmp, /dev/shm,
    // and hidden dot-files in those directories.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)/ nocase

    // Filename patterns strongly associated with connectivity check output:
    // common attacker naming conventions such as out, result, check, ping,
    // net, conn, reach, trace, scan, probe, test followed by optional
    // extensions or numeric suffixes. Also catches hidden (dot-prefixed) files.
    $file.target.file.full_path = /\/(\.?)(ping|curl|wget|trace|tracert|traceroute|nmap|scan|conn|reach|net_check|netcheck|connectivity|internet|probe|reachability|check|result|out)([-_.]?[0-9a-z]*)(\.(txt|log|out|tmp|dat|json|csv))?$/ nocase

    // The writing process must be a shell or a known connectivity/network tool.
    // This anchors the artifact to the expected process lineage and avoids
    // matching unrelated file writes that happen to land in /tmp.
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|fish|curl|wget|ping|ping6|traceroute|tracepath|nmap|nc|netcat|ncat|python[23]?|perl|ruby|lua)$/

    // Exclude approved administrative and backup tooling that legitimately
    // writes diagnostic output to temporary paths.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $artifact_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
