/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:16:09.474694+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_LKM_File_Drop_Then_Module_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a kernel module (.ko) file written to a suspicious or non-standard path followed by a process that loads a kernel module (insmod/modprobe/kmod) referencing the same host. LKM-based rootkits commonly drop a compiled module to a writable directory before loading it into the kernel. This rule provides additive coverage beyond command-line process-creation rules by correlating the file-drop event with the subsequent load attempt."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. FILE_CREATION events must include target.file.full_path. PROCESS_LAUNCH events must include target.process.command_line and target.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate kernel module installation by package managers (apt, yum, dnf, rpm) writing to /lib/modules or /usr/lib/modules. Custom driver builds by developers. Automated provisioning pipelines that compile and load out-of-tree drivers."
    tuning_guidance = "Add trusted parent processes (package manager paths such as /usr/bin/dpkg, /usr/bin/rpm) to %global_allowed_admin_tools. Scope the file-path regex to exclude /lib/modules and /usr/lib/modules if package-manager noise is high. Raise the risk score if the writing process is a shell or interpreter."

  events:
    // Event 1: A .ko file is created in a suspicious or non-standard location.
    // Standard package-manager paths (/lib/modules, /usr/lib/modules) are excluded
    // to reduce noise from legitimate driver installs.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.ko$/ nocase
    // Suspicious write locations: /tmp, /dev/shm, /var/tmp, /run, home dirs, /opt, /root
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/home\/|\/root\/|\/opt\/)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    // Event 2: A kernel module loader process launches on the same host.
    // Targets insmod, modprobe, and kmod (the unified helper used by systemd).
    $load.metadata.event_type = "PROCESS_LAUNCH"
    $load.target.process.file.full_path = /\/(insmod|modprobe|kmod)$/ nocase
    not $load.principal.process.file.full_path in %global_allowed_admin_tools
    not $load.principal.process.file.full_path in %global_allowed_security_tools
    $load.principal.hostname = $hostname

    // Chronological ordering: file must be dropped before the load attempt.
    $file.metadata.event_timestamp.seconds <= $load.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity = array_distinct($hostname)
    $dropped_module_paths = array_distinct($file.target.file.full_path)
    $loader_process = array_distinct($load.target.process.file.full_path)
    $loader_cmdline = array_distinct($load.target.process.command_line)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)
    $loading_user = array_distinct($load.principal.user.userid)

  condition:
    $file and $load
}
