/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:07:02.103765+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_Invisible_Unicode_Network_Exfil_Or_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network connections to external destinations carrying HTTP request URIs or user-agent strings that contain percent-encoded invisible Unicode code points commonly abused in T1027.018 (zero-width spaces, variation selectors, bidirectional controls, tag characters). Adversaries embed these characters in URLs, headers, or payloads to smuggle encoded content past visual inspection. Observed in phishing kit C2 (e.g., Tycoon2FA) and exfiltration channels. Firewall/proxy logs are the detection surface; no endpoint process context is required."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires firewall or forward-proxy logs normalised to UDM NETWORK_HTTP with target.url or network.http.user_agent populated. The proxy must log full request URIs including query strings."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate internationalised applications that pass Unicode in query parameters (e.g., CJK search terms encoded as %E2%80%8B by a buggy client). Automated API clients that percent-encode all non-ASCII bytes. Security scanners probing for Unicode injection."
    tuning_guidance = "Add known-good external domains that legitimately carry Unicode payloads to %global_allowed_domains. Add approved scanner source addresses to %global_allowed_scanners. Raise severity if the destination is also newly registered or uncategorised."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Exclude internal destinations - firewall sees both directions
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

    // Match percent-encoded invisible Unicode code points in the request URI or user-agent.
    // Categories covered:
    //   Zero-width spaces / joiners / non-joiners : %E2%80%8B, %E2%80%8C, %E2%80%8D
    //   Zero-width no-break space (BOM/ZWNBSP)   : %EF%BB%BF
    //   Bidirectional controls (LRE/RLE/PDF/LRO/RLO/LRI/RLI/FSI/PDI):
    //     %E2%80%AA through %E2%80%AF, %E2%81%A6 through %E2%81%A9
    //   Variation selectors VS1-VS16             : %EF%B8%80 through %EF%B8%8F
    //   Variation selectors supplement VS17-VS256 : %F3%A0%80%80 through %F3%A0%87%BF (tag block)
    //   Soft hyphen                              : %C2%AD
    //   Word joiner                              : %E2%81%A0
    //   Function application / invisible times   : %E2%81%A1, %E2%81%A2, %E2%81%A3
    //
    // The pattern anchors on the percent-encoded UTF-8 byte sequences that are
    // unambiguously invisible Unicode; printable CJK ranges are excluded.

    (
      $net.target.url = /(?i)(%e2%80%8[bcd]|%ef%bb%bf|%c2%ad|%e2%81%a[0-3]|%e2%80%a[a-f]|%e2%80%[ab][0-9a-f]|%ef%b8%8[0-9a-f]|%ef%b8%[89][0-9a-f]|%f3%a0%8[0-7]%[0-9a-f][0-9a-f])/ nocase
      or
      $net.network.http.user_agent = /(?i)(%e2%80%8[bcd]|%ef%bb%bf|%c2%ad|%e2%81%a[0-3]|%e2%80%a[a-f]|%e2%80%[ab][0-9a-f]|%ef%b8%8[0-9a-f]|%ef%b8%[89][0-9a-f]|%f3%a0%8[0-7]%[0-9a-f][0-9a-f])/ nocase
    )

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_host = array_distinct($net.target.hostname)
    $destination_url = array_distinct($net.target.url)
    $user_agent = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
