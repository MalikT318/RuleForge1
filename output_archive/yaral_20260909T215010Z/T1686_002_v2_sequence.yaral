/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:52:12.235677+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Firewall_Rule_Change_Then_New_Permitted_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a firewall policy or ACL modification followed within 10 minutes by a new network flow that was previously blocked or originates from an unexpected external source on the same device. This pattern is consistent with an adversary modifying firewall rules to permit otherwise blocked traffic, then immediately leveraging the newly opened path for C2 or lateral movement."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Requires firewall management-plane logs normalised to SETTING_MODIFICATION (ACL/policy change events) and NETWORK_FLOW or NETWORK_CONNECTION records from the same device. Both event types must be ingested into Chronicle UDM."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned firewall maintenance windows, authorised security team rule updates, automated policy deployment via orchestration platforms, vulnerability scanner probes following a legitimate rule change."
    tuning_guidance = "Add authorised change-management service accounts to %global_allowed_service_accounts. Add known scanner source IPs to %global_allowed_scanners. Add approved management source addresses to %global_allowed_mgmt_sources. Narrow the match by requiring specific high-risk destination ports if the environment has a well-defined perimeter policy."

  events:
    // Event 1: A firewall ACL, policy, or security-zone rule is modified
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname = $device_hostname
    // Restrict to firewall/ACL policy change semantics via target resource path
    $cfg.target.resource.name = /(?i)(acl|access.?list|firewall|policy|rule|zone|filter|permit|deny)/
    // Exclude authorised service accounts performing automated deployments
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    // Exclude changes originating from approved management sources
    not $cfg.principal.ip in %global_allowed_mgmt_sources

    // Event 2: A network flow is observed from an external source to an internal destination
    // on the same device shortly after the rule change
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $device_hostname
    // Exclude purely internal flows - external source must not be in RFC1918 space
    not $flow.principal.ip in %rfc1918_internal
    // Exclude known authorised scanners
    not $flow.principal.ip in %global_allowed_scanners
    // Exclude flows to known-good external domains (e.g. update services)
    not $flow.target.hostname in %global_allowed_domains

    // Chronological ordering: config change must precede the suspicious flow
    $cfg.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($device_hostname)
    $changing_user = array_distinct($cfg.principal.user.userid)
    $changed_resource = array_distinct($cfg.target.resource.name)
    $external_source_ips = array_distinct($flow.principal.ip)
    $destination_ips = array_distinct($flow.target.ip)
    $destination_ports = array_distinct($flow.target.port)
    $flow_count = count($flow.metadata.id)

  condition:
    $cfg and $flow
}
