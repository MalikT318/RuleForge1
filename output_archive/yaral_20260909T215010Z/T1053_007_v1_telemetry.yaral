/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:11:31.209672+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_K8s_CronJob_Resource_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of Kubernetes CronJob or Job resources via the API server. Adversaries abuse CronJob scheduling to deploy containers that execute malicious workloads on a recurring basis, achieving persistence and execution within a cluster. This rule pivots on the resource-creation artifact rather than command-line telemetry, providing coverage orthogonal to process-launch rules."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes API server audit logs normalised into Chronicle UDM. The audit log must capture resource creation events with resource type, namespace, and principal identity fields populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "Legitimate CI/CD pipelines creating CronJobs for batch processing, database backups, certificate rotation, or log aggregation. Cluster operators deploying scheduled maintenance workloads."
    tuning_guidance = "Add known CI/CD service accounts to %global_allowed_service_accounts. Add known automation principals to %global_allowed_cloud_principals. Consider scoping to sensitive namespaces (e.g. kube-system) for higher-fidelity alerting, or raising risk_score when the creating principal is not a recognised service account."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target resource must be a Kubernetes CronJob or Job scheduling primitive
    $cloud.target.resource.resource_subtype = /(?i)(cronjob|batch\/v1.*job)/

    // Exclude known-good automation service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good cloud/automation principals (CI/CD, operators)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Capture the namespace for context; kube-system jobs are especially sensitive
    $cloud.target.resource.name = $resource_name

    // Capture the acting principal for correlation
    $cloud.principal.user.userid = $actor

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($cloud.principal.hostname)
    $created_resource = array_distinct($resource_name)
    $acting_principal = array_distinct($actor)
    $resource_subtype = array_distinct($cloud.target.resource.resource_subtype)

  condition:
    $cloud
}
