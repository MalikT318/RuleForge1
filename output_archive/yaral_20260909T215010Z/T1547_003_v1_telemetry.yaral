/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:13:53.575674+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_TimeProvider_Registry_DllName_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications to the W32Time TimeProviders subkeys, specifically writes to the DllName value. Adversaries register malicious DLLs as time providers under HKLM\\System\\CurrentControlSet\\Services\\W32Time\\TimeProviders\\ to achieve persistence and execution as Local Service at boot. This rule fires on the resulting registry state change rather than the process command line, providing coverage against command-line evasion."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13 or equivalent EDR registry write events) normalised to UDM REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate NTP client software or Windows updates that register or update a time provider DLL. Third-party time synchronisation products (e.g., enterprise NTP appliance agents) may write to these keys during installation or upgrade."
    tuning_guidance = "Populate %global_allowed_admin_tools with the full paths of approved time-provider installer processes. If a specific known-good DLL path pattern recurs in alerts, add the writing process to the exclusion list rather than suppressing the registry key match, to preserve coverage for unexpected writers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\System\\CurrentControlSet\\Services\\W32Time\\TimeProviders\\/
    $reg.target.registry.registry_value_name = /(?i)^DllName$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $dll_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
