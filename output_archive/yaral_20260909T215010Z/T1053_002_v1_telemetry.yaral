/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:09:02.847961+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_At_Job_File_Creation_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of at(1) job spool files under /var/spool/atjobs or /var/spool/at, which are the on-disk artifacts produced when a job is scheduled via the at utility on Linux. Monitoring the resulting file artifact rather than the at command invocation provides coverage against command-line log evasion and direct spool-file manipulation by adversaries."
    mitre_tactic    = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires Linux EDR or auditd file-system event telemetry normalised to Chronicle UDM FILE_CREATION or FILE_MODIFICATION events. Auditd rules should watch /var/spool/at and /var/spool/atjobs with -w or equivalent syscall watches (open, creat, rename)."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate use of at by system administrators for one-off maintenance tasks. Batch job scheduling frameworks that wrap at internally. Automated testing pipelines running on developer workstations."
    tuning_guidance = "Add known-good service account names to %global_allowed_service_accounts to suppress authorised automation. Add approved parent process paths (e.g. configuration management agents) to %global_allowed_admin_tools. Consider raising severity if the writing process is not atd itself."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match the at job spool directories used across major Linux distributions.
    // /var/spool/at      - Debian/Ubuntu and derivatives
    // /var/spool/atjobs  - RHEL/CentOS/Fedora and derivatives
    // Job files are named with a leading 'a' followed by a hex sequence, e.g. a0000201b4d5e6
    $file.target.file.full_path = /^\/var\/spool\/(at|atjobs)\// nocase

    // Exclude the atd daemon itself writing its own legitimate spool entries
    // when it is running as root under normal operation - this is expected.
    // We still want to alert when any OTHER process writes to the spool dir,
    // which is the adversarial case (direct file drop bypassing the at binary).
    // We also want to alert when atd writes a file but the initiating user is
    // not in the allowed service accounts list.
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative tooling (e.g. config management agents)
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)
    $spool_file_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
