/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:00:40.969150+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_EmbeddedPayload_FileWrite_Then_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage embedded payload pattern: a non-standard parent process writes a portable executable or script file to a user-writable or temp directory, followed by execution of that same file within 5 minutes. This is additive coverage over command-line-only rules, focusing on the file-drop-then-execute sequence characteristic of embedded payload extraction."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION and PROCESS_LAUNCH telemetry normalised into UDM. Sysmon Event IDs 11 (FileCreate) and 1 (ProcessCreate) are sufficient."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that self-extract and run components; legitimate updaters; package managers (chocolatey, winget); RMM agents deploying scripts."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Add approved deployment service accounts to %global_allowed_service_accounts. Narrow the dropped-file path regex if temp-dir writes are too noisy in your environment."

  events:
    // Event 1: A suspicious parent process writes an executable or script to a
    // user-writable or temporary location. We exclude known-good tooling.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\(temp|tmp|appdata|programdata|users\\[^\\]+\\downloads|public)\\[^\\]+\.(exe|dll|ps1|vbs|js|hta|bat|cmd|scr|cpl|msi|jar)$/
    not $file.principal.process.file.full_path = /(?i)\\(msiexec|setup|install|update|winget|choco|chocolatey|wix|inno)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $dropped_path

    // Event 2: The exact file that was written is subsequently launched as a process.
    // This confirms the embedded payload was extracted and executed.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $dropped_path
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Enforce chronological ordering: file must be written before it is executed.
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $dropped_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $dropped_file_path = array_distinct($proc.target.process.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $execution_count = count($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
