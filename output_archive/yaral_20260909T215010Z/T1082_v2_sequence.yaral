/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:22:54.207856+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_002_NetDevice_Login_Then_BulkMgmtQuery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Medium"
    description     = "Detects a pattern consistent with system information discovery on network devices: an interactive management-plane login followed by a burst of outbound SNMP or NETCONF/RESTCONF queries from the device within a short window. An adversary who has gained CLI or API access to a network device may issue bulk information-gathering queries (show version, show inventory, SNMP GET-BULK, NETCONF get-config) that are observable as management-plane traffic. This rule joins the login event to the subsequent query traffic over a 10-minute window."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Requires firewall/perimeter logs that capture management-plane sessions (SSH/Telnet/HTTPS to device management ports) and SNMP/NETCONF flow records. Both event types must be normalised to UDM."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorised NMS/SNMP pollers, network monitoring platforms, scheduled configuration backup jobs, and vulnerability scanners will trigger this rule. Tune by adding known management source IPs to %global_allowed_mgmt_sources and known scanner sources to %global_allowed_scanners."
    tuning_guidance = "Add approved management station source IPs to %global_allowed_mgmt_sources. Add authorised SNMP/NETCONF collector addresses to %global_allowed_scanners. Raise the NETWORK_FLOW port filter if your environment uses non-standard management ports."

  events:
    // Event 1: Interactive management-plane login to a network device
    // Matches SSH (22), Telnet (23), HTTPS management (443), or NETCONF (830)
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.port >= 22
    $auth.target.port <= 830
    (
        $auth.target.port = 22  or
        $auth.target.port = 23  or
        $auth.target.port = 443 or
        $auth.target.port = 830
    )
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.ip in %global_allowed_scanners
    not $auth.principal.user.userid in %global_allowed_service_accounts
    $auth.target.ip = $device_ip

    // Event 2: Outbound management-protocol traffic originating FROM the same device
    // SNMP (161/162 UDP), NETCONF (830), RESTCONF (443), or high-volume SSH polling
    $flow.metadata.event_type = "NETWORK_FLOW"
    (
        $flow.target.port = 161  or
        $flow.target.port = 162  or
        $flow.target.port = 830  or
        $flow.target.port = 443
    )
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.ip in %global_allowed_mgmt_sources
    not $flow.target.ip in %global_allowed_scanners
    $flow.principal.ip = $device_ip

    // Chronological ordering: login must precede the outbound query traffic
    $auth.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score          = max(65)
    $mitre_technique_id  = array_distinct("T1082")
    $primary_entity      = array_distinct($device_ip)
    $login_user          = array_distinct($auth.principal.user.userid)
    $login_source_ip     = array_distinct($auth.principal.ip)
    $query_destination   = array_distinct($flow.target.ip)
    $query_ports_seen    = array_distinct($flow.target.port)
    $flow_count          = count($flow.metadata.id)

  condition:
    $auth and $flow
}
