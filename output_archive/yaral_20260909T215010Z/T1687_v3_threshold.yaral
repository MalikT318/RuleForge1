/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:53:41.559670+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_003_Repeated_MFA_Disable_Or_Bypass_Threshold {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Threshold"
    severity        = "High"
    description     = "Detects a high volume of MFA-related permission or settings changes for distinct accounts within a short window. Individually these changes may be legitimate administrative actions; in aggregate they suggest an adversary exploiting identity-provider controls to impair authentication enforcement and weaken defenses across multiple accounts."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires identity-provider audit logs normalised to UDM USER_CHANGE_PERMISSIONS or USER_CHANGE_PASSWORD events that capture MFA policy or authentication-method changes."
    platform        = "Windows"
    log_source      = "identity"
    false_positives = "Bulk MFA enrollment or reset campaigns, helpdesk-driven account remediation, automated provisioning pipelines, and identity governance workflows that touch many accounts in a short period."
    tuning_guidance = "Add known provisioning and helpdesk service accounts to %global_allowed_service_accounts. Raise the count threshold if bulk enrollment events are common in the environment. Consider scoping to non-business hours to reduce noise."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // Target a change that touches authentication strength or MFA policy.
    // Chronicle normalises MFA-related audit actions into these fields.
    (
      $auth.target.user.attribute.roles.description = /(?i)(mfa|multi.factor|authenticat|strong.auth|auth.method|conditional.access|security.default)/ or
      $auth.security_result.description = /(?i)(mfa|multi.factor|authenticat|strong.auth|auth.method|conditional.access|security.default|bypass|disable|exempt)/
    )

    // Exclude approved service and automation accounts performing bulk operations.
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Capture the acting principal for grouping.
    $auth.principal.user.userid = $actor

  match:
    $actor over 10m

  outcome:
    // Scale risk with volume: base 55, capped at 95.
    $risk_score = max(
      55 +
      (count($auth.target.user.userid) * 4)
    )
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity     = array_distinct($actor)
    $affected_accounts  = array_distinct($auth.target.user.userid)
    $change_descriptions = array_distinct($auth.security_result.description)
    $event_count        = count($auth.target.user.userid)

  condition:
    // Fire when a single actor modifies MFA/auth permissions for 5 or more
    // distinct target accounts within the 10-minute window.
    #auth >= 5
}
