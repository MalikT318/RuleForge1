/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:02:52.047432+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_Icon_Smuggling_File_Then_Network {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects LNK Icon Smuggling: a .lnk file is created in a user-writable or temp location, followed within 5 minutes by an outbound network connection from a scripting host or shell process on the same host. This pattern is consistent with a weaponised LNK whose icon field or target path triggers a payload download when the shortcut is invoked."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION events for .lnk files and NETWORK_CONNECTION events. Both must be normalised to UDM and ingested from the same endpoint."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers that create .lnk shortcuts and immediately phone home for updates; browser download managers; RMM agents deploying shortcuts with update checks."
    tuning_guidance = "Add known-good parent processes that create shortcuts (e.g., installer frameworks) to %global_allowed_admin_tools. Add approved update domains to %global_allowed_domains. Narrow the file path regex to specific high-risk directories if noise is high."

  events:
    // Event 1: A .lnk file is created in a user-writable or staging location
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\(temp|tmp|appdata|downloads|desktop|public|users)\\[^\\]+\.lnk$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Event 2: A scripting host or shell makes an outbound network connection on the same host
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(?i)\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|wget)\.exe$/
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    // Chronological ordering: LNK creation precedes the outbound connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1027.012")
    $primary_entity      = array_distinct($hostname)
    $lnk_paths_created   = array_distinct($file.target.file.full_path)
    $spawning_processes  = array_distinct($net.principal.process.file.full_path)
    $destination_ips     = array_distinct($net.target.ip)
    $destination_ports   = array_distinct($net.target.port)

  condition:
    $file and $net
}
