/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T21:54:05.279510+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Obfuscated_Payload_Network_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network-layer indicators of obfuscated or encoded payload transfer observed by IDS/IPS appliances. Targets high-entropy or encoded content patterns in HTTP traffic traversing network devices - characteristic of adversaries staging obfuscated files or tools via encrypted/encoded channels that bypass content inspection. Complements existing process-creation detections by covering the network delivery phase."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM NETWORK_HTTP events. HTTP request/response metadata including URI, user-agent, content-type, and referrer fields must be populated."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Legitimate software update mechanisms using compressed archives, CDN-delivered minified JavaScript, base64-encoded API payloads from authorised SaaS integrations, encrypted backup transfers."
    tuning_guidance = "Add known-good external domains serving compressed or encoded content to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Tune the URI and content-type regex patterns if specific legitimate applications generate matching traffic."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Exclude known-good external destinations
    not $net.target.hostname in %global_allowed_domains

    // Exclude internal-to-internal traffic
    not $net.target.ip in %rfc1918_internal

    // Exclude authorised scanners
    not $net.principal.ip in %global_allowed_scanners

    // Detect URIs characteristic of encoded/obfuscated payload delivery:
    // - Long base64-like path segments (high-entropy alphanumeric strings)
    // - Double-encoded percent sequences (%25xx)
    // - Paths with concatenated encoded blobs typical of split-payload staging
    (
      $net.network.http.request_url = /\/[A-Za-z0-9+\/]{40,}={0,2}(\/|$|\?)/ nocase or
      $net.network.http.request_url = /%25[0-9a-fA-F]{2}/ nocase or
      $net.network.http.request_url = /\.(b64|enc|packed|obf|crypt)(\/|\?|$)/ nocase
    )

    // Detect content-type mismatches or opaque binary transfers
    // commonly used to smuggle encoded payloads past content filters
    (
      $net.network.http.response_code = 200 or
      $net.network.http.response_code = 206
    )

    // Flag suspicious user-agents associated with scripted/automated retrieval
    // of obfuscated content (no legitimate browser UA, or curl/wget variants
    // used to pull staged payloads)
    (
      $net.network.http.user_agent = /^(curl|wget|python-requests|go-http|libwww|lwp-trivial)/  nocase or
      $net.network.http.user_agent = /^-$/ nocase or
      $net.network.http.user_agent = /^$/ nocase
    )

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $suspicious_uri = array_distinct($net.network.http.request_url)
    $observed_user_agent = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
