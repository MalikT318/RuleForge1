/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:18:58.762314+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of .desktop files in XDG Autostart directories (/etc/xdg/autostart or ~/.config/autostart). Adversaries abuse these locations to achieve persistence by configuring malicious executables to launch when a user's desktop environment loads. This rule targets the file artifact produced by the attack rather than the command used to create it, providing coverage that is harder to evade than process-creation detection."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate desktop application installers (e.g., Slack, Teams, Zoom, Dropbox) writing their own autostart entries; package managers installing desktop applications; IT provisioning scripts deploying standard desktop configurations."
    tuning_guidance = "Add known-good installer or provisioning process paths to %global_allowed_admin_tools. If specific application names are consistently benign, scope exclusions to the principal process path. Consider raising severity if the writing process is a shell interpreter, script host, or resides in /tmp or /dev/shm."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target XDG Autostart directories: system-wide and per-user
    // System: /etc/xdg/autostart/
    // User:   /home/<user>/.config/autostart/  or  /root/.config/autostart/
    $file.target.file.full_path = /(?i)(\/etc\/xdg\/autostart\/|\/\.config\/autostart\/).*\.desktop$/ nocase

    // Exclude known-good administrative and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good script hosts used by legitimate provisioning
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $autostart_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
