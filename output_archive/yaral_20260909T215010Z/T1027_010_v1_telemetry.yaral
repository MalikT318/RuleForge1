/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:01:06.261337+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Obfuscated_Script_File_Written_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of script files in world-writable or temporary directories whose content patterns suggest command obfuscation artifacts: base64-encoded blobs, heavily escaped shell constructs, or eval/exec wrappers written to disk. Attackers stage obfuscated payloads as files to evade command-line logging and execute them in a second step. This rule pivots on the FILE_CREATION / FILE_MODIFICATION artifact rather than the process command line."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events, with target.file.full_path and, where available, target.file.content populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate deployment scripts written by configuration management tools (Ansible, Chef, Puppet) that use base64 for binary embedding; application installers that stage encoded payloads in /tmp; container build processes writing encoded layers."
    tuning_guidance = "Add known-good parent process paths (e.g., Ansible, Puppet agent, package managers) to %global_allowed_admin_tools. Add authorised automation service accounts to %global_allowed_service_accounts. Narrow the path regex to exclude specific subdirectories used by approved tooling."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target world-writable, temporary, and user-staging directories commonly
    // abused to drop obfuscated scripts; also cover hidden dot-directories
    // under home trees and /dev/shm which is frequently used for in-memory staging.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/run\/user\/|\/home\/[^\/]+\/\.(config|cache|local|bash|profile)|\/var\/spool\/|\/etc\/cron\.(d|daily|hourly|weekly|monthly)\/)/ nocase

    // Match file extensions associated with interpreted scripts or generic
    // data files that are commonly used to carry obfuscated payloads.
    // Covers shell scripts, Python, Perl, Ruby, PHP, and extensionless blobs
    // with a dot-hidden prefix.
    (
        $file.target.file.full_path = /\.(sh|bash|py|pl|rb|php|js|ps1|b64|enc|dat|tmp|bin)$/ nocase
        or
        $file.target.file.full_path = /\/\.[^\/]{1,40}$/
    )

    // Exclude files written by known-good administrative and backup tooling.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude package-manager and system-update processes that legitimately
    // write scripts to these locations during installation.
    not $file.principal.process.file.full_path = /\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper|snap|flatpak|pip[0-9]?|npm|cargo|gem)$/ nocase

    // Exclude known security tooling that may write detection artefacts.
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_path      = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $actor_user        = array_distinct($file.principal.user.userid)

  condition:
    $file
}
