/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T22:20:28.086132+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_Network_Config_Discovery_Burst_Then_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a burst of outbound network connections from a Linux host to external destinations shortly after a spike in internal DNS queries for network topology information. A compromised Linux host performing automated network configuration discovery will often enumerate internal subnets and then attempt to beacon or exfiltrate findings externally. This rule correlates a high-volume DNS query burst (indicative of subnet/host enumeration) with a subsequent external connection from the same source IP, providing firewall-layer coverage that is additive to endpoint process-launch rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Requires firewall or perimeter device logs forwarded to Chronicle with NETWORK_DNS and NETWORK_CONNECTION UDM event types. DNS query logging must be enabled on the perimeter firewall or inline DNS resolver."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Vulnerability scanners, authorised network monitoring tools, DHCP lease renewals causing DNS bursts, CI/CD pipelines performing service discovery, backup agents resolving many hostnames."
    tuning_guidance = "Add known scanner source IPs to %global_allowed_scanners. Add approved monitoring source addresses to %global_allowed_mgmt_sources. Raise the DNS query count threshold or widen the time window if legitimate orchestration workloads trigger this rule."

  events:
    // Leg 1: burst of DNS queries from the same internal source IP
    // indicative of automated host/subnet enumeration
    $dns.metadata.event_type = "NETWORK_DNS"
    not $dns.principal.ip in %rfc1918_internal
    not $dns.principal.ip in %global_allowed_scanners
    not $dns.principal.ip in %global_allowed_mgmt_sources
    $dns.principal.ip = $src_ip

    // Leg 2: outbound connection from the same source to an external destination
    // occurring after the DNS enumeration burst
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Chronological ordering: DNS enumeration precedes external connection
    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($src_ip)
    $dns_query_count = count($dns.network.dns.questions.name)
    $distinct_dns_names = array_distinct($dns.network.dns.questions.name)
    $external_destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #dns >= 20 and $net
}
