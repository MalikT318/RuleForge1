/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:21:08.416267+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_OpenThenRemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-system process opening a handle to a remote process (PROCESS_OPEN) followed by a new thread creation event (PROCESS_LAUNCH of a remote thread or injected image) on the same host within 5 minutes. This pattern is consistent with PE injection via VirtualAllocEx/WriteProcessMemory/CreateRemoteThread without requiring command-line matching, providing additive coverage over existing PROCESS_LAUNCH command-line rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN events (Sysmon Event ID 10 / EDR handle-open telemetry) and PROCESS_LAUNCH or thread-creation events normalised to UDM. Both event types must be present for the correlation to fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tools (EDR agents, AV), debuggers, JIT compilers (JVM, CLR), legitimate RMM agents, crash-dump collectors, and performance profilers routinely open handles to remote processes and may spawn threads. Tune using the reference lists below."
    tuning_guidance = "Add known security and admin tool paths to %global_allowed_security_tools and %global_allowed_admin_tools. Add authorised service accounts to %global_allowed_service_accounts. Narrow the rule further by restricting $open.target.process.file.full_path to high-value targets such as lsass.exe, svchost.exe, or explorer.exe."

  events:
    // Event 1: A non-system process opens a handle to a different (remote) process.
    // Sysmon Event ID 10 / EDR handle-open telemetry normalised to PROCESS_OPEN.
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener must not be a known-good security or admin tool.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude openers that are themselves system-level binaries living in System32/SysWOW64.
    // Legitimate injectors from user-space are the threat; system processes opening each other is normal.
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\/
    not $open.principal.process.file.full_path = /(?i)\\windows\\syswow64\\/

    // The target of the handle open must be a different process (cross-process open).
    // We detect this by requiring the principal and target process image paths differ.
    // Target is a high-value host process commonly abused for injection.
    $open.target.process.file.full_path = /(?i)\\(svchost|explorer|lsass|winlogon|csrss|spoolsv|dllhost|rundll32|regsvr32|msiexec|werfault|taskhost|taskhostw|conhost)\.exe$/

    // Bind the host for the join.
    $open.principal.hostname = $hostname

    // Event 2: Within the same window on the same host, a new process or thread
    // is launched whose parent is the same process that opened the handle above,
    // OR a new image is loaded into the previously targeted process.
    // We detect the injected execution as a PROCESS_LAUNCH where the parent is
    // the suspicious opener (same principal process path) and the child image
    // path is anomalous (not a known Windows binary).
    $launch.metadata.event_type = "PROCESS_LAUNCH"

    // The parent of the newly launched entity matches the opener's process.
    $launch.principal.process.file.full_path = $opener_path

    // The child process image is NOT a standard Windows system binary,
    // indicating an injected PE or shellcode stub that has been given a process context.
    not $launch.target.process.file.full_path = /(?i)\\windows\\system32\\/
    not $launch.target.process.file.full_path = /(?i)\\windows\\syswow64\\/
    not $launch.target.process.file.full_path = /(?i)\\windows\\winsxs\\/
    not $launch.target.process.file.full_path = /(?i)\\program files(?: \(x86\))?\\/ 

    // Exclude known-good tooling from the child side as well.
    not $launch.target.process.file.full_path in %global_allowed_admin_tools
    not $launch.target.process.file.full_path in %global_allowed_security_tools

    // Bind the same host.
    $launch.principal.hostname = $hostname

    // Also bind the opener process path so the join is tight (same process on same host).
    $open.principal.process.file.full_path = $opener_path

    // Chronological ordering: handle open must precede the injected launch.
    $open.metadata.event_timestamp.seconds <= $launch.metadata.event_timestamp.seconds

  match:
    $hostname, $opener_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $targeted_process = array_distinct($open.target.process.file.full_path)
    $injected_child = array_distinct($launch.target.process.file.full_path)
    $affected_user = array_distinct($open.principal.user.userid)

  condition:
    $open and $launch
}
