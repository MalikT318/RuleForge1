/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:26:14.840588+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Process_Hollowing_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process hollowing at the PROCESS_OPEN abstraction layer. Process hollowing requires the injecting process to open a handle to the newly-created suspended victim process with PROCESS_VM_WRITE and PROCESS_VM_OPERATION access rights so it can unmap and rewrite the process image. EDR/Sysmon telemetry surfaces these handle requests as PROCESS_OPEN events. This rule fires when a non-system, non-security process opens a handle to a common Windows host process (svchost, RuntimeBroker, dllhost, etc.) with write-capable access, which is the prerequisite OS-level state change that process hollowing must produce regardless of how the injector is named or compiled."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised to UDM PROCESS_OPEN. The target.process.access_mask field must be populated by the sensor. Sysmon must have ProcessAccess rules enabled for the relevant target image patterns."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tools (EDR agents, AV engines) legitimately open handles to system processes for inspection. Debuggers (WinDbg, x64dbg) opened against host processes during development. Some legitimate software updaters briefly open write handles to host processes. Backup and imaging agents may open broad handles."
    tuning_guidance = "Add confirmed security agent and backup process paths to %global_allowed_security_tools and %global_allowed_backup_processes. If access_mask values are available, narrow to masks that include 0x0020 (PROCESS_VM_WRITE) and 0x0008 (PROCESS_VM_OPERATION) combined. Exclude known-good parent process paths via %global_allowed_admin_tools."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be a common Windows host process used as a hollowing vessel.
    // Attackers choose these because they are always present, signed, and
    // blend into normal process listings.
    $open.target.process.file.full_path = /(?i)\\(svchost|RuntimeBroker|dllhost|werfault|taskhost|taskhostw|sihost|ctfmon|spoolsv|lsass|services|SearchIndexer|SearchProtocolHost|msiexec|regsvr32|rundll32|explorer|wuauclt|WmiPrvSE|conhost|csrss|winlogon|userinit)\.exe$/

    // The opening (injecting) process must NOT itself be a known Windows
    // system binary living in System32 or SysWOW64. Legitimate inter-process
    // handle requests between OS components are excluded here.
    not $open.principal.process.file.full_path = /(?i)\\Windows\\[Ss]ystem32\\/
    not $open.principal.process.file.full_path = /(?i)\\Windows\\[Ss]ys[Ww][Oo][Ww]64\\/
    not $open.principal.process.file.full_path = /(?i)\\Windows\\[Ww]in[Ss][Xx][Ss]\\/

    // Exclude processes running from Program Files - reduces noise from
    // legitimate software that opens handles for IPC or COM.
    not $open.principal.process.file.full_path = /(?i)\\[Pp]rogram [Ff]iles\\/

    // Exclude known-good security and backup tooling via reference lists.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing legitimate handle operations.
    not $open.principal.user.userid in %global_allowed_service_accounts

    // The principal hostname must be populated (real endpoint event).
    $open.principal.hostname != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($open.principal.hostname)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $hollowed_target = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
