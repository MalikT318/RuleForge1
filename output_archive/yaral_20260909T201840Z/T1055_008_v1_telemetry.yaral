/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:23:56.422379+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injection_Proc_Mem_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-level artifacts of ptrace-based process injection on Linux. A non-debugger process opening or modifying the writable memory interface of another process (/proc/<pid>/mem) is a strong indicator of ptrace injection. Legitimate debuggers (gdb, strace, lldb) are excluded via reference list. This rule targets the resulting file-access artifact rather than command-line invocation, providing coverage orthogonal to process-creation rules."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR or auditd with file-open/file-access telemetry normalised into Chronicle UDM FILE_READ or FILE_MODIFICATION events. Auditd rules must include '-a always,exit -F arch=b64 -S open,openat,write -F path=/proc' or equivalent. EDR agents that capture /proc/<pid>/mem access will also populate these events."
    log_source      = "linux_endpoint"
    platform        = "Linux"
    false_positives = "Legitimate debuggers (gdb, lldb, strace, ltrace), Java/JVM JIT introspection, some profiling tools (perf, valgrind), and security agents that perform memory scanning. Add approved binaries to %global_allowed_security_tools."
    tuning_guidance = "Add authorised debugger and profiling binary paths to %global_allowed_security_tools. If a specific CI/CD host runs automated debug builds, add it to %global_allowed_admin_tools. Consider scoping to non-development hosts by excluding known build-server hostnames."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target the /proc/<pid>/mem pseudo-file which is the direct write
    // interface used by ptrace injection (PTRACE_POKETEXT/POKEDATA ultimately
    // resolve to writes through this interface on modern kernels).
    // Pattern: /proc/<numeric pid>/mem
    $file.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase

    // The acting process must not be a known-good debugger or security tool.
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude kernel threads and processes with no resolved binary path,
    // which appear as empty strings in UDM and are not injection actors.
    $file.principal.process.file.full_path != ""

    // Exclude the process modifying its OWN /proc entry (self-modification
    // used by some JIT runtimes). We cannot compare PIDs directly in YARA-L,
    // but we can exclude the most common self-modifying runtimes by path.
    // Operators should extend %global_allowed_security_tools for JVM/node.
    not $file.principal.process.file.full_path = /\/(java|node|python[23]?|ruby|mono)$/ nocase

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity    = array_distinct($file.principal.hostname)
    $injecting_process = array_distinct($file.principal.process.file.full_path)
    $target_mem_path   = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
