/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:19:03.852472+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_ProcInject_SharedMem_Artifact {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file artifacts written to anonymous or named shared-memory and world-writable temporary paths that are characteristic of Linux process injection staging. Attackers commonly write shellcode or a shared library to /dev/shm, /run/shm, /tmp, or /var/tmp before mapping it into a target process via memfd_create, ptrace, or LD_PRELOAD. This rule fires on the FILE_CREATION artifact rather than the process-launch command line, providing a complementary detection layer that is harder to evade."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires Linux EDR or auditd file-create telemetry normalised to UDM FILE_CREATION. The sensor must capture file events under /dev/shm, /run/shm, /tmp, /var/tmp, and /proc/*/fd."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "JVM and .NET runtimes legitimately write shared libraries to /tmp; some IPC frameworks use /dev/shm for message queues; container runtimes may stage layers under /tmp. Tune by adding known-good parent processes to %global_allowed_backup_processes or %global_allowed_security_tools."
    tuning_guidance = "Add trusted runtime parent process paths (e.g. java, dotnet, containerd) to %global_allowed_admin_tools. Narrow the rule further by requiring the file extension to match .so or no extension combined with executable permissions if your EDR surfaces file-mode metadata."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: files created in shared-memory or world-writable staging paths
    // that are commonly abused for injection payload staging.
    // Matches: /dev/shm/*, /run/shm/*, /tmp/*, /var/tmp/*
    // Also matches memfd-style anonymous files surfaced under /proc/<pid>/fd/
    $file.target.file.full_path = /^(\/dev\/shm\/|\/run\/shm\/|\/tmp\/|\/var\/tmp\/|\/proc\/[0-9]+\/fd\/)/ nocase

    // Restrict to files that look like shared objects, position-independent
    // executables, or have no extension at all (raw shellcode blobs).
    // Legitimate temp files from package managers typically carry .rpm/.deb/.tar suffixes.
    $file.target.file.full_path = /\.(so(\.[0-9]+)*|bin|elf|mem|shm|dat|img|raw|tmp|x)$|\/[^.\/]+$/ nocase

    // Exclude known-good backup and security agent writers
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude common benign runtimes that legitimately stage libraries in /tmp
    not $file.principal.process.file.full_path = /\/(java|python[0-9.]*|node|ruby|perl|dotnet|containerd|dockerd|podman|snapd|apt|dpkg|rpm|yum|dnf|zypper|pip[0-9.]*)$/ nocase

    // Exclude service accounts known to perform legitimate privileged writes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($file.principal.hostname)
    $staging_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
