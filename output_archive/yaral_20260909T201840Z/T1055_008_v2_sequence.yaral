/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:24:18.533430+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injection_ProcMem_Write_Then_Suspicious_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a potential ptrace-based process injection sequence: a non-debugger process opens /proc/<pid>/mem (used by ptrace to write into a target process address space) followed by creation of a suspicious artifact in a world-writable or temporary directory on the same host within 5 minutes. This combination is characteristic of ptrace injection tooling that writes a payload into a running process and then drops a staging file."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. Auditd rules must capture openat/open syscalls on /proc/*/mem and file creation events in /tmp, /dev/shm, /var/tmp, and /run/shm."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, lldb) and profilers (perf, valgrind) that open /proc/<pid>/mem. Security agents performing memory scanning. Java/JVM runtimes that use /proc/self/mem for JIT operations."
    tuning_guidance = "Add known debugger and profiler parent process paths to %global_allowed_security_tools. Add authorised service account names to %global_allowed_service_accounts. Narrow the world-writable path regex if /tmp activity is noisy in the environment."

  events:
    // Event 1: A process opens /proc/<pid>/mem - the primary mechanism for
    // ptrace-based memory writes without requiring PTRACE_POKEDATA privileges.
    // FILE_MODIFICATION covers the open-for-write access to the proc pseudo-file.
    $open.metadata.event_type = "FILE_MODIFICATION"
    $open.target.file.full_path = /\/proc\/[0-9]+\/mem$/
    not $open.principal.process.file.full_path = /\/(gdb|strace|ltrace|lldb|perf|valgrind|python[0-9.]*|java)$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.user.userid in %global_allowed_service_accounts
    $open.principal.hostname = $hostname

    // Event 2: Within the same time window on the same host, a file is created
    // in a world-writable or temporary directory - consistent with dropping a
    // payload or shared-memory staging artifact used by ptrace injection tooling.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|dev\/shm|var\/tmp|run\/shm|run\/user\/[0-9]+)\//
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: proc/mem access precedes artifact drop
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($hostname)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $injecting_user = array_distinct($open.principal.user.userid)
    $proc_mem_targets = array_distinct($open.target.file.full_path)
    $dropped_artifacts = array_distinct($file.target.file.full_path)
    $artifact_creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $open and $file
}
