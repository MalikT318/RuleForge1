/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:24:41.315223+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Proc_Mem_Maps_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read access to /proc/<pid>/maps or /proc/<pid>/mem by a process other than the process itself, which is a strong indicator of T1055.009 proc memory injection. Attackers enumerate /proc/[pid]/maps to discover memory layout and gadgets, then overwrite the target stack via /proc/[pid]/mem or using dd against the mem pseudo-file. This rule fires on the FILE_READ artifact produced by that enumeration, providing coverage at a different abstraction layer than command-line detection."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd with file-read (open/openat) syscall auditing enabled for /proc filesystem paths. Auditd rule example: -a always,exit -F arch=b64 -S open,openat -F dir=/proc -F success=1 -k proc_injection"
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers (gdb, lldb, strace), security scanners, performance profilers (perf, valgrind), container runtimes inspecting child processes, backup agents, and legitimate monitoring daemons that enumerate /proc for telemetry. Tune using %global_allowed_security_tools and %global_allowed_backup_processes."
    tuning_guidance = "Add known-good monitoring and debugging binaries to %global_allowed_security_tools. Add backup and profiling agents to %global_allowed_backup_processes. Consider narrowing by restricting to processes whose principal PID differs from the numeric PID component in the target path, if your EDR populates that field."

  events:
    $open.metadata.event_type = "FILE_READ"

    // Target must be a /proc/<numeric-pid>/maps or /proc/<numeric-pid>/mem pseudo-file.
    // The numeric PID segment distinguishes process-specific entries from /proc/self or /proc/sys.
    $open.target.file.full_path = /\/proc\/[0-9]+\/(maps|mem|smaps|pagemap)$/ nocase

    // Exclude the process reading its own /proc entry (self-inspection is benign).
    // EDR agents populate principal.process.pid; we match it against the PID in the path.
    // We cannot do arithmetic here, so we exclude the /proc/self/ form and rely on
    // reference-list exclusions for known-good tools.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude common legitimate debugger and profiler binaries by path pattern.
    // Using a broad regex so renamed copies are not automatically excluded.
    not $open.principal.process.file.full_path = /\/(gdb|lldb|strace|ltrace|perf|valgrind|heaptrack|systemd|dockerd|containerd|runc|lxc-attach|ps|top|htop|procps)$/ nocase

    // Require the reading process to have a real executable path (filters kernel threads).
    $open.principal.process.file.full_path = /^\/.+/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($open.principal.hostname)
    $reading_process = array_distinct($open.principal.process.file.full_path)
    $target_proc_path = array_distinct($open.target.file.full_path)
    $actor_userid = array_distinct($open.principal.user.userid)

  condition:
    $open
}
