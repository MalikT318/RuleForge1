/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:19:51.979518+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process opening a handle to a remote process with permissions consistent with DLL injection (PROCESS_VM_WRITE + PROCESS_CREATE_THREAD or PROCESS_VM_OPERATION). Attackers must request these access rights to write a DLL path into the target process and invoke CreateRemoteThread. This rule pivots on the PROCESS_OPEN telemetry layer rather than command-line arguments, providing additive coverage over process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR or Sysmon Event ID 10 (ProcessAccess) normalised to UDM PROCESS_OPEN with target.process.file.full_path and additional.fields containing the granted access mask or access rights string."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers (WinDbg, x64dbg), profilers, legitimate AV/EDR agents opening process handles, JIT compilers, game anti-cheat engines, and some RMM tools."
    tuning_guidance = "Add known-good opener binaries (debuggers, security agents) to %global_allowed_security_tools and %global_allowed_admin_tools. Narrow further by excluding processes whose parent is a known-good deployment or patching tool."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener must not be a recognised security or admin tool
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Opener is not a Windows system binary (system32 / syswow64 / sysmon itself)
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\/
    not $open.principal.process.file.full_path = /(?i)\\windows\\syswow64\\/
    not $open.principal.process.file.full_path = /(?i)\\windows\\sysmon/

    // Target is a meaningful host process worth injecting into
    // (exclude self-opens and kernel/idle)
    $open.target.process.file.full_path = /(?i)\\(lsass|svchost|explorer|winlogon|csrss|wininit|services|spoolsv|dllhost|rundll32|regsvr32|msiexec|taskhost|taskhostw|RuntimeBroker|SearchIndexer|SearchHost|sihost|ctfmon|dwm|audiodg|wlanext|conhost|msedge|chrome|firefox|iexplore|outlook|WINWORD|EXCEL|POWERPNT)\.exe$/

    // Access rights string must indicate write + thread-creation capability
    // EDR/Sysmon normalise the granted access mask into a readable string or hex;
    // match patterns that include VM_WRITE combined with CREATE_THREAD or VM_OPERATION.
    // Sysmon logs the hex mask in GrantedAccess; many EDRs surface a decoded string.
    $open.target.process.command_line = /(?i)(PROCESS_VM_WRITE|0x[0-9a-f]*[28][0-9a-f]{3,})/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)

  condition:
    $open
}
