/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:19:28.656123+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_Process_Open_Then_Remote_Thread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a classic process injection sequence: a suspicious process opens a handle to a remote process (PROCESS_OPEN) and then launches a child process or loads a module shortly after, indicating possible shellcode execution or reflective DLL injection. This provides additive coverage beyond command-line heuristics by focusing on cross-process handle acquisition followed by observable post-injection activity."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_OPEN events (Sysmon Event ID 10) and PROCESS_LAUNCH events with parent/child lineage. Both event types must be normalised into UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tools (EDR agents, AV), debuggers (WinDbg, x64dbg), JIT compilers (.NET CLR, JVM), legitimate RMM agents, and software installers that open handles to other processes for monitoring or patching."
    tuning_guidance = "Add known-good security and monitoring tool paths to %global_allowed_security_tools. Add approved admin tooling to %global_allowed_admin_tools. Narrow the injector process exclusion to specific parent paths observed in your environment."

  events:
    // Event 1: A non-system process opens a handle to a remote process.
    // PROCESS_OPEN is produced by Sysmon Event ID 10 / EDR cross-process telemetry.
    $open.metadata.event_type = "PROCESS_OPEN"

    // Injector must not be a known security or admin tool
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

    // Injector is not living under typical system directories (catches userland injectors)
    // Exclude common system paths: Windows\System32, Windows\SysWOW64, Program Files
    not $open.principal.process.file.full_path = /(?i)^[A-Za-z]:\\Windows\\(System32|SysWOW64|WinSxS)\\/
    not $open.principal.process.file.full_path = /(?i)^[A-Za-z]:\\Program Files/

    // Target of the handle open must be a high-value system process (common injection targets)
    $open.target.process.file.full_path = /(?i)\\(lsass|svchost|explorer|winlogon|csrss|wininit|services|spoolsv|RuntimeBroker|SearchIndexer)\.exe$/

    // Capture the injecting process path as the join key
    $open.principal.process.file.full_path = $injector_path
    $open.principal.hostname = $hostname

    // Event 2: The same injecting process (by path) subsequently launches a child process.
    // This represents post-injection execution: the injected payload spawning further activity.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = $injector_path
    $proc.principal.hostname = $hostname

    // The child spawned post-injection should look suspicious:
    // interpreters, shells, or reconnaissance binaries commonly used after injection
    $proc.target.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic|net|whoami|ipconfig|nltest|tasklist|sc)\.exe$/

    // Exclude service accounts and automation that legitimately spawn these children
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: handle open must precede the child launch
    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $injector_path over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($open.principal.hostname)
    $injector_process = array_distinct($open.principal.process.file.full_path)
    $injection_target = array_distinct($open.target.process.file.full_path)
    $child_processes_spawned = array_distinct($proc.target.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)
    $open_event_count = count($open.metadata.id)

  condition:
    $open and $proc
}
