/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:20:38.163042+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process opening a handle to a remote process with permissions consistent with PE injection (PROCESS_VM_WRITE + PROCESS_VM_OPERATION + PROCESS_CREATE_THREAD). PE injection requires writing a PE image into the target address space and creating a remote thread; this combination of access rights on a cross-process handle is a strong behavioral indicator regardless of the injecting binary name."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR or Sysmon Event ID 10 (ProcessAccess) telemetry normalised to UDM PROCESS_OPEN with target.process.access_mask or equivalent field populated. CrowdStrike, SentinelOne, and Sysmon all emit this event type."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers (Visual Studio, WinDbg), legitimate crash-reporting agents, some AV/EDR self-protection routines, JIT compilers (JVM, .NET CLR), and certain RMM tools that inject helper DLLs. Tune using the reference lists below."
    tuning_guidance = "Add known-good opener binaries to %global_allowed_security_tools (EDR agents) or %global_allowed_admin_tools (debuggers, RMM). Add service accounts that legitimately perform cross-process operations to %global_allowed_service_accounts. Consider narrowing by restricting the target process to high-value processes (lsass, svchost, explorer) if noise is high."

  events:
    // PROCESS_OPEN is emitted when one process opens a handle to another (Sysmon EID 10 / EDR equivalent)
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener must not be a Windows system binary from a trusted system path
    // Matches processes NOT running from System32 / SysWOW64 / WinSxS
    not $open.principal.process.file.full_path = /(?i)\\(windows\\system32|windows\\syswow64|windows\\winsxs)\\/

    // Opener must not be a known security or admin tool
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Principal user must not be a known service account
    not $open.principal.user.userid in %global_allowed_service_accounts

    // Target process access mask must include the three rights required for PE injection:
    //   0x0002 PROCESS_CREATE_THREAD
    //   0x0008 PROCESS_VM_OPERATION
    //   0x0020 PROCESS_VM_WRITE
    // Combined minimum mask = 0x002A (decimal 42).
    // EDRs and Sysmon normalise the raw access mask into target.process.access_mask (integer).
    // We match the hex string representation as populated by most UDM normalisers,
    // covering the exact injection-capable mask as well as broader masks that include it
    // (e.g. PROCESS_ALL_ACCESS = 0x1FFFFF).
    $open.target.process.access_mask = /(?i)0x(001f0fff|1fffff|0*[0-9a-f]*[2-9a-f][0-9a-f])/

    // Require a target process to be identified (populated field guard)
    $open.target.process.file.full_path = /.+/

    // Exclude self-opens (process opening itself - normal for many runtimes)
    // by ensuring opener PID != target PID where telemetry provides both
    // (Chronicle populates principal.process.pid and target.process.pid when available)
    $open.principal.process.pid != $open.target.process.pid

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $access_mask_observed = array_distinct($open.target.process.access_mask)
    $opener_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
