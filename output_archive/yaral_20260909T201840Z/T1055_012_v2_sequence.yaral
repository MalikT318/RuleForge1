/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:26:43.931564+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_ProcessHollowing_SuspendedChildNetworkBeacon {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a process-hollowing pattern: a legitimate Windows host process is launched (candidate for hollowing) and then makes an outbound network connection to a non-RFC1918 address shortly after. Process hollowing typically spawns a suspended legitimate binary, replaces its image, then resumes it - the resumed hollow shell then beacons out. This rule joins the PROCESS_OPEN (handle acquisition to a child for memory manipulation) event with the subsequent NETWORK_CONNECTION from the same host, providing additive coverage beyond command-line matching."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN events (handle opens with VM_WRITE / SUSPEND access rights) and NETWORK_CONNECTION events. CrowdStrike Falcon, Microsoft Defender for Endpoint, and Sysmon Event ID 10 + 3 satisfy this requirement after UDM normalisation."
    log_source      = "windows_endpoint"
    platform        = "Windows"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg) opening handles to child processes; JIT compilers (CLR, V8) writing to child process memory; software updaters that spawn and patch child processes; security agents performing self-inspection."
    tuning_guidance = "Add known-good parent process paths (debuggers, JIT hosts, update agents) to %global_allowed_security_tools or %global_allowed_admin_tools. Add approved external destinations to %global_allowed_domains. Raise the risk score if the parent process is not a recognised development tool."

  events:
    // Event 1: A process opens a handle to another process with rights
    // consistent with hollowing (write + suspend/resume). EDR normalises
    // these as PROCESS_OPEN with the target being the hollowed victim.
    // We narrow to common hollowing victims: legitimate Windows host processes
    // that are plausible decoys (svchost, explorer, notepad, RuntimeBroker, etc.)
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(svchost|explorer|notepad|RuntimeBroker|dllhost|werfault|conhost|msiexec|regsvr32|rundll32|wscript|cscript|mshta)\.exe$/
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname

    // Event 2: A network connection originates from the same host to an
    // external (non-RFC1918) address. The connecting process is one of the
    // same hollowing-victim binaries, indicating the hollowed shell is now
    // beaconing. We require the process name to overlap with hollowing victims
    // to tighten the join and avoid Cartesian explosion.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(svchost|explorer|notepad|RuntimeBroker|dllhost|werfault|conhost|msiexec|regsvr32|rundll32|wscript|cscript|mshta)\.exe$/
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the network beacon
    $open.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(90)
    $mitre_technique_id  = array_distinct("T1055.012")
    $primary_entity      = array_distinct($hostname)
    $hollowed_process    = array_distinct($net.principal.process.file.full_path)
    $opener_process      = array_distinct($open.principal.process.file.full_path)
    $destination_ips     = array_distinct($net.target.ip)
    $destination_ports   = array_distinct($net.target.port)

  condition:
    $open and $net
}
