/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:22:41.918875+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Suspended_Process_Then_Remote_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with Early Bird APC injection: a non-standard parent process creates a child in a suspended or hollowed state (via flags visible in command-line or process lineage), followed shortly by a PROCESS_OPEN event from a different process targeting the same host. This two-stage sequence is additive coverage over command-line-only rules and targets the OS-level handle acquisition that APC injection requires."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_LAUNCH and PROCESS_OPEN events with process lineage and command-line fields populated. Sysmon Event IDs 1 and 10 map to these UDM types."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers (Visual Studio, WinDbg), legitimate process hollowing in security tools, some installers that create suspended child processes, JIT compilers. Tune via %global_allowed_security_tools and %global_allowed_admin_tools."
    tuning_guidance = "Add known-good parent process paths that legitimately spawn suspended children to %global_allowed_admin_tools. Add security agent binaries that open cross-process handles to %global_allowed_security_tools."

  events:
    // Event 1: A suspicious parent spawns a child process.
    // We look for processes that are NOT common, trusted launchers
    // spawning executables - the key signal is the parent being
    // an unexpected binary (script host, document reader, browser, etc.)
    // combined with the child being a native Windows executable that
    // is commonly abused as an APC injection target.
    $launch.metadata.event_type = "PROCESS_LAUNCH"
    $launch.principal.process.file.full_path = /\\(wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|powershell|pwsh|cmd)\.exe$/ nocase
    $launch.target.process.file.full_path = /\\(svchost|lsass|explorer|notepad|RuntimeBroker|dllhost|taskhost|taskhostw|conhost|WerFault|spoolsv)\.exe$/ nocase
    not $launch.principal.process.file.full_path in %global_allowed_admin_tools
    not $launch.principal.process.file.full_path in %global_allowed_security_tools
    $launch.principal.hostname = $hostname

    // Event 2: A PROCESS_OPEN event on the same host where a process
    // acquires a handle to another process. This is the handle-acquisition
    // step required before QueueUserAPC or WriteProcessMemory can be called.
    // The opener must be different from the common trusted security agents.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\\(wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|powershell|pwsh|cmd)\.exe$/ nocase
    $open.target.process.file.full_path = /\\(svchost|lsass|explorer|notepad|RuntimeBroker|dllhost|taskhost|taskhostw|conhost|WerFault|spoolsv)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname

    // Chronological ordering: process launch must precede the handle open
    $launch.metadata.event_timestamp.seconds <= $open.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($launch.principal.hostname)
    $spawning_process = array_distinct($launch.principal.process.file.full_path)
    $spawned_target = array_distinct($launch.target.process.file.full_path)
    $handle_opener = array_distinct($open.principal.process.file.full_path)
    $handle_target = array_distinct($open.target.process.file.full_path)
    $affected_user = array_distinct($launch.principal.user.userid)

  condition:
    $launch and $open
}
