/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:20:09.959287+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_Process_Open_Followed_By_Remote_Thread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process opening another process with memory access rights followed by module load in the target, indicating potential DLL injection via CreateRemoteThread or similar techniques."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR telemetry capturing process open events with access rights and module load events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers, security tools, backup agents, RMM software, legitimate inter-process communication by system services."
    tuning_guidance = "Add approved debugging and security tooling to %global_allowed_security_tools. Add backup software to %global_allowed_backup_processes."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\.exe$/ nocase
    $open.target.process.file.full_path = /\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path = /\\windows\\system32\\/ nocase
    not $open.principal.process.file.full_path = /\\windows\\syswow64\\/ nocase
    $open.principal.hostname = $hostname
    $open.target.process.pid = $target_pid

    $load.metadata.event_type = "PROCESS_MODULE_LOAD"
    $load.target.process.pid = $target_pid
    $load.target.file.full_path = /\.dll$/ nocase
    not $load.target.file.full_path = /\\windows\\system32\\/ nocase
    not $load.target.file.full_path = /\\windows\\syswow64\\/ nocase
    not $load.target.file.full_path = /\\program files\\/ nocase
    not $load.target.file.full_path = /\\program files \(x86\)\\/ nocase
    $load.principal.hostname = $hostname

    $open.metadata.event_timestamp.seconds <= $load.metadata.event_timestamp.seconds

  match:
    $hostname, $target_pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $injector_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $loaded_dll = array_distinct($load.target.file.full_path)

  condition:
    $open and $load
}
