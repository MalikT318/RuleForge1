/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:21:57.022755+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_OpenHandle_Then_Suspicious_Child {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects thread execution hijacking: a non-system process opens a handle to a remote process (PROCESS_OPEN) and within 5 minutes that same host spawns an anomalous child from a normally-headless system process, indicating the hijacked thread has executed injected code. This is additive coverage over command-line rules and focuses on the post-injection execution artefact."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target process path populated (e.g. CrowdStrike, SentinelOne, Sysmon Event ID 10) and PROCESS_LAUNCH events with parent/child lineage."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), AV/EDR agents performing memory scanning, JIT compilers, and profiling tools that open handles to other processes. Approved security tooling should be added to %global_allowed_security_tools."
    tuning_guidance = "Add known-good parent processes that legitimately spawn children from system process contexts to %global_allowed_security_tools. Narrow the suspicious child list if specific LOLBins dominate false positives in the environment."

  events:
    // Event 1: A non-system, non-security process opens a handle to a remote process.
    // PROCESS_OPEN is the UDM event type for OpenProcess/OpenThread API calls captured by EDR.
    $open.metadata.event_type = "PROCESS_OPEN"
    // The opener must not itself be a known system binary
    not $open.principal.process.file.full_path = /(?i)\\(svchost|lsass|csrss|wininit|services|smss|winlogon|ntoskrnl)\.exe$/
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    // The target being opened is a legitimate system process (classic hijack target)
    $open.target.process.file.full_path = /(?i)\\(svchost|explorer|lsass|spoolsv|taskhost|taskhostw|dllhost|rundll32|regsvr32|msiexec|werfault|searchindexer|wmiprvse)\.exe$/
    $open.principal.hostname = $hostname

    // Event 2: Within the window, a suspicious child process spawns from a normally-headless
    // system process — the hallmark of injected code executing inside the hijacked thread.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    // Parent is one of the system processes that should never spawn interactive children
    $proc.principal.process.file.full_path = /(?i)\\(svchost|spoolsv|dllhost|taskhost|taskhostw|wmiprvse|searchindexer|msiexec)\.exe$/
    // Child is a shell, script host, or reconnaissance binary — anomalous from these parents
    $proc.target.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic|net|whoami|ipconfig|nltest|ping|curl|wget)\.exe$/
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the anomalous child spawn
    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $hijacked_target = array_distinct($open.target.process.file.full_path)
    $spawned_child = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $open and $proc
}
