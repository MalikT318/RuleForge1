/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:23:04.652549+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Injection_Process_Handle_Open {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a suspicious process opening a handle to a remote process with VM_WRITE and VM_OPERATION access rights, a prerequisite for TLS callback injection. Attackers must allocate and write shellcode into the target process address space before manipulating TLS callback pointers. This rule pivots on the PROCESS_OPEN event (handle acquisition) rather than command-line telemetry, providing additive coverage over process-creation rules."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires EDR or Sysmon Event ID 10 (ProcessAccess) normalised to PROCESS_OPEN in UDM. The EDR must capture cross-process handle requests with access mask details surfaced in target.process.access_mask or equivalent fields."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), profilers, crash-dump collectors, AV/EDR agents performing memory scanning, and some RMM tools that inject helper DLLs. Exclude known-good binaries via %global_allowed_security_tools and %global_allowed_admin_tools."
    tuning_guidance = "Add trusted parent process paths to %global_allowed_security_tools or %global_allowed_admin_tools. Consider narrowing by requiring the opening process to reside outside of C:\\Windows\\System32 and C:\\Program Files. Raise severity if the target process is a high-value host such as lsass.exe or a browser."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must NOT be a known Windows system process performing legitimate cross-process work.
    // Suspicious openers are typically user-land binaries outside standard OS paths.
    not $open.principal.process.file.full_path = /(?i)^C:\\Windows\\System32\\/ nocase
    not $open.principal.process.file.full_path = /(?i)^C:\\Windows\\SysWOW64\// nocase

    // Target process is a running executable - TLS injection requires a live host process.
    // Restrict to common injection targets: browsers, office apps, or any .exe outside system dirs.
    $open.target.process.file.full_path = /(?i)\.exe$/

    // Exclude the opener being the same binary as the target (self-open is benign).
    // We approximate this by ensuring the principal and target process paths differ.
    // Chronicle evaluates this as a field inequality.
    not $open.principal.process.file.full_path = $open.target.process.file.full_path

    // Exclude approved security tooling that legitimately opens process handles.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known-good service accounts performing automation.
    not $open.principal.user.userid in %global_allowed_service_accounts

    // Opener should not itself be a recognised administrative tool.
    not $open.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity    = array_distinct($open.principal.hostname)
    $opener_process    = array_distinct($open.principal.process.file.full_path)
    $target_process    = array_distinct($open.target.process.file.full_path)
    $acting_user       = array_distinct($open.principal.user.userid)

  condition:
    $open
}
