/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:23:33.429801+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Injection_Process_Open_Then_Suspicious_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a potential TLS callback injection sequence: a non-system process opens a handle to another process (PROCESS_OPEN), followed by the target process spawning an anomalous child process within 5 minutes. TLS callback injection manipulates PE TLS pointers so malicious code executes before the legitimate entry point, causing the victim process to launch unexpected children. This rule provides additive coverage beyond command-line matching by correlating cross-process handle acquisition with anomalous child process lineage."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_OPEN events (handle acquisition) and PROCESS_LAUNCH events with parent/child lineage. Sysmon Event ID 10 (ProcessAccess) and Event ID 1 (ProcessCreate) are the primary sources."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tooling (EDR agents, AV) legitimately opens process handles. Debuggers and profilers. JIT compilers such as the .NET CLR opening handles to host processes. Software installers that inject into running processes for patching."
    tuning_guidance = "Add known-good security and admin tools to %global_allowed_security_tools to suppress the PROCESS_OPEN side. Add approved parent processes to %global_allowed_admin_tools to suppress the PROCESS_LAUNCH side. Narrow the child process regex if specific interpreters generate excessive noise in your environment."

  events:
    // Event 1: A non-system process acquires a handle to another live process.
    // This is the injection precursor - memory write access is needed for TLS pointer manipulation.
    $open.metadata.event_type = "PROCESS_OPEN"
    // The opener must not be a known system binary - filter to user-space processes
    $open.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|certutil|bitsadmin|explorer|notepad|wordpad|winword|excel|powerpnt|outlook|iexplore|msedge|chrome|firefox)\.exe$/ nocase
    // Target is a common injection victim: a legitimate Windows host process
    $open.target.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|dllhost|taskhost|taskhostw|spoolsv|SearchIndexer|WmiPrvSE|msiexec|conhost)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname

    // Event 2: The victim process (now potentially carrying injected TLS callbacks)
    // spawns an unexpected child - a shell, script host, or network-capable binary.
    $child.metadata.event_type = "PROCESS_LAUNCH"
    // Parent is the same victim process that was targeted by the handle open
    $child.principal.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|dllhost|taskhost|taskhostw|spoolsv|SearchIndexer|WmiPrvSE|msiexec|conhost)\.exe$/ nocase
    // Child is anomalous for these parents: a shell, interpreter, or recon tool
    $child.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|net|whoami|ipconfig|nltest|dsquery|wmic|curl|wget|ftp|tftp|mshta|msbuild|installutil|regasm|regsvcs|cmstp|pcalua|forfiles|esentutl|expand|extrac32|findstr|hh|makecab|mavinject|microsoft\.workflow\.compiler|msdeploy|msdt|msiexec|odbcconf|pcwrun|presentationhost|replace|rpcping|runscripthelper|syncappvpublishingserver|tttracer|verclsid|wab|winrm|xwizard)\.exe$/ nocase
    not $child.principal.process.file.full_path in %global_allowed_script_hosts
    $child.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the anomalous child spawn
    $open.metadata.event_timestamp.seconds <= $child.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $spawned_child = array_distinct($child.target.process.file.full_path)
    $child_command_line = array_distinct($child.target.process.command_line)
    $injection_event_count = count($open.metadata.event_timestamp.seconds)

  condition:
    $open and $child
}
