/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:22:18.110106+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_Process_Handle_Request_For_APC_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process handle requests with PROCESS_VM_WRITE and PROCESS_VM_OPERATION access rights, indicative of APC injection preparation. Attackers use OpenThread/OpenProcess with these rights to queue malicious APCs into remote process threads."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR telemetry capturing process handle requests (Sysmon Event ID 10 equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers, security tools, backup agents, RMM software, legitimate inter-process communication by system utilities."
    tuning_guidance = "Add approved debugging and security tooling to %global_allowed_security_tools. Add backup software to %global_allowed_backup_processes. Exclude service accounts performing legitimate process management via %global_allowed_service_accounts."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path != ""
    $open.principal.process.file.full_path != ""
    
    // Detect handle requests with VM write and operation rights required for APC injection
    $open.target.resource.attribute.labels.key = /(?i)(granted_access|access_mask|desired_access)/
    $open.target.resource.attribute.labels.value = /(?i)0x[0-9a-f]*(1[0-9a-f][0-9a-f]8|14[3-7][0-9a-f]|1[4-9a-f][0-9a-f][0-9a-f]|[2-9a-f][0-9a-f][0-9a-f][0-9a-f])/
    
    // Exclude cross-process access from same binary to itself
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    
    // Exclude system processes opening handles to their children
    not $open.principal.process.file.full_path = /\\(services|svchost|lsass|csrss|wininit|smss)\.exe$/ nocase
    
    // Exclude known security and backup tooling
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.user.userid in %global_allowed_service_accounts
    
    // Exclude common legitimate inter-process scenarios
    not $open.principal.process.file.full_path = /\\(taskmgr|procexp|procexp64|processhacker)\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\windows\\system32\\msiexec\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\windows\\system32\\wbem\\wmiprvse\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($open.principal.hostname)

  condition:
    $open
}
