/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:21:31.785878+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_Process_Handle_Open {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a non-system process opening a handle to a remote thread-ownable process with permissions consistent with Thread Execution Hijacking (THREAD_SUSPEND_RESUME + THREAD_SET_CONTEXT + THREAD_GET_CONTEXT). Attackers call OpenThread with these access rights before SuspendThread/WriteProcessMemory/SetThreadContext/ResumeThread. This rule pivots on the PROCESS_OPEN event produced by EDR/Sysmon rather than command-line telemetry, providing additive coverage that is harder to evade."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) normalised to UDM PROCESS_OPEN with target.process.file.full_path and principal.process.file.full_path populated. The access mask or granted rights field must be surfaced in security_result.description or target.process.access_mask."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Debuggers (WinDbg, x64dbg, Visual Studio debugger), legitimate crash-dump collectors (WER, ProcDump), AV/EDR agents performing memory scanning, profiling tools (VTune, dotTrace). Add these to %global_allowed_security_tools or %global_allowed_admin_tools."
    tuning_guidance = "Scope exclusions via %global_allowed_security_tools for EDR/AV agents and %global_allowed_admin_tools for approved debuggers and profilers. Further narrow by requiring the principal process to reside outside of known system directories if false-positive volume is high."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must NOT be a known system binary running from System32/SysWOW64
    // Legitimate OS components rarely open cross-process thread handles for write+context operations
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\/ 
    not $open.principal.process.file.full_path = /(?i)\\windows\\syswow64\//

    // Target is a running process (not self-open) - target path must be populated
    $open.target.process.file.full_path = /(?i)\.exe$/

    // The access rights combination required for Thread Execution Hijacking:
    // THREAD_SUSPEND_RESUME (0x0002) | THREAD_GET_CONTEXT (0x0008) | THREAD_SET_CONTEXT (0x0010)
    // EDR/Sysmon surfaces this in the granted access mask field normalised into security_result.description
    // Match the hex access mask patterns that include these rights (0x001a and supersets)
    $open.security_result.description = /(?i)(0x001a|0x001b|0x001e|0x001f|0x0028|0x0038|0x003a|0x003b|0x003e|0x003f|0x1f03ff|suspend.*resume|set.*context|thread.*hijack)/

    // Exclude approved security tooling and admin utilities
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity    = array_distinct($open.principal.hostname)
    $opener_process    = array_distinct($open.principal.process.file.full_path)
    $target_process    = array_distinct($open.target.process.file.full_path)
    $access_detail     = array_distinct($open.security_result.description)

  condition:
    $open
}
