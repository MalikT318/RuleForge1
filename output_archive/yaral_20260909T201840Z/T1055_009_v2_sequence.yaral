/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:25:07.041890+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_ProcMem_MapRead_Then_MemWrite {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects the two-stage /proc filesystem memory injection pattern: a process first reads the memory map of a target process (/proc/<pid>/maps) to enumerate gadgets and stack offsets, then writes directly to that process's memory (/proc/<pid>/mem). This sequence is the core mechanism of proc memory injection (T1055.009) and is distinct from simple command-line indicators already covered by existing rules."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that emits FILE_READ and FILE_MODIFICATION events for /proc/<pid>/maps and /proc/<pid>/mem respectively. Auditd rules targeting -w /proc -p rw or equivalent EDR file-access telemetry must be enabled."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Debuggers (gdb, lldb, strace), legitimate profiling tools (perf, valgrind), container runtimes performing introspection, and some JVM/JIT engines that inspect their own /proc entries. Security scanners may also trigger the maps-read leg."
    tuning_guidance = "Add known debugger and profiler parent process paths to %global_allowed_security_tools. Add authorised scanning hosts to %global_allowed_scanners. Narrow the rule further by requiring the reading and writing process to differ from the target PID directory owner."

  events:
    // Leg 1: process reads /proc/<pid>/maps to enumerate memory layout
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/proc\/[0-9]+\/maps$/
    // Exclude self-inspection: the reading process should not be reading its own maps
    // (self-read path would be /proc/self/maps, but some tools resolve the numeric PID)
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.principal.process.pid = $injector_pid

    // Leg 2: same process writes to /proc/<pid>/mem of a (potentially different) process
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/proc\/[0-9]+\/mem$/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.principal.process.pid = $injector_pid

    // Enforce chronological order: maps read must precede mem write
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $injector_pid over 5m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1055.009")
    $primary_entity      = array_distinct($hostname)
    $injector_process    = array_distinct($open.principal.process.file.full_path)
    $maps_paths_read     = array_distinct($open.target.file.full_path)
    $mem_paths_written   = array_distinct($file.target.file.full_path)
    $event_count         = count($file.metadata.event_timestamp.seconds)

  condition:
    $open and $file
}
