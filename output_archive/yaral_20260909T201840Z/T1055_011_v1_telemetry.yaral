/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:25:28.104049+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_Process_Handle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious cross-process handle acquisition consistent with Extra Window Memory (EWM) injection. EWM injection requires an attacker process to open a handle to a target process with VM_WRITE and VM_OPERATION access in order to write shellcode into shared memory sections before redirecting execution via the EWM pointer. This rule pivots on the PROCESS_OPEN telemetry layer rather than command-line arguments, providing additive coverage over process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10) telemetry that records cross-process handle open events with access rights. Sysmon must be configured with ProcessAccess events enabled. UDM event type: PROCESS_OPEN."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), profiling tools, some AV/EDR agents opening handles to monitored processes, RMM tooling performing process inspection."
    tuning_guidance = "Add known-good parent process paths (debuggers, security tools) to %global_allowed_security_tools. Add approved administrative tooling to %global_allowed_admin_tools. Narrow scope by excluding processes whose principal.process.file.full_path matches your EDR agent path."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Attacker process is NOT a known Windows system binary performing legitimate cross-process access.
    // Suspicious openers: scripting hosts, document readers, browsers, or unusual binaries opening GUI processes.
    $open.principal.process.file.full_path = /(?i)\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|certutil|bitsadmin|explorer|winword|excel|powerpnt|msaccess|outlook|acrord32|foxit)\.exe$/

    //(?i) Target is a graphical/windowed process that registers window classes and allocates EWM.
    // EWM injection targets processes with message loops and registered window classes.
    $open.target.process.file.full_path = /(?i)\\(explorer|svchost|lsass|winlogon|csrss|dwm|taskhost|taskhostw|sihost|shellexperiencehost|searchui|startmenuexperiencehost|runtimebroker)\.exe$/

    // Exclude the process opening itself (self-handle is benign).
    $open.principal.process.pid != $open.target.process.pid

    // Exclude known security tooling performing legitimate process inspection.
    not $open.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude approved administrative tools.
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude backup agents that may enumerate processes.
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $target_pid = array_distinct($open.target.process.pid)

  condition:
    $open
}
