/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T20:25:46.392279+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects process opening a handle to a GUI process with PROCESS_VM_WRITE followed by SetWindowLong API calls, indicating potential Extra Window Memory injection."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires EDR telemetry capturing process handle operations and module load events with API call context."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate UI automation frameworks, accessibility tools, debugging utilities, screen readers, window management utilities."
    tuning_guidance = "Add approved automation tools to %global_allowed_security_tools. Exclude known UI testing frameworks and accessibility software."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(explorer|dwm|taskmgr|mmc|notepad|calc|mspaint|winword|excel|powerpnt|chrome|firefox|msedge|iexplore)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path = /\\(csrss|wininit|services|lsass|svchost)\.exe$/ nocase
    $open.principal.hostname = $hostname
    $open.target.process.pid = $target_pid

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = $open.principal.process.file.full_path
    $inj.target.process.pid = $target_pid
    (
      $inj.target.process.command_line = /(?i)setwindowlong/ or
      $inj.target.process.command_line = /(?i)getwindowlong/ or
      $inj.principal.process.command_line = /(?i)setwindowlong/ or
      $inj.principal.process.command_line = /(?i)getwindowlong/
    )
    $inj.principal.hostname = $hostname

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $target_pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($open.principal.hostname)
    $injector_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $injection_count = count_distinct($inj.metadata.id)

  condition:
    $open and $inj
}
