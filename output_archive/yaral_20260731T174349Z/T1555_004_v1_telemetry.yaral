/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:44:04.342944+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_CredentialVault_File_Read_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read access to Windows Credential Manager vault files (.vcrd) or the vault encryption key (Policy.vpol) by processes other than known legitimate Windows credential subsystem binaries. Adversaries reading these files directly attempt to extract encrypted credentials for offline decryption. This rule fires at the file-access layer, providing coverage orthogonal to process-creation/command-line detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR file telemetry with FILE_READ events (e.g., Microsoft Defender for Endpoint, CrowdStrike Falcon, Carbon Black, or Sysmon Event ID 11/15 ingested as FILE_READ). The EDR must capture reads of files under AppData paths."
    platform = "Windows"
    false_positives = "Windows LSASS and credential manager subsystem (lsass.exe, svchost.exe hosting VaultSvc, credential backup utilities). Legitimate backup agents that archive user profiles may also trigger this rule."
    tuning_guidance = "Add known-good credential backup or profile management tool paths to %global_allowed_vault_readers. Consider also scoping by principal.user.userid to exclude dedicated service accounts used by backup solutions."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target the vault credential files and the encryption key file
    $file.target.file.full_path = /\\AppData\\Local\\Microsoft\\(Vault|Credentials)\\.*\.(vcrd|vpol)$/ nocase

    // Exclude the core Windows credential subsystem processes that legitimately read these files
    not $file.principal.process.file.full_path = /\\Windows\\System32\\lsass\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\Windows\\System32\\svchost\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\Windows\\System32\\vaultsvc\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\Windows\\System32\\credwiz\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\Windows\\System32\\rundll32\.exe$/ nocase

    // Exclude known-good backup and admin tools via reference list
    not $file.principal.process.file.full_path in %global_allowed_vault_readers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $vault_file_accessed = array_distinct($file.target.file.full_path)
    $user_context = array_distinct($file.principal.user.userid)

  condition:
    $file
}
