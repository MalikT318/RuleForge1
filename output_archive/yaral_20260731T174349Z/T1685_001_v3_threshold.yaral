/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:52:07.803485+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_Bulk_Audit_Policy_Modification_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a high volume of audit policy modification events originating from a single host within a short window. Adversaries bulk-disable audit subcategories via auditpol.exe or Group Policy to suppress event generation before executing further attack stages. Individual auditpol changes are common during legitimate hardening; the volume and velocity are the signal."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires Windows Security Event Log forwarded to Chronicle. Event ID 4719 (System audit policy was changed) must be enabled via Advanced Audit Policy Configuration > Policy Change > Audit Policy Change. Alternatively, EDR process telemetry capturing auditpol.exe command lines will populate PROCESS_LAUNCH events."
    platform = "Windows"
    false_positives = "Group Policy refresh cycles applying a new audit baseline across a fleet (will appear on many hosts simultaneously, not one). Automated compliance tooling (CIS benchmarks, STIG scripts) run by IT operations. Security product installation that reconfigures audit policy. Scheduled hardening scripts."
    tuning_guidance = "Add known compliance automation hostnames to %global_audit_policy_exempt_hosts. If GPO refresh is the primary false-positive source, correlate with GPRESULT or Group Policy operational log events to suppress. Raise the threshold from 5 to 10 if the environment applies audit policy via GPO frequently. Lower to 3 for high-sensitivity environments."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\auditpol\.exe$/ nocase
    (
      $proc.target.process.command_line = /\/set/ nocase or
      $proc.target.process.command_line = /\/clear/ nocase or
      $proc.target.process.command_line = /\/restore/ nocase
    )
    (
      $proc.target.process.command_line = /no auditing/ nocase or
      $proc.target.process.command_line = /\/success:disable/ nocase or
      $proc.target.process.command_line = /\/failure:disable/ nocase or
      $proc.target.process.command_line = /\/subcategory/ nocase
    )
    not $proc.principal.hostname in %global_audit_policy_exempt_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    $proc.principal.hostname = $src_host

  match:
    $src_host over 10m

  outcome:
    $risk_score = max(
      if(count($proc.metadata.id) >= 10, 90,
      if(count($proc.metadata.id) >= 7, 75,
      65))
    )
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $audit_policy_change_count = count($proc.metadata.id)
    $distinct_subcategories_targeted = array_distinct($proc.target.process.command_line)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 5
}
