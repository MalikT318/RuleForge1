/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:45:39.886091+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_SecretsManager_Enum_Then_Bulk_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud identity that first enumerates/lists secrets in a secrets manager (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault) and then performs bulk secret read/access operations within a short window. Listing followed immediately by targeted reads is a strong indicator of credential harvesting rather than routine application access, which typically reads only the specific secret it needs without prior enumeration."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Requires cloud audit logs ingested into Chronicle UDM: AWS CloudTrail (ListSecrets, GetSecretValue), GCP Cloud Audit Logs (ListSecrets, AccessSecretVersion), Azure Monitor / Activity Logs (SecretList, SecretGet). These must be mapped to USER_RESOURCE_ACCESS events with target.resource.name and metadata.description or target.resource.resource_type populated."
    platform = "IaaS"
    false_positives = "Secrets rotation automation that lists then reads; CI/CD pipelines performing bulk secret retrieval at startup; infrastructure-as-code tooling (Terraform, Pulumi) during plan/apply; secrets scanning compliance tools."
    tuning_guidance = "Add known automation service account user IDs to %global_allowed_secrets_automation_principals. Add known CI/CD source IPs or principal hostnames to %global_allowed_cicd_principals. Raise the threshold on the bulk-read side if rotation jobs legitimately touch many secrets."

  events:
    // Leg 1: Secrets enumeration / list operation
    $enum.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $enum.target.resource.name = /ListSecrets/ nocase or
      $enum.target.resource.name = /list.*secret/ nocase or
      $enum.metadata.description = /ListSecrets/ nocase or
      $enum.metadata.description = /list.*secret/ nocase or
      $enum.metadata.description = /SecretList/ nocase or
      $enum.metadata.description = /secrets\.list/ nocase
    )
    not $enum.principal.user.userid in %global_allowed_secrets_automation_principals
    not $enum.principal.hostname in %global_allowed_cicd_principals
    $enum.principal.user.userid = $cloud_identity

    // Leg 2: Secret read / access operation (bulk - same identity)
    $read.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $read.target.resource.name = /GetSecretValue/ nocase or
      $read.target.resource.name = /AccessSecretVersion/ nocase or
      $read.target.resource.name = /SecretGet/ nocase or
      $read.metadata.description = /GetSecretValue/ nocase or
      $read.metadata.description = /AccessSecretVersion/ nocase or
      $read.metadata.description = /SecretGet/ nocase or
      $read.metadata.description = /get.*secret.*value/ nocase or
      $read.metadata.description = /access.*secret.*version/ nocase
    )
    not $read.principal.user.userid in %global_allowed_secrets_automation_principals
    not $read.principal.hostname in %global_allowed_cicd_principals
    $read.principal.user.userid = $cloud_identity

    // Chronological ordering: enumeration must precede the read
    $enum.metadata.event_timestamp.seconds <= $read.metadata.event_timestamp.seconds

  match:
    $cloud_identity over 10m

  outcome:
    $risk_score = max(82)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity = array_distinct($cloud_identity)
    $enumerated_resource_names = array_distinct($enum.target.resource.name)
    $accessed_secret_names = array_distinct($read.target.resource.name)
    $read_event_count = count($read.metadata.id)
    $source_ips = array_distinct($read.principal.ip)
    $source_hostnames = array_distinct($read.principal.hostname)

  condition:
    $enum and $read
}
