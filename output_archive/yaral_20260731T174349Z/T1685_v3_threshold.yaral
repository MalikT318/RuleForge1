/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:51:32.659557+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1562_001_Repeated_Security_Service_Stop_Attempts {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single host repeatedly stopping, disabling, or killing security-related services and processes within a short window. Individual service-stop events are common; a burst of them targeting security tooling on the same host is a strong indicator of defense impairment activity consistent with T1562.001 (Disable or Modify Tools). Covers sc.exe stop/delete/config, net stop, and taskkill targeting known security service name patterns."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1562.001"
    mitre_technique_name = "Impair Defenses: Disable or Modify Tools"
    log_prerequisites = "Requires EDR process telemetry (e.g., CrowdStrike, SentinelOne, Defender for Endpoint) or Windows Event ID 4688 with full command-line auditing enabled."
    platform = "Windows, Linux"
    false_positives = "Authorized patch management or software deployment agents that restart security services during upgrades; IT automation scripts (Ansible, SCCM, Intune) performing bulk service restarts; security tool self-update routines that temporarily stop their own service."
    tuning_guidance = "Add authorized patch/deployment parent process paths to %global_allowed_service_managers. Raise the threshold count if the environment has aggressive automated patching. Consider scoping to non-business hours for lower-noise alerting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the management binaries used to stop or kill services/processes
    $proc.target.process.file.full_path = /\\(sc|net|net1|taskkill|powershell|pwsh|wmic)\.exe$/ nocase

    // Match command-line patterns that stop, delete, disable, or kill
    $proc.target.process.command_line = /(stop|delete|disabled|kill|terminate|uninstall)/ nocase

    // Match security tool service/process name patterns in the command line
    // Covers AV, EDR, logging agents, SIEM forwarders, IDS sensors, Sysmon, etc.
    $proc.target.process.command_line = /(defender|sense|windefend|mssecflt|securityhealthservice|wscsvc|wdnissvc|mbamdor|mbamservice|mbamtray|carbonblack|cbdefense|cbsensor|crowdstrike|csfalcon|csagent|sentinelone|sentinelagent|cylance|cyoptics|cyupdate|symantec|sepmaster|smc|smcgui|norton|navapsvc|mcafee|mfemms|mfevtp|mfefire|sophos|savservice|sav|hmpalert|malwarebytes|elastic|winlogbeat|filebeat|metricbeat|auditbeat|nxlog|splunkd|splunkuf|sysmon|sysmon64|ossec|wazuh|lacework|qualys|tenable|nessus|rapid7|insight|logrhythm|arcsight|qradar|tanium|illumio|vectra|darktrace|cylera|forescout|cisco\s*amp|amp4ep|trendmicro|tmccsf|tmlisten|ntrtscan|pccntmon|eset|ekrn|egui|bitdefender|bdagent|vsserv|avast|avastsvc|avg|avgui|kaspersky|avp|klnagent|fsecure|fsgk32|fssm32|panda|nano|drweb|comodo|cavwp|vipre|vipreantivirus)/ nocase

    // Exclude known-good automation parent processes
    not $proc.principal.process.file.full_path in %global_allowed_service_managers

    // Group by source host for narrowest entity aggregation
    $proc.principal.hostname = $hostname

  match:
    $hostname over 10m

  outcome:
    // Scale risk score based on volume: base 60, capped at 95
    $risk_score = max(
      if(count($proc.metadata.event_timestamp.seconds) >= 10, 95,
      if(count($proc.metadata.event_timestamp.seconds) >= 7, 85,
      60))
    )
    $mitre_technique_id = array_distinct("T1562.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $distinct_security_targets = array_distinct($proc.target.process.command_line)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $event_count = count($proc.metadata.event_timestamp.seconds)

  condition:
    // Conservative threshold: 5 security-service-stop events in 10 minutes from one host
    #proc >= 5
}
