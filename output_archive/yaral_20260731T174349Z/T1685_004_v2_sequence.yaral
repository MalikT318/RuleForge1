/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:53:54.330965+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Auditd_Stop_Then_Config_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage defense impairment pattern on Linux: first, a process stops or kills the auditd daemon (via systemctl, service, or kill), then within 10 minutes a write or modification occurs to the audit configuration or rules files. This sequence strongly indicates an adversary disabling audit logging before tampering with its configuration to prevent re-enablement."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires EDR process telemetry (e.g., CrowdStrike Falcon, SentinelOne, Auditbeat) providing PROCESS_LAUNCH events with command_line, AND file telemetry providing FILE_MODIFICATION or FILE_CREATION events on /etc/audit/ paths. Both event types must be forwarded to Chronicle."
    platform = "Linux"
    false_positives = "Authorized system administrators performing scheduled auditd maintenance or OS upgrades. Configuration management tools (Ansible, Puppet, Chef) that restart auditd and deploy new audit rules as part of a hardening playbook. Package manager upgrades of the audit package."
    tuning_guidance = "Add authorized admin user IDs to %linux_allowed_audit_admins. Add approved automation hostnames to %global_allowed_config_mgmt_hosts. If CM tools trigger this, scope the exclusion to the CM agent process path in the file event filter."

  events:
    // Stage 1: Process that stops, disables, or kills the auditd daemon
    $stop.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $stop.target.process.file.full_path = /\/(systemctl|service)$/ nocase
        and $stop.target.process.command_line = /(stop|disable|mask|kill)\s+audit/ nocase
      )
      or
      (
        $stop.target.process.file.full_path = /\/kill(all|5)?$/ nocase
        and $stop.target.process.command_line = /audit/ nocase
      )
      or
      (
        $stop.target.process.file.full_path = /\/auditctl$/ nocase
        and $stop.target.process.command_line = /\-e\s+0/ nocase
      )
    )
    not $stop.principal.user.userid in %linux_allowed_audit_admins
    not $stop.principal.hostname in %global_allowed_config_mgmt_hosts
    $stop.principal.hostname = $hostname

    // Stage 2: File write to audit configuration or rules files on the same host
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/etc\/audit\/(audit\.(rules|conf)|rules\.d\/)/ nocase
    not $file.principal.user.userid in %linux_allowed_audit_admins
    not $file.principal.hostname in %global_allowed_config_mgmt_hosts
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: stop happens before config tamper
    $stop.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($stop.principal.hostname)
    $stop_command = array_distinct($stop.target.process.command_line)
    $tampered_file = array_distinct($file.target.file.full_path)
    $acting_user_stop = array_distinct($stop.principal.user.userid)
    $acting_user_file = array_distinct($file.principal.user.userid)
    $stop_process = array_distinct($stop.target.process.file.full_path)

  condition:
    $stop and $file
}
