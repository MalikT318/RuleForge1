/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:44:21.851909+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_CredMgr_VaultFile_Read_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process reading Windows Credential Manager vault files (.vcrd or Policy.vpol) followed by an outbound network connection from the same host within 10 minutes. This sequence indicates credential harvesting from the Credential Locker followed by exfiltration or C2 activity. Intentionally avoids command-line matching to provide additive coverage beyond existing T1555.004 process-launch rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR file-read telemetry (e.g., Sysmon Event ID 11/15 or CrowdStrike file-open events mapped to FILE_READ) and network connection telemetry (NETWORK_CONNECTION). Both must be ingested into Chronicle UDM."
    platform = "Windows"
    false_positives = "Windows Credential Manager service (lsass.exe, svchost.exe) performing routine vault maintenance, backup agents reading user profile directories, roaming profile synchronization tools, antivirus scanning vault directories."
    tuning_guidance = "Add legitimate backup or sync process paths to %credmgr_allowed_vault_readers. Add known-good internal management IPs/ranges to %rfc1918_internal to suppress internal-only connections. Narrow target.file.full_path regex if EDR populates a more specific vault path."

  events:
    // Leg 1: A process reads a Credential Manager vault file
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\AppData\\Local\\Microsoft\\(Vault|Credentials)\\/  nocase
    $file.target.file.full_path = /\.(vcrd|vpol)$/ nocase
    not $file.principal.process.file.full_path = /\\(lsass|svchost|MsSense|MsMpEng|csrss)\.exe$/ nocase
    not $file.principal.process.file.full_path in %credmgr_allowed_vault_readers
    $file.principal.hostname = $hostname

    // Leg 2: The same process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $net_proc_path
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\\(lsass|svchost|MsSense|MsMpEng|csrss)\.exe$/ nocase
    not $net.principal.process.file.full_path in %credmgr_allowed_vault_readers
    $net.principal.hostname = $hostname

    // Chronological ordering: file read must precede network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

    // Correlate the reading process to the connecting process on the same host
    $file.principal.process.file.full_path = $net_proc_path

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $vault_files_accessed = array_distinct($file.target.file.full_path)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $file_read_count = count($file.target.file.full_path)

  condition:
    $file and $net
}
