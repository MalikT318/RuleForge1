/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:45:59.429453+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Suspicious_Network_Proxy_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of system-level network proxy or protocol-routing configuration files on Linux/macOS/Windows that adversaries abuse to redirect application-layer traffic through attacker-controlled infrastructure. This targets the persistent state change produced by C2 channel setup rather than the process that made the change, providing coverage orthogonal to process-creation rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires EDR file-event telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11/2) reporting FILE_CREATION or FILE_MODIFICATION with full target path. On Linux/macOS, auditd or equivalent must capture file writes to /etc and user home directories."
    platform = "Linux, macOS, Windows"
    false_positives = "Legitimate proxy configuration by IT/network teams, VPN clients writing PAC files, browser enterprise policy pushes, configuration management tools (Ansible, Chef, Puppet), corporate MDM agents."
    tuning_guidance = "Add known-good management tool paths to %global_allowed_proxy_config_writers. Scope further by correlating the writing process against %global_allowed_admin_tools. Consider suppressing events where principal.user.userid matches service accounts listed in %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target: proxy/protocol config files across platforms
    // Windows: system proxy registry export artifacts, PAC files, WinHTTP config
    // Linux: /etc/environment, /etc/profile.d/, apt/yum proxy conf, curl/wget rc files
    // macOS: networksetup-managed plist files, curl/wget rc files
    $file.target.file.full_path = /(\/(etc\/(environment|profile\.d\/|apt\/apt\.conf|yum\.conf|dnf\/dnf\.conf|wgetrc|curlrc|proxychains)|home\/[^\/]+\/\.(wgetrc|curlrc|bashrc|bash_profile|zshrc|profile))|[Pp]roxy|\.pac$|proxy\.conf|proxychains\.conf|networksetup|com\.apple\.SystemConfiguration)/ nocase

    // Exclude paths that are clearly benign update/package manager internals
    not $file.target.file.full_path = /\/(var\/cache|tmp\/apt|dpkg\/info)/ nocase

    // Exclude known-good writers via reference list
    not $file.principal.process.file.full_path in %global_allowed_proxy_config_writers
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
