/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:52:28.193130+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_CloudLog_Disable_Then_Suspicious_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a cloud audit logging configuration being disabled or modified, followed within 10 minutes by a sensitive resource access or configuration change on the same principal. Adversaries disable logging first to blind defenders before conducting further malicious activity such as credential harvesting, data exfiltration, or privilege escalation."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1485.002"
    mitre_technique_name = "Disable or Modify Cloud Logs"
    log_prerequisites = "Requires cloud audit logs ingested into Chronicle UDM: AWS CloudTrail, GCP Cloud Audit Logs, Azure Monitor, or M365 Unified Audit Log. Events must populate metadata.event_type as SETTING_MODIFICATION or RESOURCE_PERMISSIONS_CHANGE and USER_RESOURCE_ACCESS or RESOURCE_CREATION."
    platform = "IaaS, SaaS, Identity Provider, Office Suite"
    false_positives = "Authorized cloud operations teams rotating logging configurations during maintenance windows; infrastructure-as-code pipelines (Terraform, CloudFormation) that modify logging settings as part of a deployment; SIEM/SOAR integration accounts that adjust log forwarding destinations."
    tuning_guidance = "Add authorized automation service accounts to %cloud_logging_admin_allowed_principals. Add known CI/CD pipeline user IDs to the same list. Narrow the second event filter to specific high-value resource types if alert volume is high. Consider raising severity only when the acting principal is a human user rather than a service account."

  events:
    // Event 1: Cloud logging is disabled or materially modified
    $log_disable.metadata.event_type = "SETTING_MODIFICATION"
    (
      $log_disable.target.resource.name = /cloudtrail/ nocase or
      $log_disable.target.resource.name = /cloudwatch/ nocase or
      $log_disable.target.resource.name = /audit.?log/ nocase or
      $log_disable.target.resource.name = /diagnostic.?setting/ nocase or
      $log_disable.target.resource.name = /mailbox.?audit/ nocase or
      $log_disable.target.resource.name = /unified.?audit/ nocase or
      $log_disable.target.resource.name = /log.?profile/ nocase or
      $log_disable.target.resource.name = /log.?sink/ nocase
    )
    (
      $log_disable.target.resource.attribute.labels.key = /action|operation|change/ nocase
      $log_disable.target.resource.attribute.labels.value = /stop|disable|delete|remove|bypass|downgrade/ nocase
    )
    $log_disable.principal.user.userid != ""
    not $log_disable.principal.user.userid in %cloud_logging_admin_allowed_principals
    $log_disable.principal.user.userid = $actor

    // Event 2: Sensitive resource access or creation following the logging change
    $post_action.metadata.event_type = "USER_RESOURCE_ACCESS"
    $post_action.principal.user.userid = $actor
    $post_action.principal.user.userid != ""
    not $post_action.principal.user.userid in %cloud_logging_admin_allowed_principals
    (
      $post_action.target.resource.name = /iam|role|policy|credential|secret|key|bucket|storage|blob|snapshot|export|backup/ nocase
    )

    // Chronological ordering: logging disabled before the follow-on action
    $log_disable.metadata.event_timestamp.seconds <= $post_action.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1485.002")
    $primary_entity = array_distinct($actor)
    $log_disable_resource = array_distinct($log_disable.target.resource.name)
    $post_action_resource = array_distinct($post_action.target.resource.name)
    $source_ip = array_distinct($log_disable.principal.ip)
    $post_action_count = count($post_action.metadata.id)

  condition:
    $log_disable and $post_action
}
