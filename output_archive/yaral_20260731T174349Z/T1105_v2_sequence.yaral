/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:50:46.601658+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_FileWrite_Then_Outbound_Network_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects ingress tool transfer by correlating an unexpected file creation in a writable/temp-like directory on a host with a preceding or concurrent outbound network connection from the same host. This catches the network-pull-then-drop pattern without relying on command-line strings, providing additive coverage to process-launch rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires EDR file-creation telemetry (e.g., Sysmon Event ID 11, CrowdStrike, SentinelOne) and network connection telemetry (e.g., Sysmon Event ID 3, EDR netflow). Both event types must be ingested into Chronicle UDM."
    platform = "Windows, Linux, macOS, ESXi"
    false_positives = "Software update agents (SCCM, Intune, Jamf, Chef, Puppet), legitimate package managers downloading to temp directories, developer tooling (npm, pip, cargo), CI/CD build agents, backup agents writing to staging directories."
    tuning_guidance = "Add known software deployment process paths to %global_allowed_download_processes. Add approved internal/CDN subnets to %global_allowed_software_sources. Narrow the file extension regex to executable types only if false-positive volume is high."

  events:
    // Leg 1: Outbound network connection to a non-RFC1918 address
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %global_allowed_software_sources
    // Exclude loopback and link-local
    not $net.target.ip = "127.0.0.1"
    not $net.target.ip = "::1"
    // Exclude RFC1918 ranges via reference list
    not $net.target.ip in %rfc1918_internal
    // Only consider connections on common file-transfer ports or high ports
    // (port 0 means unknown; we accept any non-zero port to stay portable)
    $net.target.port > 0
    not $net.principal.process.file.full_path in %global_allowed_download_processes
    $net.principal.hostname = $hostname

    // Leg 2: File creation in a writable/staging directory shortly after
    $file.metadata.event_type = "FILE_CREATION"
    // Match temp, staging, download, and common adversary drop locations across OSes
    $file.target.file.full_path = /\/(tmp|temp|var\/tmp|dev\/shm|Downloads|staging|upload|drop)|\\(Temp|Tmp|Downloads|AppData\\Local\\Temp|ProgramData\\[^\\]+\\Temp|Users\\[^\\]+\\Downloads)/  nocase
    // Restrict to file types that represent executable or script payloads
    $file.target.file.full_path = /\.(exe|elf|sh|py|pl|rb|ps1|bat|cmd|vbs|js|jar|dll|so|dylib|bin|run|out|php|hta|msi|pkg|deb|rpm|tar|gz|zip|7z|rar)$/  nocase
    not $file.principal.process.file.full_path in %global_allowed_download_processes
    $file.principal.hostname = $hostname

    // Chronological ordering: network connection must precede or coincide with file creation
    $net.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($file.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $dropped_files = array_distinct($file.target.file.full_path)
    $downloading_process = array_distinct($net.principal.process.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $net and $file
}
