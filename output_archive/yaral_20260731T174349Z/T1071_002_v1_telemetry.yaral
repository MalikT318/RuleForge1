/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:47:27.202135+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_FTP_Drop_In_Sensitive_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation events in directories commonly targeted by FTP-based C2 implants and data staging — specifically files written by FTP daemon processes or in FTP root/home paths. Attackers abusing T1071.002 (File Transfer Protocols) frequently drop payloads, scripts, or configuration files via FTP rather than interactive shells, leaving a file artifact even when command-line logging is absent or evaded. This rule targets the resulting file-system state change rather than the FTP client invocation."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires EDR file-creation telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11) ingested into Chronicle UDM. The principal.process.file.full_path field must be populated with the writing process path."
    platform = "Linux, Windows, ESXi, macOS"
    false_positives = "Legitimate FTP servers used for software distribution, backup agents writing to FTP roots, managed file transfer (MFT) platforms such as GoAnywhere or MOVEit, web hosting control panels (cPanel, Plesk). Add known-good writer processes to %global_allowed_ftp_writers and known-good paths to %global_allowed_ftp_drop_paths."
    tuning_guidance = "Populate %global_allowed_ftp_writers with full paths of approved MFT/backup agents. Populate %global_allowed_ftp_drop_paths with approved FTP root directories. Raise severity to Critical if the dropped file extension matches executable types (see regex). Consider correlating with subsequent PROCESS_LAUNCH from the same path."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Written by an FTP daemon, FTP service, or a process whose name suggests
    // an FTP client/server binary. Covers vsftpd, proftpd, pure-ftpd, ftpd,
    // Windows IIS FTP (svchost hosting ftpsvc), FileZilla Server, and generic
    // ftp binaries. Regex is intentionally broad to survive binary renaming
    // attempts that keep the service wrapper name intact.
    (
      $file.principal.process.file.full_path = /[\/\\](vsftpd|proftpd|pure-ftpd|ftpd|in\.ftpd|xferlog|ftpsvc|filezilla\s*server|ftp)([^\/\\]*)?$/ nocase
      or
      // File dropped into a path that is structurally an FTP root, anonymous
      // share, or common FTP staging directory across Linux, Windows, and ESXi.
      // Covers: /var/ftp, /srv/ftp, /home/ftp, /pub, C:\inetpub\ftproot,
      // C:\FTP, /vmfs/volumes staging, and similar.
      $file.target.file.full_path = /([\/\\](var[\/\\]ftp|srv[\/\\]ftp|home[\/\\]ftp|pub[\/\\]|inetpub[\/\\]ftproot|ftproot|ftp[\/\\]pub|ftp[\/\\]incoming|ftp[\/\\]upload|ftp[\/\\]drop|vmfs[\/\\]volumes[\/\\][^\/\\]+[\/\\]ftp))/ nocase
    )

    // Focus on file types that represent executable payloads, scripts,
    // archives, or configuration drops — the artifacts most relevant to C2.
    $file.target.file.full_path = /\.(exe|elf|sh|bash|py|pl|rb|ps1|bat|cmd|vbs|js|jar|war|php|asp|aspx|so|dylib|ko|tar|gz|zip|7z|rar|bin|run|out|cron|conf|cfg|ini|service|timer)$/ nocase

    // Exclude known-good writer processes (MFT platforms, backup agents, etc.)
    not $file.principal.process.file.full_path in %global_allowed_ftp_writers

    // Exclude known-good FTP root paths approved per environment
    not $file.target.file.full_path in %global_allowed_ftp_drop_paths

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
