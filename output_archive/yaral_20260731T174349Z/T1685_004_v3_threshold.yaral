/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:54:12.039375+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Auditd_Config_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of modifications to Linux Audit system configuration files or rule files within a short window. Individual edits may be legitimate maintenance; repeated modifications in rapid succession suggest an adversary iterating to suppress audit logging. Covers writes to /etc/audit/audit.rules, /etc/audit/auditd.conf, /etc/audit/rules.d/, and /etc/audit/audit.conf."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR file telemetry (e.g., Auditbeat FILE_MODIFICATION events, CrowdStrike Falcon, or SentinelOne) reporting target.file.full_path and principal.user.userid."
    platform = "Linux"
    false_positives = "Automated configuration management tools (Ansible, Puppet, Chef, Salt) applying audit policy baselines; security hardening scripts run during provisioning; authorized security engineers performing bulk audit rule updates."
    tuning_guidance = "Add known configuration management service accounts to %global_allowed_audit_config_writers. Reduce the threshold from 5 to 3 in high-sensitivity environments, or raise to 8 in environments with frequent automated policy pushes. Scope exclusions by principal.user.userid rather than hostname to avoid over-suppression."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target Linux Audit system configuration and rule files
    $file.target.file.full_path = /\/etc\/audit\// nocase

    // Narrow to known audit config file names and rules directories
    (
      $file.target.file.full_path = /\/etc\/audit\/audit\.rules$/ nocase or
      $file.target.file.full_path = /\/etc\/audit\/auditd\.conf$/ nocase or
      $file.target.file.full_path = /\/etc\/audit\/audit\.conf$/ nocase or
      $file.target.file.full_path = /\/etc\/audit\/rules\.d\// nocase
    )

    // Exclude known-safe configuration management accounts
    not $file.principal.user.userid in %global_allowed_audit_config_writers

    // Exclude empty/system user context (uid 0 is root - keep it; exclude blank)
    $file.principal.user.userid != ""

    // Group by the narrowest entity: the individual user on a specific host
    $file.principal.user.userid = $userid
    $file.principal.hostname = $hostname

  match:
    $userid, $hostname over 10m

  outcome:
    // Scale risk score with volume: base 55, capped at 95
    $risk_score = max(
      55 +
      (count($file.target.file.full_path) * 8)
    )
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_user = array_distinct($file.principal.user.userid)
    $modified_files = array_distinct($file.target.file.full_path)
    $modification_count = count($file.target.file.full_path)
    $source_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    // Fire when 5 or more distinct modification events occur within the window
    // for the same user on the same host - conservative to reduce noise
    #file >= 5
}
