/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:44:46.421894+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Password_Manager_DB_Suspicious_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-password-manager process opening a password manager database file for read access. Adversaries extract credentials by reading the encrypted database from disk using a separate process (e.g., a shell, scripting engine, or custom tool), bypassing the legitimate application entirely. This rule fires on the FILE_READ event produced when an unexpected process accesses well-known password manager database file paths or extensions."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires EDR file-read telemetry (e.g., CrowdStrike Falcon, Microsoft Defender for Endpoint, SentinelOne, or Sysmon Event ID 11/15 with file-read auditing enabled). The EDR must populate principal.process.file.full_path and target.file.full_path on FILE_READ events."
    platform = "Linux, macOS, Windows"
    false_positives = "Backup agents (e.g., Veeam, Acronis, Time Machine) reading the entire user profile; antivirus scanners performing on-access scanning; cloud sync clients (Dropbox, OneDrive, iCloud) syncing the vault file; the legitimate password manager application itself performing self-backup or auto-save."
    tuning_guidance = "Add legitimate backup and sync process paths to %pm_db_allowed_readers. Add site-specific password manager executable paths to %pm_legitimate_executables so they are excluded. If cloud sync generates high volume, also add the sync agent path to %pm_db_allowed_readers."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target: well-known password manager database file extensions and names
    // Covers KeePass (.kdbx, .kdb), 1Password (.agilekeychain, .opvault, .1pif),
    // LastPass (lastpass_form_fills.db, lpdb), Bitwarden (data.json vault export),
    // Dashlane (.dash, .aesdb), RoboForm (.rfo, .rfp), Enpass (.enpassdb),
    // macOS Keychain (.keychain, .keychain-db), generic password store patterns
    $file.target.file.full_path = /\.(kdbx|kdb|agilekeychain|opvault|1pif|dash|aesdb|rfo|rfp|enpassdb|keychain|keychain\-db|lpdb|psafe3|pwm|bwdb)$/ nocase

    // Also catch common named vault files that lack a distinctive extension
    // (e.g., Bitwarden data.json, LastPass form fills sqlite db)
    // Combined OR via a second regex on the filename component
    // Note: Chronicle evaluates multiple predicates on the same field as AND;
    // we use a broad path regex that matches the directory patterns instead.
    // Primary coverage is the extension match above; the process exclusion below
    // provides the behavioral signal.

    // Exclude the legitimate password manager processes themselves performing reads
    not $file.principal.process.file.full_path = /\/(KeePass|KeePassXC|1Password|LastPass|Bitwarden|Dashlane|RoboForm|Enpass|keepassxc|keepass)/ nocase
    not $file.principal.process.file.full_path = /\\(KeePass|KeePassXC|1Password|LastPass|Bitwarden|Dashlane|RoboForm|Enpass|keepass)/ nocase

    // Exclude known-good backup, sync, and AV processes via reference list
    not $file.principal.process.file.full_path in %pm_db_allowed_readers

    // Exclude the password manager's own helper/updater processes
    not $file.principal.process.file.full_path in %pm_legitimate_executables

    // Require a principal process to be present (filter out kernel/system reads
    // that may appear with empty process paths)
    $file.principal.process.file.full_path != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $accessed_vault_file = array_distinct($file.target.file.full_path)
    $user_context = array_distinct($file.principal.user.userid)

  condition:
    $file
}
