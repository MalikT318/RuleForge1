/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:45:01.583129+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_PasswordMgr_FileRead_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process reading a password manager database file (e.g., KeePass .kdbx, 1Password .agilekeychain/.opvault, Bitwarden data.json, LastPass vault) followed by that same process making an outbound network connection within 10 minutes. This pattern is consistent with credential harvesting from a password manager database followed by exfiltration, and is additive to existing process-launch/command-line detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires EDR file-read telemetry (e.g., Sysmon Event ID 11/15, CrowdStrike file events) and network connection telemetry. Both must be ingested into Chronicle UDM."
    platform = "Linux, macOS, Windows"
    false_positives = "Legitimate password manager applications syncing their vault to a cloud backend (e.g., KeePass with cloud sync plugin, Bitwarden desktop app). Backup agents reading vault files. Security scanners. Browser-integrated password manager extensions."
    tuning_guidance = "Add known-good password manager process paths to %global_allowed_pwmgr_processes. Add approved sync destinations (e.g., cloud provider IP ranges) to %global_allowed_pwmgr_destinations. Consider raising severity if the reading process is NOT a known password manager binary."

  events:
    // Event 1: A process reads a password manager database file
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\.(kdbx|kdb|agilekeychain|opvault|dashlane|psafe3|pwm|bwdb|lpdb)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_pwmgr_processes
    $file.principal.hostname = $hostname
    $file.principal.process.pid = $pid

    // Event 2: The same process (by hostname + pid) makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $hostname
    $net.principal.process.pid = $pid
    not $net.target.ip in %global_allowed_pwmgr_destinations
    not $net.target.ip in %rfc1918_internal

    // Enforce chronological ordering: file read happens before network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $vault_files_accessed = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $file and $net
}
