/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:53:36.032582+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_SecurityUI_Spoof_Burst {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Threshold"
    severity        = "High"
    description     = "Detects a burst of process launches within a short window where processes impersonate or reference security-tool UI components (system tray icons, notification windows, health dashboards) from an unusual parent or working path. A single such launch may be benign; repeated launches from the same host in 10 minutes suggest an adversary cycling fake security-tool UI processes to maintain the appearance of protection after disabling the real agent."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires EDR process-launch telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 1) forwarded to Chronicle as PROCESS_LAUNCH UDM events with command_line and parent process path populated."
    platform        = "Windows, Linux, macOS"
    false_positives = "Security product auto-updaters that restart their tray agent repeatedly; software deployment tools (SCCM, Intune) pushing AV updates; RMM agents restarting endpoint protection components; developer workstations running UI test harnesses for security products."
    tuning_guidance = "Add known-good parent process paths (e.g., your RMM agent, software deployment tool) to %global_allowed_security_ui_parents. Raise the threshold count if your environment legitimately restarts security tray agents frequently. Lower severity for hosts in %global_dev_workstations."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match processes whose command line or binary path references common
    // security-tool UI surface keywords: tray icons, notification agents,
    // health/status dashboards, or explicit "SecurityHealth" components.
    // Using broad regex so renamed wrappers that still carry the UI keyword
    // in their arguments are caught.
    (
      $proc.target.process.command_line = /security.*health/        nocase or
      $proc.target.process.command_line = /securitycenter/          nocase or
      $proc.target.process.command_line = /defender.*tray/          nocase or
      $proc.target.process.command_line = /av.*notify/              nocase or
      $proc.target.process.command_line = /antivirus.*status/       nocase or
      $proc.target.process.command_line = /endpoint.*protection.*ui/ nocase or
      $proc.target.process.command_line = /edr.*agent.*ui/          nocase or
      $proc.target.process.command_line = /systray.*security/       nocase or
      $proc.target.process.file.full_path = /SecurityHealth/        nocase or
      $proc.target.process.file.full_path = /SecurityCenter/        nocase or
      $proc.target.process.file.full_path = /DefenderTray/          nocase or
      $proc.target.process.file.full_path = /AVNotify/              nocase or
      $proc.target.process.file.full_path = /EPProtectionUI/        nocase
    )

    // Exclude launches whose parent is a known-legitimate security product
    // installation directory or an approved admin tool.
    not $proc.principal.process.file.full_path in %global_allowed_security_ui_parents

    // Exclude processes launched from canonical Windows security directories;
    // a spoofed UI is unlikely to live in the real product path.
    not $proc.target.process.file.full_path = /\\Windows Defender\\/  nocase
    not $proc.target.process.file.full_path = /\\Microsoft Security Client\\/ nocase

    $proc.principal.hostname = $hostname

  match:
    $hostname over 10m

  outcome:
    // Scale risk with volume: base 45, capped at 90.
    // count() returns the number of matching events in the window.
    $risk_score = max(
      if(count($proc.metadata.event_type) >= 15, 90,
      if(count($proc.metadata.event_type) >= 10, 75,
      if(count($proc.metadata.event_type) >= 5,  60,
         45)))
    )
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity     = array_distinct($proc.principal.hostname)
    $triggering_user    = array_distinct($proc.principal.user.userid)
    $spawned_binaries   = array_distinct($proc.target.process.file.full_path)
    $parent_processes   = array_distinct($proc.principal.process.file.full_path)
    $event_count        = count($proc.metadata.event_type)

  condition:
    // Conservative threshold: 5 matching launches in 10 minutes from one host.
    #proc >= 5
}
