/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:51:50.219765+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Service_Disabled_Then_Cleared {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage defense impairment pattern: first the Windows EventLog service is disabled or stopped via sc.exe or PowerShell, then within 10 minutes a process clears or wipes an event log channel using wevtutil or PowerShell. The combination strongly indicates deliberate audit-trail destruction rather than accidental misconfiguration."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires EDR process telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint) or Windows Security Event 4688 with full command-line auditing enabled. Both PROCESS_LAUNCH events must be forwarded to Chronicle."
    platform = "Windows"
    false_positives = "Authorized IT operations that stop the EventLog service during maintenance windows and subsequently rotate logs. Security baseline hardening scripts that disable legacy log channels. SIEM agent reinstallation procedures that clear logs before re-enrollment."
    tuning_guidance = "Add authorized maintenance account usernames to %global_eventlog_maintenance_users. Add approved automation host names to %global_eventlog_maintenance_hosts. Raise the time window or add a shift-hours filter if your environment performs scheduled log rotation."

  events:
    // Stage 1: EventLog service disabled or stopped
    $svc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $svc.target.process.file.full_path = /\\sc\.exe$/ nocase
        and
        (
          $svc.target.process.command_line = /\bconfig\b/ nocase
          or
          $svc.target.process.command_line = /\bstop\b/ nocase
        )
        and $svc.target.process.command_line = /\beventlog\b/ nocase
      )
      or
      (
        $svc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        (
          $svc.target.process.command_line = /Set-Service\b/ nocase
          or
          $svc.target.process.command_line = /Stop-Service\b/ nocase
        )
        and $svc.target.process.command_line = /\bEventLog\b/ nocase
      )
    )
    not $svc.principal.user.userid in %global_eventlog_maintenance_users
    not $svc.principal.hostname in %global_eventlog_maintenance_hosts
    $svc.principal.hostname = $hostname

    // Stage 2: Event log channel cleared or wiped
    $clr.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $clr.target.process.file.full_path = /\\wevtutil\.exe$/ nocase
        and $clr.target.process.command_line = /\b(cl|clear-log)\b/ nocase
      )
      or
      (
        $clr.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and $clr.target.process.command_line = /Clear-EventLog\b/ nocase
      )
    )
    not $clr.principal.user.userid in %global_eventlog_maintenance_users
    not $clr.principal.hostname in %global_eventlog_maintenance_hosts
    $clr.principal.hostname = $hostname

    // Enforce chronological ordering: disable before clear
    $svc.metadata.event_timestamp.seconds <= $clr.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($hostname)
    $disable_cmdline = array_distinct($svc.target.process.command_line)
    $clear_cmdline = array_distinct($clr.target.process.command_line)
    $acting_user = array_distinct($svc.principal.user.userid)
    $clear_user = array_distinct($clr.principal.user.userid)
    $disable_process = array_distinct($svc.target.process.file.full_path)
    $clear_process = array_distinct($clr.target.process.file.full_path)

  condition:
    $svc and $clr
}
