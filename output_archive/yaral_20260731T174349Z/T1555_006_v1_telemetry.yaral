/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:45:21.329506+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_Cloud_Secret_Bulk_Read_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects USER_RESOURCE_ACCESS events representing direct API reads of secrets from cloud-native secret management stores (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault). This rule targets the resulting cloud audit log entry produced when a secret value is retrieved, providing coverage at the API/audit layer rather than the process-creation layer. Bulk or anomalous secret reads by non-service identities are a strong indicator of credential harvesting."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Requires cloud audit logs ingested into Chronicle UDM: AWS CloudTrail (GetSecretValue), GCP Cloud Audit Logs (AccessSecretVersion), Azure Monitor / Key Vault diagnostic logs (SecretGet). These must be forwarded to Google SecOps via the appropriate Chronicle ingestion feeds."
    platform = "IaaS (AWS, GCP, Azure)"
    false_positives = "Legitimate application service accounts performing scheduled secret rotation checks, CI/CD pipeline identities fetching deployment credentials, secrets manager SDK health checks, authorized break-glass access by SRE teams."
    tuning_guidance = "Populate %cloud_secret_allowed_service_accounts with known CI/CD and application service account identities. Populate %cloud_secret_allowed_resource_prefixes with approved automation resource name patterns. Consider raising severity or lowering threshold for human (non-service) identities accessing secrets outside business hours."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match the canonical secret-read API actions across AWS, GCP, and Azure
    // as they appear in Chronicle UDM after normalization from cloud audit logs.
    // AWS CloudTrail: GetSecretValue
    // GCP Cloud Audit: google.cloud.secretmanager.v1.SecretManagerService.AccessSecretVersion
    // Azure Key Vault: SecretGet / VaultGet
    $cloud.metadata.product_event_type = /GetSecretValue|AccessSecretVersion|SecretGet|VaultGet/ nocase

    // Target resource must reference a secrets management service path or ARN pattern.
    // AWS: arn:aws:secretsmanager:...
    // GCP: projects/.../secrets/.../versions/...
    // Azure: https://<vault>.vault.azure.net/secrets/...
    $cloud.target.resource.name = /secretsmanager|secretmanager|vault\.azure\.net\/secrets|\/secrets\/.*\/versions\// nocase

    // Capture the principal identity performing the access
    $cloud.principal.user.userid = $accessor

    // Exclude known-good automation service accounts
    not $cloud.principal.user.userid in %cloud_secret_allowed_service_accounts

    // Exclude known-good resource name prefixes (e.g. approved rotation automation targets)
    not $cloud.target.resource.name in %cloud_secret_allowed_resource_prefixes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_secret_resource = array_distinct($cloud.target.resource.name)
    $cloud_api_action = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
