/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:52:49.308108+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_002_Repeated_Cloud_Log_Disable_Modify_By_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single user performing repeated cloud audit-log disable or modification actions within a short window. Individual log-config changes may be routine; a burst of such changes by one identity is a strong indicator of deliberate defense impairment. Covers AWS CloudTrail/CloudWatch tampering, GCP logging sink deletion, Azure Monitor/Diagnostic Settings removal, and M365 mailbox audit bypass or Advanced Auditing downgrade."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1562.008"
    mitre_technique_name = "Impair Defenses: Disable Cloud Logs"
    log_prerequisites = "Requires cloud audit logs ingested into Chronicle UDM: AWS CloudTrail, GCP Cloud Audit Logs, Azure Activity Log, or M365 Unified Audit Log. Events must map to SETTING_MODIFICATION or SETTING_DELETION with principal.user.userid populated."
    platform = "IaaS, SaaS, Identity Provider, Office Suite"
    false_positives = "Authorized cloud infrastructure automation (Terraform, Pulumi, CDK) applying planned changes; cloud operations teams performing scheduled maintenance; log-rotation or archival pipelines that temporarily disable sinks."
    tuning_guidance = "Add known automation service-account userids to %global_allowed_log_admin_users. Add approved CI/CD principal hostnames to %global_allowed_cicd_hosts. Lower the threshold from 3 to 2 for high-sensitivity tenants, or raise to 5 for environments with frequent infra automation."

  events:
    // Match any setting-level deletion or modification event
    $cfg.metadata.event_type = "SETTING_MODIFICATION" or
    $cfg.metadata.event_type = "SETTING_DELETION"

    // Target resource name or operation must reference logging, auditing, monitoring, or diagnostic infrastructure
    (
      $cfg.target.resource.name = /log/                nocase or
      $cfg.target.resource.name = /audit/              nocase or
      $cfg.target.resource.name = /trail/              nocase or
      $cfg.target.resource.name = /cloudwatch/         nocase or
      $cfg.target.resource.name = /diagnostic/         nocase or
      $cfg.target.resource.name = /monitor/            nocase or
      $cfg.target.resource.name = /sink/               nocase or
      $cfg.target.resource.name = /retention/          nocase or
      $cfg.target.resource.name = /mailboxaudit/       nocase or
      $cfg.target.resource.name = /advancedaudit/      nocase or
      $cfg.security_result.summary = /log.*disabl/     nocase or
      $cfg.security_result.summary = /audit.*bypass/   nocase or
      $cfg.security_result.summary = /trail.*stop/     nocase or
      $cfg.security_result.summary = /sink.*delet/     nocase or
      $cfg.security_result.summary = /monitor.*remov/  nocase or
      $cfg.security_result.summary = /diagnostic.*del/ nocase
    )

    // Must have an identified user actor
    $cfg.principal.user.userid != ""

    // Exclude known authorized log-administration identities and automation accounts
    not $cfg.principal.user.userid in %global_allowed_log_admin_users

    // Exclude known CI/CD pipeline hosts to reduce automation noise
    not $cfg.principal.hostname in %global_allowed_cicd_hosts

    // Bind the grouping entity for the match block
    $cfg.principal.user.userid = $actor_userid

  match:
    $actor_userid over 10m

  outcome:
    // Scale risk: base 60 for threshold breach; SOAR can escalate further on count
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1562.008")
    $primary_entity = array_distinct($actor_userid)
    $affected_resources = array_distinct($cfg.target.resource.name)
    $source_hosts = array_distinct($cfg.principal.hostname)
    $event_types_seen = array_distinct($cfg.metadata.event_type)
    $operation_summaries = array_distinct($cfg.security_result.summary)
    $distinct_change_count = count($cfg.metadata.id)

  condition:
    // Fire only when the same user makes 3 or more distinct log-impairment changes in the window
    #cfg >= 3
}
