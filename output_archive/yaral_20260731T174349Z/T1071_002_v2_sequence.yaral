/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:47:48.967003+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_FTP_Process_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-browser, non-dedicated FTP client process that first opens an FTP/FTPS/TFTP port connection (21, 22, 69, 990) and then establishes a follow-on external network connection, indicating potential C2 over file-transfer protocols. This is additive to process-launch command-line rules by correlating the actual network behaviour rather than the invocation arguments."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires EDR or host-based network telemetry that populates principal.process.file.full_path on NETWORK_CONNECTION events (e.g., CrowdStrike Falcon, Carbon Black, Sysmon with network events, or equivalent). Both events must share the same hostname."
    platform = "Windows, Linux, macOS, ESXi"
    false_positives = "Legitimate backup agents (Veeam, Commvault), managed file transfer tools (MoveIt, GoAnywhere), CI/CD pipeline runners that push artifacts via FTP, and software update daemons. Add their binary paths to %global_allowed_ftp_processes."
    tuning_guidance = "Populate %global_allowed_ftp_processes with full paths of approved MFT/backup binaries. Populate %rfc1918_internal with your internal CIDR summary addresses to suppress internal-only transfers. Raise severity to Critical if the initiating process is a scripting engine (powershell, python, perl, bash)."

  events:
    // Event 1: A process makes a connection to an FTP-family control or data port.
    // Pre-filter: only FTP/FTPS/TFTP control ports to avoid joining on every outbound connection.
    $ftp.metadata.event_type = "NETWORK_CONNECTION"
    $ftp.target.port in [21, 69, 990, 2121]
    not $ftp.principal.process.file.full_path in %global_allowed_ftp_processes
    // Exclude dedicated FTP client binaries (already covered by process-launch rule).
    not $ftp.principal.process.file.full_path = /\/(s?ftp|lftp|ncftp|winscp|filezilla|curl|wget)$/ nocase
    not $ftp.principal.process.file.full_path = /\\(ftp|sftp|winscp|filezilla|curl|wget)\.exe$/ nocase
    // Exclude browsers.
    not $ftp.principal.process.file.full_path = /\\(chrome|firefox|msedge|iexplore|safari|opera)\.exe$/ nocase
    $ftp.principal.hostname = $hostname

    // Event 2: The SAME process on the SAME host subsequently makes an external connection
    // on a non-FTP port, suggesting data exfiltration or C2 beacon after the FTP handshake.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.port in [21, 69, 990, 2121]
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_ftp_processes
    not $net.principal.process.file.full_path = /\/(s?ftp|lftp|ncftp|winscp|filezilla|curl|wget)$/ nocase
    not $net.principal.process.file.full_path = /\\(ftp|sftp|winscp|filezilla|curl|wget)\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(chrome|firefox|msedge|iexplore|safari|opera)\.exe$/ nocase
    $net.principal.hostname = $hostname
    // Join on the same initiating process so we do not correlate unrelated processes.
    $ftp.principal.process.file.full_path = $initiating_process

    // Chronological ordering: FTP control connection precedes the follow-on external connection.
    $ftp.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $initiating_process over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($ftp.principal.hostname)
    $initiating_process_path = array_distinct($ftp.principal.process.file.full_path)
    $ftp_destination_ips = array_distinct($ftp.target.ip)
    $ftp_destination_ports = array_distinct($ftp.target.port)
    $followon_destination_ips = array_distinct($net.target.ip)
    $followon_destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($ftp.principal.user.userid)

  condition:
    $ftp and $net
}
