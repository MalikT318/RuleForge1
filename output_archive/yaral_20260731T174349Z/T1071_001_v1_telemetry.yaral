/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:46:43.267041+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Suspicious_Web_Protocol_Config_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file artifacts written to suspicious locations that are consistent with C2 beacon configuration files, implant staging, or HTTP/WebSocket channel configuration dropped by malware using web protocols. Targets the resulting file-system state change rather than the process command line, providing coverage that survives command-line obfuscation and LOLBin abuse."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires EDR file-creation/modification telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11). File path and writing-process fields must be populated."
    platform = "Windows, Linux, macOS"
    false_positives = "Legitimate software update agents writing config files to temp directories; browser extension installers; developer tooling (curl, wget) writing response bodies to disk; RMM agents caching configuration. Tune by adding known-good parent process paths to %global_allowed_web_config_writers."
    tuning_guidance = "Add trusted parent process full paths (e.g., software update agents, RMM tools) to %global_allowed_web_config_writers. Add approved directories to %global_allowed_web_artifact_paths. Raise severity if the writing process is not a browser or update agent."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Written to high-risk staging or temp locations across Windows, Linux, macOS
    $file.target.file.full_path = /(?i)(\\temp\\|\\tmp\\|\\appdata\\local\\temp\\|\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\\programdata\\|\/Library\/Application Support\/|\\users\\[^\\]+\\appdata\\roaming\\)/

    // File extensions associated with C2 config blobs, encoded payloads, or
    // HTTP response bodies cached by implants. Excludes common browser cache
    // extensions to reduce noise.
    $file.target.file.full_path = /\.(dat|bin|cfg|config|ini|json|xml|log|tmp|cache|bak|db|sqlite|raw|enc|b64|out|rsp|hdr|pkt)$/ nocase

    // The writing process is NOT a known browser or update binary.
    // Attackers use LOLBins or renamed binaries; we match on the absence of
    // expected writers rather than an allowlist of attacker tool names.
    not $file.principal.process.file.full_path = /\\(chrome|firefox|msedge|safari|opera|iexplore|brave|vivaldi|MicrosoftEdgeUpdate|GoogleUpdate|MsMpEng|svchost|wuauclt|TiWorker|OneDrive|Dropbox|Teams|slack|zoom)\.exe$/ nocase

    // Exclude known-good parent processes supplied per-customer via reference list
    not $file.principal.process.file.full_path in %global_allowed_web_config_writers

    // Exclude known-good destination paths supplied per-customer via reference list
    not $file.target.file.full_path in %global_allowed_web_artifact_paths

    // The writing process itself is not located in a standard system directory,
    // OR it is a scripting host / LOLBin writing to a user-writable path.
    // This catches renamed implants dropped outside Program Files / System32.
    $file.principal.process.file.full_path = /(?i)(\\users\\|\\temp\\|\\tmp\\|\\programdata\\|\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/home\/|\\appdata\\)/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
