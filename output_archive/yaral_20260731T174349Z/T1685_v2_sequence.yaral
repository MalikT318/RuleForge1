/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:51:05.317162+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1562_001_Security_Service_Kill_Then_Config_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage defense impairment pattern: a security-related process or service is terminated, followed within 10 minutes by modification of a security tool configuration file or registry key on the same host. This combination strongly suggests deliberate tampering with defensive tooling rather than routine administration."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1562.001"
    mitre_technique_name = "Impair Defenses: Disable or Modify Tools"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_TERMINATION) and either file-write or registry-write events. Windows Event 4688 alone is insufficient; a full EDR sensor (CrowdStrike, SentinelOne, Defender for Endpoint, Carbon Black) or Sysmon with EventID 1/11/12/13 is required."
    platform = "Windows, Linux, macOS"
    false_positives = "Legitimate AV/EDR upgrades that stop services before replacing binaries; RMM-driven patch cycles; IT automation scripts that restart security agents; vendor-initiated self-update routines."
    tuning_guidance = "Add authorized update parent processes to %global_allowed_security_updaters. Add known-good config paths to %global_allowed_security_config_paths. Scope by $hostname to a pilot group before broad deployment."

  events:
    // Stage 1: Termination of a process whose name matches common security tool patterns.
    $kill.metadata.event_type = "PROCESS_TERMINATION"
    $kill.target.process.file.full_path = /\/(sysmon|mssense|mdatp|falcon|cbdefense|cbagent|cylance|carbonblack|sentinel|sentinelone|edr|av|antivirus|defender|eset|sophos|symantec|mcafee|trendmicro|crowdstrike|qualys|nessus|ossec|wazuh|auditd|filebeat|winlogbeat|elastic-agent|splunkd|nxlog|rsyslog|syslog-ng|logstash|fluentd|td-agent|osquery|lacework|sysdig|twistlock|aqua|tenable)(\.exe)?$/ nocase
    not $kill.target.process.file.full_path in %global_allowed_security_updaters
    $kill.principal.hostname = $hostname

    // Stage 2: Modification of a security tool configuration file or registry key on the same host.
    $tamper.metadata.event_type = "FILE_MODIFICATION"
    (
      $tamper.target.file.full_path = /\/(sysmon|mssense|mdatp|falcon|cbdefense|cbagent|cylance|carbonblack|sentinel|sentinelone|edr|defender|eset|sophos|symantec|mcafee|trendmicro|crowdstrike|qualys|nessus|ossec|wazuh|auditd|filebeat|winlogbeat|elastic-agent|splunkd|nxlog|rsyslog|syslog-ng|logstash|fluentd|td-agent|osquery|lacework|sysdig|twistlock|aqua|tenable)/ nocase
      or
      $tamper.target.file.full_path = /\.(conf|cfg|config|xml|yaml|yml|json|ini|policy|rules|toml)$/ nocase
    )
    not $tamper.target.file.full_path in %global_allowed_security_config_paths
    $tamper.principal.hostname = $hostname

    // Chronological ordering: kill must precede config tamper
    $kill.metadata.event_timestamp.seconds <= $tamper.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1562.001")
    $primary_entity = array_distinct($kill.principal.hostname)
    $killed_process_paths = array_distinct($kill.target.process.file.full_path)
    $tampered_file_paths = array_distinct($tamper.target.file.full_path)
    $acting_user = array_distinct($kill.principal.user.userid)
    $kill_event_count = count($kill.metadata.id)
    $tamper_event_count = count($tamper.metadata.id)

  condition:
    $kill and $tamper
}
