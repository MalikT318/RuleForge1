/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:49:39.712584+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_PubSub_Protocol_Config_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of pub/sub protocol client configuration files (MQTT, AMQP, XMPP, STOMP) in non-standard or user-writable directories. Adversaries deploying pub/sub C2 agents typically drop a broker configuration file containing connection strings, credentials, and topic subscriptions. Detecting the artifact is more resilient than command-line matching because the file must exist for the agent to function across reboots."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires EDR file-creation/modification telemetry (e.g., CrowdStrike Falcon, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11). File path and extension must be populated in target.file.full_path."
    platform = "Windows, Linux, macOS"
    false_positives = "Legitimate IoT development tooling (Mosquitto, RabbitMQ clients, ActiveMQ), CI/CD pipelines writing broker configs, messaging middleware installers, home-automation platforms (Home Assistant), and developer workstations running MQTT explorers."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_pubsub_writers. Add approved directories (e.g., application install paths) to %global_allowed_pubsub_dirs. Raise severity if the writing process is an interpreter (python, node, powershell) rather than a dedicated messaging binary."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file path matches pub/sub configuration file naming conventions
    // Covers MQTT (.conf, .cfg, .ini, .json, .yaml, .yml, .toml),
    // AMQP/RabbitMQ, XMPP, and STOMP client config patterns
    $file.target.file.full_path = /\/(mqtt|amqp|amqps|xmpp|stomp|rabbitmq|mosquitto|activemq|paho|emqx|hivemq|nats)[^\/]*\.(conf|cfg|ini|json|yaml|yml|toml|xml|properties)$/  nocase

    // OR: generic config files whose names embed broker/topic keywords
    // Second filter broadens to files in temp/user-writable paths with broker keywords
    // We use OR-equivalent by splitting into two separate conditions joined with OR logic
    // YARA-L does not support OR across conditions, so we use a broad path regex
    // and rely on the filename pattern above as the primary signal

    // Restrict to directories that are suspicious for this file type:
    // temp dirs, user home dirs, working dirs, hidden dirs, /tmp, AppData, /var/tmp
    $file.target.file.full_path = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\\Temp\\|\\AppData\\|\\ProgramData\\|\/home\/[^\/]+\/\.|\\Users\\[^\\]+\\AppData|\/root\/\.|\/opt\/[^\/]+\/conf)/ nocase

    // Exclude known-good writer processes (messaging middleware installers, package managers)
    not $file.principal.process.file.full_path in %global_allowed_pubsub_writers

    // Exclude known-good directories where legitimate broker software installs configs
    not $file.target.file.full_path in %global_allowed_pubsub_dirs

    // Exclude system-level package manager paths to reduce installer noise
    not $file.principal.process.file.full_path = /\/(usr\/bin\/apt|usr\/bin\/yum|usr\/bin\/dnf|usr\/bin\/rpm|usr\/bin\/dpkg|usr\/sbin\/installer|Windows\/System32\/msiexec)/ nocase

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $config_file_path = array_distinct($file.target.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
