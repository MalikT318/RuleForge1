/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:48:32.173621+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_NonMailProcess_SMTP_Then_DNS_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-mail-client process establishing an outbound SMTP/SMTPS/IMAP/POP3 connection followed by a DNS lookup from the same host within 5 minutes. This pattern is consistent with malware using mail protocols for C2 by first connecting to a mail server and then resolving additional infrastructure. Complements existing process-launch/command-line detections for T1071.003."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires EDR or network flow telemetry (NETWORK_CONNECTION events with process context) and DNS telemetry (NETWORK_DNS events). Both must include principal.hostname and principal.process.file.full_path."
    platform = "Linux, macOS, Windows"
    false_positives = "Custom in-house mail relay agents, monitoring tools that probe mail ports, security scanners, and legitimate MTA daemons (sendmail, postfix, exim) if they also trigger DNS lookups. Add known mail relay process paths to %global_allowed_mail_relay_processes."
    tuning_guidance = "Populate %global_allowed_mail_relay_processes with full paths of legitimate MTA/MUA binaries (e.g. /usr/sbin/sendmail, /usr/lib/postfix/smtp). Populate %global_allowed_mail_servers with known internal mail relay IPs to suppress internal relay traffic. Raise severity to Critical if the DNS query resolves to a newly registered or low-reputation domain."

  events:
    // Event 1: A process that is NOT a known mail client/MTA makes an outbound
    // connection on a standard mail protocol port (SMTP 25, SMTP 465, SMTP 587,
    // IMAP 143, IMAPS 993, POP3 110, POP3S 995).
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port in [25, 110, 143, 465, 587, 993, 995]
    not $net.principal.process.file.full_path = /\/(sendmail|postfix|exim|dovecot|smtp|smtpd|imapd|pop3d|thunderbird|outlook|evolution|mutt|alpine|msmtp|ssmtp|nullmailer)/ nocase
    not $net.principal.process.file.full_path = /\\(thunderbird|outlook|msimn|winmail|eudora|thebat|postfix|sendmail)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_mail_relay_processes
    not $net.target.ip in %global_allowed_mail_servers
    $net.principal.hostname = $hostname

    // Event 2: The same host performs a DNS lookup shortly after, suggesting
    // the malware is resolving additional C2 infrastructure after initial
    // mail-protocol beacon.
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.hostname = $hostname
    not $dns.network.dns.questions.name = /\.(microsoft|windows|apple|google|amazon|akamai|cloudflare|office365|outlook)\.com$/ nocase

    // Chronological ordering: mail-protocol connection must precede DNS lookup
    $net.metadata.event_timestamp.seconds <= $dns.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $offending_process = array_distinct($net.principal.process.file.full_path)
    $mail_port_contacted = array_distinct($net.target.port)
    $destination_ip = array_distinct($net.target.ip)
    $dns_queries = array_distinct($dns.network.dns.questions.name)
    $event_count = count($dns.metadata.id)

  condition:
    $net and $dns
}
