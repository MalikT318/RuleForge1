/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:53:12.116561+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Security_Tool_Disabled_Then_Fake_UI_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a sequence where a security tool service is stopped or disabled, followed by a non-standard process launching with a name or window title mimicking a legitimate security product UI. Adversaries disable real defenses then spawn a fake UI to maintain the appearance of protection and delay detection."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) capturing command lines and parent process paths. Windows: Event 4688 or Sysmon Event 1. Linux/macOS: auditd or equivalent EDR. Both events must be correlated on the same hostname."
    platform = "Linux, macOS, Windows"
    false_positives = "Legitimate security product installers or updaters that restart services and relaunch UI components. Security product self-healing mechanisms. RMM tools that manage AV/EDR lifecycle. Pentest tooling in authorized red-team engagements."
    tuning_guidance = "Add known-good security product installer paths to %global_allowed_security_installers. Add authorized RMM parent process paths to %global_allowed_rmm_parents. Narrow the security product name regex to match only products deployed in your environment."

  events:
    // Leg 1: A process stops or disables a known security service via sc, net, systemctl, launchctl, or similar
    $svc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $svc.target.process.command_line = /\b(sc(\.exe)?)\b.*(stop|config\s+\S+\s+start=\s*disabled)/ nocase
      or
      $svc.target.process.command_line = /\b(net(\.exe)?)\b.*\bstop\b/ nocase
      or
      $svc.target.process.command_line = /\b(systemctl|launchctl)\b.*(stop|disable|unload)/ nocase
    )
    (
      $svc.target.process.command_line = /\b(defender|mssense|sense|windefend|csfalcon|cbdefense|cylance|sentinel|carbonblack|crowdstrike|symantec|norton|mcafee|sophos|eset|bitdefender|malwarebytes|avast|avg|kaspersky|trendmicro|fireeye|tanium|qualys|tenable|nessus|wdav|wdfilter|wdnisdrv|mpssvc|mpcmdrun|securityhealthservice|wscsvc)\b/ nocase
    )
    not $svc.principal.process.file.full_path in %global_allowed_security_installers
    $svc.principal.hostname = $hostname

    // Leg 2: A process launches from an unusual or non-product path with a name mimicking a security product UI
    $ui.metadata.event_type = "PROCESS_LAUNCH"
    (
      $ui.target.process.file.full_path = /\b(defender|security|protect|antivirus|av_ui|shield|guard|sentinel|endpoint|safeguard|firewall|scanner|health)\b/ nocase
    )
    // Must NOT originate from a known legitimate security product installation directory
    not $ui.principal.process.file.full_path = /\\(Windows Defender|Microsoft Security Client|CrowdStrike|Carbon Black|SentinelOne|Symantec|McAfee|Sophos|ESET|Bitdefender|Malwarebytes|Avast|AVG|Kaspersky|Trend Micro|FireEye|Cylance)\\/i nocase
    not $ui.target.process.file.full_path = /\\(Program Files|Program Files \(x86\))\\(Windows Defender|Microsoft Security Client|CrowdStrike|Carbon Black|SentinelOne|Symantec|McAfee|Sophos|ESET|Bitdefender|Malwarebytes|Avast|AVG|Kaspersky|Trend Micro|FireEye|Cylance)\\/i nocase
    not $ui.principal.process.file.full_path in %global_allowed_rmm_parents
    $ui.principal.hostname = $hostname

    // Chronological ordering: service disruption must precede fake UI launch
    $svc.metadata.event_timestamp.seconds <= $ui.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity = array_distinct($svc.principal.hostname)
    $disabled_service_cmdline = array_distinct($svc.target.process.command_line)
    $fake_ui_process_path = array_distinct($ui.target.process.file.full_path)
    $fake_ui_parent_path = array_distinct($ui.principal.process.file.full_path)
    $svc_actor_user = array_distinct($svc.principal.user.userid)
    $ui_actor_user = array_distinct($ui.principal.user.userid)

  condition:
    $svc and $ui
}
