/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:46:18.880409+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_Suspicious_Process_Beaconing_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-browser process establishing an outbound network connection shortly after being launched by a potentially suspicious parent (e.g. script interpreter, document handler, or shell). This correlation catches application-layer C2 beaconing where a process spawned from a risky parent immediately reaches out over HTTP/S or other high ports, blending into normal web traffic. Complements existing process-launch command-line rules by requiring an observed network event."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_CONNECTION) correlated on the same host. Sysmon, CrowdStrike, SentinelOne, or equivalent."
    platform = "Linux, macOS, Windows"
    false_positives = "Software updaters spawned by office suites, package managers, IDE extensions fetching plugins, RMM agents, legitimate scripting automation. Tune via %global_allowed_beaconing_parents and %global_allowed_beaconing_children."
    tuning_guidance = "Add known-good parent/child process paths to %global_allowed_beaconing_parents and %global_allowed_beaconing_children. Add trusted internal egress proxies or jump hosts to %rfc1918_internal. Lower severity for hosts in %global_developer_workstations where IDE tooling is common."

  events:
    // Event 1: A risky parent spawns a child process on the same host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(bash|sh|zsh|fish|ksh|python[23]?|ruby|perl|php|node|powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32|svchost|winword|excel|powerpnt|outlook|acrord32|java|javaw)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_beaconing_parents
    not $proc.target.process.file.full_path in %global_allowed_beaconing_children
    // Exclude obvious system management children to reduce noise
    not $proc.target.process.file.full_path = /\/(systemd|launchd|cron|apt|yum|dnf|brew|pip[23]?|npm|cargo|go)$/ nocase
    $proc.principal.hostname = $hostname

    // Event 2: The child (or a process on the same host matching the child path) makes an outbound connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    // Target must be a non-RFC1918 address (external)
    not $net.target.ip in %rfc1918_internal
    // Focus on application-layer ports: HTTP, HTTPS, and high ports commonly used for C2
    $net.target.port >= 80
    not $net.principal.process.file.full_path in %global_allowed_beaconing_children
    // Exclude well-known browser processes from the network side to avoid browser FP flood
    not $net.principal.process.file.full_path = /\/(chrome|firefox|safari|msedge|opera|brave|iexplore|chromium)$/ nocase
    $net.principal.hostname = $hostname

    // Chronological ordering: process launch must precede the network connection
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($proc.principal.hostname)
    $spawning_parent = array_distinct($proc.principal.process.file.full_path)
    $spawned_child = array_distinct($proc.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $proc and $net
}
