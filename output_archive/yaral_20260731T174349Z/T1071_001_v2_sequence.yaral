/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:47:02.520171+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Suspicious_Process_Beaconing_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-browser process that establishes an outbound HTTP/S connection shortly after being launched by a suspicious parent (script interpreter, document handler, or LOLBin). This correlation targets C2 beaconing over web protocols by processes that have no legitimate reason to initiate HTTP traffic, providing additive coverage beyond command-line process-creation rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and network telemetry (NETWORK_HTTP or proxy logs ingested as NETWORK_HTTP). Both event types must populate principal.hostname and principal.process.file.full_path."
    platform = "Windows, Linux, macOS"
    false_positives = "Software updaters spawned by script wrappers, developer tooling (npm, pip, curl in CI pipelines), RMM agents that use scripting engines, legitimate admin scripts that call web APIs."
    tuning_guidance = "Add known-good parent/child process combinations to %global_allowed_http_spawners. Add internal proxy or update server IPs to %global_allowed_update_destinations. Narrow severity by scoping to endpoints not in %global_server_assets if server-side false positives are high."

  events:
    // Event 1: A script interpreter, document handler, or LOLBin spawns a child process
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|bash|sh|python[23]?|perl|ruby|php|node)\.exe$/ nocase
    // Child must NOT be a known browser or system updater - target unusual children
    not $proc.target.process.file.full_path = /\\(chrome|firefox|msedge|iexplore|safari|opera|brave|MicrosoftEdge|svchost|WerFault|conhost)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_http_spawners
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $child_path

    // Event 2: That same child process (matched by path) makes an outbound HTTP request
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = $child_path
    // Exclude RFC-1918 and loopback destinations - C2 is external
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname = /\.(microsoft|windows|apple|google|amazon|akamai|cloudflare|digicert|verisign|symantec|windowsupdate|office365|live|msftncsi)\.(com|net|org|io)$/ nocase
    not $net.target.ip in %global_allowed_update_destinations
    $net.principal.hostname = $hostname

    // Chronological ordering: process launch must precede the network event
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $child_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $spawning_parent = array_distinct($proc.principal.process.file.full_path)
    $beaconing_process = array_distinct($child_path)
    $destination_hostnames = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $http_methods = array_distinct($net.network.http.method)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $proc and $net
}
