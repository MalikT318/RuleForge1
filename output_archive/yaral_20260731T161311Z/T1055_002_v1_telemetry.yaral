/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:14:59.311717+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious cross-process handle acquisition consistent with PE injection preparation. Adversaries performing T1055.002 must open a handle to the target process with PROCESS_VM_WRITE and PROCESS_CREATE_THREAD access rights before injecting a portable executable. This rule fires on PROCESS_OPEN events where a non-administrative, non-system process opens a handle to a process it does not own, targeting high-value system processes. This is a state-change / handle-layer detection that is additive to any existing command-line rule."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target process path populated (e.g., CrowdStrike Falcon, Microsoft Defender for Endpoint via MDE connector, Carbon Black, SentinelOne). Windows ETW kernel handle events (Event ID 10 via Sysmon) also populate this field."
    platform = "Windows"
    false_positives = "Legitimate security software (AV/EDR agents), debuggers (WinDbg, x64dbg), process monitoring tools (Process Explorer, Process Hacker), RMM agents, and software installers that inspect running processes. Crash reporting services (WerFault) also open cross-process handles."
    tuning_guidance = "Add known security tooling and RMM agent paths to %global_allowed_process_openers. Add approved monitoring tool paths to %global_allowed_debuggers. Consider narrowing by requiring the opening process to reside outside of %windir% and %programfiles% if your EDR populates those paths reliably."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // The opener (principal) is NOT a known system binary - it lives outside
    // the standard Windows system directories. Use regex with wildcard for
    // username-agnostic matching and nocase for case-insensitive comparison.
    not $proc.principal.process.file.full_path = /\\Windows\\System32\\/i nocase
    not $proc.principal.process.file.full_path = /\\Windows\\SysWOW64\\/i nocase
    not $proc.principal.process.file.full_path = /\\Windows\\WinSxS\\/i nocase

    // Target must be a high-value system process commonly abused for injection:
    // lsass, svchost, explorer, winlogon, csrss, wininit, services, spoolsv.
    // Matching on the target process path (the process being opened).
    $proc.target.process.file.full_path = /\\(lsass|svchost|explorer|winlogon|csrss|wininit|services|spoolsv|dllhost|taskhost|taskhostw|RuntimeBroker)\.exe$/i nocase

    // The opener must not be the same image as the target (self-open is benign).
    // We compare the base filename portion via regex negation on the principal path
    // against the same set of trusted system executables.
    not $proc.principal.process.file.full_path = /\\(lsass|svchost|explorer|winlogon|csrss|wininit|services|spoolsv|dllhost|taskhost|taskhostw|RuntimeBroker)\.exe$/i nocase

    // Exclude processes running as SYSTEM opening handles to their own children
    // (common in service management). Require the opening user to be non-empty
    // so we have attribution context.
    $proc.principal.user.userid != ""

    // Exclude known-good openers via reference list for MSSP multi-tenant tuning.
    not $proc.principal.process.file.full_path in %global_allowed_process_openers
    not $proc.principal.process.file.full_path in %global_allowed_debuggers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $opening_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
