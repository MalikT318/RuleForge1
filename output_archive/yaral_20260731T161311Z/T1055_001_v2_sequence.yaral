/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:14:37.461392+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_Process_Open_Then_Remote_Thread_DLL_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage DLL injection pattern: a non-system process opens a handle to a remote process (PROCESS_OPEN), followed within 5 minutes by a new thread being created in that same target process (PROCESS_INJECTION). This covers the VirtualAllocEx/WriteProcessMemory/CreateRemoteThread injection chain without relying on command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g. Sysmon Event ID 10 / CrowdStrike process handle events) and PROCESS_INJECTION events (e.g. Sysmon Event ID 8 CreateRemoteThread). Both event types must be ingested into Chronicle UDM."
    platform = "Windows"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), JIT compilers (JVM, CLR), AV/EDR products performing self-injection, RMM agents, and software installers that inject into host processes for legitimate IPC."
    tuning_guidance = "Add known-good opener process paths to %global_allowed_process_openers (e.g. AV engines, JVM, CLR hosts). Add known-good target process paths to %global_allowed_injection_targets. Narrow $target_pid join if your EDR populates target.process.pid reliably."

  events:
    // Stage 1: A non-system process opens a handle to another (remote) process.
    // Sysmon Event 10 / EDR process-access events map to PROCESS_OPEN.
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must not be a known Windows system binary to reduce noise.
    // We match on the principal (the process doing the opening).
    not $open.principal.process.file.full_path = /\\(lsass|csrss|smss|wininit|services|svchost|winlogon|System)\.exe$/i nocase
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Target of the open must be a running process (has a pid populated).
    $open.target.process.pid > 0

    // Exclude self-opens (same process opening itself, common in runtimes).
    $open.principal.process.pid != $open.target.process.pid

    // Bind join keys: host and target process pid.
    $open.principal.hostname = $hostname
    $open.target.process.pid = $target_pid

    // Stage 2: A remote thread is created in the same target process on the same host.
    // Sysmon Event 8 / EDR CreateRemoteThread maps to PROCESS_INJECTION.
    $inj.metadata.event_type = "PROCESS_INJECTION"

    // The injecting principal must not be a known-good tool.
    not $inj.principal.process.file.full_path in %global_allowed_process_openers

    // Target of the injection must match the same process that was opened.
    $inj.target.process.pid = $target_pid
    $inj.principal.hostname = $hostname

    // Exclude injection into self (legitimate JIT pattern).
    $inj.principal.process.pid != $inj.target.process.pid

    // Exclude injection into known-safe targets (e.g. browser renderer sandboxes).
    not $inj.target.process.file.full_path in %global_allowed_injection_targets

    // Chronological ordering: handle open must precede the remote thread creation.
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $target_pid over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $injection_source_process = array_distinct($inj.principal.process.file.full_path)
    $injected_target_process = array_distinct($inj.target.process.file.full_path)
    $injected_target_pid = max($target_pid)

  condition:
    $open and $inj
}
