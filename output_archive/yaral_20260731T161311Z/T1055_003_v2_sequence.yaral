/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:16:02.464557+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_OpenProcess_Then_RemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a behavioral sequence consistent with Thread Execution Hijacking: a process opens a handle to a remote process (PROCESS_OPEN) and subsequently creates a remote thread or resumes a suspended thread in that target (PROCESS_INJECTION). This correlation targets the OS-level mechanism rather than command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., Sysmon Event ID 10 with GrantedAccess including THREAD_SET_CONTEXT/SUSPEND_RESUME rights) and PROCESS_INJECTION events (e.g., Sysmon Event ID 8 CreateRemoteThread or EDR injection telemetry). Both event types must be ingested into Chronicle UDM."
    platform = "Windows"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg, x64dbg), profiling tools (VTune, dotTrace), AV/EDR self-protection threads, JVM/CLR runtime thread management, RMM agents performing process inspection."
    tuning_guidance = "Add known-good parent process paths (debuggers, profilers, RMM agents) to %global_allowed_process_open_sources. Add known-good target process paths to %global_allowed_injection_targets. Narrow the GrantedAccess mask filter in your EDR policy to reduce noise from read-only handle opens."

  events:
    // Leg 1: A non-system process opens a handle to another process with
    // rights consistent with thread manipulation (THREAD_SET_CONTEXT,
    // SUSPEND/RESUME, VM_WRITE). EDR vendors surface this as PROCESS_OPEN.
    $proc.metadata.event_type = "PROCESS_OPEN"

    // Exclude common system and security tool paths to reduce noise.
    not $proc.principal.process.file.full_path = /\\(svchost|lsass|csrss|smss|wininit|services)\.exe$/i nocase
    not $proc.principal.process.file.full_path in %global_allowed_process_open_sources

    // The opening process must not be opening itself (self-injection is a
    // different technique variant and handled by a separate rule).
    $proc.principal.process.pid != $proc.target.process.pid

    // Capture the hostname and the injecting process path for the join and outcome.
    $proc.principal.hostname = $hostname
    $proc.principal.process.file.full_path = $injector_path

    // Leg 2: Within the same window, a PROCESS_INJECTION event is observed
    // originating from the same host and the same injecting process.
    $inj.metadata.event_type = "PROCESS_INJECTION"

    // The injecting process in leg 2 must match the opener from leg 1.
    $inj.principal.process.file.full_path = $injector_path
    $inj.principal.hostname = $hostname

    // Exclude the same system processes on the injection side.
    not $inj.principal.process.file.full_path = /\\(svchost|lsass|csrss|smss|wininit|services)\.exe$/i nocase
    not $inj.principal.process.file.full_path in %global_allowed_process_open_sources

    // Exclude injections into self (same PID on both sides).
    $inj.principal.process.pid != $inj.target.process.pid

    // Chronological ordering: handle open must precede the injection event.
    $proc.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $injector_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $injecting_process = array_distinct($proc.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $injecting_user = array_distinct($proc.principal.user.userid)
    $open_event_count = count($proc.metadata.id)
    $injection_event_count = count($inj.metadata.id)

  condition:
    $proc and $inj
}
