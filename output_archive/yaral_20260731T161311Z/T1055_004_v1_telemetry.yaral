/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:16:24.505271+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where an unexpected process requests a handle to another process with permissions consistent with APC injection (e.g., PROCESS_VM_WRITE, PROCESS_VM_OPERATION, PROCESS_SUSPEND_RESUME). APC injection requires a handle to the victim process or thread before queuing the APC; detecting the handle request catches the technique at a lower abstraction layer than command-line telemetry and is harder to evade."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target process path and access rights (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, or Sysmon Event ID 10). The principal.process.file.full_path field must be populated with the requesting process path and target.process.file.full_path with the victim process path."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio devenv), security products performing process inspection, RMM agents (e.g., ConnectWise, Kaseya), antivirus engines, and Windows system components such as csrss.exe and lsass.exe opening handles to other processes for legitimate reasons."
    tuning_guidance = "Add known-good requesting process paths (debuggers, AV engines, RMM agents) to %global_allowed_process_open_sources. Add known-good victim process paths (e.g., system processes opened by security tooling) to %global_allowed_process_open_targets. Consider narrowing by access_mask if your EDR populates that field."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // Requesting process must not be a known Windows system binary performing
    // legitimate cross-process operations. We match on paths OUTSIDE the
    // canonical Windows system directories to catch injectors living in
    // user-writable or temp locations, while also flagging unexpected system-
    // path binaries that should never open handles to arbitrary processes.
    not $proc.principal.process.file.full_path = /\\(csrss|wininit|services|lsass|svchost|smss|winlogon|ntoskrnl)\.exe$/i nocase

    // Victim process is a high-value injection target: a process running from
    // a system path (making it a privileged or trusted context). Attackers
    // prefer to inject into these to inherit trust or elevated privilege.
    $proc.target.process.file.full_path = /\\Windows\\(System32|SysWOW64|explorer\.exe)/i nocase

    // Requesting process lives outside the Windows system directory, indicating
    // a user-land or third-party binary opening a handle to a privileged process.
    // This combination (non-system opener -> system target) is the core signal.
    not $proc.principal.process.file.full_path = /\\Windows\\(System32|SysWOW64)\\/i nocase

    // Exclude known-good requesting processes via reference list (MSSP tuning).
    not $proc.principal.process.file.full_path in %global_allowed_process_open_sources

    // Exclude known-good victim processes that security tooling legitimately inspects.
    not $proc.target.process.file.full_path in %global_allowed_process_open_targets

    // Require the requesting process path to be populated to avoid noise from
    // incomplete telemetry where the opener is unknown.
    $proc.principal.process.file.full_path != ""
    $proc.target.process.file.full_path != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $requesting_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $requesting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
