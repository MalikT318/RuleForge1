/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:13:49.628450+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_ProcessInjection_OpenThenRemoteWrite {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process opening a handle to a remote process (PROCESS_OPEN) followed by a cross-process memory write or module load into that same target process (PROCESS_INJECTION or PROCESS_MODULE_LOAD) within 5 minutes on the same host. This correlation targets the open-then-inject pattern common to shellcode injectors, reflective DLL loaders, and process hollowing, without relying on command-line strings."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., Sysmon EventID 10 / CrowdStrike / SentinelOne) and PROCESS_INJECTION or PROCESS_MODULE_LOAD events. Both event types must populate principal.hostname, principal.process.file.full_path, and target.process.pid."
    platform = "Linux, macOS, Windows"
    false_positives = "Debuggers (Visual Studio, WinDbg, gdb, lldb), JVM/CLR runtimes attaching to child processes, legitimate AV/EDR self-protection hooks, RMM agents performing process inspection, crash reporters (WerFault, Crashpad)."
    tuning_guidance = "Add known-safe openers (debuggers, AV engines, RMM agents) to %global_allowed_process_openers. Add known-safe injection targets (JVM, CLR host processes) to %global_allowed_injection_targets. Narrow scope further by restricting to non-admin users if your EDR populates principal.user.userid."

  events:
    // Leg 1: A process opens a handle to a DIFFERENT process (cross-process open)
    $open.metadata.event_type = "PROCESS_OPEN"
    // The opener must not be a known-safe administrative tool
    not $open.principal.process.file.full_path in %global_allowed_process_openers
    // The target process pid must be populated and differ from the opener
    $open.target.process.pid > 0
    // Capture the target PID and host as join keys
    $open.target.process.pid = $target_pid
    $open.principal.hostname = $hostname

    // Leg 2: A memory-write injection or suspicious remote module load into the same PID
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.pid = $target_pid
    $inj.principal.hostname = $hostname
    // The injecting process must not be a known-safe tool
    not $inj.principal.process.file.full_path in %global_allowed_process_openers
    // The target process must not be a known-safe injection host (JVM, CLR, etc.)
    not $inj.target.process.file.full_path in %global_allowed_injection_targets

    // Chronological ordering: open must precede injection
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $target_pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($open.principal.hostname)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $target_process = array_distinct($inj.target.process.file.full_path)
    $target_process_pid = max($target_pid)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $injection_count = count($inj.metadata.event_timestamp.seconds)

  condition:
    $open and $inj
}
