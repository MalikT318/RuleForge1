/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:13:32.434522+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_ProcessInjection_ProcessHandleOpen {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious PROCESS_OPEN events where an unexpected process requests a handle to another process with permissions consistent with code injection (e.g., PROCESS_VM_WRITE, PROCESS_CREATE_THREAD). This targets the OS-level handle request that must occur for most injection techniques, regardless of how the injector was launched or named. Covers classic VirtualAllocEx/WriteProcessMemory/CreateRemoteThread patterns, reflective DLL injection, and shellcode injection chains."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR telemetry that records PROCESS_OPEN events with target process details (e.g., CrowdStrike Falcon, Microsoft Defender for Endpoint, Carbon Black, SentinelOne, or Sysmon Event ID 10 via Chronicle ingestion). The principal.process and target.process fields must be populated."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), profiling tools (dotTrace, VTune), RMM agents performing process inspection, AV/EDR self-protection handles, and some software installers that inject into running processes for patching. Crash reporting tools (WerFault, Breakpad) may also open handles to crashing processes."
    tuning_guidance = "Add known-good opener process paths to %global_allowed_process_openers (e.g., debuggers, RMM agents, AV binaries). Add known-good target process paths to %global_allowed_injection_targets if specific high-value targets generate noise. Consider narrowing by principal.user.userid to exclude service accounts used by monitoring tools."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // The opener must NOT be a known-good administrative or security tool
    not $proc.principal.process.file.full_path in %global_allowed_process_openers

    // Exclude the process opening a handle to itself (self-injection is a separate technique variant)
    // and exclude system idle / kernel handles where principal path is empty
    $proc.principal.process.file.full_path != ""
    $proc.principal.process.file.full_path != $proc.target.process.file.full_path

    // Exclude well-known OS-internal opener paths that legitimately open cross-process handles
    // (csrss, lsass self-inspection, werfault, taskmgr)
    not $proc.principal.process.file.full_path = /\\(csrss|werfault|taskmgr|msiexec|svchost)\.exe$/i nocase

    // Target must be a meaningful process (not the System/Idle pseudo-process)
    $proc.target.process.file.full_path != ""
    not $proc.target.process.file.full_path = /\\(System|Registry)$/ nocase

    // High-value injection targets: browsers, security tools, system processes
    // Targeting these is a strong signal; adjust via reference list if needed
    $proc.target.process.file.full_path = /\\(lsass|winlogon|explorer|svchost|RuntimeBroker|spoolsv|dllhost|taskhost|taskhostw|sihost|userinit|wininit|services|smss|csrss|chrome|firefox|msedge|iexplore|outlook|Teams|slack)\.exe$/i nocase

    // Opener must not itself be a child of a known-good security product
    not $proc.principal.process.file.full_path = /\\(MsMpEng|SenseCntr|CSFalconService|cb\.exe|SentinelAgent|bdagent|avp|ekrn|avgnt)\.exe$/i nocase

    // Exclude openers from known system directories acting as legitimate service hosts
    not $proc.principal.process.file.full_path = /^[Cc]:\\[Ww]indows\\[Ss]ystem32\\/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
