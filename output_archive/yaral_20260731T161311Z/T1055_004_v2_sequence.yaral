/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:16:51.004305+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Suspended_Process_Then_Remote_Thread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with APC injection: a process launches a child in suspended state (CREATE_SUSPENDED flag visible in command-line or via debugger-style parent), then a PROCESS_INJECTION event is observed from the same host within 5 minutes. This covers Early Bird APC injection where code is written into a suspended process before its entry point executes, as well as classic QueueUserAPC patterns where a process opens a remote thread handle and queues an APC. Additive to existing PROCESS_LAUNCH command-line rules by correlating the suspension event with a subsequent injection telemetry event."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_LAUNCH with command-line arguments AND PROCESS_INJECTION events (e.g., CrowdStrike Falcon, SentinelOne, Microsoft Defender for Endpoint via Chronicle ingestion). PROCESS_INJECTION events are generated when the EDR detects cross-process memory writes or remote thread/APC queue operations."
    platform = "Windows"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg) launching targets in suspended state; software installers that use suspended process creation for privilege separation; JVM and .NET runtimes that spawn suspended helper processes; some RMM agents and AV products that inject monitoring code via APC."
    tuning_guidance = "Add known-good parent process paths (e.g., devenv.exe, msbuild.exe, installer frameworks) to %global_allowed_suspended_launchers. Add known-good injecting process paths to %global_allowed_injection_sources. Narrow scope further by restricting to non-interactive sessions or specific OU/asset groups via a reference list of sensitive hosts."

  events:
    // Leg 1: Process launched in suspended state.
    // CREATE_SUSPENDED (0x4) is typically passed via NtCreateProcess flags or
    // surfaced in EDR telemetry as a command-line argument to internal launchers,
    // or as a process-creation flag annotation in the command_line field.
    // We match the flag value or the keyword "suspended" as EDRs surface it.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /create_suspended|createsuspended|0x00000004|suspended/i nocase
      or
      $proc.target.process.command_line = /\-suspended/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_suspended_launchers
    not $proc.target.process.file.full_path in %global_allowed_suspended_launchers
    $proc.principal.hostname = $hostname

    // Leg 2: A PROCESS_INJECTION event from the same host within the window.
    // PROCESS_INJECTION is emitted by EDRs when WriteProcessMemory +
    // QueueUserAPC / NtQueueApcThread / CreateRemoteThread patterns are detected.
    $inj.metadata.event_type = "PROCESS_INJECTION"
    not $inj.principal.process.file.full_path in %global_allowed_injection_sources
    $inj.principal.hostname = $hostname

    // Chronological ordering: suspension must precede the injection event.
    $proc.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $suspended_process_path = array_distinct($proc.target.process.file.full_path)
    $suspended_process_cmdline = array_distinct($proc.target.process.command_line)
    $injecting_process_path = array_distinct($inj.principal.process.file.full_path)
    $injection_target_path = array_distinct($inj.target.process.file.full_path)
    $launching_parent_path = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc and $inj
}
