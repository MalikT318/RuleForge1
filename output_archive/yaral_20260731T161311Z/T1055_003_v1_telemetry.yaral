/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:15:40.862948+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_Process_Open_Handle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where an unexpected process requests a handle to a remote process with permissions consistent with thread execution hijacking (e.g., THREAD_SUSPEND_RESUME, THREAD_SET_CONTEXT, THREAD_GET_CONTEXT, PROCESS_VM_WRITE). This targets the OS-level handle acquisition step that must occur before SuspendThread/WriteProcessMemory/SetThreadContext can be called, providing coverage orthogonal to command-line detection."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR telemetry that logs PROCESS_OPEN events with target process path and requested access mask or access description. Sysmon Event ID 10 (ProcessAccess) with GrantedAccess populated, or CrowdStrike/SentinelOne process handle telemetry."
    platform = "Windows"
    false_positives = "Debuggers (Visual Studio, WinDbg, x64dbg), profilers (VTune, dotTrace), crash reporters (WER, Breakpad), legitimate AV/EDR self-protection checks, RMM agents performing process inspection, JIT compilers."
    tuning_guidance = "Add known debugger and profiler paths to %global_allowed_process_open_tools. Add known RMM agent paths to %global_allowed_rmm_agents. Consider scoping to non-developer workstations via asset group tagging. Narrow by requiring the principal process to NOT be a known security product."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // The requesting (principal) process is NOT a known system binary performing
    // legitimate cross-process inspection. Exclude common Windows OS paths that
    // routinely open handles to other processes for benign reasons.
    not $proc.principal.process.file.full_path = /\\(csrss|lsass|services|svchost|wininit|winlogon|smss|taskmgr|msiexec|WerFault|WerFaultSecure|MsMpEng|SenseIR|SenseCncProxy)\.exe$/i nocase

    // The target process being opened is a high-value, long-running process
    // that adversaries commonly hijack to blend in: system services, browsers,
    // or other persistent user-mode processes.
    $proc.target.process.file.full_path = /\\(svchost|explorer|RuntimeBroker|SearchHost|SearchIndexer|lsass|spoolsv|dllhost|taskhost|taskhostw|sihost|ctfmon|dwm|winlogon|chrome|msedge|firefox|iexplore)\.exe$/i nocase

    // The access description or command context indicates thread-manipulation
    // permissions. EDRs surface this differently; match the semantic pattern
    // that covers THREAD_SUSPEND_RESUME (0x0002), THREAD_SET_CONTEXT (0x0010),
    // THREAD_GET_CONTEXT (0x0008), and PROCESS_VM_WRITE (0x0020) combinations.
    // Chronicle UDM surfaces Sysmon GrantedAccess in target.process.access_mask
    // or in the security_result.description field depending on the parser.
    $proc.target.process.command_line = /0x[0-9a-fA-F]*(1[Ff][Ff][Ff]|0[Ff][Ff][Ff]|1438|143[aA]|0[Ff][Ff][Ee]|1[Ff][Ff][Ee])/ nocase

    // Exclude the requesting process if it is in the MSSP-managed allowlist
    not $proc.principal.process.file.full_path in %global_allowed_process_open_tools
    not $proc.principal.process.file.full_path in %global_allowed_rmm_agents

    // Exclude self-opens (process opening a handle to itself - benign)
    $proc.principal.process.pid != $proc.target.process.pid

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
