/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:15:17.573559+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_ProcessOpen_Then_RemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the two-stage behavioral signature of PE injection: a non-system process opens a handle to a remote process (PROCESS_OPEN) followed by a new thread being injected into that same target process (PROCESS_INJECTION). This sequence mirrors the VirtualAllocEx/WriteProcessMemory/CreateRemoteThread API chain used in portable executable injection without relying on command-line strings or file hashes."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g. CrowdStrike, SentinelOne, Microsoft Defender for Endpoint via Chronicle ingestion) and PROCESS_INJECTION events. Both event types must populate principal.hostname, principal.process.file.full_path, and target.process.pid."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio), profilers (VTune, dotTrace), AV/EDR self-protection threads, RMM agents performing process inspection, JIT compilers (JVM, CLR) opening child process handles."
    tuning_guidance = "Add known-good opener binaries (debuggers, RMM agents, AV engines) to %global_allowed_process_openers. Add known-good target process paths to %global_allowed_injection_targets. Raise severity to Critical if the target process is a high-value system binary (lsass, svchost, winlogon)."

  events:
    // Stage 1: A non-system process opens a handle to another live process.
    // This maps to OpenProcess() with PROCESS_VM_WRITE / PROCESS_VM_OPERATION access.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.hostname != ""
    $open.principal.process.file.full_path != ""
    // Exclude well-known system openers to reduce volume before the join.
    not $open.principal.process.file.full_path = /\\(svchost|csrss|wininit|services|lsass|smss|System)\.exe$/i nocase
    not $open.principal.process.file.full_path in %global_allowed_process_openers
    // Capture the target PID so we can join to the injection event.
    $open.target.process.pid = $target_pid
    $open.principal.hostname = $hostname

    // Stage 2: A remote thread is created in the same target process on the same host.
    // This maps to CreateRemoteThread() / NtCreateThreadEx() into the victim process.
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname != ""
    $inj.target.process.pid = $target_pid
    $inj.principal.hostname = $hostname
    // The injecting process should match the opener - same binary performing both steps.
    $inj.principal.process.file.full_path = $opener_path
    not $inj.principal.process.file.full_path in %global_allowed_process_openers
    not $inj.target.process.file.full_path in %global_allowed_injection_targets

    // Bind the opener path from stage 1 for the join.
    $open.principal.process.file.full_path = $opener_path

    // Enforce chronological ordering: handle open must precede thread injection.
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $target_pid, $opener_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($inj.target.process.file.full_path)
    $target_process_pid = max($target_pid)
    $injection_event_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
