/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T16:14:16.539771+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_Process_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process opening a handle to another process with PROCESS_VM_WRITE and PROCESS_CREATE_THREAD access rights, which are the fundamental OS-level prerequisites for classic DLL injection (VirtualAllocEx + WriteProcessMemory + CreateRemoteThread). This rule operates at the process-handle telemetry layer rather than command-line, providing additive coverage that survives binary renaming and command-line obfuscation."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events with target access rights populated (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Carbon Black). Windows Sysmon Event ID 10 (ProcessAccess) with GrantedAccess field is the canonical source. Access mask 0x1fffff (PROCESS_ALL_ACCESS) and 0x43a (VM_WRITE | CREATE_THREAD | VM_OPERATION | QUERY_INFORMATION) should be captured."
    platform = "Windows"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), profilers (VTune, dotTrace), AV/EDR agents performing self-inspection, game anti-cheat engines, RMM tools with live memory inspection, JVM/CLR runtimes during JIT compilation, and process monitoring utilities such as Process Hacker or Process Explorer."
    tuning_guidance = "Populate %global_allowed_process_open_sources with full paths of approved debuggers, AV agents, RMM tools, and JIT runtimes. Populate %global_allowed_process_open_targets with paths of processes that are legitimately inspected (e.g., browser helper processes). Narrow further by excluding known-good parent process paths or by requiring the source and target to be different users (cross-session injection is higher fidelity). Consider raising severity when the target process is a high-value system binary (lsass, svchost, explorer)."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"

    // Source process must not be a known Windows system binary performing
    // legitimate cross-process operations. We match on the absence of
    // well-known system paths rather than an allowlist of attacker tools,
    // so the rule survives binary renaming.
    not $proc.principal.process.file.full_path = /\\Windows\\(System32|SysWOW64|WinSxS)\\/i nocase

    // Target process should be a running user-mode or system process.
    // Exclude self-opens (same path) to reduce profiler noise.
    $proc.target.process.file.full_path != ""
    not $proc.target.process.file.full_path = $proc.principal.process.file.full_path

    // Detect the access-right combination required for DLL injection:
    // PROCESS_VM_WRITE (0x0020) | PROCESS_CREATE_THREAD (0x0002) |
    // PROCESS_VM_OPERATION (0x0008). EDR vendors surface this as a
    // hex string or decoded label in target.process.access_mask or
    // security_result.description. We match the decoded label pattern
    // that Chronicle normalises from Sysmon/EDR telemetry.
    // The regex covers common EDR representations of these combined rights.
    $proc.target.process.access_mask = /0x[0-9a-f]*[13][0-9a-f]*[28][0-9a-f]*/i nocase

    // Exclude processes explicitly approved for cross-process memory access.
    not $proc.principal.process.file.full_path in %global_allowed_process_open_sources

    // Exclude target processes that are legitimately inspected by approved tooling.
    not $proc.target.process.file.full_path in %global_allowed_process_open_targets

    // Require a populated hostname to anchor the alert to an asset.
    $proc.principal.hostname != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $source_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $source_user = array_distinct($proc.principal.user.userid)
    $access_mask_observed = array_distinct($proc.target.process.access_mask)

  condition:
    $proc
}
