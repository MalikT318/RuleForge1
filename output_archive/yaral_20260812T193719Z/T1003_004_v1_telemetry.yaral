/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:03:18.898508+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Registry_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects registry read or modification access to HKLM\\SECURITY\\Policy\\Secrets, the storage location for LSA secrets. Legitimate access to this key is extremely rare outside of the SYSTEM account performing internal OS operations. Adversaries with SYSTEM privileges use direct registry access to extract service account credentials, cached domain credentials, and other sensitive material stored by LSA."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 or equivalent EDR registry event). Windows Security audit policy for registry object access (Event 4663) is an alternative source. UDM event type REGISTRY_MODIFICATION must be populated with target.registry.registry_key."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows LSASS itself performing internal secret rotation; backup agents running as SYSTEM that snapshot the registry hive; domain join operations; some endpoint security products performing registry scanning. These are rare and should be validated by process lineage."
    tuning_guidance = "Add known-good SYSTEM-context processes (e.g., authorised backup agents) to %lsa_registry_allowed_processes. Narrow further by excluding events where principal.user.userid matches a known service account pattern via %lsa_allowed_service_accounts. Alert volume should be very low; any sustained activity warrants immediate investigation."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /HKEY_LOCAL_MACHINE\\SECURITY\\Policy\\Secrets/ nocase
    not $reg.principal.process.file.full_path in %lsa_registry_allowed_processes
    not $reg.principal.user.userid in %lsa_allowed_service_accounts

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $accessing_process = array_distinct($reg.principal.process.file.full_path)
    $accessing_user = array_distinct($reg.principal.user.userid)
    $registry_key_accessed = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
