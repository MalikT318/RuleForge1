/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:53:37.532569+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_Network_Device_CLI_Remote_Mgmt_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects inbound network connections to management-plane ports (SSH, Telnet, NETCONF, RESTCONF, gRPC) on network devices originating from addresses outside known internal management ranges. Adversaries abusing T1059.008 must first establish CLI access remotely; this rule catches the network-observable leg of that access from unexpected source space."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Script Interpreter: Network Device CLI"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs that record inbound sessions to network device management addresses. Connections must be logged with source IP, destination IP, and destination port."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised remote network engineers connecting from jump hosts or VPN exit nodes outside the internal RFC-1918 range; cloud-hosted NMS/SIEM collectors; vendor TAC remote-assist sessions."
    tuning_guidance = "Add all approved management source CIDRs and jump-host IPs to %approved_mgmt_sources. Add all known network device management IPs to %known_mgmt_plane_hosts. Raise severity to Critical if Telnet (port 23) is observed, as it should never appear in a hardened environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target must be a known management-plane host (network device)
    $net.target.ip in %known_mgmt_plane_hosts

    // Management-plane ports:
    //   22   = SSH
    //   23   = Telnet (legacy, high-risk)
    //   830  = NETCONF over SSH
    //   831  = NETCONF over TLS
    //   8080 = RESTCONF (HTTP alt)
    //   8443 = RESTCONF (HTTPS alt)
    //   57400 = gRPC / gNMI (common on modern network OS)
    $net.target.port in [22, 23, 830, 831, 8080, 8443, 57400]

    // Source must NOT be an approved management source
    not $net.principal.ip in %approved_mgmt_sources

    // Exclude loopback / link-local that may appear in normalised logs
    not $net.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
