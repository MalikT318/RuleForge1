/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:07:14.570650+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Password_Store_Read_Then_Exfil_Staging {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage credential harvesting pattern on Linux: a process reads a known password store or credential file (e.g. browser credential DB, keyring, .netrc, libsecret store, KeePass DB, pass store), followed within 10 minutes by a file creation event in a world-writable or staging directory on the same host. This combination suggests the credential material was read and then staged for exfiltration, without relying on command-line argument matching."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that emits FILE_READ events for sensitive paths and FILE_CREATION events. Auditd rules must include -w on credential store paths with -p r, and -w on /tmp, /dev/shm, /var/tmp with -p w."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Backup agents reading credential stores legitimately; password manager sync daemons; browser profile sync tools; automated secret rotation scripts."
    tuning_guidance = "Add trusted backup or sync process paths to %linux_allowed_credential_readers. Add approved staging directories to %linux_allowed_staging_paths. Narrow by principal.user.userid to exclude service accounts."

  events:
    // Stage 1: a process reads a known Linux password store or credential file
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\/(\.local\/share\/keyrings\/|\.gnome2\/keyrings\/|\.password-store\/|\.config\/chromium\/Default\/Login Data|\.config\/google-chrome\/Default\/Login Data|\.mozilla\/firefox\/[^\/]+\/key[34]\.db|\.mozilla\/firefox\/[^\/]+\/logins\.json|\.netrc|\.pgpass|\.aws\/credentials|\.config\/gcloud\/credentials\.db|\.config\/gcloud\/application_default_credentials\.json|keepass.*\.kdbx|\.vault-token|\/etc\/passwd|\/etc\/shadow|\/etc\/gshadow|\/var\/lib\/gnome-keyring\/)/ nocase
    not $read.principal.process.file.full_path in %linux_allowed_credential_readers
    $read.principal.hostname = $hostname
    $read.principal.user.userid = $userid

    // Stage 2: same user on same host creates a file in a world-writable or temp staging location
    $stage.metadata.event_type = "FILE_CREATION"
    $stage.target.file.full_path = /(^\/tmp\/|^\/var\/tmp\/|^\/dev\/shm\/|^\/run\/shm\/|^\/run\/user\/[0-9]+\/|^\/var\/spool\/|^\/home\/[^\/]+\/\.cache\/)/ nocase
    not $stage.target.file.full_path in %linux_allowed_staging_paths
    not $stage.principal.process.file.full_path in %linux_allowed_credential_readers
    $stage.principal.hostname = $hostname
    $stage.principal.user.userid = $userid

    // Enforce chronological ordering: read must precede staging
    $read.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $hostname, $userid over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1555")
    $primary_entity      = array_distinct($read.principal.hostname)
    $credential_files_accessed = array_distinct($read.target.file.full_path)
    $staging_files_created     = array_distinct($stage.target.file.full_path)
    $reading_processes         = array_distinct($read.principal.process.file.full_path)
    $staging_processes         = array_distinct($stage.principal.process.file.full_path)
    $affected_user             = array_distinct($userid)

  condition:
    $read and $stage
}
