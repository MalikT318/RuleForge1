/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:39:22.873652+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process opening a handle to a remote process with permissions consistent with PE injection (PROCESS_VM_WRITE + PROCESS_VM_OPERATION + PROCESS_CREATE_THREAD). Attackers must request these access rights before calling VirtualAllocEx/WriteProcessMemory/CreateRemoteThread. This rule pivots on the resulting PROCESS_OPEN telemetry rather than command-line arguments, providing additive coverage over process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR or Sysmon Event ID 10 (ProcessAccess) normalised to PROCESS_OPEN in UDM. The access mask field must be populated in target.process.access_mask or an equivalent UDM field. Sysmon must be configured to log ProcessAccess events (Event ID 10)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg, Visual Studio debugger), AV/EDR self-protection probes, process-monitoring tools (Process Explorer, Process Hacker), JIT compilers (CLR, JVM) writing to their own child processes, and some RMM agents."
    tuning_guidance = "Add known-good opener process paths to %global_allowed_process_openers (e.g. debuggers, AV engines). Add known-good target process paths to %global_allowed_injection_targets. Raise severity to Critical if the target process is a high-value system binary (lsass, svchost) by layering a second rule variant."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must not be a core Windows system binary acting on itself.
    // Regex matches common system paths to exclude; invert to flag unexpected openers.
    not $open.principal.process.file.full_path = /^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss][Yy][Ss][Tt][Ee][Mm]32\\(lsass|csrss|smss|wininit|services|svchost)\.exe$/ nocase

    // The opener process must not be in the approved admin-tool list.
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Target must not be in the approved injection-target exclusion list.
    not $open.target.process.file.full_path in %global_allowed_injection_targets

    // Target is a running Windows process (has a .exe extension).
    $open.target.process.file.full_path = /\.exe$/ nocase

    // The opener must not be opening itself (self-injection is a separate technique variant).
    // Require opener and target to differ at the process-image level.
    not $open.principal.process.file.full_path = $open.target.process.file.full_path

    // Access mask consistent with PE injection:
    // 0x1F0FFF = PROCESS_ALL_ACCESS (superset, always suspicious from non-system processes)
    // 0x001F = includes PROCESS_VM_WRITE (0x0020) | PROCESS_VM_OPERATION (0x0008) | PROCESS_CREATE_THREAD (0x0002)
    // Sysmon normalises the decimal access mask; match the hex patterns EDR/Sysmon emit.
    // PROCESS_VM_WRITE | PROCESS_VM_OPERATION | PROCESS_CREATE_THREAD = 0x002A
    // PROCESS_ALL_ACCESS on modern Windows = 0x1FFFFF
    $open.target.process.access_mask = /0x1[Ff][Ff][Ff][Ff][Ff]|0x[0-9A-Fa-f]*[2-9A-Fa-f][0-9A-Fa-f]/ nocase

    // Opener must not be running from a standard Windows or Program Files system path
    // without also being in the allowlist — catches userland / temp-path injectors.
    $open.principal.process.file.full_path = /^[Cc]:\\/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $access_mask_observed = array_distinct($open.target.process.access_mask)

  condition:
    $open
}
