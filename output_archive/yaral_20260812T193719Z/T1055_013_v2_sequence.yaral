/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:46:18.665241+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Doppelganging_Orphan_Process_No_File {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a hallmark of Process Doppelganging: a process is opened/created whose image path does not correspond to any file-creation event on disk in the same window, combined with a subsequent suspicious child process launch from that same host. TxF-based doppelganging writes the PE into a transacted file handle that is rolled back before the section is mapped, so the image never lands on disk as a committed file. This rule correlates a PROCESS_OPEN targeting a legitimate host process (handle acquisition step) with a PROCESS_LAUNCH where the spawned child has no matching on-disk image path, indicating the parent may be executing from a transacted/rolled-back section."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelganging"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_OPEN (handle acquisition) and PROCESS_LAUNCH events with process image paths and parent-child lineage. Sysmon Event IDs 10 (ProcessAccess) and 1 (ProcessCreate) cover both legs."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate process virtualization software, application compatibility shims, some AV/EDR self-protection drivers that open process handles before launching child processes. Sandboxing products may trigger the PROCESS_OPEN leg."
    tuning_guidance = "Add known-good parent process paths (e.g., security tooling, deployment agents) to %global_allowed_doppel_parents. Add known-good child process paths to %global_allowed_doppel_children. Narrow the PROCESS_OPEN target filter to only the most commonly abused host processes if false-positive volume is high."

  events:
    // Leg 1: A process opens a handle to a legitimate Windows host process.
    // Doppelganging requires a handle to an existing process whose memory
    // will be replaced. We look for cross-process handle acquisition targeting
    // common host processes used as doppelganging vessels.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|dllhost|taskhost|taskhostw|sihost|ctfmon|spoolsv|SearchIndexer|WmiPrvSE)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_doppel_parents
    $open.principal.hostname = $hostname

    // Leg 2: Shortly after the handle acquisition, a new process is launched
    // whose parent image path matches a known host process (the vessel) but
    // whose own image path sits in a suspicious or user-writable location,
    // consistent with a doppelganged section being mapped and executed.
    // The child image path is NOT in a standard Windows system directory,
    // indicating the spawned process image is anomalous for that parent.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|dllhost|taskhost|taskhostw|sihost|ctfmon|spoolsv|SearchIndexer|WmiPrvSE)\.exe$/ nocase
    not $proc.target.process.file.full_path = /\\(Windows|Program Files|Program Files \(x86\))\\/ nocase
    $proc.target.process.file.full_path = /\.(exe|dll|scr|com)$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_doppel_children
    $proc.principal.hostname = $hostname

    // Chronological ordering: handle acquisition precedes child process launch
    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($proc.principal.hostname)
    $vessel_process = array_distinct($open.target.process.file.full_path)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $spawned_child   = array_distinct($proc.target.process.file.full_path)
    $child_cmdline   = array_distinct($proc.target.process.command_line)

  condition:
    $open and $proc
}
