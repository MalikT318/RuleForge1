/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:44:35.549987+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_ProcessOpen_Then_Network {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a suspicious process opening a handle to a remote process (PROCESS_OPEN) followed by an outbound network connection from the same host within 5 minutes. Extra Window Memory injection requires the attacker to first obtain a handle to the target process before writing shellcode into shared sections and redirecting EWM pointers. The subsequent network connection suggests the injected payload is beaconing or staging additional tooling. This rule provides additive coverage beyond command-line detection by correlating cross-process handle acquisition with post-injection network activity."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN events (Sysmon Event ID 10 / EDR equivalent) and NETWORK_CONNECTION events. Both must be normalised into Chronicle UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), RMM agents that inspect remote processes, AV/EDR self-protection routines, and Windows accessibility tools that hook GUI processes."
    tuning_guidance = "Add known-good opener processes to %global_allowed_process_openers. Add internal network ranges to %rfc1918_internal to suppress purely internal beaconing. Narrow the rule further by restricting target processes to high-value GUI processes (explorer.exe, winlogon.exe) if false-positive volume is high."

  events:
    // Event 1: A non-system process opens a handle to a remote GUI/privileged process.
    // This is the prerequisite step for EWM injection: the attacker must obtain
    // a cross-process handle before they can call SetWindowLong/SetWindowLongPtr
    // to redirect EWM pointers.
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener must NOT be a known Windows system binary performing routine work.
    // We match on processes that are NOT residing in the core Windows system paths.
    not $open.principal.process.file.full_path = /\\(windows\\system32|windows\\syswow64|windows\\sysnative)\\/ nocase

    // The target of the handle open must be a GUI-capable or privileged process
    // that owns windows (and therefore has EWM). Common EWM injection targets:
    // explorer.exe, winlogon.exe, lsass.exe, svchost.exe, taskhost.exe, dwm.exe.
    $open.target.process.file.full_path = /\\(explorer|winlogon|lsass|svchost|taskhost|taskhostw|dwm|csrss)\.exe$/ nocase

    // Exclude known-good openers (RMM, AV, debuggers) via reference list.
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Capture the hostname to join with the network event.
    $open.principal.hostname = $hostname

    // -----------------------------------------------------------------------
    // Event 2: An outbound network connection from the same host, originating
    // from a process that is NOT a recognised browser or update service.
    // This represents the injected payload phoning home or staging tools.
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // The connecting process must NOT be a well-known browser or updater.
    not $net.principal.process.file.full_path = /\\(chrome|firefox|msedge|iexplore|MicrosoftEdge|OneDrive|MsMpEng|svchost)\.exe$/ nocase

    // Exclude purely internal traffic to reduce noise.
    not $net.target.ip in %rfc1918_internal

    // Exclude connections on well-known benign management ports (RDP, SMB, WinRM).
    not $net.target.port = 3389
    not $net.target.port = 445
    not $net.target.port = 5985
    not $net.target.port = 5986

    // Exclude known-good network-initiating processes.
    not $net.principal.process.file.full_path in %global_allowed_process_openers

    $net.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the network connection.
    $open.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1055.011")
    $primary_entity      = array_distinct($open.principal.hostname)
    $opener_process      = array_distinct($open.principal.process.file.full_path)
    $target_process      = array_distinct($open.target.process.file.full_path)
    $network_destination = array_distinct($net.target.ip)
    $network_ports       = array_distinct($net.target.port)
    $connecting_process  = array_distinct($net.principal.process.file.full_path)

  condition:
    $open and $net
}
