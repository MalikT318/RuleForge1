/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:58:14.525802+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_DefaultAccount_Login_Then_PrivilegedAction {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a well-known default or built-in service account authenticating successfully to an identity provider, followed by a privileged directory action (permission change, group modification, or user creation) within 1 hour. This pattern indicates potential abuse of a default account to establish persistence or escalate privileges in a SaaS or cloud identity environment."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires identity provider sign-in and directory audit logs normalised to UDM. Events must include principal.user.userid, metadata.event_type USER_LOGIN and USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION or USER_CREATION."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Automated provisioning pipelines using service accounts, break-glass emergency admin accounts used during incidents, vendor-managed default accounts with documented usage."
    tuning_guidance = "Add approved default/service account userids to %saas_allowed_default_accounts. Add known automation source IPs to %saas_allowed_automation_ips. Narrow the account name regex to match only the naming conventions observed in your tenant."

  events:
    // Event 1: Successful login by a default or well-known built-in account
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = /^(admin|administrator|root|guest|service|svc|default|system|noreply|no-reply|support|helpdesk|serviceaccount|sa[-_]|svc[-_]|adm[-_])/ nocase
    not $auth.principal.user.userid in %saas_allowed_default_accounts
    not $auth.principal.ip in %saas_allowed_automation_ips
    $auth.principal.user.userid = $account_id

    // Event 2: Privileged directory action performed by the same account
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $priv.principal.user.userid = $account_id
    not $priv.principal.user.userid in %saas_allowed_default_accounts

    // Chronological ordering: login must precede the privileged action
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $account_id over 1h

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $login_source_ips = array_distinct($auth.principal.ip)
    $privileged_action_count = count($priv.metadata.event_timestamp.seconds)
    $target_resources = array_distinct($priv.target.resource.name)

  condition:
    $auth and $priv
}
