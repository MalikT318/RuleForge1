/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:00:10.335649+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_Cloud_Login_Then_Privilege_Escalation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a cloud identity account login followed by a privilege or permissions change within 1 hour on the same user principal. This pattern is consistent with an adversary using a compromised cloud account to escalate privileges or persist by modifying IAM roles, group memberships, or directory permissions. Covers federated, synced, and cloud-native accounts."
    mitre_tactic    = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires identity provider sign-in logs and directory audit logs normalised to UDM USER_LOGIN and USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION events. Applicable to Entra ID, Okta, and similar IdPs feeding Chronicle."
    platform        = "IaaS"
    log_source      = "identity"
    false_positives = "Legitimate administrators performing routine IAM housekeeping immediately after logging in; automated provisioning pipelines using service accounts; onboarding workflows that grant permissions at first login."
    tuning_guidance = "Add known provisioning service account userids to %cloud_privileged_automation_accounts. Add known admin workstation source IPs to %cloud_admin_trusted_sources to reduce noise from routine admin sessions. Raise severity threshold if the acting user is not in %cloud_iam_admin_roles."

  events:
    // Leg 1: cloud identity login event
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %cloud_privileged_automation_accounts
    $auth.target.user.userid = $cloud_userid

    // Leg 2: privilege or permissions change on the same user identity
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $priv.principal.user.userid != ""
    not $priv.principal.user.userid in %cloud_privileged_automation_accounts
    $priv.principal.user.userid = $cloud_userid

    // Chronological ordering: login must precede the privilege change
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $cloud_userid over 1h

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1078.004")
    $primary_entity      = array_distinct($cloud_userid)
    $login_event_count   = count($auth.metadata.id)
    $priv_change_targets = array_distinct($priv.target.user.userid)
    $priv_change_actions = array_distinct($priv.metadata.description)
    $source_ips          = array_distinct($auth.principal.ip)

  condition:
    $auth and $priv
}
