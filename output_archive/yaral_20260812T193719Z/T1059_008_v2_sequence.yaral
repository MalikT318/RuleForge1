/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:53:55.044208+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_NetDevice_CLI_Login_Then_Config_Change {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a management-plane login to a network device followed by a configuration change within 5 minutes. Adversaries abusing the network device CLI (T1059.008) typically authenticate via SSH or Telnet and immediately issue configuration commands to modify routing, ACLs, startup config, or disable logging. This correlation rule fires on the observable network-layer sequence: management-plane authentication event followed by a setting modification event on the same device, providing coverage additive to any process-launch or command-line rules."
    mitre_tactic         = "Execution"
    mitre_technique      = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites    = "Requires firewall or network perimeter syslog forwarded to Chronicle with USER_LOGIN and SETTING_MODIFICATION events normalised into UDM. Management-plane authentication and configuration-change syslog messages must be ingested (e.g., Cisco IOS 'SYS-5-CONFIG_I', Juniper 'UI_COMMIT', or equivalent vendor syslog normalised by Chronicle parsers)."
    platform             = "Network Devices"
    log_source           = "firewall"
    false_positives      = "Authorised network engineers performing scheduled maintenance, automated configuration management tools (Ansible, NAPALM, Terraform), NOC change-window activities, and device provisioning workflows."
    tuning_guidance      = "Add authorised management source IPs to %allowed_mgmt_source_ips and authorised admin user accounts to %allowed_network_admins. Narrow the time window if false-positive rate is high in environments with frequent automated config pushes."

  events:
    // Event 1: Management-plane authentication to the network device
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $device_hostname
    $auth.target.hostname != ""
    not $auth.principal.ip in %allowed_mgmt_source_ips
    not $auth.principal.user.userid in %allowed_network_admins

    // Event 2: Configuration change on the same device shortly after login
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.hostname = $device_hostname
    $cfg.target.hostname != ""
    not $cfg.principal.user.userid in %allowed_network_admins

    // Chronological ordering: login must precede config change
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $device_hostname over 5m

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity    = array_distinct($device_hostname)
    $source_ips        = array_distinct($auth.principal.ip)
    $admin_users       = array_distinct($auth.principal.user.userid)
    $changed_settings  = array_distinct($cfg.target.resource.name)
    $login_count       = count($auth.metadata.event_timestamp.seconds)
    $config_change_count = count($cfg.metadata.event_timestamp.seconds)

  condition:
    $auth and $cfg
}
