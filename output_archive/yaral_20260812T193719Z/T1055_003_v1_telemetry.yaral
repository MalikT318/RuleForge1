/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:40:10.879512+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_Process_Handle_Open {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a process opening a handle to a remote thread in another process with permissions consistent with Thread Execution Hijacking (THREAD_SUSPEND_RESUME | THREAD_SET_CONTEXT | THREAD_GET_CONTEXT combined with PROCESS_VM_WRITE or PROCESS_VM_OPERATION). Attackers must request these access rights to suspend a thread, overwrite its context, and redirect execution to injected shellcode. This rule pivots on the PROCESS_OPEN telemetry layer rather than command-line arguments, providing additive coverage that is harder to evade."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR or Sysmon Event ID 10 (ProcessAccess) normalised to PROCESS_OPEN in UDM. The sensor must capture the granted access mask on cross-process handle requests."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Debuggers (Visual Studio, WinDbg, x64dbg), profilers (VTune, dotTrace), crash-dump collectors (WerFault, Procdump), legitimate AV/EDR self-protection, and some game anti-cheat engines open threads with broad access rights."
    tuning_guidance = "Add known debugger and profiler paths to %global_allowed_thread_openers. Consider narrowing by requiring the principal process to reside outside of known developer tool directories. Raise severity if the target process is a high-value system process (lsass, svchost, winlogon)."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must not be a known system self-inspection path
    not $open.principal.process.file.full_path in %global_allowed_thread_openers

    // Exclude the process opening a handle to itself (self-debugging / profiling)
    $open.principal.process.pid != $open.target.process.pid

    // Target is a running Windows system or user process - exclude trivial noise
    // by requiring the target to be a real executable (has .exe extension)
    $open.target.process.file.full_path = /\.exe$/ nocase

    // The access mask field populated by EDR/Sysmon for cross-process opens.
    // Mask values that cover THREAD_SUSPEND_RESUME (0x0002), THREAD_GET_CONTEXT (0x0008),
    // THREAD_SET_CONTEXT (0x0010), and PROCESS_VM_WRITE (0x0020) / PROCESS_VM_OPERATION (0x0008)
    // are represented in UDM as the granted_access string on the handle event.
    // Match the hex patterns that include the thread-hijacking-relevant permission combinations.
    // 0x1fffff = THREAD_ALL_ACCESS (highly suspicious from non-system processes)
    // 0x1f03ff = PROCESS_ALL_ACCESS
    // Patterns below match common attacker-requested masks documented in public research.
    (
      $open.target.resource.attribute.labels.key = "granted_access" and
      (
        $open.target.resource.attribute.labels.value = /0x1f[0-9a-f]{4}/ nocase or
        $open.target.resource.attribute.labels.value = /0x[0-9a-f]*[13][aAbBcCdDeEfF][0-9a-f]{2}/ nocase
      )
    )

    // Exclude openers that are children of known safe administrative parents
    not $open.principal.process.file.full_path = /\\(MsMpEng|SenseIR|csrss|werfault|WerFaultSecure)\.exe$/ nocase

    // Exclude openers living in well-known security product directories
    not $open.principal.process.file.full_path = /\\(Windows Defender|CrowdStrike|SentinelOne|Carbon Black|Cylance)\\/i nocase

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity    = array_distinct($open.principal.hostname)
    $opener_process    = array_distinct($open.principal.process.file.full_path)
    $target_process    = array_distinct($open.target.process.file.full_path)
    $opener_pid        = array_distinct($open.principal.process.pid)
    $target_pid        = array_distinct($open.target.process.pid)

  condition:
    $open
}
