/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:48:21.311411+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_Shell_Interpreter_Outbound_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound network connections on interactive shell or scripting interpreter ports (e.g. reverse shell callbacks, interactive SSH tunnels, or script-driven C2 beaconing) observed at the network perimeter. Firewall logs do not carry process context; this rule pivots to the network-observable signature: non-internal destination, high-risk destination port associated with shell interpreters or common reverse-shell staging, and short-lived or low-byte-count sessions indicative of command-and-control check-ins rather than bulk data transfer."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW. Fields needed: principal.ip, target.ip, target.port, network.application_protocol, network.sent_bytes."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate SSH management sessions to external jump hosts, authorised remote access tools, CI/CD pipelines reaching external build infrastructure, developer workstations connecting to cloud VMs."
    tuning_guidance = "Populate %internal_ip_ranges with all RFC-1918 and RFC-6598 CGNAT ranges used by the tenant. Add approved external management destinations to %allowed_mgmt_destinations. Raise the sent_bytes threshold if bulk-transfer false positives appear. Scope by source subnet if only server subnets are in scope."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal asset (firewall sees the inside initiator)
    $net.principal.ip in %internal_ip_ranges

    // Destination must be external (not in internal ranges)
    not $net.target.ip in %internal_ip_ranges

    // Destination must not be an approved management endpoint
    not $net.target.ip in %allowed_mgmt_destinations

    // Target ports associated with reverse shells, interactive interpreters,
    // and common C2 staging channels:
    //   22   - SSH (reverse tunnel / interactive shell)
    //   23   - Telnet (cleartext shell)
    //   4444 - Metasploit default reverse shell
    //   4445 - Common secondary reverse shell port
    //   5555 - Common reverse shell / ADB
    //   6666 - Common reverse shell
    //   7777 - Common reverse shell
    //   8888 - Python SimpleHTTPServer / reverse shell
    //   9001 - Tor / common C2
    //   9090 - Common reverse shell / web shell callback
    //   1337 - Common attacker port
    //   31337 - Classic "elite" backdoor port
    $net.target.port in [22, 23, 4444, 4445, 5555, 6666, 7777, 8888, 9001, 9090, 1337, 31337]

    // Exclude high-volume bulk transfers - reverse shells are typically
    // low-bandwidth interactive sessions. Threshold of 0 allows zero-byte
    // SYN-only entries; cap at 5 MB to exclude legitimate SSH file transfers.
    // Adjust via tuning_guidance above.
    $net.network.sent_bytes < 5242880

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
