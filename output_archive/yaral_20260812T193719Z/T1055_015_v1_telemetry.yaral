/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:47:27.730626+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_CrossProcess_Handle_Request {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a process opening a handle to another process with PROCESS_VM_WRITE or PROCESS_VM_OPERATION access rights, which is a prerequisite for ListPlanting. The attacker must write shellcode into the target process address space before triggering the SysListView32 sort callback. This rule pivots on the cross-process handle acquisition event rather than command-line arguments, providing coverage that is orthogonal to process-creation rules. Suspicious combinations are flagged when a non-system process opens a handle to a process that is known to host list-view controls (Explorer, common dialogs, etc.) or when an unusual parent opens a handle to any interactive process."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires EDR or Sysmon Event ID 10 (ProcessAccess) telemetry normalised to PROCESS_OPEN UDM events. The sensor must capture the granted access mask or the target process image path."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate accessibility tools (screen readers, magnifiers), debuggers (WinDbg, x64dbg), AV/EDR self-protection, process monitors (Process Explorer, Process Hacker), RMM agents, and some software installers that inject into Explorer for shell extension registration."
    tuning_guidance = "Populate %global_allowed_vm_write_sources with full paths of approved tools (debuggers, RMM agents, AV engines). Narrow further by requiring the target process to match /explorer\.exe$/ or common dialog hosts if false-positive volume is high."

  events:
    // PROCESS_OPEN maps to Sysmon Event 10 (ProcessAccess) in UDM.
    // principal = the process requesting the handle (the injector).
    // target    = the process whose handle is being opened (the victim).
    $open.metadata.event_type = "PROCESS_OPEN"

    // The requesting process must NOT be a known system binary.
    // Legitimate OS components that open cross-process handles live under System32/SysWOW64.
    // Flag anything outside those canonical paths.
    not $open.principal.process.file.full_path = /\\(Windows\\System32|Windows\\SysWOW64|Windows\\WinSxS)\\/ nocase

    // The requesting process must not be a kernel/system idle placeholder.
    not $open.principal.process.file.full_path = /^(System|Idle)$/ nocase

    // Target process is a GUI host that commonly owns SysListView32 windows:
    // explorer.exe, mmc.exe, taskmgr.exe, regedit.exe, or any process
    // hosting common file-open dialogs (comdlg32 / shell32 backed).
    // We match a broad set of interactive shell / management hosts.
    $open.target.process.file.full_path = /\\(explorer|mmc|taskmgr|regedit|msiexec|rundll32|dllhost|svchost)\.exe$/ nocase

    // Exclude the requesting process if it is the same binary as the target
    // (self-injection is a different technique and avoids false positives here).
    not $open.principal.process.file.full_path = $open.target.process.file.full_path

    // Exclude processes explicitly allow-listed by the MSSP or client.
    not $open.principal.process.file.full_path in %global_allowed_vm_write_sources

    // Exclude processes running from user temp / download directories
    // is NOT done here because those are exactly the paths we want to catch.
    // Instead exclude only well-known signed tool locations.
    not $open.principal.process.file.full_path = /\\(Program Files|Program Files \(x86\))\\/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($open.principal.hostname)
    $injector_process = array_distinct($open.principal.process.file.full_path)
    $target_process   = array_distinct($open.target.process.file.full_path)
    $affected_host    = array_distinct($open.principal.hostname)

  condition:
    $open
}
