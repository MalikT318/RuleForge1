/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:40:44.693111+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_OpenHandle_Then_Suspicious_Child {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a pattern consistent with Thread Execution Hijacking: a non-standard process opens a handle to a remote process (PROCESS_OPEN), and within 5 minutes that same host produces a PROCESS_LAUNCH where a normally-headless system binary spawns an unexpected interactive shell or scripting engine. The combination of cross-process handle acquisition followed by anomalous child-process lineage is a strong indicator of thread context hijacking (T1055.003). This rule is additive to existing command-line detections and focuses on the process-lineage and handle-acquisition signals."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (cross-process handle acquisition) and PROCESS_LAUNCH events with parent/child lineage. Sysmon Event ID 10 (ProcessAccess) maps to PROCESS_OPEN in UDM. Standard Windows Security log alone is insufficient."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), crash-reporting agents (WER), AV/EDR self-protection, RMM tools performing remote diagnostics, JIT compilers. Tune via %global_allowed_handle_openers and %global_allowed_parent_processes."
    tuning_guidance = "Add known-good handle-acquiring processes (debuggers, AV engines, RMM agents) to %global_allowed_handle_openers. Add approved parent processes that legitimately spawn shells to %global_allowed_parent_processes. Narrow the victim process regex if svchost or lsass generate excessive noise in your environment."

  events:
    // --- Leg 1: Cross-process handle acquisition ---
    // A process that is NOT a known-good tool opens a handle to a
    // sensitive system process. EDR/Sysmon surfaces this as PROCESS_OPEN.
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener must NOT be a well-known system process that legitimately
    // acquires handles (e.g. antivirus, WER). Exclude common benign openers.
    not $open.principal.process.file.full_path = /\\(MsMpEng|SenseIr|csrss|werfault|WerFaultSecure|lsass|services|svchost)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_handle_openers

    // The victim (target) process is a high-value system process whose
    // thread context is worth hijacking for privilege or stealth.
    $open.target.process.file.full_path = /\\(svchost|lsass|explorer|winlogon|spoolsv|taskhost|taskhostw|RuntimeBroker|SearchIndexer|dllhost)\.exe$/ nocase

    // Bind the host so we can join to Leg 2.
    $open.principal.hostname = $hostname

    // --- Leg 2: Anomalous child process from a normally-headless parent ---
    // After the handle is acquired the injected thread runs inside the victim
    // process, which then spawns a shell or scripting engine it would never
    // legitimately parent.
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent is one of the same high-value processes targeted in Leg 1.
    $proc.principal.process.file.full_path = /\\(svchost|lsass|explorer|winlogon|spoolsv|taskhost|taskhostw|RuntimeBroker|SearchIndexer|dllhost)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_parent_processes

    // Child is an interactive shell, scripting engine, or download utility —
    // none of which these parents should spawn under normal operation.
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic|msiexec|installutil|cmstp|msbuild|xwizard)\.exe$/ nocase

    // Join on the same host.
    $proc.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the suspicious spawn.
    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity    = array_distinct($hostname)
    $handle_opener     = array_distinct($open.principal.process.file.full_path)
    $victim_process    = array_distinct($open.target.process.file.full_path)
    $spawned_child     = array_distinct($proc.target.process.file.full_path)
    $child_cmdline     = array_distinct($proc.target.process.command_line)
    $opener_pid        = array_distinct($open.principal.process.pid)

  condition:
    $open and $proc
}
