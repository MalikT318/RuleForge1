/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:05:54.655646+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Mem_Read_Then_File_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a process opening /proc/<PID>/mem or /proc/<PID>/maps for reading (credential scraping from process memory) followed within 10 minutes by a file write to a world-writable or temporary location on the same host. This two-stage pattern indicates an adversary dumped in-memory credentials and staged them for exfiltration. Complements existing PROCESS_LAUNCH command-line rules by focusing on the file-access and staging artefacts rather than the invocation."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux EDR or auditd file-open/read telemetry (auditd -a always,exit -F arch=b64 -S open,openat -F dir=/proc) and file-creation telemetry for /tmp, /dev/shm, /var/tmp, and home directories."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace), performance profilers (perf, valgrind), container runtimes inspecting child processes, and security scanners that read /proc memory maps. Java/JVM garbage-collection tooling may also read /proc/<PID>/maps."
    tuning_guidance = "Add known profiler and debugger parent process paths to %linux_allowed_proc_readers. Add authorised staging directories or CI/CD agent paths to %linux_allowed_staging_paths. Narrow the file-write filter to specific sensitive extensions (.txt, .log, .out, .dump) if noise is high."

  events:
    // Stage 1: process reads /proc/<PID>/mem or /proc/<PID>/maps
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|smaps|environ)$/ nocase
    not $open.principal.process.file.full_path in %linux_allowed_proc_readers
    $open.principal.hostname = $hostname

    // Stage 2: a file is created in a temporary or world-writable staging location
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/shm\/|\/home\/[^\/]+\/\.[^\/]+)/ nocase
    not $file.target.file.full_path in %linux_allowed_staging_paths
    $file.principal.hostname = $hostname

    // Chronological ordering: proc read must precede the staging write
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1003.007")
    $primary_entity      = array_distinct($open.principal.hostname)
    $reading_process     = array_distinct($open.principal.process.file.full_path)
    $proc_paths_accessed = array_distinct($open.target.file.full_path)
    $staged_files        = array_distinct($file.target.file.full_path)
    $writing_process     = array_distinct($file.principal.process.file.full_path)
    $affected_users      = array_distinct($open.principal.user.userid)

  condition:
    $open and $file
}
