/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:03:03.480907+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_VSS_Shadow_Then_NTDS_File_Access {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a two-stage NTDS credential theft pattern: (1) a Volume Shadow Copy is created or manipulated via vssadmin, wmic, or PowerShell VSS APIs, followed within 10 minutes by (2) a FILE_CREATION or FILE_MODIFICATION event targeting a path consistent with the NTDS.dit database or its associated log files. This sequence is characteristic of shadow-copy-based NTDS extraction without requiring command-line matching, providing additive coverage over existing process-launch rules."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION/FILE_MODIFICATION telemetry with full target file paths, plus PROCESS_LAUNCH telemetry capturing VSS-related process activity. Both event types must be normalised into UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate AD backup solutions (Windows Server Backup, Veeam, Commvault) that snapshot VSS and copy NTDS as part of authorised backup jobs. Domain controller OS patching pipelines that touch NTDS log files. Authorised NTDS defragmentation via ntdsutil."
    tuning_guidance = "Add authorised backup service account names to %allowed_backup_userids and authorised backup process paths to %allowed_vss_processes. Consider scoping to domain-controller asset groups if your SIEM supports asset tagging."

  events:
    // Stage 1: VSS creation or manipulation by a process associated with shadow-copy tooling.
    // Targets the PROCESS_LAUNCH of vssadmin, wmic (with shadow sub-command context),
    // or PowerShell/pwsh invoking VSS COM objects. We match on the child process path
    // rather than command-line content to avoid duplicating existing CL-based rules.
    $vss.metadata.event_type = "PROCESS_LAUNCH"
    $vss.target.process.file.full_path = /\\(vssadmin|vshadow|wbadmin|diskshadow)\.exe$/ nocase
    not $vss.principal.process.file.full_path in %allowed_vss_processes
    not $vss.principal.user.userid in %allowed_backup_userids
    $vss.principal.hostname = $dc_host

    // Stage 2: A file write event whose target path resolves to the NTDS database
    // directory or a staging location that contains the NTDS.dit filename.
    // This fires on direct shadow-mount copies, ntdsutil IFM sets, and
    // Invoke-NinjaCopy-style raw reads that result in a new file on disk.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /ntds\.dit$/ nocase
    not $file.target.file.full_path in %allowed_ntds_backup_paths
    not $file.principal.user.userid in %allowed_backup_userids
    $file.principal.hostname = $dc_host

    // Chronological ordering: shadow copy must precede the NTDS file write.
    $vss.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $dc_host over 10m

  outcome:
    $risk_score          = max(95)
    $mitre_technique_id  = array_distinct("T1003.003")
    $primary_entity      = array_distinct($dc_host)
    $vss_process_path    = array_distinct($vss.target.process.file.full_path)
    $vss_parent_path     = array_distinct($vss.principal.process.file.full_path)
    $ntds_file_path      = array_distinct($file.target.file.full_path)
    $acting_user         = array_distinct($file.principal.user.userid)
    $vss_actor_user      = array_distinct($vss.principal.user.userid)

  condition:
    $vss and $file
}
