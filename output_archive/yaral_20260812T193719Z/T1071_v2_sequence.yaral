/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:12:12.877057+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_Beaconing_Then_Large_Outbound_Flow {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a Linux host that first exhibits periodic low-volume outbound connections (potential C2 beaconing over an application-layer protocol) and then produces a large outbound data transfer to the same external destination within a 5-minute window. This pattern is consistent with an implant checking in and then exfiltrating or receiving a large payload over HTTP, HTTPS, DNS-over-HTTPS, or other application-layer protocols. The rule operates entirely on firewall/perimeter telemetry and provides additive coverage beyond endpoint process-launch detections."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs normalised into Chronicle UDM with principal.ip, target.ip, target.port, network.sent_bytes, and metadata.event_type = NETWORK_CONNECTION or NETWORK_FLOW populated."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Software update daemons (apt, yum, dnf) performing scheduled checks followed by package downloads; monitoring agents phoning home; CDN-backed SaaS clients with bursty traffic; backup agents initiating large transfers after a heartbeat."
    tuning_guidance = "Add known-good external update and SaaS destinations to %firewall_allowed_update_destinations. Add internal RFC-1918 and link-local ranges to %firewall_internal_address_space. Raise the sent_bytes threshold or narrow target ports if high-volume legitimate traffic triggers the rule in a specific environment."

  events:
    // Event 1: small outbound connection - potential beacon check-in.
    // Narrow pre-filter: non-internal destination, common C2-capable ports,
    // small byte count consistent with a heartbeat/poll.
    $beacon.metadata.event_type = "NETWORK_CONNECTION"
    $beacon.network.sent_bytes > 0
    $beacon.network.sent_bytes < 4096
    $beacon.target.port = /^(80|443|8080|8443|53|2222|4443|9443)$/
    not $beacon.target.ip in %firewall_internal_address_space
    not $beacon.target.ip in %firewall_allowed_update_destinations
    $beacon.principal.ip = $src_ip
    $beacon.target.ip   = $dst_ip

    // Event 2: large outbound flow to the same external host shortly after.
    // Narrow pre-filter: same port family, significantly larger payload.
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.sent_bytes > 500000
    $flow.target.port = /^(80|443|8080|8443|53|2222|4443|9443)$/
    not $flow.target.ip in %firewall_internal_address_space
    not $flow.target.ip in %firewall_allowed_update_destinations
    $flow.principal.ip = $src_ip
    $flow.target.ip   = $dst_ip

    // Chronological ordering: beacon must precede the large flow.
    $beacon.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 5m

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity    = array_distinct($src_ip)
    $destination_ip    = array_distinct($dst_ip)
    $destination_ports = array_distinct($flow.target.port)
    $max_bytes_sent    = max($flow.network.sent_bytes)
    $beacon_bytes_sent = max($beacon.network.sent_bytes)

  condition:
    $beacon and $flow
}
