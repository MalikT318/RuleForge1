/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:12:51.945637+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_NetDev_HTTP_C2_Login_Then_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network device management-plane login followed within 5 minutes by an anomalous outbound HTTP/HTTPS connection originating from the same device. This pattern is consistent with adversaries using web protocols for C2 after gaining access to a network device, blending malicious traffic with legitimate web flows."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires firewall or perimeter device syslog forwarded to Chronicle with UDM normalisation. Both USER_LOGIN and NETWORK_CONNECTION/NETWORK_FLOW events must be ingested from the same device. Management-plane login events and egress flow records must be present."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate administrator logins followed by automated health-check or telemetry uploads to vendor cloud portals. Software-defined networking controllers that authenticate and then poll external APIs. Scheduled firmware update checks."
    tuning_guidance = "Add known management workstation source IPs to %allowed_mgmt_sources. Add approved external update or telemetry destinations to %allowed_device_update_destinations. Narrow $auth.principal.user.userid patterns to exclude known service accounts via %allowed_device_service_accounts."

  events:
    // Event 1: Management-plane login to the network device
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $device_hostname
    not $auth.principal.ip in %allowed_mgmt_sources
    not $auth.principal.user.userid in %allowed_device_service_accounts

    // Event 2: Outbound HTTP or HTTPS connection from the same device
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $device_hostname
    not $net.target.ip in %allowed_device_update_destinations
    not $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )

    // Chronological ordering: login must precede the outbound connection
    $auth.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $device_hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($device_hostname)
    $login_source_ips = array_distinct($auth.principal.ip)
    $login_userids = array_distinct($auth.principal.user.userid)
    $outbound_destination_ips = array_distinct($net.target.ip)
    $outbound_destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.target.ip)

  condition:
    $auth and $net
}
