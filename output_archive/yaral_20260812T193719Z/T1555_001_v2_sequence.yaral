/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:07:56.730596+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Keychain_File_Read_Then_Exfil_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-system process reading a Keychain database file followed by a network-capable or data-staging process launch on the same host within 10 minutes. This correlation targets the file-access-then-exfiltration pattern for Keychain credential theft, providing additive coverage beyond command-line-only detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "Requires macOS EDR or unified log telemetry that emits FILE_READ events for Keychain database paths and PROCESS_LAUNCH events with parent/child process paths. Both event types must be normalised into Chronicle UDM."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Backup agents (Time Machine, third-party backup tools), legitimate password managers (1Password, Bitwarden) accessing their own Keychain entries, iCloud Keychain sync daemons, security audit tooling run by administrators."
    tuning_guidance = "Add trusted backup and password-manager process paths to %macos_allowed_keychain_readers. Add approved data-staging or sync process paths to %macos_allowed_network_processes. Scope by principal.user.userid to exclude service accounts."

  events:
    // Event 1: A non-system process reads a Keychain database file
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/(Users\/[^\/]+\/Library\/Keychains|Library\/Keychains|Network\/Library\/Keychains)\/.+\.(keychain|keychain-db)$/ nocase
    not $file.principal.process.file.full_path = /^\/(System\/Library|usr\/libexec|usr\/sbin)\// nocase
    not $file.principal.process.file.full_path in %macos_allowed_keychain_readers
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $userid

    // Event 2: A network-capable or data-staging process is launched on the same host by the same user
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(curl|wget|python[23]?|ruby|perl|osascript|nc|ncat|ssh|sftp|ftp|rsync|tar|zip)$/ nocase
    not $proc.target.process.file.full_path in %macos_allowed_network_processes
    not $proc.principal.process.file.full_path = /^\/(System\/Library|usr\/libexec)\// nocase
    $proc.principal.hostname = $hostname
    $proc.principal.user.userid = $userid

    // Chronological ordering: file read must precede the staging/exfil process launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $userid over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($hostname)
    $affected_user = array_distinct($userid)
    $keychain_files_read = array_distinct($file.target.file.full_path)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $staging_process = array_distinct($proc.target.process.file.full_path)
    $staging_process_args = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
