/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Office Suite
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:57:57.302607+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_DefaultAccount_OfficeLogin_IdentityProvider {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a successful authentication event from a well-known default or built-in service account name against an identity provider. Adversaries abuse default accounts (e.g., admin, administrator, guest, root, service, svc, noreply, postmaster, break-glass) that organisations fail to rename or disable post-provisioning. This rule fires on USER_LOGIN events where the authenticating userid matches a pattern consistent with default account naming conventions, providing coverage at the authentication-result layer rather than the command-line layer."
    mitre_tactic    = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires identity provider sign-in logs normalised to UDM USER_LOGIN events. Entra ID Sign-In logs, Okta System Log, or equivalent must be forwarded to Chronicle."
    platform        = "Office Suite"
    log_source      = "identity"
    false_positives = "Break-glass / emergency-access accounts used during legitimate incidents; shared service accounts with generic names that have been formally approved; automated pipeline accounts named with default-like patterns."
    tuning_guidance = "Populate %allowed_default_account_names with formally approved generic account names (e.g., approved break-glass UPNs). Populate %allowed_default_account_hosts with source hosts permitted to authenticate with these accounts. Raise severity if the account also has directory-admin role assignments."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Match userid patterns consistent with well-known default / built-in account names.
    // Covers: admin, administrator, guest, root, svc*, service*, noreply, postmaster,
    // default, operator, support, helpdesk, test, demo, break.glass patterns.
    $auth.principal.user.userid = /^(admin|administrator|guest|root|default|operator|support|helpdesk|test|demo|noreply|no-reply|postmaster|svc[._\-]?|service[._\-]?|break[._\-]?glass|breakglass|emergency[._\-]?access|shared[._\-]?)/ nocase

    // Exclude formally approved default-named accounts tracked in a reference list.
    not $auth.principal.user.userid in %allowed_default_account_names

    // Exclude known-safe source hosts (e.g., approved automation servers).
    not $auth.principal.hostname in %allowed_default_account_hosts

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity    = array_distinct($auth.principal.user.userid)
    $source_ip         = array_distinct($auth.principal.ip)
    $target_resource   = array_distinct($auth.target.resource.name)
    $user_agent        = array_distinct($auth.network.http.user_agent)

  condition:
    $auth
}
