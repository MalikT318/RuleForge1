/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:49:45.752921+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_AppleScript_File_Artifact_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of compiled AppleScript artifacts (.scpt, .scptd, .osas) or plain-text AppleScript files with an osascript shebang written to suspicious locations outside standard application bundles. Adversaries stage AppleScript payloads as file artifacts for persistence, lateral movement, or deferred execution via Mail rules, Calendar alarms, or Automator workflows. This rule targets the resulting file state change rather than the osascript command line, providing additive coverage over process-creation detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "Requires macOS EDR file-creation telemetry normalised into Chronicle UDM FILE_CREATION events. The EDR agent must capture target.file.full_path and, where available, target.file.content or the creating process path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate Automator workflows saved by end users, Xcode AppleScript projects, developer tooling that compiles .scpt files, IT automation frameworks (e.g. Jamf scripts). Tune by adding known-good parent process paths and directories to the reference lists."
    tuning_guidance = "Add approved parent process paths to %macos_allowed_script_writers. Add approved directories (e.g. /Applications/Automator.app) to %macos_allowed_applescript_dirs. Raise severity to High if the creating process is not Automator, Script Editor, or Xcode."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file has an AppleScript-associated extension
    (
      $file.target.file.full_path = /\.(scpt|scptd|osas|applescript)$/ nocase
      or
      // Plain-text shell scripts declaring osascript as interpreter
      $file.target.file.full_path = /\.sh$/ nocase
    )

    // Written to user-writable or suspicious locations rather than inside
    // a signed application bundle - covers staging in home dirs, tmp, and
    // common persistence locations
    (
      $file.target.file.full_path = /^\/Users\/[^\/]+\/(Downloads|Desktop|Documents|Library|tmp|\.config|\.local)/ nocase
      or $file.target.file.full_path = /^\/tmp\// nocase
      or $file.target.file.full_path = /^\/var\/folders\// nocase
      or $file.target.file.full_path = /^\/Library\/(LaunchAgents|LaunchDaemons|Application Support|Scripts)\// nocase
      or $file.target.file.full_path = /^\/Users\/[^\/]+\/Library\/(LaunchAgents|Application Support|Scripts|Automator)\// nocase
    )

    // Exclude files written by known-legitimate AppleScript authoring tools
    not $file.principal.process.file.full_path in %macos_allowed_script_writers

    // Exclude known-safe directories (e.g. signed app bundles)
    not $file.target.file.full_path in %macos_allowed_applescript_dirs

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_user = array_distinct($file.principal.user.userid)
    $created_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
