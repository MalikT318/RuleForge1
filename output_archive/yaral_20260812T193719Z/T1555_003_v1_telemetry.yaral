/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:09:03.345383+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Browser_Credential_DB_File_Read_macOS {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a non-browser process opening or reading browser credential database files on macOS (e.g. Chrome Login Data, Firefox key4.db, Safari SafariPasswords). Credential-stealing tools must access these files directly; detecting the file-read event catches the technique regardless of how the tool was launched or named."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Web Browsers"
    log_prerequisites = "Requires macOS EDR telemetry that emits FILE_READ events with both the accessing process path and the target file path populated in UDM. Verified sources include CrowdStrike Falcon, SentinelOne, and Microsoft Defender for Endpoint on macOS."
    platform        = "macOS"
    log_source      = "macos_endpoint"
    false_positives = "Backup agents (Time Machine helper, third-party backup daemons), password managers with explicit browser-sync features, browser update helpers reading their own profile, and security scanners. Tune using %macos_allowed_browser_credential_readers."
    tuning_guidance = "Populate %macos_allowed_browser_credential_readers with full paths of approved backup or security tools (e.g. /Library/Application Support/CrashPlan/...). Narrow further by also excluding processes whose parent is the browser itself if your EDR populates principal.process.parent_process.file.full_path."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target: browser credential store files across Chrome/Chromium family,
    // Firefox family, and Safari — matched by path pattern, not filename alone.
    // Covers per-user profile paths (/Users/<any>/Library/...) and
    // system-level browser installs.
    (
      // Chrome / Chromium / Brave / Edge (Chromium) — SQLite credential DB
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/Application Support\/(Google\/Chrome|Chromium|BraveSoftware\/Brave-Browser|Microsoft Edge)\/[^\/]+\/Login Data/ nocase
      or
      // Firefox — NSS key database and logins JSON
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/Application Support\/Firefox\/Profiles\/[^\/]+\/(key4\.db|logins\.json|signons\.sqlite)/ nocase
      or
      // Safari — Keychain-backed password store and WebKit credential storage
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/(Safari|Cookies|WebKit)\/.*/ nocase
      or
      // Opera
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/Application Support\/com\.operasoftware\.[^\/]+\/[^\/]+\/Login Data/ nocase
    )

    // Exclude the browser processes reading their own credential files —
    // legitimate browser activity. Match on the accessing process name.
    not $file.principal.process.file.full_path = /\/(Google Chrome|Chromium|Brave Browser|Microsoft Edge|firefox|Safari|Opera)([^\/]*)?$/ nocase

    // Exclude system-level Apple processes and known safe helpers
    not $file.principal.process.file.full_path = /\/(safaridriver|com\.apple\.|WebKit|nsurlsessiond|trustd|syspolicyd)/ nocase

    // MSSP tuning exclusion — populated per-client with approved readers
    not $file.principal.process.file.full_path in %macos_allowed_browser_credential_readers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $credential_file_accessed = array_distinct($file.target.file.full_path)
    $username = array_distinct($file.principal.user.userid)

  condition:
    $file
}
