/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:56:57.723555+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_API_Exec_After_Image_Pull {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud audit sequence where a container image is pulled or a new container resource is created, followed within 5 minutes by an interactive exec or command execution API call against that container. This pattern is consistent with adversaries pulling a utility image and immediately executing commands inside it via the container API, without relying on process-level telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Requires cloud control-plane audit logs normalised into Chronicle UDM. Kubernetes audit logs (exec sub-resource) and container registry/runtime API audit events must be ingested. Events must populate principal.user.userid, target.resource.name, and metadata.event_type."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines that pull images and immediately run smoke-test commands; operators using kubectl exec for debugging; automated health-check frameworks that exec into containers post-deploy."
    tuning_guidance = "Add known CI/CD service accounts to %allowed_cicd_principals. Add approved container namespaces or resource name patterns to %allowed_container_namespaces. Raise severity if the principal is not a service account (i.e., a human identity performing exec)."

  events:
    // Leg 1: Container image pull or new container resource creation via cloud API
    $pull.metadata.event_type = "RESOURCE_CREATION"
    $pull.target.resource.type = /container/ nocase
    $pull.metadata.description = /pull|create|run|deploy/ nocase
    not $pull.principal.user.userid in %allowed_cicd_principals
    not $pull.target.resource.name in %allowed_container_namespaces
    $pull.principal.user.userid = $actor

    // Leg 2: Interactive exec or command execution API call against a container
    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.resource.type = /container/ nocase
    $exec.metadata.description = /exec|attach|run|command/ nocase
    not $exec.principal.user.userid in %allowed_cicd_principals
    not $exec.target.resource.name in %allowed_container_namespaces
    $exec.principal.user.userid = $actor

    // Chronological ordering: image pull/create must precede exec
    $pull.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $actor over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($actor)
    $pulled_resources = array_distinct($pull.target.resource.name)
    $exec_targets = array_distinct($exec.target.resource.name)
    $exec_descriptions = array_distinct($exec.metadata.description)
    $source_ips = array_distinct($exec.principal.ip)

  condition:
    $pull and $exec
}
