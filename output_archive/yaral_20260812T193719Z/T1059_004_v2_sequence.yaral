/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:51:21.395311+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_MacOS_Shell_Outbound_Then_Sustained_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with an interactive reverse shell on macOS: an initial outbound connection to a non-standard port is followed within 5 minutes by a sustained bidirectional flow to the same destination, suggesting an interactive Unix shell session established over the network. Firewall telemetry only - no process context required."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Script Interpreter: Unix Shell"
    log_prerequisites = "Requires perimeter or host-based firewall/flow logs normalised to Chronicle UDM NETWORK_CONNECTION and NETWORK_FLOW events. Bidirectional byte counts must be populated in network/sent_bytes and network/received_bytes."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "SSH administrative sessions, VPN tunnels, developer tools making persistent API connections, remote desktop solutions, legitimate backup agents."
    tuning_guidance = "Add approved management jump hosts and known-good destination CIDRs to %approved_remote_mgmt_destinations. Add internal RFC-1918 and link-local ranges to %rfc1918_and_loopback. Raise the received_bytes threshold if backup or sync traffic generates false positives."

  events:
    // Leg 1: initial outbound TCP connection to a non-standard port
    // (excludes well-known service ports to reduce noise from browsers/updates)
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.network.ip_protocol = "TCP"
    $conn.target.port > 1024
    $conn.target.port != 3389
    $conn.target.port != 5900
    $conn.target.port != 8080
    $conn.target.port != 8443
    $conn.target.port != 443
    $conn.target.port != 80
    not $conn.target.ip in %rfc1918_and_loopback
    not $conn.target.ip in %approved_remote_mgmt_destinations
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip
    $conn.target.port = $dst_port

    // Leg 2: sustained bidirectional flow to the same destination
    // High received_bytes indicates data flowing back to the host (shell output)
    // High sent_bytes indicates commands being typed (interactive input)
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.ip_protocol = "TCP"
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip
    $flow.target.port = $dst_port
    $flow.network.received_bytes > 2048
    $flow.network.sent_bytes > 512
    not $flow.target.ip in %rfc1918_and_loopback
    not $flow.target.ip in %approved_remote_mgmt_destinations

    // Chronological ordering: connection must precede the sustained flow
    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip, $dst_port over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($dst_port)
    $total_bytes_received = max($flow.network.received_bytes)
    $total_bytes_sent = max($flow.network.sent_bytes)

  condition:
    $conn and $flow
}
