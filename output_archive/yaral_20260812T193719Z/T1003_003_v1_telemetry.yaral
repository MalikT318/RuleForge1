/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:02:40.924632+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_File_Access_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects file read or creation events targeting the NTDS.dit database or its associated transaction logs outside of expected system paths. Adversaries copy or access NTDS.dit directly to extract credential hashes offline. This rule fires on the file artifact produced by the access, not on the process command line, providing a complementary detection layer to process-creation rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires EDR or Sysmon file-access telemetry (Sysmon Event ID 11 for FILE_CREATION, or EDR file-read events normalised to FILE_READ / FILE_CREATION in UDM). The sensor must be deployed on Domain Controllers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate AD backup solutions (Windows Server Backup, Veeam, Commvault) reading NTDS.dit as part of a scheduled backup job. NTDS.dit access by the LSASS / NTDS service itself at %SystemRoot%\\NTDS\\Ntds.dit is expected and should be excluded via the reference list."
    tuning_guidance = "Add the full paths of authorised backup agent executables to %global_allowed_ntds_readers. Add the canonical DC NTDS path (%SystemRoot%\\NTDS\\Ntds.dit) if your EDR generates noise from the NTDS service's own access. Scope the rule to assets tagged as Domain Controllers in your CMDB to reduce false positives on non-DC endpoints."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be the NTDS database file or its associated log files
    // Matches: any path containing ntds.dit, edb.log, edb*.log, or res1/res2.log
    $file.target.file.full_path = /[\\\/]ntds\.dit$/ nocase or
    $file.target.file.full_path = /[\\\/]edb(\d+)?\.log$/ nocase or
    $file.target.file.full_path = /[\\\/]res[12]\.log$/ nocase

    // Exclude the canonical in-place NTDS service path to suppress NTDS service self-access noise
    // Attackers copy the file OUT of this directory; the copy destination is the artifact we want
    not $file.target.file.full_path = /\\Windows\\NTDS\\Ntds\.dit$/ nocase

    // Exclude authorised backup readers maintained per-client
    not $file.principal.process.file.full_path in %global_allowed_ntds_readers

    // Require a principal process to be present (suppress system-generated synthetic events)
    $file.principal.process.file.full_path != ""

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
