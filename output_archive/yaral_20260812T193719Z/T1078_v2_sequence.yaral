/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Office Suite
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:57:39.132302+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_OfficeIdP_Login_Then_Privilege_Escalation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a valid-account abuse pattern in Office Suite / Identity Provider logs: a successful login from an unusual or new location is followed within 1 hour by a privilege or group change on the same account. This sequence is consistent with an adversary using compromised credentials to establish persistence or escalate privileges without deploying malware."
    mitre_tactic    = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires identity provider sign-in logs (Entra ID, Okta, or equivalent) normalised to UDM USER_LOGIN and USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION events. MFA result and country/city fields should be populated for best fidelity."
    platform        = "Office Suite"
    log_source      = "identity"
    false_positives = "Legitimate IT administrators performing planned privilege changes after travelling or working remotely; automated provisioning pipelines that authenticate and then assign roles; break-glass account usage during incidents."
    tuning_guidance = "Add known admin service accounts to %idp_allowed_priv_accounts. Add approved admin source countries or IP ranges to %idp_approved_admin_locations. Raise severity if MFA was not satisfied on the login event."

  events:
    // --- Leg 1: Successful login that looks anomalous ---
    // Narrow pre-filter: must be a completed, successful authentication
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.summary = /success|succeeded|completed/ nocase
    // Exclude known-good service accounts and approved admin identities
    not $auth.principal.user.userid in %idp_allowed_priv_accounts
    // Capture the joining entity: the authenticated user
    $auth.principal.user.userid = $userid

    // --- Leg 2: Privilege or group change on the same account within the window ---
    // Accept either a direct permission change or a group membership change
    // (both are produced by IdP audit logs and map to different UDM event types;
    //  we use GROUP_MODIFICATION here because it is the most reliably populated
    //  for role/group assignment events in Entra ID and Okta)
    $priv.metadata.event_type = "GROUP_MODIFICATION"
    // The target of the modification is the same user who just logged in
    $priv.target.user.userid = $userid
    // Exclude routine automated provisioning actors
    not $priv.principal.user.userid in %idp_allowed_priv_accounts
    // Exclude known-safe groups (e.g. distribution lists, low-privilege groups)
    not $priv.target.group.group_display_name in %idp_excluded_low_risk_groups

    // --- Chronological ordering: login must precede the privilege change ---
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $userid over 1h

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1078")
    $primary_entity      = array_distinct($userid)
    $login_source_ip     = array_distinct($auth.principal.ip)
    $login_user_agent    = array_distinct($auth.network.http.user_agent)
    $modified_group      = array_distinct($priv.target.group.group_display_name)
    $priv_actor          = array_distinct($priv.principal.user.userid)
    $auth_event_count    = count($auth.metadata.id)
    $priv_event_count    = count($priv.metadata.id)

  condition:
    $auth and $priv
}
