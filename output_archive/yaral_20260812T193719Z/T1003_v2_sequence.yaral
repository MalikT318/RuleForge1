/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:00:51.004410+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_macOS_CredDump_ProcOpen_Then_StagedFile {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a credential-dumping sequence on macOS: a process opens or attaches to a security-sensitive system process (e.g. securityd, loginwindow, opendirectoryd) followed within 10 minutes by creation of a file in a world-writable or user-temp location that matches common credential-staging patterns (e.g. .db, .plist, .json, .txt in /tmp or /var/folders). This two-stage signal is additive to command-line detections and targets the artifact-staging phase of credential dumping."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires macOS EDR or unified log telemetry normalised to Chronicle UDM. PROCESS_OPEN events must be generated when a process attaches to another process (e.g. task_for_pid / ptrace). FILE_CREATION events must capture target.file.full_path."
    platform        = "macOS"
    log_source      = "macos_endpoint"
    false_positives = "Legitimate security tools (e.g. Instruments, lldb, Xcode debugger), crash reporters, and MDM agents that inspect system processes. Backup agents writing to /tmp. Developers running local debug sessions."
    tuning_guidance = "Add known-good parent process paths to %macos_allowed_debugger_parents. Add approved staging directories or process names to %macos_allowed_staging_writers. Narrow the file extension regex if .txt or .json produce too many false positives in your environment."

  events:
    // Event 1: A non-system process opens / attaches to a sensitive macOS system process.
    // This covers task_for_pid-style process inspection surfaced as PROCESS_OPEN.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\/(securityd|loginwindow|opendirectoryd|DirectoryService|lsass|PasswordServer|authorizationhost)$/ nocase
    not $open.principal.process.file.full_path = /^\/(usr\/bin\/(lldb|python3?|ruby)|Applications\/Xcode\.app\/)/ nocase
    not $open.principal.process.file.full_path in %macos_allowed_debugger_parents
    $open.principal.hostname = $hostname

    // Event 2: A file with a credential-staging extension is created in a temp or world-writable path.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|private\/tmp|var\/folders\/[^\/]+\/[^\/]+\/[CT]\/|Users\/[^\/]+\/\.local\/share\/)/ nocase
    $file.target.file.full_path = /\.(db|sqlite|plist|json|txt|csv|log|dmp|bin)$/ nocase
    not $file.principal.process.file.full_path in %macos_allowed_staging_writers
    $file.principal.hostname = $hostname

    // Chronological ordering: process open must precede the file staging
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1003")
    $primary_entity      = array_distinct($open.principal.hostname)
    $attaching_process   = array_distinct($open.principal.process.file.full_path)
    $targeted_sys_proc   = array_distinct($open.target.process.file.full_path)
    $staged_file_paths   = array_distinct($file.target.file.full_path)
    $staging_writer      = array_distinct($file.principal.process.file.full_path)

  condition:
    $open and $file
}
