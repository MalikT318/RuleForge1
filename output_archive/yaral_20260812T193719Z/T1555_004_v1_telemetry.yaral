/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:09:42.034240+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_CredentialVault_File_Read {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-read access to Windows Credential Locker artifacts (.vcrd, Policy.vpol) under a user AppData path. Adversaries reading these files are attempting to extract encrypted credential material from the Windows Credential Manager vaults. This rule fires on the resulting file-access artifact rather than on process command-line arguments, providing coverage orthogonal to process-creation detections."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR or Sysmon file-read telemetry (Sysmon Event ID 15 / FileAccessEvent, or equivalent EDR file-access events normalised to FILE_READ in Chronicle UDM)."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Windows LSASS or credential backup utilities performing legitimate vault maintenance; enterprise password managers with vault integration; Windows Hello provisioning; authorised IT backup agents."
    tuning_guidance = "Add known-good backup agent or credential-management process paths to %global_allowed_vault_readers. Consider scoping to non-SYSTEM user contexts if LSASS generates noise."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target the two sensitive Credential Locker artifact types
    (
      $file.target.file.full_path = /\\AppData\\Local\\Microsoft\\(Vault|Credentials)\\.*\.vcrd$/  nocase
      or
      $file.target.file.full_path = /\\AppData\\Local\\Microsoft\\(Vault|Credentials)\\Policy\.vpol$/ nocase
    )

    // Must be under a user home directory (wildcard username)
    $file.target.file.full_path = /\\Users\\[^\\]+\\AppData\\Local\\Microsoft\\(Vault|Credentials)\\/  nocase

    // Exclude the OS credential subsystem itself performing routine access
    not $file.principal.process.file.full_path = /\\Windows\\System32\\lsass\.exe$/ nocase

    // Exclude known-good vault management processes via reference list
    not $file.principal.process.file.full_path in %global_allowed_vault_readers

    // Exclude Windows credential UI host (legitimate vault unlock flows)
    not $file.principal.process.file.full_path = /\\Windows\\System32\\(credentialuibroker|vaultcmd)\.exe$/ nocase

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity    = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $vault_file_path   = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
