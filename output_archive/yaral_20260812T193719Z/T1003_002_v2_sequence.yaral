/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:02:20.560742+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Registry_Export_Then_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects the two-stage SAM database extraction pattern: a process opens a handle to the HKLM\\SAM or HKLM\\SYSTEM registry hive (registry read/modification event), followed by creation of a suspicious output file on the same host within 10 minutes. This covers the 'reg save HKLM\\sam' and similar offline extraction paths without relying on command-line matching."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 12/13/14 or equivalent UDM REGISTRY_MODIFICATION) and file-creation telemetry (Sysmon Event ID 11 or EDR equivalent). Both must be normalised into Chronicle UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows backup agents (e.g. VSS writers, backup software) that legitimately snapshot registry hives; domain-join or provisioning tooling that reads HKLM\\SAM during imaging; authorised security assessment tools run by the red team."
    tuning_guidance = "Add authorised backup agent process paths to %global_allowed_registry_backup_procs. Add known-good output directories (e.g. backup staging paths) to %global_allowed_hive_export_paths. Scope by hostname or user if a specific host generates persistent false positives."

  events:
    // Stage 1: process touches the SAM or SYSTEM hive in the registry
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /HKLM\\(SAM|SYSTEM|SECURITY)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_registry_backup_procs
    $reg.principal.hostname = $hostname

    // Stage 2: a file is created that looks like a hive export or credential dump output
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(sam|hiv|hive|dmp|dump|ntds|dit|bak|save|out)$/ nocase
    not $file.target.file.full_path in %global_allowed_hive_export_paths
    $file.principal.hostname = $hostname

    // Chronological ordering: registry access precedes file creation
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys_accessed = array_distinct($reg.target.registry.registry_key)
    $files_created = array_distinct($file.target.file.full_path)
    $actor_processes = array_distinct($reg.principal.process.file.full_path)
    $actor_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $file
}
