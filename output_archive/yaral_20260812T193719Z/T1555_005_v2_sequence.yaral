/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:10:56.109083+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_PasswordManager_DB_Read_Then_Exfil_Process {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a non-password-manager process reading a password manager database file (1Password, Bitwarden, KeePass, Keychain export) followed within 10 minutes by a network-capable process launch on the same host. This two-stage pattern is consistent with credential harvesting from a password manager vault on macOS."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires macOS EDR or unified log telemetry that records file-read/open events and process-launch events with full path and parent context."
    platform        = "macOS"
    log_source      = "macos_endpoint"
    false_positives = "Backup agents (Time Machine, Backblaze, Carbon Copy Cloner) scanning user Library directories; Spotlight indexing password manager vaults; security scanners; developer tooling running integration tests against password manager SDKs."
    tuning_guidance = "Add known backup and indexing process paths to %macos_allowed_vault_readers. Add approved network utilities to %macos_allowed_net_processes. Narrow the vault path regex if only specific password managers are in scope."

  events:
    // Event 1: a process reads a password manager vault/database file
    // but is NOT the password manager application itself
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/(Users\/[^\/]+\/Library\/(Application Support|Preferences|Keychains)|Library\/(Application Support|Keychains))\/.*(\.agilekeychain|\.opvault|\.1pif|\.kdbx|\.kdb|\.bitwarden|\.keychain-db|\.keychain|vault\.json|data\.mdf)/ nocase
    not $file.principal.process.file.full_path = /\/(Applications|Users\/[^\/]+\/Applications)\/(1Password|KeePassXC|Bitwarden|KeyShade|Strongbox|MacPass|Buttercup)\.app\// nocase
    not $file.principal.process.file.full_path = /\/(usr\/libexec\/(trustd|securityd)|System\/Library\/Frameworks)/ nocase
    not $file.principal.process.file.full_path in %macos_allowed_vault_readers
    $file.principal.hostname = $hostname

    // Event 2: a network-capable process is launched on the same host
    // shortly after the vault read - consistent with staging exfiltration
    $net_proc.metadata.event_type = "PROCESS_LAUNCH"
    $net_proc.target.process.file.full_path = /\/(usr\/bin\/(curl|python[23]?|ruby|perl|nc|ncat|ssh|sftp|ftp)|usr\/local\/bin\/(curl|python[23]?|node|ruby|perl)|bin\/(nc|bash|sh|zsh)|usr\/bin\/osascript)/ nocase
    not $net_proc.target.process.file.full_path in %macos_allowed_net_processes
    not $net_proc.principal.process.file.full_path = /\/(Applications|Users\/[^\/]+\/Applications)\/(iTerm|Terminal|Xcode|JetBrains|Visual Studio Code)\.app\// nocase
    $net_proc.principal.hostname = $hostname

    // Chronological ordering: vault read must precede the network process launch
    $file.metadata.event_timestamp.seconds <= $net_proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1555.005")
    $primary_entity      = array_distinct($hostname)
    $vault_files_read    = array_distinct($file.target.file.full_path)
    $reading_processes   = array_distinct($file.principal.process.file.full_path)
    $net_processes_seen  = array_distinct($net_proc.target.process.file.full_path)
    $affected_users      = array_distinct($file.principal.user.userid)

  condition:
    $file and $net_proc
}
