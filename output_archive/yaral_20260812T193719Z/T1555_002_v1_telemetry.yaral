/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:08:14.925143+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Securityd_Memory_Proc_Mem_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects file read or access events targeting /proc/<pid>/mem or /proc/<pid>/maps for processes associated with credential stores or security daemons (e.g. gnome-keyring-daemon, kwallet, ssh-agent). An adversary with root access may open the memory of a credential-caching daemon to extract plaintext secrets, mirroring the macOS securityd memory technique on Linux equivalents. This rule fires on the FILE_READ artifact produced by the memory scrape rather than on the attacker's process launch, providing a complementary detection layer."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux EDR or auditd with file-open/read syscall auditing enabled (auditd rules: -a always,exit -F arch=b64 -S open,openat,read -F dir=/proc). Chronicle UDM must normalise these to FILE_READ events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace) used by developers; system monitoring agents (e.g. Datadog, Dynatrace) that inspect process memory for profiling; kernel crash dump collectors; authorised security scanners."
    tuning_guidance = "Add authorised monitoring agent process paths to %linux_allowed_mem_readers. Scope further by requiring principal.user.userid = 'root' if your EDR populates that field reliably. Consider pairing with a USER_LOGIN alert for unexpected root sessions to raise confidence."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|environ|fd)$/ nocase
    $file.principal.process.file.full_path = /\/(gnome-keyring-daemon|kwallet|kwalletd5|kwalletd|ssh-agent|gpg-agent|dbus-daemon|polkitd|pam|lsass|seahorse)/ nocase
    not $file.principal.process.file.full_path in %linux_allowed_mem_readers
    not $file.principal.process.file.full_path = /\/(gdb|strace|ltrace|perf|valgrind)/ nocase

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessed_proc_path = array_distinct($file.target.file.full_path)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
