/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:47:58.527271+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_CrossProc_Handle_Then_Shellcode_Region {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a ListPlanting-style injection sequence: a non-system process opens a handle to a foreign process (PROCESS_OPEN) and, within the same short window, a new executable memory region is created inside that target process (FILE_CREATION of a mapped section or a child process launches from the victim). The join is over the victim hostname and the target process identifier to avoid Cartesian explosion. This is variant 2 of 2 for T1055.015 and provides additive coverage beyond command-line process-launch rules by correlating cross-process handle acquisition with subsequent code-planting activity observed in the victim process context."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (cross-process handle acquisition) and PROCESS_LAUNCH events for child processes spawned from the victim. CrowdStrike Falcon, Microsoft Defender for Endpoint, and SentinelOne all surface these; Sysmon Event ID 10 (ProcessAccess) maps to PROCESS_OPEN."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate accessibility tools (screen readers, automation frameworks), debuggers, RMM agents performing process inspection, AV/EDR self-protection threads, and software installers that enumerate windows via FindWindow/EnumWindows."
    tuning_guidance = "Add known-good opener process paths (RMM agents, AV engines, debuggers) to %global_allowed_cross_proc_openers. Add known-good victim process names (explorer.exe variants used by deployment tools) to %global_allowed_listplant_victims. Narrow the PROCESS_OPEN filter to specific access-right bitmasks if your EDR surfaces them (PROCESS_VM_WRITE | PROCESS_VM_OPERATION = 0x28)."

  events:
    // Event 1: A non-system process acquires a cross-process handle to a
    // victim that hosts a SysListView32 control. Common victims are
    // explorer.exe, mmc.exe, taskmgr.exe, and other GUI processes.
    // PROCESS_OPEN in UDM: principal = opener, target = victim process.
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must NOT be a known Windows system binary location.
    // Legitimate list-view hosts open themselves; suspicious openers come
    // from user-writable or unusual paths.
    not $open.principal.process.file.full_path = /\\Windows\\System32\\/  nocase
    not $open.principal.process.file.full_path = /\\Windows\\SysWOW64\\/ nocase
    not $open.principal.process.file.full_path = /\\Windows\\explorer\.exe$/ nocase

    // Victim process is a GUI host that typically owns SysListView32 windows.
    $open.target.process.file.full_path = /\\(explorer|mmc|taskmgr|regedit|mstsc|control|rundll32|dllhost)\.exe$/ nocase

    // Exclude known-good openers via reference list.
    not $open.principal.process.file.full_path in %global_allowed_cross_proc_openers

    // Join anchors: same host, same victim process image name.
    $open.principal.hostname = $hostname
    $open.target.process.file.full_path = $victim_image

    // Event 2: Within the time window, a new child process is launched
    // whose PARENT is the victim GUI process. Under ListPlanting the
    // injected callback executes inside the victim, which may then spawn
    // a shell or loader. This is the observable side-effect of the
    // planted sort-callback executing arbitrary code.
    $child.metadata.event_type = "PROCESS_LAUNCH"

    // Parent of the new process must match the victim image captured above.
    $child.principal.process.file.full_path = $victim_image

    // The spawned child should be a shell, script host, or loader -
    // not a normal child of the victim (e.g. explorer spawning cmd is
    // anomalous; explorer spawning a browser is normal).
    $child.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32|certutil|bitsadmin|wmic)\.exe$/ nocase

    // Exclude known-good victim-spawned processes.
    not $child.target.process.file.full_path in %global_allowed_listplant_victims

    $child.principal.hostname = $hostname

    // Chronological ordering: handle acquisition precedes code execution.
    $open.metadata.event_timestamp.seconds <= $child.metadata.event_timestamp.seconds

  match:
    $hostname, $victim_image over 5m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1055.015")
    $primary_entity      = array_distinct($hostname)
    $opener_process      = array_distinct($open.principal.process.file.full_path)
    $victim_process      = array_distinct($victim_image)
    $spawned_child       = array_distinct($child.target.process.file.full_path)
    $child_cmdline       = array_distinct($child.target.process.command_line)
    $opener_user         = array_distinct($open.principal.user.userid)

  condition:
    $open and $child
}
