/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:49:03.929601+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_ScriptBlock_Artifact_Written {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects PowerShell script-block logging artifacts written to the Windows event log cache or AppData temp paths, and PowerShell module/profile files created in suspicious locations. PowerShell script-block logging (Event 4104) causes the engine to write decoded script content to disk-backed structures; adversaries using AMSI bypass, encoded commands, or reflective loading still produce these file artifacts. This rule pivots on the FILE_CREATION telemetry layer rather than command-line arguments, providing additive coverage against command-line evasion."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires EDR file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file-write events). PowerShell script-block logging should be enabled (HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ScriptBlockLogging). EDR must capture file creation events for AppData, Temp, and ProgramData paths."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate administrative PowerShell scripts writing output to temp directories; software installers using PowerShell helpers; RMM agents (e.g., patch management) that stage PS1 files; developer workstations running build pipelines."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_ps_file_writers. Add approved staging directories to %global_allowed_ps_staging_paths. Consider scoping to servers only if workstation noise is high. Correlate with network events to elevate severity."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file is a PowerShell script or module artifact
    $file.target.file.full_path = /\.(ps1|psm1|psd1|ps1xml)$/ nocase

    // Written into high-risk transient or user-writable directories
    // Covers: %TEMP%, %APPDATA%, %LOCALAPPDATA%, ProgramData, Public, Downloads, and Windows\Temp
    $file.target.file.full_path = /\\(Temp|tmp|AppData\\(Local|Roaming)|ProgramData|Users\\Public|Downloads|Windows\\Temp)\\/  nocase

    // The writing process is NOT a known legitimate PowerShell host or installer
    // Catches non-powershell.exe processes writing PS1 files (e.g., reflective loaders, .NET CLR hosts)
    not $file.principal.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase

    // Exclude known software deployment and RMM parent processes
    not $file.principal.process.file.full_path in %global_allowed_ps_file_writers

    // Exclude known safe staging paths (e.g., approved patch management directories)
    not $file.target.file.full_path in %global_allowed_ps_staging_paths

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity    = array_distinct($file.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $artifact_path     = array_distinct($file.target.file.full_path)
    $affected_user     = array_distinct($file.principal.user.userid)

  condition:
    $file
}
