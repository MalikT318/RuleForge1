/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:38:05.379763+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_Process_Open_Then_Remote_Thread {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a suspicious process opening a handle to a remote process (PROCESS_OPEN) followed within 5 minutes by a network connection from that same host. This two-stage pattern is consistent with classic injection techniques (e.g., VirtualAllocEx / WriteProcessMemory / CreateRemoteThread) where the injector first acquires a cross-process handle and then beacons out from the victim process. Deliberately avoids command-line matching to provide additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN events (Sysmon Event ID 10 / CrowdStrike process handle telemetry). Also requires network connection telemetry from the same sensor."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), AV/EDR self-protection opening handles to monitored processes, JIT compilers (JVM, CLR) opening handles to child worker processes, RMM agents."
    tuning_guidance = "Add known-good opener process paths to %global_allowed_process_openers. Add known-good target process paths to %global_allowed_injection_targets. Add internal IP ranges to %rfc1918_internal to suppress purely internal beaconing if desired."

  events:
    // --- Leg 1: suspicious cross-process handle acquisition ---
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener must NOT be a known-good system process that legitimately
    // opens handles to other processes (e.g., lsass, csrss, werfault).
    not $open.principal.process.file.full_path = /\\(lsass|csrss|werfault|wer|msiexec|svchost|services|smss|wininit|winlogon|spoolsv|taskhostw|sihost|fontdrvhost|dwm|audiodg|searchindexer|searchprotocolhost|searchfilterhost|runtimebroker|dllhost|conhost|ctfmon|taskmgr|procexp|procexp64|procmon|procmon64|mmc|wmiprvse|wsmprovhost)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Target of the handle must be a high-value process commonly abused
    // for injection (system processes, browsers, security tools).
    $open.target.process.file.full_path = /\\(lsass|svchost|explorer|RuntimeBroker|spoolsv|winlogon|csrss|wininit|smss|services|chrome|msedge|firefox|iexplore|MicrosoftEdge|SearchUI|SearchApp|notepad|mspaint|calc|regsvr32|rundll32|mshta|wscript|cscript|powershell|pwsh|cmd)\.exe$/ nocase
    not $open.target.process.file.full_path in %global_allowed_injection_targets

    // Bind to the shared join key
    $open.principal.hostname = $hostname

    // --- Leg 2: outbound network connection from the same host within the window ---
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Only flag connections to non-RFC-1918 destinations to reduce noise
    // from legitimate internal traffic; adjust via reference list if needed.
    not $net.target.ip in %rfc1918_internal

    // Exclude well-known benign destination ports (DNS, NTP, OCSP, Windows Update)
    not $net.target.port = 53
    not $net.target.port = 123
    not $net.target.port = 80
    not $net.target.port = 443

    // The network event must originate from the same host as the handle open
    $net.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the network connection
    $open.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1055")
    $primary_entity      = array_distinct($open.principal.hostname)
    $opener_process      = array_distinct($open.principal.process.file.full_path)
    $target_process      = array_distinct($open.target.process.file.full_path)
    $net_process         = array_distinct($net.principal.process.file.full_path)
    $destination_ips     = array_distinct($net.target.ip)
    $destination_ports   = array_distinct($net.target.port)

  condition:
    $open and $net
}
