/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:38:54.855169+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_WriteMemory_Then_RemoteThread {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects the two-stage DLL injection pattern: a non-system process opens a handle to a remote process (PROCESS_OPEN) and then a new thread is created in that remote process (PROCESS_INJECTION) within 5 minutes on the same host. This covers the VirtualAllocEx/WriteProcessMemory/CreateRemoteThread injection chain without relying on command-line matching."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN (handle acquisition to a remote process) and PROCESS_INJECTION events. Sysmon Event IDs 10 (ProcessAccess) and 8 (CreateRemoteThread) map to these UDM types after Chronicle normalisation."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), AV/EDR self-protection threads, JIT compilers (Java, .NET CLR), RMM agents, and software installers that inject into host processes for hooking."
    tuning_guidance = "Add known-good opener process paths (debuggers, AV engines, RMM agents) to %global_allowed_process_openers. Add known-good target process paths to %global_allowed_injection_targets. Narrow the rule further by excluding processes whose principal.user.userid matches a service account pattern."

  events:
    // Stage 1: a process acquires a handle to a DIFFERENT (remote) process
    // Sysmon Event 10 / EDR process-access telemetry -> UDM PROCESS_OPEN
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must not be a known Windows system binary
    not $open.principal.process.file.full_path = /\\(lsass|csrss|smss|wininit|services|svchost|winlogon|dwm|fontdrvhost|spoolsv|SearchIndexer)\.exe$/ nocase
    not $open.principal.process.file.full_path = /^C:\\Windows\\System32\\/i nocase
    not $open.principal.process.file.full_path = /^C:\\Windows\\SysWOW64\\/i nocase

    // Opener must not be in the allow-list
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Target (victim) process must be a real Windows host process worth injecting into
    $open.target.process.file.full_path = /\\(explorer|svchost|lsass|notepad|rundll32|regsvr32|msiexec|dllhost|werfault|taskhost|taskhostw|conhost|RuntimeBroker|SearchHost|sihost|ctfmon)\.exe$/ nocase

    not $open.target.process.file.full_path in %global_allowed_injection_targets

    // Bind to the shared host placeholder
    $open.principal.hostname = $hostname

    // Stage 2: a remote thread is created in the same target process on the same host
    // Sysmon Event 8 / EDR remote-thread telemetry -> UDM PROCESS_INJECTION
    $inj.metadata.event_type = "PROCESS_INJECTION"

    // The injecting process must not be a known-good system binary
    not $inj.principal.process.file.full_path = /^C:\\Windows\\System32\\/i nocase
    not $inj.principal.process.file.full_path = /^C:\\Windows\\SysWOW64\\/i nocase
    not $inj.principal.process.file.full_path in %global_allowed_process_openers

    // Target of the injection must be the same class of host process
    $inj.target.process.file.full_path = /\\(explorer|svchost|lsass|notepad|rundll32|regsvr32|msiexec|dllhost|werfault|taskhost|taskhostw|conhost|RuntimeBroker|SearchHost|sihost|ctfmon)\.exe$/ nocase

    // Bind to the same host
    $inj.principal.hostname = $hostname

    // Chronological ordering: handle open must precede thread creation
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity    = array_distinct($hostname)
    $opener_processes  = array_distinct($open.principal.process.file.full_path)
    $injection_targets = array_distinct($inj.target.process.file.full_path)
    $affected_users    = array_distinct($open.principal.user.userid)

  condition:
    $open and $inj
}
