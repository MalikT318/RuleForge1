/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:01:40.154374+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Dump_File_Written_After_Handle_Open {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a non-system process opening a handle to lsass.exe (PROCESS_OPEN) followed within 10 minutes by creation of a minidump-style file on the same host. This two-stage signal catches memory-dump workflows (comsvcs MiniDump, procdump, custom loaders) without relying on command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN events (Sysmon Event ID 10 / EDR equivalent) and FILE_CREATION events normalised into UDM. Both event types must be present for the correlation to fire."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate crash-reporting tools (WER, Dr. Watson), authorised vulnerability scanners, some AV/EDR self-protection checks that open lsass handles, and backup agents that snapshot process memory. Tune via %lsass_allowed_openers."
    tuning_guidance = "Add the full paths of approved tools (e.g. AV engines, authorised diagnostic utilities) to the %lsass_allowed_openers reference list. Consider narrowing the dump-file regex if your environment uses a specific naming convention for legitimate crash dumps."

  events:
    // --- Leg 1: a process opens a handle to lsass.exe ---
    $open.metadata.event_type = "PROCESS_OPEN"
    // Target of the open must be lsass
    $open.target.process.file.full_path = /\\lsass\.exe$/  nocase
    // Exclude well-known system paths that legitimately open lsass
    not $open.principal.process.file.full_path = /\\Windows\\System32\\(csrss|wininit|services|svchost|lsm|winlogon)\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\Windows\\SysWOW64\\(csrss|wininit|services|svchost|lsm|winlogon)\.exe$/ nocase
    not $open.principal.process.file.full_path in %lsass_allowed_openers
    // Bind the joining placeholder
    $open.principal.hostname = $hostname

    // --- Leg 2: a dump-style file is created on the same host ---
    $file.metadata.event_type = "FILE_CREATION"
    // Match common minidump / raw-dump extensions and lsass-themed names
    (
        $file.target.file.full_path = /\.(dmp|mdmp|dump|bin|dat)$/ nocase
        or
        $file.target.file.full_path = /lsass/  nocase
    )
    // Exclude Windows Error Reporting's own legitimate dump directory
    not $file.target.file.full_path = /\\Windows\\(WER|Minidump|memory\.dmp)/ nocase
    not $file.principal.process.file.full_path in %lsass_allowed_openers
    $file.principal.hostname = $hostname

    // --- Chronological ordering: handle open must precede file creation ---
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(95)
    $mitre_technique_id  = array_distinct("T1003.001")
    $primary_entity      = array_distinct($hostname)
    $opener_process      = array_distinct($open.principal.process.file.full_path)
    $dump_file_path      = array_distinct($file.target.file.full_path)
    $opener_user         = array_distinct($open.principal.user.userid)

  condition:
    $open and $file
}
