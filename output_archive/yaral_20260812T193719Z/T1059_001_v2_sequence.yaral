/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:49:24.826935+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_ScriptBlock_Then_Network {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a PowerShell process writing a script file to a user-writable or temp directory, followed within 5 minutes by a network connection from that same PowerShell process on the same host. This two-stage pattern is characteristic of download-and-execute or in-memory staging activity and is additive to command-line-only detections."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Event ID 11) and network-connection telemetry (Event ID 3) normalised into UDM FILE_CREATION and NETWORK_CONNECTION events. PowerShell script-block logging (Event ID 4104) is complementary but not required for this rule."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate PowerShell-based software deployment tools (SCCM, Ansible, DSC), update agents that stage scripts before phoning home, and developer workflows that download NuGet packages. RMM platforms frequently exhibit this pattern."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_ps_parents and known-good script staging directories to %global_allowed_ps_script_dirs. Narrow the network filter by adding approved internal CIDR ranges to %rfc1918_internal if internal destinations are acceptable."

  events:
    // Stage 1: PowerShell creates a script or payload file in a user-writable location
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    (
        $file.target.file.full_path = /\\(temp|tmp)\\/  nocase or
        $file.target.file.full_path = /\\appdata\\/     nocase or
        $file.target.file.full_path = /\\public\\/      nocase or
        $file.target.file.full_path = /\\programdata\\/ nocase
    )
    (
        $file.target.file.full_path = /\.(ps1|psm1|psd1|bat|vbs|js|hta|dll|exe)$/ nocase
    )
    not $file.target.file.full_path in %global_allowed_ps_script_dirs
    not $file.principal.process.file.full_path in %global_allowed_ps_parents
    $file.principal.hostname = $hostname

    // Stage 2: PowerShell makes an outbound network connection from the same host
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 0
    $net.principal.hostname = $hostname

    // Chronological ordering: file drop must precede the network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1059.001")
    $primary_entity      = array_distinct($file.principal.hostname)
    $dropped_file_paths  = array_distinct($file.target.file.full_path)
    $destination_ips     = array_distinct($net.target.ip)
    $destination_ports   = array_distinct($net.target.port)
    $ps_process_path     = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $net
}
