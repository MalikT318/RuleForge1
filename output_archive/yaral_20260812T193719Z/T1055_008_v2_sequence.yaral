/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:43:08.876064+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injection_Proc_Mem_Access_Sequence {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage ptrace injection pattern: a non-debugger process opens /proc/<pid>/mem or /proc/<pid>/maps (stage 1 - memory reconnaissance or write via procfs), followed by that same process launching a child within 5 minutes. Attackers use /proc/<pid>/mem as an alternative or complement to ptrace POKEDATA to write shellcode into a target process, then execute it. This rule is additive to command-line ptrace detections and focuses on the procfs memory-access vector."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that records FILE_READ or FILE_OPEN events against /proc filesystem paths and subsequent PROCESS_LAUNCH events with parent process context."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, lldb, strace), performance profilers (perf, valgrind), container runtimes inspecting /proc, monitoring agents (Datadog, Dynatrace), and security scanners. Tune by adding known tool paths to %linux_allowed_proc_mem_readers."
    tuning_guidance = "Populate %linux_allowed_proc_mem_readers with full paths of approved debuggers, profilers, and monitoring agents. Narrow further by excluding known CI/CD runner user accounts via principal.user.userid if needed."

  events:
    // Stage 1: A process reads /proc/<pid>/mem or /proc/<pid>/maps
    // This is the procfs-based memory access that accompanies or replaces ptrace PEEKDATA/POKEDATA
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|pagemap|task\/[0-9]+\/mem)$/ nocase
    not $open.principal.process.file.full_path = /\/(gdb|lldb|strace|ltrace|perf|valgrind|python[0-9.]*|ruby|java)$/ nocase
    not $open.principal.process.file.full_path in %linux_allowed_proc_mem_readers
    $open.principal.hostname = $hostname
    $open.principal.process.pid = $injector_pid

    // Stage 2: The same process (same pid on same host) spawns a child process
    // This indicates the injector is now executing code - either in itself after
    // gaining elevated context, or orchestrating further payload delivery
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.pid = $injector_pid
    $proc.principal.hostname = $hostname
    not $proc.target.process.file.full_path = /\/(gdb|lldb|strace|ltrace|perf|valgrind)$/ nocase
    not $proc.principal.process.file.full_path in %linux_allowed_proc_mem_readers

    // Enforce chronological ordering: memory access precedes child launch
    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $injector_pid over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($open.principal.hostname)
    $injector_process_path = array_distinct($open.principal.process.file.full_path)
    $accessed_proc_mem_paths = array_distinct($open.target.file.full_path)
    $spawned_child_processes = array_distinct($proc.target.process.file.full_path)
    $affected_user = array_distinct($open.principal.user.userid)

  condition:
    $open and $proc
}
