/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:04:31.069787+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_CachedCreds_RegRead_Then_PrivProcess {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage pattern associated with cached domain credential harvesting on Windows: (1) a process opens or reads the LSA Secrets / MSCache registry hive path, followed within 10 minutes by (2) a SYSTEM-context or elevated process launch from the same host that is consistent with credential extraction tooling behaviour (non-standard parent spawning a sensitive utility). This correlation provides additive coverage beyond simple command-line matching by anchoring on registry access to the DCC2 storage location and the subsequent privileged process activity."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires EDR or Sysmon registry event telemetry (EventID 12/13/14 or equivalent UDM REGISTRY_MODIFICATION/REGISTRY_CREATION) and process-launch telemetry (EventID 1 / 4688 or EDR equivalent). Both event streams must be normalised into Chronicle UDM."
    log_source      = "windows_endpoint"
    platform        = "Windows"
    false_positives = "Domain-joined backup agents reading LSA for credential sync, legitimate IT admin scripts querying cached credential count via registry, security scanning tools performing configuration audits."
    tuning_guidance = "Add known-good backup or management process paths to %global_allowed_lsa_readers. Add approved privileged utility paths to %global_allowed_priv_launchers. Scope by hostname or OU if noisy in specific environments."

  events:
    // Stage 1: registry access targeting the MSCache / LSA Secrets storage path
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SECURITY\\Cache/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_lsa_readers
    $reg.principal.hostname = $hostname

    // Stage 2: within the same host, a privileged process launches
    // from an unusual parent (non-standard shell or service host lineage)
    // that is consistent with post-registry-access credential extraction activity
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $hostname
    // Parent is a service host, WMI provider host, or scripting engine -
    // legitimate admin tools do not typically spawn from these after registry reads
    $proc.principal.process.file.full_path = /\\(svchost|wmiprvse|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    // Child process is a general-purpose interpreter or reg-access utility
    // (behavioural combination, not a named attacker tool)
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|reg|wmic|net|nltest)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_priv_launchers

    // Chronological ordering: registry access must precede the process launch
    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1003.005")
    $primary_entity      = array_distinct($hostname)
    $reg_keys_accessed   = array_distinct($reg.target.registry.registry_key)
    $reg_actor_process   = array_distinct($reg.principal.process.file.full_path)
    $child_process_path  = array_distinct($proc.target.process.file.full_path)
    $parent_process_path = array_distinct($proc.principal.process.file.full_path)
    $child_cmdline       = array_distinct($proc.target.process.command_line)

  condition:
    $reg and $proc
}
