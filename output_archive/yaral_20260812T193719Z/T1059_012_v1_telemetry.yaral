/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:56:03.860616+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Firewall_Config_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi host firewall or network configuration files that result from hypervisor CLI abuse (esxcli, vim-cmd). Attackers use these CLIs to disable firewall rules, enable outbound connectivity, or alter log forwarding — producing file-level state changes that persist even when command-line logging is incomplete. This rule targets the resulting artifact rather than the process invocation."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "Requires ESXi file integrity or hostd/shell audit telemetry forwarded to Chronicle. FILE_MODIFICATION events must be generated for /etc/vmware and /etc/vmware/firewall paths."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorized vSphere administrators applying firewall policy changes via vCenter, automated configuration management tools (Ansible, Puppet) managing ESXi baseline, VMware Update Manager applying patches."
    tuning_guidance = "Add known authorized management host identifiers or principal user accounts to %esxi_allowed_config_managers. Narrow scope by restricting to after-hours changes if change windows are predictable."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target ESXi firewall ruleset and network/syslog configuration files
    // These are the on-disk artifacts written by esxcli network firewall / esxcli system syslog
    $file.target.file.full_path = /\/(etc\/vmware\/(firewall|esx\.conf|hosts|syslog\.conf)|etc\/vmware\/firewall\/[^\/]+\.xml|var\/log\/hostd|scratch\/log)/ nocase

    // Exclude read-only or expected VMware daemon self-writes where distinguishable
    not $file.principal.user.userid in %esxi_allowed_config_managers

    // Exclude VMware internal service accounts performing routine writes
    not $file.principal.user.userid = /^(vpxuser|dcui)$/ nocase

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
