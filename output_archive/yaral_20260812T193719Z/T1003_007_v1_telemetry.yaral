/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:05:34.464572+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Mem_File_Read_Artifact {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-read access to /proc/<PID>/mem or /proc/<PID>/maps by a process other than the kernel debugger or known diagnostic tools. Adversaries with root privileges read these pseudo-files to extract credentials from process memory without spawning a dedicated dump utility. This rule fires on the FILE_READ event produced by Linux EDR or auditd when such access is recorded, providing coverage at the OS artifact layer rather than the command-line layer."
    mitre_tactic         = "Credential Access"
    mitre_technique      = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites    = "Requires Linux EDR or auditd with file-read (open/read syscall) telemetry normalised to UDM FILE_READ events. Auditd rules: -a always,exit -F arch=b64 -S open,openat,read -F dir=/proc -F success=1 -k proc_mem_access"
    platform             = "Linux"
    log_source           = "linux_endpoint"
    false_positives      = "Legitimate debuggers (gdb, strace, ltrace), system profilers (perf, valgrind), Java JVM introspection, container runtimes performing health checks, monitoring agents reading /proc/<PID>/maps for memory profiling."
    tuning_guidance      = "Add known monitoring agent binary paths to %linux_allowed_proc_readers. Scope by principal.user.userid to exclude root-equivalent service accounts that legitimately inspect /proc. Consider raising severity to Critical when the reading process is an interpreted language runtime (python, perl, ruby) or a shell."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target must be /proc/<numeric PID>/mem or /proc/<numeric PID>/maps
    $file.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps)$/ nocase

    // Exclude self-inspection: a process reading its own /proc entry is normal;
    // cross-process reads (different PID in path vs. reader PID) are suspicious.
    // We approximate this by requiring the reading process is NOT a known kernel
    // diagnostic binary. Exact self-PID comparison is not available in UDM, so
    // we rely on process-name exclusions and the reference-list exclusion below.
    not $file.principal.process.file.full_path = /\/(gdb|strace|ltrace|perf|valgrind|java|jvm)$/ nocase

    // Exclude known-good monitoring and profiling binaries via reference list
    not $file.principal.process.file.full_path in %linux_allowed_proc_readers

    // Require a real user-space process (principal process path must be set)
    $file.principal.process.file.full_path = /.+/

    // Exclude kernel threads (no user-space path)
    not $file.principal.process.file.full_path = /^\[/

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity    = array_distinct($file.principal.hostname)
    $reading_process   = array_distinct($file.principal.process.file.full_path)
    $target_proc_file  = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
