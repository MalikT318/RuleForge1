/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:52:40.484117+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_Python_Drops_File_Then_Executes_Child {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a Python interpreter writing a file to a user-writable or temp directory and then launching a child process within 5 minutes. This two-stage pattern is consistent with Python-based droppers that stage a payload and execute it, providing additive coverage beyond simple command-line detections."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Event ID 11) and process-launch telemetry (Event ID 1 / equivalent EDR). Both must be normalised into Chronicle UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate Python development workflows (pip install, build scripts, test runners), data-science tooling writing artefacts to temp directories, CI/CD agents running Python build steps."
    tuning_guidance = "Add known-good Python parent paths (e.g. IDE helpers, package managers) to %global_allowed_python_parents. Add approved staging directories to %global_allowed_python_write_dirs. Narrow the child-process filter if specific interpreters or shells are not present in your environment."

  events:
    // --- Leg 1: Python writes a file to a user-writable or temp location ---
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\python[0-9]*\.exe$/  nocase
    (
        $file.target.file.full_path = /\\Temp\\/                      nocase or
        $file.target.file.full_path = /\\AppData\\/                   nocase or
        $file.target.file.full_path = /\\ProgramData\\/               nocase or
        $file.target.file.full_path = /\\Users\\[^\\]+\\Downloads\\/  nocase or
        $file.target.file.full_path = /\\Public\\/                    nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_python_parents
    not $file.target.file.full_path in %global_allowed_python_write_dirs
    $file.principal.hostname = $hostname

    // --- Leg 2: Python (same host) spawns a notable child process ---
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\python[0-9]*\.exe$/ nocase
    (
        $proc.target.process.file.full_path = /\\cmd\.exe$/          nocase or
        $proc.target.process.file.full_path = /\\powershell\.exe$/   nocase or
        $proc.target.process.file.full_path = /\\pwsh\.exe$/         nocase or
        $proc.target.process.file.full_path = /\\wscript\.exe$/      nocase or
        $proc.target.process.file.full_path = /\\cscript\.exe$/      nocase or
        $proc.target.process.file.full_path = /\\mshta\.exe$/        nocase or
        $proc.target.process.file.full_path = /\\rundll32\.exe$/     nocase or
        $proc.target.process.file.full_path = /\\regsvr32\.exe$/     nocase or
        $proc.target.process.file.full_path = /\\certutil\.exe$/     nocase or
        $proc.target.process.file.full_path = /\\bitsadmin\.exe$/    nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_python_parents
    $proc.principal.hostname = $hostname

    // --- Chronological ordering: file drop must precede child launch ---
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1059.006")
    $primary_entity      = array_distinct($hostname)
    $dropped_files       = array_distinct($file.target.file.full_path)
    $child_processes     = array_distinct($proc.target.process.file.full_path)
    $child_cmdlines      = array_distinct($proc.target.process.command_line)
    $python_parent_path  = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $proc
}
