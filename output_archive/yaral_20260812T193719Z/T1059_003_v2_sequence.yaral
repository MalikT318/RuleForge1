/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:50:42.270499+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_CmdShell_Drops_BatchFile_Then_Executes {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a suspicious process writing a batch file (.bat/.cmd) to a user-writable or temporary location, followed within 5 minutes by cmd.exe executing that same batch file. This two-stage pattern is additive coverage beyond simple cmd.exe command-line matching and targets the file-drop-then-execute lifecycle common in script-based execution chains."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION telemetry (EventID 11) and PROCESS_LAUNCH telemetry (EventID 1 / EDR equivalent). Both event types must be normalised into UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers writing and executing setup scripts, RMM agents deploying batch-based configuration, build pipelines, and developer toolchains that legitimately drop and run batch files."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_batch_writers. Add known-good batch file directories (e.g., installer staging paths) to %global_allowed_batch_dirs. Narrow severity by correlating with user context (interactive vs. service account)."

  events:
    // Event 1: A suspicious process writes a batch file to a user-writable or temp path
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(bat|cmd)$/ nocase
    $file.target.file.full_path = /(\\Users\\[^\\]+\\(AppData|Desktop|Downloads|Documents)|\\Windows\\Temp|\\Temp|\\ProgramData|\\Public)/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|setup|install|update|deploy)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_batch_writers
    not $file.target.file.full_path in %global_allowed_batch_dirs
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $batch_path

    // Event 2: cmd.exe launches and executes that same batch file
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\cmd\.exe$/ nocase
    $proc.target.process.command_line = /\.(bat|cmd)(\s|"|'|$)/ nocase
    $proc.target.process.command_line = /(\\Users\\[^\\]+\\(AppData|Desktop|Downloads|Documents)|\\Windows\\Temp|\\Temp|\\ProgramData|\\Public)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_batch_writers
    $proc.principal.hostname = $hostname

    // Chronological ordering: file must be written before cmd executes it
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $batch_path over 5m

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $batch_files_written = array_distinct($file.target.file.full_path)
    $writing_processes  = array_distinct($file.principal.process.file.full_path)
    $executing_cmdlines = array_distinct($proc.target.process.command_line)
    $event_count        = count($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
