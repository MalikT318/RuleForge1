/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:53:20.596059+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_JS_Engine_Drops_Suspicious_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Windows Script Host or Node.js JavaScript engine process that subsequently creates a file in a user-writable or staging directory. This two-event sequence catches JS-based droppers and stagers that execute via wscript/cscript/node and write a payload to disk, providing additive coverage beyond command-line matching alone."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION events (Sysmon Event ID 11) and PROCESS_LAUNCH events (Sysmon Event ID 1 / EDR equivalent). Both event types must be normalised into Chronicle UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Node.js build pipelines, software installers using JScript, enterprise web application deployment scripts, developer toolchains writing build artefacts."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_js_engines and known-good output directories to %global_allowed_js_output_paths. Scope by hostname or user group for developer machines."

  events:
    // Event 1: A JavaScript engine process launches
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(wscript|cscript|node|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_js_engines
    $proc.principal.hostname = $hostname
    $proc.target.process.pid = $js_pid

    // Event 2: The same JS engine process creates a file in a suspicious location
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(wscript|cscript|node|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\\(Users\\[^\\]+\\(AppData\\(Local\\Temp|Roaming)|Downloads|Desktop)|Windows\\Temp|ProgramData|Temp)\\/ nocase
    $file.target.file.full_path = /\.(exe|dll|bat|cmd|ps1|vbs|js|hta|scr|com|pif|msi|jar|lnk)$/ nocase
    not $file.target.file.full_path in %global_allowed_js_output_paths
    $file.principal.hostname = $hostname
    $file.principal.process.pid = $js_pid

    // Chronological ordering: process must launch before file is created
    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $js_pid over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $js_engine_path = array_distinct($proc.target.process.file.full_path)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
