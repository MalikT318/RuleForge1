/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:55:47.204367+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Execution_Then_Outbound_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Lua interpreter process launch on Windows followed within 5 minutes by an outbound network connection from the same host. This correlation catches Lua-based malware that executes scripts and then beacons out or exfiltrates data, providing additive coverage beyond command-line argument matching alone."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires EDR/Sysmon process telemetry (PROCESS_LAUNCH) and firewall or network perimeter logs (NETWORK_CONNECTION or NETWORK_FLOW). Both must be ingested into Chronicle and normalised to UDM."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Game engines and embedded applications that bundle a Lua interpreter (e.g. game clients, automation frameworks, network device management tools). Legitimate scripting workflows by developers or administrators. Security tooling that uses Lua for policy evaluation."
    tuning_guidance = "Add known-good Lua-embedding application hostnames to %global_lua_allowed_hosts. Add approved external destination CIDRs or IPs to %global_allowed_lua_destinations. Narrow the Lua process name regex if the environment uses a renamed interpreter for a specific product."

  events:
    // Event 1: Lua interpreter launches on a Windows endpoint (EDR telemetry)
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\lua(5\.[0-9]|jit|[0-9]+)?\.exe$/ nocase
    not $proc.principal.hostname in %global_lua_allowed_hosts
    $proc.principal.hostname = $hostname

    // Event 2: Outbound network connection from the same host (firewall/perimeter telemetry)
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $hostname
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_lua_destinations

    // Chronological ordering: process launch must precede the network connection
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $lua_process_path = array_distinct($proc.target.process.file.full_path)
    $lua_cmdline = array_distinct($proc.target.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc and $net
}
