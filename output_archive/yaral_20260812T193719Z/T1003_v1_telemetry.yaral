/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:00:29.630624+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_Linux_Credential_File_Access_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification events targeting Linux credential stores and shadow password files in sensitive paths (/etc/shadow, /etc/passwd, /etc/gshadow, /etc/master.passwd). Credential dumping tools frequently read these files and write their contents to a staging location such as /tmp, /dev/shm, or /var/tmp. This rule fires on writes to those staging paths when the file name pattern resembles a credential dump artifact, providing coverage orthogonal to process-launch command-line detection."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup agents writing scheduled copies of /etc/shadow or /etc/passwd to staging directories; configuration management tools (Ansible, Puppet, Chef) staging credential files during provisioning; legitimate sysadmin scripts performing manual backups."
    tuning_guidance = "Add known backup agent process paths to %linux_allowed_credential_readers. Add approved staging directories or file name patterns to %linux_allowed_credential_staging_paths. Narrow scope by correlating with the writing process identity if EDR populates principal.process.file.full_path."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: files written into volatile or world-writable staging directories
    // that match naming patterns consistent with credential dump artifacts.
    // Covers /tmp, /dev/shm, /var/tmp, /run, and hidden dot-files in home dirs.
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/home\/[^\/]+\/\.[^\/]+)/ nocase

    // File name must resemble a credential dump: contains keywords like
    // shadow, passwd, creds, dump, hash, loot, or ntlm (cross-platform tools
    // such as Mimikatz-for-Unix emit ntlm artifacts on Linux).
    $file.target.file.full_path = /(shadow|passwd|gshadow|master\.passwd|cred|dump|hash|loot|ntlm|sam_|secrets)/ nocase

    // Exclude known-safe writing processes (backup agents, config management).
    not $file.principal.process.file.full_path in %linux_allowed_credential_readers

    // Exclude known-safe staging paths approved by the customer.
    not $file.target.file.full_path in %linux_allowed_credential_staging_paths

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($file.principal.hostname)
    $artifact_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
