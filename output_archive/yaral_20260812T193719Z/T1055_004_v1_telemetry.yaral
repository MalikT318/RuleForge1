/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:41:04.781800+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Suspended_Process_Handle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where a non-system process requests cross-process handle access to a suspended or alertable target process, consistent with APC injection (QueueUserAPC / Early Bird). Attackers must open a handle to the victim process before queuing an APC; this state-change artifact is harder to suppress than command-line telemetry."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised into UDM PROCESS_OPEN events. The target.process.access_mask or equivalent field must be populated. Sysmon must be configured with ProcessAccess rules."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers (Visual Studio, WinDbg), legitimate AV/EDR self-protection handles, crash-dump collectors (WER), JIT compilers (CLR, JVM), and some RMM agents that inspect remote process memory."
    tuning_guidance = "Add known-good parent process paths (debuggers, AV engines, RMM agents) to %global_allowed_process_open_sources. Narrow further by requiring the requesting process to reside outside of C:\\Windows\\System32 and C:\\Program Files."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Requesting process is NOT a known system binary location
    // Covers user-land injectors, dropped loaders, and living-off-the-land abuse
    not $open.principal.process.file.full_path = /\\Windows\\System32\\/  nocase
    not $open.principal.process.file.full_path = /\\Windows\\SysWOW64\\/ nocase
    not $open.principal.process.file.full_path = /\\Windows\\WinSxS\\/   nocase

    // Target process is a common injection victim: a Windows host process
    // or a newly-spawned suspended process used in Early Bird injection
    $open.target.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|dllhost|werfault|conhost|notepad|msiexec|regsvr32|rundll32|wscript|cscript|mshta)\.exe$/ nocase

    // Exclude the process opening itself (self-handles are benign)
    $open.principal.process.pid != $open.target.process.pid

    // Exclude known-good openers via reference list
    not $open.principal.process.file.full_path in %global_allowed_process_open_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($open.principal.hostname)
    $requesting_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $requesting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
