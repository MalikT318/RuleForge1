/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:39:44.850069+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_OpenThenRemoteThread {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a two-stage PE injection pattern: a process opens a handle to a remote process (PROCESS_OPEN) and, within 5 minutes on the same host, a new thread is created inside that remote process (PROCESS_INJECTION). This sequence mirrors the VirtualAllocEx / WriteProcessMemory / CreateRemoteThread API chain used by PE injection without requiring a file on disk or a specific command line."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN (handle-to-process) and PROCESS_INJECTION (remote-thread creation) UDM events. CrowdStrike Falcon, Microsoft Defender for Endpoint, and Sysmon Event IDs 10 and 8 all produce this telemetry and are normalised by Chronicle UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), JIT compilers (JVM, CLR), AV/EDR self-protection threads, RMM agents performing memory inspection, and some DRM software."
    tuning_guidance = "Add known-good injecting processes (e.g. JVM, CLR hosts, approved RMM agents) to %global_allowed_injection_sources. Add known-good target processes to %global_allowed_injection_targets. Narrow severity by excluding self-injection (principal.process = target.process on the same PID)."

  events:
    // Stage 1: a process opens a handle to another (remote) process
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\.exe$/  nocase
    // Exclude self-opens: injector and target must differ
    $open.principal.process.pid != $open.target.process.pid
    // Exclude known-good injecting processes
    not $open.principal.process.file.full_path in %global_allowed_injection_sources
    // Exclude common system self-inspection paths (e.g. antivirus, WER)
    not $open.principal.process.file.full_path = /\\(werfault|wermgr|mrt|msmpeng|svchost)\.exe$/ nocase
    $open.principal.hostname = $hostname

    // Stage 2: a remote thread is created inside the target process on the same host
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_injection_sources
    not $inj.target.process.file.full_path in %global_allowed_injection_targets
    // Exclude common benign injection targets used by the OS itself
    not $inj.target.process.file.full_path = /\\(werfault|wermgr|conhost|csrss)\.exe$/ nocase
    $inj.principal.hostname = $hostname

    // Chronological ordering: handle open must precede thread creation
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

    // Correlate the injecting process across both events so the join is tight
    $open.principal.process.file.full_path = $injector_path
    $inj.principal.process.file.full_path  = $injector_path

  match:
    $hostname, $injector_path over 5m

  outcome:
    $risk_score        = max(90)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity    = array_distinct($hostname)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $target_processes  = array_distinct($inj.target.process.file.full_path)
    $injecting_pids    = array_distinct($open.principal.process.pid)
    $target_pids       = array_distinct($inj.target.process.pid)

  condition:
    $open and $inj
}
