/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:54:53.331899+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoHotKey_AutoIT_Script_File_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation of AutoHotKey (.ahk) or AutoIT (.au3) script files on disk. Adversaries use these scripting languages to execute payloads, implement keyloggers, and deliver phishing implants. This rule pivots on the file-artifact layer rather than process command-line arguments, providing coverage that survives command-line logging evasion."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write telemetry must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate automation engineers, QA teams, and IT operations staff who author AHK or AutoIT scripts for workflow automation. Software installers that drop .au3 helper scripts during setup."
    tuning_guidance = "Add known-good parent process paths (e.g., IDE executables, build pipeline agents) to %global_allowed_script_creators. Add trusted staging directories to %global_allowed_script_directories if your environment legitimately writes these files to fixed locations."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match .ahk (AutoHotKey) or .au3 (AutoIT) script extensions
    $file.target.file.full_path = /\.(ahk|au3)$/  nocase

    // Exclude files written into known-good developer / installer directories
    // using a reference list so MSSP operators can tune per client
    not $file.target.file.full_path = /\\(program files|program files \(x86\))\\autoit3\\/  nocase
    not $file.target.file.full_path = /\\(program files|program files \(x86\))\\autohotkey\\/  nocase

    // Exclude trusted parent processes (build agents, IDEs, authorised automation)
    not $file.principal.process.file.full_path in %global_allowed_script_creators

    // Exclude trusted staging directories defined per-client
    not $file.target.file.full_path in %global_allowed_script_directories

    // Raise signal when the writing process is NOT the canonical AutoIT or AHK editor/compiler
    // (i.e., something unexpected is dropping the script)
    not $file.principal.process.file.full_path = /\\(scite|aut2exe|autoit3|autohotkey)\.exe$/  nocase

  outcome:
    $risk_score        = max(65)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_file_path = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $writing_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
