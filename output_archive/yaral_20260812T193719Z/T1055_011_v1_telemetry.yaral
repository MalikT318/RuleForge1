/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:44:07.895924+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_Process_Handle_Request {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a non-privileged or unexpected process opening a handle to a GUI process with VM_WRITE or equivalent cross-process memory access rights, which is a prerequisite for Extra Window Memory (EWM) injection. Attackers write shellcode into a shared section of the target process, store a pointer in EWM, then redirect execution. This rule pivots on the PROCESS_OPEN telemetry layer rather than command-line arguments, providing coverage orthogonal to process-creation rules."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised into Chronicle UDM PROCESS_OPEN events. The EDR must capture cross-process handle requests including the access mask or a description of the requested rights."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Accessibility tools (e.g., screen readers, magnifiers), legitimate UI automation frameworks, some AV/EDR self-protection drivers, remote desktop or virtualisation agents that enumerate GUI windows, and developer debugging sessions."
    tuning_guidance = "Add known-good parent process paths (accessibility tools, RMM agents, UI automation) to %global_allowed_process_open_sources. Add known-good target process paths to %global_allowed_ewm_targets. Scope by principal.user.userid to exclude service accounts that legitimately perform cross-process operations."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The requesting (principal) process must NOT be a known Windows GUI subsystem component.
    // Legitimate EWM access originates from the same process or well-known shell components.
    // Suspicious openers are non-system processes requesting write access to another GUI process.
    not $open.principal.process.file.full_path = /\\(explorer|dwm|csrss|winlogon|lsass|services|svchost|taskhostw|sihost|ctfmon|fontdrvhost)\.exe$/ nocase
    not $open.principal.process.file.full_path = /^C:\\Windows\\System32\\/i nocase
    not $open.principal.process.file.full_path = /^C:\\Windows\\SysWOW64\\/i nocase

    // Target must be a GUI-capable process - common injection targets for EWM
    // (explorer, notepad, browser renderer processes, etc.)
    $open.target.process.file.full_path = /\\(explorer|notepad|mspaint|calc|wordpad|iexplore|msedge|chrome|firefox|opera|brave)\.exe$/ nocase

    // The requesting process should not be the same binary as the target
    // (self-injection is a different technique variant)
    not $open.principal.process.file.full_path = $open.target.process.file.full_path

    // Exclude processes running from standard program directories that are
    // explicitly allow-listed by the MSSP tuning reference list
    not $open.principal.process.file.full_path in %global_allowed_process_open_sources
    not $open.target.process.file.full_path in %global_allowed_ewm_targets

    // Exclude SYSTEM-context openers that are expected to have broad access
    not $open.principal.user.userid = /^(SYSTEM|LOCAL SERVICE|NETWORK SERVICE)$/ nocase

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($open.principal.hostname)
    $requesting_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $requesting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
