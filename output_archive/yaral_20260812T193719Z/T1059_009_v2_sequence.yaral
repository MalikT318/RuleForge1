/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:54:34.910234+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_CloudAPI_ServicePrincipalLogin_Then_PrivilegeChange {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a non-interactive or service-principal authentication event followed by a privilege or permission change within a short window. This pattern is consistent with an adversary using an application access token or stolen service-principal credentials to invoke cloud APIs that escalate privileges or modify IAM policies — a key execution path for T1059.009 abuse via identity-layer APIs."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires identity provider audit logs capturing authentication events (sign-in logs) and directory/IAM change events. Covers Entra ID, Okta, and equivalent IdP sources normalised to Chronicle UDM."
    platform        = "IaaS"
    log_source      = "identity"
    false_positives = "Automated deployment pipelines, CI/CD service accounts performing legitimate role assignments, infrastructure-as-code tooling (Terraform, Pulumi), and privileged identity management (PIM) activation workflows."
    tuning_guidance = "Add known CI/CD and automation service-principal user IDs to %allowed_automation_principals. Add approved admin user IDs performing routine PIM activations to %allowed_pim_users. Narrow the match window if false-positive volume remains high."

  events:
    // Event 1: Non-interactive or service-principal authentication
    // Targets programmatic logins typical of API-based access (application tokens,
    // service principals, OAuth client-credential flows) rather than human SSO.
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.auth_details = /service.principal|application|client.credential|non.interactive|programmatic|api.token|oauth|machine/ nocase
    not $auth.principal.user.userid in %allowed_automation_principals
    not $auth.principal.user.userid in %allowed_pim_users
    $auth.principal.user.userid = $actor_id

    // Event 2: Privilege or permission change following the login
    // Targets IAM role assignments, group membership changes, or permission
    // modifications that an adversary would invoke via cloud APIs post-authentication.
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $priv.principal.user.userid = $actor_id
    not $priv.principal.user.userid in %allowed_automation_principals
    not $priv.principal.user.userid in %allowed_pim_users

    // Enforce chronological ordering: login must precede the privilege change
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $actor_id over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1059.009")
    $primary_entity      = array_distinct($actor_id)
    $auth_details        = array_distinct($auth.extensions.auth.auth_details)
    $target_resource     = array_distinct($priv.target.resource.name)
    $target_user_changed = array_distinct($priv.target.user.userid)
    $source_ip           = array_distinct($auth.principal.ip)

  condition:
    $auth and $priv
}
