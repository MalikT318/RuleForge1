/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:01:16.799160+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Dump_File_Artifact {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects creation of a file artifact consistent with an LSASS memory dump. Attackers using procdump, comsvcs.dll MiniDump, Task Manager, or WerFault silent-exit abuse all produce a dump file on disk. This rule pivots on the resulting FILE_CREATION event rather than the process command line, providing coverage that survives command-line obfuscation and tool renaming."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires EDR or Sysmon File Creation telemetry (Sysmon Event ID 11 or equivalent EDR file-write event) normalised into Chronicle UDM FILE_CREATION events with target.file.full_path and principal.process.file.full_path populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate Windows Error Reporting (WerFault.exe) writing crash dumps for non-LSASS processes; authorised incident-response or forensic tooling; some AV/EDR vendors that snapshot LSASS for tamper detection. Tune via %lsass_dump_allowed_writers."
    tuning_guidance = "Add fully-qualified paths of authorised dump-writing processes (e.g., your EDR sensor path) to the %lsass_dump_allowed_writers reference list. Narrow further by scoping to sensitive asset groups via a %sensitive_hosts list."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match file names or extensions strongly associated with LSASS dumps.
    // Covers: lsass.dmp, lsass.dmp.gz, lsass_dump, lsass.mdmp, lsassdump.dmp,
    // WerFault-style dumps (lsass*.dmp), and generic minidump extensions written
    // to temp/user-writable locations. The regex is intentionally broad on the
    // lsass stem and tight on the extension to avoid false positives on unrelated
    // .dmp files while still catching renamed-but-stem-preserved dumps.
    (
      $file.target.file.full_path = /[\\\/]lsass[^\\\/]*\.(dmp|mdmp|bin|zip|gz|tmp)$/  nocase
      or
      $file.target.file.full_path = /[\\\/][^\\\/]*(lsass|lsadump|lsassdump)[^\\\/]*$/  nocase
    )

    // Exclude known-good system paths where legitimate WER dumps land under
    // controlled conditions (ProgramData\Microsoft\Windows\WER\ReportQueue).
    // Attackers almost never write to this path; they prefer Temp or CWD.
    not $file.target.file.full_path = /\\ProgramData\\Microsoft\\Windows\\WER\\/ nocase

    // Exclude authorised dump-writing processes via reference list.
    not $file.principal.process.file.full_path in %lsass_dump_allowed_writers

    // Exclude the Windows kernel / System process (PID 4) which has no image path.
    // A blank principal process path is a strong signal of a legitimate kernel write;
    // an attacker process will always have a path.
    $file.principal.process.file.full_path != ""

  outcome:
    $risk_score      = max(95)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity  = array_distinct($file.principal.hostname)
    $dump_file_path  = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
