/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:52:20.361109+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_ESXi_Python_Script_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of Python script files (.py, .pyc) in sensitive ESXi filesystem locations such as /tmp, /var/tmp, scratch volumes, and datastore paths. Adversaries executing Python on ESXi will typically stage or drop script artifacts before or after execution. This rule targets the resulting file artifact rather than the process launch, providing coverage that survives command-line obfuscation or log gaps."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Requires ESXi shell/hostd file activity telemetry forwarded to Chronicle via syslog or ESXi audit log integration. File creation events must be normalised to UDM FILE_CREATION."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "VMware lifecycle management scripts, vSphere Update Manager staging files, authorised automation frameworks (Ansible, Salt) deploying configuration scripts, vendor-supplied health-check utilities."
    tuning_guidance = "Add known-good automation service account usernames to %esxi_allowed_script_deployers. Add approved staging directories to %esxi_allowed_script_paths. Narrow severity if the creating principal is a known management host."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match Python script or compiled bytecode artifacts
    $file.target.file.full_path = /\.(py|pyc|pyo)$/ nocase

    // Restrict to high-risk ESXi filesystem locations where adversaries stage tooling
    // Covers /tmp, /var/tmp, /scratch, /vmfs/volumes (datastores), /store, /bootbank
    $file.target.file.full_path = /^(\/(tmp|var\/tmp|scratch|store|bootbank)|\/vmfs\/volumes\/)/ nocase

    // Exclude known-good automation principals via reference list
    not $file.principal.user.userid in %esxi_allowed_script_deployers

    // Exclude known-good staging paths used by authorised management tooling
    not $file.target.file.full_path in %esxi_allowed_script_paths

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
