/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:12:35.458272+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Suspicious_Outbound_HTTP_Beaconing_Firewall {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects outbound HTTP/HTTPS connections from internal Linux hosts to non-RFC1918 destinations on standard web ports that exhibit characteristics consistent with C2 beaconing over web protocols: non-browser user-agents, unusual URI patterns, or connections to high-numbered ports masquerading as web traffic. Firewall and proxy telemetry only - additive to process-launch detections."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires firewall, next-gen firewall, or forward proxy logs normalised into Chronicle UDM NETWORK_HTTP events. User-agent and URI fields must be populated by the log source (e.g. Palo Alto, Fortinet, Squid, Zscaler)."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Automated software update clients (apt, yum, curl-based health checks), monitoring agents, container orchestration pull traffic, CDN-hosted SaaS applications with minimal URI paths, IoT devices with terse user-agents."
    tuning_guidance = "Add known-good internal source CIDRs to %internal_address_space. Add approved automation user-agent substrings to %allowed_http_user_agents. Add sanctioned external destinations to %allowed_external_web_destinations. Raise severity to High after baselining false-positive volume per environment."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Destination must be external (non-RFC1918 / non-internal)
    not $net.target.ip in %internal_address_space
    not $net.target.hostname in %allowed_external_web_destinations

    // Standard web ports only - catches protocol-port mismatch abuse
    // Port 80 or 443; attackers also use 8080/8443 to blend in
    $net.target.port in [80, 443, 8080, 8443]

    // Suspicious or absent user-agent strings commonly seen in C2 frameworks
    // Matches: empty UA, single-word UAs, curl/wget without version context,
    // python-requests, Go default UA, and very short custom strings
    (
      $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|Go-http-client|libwww-perl|Java\/|okhttp|axios|got|node-fetch)/ nocase
      or
      $net.network.http.user_agent = /^\s*$/ nocase
      or
      $net.network.http.user_agent = /^[a-zA-Z0-9_\-]{1,12}$/ nocase
    )

    // Exclude well-known legitimate automation agents to reduce noise
    not $net.network.http.user_agent in %allowed_http_user_agents

    // URI patterns consistent with C2: very short paths, base64-like query strings,
    // or paths that look like random identifiers (beacon check-ins)
    (
      $net.network.http.request_url = /^https?:\/\/[^\/]+(\/[a-zA-Z0-9+\/=]{20,})?(\?[a-zA-Z0-9+\/=_\-]{16,})?$/ nocase
      or
      $net.network.http.request_url = /\/(gate|check|ping|beacon|poll|task|cmd|c2|update|sync|hb|heartbeat)(\.php|\.aspx|\.jsp|\/)?(\?|$)/ nocase
    )

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_host  = array_distinct($net.target.hostname)
    $destination_ip    = array_distinct($net.target.ip)
    $user_agent_seen   = array_distinct($net.network.http.user_agent)
    $target_port       = array_distinct($net.target.port)

  condition:
    $net
}
