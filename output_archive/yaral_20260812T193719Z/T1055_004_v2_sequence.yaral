/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:41:29.460793+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Suspended_Process_Then_Remote_Open {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects the Early Bird APC injection pattern: a process is launched in suspended state (CREATE_SUSPENDED flag visible in command-line or via a known launcher), followed within 5 minutes by a cross-process PROCESS_OPEN event from the same host — indicating a second actor is opening a handle to the suspended process to queue an APC before the entry point executes. This is additive coverage over command-line-only rules; it correlates the process-creation artefact with the subsequent handle-open telemetry."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_LAUNCH with command-line and PROCESS_OPEN (Sysmon Event ID 10 / EDR equivalent) events. Both must be normalised into Chronicle UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Debuggers (Visual Studio, WinDbg), legitimate process hollowing in AV/EDR self-protection, some installers that spawn helper processes in suspended state, JVM/CLR runtimes."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_suspended_launchers. Add authorised debugging or security tool paths to %global_allowed_process_openers. Narrow by target.process.file.full_path if specific binaries generate noise."

  events:
    // Leg 1 – a process is created in suspended state.
    // Suspended creation is signalled by the -suspended / CREATE_SUSPENDED
    // flag appearing in the command line of the launcher (e.g. NtCreateProcess
    // wrappers, custom loaders) OR by the process being a known APC-staging
    // binary. We match on the flag pattern rather than a specific tool name.
    $launch.metadata.event_type = "PROCESS_LAUNCH"
    $launch.target.process.command_line = /suspend/  nocase
    not $launch.principal.process.file.full_path in %global_allowed_suspended_launchers
    not $launch.target.process.file.full_path in %global_allowed_suspended_launchers
    $launch.principal.hostname = $hostname

    // Leg 2 – within the same window a PROCESS_OPEN is observed on the same
    // host, where the opener is NOT the same image as the target (cross-process
    // handle acquisition — prerequisite for QueueUserAPC / WriteProcessMemory).
    $open.metadata.event_type = "PROCESS_OPEN"
    // The opening process must not be a known-good security or admin tool.
    not $open.principal.process.file.full_path in %global_allowed_process_openers
    // Exclude self-opens (process opening itself is benign).
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    // The target of the open should be a common injection victim or generic executable.
    $open.target.process.file.full_path = /\\[^\\]+\.exe$/ nocase
    $open.principal.hostname = $hostname

    // Chronological ordering: suspended launch must precede the handle open.
    $launch.metadata.event_timestamp.seconds <= $open.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($hostname)
    $suspended_process_cmdline = array_distinct($launch.target.process.command_line)
    $opener_process_path = array_distinct($open.principal.process.file.full_path)
    $target_opened_process = array_distinct($open.target.process.file.full_path)
    $launching_parent = array_distinct($launch.principal.process.file.full_path)

  condition:
    $launch and $open
}
