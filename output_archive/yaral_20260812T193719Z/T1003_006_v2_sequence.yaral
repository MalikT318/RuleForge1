/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:05:12.816771+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_Network_Replication_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects DCSync attacks by correlating two network-layer signals: an inbound MS-DRSR (Directory Replication Service Remote Protocol) connection to a Domain Controller on port 135 (RPC endpoint mapper) or high RPC ports, followed by sustained high-volume network flow from the same non-DC source. DCSync abuses the DRS replication API to pull credential hashes without touching LSASS locally. This rule targets the network replication traffic pattern rather than process command lines, providing additive coverage to existing PROCESS_LAUNCH detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION and NETWORK_FLOW. The appliance must inspect traffic to Domain Controller hosts and report connection metadata including destination port and byte counts."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Legitimate Domain Controllers replicating with each other (DC-to-DC replication), Azure AD Connect sync agents, third-party directory synchronisation tools, authorised backup agents querying AD via DRSR."
    tuning_guidance = "Populate %dc_hostnames with all Domain Controller hostnames and %approved_replication_sources with IP ranges of legitimate DC and sync agent hosts. Increase the flow byte threshold if legitimate sync agents generate high-volume traffic to DCs."

  events:
    // Event 1: Inbound RPC connection to a Domain Controller on port 135
    // (RPC endpoint mapper - the entry point for MS-DRSR negotiation)
    // or dynamic RPC high ports (49152-65535) used after endpoint resolution.
    // Pre-filtered to known DC targets and suspicious (non-approved) sources.
    $rpc.metadata.event_type = "NETWORK_CONNECTION"
    $rpc.target.hostname = $dc_host
    $rpc.target.hostname in %dc_hostnames
    (
      $rpc.target.port = 135 or
      ($rpc.target.port >= 49152 and $rpc.target.port <= 65535)
    )
    not $rpc.principal.ip in %approved_replication_sources
    $rpc.principal.ip = $src_ip

    // Event 2: High-volume network flow from the same source to the same DC
    // within the window, indicating bulk data extraction consistent with
    // replication of the NTDS credential store.
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.target.hostname = $dc_host
    $flow.target.hostname in %dc_hostnames
    $flow.principal.ip = $src_ip
    not $flow.principal.ip in %approved_replication_sources
    // Replication of credential data produces substantial byte counts;
    // threshold set conservatively to reduce false positives from small probes.
    $flow.network.sent_bytes > 500000

    // Chronological ordering: RPC endpoint contact precedes bulk data flow
    $rpc.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $dc_host, $src_ip over 10m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($dc_host)
    $source_ips = array_distinct($rpc.principal.ip)
    $rpc_ports_observed = array_distinct($rpc.target.port)
    $max_bytes_transferred = max($flow.network.sent_bytes)
    $flow_count = count($flow.metadata.id)

  condition:
    $rpc and $flow
}
