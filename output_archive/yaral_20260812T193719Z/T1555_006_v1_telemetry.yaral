/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:11:16.371803+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_Cloud_Secrets_Manager_Bulk_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects access to cloud secrets manager resources (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault) via cloud audit logs. Focuses on the API-level resource access event produced when a principal retrieves secret material, providing coverage at the control-plane telemetry layer rather than the command-line layer. Suspicious signals include access by non-service identities, access outside expected resource patterns, or access to secrets the principal has not previously touched."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM: AWS CloudTrail (GetSecretValue, DescribeSecret, ListSecrets), GCP Audit Logs (accessSecretVersion, getSecret, listSecrets), Azure Activity Logs (VaultGet, SecretGet, KeyGet). Events must be ingested as USER_RESOURCE_ACCESS."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate application service accounts retrieving secrets at runtime, CI/CD pipelines, secrets rotation automation, infrastructure-as-code tooling, and authorised DevOps workflows. Add known service account identities to %cloud_secrets_allowed_principals and known secret resource name patterns to %cloud_secrets_allowed_resources."
    tuning_guidance = "Populate %cloud_secrets_allowed_principals with approved service account IDs and automation identities. Populate %cloud_secrets_allowed_resources with approved secret ARNs, resource IDs, or name patterns. Consider tightening to human (interactive) identities only by filtering on principal.user.user_display_name patterns that do not match service account naming conventions."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match the normalised API method names across AWS, GCP, and Azure
    // AWS: GetSecretValue, DescribeSecret, ListSecrets, GetResourcePolicy
    // GCP: accessSecretVersion, getSecret, listSecrets, listSecretVersions
    // Azure: VaultGet, SecretGet, KeyGet, CertificateGet, SecretList
    $cloud.target.resource.name = /secret|vault|keyvault|secretversion|secretvalue/ nocase

    // Restrict to read/access operations that retrieve credential material
    // Chronicle normalises the cloud API method into metadata.product_event_type
    $cloud.metadata.product_event_type = /GetSecretValue|DescribeSecret|ListSecret|accessSecretVersion|getSecret|listSecret|VaultGet|SecretGet|KeyGet|CertificateGet|SecretList|GetResourcePolicy/ nocase

    // Require a principal identity to be present
    $cloud.principal.user.userid != ""

    // Exclude known-good automation identities and approved service accounts
    not $cloud.principal.user.userid in %cloud_secrets_allowed_principals

    // Exclude known-good secret resource names / ARNs
    not $cloud.target.resource.name in %cloud_secrets_allowed_resources

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_secret_resource = array_distinct($cloud.target.resource.name)
    $api_method = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
