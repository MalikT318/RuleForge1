/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:45:25.159499+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Hollowed_Process_Network_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a potential process hollowing sequence: a legitimate Windows host process is launched suspended (via a non-standard parent) and then makes an outbound network connection shortly after, suggesting the hollowed process is beaconing. This is additive coverage over command-line rules by correlating process lineage anomaly with subsequent network activity."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires EDR or Sysmon telemetry providing process lineage (parent/child relationships) and network connection events normalised into UDM PROCESS_LAUNCH and NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that legitimately spawn svchost or runtimebroker; some JIT compilers; application virtualisation products; legitimate security tools performing process inspection."
    tuning_guidance = "Add known-good parent processes to %allowed_hollow_parents. Add known-good internal destinations to %rfc1918_internal or %allowed_beacon_destinations. Narrow target process list if specific binaries generate excessive noise."

  events:
    // Stage 1: A canonical Windows host process is spawned by an unusual parent.
    // Hollowing typically creates a legitimate-looking victim process from a
    // non-standard parent (e.g. a user-space binary, a script interpreter, or
    // an Office application) rather than from services.exe / wininit.exe.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(svchost|RuntimeBroker|dllhost|werfault|msiexec|regsvr32|rundll32|explorer|conhost)\.exe$/ nocase
    // Parent must NOT be one of the legitimate Windows service managers
    not $proc.principal.process.file.full_path = /\\(services|wininit|smss|csrss|winlogon|taskeng|taskhostw|svchost)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %allowed_hollow_parents
    $proc.principal.hostname = $hostname
    // Capture the spawned process image path to correlate with the network event
    $proc.target.process.file.full_path = $victim_image

    // Stage 2: The same host process image makes an outbound network connection
    // shortly after being launched, which is anomalous for most of these binaries
    // when spawned outside their normal service context.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $victim_image
    $net.principal.hostname = $hostname
    // Exclude loopback and link-local; flag external or unexpected internal destinations
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %allowed_beacon_destinations

    // Enforce chronological ordering: process launch must precede network connection
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $victim_image over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $spawned_process = array_distinct($victim_image)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $proc and $net
}
