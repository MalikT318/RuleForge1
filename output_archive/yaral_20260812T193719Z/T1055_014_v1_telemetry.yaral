/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:46:40.500433+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_VDSO_Hijack_Shared_Object_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation or modification of shared object (.so) files in world-writable or suspicious memory-backed paths (/dev/shm, /tmp, /run/shm, /var/tmp, /proc/<pid>/mem). VDSO hijacking requires staging a malicious shared library that will be mapped into a victim process's address space. Attackers frequently drop crafted .so files into these locations before redirecting the GOT or patching vdso stubs. This rule fires on the resulting file artifact rather than on process command-line arguments, providing a complementary detection layer."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to Chronicle UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "JIT compilers (JVM, V8, .NET) writing temporary native libraries to /tmp; container runtimes extracting layers to /tmp or /run; legitimate software installers staging .so files; LD_PRELOAD-based profiling tools (e.g. heaptrack, valgrind wrappers). Tune using %linux_allowed_so_writers."
    tuning_guidance = "Populate %linux_allowed_so_writers with the full paths of known-good processes that legitimately write .so files to these paths (e.g. /usr/lib/jvm/java-*/bin/java, container runtime shims). Consider narrowing the path regex to exclude /tmp/hsperfdata_* if JVM noise is high."

  events:
    $file.metadata.event_type = "FILE_CREATION" or
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Shared object file written to a world-writable or memory-backed path
    // that has no legitimate reason to host persistent shared libraries.
    $file.target.file.full_path = /^\/dev\/shm\/.+\.so(\.[0-9]+)*$/ nocase or
    $file.target.file.full_path = /^\/tmp\/.+\.so(\.[0-9]+)*$/ nocase or
    $file.target.file.full_path = /^\/var\/tmp\/.+\.so(\.[0-9]+)*$/ nocase or
    $file.target.file.full_path = /^\/run\/shm\/.+\.so(\.[0-9]+)*$/ nocase or
    $file.target.file.full_path = /^\/proc\/[0-9]+\/.+\.so(\.[0-9]+)*$/ nocase or
    $file.target.file.full_path = /^\/run\/user\/[0-9]+\/.+\.so(\.[0-9]+)*$/ nocase

    // Exclude known-good writers (JIT runtimes, container runtimes, package managers)
    not $file.principal.process.file.full_path in %linux_allowed_so_writers

    // Exclude package-manager and system-library staging paths that are
    // legitimately under /tmp during upgrades
    not $file.target.file.full_path = /\/tmp\/apt-|\/tmp\/rpm-|\/tmp\/dpkg/ nocase

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity    = array_distinct($file.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $dropped_so_path   = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
