/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:52:59.396859+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_JXA_Script_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of JavaScript for Automation (JXA) or compiled OSA script artifacts on macOS. Adversaries use JXA to execute code via osascript/osacompile, producing .jxa, .scpt, or .app bundles in suspicious locations outside standard application directories. This rule pivots on the file artifact produced rather than the command line, providing coverage orthogonal to process-creation detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires macOS EDR or unified log telemetry with FILE_CREATION events including target.file.full_path and principal.process.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate developer workflows using osacompile, Xcode automation scripts, IT management tools writing OSA scripts to /Library paths, Alfred or Automator workflows."
    tuning_guidance = "Add known-good parent process paths to %macos_allowed_osa_writers. Add approved staging directories to %macos_allowed_script_dirs. Consider scoping to user home directories only if /Library false-positive rate is high."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target JXA source files, compiled OSA scripts, and app bundles
    // created by osacompile or similar tooling
    (
      $file.target.file.full_path = /\.jxa$/ nocase or
      $file.target.file.full_path = /\.scpt$/ nocase or
      $file.target.file.full_path = /\.scptd$/ nocase or
      $file.target.file.full_path = /\.osas$/ nocase
    )

    // Focus on suspicious creation locations:
    // user temp/download areas, hidden directories, or non-standard Library paths
    (
      $file.target.file.full_path = /\/Users\/[^\/]+\/(Downloads|Desktop|tmp|\.[\w]+)\// nocase or
      $file.target.file.full_path = /\/private\/tmp\// nocase or
      $file.target.file.full_path = /\/var\/folders\// nocase or
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/(Application Support|Caches|Containers)\// nocase or
      $file.target.file.full_path = /\/tmp\// nocase
    )

    // Optionally written by scripting runtimes, shells, or download agents
    // rather than a known IDE - catches post-exploitation staging
    not $file.principal.process.file.full_path in %macos_allowed_osa_writers
    not $file.target.file.full_path in %macos_allowed_script_dirs

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_script_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
