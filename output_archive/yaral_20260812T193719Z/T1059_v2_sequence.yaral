/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Identity Provider
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:48:40.553307+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_IdP_Shell_Enable_Then_Admin_Auth {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a hypervisor management-plane shell or SSH service being enabled, followed within 5 minutes by an interactive management authentication on the same host. This sequence is consistent with an adversary enabling a command interpreter on an ESXi host and then authenticating to use it, a pattern that does not rely on process command-line telemetry and therefore provides additive coverage beyond existing PROCESS_LAUNCH detections."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires ESXi hostd or DCUI audit logs normalised to UDM SETTING_MODIFICATION (shell/SSH service state changes) and USER_LOGIN (management-plane authentication). Both event types must be ingested and normalised by the Chronicle forwarder."
    platform        = "Identity Provider"
    log_source      = "vmware_esxi"
    false_positives = "Authorised maintenance windows where an administrator legitimately enables the ESXi shell or SSH before performing hands-on work. Automated configuration management tools (Ansible, Terraform, vSphere API) that enable and then authenticate to the shell as part of a documented workflow."
    tuning_guidance = "Add known maintenance service accounts to %esxi_allowed_shell_enablement_users. Add known automation hostnames to %esxi_allowed_automation_hosts. Narrow the time window if the 5-minute window produces too many false positives in environments with frequent scheduled maintenance."

  events:
    // Event 1: Shell or SSH service is enabled on the hypervisor host
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.resource.name = /ssh|shell|esxi\s*shell|tsm-ssh|tsm-dcui/ nocase
    $cfg.security_result.summary = /enabl|start|activat/ nocase
    not $cfg.principal.user.userid in %esxi_allowed_shell_enablement_users
    not $cfg.principal.hostname in %esxi_allowed_automation_hosts
    $cfg.target.hostname = $esxi_host

    // Event 2: Interactive management-plane login to the same host after shell enablement
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $esxi_host
    not $auth.principal.user.userid in %esxi_allowed_shell_enablement_users
    not $auth.principal.hostname in %esxi_allowed_automation_hosts

    // Chronological ordering: setting change must precede the login
    $cfg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $esxi_host over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1059")
    $primary_entity      = array_distinct($esxi_host)
    $enabling_user       = array_distinct($cfg.principal.user.userid)
    $authenticating_user = array_distinct($auth.principal.user.userid)
    $changed_setting     = array_distinct($cfg.target.resource.name)
    $login_count         = count($auth.metadata.id)

  condition:
    $cfg and $auth
}
