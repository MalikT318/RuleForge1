/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:58:35.935067+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Domain_Account_Interactive_Logon_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects interactive or remote-interactive logon events using domain accounts to hosts where such logons are atypical - specifically targeting workstations and servers receiving Type 2 (interactive) or Type 10 (remote interactive) logons from domain accounts outside of expected service or admin patterns. This pivots on the authentication state change rather than process creation, providing coverage orthogonal to command-line rules."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation, Defense Evasion"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Windows Security Event Log forwarded to Chronicle (Event ID 4624 - successful logon). UDM normalises logon type into metadata fields. Ensure Security log collection is enabled and forwarded via the EDR or a SIEM connector."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrator remote desktop sessions, helpdesk staff performing remote support, automated software deployment accounts performing interactive logons, jump-server patterns where admins RDP to intermediate hosts."
    tuning_guidance = "Add known admin and service account userids to %global_allowed_domain_interactive_accounts. Add known admin workstation hostnames to %global_allowed_rdp_source_hosts. Consider narrowing to specific target hostname patterns (e.g. servers vs workstations) using principal.hostname regex if your environment has consistent naming conventions."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Domain account logon - UDM populates domain when the authenticating account is a domain account
    $auth.target.user.user_display_name != ""
    $auth.target.user.windows_sid = /^S-1-5-21-/ nocase

    // Exclude local/built-in accounts (S-1-5-18 SYSTEM, S-1-5-19 LOCAL SERVICE, S-1-5-20 NETWORK SERVICE)
    not $auth.target.user.windows_sid = /^S-1-5-(18|19|20)$/ nocase

    // Exclude machine accounts (computer accounts end with $)
    not $auth.target.user.userid = /\$$/ nocase

    // Exclude known service/batch logon types - focus on interactive and remote-interactive
    // UDM logon_type field: 2 = Interactive, 10 = RemoteInteractive (RDP)
    $auth.extensions.auth.auth_details = /logon_type=(2|10)/ nocase

    // Exclude accounts explicitly allow-listed for interactive domain logons
    not $auth.target.user.userid in %global_allowed_domain_interactive_accounts

    // Exclude known approved RDP source hosts (jump servers, admin workstations)
    not $auth.principal.hostname in %global_allowed_rdp_source_hosts

    // Exclude logons originating from the same host (local console logon from domain account is lower risk)
    // This retains remote interactive logons where principal != target host
    $auth.principal.hostname != $auth.target.hostname

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($auth.target.hostname)
    $logon_account = array_distinct($auth.target.user.userid)
    $source_host = array_distinct($auth.principal.hostname)
    $account_sid = array_distinct($auth.target.user.windows_sid)

  condition:
    $auth
}
