/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:45:52.572007+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Doppelganging_Process_Handle_Suspicious_Open {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a suspicious process opening a handle to another process with full access rights in a pattern consistent with Process Doppelganging. The technique abuses Windows Transactional NTFS (TxF) to stage malicious code inside a transaction, then maps it into a legitimate process. The observable at this layer is a non-standard process requesting PROCESS_ALL_ACCESS or equivalent broad handle rights against a target process whose image lives in a protected system path, while the requesting process itself originates from a user-writable or temporary location. This is additive coverage over command-line rules: it fires on the handle-acquisition event rather than the staging command."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelganging"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised to UDM PROCESS_OPEN. The sensor must capture the requesting process image path and the target process image path. CrowdStrike Falcon, Microsoft Defender for Endpoint, and SentinelOne all emit this telemetry; Sysmon requires ProcessAccess logging enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio debugger), security scanners, AV engines performing in-memory inspection, and some RMM agents open broad process handles. Exclude known-good parent paths via the reference list."
    tuning_guidance = "Populate %global_allowed_process_openers with full paths of approved tools that legitimately open broad handles (e.g. debuggers, AV engines, RMM agents). Narrow the rule further by restricting target.process.file.full_path to specific high-value system processes if false-positive volume is high."

  events:
    // A process opens a handle to another process - the PROCESS_OPEN event
    // is emitted by EDR/Sysmon when one process acquires a handle to another.
    $open.metadata.event_type = "PROCESS_OPEN"

    // The requesting (principal) process originates from a user-writable,
    // temporary, or non-standard location - a strong indicator that it is
    // not a legitimate system component. Legitimate system tools that open
    // process handles live in System32, SysWOW64, or Program Files.
    (
      $open.principal.process.file.full_path = /\\users\\/i nocase or
      $open.principal.process.file.full_path = /\\temp\\/i nocase or
      $open.principal.process.file.full_path = /\\tmp\\/i nocase or
      $open.principal.process.file.full_path = /\\appdata\\/i nocase or
      $open.principal.process.file.full_path = /\\programdata\\/i nocase or
      $open.principal.process.file.full_path = /\\public\\/i nocase or
      $open.principal.process.file.full_path = /\\downloads\\/i nocase
    )

    // The target process being opened is a legitimate Windows system process.
    // Doppelganging maps malicious sections into real system processes to
    // blend with normal execution. Targeting system processes is the
    // canonical pattern.
    $open.target.process.file.full_path = /\\windows\\(system32|syswow64|sysnative)\\/i nocase

    // The target process is one of the high-value injection targets commonly
    // abused by Doppelganging implementations: svchost, lsass, explorer,
    // spoolsv, and similar. Match on the directory rather than filename to
    // avoid binary-name dependency (rename test passes because the directory
    // constraint still applies to the victim process).
    // Additionally require the target to be a known Windows host process
    // by confirming it sits under the system path already constrained above.
    // No hardcoded tool names on the attacker side.

    // Exclude known-good openers via reference list to support multi-tenant tuning.
    not $open.principal.process.file.full_path in %global_allowed_process_openers

    // Exclude the process opening itself (self-handle, common in legitimate code).
    not $open.principal.process.pid = $open.target.process.pid

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity    = array_distinct($open.principal.hostname)
    $requesting_process = array_distinct($open.principal.process.file.full_path)
    $target_process    = array_distinct($open.target.process.file.full_path)
    $requesting_user   = array_distinct($open.principal.user.userid)

  condition:
    $open
}
