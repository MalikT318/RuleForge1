/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:38:30.290169+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_Process_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where a non-system process requests cross-process memory write and thread creation access rights against a remote process - the kernel-level precondition for classic DLL injection via VirtualAllocEx/WriteProcessMemory/CreateRemoteThread. This fires on the handle request itself, not on command-line arguments, providing coverage that survives command-line evasion."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised into Chronicle UDM PROCESS_OPEN events. The EDR must capture target process access rights (target.process.access_mask or equivalent mapped field). Sysmon must be configured with a ProcessAccess rule capturing GrantedAccess 0x1F0FFF, 0x1FFFFF, 0x40, 0x800, or combinations thereof."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), AV/EDR self-protection handles, RMM agents performing process inspection, Windows Error Reporting (WerFault.exe), Task Manager, Process Explorer. Baseline your environment and add known-good callers to the exclusion list."
    tuning_guidance = "Populate %global_allowed_process_open_callers with full paths of approved tools (debuggers, RMM agents, AV engines). Add %global_allowed_system_processes to exclude Windows-native callers such as lsass.exe, csrss.exe, and werfault.exe. Narrow further by requiring the caller to reside outside System32/SysWOW64 if your EDR populates principal.process.file.full_path reliably."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Caller is NOT a known Windows system binary - catches injectors living
    // outside the standard OS directories. Regex anchors to the full path so
    // a binary named 'svchost.exe' placed elsewhere still fires.
    not $open.principal.process.file.full_path = /\\Windows\\(System32|SysWOW64|WinSxS)\\/  nocase

    // Exclude processes whose full path is in the MSSP-managed allow list
    not $open.principal.process.file.full_path in %global_allowed_process_open_callers

    // The target must be a running process (non-self handle) - EDR typically
    // populates target.process.pid; exclude same-PID self-opens
    // Target is a meaningful Windows host process commonly abused for injection
    $open.target.process.file.full_path = /\\(svchost|explorer|lsass|spoolsv|RuntimeBroker|dllhost|msiexec|notepad|SearchHost|sihost|taskhostw|winlogon|csrss|wininit)\.exe$/ nocase

    // Caller must not itself be a known system binary masquerading legitimately
    not $open.principal.process.file.full_path in %global_allowed_system_processes

    // Caller process should not be empty (handle must have an attributed process)
    $open.principal.process.file.full_path != ""

    // Restrict to endpoints where a hostname is populated (filters noise)
    $open.principal.hostname != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $caller_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $affected_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
