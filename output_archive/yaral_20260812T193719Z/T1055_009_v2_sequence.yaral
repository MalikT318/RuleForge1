/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:43:43.068985+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Proc_Memory_Maps_Read_Then_Mem_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage /proc filesystem injection pattern: a process first reads the memory map of a target process via /proc/[pid]/maps (to enumerate gadgets and stack offsets), then opens /proc/[pid]/mem for writing (to overwrite the target process stack). This sequence is characteristic of ROP-based proc memory injection on Linux and is additive coverage beyond command-line detections."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd file-access telemetry that records FILE_READ and FILE_MODIFICATION events against /proc pseudo-filesystem paths, including the acting process identity."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers (gdb, lldb, strace), legitimate profiling tools (perf, valgrind), container runtimes inspecting child processes, and some JVM/Go runtimes that self-inspect via /proc."
    tuning_guidance = "Add known debugger and profiler paths to %linux_allowed_proc_inspectors. Scope by principal.user.userid to exclude root-owned monitoring daemons if they are well-understood. Consider narrowing the match window below 5m if false-positive rates remain high."

  events:
    // Stage 1: process reads /proc/<pid>/maps to enumerate memory layout
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\/proc\/[0-9]+\/maps$/ nocase
    not $read.principal.process.file.full_path in %linux_allowed_proc_inspectors
    not $read.principal.process.file.full_path = /\/(gdb|lldb|strace|ltrace|perf|valgrind|python[0-9.]*|java)$/ nocase
    $read.principal.hostname = $hostname
    $read.principal.user.userid = $userid

    // Stage 2: same process (same host + user) opens /proc/<pid>/mem for modification
    $write.metadata.event_type = "FILE_MODIFICATION"
    $write.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase
    not $write.principal.process.file.full_path in %linux_allowed_proc_inspectors
    not $write.principal.process.file.full_path = /\/(gdb|lldb|strace|ltrace|perf|valgrind|python[0-9.]*|java)$/ nocase
    $write.principal.hostname = $hostname
    $write.principal.user.userid = $userid

    // Enforce chronological ordering: maps read must precede mem write
    $read.metadata.event_timestamp.seconds <= $write.metadata.event_timestamp.seconds

  match:
    $hostname, $userid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($hostname)
    $acting_user = array_distinct($userid)
    $maps_paths_read = array_distinct($read.target.file.full_path)
    $mem_paths_written = array_distinct($write.target.file.full_path)
    $injecting_process = array_distinct($write.principal.process.file.full_path)

  condition:
    $read and $write
}
