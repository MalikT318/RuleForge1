/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:57:16.816733+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_IdP_Dormant_Account_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful authentication event from an account that has been flagged as inactive or disabled in the identity provider directory. Adversaries abusing valid accounts frequently reactivate or leverage dormant credentials to evade detection, as the original owner is no longer monitoring the account. This rule targets the resulting authentication state change rather than any command-line activity, providing additive coverage over process-creation detections."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation, Defense Evasion"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires identity provider sign-in audit logs normalised to UDM USER_LOGIN events. The log source must populate target.user.account_type or security_result.summary with account state metadata (e.g., Entra ID Sign-In Logs, Okta System Log). The principal.user.userid and target.user.userid fields must be populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Service accounts reactivated by IT for maintenance windows; break-glass emergency accounts used during incidents; accounts reactivated as part of an offboarding reversal or rehire process; automated provisioning workflows that briefly reactivate accounts."
    tuning_guidance = "Add known break-glass or emergency account userids to %idp_allowed_dormant_accounts. Add known service account patterns to %idp_service_account_exclusions. Consider narrowing by target.resource.name to specific high-value applications if alert volume is high."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Successful authentication only - failed logins are a separate detection
    $auth.security_result.action = "ALLOW"

    // Account state indicators: identity providers surface dormant/disabled
    // account context in the summary or description fields after normalisation.
    // Match on common IdP-normalised strings indicating the account was
    // previously inactive, disabled, or suspended.
    (
      $auth.security_result.summary = /dormant/ nocase or
      $auth.security_result.summary = /disabled/ nocase or
      $auth.security_result.summary = /suspended/ nocase or
      $auth.security_result.summary = /inactive/ nocase or
      $auth.security_result.description = /dormant/ nocase or
      $auth.security_result.description = /disabled/ nocase or
      $auth.security_result.description = /suspended/ nocase or
      $auth.security_result.description = /inactive/ nocase
    )

    // Exclude accounts explicitly allow-listed as known dormant/emergency accounts
    not $auth.principal.user.userid in %idp_allowed_dormant_accounts

    // Exclude known service account patterns that may legitimately appear dormant
    not $auth.principal.user.userid in %idp_service_account_exclusions

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $target_application = array_distinct($auth.target.resource.name)
    $source_ip = array_distinct($auth.principal.ip)
    $auth_result_summary = array_distinct($auth.security_result.summary)

  condition:
    $auth
}
