/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:56:21.351734+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Login_Then_Hypervisor_CLI_Burst {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects an interactive or SSH login to an ESXi host followed within 5 minutes by execution of a hypervisor management CLI (esxcli, vim-cmd, esxcfg-*, vmkfstools, etc.). This sequence is additive coverage over standalone command-line rules: it correlates the authentication event with the subsequent CLI invocation, surfacing cases where an adversary authenticates and immediately begins hypervisor manipulation."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Script Interpreter: Hypervisor CLI"
    log_prerequisites = "Requires ESXi shell/SSH authentication events (hostd or sshd producing USER_LOGIN UDM records) and ESXi process telemetry (shell or hostd producing PROCESS_LAUNCH UDM records). Both event types must be ingested and normalised into Chronicle UDM."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised VMware administrators performing routine maintenance, automated orchestration frameworks (vCenter, Ansible, Terraform), monitoring agents that authenticate and probe host state, and scheduled backup jobs that invoke esxcli."
    tuning_guidance = "Add known-good service accounts to %esxi_allowed_admin_accounts and known-good management hostnames/IPs to %esxi_allowed_mgmt_sources. Raise severity or lower the time window if the environment prohibits direct ESXi shell access entirely."

  events:
    // --- Leg 1: interactive or SSH login to the ESXi host ---
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %esxi_allowed_admin_accounts
    not $auth.target.hostname in %esxi_allowed_mgmt_sources
    $auth.target.hostname = $esxi_host

    // --- Leg 2: hypervisor management CLI launched on the same host ---
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(esxcli|vim-cmd|esxcfg-[a-z]+|vmkfstools|vmware-cmd|esxconfig)$/ nocase
    not $proc.principal.user.userid in %esxi_allowed_admin_accounts
    $proc.principal.hostname = $esxi_host

    // --- Chronological ordering: login must precede CLI execution ---
    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $esxi_host over 5m

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity    = array_distinct($esxi_host)
    $triggered_user    = array_distinct($auth.principal.user.userid)
    $cli_invoked       = array_distinct($proc.target.process.file.full_path)
    $cli_args          = array_distinct($proc.target.process.command_line)
    $login_count       = count($auth.metadata.event_timestamp.seconds)
    $cli_exec_count    = count($proc.metadata.event_timestamp.seconds)

  condition:
    $auth and $proc
}
