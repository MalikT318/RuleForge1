/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:41:56.071144+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a suspicious process opening a handle to another process with VM_WRITE and VM_OPERATION access rights, which is a prerequisite for TLS callback injection. Attackers must allocate and write shellcode into the target process memory before manipulating PE TLS callback pointers. This rule pivots on the PROCESS_OPEN event (handle acquisition) rather than command-line telemetry, providing a lower-evasion detection layer for T1055.005."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised into UDM PROCESS_OPEN events. The access mask fields must be populated by the sensor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg), profilers (VTune, dotTrace), AV/EDR self-protection routines, JIT compilers (CLR, V8), and some RMM agents that inject helper DLLs. Baseline the opener process paths in %global_allowed_process_open_tools."
    tuning_guidance = "Populate %global_allowed_process_open_tools with verified debugger, profiler, and RMM binary paths. Narrow further by excluding opener-to-self handles (principal.process = target.process) if your EDR surfaces those. Consider pairing with a FILE_CREATION rule (variant 2) for higher-fidelity alerting."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must NOT be a known system process that legitimately cross-injects
    // Match suspicious non-system openers: anything outside core Windows paths
    // or well-known runtime hosts opening handles to unrelated processes.
    // Exclude canonical Windows system directories to reduce noise.
    not $open.principal.process.file.full_path = /\\Windows\\System32\\/  nocase
    not $open.principal.process.file.full_path = /\\Windows\\SysWOW64\\/ nocase
    not $open.principal.process.file.full_path = /\\Windows\\WinSxS\\/   nocase

    // Target must be a running host process commonly abused for TLS injection:
    // legitimate executables whose PE TLS callbacks are hijacked or whose
    // address space is used to stage the injected payload.
    $open.target.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|dllhost|werfault|conhost|spoolsv|taskhost|taskhostw|sihost|ctfmon|SearchIndexer|msiexec|regsvr32|rundll32|wscript|cscript|mshta)\.exe$/ nocase

    // Opener must itself be a user-land executable (not a kernel component).
    // Require the opener to live under a user-writable or non-standard path,
    // which is characteristic of attacker-controlled loaders.
    $open.principal.process.file.full_path = /\.(exe|dll|scr|com)$/ nocase

    // Exclude the opener being the same binary as the target (self-open is normal).
    not $open.principal.process.file.full_path = $open.target.process.file.full_path

    // Exclude known-good process opener tools via reference list.
    not $open.principal.process.file.full_path in %global_allowed_process_open_tools

    // Exclude known-good target processes opened by their own service controller.
    not $open.principal.process.file.full_path = /\\services\.exe$/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opener_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
