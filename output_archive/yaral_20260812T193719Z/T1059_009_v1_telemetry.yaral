/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:54:15.313125+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_SaaS_ServicePrincipal_API_Abuse_Via_AppToken {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a service principal or non-interactive application identity performing high-impact administrative API actions in a SaaS/IdP environment using an application access token. Adversaries who have obtained app credentials (T1550.001) abuse cloud APIs to execute privileged operations without spawning a user-interactive session. This rule pivots on the resulting directory/resource change event rather than command-line telemetry, providing coverage that evades process-creation logging."
    mitre_tactic         = "Execution"
    mitre_technique      = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites    = "Requires identity provider audit logs (e.g. Entra ID / Okta / similar IdP) normalised to Chronicle UDM. Service-principal and application sign-in events must be ingested. USER_CHANGE_PERMISSIONS and GROUP_MODIFICATION events must be present."
    platform             = "SaaS"
    log_source           = "identity"
    false_positives      = "Legitimate CI/CD pipelines, infrastructure-as-code automation (Terraform, Ansible), approved provisioning service principals, and break-glass admin accounts performing bulk role assignments."
    tuning_guidance      = "Populate %allowed_automation_service_principals with approved CI/CD and provisioning service-principal IDs. Populate %allowed_admin_roles with expected high-privilege role names that automation legitimately assigns. Narrow the match window or raise the threshold if the environment has high-volume legitimate automation."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // Target a service-principal / application identity, not an interactive human user.
    // IdPs normalise non-interactive / app-only tokens into the user type field.
    $auth.principal.user.user_display_name = /service.?principal|app.?only|application|svc|automation|pipeline|terraform|ansible|robot|bot/ nocase

    // The action must affect a privileged or administrative scope.
    // Chronicle normalises the changed role/permission into target.resource.name or
    // target.user.attribute.roles. Match broad privilege keywords.
    (
      $auth.target.resource.name = /owner|contributor|admin|global.?admin|privileged|security|billing|directory|role.?admin|user.?access/ nocase
      or
      $auth.target.user.attribute.roles = /owner|contributor|admin|global.?admin|privileged|security|billing|directory|role.?admin|user.?access/ nocase
    )

    // Exclude known-good automation service principals by their userid.
    not $auth.principal.user.userid in %allowed_automation_service_principals

    // Exclude expected high-privilege role assignments that automation legitimately performs.
    not $auth.target.resource.name in %allowed_admin_roles

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity    = array_distinct($auth.principal.user.userid)
    $affected_target   = array_distinct($auth.target.user.userid)
    $privilege_granted = array_distinct($auth.target.resource.name)

  condition:
    $auth
}
