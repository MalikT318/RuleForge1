/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:02:01.562245+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Registry_Hive_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects file creation events consistent with the SAM or SYSTEM registry hive being saved to disk outside of legitimate backup locations. Adversaries use 'reg save HKLM\\sam' or volume shadow copy techniques to extract the SAM database for offline credential cracking. This rule fires on the resulting file artifact rather than the command line, providing coverage against process-creation log evasion."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event) normalised into Chronicle UDM FILE_CREATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised backup software writing hive exports to known backup directories; Windows in-box backup (wbadmin, Windows Server Backup) writing to dedicated backup volumes; domain-joined systems running authorised SCCM/Intune inventory tasks."
    tuning_guidance = "Add known backup destination directory prefixes to %global_allowed_hive_backup_paths. Add authorised backup process full paths to %global_allowed_backup_processes. Narrow severity for assets already covered by PAM controls."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file name matches SAM, SYSTEM, or SECURITY hive exports
    // Covers bare filenames (sam, sam.hive, sam.bak, system, security, ntds, etc.)
    $file.target.file.full_path = /[\\\/](sam|system|security|ntds)(\.hive|\.bak|\.save|\.dmp|\.dat|\.export|\.out|\.bin|\.tmp)?$/ nocase

    // Exclude the canonical in-use registry hive locations - these are normal OS files
    not $file.target.file.full_path = /^[A-Za-z]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\[Ss][Yy][Ss][Tt][Ee][Mm]32\\[Cc][Oo][Nn][Ff][Ii][Gg]\\/

    // Exclude Windows VSS / shadow copy staging paths
    not $file.target.file.full_path = /\\[Ss]ystem [Vv]olume [Ii]nformation\\/

    // Exclude known authorised backup destination paths (reference list for per-client tuning)
    not $file.target.file.full_path in %global_allowed_hive_backup_paths

    // Exclude known authorised backup processes (reference list for per-client tuning)
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Require a principal process to be present - filters out OS-internal synthetic events
    $file.principal.process.file.full_path != ""

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $created_file_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
