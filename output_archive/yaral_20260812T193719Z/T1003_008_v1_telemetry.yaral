/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:06:13.198707+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_Passwd_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file-read access to /etc/shadow or /etc/passwd at the file-artifact layer. This provides coverage orthogonal to command-line rules: even if process-creation logging is disabled or the attacker uses a renamed binary, the file-open/read event is still emitted by the kernel and captured by EDR or auditd. Accessing /etc/shadow by any process other than well-known system daemons is highly suspicious."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux EDR or auditd with file-read (open/read syscall) telemetry normalised to UDM FILE_READ events. Auditd rule: -a always,exit -F arch=b64 -S open,openat,read -F path=/etc/shadow -F perm=r -k shadow_read"
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "PAM authentication stack (pam_unix.so), sssd, systemd-logind, passwd/chpasswd/shadow utilities during legitimate password changes, backup agents reading /etc/passwd for UID mapping."
    tuning_guidance = "Populate %linux_allowed_shadow_readers with full paths of legitimate daemons (e.g. /usr/sbin/sshd, /usr/lib/x86_64-linux-gnu/security/pam_unix.so, /usr/sbin/sssd). Add backup agent paths as needed per client. Scope further by alerting only on /etc/shadow reads outside business hours if noise remains high."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/etc\/(shadow|passwd|shadow\-|passwd\-)$/ nocase
    not $file.principal.process.file.full_path in %linux_allowed_shadow_readers
    not $file.principal.process.file.full_path = /^\/(usr\/)?sbin\/(sshd|sssd|login|su|sudo|passwd|chpasswd|unix_chkpwd|newgrp|sg|gpasswd)$/ nocase
    not $file.principal.process.file.full_path = /^\/usr\/lib\/(x86_64-linux-gnu|aarch64-linux-gnu|systemd)\/.*$/ nocase
    not $file.principal.process.file.full_path = /^\/usr\/sbin\/(cron|crond|atd|nscd|nslcd)$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $target_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
