/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:52:02.692149+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_VB_Script_Drop_Then_Execute_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a VBScript-compatible or Mono-hosted VB file written to a suspicious staging path on Linux, followed within 5 minutes by a process launch that interprets or executes it. On Linux, VB execution typically occurs via Mono (mono), the .NET runtime (dotnet), or wrapper scripts. This two-stage sequence (drop then execute) provides additive coverage beyond simple command-line matching."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires Linux EDR or auditd file-write and process-launch telemetry normalised into Chronicle UDM. FILE_CREATION events must populate target.file.full_path; PROCESS_LAUNCH events must populate target.process.command_line and principal.hostname."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate Mono/.NET application deployments, developer build pipelines, CI/CD agents compiling VB.NET projects, automated test frameworks."
    tuning_guidance = "Add known-good parent process paths to %linux_allowed_vb_parents and known-good staging directories to %linux_allowed_vb_staging_dirs. Narrow the file-path regex if your environment uses a fixed deployment directory."

  events:
    // Stage 1: A VB-related file is written to a suspicious staging location.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(vb|vbs|vbx|bas)$/ nocase
    $file.target.file.full_path = /(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/home\/[^\/]+\/(\.cache|\.config|\.local)|\/opt\/[^\/]+\/tmp\/)/ nocase
    not $file.target.file.full_path in %linux_allowed_vb_staging_dirs
    $file.principal.hostname = $hostname

    // Stage 2: A runtime capable of executing VB/Mono code launches and references the same staging area or a VB-related argument.
    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.target.process.file.full_path = /(\/usr\/bin\/mono|\/usr\/local\/bin\/mono|\/usr\/bin\/dotnet|\/usr\/local\/bin\/dotnet|\/usr\/bin\/vbnc|\/usr\/local\/bin\/vbnc|\/usr\/bin\/mcs|\/usr\/local\/bin\/mcs)$/ nocase
    $exec.target.process.command_line = /\.(vb|vbs|vbx|bas|exe|dll)\b/ nocase
    $exec.target.process.command_line = /(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/home\/[^\/]+\/(\.cache|\.config|\.local)|\/opt\/[^\/]+\/tmp\/)/ nocase
    not $exec.principal.process.file.full_path in %linux_allowed_vb_parents
    $exec.principal.hostname = $hostname

    // Enforce chronological ordering: file must be written before execution.
    $file.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity    = array_distinct($exec.principal.hostname)
    $dropped_files     = array_distinct($file.target.file.full_path)
    $exec_cmdlines     = array_distinct($exec.target.process.command_line)
    $runtime_used      = array_distinct($exec.target.process.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file and $exec
}
