/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : ESXi
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:59:15.126578+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_ESXi_Local_Account_Privilege_Change_Identity {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects privilege or permission changes applied to local accounts via identity provider audit logs. On ESXi environments fronted by an identity provider, adversaries who have obtained local account credentials may escalate privileges or modify group membership to establish persistence or gain elevated access. This rule fires on directory audit events that grant elevated roles or modify group membership for accounts, which is a state-change artifact that persists beyond any command-line invocation."
    mitre_tactic    = "Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires identity provider audit logs (e.g. Entra ID, Okta, or equivalent) normalised into Chronicle UDM. Events must populate target.user.userid, principal.user.userid, and metadata.event_type = USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION."
    platform        = "ESXi"
    log_source      = "identity"
    false_positives = "Authorised IT administrators performing scheduled access reviews, onboarding workflows that grant roles programmatically, break-glass account provisioning, and automated identity governance tooling."
    tuning_guidance = "Populate %esxi_idp_allowed_admin_accounts with service accounts and identity-governance automation principals that legitimately perform privilege grants. Populate %esxi_privileged_role_patterns with approved role names if your environment uses non-standard naming. Narrow severity by correlating with off-hours timestamps or accounts not seen previously."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // Target account must not be a known, approved privileged service account
    not $auth.target.user.userid in %esxi_idp_allowed_admin_accounts

    // Actor performing the change must not be an approved identity-governance automation account
    not $auth.principal.user.userid in %esxi_idp_allowed_admin_accounts

    // The role or permission granted should match elevated / administrative patterns
    // Chronicle normalises the granted role into target.user.attribute.roles or
    // security_result.description; we match broadly on common admin role naming
    (
      $auth.target.user.attribute.roles = /admin/ nocase or
      $auth.target.user.attribute.roles = /root/ nocase or
      $auth.target.user.attribute.roles = /superuser/ nocase or
      $auth.target.user.attribute.roles = /privilege/ nocase or
      $auth.target.user.attribute.roles = /elevated/ nocase or
      $auth.target.user.attribute.roles = /sysadmin/ nocase or
      $auth.target.user.attribute.roles = /dcadmin/ nocase or
      $auth.target.user.attribute.roles = /globaladmin/ nocase
    )

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity    = array_distinct($auth.target.user.userid)
    $actor_account     = array_distinct($auth.principal.user.userid)
    $granted_roles     = array_distinct($auth.target.user.attribute.roles)

  condition:
    $auth
}
