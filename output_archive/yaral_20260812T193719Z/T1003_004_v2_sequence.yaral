/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:03:38.373672+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Registry_Access_Then_Hive_Export {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage LSA secrets harvesting pattern: a process opens or reads the HKLM\\SECURITY\\Policy\\Secrets registry hive (stage 1), followed within 10 minutes by a file creation event consistent with a registry hive export or credential dump file on the same host (stage 2). This targets the registry-read-then-export workflow used by tools that dump LSA secrets without spawning reg.exe on the command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing REGISTRY_MODIFICATION or REGISTRY_CREATION events for HKLM\\SECURITY reads, and FILE_CREATION events. Sysmon Event IDs 12/13 (registry) and 11 (file create) are sufficient. Windows Security audit of object access on the SECURITY hive also feeds this via UDM normalisation."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup agents performing scheduled registry exports, domain controller replication tooling, authorised vulnerability scanners with SYSTEM privileges, Windows Backup (wbadmin) creating VSS snapshots that include the SECURITY hive."
    tuning_guidance = "Add authorised backup and scanner process paths to %global_allowed_lsa_readers. Add known-safe export destinations (e.g. backup share UNC paths) to %global_allowed_hive_export_paths. Scope by hostname if a specific host runs a legitimate backup agent that touches the SECURITY hive."

  events:
    // Stage 1: any process touches the HKLM\SECURITY\Policy\Secrets registry path
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /HKEY_LOCAL_MACHINE\\SECURITY\\Policy\\Secrets/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_lsa_readers
    $reg.principal.hostname = $hostname

    // Stage 2: a file is created that matches common hive-dump or credential-dump naming patterns
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(hiv|save|dmp|bin|dat|secrets|lsa)$/ nocase
    not $file.target.file.full_path in %global_allowed_hive_export_paths
    $file.principal.hostname = $hostname

    // Chronological ordering: registry access precedes file creation
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys_accessed = array_distinct($reg.target.registry.registry_key)
    $dump_files_created = array_distinct($file.target.file.full_path)
    $accessing_processes = array_distinct($reg.principal.process.file.full_path)
    $file_creating_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
