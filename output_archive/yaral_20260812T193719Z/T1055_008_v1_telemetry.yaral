/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:42:45.090535+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injection_Proc_Mem_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-level access to /proc/<pid>/mem or /proc/<pid>/task paths that indicate a process is writing directly into another process's address space - the artifact produced by ptrace-based injection. Legitimate debuggers (gdb, strace) access these paths, but access from non-developer processes or from processes running outside known tool directories is suspicious. This rule targets the resulting file-system artifact rather than the ptrace syscall itself, providing coverage that survives command-line log evasion."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR or auditd with file-open/file-write telemetry normalised into Chronicle UDM FILE_MODIFICATION events. Auditd rules: -a always,exit -F arch=b64 -S write -F dir=/proc -F key=proc_mem_write"
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, lldb, strace, valgrind), Java JVM introspection, performance profilers (perf, bpftrace), container runtimes performing checkpoint/restore (CRIU). Security scanners may also access /proc/<pid>/mem."
    tuning_guidance = "Populate %linux_allowed_debugger_paths with full paths of approved debuggers and profilers (e.g. /usr/bin/gdb, /usr/bin/strace, /usr/bin/valgrind). Populate %linux_allowed_proc_mem_users with service accounts that legitimately access /proc/<pid>/mem (e.g. CRIU, container runtime users). Narrow further by excluding writes originating from known CI/CD build hosts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target the /proc/<pid>/mem pseudo-file or task memory maps -
    // these are the kernel interfaces written to during ptrace injection.
    // Also covers /proc/<pid>/task/<tid>/mem for thread-level injection.
    $file.target.file.full_path = /\/proc\/[0-9]+\/(mem|task\/[0-9]+\/mem)$/ nocase

    // The writing process must not be a known, approved debugger.
    not $file.principal.process.file.full_path in %linux_allowed_debugger_paths

    // Exclude approved service accounts that legitimately touch proc/mem.
    not $file.principal.user.userid in %linux_allowed_proc_mem_users

    // Exclude writes originating from the kernel itself (pid 0 / kthread paths).
    not $file.principal.process.file.full_path = /\/usr\/lib\/systemd\// nocase

    // Capture the writing process path for outcome enrichment.
    $file.principal.process.file.full_path = $writer_path
    $file.principal.hostname = $hostname

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity    = array_distinct($hostname)
    $injecting_process = array_distinct($writer_path)
    $target_proc_path  = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
