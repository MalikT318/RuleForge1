/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:03:59.300907+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_Linux_Cached_Domain_Credential_DB_Access {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-read or open access to Linux cached domain credential databases maintained by SSSD or Quest Authentication Services. Adversaries with elevated privileges read these LDB/VDB files to extract cached domain credential hashes for offline cracking. This rule fires on the file artifact access rather than the command line, providing coverage that survives tool renaming."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires Linux EDR or auditd file-open/read telemetry normalised into Chronicle UDM FILE_READ events. Auditd rules must include '-a always,exit -F arch=b64 -S open,openat -F dir=/var/lib/sss/db -F dir=/var/opt/quest/vas/authcache -k cached_creds' or equivalent EDR file monitoring on those paths."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "SSSD daemon itself reading its own cache during normal authentication; Quest VAS daemon performing routine cache maintenance; authorised backup agents reading /var/lib/sss/db; security scanning tools with explicit approval."
    tuning_guidance = "Populate %linux_allowed_credential_cache_readers with the full paths of authorised processes (e.g. /usr/sbin/sssd, /opt/quest/bin/vasd, approved backup agent binaries). Narrow further by adding known-good parent process paths. If auditd is the source, ensure the auid field is mapped so interactive root sessions are distinguished from daemon activity."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target the SSSD domain credential cache LDB files or Quest VAS auth cache VDB files.
    // Both patterns use a wildcard segment to accommodate any domain name in the path.
    (
      $file.target.file.full_path = /^\/var\/lib\/sss\/db\/cache\.[^\/]+\.ldb$/ nocase
      or
      $file.target.file.full_path = /^\/var\/opt\/quest\/vas\/authcache\/vas_auth\.vdb$/ nocase
    )

    // Exclude the authorised daemons and tools that legitimately read these files.
    not $file.principal.process.file.full_path in %linux_allowed_credential_cache_readers

    // Exclude the SSSD daemon itself by path pattern as a belt-and-suspenders guard
    // in case the reference list is not yet populated.
    not $file.principal.process.file.full_path = /^\/usr\/sbin\/sssd$/ nocase
    not $file.principal.process.file.full_path = /^\/usr\/libexec\/sssd\// nocase
    not $file.principal.process.file.full_path = /^\/opt\/quest\/bin\/vasd$/ nocase

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity    = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $accessed_file     = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
