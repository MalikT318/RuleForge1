/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:07:35.769390+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Keychain_File_Read_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects unexpected processes opening or reading macOS Keychain database files directly from disk. Adversaries may read login.keychain-db or other Keychain files to extract stored credentials without invoking the security CLI. This rule targets the file-read artifact rather than command-line invocation, providing coverage orthogonal to process-creation detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "Requires macOS EDR telemetry capable of emitting FILE_READ events for Keychain database paths (e.g., CrowdStrike Falcon, SentinelOne, or Jamf Protect with file-access auditing enabled)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Keychain Access.app, securityd, secd, cloudd, akd, and other Apple system daemons legitimately read Keychain files. Backup agents (Time Machine, third-party backup tools) may also read these files. Password managers with Keychain integration may trigger this rule."
    tuning_guidance = "Populate %macos_allowed_keychain_readers with full paths of approved system daemons and backup agents (e.g., /usr/sbin/securityd, /usr/libexec/secd, /System/Library/CoreServices/Keychain Access.app/Contents/MacOS/Keychain Access). Narrow scope further by excluding processes signed by Apple (if codesign metadata is available in your EDR UDM normalisation)."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target Keychain database files across all three Keychain locations
    (
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/Keychains\// nocase or
      $file.target.file.full_path = /\/Library\/Keychains\// nocase or
      $file.target.file.full_path = /\/Network\/Library\/Keychains\// nocase
    )

    // Match known Keychain database file extensions and names
    (
      $file.target.file.full_path = /login\.keychain(-db)?$/ nocase or
      $file.target.file.full_path = /System\.keychain$/ nocase or
      $file.target.file.full_path = /\.keychain-db$/ nocase or
      $file.target.file.full_path = /\.keychain$/ nocase
    )

    // Exclude well-known Apple system processes that legitimately access Keychain files
    not $file.principal.process.file.full_path in %macos_allowed_keychain_readers

    // Exclude Apple system process directories to reduce noise from OS daemons
    not $file.principal.process.file.full_path = /^\/(System\/Library|usr\/libexec|usr\/sbin)\// nocase

    // Flag processes running from user-writable or suspicious locations
    // This catches tools dropped into temp dirs, home dirs, or app bundles outside /Applications
    (
      $file.principal.process.file.full_path = /\/Users\/[^\/]+\// nocase or
      $file.principal.process.file.full_path = /\/tmp\// nocase or
      $file.principal.process.file.full_path = /\/private\/tmp\// nocase or
      $file.principal.process.file.full_path = /\/var\/folders\// nocase or
      $file.principal.process.file.full_path = /\/Applications\/[^\/]+\.app\// nocase
    )

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $keychain_file_accessed = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
