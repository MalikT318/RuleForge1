/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:11:52.677196+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_AppLayerProtocol_HighFreqBeacon_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects potential C2 beaconing over application-layer protocols by identifying high-frequency, low-variance outbound connections to non-internal destinations on common web and alternate ports. Adversaries blend C2 traffic into legitimate HTTP/HTTPS/DNS flows. This rule targets the network-observable pattern of periodic connections characteristic of implant check-ins, as seen from firewall and proxy perimeter telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires firewall or perimeter proxy logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Connection count and port visibility required."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software update agents, telemetry clients, monitoring agents, CDN health checks, SaaS application heartbeats, and browser prefetch activity may produce similar high-frequency outbound patterns."
    tuning_guidance = "Add known-good internal source IPs or subnets to %internal_address_space. Add approved high-frequency destination IPs (e.g., update servers, monitoring endpoints) to %allowed_beacon_destinations. Raise the port filter or restrict to specific ports if environment uses a proxy that normalises all outbound traffic."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Restrict to outbound connections only - source is internal, destination is external
    not $net.principal.ip in %internal_address_space
    not $net.target.ip in %internal_address_space
    not $net.target.ip in %allowed_beacon_destinations

    // Target common application-layer protocol ports used for C2 blending:
    // 80 (HTTP), 443 (HTTPS), 8080 (alt-HTTP), 8443 (alt-HTTPS), 53 (DNS-over-TCP),
    // 8888, 4443 - commonly abused by implants mimicking web traffic
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 8888 or
      $net.target.port = 4443 or
      $net.target.port = 53
    )

    // Exclude multicast and broadcast ranges that may appear in perimeter logs
    not $net.target.ip in %rfc_special_ranges

    // Require a source IP is present (logged connection, not a summary/aggregate)
    $net.principal.ip != ""
    $net.target.ip != ""

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
