/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:10:07.902674+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_CredMgr_Vault_File_Read_After_Suspicious_Process {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a non-system process opening or reading the Windows Credential Manager vault files (.vcrd / Policy.vpol) shortly after a process that is not a known credential-manager consumer is launched. This correlation provides additive coverage beyond command-line detections by focusing on the file-access behaviour that must occur when credentials are actually extracted from the vault."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR or Sysmon file-read/open telemetry (FILE_READ events on vault paths) and PROCESS_LAUNCH telemetry. Sysmon Event ID 11 (FileCreate) or EDR file-access events normalised to FILE_READ/FILE_CREATION in UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Windows Credential Manager service itself (lsass.exe, svchost.exe hosting VaultSvc), backup agents reading user profiles, roaming-profile synchronisation tools, and authorised password-management software."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_credmgr_parents and known-good accessing process paths to %global_allowed_vault_readers. Scope by hostname if noisy in specific environments."

  events:
    // Event 1: A process launches that is NOT a known system or credential-manager binary.
    // We pre-filter narrowly to processes whose parent is an interactive or scripting host,
    // indicating user-space or attacker-controlled execution rather than OS internals.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\.(exe)$/ nocase
    // Exclude known-safe system processes that legitimately touch the vault
    not $proc.target.process.file.full_path = /\\(lsass|svchost|explorer|taskhostw|backgroundtaskhost|dllhost|SearchIndexer|WmiPrvSE)\.exe$/ nocase
    // Exclude known-safe parent paths via reference list
    not $proc.principal.process.file.full_path in %global_allowed_credmgr_parents
    // Anchor the join on the hostname
    $proc.principal.hostname = $hostname

    // Event 2: A file read/access targeting the Windows Credential Manager vault path.
    // The vault is stored under AppData\Local\Microsoft\Vault or \Credentials\.
    // .vcrd files hold encrypted credentials; Policy.vpol holds the encryption key.
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\AppData\\Local\\Microsoft\\(Vault|Credentials)\\.*\.(vcrd|vpol)$/ nocase
    // The accessing process must not be a known-safe vault reader
    not $file.principal.process.file.full_path = /\\(lsass|svchost|VaultSvc)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_vault_readers
    $file.principal.hostname = $hostname

    // Chronological ordering: process launch must precede the vault file access
    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $launched_process  = array_distinct($proc.target.process.file.full_path)
    $vault_files_accessed = array_distinct($file.target.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc and $file
}
