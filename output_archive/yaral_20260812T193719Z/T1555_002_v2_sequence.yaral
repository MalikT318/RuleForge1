/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:08:38.919816+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Securityd_Memory_Dump_Then_Keychain_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage credential harvesting pattern targeting macOS securityd memory: first, a process attaches to or inspects the securityd process (via task_for_pid-capable tools such as lldb, gdb, vmmap, or memory inspection utilities), followed within 10 minutes by access or creation of keychain-related files in user or system Library paths. This combination is strongly indicative of T1555.002 securityd memory scraping for plaintext keychain credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires macOS EDR telemetry providing PROCESS_LAUNCH and FILE_CREATION/FILE_MODIFICATION events with process command-line and file path fields populated. Unified log forwarding via an EDR agent (e.g., SentinelOne, CrowdStrike Falcon, Jamf Protect) normalised to Chronicle UDM."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate developers using lldb/gdb for debugging on developer workstations; Apple Diagnostics or crash reporters accessing securityd; authorised security tooling performing memory analysis; Xcode instruments runs."
    tuning_guidance = "Add known developer hostnames to %macos_approved_developer_hosts. Add authorised memory-inspection parent process paths to %macos_allowed_memory_tools. Scope by user role - developer accounts may legitimately invoke debuggers."

  events:
    // Stage 1: A memory-inspection or debugger tool is launched targeting securityd
    // Matches debuggers, vmmap, heap, leaks, sample, dtrace, or similar
    // that reference securityd in their arguments - indicating process attachment
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(lldb|gdb|vmmap|heap|leaks|sample|dtrace|dtruss|memdump|memorystatus)$/ nocase
    $proc.target.process.command_line = /securityd/ nocase
    not $proc.principal.hostname in %macos_approved_developer_hosts
    not $proc.principal.process.file.full_path in %macos_allowed_memory_tools
    $proc.principal.hostname = $hostname

    // Stage 2: Keychain-related file creation or modification following the memory probe
    // Covers user keychains, system keychain, and common staging/exfil file patterns
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/Keychains\// nocase or
      $file.target.file.full_path = /\/Library\/Keychains\// nocase or
      $file.target.file.full_path = /\/private\/var\/db\/mds\// nocase or
      $file.target.file.full_path = /\.keychain(-db)?$/ nocase
    )
    not $file.target.file.full_path in %macos_allowed_keychain_writers
    $file.principal.hostname = $hostname

    // Chronological ordering: memory probe must precede keychain file event
    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $memory_tool_invoked = array_distinct($proc.target.process.file.full_path)
    $memory_tool_cmdline = array_distinct($proc.target.process.command_line)
    $keychain_files_touched = array_distinct($file.target.file.full_path)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $file_event_count = count($file.target.file.full_path)

  condition:
    $proc and $file
}
