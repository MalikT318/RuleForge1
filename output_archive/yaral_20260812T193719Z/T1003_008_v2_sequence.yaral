/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:06:31.627695+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_Read_Then_Crackdb_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a process opening /etc/shadow or /etc/passwd for reading followed by creation of a file in a world-writable or temp directory on the same host within 10 minutes. This pattern is consistent with credential file dumping (e.g., unshadow) that stages output for offline cracking. Intentionally avoids command-line matching to provide additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. FILE_READ events must be generated for /etc/shadow and /etc/passwd access. FILE_CREATION events must be generated for output files written to /tmp, /dev/shm, /var/tmp, or similar staging paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup agents reading /etc/shadow for system state snapshots; authorised identity management tooling; security scanners; configuration management systems (Ansible, Puppet, Chef) that audit credential files."
    tuning_guidance = "Add authorised backup or IAM process paths to %linux_allowed_shadow_readers. Add known-safe staging directories or file name patterns to %linux_allowed_staging_paths. Scope by principal.user.userid to exclude service accounts that legitimately read these files."

  events:
    // Leg 1: a process reads /etc/shadow or /etc/passwd
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /^\/(etc)\/(shadow|passwd|shadow\-|passwd\-)$/ nocase
    not $read.principal.process.file.full_path in %linux_allowed_shadow_readers
    $read.principal.hostname = $hostname

    // Leg 2: a file is created in a world-writable or temp staging location on the same host
    $create.metadata.event_type = "FILE_CREATION"
    $create.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm|var\/run)\// nocase
    not $create.target.file.full_path in %linux_allowed_staging_paths
    $create.principal.hostname = $hostname

    // Chronological ordering: shadow read must precede the staged output file
    $read.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($read.principal.hostname)
    $reading_process = array_distinct($read.principal.process.file.full_path)
    $credential_file_accessed = array_distinct($read.target.file.full_path)
    $staged_output_file = array_distinct($create.target.file.full_path)
    $acting_user = array_distinct($read.principal.user.userid)

  condition:
    $read and $create
}
