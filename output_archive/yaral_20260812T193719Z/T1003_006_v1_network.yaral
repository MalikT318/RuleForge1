/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:04:50.236311+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_Network_Replication_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects network-observable DCSync behaviour: a non-domain-controller host initiating an outbound connection to a domain controller on the MS-DRSR replication port (TCP 135 RPC endpoint mapper or high RPC ports associated with DRSUAPI). DCSync abuses the Directory Replication Service Remote Protocol to pull credential material. Firewall/perimeter logs will surface unexpected hosts initiating connections to DC RPC ports. Legitimate AD replication originates only from known DC addresses."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires firewall or network flow telemetry that records internal east-west traffic including source IP, destination IP, destination port, and protocol. Internal DC subnets and known-good replication sources must be enumerated in reference lists."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate domain controllers performing AD replication (add their IPs to %dc_replication_sources). Backup and identity management products (e.g. Azure AD Connect, Quest, SolarWinds) that perform legitimate directory sync over RPC. Vulnerability scanners probing RPC ports."
    tuning_guidance = "Populate %dc_replication_sources with all known DC and directory-sync appliance IPs. Populate %dc_subnet_destinations with DC IP ranges. Populate %approved_dirsync_sources with identity management tool IPs. Narrow the port range if your environment uses fixed RPC ports via Group Policy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target must be a known domain controller address range
    $net.target.ip in %dc_subnet_destinations

    // RPC endpoint mapper (initial binding) or high dynamic RPC ports
    // DRSUAPI binds via port 135 then negotiates a dynamic port (49152-65535)
    // Both patterns are included to catch the full handshake sequence
    (
      $net.target.port = 135
      or
      ($net.target.port >= 49152 and $net.target.port <= 65535)
    )

    // TCP only - DRSUAPI is TCP-based
    $net.network.ip_protocol = "TCP"

    // Source must NOT be a known legitimate DC or approved directory-sync source
    not $net.principal.ip in %dc_replication_sources
    not $net.principal.ip in %approved_dirsync_sources

    // Source must not be in the DC subnet itself (DC-to-DC replication is normal)
    not $net.principal.ip in %dc_subnet_destinations

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_dc = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
