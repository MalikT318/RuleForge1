/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:06:53.534280+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_CredStore_File_Access_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read or open access to well-known Windows credential store files (DPAPI master keys, Windows Credential Manager vaults, browser credential databases, and Windows Vault files). Attackers targeting T1555 must physically access these files to extract credentials; this rule fires on the resulting file-access event rather than on the process command line, providing a layer of coverage that survives command-line obfuscation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires EDR or Sysmon file-access telemetry (Sysmon Event ID 11 / FileCreate, or EDR file-open events normalised to FILE_READ or FILE_CREATION in UDM). DPAPI and Vault file paths must be included in the EDR file-monitoring scope."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows LSASS / credential backup utilities during legitimate profile operations; enterprise password-sync agents; backup software reading user profile directories; antivirus scanning credential store paths."
    tuning_guidance = "Add known-good backup or sync process paths to %global_allowed_credstore_readers. Scope the rule to non-system processes by excluding SYSTEM-context processes if your EDR populates principal.user.userid reliably. Consider raising severity to Critical when the accessing process is not a recognised Windows component."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target the canonical Windows credential store file paths using regex
    // with nocase to handle any case variation in UDM normalisation.
    // Covers:
    //   DPAPI master keys  : %APPDATA%\Microsoft\Protect\<SID>\*
    //   Credential Manager : %APPDATA%\Microsoft\Credentials\*
    //   Windows Vault      : %LOCALAPPDATA%\Microsoft\Vault\*
    //   IE / Edge legacy   : %APPDATA%\Microsoft\Windows\IEUser.dat
    //   Chrome credentials : \AppData\Local\Google\Chrome\User Data\Default\Login Data
    //   Firefox logins     : \AppData\Roaming\Mozilla\Firefox\Profiles\*\logins.json
    //   Edge (Chromium)    : \AppData\Local\Microsoft\Edge\User Data\Default\Login Data
    (
      $file.target.file.full_path = /\\AppData\\Roaming\\Microsoft\\Protect\\/ nocase or
      $file.target.file.full_path = /\\AppData\\Roaming\\Microsoft\\Credentials\\/ nocase or
      $file.target.file.full_path = /\\AppData\\Local\\Microsoft\\Vault\\/ nocase or
      $file.target.file.full_path = /\\AppData\\Roaming\\Microsoft\\Windows\\IEUser\.dat$/ nocase or
      $file.target.file.full_path = /\\AppData\\Local\\Google\\Chrome\\User Data\\[^\\]+\\Login Data/ nocase or
      $file.target.file.full_path = /\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\[^\\]+\\logins\.json$/ nocase or
      $file.target.file.full_path = /\\AppData\\Local\\Microsoft\\Edge\\User Data\\[^\\]+\\Login Data/ nocase
    )

    // Exclude processes that legitimately manage these files as part of
    // normal Windows operation or known-good tooling.
    not $file.principal.process.file.full_path = /\\Windows\\System32\\lsass\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\Windows\\System32\\svchost\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\Windows\\System32\\dpapi\.dll$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_credstore_readers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $credential_file_accessed = array_distinct($file.target.file.full_path)
    $user_context = array_distinct($file.principal.user.userid)

  condition:
    $file
}
