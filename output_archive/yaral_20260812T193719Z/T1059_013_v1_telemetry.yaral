/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:56:40.880656+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_API_Exec_Audit {
  meta:
    author          = "TELUS Automated Detection Engineering"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects container exec/attach API calls recorded in cloud audit logs. These calls indicate a user or service account opened an interactive or command-execution session inside a running container via the container runtime API (e.g., Kubernetes exec, Docker API exec). This is the audit-plane artifact produced by T1059.013 and is harder to suppress than process-creation telemetry."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Cloud provider audit logs normalised into Chronicle UDM. Kubernetes API server audit logging must be enabled (audit policy level >= Request). Docker daemon audit logging via cloud-native audit trail. No endpoint agent required."
    platform        = "Containers"
    log_source      = "cloud_audit"
    false_positives = "Authorised SRE/DevOps interactive debugging sessions, CI/CD pipeline health-check exec calls, monitoring agents that exec into containers to collect metrics, automated runbook remediation tooling."
    tuning_guidance = "Populate %container_exec_allowed_principals with approved service accounts and human users that legitimately exec into containers (e.g., CI service accounts, on-call SRE accounts). Populate %container_exec_allowed_namespaces with non-production namespaces where interactive exec is expected. Consider raising severity to Critical when the target namespace is production or kube-system."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match the exec/attach/portforward API verbs as normalised by Chronicle UDM.
    // These are the audit-plane operations produced when someone runs
    // `kubectl exec`, `kubectl attach`, `docker exec`, or equivalent API calls.
    $cloud.metadata.product_event_type = /exec|attach|portforward/ nocase

    // Scope to container workload resource types: pods (Kubernetes) or
    // containers (generic cloud runtime audit). Avoids matching unrelated
    // resource access events that share the same verb pattern.
    $cloud.target.resource.resource_type = /pod|container/ nocase

    // Capture the acting principal for join / outcome use.
    $cloud.principal.user.userid = $actor

    // Exclude approved principals that legitimately exec into containers.
    not $cloud.principal.user.userid in %container_exec_allowed_principals

    // Exclude approved namespaces / resource groups where interactive exec
    // is expected (e.g., dev, staging, ephemeral test namespaces).
    not $cloud.target.resource.attribute.labels["namespace"] in %container_exec_allowed_namespaces

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $target_container  = array_distinct($cloud.target.resource.name)
    $target_namespace  = array_distinct($cloud.target.resource.attribute.labels["namespace"])
    $source_ip         = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
