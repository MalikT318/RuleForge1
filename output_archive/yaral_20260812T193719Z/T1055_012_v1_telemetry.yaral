/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:45:02.436946+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Process_Hollowing_Suspended_Process_Open {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a non-system process opening a handle to another process with PROCESS_VM_WRITE and PROCESS_SUSPEND_RESUME access rights combined - the canonical handle pattern required to hollow a suspended process. This fires on the PROCESS_OPEN telemetry produced by EDR/Sysmon (Event ID 10) rather than on command-line arguments, providing a different abstraction layer from process-creation rules and making evasion significantly harder."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires EDR or Sysmon process-access telemetry (Sysmon Event ID 10 or equivalent EDR cross-process handle event) normalised into UDM PROCESS_OPEN events. The sensor must capture granted_access / access_mask values."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Debuggers (Visual Studio, WinDbg, x64dbg), legitimate process monitors (Process Explorer, Process Hacker), JIT compilers (JVM, CLR), some AV/EDR self-protection threads, and software installers that inject into their own child processes."
    tuning_guidance = "Add known-good parent process paths (debuggers, JVM, CLR hosts) to %global_allowed_process_open_parents. Add known-good child/target process paths to %global_allowed_process_open_targets. Consider scoping to non-developer workstation asset groups if debugger false-positives are high."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opening (injecting) process must NOT be a known system process.
    // Legitimate OS components that open child processes for valid reasons
    // are excluded here; attackers use user-land or LOLBin launchers.
    not $open.principal.process.file.full_path = /\\(csrss|smss|wininit|services|lsass|svchost|ntoskrnl|System)\.exe$/ nocase
    not $open.principal.process.file.full_path = /^$/ nocase

    // The target (victim/hollowed) process is typically a benign Windows
    // binary launched suspended - common choices are system executables.
    // We match the most-abused targets: any .exe under System32 or SysWOW64,
    // or any .exe under Program Files, which are the canonical "legitimate
    // looking" host processes used in hollowing.
    $open.target.process.file.full_path = /\\(windows\\system32|windows\\syswow64|windows\\sysnative)/ nocase

    // Access mask: hollowing requires at minimum PROCESS_VM_WRITE (0x0020),
    // PROCESS_VM_OPERATION (0x0008), and PROCESS_SUSPEND_RESUME (0x0800).
    // EDR/Sysmon surfaces this as a hex or decimal string in the
    // target.process.access_mask / security_result field.
    // We match the combined mask 0x0828 (VM_OPERATION | VM_WRITE | SUSPEND_RESUME)
    // or the broader 0x1fffff (PROCESS_ALL_ACCESS) which attackers also use.
    // Chronicle normalises Sysmon GrantedAccess into target.process.access_mask.
    $open.target.process.access_mask = /0x(0*1fffff|0*0828|0*1828|0*0020|0*08[2-9a-f][0-9a-f])/ nocase

    // Exclude known-good openers (debuggers, JVM, CLR, AV, EDR self-protection)
    not $open.principal.process.file.full_path in %global_allowed_process_open_parents

    // Exclude known-good target processes that are legitimately opened this way
    not $open.target.process.file.full_path in %global_allowed_process_open_targets

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity    = array_distinct($open.principal.hostname)
    $opening_process   = array_distinct($open.principal.process.file.full_path)
    $target_process    = array_distinct($open.target.process.file.full_path)
    $access_mask_seen  = array_distinct($open.target.process.access_mask)

  condition:
    $open
}
