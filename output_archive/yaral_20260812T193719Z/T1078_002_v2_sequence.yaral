/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:58:56.302582+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Domain_Account_Auth_Then_Sensitive_File_Access {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a domain account (SSSD/PAM/Kerberos-authenticated) login to a Linux host followed within 1 hour by access or modification of sensitive files such as /etc/sudoers, /etc/passwd, /etc/shadow, SSH authorized_keys, or cron configuration. This pattern is consistent with an adversary leveraging a compromised domain account to establish persistence or escalate privileges on a Linux system joined to Active Directory."
    mitre_tactic    = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. USER_LOGIN events must populate principal.user.userid and principal.hostname. FILE_MODIFICATION or FILE_CREATION events must populate target.file.full_path and principal.user.userid. SSSD, PAM, or Kerberos authentication must be in use for domain account logins."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate domain administrators performing authorised configuration changes; configuration management tools (Ansible, Puppet, Chef) running as domain service accounts; automated patching pipelines; IT onboarding scripts that provision SSH keys."
    tuning_guidance = "Add known automation service account userids to %linux_allowed_domain_service_accounts. Add approved configuration management hostnames to %linux_approved_config_mgmt_hosts. Narrow the file path regex if only specific sensitive paths are relevant to your environment."

  events:
    // Event 1: Domain account login via PAM/SSSD/Kerberos on a Linux host.
    // Domain accounts on Linux typically contain '@' (UPN) or a domain prefix,
    // or are authenticated via sssd/krb5 which populates the realm field.
    // We filter on USER_LOGIN and require the userid to contain a domain indicator.
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = /[@\\]/ nocase
    not $auth.principal.user.userid in %linux_allowed_domain_service_accounts
    $auth.principal.hostname = $hostname
    $auth.principal.user.userid = $domain_user

    // Event 2: Sensitive file modification or creation following the login,
    // attributed to the same domain user on the same host.
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^(\/etc\/(sudoers|sudoers\.d\/|passwd|shadow|group|ssh\/|pam\.d\/|cron\.|crontab|security\/)|\/var\/spool\/cron\/|\/home\/[^\/]+\/\.ssh\/(authorized_keys|config)|\/root\/\.ssh\/(authorized_keys|config)|\/etc\/systemd\/system\/|\/lib\/systemd\/system\/)/ nocase
    $file.principal.user.userid = $domain_user
    not $file.principal.hostname in %linux_approved_config_mgmt_hosts
    $file.principal.hostname = $hostname

    // Chronological ordering: login must precede the sensitive file operation
    $auth.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $domain_user over 1h

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1078.002")
    $primary_entity      = array_distinct($hostname)
    $affected_user       = array_distinct($domain_user)
    $sensitive_files_touched = array_distinct($file.target.file.full_path)
    $login_count         = count($auth.metadata.id)
    $file_mod_count      = count($file.metadata.id)

  condition:
    $auth and $file
}
