/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:10:32.883837+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Password_Manager_DB_File_Read {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-read or file-open access to common Linux password manager database files (KeePass .kdbx, pass store, Bitwarden vault, KWallet, GNOME Keyring, etc.) by a process that is not the legitimate password manager binary. Attackers exfiltrate or parse these encrypted databases offline after copying them. This rule fires on the file artifact access rather than on command-line invocation, providing a complementary detection layer that is harder to evade."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires Linux EDR or auditd with file-open/file-read syscall auditing (auditd rules: -a always,exit -F arch=b64 -S open,openat,read -F exit=-EACCES or equivalent). Chronicle UDM must populate target.file.full_path and principal.process.file.full_path for FILE_READ events."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Backup agents (rsync, tar, Bacula, Veeam) reading password store directories; legitimate password manager processes opening their own database; user-initiated cp/mv of their own vault; IDE plugins with vault integration."
    tuning_guidance = "Add authorised backup agent paths to %linux_allowed_vault_readers. Add the legitimate password manager binary paths (keepassxc, pass, rbw, etc.) to the same list. Consider scoping by principal.user.userid to exclude service accounts that legitimately touch these files."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target: common Linux password manager database file paths and extensions
    (
      $file.target.file.full_path = /\.kdbx$/ nocase or
      $file.target.file.full_path = /\.kdb$/ nocase or
      $file.target.file.full_path = /\/\.password-store\// nocase or
      $file.target.file.full_path = /\/\.local\/share\/keyrings\// nocase or
      $file.target.file.full_path = /\/\.gnome2\/keyrings\// nocase or
      $file.target.file.full_path = /\/\.kde(4)?\/(share\/)?apps\/kwallet\// nocase or
      $file.target.file.full_path = /\/\.config\/Bitwarden\// nocase or
      $file.target.file.full_path = /\/\.config\/1Password\// nocase or
      $file.target.file.full_path = /\/\.config\/rbw\// nocase or
      $file.target.file.full_path = /\/\.local\/share\/pass\// nocase or
      $file.target.file.full_path = /\/\.vault\// nocase or
      $file.target.file.full_path = /\/kwallet[^\/]*\.kwl$/ nocase or
      $file.target.file.full_path = /\/login\.keychain/ nocase
    )

    // Exclude the legitimate password manager processes themselves
    not $file.principal.process.file.full_path = /\/(keepassxc|keepass2|keepass|pass|rbw|bitwarden|1password|kwallet|gnome-keyring-daemon|secret-tool|gpg|gpg2|gpg-agent)$/ nocase

    // Exclude common authorised readers (backup, sync, package managers)
    not $file.principal.process.file.full_path in %linux_allowed_vault_readers

    // Exclude root-owned system maintenance processes that legitimately traverse home dirs
    not $file.principal.process.file.full_path = /\/(rsync|tar|cpio|bacula-fd|veeam|duplicati|restic|borg|rclone)$/ nocase

    // Exclude editors that a user may open their own vault with intentionally
    // (retain for high-sensitivity environments; comment out if too noisy)
    not $file.principal.process.file.full_path = /\/(vim|vi|nano|gedit|kate|code|atom|sublime_text)$/ nocase

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity    = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $vault_file        = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
