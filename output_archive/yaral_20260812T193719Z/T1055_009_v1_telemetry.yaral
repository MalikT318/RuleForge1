/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:43:24.307680+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Proc_Mem_Maps_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read access to /proc/<pid>/maps or /proc/<pid>/mem by a process other than the target process itself, which is a prerequisite for proc memory injection via ROP payload construction. Attackers enumerate memory mappings to locate gadgets and stack offsets before overwriting the target process memory using dd or similar utilities."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd with file open/read syscall auditing enabled (auditd rules targeting -a always,exit -F arch=b64 -S open,openat,read -F dir=/proc). Chronicle UDM FILE_READ events must be populated from auditd or EDR telemetry."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace), system monitoring agents (Prometheus node_exporter, Datadog agent), container runtimes inspecting child processes, and security scanning tools that enumerate /proc for process inventory."
    tuning_guidance = "Add known monitoring agent binary paths to %linux_allowed_proc_readers. Consider narrowing by requiring the reading process to differ from the target PID directory owner. Correlate with subsequent dd or ptrace activity for higher-confidence detections."

  events:
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/proc\/[0-9]+\/(maps|mem|smaps|pagemap)$/ nocase
    not $open.principal.process.file.full_path in %linux_allowed_proc_readers
    not $open.principal.process.file.full_path = /\/(usr\/bin\/|usr\/sbin\/|bin\/|sbin\/)(ps|top|htop|ss|netstat|lsof|strace|gdb|ltrace)$/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($open.principal.hostname)
    $reading_process = array_distinct($open.principal.process.file.full_path)
    $target_proc_path = array_distinct($open.target.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
