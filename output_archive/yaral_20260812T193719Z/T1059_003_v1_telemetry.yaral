/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:50:22.781351+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_CmdShell_BatchFile_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation of batch script files (.bat / .cmd) in user-writable or suspicious directories. Adversaries frequently drop batch files as a persistence or execution artifact after abusing the Windows command shell, making file-creation telemetry a complementary detection layer that is harder to suppress than command-line logging."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised into UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write telemetry must be enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers, build pipelines, RMM agents, and developer toolchains that legitimately write batch files. Scheduled maintenance scripts dropped by authorised management tooling."
    tuning_guidance = "Add known-good parent process paths (e.g. installer engines, CI runners) to %global_allowed_batch_writers. Narrow the path regex to exclude your organisation's approved script staging directories if they generate noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match .bat or .cmd file extensions
    $file.target.file.full_path = /\.(bat|cmd)$/ nocase

    // Focus on user-writable and commonly abused staging locations:
    // %TEMP%, %APPDATA%, %LOCALAPPDATA%, %PUBLIC%, Downloads, Desktop,
    // root of C:\, and ProgramData sub-directories.
    $file.target.file.full_path = /(\\Temp\\|\\AppData\\|\\ProgramData\\|\\Users\\Public\\|\\Downloads\\|\\Desktop\\|^[A-Za-z]:\\[^\\]+\.(bat|cmd)$)/ nocase

    // Exclude known-good writer processes supplied per-client via reference list
    not $file.principal.process.file.full_path in %global_allowed_batch_writers

    // Exclude Windows system directories where legitimate batch files live
    not $file.target.file.full_path = /^[A-Za-z]:\\Windows\\/i nocase
    not $file.target.file.full_path = /^[A-Za-z]:\\Program Files/ nocase

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
