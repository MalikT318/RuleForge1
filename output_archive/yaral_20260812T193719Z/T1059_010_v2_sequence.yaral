/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:55:11.037191+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoScript_Drops_File_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an AutoHotKey or AutoIT interpreter spawning a child process that subsequently creates a file in a user-writable or temp directory, indicating potential payload staging or dropper activity. This provides additive coverage beyond command-line detection by correlating process lineage with file-write behaviour."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires EDR process telemetry with process lineage and file creation events (Sysmon Event IDs 1 and 11, or equivalent EDR normalised to UDM PROCESS_LAUNCH and FILE_CREATION)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate AutoIT-based installers or deployment tools that write files during setup. AutoHotKey scripts used by helpdesk or automation teams that legitimately drop configuration files. Software packaging workflows."
    tuning_guidance = "Add known-good AutoIT/AHK parent process full paths or child process paths to %global_allowed_autoscript_children. Add approved staging directories to %global_allowed_autoscript_write_paths. Scope by hostname or user group for environments with legitimate AHK/AutoIT usage."

  events:
    // First event: AutoHotKey or AutoIT interpreter launches a child process
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(autohotkey|autohotkey32|autohotkey64|autoit3|autoit3_x64|au3)\.exe$/  nocase
    not $proc.principal.process.file.full_path in %global_allowed_autoscript_children
    $proc.principal.hostname = $hostname
    $proc.target.process.pid = $child_pid

    // Second event: a file is created by a process on the same host shortly after,
    // targeting user-writable or staging paths commonly abused for payload drops
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(temp|tmp|appdata|programdata|public|downloads|desktop)\\/ nocase
    not $file.target.file.full_path in %global_allowed_autoscript_write_paths
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $autoscript_interpreter = array_distinct($proc.principal.process.file.full_path)
    $child_processes_launched = array_distinct($proc.target.process.file.full_path)
    $files_created = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
