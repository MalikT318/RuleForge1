/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:47:01.684193+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_VDSO_Hijack_ProcMem_Then_SharedLib_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a two-stage VDSO hijacking pattern: a process opens another process's memory map via /proc/<pid>/mem (indicating ptrace-style memory manipulation targeting the vdso region or GOT), followed within 5 minutes by the same host creating a shared object file in a world-writable or temporary location. Together these events indicate an adversary reading/patching vdso stubs and then staging a malicious shared library for injection via the hijacked syscall interface."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. Auditd rules must capture openat/open syscalls on /proc/*/mem and file creation events under /tmp, /dev/shm, /var/tmp, and anonymous paths. EDR must emit FILE_READ for /proc/<pid>/mem access and FILE_CREATION for shared object drops."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, lldb, strace) reading /proc/<pid>/mem; JVM or .NET runtimes generating shared objects in /tmp; package managers extracting .so files to temp directories during install; sanitizer-instrumented builds."
    tuning_guidance = "Add trusted debugger and runtime parent process paths to %linux_allowed_procmem_readers. Add known build/package-manager processes to %linux_allowed_so_creators. Narrow the shared-object path regex if /tmp drops are too noisy in your environment."

  events:
    // Stage 1: process reads another process's memory map - hallmark of
    // ptrace-equivalent vdso/GOT manipulation without a direct ptrace call.
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase
    not $open.principal.process.file.full_path in %linux_allowed_procmem_readers
    $open.principal.hostname = $hostname

    // Stage 2: a shared object is created in a world-writable or anonymous
    // location on the same host - consistent with staging a malicious .so
    // to be mapped via the hijacked vdso syscall stub.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(tmp|dev\/shm|var\/tmp|run\/shm)\/.*\.so(\.[0-9]+)*$/ nocase
    not $file.principal.process.file.full_path in %linux_allowed_so_creators
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: memory read precedes shared-object drop.
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score        = max(92)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity    = array_distinct($hostname)
    $procmem_reader    = array_distinct($open.principal.process.file.full_path)
    $so_creator        = array_distinct($file.principal.process.file.full_path)
    $dropped_so_paths  = array_distinct($file.target.file.full_path)
    $targeted_pid_mem  = array_distinct($open.target.file.full_path)

  condition:
    $open and $file
}
