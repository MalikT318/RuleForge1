/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:37:38.928726+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_macOS_Dylib_Injection_File_Artifact {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation of a dynamic library (.dylib) file in world-writable or user-writable locations commonly abused for macOS dylib injection and hijacking. Adversaries plant a malicious dylib in a path that a privileged process will load, achieving code injection without spawning a suspicious child process. This rule pivots on the file artifact rather than command-line telemetry, providing additive coverage over process-creation detections."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires macOS EDR or unified log telemetry that records FILE_CREATION events with target.file.full_path and principal.process.file.full_path populated. Verified with CrowdStrike Falcon for Mac, SentinelOne, and Jamf Protect."
    platform        = "macOS"
    log_source      = "macos_endpoint"
    false_positives = "Legitimate software installers writing dylibs to /tmp or /var/folders during installation; Homebrew package manager; developer build systems writing to project-local directories; Xcode derived data. Tune by adding known installer processes to %macos_allowed_dylib_writers."
    tuning_guidance = "Populate %macos_allowed_dylib_writers with full paths of trusted installer and build processes (e.g. /usr/sbin/installer, Homebrew ruby, Xcode build agents). Consider narrowing the path regex to exclude /private/var/folders if build-system noise is high. Raise severity to Critical if the writing process is a browser, document viewer, or network-facing daemon."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a dynamic library file
    $file.target.file.full_path = /\.dylib$/ nocase

    // Restrict to paths commonly abused for dylib injection:
    //   /tmp, /var/folders (world-writable scratch space)
    //   /Users/*/Library/Application Support (user-writable, loaded by apps)
    //   /Users/*/Library/Frameworks (user-writable framework injection)
    //   /Library/Application Support (admin-writable, loaded by system daemons)
    //   /private/tmp, /private/var (macOS canonical temp paths)
    $file.target.file.full_path = /^(\/private)?\/(tmp|var\/folders|Users\/[^\/]+\/Library\/(Application Support|Frameworks|Preferences)|Library\/(Application Support|Frameworks))\/.*\.dylib$/ nocase

    // Exclude known legitimate system writers
    not $file.principal.process.file.full_path = /^\/(System\/Library|usr\/libexec|usr\/bin\/codesign|usr\/sbin\/installer)/ nocase

    // Exclude known package managers and build toolchains via reference list
    not $file.principal.process.file.full_path in %macos_allowed_dylib_writers

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $injected_dylib_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
