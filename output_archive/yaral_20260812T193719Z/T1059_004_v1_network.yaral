/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:51:01.927278+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_NetworkDevice_Shell_Reverse_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound network connections from network devices to non-standard ports commonly associated with interactive Unix shell sessions established over command-and-control channels. Adversaries abusing T1059.004 on network devices (routers, switches, firewalls) may establish reverse shells or interactive sessions over ports such as 4444, 1337, 31337, 9001, 9002, or high ephemeral ports not associated with legitimate management protocols. This rule pivots to the network side to complement existing process-launch detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires firewall or perimeter flow logs with source/destination IP, port, and protocol. Connections must be logged at session establishment. UDM event type NETWORK_CONNECTION or NETWORK_FLOW."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate out-of-band management tools using non-standard ports, custom monitoring agents, vendor-specific telemetry collectors, or authorised penetration testing activity."
    tuning_guidance = "Add known management-plane source IPs or destination IPs to %allowed_mgmt_destinations. Add approved high ports used by monitoring tools to %allowed_nonstandard_ports. Narrow the destination port list if specific ports generate excessive noise in your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Originating from a network device management plane address space
    // (principal is the network device initiating the outbound connection)
    not $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal

    // Target destination is NOT a known-good management destination
    not $net.target.ip in %allowed_mgmt_destinations

    // Ports strongly associated with interactive shell / reverse shell sessions
    // Covers common attacker-chosen ports: 4444 (Metasploit default),
    // 1337, 31337 (elite), 9001/9002 (common C2), 6666, 7777, 8888 (common shells),
    // and the suspicious high-port band 40000-65535 excluding known services
    (
      $net.target.port = 4444 or
      $net.target.port = 1337 or
      $net.target.port = 31337 or
      $net.target.port = 9001 or
      $net.target.port = 9002 or
      $net.target.port = 6666 or
      $net.target.port = 7777 or
      $net.target.port = 8888 or
      $net.target.port = 5555 or
      $net.target.port = 2222
    )

    // TCP only - interactive shells require reliable transport
    $net.network.ip_protocol = "TCP"

    // Exclude connections to approved non-standard port destinations
    not $net.target.port in %allowed_nonstandard_ports

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
