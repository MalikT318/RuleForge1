/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:59:53.566101+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_SaaS_Cloud_Account_Privilege_Change_After_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a privilege or permission change applied to a cloud/SaaS account shortly after an interactive login, which may indicate an adversary leveraging a compromised cloud account to escalate privileges or establish persistence. Targets identity provider audit events for role/group assignment changes rather than process-creation telemetry, providing additive coverage over command-line-based detections."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires identity provider audit logs (e.g. Entra ID, Okta, Google Workspace) normalised to Chronicle UDM. Events must include USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION with principal.user.userid and target.user.userid populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate IT provisioning workflows, automated role-assignment pipelines, HR onboarding automation, and privileged access management (PAM) tooling that assigns roles programmatically."
    tuning_guidance = "Add known provisioning service accounts to %global_allowed_provisioning_accounts. Add approved admin groups whose membership changes are expected to %global_allowed_admin_groups. Narrow severity by correlating with risky sign-in signals if available."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // The actor performing the change must be a real user account, not a known service principal
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_provisioning_accounts

    // The target of the permission change must be a different account (self-escalation is also interesting but handled separately)
    $auth.target.user.userid != ""

    // Detect elevation to high-privilege roles: match common privileged role/group name patterns
    // across identity providers without hardcoding vendor-specific strings
    (
      $auth.target.user.role_name = /admin/ nocase or
      $auth.target.user.role_name = /global.admin/ nocase or
      $auth.target.user.role_name = /owner/ nocase or
      $auth.target.user.role_name = /privileged/ nocase or
      $auth.target.user.role_name = /super.?user/ nocase or
      $auth.target.user.role_name = /root/ nocase or
      $auth.target.user.role_name = /security.admin/ nocase or
      $auth.target.user.role_name = /directory.?role/ nocase
    )

    // Exclude changes targeting groups that are explicitly allow-listed
    not $auth.target.user.role_name in %global_allowed_admin_groups

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $target_account = array_distinct($auth.target.user.userid)
    $role_assigned = array_distinct($auth.target.user.role_name)
    $src_ip = array_distinct($auth.principal.ip)

  condition:
    $auth
}
