/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:11:35.883358+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_Secret_Access_After_Permission_Escalation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a cloud identity that first modifies permissions on a secrets management resource (e.g., Key Vault policy, Secrets Manager resource policy, Secret Manager IAM binding) and then immediately reads one or more secrets from that store. This two-step pattern is consistent with an adversary escalating their own access before harvesting credentials from a cloud-native secrets manager."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM. Covers AWS CloudTrail (GetSecretValue, PutResourcePolicy, UpdateSecret), Azure Activity (Key Vault access and policy events), and GCP Audit (accessSecretVersion, setIamPolicy on Secret Manager resources)."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Automated secret rotation pipelines that update their own IAM policy before reading a new secret version; infrastructure-as-code tooling (Terraform, Pulumi) applying permission changes during a planned deployment; CI/CD service accounts with legitimate broad secret access."
    tuning_guidance = "Add known automation service account identifiers to %cloud_allowed_secret_automation_principals. Add known CI/CD source IP ranges or principal patterns to %cloud_allowed_cicd_principals. Narrow the resource name regex to your organisation's secret naming convention to reduce noise."

  events:
    // Event 1: permission change on a secrets management resource
    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.target.resource.name = /secret|vault|kms|key.vault|secretsmanager|secret.manager/ nocase
    not $perm.principal.user.userid in %cloud_allowed_secret_automation_principals
    $perm.principal.user.userid = $actor

    // Event 2: secret read / access following the permission change
    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.target.resource.name = /secret|vault|kms|key.vault|secretsmanager|secret.manager/ nocase
    $acc.target.resource.attribute.labels.key = /action|operation|method/ nocase
    $acc.target.resource.attribute.labels.value = /GetSecretValue|accessSecretVersion|SecretGet|getSecret|show/ nocase
    not $acc.principal.user.userid in %cloud_allowed_secret_automation_principals
    $acc.principal.user.userid = $actor

    // Chronological ordering: permission change must precede the secret read
    $perm.metadata.event_timestamp.seconds <= $acc.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity = array_distinct($actor)
    $secrets_accessed = array_distinct($acc.target.resource.name)
    $permission_resources_modified = array_distinct($perm.target.resource.name)
    $source_ips = array_distinct($acc.principal.ip)
    $perm_event_count = count($perm.metadata.id)
    $access_event_count = count($acc.metadata.id)

  condition:
    $perm and $acc
}
