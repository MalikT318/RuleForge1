/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:50:05.572901+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_AppleScript_File_Then_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an AppleScript file (.scpt or .applescript) written to a user-writable or staging path, followed by osascript executing a file argument from the same host within 5 minutes. This correlation catches adversaries who drop a compiled or plain-text AppleScript payload to disk and then execute it, a pattern distinct from inline -e flag execution already covered by existing rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "Requires macOS EDR or unified log telemetry normalised to UDM FILE_CREATION and PROCESS_LAUNCH events. Both event types must be present for the correlation to fire."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Automator workflows saving compiled scripts, legitimate developer tooling (Xcode, Script Editor auto-save), IT automation frameworks writing AppleScript helpers to /tmp or user Library paths."
    tuning_guidance = "Add known-good parent process paths (e.g. Script Editor, Xcode) to %macos_allowed_applescript_writers. Add approved staging directories to %macos_allowed_script_staging_dirs. Raise severity if the writing process is a browser or document viewer."

  events:
    // Event 1: An AppleScript file is created in a user-writable or suspicious staging location
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(scpt|applescript|osas)$/ nocase
    $file.target.file.full_path = /(\/tmp\/|\/var\/folders\/|\/Users\/[^\/]+\/(Downloads|Desktop|Library\/Application Support|Library\/Caches)|\/private\/tmp\/)/ nocase
    not $file.principal.process.file.full_path = /\/(Script Editor|Automator|Xcode)\.app\// nocase
    not $file.principal.process.file.full_path in %macos_allowed_applescript_writers
    $file.principal.hostname = $hostname

    // Event 2: osascript launches with a file path argument (not -e inline, which is covered elsewhere)
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/osascript$/ nocase
    $proc.target.process.command_line = /osascript\s+[^-]/ nocase
    not $proc.principal.process.file.full_path in %macos_allowed_applescript_writers
    $proc.principal.hostname = $hostname

    // Chronological ordering: file must be written before execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $dropped_script_paths = array_distinct($file.target.file.full_path)
    $osascript_command_lines = array_distinct($proc.target.process.command_line)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $executing_parent = array_distinct($proc.principal.process.file.full_path)

  condition:
    $file and $proc
}
