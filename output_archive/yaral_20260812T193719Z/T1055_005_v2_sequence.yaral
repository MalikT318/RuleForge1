/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:42:24.188691+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Injection_ProcessOpen_Then_Suspicious_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a potential TLS callback injection sequence: a non-standard process opens a handle to a remote process (PROCESS_OPEN), followed within 5 minutes by the victim process spawning an anomalous child process. TLS injection manipulates PE TLS callback pointers so that injected code executes before the legitimate entry point, often causing the victim process to launch unexpected children or load unexpected modules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_OPEN events (Sysmon Event ID 10) and PROCESS_LAUNCH events with parent-child lineage. Both event types must be normalised into Chronicle UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), AV/EDR self-protection handles, JIT compilers (JVM, CLR) opening host processes, software installers that inject into setup hosts."
    tuning_guidance = "Add known-good openers (debuggers, AV agents, JVM paths) to %global_allowed_process_openers. Add known-good parent/child pairs to %global_allowed_parent_child_pairs. Narrow the anomalous-child regex if specific scripting engines are not present in your environment."

  events:
    // Leg 1: a suspicious process opens a handle to another process (cross-process access)
    $open.metadata.event_type = "PROCESS_OPEN"
    // The opener must NOT be a known system process performing routine handle operations
    not $open.principal.process.file.full_path = /\\(lsass|csrss|smss|wininit|services|svchost|MsMpEng|SenseIr|SenseCnc|MsSense)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_process_openers
    // The target of the handle open is a running host process (common injection targets)
    $open.target.process.file.full_path = /\\(explorer|svchost|RuntimeBroker|dllhost|msiexec|regsvr32|rundll32|werfault|conhost|notepad|mspaint|calc)\.exe$/ nocase
    // Capture the victim hostname and the victim process image for the join
    $open.principal.hostname = $hostname
    $open.target.process.file.full_path = $victim_image

    // Leg 2: the victim process (same image) spawns an anomalous child shortly after
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $hostname
    // Parent of the child must match the victim image captured above
    $proc.principal.process.file.full_path = $victim_image
    // Child is a scripting engine, shell, or loader - unexpected from these parents
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|regsvr32|rundll32|certutil|bitsadmin|wmic|msiexec|installutil|cmstp|odbcconf|ieexec|pcalua|forfiles|sdbinst|eudcedit|replace|makecab|expand|extrac32|hh|infdefaultinstall|msdeploy|msconfig|presentationhost|runscripthelper|syncappvpublishingserver|appsyncpublishingserver|appvlp|bginfo|csi|dnscmd|ftp|gpscript|mftrace|msdtc|msdt|msiexec|netsh|pcwrun|rpcping|runlegacycplsetting|scriptrunner|secedit|sfc|shdocvw|syssetup|ttdinject|tttracer|vbc|vsjitdebugger|wab|winrm|wmic|xwizard)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_parent_child_pairs

    // Chronological ordering: handle open must precede the anomalous child launch
    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $victim_image over 5m

  outcome:
    $risk_score = max(82)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($victim_image)
    $anomalous_child = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $open_event_count = count($open.metadata.id)

  condition:
    $open and $proc
}
