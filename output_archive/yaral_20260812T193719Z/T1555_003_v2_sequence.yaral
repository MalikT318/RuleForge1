/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T20:09:23.205531+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_BrowserCredDB_Read_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-browser process opening a browser credential database file (Chrome Login Data, Firefox logins.json, Edge Login Data, etc.) followed by an outbound network connection from the same process on the same host within 10 minutes. This two-stage correlation provides additive coverage beyond command-line process-launch rules by focusing on the file-access-then-exfil pattern."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Web Browsers"
    log_prerequisites = "Requires EDR file-read/open telemetry (FILE_READ or FILE_OPEN events) and network connection telemetry from an EDR or Sysmon-equivalent source normalised into Chronicle UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup agents reading browser profiles, password managers syncing credentials, antivirus scanning browser directories, IT asset-inventory tools."
    tuning_guidance = "Add known backup or AV process paths to %global_allowed_browser_db_readers. Add approved internal subnets to %rfc1918_internal to suppress internal-only connections if desired. Narrow target.file.full_path regex if only specific browsers are in scope."

  events:
    // Event 1: A non-browser process reads a browser credential store file
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\(Login Data|logins\.json|key4\.db|cookies\.sqlite|signons\.sqlite|Web Data)$/ nocase
    $file.target.file.full_path = /(AppData\\Local\\Google\\Chrome|AppData\\Local\\Microsoft\\Edge|AppData\\Roaming\\Mozilla\\Firefox|AppData\\Local\\BraveSoftware|AppData\\Local\\Opera Software)/ nocase
    // Exclude the browsers themselves reading their own credential stores
    not $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|iexplore|MicrosoftEdge)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_browser_db_readers
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $reader_proc

    // Event 2: The same process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $reader_proc
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 0
    $net.principal.hostname = $hostname

    // Chronological ordering: file read must precede network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $reader_proc over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($reader_proc)
    $credential_files_accessed = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file and $net
}
