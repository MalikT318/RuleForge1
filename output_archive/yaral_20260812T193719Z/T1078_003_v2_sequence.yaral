/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:59:35.495631+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Local_Account_Login_Then_Privilege_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a local account interactive or network login followed by a privilege or group membership change within 1 hour. This pattern is consistent with an adversary abusing a local account to escalate privileges or establish persistence via directory/group manipulation. Variant 2 of 2 for T1078.003."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires identity provider or Active Directory audit logs normalised to UDM USER_LOGIN and GROUP_MODIFICATION or USER_CHANGE_PERMISSIONS events. Windows Security Event IDs 4624 (logon), 4728/4732/4756 (group member add), 4672 (special privileges) should be ingested."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Helpdesk staff adding users to local groups during provisioning workflows; automated IT runbooks that log in with a service account and then adjust group membership; scheduled maintenance windows."
    tuning_guidance = "Add known provisioning service accounts to %global_allowed_provisioning_accounts. Add known admin workstation hostnames to %global_allowed_admin_hosts. Narrow the logon_type filter if only interactive logins are in scope."

  events:
    // Event 1: Local account login - logon type 2 (interactive) or 3 (network)
    // A local account is identified by the principal user domain matching the
    // target hostname (workgroup/local) or by a well-known local-account indicator.
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    // Exclude clearly domain-joined UPN-style accounts (contain @) and
    // well-known service/system accounts to reduce noise.
    not $auth.principal.user.userid = /^(system|anonymous logon|network service|local service)$/ nocase
    not $auth.principal.user.userid = /@/ nocase
    not $auth.principal.user.userid in %global_allowed_provisioning_accounts
    not $auth.target.hostname in %global_allowed_admin_hosts
    $auth.principal.user.userid = $userid
    $auth.target.hostname = $target_host

    // Event 2: Privilege or group membership change performed in the same session
    // context - same user acting as principal after the login.
    ($priv.metadata.event_type = "GROUP_MODIFICATION" or
     $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS")
    $priv.principal.user.userid = $userid
    $priv.target.hostname = $target_host
    not $priv.principal.user.userid in %global_allowed_provisioning_accounts

    // Chronological ordering: login must precede the privilege change.
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $userid, $target_host over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $affected_host = array_distinct($priv.target.hostname)
    $login_count = count($auth.metadata.id)
    $privilege_change_count = count($priv.metadata.id)
    $changed_groups = array_distinct($priv.target.group.group_display_name)

  condition:
    $auth and $priv
}
