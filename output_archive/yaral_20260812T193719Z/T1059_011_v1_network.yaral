/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:55:31.451804+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Outbound_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound network connections on uncommon high ports or to external destinations that may indicate Lua interpreter or Lua-embedded application establishing C2 or exfiltration channels on macOS. Firewall/proxy logs do not carry process context; this rule focuses on connection characteristics (destination port, protocol, external address) that are anomalous for typical macOS user traffic and consistent with Lua-based implant behaviour observed in threat reporting."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source IP must be a macOS endpoint in the monitored fleet."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Game engines with embedded Lua (e.g., World of Warcraft, Roblox client) making legitimate update connections; developer workstations running Lua-based build tooling; monitoring agents that embed Lua for scripting."
    tuning_guidance = "Add known-good internal source IPs or subnets to %lua_allowed_source_hosts. Add approved external destination CIDRs or IPs to %lua_allowed_destinations. Narrow the port list if specific Lua C2 ports are confirmed in your environment. Consider raising severity to High after baselining."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal macOS host - exclude internal-to-internal flows
    // by requiring the destination to be external (not in RFC-1918 / internal space)
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %lua_allowed_destinations

    // Exclude known-good source hosts (approved Lua-using applications)
    not $net.principal.ip in %lua_allowed_source_hosts

    // Focus on non-standard ports associated with Lua C2 tooling in threat reports
    // (PoetRat used 4443/8443/custom; EvilBunny used non-standard high ports)
    // Exclude well-known web ports to reduce noise from embedded-Lua web clients
    not $net.target.port = 80
    not $net.target.port = 443
    not $net.target.port = 8080
    not $net.target.port = 8443
    not $net.target.port = 53
    not $net.target.port = 22
    not $net.target.port = 25
    not $net.target.port = 587
    not $net.target.port = 993
    not $net.target.port = 995

    // Target high-numbered ports commonly used by Lua implants for raw socket C2
    $net.target.port >= 1024
    $net.target.port <= 65535

    // Require a non-trivial amount of data to filter idle/probe connections
    // and focus on sessions carrying payload (exfil or C2 tasking)
    $net.network.sent_bytes > 512

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
