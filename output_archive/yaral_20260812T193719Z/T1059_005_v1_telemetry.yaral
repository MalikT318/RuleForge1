/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-12T19:51:41.613398+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_VBScript_Artifact_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation of VBScript or VBA-related script artifacts in suspicious filesystem locations. Adversaries frequently drop .vbs, .vbe, .wsf, or .hta files into user-writable or temporary directories as a staging step before execution. This rule pivots on the file-creation artifact rather than process command-line arguments, providing coverage that is harder to evade than command-line logging."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write telemetry is required."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers dropping .vbs helper scripts, Group Policy logon/logoff scripts written to SYSVOL or local policy paths, RMM agents deploying automation scripts, developer workstations authoring VBScript files."
    tuning_guidance = "Add known-good parent process paths (e.g. software deployment agents, GPO engines) to %global_allowed_vbs_writers. Add approved staging directories to %global_allowed_script_dirs. Consider raising severity if the writing process is a browser, document viewer, or email client."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match VBScript and related script file extensions
    $file.target.file.full_path = /\.(vbs|vbe|wsf|wsc|hta)$/ nocase

    // Suspicious locations: user temp, AppData, ProgramData, root of drive,
    // Downloads, Public, and Windows Temp — all commonly abused staging paths
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\AppData\\(Local|Roaming|LocalLow)\\|\\Users\\[^\\]+\\Downloads\\|\\Users\\[^\\]+\\Desktop\\|\\Users\\Public\\|\\ProgramData\\|\\Windows\\Temp\\|\\Temp\\|%TEMP%|[A-Za-z]:\\[^\\]+\.(vbs|vbe|wsf|wsc|hta)$)/ nocase

    // Exclude known-good writer processes via reference list
    not $file.principal.process.file.full_path in %global_allowed_vbs_writers

    // Exclude SYSVOL and Group Policy script paths to reduce GPO false positives
    not $file.target.file.full_path = /\\sysvol\\/i nocase
    not $file.target.file.full_path = /\\PolicyDefinitions\\/i nocase
    not $file.target.file.full_path = /\\GroupPolicy\\/i nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
