/*
  MITRE Technique : T1684.002 - Email Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:50:39.992290+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_002_Email_Header_Spoofing_Sendmail_Config {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes invoking local mail transfer agents (sendmail, postfix, exim, msmtp, swaks) with command-line arguments that directly inject or override email headers such as From, Reply-To, or Sender. Adversaries abuse these flags to spoof sender identity and bypass casual inspection, particularly when DMARC/SPF/DKIM enforcement is absent or weak."
    mitre_tactic    = "Stealth"
    mitre_technique = "T1684.002"
    mitre_technique_name = "Email Spoofing"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with full command-line capture (execve syscall arguments). Auditd rule: -a always,exit -F arch=b64 -S execve."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate bulk-mail scripts, monitoring alert systems, or application notification services that set a custom From address. Cron-driven system notification mailers may also trigger this rule."
    tuning_guidance = "Add known-good parent processes (e.g., monitoring daemons, CI/CD agents) to %global_allowed_script_hosts. Scope by principal.user.userid using %global_allowed_service_accounts for authorised notification accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match common Linux MTA and mail-sending binaries by path pattern
    $proc.target.process.file.full_path = /\/(sendmail|postfix|exim|exim4|msmtp|swaks|mutt|mailx|mail|ssmtp)(\.bin)?$/ nocase

    // Detect header injection via command-line flags that set or override envelope/header fields.
    // Covers: sendmail -f (envelope-from), swaks --from/--header, msmtp --from,
    //         mutt/mailx -e 'set from=', and raw header injection via -a "From:" or --add-header
    $proc.target.process.command_line = /(\s|^)(-f\s*\S+@\S+|--from[=\s]\S+@\S+|--header[=\s]["']?From:|--add-header[=\s]["']?From:|--h-From:|--sender[=\s]\S+@\S+|-a\s+"?From:|-F\s+["']?[^"'\s]+\s+<\S+@\S+>)/

    // Exclude approved script hosts and automation accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1684.002")
    $primary_entity    = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
