/*
  MITRE Technique : T1673 - Virtual Machine Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:47:50.910250+00:00
  Reference       : https://attack.mitre.org/techniques/T1673
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1673_ESXi_VM_Enumeration_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects execution of ESXi commands used to enumerate virtual machines on a hypervisor, often preceding ransomware or destructive attacks."
    mitre_tactic = "Discovery"
    mitre_technique = "T1673"
    mitre_technique_name = "Virtual Machine Discovery"
    log_prerequisites = "Requires ESXi shell command logging (hostd, vmkernel, or SSH session logs)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorized hypervisor administrators performing routine VM inventory, backup software querying VM lists, monitoring and orchestration tools, vCenter automated tasks."
    tuning_guidance = "Add authorized management hosts to %global_allowed_mgmt_sources or service accounts to %global_allowed_service_accounts. Exclude known backup and monitoring principals."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /esxcli\s+vm\s+process\s+list/ nocase or
      $proc.target.process.command_line = /vim-cmd\s+vmsvc\/getallvms/ nocase or
      $proc.target.process.command_line = /vim-cmd\s+vmsvc\/get\.summary/ nocase or
      $proc.target.process.command_line = /esxcli\s+vm\s+process\s+kill/ nocase or
      $proc.target.process.command_line = /vim-cmd\s+solo\/registervm/ nocase or
      $proc.target.process.command_line = /vim-cmd\s+vmsvc\/power\.getstate/ nocase or
      $proc.target.process.command_line = /vim-cmd\s+vmsvc\/getallvms\s+\|/ nocase or
      $proc.target.process.command_line = /esxcli\s+--formatter=csv\s+vm\s+process\s+list/ nocase
    )
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1673")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
