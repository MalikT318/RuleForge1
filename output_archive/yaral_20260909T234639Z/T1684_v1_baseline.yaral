/*
  MITRE Technique : T1684 - Social Engineering
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:50:04.474897+00:00
  Reference       : https://attack.mitre.org/techniques/T1684
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_Suspicious_MFA_Modification_After_Password_Reset {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects MFA method modification or removal shortly after a password reset, indicating potential social engineering compromise of user credentials."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684"
    mitre_technique_name = "Social Engineering"
    log_prerequisites = "Requires identity provider audit logs capturing authentication method changes and password resets."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate user self-service password reset followed by MFA re-enrollment; help desk assisted account recovery; new employee onboarding workflows."
    tuning_guidance = "Add authorized help desk service accounts to %global_allowed_service_accounts. Exclude known onboarding automation principals to %global_allowed_cloud_principals."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    (
      $auth.target.resource.attribute.labels.key = /(?i)mfa/ or
      $auth.target.resource.attribute.labels.key = /(?i)multi.?factor/ or
      $auth.target.resource.attribute.labels.key = /(?i)authentication.?method/ or
      $auth.target.resource.attribute.labels.key = /(?i)phone.?number/ or
      $auth.target.resource.attribute.labels.key = /(?i)authenticator/ or
      $auth.security_result.summary = /(?i)mfa/ or
      $auth.security_result.summary = /(?i)multi.?factor/ or
      $auth.security_result.summary = /(?i)authentication.?method/
    )
    (
      $auth.security_result.summary = /(?i)(remov|delet|disabl|reset|modif|chang|updat)/ or
      $auth.target.resource.attribute.labels.value = /(?i)(remov|delet|disabl|none|null)/
    )
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1684")
    $primary_entity = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
