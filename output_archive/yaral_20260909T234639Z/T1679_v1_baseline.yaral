/*
  MITRE Technique : T1679 - Selective Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:49:27.386319+00:00
  Reference       : https://attack.mitre.org/techniques/T1679
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1679_001_Ransomware_Selective_Exclusion_Patterns {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects process command lines that enumerate or iterate over files while explicitly skipping known system-critical extensions (.dll, .exe, .lnk, .sys, .ini, etc.) - a hallmark of ransomware selective exclusion logic executed via scripting hosts or native binaries. Adversaries avoid encrypting these extensions to keep the system operational and deliver ransom notices."
    mitre_tactic = "Stealth"
    mitre_technique = "T1679"
    mitre_technique_name = "Selective Exclusion"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture, or Sysmon Event ID 1. Command-line logging must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup software, archiving utilities, and file-sync agents that legitimately skip system files. Authorized IT scripts performing selective file operations. Antivirus remediation tooling."
    tuning_guidance = "Add known backup and archiving parent process paths to %global_allowed_backup_processes. Add authorized script-running hosts to %global_allowed_script_hosts. Narrow the extension exclusion regex if specific extensions cause noise in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting hosts and native file-iteration binaries commonly abused
    // to implement selective exclusion loops in ransomware droppers/scripts
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|wmic)\.exe$/ nocase

    // Command line must reference multiple system-critical extensions being
    // explicitly excluded or filtered - the combination of several skip-patterns
    // in a single command is the high-fidelity signal
    $proc.target.process.command_line = /(?i)(\.dll|\.exe|\.sys|\.lnk|\.ini|\.msi|\.bat|\.com|\.drv)/ nocase
    $proc.target.process.command_line = /(?i)(-exclude|-skip|notlike|notmatch|-ne\s+|where.*-not|if.*not.*ext|extension.*-ne)/ nocase

    // Exclude known-good administrative and backup tooling parents
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1679")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
