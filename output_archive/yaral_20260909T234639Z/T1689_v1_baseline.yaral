/*
  MITRE Technique : T1689 - Downgrade Attack
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:51:11.264533+00:00
  Reference       : https://attack.mitre.org/techniques/T1689
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1689_PowerShell_Version_Downgrade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PowerShell execution with explicit version downgrade flags to evade Script Block Logging and other security features introduced in PowerShell v5+."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1689"
    mitre_technique_name = "Downgrade Attack"
    log_prerequisites = "Requires EDR process telemetry or Windows Event 4688 with command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy automation scripts requiring PowerShell v2 for compatibility with older modules; software deployment tools testing multi-version compatibility; authorized penetration testing."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_script_hosts. Review scripts using -Version flag for legitimate business justification."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    (
      $proc.target.process.command_line = /(?i)\s-version\s+[1-4](\s|$|\.)/ or
      $proc.target.process.command_line = /(?i)\s-v\s+[1-4](\s|$|\.)/ or
      $proc.target.process.command_line = /(?i)\s-ver\s+[1-4](\s|$|\.)/
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1689")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
