/*
  MITRE Technique : T1675 - ESXi Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:48:31.306963+00:00
  Reference       : https://attack.mitre.org/techniques/T1675
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1675_ESXi_GuestOps_API_Execution {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects ESXi hostd log entries indicating use of vSphere Guest Operations APIs (StartProgramInGuest, ListProcessesInGuest, ListFileInGuest, InitiateFileTransferFromGuest) to execute commands or enumerate files inside guest VMs. Adversaries abuse these APIs via the vSphere Web Services SDK to run processes, harvest credentials, or exfiltrate data from guest operating systems without touching the guest network stack."
    mitre_tactic    = "Execution"
    mitre_technique = "T1675"
    mitre_technique_name = "ESXi Administration Command"
    log_prerequisites = "Requires VMware ESXi hostd verbose/info logging forwarded to Chronicle via syslog or the VMware ESXi log source. The hostd daemon logs Guest Operations API calls at info level when verbose guest-ops logging is enabled."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Legitimate VMware Tools-based management by vCenter orchestration, backup agents (Veeam, Commvault, Veritas), and configuration management platforms that use Guest Operations APIs for health checks or patching."
    tuning_guidance = "Add authorised management service account identifiers to %global_allowed_service_accounts and approved source hosts to %global_allowed_mgmt_sources. Narrow the match to specific guest VM names or datastores if the environment has a well-defined management boundary."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // hostd normalises Guest Operations API invocations as process launches
    // where the initiating process is the hostd or vmx worker on the ESXi host.
    // Match the ESXi-side process paths that broker guest-ops requests.
    $proc.principal.process.file.full_path = /\/(bin|sbin|lib\/vmware|vmkctl)\// nocase

    // The target command line carries the Guest Operations API method name
    // as logged by hostd when it dispatches the call to the guest.
    $proc.target.process.command_line = /(?i)(StartProgramInGuest|ListProcessesInGuest|ListFileInGuest|InitiateFileTransferFromGuest|InitiateFileTransferToGuest)/

    // Exclude known-good automation and backup service accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved management source hosts (vCenter, jump hosts)
    not $proc.principal.hostname in %global_allowed_mgmt_sources

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1675")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $target_vm         = array_distinct($proc.target.hostname)
    $guest_ops_method  = array_distinct($proc.target.process.command_line)
    $initiating_user   = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
