/*
  MITRE Technique : T1684.001 - Impersonation
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:50:21.200326+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_001_BEC_Impersonation_Suspicious_Email_Patterns {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects inbound email transactions exhibiting business email compromise (BEC) impersonation indicators: high-urgency social engineering keywords in the subject combined with sender display-name spoofing patterns where the display name contains executive or authority terms but the sending domain does not match the organisation's expected internal domain. Targets T1684.001 impersonation via email."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.001"
    mitre_technique_name = "Impersonation"
    log_prerequisites = "Requires M365 unified audit logs normalised to UDM EMAIL_TRANSACTION events, including network.email.subject, network.email.from, and principal.user.email_addresses fields."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate external vendors or partners whose display names include executive titles; automated notification systems using urgency language; newsletters with payment or request terminology."
    tuning_guidance = "Add known-good external sender domains to %global_allowed_domains. Add approved service account senders to %global_allowed_service_accounts. Narrow subject regex to match organisation-specific BEC lure patterns observed in threat intelligence."

  events:
    $email.metadata.event_type = "EMAIL_TRANSACTION"

    // Urgency and BEC social-engineering keywords in subject line
    $email.network.email.subject = /(?i)(urgent|wire\s*transfer|payment\s*request|invoice\s*due|immediate\s*action|confidential\s*request|fund\s*transfer|account\s*update|verify\s*your|action\s*required|ceo\s*request|executive\s*request|direct\s*deposit\s*change)/ nocase

    // Sender display name contains executive or authority impersonation terms
    // while the actual sending address comes from an external (non-internal) domain
    $email.network.email.from = /(?i)(ceo|cfo|coo|president|director|vp\s|vice\s*president|chief\s*executive|chief\s*financial|chief\s*operating|controller|treasurer|payroll|finance\s*team|accounts\s*payable)/

    // Exclude known-good external domains to reduce noise from legitimate partners
    not $email.network.email.from in %global_allowed_domains

    // Exclude approved service account senders
    not $email.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1684.001")
    $primary_entity = array_distinct($email.network.email.to)
    $sender_address = array_distinct($email.network.email.from)
    $email_subject = array_distinct($email.network.email.subject)

  condition:
    $email
}
