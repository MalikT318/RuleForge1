/*
  MITRE Technique : T1674 - Input Injection
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:48:13.883323+00:00
  Reference       : https://attack.mitre.org/techniques/T1674
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1674_001_Input_Injection_Suspicious_Shell_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects input injection attacks where adversary tooling or a HID device simulates keystrokes to launch a shell interpreter (cmd, powershell, pwsh, wscript, cscript, mshta) from an unusual or interactive parent process. This covers both software-based keystroke injection (e.g., SendInput/SendMessage abuse) and USB HID emulation attacks where the device types commands that open a shell. The detection focuses on the resulting process lineage: a shell spawned by a process that is not a known legitimate parent, combined with command-line patterns indicative of download-and-execute or encoded payloads."
    mitre_tactic = "Execution"
    mitre_technique = "T1674"
    mitre_technique_name = "Input Injection"
    log_prerequisites = "Requires EDR process telemetry with parent-child process lineage and full command-line capture (Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, or equivalent UDM PROCESS_LAUNCH events)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate automation tools (AutoHotkey, AutoIt) used by IT teams, RMM agents launching shells for scripted remediation, software installers spawning PowerShell, accessibility software simulating input."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools and known-good script hosts to %global_allowed_script_hosts. Narrow the rule further by requiring both an unusual parent AND an encoded/download command-line pattern if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target: a shell or script interpreter being launched
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase

    // Parent is NOT a known legitimate shell-spawning process
    // Covers: explorer, RunDLL32, userinit, winlogon, services, svchost, taskeng, taskhostw
    // Suspicious parents include: browser processes, Office apps, media players, USB HID emulators
    not $proc.principal.process.file.full_path = /\\(explorer|userinit|winlogon|services|svchost|taskeng|taskhostw|conhost|wininit|smss|csrss|lsass|RuntimeBroker|sihost|SearchHost|StartMenuExperienceHost|ShellExperienceHost)\.exe$/ nocase

    // Command line must carry a payload indicator: encoded command, download cradle,
    // clipboard paste execution, or inline script - the hallmarks of injected keystrokes
    $proc.target.process.command_line = /(-enc|-encodedcommand|-e\s+[A-Za-z0-9+\/]{20,}|iex|invoke-expression|downloadstring|downloadfile|webclient|bitstransfer|certutil|bitsadmin|mshta\s+http|vbscript:|javascript:)/  nocase

    // Exclude approved administrative and script-host tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1674")
    $primary_entity = array_distinct($proc.principal.hostname)
    $spawned_shell = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $injected_cmdline = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
