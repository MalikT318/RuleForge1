/*
  MITRE Technique : T1677 - Poisoned Pipeline Execution
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:48:48.212694+00:00
  Reference       : https://attack.mitre.org/techniques/T1677
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1677_001_Poisoned_Pipeline_CI_Config_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of CI/CD pipeline configuration files (e.g., .gitlab-ci.yml, .github/workflows/*.yml, Jenkinsfile, .circleci/config.yml) via cloud audit logs. Adversaries modify these files to inject malicious build steps that exfiltrate secrets, install backdoors, or pivot through the build environment. Covers direct pipeline poisoning where the attacker has write access to the repository or pipeline configuration."
    mitre_tactic    = "Execution"
    mitre_technique = "T1677"
    mitre_technique_name = "Poisoned Pipeline Execution"
    log_prerequisites = "Requires cloud control plane audit logs capturing repository or pipeline resource update events, including the resource name or path of the modified object. Source control platform audit logs (e.g., GitHub Audit Log, GitLab Audit Events, Bitbucket Audit) forwarded to Chronicle via the cloud_audit ingestion path."
    platform        = "SaaS"
    log_source      = "cloud_audit"
    false_positives = "Legitimate DevOps engineers updating pipeline configuration as part of normal development workflows. Automated dependency update bots (e.g., Dependabot, Renovate) that modify workflow files. Release engineering teams performing scheduled pipeline maintenance."
    tuning_guidance = "Add known automation service accounts (Dependabot, Renovate, release bots) to %global_allowed_service_accounts. Add approved CI/CD administrators to %global_allowed_admin_users. Consider narrowing to modifications made outside business hours or from unexpected source IPs to reduce volume."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"

    // Match modifications to common CI/CD pipeline configuration files
    // Covers: GitHub Actions, GitLab CI, Jenkins, CircleCI, Azure Pipelines, Bitbucket Pipelines, Travis CI
    $cloud.target.resource.name = /(?i)(\.github[\/\\]workflows[\/\\][^\/\\]+\.ya?ml|\.gitlab-ci\.ya?ml|Jenkinsfile[^\/\\]*|\.circleci[\/\\]config\.ya?ml|azure-pipelines\.ya?ml|bitbucket-pipelines\.ya?ml|\.travis\.ya?ml|\.drone\.ya?ml|\.buildkite[\/\\]pipeline\.ya?ml|Makefile|\.github[\/\\]workflows)/

    // Exclude known-good automation service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good CI/CD administrators
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1677")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $modified_resource = array_distinct($cloud.target.resource.name)
    $actor_ip          = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
