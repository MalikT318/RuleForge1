/*
  MITRE Technique : T1678 - Delay Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:49:09.325767+00:00
  Reference       : https://attack.mitre.org/techniques/T1678
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1678_001_Delay_Execution_Ping_Loop_Or_Sleep {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects common delay-execution patterns on Windows: ping used as a sleep substitute with high repeat counts, PowerShell Start-Sleep with long durations, cmd timeout, and waitfor - all techniques adversaries use to stall execution, evade sandbox time-outs, or pace C2 activity."
    mitre_tactic    = "Stealth"
    mitre_technique = "T1678"
    mitre_technique_name = "Delay Execution"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with command_line populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Network diagnostic scripts using ping with high counts; legitimate PowerShell automation using Start-Sleep; build/CI pipelines using timeout or waitfor for synchronisation."
    tuning_guidance = "Add known-good parent processes (deployment agents, CI runners, RMM tools) to %global_allowed_admin_tools. Raise the ping count threshold or sleep duration threshold to reduce noise from diagnostic scripts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // --- Pattern 1: ping used as a delay primitive (high repeat count) ---
    // ping -n <large_number> 127.0.0.1  or  ping /n <large_number> 127.0.0.1
    // Threshold of 20+ iterations is well above normal diagnostic use
    (
      $proc.target.process.file.full_path = /(?i)\\ping\.exe$/ and
      $proc.target.process.command_line = /(?i)[\-\/]n\s+([2-9][0-9]|[1-9][0-9]{2,})\b/
    )
    or
    // --- Pattern 2: PowerShell Start-Sleep with a meaningful duration ---
    // Catches: Start-Sleep -Seconds N  |  Start-Sleep -s N  |  Start-Sleep N
    // Duration >= 10 seconds to avoid false-positives from short waits
    (
      $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh)\.exe$/ and
      $proc.target.process.command_line = /(?i)start[\-\s]sleep/ and
      $proc.target.process.command_line = /(?i)[\-]?(seconds?|s)\s+([1-9][0-9]{1,}|[2-9][0-9])\b/
    )
    or
    // --- Pattern 3: cmd.exe timeout used as a delay primitive ---
    // timeout /t <N> [/nobreak]  - adversaries use this to stall batch scripts
    (
      $proc.target.process.file.full_path = /(?i)\\timeout\.exe$/ and
      $proc.target.process.command_line = /(?i)\/t\s+([1-9][0-9]+)\b/
    )
    or
    // --- Pattern 4: waitfor with a delay flag ---
    // waitfor /t <seconds> <signal>  - rarely used legitimately; common in malware loaders
    (
      $proc.target.process.file.full_path = /(?i)\\waitfor\.exe$/ and
      $proc.target.process.command_line = /(?i)\/t\s+\d+/
    )

    // Exclude known-good administrative and deployment tooling as parent
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1678")
    $primary_entity    = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
