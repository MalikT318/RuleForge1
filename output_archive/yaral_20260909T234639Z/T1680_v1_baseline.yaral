/*
  MITRE Technique : T1680 - Local Storage Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:49:47.456386+00:00
  Reference       : https://attack.mitre.org/techniques/T1680
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1680_001_ESXi_Storage_Discovery_Via_CLI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects adversaries enumerating local storage on ESXi hosts using hypervisor CLI commands such as esxcli or vmkfstools to list datastores, volumes, and VMDK files. This activity is a common precursor to ransomware encryption or lateral movement on ESXi infrastructure."
    mitre_tactic = "Discovery"
    mitre_technique = "T1680"
    mitre_technique_name = "Local Storage Discovery"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry ingested into Chronicle UDM as PROCESS_LAUNCH events. Enable ESXi shell logging and forward hostd/shell logs to Chronicle."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorized VMware administrators performing routine storage audits, capacity planning scripts, backup agents enumerating datastores, monitoring tools polling storage health."
    tuning_guidance = "Add authorized admin accounts performing routine storage enumeration to %global_allowed_admin_users. Add approved automation or backup service accounts to %global_allowed_service_accounts. Add approved management hosts to %global_allowed_mgmt_sources."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target known ESXi storage enumeration binaries
    $proc.target.process.file.full_path = /\/(esxcli|vmkfstools|esxcfg-scsidevs|esxcfg-mpath|vmware-cmd|vim-cmd)$/ nocase

    // Match storage/volume/datastore discovery subcommands and flags
    (
      // esxcli storage enumeration patterns
      $proc.target.process.command_line = /storage\s+(core|nmp|san|vmfs|filesystem)/ nocase
      or
      // esxcli storage list/get operations
      $proc.target.process.command_line = /\s+(list|get|info)\b/ nocase
      or
      // vmkfstools volume/VMDK inspection
      $proc.target.process.command_line = /(-P|-v\s*[0-9]|--diskinfo|--querygeometry)/ nocase
      or
      // esxcfg-scsidevs device listing
      $proc.target.process.command_line = /(-l|-m|-c|-a)/ nocase
      or
      // vim-cmd vmsvc datastore/volume listing
      $proc.target.process.command_line = /vmsvc\/(get\.datastores|get\.disks|get\.config)/ nocase
      or
      // VMDK file discovery via find-style patterns
      $proc.target.process.command_line = /\.vmdk/ nocase
    )

    // Exclude approved backup processes
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude approved admin tools (RMM, deployment, patching)
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known authorized admin users performing routine operations
    not $proc.principal.user.userid in %global_allowed_admin_users

    // Exclude approved service/automation accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1680")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggered_command = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)
    $storage_binary = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
