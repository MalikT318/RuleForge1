/*
  MITRE Technique : T1690 - Prevent Command History Logging
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:51:32.202945+00:00
  Reference       : https://attack.mitre.org/techniques/T1690
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1690_001_Prevent_Command_History_Logging_Windows {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects attempts to suppress PowerShell or cmd command history logging on Windows. Adversaries may set PSReadLine history save style to None, clear the history file, or manipulate environment variables to prevent command history from being recorded."
    mitre_tactic    = "Defense Impairment"
    mitre_technique = "T1690"
    mitre_technique_name = "Prevent Command History Logging"
    log_prerequisites = "Requires EDR process telemetry (Sysmon Event ID 1 or equivalent) or PowerShell script-block logging (Event ID 4104). UDM event type: PROCESS_LAUNCH."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "Security tooling that audits or resets PowerShell profiles; developer environment setup scripts; IT provisioning automation that configures shell environments."
    tuning_guidance = "Add known provisioning or automation parent processes to %global_allowed_script_hosts. Narrow the rule by requiring the command to originate outside business hours if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target PowerShell or cmd as the interpreter
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd)\.exe$/ nocase

    // Match the family of command-line patterns that suppress history logging:
    // 1. PSReadLine: Set-PSReadLineOption -HistorySaveStyle SaveNothing
    // 2. Clearing or nullifying the PSReadLine history file path
    // 3. Removing or zeroing HISTFILESIZE / HISTSIZE via [System.Environment]::SetEnvironmentVariable
    // 4. Deleting the ConsoleHost_history.txt file via Remove-Item / del / erase
    // 5. Setting $null or empty string to $env:HISTFILE
    $proc.target.process.command_line = /HistorySaveStyle\s+SaveNothing|Set-PSReadLine.*SaveNothing|PSReadLine.*HistorySave|Remove-Item.*ConsoleHost_history|del\s+.*ConsoleHost_history|erase\s+.*ConsoleHost_history|SetEnvironmentVariable.*HISTFILESIZE.*0|SetEnvironmentVariable.*HISTSIZE.*0|env:HISTFILE\s*=\s*['"]{0,1}\s*['"]{0,1}$|Clear-History\s+-CommandLine|Add-Content.*HISTFILE.*\/dev\/null/ nocase

    // Exclude known-good script hosts and automation accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(65)
    $mitre_technique_id = array_distinct("T1690")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_user     = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
