/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:34:44.191626+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Browser_CredStore_FileRead {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-browser process opening or reading browser credential store files (Login Data, key4.db, logins.json, Cookies, Web Data) at the file-read/open abstraction layer. Attackers that dump browser credentials must access these files regardless of how they invoke the extraction logic, making this a harder-to-evade signal than command-line matching."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Password Stores: Credentials from Web Browsers"
    log_prerequisites = "Requires EDR file-read telemetry (e.g., CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon Event ID 11/23 mapped to FILE_READ or PROCESS_OPEN). Principal process path must be populated."
    platform = "Linux, macOS, Windows"
    false_positives = "Browser sync agents, backup software, AV/EDR scanning, password managers with legitimate browser integration, OS credential migration utilities."
    tuning_guidance = "Add legitimate backup, AV, or sync process paths to %browser_credstore_allowed_readers. Scope further by adding known-good parent process paths. On macOS, exclude com.apple.* and legitimate Keychain helpers."

  events:
    $open.metadata.event_type = "FILE_READ"

    // Target must be a known browser credential store file across Windows, macOS, Linux
    // Windows Chrome/Edge: Login Data, Cookies, Web Data
    // Firefox: key4.db, logins.json, signons.sqlite
    // macOS/Linux paths included via wildcard username segment
    $open.target.file.full_path = /[\/\\](Login Data|key4\.db|logins\.json|signons\.sqlite|Web Data|Cookies)$/ nocase

    // Restrict to paths that are inside a browser profile directory
    $open.target.file.full_path = /[\/\\](Google[\/\\]Chrome|Microsoft[\/\\]Edge|BraveSoftware|Mozilla[\/\\]Firefox|Chromium|Opera|Vivaldi|Yandex|LibreWolf|Waterfox)[\/\\]/ nocase

    // The reading process must NOT be a legitimate browser executable
    not $open.principal.process.file.full_path = /[\/\\](chrome|msedge|firefox|brave|opera|vivaldi|chromium|safari|waterfox|librewolf|iexplore)\.exe$/ nocase

    // Exclude known-good system and security tooling via reference list
    not $open.principal.process.file.full_path in %browser_credstore_allowed_readers

    // Exclude OS-level paths that legitimately touch these files (e.g., Windows Search indexer)
    not $open.principal.process.file.full_path = /[\/\\](SearchIndexer|SearchProtocolHost|MsMpEng|SgrmBroker|WerFault|dllhost)\.exe$/ nocase

    // Require a principal process to be present (filter noise from kernel/system events)
    $open.principal.process.file.full_path != ""

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($open.principal.hostname)
    $accessing_process = array_distinct($open.principal.process.file.full_path)
    $credential_file_accessed = array_distinct($open.target.file.full_path)
    $actor_userid = array_distinct($open.principal.user.userid)

  condition:
    $open
}
