/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:27:26.436336+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_CredDump_SensitiveFileRead_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a process reading a sensitive credential store file (e.g. /etc/shadow, SAM hive, LSASS dump, keychains) followed by an outbound network connection from the same process on the same host within 10 minutes. This correlation targets the exfiltration phase of credential dumping rather than the dump command itself, providing additive coverage beyond process-launch detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires EDR file-read telemetry (e.g. CrowdStrike, SentinelOne, Sysmon EventID 11/15 mapped to FILE_READ) and network connection telemetry (NETWORK_CONNECTION). Both event types must be ingested into Chronicle with principal.hostname and principal.process.file.full_path populated."
    platform = "Linux, macOS, Windows"
    false_positives = "Backup agents reading shadow/SAM files for legitimate backup jobs; security scanners; AV products reading credential stores for inspection; SIEM/EDR agents themselves. Tune using %global_allowed_credential_readers and %global_allowed_backup_processes."
    tuning_guidance = "Add known backup agent paths and security tool paths to %global_allowed_credential_readers. Add trusted internal SIEM/backup destinations to %global_allowed_credential_exfil_destinations. Consider narrowing target.file.full_path regex if noise is high in a specific environment."

  events:
    // Leg 1: Process reads a sensitive credential store file
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /(\/(etc\/(shadow|gshadow|passwd|master\.passwd)|private\/var\/db\/dslocal|Library\/Keychains)|[Ss][Aa][Mm]$|[Ss][Yy][Ss][Tt][Ee][Mm]32\\[Cc][Oo][Nn][Ff][Ii][Gg]\\(SAM|SECURITY|SYSTEM)|lsass.*\.dmp|\.ntds|ntds\.dit)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_credential_readers
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $dumper_process

    // Leg 2: Same process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $dumper_process
    not $net.target.ip in %global_allowed_credential_exfil_destinations
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname

    // Chronological ordering: file read must precede network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $dumper_process over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($file.principal.hostname)
    $sensitive_files_read = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $dumping_process_path = array_distinct($file.principal.process.file.full_path)
    $actor_userid = array_distinct($file.principal.user.userid)

  condition:
    $file and $net
}
