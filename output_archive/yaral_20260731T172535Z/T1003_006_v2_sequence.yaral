/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:31:12.738692+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_NonDC_Replication_Then_Sensitive_Account_Auth {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects DCSync attack pattern: a non-domain-controller host generates a directory replication network connection to a DC (port 135/445/49152+ RPC) followed by a privileged account authentication event originating from the same host within 10 minutes. This targets the network-observable side of DCSync rather than process command-line, providing additive coverage to existing PROCESS_LAUNCH rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires network flow or firewall telemetry showing RPC/SMB connections to domain controllers, AND Windows Security Event 4624/4648 (logon events) or equivalent EDR authentication telemetry. DC hostnames must be populated in the %known_domain_controllers reference list."
    platform = "Windows"
    false_positives = "Legitimate domain controller replication traffic from secondary DCs, Azure AD Connect sync hosts, backup agents performing AD snapshots, privileged admin workstations with scheduled AD queries."
    tuning_guidance = "Populate %known_domain_controllers with all DC hostnames/IPs. Add AD Connect servers and authorised replication hosts to %global_allowed_replication_sources. Add service accounts that legitimately authenticate after AD queries to %global_allowed_dc_auth_accounts."

  events:
    // Event 1: Non-DC host makes an RPC/SMB connection toward a domain controller
    // DCSync uses MS-DRSR over RPC (port 135 for endpoint mapper, then dynamic high ports, or 445 for SMB transport)
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.hostname in %known_domain_controllers
    (
      $net.target.port = 135 or
      $net.target.port = 445 or
      ($net.target.port >= 49152 and $net.target.port <= 65535)
    )
    not $net.principal.hostname in %known_domain_controllers
    not $net.principal.hostname in %global_allowed_replication_sources
    $net.principal.hostname = $src_hostname

    // Event 2: A sensitive / privileged account authentication event from the same host
    // shortly after — indicative of credential material being used post-DCSync
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $src_hostname
    not $auth.principal.user.userid in %global_allowed_dc_auth_accounts
    (
      $auth.target.user.userid = /krbtgt/i nocase or
      $auth.target.user.userid = /administrator/i nocase or
      $auth.target.user.userid = /admin/i nocase or
      $auth.target.user.userid = /svc_/i nocase or
      $auth.target.user.userid = /service/ nocase
    )

    // Chronological ordering: network replication attempt precedes auth use
    $net.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $src_hostname over 10m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($src_hostname)
    $targeted_dc = array_distinct($net.target.hostname)
    $rpc_ports_observed = array_distinct($net.target.port)
    $sensitive_accounts_authed = array_distinct($auth.target.user.userid)
    $auth_count = count($auth.metadata.event_timestamp.seconds)

  condition:
    $net and $auth
}
