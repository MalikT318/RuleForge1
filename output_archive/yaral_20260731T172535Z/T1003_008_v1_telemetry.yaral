/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:32:05.786876+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_Passwd_File_Read_By_Untrusted_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process opening /etc/shadow or /etc/passwd for reading outside of expected system contexts. Attackers reading these files to dump credentials will produce a FILE_READ event regardless of which binary or shell alias they use, making this harder to evade than command-line matching alone."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires EDR file-read telemetry (e.g., Auditd with -a always,exit -F arch=b64 -S open,openat -F path=/etc/shadow, or an agent such as CrowdStrike/SentinelOne that emits FILE_READ UDM events for sensitive paths)."
    platform = "Linux"
    false_positives = "PAM subsystem, sssd, shadow-utils (chage, passwd, useradd), login, su, sudo, sshd, cron, nscd, systemd, and other legitimate authentication daemons routinely read these files. Tune via the reference lists below."
    tuning_guidance = "Add fully-qualified paths of legitimate readers to %linux_allowed_shadow_readers (e.g., /usr/bin/passwd, /sbin/nologin, /usr/sbin/sshd). Add service account userids to %linux_allowed_shadow_userids. Scope narrowly per customer to reduce noise from custom PAM modules."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target must be one of the two sensitive credential files
    $file.target.file.full_path = /^\/etc\/(shadow|passwd)$/ nocase

    // Exclude well-known legitimate system binaries that must read these files
    not $file.principal.process.file.full_path in %linux_allowed_shadow_readers

    // Exclude service accounts and system UIDs that legitimately access these files
    not $file.principal.user.userid in %linux_allowed_shadow_userids

    // Flag reads originating from interactive shells, scripting runtimes,
    // or utilities that have no business reading credential stores directly.
    // This regex matches common attacker-controlled execution contexts.
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|fish|python[23]?|perl[0-9.]*|ruby|lua[0-9.]*|php|node|cat|tee|cp|dd|rsync|nc|ncat|socat|curl|wget|unshadow|john|hashcat|awk|gawk|sed|strings|xxd|od|hexdump|base64|openssl)$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $reading_user = array_distinct($file.principal.user.userid)
    $sensitive_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
