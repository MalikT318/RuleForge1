/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:32:23.746345+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Passwd_Shadow_Read_Then_Exfil_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage credential staging attack on Linux: a process opens /etc/passwd or /etc/shadow for reading, followed by a file creation event on the same host that suggests the combined output is being written to a staging location (e.g. /tmp, /dev/shm, /var/tmp). This is additive to existing PROCESS_LAUNCH command-line rules and targets the file-access and output-staging behaviour rather than the invoking command."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires EDR file-read telemetry (e.g. Sysmon for Linux eid 11/15, auditd with -w /etc/shadow -p r, or a Chronicle-integrated EDR that emits FILE_READ events for /etc/passwd and /etc/shadow). Also requires FILE_CREATION telemetry for staging paths."
    platform = "Linux"
    false_positives = "Backup agents (e.g. Bacula, Amanda) that archive /etc/shadow to a staging area; configuration management tools (Ansible, Puppet) that read credential files during audits; legitimate unshadow invocations by authorised sysadmins performing password audits."
    tuning_guidance = "Add authorised backup and config-management process paths to %linux_allowed_credential_readers. Add approved staging directories to %linux_allowed_staging_paths. Scope by principal.user.userid to exclude root service accounts that legitimately read these files."

  events:
    // Stage 1: a process reads /etc/passwd or /etc/shadow
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /^\/(etc\/passwd|etc\/shadow)$/ nocase
    not $read.principal.process.file.full_path in %linux_allowed_credential_readers
    $read.principal.hostname = $hostname

    // Stage 2: a file is created in a world-writable or temporary staging path
    // on the same host shortly after, suggesting output capture
    $stage.metadata.event_type = "FILE_CREATION"
    $stage.target.file.full_path = /^\/(tmp|dev\/shm|var\/tmp|run\/shm)\// nocase
    not $stage.target.file.full_path in %linux_allowed_staging_paths
    $stage.principal.hostname = $hostname

    // Enforce chronological ordering: read must precede staging write
    $read.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($read.principal.hostname)
    $credential_files_read = array_distinct($read.target.file.full_path)
    $staging_files_created = array_distinct($stage.target.file.full_path)
    $reading_processes = array_distinct($read.principal.process.file.full_path)
    $staging_processes = array_distinct($stage.principal.process.file.full_path)
    $acting_user = array_distinct($read.principal.user.userid)

  condition:
    $read and $stage
}
