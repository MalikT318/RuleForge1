/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:33:43.510961+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Keychain_File_Read_Then_Exfil_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-system process reading macOS Keychain database files followed by an outbound network connection from the same process on the same host within 10 minutes. This correlation targets the post-exploitation pattern of reading Keychain credential stores and immediately staging or exfiltrating the data, providing additive coverage beyond command-line detection of the security utility."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "Requires macOS EDR file-read telemetry (e.g., Jamf Protect, CrowdStrike Falcon, or SentinelOne) and network connection telemetry from the same agent. FILE_READ events must include target.file.full_path and principal.process.file.full_path."
    platform = "macOS"
    false_positives = "Backup agents (Time Machine, Backblaze) reading Keychain files as part of a full-disk backup. Password manager applications performing legitimate Keychain reads. Apple iCloud sync daemon syncing Local Items Keychain. Security audit tooling run by IT administrators."
    tuning_guidance = "Add known backup agent and password manager binary paths to %macos_allowed_keychain_readers. Add approved internal backup destinations to %macos_allowed_backup_destinations. Scope further by requiring the reading process to be outside /Applications or /System/Library."

  events:
    // Leg 1: A process reads a Keychain database file
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/(Library\/Keychains\/|Network\/Library\/Keychains\/).*\.(keychain|keychain-db)$/ nocase
    // Exclude known macOS system daemons that legitimately access Keychain
    not $file.principal.process.file.full_path = /\/(System\/Library|usr\/libexec)\// nocase
    not $file.principal.process.file.full_path in %macos_allowed_keychain_readers
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $reading_process

    // Leg 2: The same process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $reading_process
    // Exclude RFC-1918 and loopback to focus on external exfiltration
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip = /^127\.|^::1$/ nocase
    not $net.principal.process.file.full_path in %macos_allowed_keychain_readers
    $net.principal.hostname = $hostname

    // Enforce chronological ordering: file read precedes network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $reading_process over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $keychain_files_accessed = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $offending_process = array_distinct($reading_process)

  condition:
    $file and $net
}
