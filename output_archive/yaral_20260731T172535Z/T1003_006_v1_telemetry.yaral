/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:30:54.392868+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_DRSUAPI_Module_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects loading of the DRSUAPI or SAMLIB DLL modules by non-DC processes outside of expected system paths. DCSync abuses the Directory Replication Service (DRS) remote protocol; the DRSUAPI and SAMLIB libraries are loaded into the attacking process at runtime to invoke GetNCChanges. Detecting the module load provides coverage orthogonal to command-line inspection and fires even when process arguments are obfuscated or stripped."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires EDR module-load (image-load) telemetry, e.g. Sysmon Event ID 7, CrowdStrike module load events, or Microsoft Defender for Endpoint DeviceImageLoadEvents ingested into Chronicle as PROCESS_MODULE_LOAD events."
    platform = "Windows"
    false_positives = "Legitimate AD management tools (ADExplorer, LDP.exe, dsquery, Active Directory Users and Computers MMC snap-in), backup agents that replicate AD data (Veeam, Quest Recovery Manager), Azure AD Connect sync service, and domain controller OS processes themselves. Tune using the reference lists below."
    tuning_guidance = "Populate %global_allowed_drsuapi_loaders with full paths of approved AD management and backup binaries (e.g. /windows/system32/lsass.exe, /windows/system32/svchost.exe, AD Connect paths). Populate %global_dc_hostnames with known domain controller hostnames to suppress DC-to-DC replication noise. Raise severity threshold if the loading process is outside system32 or SysWOW64."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"

    // Target the DRS replication and legacy SAM libraries used by DCSync
    (
      $mod.target.process.file.full_path = /\\drsuapi\.dll$/  nocase or
      $mod.target.process.file.full_path = /\\samlib\.dll$/   nocase or
      $mod.target.process.file.full_path = /\\ntdsapi\.dll$/  nocase
    )

    // The loading (principal) process must NOT be a known-good system binary
    not $mod.principal.process.file.full_path in %global_allowed_drsuapi_loaders

    // Suppress events originating from domain controllers themselves
    not $mod.principal.hostname in %global_dc_hostnames

    // Flag loads from outside canonical Windows system directories —
    // legitimate callers live in system32 or SysWOW64; attacker tooling rarely does
    not $mod.principal.process.file.full_path = /\\windows\\system32\\/   nocase
    not $mod.principal.process.file.full_path = /\\windows\\syswow64\\/   nocase
    not $mod.principal.process.file.full_path = /\\windows\\sysnative\\/  nocase

    // Exclude Microsoft-signed AD management MMC and DS tools that legitimately
    // call these libraries from their own install paths
    not $mod.principal.process.file.full_path = /\\microsoft\s+azure\s+ad\s+sync\\/  nocase
    not $mod.principal.process.file.full_path = /\\program\s+files\\microsoft\\/      nocase

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $loaded_module = array_distinct($mod.target.process.file.full_path)
    $affected_user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
