/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:26:10.633623+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Local_Account_Auth_Then_Sensitive_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a local account (non-domain) interactive or remote login followed by access to a sensitive resource (e.g. credential store, shadow file, SAM hive, or admin share) within 1 hour. This pattern is consistent with adversaries abusing local accounts for persistence, privilege escalation, or lateral movement after obtaining credentials. Complements existing process-launch command-line detections for T1078.003."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access, Defense Evasion"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires Windows Security Event Log (4624 for logon, 4663/4656 for object access) or EDR file-read telemetry mapped to UDM USER_LOGIN and FILE_READ. Linux PAM/auditd events mapped to USER_LOGIN and FILE_READ also satisfy this rule."
    platform = "Windows, Linux, macOS"
    false_positives = "Backup agents reading shadow/SAM files, authorized vulnerability scanners, IT admin scripts performing credential audits, password managers with local vault access."
    tuning_guidance = "Add known service accounts and backup agent usernames to %global_allowed_local_service_accounts. Add approved admin hostnames to %global_allowed_admin_hosts. Narrow the sensitive path regex if the rule fires on legitimate admin tooling."

  events:
    // Event 1: Local account login (non-domain, non-system, non-service)
    $auth.metadata.event_type = "USER_LOGIN"
    // Local accounts typically have no domain component or match the hostname as domain
    not $auth.target.user.userid = /\$$/  // exclude machine accounts
    not $auth.target.user.userid in %global_allowed_local_service_accounts
    not $auth.principal.hostname in %global_allowed_admin_hosts
    // Exclude well-known system/service SIDs and anonymous logons
    not $auth.target.user.userid = /^(SYSTEM|ANONYMOUS LOGON|LOCAL SERVICE|NETWORK SERVICE)$/ nocase
    // Logon type: interactive (2), remote interactive (10), network (3) - exclude batch/service (4,5)
    $auth.extensions.auth.auth_details = /type=(2|3|10)/ nocase
    $auth.principal.hostname = $hostname
    $auth.target.user.userid = $local_user

    // Event 2: Access to sensitive credential-related files after the login
    $file.metadata.event_type = "FILE_READ"
    $file.principal.user.userid = $local_user
    $file.principal.hostname = $hostname
    // Sensitive paths: Windows SAM/NTDS/SECURITY hives, Linux shadow/passwd, macOS keychain
    $file.target.file.full_path = /\\(SAM|NTDS\.dit|SECURITY|SYSTEM)$|\/etc\/(shadow|passwd|gshadow)|\/var\/db\/shadow|Library\/Keychains\/|\\admin\$\\|\\c\$\\/ nocase
    not $file.target.file.full_path in %global_allowed_credential_paths

    // Chronological ordering: login must precede file access
    $auth.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $local_user over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($auth.principal.hostname)
    $accessed_sensitive_paths = array_distinct($file.target.file.full_path)
    $logon_count = count($auth.metadata.event_timestamp.seconds)
    $sensitive_access_count = count($file.metadata.event_timestamp.seconds)
    $affected_user = array_distinct($local_user)

  condition:
    $auth and $file
}
