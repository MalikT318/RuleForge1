/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:33:24.432030+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Keychain_File_Read_By_Suspicious_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process opening or reading a macOS Keychain database file directly from disk. Adversaries may bypass the Keychain Services API and read the raw .keychain-db or .keychain file to extract credentials offline. This rule fires on the file-read artifact rather than the command line, providing coverage when process-creation logging is absent or evaded."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "Requires macOS EDR file-access telemetry (e.g., CrowdStrike Falcon, SentinelOne, or Jamf Protect) that emits FILE_READ events with principal.process.file.full_path and target.file.full_path populated."
    platform = "macOS"
    false_positives = "Keychain Access.app performing user-initiated browsing, iCloud Keychain sync daemons (bird, cloudd), macOS backup agents (Time Machine, backupd), legitimate password managers that use the Keychain API at the file layer, and MDM/security tooling performing inventory."
    tuning_guidance = "Add trusted process full paths to %macos_allowed_keychain_readers (e.g., /System/Library/PrivateFrameworks paths, approved password manager binaries). Add known backup or sync daemon paths to the same list. Narrow scope further by excluding events where principal.user.userid matches a dedicated service account list."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target must be a Keychain database file in any of the three canonical locations
    $file.target.file.full_path = /\/(Library\/Keychains\/|Network\/Library\/Keychains\/).+\.(keychain-db|keychain)$/ nocase

    // Exclude reads originating from known macOS system framework paths
    not $file.principal.process.file.full_path = /^\/(System\/Library|usr\/libexec|usr\/sbin|sbin)/ nocase

    // Exclude reads by the Keychain Access GUI application itself
    not $file.principal.process.file.full_path = /\/Keychain Access\.app\// nocase

    // Exclude known iCloud and backup daemons by path pattern
    not $file.principal.process.file.full_path = /\/(bird|cloudd|backupd|nsurlsessiond|akd)$/ nocase

    // MSSP multi-tenant exclusion: customer-specific trusted readers
    not $file.principal.process.file.full_path in %macos_allowed_keychain_readers

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $keychain_file_accessed = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
