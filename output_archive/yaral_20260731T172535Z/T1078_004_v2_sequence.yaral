/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:26:45.642778+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_Cloud_Account_Login_Then_Privilege_Escalation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud account login from an unfamiliar or anomalous context followed by a privilege escalation action (role/permission grant) within the same hour. This pattern is consistent with an adversary using a compromised cloud account to establish persistence or escalate privileges after initial access."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires cloud identity provider or SaaS audit logs ingested into Chronicle UDM. Covers Google Workspace Admin, Azure AD Sign-In + Audit, AWS CloudTrail, and Okta logs normalized to UDM USER_LOGIN and USER_CHANGE_PERMISSIONS event types."
    platform = "IaaS, Identity Provider, Office Suite, SaaS"
    false_positives = "Legitimate IT administrators granting permissions after authenticating. Automated provisioning pipelines that authenticate and then assign roles. Onboarding workflows for new privileged users."
    tuning_guidance = "Add known provisioning service accounts to %cloud_privileged_provisioning_accounts. Add known admin workstation hostnames or source IPs (via reference list) to reduce noise from authorized admin sessions. Narrow the match window if false-positive volume is high."

  events:
    // Leg 1: Cloud account login event - filter narrowly to avoid high-volume join
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid != ""
    // Exclude known automated provisioning accounts
    not $auth.target.user.userid in %cloud_privileged_provisioning_accounts
    // Exclude known internal service account patterns (e.g. svc-, sa-, bot-)
    not $auth.target.user.userid = /^(svc[-_]|sa[-_]|bot[-_]|service[-_])/ nocase
    // Capture the user as the join key
    $auth.target.user.userid = $cloud_userid

    // Leg 2: Privilege escalation action - role or permission grant on the same user context
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $priv.principal.user.userid != ""
    // The actor performing the privilege change is the same account that just logged in
    // (self-escalation pattern, or the session is being used to escalate another account)
    $priv.principal.user.userid = $cloud_userid
    not $priv.principal.user.userid in %cloud_privileged_provisioning_accounts
    // Exclude known break-glass or emergency-access accounts
    not $priv.principal.user.userid in %cloud_breakglass_accounts

    // Chronological ordering: login must precede the permission change
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $cloud_userid over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($cloud_userid)
    $login_event_count = count($auth.metadata.id)
    $permission_change_targets = array_distinct($priv.target.user.userid)
    $permission_change_actions = array_distinct($priv.target.resource.name)
    $source_hostnames = array_distinct($auth.principal.hostname)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth and $priv
}
