/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:30:30.797186+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_CachedCreds_RegRead_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process reading the LSA cached-credentials registry hive (HKLM\\SECURITY\\Cache) followed by an outbound network connection from the same process on the same host within 10 minutes. This pattern is consistent with tools that extract DCC2 hashes and exfiltrate or transmit them, without relying on command-line string matching."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires Windows Security Event 4663 (object access auditing on HKLM\\SECURITY\\Cache) or EDR registry-read telemetry mapped to FILE_READ / REGISTRY_MODIFICATION UDM events, plus EDR network telemetry (NETWORK_CONNECTION). Registry object access auditing must be enabled on the SECURITY hive."
    platform = "Windows"
    false_positives = "Domain-joined backup agents that read the SECURITY hive for inventory purposes; some AV/EDR products performing self-inspection; Microsoft LAPS or identity management tooling. Validate by correlating the connecting process with known-good software."
    tuning_guidance = "Add trusted security or backup agent full paths to %global_allowed_security_readers. Add known-good internal destinations to %rfc1918_internal to suppress internal pivots. Raise severity to Critical if the destination IP is external."

  events:
    // Leg 1: registry read of the LSA cached-credentials key
    $reg.metadata.event_type = "FILE_READ"
    $reg.target.registry.registry_key = /\\SECURITY\\Cache/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_security_readers
    $reg.principal.hostname = $hostname
    $reg.principal.process.file.full_path = $dumper_path

    // Leg 2: outbound network connection from the same process on the same host
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $dumper_path
    not $net.target.ip in %rfc1918_internal
    $net.target.port != 0

    // Chronological ordering: registry read must precede the network connection
    $reg.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $dumper_path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dumper_process = array_distinct($dumper_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $registry_keys_accessed = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg and $net
}
