/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:26:27.500324+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_Cloud_Account_Privileged_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects configuration/setting changes to cloud account privilege assignments, role bindings, federation trust settings, or MFA policy modifications. Adversaries who have obtained cloud account access frequently modify these settings to establish persistence or escalate privileges. This rule fires on the resulting state change rather than the command used to make it, providing coverage orthogonal to process-launch rules."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation, Defense Evasion"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires cloud audit logs ingested into Chronicle UDM: AWS CloudTrail, GCP Cloud Audit Logs, Azure Activity Log, Okta System Log, or Microsoft Entra ID audit events. Events must be normalized to SETTING_MODIFICATION with target.resource.name and principal.user.userid populated."
    platform = "IaaS, SaaS, Identity Provider, Office Suite"
    false_positives = "Authorized IAM administrators performing routine role assignments, automated provisioning pipelines (e.g., Terraform, Pulumi), break-glass account activations, and scheduled access reviews that bulk-modify permissions."
    tuning_guidance = "Add known provisioning service accounts to %cloud_privileged_provisioning_accounts. Add approved automation hostnames or user agents to %cloud_approved_automation_principals. Narrow the resource name regex to your specific cloud tenant naming conventions."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Target a privilege-bearing or trust-bearing resource type
    // Matches: role assignments, policy bindings, federation configs, MFA policy, conditional access, trust relationships
    (
      $cloud.target.resource.name = /role.assign/i nocase or
      $cloud.target.resource.name = /policy.bind/i nocase or
      $cloud.target.resource.name = /iam.policy/i nocase or
      $cloud.target.resource.name = /federation/i nocase or
      $cloud.target.resource.name = /trust/i nocase or
      $cloud.target.resource.name = /mfa.policy/i nocase or
      $cloud.target.resource.name = /conditional.access/i nocase or
      $cloud.target.resource.name = /privileged.role/i nocase or
      $cloud.target.resource.name = /admin.role/i nocase or
      $cloud.target.resource.name = /service.account.key/i nocase or
      $cloud.target.resource.name = /access.key/i nocase or
      $cloud.target.resource.name = /identity.provider/ nocase
    )

    // Actor must be a user or service principal (not an anonymous/unauthenticated source)
    $cloud.principal.user.userid != ""

    // Exclude known authorized provisioning accounts and automation principals
    not $cloud.principal.user.userid in %cloud_privileged_provisioning_accounts
    not $cloud.principal.hostname in %cloud_approved_automation_principals

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $modified_resource = array_distinct($cloud.target.resource.name)
    $actor_hostname = array_distinct($cloud.principal.hostname)

  condition:
    $cloud
}
