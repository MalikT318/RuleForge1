/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:25:50.583278+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Local_Account_Passwd_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects direct modification of local account credential stores (/etc/passwd, /etc/shadow, /etc/gshadow, /etc/group on Linux/macOS, or SAM/SECURITY hive files on Windows). Adversaries who create or manipulate local accounts via API or direct file writes will produce this artifact even when command-line logging is suppressed or evaded. This rule targets the resulting state change rather than the process invocation."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access, Defense Evasion"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires EDR file-integrity telemetry (e.g., CrowdStrike, SentinelOne, Sysmon EventID 11) or auditd FILE_MODIFY events forwarded to Chronicle. On Windows, Sysmon must monitor the SAM/SECURITY registry hive files."
    platform = "Linux, macOS, Windows"
    false_positives = "Legitimate user provisioning tools (Ansible, Chef, Puppet, cloud-init), OS package upgrades that update /etc/passwd or /etc/group, authorized identity management agents, Windows domain join operations writing to SAM."
    tuning_guidance = "Add known provisioning tool paths to %global_allowed_account_provisioners. Add authorized orchestration hostnames to %global_allowed_provisioning_hosts. Consider narrowing by time-of-day or change management windows for high-volume environments."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Linux / macOS credential and account database files
    // Windows SAM and SECURITY hive backing files (VSS or direct path)
    $file.target.file.full_path = /\/(etc\/(passwd|shadow|gshadow|group|sudoers|sudoers\.d\/|pam\.d\/)|var\/db\/shadow\/hash\/)/ nocase
    or
    $file.target.file.full_path = /[\\\/](system32|syswow64)[\\\/]config[\\\/](SAM|SECURITY|SYSTEM)$/  nocase
    or
    $file.target.file.full_path = /[\\\/]repair[\\\/](SAM|SECURITY|SYSTEM)$/ nocase

    // Exclude known-safe provisioning processes
    not $file.principal.process.file.full_path in %global_allowed_account_provisioners

    // Exclude known-safe provisioning hosts
    not $file.principal.hostname in %global_allowed_provisioning_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
