/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:32:46.848810+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_PasswordStore_FileRead_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read access to well-known password store database files and credential vault artifacts (e.g., browser credential databases, KeePass databases, macOS Keychain files, credential manager exports). Attackers targeting T1555 must physically open or copy these files; this rule fires on the resulting FILE_READ event rather than on process command-line arguments, providing a complementary detection layer that survives tool renaming and obfuscated launchers."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires EDR file-access telemetry (e.g., CrowdStrike Falcon file read events, Microsoft Defender for Endpoint FileRead, Sysmon Event ID 11/15, or equivalent). Chronicle UDM event type FILE_READ must be populated with target.file.full_path."
    platform = "Windows, macOS, Linux"
    false_positives = "Legitimate password manager applications reading their own database (e.g., KeePass opening Login.kdbx, browser sync processes). Backup agents archiving user profile directories. IT asset management tools enumerating credential stores. Security scanners performing authorized credential audits."
    tuning_guidance = "Add trusted backup agent and password manager process paths to %global_allowed_credstore_readers. Add approved security scanner hostnames to %global_credstore_scan_hosts. Narrow scope by requiring the reading process to be outside the user's own password manager binary."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Match well-known password store file paths and names across platforms.
    // Browser credential databases (Chrome, Edge, Brave, Firefox, Opera, Vivaldi)
    // macOS Keychain files, Windows Credential Manager exports,
    // KeePass / KeePassXC databases, 1Password, Bitwarden local vaults,
    // LastPass local cache, GNOME Keyring, pass (Unix password manager).
    $file.target.file.full_path = /[\/\\](Login Data|Cookies|Web Data|key[34]\.db|logins\.json|key4\.db|cert9\.db|signons\.sqlite|places\.sqlite)$/ nocase

    or $file.target.file.full_path = /\.kdbx$/ nocase

    or $file.target.file.full_path = /[\/\\](default\.keychain|login\.keychain-db|Local Items\.keychain-db|System\.keychain)$/ nocase

    or $file.target.file.full_path = /[\/\\](Credentials|Local State|Vault\.vcrd|Policy\.vpol)$/ nocase

    or $file.target.file.full_path = /[\/\\](\.password-store|\.gnome2[\/\\]keyrings|keyrings[\/\\].*\.keyring)/ nocase

    or $file.target.file.full_path = /[\/\\](1password[\/\\].*\.sqlite|1Password\.sqlite)$/ nocase

    or $file.target.file.full_path = /[\/\\](data\.mdf|vault\.bitwarden)$/ nocase

    // Exclude reads by the owning password manager or browser process itself
    // to suppress the highest-volume legitimate noise.
    not $file.principal.process.file.full_path = /[\/\\](keepass|keepassxc|1password|bitwarden|lastpass|dashlane)/ nocase
    not $file.principal.process.file.full_path = /[\/\\](chrome|msedge|brave|firefox|opera|vivaldi|safari)\.exe$/ nocase
    not $file.principal.process.file.full_path = /[\/\\](chrome|msedge|brave|firefox|opera|vivaldi|safari)$/ nocase

    // Reference-list exclusions for MSSP multi-tenant tuning
    not $file.principal.process.file.full_path in %global_allowed_credstore_readers
    not $file.principal.hostname in %global_credstore_scan_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $accessed_file = array_distinct($file.target.file.full_path)
    $actor_userid = array_distinct($file.principal.user.userid)

  condition:
    $file
}
