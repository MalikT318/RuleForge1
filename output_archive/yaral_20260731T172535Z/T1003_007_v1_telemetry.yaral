/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:31:31.077781+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Mem_File_Read_Credential_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read access to /proc/<PID>/mem or /proc/<PID>/maps by a process other than the process that owns the PID. Reading /proc/<PID>/mem with root privileges is the core mechanism used by credential dumpers such as MimiPenguin and similar tools to extract plaintext credentials or cached hashes from process virtual memory. This rule fires on the FILE_READ artifact rather than the process-launch command line, providing a complementary detection layer that survives command-line obfuscation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux EDR telemetry that emits FILE_READ events for procfs access (e.g., Sysdig Falco, Elastic Endpoint, Aqua Tracee, or auditd with file-read syscall rules mapped to UDM FILE_READ). Confirm your EDR populates target.file.full_path for /proc paths."
    platform = "Linux"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace) reading /proc/<PID>/mem of a child process; security scanners and AV engines performing memory inspection; container runtimes (runc, containerd) during process introspection; performance monitoring tools (perf, valgrind); kernel developers running test harnesses."
    tuning_guidance = "Add known-good debugger and monitoring tool paths to %linux_allowed_proc_mem_readers. Consider also scoping by principal.user.userid to exclude root-owned monitoring service accounts listed in %linux_allowed_proc_mem_users. Narrow further by requiring the reading PID to differ from the target PID if your EDR populates both."

  events:
    $file.metadata.event_type = "FILE_READ"
    // Match /proc/<numeric PID>/mem or /proc/<numeric PID>/maps
    // Covers both credential-extraction targets in the MITRE description
    $file.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps)$/ nocase
    // Exclude reads of a process's own mem/maps (self-introspection is benign)
    // /proc/self/mem and /proc/self/maps use the literal "self" path
    not $file.target.file.full_path = /\/proc\/self\/(mem|maps)$/
    // Exclude known-good tools by their executable path
    not $file.principal.process.file.full_path in %linux_allowed_proc_mem_readers
    // Exclude known-good service accounts performing legitimate memory inspection
    not $file.principal.user.userid in %linux_allowed_proc_mem_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $target_proc_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
