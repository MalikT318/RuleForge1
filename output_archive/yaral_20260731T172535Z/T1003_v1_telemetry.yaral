/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:27:09.156030+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_CredDump_SensitiveFileArtifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification events targeting well-known credential store paths and dump file patterns across Linux, macOS, and Windows. Attackers who dump credentials frequently write output to disk (e.g. LSASS minidumps, SAM/SYSTEM hive exports, /etc/shadow copies, keychains). This rule fires on the resulting file artifact rather than the process command line, providing coverage that survives command-line obfuscation and binary renaming."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires EDR file-event telemetry (e.g. CrowdStrike, SentinelOne, Microsoft Defender for Endpoint, Sysmon EventID 11) forwarded to Chronicle via UDM. FILE_CREATION and FILE_MODIFICATION events must include target.file.full_path."
    platform = "Linux, macOS, Windows"
    false_positives = "Legitimate backup agents exporting registry hives (e.g. SCCM, Veeam, Windows Server Backup). Security tooling performing authorised credential audits. macOS Keychain sync processes. Shadow copy creation by backup software. Forensic workstations running authorised IR tooling."
    tuning_guidance = "Add authorised backup agent process paths to %global_allowed_credential_file_writers. Scope exclusions narrowly to the specific process path, not the entire host, to avoid blind spots. Consider adding a parent-process join rule as a follow-on to correlate with suspicious parent lineage."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match sensitive credential file paths and dump artifacts across platforms.
    // Windows: SAM/SYSTEM/SECURITY hive exports, LSASS dump files, NTDS.dit copies,
    //          credential manager exports, LSA secrets dumps.
    // Linux:   /etc/shadow copies, /proc/*/mem reads written to disk, keyrings.
    // macOS:   Keychain database copies, securityd memory dumps.
    (
      // Windows registry hive exports written outside their canonical locations
      $file.target.file.full_path = /\\(SAM|SYSTEM|SECURITY|NTDS\.dit)(\.|$)/ nocase

      or

      // LSASS / process memory dump files by extension or common naming patterns
      $file.target.file.full_path = /\.(dmp|mdmp|dump)$/ nocase

      or

      // NTDS.dit copies anywhere outside the canonical NTDS directory
      (
        $file.target.file.full_path = /ntds\.dit/ nocase
        and not $file.target.file.full_path = /\\Windows\\NTDS\\ntds\.dit/ nocase
      )

      or

      // Linux shadow file written outside /etc
      (
        $file.target.file.full_path = /\/shadow/ nocase
        and not $file.target.file.full_path = /^\/etc\/shadow$/
      )

      or

      // macOS Keychain database copies outside canonical locations
      (
        $file.target.file.full_path = /\.keychain(-db)?$/ nocase
        and not $file.target.file.full_path = /\/Library\/Keychains\// nocase
      )

      or

      // Generic credential dump output naming conventions used by common tooling
      $file.target.file.full_path = /(lsass|cred(ential)?s?|hashdump|sekurlsa|mimikatz|pwdump|fgdump|cachedump|wce_|gsecdump)/ nocase
    )

    // Exclude authorised credential file writers (backup agents, IR tooling allow-listed per customer)
    not $file.principal.process.file.full_path in %global_allowed_credential_file_writers

    // Exclude canonical Windows backup and VSS processes writing hives legitimately
    not $file.principal.process.file.full_path = /\\(svchost\.exe|wbengine\.exe|vssvc\.exe|smss\.exe|lsass\.exe|csrss\.exe)$/ nocase

    // Exclude Windows registry hive files in their canonical system locations
    not (
      $file.target.file.full_path = /\\Windows\\System32\\config\\(SAM|SYSTEM|SECURITY|DEFAULT|SOFTWARE)$/ nocase
    )

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
