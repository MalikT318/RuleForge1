/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:34:23.154161+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Securityd_Memory_Read_Then_Keychain_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a non-system process opening a handle to the securityd process memory (PROCESS_OPEN) followed by a file read of keychain database files on the same host within 10 minutes. This two-stage pattern indicates an adversary with root access scanning securityd memory for PBKDF2 master keys and then harvesting the on-disk keychain, providing additive coverage beyond command-line detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events (e.g., SentinelOne, CrowdStrike Falcon, Elastic Endpoint) and FILE_READ events for macOS/Linux. principal.process.file.full_path and target.process.file.full_path must be populated on PROCESS_OPEN events; target.file.full_path must be populated on FILE_READ events."
    platform = "macOS, Linux"
    false_positives = "Legitimate security auditing tools (e.g., osquery, authorized pen-test frameworks), Apple diagnostics daemons, and backup agents that inspect securityd or read keychain files as part of authorized operations."
    tuning_guidance = "Add authorized security tooling and backup agent paths to %global_allowed_securityd_readers. Add known-safe keychain-reading processes to %global_allowed_keychain_readers. Scope by principal.user.userid to exclude root-equivalent service accounts that legitimately touch these resources."

  events:
    // Stage 1: A non-system process opens securityd's memory
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\/securityd$/ nocase
    // Exclude securityd opening itself and known OS daemons
    not $open.principal.process.file.full_path = /\/(securityd|launchd|kernel|kextd|watchdogd|configd)$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_securityd_readers
    $open.principal.hostname = $hostname

    // Stage 2: The same host reads a keychain database file shortly after
    $file.metadata.event_type = "FILE_READ"
    // Match macOS keychain paths and Linux equivalents (gnome-keyring, kwallet)
    $file.target.file.full_path = /\/(Keychains\/.*\.keychain(-db)?|login\.keychain(-db)?|System\.keychain|keyrings\/.*\.(keyring|kwl)|gnome2\/keyrings\/)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_keychain_readers
    $file.principal.hostname = $hostname

    // Chronological ordering: memory open must precede keychain file read
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $securityd_opener_process = array_distinct($open.principal.process.file.full_path)
    $securityd_opener_user = array_distinct($open.principal.user.userid)
    $keychain_files_read = array_distinct($file.target.file.full_path)
    $keychain_reader_process = array_distinct($file.principal.process.file.full_path)
    $keychain_reader_user = array_distinct($file.principal.user.userid)
    $event_count = count($file.metadata.event_timestamp.seconds)

  condition:
    $open and $file
}
