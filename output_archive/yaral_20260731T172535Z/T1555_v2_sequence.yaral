/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:33:06.301558+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_PasswordStore_FileRead_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process reading from a known password store or credential file location, followed by an outbound network connection from the same process on the same host within 10 minutes. This pattern is consistent with credential harvesting tools exfiltrating extracted secrets. Complements existing T1555 process-launch/command-line rules by focusing on the file-read-then-exfil behaviour rather than tool invocation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires EDR file-read telemetry (e.g. CrowdStrike, SentinelOne, Microsoft Defender for Endpoint) and network connection telemetry ingested into Chronicle UDM. FILE_READ events must populate target.file.full_path and principal.process.file.full_path."
    platform = "Windows, Linux, macOS"
    false_positives = "Legitimate password manager sync clients (e.g. 1Password, Bitwarden desktop) reading their own vault and syncing to cloud backends. Browser auto-update processes reading login data. Backup agents archiving credential stores. Security scanners performing authorised credential audits."
    tuning_guidance = "Add known-good sync processes to %global_allowed_credential_readers. Add approved internal sync destinations to %global_allowed_credential_sync_destinations. Scope by tenant if a specific password manager is universally deployed."

  events:
    // Leg 1: process reads from a known credential/password store path
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /[\/\\](Login Data|logins\.json|key[34]\.db|cert[89]\.db|signons\.sqlite|\.keychain|keychain\.db|Keychain|pass\.db|\.password-store|KeePass|\.kdbx|LastPass|dashlane|1password|Bitwarden|Enpass|RoboForm|credentials\.db|credentials\.pfx|Vault|secrets\.yml|\.aws[\/\\]credentials|\.azure[\/\\]accessTokens\.json|\.config[\/\\]gcloud[\/\\]credentials\.db|wallet\.dat|id_rsa|id_ecdsa|id_ed25519)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_credential_readers
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $reading_process

    // Leg 2: same process makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $reading_process
    $net.principal.hostname = $hostname
    not $net.target.ip in %global_allowed_credential_sync_destinations
    // Exclude RFC-1918 to focus on external exfiltration; internal lateral movement is a separate rule
    not $net.target.ip = /^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|127\.|::1)/

    // Chronological ordering: file read must precede the network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $reading_process over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($file.principal.hostname)
    $credential_files_accessed = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $reading_process_path = array_distinct($reading_process)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $file and $net
}
