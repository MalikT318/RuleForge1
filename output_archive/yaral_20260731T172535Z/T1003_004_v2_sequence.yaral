/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:29:55.100477+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Registry_Read_Then_Network_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a process opening the LSA Secrets registry hive (HKLM\\SECURITY\\Policy\\Secrets) followed by an outbound network connection from the same process on the same host within 10 minutes. This two-stage correlation catches credential harvesting tools that read LSA secrets from the registry and then exfiltrate them, providing additive coverage beyond command-line process-launch detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires EDR registry telemetry (e.g., Sysmon Event ID 12/13 or CrowdStrike registry events) and EDR network telemetry. Registry auditing must be enabled for HKLM\\SECURITY."
    platform = "Windows"
    false_positives = "Domain controllers running legitimate LSA replication processes (lsass.exe performing normal AD operations), backup agents that snapshot the registry and then upload to cloud storage, security scanning tools performing credential hygiene checks."
    tuning_guidance = "Add known-good backup or security agent process paths to %global_allowed_lsa_readers. Add known-good internal management IP ranges to %global_allowed_mgmt_destinations. Consider scoping to non-SYSTEM service accounts if lsass.exe generates noise."

  events:
    // Leg 1: Registry access to LSA Secrets hive
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /HKLM\\SECURITY\\Policy\\Secrets/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_lsa_readers
    $reg.principal.hostname = $hostname
    $reg.principal.process.file.full_path = $proc_path

    // Leg 2: Outbound network connection from the same process on the same host
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $proc_path
    not $net.target.ip in %global_allowed_mgmt_destinations
    not $net.target.ip in %rfc1918_internal

    // Chronological ordering: registry access must precede network connection
    $reg.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $offending_process = array_distinct($proc_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $registry_keys_accessed = array_distinct($reg.target.registry.registry_key)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $reg and $net
}
