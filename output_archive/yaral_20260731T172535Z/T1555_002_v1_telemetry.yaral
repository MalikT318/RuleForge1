/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:34:00.643504+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Securityd_Memory_Process_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a non-system process opening a handle to the securityd process with memory-read access. Adversaries with root privileges may read securityd memory to extract cached keychain master keys and recover plaintext credentials. This rule fires on the PROCESS_OPEN event rather than process-launch command-line telemetry, providing additive coverage that is harder to evade."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires EDR telemetry that emits PROCESS_OPEN events on macOS or Linux (e.g., Crowdstrike Falcon, SentinelOne, Elastic Endpoint). The sensor must populate target.process.file.full_path with the victim process path and principal.process.file.full_path with the requesting process path."
    platform = "macOS, Linux"
    false_positives = "Apple diagnostics daemons (e.g., diagnosticd, ReportCrash), authorized security tooling performing process inspection, legitimate debugging sessions by platform engineers, macOS system integrity protection (SIP) enforcement processes."
    tuning_guidance = "Add authorized security tooling and Apple system diagnostic binaries to %global_allowed_securityd_openers. Scope further by requiring the requesting process to originate from an unexpected parent or non-system path. Consider raising severity only when principal.user.userid is not 'root' to catch privilege-escalation-assisted access."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be the securityd daemon
    $open.target.process.file.full_path = /\/securityd$/ nocase

    // The requesting process must NOT itself be a known Apple system binary
    // that legitimately inspects securityd (e.g., security, securityd itself)
    not $open.principal.process.file.full_path = /\/(securityd|security|launchd|kernel_task|diagnosticd|ReportCrash|sysdiagnose|spindump|SubmitDiagInfo)$/ nocase

    // Exclude processes running from canonical Apple system directories
    not $open.principal.process.file.full_path = /^\/(System\/Library|usr\/libexec|usr\/sbin|usr\/bin|sbin|bin)\// nocase

    // Exclude processes running from known macOS security framework paths
    not $open.principal.process.file.full_path = /\/Library\/Apple\// nocase

    // Multi-tenant exclusion: allow approved tooling registered per customer
    not $open.principal.process.file.full_path in %global_allowed_securityd_openers

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $requesting_process = array_distinct($open.principal.process.file.full_path)
    $requesting_user = array_distinct($open.principal.user.userid)
    $target_process = array_distinct($open.target.process.file.full_path)

  condition:
    $open
}
