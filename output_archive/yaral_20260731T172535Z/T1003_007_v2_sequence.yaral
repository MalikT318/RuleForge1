/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:31:47.552913+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_ProcFS_Maps_Read_Then_Mem_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage /proc filesystem credential harvesting pattern: a process first opens /proc/<PID>/maps to enumerate memory regions, then accesses /proc/<PID>/mem to read process memory. This sequence is characteristic of in-memory credential dumpers (e.g. MimiPenguin) and distinguishes active harvesting from incidental /proc reads. Additive coverage over existing PROCESS_LAUNCH command-line rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux file-access telemetry (EDR with FILE_READ events for /proc paths, e.g. Falco, Sysdig, CrowdStrike Falcon on Linux, or auditd with file-open syscall rules forwarded to Chronicle via UDM)."
    platform = "Linux"
    false_positives = "Debuggers (gdb, lldb, strace), legitimate memory profilers (valgrind, perf), container runtimes inspecting their own child processes, security scanners. Scope exclusions via %linux_allowed_proc_readers."
    tuning_guidance = "Add known-good profiling and debugging tool full paths to %linux_allowed_proc_readers. Consider narrowing by principal.user.userid to exclude root-owned monitoring daemons that are explicitly whitelisted. If noise persists, restrict to events where the reading process differs from the target PID owner."

  events:
    // Stage 1: process reads /proc/<PID>/maps to enumerate memory regions
    $maps.metadata.event_type = "FILE_READ"
    $maps.target.file.full_path = /\/proc\/[0-9]+\/maps$/ nocase
    not $maps.principal.process.file.full_path in %linux_allowed_proc_readers
    $maps.principal.hostname = $hostname
    $maps.principal.process.pid = $reader_pid

    // Stage 2: same process on the same host reads /proc/<PID>/mem
    // (may target the same or a different PID than the maps read)
    $mem.metadata.event_type = "FILE_READ"
    $mem.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase
    not $mem.principal.process.file.full_path in %linux_allowed_proc_readers
    $mem.principal.hostname = $hostname
    $mem.principal.process.pid = $reader_pid

    // Enforce chronological ordering: maps enumeration precedes mem access
    $maps.metadata.event_timestamp.seconds <= $mem.metadata.event_timestamp.seconds

  match:
    $hostname, $reader_pid over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($maps.principal.hostname)
    $reading_process = array_distinct($maps.principal.process.file.full_path)
    $reading_user = array_distinct($maps.principal.user.userid)
    $maps_targets = array_distinct($maps.target.file.full_path)
    $mem_targets = array_distinct($mem.target.file.full_path)
    $event_count = count($mem.metadata.id)

  condition:
    $maps and $mem
}
