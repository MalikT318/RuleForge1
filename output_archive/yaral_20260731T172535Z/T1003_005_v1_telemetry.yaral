/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:30:14.499948+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_Cached_Creds_Registry_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process handle opens targeting the LSA Security registry hive where Windows cached domain credentials (DCC2/MSCachev2) are stored. Legitimate processes rarely open a raw handle to HKLM\\SECURITY\\Cache outside of LSASS itself or authorised backup agents. This rule fires on the resulting OS state-change event rather than on command-line arguments, providing coverage that is orthogonal to existing process-creation detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires EDR telemetry that records registry key open/read events (e.g. Sysmon Event ID 12/13/17 ingested as REGISTRY_MODIFICATION, or CrowdStrike/SentinelOne registry-access telemetry mapped to UDM). Windows Security audit policy 'Audit Registry' must be enabled for native Windows event coverage."
    platform = "Windows"
    false_positives = "Windows backup agents (e.g. Veeam, Acronis), domain-join tooling, authorised credential-management software, and some AV/EDR products that audit LSA state. LSASS itself should be excluded by the principal process filter."
    tuning_guidance = "Add authorised backup and credential-management process paths to %global_allowed_lsa_readers. If your EDR maps registry reads as FILE_READ rather than REGISTRY_MODIFICATION, clone this rule with that event type and the equivalent file path field."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the exact registry key that stores cached domain credentials
    $reg.target.registry.registry_key = /\\SECURITY\\Cache/ nocase

    // Catch both direct key access and individual NL$ cache entry sub-keys
    // NL$1 .. NL$25 are the per-slot cached credential entries
    $reg.target.registry.registry_key = /HKLM|HKEY_LOCAL_MACHINE/ nocase

    // Exclude LSASS itself - it legitimately owns this key at all times
    not $reg.principal.process.file.full_path = /\\lsass\.exe$/ nocase

    // Exclude the Windows Registry service and authorised system processes
    not $reg.principal.process.file.full_path = /\\services\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\svchost\.exe$/ nocase

    // MSSP multi-tenant exclusion list for authorised backup / credential tools
    not $reg.principal.process.file.full_path in %global_allowed_lsa_readers

    // Exclude known-safe registry editor paths used by authorised admins
    not $reg.principal.user.userid in %global_allowed_privileged_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $offending_process = array_distinct($reg.principal.process.file.full_path)
    $offending_user = array_distinct($reg.principal.user.userid)
    $accessed_key = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
