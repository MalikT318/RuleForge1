/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T17:29:40.560700+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Registry_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects registry read or modification of the LSA Secrets hive at HKLM\\SECURITY\\Policy\\Secrets. Adversaries with SYSTEM privileges query or enumerate this key to extract service account credentials, cached domain credentials, and other sensitive material. This rule fires on the registry state-change layer rather than process command-line, providing coverage when command-line logging is absent or the attacker uses a renamed/reflective tool."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires Windows Security Event 4663 (Object Access - Registry) with SACL auditing enabled on HKLM\\SECURITY\\Policy\\Secrets, OR EDR registry telemetry (e.g., Sysmon Event ID 12/13/14, CrowdStrike, SentinelOne) forwarded to Chronicle as REGISTRY_MODIFICATION or REGISTRY_CREATION UDM events."
    platform = "Windows"
    false_positives = "LSASS itself performing internal secret rotation, Windows DPAPI operations, legitimate backup agents (e.g., Veeam, Commvault) running as SYSTEM, domain join/unjoin operations, and some Group Policy processing cycles."
    tuning_guidance = "Add known-good SYSTEM-context processes that legitimately touch this key (e.g., backup agent executables) to %lsa_registry_allowed_processes. If noise from domain controllers is high, add DC hostnames to %lsa_registry_allowed_hosts. Narrow further by requiring the accessing process to NOT be lsass.exe or services.exe."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SECURITY\\Policy\\Secrets/ nocase
    not $reg.principal.process.file.full_path in %lsa_registry_allowed_processes
    not $reg.principal.hostname in %lsa_registry_allowed_hosts
    // Exclude the OS processes that legitimately own this key at runtime
    not $reg.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\services\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\svchost\.exe$/ nocase

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $accessing_process = array_distinct($reg.principal.process.file.full_path)
    $accessing_user = array_distinct($reg.principal.user.userid)
    $registry_key_touched = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
