/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-25T19:43:55.698101+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Service_Registry_Then_Stop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage attack against the Windows Event Log: first a registry modification that disables or reconfigures the EventLog service start type, followed by a process launch that stops or disables the service. This correlation provides additive coverage beyond command-line-only detections by anchoring on the registry change that persists the impairment."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 13) and process-launch telemetry (Event ID 1 / 4688). Both event types must be ingested and normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorized system hardening scripts, GPO-driven audit policy changes, backup or imaging agents that temporarily stop the EventLog service, RMM platforms performing maintenance."
    tuning_guidance = "Add authorized maintenance account usernames to %global_allowed_eventlog_admin_users and authorized parent process paths to %global_allowed_eventlog_mgmt_parents. Consider scoping to non-maintenance windows using a time-of-day filter."

  events:
    // Stage 1: Registry modification targeting the EventLog service start value
    // start=4 (disabled) or start=3 (manual) are both suspicious in this context
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Services\\EventLog$/ nocase
    $reg.target.registry.registry_value_name = /^Start$/ nocase
    not $reg.principal.user.userid in %global_allowed_eventlog_admin_users
    $reg.principal.hostname = $hostname

    // Stage 2: A process that stops, disables, or reconfigures the EventLog service
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      // sc.exe disabling or stopping the service
      (
        $proc.target.process.file.full_path = /\\sc\.exe$/ nocase
        $proc.target.process.command_line = /eventlog/ nocase
        $proc.target.process.command_line = /(stop|disabled|demand)/ nocase
      )
      or
      // net.exe / net1.exe stopping the service
      (
        $proc.target.process.file.full_path = /\\net1?\.exe$/ nocase
        $proc.target.process.command_line = /stop/ nocase
        $proc.target.process.command_line = /eventlog/ nocase
      )
      or
      // PowerShell stopping or setting the service
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        $proc.target.process.command_line = /(Stop-Service|Set-Service)/ nocase
        $proc.target.process.command_line = /EventLog/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_eventlog_mgmt_parents
    not $proc.principal.user.userid in %global_allowed_eventlog_admin_users
    $proc.principal.hostname = $hostname

    // Enforce chronological ordering: registry change precedes service stop
    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($hostname)
    $reg_key_modified = array_distinct($reg.target.registry.registry_key)
    $reg_value_name = array_distinct($reg.target.registry.registry_value_name)
    $stop_command_line = array_distinct($proc.target.process.command_line)
    $stop_process_path = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $reg and $proc
}
