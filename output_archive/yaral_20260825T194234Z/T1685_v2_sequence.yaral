/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-25T19:43:17.620663+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_Container_Security_Tool_Disable_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage defense impairment pattern in container environments via cloud audit logs: first, a privileged or security-relevant resource access or modification targeting a container security control (e.g., admission controller, runtime policy, logging agent config), followed by deletion or disabling of a related security resource within the same time window. This targets adversaries who tamper with Kubernetes security tooling at the control-plane API level rather than via in-container process execution."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1562.001"
    mitre_technique_name = "Impair Defenses: Disable or Modify Tools"
    log_prerequisites = "Requires cloud provider audit logs (e.g., Kubernetes API server audit, GKE/EKS/AKS control plane audit) normalised into Chronicle UDM. Events must populate principal.user.userid, target.resource.name, and metadata.event_type."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate security tool upgrades or migrations, GitOps pipelines rotating admission webhook configurations, authorized cluster administrators decommissioning deprecated security agents."
    tuning_guidance = "Add trusted CI/CD service accounts and cluster-admin principals to %container_allowed_security_admins. Add known-safe resource name patterns (e.g., upgrade namespaces) to %container_allowed_security_resources. Narrow the time window if false-positive rate is high in environments with frequent automated deployments."

  events:
    // Stage 1: Privileged access or modification of a security-relevant container resource
    // (admission webhooks, network policies, audit policies, runtime classes, PSPs/PSAs)
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.resource.name = /admissionwebhook|networkpolic|auditpolic|runtimeclass|podsecurit|securitypolic|falco|sysdig|twistlock|aqua|stackrox|opa|gatekeeper|kyverno|logging|monitoring|fluentd|fluent-bit|filebeat|metricbeat|cloudwatch-agent|datadog-agent/ nocase
    not $access.principal.user.userid in %container_allowed_security_admins
    not $access.target.resource.name in %container_allowed_security_resources
    $access.principal.user.userid = $actor

    // Stage 2: Deletion of a security-relevant container resource by the same principal
    $del.metadata.event_type = "RESOURCE_DELETION"
    $del.target.resource.name = /admissionwebhook|networkpolic|auditpolic|runtimeclass|podsecurit|securitypolic|falco|sysdig|twistlock|aqua|stackrox|opa|gatekeeper|kyverno|logging|monitoring|fluentd|fluent-bit|filebeat|metricbeat|cloudwatch-agent|datadog-agent/ nocase
    not $del.principal.user.userid in %container_allowed_security_admins
    not $del.target.resource.name in %container_allowed_security_resources
    $del.principal.user.userid = $actor

    // Chronological ordering: access precedes deletion
    $access.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(82)
    $mitre_technique_id = array_distinct("T1562.001")
    $primary_entity = array_distinct($actor)
    $accessed_resources = array_distinct($access.target.resource.name)
    $deleted_resources = array_distinct($del.target.resource.name)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $access and $del
}
