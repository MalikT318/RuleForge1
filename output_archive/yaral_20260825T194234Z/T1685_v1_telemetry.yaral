/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-25T19:42:55.559977+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_IaaS_Security_Monitoring_Config_Tampered {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects cloud control-plane API calls that disable, delete, or modify security monitoring services, log sinks, diagnostic settings, flow logs, or guardrail configurations. Adversaries tamper with these resources to blind defenders before or during an intrusion. Targets the resulting configuration state change rather than the process that issued the command, providing coverage that survives command-line log evasion."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1562.001"
    mitre_technique_name = "Impair Defenses: Disable or Modify Tools"
    log_prerequisites = "Cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, GCP Audit Logs). Requires SETTING_MODIFICATION and RESOURCE_DELETION event types to be ingested."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Authorised infrastructure-as-code pipelines rotating or replacing monitoring configurations; security team decommissioning legacy log sinks; cloud provider maintenance operations; automated compliance remediation tools."
    tuning_guidance = "Populate %cloud_approved_security_automation_principals with service accounts and CI/CD identities that legitimately manage monitoring resources. Add known-good resource name patterns to %cloud_allowed_monitoring_resource_names. Raise severity if the acting principal has no prior history of touching monitoring resources."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Match API method names that disable, delete, or update security-relevant
    // monitoring primitives across AWS, Azure, and GCP. Chronicle normalises
    // the provider-specific API verb into target.resource.attribute or
    // metadata.product_event_type; we match on the resource type name which
    // is reliably populated across providers.
    (
      // Log sinks, trails, diagnostic settings, flow logs
      $cloud.target.resource.name = /trail|sink|diagnostic.setting|flow.log|log.profile|log.export|audit.config/ nocase
      or
      // Security centre / posture / guardrail services
      $cloud.target.resource.name = /security.center|security.hub|guard.duty|defender|cloud.armor|waf.policy|shield|inspector|macie|access.analyzer/ nocase
      or
      // Monitoring agents and metric alerting
      $cloud.target.resource.name = /monitoring.agent|metric.alert|alert.policy|notification.channel|log.metric|alarm|event.subscription/ nocase
      or
      // Cloud-native IDS / detection services
      $cloud.target.resource.name = /threat.detection|anomaly.detection|ids.endpoint|network.watcher|packet.capture/ nocase
    )

    // Capture the acting identity for join and outcome
    $cloud.principal.user.userid = $actor

    // Exclude approved automation principals
    not $cloud.principal.user.userid in %cloud_approved_security_automation_principals

    // Exclude known-good resource names (e.g., dev/test monitoring stacks)
    not $cloud.target.resource.name in %cloud_allowed_monitoring_resource_names

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1562.001")
    $primary_entity    = array_distinct($actor)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $source_ip         = array_distinct($cloud.principal.ip)
    $cloud_project     = array_distinct($cloud.target.resource.attribute.labels.key)

  condition:
    $cloud
}
