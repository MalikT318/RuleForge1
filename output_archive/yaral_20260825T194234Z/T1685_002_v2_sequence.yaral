/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-25T19:44:32.295119+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_M365_AuditBypass_Then_MailboxAccess {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a mailbox audit bypass or advanced auditing downgrade for a target user, followed by mailbox resource access against that same user within 10 minutes. This pattern indicates an adversary disabling M365 audit coverage before accessing mailbox contents to avoid leaving a forensic trail."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Log"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log (UAL) ingested into Chronicle via the M365 connector. Audit log must be enabled at the tenant level. Set-MailboxAuditBypassAssociation and mailbox access events must be present."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Authorized IT administrators performing bulk mailbox migrations or license changes followed by compliance validation access. Automated provisioning pipelines that adjust audit settings and immediately verify mailbox state."
    tuning_guidance = "Add known admin service accounts to %m365_allowed_audit_admin_accounts. Add known provisioning or migration service principals to %m365_allowed_provisioning_principals. Narrow the match window if false-positive rate is high in environments with frequent license management activity."

  events:
    // Event 1: Audit bypass or auditing downgrade applied to a target mailbox
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.user.userid = $target_user
    $cfg.target.user.userid != ""
    (
      $cfg.metadata.description = /MailboxAuditBypassAssociation/ nocase or
      $cfg.metadata.description = /Set-MailboxAuditBypassAssociation/ nocase or
      $cfg.metadata.description = /AuditEnabled.*false/ nocase or
      $cfg.metadata.description = /DisableAdvancedAuditing/ nocase or
      $cfg.metadata.description = /DowngradeLicense/ nocase
    )
    not $cfg.principal.user.userid in %m365_allowed_audit_admin_accounts
    not $cfg.principal.user.userid in %m365_allowed_provisioning_principals

    // Event 2: Mailbox or resource access against the same target user after the bypass
    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.target.user.userid = $target_user
    $acc.target.user.userid != ""
    (
      $acc.metadata.description = /MailItemsAccessed/ nocase or
      $acc.metadata.description = /FolderBind/ nocase or
      $acc.metadata.description = /MessageBind/ nocase or
      $acc.metadata.description = /MailboxLogin/ nocase
    )
    not $acc.principal.user.userid in %m365_allowed_audit_admin_accounts

    // Chronological ordering: bypass must precede access
    $cfg.metadata.event_timestamp.seconds <= $acc.metadata.event_timestamp.seconds

  match:
    $target_user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($target_user)
    $bypass_actor = array_distinct($cfg.principal.user.userid)
    $access_actor = array_distinct($acc.principal.user.userid)
    $bypass_descriptions = array_distinct($cfg.metadata.description)
    $access_descriptions = array_distinct($acc.metadata.description)

  condition:
    $cfg and $acc
}
