/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-25T19:43:34.127218+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Service_Registry_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications that disable or reconfigure the Windows EventLog service start type, indicating an adversary attempting to prevent event log collection at boot or runtime. This targets the resulting registry state change rather than the command used to produce it, providing coverage against evasion of process-creation logging."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13 or equivalent EDR registry modification events) normalised into Chronicle UDM REGISTRY_MODIFICATION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorized system hardening scripts, GPO-driven audit policy changes, legitimate IT operations disabling the service for maintenance. Rare in production environments."
    tuning_guidance = "Add authorized administrative accounts to %global_allowed_eventlog_admin_users and authorized management hosts to %global_allowed_admin_hosts. Review parent process context in SOAR triage."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the EventLog service control registry key
    $reg.target.registry.registry_key = /\\SYSTEM\\(CurrentControlSet|ControlSet[0-9]+)\\Services\\EventLog$/ nocase

    // The Start value controls service startup: 4 = Disabled, 3 = Manual (abnormal for EventLog)
    $reg.target.registry.registry_value_name = /^Start$/ nocase

    // Value data of 4 (disabled) or 3 (manual) is suspicious for the EventLog service
    // Chronicle normalises registry value data into registry_value_data as a string
    $reg.target.registry.registry_value_data = /^[34]$/

    // Exclude known-good administrative accounts and hosts
    not $reg.principal.user.userid in %global_allowed_eventlog_admin_users
    not $reg.principal.hostname in %global_allowed_admin_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $actor_userid = array_distinct($reg.principal.user.userid)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $new_start_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
