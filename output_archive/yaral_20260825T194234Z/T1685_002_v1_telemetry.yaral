/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-08-25T19:44:14.704948+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_M365_Mailbox_Audit_Bypass_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of mailbox audit bypass associations or disabling of per-user M365 Advanced Auditing settings. Adversaries with sufficient privileges may suppress mailbox audit logging for targeted accounts to conceal mail collection activity. This rule pivots on the resulting configuration state change rather than the command line used to invoke it, providing coverage that is resilient to process-creation log gaps."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Log"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log ingested into Chronicle. Relevant operations include Set-MailboxAuditBypassAssociation, Disable-OrganizationCustomization, and license downgrade events normalised to SETTING_MODIFICATION."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Authorized IT administrators performing bulk license reassignment during planned migrations; service accounts used by compliance tooling that legitimately adjusts audit bypass settings."
    tuning_guidance = "Add known administrative service account user IDs to %m365_allowed_audit_admins. Add approved change-window hostnames or source IPs to %m365_approved_admin_sources. Reduce severity for accounts in %m365_licensed_migration_accounts during documented migration windows."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Match audit-suppression operations by targeting the operation name
    // normalised into the resource name or operation field.
    // Covers: MailboxAuditBypassAssociation changes, Advanced Audit disable,
    // and audit-related policy modifications.
    (
      $cloud.target.resource.name = /auditbypass/ nocase or
      $cloud.target.resource.name = /mailboxaudit/ nocase or
      $cloud.target.resource.name = /advancedaudit/ nocase or
      $cloud.target.resource.attribute.labels.key = /auditbypass/ nocase or
      $cloud.target.resource.attribute.labels.value = /auditbypass/ nocase or
      $cloud.target.resource.attribute.labels.value = /disable/ nocase
    )

    // Restrict to operations that indicate a disabling or bypass action
    (
      $cloud.security_result.description = /bypass/ nocase or
      $cloud.security_result.description = /disable/ nocase or
      $cloud.security_result.description = /auditdisabled/ nocase or
      $cloud.target.resource.attribute.labels.value = /false/ nocase
    )

    // Actor must be a real user principal, not an automated system account
    $cloud.principal.user.userid != ""

    // Exclude known authorised audit administrators
    not $cloud.principal.user.userid in %m365_allowed_audit_admins

    // Exclude approved administrative source addresses
    not $cloud.principal.ip in %m365_approved_admin_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $modified_resource = array_distinct($cloud.target.resource.name)
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
