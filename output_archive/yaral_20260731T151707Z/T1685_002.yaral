/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:18:16.120240+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1685_002_Disable_or_Modify_Cloud_Log {

  meta:
    author = "TELUS Detection Engineering"
    description = "Detects attempts to disable or modify cloud logging capabilities including AWS CloudTrail/CloudWatch, Azure Monitor, GCP logging, and Office 365 audit logging. Adversaries with sufficient permissions may tamper with logging to evade detection of subsequent malicious activity."
    mitre_attack_technique = "T1685.002 - Disable or Modify Cloud Log"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    false_positive = "Legitimate cloud administrators performing authorized maintenance, log rotation, or infrastructure changes. Security teams conducting authorized audits or configuration changes. Automated infrastructure-as-code pipelines (Terraform, CloudFormation) performing planned changes. Validate against change management records."
    platform = "IaaS, SaaS, Identity Provider, Office Suite"
    reference = "https://attack.mitre.org/techniques/T1685/002/"
    rule_version = "1.0"
    created = "2025-01-01"

  events:

    // Pattern 1: Process-based detection for CLI tools disabling cloud logging
    $proc_event.metadata.event_type = "PROCESS_LAUNCH"
    (
      // AWS CloudTrail disable/modify operations via CLI
      re.regex($proc_event.principal.process.command_line, `(?i)(aws\s+cloudtrail\s+(delete-trail|stop-logging|update-trail|remove-tags|put-event-selectors))`) nocase or
      // AWS CloudWatch log group deletion or retention modification
      re.regex($proc_event.principal.process.command_line, `(?i)(aws\s+logs\s+(delete-log-group|delete-log-stream|delete-retention-policy|delete-subscription-filter|disassociate-kms-key))`) nocase or
      // AWS SNS topic removal (associated with CloudTrail notifications)
      re.regex($proc_event.principal.process.command_line, `(?i)(aws\s+sns\s+delete-topic)`) nocase or
      // Azure Monitor / Diagnostic Settings disable
      re.regex($proc_event.principal.process.command_line, `(?i)(az\s+(monitor\s+(diagnostic-settings\s+delete|log-profiles\s+delete|activity-log\s+alert\s+delete)|security\s+audit-policy\s+update))`) nocase or
      // GCP logging disable
      re.regex($proc_event.principal.process.command_line, `(?i)(gcloud\s+(logging\s+(sinks\s+delete|buckets\s+delete|views\s+delete)|projects\s+update.*--no-enable-cloud-logging))`) nocase or
      // Office 365 / Exchange Online audit bypass
      re.regex($proc_event.principal.process.command_line, `(?i)(Set-MailboxAuditBypassAssociation|Set-AdminAuditLogConfig.*-UnifiedAuditLogIngestionEnabled\s+\$?false|Disable-OrganizationCustomization)`) nocase or
      // Pacu or similar cloud attack framework modules
      re.regex($proc_event.principal.process.command_line, `(?i)(pacu.*detection|cloudtrail.*disable|logging.*tamper)`) nocase or
      // Generic patterns for disabling multi-region or log validation
      re.regex($proc_event.principal.process.command_line, `(?i)(--no-enable-log-file-validation|--no-is-multi-region-trail|--no-include-global-service-events)`) nocase or
      // Terraform or infrastructure destroy targeting logging resources
      re.regex($proc_event.principal.process.command_line, `(?i)(terraform\s+(destroy|apply).*cloudtrail|terraform\s+(destroy|apply).*log_group)`) nocase
    )

  condition:
    $proc_event

}
