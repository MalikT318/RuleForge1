/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:19:55.579528+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1686_Disable_or_Modify_System_Firewall {

  meta:
    author = "TELUS Detection Engineering"
    description = "Detects attempts to disable or modify host-based firewalls across Windows, Linux, macOS, and ESXi platforms. Covers netsh, ufw, iptables, firewall-cmd, pfctl, esxcli, and PowerShell-based firewall manipulation."
    mitre_attack_technique = "T1686 - Disable or Modify System Firewall"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    false_positive = "Legitimate system administrators performing authorized firewall configuration changes, automated configuration management tools (Ansible, Chef, Puppet), and security software installations may trigger this rule. Validate against change management records."
    version = "1.0"
    created = "2025-01-01"
    platform = "Windows, Linux, macOS, ESXi"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"

    (
      // Windows - netsh firewall/advfirewall disable or rule modification
      (
        re.regex($e.principal.process.command_line, `netsh\s+(advfirewall|firewall)`, nocase) and
        re.regex($e.principal.process.command_line, `(set\s+(allprofiles|domainprofile|privateprofile|publicprofile|currentprofile|opmode|state|firewallpolicy|rule)|add\s+rule|delete\s+rule)`, nocase) and
        re.regex($e.principal.process.command_line, `(disable|off|allow|bypass)`, nocase)
      )
      or
      // Windows - PowerShell firewall cmdlets
      (
        re.regex($e.principal.process.command_line, `(Set-NetFirewallProfile|Disable-NetFirewallRule|New-NetFirewallRule|Remove-NetFirewallRule|Set-NetFirewallRule)`, nocase) and
        re.regex($e.principal.process.command_line, `(Enabled\s*\$false|-Enabled\s+False|-Action\s+Allow|-Profile\s+(Any|All|Domain|Private|Public))`, nocase)
      )
      or
      // Windows - sc stop/disable Windows Firewall service
      (
        re.regex($e.principal.process.command_line, `(sc\.exe|sc)\s+(stop|config|delete)\s+(mpssvc|mpsdrv|sharedaccess|bfe)`, nocase)
      )
      or
      // Linux - ufw disable or allow
      (
        re.regex($e.principal.process.command_line, `ufw\s+(disable|reset|allow|delete|deny|reject|insert)`, nocase)
      )
      or
      // Linux - iptables flush or permissive policy
      (
        re.regex($e.principal.process.command_line, `iptables\s+`, nocase) and
        re.regex($e.principal.process.command_line, `(-F|-X|-P\s+(INPUT|OUTPUT|FORWARD)\s+ACCEPT|--flush|--delete-chain|--policy\s+(INPUT|OUTPUT|FORWARD)\s+ACCEPT)`, nocase)
      )
      or
      // Linux - firewalld disable or zone manipulation
      (
        re.regex($e.principal.process.command_line, `(firewall-cmd|systemctl)\s+`, nocase) and
        re.regex($e.principal.process.command_line, `(--add-port|--add-service|--remove-service|--zone=drop|--set-default-zone|stop\s+firewalld|disable\s+firewalld)`, nocase)
      )
      or
      // macOS - pfctl disable or flush
      (
        re.regex($e.principal.process.command_line, `pfctl\s+`, nocase) and
        re.regex($e.principal.process.command_line, `(-d|-F\s+(all|rules|nat|queue|state|info|Tables|osfp)|-f\s+/dev/null)`, nocase)
      )
      or
      // macOS - socketfilterfw disable
      (
        re.regex($e.principal.process.command_line, `socketfilterfw\s+`, nocase) and
        re.regex($e.principal.process.command_line, `(--setglobalstate\s+off|--setblockall\s+off|--setstealthmode\s+off|--remove)`, nocase)
      )
      or
      // ESXi - esxcli firewall manipulation
      (
        re.regex($e.principal.process.command_line, `esxcli\s+network\s+firewall`, nocase) and
        re.regex($e.principal.process.command_line, `(set\s+--enabled\s+(false|0)|ruleset\s+set\s+--allowed-all\s+true|ruleset\s+set\s+--enabled\s+false|unload)`, nocase)
      )
      or
      // ESXi - vim-cmd or direct config modification for firewall
      (
        re.regex($e.principal.process.command_line, `(vim-cmd\s+hostsvc/firewall|esxcfg-firewall)`, nocase) and
        re.regex($e.principal.process.command_line, `(-d|--disable|--allowIncoming|--allowOutgoing|--openPort)`, nocase)
      )
      or
      // Network devices - common CLI patterns for disabling firewall/ACL
      (
        re.regex($e.principal.process.command_line, `(no\s+ip\s+(access-list|inspect|firewall)|no\s+firewall|set\s+security-policy\s+disable)`, nocase)
      )
    )

  condition:
    $e
}
