/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:18:56.188807+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1685_004_Disable_or_Modify_Linux_Audit_System_Log {

  meta:
    author = "TELUS Detection Engineering"
    description = "Detects attempts to disable or modify the Linux Audit system (auditd) including stopping the service, killing the daemon, modifying audit rules/config files, or using auditctl to disable logging. Indicative of T1685.004 Defense Impairment activity."
    mitre_attack_technique = "T1685.004 - Disable or Modify Linux Audit System Log"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    false_positive = "Legitimate system administrators performing authorized audit configuration changes, automated configuration management tools (Ansible, Puppet, Chef) modifying audit rules, OS patching processes that restart auditd, and security hardening scripts that reconfigure audit rules."
    platform = "Linux"
    rule_version = "1.0"
    created = "2025-01-01"

  events:

    // Pattern 1: Stopping or disabling auditd via systemctl or service command
    (
      $e1.metadata.event_type = "PROCESS_LAUNCH" and
      (
        (
          re:match($e1.principal.process.command_line, `systemctl\s+(stop|disable|mask|kill)\s+audit`, nocase) or
          re:match($e1.principal.process.command_line, `service\s+auditd?\s+(stop|disable|kill)`, nocase)
        ) or
        // Pattern 2: Killing auditd process directly
        (
          re:match($e1.principal.process.command_line, `kill\s+.*auditd`, nocase) or
          re:match($e1.principal.process.command_line, `killall\s+.*auditd`, nocase) or
          re:match($e1.principal.process.command_line, `pkill\s+.*auditd`, nocase)
        ) or
        // Pattern 3: auditctl used to disable logging or remove all rules
        (
          re:match($e1.principal.process.command_line, `auditctl\s+.*-e\s+0`, nocase) or
          re:match($e1.principal.process.command_line, `auditctl\s+.*-D`, nocase) or
          re:match($e1.principal.process.command_line, `auditctl\s+.*--backlog-limit\s+0`, nocase) or
          re:match($e1.principal.process.command_line, `auditctl\s+.*-b\s+0`, nocase)
        ) or
        // Pattern 4: Overwriting or truncating audit rules/config files via shell redirection
        (
          re:match($e1.principal.process.command_line, `>\s*/etc/audit/audit\.rules`, nocase) or
          re:match($e1.principal.process.command_line, `>\s*/etc/audit/auditd\.conf`, nocase) or
          re:match($e1.principal.process.command_line, `>\s*/etc/audit/rules\.d/`, nocase) or
          re:match($e1.principal.process.command_line, `truncate\s+.*(/etc/audit/audit\.rules|/etc/audit/auditd\.conf)`, nocase) or
          re:match($e1.principal.process.command_line, `shred\s+.*(/etc/audit/audit\.rules|/etc/audit/auditd\.conf)`, nocase)
        ) or
        // Pattern 5: Using sed/awk/perl to modify audit config files inline
        (
          re:match($e1.principal.process.command_line, `(sed|awk|perl)\s+.*-i.*(/etc/audit/audit\.rules|/etc/audit/auditd\.conf|/etc/audit/rules\.d/)`, nocase)
        ) or
        // Pattern 6: Removing audit rules files
        (
          re:match($e1.principal.process.command_line, `rm\s+.*(/etc/audit/audit\.rules|/etc/audit/auditd\.conf|/etc/audit/rules\.d/)`, nocase)
        ) or
        // Pattern 7: chmod/chattr to lock out audit config or logs
        (
          re:match($e1.principal.process.command_line, `chattr\s+.*\+i\s+.*/etc/audit/`, nocase) or
          re:match($e1.principal.process.command_line, `chmod\s+.*000\s+.*/etc/audit/`, nocase) or
          re:match($e1.principal.process.command_line, `chmod\s+.*000\s+.*/var/log/audit/`, nocase)
        )
      )
    )

    or

    // Pattern 8: Direct file modification of audit rules or configuration
    (
      $e1.metadata.event_type = "FILE_CREATION" and
      (
        re:match($e1.target.file.full_path, `/etc/audit/audit\.rules`, nocase) or
        re:match($e1.target.file.full_path, `/etc/audit/auditd\.conf`, nocase) or
        re:match($e1.target.file.full_path, `/etc/audit/rules\.d/.*\.rules`, nocase)
      )
    )

  condition:
    $e1

}
