/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:17:41.955155+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1685_Disable_or_Modify_Tools {

  meta:
    author = "TELUS Detection Engineering"
    description = "Detects attempts to disable, stop, or tamper with security tools including EDR agents, antivirus services, logging agents, Sysmon, and ETW providers. Covers process kills, service stops, registry modifications, and configuration file deletions targeting known defensive tooling."
    mitre_attack_technique = "T1685 - Disable or Modify Tools"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    false_positive = "Legitimate IT administration tasks such as security tool upgrades, maintenance windows, or authorized uninstall procedures may trigger this rule. Validate against change management records and authorized admin accounts."
    rule_version = "1.0"
    platform = "Windows, Linux, macOS, Containers, ESXi"

  events:

    // Event 1: Process launch targeting security tool processes or services
    (
      $e1.metadata.event_type = "PROCESS_LAUNCH"
      and
      (
        // Stopping security services via sc.exe, net.exe, or systemctl
        (
          re:match($e1.principal.process.command_line, `(sc\.exe|sc)\s+(stop|delete|config|failure)\s+`, nocase)
          and
          re:match($e1.principal.process.command_line, `(sense|windefend|mssecflt|mssense|csfalconservice|csagent|carbonblack|cb|cylance|cyserver|cyoptics|cyupdate|mfemms|mfevtp|ekrn|eset|bdagent|bdredline|sophos|savservice|sav|tmccsf|tmlisten|ntrtscan|ds_agent|qualys|tanium|crowdstrike|sentinel|sysmon|eventlog|wecsvc|wevtsvc|splunkforwarder|nxlog|filebeat|winlogbeat|elastic|logstash|ossec|wazuh|syslog|auditd|tenable|nessus|rapid7|insight|cylanceprotect|malwarebytes|mbam|avast|avg|mcafee|symantec|norton|kaspersky|sophos|trend|panda|webroot|bitdefender|fsecure|comodo|drweb)`, nocase)
        )
        or
        // Killing security tool processes via taskkill
        (
          re:match($e1.principal.process.command_line, `taskkill\s+.*(\/f|\/im|\/pid)`, nocase)
          and
          re:match($e1.principal.process.command_line, `(mssense|msmpeng|mpcmdrun|nissrv|sense|csfalcon|csagent|cb\.exe|cbdefense|cylance|cyoptics|ekrn|egui|bdagent|sophosav|savservice|tmccsf|tmlisten|ntrtscan|ds_agent|qualys|tanium|sentinelone|sysmon|splunkd|nxlog|filebeat|winlogbeat|elastic|wazuh|ossec|tenable|nessus|rapid7|malwarebytes|avast|avg|mcafee|symantec|kaspersky|bitdefender|comodo|drweb)`, nocase)
        )
        or
        // Linux/macOS service stop targeting security tools
        (
          re:match($e1.principal.process.command_line, `(systemctl|service|launchctl)\s+(stop|disable|unload|kill|mask)\s+`, nocase)
          and
          re:match($e1.principal.process.command_line, `(auditd|syslog|rsyslog|syslog-ng|ossec|wazuh|filebeat|elastic|splunk|nxlog|crowdstrike|falcon|sentinelone|cbdaemon|carbonblack|cylance|qualys|nessus|tenable|rapid7|clamav|sophos|trend|symantec|mcafee|eset|bitdefender|comodo|sysmon)`, nocase)
        )
        or
        // ETW provider disabling or event log manipulation
        (
          re:match($e1.principal.process.command_line, `(wevtutil|auditpol|logman)\s+`, nocase)
          and
          re:match($e1.principal.process.command_line, `(cl|clear|sl|set-log|delete|stop|disable|update)\s+`, nocase)
          and
          re:match($e1.principal.process.command_line, `(security|system|application|microsoft-windows-sysmon|microsoft-windows-windows defender|microsoft-windows-sense|microsoft-windows-etw|powershell|windefend)`, nocase)
        )
        or
        // PowerShell disabling Windows Defender or security features
        (
          re:match($e1.principal.process.command_line, `(Set-MpPreference|Add-MpPreference|Remove-MpPreference|Disable-WindowsOptionalFeature|Uninstall-WindowsFeature)`, nocase)
          and
          re:match($e1.principal.process.command_line, `(DisableRealtimeMonitoring|DisableBehaviorMonitoring|DisableBlockAtFirstSeen|DisableIOAVProtection|DisableScriptScanning|DisableAntiSpyware|DisableAntiVirus|ExclusionPath|ExclusionProcess|ExclusionExtension|SignatureDisableUpdateOnStartupWithoutEngine)`, nocase)
        )
        or
        // Unloading or deleting Sysmon driver
        (
          re:match($e1.principal.process.command_line, `sysmon(64)?(\.(exe|sys))?\s+(-u|-uninstall)`, nocase)
        )
        or
        // Disabling ETW via registry or command line patching references
        (
          re:match($e1.principal.process.command_line, `(reg\s+(add|delete|import)|regsvr32|rundll32)\s+`, nocase)
          and
          re:match($e1.principal.process.command_line, `(ETW|EventLog|DiagnosticLog|WinDefend|SecurityHealth|Sense|MpsSvc|SharedAccess|WdFilter|WdNisSvc|WdNisDrv|WdBoot|mpssvc|bfe)`, nocase)
        )
      )
    )

    or

    // Event 2: Registry modification targeting security tool configuration or disablement
    (
      $e2.metadata.event_type = "REGISTRY_MODIFICATION"
      and
      (
        re:match($e2.target.registry.registry_key, `(HKLM|HKCU)\\(SOFTWARE|SYSTEM)\\`, nocase)
        and
        re:match($e2.target.registry.registry_key, `(Windows Defender|WinDefend|Sense|MsSense|CrowdStrike|CarbonBlack|Cylance|SentinelOne|Sophos|Symantec|McAfee|Kaspersky|ESET|Bitdefender|Malwarebytes|Sysmon|EventLog|DiagnosticLog|ETW|SecurityCenter|SecurityCenter2|MpEngine|SpyNet|Real-Time Protection|Antivirus|AntiSpyware|AntiMalware|Policies\\Microsoft\\Windows Defender|Policies\\Microsoft\\Windows Advanced Threat Protection)`, nocase)
      )
    )

    or

    // Event 3: File deletion or modification targeting security tool configuration files
    (
      $e3.metadata.event_type = "FILE_CREATION"
      and
      (
        re:match($e3.target.file.full_path, `(sysmon|ossec|wazuh|auditd|rsyslog|syslog|filebeat|winlogbeat|nxlog|splunk|elastic|crowdstrike|sentinelone|carbonblack|cylance|qualys|nessus|tenable|rapid7|malwarebytes|defender|mcafee|symantec|kaspersky|sophos|eset|bitdefender|comodo)`, nocase)
        and
        re:match($e3.target.file.full_path, `\.(conf|cfg|config|xml|json|yml|yaml|ini|log|db|dat|sys|dll|exe)$`, nocase)
      )
    )

  condition:
    $e1 or $e2 or $e3

}
