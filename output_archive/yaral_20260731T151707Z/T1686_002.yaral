/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:20:38.880267+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1686_002_Network_Device_Firewall {

  meta:
    author = "TELUS Threat Detection Engineering"
    description = "Detects potential network device firewall manipulation including ACL modifications, firewall rule changes, security zone alterations, or disabling of firewall mechanisms on network infrastructure devices. Covers T1686.002 - Network Device Firewall under Defense Impairment."
    mitre_attack_technique = "T1686.002 - Network Device Firewall"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    false_positive = "Legitimate network administrators performing authorized firewall rule changes, scheduled maintenance windows, automated network configuration management tools (e.g., Ansible, Terraform), and CI/CD pipeline network provisioning may trigger this rule. Validate against change management records."
    version = "1.0"
    created = "2025-01-01"
    platform = "Network Devices"

  events:

    // Event 1: Process-based firewall rule modification commands on network devices or management hosts
    (
      $e1.metadata.event_type = "PROCESS_LAUNCH" AND
      (
        // Cisco IOS / IOS-XE style ACL and firewall commands
        re.regex($e1.principal.process.command_line, `(no\s+access-list|no\s+ip\s+access-list|no\s+ipv6\s+access-list)`) nocase OR
        re.regex($e1.principal.process.command_line, `(permit\s+any\s+any|deny\s+any\s+any)`) nocase OR
        re.regex($e1.principal.process.command_line, `(no\s+firewall|firewall\s+disable|no\s+zone-based|no\s+zone\s+security)`) nocase OR
        re.regex($e1.principal.process.command_line, `(no\s+ip\s+inspect|no\s+service\s+firewall)`) nocase OR
        // Juniper / Palo Alto / generic firewall CLI patterns
        re.regex($e1.principal.process.command_line, `(delete\s+firewall|deactivate\s+firewall|set\s+firewall\s+disable)`) nocase OR
        re.regex($e1.principal.process.command_line, `(delete\s+security\s+policies|delete\s+security\s+zones)`) nocase OR
        // iptables / nftables on Linux-based network devices
        re.regex($e1.principal.process.command_line, `(iptables\s+-F|iptables\s+--flush|ip6tables\s+-F|ip6tables\s+--flush)`) nocase OR
        re.regex($e1.principal.process.command_line, `(iptables\s+-P\s+(INPUT|OUTPUT|FORWARD)\s+ACCEPT)`) nocase OR
        re.regex($e1.principal.process.command_line, `(nft\s+flush\s+ruleset|nft\s+delete\s+table)`) nocase OR
        re.regex($e1.principal.process.command_line, `(ufw\s+disable|ufw\s+reset|firewall-cmd\s+--panic-off)`) nocase OR
        re.regex($e1.principal.process.command_line, `(firewall-cmd\s+--remove-rule|firewall-cmd\s+--remove-rich-rule)`) nocase OR
        // Windows Firewall manipulation
        re.regex($e1.principal.process.command_line, `(netsh\s+advfirewall\s+set\s+allprofiles\s+state\s+off)`) nocase OR
        re.regex($e1.principal.process.command_line, `(netsh\s+firewall\s+set\s+opmode\s+disable)`) nocase OR
        re.regex($e1.principal.process.command_line, `(Set-NetFirewallProfile.*-Enabled\s+False)`) nocase OR
        re.regex($e1.principal.process.command_line, `(netsh\s+advfirewall\s+firewall\s+delete\s+rule)`) nocase OR
        re.regex($e1.principal.process.command_line, `(netsh\s+advfirewall\s+firewall\s+add\s+rule.*allow.*any)`) nocase OR
        // SCM / service stop for firewall services
        re.regex($e1.principal.process.command_line, `(sc\s+(stop|config)\s+(mpssvc|SharedAccess|MpsSvc))`) nocase OR
        re.regex($e1.principal.process.command_line, `(Stop-Service\s+.*(mpssvc|SharedAccess|firewall))`) nocase
      )
    )

    OR

    // Event 2: Registry modification disabling Windows Firewall
    (
      $e1.metadata.event_type = "REGISTRY_MODIFICATION" AND
      (
        re.regex($e1.target.registry.registry_key, `HKLM\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy`) nocase OR
        re.regex($e1.target.registry.registry_key, `HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall`) nocase OR
        re.regex($e1.target.registry.registry_key, `HKLM\\SYSTEM\\CurrentControlSet\\Services\\MpsSvc`) nocase
      )
    )

    OR

    // Event 3: Network connection to management interfaces of network devices from unusual sources
    (
      $e1.metadata.event_type = "NETWORK_CONNECTION" AND
      (
        // SSH/Telnet/NETCONF/RESTCONF to network device management ports
        $e1.target.port = 22 OR
        $e1.target.port = 23 OR
        $e1.target.port = 830 OR
        $e1.target.port = 443 OR
        $e1.target.port = 8443
      ) AND
      (
        re.regex($e1.principal.process.file.full_path, `(ssh|telnet|netconf|curl|wget|python|perl|ruby|nmap|nc|netcat)`) nocase OR
        re.regex($e1.target.process.file.full_path, `(ssh|telnet|netconf|curl|wget|python|perl|ruby|nmap|nc|netcat)`) nocase
      )
    )

    OR

    // Event 4: File creation of scripts targeting firewall configuration paths
    (
      $e1.metadata.event_type = "FILE_CREATION" AND
      (
        re.regex($e1.target.file.full_path, `(/etc/iptables|/etc/nftables|/etc/firewalld|/etc/ufw)`) nocase OR
        re.regex($e1.target.file.full_path, `(firewall.*\.(sh|py|pl|ps1|bat|cmd))`) nocase OR
        re.regex($e1.target.file.full_path, `(acl.*\.(cfg|conf|txt)|access-list.*\.(cfg|conf|txt))`) nocase
      )
    )

  condition:
    $e1

}
