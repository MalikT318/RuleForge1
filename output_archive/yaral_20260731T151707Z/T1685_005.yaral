/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:19:09.016585+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1685_005_Clear_Windows_Event_Logs {
  meta:
    author = "TELUS Detection Engineering"
    description = "Detects attempts to clear Windows Event Logs via wevtutil, PowerShell Remove-EventLog, or direct deletion of .evtx log files. Covers T1685.005 - Clear Windows Event Logs."
    mitre_attack_technique = "T1685.005 - Clear Windows Event Logs"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    false_positive = "Legitimate system administrators may clear event logs during maintenance. Verify the user context, time of day, and whether a change ticket exists. SIEM or log management tools may also rotate or archive logs."
    platform = "Windows"
    rule_version = "1.0"
    created = "2024-01-01"

  events:
    // Branch 1: wevtutil cl <logname> command execution
    (
      $e1.metadata.event_type = "PROCESS_LAUNCH" and
      (
        re:regex($e1.target.process.file.full_path, `(?i)(\\|/)wevtutil(\.exe)?$`) or
        re:regex($e1.principal.process.command_line, `(?i)wevtutil`)
      ) and
      re:regex($e1.target.process.command_line, `(?i)\bcl\b|\bclear-log\b`) and
      re:regex($e1.target.process.command_line, `(?i)(system|application|security|setup|forwardedevents|hardwareevent|internet\s+explorer|windows\s+powershell|microsoft-windows)`)
    )
    or
    // Branch 2: PowerShell Remove-EventLog or Clear-EventLog
    (
      $e1.metadata.event_type = "PROCESS_LAUNCH" and
      re:regex($e1.target.process.command_line, `(?i)(Remove-EventLog|Clear-EventLog)`) and
      re:regex($e1.target.process.command_line, `(?i)-LogName\s+(Security|System|Application|Setup|ForwardedEvents|HardwareEvents)`)
    )
    or
    // Branch 3: PowerShell [System.Diagnostics.EventLog]::Delete or ::Clear
    (
      $e1.metadata.event_type = "PROCESS_LAUNCH" and
      re:regex($e1.target.process.command_line, `(?i)\[System\.Diagnostics\.EventLog\]::(Delete|Clear)\s*\(`)
    )
    or
    // Branch 4: Direct deletion of .evtx files from the Windows event log directory
    (
      $e1.metadata.event_type = "FILE_CREATION" and
      re:regex($e1.target.file.full_path, `(?i)\\Windows\\System32\\winevt\\[Ll]ogs\\.*\.evtx$`)
    )

  condition:
    $e1
}
