/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:18:37.789046+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1685_003_Modify_or_Spoof_Tool_UI {

  meta:
    author = "TELUS Detection Engineering"
    description = "Detects attempts to spoof or manipulate security tool user interfaces (e.g., Windows Security, EDR tray icons) to falsely indicate healthy status after disabling or tampering with underlying defenses. Adversaries may launch fake UI processes, modify registry keys controlling security tool display, or create files mimicking legitimate security tool executables."
    mitre_attack_technique = "T1685.003 - Modify or Spoof Tool UI"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    false_positive = "Legitimate security software updates or reinstallations may trigger registry or file writes to security tool paths. Security administrators testing UI components may also match. Validate process lineage and signing status."
    version = "1.0"
    created = "2025-01-01"
    platform = "Windows, Linux, macOS"

  events:

    // Event 1: Process launch mimicking or spoofing a known security tool UI
    // Detects processes with names matching security tool UI components
    // launched from suspicious or non-standard parent paths
    $proc_spoof = /./
    $proc_spoof.metadata.event_type = "PROCESS_LAUNCH"
    (
      re.regex($proc_spoof.target.process.file.full_path, `(?i)(windowssecurityapp|securityhealthsystray|securityhealthservice|msmpeng|msseces|egui|ekrn|bdagent|csc\.exe|avgui|avastui|mbam|mbamtray|sophosui|cylancesvc|carbonblack|cbdefense|sentinelone|s1agent|falconhost|csfalcon)`) nocase
      or
      re.regex($proc_spoof.principal.process.command_line, `(?i)(--fake|--spoof|--mock|--simulate|--headless.*security|--no-real|fakeav|spoofui|mockdefender)`) nocase
    )
    re.regex($proc_spoof.principal.process.file.full_path, `(?i)(temp|appdata\\local\\temp|programdata\\[^\\]{1,20}\\temp|users\\public|downloads|\\$recycle\.bin)`) nocase

    // Event 2: Registry modification to security tool display or notification keys
    // Adversaries may alter registry values that control security center status or tray icon behavior
    $reg_mod = /./
    $reg_mod.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      re.regex($reg_mod.target.registry.registry_key, `(?i)(\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run.*security|\\SOFTWARE\\Microsoft\\Security Center|\\SOFTWARE\\Microsoft\\Windows Defender|\\SOFTWARE\\Policies\\Microsoft\\Windows Defender|\\SYSTEM\\CurrentControlSet\\Services\\(WinDefend|SecurityHealthService|wscsvc|Sense|MsMpSvc)|\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings.*security|\\SOFTWARE\\Microsoft\\Windows Security Health)`) nocase
    )
    re.regex($reg_mod.principal.process.file.full_path, `(?i)(temp|appdata\\local\\temp|programdata\\[^\\]{1,20}\\temp|users\\public|downloads|\\$recycle\.bin|cmd\.exe|powershell\.exe|wscript\.exe|cscript\.exe|mshta\.exe|rundll32\.exe|regsvr32\.exe)`) nocase

    // Event 3: File creation mimicking security tool executables or UI assets
    // Adversaries may drop fake executables or DLLs with names matching legitimate security tools
    $file_create = /./
    $file_create.metadata.event_type = "FILE_CREATION"
    (
      re.regex($file_create.target.file.full_path, `(?i)(windowssecurityapp\.exe|securityhealthsystray\.exe|msmpeng\.exe|msseces\.exe|egui\.exe|bdagent\.exe|avgui\.exe|avastui\.exe|mbamtray\.exe|sophosui\.exe|s1agent\.exe|falconhost\.exe|csfalcon\.exe|cbdefense\.exe)`) nocase
    )
    NOT re.regex($file_create.target.file.full_path, `(?i)(\\Program Files\\|\\Program Files \(x86\)\\|\\Windows\\|\\ProgramData\\Microsoft\\Windows Defender\\|\\ProgramData\\Sophos\\|\\ProgramData\\CarbonBlack\\|\\ProgramData\\SentinelOne\\|\\ProgramData\\CrowdStrike\\)`) nocase

  condition:
    $proc_spoof or $reg_mod or $file_create

}
