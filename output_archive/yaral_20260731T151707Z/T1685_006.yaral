/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:19:31.336822+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1685_006_Clear_Linux_or_Mac_System_Logs {

  meta:
    author = "TELUS Detection Engineering"
    description = "Detects attempts to clear or truncate Linux/macOS system logs under /var/log/ via process execution, file truncation, or deletion commands. Adversaries clear logs to hide evidence of intrusion activity."
    mitre_attack_technique = "T1685.006 - Clear Linux or Mac System Logs"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    platforms = "Linux, macOS"
    false_positive = "Legitimate log rotation tools (logrotate, newsyslog), system administrators performing manual log maintenance, or backup/archival scripts may trigger this rule. Validate against scheduled maintenance windows and authorized admin activity."
    version = "1.0"
    created = "2024-01-01"

  events:

    // Event 1: Process-based log clearing via shell commands (truncate, shred, rm, cat /dev/null)
    $proc_clear.metadata.event_type = "PROCESS_LAUNCH"
    (
      // Truncate command targeting /var/log
      re.regex($proc_clear.principal.process.command_line, `truncate\s+.*(-s\s*0|--size[=\s]+0).*\/var\/log\/`) nocase or
      re.regex($proc_clear.principal.process.command_line, `truncate\s+.*\/var\/log\/.*(-s\s*0|--size[=\s]+0)`) nocase or

      // cat /dev/null redirect to log file
      re.regex($proc_clear.principal.process.command_line, `cat\s+\/dev\/null\s*>\s*\/var\/log\/`) nocase or
      re.regex($proc_clear.principal.process.command_line, `>\s*\/var\/log\/[^\s]+\.(log|txt|1|0|gz)?`) nocase or

      // echo empty string redirect to log file
      re.regex($proc_clear.principal.process.command_line, `echo\s+['"]{2}\s*>\s*\/var\/log\/`) nocase or
      re.regex($proc_clear.principal.process.command_line, `echo\s+-n\s+['"]{0,2}\s*>\s*\/var\/log\/`) nocase or

      // shred targeting /var/log
      re.regex($proc_clear.principal.process.command_line, `shred\s+.*(\/var\/log\/)`) nocase or

      // rm targeting specific log files under /var/log
      re.regex($proc_clear.principal.process.command_line, `rm\s+(-[rfv]+\s+)?(\/var\/log\/(messages|secure|auth\.log|syslog|kern\.log|cron\.log|maillog|wtmp|utmp|btmp|lastlog|httpd|nginx|apache2|audit\/audit\.log))`) nocase or

      // dd to zero out log files
      re.regex($proc_clear.principal.process.command_line, `dd\s+.*if=\/dev\/(zero|null).*of=\/var\/log\/`) nocase or

      // Python/Perl one-liners to clear log files
      re.regex($proc_clear.principal.process.command_line, `(python[23]?|perl)\s+.*open\s*\(.*\/var\/log\/.*['"]\s*,\s*['"]w['"]`) nocase or

      // install command to zero out log (install -m with /dev/null)
      re.regex($proc_clear.principal.process.command_line, `install\s+.*\/dev\/null\s+\/var\/log\/`) nocase or

      // tee with /dev/null to clear
      re.regex($proc_clear.principal.process.command_line, `tee\s+\/var\/log\/[^\s]+\s*<\s*\/dev\/null`) nocase or

      // macOS specific: log erase or syslog -k
      re.regex($proc_clear.principal.process.command_line, `log\s+erase\s+(--all|--predicate)`) nocase or
      re.regex($proc_clear.principal.process.command_line, `syslog\s+.*-k\s+.*Time\s+ge`) nocase or

      // journalctl vacuum (systemd journal clearing)
      re.regex($proc_clear.principal.process.command_line, `journalctl\s+.*(--rotate|--vacuum-time|--vacuum-size|--flush)`) nocase or
      re.regex($proc_clear.principal.process.command_line, `journalctl\s+.*-m\s*0`) nocase or

      // auditd log clearing
      re.regex($proc_clear.principal.process.command_line, `(aureport|auditctl|ausearch)\s+.*--reset`) nocase or

      // Direct wipe of audit log
      re.regex($proc_clear.principal.process.command_line, `>\s*\/var\/log\/audit\/audit\.log`) nocase
    )

  condition:
    $proc_clear

}
