/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:20:13.052328+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1686_001_Cloud_Firewall {

  meta:
    author = "TELUS Detection Engineering"
    description = "Detects adversarial modification or disabling of cloud firewall rules, security groups, or network ACLs that may allow unrestricted or overly permissive inbound/outbound access to cloud-hosted resources. Covers creation of permissive ingress rules, deletion of existing firewall rules, and modification of security group policies in IaaS environments."
    mitre_attack_technique = "T1686.001 - Cloud Firewall"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    false_positive = "Legitimate cloud infrastructure automation (Terraform, CloudFormation, Ansible), authorized security group changes by cloud admins, CI/CD pipeline deployments modifying firewall rules. Tune by excluding known automation service accounts and approved change windows."
    platform = "IaaS"
    reference = "https://attack.mitre.org/techniques/T1686/001/"
    rule_version = "1.0"

  events:

    // Event 1: Detect cloud API calls that create, modify, or delete firewall/security group rules
    $api_call.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    (
      // AWS security group ingress/egress rule modifications
      re.regex($api_call.target.resource.name, `(?i)(AuthorizeSecurityGroupIngress|AuthorizeSecurityGroupEgress|RevokeSecurityGroupIngress|RevokeSecurityGroupEgress|CreateSecurityGroup|DeleteSecurityGroup|ModifySecurityGroupRules)`) or
      // GCP firewall rule modifications
      re.regex($api_call.target.resource.name, `(?i)(firewalls\.insert|firewalls\.patch|firewalls\.delete|firewalls\.update|networks\.updatePolicy)`) or
      // Azure NSG / firewall modifications
      re.regex($api_call.target.resource.name, `(?i)(networkSecurityGroups|securityRules|azureFirewalls|firewallPolicies)`) or
      // Generic cloud firewall keywords
      re.regex($api_call.target.resource.name, `(?i)(firewall.rule|security.group|network.acl|inbound.rule|outbound.rule)`)
    )

    // Event 2: Detect process-level CLI commands used to modify cloud firewall rules
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      // AWS CLI firewall modifications
      re.regex($proc.principal.process.command_line, `(?i)aws\s+ec2\s+(authorize|revoke|create|delete|modify)[\s\-]+(security.group|ingress|egress)`) or
      // GCP gcloud firewall modifications
      re.regex($proc.principal.process.command_line, `(?i)gcloud\s+(compute\s+firewall.rules|compute\s+networks)\s+(create|update|delete|patch)`) or
      // Azure CLI firewall modifications
      re.regex($proc.principal.process.command_line, `(?i)az\s+(network\s+nsg|network\s+firewall|network\s+vnet)\s+(rule\s+)?(create|update|delete|add)`) or
      // Permissive CIDR patterns indicating wide-open rules (0.0.0.0/0 or ::/0)
      re.regex($proc.principal.process.command_line, `(?i)(0\.0\.0\.0\/0|::\/0).*(ingress|inbound|allow|permit|open|any)`) or
      re.regex($proc.principal.process.command_line, `(?i)(ingress|inbound|allow|permit|open|any).*(0\.0\.0\.0\/0|::\/0)`)
    )

    // Correlate both events to the same user principal within a 5-minute window
    $api_call.principal.user.userid = $proc.principal.user.userid

  condition:
    $api_call and $proc

}
