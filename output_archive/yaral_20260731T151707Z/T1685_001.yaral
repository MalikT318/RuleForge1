/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-07-31T15:17:58.839641+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
*/

rule TELUS_T1685_001_Disable_or_Modify_Windows_Event_Log {
  meta:
    author = "TELUS Security Operations"
    description = "Detects attempts to disable or modify the Windows Event Log service or audit policy via command-line tools, PowerShell, registry modification, or service control commands. Covers T1685.001 - Disable or Modify Windows Event Log."
    mitre_attack_technique = "T1685.001 - Disable or Modify Windows Event Log"
    mitre_attack_tactic = "Defense Impairment"
    severity = "HIGH"
    false_positive = "Legitimate system administrators may disable or reconfigure the EventLog service during maintenance windows or audit policy changes. Verify with change management records. Security tooling and endpoint management platforms may also invoke auditpol.exe or sc.exe legitimately."
    platform = "Windows"
    version = "1.0"
    created = "2025-01-01"

  events:
    (
      // Detect PowerShell commands to stop or disable the EventLog service
      $e1.metadata.event_type = "PROCESS_LAUNCH" and
      (
        (
          re.regex($e1.target.process.file.full_path, `(?i)(powershell\.exe|pwsh\.exe)$`) and
          (
            re.regex($e1.principal.process.command_line, `(?i)Set-Service\s+.*EventLog.*(-Status\s+Stopped|-StartupType\s+Disabled)`) or
            re.regex($e1.principal.process.command_line, `(?i)Stop-Service\s+.*EventLog`) or
            re.regex($e1.principal.process.command_line, `(?i)Set-Service\s+.*-Name\s+EventLog`) or
            re.regex($e1.target.process.command_line, `(?i)Set-Service\s+.*EventLog.*(-Status\s+Stopped|-StartupType\s+Disabled)`) or
            re.regex($e1.target.process.command_line, `(?i)Stop-Service\s+.*EventLog`) or
            re.regex($e1.target.process.command_line, `(?i)Set-Service\s+.*-Name\s+EventLog`)
          )
        ) or
        // Detect sc.exe disabling the EventLog service
        (
          re.regex($e1.target.process.file.full_path, `(?i)(\\sc\.exe)$`) and
          (
            re.regex($e1.target.process.command_line, `(?i)sc\s+(config|stop)\s+eventlog`) or
            re.regex($e1.principal.process.command_line, `(?i)sc\s+(config|stop)\s+eventlog`)
          )
        ) or
        // Detect net.exe stopping the EventLog service
        (
          re.regex($e1.target.process.file.full_path, `(?i)(\\net\.exe|\\net1\.exe)$`) and
          (
            re.regex($e1.target.process.command_line, `(?i)net\s+stop\s+eventlog`) or
            re.regex($e1.principal.process.command_line, `(?i)net\s+stop\s+eventlog`)
          )
        ) or
        // Detect auditpol.exe clearing or disabling audit policies
        (
          re.regex($e1.target.process.file.full_path, `(?i)(\\auditpol\.exe)$`) and
          (
            re.regex($e1.target.process.command_line, `(?i)auditpol\s+.*(\/clear|\/remove|\/set.*disable|\/set.*no auditing)`) or
            re.regex($e1.principal.process.command_line, `(?i)auditpol\s+.*(\/clear|\/remove|\/set.*disable|\/set.*no auditing)`)
          )
        ) or
        // Detect wevtutil.exe clearing or disabling event logs
        (
          re.regex($e1.target.process.file.full_path, `(?i)(\\wevtutil\.exe)$`) and
          (
            re.regex($e1.target.process.command_line, `(?i)wevtutil\s+(cl|clear-log|sl|set-log)\s+`) or
            re.regex($e1.principal.process.command_line, `(?i)wevtutil\s+(cl|clear-log|sl|set-log)\s+`)
          )
        )
      )
    ) or
    // Detect registry modification to disable EventLog service startup
    (
      $e1.metadata.event_type = "REGISTRY_MODIFICATION" and
      re.regex($e1.target.registry.registry_key, `(?i)HKEY_LOCAL_MACHINE\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Services\\EventLog`) and
      re.regex($e1.target.registry.registry_key, `(?i)\\Start$`)
    )

  condition:
    $e1
}
