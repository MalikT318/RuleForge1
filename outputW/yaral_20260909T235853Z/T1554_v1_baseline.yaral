/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:06:50.279915+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_001_Host_Software_Binary_Compromise {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of executable binaries in trusted system or application directories by processes that are not expected to write to those locations. Adversaries replace or patch legitimate binaries (browsers, SSH clients, FTP clients, email clients, system utilities) to establish persistence or harvest credentials. The rule fires when a non-installer, non-updater process writes a PE-extension file into a Program Files or Windows system path."
    mitre_tactic    = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "Requires EDR or Sysmon file-write telemetry producing FILE_MODIFICATION or FILE_CREATION events with principal process path and target file path populated."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers (msiexec, setup.exe, update.exe), patch management agents, software deployment tools (SCCM, Intune), antivirus signature updates, and developer build pipelines writing compiled output."
    tuning_guidance = "Add known-good installer and updater binaries to %global_allowed_admin_tools. Add patch/deployment service accounts to %global_allowed_service_accounts. Narrow the target path regex if specific application directories generate noise."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target must be an executable or library in a trusted system/application path
    $file.target.file.full_path = /(?i)^[A-Za-z]:\\(Windows\\(System32|SysWOW64|explorer\.exe)|Program Files( \(x86\))?\\[^\\]+\\[^\\]+)\.(exe|dll|sys|ocx|cpl|scr|com)$/

    // Writing process must NOT itself reside in a recognised system or installer location
    not $file.principal.process.file.full_path = /(?i)^[A-Za-z]:\\Windows\\(System32|SysWOW64)\\(msiexec|TrustedInstaller|wusa|wuauclt|svchost|MpSigStub|MpCmdRun|WindowsUpdateBox)\.exe$/

    // Exclude common updater and installer naming patterns in the writing process
    not $file.principal.process.file.full_path = /(?i)(setup|install|update|patch|deploy|uninstall|repair|bootstrap|redist|vcredist|dotnet|ndp|kb[0-9]+)[^\\]*\.exe$/

    // Exclude approved administrative and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved backup and imaging processes
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude approved service accounts performing the write
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude security tools (EDR self-update, AV engine updates)
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score        = max(78)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity    = array_distinct($file.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $modified_binary   = array_distinct($file.target.file.full_path)
    $actor_user        = array_distinct($file.principal.user.userid)

  condition:
    $file
}
