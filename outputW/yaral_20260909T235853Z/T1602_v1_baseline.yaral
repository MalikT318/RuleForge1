/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:18:43.495704+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_Config_Repository_Exfil_Via_SNMP_TFTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential collection of data from network device configuration repositories via management-plane protocols (SNMP, TFTP, SCP, NETCONF). Adversaries abuse these protocols to bulk-retrieve device configurations, routing tables, and credentials from network infrastructure. Fires on connections from non-approved external sources to management-plane ports on network devices."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Requires firewall or perimeter flow logs with source/destination IP, port, and byte-count fields normalised into UDM NETWORK_FLOW or NETWORK_CONNECTION events."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised NMS/SNMP polling systems, scheduled TFTP-based config backups, legitimate SCP-based config management, vulnerability scanners."
    tuning_guidance = "Add authorised management source IPs to %global_allowed_mgmt_sources and approved scanner IPs to %global_allowed_scanners. Raise the network.sent_bytes threshold if large legitimate config transfers are observed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target management-plane ports used to retrieve device configurations:
    // UDP 161 = SNMP GET/WALK, UDP 69 = TFTP, TCP 22 = SSH/SCP config pull,
    // TCP 830 = NETCONF, TCP 443 = RESTCONF/HTTPS management
    (
      $net.target.port = 161 or
      $net.target.port = 69  or
      $net.target.port = 830 or
      $net.target.port = 22  or
      $net.target.port = 443
    )

    // Source must not be an approved management or scanner address
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // Source must not be internal (RFC 1918) - external origin raises fidelity
    not $net.principal.ip in %rfc1918_internal

    // Require meaningful data transfer indicating config retrieval, not just a probe
    $net.network.sent_bytes > 0

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
