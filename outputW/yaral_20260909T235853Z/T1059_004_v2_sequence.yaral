/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:13:05.944214+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_Shell_Script_Drop_Then_Outbound_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a shell script or executable dropped into a world-writable or staging directory on Linux, followed within 5 minutes by an outbound network connection from the same host to a non-internal destination. This pattern is consistent with adversaries using Unix shell scripts to stage and execute payloads that establish command-and-control channels."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (FILE_CREATION) AND firewall or perimeter network flow logs (NETWORK_FLOW or NETWORK_CONNECTION). Both sources must populate principal.hostname consistently for the join to succeed."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate software deployment pipelines writing scripts to /tmp before phoning home for updates; container orchestration agents; vulnerability scanners; backup agents initiating outbound connections after staging files."
    tuning_guidance = "Add known deployment hosts to %global_allowed_script_hosts, approved scanner sources to %global_allowed_scanners, and backup agents to %global_allowed_backup_processes. Narrow the file path regex if staging directories differ per environment."

  events:
    // Event 1: A shell script or executable is written to a world-writable or
    // common staging path on Linux. Pre-filtered to specific high-risk directories
    // to avoid joining against every file write on the system.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/|\/var\/run\/)/ nocase
    $file.target.file.full_path = /\.(sh|bash|py|pl|rb|elf|bin|run|out)$/ nocase
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    // Event 2: An outbound network connection from the same host to a
    // non-internal destination, observed in firewall/perimeter telemetry.
    // Pre-filtered to non-RFC1918 destinations and common C2-capable ports.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    $net.target.port >= 1
    $net.principal.hostname = $hostname

    // Chronological ordering: file drop must precede the outbound connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($hostname)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $file and $net
}
