/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:11:56.461344+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Stored_Data_Manipulation_Suspicious_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious modification of high-value stored data files (Office documents, databases, email stores, configuration files) by processes that are not typical editors or backup tools. Adversaries manipulate stored data to affect business processes, corrupt records, or hide activity."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Data Manipulation: Stored Data Manipulation"
    log_prerequisites = "Requires EDR file telemetry (Sysmon Event ID 11/FileCreate or equivalent EDR file-write events) normalised to UDM FILE_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office applications saving documents, database maintenance tools, email clients, backup software, and software deployment agents writing configuration files."
    tuning_guidance = "Add known-good parent processes (Office suite, database engines, email clients) to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the file extension regex to the data types most relevant to the protected environment."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target high-value stored data file types: Office docs, databases, email stores, config files
    $file.target.file.full_path = /\.(docx?|xlsx?|pptx?|mdb|accdb|sqlite|sqlite3|db|mdf|ldf|pst|ost|eml|msg|csv|json|xml|ini|conf|config|bak)$/ nocase

    // Suspicious initiating processes - scripting engines, shells, and remote execution tools
    // that have no legitimate reason to directly write business data files
    $file.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic|msiexec|installutil|cmstp|msbuild|regasm|regsvcs|forfiles|pcalua|bash|wsl)\.exe$/ nocase

    // Exclude paths that are clearly temp/cache locations used by legitimate apps
    not $file.target.file.full_path = /\\(AppData\\Local\\Temp|Windows\\Temp|ProgramData\\Microsoft\\Windows\\WER)\\/ nocase

    // Exclude known-good backup and admin tooling
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved script hosts (e.g., managed automation)
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_file = array_distinct($file.target.file.full_path)
    $initiating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
