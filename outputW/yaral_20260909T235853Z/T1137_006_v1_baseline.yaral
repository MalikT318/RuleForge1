/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:42:19.624975+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_Addin_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications that register Office add-ins (WLL, XLL, COM, VSTO, Outlook) for persistence. Adversaries abuse add-in registry keys so malicious code executes each time an Office application starts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office add-in installations by IT deployment tools, software vendors (e.g., Adobe Acrobat PDF add-in, antivirus Office integration), or developer workstations installing VSTO/COM add-ins during development."
    tuning_guidance = "Add known-good installer processes (e.g., msiexec.exe invoked by approved deployment tooling) to %global_allowed_admin_tools. Add authorised service accounts performing software deployment to %global_allowed_service_accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the canonical registry paths used by all major Office add-in types:
    // - HKCU/HKLM Office\Word\Addins, Excel\Addins, Outlook\Addins, PowerPoint\Addins (COM/VSTO add-ins)
    // - HKCU/HKLM Office\<version>\Excel\Options OPEN keys (XLL/WLL auto-open)
    // - HKCU/HKLM Office\<version>\Word\Options STARTUP (WLL path)
    // - HKCU/HKLM Office\<version>\Outlook\Addins (Outlook COM add-ins)
    $reg.target.registry.registry_key = /\\Software\\(Wow6432Node\\)?Microsoft\\Office\\(Word|Excel|PowerPoint|Outlook)(\\[0-9]+\.[0-9]+)?(\\Addins|\\Options|\\Resiliency\\DoNotDisableAddinList|\\Resiliency\\AddinList)/ nocase

    // Capture writes that either register a new add-in path or set an OPEN/load key
    // pointing to a file with an add-in extension
    (
      $reg.target.registry.registry_value_data = /\.(xll|wll|dll|vsto|xlam|xlsm|dotm|ppam|ppa|com)/ nocase
      or
      $reg.target.registry.registry_value_name = /^OPEN[0-9]*$/ nocase
      or
      $reg.target.registry.registry_value_name = /^(FriendlyName|Description|LoadBehavior|Manifest)$/ nocase
    )

    // Exclude known-good administrative and deployment processes
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing software deployment
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
