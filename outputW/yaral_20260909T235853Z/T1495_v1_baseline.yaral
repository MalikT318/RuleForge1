/*
  MITRE Technique : T1495 - Firmware Corruption
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:54:32.952992+00:00
  Reference       : https://attack.mitre.org/techniques/T1495
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1495_001_Firmware_Corruption_Network_Observable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects network-observable firmware corruption activity targeting network devices. Adversaries may attempt to overwrite or corrupt firmware on network devices by transferring firmware images or exploit payloads over management protocols (TFTP, FTP, HTTP) to device management interfaces. This rule identifies anomalous firmware-related transfers from unexpected sources to network device management ports, which may indicate an attempt to render devices inoperable per T1495."
    mitre_tactic = "Impact"
    mitre_technique = "T1495"
    mitre_technique_name = "Firmware Corruption"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs with port and protocol visibility. TFTP (UDP/69), FTP (TCP/20-21), and HTTP (TCP/80/443/8080) to network device management planes should be logged."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorized network device firmware upgrades performed by network operations teams via jump hosts or approved management stations. Vulnerability scanner probes against management interfaces. Backup and imaging software polling device management planes."
    tuning_guidance = "Add authorized firmware management source addresses to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Restrict the destination port set if your environment does not use TFTP or FTP for device management."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target management protocol ports commonly used for firmware transfer:
    // TFTP (69), FTP control (21), FTP data (20), HTTP (80), HTTPS (443), alt-HTTP (8080), alt-HTTPS (8443)
    (
      $net.target.port = 69   or
      $net.target.port = 20   or
      $net.target.port = 21   or
      $net.target.port = 80   or
      $net.target.port = 443  or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )

    // Source must not be an approved management station or scanner
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // Source must not be internal trusted infrastructure (RFC1918 approved ranges)
    not $net.principal.ip in %rfc1918_internal

    // Destination must not be a known-good domain (covers HTTP/HTTPS cases)
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1495")
    $primary_entity = array_distinct($net.target.ip)

  condition:
    $net
}
