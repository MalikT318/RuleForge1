/*
  MITRE Technique : T1129 - Shared Modules
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:37:25.030674+00:00
  Reference       : https://attack.mitre.org/techniques/T1129
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1129_001_Suspicious_Shared_Module_Load_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network connections originating from processes that have loaded shared objects from suspicious or world-writable paths (e.g., /tmp, /dev/shm, /var/tmp). Adversaries modularize malware into shared objects that establish C2 communications. A firewall/perimeter log showing an outbound connection to a non-RFC1918 destination from a Linux host is correlated with the behavioral pattern of shared-module-based implants making external callbacks."
    mitre_tactic = "Execution"
    mitre_technique = "T1129"
    mitre_technique_name = "Shared Modules"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs with source IP, destination IP, destination port, and byte counts. Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate software update agents, telemetry daemons, and monitoring tools making outbound connections on uncommon ports. Cloud-native workloads with dynamic library loading patterns. Container runtimes pulling images."
    tuning_guidance = "Add known-good internal source IPs to %rfc1918_internal exclusions. Add approved external destinations to %global_allowed_domains. Add approved scanner source IPs to %global_allowed_scanners. Narrow by destination port if a specific C2 port pattern is observed in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal Linux host (RFC1918 source)
    net.ip_in_range_cidr($net.principal.ip, "10.0.0.0/8") or
    net.ip_in_range_cidr($net.principal.ip, "172.16.0.0/12") or
    net.ip_in_range_cidr($net.principal.ip, "192.168.0.0/16")

    // Destination must be external (not RFC1918)
    not $net.target.ip in %rfc1918_internal

    // Exclude approved external destinations
    not $net.target.domain.name in %global_allowed_domains

    // Exclude approved scanners and remote management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_remote_mgmt

    // Focus on non-standard high ports commonly used by implants
    // and avoid well-known service ports (80, 443, 53, 22, 25, 587, 993, 995)
    $net.target.port > 1024
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 3128

    // Detect low-and-slow or beaconing-style connections:
    // small outbound byte counts typical of C2 check-ins
    $net.network.sent_bytes > 0
    $net.network.sent_bytes < 5000

    // Received bytes also small, consistent with command polling
    $net.network.received_bytes < 10000

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1129")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)
    $bytes_received = max($net.network.received_bytes)

  condition:
    $net
}
