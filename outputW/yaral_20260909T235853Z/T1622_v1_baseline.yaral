/*
  MITRE Technique : T1622 - Debugger Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:24:07.080415+00:00
  Reference       : https://attack.mitre.org/techniques/T1622
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1622_001_Linux_Proc_Self_Status_TracerPID_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes reading /proc/self/status to check the TracerPID field, a primary Linux debugger-evasion technique. Malware queries this pseudo-file at runtime to determine whether it is being traced by a debugger or dynamic analysis tool, and alters behaviour accordingly. Legitimate software rarely opens /proc/self/status programmatically; the combination of a non-system parent and a suspicious process lineage raises fidelity."
    mitre_tactic = "Defense Evasion, Discovery"
    mitre_technique = "T1622"
    mitre_technique_name = "Debugger Evasion"
    log_prerequisites = "Requires Linux EDR or auditd file-open/read telemetry normalised to UDM FILE_READ events, or PROCESS_LAUNCH events where the command line includes explicit reads of /proc/self/status (e.g. via cat, head, grep, awk)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Security tools and profilers (perf, strace, gdb itself), some JVM/Go runtimes that self-inspect, custom health-check scripts, and certain monitoring agents may legitimately read /proc/self/status."
    tuning_guidance = "Add known-good parent process paths (monitoring agents, JVM launchers, security tools) to %global_allowed_security_tools. Add approved script hosts to %global_allowed_script_hosts. If FILE_READ events are not available, the rule falls back to PROCESS_LAUNCH detection of shell utilities explicitly reading the file."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Detect shell utilities or interpreters explicitly reading /proc/self/status
    // This covers: cat /proc/self/status, grep TracerPID /proc/self/status,
    // head /proc/self/status, awk '/TracerPID/' /proc/self/status, etc.
    $proc.target.process.file.full_path = /\/(cat|grep|awk|head|tail|sed|python[23]?|perl|ruby|sh|bash|dash|zsh)$/ nocase
    $proc.target.process.command_line = /\/proc\/(self|\d+)\/status/ nocase

    // Narrow to cases that specifically seek the tracer field or read the whole file
    // (TracerPID keyword OR reading the full status file without a specific benign field)
    $proc.target.process.command_line = /TracerPID|\/proc\/(self|\d+)\/status/ nocase

    // Exclude known-good security and monitoring tooling
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

    // Exclude processes launched from standard system management paths
    not $proc.principal.process.file.full_path = /^\/(usr\/bin|usr\/sbin|bin|sbin)\/(systemd|init|cron|anacron|puppet|chef|ansible)/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1622")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
