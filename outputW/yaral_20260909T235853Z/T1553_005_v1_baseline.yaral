/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:06:11.989131+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_MOTW_Bypass_Container_Mount_Execute {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of processes whose parent is a container-mounting or archive-extraction utility (ISO, VHD, VHDX, IMG, ARJ, 7z, RAR, ZIP). Files extracted or mounted from these containers do not inherit the Mark-of-the-Web Zone.Identifier ADS, bypassing SmartScreen and Protected View controls. Adversaries abuse this to deliver and execute payloads without MOTW warnings."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with parent process lineage (principal.process.file.full_path and target.process.file.full_path populated)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software distributed as ISO or VHD (e.g., Microsoft Visual Studio, Windows ADK installers). Developers mounting disk images for testing. Authorized software deployment via archive formats."
    tuning_guidance = "Add known-good parent installer paths to %global_allowed_admin_tools. Narrow scope by excluding %global_allowed_script_hosts if scripting engines appear as false positives. Consider adding a child-process allowlist for known-good setup executables."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent process is a container-mounting or archive-extraction utility
    // Covers Windows Explorer mounting ISOs/VHDs natively, or common archive tools
    $proc.principal.process.file.full_path = /\\(explorer|rundll32|msiexec|wscript|cscript|7z|7zG|7zFM|WinRAR|WinZip|peazip|bandizip|unarj|mhd|mhc)\.exe$/ nocase

    // Child process is a suspicious executable category:
    // scripting engines, shells, or generic executable launchers
    // that would normally be blocked or warned about via SmartScreen
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|certutil|bitsadmin|wmic|installutil|cmstp|msbuild|regasm|regsvcs|odbcconf|xwizard|pcalua|forfiles|schtasks|at|bash|python|pythonw|ruby|perl|node|wsl|explorer)\.exe$/ nocase

    // Execution originates from a user-writable or temp-like path,
    // consistent with a mounted/extracted container payload
    $proc.target.process.file.full_path = /\\(Users|Temp|AppData|Downloads|Desktop|Public|ProgramData)\\/ nocase

    // Exclude known administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
