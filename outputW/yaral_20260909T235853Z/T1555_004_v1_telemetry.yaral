/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:31:15.299731+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_Credential_Vault_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read access to Windows Credential Manager vault files (.vcrd) or the vault encryption key (Policy.vpol) by processes other than known system components. Adversaries access these files to extract stored credentials offline after copying them. This rule fires on the file-access artifact rather than the command line, providing coverage that evades process-creation logging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR or Sysmon file-read telemetry (Sysmon Event ID 11 or equivalent EDR FILE_READ events normalised to UDM). The sensor must be configured to log reads of files under AppData paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Credential Manager service (VaultSvc) itself, backup agents reading user profiles, roaming profile synchronisation, and some password manager integrations may legitimately access these files."
    tuning_guidance = "Add backup agent process paths to %global_allowed_backup_processes and approved security tooling to %global_allowed_security_tools. If roaming profiles are in use, consider scoping by principal.hostname to high-value asset groups."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target the vault credential files or the encryption key file
    // Matches: \AppData\Local\Microsoft\Vault\<guid>\*.vcrd
    //          \AppData\Local\Microsoft\Credentials\*
    //          \AppData\Local\Microsoft\Vault\<guid>\Policy.vpol
    //          \AppData\Roaming\Microsoft\Credentials\* (domain credentials)
    $file.target.file.full_path = /(?i)\\AppData\\(Local|Roaming)\\Microsoft\\(Vault|Credentials)\\/

    // Narrow to the specific sensitive file types
    $file.target.file.full_path = /(?i)\.(vcrd|vpol)$|\\Credentials\\[0-9A-Fa-f]{32,}/

    // Exclude the legitimate Windows Credential Manager host process
    not $file.principal.process.file.full_path = /(?i)\\Windows\\System32\\(svchost|lsass|VaultSvc)\.exe$/

    // Exclude known backup and security tooling
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude approved admin accounts performing profile management
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $vault_file_accessed = array_distinct($file.target.file.full_path)
    $user_context = array_distinct($file.principal.user.userid)

  condition:
    $file
}
