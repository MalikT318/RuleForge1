/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:05:26.173049+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_ProcMem_Maps_Read_Then_Mem_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage /proc filesystem injection pattern: a process first reads the memory map of a target process via /proc/[pid]/maps (to enumerate gadgets and stack offsets), then writes to /proc/[pid]/mem to overwrite the target process address space. This is the canonical Linux proc memory injection sequence described in T1055.009."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd file-access telemetry that emits FILE_READ and FILE_MODIFICATION events for /proc filesystem paths. Auditd rules targeting -w /proc or syscall open/read/write against /proc paths are required."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace), profiling tools (perf, valgrind), container runtimes inspecting child process memory, security agents performing memory scanning."
    tuning_guidance = "Add known debugger and profiler parent process paths to %global_allowed_security_tools. Add authorised service account identifiers performing memory inspection to %global_allowed_service_accounts. Narrow the rule further by excluding known-good hostnames running debug workloads."

  events:
    // Stage 1: process reads /proc/<pid>/maps to enumerate memory layout
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\/proc\/[0-9]+\/maps$/
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.user.userid in %global_allowed_service_accounts
    $read.principal.hostname = $hostname
    $read.principal.process.pid = $injector_pid

    // Stage 2: same process writes to /proc/<pid>/mem within the window
    $write.metadata.event_type = "FILE_MODIFICATION"
    $write.target.file.full_path = /\/proc\/[0-9]+\/mem$/
    not $write.principal.process.file.full_path in %global_allowed_security_tools
    not $write.principal.user.userid in %global_allowed_service_accounts
    $write.principal.hostname = $hostname
    $write.principal.process.pid = $injector_pid

    // Enforce chronological ordering: maps read must precede mem write
    $read.metadata.event_timestamp.seconds <= $write.metadata.event_timestamp.seconds

  match:
    $hostname, $injector_pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($read.principal.hostname)
    $injecting_process = array_distinct($read.principal.process.file.full_path)
    $injecting_user = array_distinct($read.principal.user.userid)
    $maps_targets = array_distinct($read.target.file.full_path)
    $mem_targets = array_distinct($write.target.file.full_path)
    $event_count = count($write.metadata.event_timestamp.seconds)

  condition:
    $read and $write
}
