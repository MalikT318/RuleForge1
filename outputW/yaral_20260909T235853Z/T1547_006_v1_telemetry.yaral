/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:12:53.395755+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_Kernel_Module_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a kernel module file (.ko) outside of standard package-managed kernel module directories. Adversaries loading malicious LKMs must first write the module binary to disk before inserting it into the kernel. Catching the file artifact provides detection coverage that is orthogonal to command-line/process-creation rules and is harder to evade."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Kernel developers compiling and testing custom modules locally; DKMS (Dynamic Kernel Module Support) building out-of-tree drivers such as VirtualBox guest additions, NVIDIA/AMD GPU drivers, or ZFS; legitimate third-party security agents that ship kernel modules."
    tuning_guidance = "Add the parent process path of known DKMS or build systems to %global_allowed_admin_tools. If GPU driver or VirtualBox build paths are noisy, scope the exclusion to the specific build output directory by extending the regex in the events block. Service accounts that run DKMS builds can be added to %global_allowed_service_accounts."

  events:
    // Target the file artifact, not the process command line.
    // Match either a new .ko file being written or an existing one modified.
    $file.metadata.event_type = "FILE_CREATION"

    // Kernel module binary extension - the canonical artifact of LKM persistence.
    $file.target.file.full_path = /\.ko(\.xz|\.gz|\.zst)?$/ nocase

    // Flag writes that occur OUTSIDE the standard package-managed module trees.
    // Legitimate distro/DKMS modules land under /lib/modules or /usr/lib/modules.
    // Writes to /tmp, /dev/shm, /var/tmp, home directories, or arbitrary paths
    // are strongly anomalous and indicate staging of a malicious module.
    not $file.target.file.full_path = /^\/lib\/modules\// nocase
    not $file.target.file.full_path = /^\/usr\/lib\/modules\// nocase
    not $file.target.file.full_path = /^\/usr\/src\// nocase

    // Exclude known build and packaging processes that legitimately produce .ko files.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service accounts (e.g. DKMS automation).
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $written_module_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
