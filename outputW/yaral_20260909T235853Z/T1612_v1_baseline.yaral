/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:21:50.357128+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_Build_Image_On_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects container image build operations executed directly on a host via the container runtime API or CLI. Adversaries abuse the build API to construct custom images containing malware downloaded from C2, bypassing registry-based defenses that only inspect pulled images."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires container runtime audit logs (Docker daemon API audit, containerd, or equivalent) and/or Kubernetes audit logs capturing exec and resource creation events. Process telemetry from within the container host is also suitable."
    platform = "Containers"
    log_source = "container"
    false_positives = "Legitimate CI/CD pipeline agents (Jenkins, GitLab Runner, Tekton) building images as part of automated workflows. Developer workstations with local Docker access. Image baking pipelines in build namespaces."
    tuning_guidance = "Scope exclusions by principal.user.userid for known CI/CD service accounts using %global_allowed_service_accounts, or by principal.hostname for dedicated build nodes using %global_allowed_admin_tools. Consider restricting the rule to non-build namespaces in Kubernetes environments."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match container runtime CLIs and daemon socket callers performing a build
    $proc.target.process.file.full_path = /\/(docker|podman|buildah|kaniko|buildctl|nerdctl)$/ nocase

    // The build subcommand is the primary indicator; also catch build-related aliases
    $proc.target.process.command_line = /\b(build|image\s+build|buildx\s+build|bud)\b/ nocase

    // Exclude known-good CI/CD and build service accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved build tooling paths (e.g., sanctioned CI agents)
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Raise fidelity: flag builds that pull from external sources or embed
    // suspicious instructions (RUN curl/wget, ADD from URL, --network=host)
    // Using a broad OR-style regex across the command line for high-recall coverage
    $proc.target.process.command_line = /(\-\-network[=\s]host|curl|wget|chmod\s+[0-7]*[67][0-7]*|nc\s|ncat\s|bash\s+-[a-z]*i|python[23]?\s+-c|perl\s+-e|ADD\s+http)/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity = array_distinct($proc.principal.hostname)
    $build_command = array_distinct($proc.target.process.command_line)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $runtime_binary = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
