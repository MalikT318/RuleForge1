/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:13:36.811599+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_001_ESXi_NonStandard_Port_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects ESXi host processes initiating outbound network connections on ports that are non-standard for common management and data protocols. Adversaries abuse non-standard ports to bypass firewall filtering and evade protocol-based detection. This rule targets NETWORK_CONNECTION events from ESXi host-resident processes connecting to unexpected ports."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "Requires ESXi hostd, vmkernel, or shell network telemetry normalised into Chronicle UDM NETWORK_CONNECTION events. ESXi firewall logging or vSphere network flow collection must be enabled."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Custom vSphere plugin communication, third-party backup agents using non-standard ports, authorised management tooling configured on alternate ports, vSAN or vMotion traffic on non-default ports."
    tuning_guidance = "Add authorised management source addresses to %global_allowed_mgmt_sources. Add approved administrative processes to %global_allowed_admin_tools. Adjust the excluded port list to match your environment's approved non-standard management ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Originating from an ESXi host-resident process or shell
    // Match common ESXi management and VM-related process paths
    $net.principal.process.file.full_path = /^\/(bin|sbin|usr\/bin|usr\/sbin|vmfs\/volumes|opt\/vmware|lib\/vmware)/ nocase

    // Exclude well-known standard ports for common protocols:
    // 22 (SSH), 80 (HTTP), 443 (HTTPS/vSphere API), 902 (VMware agent),
    // 903 (VMware remote console), 2049 (NFS), 8080, 8443 (alt HTTPS),
    // 9000 (vSAN), 5671/5672 (AMQP), 7444 (SSO), 636 (LDAPS), 389 (LDAP)
    $net.target.port != 22
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 902
    $net.target.port != 903
    $net.target.port != 2049
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 9000
    $net.target.port != 5671
    $net.target.port != 5672
    $net.target.port != 7444
    $net.target.port != 636
    $net.target.port != 389
    $net.target.port != 53
    $net.target.port != 123
    $net.target.port != 514
    $net.target.port != 6500
    $net.target.port != 6501
    $net.target.port != 8000
    $net.target.port != 8300
    $net.target.port != 31031
    $net.target.port != 44046

    // Target port must be in a range indicative of application/C2 traffic
    // Exclude ephemeral/high ports used for return traffic (>49151)
    $net.target.port > 1024
    $net.target.port <= 49151

    // Exclude connections to internal management plane sources
    not $net.target.ip in %global_allowed_mgmt_sources

    // Exclude known-good administrative processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude connections to approved external domains
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
