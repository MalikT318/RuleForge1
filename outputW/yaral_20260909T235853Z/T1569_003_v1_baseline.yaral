/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:13:15.861122+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Systemctl_Suspicious_Service_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious use of systemctl to start, enable, or manipulate services from anomalous parent processes such as shells, scripting interpreters, or processes running from world-writable directories. Adversaries abuse systemctl to execute malicious systemd services for persistence or execution."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events, including parent process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate administrators starting or enabling services interactively; configuration management tools (Ansible, Puppet, Chef); software package post-install scripts; container orchestration agents."
    tuning_guidance = "Add known-good automation and deployment parent processes to %global_allowed_admin_tools. Add authorised service account identifiers to %global_allowed_service_accounts. Narrow the parent process regex if a specific RMM or CM tool generates volume."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be systemctl
    $proc.target.process.file.full_path = /\/systemctl$/ nocase

    // Subcommand must be one that causes execution or persistence change
    $proc.target.process.command_line = /\b(start|enable|restart|daemon-reload|link)\b/ nocase

    // Parent process is a shell, interpreter, or originates from a suspicious location
    (
      $proc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|fish|ash)$/ nocase
      or $proc.principal.process.file.full_path = /\/(python[23]?|perl|ruby|lua|node|php)$/ nocase
      or $proc.principal.process.file.full_path = /\/(curl|wget)$/ nocase
      or $proc.principal.process.file.full_path = /^\/(tmp|dev\/shm|var\/tmp|run\/shm)\// nocase
      or $proc.principal.process.command_line = /\/(tmp|dev\/shm|var\/tmp|run\/shm)\// nocase
    )

    // Exclude approved admin tooling and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $systemctl_cmdline = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
