/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:28:15.599044+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_Exfil_Over_Alternate_Network_Medium {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects large outbound network flows to non-internal destinations over uncommon high ports or protocols that may indicate exfiltration over an alternate network medium (e.g., cellular modem, Bluetooth bridge, rogue WiFi). Signals include high-volume flows to external IPs on non-standard ports outside typical web/mail/DNS ranges, which are characteristic of data staging and exfiltration over secondary channels."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Requires firewall or perimeter flow logs with bytes_sent populated. Flow logs must include source/destination IP, destination port, and bytes transferred per session."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Backup agents sending large datasets to cloud storage on non-standard ports, VPN concentrators, authorised bulk data transfer tools, video conferencing software using high ephemeral ports."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add approved scanner or backup source IPs to %global_allowed_backup_processes or %global_allowed_scanners. Raise the bytes threshold if legitimate bulk transfers are common in the environment. Narrow the port exclusion list to match approved application ports."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Destination must be external (not RFC1918 internal space)
    not $net.target.ip in %rfc1918_internal

    // Exclude approved scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude well-known legitimate high-volume service ports:
    // 80 (HTTP), 443 (HTTPS), 25/465/587 (SMTP), 53 (DNS),
    // 22 (SSH), 21 (FTP), 123 (NTP), 993/995 (IMAP/POP3 TLS)
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 22
    $net.target.port != 25
    $net.target.port != 465
    $net.target.port != 587
    $net.target.port != 21
    $net.target.port != 123
    $net.target.port != 993
    $net.target.port != 995

    // Focus on non-trivial high-port or uncommon-port destinations
    // typical of alternate medium bridging (e.g., cellular modem NAT,
    // Bluetooth PAN gateway, rogue AP uplink)
    $net.target.port > 1024

    // Require meaningful outbound data volume to distinguish exfiltration
    // from keep-alive or probe traffic (threshold: 5 MB per flow)
    $net.network.sent_bytes > 5242880

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
