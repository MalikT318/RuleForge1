/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:31:29.593061+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_001_Network_Share_Data_Collection_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes reading or copying data from mounted network shares on Linux. Adversaries mount SMB/NFS/CIFS shares and use standard utilities to enumerate and stage files of interest prior to exfiltration. This rule fires on PROCESS_LAUNCH events where a file-access or copy utility targets common Linux mount points for network shares."
    mitre_tactic    = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with full command-line capture (execve syscall arguments). Auditd rules should include -a always,exit -F arch=b64 -S execve."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Backup agents, legitimate sysadmin scripts, CI/CD pipelines, and monitoring tools that read from NFS/CIFS mounts. Scheduled cron jobs performing authorised data synchronisation."
    tuning_guidance = "Add authorised backup or sync process paths to %global_allowed_backup_processes. Add known service accounts that perform scheduled share reads to %global_allowed_service_accounts. Narrow the mount-point regex if your environment uses non-standard share mount paths."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target a utility commonly used to read, copy, or archive data from shares
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin)\/(cp|rsync|scp|tar|find|cat|dd|mv|zip|gzip|bzip2|xz|7z|lftp|curl|wget|sftp|ftp)$/ nocase

    // Command line must reference a path consistent with a network share mount point:
    // /mnt/, /media/, /net/, /srv/, /run/user/*/gvfs (GVFS CIFS/SMB mounts),
    // or explicit SMB/NFS protocol indicators
    $proc.target.process.command_line = /(\/(mnt|media|net|srv|run\/user\/[0-9]+\/gvfs|var\/autofs)|smb:\/\/|nfs:\/\/|cifs:\/\/|\/\/[^\/]+\/[^\/]+)/ nocase

    // Exclude processes whose parent is an approved backup or admin tool
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known service accounts performing authorised share operations
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative tooling
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $acting_user       = array_distinct($proc.principal.user.userid)
    $command_observed  = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
