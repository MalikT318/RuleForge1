/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:14:01.663529+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_Python_Script_Written_To_Suspicious_Path {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects Python script files (.py, .pyc, .pyo) or compiled Python bytecode written to world-writable or staging directories commonly abused by adversaries (e.g. /tmp, /dev/shm, /var/tmp, /run/shm). This targets the file-artifact layer rather than command-line invocation, providing additive coverage that is harder to evade than process-creation logging."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Linux EDR or auditd with file-creation/modification telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events. Requires target.file.full_path population."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Package managers (pip, conda, poetry) writing to /tmp during install; build systems (tox, pytest) writing compiled bytecode to temp dirs; container image build steps; legitimate developer workflows in /tmp."
    tuning_guidance = "Add known build/package-manager parent process paths to %global_allowed_script_hosts. Narrow the path regex to exclude specific subdirectories used by approved tooling. Raise severity if the writing process is not a known package manager."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file must be a Python source or compiled bytecode artifact
    $file.target.file.full_path = /\.(py|pyc|pyo)$/ nocase

    // File written into world-writable or adversary-favoured staging paths
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/run\/user\/[0-9]+\/|\/proc\/[0-9]+\/fd\/)/ nocase

    // Exclude known legitimate package management and build tooling parent processes
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

    // Exclude backup and imaging processes that may stage files
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_file      = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $writing_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
