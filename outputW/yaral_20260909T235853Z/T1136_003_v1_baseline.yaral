/*
  MITRE Technique : T1136.003 - Cloud Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:40:34.226874+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_003_Cloud_Account_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new cloud user or service account in an identity provider directory. Adversaries create cloud accounts to establish persistent secondary access without deploying remote access tooling. Fires on any USER_CREATION event where the acting principal is not a known service account or approved admin user."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.003"
    mitre_technique_name = "Create Account: Cloud Account"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM USER_CREATION events (e.g. Entra ID Audit Logs, Okta System Log, ADFS audit). The acting principal (who performed the action) must be populated in principal.user.userid."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate IT onboarding workflows, HR-driven provisioning automation, approved service-account creation by identity governance tooling."
    tuning_guidance = "Add provisioning automation service accounts to %global_allowed_service_accounts. Add approved admin identities to %global_allowed_admin_users. Consider narrowing by target.user.user_role or target.user.account_type if your UDM normalisation populates those fields."

  events:
    $auth.metadata.event_type = "USER_CREATION"

    // The acting principal must be present - exclude known provisioning service accounts
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Exclude automated provisioning sources (e.g. SCIM connectors, HR sync)
    not $auth.principal.application in %global_allowed_admin_tools

    // Target account must have a resolvable identity
    $auth.target.user.userid != ""

    // Optionally restrict to accounts that appear to be service/non-human identities
    // by matching common service-principal naming conventions; this broadens coverage
    // to both human and non-human cloud account creation
    // (no filter applied here so all cloud account creations are captured)

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1136.003")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $created_account = array_distinct($auth.target.user.userid)
    $source_application = array_distinct($auth.principal.application)
    $target_user_email = array_distinct($auth.target.user.email_addresses)

  condition:
    $auth
}
