/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:34:38.402555+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_FTP_CnC_Network_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound connections on FTP control and data ports (20, 21) or TFTP (69/UDP) from internal hosts to external destinations. Adversaries abuse file transfer protocols for C2 communications, blending malicious traffic with legitimate file transfer activity. This rule provides network-side coverage complementary to endpoint process-launch detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Logs must populate principal.ip, target.ip, target.port, and network.ip_protocol."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate FTP/TFTP usage for software distribution, backup transfers, or network device management. Authorised FTP servers reachable from internal hosts. Vulnerability scanners probing external hosts."
    tuning_guidance = "Add known-good external FTP destinations to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Add approved service accounts or automation hosts to %global_allowed_service_accounts. Consider narrowing to non-standard source ports or high-frequency connection counts if false-positive volume is high."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Match FTP control (21), FTP data (20), or TFTP (69) destination ports
    (
      $net.target.port = 21 or
      $net.target.port = 20 or
      $net.target.port = 69
    )

    // Source must be an internal address - exclude external-to-external flows
    $net.principal.ip in %rfc1918_internal

    // Destination must be external - exclude internal-to-internal transfers
    not $net.target.ip in %rfc1918_internal

    // Exclude authorised scanner sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved management sources (e.g. network device management hosts)
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
