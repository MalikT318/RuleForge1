/*
  MITRE Technique : T1037.001 - Logon Script (Windows)
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:30:38.362054+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_001_Logon_Script_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification or creation of the UserInitMprLogonScript registry value under HKCU\\Environment, which is the OS mechanism Windows uses to execute logon scripts at user login. Adversaries abuse this key to achieve persistence by pointing it to a malicious script or binary that runs each time the user authenticates."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.001"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Logon Script (Windows)"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry capturing HKCU registry writes (Sysmon Event ID 13, or equivalent EDR registry modification events normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or enterprise login script management tools that legitimately configure UserInitMprLogonScript for mapped drives or environment setup. Verify the value data points to an approved script path."
    tuning_guidance = "Add known-good service or automation accounts that legitimately write this key to %global_allowed_service_accounts. If specific admin tools are responsible, add their process paths to %global_allowed_admin_tools."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment\\UserInitMprLogonScript$/  nocase
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
