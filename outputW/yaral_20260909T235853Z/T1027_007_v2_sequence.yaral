/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:53:43.516262+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_Dynamic_API_Resolution_Suspicious_Module_Load_Then_Memory_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with dynamic API resolution: a process loads a core Windows library (ntdll, kernel32, kernelbase) via an unusual parent lineage, followed by a file write to a temp or user-writable path within the same short window. Adversaries performing API hashing/resolution typically load these modules at runtime and then write resolved stubs or shellcode to disk or staging locations."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_OPEN (module load / handle open) and FILE_CREATION events with process context. Sysmon Event ID 7 (ImageLoad) and Event ID 11 (FileCreate) normalised to UDM are ideal."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate packers, installers, and JIT runtimes (.NET CLR, JVM) that load ntdll/kernel32 and write temp files as part of normal operation. Security tooling and AV engines performing in-memory scanning may also trigger this pattern."
    tuning_guidance = "Add known-good parent process paths (installer engines, JIT hosts, security agents) to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow the file write path regex if staging directories differ per environment."

  events:
    // Event 1: A process opens a handle to a core Windows API library.
    // This is the module-load step of dynamic API resolution - the process
    // must load ntdll/kernel32/kernelbase before it can walk the export table.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /(?i)\\(ntdll|kernel32|kernelbase|advapi32|user32)\.dll$/
    // The opening process must NOT itself be a known Windows system host
    // (lsass, svchost, etc.) - those legitimately open these modules constantly.
    not $open.principal.process.file.full_path = /(?i)\\(svchost|lsass|csrss|wininit|services|smss|spoolsv|msiexec|explorer|RuntimeBroker|SearchHost|sihost|taskhostw|dwm)\.exe$/
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.principal.process.pid = $pid

    // Event 2: The SAME process (matched by hostname + pid) creates a file
    // in a temp or user-writable staging location shortly after.
    // Writing resolved shellcode/stubs to disk is a common post-resolution step.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\\temp\\|\\tmp\\|\\appdata\\local\\temp\\|\\appdata\\roaming\\|\\programdata\\|\\users\\public\\)/
    not $file.target.file.full_path = /(?i)\.(log|tmp\.log|etl|evtx|db|db-wal|db-shm)$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.principal.process.pid = $pid

    // Chronological ordering: module open must precede the file write
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $loaded_module = array_distinct($open.target.process.file.full_path)
    $written_file = array_distinct($file.target.file.full_path)
    $event_count = count($file.metadata.event_timestamp.seconds)

  condition:
    $open and $file
}
