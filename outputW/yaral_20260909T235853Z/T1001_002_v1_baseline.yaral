/*
  MITRE Technique : T1001.002 - Steganography
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:26:25.779272+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_002_ESXi_Steganography_C2_Indicators {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects potential steganography-based C2 activity on ESXi hosts by identifying shell processes invoking image/media manipulation utilities or transferring files with image/archive extensions via network-capable tools. Adversaries embed C2 instructions in image or document files transferred to or from the ESXi management plane."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1001.002"
    mitre_technique_name = "Data Obfuscation: Steganography"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised to UDM PROCESS_LAUNCH. ESXi Shell must be enabled and shell command logging active (hostd or syslog forwarding to Chronicle)."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Legitimate VM image exports (vmkfstools, ovftool), authorised datastore maintenance scripts, backup agents transferring VMDK/ISO files, vendor health-check tooling."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_backup_processes. Add authorised admin accounts to %global_allowed_admin_users. Narrow the command-line regex if specific legitimate workflows trigger the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Execution must originate from an ESXi shell or management daemon context
    $proc.principal.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|vmfs\/volumes)\// nocase

    // Target process is a network-capable transfer tool or an image/data manipulation utility
    // commonly abused to exfiltrate steganographic payloads or retrieve encoded C2 instructions
    $proc.target.process.file.full_path = /\/(wget|curl|python|python3|perl|nc|ncat|netcat|openssl|base64|xxd|dd|busybox)$/ nocase

    // Command line references image, document, or archive file extensions
    // which are typical steganographic carrier formats, OR uses encoding flags
    // that suggest data is being hidden or extracted from binary blobs
    $proc.target.process.command_line = /\.(png|jpg|jpeg|gif|bmp|tif|tiff|ico|svg|pdf|docx|zip|tar|gz|bz2|vmdk|iso)\b|--output\s+\S+\.(png|jpg|jpeg|gif|bmp|pdf)|base64\s+(-d|--decode)|-e\s+base64/ nocase

    // Exclude known-good backup and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1001.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $triggered_process = array_distinct($proc.target.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
