/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:22:40.165689+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_EmailAccountDiscovery_AuthThenDirectoryEnum {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with email account enumeration via an identity provider: an interactive or programmatic login followed shortly by a directory or group read operation from the same principal. This is additive coverage over process-launch command-line rules, targeting identity-plane audit events rather than endpoint telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM. The tenant must emit both authentication events (USER_LOGIN) and directory/group read events (USER_RESOURCE_ACCESS or GROUP_MODIFICATION) with principal.user.userid populated on both."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Helpdesk tooling that authenticates and then queries the directory, HR provisioning workflows, approved IT automation accounts, and directory synchronisation service principals."
    tuning_guidance = "Add known automation and service accounts to %global_allowed_service_accounts. Add approved cloud/directory principals to %global_allowed_cloud_principals. Narrow the resource name regex if your tenant uses a consistent naming convention for address-list or GAL objects."

  events:
    // Event 1: An interactive or delegated login that is NOT from a known service account.
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    $auth.principal.user.userid = $userid

    // Event 2: A directory or group read that targets email/address-list related resources,
    // performed by the same principal shortly after login.
    $dir.metadata.event_type = "USER_RESOURCE_ACCESS"
    $dir.principal.user.userid = $userid
    not $dir.principal.user.userid in %global_allowed_service_accounts
    not $dir.principal.user.userid in %global_allowed_cloud_principals
    // Match resource names associated with global address lists, directory listings,
    // contact lists, or distribution group enumeration.
    $dir.target.resource.name = /(?i)(global.?address|address.?list|gal|directory|contact.?list|distribution.?group|all.?users|all.?mailbox|exchange.?recipient|get.?mailbox|get.?recipient|get.?user|get.?group|mailsniper|ews|autodiscover)/

    // Chronological ordering: login must precede the directory access.
    $auth.metadata.event_timestamp.seconds <= $dir.metadata.event_timestamp.seconds

  match:
    $userid over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($userid)
    $accessed_resources = array_distinct($dir.target.resource.name)
    $login_count = count($auth.metadata.event_timestamp.seconds)
    $directory_access_count = count($dir.metadata.event_timestamp.seconds)

  condition:
    $auth and $dir
}
