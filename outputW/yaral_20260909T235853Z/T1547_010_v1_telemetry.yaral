/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:15:16.753100+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_Port_Monitor_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications to the Print Monitors key (HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors) that set or change a Driver value. Adversaries abuse this mechanism to load an arbitrary DLL via the print spooler (spoolsv.exe) at SYSTEM privilege on boot. This rule fires on the registry state change rather than the process command line, providing coverage that is harder to evade."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_MODIFICATION / REGISTRY_CREATION events. Sysmon Event ID 13 (RegistryValueSet) or equivalent EDR registry telemetry."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver installation by vendor software or Windows Update may write to this key. Print server administrators installing new port monitors will also trigger this rule."
    tuning_guidance = "Add known-good printer management processes (e.g., print driver installers, Windows Update worker) to %global_allowed_admin_tools. Consider suppressing events where the writing process originates from a trusted software deployment path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors\\/  nocase
    $reg.target.registry.registry_value_name = /^Driver$/  nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $driver_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
