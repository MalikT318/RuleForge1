/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:33:36.024031+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Executable_Written_To_Removable_Media {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects executable file creation on removable media, indicating potential lateral movement or initial access via USB/removable drives."
    mitre_tactic = "Lateral Movement, Initial Access"
    mitre_technique = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites = "Requires EDR file telemetry or Windows file system auditing."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installation to USB drives, portable application deployment, backup operations, authorized file transfers to removable media."
    tuning_guidance = "Add approved backup processes to %global_allowed_backup_processes. Exclude known portable application deployment tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[D-Z]:\\/ nocase
    (
      $file.target.file.full_path = /\.exe$/ nocase or
      $file.target.file.full_path = /\.dll$/ nocase or
      $file.target.file.full_path = /\.scr$/ nocase or
      $file.target.file.full_path = /\.com$/ nocase or
      $file.target.file.full_path = /\.bat$/ nocase or
      $file.target.file.full_path = /\.cmd$/ nocase or
      $file.target.file.full_path = /\.vbs$/ nocase or
      $file.target.file.full_path = /\.js$/ nocase or
      $file.target.file.full_path = /\.lnk$/ nocase or
      $file.target.file.full_path = /\.pif$/ nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
