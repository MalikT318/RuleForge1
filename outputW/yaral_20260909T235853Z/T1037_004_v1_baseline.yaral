/*
  MITRE Technique : T1037.004 - RC Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:31:11.149900+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_004_RC_Script_Persistence_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of RC script files (rc.local, rc.common, local.sh, etc.) on network devices via management-plane configuration change events. Adversaries modify these startup scripts to achieve persistence across reboots, executing arbitrary commands as root. This is particularly relevant for lightweight Unix-like network devices, IoT, and ESXi hypervisors where RC scripts are one of the few persistent storage mechanisms."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.004"
    mitre_technique_name = "Boot or Logon Initialization Scripts: RC Scripts"
    log_prerequisites = "Requires network device management-plane syslog or configuration audit logs normalised to UDM SETTING_MODIFICATION. The device must log configuration or file change events including the affected resource or setting name."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network administrators performing scheduled maintenance, firmware upgrades that touch startup scripts, automated configuration management systems (Ansible, NAPALM, Terraform), and backup/restore operations."
    tuning_guidance = "Add authorised administrator accounts to %global_allowed_admin_users and approved management source addresses to %global_allowed_mgmt_sources. Scope by device criticality if alert volume is high."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Match modification of RC startup script paths common on Unix-like network devices,
    // ESXi hypervisors, IoT, and embedded systems. Patterns cover:
    //   /etc/rc.local, /etc/rc.common, /etc/rc.d/*, /etc/rc*.d/*,
    //   /etc/rc.local.d/local.sh (ESXi persistence path),
    //   /etc/init.d/*, /etc/rc (generic)
    $cfg.target.resource.name = /(?i)(\/etc\/rc\.local(\.d\/[^\s]*)?|\/etc\/rc\.common|\/etc\/rc[0-9S]?\.d\/|\/etc\/rc\.d\/|\/etc\/init\.d\/|\/etc\/rc$|local\.sh)/

    // Exclude approved management source addresses (e.g., jump hosts, NMS)
    not $cfg.principal.ip in %global_allowed_mgmt_sources

    // Exclude approved service and automation accounts performing legitimate config pushes
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrator accounts performing authorised maintenance
    not $cfg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.004")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $affected_resource = array_distinct($cfg.target.resource.name)
    $actor_user = array_distinct($cfg.principal.user.userid)
    $source_ip = array_distinct($cfg.principal.ip)

  condition:
    $cfg
}
