/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:20:48.908727+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_001_Container_Admin_Command_Exec {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects interactive command execution inside a running container via container administration interfaces such as docker exec or kubectl exec. Adversaries abuse these mechanisms to run arbitrary commands within container workloads without deploying a new container."
    mitre_tactic    = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Requires Kubernetes API server audit logs or container runtime telemetry normalised to UDM USER_RESOURCE_ACCESS. The audit log must capture exec/attach sub-resource calls against pods."
    platform        = "Containers"
    log_source      = "container"
    false_positives = "Authorised SRE/DevOps engineers executing into pods for debugging, CI/CD pipelines running acceptance tests inside containers, monitoring agents that exec health-check commands."
    tuning_guidance = "Add known automation service accounts to %global_allowed_service_accounts. Add approved administrative source identities to %global_allowed_admin_users. Scope exclusions to specific namespaces or pod name patterns if exec is expected in non-production namespaces."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Kubernetes API server exec or attach sub-resource calls
    // kubectl exec and direct API calls both produce a request to
    // /api/v1/namespaces/<ns>/pods/<pod>/exec or /attach
    $cloud.target.resource.name = /\/pods\/[^\/]+\/(exec|attach)/ nocase

    // HTTP verb must be a write-class verb that initiates the exec session
    $cloud.network.http.method = /^(POST|GET)$/ nocase

    // Exclude known-good automation and service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Exclude approved scanners and security tooling that may probe the API
    not $cloud.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $target_pod        = array_distinct($cloud.target.resource.name)
    $source_ip         = array_distinct($cloud.principal.ip)
    $http_method       = array_distinct($cloud.network.http.method)

  condition:
    $cloud
}
