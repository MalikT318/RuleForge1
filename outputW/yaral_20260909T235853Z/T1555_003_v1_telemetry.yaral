/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:30:36.449078+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Browser_Credential_DB_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file-read or file-open access to browser credential stores on Linux (Chrome/Chromium Login Data, Firefox key4.db/logins.json, etc.) by a process that is not the browser itself. Attackers copy or read these SQLite databases to extract saved credentials without spawning a suspicious command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Web Browsers"
    log_prerequisites = "Requires Linux EDR or auditd with file-open/file-read telemetry normalised into UDM FILE_READ events. auditd rule: -a always,exit -F arch=b64 -S open,openat -F exit=-EACCES -F exit=0 covering browser profile paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Browser sync daemons, backup agents reading profile directories, security scanners, password manager integrations that legitimately access browser stores."
    tuning_guidance = "Add legitimate backup or sync process paths to %global_allowed_backup_processes. Add approved security tooling to %global_allowed_security_tools. Scope further by requiring the accessing process to be outside the user's own browser binary path."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target: browser credential store files on Linux
    // Chrome/Chromium: Login Data (SQLite), Cookies, Web Data
    // Firefox: key4.db (NSS key store), logins.json, cert9.db
    // Opera, Brave, Vivaldi share Chromium-style paths
    $file.target.file.full_path = /(?i)\/\.config\/(google-chrome|chromium|brave-browser|opera|vivaldi|microsoft-edge)[^\/]*\/[^\/]+\/(Login Data|Cookies|Web Data|Login Data-journal)$/
    OR
    $file.target.file.full_path = /(?i)\/\.mozilla\/firefox\/[^\/]+\/(key4\.db|logins\.json|cert9\.db|cookies\.sqlite)$/
    OR
    $file.target.file.full_path = /(?i)\/snap\/(chromium|brave|firefox)\/[^\/]+\/[^\/]+\/(Login Data|key4\.db|logins\.json)$/

    // Exclude the browser processes themselves accessing their own stores
    not $file.principal.process.file.full_path = /(?i)\/(google-chrome|chrome|chromium|chromium-browser|brave|brave-browser|opera|vivaldi|msedge|firefox|firefox-esr)$/

    // Exclude approved backup and security tooling
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude known-safe script hosts running legitimate automation
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $credential_file_accessed = array_distinct($file.target.file.full_path)
    $accessing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
