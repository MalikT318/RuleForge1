/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:16:51.619772+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_File_Then_Suspicious_Exec {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a .desktop file written to an XDG Autostart directory followed by execution of a process whose parent is a desktop session launcher (e.g. gnome-session, xfce4-session, startx), indicating the newly planted autostart entry was triggered at the next login. This provides additive coverage beyond command-line process-creation rules by correlating the file-write event with the resulting desktop-session-spawned child process on the same host."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry (FILE_CREATION / FILE_MODIFICATION) and process-launch telemetry (PROCESS_LAUNCH) with parent process information populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate software installers that drop .desktop autostart entries (e.g. Zoom, Slack, Teams, Dropbox, update daemons). Package managers running post-install scripts. User-configured autostart entries created via desktop settings panels."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Add authorised service accounts that perform software deployment to %global_allowed_service_accounts. Narrow the suspicious child-process regex if specific interpreters are not used in your environment."

  events:
    // Leg 1: a .desktop file is written to a system-wide or per-user XDG Autostart directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/\.?config\/autostart\/[^\/]+\.desktop$/ nocase
    $file.target.file.full_path != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Leg 2: a process is launched whose parent is a desktop session manager,
    // indicating the autostart entry fired at login - and the child is a
    // shell, interpreter, or binary running from a world-writable / user-owned path
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(gnome-session|xfce4-session|mate-session|lxsession|openbox|startx|xinit|i3|sway|ksmserver|plasma_session|xsession|Xsession)$/
    (
      $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|fish|python[23]?|perl|ruby|node|php|lua)$/ nocase or
      $proc.target.process.file.full_path = /\/(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/home\/[^\/]+\/\.(local|cache|config)\/)/
    )
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Chronological ordering: file write must precede the desktop-session launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1547.013")
    $primary_entity      = array_distinct($hostname)
    $autostart_file_path = array_distinct($file.target.file.full_path)
    $writing_process     = array_distinct($file.principal.process.file.full_path)
    $spawned_child       = array_distinct($proc.target.process.file.full_path)
    $affected_user       = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
