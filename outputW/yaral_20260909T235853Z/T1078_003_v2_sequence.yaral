/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:21:28.696998+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Local_Account_Created_Then_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a local user account creation event on Linux followed by an interactive or remote login from that same newly created account within one hour. This sequence is a strong indicator of adversary-created backdoor accounts being activated for persistence or lateral movement."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM. USER_CREATION events must populate target.user.userid. USER_LOGIN events must populate principal.user.userid and principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Automated provisioning pipelines that create and immediately test accounts; configuration management tools (Ansible, Puppet, Chef) that create service accounts and validate connectivity; cloud-init bootstrapping on new instances."
    tuning_guidance = "Add provisioning service accounts to %global_allowed_service_accounts. Add configuration management hosts to %global_allowed_admin_tools. If the environment uses a known provisioning user, exclude it from the creation event's principal.user.userid."

  events:
    // Event 1: A local account is created on a Linux host
    $create.metadata.event_type = "USER_CREATION"
    $create.target.user.userid != ""
    not $create.target.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_service_accounts
    // Capture the newly created username and host as join keys
    $create.target.user.userid = $new_userid
    $create.principal.hostname = $hostname

    // Event 2: The newly created account successfully logs in on the same host
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $new_userid
    $login.principal.hostname = $hostname
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users

    // Enforce chronological ordering: creation must precede login
    $create.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $new_userid, $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($login.principal.hostname)
    $created_account = array_distinct($new_userid)
    $creating_user = array_distinct($create.principal.user.userid)
    $login_count = count($login.metadata.event_timestamp.seconds)

  condition:
    $create and $login
}
