/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:23:19.353764+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Memory_Dump_File_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects creation of a minidump or dump file whose path or name references lsass, indicating a likely LSASS memory dump attempt. Attackers using procdump, comsvcs.dll MiniDump, Task Manager, or custom tooling all produce a dump file artifact on disk regardless of the method used to obtain the handle. This rule pivots on the resulting FILE_CREATION event rather than the process command line, providing additive coverage that is harder to evade."
    mitre_tactic         = "Credential Access"
    mitre_technique      = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites    = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event) normalised to UDM FILE_CREATION."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Authorised memory diagnostics by incident responders or security teams; some EDR/AV products that snapshot LSASS for tamper detection; Windows Error Reporting (WerFault.exe) crash dumps for lsass in legitimate crash scenarios."
    tuning_guidance      = "Add the full path of approved dump-collection processes to %global_allowed_backup_processes or %global_allowed_security_tools. If WerFault.exe crash dumps are common in your environment, add the WER dump directory path to an exclusion and alert on it separately."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match dump file extensions commonly produced by LSASS dumping tools
    $file.target.file.full_path = /(?i)\.(dmp|mdmp|dump|bin)$/

    // The file path or name must reference lsass (case-insensitive via inline flag)
    $file.target.file.full_path = /(?i)lsass/

    // Exclude processes that legitimately write LSASS-related dump files
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity    = array_distinct($file.principal.hostname)
    $dump_file_path    = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
