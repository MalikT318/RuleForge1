/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:04:27.191326+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injection_Proc_Mem_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-level artifacts of ptrace-based process injection on Linux. Attackers using ptrace injection commonly stage shellcode or shared objects in world-writable memory-backed paths (/dev/shm, /tmp, /run/shm) or write directly to /proc/<pid>/mem to modify a target process's address space without spawning a child. This rule fires on FILE_CREATION or FILE_MODIFICATION events targeting those paths from processes that are not known-good debuggers, security tools, or backup agents - providing a telemetry layer that is harder to evade than command-line logging alone."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR or auditd file-event telemetry normalised to Chronicle UDM FILE_CREATION / FILE_MODIFICATION. Auditd rules should watch /proc/*/mem, /dev/shm, /run/shm, and /tmp with -p w. EDR agents must emit file-write events for memory-backed filesystems."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, lldb, strace), Java JIT compilers writing to /tmp/hsperfdata_*, container runtimes staging shared libraries in /dev/shm, JVM/Node.js anonymous mappings, performance profilers (perf, valgrind). Tune using %global_allowed_security_tools and %global_allowed_admin_tools."
    tuning_guidance = "Add known-good parent process paths (e.g. JVM, container runtime, profiler) to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow the /tmp branch further by requiring the file extension to match .so or no extension if false-positive volume from /tmp is high."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    (
      // Direct write to /proc/<pid>/mem - the canonical ptrace injection artifact
      $file.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase
      or
      // Shared-memory filesystems used to stage shellcode or injectable .so files
      $file.target.file.full_path = /^\/dev\/shm\// nocase
      or
      $file.target.file.full_path = /^\/run\/shm\// nocase
      or
      // Writable temp paths used to drop injectable payloads before ptrace POKETEXT
      $file.target.file.full_path = /^\/tmp\/[^\/]+\.(so(\.[0-9]+)*|bin|elf|dat|raw)$/ nocase
    )

    // Exclude known-good security and administrative tooling
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude root-owned system paths that legitimately write to /dev/shm
    not $file.principal.process.file.full_path = /^\/(usr\/lib|usr\/bin|usr\/sbin|lib|lib64)\// nocase

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity    = array_distinct($file.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $target_path       = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
