/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:07:23.395015+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Task_XML_File_Then_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a scheduled task XML file written to the Windows Tasks directory followed by a corresponding registry key creation or modification under the Task Scheduler hive. This two-stage pattern indicates a task was registered via the Task Scheduler API, WMI, or .NET wrapper rather than via schtasks.exe command-line, providing additive coverage beyond process-launch detections."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Event ID 11) and registry telemetry (Event ID 12/13). Both must be ingested and normalised to UDM FILE_CREATION and REGISTRY_CREATION/REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers, Group Policy-deployed tasks, Windows Update, SCCM/Intune task deployment, and authorised RMM tooling that registers scheduled tasks programmatically."
    tuning_guidance = "Add trusted parent process paths to %global_allowed_admin_tools. Add known-good service accounts that deploy tasks to %global_allowed_service_accounts. Narrow the registry key pattern if specific task name prefixes are known-good in your environment."

  events:
    // Event 1: XML task definition file written to the Tasks store
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\Tasks\\.+\.xml$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Event 2: Corresponding registry entry created/modified in the Task Scheduler hive
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache\\Tasks\\/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Chronological ordering: file written before registry entry appears
    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($hostname)
    $task_files_written = array_distinct($file.target.file.full_path)
    $registry_keys_created = array_distinct($reg.target.registry.registry_key)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file and $reg
}
