/*
  MITRE Technique : T1216 - System Script Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:50:02.421099+00:00
  Reference       : https://attack.mitre.org/techniques/T1216
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_System_Script_Proxy_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects abuse of Microsoft-signed system scripts (e.g. SyncAppvPublishingServer.vbs, pubprn.vbs, manage-bde.wsf, winrm.vbs, slmgr.vbs) to proxy execution of malicious payloads. Adversaries invoke these trusted, signed scripts via cscript/wscript to bypass application control and signature validation."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1216"
    mitre_technique_name = "System Script Proxy Execution"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative use of SyncAppvPublishingServer for App-V publishing, slmgr.vbs for license management, winrm.vbs for WinRM configuration. Rare in most environments."
    tuning_guidance = "Add known-good parent processes (e.g. SCCM, deployment tooling) to %global_allowed_admin_tools. Narrow by excluding hosts in %global_allowed_script_hosts if specific management servers legitimately invoke these scripts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Must be invoked through a Windows script host
    $proc.target.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase

    // Target one of the known Microsoft-signed proxy scripts used for LOLBin abuse.
    // Matching on command line covers cases where the script path is passed as an argument.
    $proc.target.process.command_line = /(?i)(SyncAppvPublishingServer\.vbs|pubprn\.vbs|manage\-bde\.wsf|winrm\.vbs|slmgr\.vbs|cmstp\.inf|appsyncpublishingserver\.vbs)/ nocase

    // The command line must also contain something beyond the script itself -
    // a URL, UNC path, or external argument indicating proxy execution of a payload.
    // Legitimate invocations of slmgr/winrm rarely pass remote paths or URLs.
    $proc.target.process.command_line = /(?i)(https?:\/\/|\\\\[a-z0-9]|\.ps1|\.exe|\.dll|\.bat|\.cmd|rundll32|powershell|mshta|regsvr32)/ nocase

    // Exclude known-good administrative tooling parents
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved script hosts (management servers, deployment systems)
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1216")
    $primary_entity = array_distinct($proc.principal.hostname)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
