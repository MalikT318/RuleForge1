/*
  MITRE Technique : T1199 - Trusted Relationship
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:45:31.733649+00:00
  Reference       : https://attack.mitre.org/techniques/T1199
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1199_Trusted_Relationship_External_Principal_Privilege_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects privilege escalation or administrative role assignment granted to an external or guest principal, which is a primary indicator of Trusted Relationship abuse. Adversaries compromise third-party partner or contractor accounts and leverage delegated administrator relationships to gain privileged access to victim tenants. This rule fires when a non-internal principal is assigned a privileged role or group membership change occurs for an account bearing external identity markers."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1199"
    mitre_technique_name = "Trusted Relationship"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM. Entra ID directory audit, Okta System Log, or ADFS audit events covering role assignments and group membership changes must be ingested."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate onboarding of new managed service providers, authorised partner delegated admin grants, IT contractor provisioning during change windows."
    tuning_guidance = "Add known-good external service principal identifiers or contractor account patterns to %global_allowed_cloud_principals. Add approved admin accounts to %global_allowed_admin_users. Scope by target.user.attribute.roles or group name patterns matching your privileged tier naming convention."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // Target account bears external or guest identity markers common across IdPs
    // Matches patterns like: #EXT#, _external_, guest, partner, vendor, contractor, b2b
    $auth.target.user.userid = /(?i)(#ext#|_external_|guest|partner|vendor|contractor|b2b|federated)/ nocase

    // The permission change involves a privileged role - match common admin role name patterns
    // Covers Global Admin, Privileged Role Admin, Company Admin, Super Admin, Org Admin, etc.
    $auth.target.user.attribute.roles = /(?i)(global.?admin|privileged.?role|company.?admin|super.?admin|org.?admin|tenant.?admin|partner.?admin|delegated.?admin|directory.?role|security.?admin|exchange.?admin|sharepoint.?admin|teams.?admin|billing.?admin|helpdesk.?admin|user.?admin|authentication.?admin)/

    // Exclude known-good cloud service principals performing automated provisioning
    not $auth.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved administrator accounts performing authorised onboarding
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1199")
    $primary_entity = array_distinct($auth.target.user.userid)
    $granting_principal = array_distinct($auth.principal.user.userid)
    $assigned_role = array_distinct($auth.target.user.attribute.roles)
    $target_resource = array_distinct($auth.target.resource.name)

  condition:
    $auth
}
