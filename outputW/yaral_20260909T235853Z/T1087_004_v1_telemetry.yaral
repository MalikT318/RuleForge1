/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:23:01.386932+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_SaaS_BulkCloudAccountEnumeration {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects bulk or repeated read access to cloud account/user directory objects via identity provider audit logs. Adversaries with valid credentials enumerate user accounts, roles, and service principals to map the environment for lateral movement or privilege escalation. This rule fires on a high volume of directory read operations against user or role objects within a short window, which is the observable state change produced by cloud account enumeration regardless of the tool used."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires identity provider audit logs normalised to Chronicle UDM. The log source must emit USER_RESOURCE_ACCESS events for directory read operations (e.g., List Users, List Roles, List Service Principals, Get Role Members). Entra ID, Okta, and similar IdPs produce these events in their audit/activity logs."
    platform        = "SaaS"
    log_source      = "identity"
    false_positives = "HR or provisioning systems performing scheduled user-sync operations; ITSM connectors performing directory reads; authorised identity governance tools; SIEM/SOAR connectors polling directory state; on-call admin performing legitimate user audits."
    tuning_guidance = "Add known provisioning service accounts to %global_allowed_service_accounts. Add approved identity governance or SIEM service principals to %global_allowed_cloud_principals. Raise the threshold or narrow the match window if the environment has high-volume legitimate directory sync traffic."

  events:
    $auth.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target must be a directory object type associated with account enumeration:
    // user objects, role/group assignments, service principals, or policy bindings.
    $auth.target.resource.type = /(?i)(user|role|service.?account|service.?principal|group.?member|directory.?role|iam.?policy|permission)/

    // The operation name should reflect a read/list/get action, not a write.
    $auth.target.resource.name = /(?i)(list|get|read|enum|describe|query)/

    // Bind the acting principal for grouping and exclusion.
    $auth.principal.user.userid = $actor

    // Exclude known-good automation and service accounts.
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  match:
    $actor over 5m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $accessed_resource_types = array_distinct($auth.target.resource.type)
    $accessed_resource_names = array_distinct($auth.target.resource.name)
    $source_ips = array_distinct($auth.principal.ip)
    $event_count = count($auth.metadata.event_type)

  condition:
    // Require at least 20 distinct directory read events within the 5-minute window
    // to distinguish bulk enumeration from incidental single lookups.
    #auth >= 20
}
