/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:00:03.698693+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Compressed_Archive_Created_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a compressed archive file created in a suspicious staging directory (e.g. /tmp, /dev/shm, /var/tmp) followed within 5 minutes by a process launch whose parent or executable path references that same archive or directory. This two-stage correlation catches adversaries who compress a payload and immediately execute or extract it, providing additive coverage beyond simple command-line matching."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM FILE_CREATION and PROCESS_LAUNCH events. File path and process command-line fields must be populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate build pipelines, CI/CD agents, backup scripts, and package managers that stage compressed artifacts in /tmp or /var/tmp before installation. Developers compressing project files in scratch directories."
    tuning_guidance = "Add known CI/CD agent user accounts to %global_allowed_service_accounts. Add approved build or deployment parent process paths to %global_allowed_admin_tools. Narrow the staging path regex if /tmp activity is too noisy in a given environment."

  events:
    // Event 1: A compressed archive is created in a suspicious staging directory.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(?:tmp|var\/tmp|dev\/shm|run\/shm)\/.+\.(?:gz|bz2|xz|zip|tar|tgz|tbz2|zst|lz4|rar|7z)$/
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    // Event 2: A process is launched from the same staging directory or
    // references a path within it, shortly after the archive was created.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\/(?:tmp|var\/tmp|dev\/shm|run\/shm)\//
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Enforce chronological ordering: archive creation precedes execution.
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity = array_distinct($proc.principal.hostname)
    $archive_paths = array_distinct($file.target.file.full_path)
    $launched_commands = array_distinct($proc.target.process.command_line)
    $acting_users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    $file and $proc
}
