/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:40:20.780652+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_SecurityTool_UI_Spoof_RegistryThenProcess {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage UI spoofing pattern: a registry modification that disables or degrades a Windows security tool (Defender, Security Center, EDR agent) followed within 10 minutes by launch of a process that mimics a security tool UI (e.g., a non-standard binary presenting a tray icon or health dashboard). Together these indicate an adversary has impaired a defense and then deployed a fake UI to conceal the impairment."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires EDR or Sysmon registry-modification telemetry (REGISTRY_MODIFICATION) and process-launch telemetry (PROCESS_LAUNCH). Both must be normalised into UDM and ingested via the windows_endpoint log source."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security software updates that temporarily modify Defender registry keys before restarting their own UI process. Group Policy refreshes that touch DisableAntiSpyware or similar keys. AV migration tooling that disables one product before installing another."
    tuning_guidance = "Add known-good security software parent processes to %global_allowed_security_tools. Add authorised admin accounts that perform policy changes to %global_allowed_admin_users. Narrow the registry key regex if the environment uses a non-Defender EDR whose keys differ."

  events:
    // Event 1: Registry modification that disables or degrades a Windows security tool.
    // Targets well-known Defender / Security Center / WSC disable keys.
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Windows Defender|Windows Defender\\Policy\\PolicyManager|Windows Defender\\Real-Time Protection|Windows Defender\\Spynet|SecurityCenter|SecurityCenter2|Windows Security\\Notifications)\\/ nocase
    $reg.target.registry.registry_value_name = /(?i)(DisableAntiSpyware|DisableAntiVirus|DisableRealtimeMonitoring|DisableBehaviorMonitoring|DisableIOAVProtection|DisableOnAccessProtection|DisableScriptScanning|HideNotifications|DisableNotifications|SpynetReporting|SubmitSamplesConsent)$/
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    // Event 2: A process launches from an unusual or writable path and its
    // command line or image name mimics a security tool UI keyword.
    // We deliberately avoid matching on exact binary names (rename-resilient)
    // and instead focus on path anomalies combined with UI-keyword arguments.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(?i)(SecurityHealth|WindowsDefender|WinDefend|AntiVirus|Protect|Defender|SecurityCenter|TrayIcon|systray|HealthUI|SafetyScanner|MpUi|MsMpEng)/
    // Launched from a user-writable or temp-like path rather than a system directory.
    $proc.target.process.file.full_path = /(?i)(\\Users\\|\\Temp\\|\\AppData\\|\\ProgramData\\|\\Public\\|\\Downloads\\|\\Desktop\\)/
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    // Chronological ordering: registry tamper must precede the fake UI launch.
    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity = array_distinct($hostname)
    $tampered_registry_keys = array_distinct($reg.target.registry.registry_key)
    $tampered_registry_values = array_distinct($reg.target.registry.registry_value_name)
    $spoofed_process_paths = array_distinct($proc.target.process.file.full_path)
    $spoofed_process_cmdlines = array_distinct($proc.target.process.command_line)
    $actor_accounts = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $proc
}
