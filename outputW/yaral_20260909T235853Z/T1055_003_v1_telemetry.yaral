/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:01:48.877877+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Thread_Hijack_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where an untrusted or unexpected process requests a handle to another process with permissions consistent with thread execution hijacking (e.g., THREAD_SUSPEND_RESUME, THREAD_SET_CONTEXT, THREAD_GET_CONTEXT, VM_WRITE). Attackers must open a handle to the victim process before they can suspend its thread, write shellcode, and redirect execution. This targets the OS-level handle request rather than command-line arguments, providing coverage that is additive to process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised to UDM PROCESS_OPEN. The EDR must capture the access rights bitmask or a decoded permission string in the target.process.access_mask or equivalent field. Sysmon GrantedAccess field is the primary source."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers (WinDbg, x64dbg, Visual Studio), legitimate crash-dump utilities, AV/EDR agents opening process handles for inspection, Windows Error Reporting (WerFault.exe), Task Manager, Process Explorer."
    tuning_guidance = "Add known-good security tooling and debugger paths to %global_allowed_security_tools. Add approved admin tooling to %global_allowed_admin_tools. Scope further by excluding well-known system parent paths such as C:\\Windows\\System32 if noise is high, but validate that the exclusion does not blind the rule to living-off-the-land abuse."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opening (attacker) process must NOT be a known system binary
    // located in the canonical Windows system directories.
    // Hijacking tools are typically user-land or dropped to temp/user paths.
    not $open.principal.process.file.full_path = /(?i)^C:\\Windows\\(System32|SysWOW64|WinSxS)\\/ nocase

    // Exclude known-good security and admin tooling via reference lists
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

    // The target (victim) process should be a high-value Windows process
    // that adversaries commonly hijack to blend in.
    // Matching on process name patterns rather than exact paths for portability.
    $open.target.process.file.full_path = /(?i)\\(svchost|lsass|explorer|RuntimeBroker|spoolsv|winlogon|csrss|services|taskhost|taskhostw|dllhost|wininit|SearchIndexer|SearchHost|sihost|fontdrvhost)\.exe$/

    // The principal process must not itself be a Windows system binary
    // (belt-and-suspenders: catches cases where path normalisation differs)
    not $open.principal.process.file.full_path = /(?i)\\(WerFault|werfaultsecure|taskmgr|mmc|svchost|lsass|csrss|wininit|services|smss)\.exe$/

    // Require a non-empty opening process path to avoid noise from
    // events where the opener is unresolved (reduces false positives).
    $open.principal.process.file.full_path = /.+/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($open.principal.hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opening_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
