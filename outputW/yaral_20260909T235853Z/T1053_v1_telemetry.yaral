/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:03:26.438888+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_Scheduled_Task_File_Creation_System32_Tasks {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of scheduled task XML files in System32\\Tasks directory, indicating task registration outside normal administrative channels."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053"
    mitre_technique_name = "Scheduled Task/Job"
    log_prerequisites = "Requires EDR file telemetry or Sysmon Event ID 11 (FileCreate)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers, Windows Update, Group Policy task deployment, RMM agents, patch management systems."
    tuning_guidance = "Add approved deployment tools and service account processes to %global_allowed_admin_tools and %global_allowed_service_accounts. Review principal.process.file.full_path for legitimate automation."

  events:
    ($file.metadata.event_type = "FILE_CREATION" or $file.metadata.event_type = "FILE_MODIFICATION")
    $file.target.file.full_path = /\\windows\\system32\\tasks\\/ nocase
    not $file.target.file.full_path = /\\windows\\system32\\tasks\\microsoft\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\\windows\\system32\\svchost\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\windows\\system32\\taskhostw\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\windows\\system32\\msiexec\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053")
    $primary_entity = array_distinct($file.principal.hostname)
    $task_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
