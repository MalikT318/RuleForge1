/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:04:25.085734+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_Bootkit_Raw_Disk_Or_ESP_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects bootkit installation attempts on Linux via raw writes to block devices (MBR/VBR) or modifications to EFI System Partition (ESP) boot files. Adversaries with root access may overwrite /dev/sdX, /dev/nvmeXnX, or drop malicious EFI binaries under /boot/efi to persist below the OS layer."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry capturing FILE_CREATION and FILE_MODIFICATION events with full target path. Auditd rules should include -w /boot/efi -p wa and -a always,exit -F arch=b64 -S open,openat -F path=/dev/sda."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate bootloader updates (grub-install, efibootmgr, shim updates), OS upgrade processes, disk imaging tools, and authorised backup agents writing to raw block devices."
    tuning_guidance = "Add authorised update manager and bootloader installer process paths to %global_allowed_admin_tools. Add backup agent process paths to %global_allowed_backup_processes. Scope exclusions narrowly to the specific binary full path, not the parent directory."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Raw block device writes (MBR/VBR on BIOS systems) or ESP boot file writes (UEFI systems)
    (
      // Raw writes to block devices - covers MBR/VBR overwrite on BIOS systems
      $file.target.file.full_path = /^\/dev\/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|xvd[a-z]|mmcblk[0-9]+)$/ nocase

      or

      // EFI System Partition boot file modifications (UEFI bootkits)
      $file.target.file.full_path = /^\/boot\/efi\/.+\.(efi|img|bin)$/ nocase

      or

      // Grub/boot directory binary or config tampering outside of known update paths
      $file.target.file.full_path = /^\/boot\/(grub|grub2|efi)\/.+/ nocase
    )

    // Exclude known-good administrative and backup tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known-good service accounts performing automated patching
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $target_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
