/*
  MITRE Technique : T1620 - Reflective Code Loading
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:23:45.125252+00:00
  Reference       : https://attack.mitre.org/techniques/T1620
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1620_001_Reflective_Code_Loading_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects indicators of reflective code loading on Linux by identifying processes that execute code from anonymous or in-memory file descriptors (memfd_create, /proc/self/fd, /dev/shm) or that invoke interpreters/loaders with fileless payloads piped directly into them. This targets the core OS mechanism: executing code that is never backed by a named file on disk."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1620"
    mitre_technique_name = "Reflective Code Loading"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with process launch events including full command-line arguments and parent process path. Auditd syscall rules for execve and memfd_create improve coverage."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "JVM and .NET runtimes legitimately use anonymous mappings; some container runtimes and language interpreters (Python, Ruby) use memfd internally; legitimate use of /dev/shm by IPC-heavy applications."
    tuning_guidance = "Add known-good parent processes (JVM launchers, container runtimes, build agents) to %global_allowed_script_hosts. Scope by principal.hostname for noisy hosts. Consider raising severity if the parent is a web server or database process."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match processes whose command line references in-memory or anonymous
    // execution mechanisms common to reflective loading on Linux:
    //   1. memfd_create-backed execution via /proc/self/fd or /proc/<pid>/fd
    //   2. Execution directly from /dev/shm (RAM-backed tmpfs)
    //   3. Fileless payload delivery: shell reading from /proc/self/fd after
    //      piping encoded payload (e.g., python -c / perl -e / bash -c with
    //      base64-decoded content executed without touching disk)
    //   4. ld.so / dynamic linker invoked directly against a memfd descriptor
    (
      $proc.target.process.command_line = /\/proc\/self\/fd\// nocase
      or
      $proc.target.process.command_line = /\/proc\/[0-9]+\/fd\// nocase
      or
      $proc.target.process.command_line = /\/dev\/shm\// nocase
      or
      $proc.target.process.command_line = /memfd_create/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(python[23]?|perl|ruby|node|lua[0-9.]*)$/ nocase
        and
        $proc.target.process.command_line = /(\-c|\-e|\-\-eval)\s+.*(base64|b64decode|frombase64|eval\s*\(|exec\s*\()/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh)$/ nocase
        and
        $proc.target.process.command_line = /base64\s+(\-d|\-\-decode).*\|\s*(bash|sh|python|perl|exec)/ nocase
      )
      or
      $proc.target.process.file.full_path = /\/ld[\-\.]so(\.[0-9]+)?$/ nocase
      and
      $proc.target.process.command_line = /\/proc\/[0-9]+\/fd\//
    )

    // Exclude known-good script hosts and automation tooling
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1620")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
