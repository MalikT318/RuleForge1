/*
  MITRE Technique : T1559.001 - Component Object Model
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:09:12.872794+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Abuse_Suspicious_Host_Spawns_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects COM-based local code execution where a known COM host process (dllhost, mshta, wscript, cscript, rundll32, regsvr32, or an Office application) spawns an unexpected child process such as a shell interpreter, scripting engine, or reconnaissance utility. This pattern indicates an adversary abusing a COM server object to achieve arbitrary execution without directly invoking the payload binary."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with parent-child process lineage and full command-line capture (Sysmon Event ID 1, or equivalent EDR PROCESS_LAUNCH events with principal.process populated)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office macros invoking shells for automation; software installers using dllhost or rundll32 to launch helper processes; developer workstations running COM-based build tooling; some RMM agents that surface as dllhost children."
    tuning_guidance = "Add known-good parent binaries to %global_allowed_admin_tools and known-good script hosts to %global_allowed_script_hosts. Scope by hostname or user group for developer populations. Consider adding a command-line allowlist for specific installer patterns observed in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // COM host processes commonly abused as surrogate launchers
    $proc.principal.process.file.full_path = /\\(dllhost|mshta|wscript|cscript|rundll32|regsvr32|winword|excel|powerpnt|outlook|onenote|msaccess|mspub)\.exe$/ nocase

    // Suspicious child processes that should not normally be spawned by COM hosts
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|certutil|bitsadmin|regsvr32|rundll32|msiexec|wmic|net|net1|nltest|whoami|ipconfig|systeminfo|tasklist|sc|reg|at|schtasks|curl|wget|ftp|bash|sh)\.exe$/ nocase

    // Exclude cases where the parent is itself the same binary (self-invocation by legitimate tools)
    not $proc.principal.process.file.full_path = $proc.target.process.file.full_path

    // Exclude approved administrative tooling and script hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
