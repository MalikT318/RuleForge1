/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:02:56.148724+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where a non-system process requests handle access to a remote process with permissions consistent with APC injection (e.g., PROCESS_VM_WRITE, PROCESS_VM_OPERATION, PROCESS_SUSPEND_RESUME, or thread-level access for QueueUserAPC). This targets the OS-level state change produced by APC injection rather than command-line arguments, providing additive coverage over process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised to UDM PROCESS_OPEN. The EDR must capture the access rights mask or equivalent field. Sysmon GrantedAccess field must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), profilers, crash reporters, and security tools that open handles to other processes for inspection. Backup agents and AV products may also trigger this."
    tuning_guidance = "Add known-good parent process paths (debuggers, AV agents, RMM tools) to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow by excluding well-known system process targets if noise is high. Consider pairing with a threshold rule to suppress single isolated events from known-good hosts."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opening (principal) process must not be a known system binary.
    // Legitimate APC injection originates from user-land processes, not kernel/system paths.
    not $open.principal.process.file.full_path = /(?i)^C:\\Windows\\System32\\/ nocase
    not $open.principal.process.file.full_path = /(?i)^C:\\Windows\\SysWOW64\// nocase

    // Exclude known-good security and admin tooling via reference lists.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Target process is a common injection victim: a running user or system process.
    // APC injection typically targets processes such as explorer, svchost, lsass, or
    // suspended newly-created processes. We match broadly on process open to any target
    // that is a Windows executable, letting the access-rights logic carry the signal.
    $open.target.process.file.full_path = /(?i)\\[^\\]+\.exe$/

    // The principal process must itself be an executable (not a script host injecting
    // via a legitimate interpreter - that is covered by a separate rule).
    $open.principal.process.file.full_path = /(?i)\\[^\\]+\.exe$/

    // Cross-process open: principal and target must differ (self-opens are benign).
    $open.principal.process.file.full_path != $open.target.process.file.full_path

    // The opening process must not be running from a standard Windows or Program Files path.
    // APC injectors frequently run from user-writable locations.
    not $open.principal.process.file.full_path = /(?i)^C:\\Program Files\\/
    not $open.principal.process.file.full_path = /(?i)^C:\\Program Files \(x86\)\\/

    // Suspicious target processes commonly abused in APC injection scenarios.
    // Broad enough to survive tool renaming; targets the victim class, not the injector name.
    $open.target.process.file.full_path = /(?i)\\(explorer|svchost|lsass|winlogon|services|spoolsv|taskhost|taskhostw|dllhost|rundll32|regsvr32|msiexec|werfault|notepad|RuntimeBroker)\.exe$/

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($open.principal.hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)

  condition:
    $open
}
