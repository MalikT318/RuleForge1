/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:45:41.008541+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Firewall_Rule_Bypass_Network_Observable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable evidence of firewall rule manipulation on network devices: traffic flows that traverse ports or protocols typically blocked by perimeter policy, suggesting ACL or firewall rule modification to permit otherwise denied traffic. Focuses on connections from external sources reaching internal management planes or sensitive port ranges that should be blocked under normal policy."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Requires firewall flow or connection logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Logs must populate target.port, principal.ip, target.ip, and network.ip_protocol."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised penetration testing, newly provisioned network segments, legitimate management access from approved jump hosts, vulnerability scanner activity."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Narrow target.port ranges to those relevant to the environment. If internal-to-internal flows are expected on these ports, extend %rfc1918_internal exclusions accordingly."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Traffic originates from an external (non-RFC1918) source
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Destination is an internal address (traffic reached an internal host,
    // implying a firewall rule permitted it when it should have been blocked)
    $net.target.ip in %rfc1918_internal

    // Sensitive port ranges that perimeter firewalls should block from external sources:
    // Management plane ports (SSH 22, Telnet 23, SNMP 161/162, NETCONF 830,
    // RESTCONF 443/8443 covered separately, RDP 3389, WinRM 5985/5986,
    // BGP 179, OSPF via raw IP, device HTTP mgmt 80/8080/8443)
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 162 or
      $net.target.port = 179 or
      $net.target.port = 830 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = "T1686.002"
    $primary_entity = $net.target.ip

  condition:
    $net
}
