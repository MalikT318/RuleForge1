/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:30:16.085946+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Memory_Dump_Tool_Then_Securityd_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects execution of memory dumping tools followed by file access to securityd process memory, indicating potential credential harvesting from macOS keychain daemon."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux/macOS EDR or auditd with process and file access telemetry."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Security scanning tools, forensic analysis by authorized incident responders, memory profiling during development."
    tuning_guidance = "Add approved forensic tools to %global_allowed_security_tools and authorized security personnel to %global_allowed_admin_users."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /\/(gdb|lldb|gcore|procdump)$/ nocase or
      $proc.target.process.command_line = /\/proc\/[0-9]+\/mem/ nocase or
      $proc.target.process.command_line = /dd\s+if=\/proc/ nocase or
      $proc.target.process.command_line = /ptrace/ nocase or
      $proc.target.process.command_line = /process_vm_readv/ nocase
    )
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname
    $proc.principal.user.userid = $userid

    $file.metadata.event_type = "FILE_READ"
    (
      $file.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase or
      $file.target.file.full_path = /\/proc\/[0-9]+\/maps$/ nocase or
      $file.target.file.full_path = /\/proc\/[0-9]+\/cmdline$/ nocase
    )
    (
      $file.principal.process.command_line = /securityd/ nocase or
      $file.target.process.file.full_path = /\/usr\/sbin\/securityd$/ nocase or
      $file.target.process.command_line = /securityd/ nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $userid

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $userid over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $suspicious_processes = array_distinct($proc.target.process.file.full_path)
    $accessed_files = array_distinct($file.target.file.full_path)
    $user_accounts = array_distinct($userid)

  condition:
    $proc and $file
}
