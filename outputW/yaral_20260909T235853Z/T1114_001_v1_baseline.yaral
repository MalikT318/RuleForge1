/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:35:07.387981+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Local_Email_Collection_Outlook_Files {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes accessing or copying Outlook local data files (.ost/.pst) from user profile directories. Adversaries collect these files to harvest email content offline without interacting with mail servers."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires EDR file telemetry (FILE_READ or FILE_CREATION) capturing access to .ost/.pst files with process context, or Sysmon Event ID 11/15."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup software reading PST/OST files, Outlook itself during normal operation, IT migration tooling, antivirus scanning."
    tuning_guidance = "Add legitimate backup and migration process paths to %global_allowed_backup_processes. Add approved admin accounts to %global_allowed_admin_users. Outlook.exe itself is excluded by default."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target must be an Outlook data file in a user profile path
    $file.target.file.full_path = /(?i)\\Users\\[^\\]+\\(AppData\\Local\\Microsoft\\Outlook|Documents\\Outlook Files)\\[^\\]+\.(ost|pst)$/

    // The accessing process must NOT be Outlook itself
    not $file.principal.process.file.full_path = /(?i)\\outlook\.exe$/

    // Exclude known-good backup and security tooling
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude approved admin users performing legitimate operations
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $target_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
