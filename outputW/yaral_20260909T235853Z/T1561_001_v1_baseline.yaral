/*
  MITRE Technique : T1561.001 - Disk Content Wipe
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:10:11.603456+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_001_Disk_Content_Wipe_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects process launches consistent with direct disk content wiping on Windows. Adversaries use built-in utilities or LOLBins to overwrite raw disk sectors, rendering data irrecoverable. Targets command-line patterns for dd-style writes to physical drives, format with overwrite flags, diskpart clean, cipher wipe, and PowerShell raw disk access via .NET or WMI."
    mitre_tactic = "Impact"
    mitre_technique = "T1561.001"
    mitre_technique_name = "Disk Content Wipe"
    log_prerequisites = "Requires EDR process telemetry or Windows Security Event 4688 with command-line auditing enabled (Sysmon Event ID 1 or equivalent)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorized disk sanitization by IT asset disposal teams, forensic imaging tools, legitimate use of diskpart or cipher for compliance wiping, backup software performing raw disk reads."
    tuning_guidance = "Add authorized disk management parent processes to %global_allowed_admin_tools. Add authorized service accounts performing disk operations to %global_allowed_service_accounts. Scope by hostname or user if wipe activity is expected in specific environments."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match processes that can perform raw disk writes or sector-level destruction
    (
      // diskpart with clean all - overwrites all sectors
      (
        $proc.target.process.file.full_path = /\\diskpart\.exe$/ nocase and
        $proc.target.process.command_line = /clean/ nocase
      )
      or
      // format with overwrite (/p flag writes zeros over sectors)
      (
        $proc.target.process.file.full_path = /\\format\.com$/ nocase and
        $proc.target.process.command_line = /\/p:/ nocase
      )
      or
      // cipher /w wipes free space by overwriting with patterns
      (
        $proc.target.process.file.full_path = /\\cipher\.exe$/ nocase and
        $proc.target.process.command_line = /\/w/ nocase
      )
      or
      // PowerShell accessing raw disk objects via .NET or WMI disk handles
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase and
        (
          $proc.target.process.command_line = /\\\\\.\\PHYSICALDRIVE/ nocase or
          $proc.target.process.command_line = /Win32_DiskDrive/ nocase or
          $proc.target.process.command_line = /FileStream.*\\\\\.\\/ nocase
        )
      )
      or
      // cmd or script launching raw write to physical drive path
      (
        $proc.target.process.file.full_path = /\\(cmd|wscript|cscript)\.exe$/ nocase and
        $proc.target.process.command_line = /\\\\\.\\PHYSICALDRIVE/ nocase
      )
      or
      // wmic invoking disk-level operations
      (
        $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase and
        $proc.target.process.command_line = /diskdrive/ nocase
      )
    )

    // Exclude known-good administrative and backup tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1561.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $wipe_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
