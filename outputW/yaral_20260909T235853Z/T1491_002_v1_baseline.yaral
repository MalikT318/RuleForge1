/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:54:14.639681+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_External_Defacement_Web_Content_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects large outbound HTTP responses or anomalous HTTP status patterns from externally-facing web servers that may indicate external defacement. Specifically looks for high-volume HTTP responses to external destinations that could represent bulk content replacement, or unexpected HTTP error bursts following content modification. Monitors for unusual outbound data volumes from web server ports to non-internal destinations."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires firewall or perimeter network flow logs with byte counts, ports, and direction. UDM fields: network.sent_bytes, target.port, target.ip, principal.ip populated by perimeter device."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate large web content deployments, CDN cache refreshes, authorized bulk content updates, software update distribution servers, media streaming services."
    tuning_guidance = "Add authorized web publishing source IPs to %global_allowed_mgmt_sources. Add known CDN and update domains to %global_allowed_domains. Adjust the sent_bytes threshold to match baseline web traffic volume for each client environment. Consider narrowing to specific externally-facing server IPs."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Target standard web server ports (HTTP and HTTPS)
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )

    // Exclude internal-to-internal traffic; focus on flows reaching external destinations
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Detect anomalously large outbound data volumes that may indicate
    // bulk web content being served after defacement (attacker-modified pages
    // being delivered to external visitors, or large file uploads replacing content)
    $net.network.sent_bytes > 10000000

    // Exclude known-good external destinations such as CDNs and update services
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
