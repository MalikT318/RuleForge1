/*
  MITRE Technique : T1578.005 - Modify Cloud Compute Configurations
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:15:07.869377+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_005_Cloud_Compute_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modifications to cloud compute configurations that affect resource quotas, tenant-wide policies, subscription associations, or regional deployment constraints. Adversaries may modify these settings to enable resource hijacking or expand compute capacity without triggering quota-based alerts."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.005"
    mitre_technique_name = "Modify Cloud Compute Configurations: Modify Cloud Compute Configurations"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs) normalised into Chronicle UDM."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate capacity planning requests, authorized infrastructure scaling operations, cloud operations teams adjusting quotas for approved projects, automated infrastructure-as-code pipelines."
    tuning_guidance = "Add authorized cloud service principals and automation accounts to %global_allowed_cloud_principals. Add known-good admin users performing approved quota changes to %global_allowed_admin_users. Consider scoping to changes outside business hours or from unexpected source locations."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Target operations that modify compute quotas, policies, or regional/subscription constraints
    // Matches API method names normalised into UDM target.resource.name or metadata fields
    // covering quota updates, policy assignments, and compute configuration changes
    (
      $cloud.target.resource.name = /(?i)(quota|limit|policy|subscription|tenant|capacity|allocation|region|zone|sku|vm.?size|machine.?type|instance.?type|compute.?config|resource.?policy|org.?policy|service.?limit|usage.?limit)/ or
      $cloud.security_result.description = /(?i)(quota|limit|policy|subscription|tenant|capacity|allocation|region|zone|sku|vm.?size|machine.?type|instance.?type|compute.?config|resource.?policy|org.?policy|service.?limit|usage.?limit)/
    )

    // Exclude known authorized cloud principals performing routine operations
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Exclude known automation and service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1578.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $modified_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
