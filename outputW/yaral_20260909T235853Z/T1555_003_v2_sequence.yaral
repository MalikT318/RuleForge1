/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:30:56.482998+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_BrowserCredDB_Read_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-browser process opening a browser credential store file (Login Data, logins.json, Web Data, cookies) followed by an outbound network connection from the same process on the same host within 10 minutes. This two-stage correlation provides additive coverage beyond command-line matching by focusing on the file-access-then-exfil pattern."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Web Browsers"
    log_prerequisites = "Requires EDR file-read/open telemetry (FILE_READ or FILE_OPEN events) and network connection telemetry (NETWORK_CONNECTION). Both must be normalised into UDM by the EDR agent."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup agents reading browser profiles, antivirus scanning credential stores, browser sync utilities, IT asset inventory tools."
    tuning_guidance = "Add backup and security agent process paths to %global_allowed_backup_processes and %global_allowed_security_tools. Add approved remote management processes to %global_allowed_remote_mgmt. Narrow the file path regex if only specific browsers are in scope."

  events:
    // Event 1: A non-browser, non-approved process reads a browser credential store file
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /(?i)\\AppData\\(Local|Roaming)\\(Google\\Chrome|Microsoft\\Edge|BraveSoftware\\Brave-Browser|Opera Software\\Opera Stable|Mozilla\\Firefox)\\(User Data\\[^\\]+\\(Login Data|Web Data|Cookies)|Profiles\\[^\\]+\\(logins\.json|key4\.db|cookies\.sqlite))/
    not $file.principal.process.file.full_path = /(?i)\\(chrome|msedge|brave|opera|firefox|chromium)\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $stealing_process

    // Event 2: The same process path makes an outbound network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = $stealing_process
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    $net.principal.hostname = $hostname

    // Chronological ordering: file read must precede network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $stealing_process over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessed_credential_files = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $offending_process = array_distinct($stealing_process)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file and $net
}
