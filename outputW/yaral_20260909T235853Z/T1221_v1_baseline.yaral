/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:51:11.821053+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_001_Office_Template_Injection_Remote_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Office applications (Word, Excel, PowerPoint) spawning network-capable child processes or script interpreters immediately after document load, which is the primary behavioral signal of OOXML template injection. When a malicious remote template reference is embedded in an OOXML document, Office fetches and executes the payload at open time, causing Office to spawn shells, script hosts, or download utilities as child processes."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires EDR process telemetry with parent-child process lineage and command-line arguments (Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, or equivalent UDM PROCESS_LAUNCH events)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office add-ins or macros that invoke PowerShell for approved automation; document management systems that use scripted Office automation; developer workstations running Office COM automation pipelines."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_script_hosts. Add approved automation service accounts to %global_allowed_service_accounts. Consider scoping by principal.hostname if specific hosts run legitimate Office automation."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent must be an Office application - the document host that loaded the template
    $proc.principal.process.file.full_path = /\\(WINWORD|EXCEL|POWERPNT|MSACCESS|MSPUB|VISIO)\.exe$/

    // Child process is a shell, script interpreter, or download utility
    // These are the processes spawned when a fetched template payload executes
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|msiexec|wmic|forfiles|pcalua|schtasks|at|installutil|cmstp|msbuild|xwizard|odbcconf)\.exe$/

    // Exclude cases where the child command line contains only benign/empty invocations
    // Require at least some argument activity to reduce noise on bare process launches
    $proc.target.process.command_line != ""

    // Exclude approved script hosts and admin tooling
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($proc.principal.hostname)
    $office_parent = array_distinct($proc.principal.process.file.full_path)
    $spawned_child = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
