/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:28:46.869484+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Password_Store_File_Read_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file-read or file-open events targeting common Linux password store locations such as browser credential databases, keyring files, KeePass databases, and application secret stores. This catches credential harvesting at the file-artifact layer rather than the command-line layer, providing coverage against attackers who evade process-creation logging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with file-open/file-read events normalised into UDM FILE_READ or FILE_MODIFICATION events. Auditd rules must include -a always,exit -F arch=b64 -S open,openat -F exit=-EACCES and equivalent for targeted paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate password manager applications opening their own database, backup agents reading credential stores, security scanners, user-initiated browser profile sync tools."
    tuning_guidance = "Add authorised backup or sync process paths to %global_allowed_backup_processes. Add approved security tooling to %global_allowed_security_tools. Scope by principal.user.userid to exclude service accounts via %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target common Linux password store file paths using regex anchored patterns.
    // Covers: GNOME keyring, KWallet, browser credential DBs (Chrome/Chromium/Firefox/Brave/Edge),
    // pass(1) store, KeePass databases, libsecret, and generic credential files.
    (
      $file.target.file.full_path = /\/\.local\/share\/keyrings\// nocase or
      $file.target.file.full_path = /\/\.gnome2\/keyrings\// nocase or
      $file.target.file.full_path = /\/\.kde(4)?\/share\/apps\/kwallet\// nocase or
      $file.target.file.full_path = /\/\.local\/share\/kwallet\// nocase or
      $file.target.file.full_path = /\/\.config\/google-chrome\/[^\/]+\/Login Data/ nocase or
      $file.target.file.full_path = /\/\.config\/chromium\/[^\/]+\/Login Data/ nocase or
      $file.target.file.full_path = /\/\.config\/BraveSoftware\/[^\/]+\/Login Data/ nocase or
      $file.target.file.full_path = /\/\.config\/microsoft-edge\/[^\/]+\/Login Data/ nocase or
      $file.target.file.full_path = /\/snap\/chromium\/[^\/]+\/\.config\/chromium\/[^\/]+\/Login Data/ nocase or
      $file.target.file.full_path = /\/\.mozilla\/firefox\/[^\/]+\/(logins\.json|key[34]\.db|signons\.sqlite)/ nocase or
      $file.target.file.full_path = /\/\.password-store\// nocase or
      $file.target.file.full_path = /\/\.gnupg\/private-keys/ nocase or
      $file.target.file.full_path = /\/\.ssh\/(id_rsa|id_ecdsa|id_ed25519|id_dsa)$/ nocase or
      $file.target.file.full_path = /\.kdbx$/ nocase or
      $file.target.file.full_path = /\.kdb$/ nocase or
      $file.target.file.full_path = /\/\.netrc$/ nocase or
      $file.target.file.full_path = /\/etc\/shadow$/ nocase or
      $file.target.file.full_path = /\/etc\/gshadow$/ nocase or
      $file.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase
    )

    // Exclude the owning browser or password manager process itself performing routine access.
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude the browser reading its own credential store (self-access).
    // Flag when a process that is NOT the expected owner reads these files.
    not (
      $file.target.file.full_path = /\/\.config\/google-chrome\// nocase and
      $file.principal.process.file.full_path = /\/google-chrome$/ nocase
    )
    not (
      $file.target.file.full_path = /\/\.config\/chromium\// nocase and
      $file.principal.process.file.full_path = /\/chromium$/ nocase
    )
    not (
      $file.target.file.full_path = /\/\.mozilla\/firefox\// nocase and
      $file.principal.process.file.full_path = /\/firefox$/ nocase
    )

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = "T1555"
    $primary_entity = $file.principal.hostname

  condition:
    $file
}
