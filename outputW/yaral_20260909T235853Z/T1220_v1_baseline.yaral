/*
  MITRE Technique : T1220 - XSL Script Processing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:50:52.751003+00:00
  Reference       : https://attack.mitre.org/techniques/T1220
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1220_001_XSL_Script_Processing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects XSL script processing abuse via msxsl.exe or wmic.exe with XSL/XML arguments. Adversaries embed malicious scripts inside XSL files and invoke them through trusted Windows utilities to bypass application control and execute arbitrary code."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1220"
    mitre_technique_name = "XSL Script Processing"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (Process Create) with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate XSLT transformations by developers or data pipeline tooling; SCCM/MECM inventory queries using wmic with format parameters; XML/XSL processing in build systems."
    tuning_guidance = "Add known-good parent processes performing legitimate XSLT work to %global_allowed_admin_tools. Scope wmic detections by parent process or working directory if build/CI systems trigger false positives."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Detect msxsl.exe (primary XSL processing binary) or wmic.exe abused with /format XSL
    (
      // msxsl.exe: any invocation is suspicious as it is not installed by default
      $proc.target.process.file.full_path = /(?i)\\msxsl\.exe$/

      or

      // wmic.exe invoked with a remote or local XSL stylesheet via /format
      (
        $proc.target.process.file.full_path = /(?i)\\wmic\.exe$/
        and
        $proc.target.process.command_line = /(?i)\/format\s*:?\s*[^\s]+\.(xsl|xslt)/
      )

      or

      // wmic.exe referencing a remote URL as a format stylesheet (http/https)
      (
        $proc.target.process.file.full_path = /(?i)\\wmic\.exe$/
        and
        $proc.target.process.command_line = /(?i)\/format\s*:?\s*https?:\/\//
      )
    )

    // Exclude known-good administrative tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1220")
    $primary_entity = array_distinct($proc.principal.hostname)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $username = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
