/*
  MITRE Technique : T1615 - Group Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:23:05.721162+00:00
  Reference       : https://attack.mitre.org/techniques/T1615
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1615_001_Group_Policy_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Group Policy discovery activity via gpresult.exe, PowerShell GPO enumeration cmdlets (Get-DomainGPO, Get-GPO, Get-GPResultantSetOfPolicy), or direct SYSVOL path access. Adversaries enumerate GPO settings to identify privilege escalation paths, security controls, and domain configuration."
    mitre_tactic = "Discovery"
    mitre_technique = "T1615"
    mitre_technique_name = "Group Policy Discovery"
    log_prerequisites = "Requires EDR process telemetry or Windows Event ID 4688 with command-line auditing enabled. PowerShell script-block logging (Event 4104) also surfaces this activity."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "IT administrators running gpresult for troubleshooting, Group Policy management tools (GPMC), software deployment agents querying GPO state, compliance scanning tools."
    tuning_guidance = "Add known administrative hosts to %global_allowed_admin_tools and known service accounts to %global_allowed_service_accounts. Consider scoping to non-admin users or non-management workstations to reduce noise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match gpresult.exe directly or PowerShell/cmd invoking GPO discovery
    (
      // gpresult.exe - native Windows GPO result tool
      $proc.target.process.file.full_path = /(?i)\\gpresult\.exe$/

      or

      // PowerShell invoking GPO-related cmdlets or functions
      (
        $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh)\.exe$/
        and
        (
          $proc.target.process.command_line = /(?i)Get-DomainGPO/
          or
          $proc.target.process.command_line = /(?i)Get-DomainGPOLocalGroup/
          or
          $proc.target.process.command_line = /(?i)Get-DomainGPOComputerLocalGroupMapping/
          or
          $proc.target.process.command_line = /(?i)Get-DomainGPOUserLocalGroupMapping/
          or
          $proc.target.process.command_line = /(?i)Get-GPO/
          or
          $proc.target.process.command_line = /(?i)Get-GPResultantSetOfPolicy/
          or
          $proc.target.process.command_line = /(?i)Get-GPOReport/
          or
          // SYSVOL path enumeration via PowerShell
          $proc.target.process.command_line = /(?i)\\SYSVOL\\.+\\Policies/
        )
      )

      or

      // cmd.exe enumerating SYSVOL GPO paths directly
      (
        $proc.target.process.file.full_path = /(?i)\\cmd\.exe$/
        and
        $proc.target.process.command_line = /(?i)\\SYSVOL\\.+\\Policies/
      )
    )

    // Exclude known administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1615")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
