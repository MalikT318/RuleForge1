/*
  MITRE Technique : T1535 - Unused/Unsupported Cloud Regions
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:02:01.482150+00:00
  Reference       : https://attack.mitre.org/techniques/T1535
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1535_001_Resource_Creation_Unusual_Cloud_Region {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud resource creation events originating from geographic regions that are atypical for IaaS workloads. Adversaries compromise cloud management accounts and spin up compute, storage, or network resources in rarely-used or unsupported regions to evade monitoring and detection controls. This rule fires on any RESOURCE_CREATION event where the cloud region does not match a known-active region pattern, providing a high-fidelity signal for T1535 activity including cryptomining via resource hijacking."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1535"
    mitre_technique_name = "Unused/Unsupported Cloud Regions"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). The cloud.availability_zone or target.location.country_or_region field must be populated by the log source normalisation."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate disaster recovery or compliance-driven expansion into new regions; authorised DevOps experiments; cloud provider internal service accounts creating resources on behalf of customers."
    tuning_guidance = "Populate %global_allowed_cloud_principals with service principals and automation accounts that are authorised to create resources in any region. Extend the approved-region regex in the events block to match the customer's active region set. Consider adding a match block over the user and a threshold if alert volume is high."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Require a user or service principal to be attributed to the action
    $cloud.principal.user.userid != ""

    // Exclude approved automation and service principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known-good cloud management source addresses (scanners, CI/CD)
    not $cloud.principal.ip in %global_allowed_scanners

    // The resource must be placed in a specific location - empty location
    // strings indicate events that cannot be evaluated for region anomaly
    $cloud.target.location.country_or_region != ""

    // Detect creation in regions that do NOT match the common, well-monitored
    // region patterns. The regex below covers the major active region families
    // across AWS (us-*, eu-*, ap-southeast-1/2, ap-northeast-1), Azure
    // (eastus, westeurope, northeurope, australiaeast), and GCP
    // (us-central1, europe-west1, asia-east1). Regions outside this set
    // (e.g. ap-east-1, me-south-1, af-south-1, ap-southeast-3,
    // brazilsouth, uaenorth, jioindiawest) are flagged as unusual.
    // Tune this regex to reflect the customer's approved region footprint.
    not $cloud.target.location.country_or_region = /(?i)^(us-(east|west|central|south|north)|eu-(west|central|north|south)|ap-(southeast-[12]|northeast-[12]|south-1)|eastus[0-9]?|westus[0-9]?|westeurope|northeurope|australiaeast|southeastasia|us-central1|us-east[14]|europe-west[14]|asia-east1|asia-northeast1)$/

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1535")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $unusual_region = array_distinct($cloud.target.location.country_or_region)
    $resource_name = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
