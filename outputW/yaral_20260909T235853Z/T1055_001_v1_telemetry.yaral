/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:00:16.062088+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process opening a handle to another process with permissions consistent with DLL injection (PROCESS_VM_WRITE + PROCESS_CREATE_THREAD or PROCESS_VM_OPERATION). EDR/Sysmon telemetry surfaces these handle requests as PROCESS_OPEN events before the DLL is mapped, providing earlier and harder-to-evade coverage than command-line inspection."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR or Sysmon Event ID 10 (ProcessAccess) normalised to UDM PROCESS_OPEN. The access mask field must be populated in target.process.access_mask or an equivalent UDM field. Sysmon must be configured to log ProcessAccess events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), profilers, AV/EDR agents opening process handles for inspection, RMM tools performing memory diagnostics, JIT compilers (JVM, CLR) cross-injecting into worker processes."
    tuning_guidance = "Add known-good parent process paths (debuggers, security agents, JIT runtimes) to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow scope by excluding processes whose principal.process.file.full_path matches known-good tooling paths. Consider adding a threshold wrapper if volume is high in dev/QA environments."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener (principal) must not be a Windows system binary living in System32/SysWOW64.
    // Legitimate injectors from those paths are covered by security tool exclusions below.
    not $open.principal.process.file.full_path = /(?i)\\windows\\(system32|syswow64|sysnative)\\/ 

    // Exclude processes whose full path is empty (kernel/system context) by requiring a non-trivial path.
    $open.principal.process.file.full_path = /.+\.exe$/

    // Target must be a running user-mode process (has a pid-bearing path).
    $open.target.process.file.full_path = /.+/

    // The access mask must include flags consistent with DLL injection:
    //   PROCESS_VM_WRITE        (0x0020)
    //   PROCESS_VM_OPERATION    (0x0008)
    //   PROCESS_CREATE_THREAD   (0x0002)
    // Sysmon logs the decimal or hex access mask; Chronicle normalises it.
    // We match the hex representation that EDR/Sysmon surfaces.
    // 0x1F0FFF = PROCESS_ALL_ACCESS; 0x43A = VM_WRITE|VM_OP|CREATE_THREAD|QUERY_INFO|VM_READ
    // Broad but necessary: match any mask containing VM_WRITE (0x20) combined with CREATE_THREAD (0x02).
    // Chronicle surfaces this in security_result.description or target.process.access_mask as a hex string.
    $open.target.process.access_mask = /0x[0-9a-fA-F]*[2367aAbBcCeEfF][0-9a-fA-F]$/

    // Exclude approved security tooling that legitimately opens cross-process handles.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude self-injection (process opening a handle to itself - normal for runtimes).
    not $open.principal.process.pid = $open.target.process.pid

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $access_mask_observed = array_distinct($open.target.process.access_mask)

  condition:
    $open
}
