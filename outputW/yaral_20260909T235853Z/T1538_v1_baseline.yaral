/*
  MITRE Technique : T1538 - Cloud Service Dashboard
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:02:37.954915+00:00
  Reference       : https://attack.mitre.org/techniques/T1538
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1538_001_Cloud_Dashboard_Enumeration_M365 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects broad enumeration of Microsoft 365 administrative and service dashboards, a behaviour consistent with an adversary using stolen credentials to survey the cloud environment via the GUI rather than the API. Triggers on access to admin portal resources (Exchange Admin Center, Azure AD / Entra admin, Security & Compliance Center, SharePoint Admin, Teams Admin) from accounts not in the approved administrator allow-list."
    mitre_tactic = "Discovery"
    mitre_technique = "T1538"
    mitre_technique_name = "Cloud Service Dashboard"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log (UAL) ingested into Chronicle. Relevant workloads: AzureActiveDirectory, SecurityComplianceCenter, Exchange, SharePoint, MicrosoftTeams. UAL must be enabled at the tenant level."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate IT administrators and helpdesk staff routinely access these portals. Security team members performing reviews will also trigger this rule. Tune by adding expected admin accounts to %global_allowed_admin_users and approved service accounts to %global_allowed_service_accounts."
    tuning_guidance = "Add known-good administrator user IDs to %global_allowed_admin_users. If a specific portal URL pattern generates excessive noise for a client, narrow the regex to exclude it. Consider pairing with a USER_LOGIN event from an unusual location to increase fidelity."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target URL must match a recognised M365 administrative or service dashboard
    // Covers: admin.microsoft.com, security.microsoft.com, compliance.microsoft.com,
    //         aad.portal.azure.com / entra.microsoft.com, exchange admin, teams admin,
    //         sharepoint admin, and the Azure portal itself when accessed for M365 resources
    $cloud.target.url = /(?i)(admin\.microsoft\.com|security\.microsoft\.com|compliance\.microsoft\.com|aad\.portal\.azure\.com|entra\.microsoft\.com|admin\.exchange\.microsoft\.com|admin\.teams\.microsoft\.com|[a-z0-9\-]+\-admin\.sharepoint\.com|portal\.azure\.com)/

    // Must have an authenticated principal user - anonymous or empty principals are noise
    $cloud.principal.user.userid != ""

    // Exclude approved administrators and service accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good cloud service principals (e.g., automated compliance scanners)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1538")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_url = array_distinct($cloud.target.url)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
