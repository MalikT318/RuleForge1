/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:45:59.540759+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Firewall_Rule_Change_Then_Anomalous_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a firewall policy or ACL modification followed within 10 minutes by a network flow to an external destination that was previously blocked or unusual. This pattern indicates an adversary may have loosened firewall rules to permit command-and-control or lateral movement traffic."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Requires network device management-plane syslog normalised to UDM SETTING_MODIFICATION (firewall/ACL config changes) and NETWORK_FLOW or NETWORK_CONNECTION records from the same perimeter device."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network engineers applying planned firewall rule changes during maintenance windows; automated orchestration systems pushing policy updates; vulnerability scanners traversing newly opened paths."
    tuning_guidance = "Add authorised change-management service accounts to %global_allowed_service_accounts. Add known scanner source addresses to %global_allowed_scanners. Add approved external destinations to %global_allowed_domains. Raise the risk score if the flow destination is in a threat-intelligence feed."

  events:
    // Event 1: A firewall ACL or policy rule is modified on the network device
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.resource.name = /(?i)(acl|access.list|firewall|policy|rule|permit|deny|zone|filter)/
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users
    $cfg.principal.hostname = $device_hostname

    // Event 2: A network flow originates from the same device (or through it) to an external destination shortly after
    $flow.metadata.event_type = "NETWORK_FLOW"
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    $flow.network.sent_bytes > 0
    $flow.principal.hostname = $device_hostname

    // Chronological ordering: config change must precede the suspicious flow
    $cfg.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($device_hostname)
    $changed_resource = array_distinct($cfg.target.resource.name)
    $modifying_user = array_distinct($cfg.principal.user.userid)
    $external_destination_ips = array_distinct($flow.target.ip)
    $external_destination_ports = array_distinct($flow.target.port)
    $total_bytes_sent = max($flow.network.sent_bytes)
    $flow_count = count($flow.metadata.event_timestamp.seconds)

  condition:
    $cfg and $flow
}
