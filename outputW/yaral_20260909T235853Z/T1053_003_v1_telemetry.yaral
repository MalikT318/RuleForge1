/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:06:24.938829+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_Cron_File_Write_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of cron-related paths on Linux, indicating a potential persistence mechanism. This rule targets the file-system artifact produced when an adversary writes a crontab or drops a script into a cron execution directory, providing coverage orthogonal to process-creation/command-line rules."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate system package managers (apt, yum, dnf, rpm) installing or upgrading packages that include cron jobs; configuration management tools (Ansible, Puppet, Chef, Salt) applying scheduled task policies; authorised administrators manually editing crontabs; monitoring agents writing to /etc/cron.d/."
    tuning_guidance = "Add known-good parent process paths (e.g., package manager binaries, CM agent paths) to %global_allowed_admin_tools. Add authorised service accounts that perform scheduled maintenance to %global_allowed_service_accounts. Narrow the path regex if only user crontabs or only system-wide cron directories are relevant for a given client."

  events:
    $file.metadata.event_type = "FILE_CREATION" or $file.metadata.event_type = "FILE_MODIFICATION"

    // Match any write into the canonical cron file-system locations on Linux:
    // /etc/crontab              - system-wide crontab
    // /etc/cron.d/              - drop-in cron job fragments
    // /etc/cron.hourly|daily|weekly|monthly/ - periodic execution directories
    // /var/spool/cron/          - per-user crontabs (crontab -e writes here)
    // /var/spool/cron/crontabs/ - Debian/Ubuntu per-user crontab store
    $file.target.file.full_path = /(?i)(\/etc\/crontab$|\/etc\/cron\.(d|hourly|daily|weekly|monthly)\/|\/var\/spool\/cron\/)/ nocase

    // Exclude known-good administrative tooling (package managers, CM agents, backup tools)
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service accounts performing scheduled maintenance
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude authorised backup processes that may touch cron paths
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_cron_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
