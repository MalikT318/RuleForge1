/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:42:36.819961+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Browser_Extension_Installation_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network-observable browser or IDE extension installation activity from Linux endpoints via firewall/proxy telemetry. Adversaries abuse extension marketplaces or sideload malicious extensions to establish persistence. This rule identifies HTTP connections to known extension distribution endpoints (Chrome Web Store, Firefox AMO, VSCode Marketplace, etc.) from internal hosts, which may indicate extension installation - benign or malicious. High volume or unusual timing warrants investigation."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Requires firewall or proxy logs with HTTP/HTTPS metadata including target URL or SNI hostname. TLS inspection or proxy decryption recommended for full URL visibility."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate browser extension installations by end users, automated update checks by browsers or IDEs, IT-managed extension deployments, developer workflows installing IDE plugins."
    tuning_guidance = "Add known-good extension marketplace domains to %global_allowed_domains to suppress expected update traffic. Scope to non-developer hosts or correlate with off-hours activity to reduce noise. Consider thresholding on volume of extension download events per host per hour."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    not $net.principal.ip in %rfc1918_internal

    // Match HTTP requests targeting browser/IDE extension distribution infrastructure
    // Chrome Web Store, Firefox AMO, Edge Add-ons, VSCode Marketplace, JetBrains Marketplace
    $net.target.hostname = /(?i)(clients2\.google\.com|chrome\.google\.com|addons\.mozilla\.org|microsoftedge\.microsoft\.com|marketplace\.visualstudio\.com|open-vsx\.org|plugins\.jetbrains\.com|extensions\.gnome\.org|packagecontrol\.io)/ nocase

    // Focus on extension download or update paths - crx, xpi, vsix are extension package formats
    (
      $net.target.url = /(?i)\/(crx|webstore|updates|download|extension|xpi|vsix|install)/ nocase
      or
      $net.network.http.request_url = /(?i)\.(crx|xpi|vsix)(\?|$)/ nocase
    )

    // Exclude known-good domains already approved for this tenant
    not $net.target.hostname in %global_allowed_domains

    // Exclude approved scanner sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
