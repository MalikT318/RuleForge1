/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:32:43.794075+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_Cloud_Secret_BulkAccess_AuditLog {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects access to cloud secrets manager resources (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault) via cloud audit logs. Focuses on the API-level resource access event produced when a principal retrieves secret material, providing coverage orthogonal to command-line detection. A single access may be benign; the rule is tuned to flag access by non-service principals or access to multiple secrets in a short window via the threshold variant."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail GetSecretValue / BatchGetSecretValue, GCP Secret Manager accessSecretVersion, Azure Key Vault SecretGet). Events must populate metadata.event_type = USER_RESOURCE_ACCESS, target.resource.name, and principal.user.userid."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Legitimate application service accounts retrieving secrets at startup or runtime, CI/CD pipelines, secrets rotation automation, and authorised security scanning tools."
    tuning_guidance = "Add known automation and service account identifiers to %global_allowed_service_accounts. Add approved scanner principals to %global_allowed_scanners. Add approved cloud principals to %global_allowed_cloud_principals. Raise severity if the accessing principal has no prior history of secrets access or if access occurs outside business hours."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match the normalised API method names across AWS, GCP, and Azure.
    // AWS:   GetSecretValue, BatchGetSecretValue
    // GCP:   accessSecretVersion
    // Azure: SecretGet, secret/get
    // Chronicle normalises these into target.resource.attribute.labels or
    // target.resource.resource_type / name; the most portable signal is the
    // resource name pattern combined with the operation captured in
    // security_result.description or target.resource.name.
    (
      $cloud.target.resource.name = /(?i)(secret|secretsmanager|keyvault|key.vault|secretmanager)/ nocase
      or
      $cloud.target.resource.resource_type = /(?i)(secret|key_vault|secretversion)/ nocase
    )

    // Restrict to read/access operations - not creation or deletion.
    // Chronicle maps the cloud API action into metadata.product_event_type
    // or security_result.description depending on the normalisation pipeline.
    (
      $cloud.metadata.product_event_type = /(?i)(GetSecretValue|BatchGetSecretValue|accessSecretVersion|SecretGet|secret\/get|getSecret|DescribeSecret)/ nocase
      or
      $cloud.security_result.description = /(?i)(GetSecretValue|BatchGetSecretValue|accessSecretVersion|SecretGet|secret\/get|getSecret)/ nocase
    )

    // Exclude known-good service and automation accounts.
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved cloud service principals (e.g., rotation lambdas, CI/CD).
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved security scanning principals.
    not $cloud.principal.user.userid in %global_allowed_scanners

    // Require a principal to be present - anonymous access is a separate signal.
    $cloud.principal.user.userid != ""

    // Capture joining fields for outcome.
    $cloud.principal.user.userid = $actor
    $cloud.target.resource.name  = $secret_name

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity    = array_distinct($actor)
    $accessed_secrets  = array_distinct($secret_name)
    $source_ip         = array_distinct($cloud.principal.ip)
    $resource_type     = array_distinct($cloud.target.resource.resource_type)

  condition:
    $cloud
}
