/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:45:14.315153+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_Hardware_Backdoor_Persistence_Indicators {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects behavioral indicators consistent with hardware supply chain backdoors on Linux systems. Hardware implants and firmware backdoors commonly establish persistence by writing unexpected binaries or scripts to system directories, modifying firmware update utilities, or creating new systemd service units or init scripts from unusual parent processes. This rule targets the OS-level persistence mechanisms that hardware backdoors rely on after initial execution."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Compromise Hardware Supply Chain"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry producing FILE_CREATION or FILE_MODIFICATION events with principal process path and target file path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate firmware update tools (fwupd, flashrom), package managers writing to /lib/systemd/system, vendor-supplied hardware management agents, authorized system administrators deploying new services."
    tuning_guidance = "Add known firmware update and hardware management binaries to %global_allowed_admin_tools. Add authorized service account identities to %global_allowed_service_accounts. Scope by hostname if specific hosts run legitimate firmware tooling frequently."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: unexpected writes to firmware update paths, systemd unit directories,
    // init.d, kernel module staging areas, or udev rule directories -
    // all locations a hardware backdoor would use to survive reboots.
    $file.target.file.full_path = /(?i)(\/lib\/systemd\/system\/[^\/]+\.service$|\/etc\/systemd\/system\/[^\/]+\.service$|\/etc\/init\.d\/[^\/]+$|\/lib\/modules\/[^\/]+\/[^\/]+\.ko$|\/etc\/udev\/rules\.d\/[^\/]+\.rules$|\/usr\/lib\/firmware\/[^\/]+$|\/lib\/firmware\/[^\/]+$|\/etc\/modprobe\.d\/[^\/]+\.conf$)/

    // Parent process is NOT a known legitimate package manager, firmware updater,
    // or system provisioning tool - hardware backdoors typically arrive via
    // unusual parent processes (shell, curl, wget, python, or obscure binaries).
    $file.principal.process.file.full_path = /(?i)(\/bin\/sh$|\/bin\/bash$|\/bin\/dash$|\/usr\/bin\/python[0-9.]*$|\/usr\/bin\/perl$|\/usr\/bin\/curl$|\/usr\/bin\/wget$|\/tmp\/[^\/]+$|\/dev\/shm\/[^\/]+$|\/var\/tmp\/[^\/]+$)/

    // Exclude known legitimate administrative and package management tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known authorized service accounts performing provisioning
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $written_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
