/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:52:35.184365+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Execution_Guardrails_Env_Check_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes on Linux that perform environment fingerprinting consistent with execution guardrails - checking hostname, domain membership, IP addresses, network interfaces, or specific file/device presence before proceeding. Adversaries use these checks to ensure payloads only execute on intended targets, reducing collateral exposure. Signals include shell or interpreter processes whose command line combines environment-probing commands (hostname, ip, ifconfig, domainname, uname, id) with conditional logic (if/test/case) and file or process execution, which is the canonical guardrail pattern."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with full command-line capture (execve syscall arguments). auditd rule: -a always,exit -F arch=b64 -S execve."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate deployment scripts, configuration management tools (Ansible, Chef, Puppet), container entrypoint scripts, and health-check scripts that probe environment before configuring services."
    tuning_guidance = "Add known-good orchestration parent processes (ansible, puppet, chef-client) to %global_allowed_admin_tools. Add authorised automation service accounts to %global_allowed_service_accounts. Narrow scope by requiring the child process to be a suspicious binary (curl, wget, python, perl) rather than a benign one."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target a shell or scripting interpreter - the typical guardrail host
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|node)$/ nocase

    // Command line must contain an environment-probing keyword
    // (hostname, IP/interface query, domain check, kernel info, or file/device test)
    $proc.target.process.command_line = /\b(hostname|domainname|dnsdomainname|ip\s+(addr|route|link)|ifconfig|uname|hostnamectl|resolvectl|realm\s+list|getent\s+(hosts|passwd)|cat\s+\/etc\/(hostname|resolv\.conf|machine-id|os-release)|ls\s+\/dev\/|test\s+-[bcedfLpSs])\b/ nocase

    // Command line must also contain conditional execution logic - the guardrail gate
    $proc.target.process.command_line = /(\bif\b|\btest\b|\[\s|\[\[|\bcase\b|\&\&|\|\|)/ nocase

    // Command line must reference a subsequent action suggesting payload gating:
    // download, execute, source, or write to disk
    $proc.target.process.command_line = /(\bcurl\b|\bwget\b|\bfetch\b|\bexec\b|\beval\b|\bsource\b|\b\.\s+\/|\bchmod\b|\bpython\b|\bperl\b|\bbash\b|\bsh\b|\bnc\b|\bsocat\b|>[\s]*\/tmp\/|>[\s]*\/dev\/shm\/)/ nocase

    // Exclude known-good automation parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts running orchestration
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude scripts running from approved script hosts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
