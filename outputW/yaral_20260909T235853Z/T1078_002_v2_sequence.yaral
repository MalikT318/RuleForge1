/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:20:50.632392+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_ESXi_Domain_Account_Login_Then_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a domain account authenticating to an ESXi host followed by a host-level setting modification within one hour. This pattern is consistent with an adversary using compromised domain credentials to access the ESXi management plane and then altering host configuration for persistence or privilege escalation. Variant 2 of 2 for T1078.002 on ESXi."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires ESXi hostd and shell authentication logs normalised to UDM USER_LOGIN and SETTING_MODIFICATION event types. Chronicle ingestion via the vmware_esxi log source is required."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised domain administrators performing scheduled maintenance, automated configuration management tools (e.g. Ansible, vSphere Lifecycle Manager) using domain service accounts, and change-window activities by infrastructure teams."
    tuning_guidance = "Add known automation and management service account identifiers to %global_allowed_service_accounts. Add approved management source addresses to %global_allowed_mgmt_sources. Raise severity if the authenticating account is not in %global_allowed_admin_users."

  events:
    // Event 1: Domain account login to ESXi management plane.
    // Domain accounts are identified by the presence of a domain separator
    // (backslash or UPN @ sign) in the userid field, distinguishing them
    // from local ESXi accounts such as 'root' or 'dcui'.
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = /[@\\]/ nocase
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    $auth.target.hostname = $esxi_host

    // Event 2: Host-level setting modification on the same ESXi host,
    // attributed to the same domain account that authenticated above.
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.user.userid = /[@\\]/ nocase
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users
    $cfg.principal.hostname = $esxi_host

    // Shared join key: same ESXi host, login precedes configuration change.
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $esxi_host over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($esxi_host)
    $domain_accounts_seen = array_distinct($auth.target.user.userid)
    $settings_modified = array_distinct($cfg.target.resource.name)
    $source_ips = array_distinct($auth.principal.ip)
    $login_count = count($auth.metadata.event_timestamp.seconds)
    $setting_change_count = count($cfg.metadata.event_timestamp.seconds)

  condition:
    $auth and $cfg
}
