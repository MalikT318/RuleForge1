/*
  MITRE Technique : T1653 - Power Settings
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:25:31.141871+00:00
  Reference       : https://attack.mitre.org/techniques/T1653
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1653_Power_Settings_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects abuse of powercfg.exe to disable sleep, hibernate, standby, or lock-screen timeouts, which adversaries use to prevent infected hosts from entering dormant states that would terminate malicious activity."
    mitre_tactic = "Persistence"
    mitre_technique = "T1653"
    mitre_technique_name = "Power Settings"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 capturing full command lines."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT administrators tuning power plans on servers or kiosks, deployment scripts configuring power settings for always-on workstations, RMM agents applying power policy baselines."
    tuning_guidance = "Add known administrative parent processes or service account identities to %global_allowed_admin_tools and %global_allowed_service_accounts. Consider narrowing to interactive user sessions if server false-positive rates are high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be powercfg
    $proc.target.process.file.full_path = /(?i)\\powercfg(\.exe)?$/

    // Match command-line patterns that disable or maximise sleep/hibernate/standby/lock timeouts
    // /change or / sets a timeout value; value of 0 disables the timeout entirely
    // /hibernate off disables hibernation
    // /setacvalueindex or /setdcvalueindex with GUID-based subgroup can also set timeouts
    (
      $proc.target.process.command_line = /(?i)(\/change|\/x)\s+(standby-timeout|hibernate-timeout|disk-timeout|monitor-timeout|lock-timeout)\s+0/
      or
      $proc.target.process.command_line = /(?i)\/hibernate\s+off/
      or
      $proc.target.process.command_line = /(?i)(\/setacvalueindex|\/setdcvalueindex).{0,200}(standby|hibernate|sleep|lock)/
      or
      $proc.target.process.command_line = /(?i)(\/change|\/x)\s+(standby-timeout|hibernate-timeout|disk-timeout|monitor-timeout)\s+\d{4,}/
    )

    // Exclude approved administrative tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service accounts performing legitimate power management
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1653")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
