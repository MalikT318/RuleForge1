/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:29:02.384724+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_001_Rootkit_Driver_Load_Suspicious {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects suspicious kernel driver registration via the registry, a primary mechanism used by Windows rootkits to load kernel-mode code. Rootkits register malicious drivers under HKLM\\SYSTEM\\CurrentControlSet\\Services with a Start type of 1 (System) or 3 (Demand) and a Type of 1 (Kernel Driver). This rule fires when a process outside of known system paths writes a new ImagePath value under a Services key, which is the canonical OS mechanism rootkits depend on to persist and load at boot or on demand."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry capturing REGISTRY_CREATION or REGISTRY_MODIFICATION events with principal process path and target registry key/value populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party kernel drivers installed by security software, hardware vendors, VPN clients, or virtualisation tools. Software deployment agents may also write driver service keys during installation."
    tuning_guidance = "Add known-good installer and driver management processes to %global_allowed_admin_tools. Consider scoping to non-interactive sessions or correlating with unsigned driver file creation events for higher fidelity."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"

    // Target the canonical Services registry hive used to register kernel drivers
    $reg.target.registry.registry_key = /\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Services\\[^\\]+$/ nocase

    // Focus on ImagePath value writes - the field that points to the driver binary on disk
    $reg.target.registry.registry_value_name = /^ImagePath$/  nocase

    // Driver binary path must point to a .sys file (kernel driver extension)
    $reg.target.registry.registry_value_data = /\.sys(\s|$|")/  nocase

    // Exclude writes originating from known Windows system directories
    // Legitimate OS driver installs come from system32, syswow64, or trusted installer paths
    not $reg.principal.process.file.full_path = /(?i)\\Windows\\(System32|SysWOW64|WinSxS|servicing)\\/ 
    not $reg.principal.process.file.full_path = /(?i)\\Windows\\(explorer|regedit)\.exe$/

    // Exclude known-good administrative and deployment tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good security tools (EDR/AV agents that manage their own drivers)
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

    // Require a principal process to be present (filter out kernel-originated writes)
    $reg.principal.process.file.full_path != ""

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = "T1014"
    $primary_entity = $reg.principal.hostname

  condition:
    $reg
}
