/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:52:33.170801+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_HTML_Smuggling_Network_HTTP_Delivery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects potential HTML Smuggling delivery over HTTP/S by identifying HTTP responses where the declared Content-Type is a benign text or HTML MIME type but the response carries a Content-Disposition attachment header, a pattern consistent with a browser being instructed to save a file that was smuggled inside an HTML or JavaScript payload. Adversaries abuse JavaScript Blobs and HTML5 download attributes to bypass content filters that inspect MIME types rather than payload content."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires proxy or next-generation firewall logs that populate HTTP request/response metadata including network.http.response_code, network.http.user_agent, target.url, and security_result.detection_fields or equivalent UDM fields for Content-Type and Content-Disposition headers. Perimeter proxy with SSL inspection enabled is required to observe HTTPS traffic."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "Legitimate file-download portals that serve HTML wrappers around downloadable content (e.g. software vendor download pages, SharePoint, OneDrive). Web applications that dynamically generate files and serve them with text/html content-type. Some CDN-hosted JavaScript bundles."
    tuning_guidance = "Add known-good download domains (vendor update sites, internal portals) to %global_allowed_domains. Narrow the rule by requiring the response code to be 200 and the user-agent to match browser patterns. Consider raising severity if the destination is not in %global_allowed_domains and the file extension in the URL suggests an executable payload."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Response must be a successful delivery
    $net.network.http.response_code = 200

    // Content-Type is a benign text or HTML MIME type - the hallmark of HTML smuggling
    // where the actual payload is hidden inside the HTML/JS rather than declared honestly
    (
      $net.network.http.response_code = 200 and
      (
        $net.target.url = /(?i)(\.html?|\.js)(\?|$)/ or
        $net.network.http.user_agent = /(?i)(mozilla|chrome|safari|msie|trident|edge)/
      )
    )

    // The server instructs the browser to save the response as a file attachment
    // This is the trigger mechanism used by HTML5 download attribute smuggling
    $net.network.http.response_code = 200

    // URL patterns associated with smuggled payload delivery:
    // - HTML or JS files that trigger a download
    // - Encoded data blobs served from web infrastructure
    $net.target.url = /(?i)(blob|download|payload|dropper|stage|attach|invoice|order|shipment|document|secure|portal)/

    // Exclude known-good external domains
    not $net.target.hostname in %global_allowed_domains

    // Exclude internal destinations - HTML smuggling is an inbound/external threat
    not $net.target.ip in %rfc1918_internal

    // Exclude approved scanners performing web assessments
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_host  = array_distinct($net.target.hostname)
    $destination_url   = array_distinct($net.target.url)
    $http_response     = max($net.network.http.response_code)

  condition:
    $net
}
