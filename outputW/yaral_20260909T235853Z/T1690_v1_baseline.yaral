/*
  MITRE Technique : T1690 - Prevent Command History Logging
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:31:56.363630+00:00
  Reference       : https://attack.mitre.org/techniques/T1690
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1690_001_Prevent_Command_History_Logging_Windows {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects attempts to suppress PowerShell command history logging on Windows by modifying the PSReadLine history save style, disabling the module, or manipulating the history file path via process command-line arguments. Adversaries disable or redirect PowerShell history to avoid forensic recovery of executed commands."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1690"
    mitre_technique_name = "Prevent Command History Logging"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture. PowerShell script-block logging (Event 4104) also surfaces this behaviour."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Security tooling that resets PSReadLine settings during automated testing; some CI/CD pipeline agents that configure non-interactive PowerShell sessions."
    tuning_guidance = "Add known automation service accounts to %global_allowed_service_accounts and known pipeline hosts to %global_allowed_script_hosts to reduce noise from legitimate build infrastructure."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be a PowerShell interpreter variant
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase

    // Match any of the known Windows-specific history suppression patterns:
    // 1. Set-PSReadLineOption -HistorySaveStyle SaveNothing
    // 2. Remove-Module PSReadLine (disables history entirely)
    // 3. Set-PSReadlineOption with SaveNothing (older alias)
    // 4. $null assignment or empty string to HISTFILE equivalent (PSReadLine path)
    // 5. Setting HistorySavePath to nul or empty
    (
      $proc.target.process.command_line = /SaveNothing/ nocase
      or
      $proc.target.process.command_line = /Remove-Module\s+PSReadLine/ nocase
      or
      $proc.target.process.command_line = /Set-PSReadLine(Option)?\s+.*HistorySave/ nocase
      or
      $proc.target.process.command_line = /HistorySavePath\s*[=,]\s*(\\\\\.\\nul|nul|\"\"|\$null)/ nocase
      or
      $proc.target.process.command_line = /HistoryNoDuplicates\s*\$false/ nocase
    )

    // Exclude approved script hosts and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1690")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
