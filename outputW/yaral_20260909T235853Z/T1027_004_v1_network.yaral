/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:51:02.155912+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_CompileAfterDelivery_NetworkFetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound network connections to external destinations on ports commonly used to fetch source code or compiler toolchains (HTTP/HTTPS/FTP/raw TCP) from Windows hosts. Compile-After-Delivery attacks retrieve uncompiled payloads (C#, C, VB source) from external infrastructure before compiling locally with csc.exe, ilasm.exe, or MinGW. A firewall or proxy log showing an outbound connection to a non-RFC1918 address on these ports from a Windows workstation or server is a network-side indicator of this staging behaviour."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires firewall or perimeter proxy logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Destination IP, destination port, and source IP must be populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate developer workstations fetching NuGet packages, GitHub source archives, or build dependencies. CI/CD pipeline agents making outbound connections to package repositories. Software update mechanisms for IDEs or compilers."
    tuning_guidance = "Add known-good developer source IPs or subnets to %global_allowed_mgmt_sources. Add approved external package repository domains to %global_allowed_domains. Scope the rule to non-developer asset groups via principal.hostname exclusions if your CMDB data is available in Chronicle."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Destination must be external (not RFC1918)
    not $net.target.ip in %rfc1918_internal

    // Ports associated with source code / compiler toolchain retrieval:
    // 80  = HTTP (plain source fetch, raw GitHub, pastebin-style staging)
    // 443 = HTTPS (encrypted source fetch, package repos)
    // 21  = FTP (legacy source delivery)
    // 8080 = alternate HTTP proxy / staging server
    // 8443 = alternate HTTPS staging
    (
        $net.target.port = 80 or
        $net.target.port = 443 or
        $net.target.port = 21 or
        $net.target.port = 8080 or
        $net.target.port = 8443
    )

    // Source must not be an approved scanner or management source
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude connections originating from known-good admin tooling hosts
    not $net.principal.hostname in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
