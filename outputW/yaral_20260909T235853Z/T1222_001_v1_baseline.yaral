/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:51:52.968851+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_Windows_Permission_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects use of built-in Windows permission-modification utilities (icacls, cacls, takeown, attrib) with arguments that grant broad access, remove ACL restrictions, or take ownership of files and directories. Adversaries abuse these tools to bypass DACLs and access protected files during defense evasion or privilege escalation."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "System administrators performing legitimate ACL remediation, software installers adjusting permissions during setup, backup agents, and RMM tooling. Attrib usage for hiding files during legitimate archival workflows."
    tuning_guidance = "Add known-good parent processes (e.g., installer engines, deployment agents) to %global_allowed_admin_tools. Scope exclusions to specific hosts using %global_allowed_script_hosts if the activity is limited to known management systems. Consider narrowing to sensitive directory paths (e.g., System32, ProgramData, user profile roots) if noise is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the four primary Windows DACL/ownership manipulation binaries
    $proc.target.process.file.full_path = /\\(icacls|cacls|takeown|attrib)\.exe$/  nocase

    // icacls/cacls: granting Everyone, full control, or resetting/removing ACLs
    // takeown: taking ownership (any invocation is suspicious in most contexts)
    // attrib: setting hidden (+h) or system (+s) attributes to conceal files
    (
      $proc.target.process.command_line = /\/grant(:\w+)?\s+(everyone|users|authenticated\s+users)/  nocase or
      $proc.target.process.command_line = /\(F\)/  nocase or
      $proc.target.process.command_line = /\/inheritance:r/  nocase or
      $proc.target.process.command_line = /\/reset/  nocase or
      $proc.target.process.command_line = /takeown/  nocase or
      $proc.target.process.command_line = /\+[hs]/  nocase
    )

    // Exclude known-good administrative and deployment tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_observed = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
