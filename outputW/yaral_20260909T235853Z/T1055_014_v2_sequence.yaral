/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:08:47.455962+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_VDSO_Hijack_ProcMem_Then_SharedLib {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage VDSO hijacking pattern: a process opens /proc/<pid>/mem (or /proc/<pid>/maps) to inspect or patch a target process's address space, followed shortly after by the creation or modification of a shared object (.so) file in a world-writable or unusual directory on the same host. Together these events indicate an adversary reading the target's GOT/VDSO layout and then staging a malicious shared library for injection."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. Auditd rules must capture openat/open syscalls on /proc/*/mem and /proc/*/maps (FILE_READ or FILE_OPEN), and file-creation events for .so files. EDR agents that emit FILE_CREATION and FILE_MODIFICATION events for shared libraries are also sufficient."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, lldb, strace), profilers (perf, valgrind), JVM/JIT runtimes that write shared stubs to /tmp or /dev/shm, and security tools that inspect process memory. Exclude known-good parent processes via %global_allowed_security_tools and %global_allowed_admin_tools."
    tuning_guidance = "Add authorised debugger and profiler parent-process paths to %global_allowed_security_tools. If a build system legitimately writes .so files to /tmp or /dev/shm, add its process path to %global_allowed_admin_tools. Narrow the shared-library path regex to exclude known-good build output directories."

  events:
    // Stage 1: process reads /proc/<pid>/mem or /proc/<pid>/maps to inspect
    // a target process's virtual address space (VDSO layout, GOT addresses).
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|pagemap)$/
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname

    // Stage 2: a shared object is created or modified in a world-writable or
    // non-standard location on the same host — the staged malicious library.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(tmp|dev\/shm|var\/tmp|run\/shm|proc\/[0-9]+)[^\s]*\.so(\.[0-9]+)*$/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: memory inspection precedes library staging.
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity    = array_distinct($hostname)
    $proc_mem_paths    = array_distinct($open.target.file.full_path)
    $so_paths_created  = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($open.principal.process.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $open and $file
}
