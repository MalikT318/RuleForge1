/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:11:20.338181+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Session_Hijack_TSCon {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects RDP session hijacking via tscon.exe, which allows a process running as SYSTEM to take over a disconnected or active Remote Desktop session without credentials. Adversaries invoke tscon.exe directly or via a service/scheduled-task to move laterally and escalate privileges by stealing Domain Admin or other high-value sessions."
    mitre_tactic    = "Lateral Movement"
    mitre_technique = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH, capturing command-line arguments and parent process path."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate IT administrators using tscon.exe for session management; Remote Desktop Services health-check tooling; some RMM platforms that reconnect sessions programmatically."
    tuning_guidance = "Add authorised admin account usernames to %global_allowed_admin_users and authorised parent process paths (e.g. RMM agents) to %global_allowed_admin_tools to suppress known-good invocations. Consider narrowing on parent process being services.exe or cmd.exe spawned by a service to raise fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // tscon.exe is the only native Windows binary that performs RDP session takeover
    $proc.target.process.file.full_path = /(?i)\\tscon\.exe$/

    // Must supply a session ID (numeric) or session name; optionally /dest: to redirect
    // Matches: tscon <id>, tscon <id> /dest:console, tscon rdp-tcp#<n>
    $proc.target.process.command_line = /(?i)tscon(\.exe)?\s+(\d+|rdp-tcp)/

    // High-fidelity signal: tscon launched by services.exe (service-based hijack),
    // cmd.exe, or powershell.exe - all common adversary delivery mechanisms.
    // Exclude legitimate session-management parents via reference list.
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known authorised admin accounts performing session management
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $target_cmdline    = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $acting_user       = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
