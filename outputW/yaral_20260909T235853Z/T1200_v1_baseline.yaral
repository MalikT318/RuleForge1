/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:45:58.780141+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_New_Network_Interface_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects first external network connection from a newly observed network interface, potentially indicating hardware addition such as rogue wireless adapter, USB Ethernet, or network implant."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Requires firewall or perimeter network flow logs with interface metadata."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate new network interfaces during infrastructure changes, USB Ethernet adapters for authorized remote access, new VPN tunnels, container network interfaces, virtual machine network adapters."
    tuning_guidance = "Baseline expected interface naming patterns for your environment. Add known management source addresses to %global_allowed_mgmt_sources. Exclude authorized remote access tools and VPN concentrators."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_domains
    $net.network.interface_name = /^(usb|eth[2-9]|wlan[1-9]|wwan|ppp|tun[1-9]|tap[1-9])/ nocase
    $net.target.port != 53
    $net.target.port != 123
    not $net.target.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($net.principal.hostname)
    $suspicious_interface = array_distinct($net.network.interface_name)
    $external_destinations = array_distinct($net.target.ip)

  condition:
    $net
}
