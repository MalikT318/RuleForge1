/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : SaaS
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:10:36.209867+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_ESXi_Shell_Enable_Then_Auth {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage ESXi management-plane attack pattern: first, the ESXi Shell or SSH service is enabled via a host configuration change, followed shortly after by an interactive login to the same host. Enabling the shell exposes a command interpreter on the hypervisor; the subsequent login suggests an adversary is preparing to execute commands directly on the ESXi host, bypassing vCenter controls."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires ESXi hostd or vCenter audit logs normalised to Chronicle UDM. SETTING_MODIFICATION events must be generated when ESXi Shell or SSH service state changes. USER_LOGIN events must be generated for direct ESXi host authentication."
    platform = "SaaS"
    log_source = "vmware_esxi"
    false_positives = "Authorised maintenance windows where administrators intentionally enable the ESXi shell for patching or troubleshooting. Automated configuration management tools (Ansible, Terraform) that enable and immediately use SSH."
    tuning_guidance = "Add known maintenance service accounts to %global_allowed_service_accounts. Add authorised management source IPs to %global_allowed_mgmt_sources. Consider narrowing the time window from 5m to 2m to reduce false positives in environments with frequent shell-enable events."

  events:
    // Event 1: ESXi Shell or SSH service is enabled (host configuration change)
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.resource.name = /(?i)(esxi\s*shell|tsm-ssh|ssh|shellservice)/
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.ip in %global_allowed_mgmt_sources
    $cfg.principal.hostname = $esxi_host

    // Event 2: Interactive login to the same ESXi host shortly after
    $auth.metadata.event_type = "USER_LOGIN"
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources
    $auth.target.hostname = $esxi_host

    // Enforce chronological ordering: shell enabled before login
    $cfg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $esxi_host over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($esxi_host)
    $enabling_user = array_distinct($cfg.principal.user.userid)
    $login_user = array_distinct($auth.principal.user.userid)
    $login_source_ip = array_distinct($auth.principal.ip)
    $setting_changed = array_distinct($cfg.target.resource.name)

  condition:
    $cfg and $auth
}
