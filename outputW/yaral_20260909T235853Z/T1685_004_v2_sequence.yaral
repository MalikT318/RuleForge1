/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:40:58.667911+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Auditd_Config_Tamper_Then_Service_Stop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage Linux Audit system impairment: first a modification to an auditd configuration or rules file, followed within 10 minutes by a process launch that stops or disables the auditd service. Together these indicate an adversary attempting to blind the audit subsystem before or after making persistent rule changes."
    mitre_tactic    = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR or auditd file-monitoring telemetry producing FILE_MODIFICATION events for /etc/audit/ paths, and PROCESS_LAUNCH events for systemctl/service/kill invocations."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate sysadmin patching of audit rules followed by a service restart; configuration management tools (Ansible, Puppet, Chef) that update audit.rules and bounce the service as part of a hardening run."
    tuning_guidance = "Add authorised configuration-management service accounts to %global_allowed_service_accounts and approved admin hosts to %global_allowed_admin_tools. Consider narrowing the file path regex if only specific rule files are in scope."

  events:
    // Leg 1: modification of an auditd configuration or rules file
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/etc\/audit\/(audit\.rules|audit\.conf|rules\.d\/.+)/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Leg 2: a process launch that stops, disables, or kills the auditd service
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/systemctl$/ nocase
        and
        $proc.target.process.command_line = /(?i)(stop|disable|mask)\s+audit/
      )
      or
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/service$/ nocase
        and
        $proc.target.process.command_line = /(?i)auditd\s+stop/
      )
      or
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/kill(all|5)?$/ nocase
        and
        $proc.target.process.command_line = /(?i)auditd/
      )
    )
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Chronological ordering: file modification must precede or coincide with service stop
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1685.004")
    $primary_entity      = array_distinct($hostname)
    $modified_files      = array_distinct($file.target.file.full_path)
    $stop_commands       = array_distinct($proc.target.process.command_line)
    $acting_users        = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
