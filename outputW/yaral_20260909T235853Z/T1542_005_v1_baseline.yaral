/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:04:53.513338+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_TFTP_Boot_Netboot_Detection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP traffic (UDP/69) originating from or destined to a network device that is not sourced from an approved management server. Adversaries abuse TFTP netbooting to load unauthorized or modified OS images onto network devices at boot time, enabling persistent backdoors and configuration tampering."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs that capture UDP port 69 traffic. Ensure the firewall policy permits logging of management-plane and out-of-band network segments."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized network device image deployments from a centralized TFTP/NMS server, PXE boot infrastructure, legitimate network provisioning workflows. Tune by adding approved TFTP server IPs to %global_allowed_mgmt_sources."
    tuning_guidance = "Add all authorized TFTP server source addresses to %global_allowed_mgmt_sources. If internal RFC1918 TFTP traffic is expected and logged, also exclude those source addresses. Raise severity to Critical if the TFTP source is external (non-RFC1918)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // TFTP operates exclusively on UDP port 69
    $net.target.port = 69

    // Exclude traffic sourced from approved management and provisioning servers
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude known-good scanners that may probe UDP/69
    not $net.principal.ip in %global_allowed_scanners

    // Capture source and destination for outcome enrichment
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ip = array_distinct($src_ip)
    $destination_ip = array_distinct($dst_ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
