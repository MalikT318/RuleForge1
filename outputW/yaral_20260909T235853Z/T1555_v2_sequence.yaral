/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:29:04.134871+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Cloud_Secret_Bulk_Access_Then_Exfil_Attempt {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud identity performing bulk access to secrets/credentials in a cloud secrets vault (e.g., AWS Secrets Manager, Azure Key Vault, GCP Secret Manager) followed by an attempt to access or enumerate additional cloud resources, indicating potential credential harvesting from cloud password stores."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM. AWS CloudTrail GetSecretValue/ListSecrets, Azure Key Vault audit events, or GCP Secret Manager access events must be ingested."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Automated rotation pipelines, CI/CD systems retrieving secrets at build time, backup agents, and approved secrets management tooling. Service accounts performing scheduled secret retrieval will trigger this rule."
    tuning_guidance = "Add known automation and CI/CD service account identifiers to %global_allowed_service_accounts. Add approved cloud principals performing bulk secret access to %global_allowed_cloud_principals. Raise the threshold count or tighten the time window if the environment has high-volume legitimate secret access patterns."

  events:
    // Event 1: Access to a secrets/credentials resource in a cloud vault
    $secret.metadata.event_type = "USER_RESOURCE_ACCESS"
    $secret.target.resource.name = /(?i)(secret|vault|credential|password|key)/
    $secret.principal.user.userid != ""
    not $secret.principal.user.userid in %global_allowed_service_accounts
    not $secret.principal.user.userid in %global_allowed_cloud_principals
    $secret.principal.user.userid = $cloud_user

    // Event 2: Subsequent resource access or enumeration of additional cloud resources
    // indicating the actor is pivoting or staging further access after harvesting credentials
    $enum.metadata.event_type = "USER_RESOURCE_ACCESS"
    $enum.target.resource.name != ""
    $enum.principal.user.userid = $cloud_user
    not $enum.principal.user.userid in %global_allowed_service_accounts
    not $enum.principal.user.userid in %global_allowed_cloud_principals

    // Chronological ordering: secret access must precede the enumeration/pivot
    $secret.metadata.event_timestamp.seconds <= $enum.metadata.event_timestamp.seconds

    // Ensure the second event targets a DIFFERENT resource to avoid self-join on the same event
    $secret.target.resource.name != $enum.target.resource.name

  match:
    $cloud_user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($cloud_user)
    $accessed_secret_resources = array_distinct($secret.target.resource.name)
    $subsequent_resources_accessed = array_distinct($enum.target.resource.name)
    $source_ips = array_distinct($secret.principal.ip)
    $secret_access_count = count($secret.metadata.event_timestamp.seconds)
    $enum_access_count = count($enum.metadata.event_timestamp.seconds)

  condition:
    $secret and $enum
}
