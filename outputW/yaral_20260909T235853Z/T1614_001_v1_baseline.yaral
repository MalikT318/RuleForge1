/*
  MITRE Technique : T1614.001 - System Language Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:22:48.537764+00:00
  Reference       : https://attack.mitre.org/techniques/T1614/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_Linux_System_Language_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects processes querying system locale, language, or keyboard layout configuration on Linux. Adversaries enumerate locale settings to determine geographic location of the victim host, often to conditionally execute or suppress malicious payloads in certain regions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614.001"
    mitre_technique_name = "System Location Discovery: System Language Discovery"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with command-line arguments captured."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "System administrators checking locale settings, configuration management tools (Ansible, Puppet, Chef), software installers performing locale detection, monitoring agents, and shell profile scripts sourcing locale variables."
    tuning_guidance = "Add known-good parent processes (configuration management agents, package managers) to %global_allowed_admin_tools. Add authorised service accounts performing locale checks to %global_allowed_service_accounts. Consider narrowing by parent process lineage if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match locale/language discovery binaries or shell built-ins reading locale config
    (
      // Direct locale query tools
      $proc.target.process.file.full_path = /\/(locale|localectl|langtable)$/ nocase
      or
      // Shell commands reading locale-related environment or config files
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|fish|python[23]?|perl|ruby)$/ nocase
        and
        (
          $proc.target.process.command_line = /\/etc\/locale\.conf/ nocase
          or
          $proc.target.process.command_line = /\/etc\/default\/locale/ nocase
          or
          $proc.target.process.command_line = /\/etc\/locale\.gen/ nocase
          or
          $proc.target.process.command_line = /\/etc\/environment/ nocase
          or
          $proc.target.process.command_line = /LANG(UAGE)?=/ nocase
          or
          $proc.target.process.command_line = /LC_ALL/ nocase
          or
          $proc.target.process.command_line = /LC_MESSAGES/ nocase
          or
          $proc.target.process.command_line = /setxkbmap/ nocase
          or
          $proc.target.process.command_line = /\/proc\/[0-9]+\/environ/ nocase
        )
      )
      or
      // cat/grep/awk reading locale config files directly
      (
        $proc.target.process.file.full_path = /\/(cat|grep|awk|sed|head|tail|cut|xargs)$/ nocase
        and
        (
          $proc.target.process.command_line = /\/etc\/locale\.conf/ nocase
          or
          $proc.target.process.command_line = /\/etc\/default\/locale/ nocase
          or
          $proc.target.process.command_line = /\/etc\/locale\.gen/ nocase
        )
      )
      or
      // setxkbmap and xkbmap for keyboard layout enumeration
      $proc.target.process.file.full_path = /\/setxkbmap$/ nocase
      or
      // timedatectl can reveal locale/timezone used for geo-inference
      (
        $proc.target.process.file.full_path = /\/timedatectl$/ nocase
        and
        $proc.target.process.command_line = /status/ nocase
      )
    )

    // Exclude known-good administrative and automation tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1614.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
