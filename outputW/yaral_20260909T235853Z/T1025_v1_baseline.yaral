/*
  MITRE Technique : T1025 - Data from Removable Media
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:29:20.040845+00:00
  Reference       : https://attack.mitre.org/techniques/T1025
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1025_001_Data_Collection_Removable_Media {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects processes enumerating or reading files from removable media drive letters (D:-Z:) via command-line tools. Adversaries use cmd, PowerShell, or scripting hosts to collect sensitive data from USB drives or optical media connected to a compromised host."
    mitre_tactic = "Collection"
    mitre_technique = "T1025"
    mitre_technique_name = "Data from Removable Media"
    log_prerequisites = "Requires EDR process telemetry with command-line capture (Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, or SentinelOne). Command-line logging must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup software reading removable media, IT imaging tools, legitimate file copy operations by administrators, antivirus scanning removable drives."
    tuning_guidance = "Add known backup and imaging parent processes to %global_allowed_backup_processes. Add approved admin accounts to %global_allowed_admin_users. Narrow the drive-letter regex if specific drive letters are always internal in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target known enumeration and file-access binaries
    $proc.target.process.file.full_path = /\\(cmd\.exe|powershell\.exe|pwsh\.exe|xcopy\.exe|robocopy\.exe|copy\.exe|wscript\.exe|cscript\.exe|mshta\.exe|forfiles\.exe|where\.exe|findstr\.exe|dir\.exe)$/ nocase

    // Command line references a removable-media drive letter (D: through Z:)
    // Excludes C: (system) and A:/B: (legacy floppy) to focus on USB/optical
    $proc.target.process.command_line = /\b[D-Zd-z]:\\/ nocase

    // Exclude common system and administrative parent processes that legitimately touch removable media
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1025")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggered_process = array_distinct($proc.target.process.file.full_path)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
