/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:53:17.700344+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_Suspicious_PE_Written_To_Temp_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PE files (DLL or EXE) written to user-writable or temporary directories by processes that are not known software installers or build tools. Malware using dynamic API resolution (T1027.007) commonly drops a packed or obfuscated stage-two PE to a temp or user-profile path before executing it. This rule pivots on the FILE_CREATION artifact rather than command-line arguments, providing coverage that is additive to process-launch detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events, including target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers writing DLLs to TEMP during setup, JIT compilers (e.g., .NET CLR, Java JIT) writing native images, game anti-cheat engines, and some security tools. Tune by adding known parent processes to %global_allowed_admin_tools."
    tuning_guidance = "Add known-good installer or build-tool parent process paths to %global_allowed_admin_tools. If a specific user temp path pattern generates noise from a known application, add the parent process to the exclusion list rather than broadening the path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a PE file (EXE or DLL) written to a user-writable or
    // temporary location. These paths are strongly associated with malware
    // staging and are not typical destinations for legitimate software
    // installation of final binaries.
    $file.target.file.full_path = /(?i)\\(Temp|tmp|AppData\\Local\\Temp|AppData\\Roaming|ProgramData\\[^\\]+\\Temp|Users\\[^\\]+\\AppData\\Local\\Temp|Users\\[^\\]+\\AppData\\Roaming)[^\\]*\\[^\\]+\.(exe|dll)$/

    // Exclude writes by known administrative or deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude writes by known backup processes
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude writes by known security tools (e.g., EDR self-updates)
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Flag when the writing process is itself living in a suspicious or
    // user-writable location, which is a strong indicator of a dropped loader
    // writing its next stage. This is the key behavioural signal: a process
    // that is ALREADY in a temp/user path writing another PE.
    $file.principal.process.file.full_path = /(?i)\\(Temp|tmp|AppData\\Local\\Temp|AppData\\Roaming|ProgramData|Users\\[^\\]+\\AppData)[^\\]*\\[^\\]+\.(exe|dll|scr|com)$/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $written_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
