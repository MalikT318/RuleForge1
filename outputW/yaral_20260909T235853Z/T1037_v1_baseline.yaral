/*
  MITRE Technique : T1037 - Boot or Logon Initialization Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:30:24.386583+00:00
  Reference       : https://attack.mitre.org/techniques/T1037
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_ESXi_Persistence_Script_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi boot or initialization scripts used for persistence, including rc.local.d scripts, boot configuration, or autostart scripts."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037"
    mitre_technique_name = "Boot or Logon Initialization Scripts"
    log_prerequisites = "Requires ESXi hostd or shell audit logs capturing file modifications."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate ESXi host configuration changes by administrators, VMware Update Manager operations, authorized automation scripts, vCenter-initiated configuration changes."
    tuning_guidance = "Add authorized management service accounts to %global_allowed_service_accounts and approved administrative users to %global_allowed_admin_users. Exclude known automation tools modifying boot scripts from %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    (
      $file.target.file.full_path = /\/etc\/rc\.local\.d\// nocase or
      $file.target.file.full_path = /\/etc\/vmware\/init\// nocase or
      $file.target.file.full_path = /\/etc\/init\.d\// nocase or
      $file.target.file.full_path = /\/etc\/rc\.d\// nocase or
      $file.target.file.full_path = /\/etc\/profile\.d\// nocase or
      $file.target.file.full_path = /\/etc\/vmware\/hostd\/env/ nocase or
      $file.target.file.full_path = /\/etc\/vmware\/vpxa\/vpxa\.cfg/ nocase or
      $file.target.file.full_path = /\/bootbank\/boot\.cfg/ nocase or
      $file.target.file.full_path = /\/altbootbank\/boot\.cfg/ nocase or
      $file.target.file.full_path = /\/etc\/rc\.local/ nocase
    )
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
