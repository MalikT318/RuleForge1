/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:37:47.949987+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_IaaS_Security_Monitoring_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud control-plane API calls that disable, delete, or modify security monitoring services, logging pipelines, or guardrail configurations in IaaS environments. Covers actions such as disabling cloud-native logging, deleting log sinks/trails, disabling security hub or monitoring agents, and removing alerting policies. Targets the resulting configuration state change rather than the command used to invoke it."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Cloud Audit Logs). SETTING_MODIFICATION and RESOURCE_DELETION events must be ingested."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorised cloud administrators decommissioning legacy monitoring stacks, infrastructure-as-code pipelines rotating log sinks, security team maintenance windows."
    tuning_guidance = "Add approved automation service principals to %global_allowed_cloud_principals and approved admin users to %global_allowed_admin_users. Consider narrowing by target.resource.name patterns for known-good maintenance resources."

  events:
    // Target the configuration state change, not the process that caused it.
    // Match SETTING_MODIFICATION (logging/monitoring config changes) or
    // RESOURCE_DELETION (destruction of a monitoring resource).
    (
      $cloud.metadata.event_type = "SETTING_MODIFICATION" or
      $cloud.metadata.event_type = "RESOURCE_DELETION"
    )

    // The API operation name must indicate a security-relevant disable/delete/update
    // action targeting logging, monitoring, alerting, or security services.
    // Covers patterns across AWS, Azure, and GCP after UDM normalisation.
    $cloud.target.resource.name = /(?i)(trail|sink|subscription|diagnostic.setting|log.profile|monitoring|security.center|security.hub|guardduty|inspector|defender|alert.rule|notification.channel|metric.alert|log.analytics|workspace|siem|flow.log|audit.log|cloud.watch|stackdriver|log.bucket|retention.policy|event.source|sensor|agent.config|watcher|insight|detector|finding.aggregator)/ nocase

    // The operation itself must be a destructive or disabling action.
    $cloud.security_result.summary = /(?i)(delete|disable|stop|remove|deactivate|suspend|turn.off|set.disabled|update.*disabled|modify.*disabled|patch.*disabled|put.*disabled)/ nocase

    // Exclude known-good automation service principals.
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known-good administrator accounts performing authorised maintenance.
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $operation_summary = array_distinct($cloud.security_result.summary)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
