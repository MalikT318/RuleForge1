/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:02:47.808245+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_001_Decoded_Executable_Dropped_To_Disk {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the artifact-layer result of T1140 deobfuscation/decoding: a PE-like or script file written to a suspicious staging path on Windows. Attackers using certutil, PowerShell, or custom malware to decode hidden payloads must ultimately write the decoded artifact to disk. This rule targets that file-creation event rather than the decoding command line, providing coverage when command-line logging is absent or tampered with."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION telemetry normalised into UDM. Sysmon Event ID 11 (FileCreate) or equivalent EDR file-write events must be enabled and forwarded."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers writing executables to temp directories, developer toolchains, package managers (npm, pip, nuget) extracting binaries, backup or deployment agents staging files."
    tuning_guidance = "Add known-good parent processes (installers, package managers, deployment agents) to %global_allowed_admin_tools. Add known-good service accounts that perform software deployment to %global_allowed_service_accounts. Narrow the path regex if a specific staging directory generates excessive noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: executable or script file extensions commonly produced by decoding operations
    $file.target.file.full_path = /\.(exe|dll|ps1|vbs|js|hta|bat|cmd|scr|cpl|msi|jar|py)$/ nocase

    // Written into high-risk staging locations: temp dirs, user profile roots,
    // recycle bin, public folders, ProgramData subdirs, and web-accessible paths.
    // Legitimate software rarely writes final executables here without an installer context.
    $file.target.file.full_path = /(?i)(\\Temp\\|\\AppData\\Local\\Temp\\|\\AppData\\Roaming\\|\\Users\\Public\\|\\ProgramData\\(?!Microsoft\\Windows Defender|Package Cache)|\\Windows\\Temp\\|\\\$Recycle\.Bin\\|\\inetpub\\|\\wwwroot\\)/ nocase

    // Parent process is NOT a known-good installer, deployment, or admin tool
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Parent process is NOT a known-good backup or imaging process
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known-good service accounts performing automated deployment
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude security tooling that may legitimately write binaries for scanning
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude files written by processes in approved script host allowlist
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

    // Raise signal when the writing process is itself a living-off-the-land binary
    // or an interpreter commonly abused for decoding (certutil, expand, extrac32,
    // wscript, cscript, mshta, powershell, pwsh, bitsadmin, curl, wget-equivalent).
    // Using a broad regex so renamed copies are NOT caught here - the path filter
    // above is the primary signal; this clause adds specificity when the parent IS
    // a known LOLBin to increase risk score via outcome branching.
    $file.principal.process.file.full_path = /(?i)\\(certutil|expand|extrac32|wscript|cscript|mshta|powershell|pwsh|bitsadmin|regsvr32|rundll32|msiexec|wmic|forfiles|pcalua|desktopimgdownldr|esentutl|makecab|replace|xcopy|robocopy|cmd)\.exe$/

  outcome:
    // Higher base score because the parent is a confirmed LOLBin performing a file write
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($file.principal.hostname)
    $decoded_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
