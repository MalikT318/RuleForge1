/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:24:43.855798+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_Mass_File_Modification_Then_Ransom_Note {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects rapid file modification activity followed by creation of a ransom note file, indicating ransomware encryption behavior."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires EDR file telemetry capturing FILE_MODIFICATION and FILE_CREATION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup software performing file operations, bulk file conversion tools, legitimate encryption utilities, software deployment or patching operations."
    tuning_guidance = "Add approved backup and encryption tools to %global_allowed_backup_processes. Exclude service accounts performing automated file operations via %global_allowed_service_accounts."

  events:
    $modify.metadata.event_type = "FILE_MODIFICATION"
    $modify.target.file.full_path = /\.(doc|docx|xls|xlsx|ppt|pptx|pdf|jpg|jpeg|png|bmp|txt|sql|mdb|zip|rar|7z|mp3|mp4|avi|mov)$/ nocase
    not $modify.principal.process.file.full_path in %global_allowed_backup_processes
    not $modify.principal.user.userid in %global_allowed_service_accounts
    $modify.principal.hostname = $hostname
    $modify.principal.process.file.full_path = $process_path

    $note.metadata.event_type = "FILE_CREATION"
    $note.target.file.full_path = /(?i)(readme|decrypt|restore|how_to|recovery|instructions|ransom|locked|encrypted|help|unlock|files_encrypted)\.(txt|html|hta|rtf)$/
    $note.principal.hostname = $hostname
    $note.principal.process.file.full_path = $process_path

    $modify.metadata.event_timestamp.seconds <= $note.metadata.event_timestamp.seconds

  match:
    $hostname, $process_path over 1h

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($modify.principal.hostname)
    $encryption_process = array_distinct($modify.principal.process.file.full_path)
    $ransom_note_path = array_distinct($note.target.file.full_path)
    $modified_file_count = count_distinct($modify.target.file.full_path)
    $user_context = array_distinct($modify.principal.user.userid)

  condition:
    $modify and $note and #modify >= 10
}
