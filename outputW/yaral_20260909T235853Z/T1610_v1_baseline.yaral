/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:21:06.720513+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_001_Privileged_Container_Deployment {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deployment of a new container resource via Kubernetes or container runtime API calls. Focuses on privileged container creation or creation by unexpected principals, which is the primary behavioral signal for T1610 - Deploy Container. Adversaries deploy containers to execute malware, bypass network controls, or escape to the host via privileged configurations."
    mitre_tactic = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires Kubernetes API server audit logs or container runtime audit logs normalized to UDM RESOURCE_CREATION events. Fields expected: target.resource.type, target.resource.name, principal.user.userid, principal.ip, security_result.description or target.resource.attribute.labels."
    platform = "Containers"
    log_source = "container"
    false_positives = "Legitimate CI/CD pipelines deploying containers, cluster autoscalers, operators, and controllers creating pods as part of normal workload management. Deployment tooling service accounts will frequently trigger this rule."
    tuning_guidance = "Add known CI/CD and orchestration service account identifiers to %global_allowed_service_accounts. Add approved automation source IPs to %global_allowed_scanners or %global_allowed_remote_mgmt. Narrow the rule by requiring the privileged label or hostPID/hostNetwork indicators in target.resource.attribute.labels if your log source populates those fields."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target must be a pod or container resource type
    $cloud.target.resource.type = /(?i)(pod|container)/

    // The resource name should exist - a newly created workload
    $cloud.target.resource.name != ""

    // Exclude known automation and service accounts that legitimately deploy containers
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known cloud/identity principals used by approved orchestration
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude traffic originating from approved management sources
    not $cloud.principal.ip in %global_allowed_mgmt_sources

    // Flag privileged or host-namespace container deployments via resource attribute
    // OR flag any container creation not from an approved principal (broad coverage)
    (
      $cloud.target.resource.attribute.labels.key = /(?i)(privileged|hostpid|hostnetwork|hostipc|allowprivilegeescalation)/
      or
      $cloud.target.resource.attribute.labels.value = /(?i)(true|yes|1)/
    )

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $container_name = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
