/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:46:59.493952+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Port_Knocking_Listener_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of processes with raw socket or libpcap capabilities that listen on closed ports or sniff for specific packet sequences, indicative of port knocking implementation."
    mitre_tactic = "Defense Evasion, Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with command-line arguments."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Network monitoring tools (tcpdump, wireshark, nmap), security scanners, IDS/IPS agents, legitimate network debugging by administrators."
    tuning_guidance = "Add approved network monitoring tools to %global_allowed_security_tools and authorized admin processes to %global_allowed_admin_tools."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /libpcap/ nocase or
      $proc.target.process.command_line = /pcap_open_live/ nocase or
      $proc.target.process.command_line = /raw\s+socket/ nocase or
      $proc.target.process.command_line = /sock_raw/ nocase or
      $proc.target.process.command_line = /af_packet/ nocase or
      $proc.target.process.command_line = /ipproto_raw/ nocase
    )
    (
      $proc.target.process.command_line = /iptables.*dport/ nocase or
      $proc.target.process.command_line = /nft.*dport/ nocase or
      $proc.target.process.command_line = /firewall-cmd.*port/ nocase or
      $proc.target.process.command_line = /ufw.*allow/ nocase or
      $proc.target.process.command_line = /knock/ nocase or
      $proc.target.process.command_line = /port.*sequence/ nocase or
      $proc.target.process.file.full_path = /\/(tmp|dev\/shm|var\/tmp)\/[^\/]+$/ nocase
    )
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path = /^\/(usr\/s?bin|bin)\/(tcpdump|wireshark|tshark|nmap|masscan)$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
