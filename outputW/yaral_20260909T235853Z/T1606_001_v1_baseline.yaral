/*
  MITRE Technique : T1606.001 - Web Cookies
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:19:56.192976+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_001_Web_Cookie_Forgery_Script_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process execution patterns consistent with web cookie forgery on Windows. Adversaries forge session cookies by invoking scripting engines or cryptographic utilities with arguments referencing cookie construction, secret material, token signing, or session key derivation. This targets the behavioral pattern of using scripting runtimes to generate or manipulate authentication cookies rather than stealing them from a live session."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.001"
    mitre_technique_name = "Forge Web Credentials: Web Cookies"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (e.g., Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, SentinelOne). Command-line logging must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate web developers testing cookie generation locally, automated integration test frameworks, security researchers, and authorized penetration testers. Session management libraries invoked by CI/CD pipelines may also trigger this rule."
    tuning_guidance = "Add known developer workstation hostnames or CI/CD service account names to %global_allowed_service_accounts. Add approved scripting parent processes to %global_allowed_script_hosts. Narrow the command-line regex if specific token-signing libraries used by your environment generate false positives."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting runtimes and utilities commonly used to forge cookies
    $proc.target.process.file.full_path = /\\(powershell|pwsh|python[0-9.]*|ruby|node|cscript|wscript|mshta|php)\.exe$/ nocase

    // Command line must reference cookie-related construction, signing, or secret material
    // Covers: cookie/token generation, HMAC/signing operations, base64 encoding of auth material,
    // secret/key references, and session token manipulation
    $proc.target.process.command_line = /(?i)(cookie|session.?token|auth.?token|saml|jwt|hmac|sign(ed|ing|ature)|secret.?key|private.?key|forge|craft.?cookie|set.?cookie|encode.*cookie|cookie.*encode|frombase64|tobase64|convert.*base64|base64.*convert|aes.*key|rsa.*key|x509|pfx|\.pem|\.p12|bearer|access.?token|refresh.?token|id.?token)/

    // Exclude known-good script hosts and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1606.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $spawning_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
