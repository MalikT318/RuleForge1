/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:25:43.923485+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_ESXi_Obfuscated_C2_Network_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential data obfuscation C2 traffic originating from ESXi infrastructure by identifying anomalous outbound network flows: non-standard high ports, unusually large payload sizes on common protocol ports, or connections to external destinations with suspicious byte-ratio characteristics indicative of junk-padding or steganographic encoding. Adversaries abusing ESXi hosts for C2 often blend traffic into expected management protocols while hiding commands in oversized or malformed payloads."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Requires firewall or perimeter flow logs with bytes-sent/received fields, source and destination IP, and port information. Chronicle UDM fields: network.sent_bytes, network.received_bytes, target.port, principal.ip, target.ip."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Legitimate ESXi management traffic on non-standard ports (vSphere APIs, vMotion on 8000/902), large OVF/ISO transfers to external repositories, backup jobs to cloud targets, authorised vulnerability scanners."
    tuning_guidance = "Add known ESXi management source IPs to %global_allowed_mgmt_sources. Add approved external backup and update destinations to %global_allowed_domains. Raise the sent_bytes threshold if large legitimate transfers are common. Narrow target.port exclusions to match your vSphere port inventory."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Traffic must originate from an internal address (ESXi host on management network)
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not internal)
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external destinations
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised management and scanner sources
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // Detect anomalous outbound payload volume on ports that should carry
    // lightweight control-plane traffic (DNS:53, NTP:123, SNMP:161/162).
    // Large bytes-sent on these ports is a strong indicator of data stuffed
    // into a legitimate-looking protocol (junk padding / steganography).
    (
      (
        $net.target.port = 53 and
        $net.network.sent_bytes > 512
      ) or
      (
        $net.target.port = 123 and
        $net.network.sent_bytes > 256
      ) or
      (
        $net.target.port = 161 and
        $net.network.sent_bytes > 1024
      ) or
      (
        $net.target.port = 162 and
        $net.network.sent_bytes > 1024
      ) or
      // Non-standard high-port outbound with substantial bidirectional traffic
      // (beacon-like sessions that carry hidden payloads)
      (
        $net.target.port >= 1024 and
        $net.target.port <= 65535 and
        $net.network.sent_bytes > 50000 and
        $net.network.received_bytes > 5000
      )
    )

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)
    $bytes_received = max($net.network.received_bytes)

  condition:
    $net
}
