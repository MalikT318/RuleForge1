/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:03:19.506820+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Suspended_Process_Then_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage APC injection pattern: a process is launched in suspended state (Early Bird injection indicator) followed by a PROCESS_OPEN event targeting that same host, consistent with a second process opening a handle to inject via QueueUserAPC. This is additive coverage beyond command-line matching."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_LAUNCH events with command-line arguments and PROCESS_OPEN events. Sysmon Event IDs 1 and 10 map to these UDM types."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers (Visual Studio, WinDbg) legitimately create suspended processes. Some installers and JIT compilers use CREATE_SUSPENDED. Security tooling may open handles to processes for inspection."
    tuning_guidance = "Add known debugger and installer parent process paths to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow by target process name if specific benign suspended processes are noisy."

  events:
    // Stage 1: Process launched in suspended state - hallmark of Early Bird APC injection.
    // Suspended creation is indicated by the presence of CREATE_SUSPENDED flags in
    // command-line wrappers (e.g. via NtCreateProcess flags surfaced by EDR) or
    // by the parent spawning a known host process with explicit suspension arguments.
    // We detect the behavioral proxy: a non-interactive, non-shell parent spawning
    // a common injection target (runtime hosts) with a suspended-state indicator.
    $launch.metadata.event_type = "PROCESS_LAUNCH"
    $launch.target.process.command_line = /(?i)(CREATE_SUSPENDED|\/suspended|--suspended|-suspended)/ nocase
    not $launch.principal.process.file.full_path in %global_allowed_security_tools
    not $launch.principal.process.file.full_path in %global_allowed_admin_tools
    $launch.principal.hostname = $hostname

    // Stage 2: A separate process opens a handle to another process on the same host,
    // consistent with the injector calling OpenThread/QueueUserAPC against the
    // suspended target. PROCESS_OPEN is Sysmon Event ID 10 (ProcessAccess).
    $open.metadata.event_type = "PROCESS_OPEN"
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    // Exclude self-opens (process opening itself is benign)
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    // Target must be a common injection victim: runtime hosts, browsers, system processes
    $open.target.process.file.full_path = /(?i)\\(svchost|lsass|explorer|RuntimeBroker|dllhost|werfault|notepad|msiexec|regsvr32|rundll32|wscript|cscript|mshta|powershell|pwsh)\.exe$/
    $open.principal.hostname = $hostname

    // Chronological ordering: suspended launch must precede the process open
    $launch.metadata.event_timestamp.seconds <= $open.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($hostname)
    $injector_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $suspended_cmdline = array_distinct($launch.target.process.command_line)
    $event_count = count($open.metadata.event_timestamp.seconds)

  condition:
    $launch and $open
}
