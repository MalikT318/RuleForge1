/*
  MITRE Technique : T1677 - Poisoned Pipeline Execution
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:29:30.792094+00:00
  Reference       : https://attack.mitre.org/techniques/T1677
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1677_001_Poisoned_Pipeline_CI_Config_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of CI/CD pipeline configuration files or referenced build scripts via cloud audit logs. Adversaries may alter CI configuration files (e.g., .gitlab-ci.yml, .github/workflows/*.yml, Jenkinsfile, Makefile) or inject malicious code into files referenced by the pipeline to execute arbitrary commands during the build process, exfiltrate secrets, or establish persistence. This covers both direct pipeline poisoning (CI config edits) and indirect poisoning (build script, test, or linter modifications)."
    mitre_tactic    = "Execution"
    mitre_technique = "T1677"
    mitre_technique_name = "Poisoned Pipeline Execution"
    log_prerequisites = "Requires cloud provider audit logs capturing repository or object-store file modification events, including the resource name or path of the modified file. Events should be normalised to USER_RESOURCE_UPDATE_CONTENT or RESOURCE_CREATION with target.resource.name populated."
    platform        = "SaaS"
    log_source      = "cloud_audit"
    false_positives = "Legitimate DevOps engineers updating pipeline definitions, automated dependency-update bots (Dependabot, Renovate), release engineering tooling, and approved CI/CD service accounts performing routine pipeline maintenance."
    tuning_guidance = "Add known automation service accounts to %global_allowed_service_accounts. Add approved CI/CD tooling principals to %global_allowed_cloud_principals. Narrow the resource name regex to match only the repository namespaces or projects relevant to sensitive pipelines."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"

    // Match modifications to CI/CD pipeline configuration files or
    // build-referenced files across common platforms (GitHub Actions,
    // GitLab CI, Jenkins, CircleCI, Azure Pipelines, Makefile, etc.)
    // and indirect-poisoning targets (scripts, test files, linters).
    $cloud.target.resource.name = /(?i)(\.github[\\/]workflows[\\/][^\\/]+\.ya?ml|\.gitlab-ci\.ya?ml|Jenkinsfile|\.circleci[\\/]config\.ya?ml|azure-pipelines\.ya?ml|\.travis\.ya?ml|bitbucket-pipelines\.ya?ml|Makefile|GNUmakefile|makefile|\.mk$|buildspec\.ya?ml|cloudbuild\.ya?ml|Taskfile\.ya?ml|\.drone\.ya?ml|build\.sh|build\.ps1|build\.py|test\.sh|lint\.sh|pre-commit-config\.ya?ml|setup\.cfg|tox\.ini|\.npmrc|\.yarnrc)/

    // Exclude known-good automation service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good CI/CD platform principals (e.g., approved bots)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1677")
    $primary_entity    = array_distinct($cloud.principal.user.userid)
    $modified_resource = array_distinct($cloud.target.resource.name)
    $actor_ip          = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
