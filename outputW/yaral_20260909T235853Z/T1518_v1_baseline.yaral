/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:59:26.639577+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_ESXi_Software_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects software discovery activity on ESXi hosts via shell commands that enumerate installed VIBs, patches, software versions, or security configuration. Adversaries enumerate installed software to identify vulnerable versions or absent security controls before follow-on exploitation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised to UDM PROCESS_LAUNCH. ESXi shell must be enabled and shell command logging active."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised administrators performing patch audits, compliance scanning tools, VMware vSphere Lifecycle Manager, and approved vulnerability scanners enumerating VIB state."
    tuning_guidance = "Add authorised administrator accounts to %global_allowed_admin_users and approved scanner source hosts to %global_allowed_scanners. Narrow the match window if alert volume is high by requiring two or more distinct discovery commands within a short session."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target ESXi-native binaries used for software/VIB/patch enumeration
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(esxcli|esxupdate|localcli|vmkchdev|vmware|uname|rpm|esxcfg-info|vib)/ nocase

    // Command-line arguments that indicate software discovery intent:
    // VIB listing, software profile queries, version checks, security baseline queries
    $proc.target.process.command_line = /(software\s+vib\s+list|software\s+profile\s+get|software\s+profile\s+list|patch\s+scan|patch\s+query|--version|-V\b|vib\s+list|get\s+acceptance|acceptance\s+level|system\s+version\s+get|system\s+settings\s+kernel|network\s+firewall\s+ruleset|--info)/ nocase

    // Exclude approved administrative and scanning accounts
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($proc.principal.hostname)
    $actor_user = array_distinct($proc.principal.user.userid)
    $discovery_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
