/*
  MITRE Technique : T1684 - Social Engineering
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:30:47.873664+00:00
  Reference       : https://attack.mitre.org/techniques/T1684
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_Suspicious_MFA_Modification_After_Password_Reset {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects MFA method modification or removal shortly after password reset, indicating potential social engineering attack where adversary convinced user to reset credentials and disable MFA."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684"
    mitre_technique_name = "Social Engineering"
    log_prerequisites = "Requires identity provider audit logs with MFA and password change events."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate help desk password resets followed by user MFA re-enrollment; new employee onboarding; self-service password reset flows with MFA reconfiguration."
    tuning_guidance = "Add authorized help desk service accounts to %global_allowed_service_accounts. Adjust time window if legitimate workflows require longer intervals between password reset and MFA changes."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    (
      $auth.target.user.attribute.labels.value = /(?i)(mfa|multi.?factor|authentication.?method|phone.?authentication|authenticator)/ or
      $auth.security_result.summary = /(?i)(mfa|multi.?factor|authentication.?method|phone.?authentication|authenticator).*(remov|delet|disabl|reset|modif|chang|updat)/
    )
    $auth.security_result.summary = /(?i)(remov|delet|disabl|reset)/ or
    $auth.target.user.attribute.labels.value = /(?i)(remov|delet|disabl|reset)/
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1684")
    $primary_entity = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
