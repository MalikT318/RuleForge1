/*
  MITRE Technique : T1480.002 - Mutual Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:53:22.470658+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_002_Linux_Mutex_File_Lock_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of mutex/lock files in world-writable or temporary directories by processes that are not known backup, admin, or security tools. Malware on Linux commonly creates a lock file in /tmp, /dev/shm, /var/lock, or /var/run to prevent multiple instances from running simultaneously (T1480.002 - Mutual Exclusion). The combination of a suspicious parent process lineage and a lock/mutex file in a volatile path is a high-fidelity indicator."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1480.002"
    mitre_technique_name = "Execution Guardrails: Mutual Exclusion"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry normalised to UDM FILE_CREATION events with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers (apt, dpkg, rpm, yum), system daemons creating PID/lock files in /var/run or /var/lock, container runtimes, legitimate single-instance applications (e.g., Xorg, NetworkManager), backup agents."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the path regex to exclude /var/run/<known_daemon>.pid patterns observed in your environment. Raise severity if the creating process resides in /tmp, /dev/shm, or a user home directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Lock/mutex file created in a world-writable or volatile path
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/lock\/|\/var\/run\/|\/run\/)/ nocase

    // File name matches common mutex/lock naming patterns:
    // .lock, .pid, .mutex, .lck, or hidden dot-files in volatile dirs
    $file.target.file.full_path = /(\.(lock|pid|mutex|lck)|\/\.[a-zA-Z0-9_\-]{3,64})$/

    // Exclude well-known system daemon lock files by path pattern
    not $file.target.file.full_path = /\/(NetworkManager|systemd|udev|dbus|cups|sshd|cron|rsyslog|apt|dpkg|yum|rpm|docker|containerd|snapd|avahi|bluetooth|wpa_supplicant)\.(lock|pid|lck)$/

    // Exclude processes that are known legitimate single-instance tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Suspicious parent: process lives outside standard system binary paths,
    // or is a shell/interpreter that spawned the file creation
    $file.principal.process.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/home\/|\/var\/tmp\/|\/opt\/|\/usr\/local\/bin\/|\/root\/)/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1480.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $mutex_file_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
