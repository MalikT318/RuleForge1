/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:57:46.947992+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_Icon_Smuggling_File_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects LNK Icon Smuggling: a .lnk file is created in a user-writable or temp location, followed within 5 minutes by an outbound network connection from a shell or script interpreter on the same host. This pattern indicates the LNK icon location field may have triggered a payload download via an embedded URL."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (FILE_CREATION) and network connection telemetry (NETWORK_CONNECTION) normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that create .lnk shortcuts and immediately phone home for updates; browser-based download managers; RMM tools deploying shortcuts."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Add approved update domains to %global_allowed_domains. Narrow the file path regex if the environment restricts user-writable paths."

  events:
    // Event 1: A .lnk file is created in a user-writable or staging location
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\.(lnk)$/
    $file.target.file.full_path = /(?i)(\\users\\|\\temp\\|\\tmp\\|\\appdata\\|\\downloads\\|\\desktop\\|\\public\\)/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Event 2: A shell or script interpreter makes an external network connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|explorer)\.exe$/
    not $net.target.ip in %rfc1918_internal
    not $net.target.url in %global_allowed_domains
    $net.principal.hostname = $hostname

    // Chronological ordering: LNK file created before the outbound connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $lnk_file_paths = array_distinct($file.target.file.full_path)
    $connecting_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $lnk_creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $net
}
