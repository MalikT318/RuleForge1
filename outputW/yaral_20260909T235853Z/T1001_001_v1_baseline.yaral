/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:26:06.531453+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_Junk_Data_C2_Obfuscation_Network_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects processes commonly abused to exfiltrate or communicate with C2 channels using patterns consistent with junk-data obfuscation: unusual argument lengths, base64-like padding, or high-entropy data blobs passed directly on the command line to network-capable utilities. Targets the Linux behavioral signal of a scripting engine or network tool being invoked with an abnormally long, encoded, or padded command-line argument that suggests protocol-level obfuscation (T1001.001)."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with full command-line capture (execve syscall arguments). auditd rule: -a always,exit -F arch=b64 -S execve."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate curl/wget calls with long URLs or base64-encoded POST bodies (e.g., package managers, CI/CD pipelines). OpenSSL test invocations. Backup scripts using base64 encoding. Security scanners."
    tuning_guidance = "Add known-good parent processes (e.g., package manager paths, CI agent binaries) to %global_allowed_script_hosts. Add approved scanner source hosts to %global_allowed_scanners. Narrow the regex if the environment uses a specific encoding scheme legitimately."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target network-capable utilities and scripting engines commonly abused for C2
    $proc.target.process.file.full_path = /\/(curl|wget|python[23]?|perl|ruby|nc|ncat|netcat|socat|bash|sh|dash|openssl|php|lua)$/ nocase

    // Detect command lines containing large base64-like blobs, repeated padding characters,
    // or long runs of high-entropy characters interspersed with junk - all hallmarks of
    // junk-data obfuscation on the wire or in the payload staging command.
    // Pattern 1: base64 blob of 80+ chars (padding with = signs typical of encoded payloads)
    // Pattern 2: repeated junk padding sequences (AAAA... or XXXX... style noise prepended/appended)
    // Pattern 3: long hex strings (>60 hex chars) used to embed junk between C2 beacons
    $proc.target.process.command_line = /([A-Za-z0-9+\/]{80,}={0,2}|[A-Fa-f0-9]{60,}|([A-Za-z0-9]{4,}\s*){10,})/

    // Require the command line to also contain a network destination indicator
    // (URL, IP-like pattern, or explicit connect flag) to reduce noise from
    // purely local base64 operations
    $proc.target.process.command_line = /(\-\-(data|data-binary|post-data|body)|https?:\/\/|[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|connect|CONNECT|-e\s+[a-z]+:\/\/)/

    // Exclude known-good parent processes (package managers, deployment agents, security tools)
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggered_process = array_distinct($proc.target.process.file.full_path)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
