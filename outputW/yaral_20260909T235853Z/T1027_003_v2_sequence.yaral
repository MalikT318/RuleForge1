/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:50:39.880117+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Stego_Image_Written_Then_Exfil_Network {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage steganography exfiltration pattern: a script interpreter (PowerShell/wscript/cscript) writes an image file (PNG/JPG/BMP/GIF) to disk, then within 5 minutes the same host makes an outbound network connection from that same interpreter process. This matches the Invoke-PSImage pattern where encoded payloads or harvested data are embedded in image files before exfiltration."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires EDR or Sysmon telemetry providing FILE_CREATION events with principal process path, and NETWORK_CONNECTION events with principal process path and external destination IP. Both event types must be normalised into UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate PowerShell scripts that download image assets (wallpaper managers, Teams/Slack clients, browser helpers). Security tools that capture screenshots and upload them. Backup agents that archive image files and sync to cloud storage."
    tuning_guidance = "Add known-good script hosts to %global_allowed_script_hosts. Add approved cloud storage or CDN destinations to %global_allowed_domains. Narrow the image-extension regex if GIF or BMP produce excessive noise in the environment."

  events:
    // Stage 1: script interpreter writes an image file to disk
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|wmic)\.exe$/  nocase
    $file.target.file.full_path = /\.(png|jpg|jpeg|bmp|gif)$/  nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Stage 2: same interpreter on same host makes an outbound connection
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|wmic)\.exe$/  nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    $net.principal.hostname = $hostname

    // Chronological ordering: file written before network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1027.003")
    $primary_entity      = array_distinct($file.principal.hostname)
    $writing_process     = array_distinct($file.principal.process.file.full_path)
    $image_files_written = array_distinct($file.target.file.full_path)
    $destination_ips     = array_distinct($net.target.ip)
    $destination_ports   = array_distinct($net.target.port)
    $acting_user         = array_distinct($file.principal.user.userid)

  condition:
    $file and $net
}
