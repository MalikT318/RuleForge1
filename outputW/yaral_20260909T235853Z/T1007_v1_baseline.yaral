/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:27:27.583789+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1007_001_System_Service_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects execution of common Windows service enumeration commands used by adversaries to discover registered local services. Covers sc.exe query, net start, tasklist /svc, and PowerShell service enumeration cmdlets. Adversaries use this information to identify security tools, running services, and potential targets for lateral movement or privilege escalation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with command-line logging enabled. PowerShell script-block logging (Event 4104) is supplementary."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT administrators running service audits, RMM agents performing health checks, monitoring software, software deployment pipelines, and helpdesk tooling. Baseline frequency per host to distinguish automated from interactive enumeration."
    tuning_guidance = "Add known-good parent processes (RMM agents, monitoring daemons) to %global_allowed_admin_tools. Add authorised service accounts to %global_allowed_service_accounts. Consider raising severity if the parent process is an Office application, browser, or script interpreter."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the set of binaries commonly used for service discovery on Windows
    // sc.exe query, net.exe start, tasklist.exe /svc, wmic service list
    (
      (
        $proc.target.process.file.full_path = /\\sc\.exe$/ nocase
        and $proc.target.process.command_line = /query/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\net\.exe$/ nocase
        and $proc.target.process.command_line = /\bstart\b/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\net1\.exe$/ nocase
        and $proc.target.process.command_line = /\bstart\b/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\tasklist\.exe$/ nocase
        and $proc.target.process.command_line = /\/svc/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase
        and $proc.target.process.command_line = /(?i)service.*(list|get|call)/ nocase
      )
      or
      (
        // PowerShell Get-Service or Get-WmiObject Win32_Service
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and $proc.target.process.command_line = /(?i)(get-service|get-wmiobject\s+win32_service|get-ciminstance\s+win32_service)/ nocase
      )
    )

    // Exclude known-good administrative tooling and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $target_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
