/*
  MITRE Technique : T1578.003 - Delete Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:14:34.207539+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_003_Delete_Cloud_Instance {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of a cloud compute instance or virtual machine via cloud provider audit logs. Adversaries may delete instances after malicious activity to destroy forensic evidence and evade detection."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.003"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Delete Cloud Instance"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs) ingested into Chronicle with UDM normalization."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized infrastructure teardown by DevOps or cloud operations teams, auto-scaling termination events, scheduled decommissioning pipelines, CI/CD ephemeral environment cleanup."
    tuning_guidance = "Add known automation and service account identifiers to %global_allowed_service_accounts. Add known orchestration principals to %global_allowed_cloud_principals. Consider correlating with prior suspicious activity on the same principal to increase fidelity."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    $cloud.target.resource.type = /(?i)(instance|virtual.machine|vm|compute)/
    (
      $cloud.metadata.product_event_type = /(?i)(terminateinstances|deleteinstance|delete.virtual.machine|instances\.delete|vm\.delete|terminateinstance)/ nocase
      or
      $cloud.target.resource.name = /(?i)(instance|vm-|compute-)/
    )
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1578.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $deleted_resource = array_distinct($cloud.target.resource.name)
    $resource_type = array_distinct($cloud.target.resource.type)
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
