/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:31:34.675347+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_CredMgr_VCRDFileRead_Then_NetworkEgress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-system process reading Windows Credential Manager vault files (.vcrd or Policy.vpol) followed by an outbound network connection from the same host within 10 minutes. This two-stage pattern indicates credential harvesting and exfiltration of Credential Manager secrets."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR file-read telemetry (FILE_READ events on vault paths) and network connection telemetry (NETWORK_CONNECTION). Both must be normalised into UDM by the EDR or Sysmon pipeline."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup agents reading user profile directories, credential sync tools, Windows Defender offline scans, enterprise password managers with vault integration."
    tuning_guidance = "Add backup and credential-sync process paths to %global_allowed_backup_processes. Add approved remote-management processes to %global_allowed_remote_mgmt. Narrow the network event filter by adding known-good egress destinations to %global_allowed_domains."

  events:
    // Event 1: A non-system process reads a Credential Manager vault file
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /(?i)\\AppData\\Local\\Microsoft\\(Vault|Credentials)\\/ 
    $file.target.file.full_path = /(?i)\.(vcrd|vpol)$/
    not $file.principal.process.file.full_path = /(?i)^C:\\Windows\\(System32|SysWOW64)\\svchost\.exe$/
    not $file.principal.process.file.full_path = /(?i)^C:\\Windows\\System32\\lsass\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    // Event 2: The same host makes an outbound network connection after the file read
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 0
    not $net.principal.process.file.full_path = /(?i)^C:\\Windows\\(System32|SysWOW64)\\svchost\.exe$/
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    // Chronological ordering: file read must precede network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $vault_files_accessed = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $egress_destinations = array_distinct($net.target.ip)
    $egress_ports = array_distinct($net.target.port)
    $network_processes = array_distinct($net.principal.process.file.full_path)
    $event_count = count($net.metadata.event_timestamp.seconds)

  condition:
    $file and $net
}
