/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:13:44.248873+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_VB_Script_Drop_Then_Execute_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a VBScript or VBA-related file written to a suspicious Linux path (e.g. /tmp, /dev/shm, /var/tmp) followed by execution of a VB interpreter or macro runner on the same host within 5 minutes. This targets cross-platform .NET/Mono-based VB execution on Linux, which is additive to existing process command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM FILE_CREATION and PROCESS_LAUNCH events. Both event types must be present for the correlation to fire."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Mono/.NET development workflows writing and running VB test scripts; automated CI/CD pipelines using vbnc or mcs; LibreOffice macro testing in developer environments."
    tuning_guidance = "Add known CI/CD service accounts to %global_allowed_service_accounts. Add approved script host processes to %global_allowed_script_hosts. Restrict the file path regex if /tmp writes are common in your environment."

  events:
    // Event 1: A VBScript or VB source file is written to a world-writable or
    // suspicious staging directory on Linux.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/proc\/[0-9]+\/fd\/).+\.(vbs|vb|bas|frm|cls|vba)$/
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    $file.principal.hostname = $hostname

    // Event 2: A VB interpreter, Mono runner, or macro-capable process launches
    // on the same host after the file drop.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)\/(mono|vbnc|vbc|mbas|libreoffice|soffice|dotnet)(\/[^\/]+)*\/[^\/]*(mono|vbnc|vbc|mbas|libreoffice|soffice|dotnet)[^\/]*$/
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    // Chronological ordering: file must be written before the interpreter runs.
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($hostname)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $interpreter_launched = array_distinct($proc.target.process.file.full_path)
    $actor_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $file and $proc
}
