/*
  MITRE Technique : T1600.001 - Reduce Key Space
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:16:39.664995+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_001_Reduced_Cipher_Strength_Network_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network connections using weak or export-grade cipher suites, short TLS key lengths, or deprecated encryption protocols on network device perimeter traffic. Adversaries who have compromised a network device may reduce the key space used in encrypted communications, making interception and decryption feasible. This rule targets the network-observable result: sessions negotiated with anomalously weak encryption parameters."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.001"
    mitre_technique_name = "Weaken Encryption: Reduce Key Space"
    log_prerequisites = "Requires firewall or perimeter device logs that record TLS/SSL negotiated cipher suite, protocol version, or session metadata in UDM network fields. Syslog-based enrichment or TLS inspection must be enabled."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy IoT devices or embedded systems that only support older TLS versions; internal test environments using self-signed certificates with weak parameters; vulnerability scanners probing cipher support."
    tuning_guidance = "Add known legacy device source IPs or scanner source addresses to %global_allowed_scanners. Add approved management source addresses to %global_allowed_mgmt_sources. Narrow the cipher pattern regex to match only the specific weak suites observed in your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target external destinations only - exclude internal RFC1918 space
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal

    // Exclude approved scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Detect weak or export-grade cipher suites recorded in the TLS/session
    // metadata field. Matches: NULL, EXPORT, anon, RC4, DES, 3DES, IDEA,
    // MD5-only MACs, and short-key RSA/DHE export variants.
    // Chronicle normalises cipher suite names into network.tls.cipher into
    // the security_result.description or network.application_protocol fields
    // depending on the parser; we match across the description field which
    // is the most consistently populated for syslog-sourced firewall events.
    $net.security_result.description = /(?i)(null|export|anon|rc4|des(?!3)|_des_|3des|idea|arcfour|rc2|skip|_md5\b|_null_|exp-|exp_|512_bit|1024_bit|dh_anon|ecdh_anon|psk_null|srp_null)/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1600.001")
    $primary_entity = array_distinct($net.principal.ip)
    $weak_cipher_detail = array_distinct($net.security_result.description)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
