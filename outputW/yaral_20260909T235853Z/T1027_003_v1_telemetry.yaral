/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:50:18.934612+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Steganography_Image_File_Written_Sensitive_Dir {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects image or audio files (common steganography carriers) written to world-writable or staging directories on Linux (/tmp, /dev/shm, /var/tmp, /run). Adversaries embed payloads inside media files and stage them in these directories prior to exfiltration or execution. This rule targets the resulting file artifact rather than the process command line, providing coverage that is harder to evade."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry normalised to UDM FILE_CREATION events with target.file.full_path populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Web application upload handlers writing user-supplied images to /tmp; container image build pipelines; legitimate media processing jobs; browser cache writes."
    tuning_guidance = "Add known-good parent process paths (e.g. web server workers, container runtimes) to %global_allowed_backup_processes. Narrow the directory regex if a specific staging path is noisy. Raise severity to High if the writing process is a shell or interpreter."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a recognised media container extension (steganography carriers)
    $file.target.file.full_path = /\.(png|jpg|jpeg|gif|bmp|tif|tiff|webp|ico|svg|mp3|wav|ogg|flac|mp4|avi|mkv|mov)$/ nocase

    // File must land in a world-writable or transient staging directory
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/|\/run\/shm\/)/ nocase

    // Exclude known-good backup and media processing agents
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known-good security tooling (e.g. EDR agents writing scan artefacts)
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude known-good administrative tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_file      = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $writing_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
