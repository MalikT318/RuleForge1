/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:09:11.887275+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects ListPlanting (T1055.015) at the process-handle layer. ListPlanting requires a process to open a handle to a target process that owns a SysListView32 window control with VM_WRITE and VM_OPERATION access rights, enabling code injection via a custom sort callback. This rule fires when a non-system process requests cross-process memory-write access to another process, which is the prerequisite state change for ListPlanting regardless of how the attacker invokes it. Covers the artifact that command-line rules miss."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires EDR or Sysmon process-open (handle request) telemetry normalised to UDM PROCESS_OPEN events. Sysmon Event ID 10 (ProcessAccess) is the canonical source. CrowdStrike, SentinelOne, and Microsoft Defender for Endpoint all emit equivalent telemetry."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate accessibility tools (screen readers, UI automation frameworks), debugging utilities, RMM agents performing UI inspection, and security products that enumerate windows for monitoring purposes."
    tuning_guidance = "Add known-good parent processes (accessibility tools, approved RMM agents, security tooling) to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow further by correlating with subsequent LVM_SORTITEMS message sends if your EDR captures API call telemetry."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The requesting process must not be a known system binary.
    // Legitimate OS components that open cross-process handles live in System32/SysWOW64.
    // Suspicious openers are user-land processes outside those paths.
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\/
    not $open.principal.process.file.full_path = /(?i)\\windows\\syswow64\\/
    not $open.principal.process.file.full_path = /(?i)\\windows\\winsxs\\/

    // The target process must be a user-interactive process that plausibly
    // hosts a SysListView32 control. Common hosts: Explorer, common dialogs,
    // file managers, and any GUI application. We exclude pure system services
    // (lsass, csrss, smss) which do not render list-view UI.
    not $open.target.process.file.full_path = /(?i)\\(lsass|csrss|smss|wininit|services)\.exe$/

    // The target must be a different process (cross-process handle).
    // EDR telemetry for PROCESS_OPEN always implies a cross-process handle;
    // self-opens are not emitted as PROCESS_OPEN events by Sysmon/EDR.

    // The requesting process must be a user-land executable (has a path).
    $open.principal.process.file.full_path = /.+\.exe$/

    // The target process must also be a user-land GUI-capable executable.
    $open.target.process.file.full_path = /.+\.exe$/

    // Exclude approved security tooling that legitimately opens process handles.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known-good service accounts performing automated UI tasks.
    not $open.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($open.principal.hostname)
    $requesting_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $requesting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
