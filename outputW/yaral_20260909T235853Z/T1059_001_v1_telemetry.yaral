/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:11:00.654196+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_ScriptBlock_FileArtifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PowerShell script-block logging artifacts written to disk under the Windows PowerShell diagnostic log path or AppData temp staging areas. When PowerShell script-block logging is enabled (HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ScriptBlockLogging), the engine writes .xml or .etl transcript artifacts. Adversaries executing encoded, obfuscated, or downloaded payloads trigger these writes even when they bypass command-line logging via the System.Management.Automation assembly directly. This rule targets the resulting FILE_CREATION event rather than the process launch, providing a complementary detection layer that is harder to suppress."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11) with PowerShell script-block logging enabled via Group Policy or registry. UDM event type FILE_CREATION must be populated with target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative PowerShell scripts run by IT staff, software deployment agents, and patch management tools will generate these artifacts. Scheduled tasks invoking PowerShell for monitoring or reporting are also expected sources."
    tuning_guidance = "Add known-good parent process paths (e.g., deployment agents, RMM tools) to %global_allowed_admin_tools. Add authorised service accounts that routinely run PowerShell scripts to %global_allowed_service_accounts. Consider scoping to high-risk directories only (e.g., Temp, AppData\\Roaming) if volume is excessive."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Script-block log artifacts written by the PowerShell engine to the
    // Windows diagnostic infrastructure or transcript output locations.
    // Matches paths such as:
    //   C:\Windows\System32\winevt\Logs\Microsoft-Windows-PowerShell%4Operational.evtx  (rotated)
    //   C:\Users\<user>\AppData\Local\Temp\*.ps1
    //   C:\Users\<user>\AppData\Roaming\*.ps1
    //   C:\Windows\Temp\*.ps1
    //   C:\ProgramData\*.ps1
    // The key signal is a .ps1 or script-block XML artifact created by a
    // non-interactive, non-editor process in a staging/temp location.
    (
      $file.target.file.full_path = /(?i)\\(Temp|tmp)\\[^\\]+\.(ps1|psm1|psd1|xml)$/ nocase
      or
      $file.target.file.full_path = /(?i)\\AppData\\(Local|Roaming|LocalLow)\\[^\\]+\.(ps1|psm1|psd1|xml)$/ nocase
      or
      $file.target.file.full_path = /(?i)\\ProgramData\\[^\\]+\.(ps1|psm1|psd1|xml)$/ nocase
      or
      $file.target.file.full_path = /(?i)\\Windows\\Temp\\[^\\]+\.(ps1|psm1|psd1|xml)$/ nocase
    )

    // The writing process must be a PowerShell host or a process hosting
    // the System.Management.Automation assembly (e.g., pwsh, powershell,
    // wsmprovhost for remoting, or a custom runspace host).
    $file.principal.process.file.full_path = /(?i)\\(powershell|pwsh|wsmprovhost|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil)\.exe$/

    // Exclude known-good administrative tooling and service accounts.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
