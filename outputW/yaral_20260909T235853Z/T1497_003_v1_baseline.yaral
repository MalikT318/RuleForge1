/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:58:15.252538+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Time_Based_Sandbox_Evasion_Via_Sleep_And_Time_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects processes using scripting interpreters or living-off-the-land binaries to perform time-based sandbox evasion checks. Adversaries sample the system clock or uptime before and after a sleep call to detect accelerated sandbox time, or enumerate system uptime to infer a sandbox environment. This rule targets the observable process-level behaviour: a script host or shell invoking sleep/delay primitives combined with time-query constructs in the same command line."
    mitre_tactic = "Defense Evasion, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with full command-line capture (Sysmon Event ID 1, or equivalent EDR telemetry normalised to UDM PROCESS_LAUNCH)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate automation scripts that include sleep loops with timestamp logging (e.g., deployment scripts, health-check loops, test harnesses). PowerShell-based monitoring agents that poll metrics at intervals. Scheduled maintenance scripts."
    tuning_guidance = "Add known-good parent processes (deployment agents, RMM tools) to %global_allowed_admin_tools. Add authorised script-hosting parent processes to %global_allowed_script_hosts. Narrow scope by requiring the process to be spawned from a suspicious parent (e.g., Office, browser, archive utility) rather than a known admin tool."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting interpreters and shells commonly abused for time-based checks
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|wmic)\.exe$/ nocase

    // Match command lines that combine a sleep/delay primitive with a time-query construct.
    // Adversaries sample time before and after sleep to detect sandbox acceleration.
    // Pattern A: PowerShell sleep + time/date/tick/uptime query
    // Pattern B: cmd ping-based delay + time query
    // Pattern C: WMI uptime or last boot time enumeration (common sandbox fingerprint)
    (
      $proc.target.process.command_line = /(?i)(Start-Sleep|sleep\s+\-[ms]|ping\s+.*\-n\s+\d+.*127\.0\.0\.1)/ nocase and
      $proc.target.process.command_line = /(?i)(Get-Date|GetSystemTime|TickCount|\[DateTime\]::Now|\[Environment\]::TickCount|uptime|LastBootUpTime|Win32_OperatingSystem)/ nocase
    )

    // Exclude known-good administrative and scripting parents
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $username = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
