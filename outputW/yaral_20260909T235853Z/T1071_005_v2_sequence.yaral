/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:36:45.584159+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_PubSub_Protocol_External_Then_Sustained_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux host initiating a connection to an external destination on a known pub/sub broker port (MQTT 1883/8883, AMQP 5671/5672, STOMP 61613/61614, XMPP 5222/5269) followed by a sustained data flow to the same destination within a short window. This pattern is consistent with malware using pub/sub protocols for C2 by blending into legitimate messaging traffic. Firewall/perimeter telemetry only - no endpoint process context required."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires firewall or network perimeter flow logs normalised to Chronicle UDM NETWORK_CONNECTION and NETWORK_FLOW event types. Both event types must be populated with principal.ip, target.ip, target.port, and network.sent_bytes."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate IoT gateways, industrial SCADA systems, or application servers using MQTT/AMQP brokers hosted externally. Authorised messaging middleware (e.g., RabbitMQ, ActiveMQ, HiveMQ) connecting to cloud-hosted brokers. Vulnerability scanners probing pub/sub ports."
    tuning_guidance = "Add known-good external broker IPs or hostnames to %global_allowed_domains. Add internal scanner sources to %global_allowed_scanners. Add approved service account sources to %global_allowed_service_accounts. Raise the network.sent_bytes threshold if legitimate high-volume pub/sub traffic is observed."

  events:
    // Event 1: Initial connection to an external destination on a pub/sub broker port
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
      $conn.target.port = 1883 or
      $conn.target.port = 8883 or
      $conn.target.port = 5671 or
      $conn.target.port = 5672 or
      $conn.target.port = 61613 or
      $conn.target.port = 61614 or
      $conn.target.port = 5222 or
      $conn.target.port = 5269
    )
    not $conn.target.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.target.ip in %global_allowed_domains
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip

    // Event 2: Sustained data flow to the same external destination on the same pub/sub port
    $flow.metadata.event_type = "NETWORK_FLOW"
    (
      $flow.target.port = 1883 or
      $flow.target.port = 8883 or
      $flow.target.port = 5671 or
      $flow.target.port = 5672 or
      $flow.target.port = 61613 or
      $flow.target.port = 61614 or
      $flow.target.port = 5222 or
      $flow.target.port = 5269
    )
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    not $flow.target.ip in %global_allowed_domains
    $flow.network.sent_bytes > 1024
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip

    // Chronological ordering: connection must precede or coincide with the flow record
    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct($src_ip)
    $destination_ip = array_distinct($dst_ip)
    $pub_sub_ports_observed = array_distinct($flow.target.port)
    $total_bytes_sent = max($flow.network.sent_bytes)
    $connection_count = count($flow.metadata.event_timestamp.seconds)

  condition:
    $conn and $flow
}
