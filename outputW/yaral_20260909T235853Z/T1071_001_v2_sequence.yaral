/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:34:22.694740+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Linux_Beaconing_Then_LargeOutbound_Firewall {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a pattern consistent with C2 over web protocols on Linux hosts: a high-frequency beaconing burst to a single external destination on HTTP/HTTPS ports, followed within 5 minutes by a large outbound data transfer to the same destination. This combination suggests an implant performing check-ins and then exfiltrating or receiving tasking payloads. Firewall/proxy telemetry only - no endpoint process context required."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_FLOW or NETWORK_HTTP. Flow records must include bytes_sent/bytes_received and connection counts. Session-level aggregation (not per-packet) is preferred."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Software update agents (apt, yum, snap) polling CDNs at regular intervals; monitoring agents (Prometheus exporters, Datadog, Elastic Beats) sending frequent small beacons; streaming media clients; legitimate large file downloads from cloud storage."
    tuning_guidance = "Add known-good update and telemetry destinations to %global_allowed_domains. Add approved scanner source IPs to %global_allowed_scanners. Raise the bytes threshold if large legitimate transfers are common. Narrow the beacon count threshold if the environment has noisy update agents."

  events:
    // Leg 1: High-frequency small outbound connections to a single external
    // destination on web ports - characteristic of C2 beaconing.
    $beacon.metadata.event_type = "NETWORK_FLOW"
    (
        $beacon.target.port = 80 or
        $beacon.target.port = 443 or
        $beacon.target.port = 8080 or
        $beacon.target.port = 8443
    )
    $beacon.network.sent_bytes < 5000
    $beacon.network.received_bytes < 5000
    not $beacon.target.ip in %rfc1918_internal
    not $beacon.target.hostname in %global_allowed_domains
    not $beacon.principal.ip in %global_allowed_scanners
    $beacon.principal.ip = $src_ip
    $beacon.target.ip = $dst_ip

    // Leg 2: Large outbound transfer to the same external destination shortly
    // after the beaconing burst - consistent with payload delivery or exfil.
    $bulk.metadata.event_type = "NETWORK_FLOW"
    (
        $bulk.target.port = 80 or
        $bulk.target.port = 443 or
        $bulk.target.port = 8080 or
        $bulk.target.port = 8443
    )
    $bulk.network.sent_bytes > 500000
    not $bulk.target.ip in %rfc1918_internal
    not $bulk.target.hostname in %global_allowed_domains
    not $bulk.principal.ip in %global_allowed_scanners
    $bulk.principal.ip = $src_ip
    $bulk.target.ip = $dst_ip

    // Enforce chronological ordering: beaconing precedes bulk transfer.
    $beacon.metadata.event_timestamp.seconds <= $bulk.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 5m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1071.001")
    $primary_entity      = array_distinct($src_ip)
    $destination_ip      = array_distinct($dst_ip)
    $destination_host    = array_distinct($bulk.target.hostname)
    $beacon_bytes_out    = max($beacon.network.sent_bytes)
    $bulk_bytes_out      = max($bulk.network.sent_bytes)
    $observed_dst_ports  = array_distinct($bulk.target.port)

  condition:
    $beacon and $bulk
}
