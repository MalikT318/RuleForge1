/*
  MITRE Technique : T1526 - Cloud Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:00:42.893198+00:00
  Reference       : https://attack.mitre.org/techniques/T1526
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1526_Cloud_Service_Discovery_Bulk_Resource_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or broad enumeration of cloud directory resources, applications, service principals, or policy objects via identity provider audit logs. Adversaries who gain initial access to an identity provider commonly enumerate available cloud services and registered applications to identify targets for lateral movement or privilege escalation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1526"
    mitre_technique_name = "Cloud Service Discovery"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM USER_RESOURCE_ACCESS. Events should capture directory read operations against service principals, applications, groups, policies, and management objects."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate IT automation, provisioning scripts, and approved security tooling that enumerate directory objects. Monitoring and compliance platforms that periodically read directory state. Helpdesk staff performing routine directory lookups."
    tuning_guidance = "Add known automation and service accounts to %global_allowed_service_accounts. Add approved security and monitoring principals to %global_allowed_security_tools. Raise the threshold or add a match block if alert volume is high for a specific user."

  events:
    $auth.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource types associated with cloud service enumeration:
    // service principals, applications, directory roles, policies, management groups
    $auth.target.resource.resource_type = /(?i)(service.?principal|application|directory.?role|policy|management.?group|subscription|tenant|oauth|app.?registration|enterprise.?app|conditional.?access|authorization.?policy|role.?definition|role.?assignment)/

    // Read/list operations - distinguish enumeration from legitimate single-object access
    $auth.target.resource.attribute.labels.key = /(?i)(operation|action|activity)/
    $auth.target.resource.attribute.labels.value = /(?i)(list|get|read|enum|search|query|discover)/

    // Exclude known automation and service accounts
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved security tooling principals
    not $auth.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved admin users performing routine operations
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1526")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $accessed_resource_type = array_distinct($auth.target.resource.resource_type)
    $source_ip = array_distinct($auth.principal.ip)

  condition:
    $auth
}
