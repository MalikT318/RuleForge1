/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:05:50.767922+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Install_Root_Certificate {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects installation of a root certificate on Windows via certutil.exe, certmgr.exe, PowerShell Import-Certificate, or direct registry modification of the certificate trust store. Adversaries install rogue root CAs to silently intercept TLS traffic without browser warnings."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (process creation) with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise PKI administrators deploying internal CAs, MDM/GPO-based certificate deployment, software installers that bundle trusted root CAs (e.g., corporate proxies, DLP agents)."
    tuning_guidance = "Add authorised certificate management accounts to %global_allowed_admin_users and approved parent processes (e.g., MDM agents, GPO scripts) to %global_allowed_admin_tools. Scope by hostname or user if enterprise PKI activity is frequent."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the primary certificate installation mechanisms
    (
      // certutil -addstore targeting Root or AuthRoot stores
      (
        $proc.target.process.file.full_path = /\\certutil\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /\-addstore/ nocase
          or
          $proc.target.process.command_line = /\/addstore/ nocase
        )
        and
        (
          $proc.target.process.command_line = /\broot\b/ nocase
          or
          $proc.target.process.command_line = /\bauthroot\b/ nocase
          or
          $proc.target.process.command_line = /\bthirdparty\b/ nocase
          or
          $proc.target.process.command_line = /\bdisallowed\b/ nocase
        )
      )
      or
      // certmgr.exe adding to root store
      (
        $proc.target.process.file.full_path = /\\certmgr\.exe$/ nocase
        and
        $proc.target.process.command_line = /\-(add|put)/ nocase
        and
        $proc.target.process.command_line = /\-s\s+(root|authroot|trustedpublisher)/  nocase
      )
      or
      // PowerShell Import-Certificate targeting root stores
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        $proc.target.process.command_line = /Import-Certificate/ nocase
        and
        (
          $proc.target.process.command_line = /Cert:\\LocalMachine\\Root/ nocase
          or
          $proc.target.process.command_line = /Cert:\\LocalMachine\\AuthRoot/ nocase
          or
          $proc.target.process.command_line = /Cert:\\CurrentUser\\Root/ nocase
        )
      )
      or
      // PowerShell Add-Certificate or X509Store targeting root
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        $proc.target.process.command_line = /X509Store/ nocase
        and
        $proc.target.process.command_line = /\.Add\(/ nocase
        and
        $proc.target.process.command_line = /(?i)(Root|AuthRoot|TrustedPublisher)/
      )
    )

    // Exclude known-good administrative tools and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $certificate_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
