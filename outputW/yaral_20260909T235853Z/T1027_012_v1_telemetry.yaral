/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:57:29.106898+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_File_Creation_Suspicious_Location {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of LNK shortcut files in suspicious or user-writable locations commonly abused for LNK Icon Smuggling (T1027.012). Adversaries craft LNK files with malicious icon location fields pointing to external URLs or UNC paths to smuggle payloads past content filters. This rule pivots on the file artifact rather than process command-line to provide additive coverage beyond process-creation detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers dropping shortcuts to user profile or temp directories; browser downloads of benign LNK files; RMM tools deploying shortcuts."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools. Narrow scope by excluding specific subdirectories under AppData if a business application legitimately writes LNK files there. Consider raising severity if the creating process is a browser, email client, or document viewer."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // LNK file written anywhere under user-writable or staging paths
    // Covers: Downloads, Temp, AppData, Desktop, Public, and root of removable/network paths
    $file.target.file.full_path = /(?i)\\Users\\[^\\]+\\(Downloads|AppData|Desktop|Documents|Temp|Local Settings)\\.*\.lnk$/
    or $file.target.file.full_path = /(?i)\\(Windows\\Temp|Temp|Tmp)\\.*\.lnk$/
    or $file.target.file.full_path = /(?i)\\(Public|Users\\Public)\\.*\.lnk$/

    // Exclude known-good administrative and deployment tooling as the creating process
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude backup and imaging software
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Flag when the creating process is a high-risk parent (browser, email, document handler, script host)
    // Regex covers common browser, mail, and Office process names without hardcoding exact paths
    $file.principal.process.file.full_path = /(?i)\\(msedge|chrome|firefox|iexplore|outlook|winword|excel|powerpnt|mshta|wscript|cscript|pwsh|powershell|cmd|rundll32|regsvr32|msiexec|explorer)\.exe$/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $lnk_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
