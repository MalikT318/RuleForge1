/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:27:00.154812+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_Network_Replication_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects DCSync attacks by correlating an anomalous inbound network connection to a Domain Controller on the MS-DRSR replication port (135/TCP RPC or 49152-65535 dynamic RPC) from a non-DC source, followed by a subsequent outbound flow carrying significant data volume from the DC — consistent with directory replication data being exfiltrated. This provides additive IDS/IPS-layer coverage beyond process-creation detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to Chronicle UDM. Both NETWORK_CONNECTION and NETWORK_FLOW events must be present. The DC hostname or IP must be resolvable in UDM target fields."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Legitimate Domain Controller replication from other DCs, authorised backup agents performing AD snapshots, Azure AD Connect sync processes, and approved vulnerability scanners."
    tuning_guidance = "Add known DC-to-DC replication source IPs to %global_allowed_mgmt_sources. Add approved sync service accounts to %global_allowed_service_accounts. Add authorised scanner IPs to %global_allowed_scanners. Raise the network.sent_bytes threshold if backup windows generate false positives."

  events:
    // Event 1: Inbound RPC/DRSR connection to a DC from a non-approved source
    // Port 135 is the RPC endpoint mapper; dynamic RPC ports 49152-65535 carry DRSR traffic
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
      $conn.target.port = 135
      or
      ($conn.target.port >= 49152 and $conn.target.port <= 65535)
    )
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_mgmt_sources
    not $conn.principal.ip in %global_allowed_scanners
    $conn.target.hostname = $dc_host

    // Event 2: Subsequent outbound flow from the same DC carrying substantial data
    // DCSync pulls NTDS credential blobs; legitimate idle DC flows are small
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $dc_host
    $flow.network.sent_bytes >= 500000
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_mgmt_sources

    // Chronological ordering: inbound RPC probe must precede the data exfil flow
    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $dc_host over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($dc_host)
    $source_ips = array_distinct($conn.principal.ip)
    $destination_ips = array_distinct($flow.target.ip)
    $max_bytes_sent = max($flow.network.sent_bytes)
    $rpc_ports_seen = array_distinct($conn.target.port)

  condition:
    $conn and $flow
}
