/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:08:19.884128+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_K8s_CronJob_Resource_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of Kubernetes CronJob or Job resources via the API server. Adversaries abuse CronJob/Job objects to schedule containers that execute malicious workloads across cluster nodes for persistence or execution. This rule pivots on the resource-creation state change rather than command-line telemetry, providing additive coverage over process-launch rules."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes API server audit logs normalised to Chronicle UDM. The audit policy must capture 'create' verbs on 'cronjobs' and 'jobs' resources in the 'batch' API group at RequestResponse level."
    platform = "Containers"
    log_source = "container"
    false_positives = "Legitimate CI/CD pipelines creating Jobs for build or test workloads; cluster operators deploying CronJobs for housekeeping tasks (log rotation, certificate renewal, backup); Helm chart deployments that include batch resources."
    tuning_guidance = "Add known CI/CD service account identifiers to %global_allowed_service_accounts. Add approved automation principals to %global_allowed_cloud_principals. Consider narrowing the rule to non-default namespaces or to service accounts that have not previously created batch resources."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    (
      $cloud.target.resource.name = /(?i)cronjob/ or
      $cloud.target.resource.name = /(?i)\/batch\// or
      $cloud.target.resource.type = /(?i)cronjob/ or
      $cloud.target.resource.type = /(?i)^job$/
    )
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_name = array_distinct($cloud.target.resource.name)
    $resource_type = array_distinct($cloud.target.resource.type)
    $source_hostname = array_distinct($cloud.principal.hostname)

  condition:
    $cloud
}
