/*
  MITRE Technique : T1529 - System Shutdown/Reboot
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:01:00.194281+00:00
  Reference       : https://attack.mitre.org/techniques/T1529
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1529_Linux_System_Shutdown_Reboot {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects execution of system shutdown or reboot commands on Linux hosts. Adversaries use these commands to disrupt access, destroy evidence, or impair incident response. Covers shutdown, reboot, halt, poweroff, and systemctl power-state transitions invoked from unexpected parent processes or user contexts."
    mitre_tactic    = "Impact"
    mitre_technique = "T1529"
    mitre_technique_name = "System Shutdown/Reboot"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE events normalised to UDM PROCESS_LAUNCH. Parent process lineage must be populated."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Scheduled maintenance scripts, cron-driven patching jobs, configuration management tools (Ansible, Puppet, Chef), and authorised administrators performing planned reboots."
    tuning_guidance = "Add approved automation service accounts to %global_allowed_service_accounts. Add approved parent processes (e.g. configuration management agents) to %global_allowed_admin_tools. Consider scoping to non-maintenance hours using timestamp.get_hour()."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the core shutdown/reboot binaries by path
    $proc.target.process.file.full_path = /\/(sbin|bin|usr\/sbin|usr\/bin)\/(shutdown|reboot|halt|poweroff|systemctl|init)$/ nocase

    // For systemctl, require a power-state subcommand; for others the binary itself is the signal
    (
      (
        $proc.target.process.file.full_path = /\/systemctl$/ nocase
        and
        $proc.target.process.command_line = /\b(poweroff|reboot|halt|shutdown|suspend|hibernate)\b/ nocase
      )
      or
      $proc.target.process.file.full_path = /\/(shutdown|reboot|halt|poweroff)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/init$/ nocase
        and
        $proc.target.process.command_line = /\b[06]\b/
      )
    )

    // Exclude approved automation and service accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

    // Exclude approved parent processes (patch management, config mgmt agents)
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1529")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_user   = array_distinct($proc.principal.user.userid)
    $command_executed  = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
