/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:12:09.462976+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_Batch_Script_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of batch script files (.bat, .cmd) in suspicious locations commonly used for persistence or lateral movement staging."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR file creation telemetry or Sysmon Event ID 11."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers, deployment tools, administrative scripts, backup solutions writing to temp directories."
    tuning_guidance = "Add approved deployment tools and backup processes to %global_allowed_admin_tools. Exclude specific parent processes writing legitimate batch files to startup or public directories."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(startup|appdata\\roaming\\microsoft\\windows\\start menu\\programs\\startup|programdata|public|windows\\temp|users\\public|windows\\tasks|windows\\system32\\tasks)\\.*\.(bat|cmd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path = /\\windows\\system32\\msiexec\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\windows\\system32\\svchost\.exe$/ nocase

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
