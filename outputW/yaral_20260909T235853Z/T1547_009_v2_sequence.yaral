/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:15:01.624667+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_Shortcut_Created_Then_Executed_At_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a .lnk shortcut file written to a Windows startup folder followed by a user login event on the same host within 10 minutes. This pattern indicates a shortcut was planted for persistence and subsequently triggered at logon, covering the execution phase that process-launch command-line rules miss."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (FILE_CREATION events with full target path) and Windows Security logon events (USER_LOGIN). Both must be normalised into Chronicle UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that place shortcuts in the startup folder (e.g. collaboration tools, VPN clients). Automated provisioning or imaging pipelines that pre-populate startup shortcuts. Group Policy preference deployments."
    tuning_guidance = "Add known-good installer or deployment parent processes to %global_allowed_admin_tools. Add authorised service or automation accounts to %global_allowed_service_accounts. Scope by hostname if a specific host is a known imaging station."

  events:
    // Event 1: A .lnk file is written into a per-user or all-users startup folder.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\[^\\]+\.lnk$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $userid

    // Event 2: A user login occurs on the same host shortly after the shortcut is written.
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    $auth.principal.user.userid = $userid

    // Enforce chronological ordering: shortcut written before login.
    $file.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname, $userid over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity = array_distinct($hostname)
    $affected_user = array_distinct($userid)
    $shortcut_paths = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $login_count = count($auth.metadata.event_timestamp.seconds)

  condition:
    $file and $auth
}
