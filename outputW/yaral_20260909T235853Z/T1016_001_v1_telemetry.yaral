/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:18:27.231102+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_Internet_Connectivity_Check_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file artifacts written to world-writable or temporary directories that contain output consistent with internet connectivity discovery tools (ping, curl, wget, traceroute). Adversaries commonly redirect connectivity-check output to a file for later parsing by their tooling. This rule targets the resulting file artifact rather than the process command line, providing coverage that is harder to evade than command-line logging."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events. The sensor must populate target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate monitoring scripts (Nagios, Zabbix, custom health checks) that write connectivity results to /tmp or /dev/shm. Network diagnostic tooling run by administrators. CI/CD pipeline connectivity pre-flight checks."
    tuning_guidance = "Add known monitoring and automation parent process paths to %global_allowed_script_hosts. Add known service account identifiers to %global_allowed_service_accounts. Narrow the file path regex if your environment uses a specific temp directory convention."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File written into world-writable or staging directories commonly used
    // by adversary tooling to capture command output on Linux.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/run\/user\/[0-9]+\/)/ nocase

    // The writing process is a connectivity-discovery utility or a shell/
    // interpreter that has been used to redirect such output. Matching on
    // the process that opened the file for write is more stable than
    // matching command-line arguments.
    $file.principal.process.file.full_path = /\/(ping|ping6|traceroute|traceroute6|tracepath|curl|wget|nc|ncat|nmap|fping|mtr|hping3|sh|bash|dash|zsh|ksh|python[23]?|python3\.[0-9]+|perl|ruby|node)$/ nocase

    // Exclude known-good automation and script hosts to reduce noise across
    // managed customer environments.
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

    // Exclude known service and monitoring accounts.
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $artifact_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
