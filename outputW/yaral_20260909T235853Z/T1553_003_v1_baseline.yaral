/*
  MITRE Technique : T1553.003 - SIP and Trust Provider Hijacking
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:05:29.990043+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Hijacking {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of Subject Interface Package (SIP) or Trust Provider registry keys, which adversaries tamper with to subvert Authenticode signature validation. Legitimate software rarely modifies these keys outside of OS or SDK installation."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry producing REGISTRY_MODIFICATION or REGISTRY_CREATION events with full key paths."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Windows SDK or WDK installation, legitimate security software registering new SIP handlers, OS in-place upgrades."
    tuning_guidance = "Add known-good installer parent processes (e.g., msiexec.exe during sanctioned deployments) to %global_allowed_admin_tools. Scope by principal.user.userid using %global_allowed_admin_users for privileged build pipelines."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // SIP registration keys - HKLM\SOFTWARE\Microsoft\Cryptography\OID\EncodingType 0\CryptSIPDll*
    // Trust Provider keys   - HKLM\SOFTWARE\Microsoft\Cryptography\Providers\Trust\*
    // Both 32-bit and 64-bit (Wow6432Node) paths are covered by the regex
    $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Cryptography\\(OID\\EncodingType 0\\CryptSIPDll|Providers\\Trust\\(FinalPolicy|InitPolicy|TestFinalPolicy|DiagnosticPolicy|CertCheck|SIPRetrieve|Message|Signature))/  nocase

    // Exclude known-good administrative and security tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity    = array_distinct($reg.principal.hostname)
    $modified_key      = array_distinct($reg.target.registry.registry_key)
    $actor_process     = array_distinct($reg.principal.process.file.full_path)
    $actor_user        = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
