/*
  MITRE Technique : T1684.002 - Email Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:31:25.193673+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_002_Email_Header_Spoofing_Sendmail_Config {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes on Linux that invoke mail transfer agent (MTA) binaries with command-line arguments commonly used to forge or override email headers such as FROM, SENDER, or REPLY-TO. Adversaries abuse sendmail, postfix, or similar MTAs with explicit header-injection flags to spoof sender identity without relying on a legitimate mail stack."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.002"
    mitre_technique_name = "Email Spoofing"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with full command-line capture (execve syscall auditing). Auditd rule: -a always,exit -F arch=b64 -S execve."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate bulk-mail scripts, monitoring/alerting systems, application notification services, and CI/CD pipelines that set a custom From address via -f or -F flags. Cron-driven system notification emails may also trigger this rule."
    tuning_guidance = "Add known-good parent process paths (e.g., monitoring agents, application servers) to %global_allowed_script_hosts. Add service accounts that legitimately send automated mail to %global_allowed_service_accounts. Narrow the regex if only specific MTA binaries are in use in the environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match common Linux MTA and mail-submission binaries
    $proc.target.process.file.full_path = /\/(sendmail|postfix|ssmtp|msmtp|exim|mutt|mail|mailx|swaks)(\.?\d*)?$/ nocase

    // Detect header-override flags used to forge sender identity:
    // -f / -F set the envelope/From address; --from overrides sender;
    // -a "From:" / -H "From:" inject raw headers; swaks --from spoofs sender
    $proc.target.process.command_line = /(\s|^)(-f\s*\S+@\S+|-F\s*['"]?[^'"]+['"]?|--from[= ]\S+@\S+|-a\s+['"]?From:|-H\s+['"]?From:|--header[= ]['"]?From:)/ nocase

    // Exclude approved script hosts and automation accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1684.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
