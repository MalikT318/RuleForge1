/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:58:10.673975+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Encoded_File_Artifact_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects creation of files with extensions or naming patterns strongly associated with encoded or encrypted payload staging on Windows hosts. Adversaries commonly drop Base64-encoded blobs, XOR-encrypted payloads, or obfuscated configuration files to disk before decoding and executing them in memory. This rule pivots on the resulting file artifact rather than the encoding command line, providing coverage when process telemetry is suppressed or the encoding step occurs off-host."
    mitre_tactic         = "Defense Evasion"
    mitre_technique      = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites    = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write events must be enabled."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Legitimate software installers that stage encoded resources (e.g., .dat blobs in application temp dirs), backup agents writing encrypted archives, certificate management tools writing .pfx/.p12 files, developer toolchains writing .b64 test fixtures."
    tuning_guidance      = "Add known-good parent process paths to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the rule by scoping target directory patterns to user-writable staging paths (Temp, AppData, ProgramData) if false-positive volume from system directories is high. Raise severity if the writing process is a script interpreter or Office application."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target suspicious staging directories where encoded payloads are commonly dropped.
    // Covers: %TEMP%, %APPDATA%, %LOCALAPPDATA%, %ProgramData%, and the root of C:\ or Windows\Temp.
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\AppData\\(Local|Roaming)|\\Windows\\Temp|\\ProgramData|\\Temp)[^\\]*\\[^\\]+\.(b64|enc|dat|bin|tmp|cfg|log|txt|pak|blob|raw|crypt|locked|payload|stage|drop)$/

    // The writing process is a script interpreter, Office app, or a generic
    // LOLBin - these are the most common parents for encoded-file staging.
    // Legitimate backup/security agents are excluded via reference lists.
    $file.principal.process.file.full_path = /(?i)\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|wget|python[0-9]*|wmic|cmd|winword|excel|powerpnt|onenote|outlook|msiexec|explorer)\.exe$/

    // Exclude known-good backup and security tooling that legitimately writes encoded blobs.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude files written into clearly legitimate application installation paths.
    not $file.target.file.full_path = /(?i)\\(WindowsApps|Program Files|Program Files \(x86\))\\[^\\]+\\/

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity    = array_distinct($file.principal.hostname)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $dropped_file      = array_distinct($file.target.file.full_path)

  condition:
    $file
}
