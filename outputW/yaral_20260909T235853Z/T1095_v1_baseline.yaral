/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:34:13.168112+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_ESXi_VMCI_NonAppLayer_Protocol_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential abuse of the Virtual Machine Communication Interface (VMCI) or non-application layer protocol channels on ESXi hosts. Adversaries may use VMCI sockets or raw protocol utilities to establish covert C2 channels between guest VMs and the ESXi host that bypass external network monitoring. This rule fires on process launches of low-level network or socket utilities from unexpected parent contexts on the ESXi shell, which is a strong indicator of covert channel establishment."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised to UDM PROCESS_LAUNCH. ESXi Shell must be enabled and shell activity forwarded to Chronicle via syslog or VMware log integration."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised VMware support sessions using vsish or esxcli for diagnostics; VMware Tools upgrades invoking vmci utilities; automated health-check scripts run by approved service accounts."
    tuning_guidance = "Add approved ESXi service account names to %global_allowed_service_accounts. Add approved management tooling paths to %global_allowed_admin_tools. Scope by principal.hostname if only specific hosts run legitimate diagnostic tooling."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target low-level ESXi networking, socket, and VMCI-related binaries
    // that have no legitimate reason to be invoked interactively or from
    // unexpected parent processes. vsish exposes kernel object trees including
    // VMCI; nc/ncat provide raw socket access; socat can tunnel over VMCI
    // sockets; esxcli network can manipulate firewall and interface state.
    $proc.target.process.file.full_path = /\/(vsish|nc|ncat|socat|vmci|esxcli)$/ nocase

    // Catch command lines that reference VMCI socket families, raw ICMP,
    // UDP raw sockets, or explicit VMCI CID/port arguments which are
    // characteristic of covert channel tooling rather than normal admin use.
    $proc.target.process.command_line = /(?i)(vmci|vsock|af_vsock|icmp|raw\s+socket|udp.*raw|cid\s*=|--cid\s+\d|socat.*vsock|nc.*-u.*-l|ncat.*--udp)/

    // Exclude approved service accounts performing legitimate operations
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative tooling invocations
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity = array_distinct($proc.principal.hostname)
    $suspicious_binary = array_distinct($proc.target.process.file.full_path)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $actor_userid = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
