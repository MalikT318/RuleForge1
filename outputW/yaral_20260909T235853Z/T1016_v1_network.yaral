/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:17:45.221537+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_Network_Config_Discovery_Outbound_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows host making an unusually high volume of short-lived outbound connections to external IP addresses in a short window, consistent with automated network configuration discovery or reconnaissance. Adversaries running tools such as arp, ipconfig, nbtstat, or route often follow up with rapid external probing to map reachable networks. Firewall/perimeter telemetry is used; no process context is required."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW. Fields needed: principal.ip, target.ip, network.sent_bytes, network.received_bytes, principal.hostname."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Vulnerability scanners, backup agents performing health checks, monitoring systems, software update clients contacting CDN nodes, RMM heartbeat traffic."
    tuning_guidance = "Add known scanner source IPs to %global_allowed_scanners. Add approved remote management source addresses to %global_allowed_remote_mgmt. Add known-good external domains/CDN ranges via %global_allowed_domains. Raise the sent_bytes threshold if legitimate bulk-transfer hosts trigger the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Must originate from an internal host
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not RFC-1918)
    not $net.target.ip in %rfc1918_internal

    // Characteristic of discovery probes: very small payloads (ICMP-like or
    // single-packet TCP SYN probes). Sent bytes low, received bytes near zero
    // indicates no established session / no response — typical of port/host sweep.
    $net.network.sent_bytes > 0
    $net.network.sent_bytes < 512
    $net.network.received_bytes < 64

    // Exclude well-known management and scanning sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($net.principal.hostname)

  condition:
    $net
}
