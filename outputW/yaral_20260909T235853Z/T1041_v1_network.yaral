/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:23:38.999389+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_001_C2_Exfil_Large_Outbound_Connection {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects potential data exfiltration over a C2 channel by identifying large outbound network flows to external destinations. Adversaries using T1041 blend exfiltration into existing C2 communications; this rule flags connections where an unusually high volume of bytes is sent outbound to a non-RFC1918 address, which is characteristic of bulk data theft over an established C2 channel. Firewall/perimeter telemetry is used, providing coverage additive to endpoint process-launch detections."
    mitre_tactic         = "Exfiltration"
    mitre_technique      = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites    = "Requires firewall or perimeter flow logs with bytes-sent (network.sent_bytes) populated per session. Logs must be normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform             = "Windows"
    log_source           = "firewall"
    false_positives      = "Legitimate large uploads to cloud storage (OneDrive, SharePoint, S3), software update distribution, backup agents sending data offsite, video conferencing with screen share, authorised bulk data transfers to SaaS platforms."
    tuning_guidance      = "Raise the network.sent_bytes threshold (currently 50 MB) if the environment has frequent large legitimate uploads. Add approved external destinations to %global_allowed_domains. Add scanner or backup source IPs to %global_allowed_scanners or %global_allowed_backup_processes reference lists as appropriate. Consider narrowing to specific destination port ranges if C2 is known to use non-standard ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Require a meaningful volume of outbound data indicative of bulk exfiltration
    // 50 MB threshold balances sensitivity vs. false-positive rate; tune per environment
    $net.network.sent_bytes >= 52428800

    // Exclude internal RFC1918 destinations - exfil travels to external infrastructure
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external domains (CDNs, update services, approved SaaS)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised management sources that legitimately move large data sets
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude approved scanners that may generate large outbound flows
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity    = array_distinct($net.principal.ip)
    $bytes_sent        = max($net.network.sent_bytes)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)

  condition:
    $net
}
