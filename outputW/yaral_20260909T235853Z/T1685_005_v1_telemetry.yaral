/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:41:13.259937+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_005_EventLog_EVTX_File_Deletion_Or_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects direct deletion or modification of Windows Event Log (.evtx) files under C:\\Windows\\System32\\winevt\\logs\\. Attackers who bypass command-line logging can still be caught at the file-artifact layer when they tamper with the stored log files directly. This provides additive coverage beyond process-creation rules targeting wevtutil or PowerShell."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1485.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires EDR or Sysmon file-event telemetry normalised to UDM FILE_DELETION or FILE_MODIFICATION. Sysmon Event ID 23 (FileDelete) or equivalent EDR file-event telemetry must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Event Log service itself rotating or archiving logs; backup agents archiving .evtx files; authorised forensic collection tools."
    tuning_guidance = "Add backup and forensic collection process paths to %global_allowed_backup_processes. Add authorised security tool paths to %global_allowed_security_tools. If the Windows Event Log service process (svchost.exe hosting EventLog) generates noise, scope exclusions to that specific process path."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\winevt\\[Ll]ogs\\.*\.evtx$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1485.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_log_file = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
