/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:07:37.572681+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Doppelganging_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where a non-system process requests handle access to another process with a combination of permissions (VM_WRITE + VM_OPERATION + CREATE_THREAD) consistent with process doppelganging memory injection. Process doppelganging abuses TxF to stage malicious code and then maps it into a target process; the handle request to the victim process is a durable OS-level artifact that survives command-line evasion."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelganging"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN events with target process path and granted access mask. CrowdStrike, SentinelOne, and Sysmon (Event ID 10) all populate this."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), security tools performing memory inspection, crash dump utilities, and some AV/EDR agents opening handles to monitored processes. Backup agents may also trigger this pattern."
    tuning_guidance = "Add known security and debugging tool paths to %global_allowed_security_tools. Add backup agent paths to %global_allowed_backup_processes. Narrow the rule further by requiring the opener to reside outside of known system directories if false-positive volume is high."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Opener must not be a known Windows system binary from a trusted system path
    $open.principal.process.file.full_path = /(?i)^[A-Za-z]:\\/ 
    not $open.principal.process.file.full_path = /(?i)^[A-Za-z]:\\Windows\\(System32|SysWOW64|WinSxS)\\/

    // Target process is a legitimate Windows host process - doppelganging hijacks
    // these to blend in; matching on the victim side is more stable than the attacker side
    $open.target.process.file.full_path = /(?i)\\(svchost|lsass|explorer|RuntimeBroker|spoolsv|winlogon|csrss|services|taskhost|taskhostw|sihost|ctfmon)\.exe$/

    // Opener must not itself be a known system binary (avoids system-to-system noise)
    not $open.principal.process.file.full_path = /(?i)\\(svchost|services|wininit|smss|csrss|lsass|winlogon|MsMpEng|SenseIR|SenseCncProxy)\.exe$/

    // Opener is not a known security tool or backup agent
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Opener is not an approved admin tool
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opener_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
