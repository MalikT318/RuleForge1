/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:01:33.077446+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Smuggling_HTTP_Then_DNS_Exfil {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage network pattern consistent with SVG smuggling on Linux: an inbound HTTP response delivering SVG content (large response body to an image/svg MIME path) followed within 5 minutes by an outbound DNS or HTTP connection to an external host from the same source IP. SVG files embedding JavaScript can trigger secondary downloads or C2 beaconing immediately after the browser renders the file."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires proxy or perimeter firewall logs that capture HTTP request/response metadata including URL path, content-type or file extension, response bytes, and DNS query events. Both event types must be normalised to UDM NETWORK_HTTP and NETWORK_DNS respectively."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Legitimate SVG-heavy web applications (data visualisation dashboards, mapping services), CDN-hosted SVG icon libraries, web design tools fetching SVG assets. Secondary DNS lookups may be routine browser pre-fetch behaviour."
    tuning_guidance = "Add known-good SVG-serving domains to %global_allowed_domains. Add internal scanner source IPs to %global_allowed_scanners. Raise the response-byte threshold if baseline SVG sizes in the environment are large. Narrow the secondary event filter to specific suspicious TLDs or newly-registered domain patterns if false-positive volume is high."

  events:
    // Stage 1: Inbound HTTP response delivering an SVG file from an external host
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    (
      $http.target.url = /\.svg(\?|#|$)/ nocase
      or
      $http.network.http.response_code = /(?i)image\/svg/
    )
    not $http.principal.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    $http.network.received_bytes >= 1024
    $http.principal.ip = $src_ip

    // Stage 2: Outbound DNS query from the same source IP to an external resolver
    $dns.metadata.event_type = "NETWORK_DNS"
    not $dns.target.hostname in %global_allowed_domains
    not $dns.principal.ip in %rfc1918_internal
    $dns.principal.ip = $src_ip

    // Chronological ordering: SVG delivery must precede the secondary DNS lookup
    $http.metadata.event_timestamp.seconds <= $dns.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score          = max(72)
    $mitre_technique_id  = array_distinct("T1027.017")
    $primary_entity      = array_distinct($src_ip)
    $svg_urls            = array_distinct($http.target.url)
    $secondary_domains   = array_distinct($dns.target.hostname)
    $http_response_bytes = max($http.network.received_bytes)
    $http_status_codes   = array_distinct($http.network.http.response_code)

  condition:
    $http and $dns
}
