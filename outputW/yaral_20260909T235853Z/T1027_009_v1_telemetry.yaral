/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:55:08.599562+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_Embedded_Payload_File_Written_Suspicious_Location {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation or modification events where a file with a benign extension (image, document, archive, font, etc.) is written to a world-writable or temporary location on Linux, a common artifact of embedded-payload staging. Attackers embed shellcode or secondary executables inside carrier files and drop them to /tmp, /dev/shm, /var/tmp, or hidden directories before extraction and execution. This rule pivots on the resulting file artifact rather than the command line used to create it."
    mitre_tactic         = "Defense Evasion"
    mitre_technique      = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites    = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform             = "Linux"
    log_source           = "linux_endpoint"
    false_positives      = "Legitimate image/document processing pipelines writing to /tmp (e.g., LibreOffice, ImageMagick, print spoolers). Backup agents staging archives in /var/tmp. Browser cache writes. Container build steps."
    tuning_guidance      = "Add known-good parent process paths to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the path regex to exclude specific application temp subdirectories that generate high-volume benign hits. Raise severity if the writing process is not a recognised document handler."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File lands in a world-writable or hidden staging location
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/proc\/[0-9]+\/fd\/)/ nocase

    // Carrier file has a benign-looking extension that can conceal embedded content
    $file.target.file.full_path = /\.(jpg|jpeg|png|gif|bmp|ico|svg|tiff|webp|pdf|doc|docx|xls|xlsx|ppt|pptx|odt|ods|odp|zip|tar|gz|bz2|xz|7z|rar|iso|img|ttf|otf|woff|woff2|mp3|mp4|wav|avi|mkv|mov|flac|ogg)$/ nocase

    // Exclude known-good backup and admin tooling that legitimately writes such files
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude security tooling (EDR agents scanning/quarantining files)
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_paths     = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
