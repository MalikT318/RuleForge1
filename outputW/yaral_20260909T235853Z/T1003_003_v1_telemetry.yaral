/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:24:40.931244+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_File_Access_Or_Copy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects file read or creation events targeting the NTDS.dit database or its associated SYSTEM/SECURITY hive files outside of expected system paths. Adversaries copy or access these files to extract Active Directory credential hashes offline. This rule fires on the resulting file artifact rather than the process command line, providing coverage that survives command-line obfuscation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires EDR or Sysmon file telemetry normalised to UDM FILE_CREATION or FILE_READ events. Sysmon Event ID 11 (FileCreate) and EDR file-access events are the primary sources."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate domain controller backup software (Windows Server Backup, Veeam, Commvault) staging NTDS.dit to a backup location. NTDS.dit appearing in Volume Shadow Copy paths during authorised backup jobs. AD DS restore operations by domain administrators."
    tuning_guidance = "Add authorised backup process paths to %global_allowed_backup_processes. Add authorised backup staging directories to a path exclusion by extending the not-in-path regex. Scope the rule to domain controller asset groups in Chronicle if the log source supports host-role tagging."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target the NTDS database file or the registry hives required to decrypt it.
    // Match the canonical DC path, VSS shadow copy staging paths, and any
    // non-standard location where an attacker might drop a copy.
    $file.target.file.full_path = /(?i)(ntds\.dit|ntds\.jfm|ntds\.pat|ntds\.edb)/ nocase

    // Exclude the canonical in-place location on the DC itself - the file
    // legitimately lives here and is not being copied when accessed in situ.
    // We want to fire when the file appears OUTSIDE its normal home, indicating
    // a staging or exfiltration copy has been written.
    not $file.target.file.full_path = /(?i)\\Windows\\NTDS\\ntds\.dit$/ nocase

    // Exclude authorised backup processes (Veeam, Windows Server Backup, etc.)
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known security tooling (EDR agents performing file inspection)
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $target_file_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
