/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:15:51.351067+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_Print_Processor_Registry_Key_Creation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of a registry key under the Print Processors path, which is the mechanism used by T1547.012 to register a malicious DLL that the print spooler (spoolsv.exe) loads at SYSTEM privilege during boot. This rule targets the resulting registry state change rather than the process command line, providing additive coverage that is harder for attackers to evade."
    mitre_tactic         = "Persistence, Privilege Escalation"
    mitre_technique      = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites    = "Requires EDR or Sysmon registry telemetry normalised to UDM REGISTRY_CREATION or REGISTRY_MODIFICATION events. Sysmon Event ID 12/13 or equivalent EDR registry events must be enabled."
    platform         = "Windows"
    log_source       = "windows_endpoint"
    false_positives  = "Legitimate printer driver installations by vendor software (e.g., HP, Canon, Xerox installers) may create keys under this path. Print server administrators deploying new print environments may also trigger this rule."
    tuning_guidance  = "Add the parent process paths of known printer management tools to %global_allowed_admin_tools. If specific print-server hosts are known, consider scoping by hostname. Validate that the Driver value points to a DLL in the expected system print-processor directory (%SystemRoot%\\System32\\spool\\prtprocs\\)."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\(CurrentControlSet|ControlSet[0-9]+)\\Control\\Print\\Environments\\[^\\]+\\Print Processors\\/  nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity    = array_distinct($reg.principal.hostname)
    $registry_key      = array_distinct($reg.target.registry.registry_key)
    $registry_value    = array_distinct($reg.target.registry.registry_value_name)
    $actor_process     = array_distinct($reg.principal.process.file.full_path)
    $actor_user        = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
