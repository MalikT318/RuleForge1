/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:39:44.730832+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_SID_History_Injection_Via_Mimikatz {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects SID-History injection attempts via Mimikatz or similar tooling by monitoring for processes invoking SID-History modification functions or PowerShell commands targeting the sidHistory attribute."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires EDR process telemetry with command-line logging or PowerShell script-block logging (Event ID 4104)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Active Directory migration tooling (ADMT), domain consolidation projects, authorized identity management scripts."
    tuning_guidance = "Add approved migration tools to %global_allowed_admin_tools and authorized service accounts to %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /sid::patch/ nocase or
      $proc.target.process.command_line = /sid::add/ nocase or
      $proc.target.process.command_line = /sid::modify/ nocase or
      $proc.target.process.command_line = /misc::addsid/ nocase or
      $proc.target.process.command_line = /Set-ADUser.*-Add.*@\{sidHistory/ nocase or
      $proc.target.process.command_line = /Set-ADUser.*sidHistory.*=/ nocase or
      $proc.target.process.command_line = /ldifde.*sidHistory/ nocase or
      $proc.target.process.command_line = /dsmod.*sidHistory/ nocase or
      $proc.target.process.command_line = /Invoke-Mimikatz.*sid::/ nocase or
      $proc.target.process.command_line = /DsAddSidHistory/ nocase or
      $proc.target.process.command_line = /sidhistory.*S-1-5-21-/ nocase
    )
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
