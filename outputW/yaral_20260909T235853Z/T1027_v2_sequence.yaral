/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:48:34.695208+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_ESXi_Login_Then_Datastore_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive or SSH login to an ESXi host followed by a datastore or VM configuration setting modification within 5 minutes. Adversaries staging obfuscated payloads on ESXi datastores frequently authenticate and then alter VM or host configuration to hide or persist encoded files. This correlation targets the authentication-then-modification sequence rather than command-line content, providing additive coverage over existing process-launch rules."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "Requires ESXi hostd and shell authentication events normalised to USER_LOGIN, and hostd/vmkernel configuration change events normalised to SETTING_MODIFICATION in Chronicle UDM."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised vSphere administrators performing routine VM reconfiguration, automated orchestration pipelines (vRealize, Ansible), backup agents modifying VM snapshots or storage policies."
    tuning_guidance = "Add authorised administrator accounts to %global_allowed_admin_users and approved automation service accounts to %global_allowed_service_accounts. Narrow the SETTING_MODIFICATION filter to specific target.resource.name patterns matching sensitive datastores if noise is high."

  events:
    // Event 1: Interactive or SSH login to the ESXi management plane
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $esxi_host
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %rfc1918_internal

    // Event 2: A host or VM configuration setting is modified shortly after
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname = $esxi_host
    // Narrow to datastore, VM config, or advanced host settings to avoid
    // matching routine heartbeat or stats updates
    $cfg.target.resource.name = /(?i)(datastore|vmx|vmdk|vmfs|advancedconfig|hostsystem|extraconfig|vmconfig)/

    // Chronological ordering: login must precede the configuration change
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $esxi_host over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($auth.target.hostname)
    $actor_users = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $modified_resources = array_distinct($cfg.target.resource.name)
    $login_count = count($auth.metadata.event_timestamp.seconds)
    $change_count = count($cfg.metadata.event_timestamp.seconds)

  condition:
    $auth and $cfg
}
