/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:05:13.687194+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_Subvert_Trust_Controls_MOTW_Removal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects attempts to subvert Windows trust controls by removing or tampering with the Mark-of-the-Web (MOTW) Zone.Identifier alternate data stream, disabling SmartScreen via registry modification, or manipulating Authenticode/WinVerifyTrust registry settings. Adversaries use these techniques to suppress security warnings and allow untrusted code to execute without user prompts."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553"
    mitre_technique_name = "Subvert Trust Controls"
    log_prerequisites = "Requires EDR or Sysmon telemetry capturing registry modification events with full key paths and value names. Windows Security Event 4657 or Sysmon Event ID 13 are suitable sources."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment tools that legitimately unblock downloaded installers, group policy management tools modifying SmartScreen policy, enterprise security configuration baselines, and some AV/EDR products that modify trust-related registry keys during installation."
    tuning_guidance = "Add known software deployment and patch management parent processes to %global_allowed_admin_tools. Add authorised service accounts that manage security policy to %global_allowed_service_accounts. Scope by principal.hostname to exclude known management hosts if needed."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Match any of the key trust-control registry paths:
    // 1. SmartScreen enforcement policy (HKLM and HKCU variants)
    // 2. Authenticode/WinVerifyTrust publisher settings
    // 3. Internet Zone security settings that control MOTW behaviour
    // 4. Attachment Manager (controls MOTW/Zone.Identifier handling)
    (
      $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\(Policies\\)?Microsoft\\Windows\\System\\EnableSmartScreen/
      or
      $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\(Policies\\)?Microsoft\\Windows\\CurrentVersion\\Explorer\\SmartScreenEnabled/
      or
      $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Attachments/
      or
      $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\(Policies\\)?Microsoft\\Internet Explorer\\Security\\DisableSafetyFilterOverride/
      or
      $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options/
      or
      $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\(Policies\\)?Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3/
      or
      $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Associations/
    )

    // Exclude authorised administrative and security tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1553")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
