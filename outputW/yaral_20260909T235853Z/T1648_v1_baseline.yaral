/*
  MITRE Technique : T1648 - Serverless Execution
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:24:23.612419+00:00
  Reference       : https://attack.mitre.org/techniques/T1648
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1648_001_Serverless_Function_Creation_Or_Update {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or update of serverless functions (e.g., Power Automate flows, Logic Apps, or equivalent SaaS automation resources) via M365 unified audit logs. Adversaries abuse serverless execution to run arbitrary code, escalate privileges, or establish persistence by attaching elevated roles to cloud functions."
    mitre_tactic = "Execution"
    mitre_technique = "T1648"
    mitre_technique_name = "Serverless Execution"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log with Power Automate, Power Apps, or Logic Apps audit events enabled. UDM event type: USER_RESOURCE_UPDATE_CONTENT or USER_RESOURCE_CREATION."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate business automation developers creating or updating approved Power Automate flows; IT administrators deploying sanctioned Logic App workflows; low-code platform champions building approved integrations."
    tuning_guidance = "Add known automation service accounts to %global_allowed_service_accounts. Add approved admin users who routinely manage flows to %global_allowed_admin_users. Narrow scope by correlating with first-seen user or anomalous time-of-day if volume is high."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"

    // Target resource must reference a serverless or automation/flow resource type
    // Matches Power Automate flows, Logic Apps, cloud functions, or similar automation resources
    $cloud.target.resource.name = /(?i)(flow|logicapp|logic.app|automation|function|trigger|connector|workflow)/

    // Operation must indicate creation, update, or deployment of the resource
    $cloud.metadata.product_event_type = /(?i)(create|update|deploy|publish|import|patch|set|write|upsert).*(flow|function|logicapp|logic.app|automation|workflow|trigger)/

    // Exclude known-good service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good admin users who routinely manage automation resources
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Exclude known-good cloud principals (e.g., CI/CD service principals)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1648")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $operation_performed = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
