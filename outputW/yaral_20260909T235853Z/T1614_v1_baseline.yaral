/*
  MITRE Technique : T1614 - System Location Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:22:21.557504+00:00
  Reference       : https://attack.mitre.org/techniques/T1614
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_System_Location_Discovery_GeoIP_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP/HTTPS connections to external IP geolocation or location-discovery services. Adversaries query these services to determine the geographic location of a victim host before deciding whether to proceed with full infection or region-specific payloads. This rule fires on network-observable behaviour: a connection to a well-known geolocation lookup hostname pattern from an internal source."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614"
    mitre_technique_name = "System Location Discovery"
    log_prerequisites = "Requires firewall or proxy logs with HTTP/HTTPS URL or SNI hostname visibility. UDM fields target.hostname or target.url must be populated by the normalisation parser."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate applications that check public IP for connectivity validation (e.g., network diagnostics tools, VPN clients, browser extensions). Weather or map applications querying location APIs. Automated asset inventory or monitoring tools."
    tuning_guidance = "Add approved internal tooling source IPs or known-good service accounts to %global_allowed_scanners. Add approved external domains to %global_allowed_domains. Narrow scope by restricting to specific internal subnets if geolocation lookups are expected only from certain hosts."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    not $net.principal.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

    $net.target.hostname = /(?i)(ip-api|ipapi|ipinfo|ipgeolocation|geoip|geo\.ip|freegeoip|ipstack|ip\.sb|ipwhois|myip|whatismyip|checkip|icanhazip|ifconfig\.me|api\.ipify|ipecho|ip-lookup|iplocation|ipdata\.co|db-ip|maxmind|geoiplookup|abstractapi\.com\/v1\/ip)/ nocase

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1614")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hostname = array_distinct($net.target.hostname)
    $destination_url = array_distinct($net.target.url)

  condition:
    $net
}
