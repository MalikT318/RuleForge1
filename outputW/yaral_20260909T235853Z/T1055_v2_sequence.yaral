/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:59:50.236079+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_Process_Open_Then_Remote_Thread_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a suspicious process opening a handle to a remote process (PROCESS_OPEN) followed by a process injection event (PROCESS_INJECTION) on the same host within 5 minutes. This two-stage sequence is characteristic of classic injection techniques such as VirtualAllocEx/WriteProcessMemory/CreateRemoteThread and is additive to command-line-only detections."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN (handle acquisition) and PROCESS_INJECTION events normalised into UDM. CrowdStrike Falcon, Microsoft Defender for Endpoint, and Sysmon Event IDs 10 and 8 all produce this telemetry."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tooling (EDR agents, AV engines), JIT compilers (.NET CLR, JVM), debuggers (WinDbg, x64dbg), legitimate RMM agents, software installers that inject into explorer.exe."
    tuning_guidance = "Add known-good opener processes to %global_allowed_security_tools. Add approved administrative binaries to %global_allowed_admin_tools. Narrow the target process filter if high-value targets such as lsass.exe or svchost.exe generate noise from authorised tooling."

  events:
    // Stage 1: A non-system process opens a handle to a remote process.
    // Sysmon Event ID 10 / EDR equivalent maps to PROCESS_OPEN in UDM.
    $open.metadata.event_type = "PROCESS_OPEN"
    // Opener must not be a known security or admin tool
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    // Opener must not be a system-level binary (filter obvious false positives)
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\(csrss|wininit|services|lsass|svchost|smss|winlogon|dwm|taskhostw|spoolsv|searchindexer)\.exe$/
    // Target process is a high-value injection destination
    $open.target.process.file.full_path = /(?i)\\windows\\(system32|syswow64)\\(svchost|lsass|explorer|rundll32|dllhost|werfault|conhost|msiexec|regsvr32|wscript|cscript|mshta|notepad)\.exe$/
    // Bind to host for join
    $open.principal.hostname = $hostname

    // Stage 2: A PROCESS_INJECTION event on the same host, from the same injecting process.
    // Sysmon Event ID 8 (CreateRemoteThread) / EDR equivalent maps to PROCESS_INJECTION in UDM.
    $inj.metadata.event_type = "PROCESS_INJECTION"
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    $inj.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the injection
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($open.principal.hostname)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $injection_target_at_stage2 = array_distinct($inj.target.process.file.full_path)
    $injecting_user = array_distinct($open.principal.user.userid)
    $event_count = count($inj.metadata.event_timestamp.seconds)

  condition:
    $open and $inj
}
