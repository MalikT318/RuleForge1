/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:19:05.912862+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_WiFi_Profile_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file creation of Wi-Fi profile export artifacts on Windows. Adversaries exporting WLAN profiles via netsh or programmatic API calls produce XML profile files in predictable locations. This rule targets the resulting file artifact rather than the command line, providing coverage that survives command-line obfuscation or direct API usage."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event). The EDR must log file creation events for user-writable and temp directories."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate IT asset management tools that export Wi-Fi profiles for provisioning or backup. Windows built-in 'netsh wlan export' run by authorized administrators. MDM/GPO-based Wi-Fi profile deployment agents."
    tuning_guidance = "Add authorized backup or provisioning process paths to %global_allowed_backup_processes. Add authorized admin accounts to %global_allowed_admin_users. Narrow scope by excluding known-good parent process paths if MDM tooling is noisy."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Wi-Fi profile XML files exported by netsh wlan export or written by tools
    // that call wlanAPI.dll directly. Profiles land in the CWD of the calling
    // process or in temp/user directories. Match the characteristic filename
    // pattern: "Wi-Fi-<SSID>.xml" or "WLAN-<SSID>.xml" or generic profile dumps.
    (
      $file.target.file.full_path = /\\Wi-Fi-[^\\]+\.xml$/  nocase or
      $file.target.file.full_path = /\\WLAN-[^\\]+\.xml$/ nocase or
      $file.target.file.full_path = /\\wireless[^\\]*\.xml$/ nocase
    )

    // Restrict to locations where adversarial tooling typically writes:
    // user profile trees, temp directories, and working directories outside
    // the legitimate Windows provisioning path (C:\ProgramData\Microsoft\Wlansvc).
    not $file.target.file.full_path = /(?i)\\ProgramData\\Microsoft\\Wlansvc\\/
    not $file.target.file.full_path = /(?i)\\Windows\\System32\\spool\\/

    // Exclude authorized backup and provisioning processes
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorized admin accounts performing provisioning
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
