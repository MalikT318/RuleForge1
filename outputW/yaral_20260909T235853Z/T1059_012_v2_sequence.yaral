/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:18:15.477757+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Login_Then_Hypervisor_CLI_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive or SSH login to an ESXi host followed by rapid execution of hypervisor management CLI commands (esxcli, vim-cmd, esxcfg-*, vmkfstools) within a short window. This pattern is consistent with adversaries leveraging the ESXi shell to enumerate, manipulate, or reconfigure the hypervisor after gaining access. Variant 2 of 2 for T1059.012 - focuses on the login-to-CLI-execution sequence rather than individual command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "Requires ESXi shell/hostd telemetry normalised to UDM. USER_LOGIN events must populate principal.user.userid and principal.hostname. PROCESS_LAUNCH events must populate target.process.file.full_path and principal.hostname."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised VMware administrators performing routine maintenance, patching, or VM lifecycle operations via the ESXi shell. Automated orchestration frameworks (vSphere APIs, Ansible, Terraform) that authenticate and invoke esxcli. Monitoring agents that periodically query host state."
    tuning_guidance = "Add known administrative service accounts to %global_allowed_service_accounts. Add approved management source hosts to %global_allowed_mgmt_sources. Raise severity if the authenticating user is not in %global_allowed_admin_users. Consider narrowing to after-hours logins for higher-fidelity alerting."

  events:
    // Leg 1: Interactive or SSH login to the ESXi host
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $esxi_host
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Leg 2: Hypervisor management CLI process launched on the same host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $esxi_host
    $proc.target.process.file.full_path = /\/(esxcli|vim-cmd|esxcfg-[a-z]+|vmkfstools|esxcfg-firewall|esxcfg-nics|esxcfg-vmknic|esxcfg-route|esxcfg-advcfg|esxcfg-vswitch|esxcfg-module|esxcfg-info|esxcfg-resgrp|esxcfg-nas|esxcfg-mpath|esxcfg-scsidevs|esxcfg-swiscsi|esxcfg-vmhbadevs|esxcfg-dumppart|esxcfg-boot|esxcfg-auth|esxcfg-syslog|esxcfg-vswif|esxcfg-dns|esxcfg-hostops|esxcfg-upgrade|esxcfg-linuxnet|esxcfg-pciid|esxcfg-rescan|esxcfg-vmknic|esxcfg-vswitch|vmware-cmd|localcli)$/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Chronological ordering: login must precede CLI execution
    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $esxi_host over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($esxi_host)
    $authenticated_users = array_distinct($auth.principal.user.userid)
    $cli_binaries_executed = array_distinct($proc.target.process.file.full_path)
    $cli_execution_count = count($proc.target.process.file.full_path)

  condition:
    $auth and $proc
}
