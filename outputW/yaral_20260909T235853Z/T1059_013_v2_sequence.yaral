/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:19:02.739923+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_API_Exec_Then_Outbound_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud audit event for an interactive exec/attach session into a running container followed by an outbound resource access or data retrieval API call from the same principal within 5 minutes. This pattern indicates an adversary using the container CLI/API to gain shell access and then exfiltrating data or pivoting via cloud APIs - additive coverage over process-launch command-line rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Requires cloud provider audit logs (e.g., Kubernetes API server audit, Docker API audit) normalised into Chronicle UDM. USER_RESOURCE_ACCESS events must include resource.type and resource.name fields reflecting container exec/attach operations."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Authorised SRE/DevOps engineers performing live debugging, CI/CD pipelines that exec into containers for health checks, monitoring agents that attach to containers for log collection."
    tuning_guidance = "Add known CI/CD service accounts to %global_allowed_service_accounts. Add approved automation principals to %global_allowed_cloud_principals. Narrow the resource.type regex if your environment uses a consistent naming convention for non-container resources."

  events:
    // Event 1: Interactive exec or attach into a running container via cloud/k8s API
    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.resource.type = /(?i)(container|pod)/
    $exec.metadata.description = /(?i)(exec|attach|run)/
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_cloud_principals
    $exec.principal.user.userid = $actor

    // Event 2: Subsequent cloud API resource access (data plane or control plane read)
    // that is NOT another exec - indicates post-exec lateral movement or data access
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    not $access.target.resource.type = /(?i)(container|pod)/
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals
    $access.principal.user.userid = $actor

    // Chronological ordering: exec must precede the follow-on access
    $exec.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $actor over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($exec.principal.user.userid)
    $exec_target_resources = array_distinct($exec.target.resource.name)
    $followon_target_resources = array_distinct($access.target.resource.name)
    $followon_resource_types = array_distinct($access.target.resource.type)
    $source_ips = array_distinct($exec.principal.ip)

  condition:
    $exec and $access
}
