/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:03:25.585728+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_PreOS_Boot_Firmware_Write_Attempt {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects processes attempting to write to firmware or bootloader components, a primary indicator of Pre-OS Boot persistence (T1542). Covers direct access to physical disk sectors, EFI system partition writes, BCD store modifications, and known firmware-interaction utilities invoked with write-capable arguments. Attackers targeting BIOS/UEFI or the MBR/VBR must interact with these OS mechanisms regardless of the tool used."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (e.g., Sysmon Event ID 1, CrowdStrike, Microsoft Defender for Endpoint, or Windows Security Event 4688 with process command-line auditing enabled)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate firmware update utilities from hardware vendors (Dell Command Update, HP BIOS update, Lenovo System Update), Windows boot repair tools (bootrec, bcdboot run by IT during OS recovery), dual-boot configuration by authorized administrators, disk imaging software."
    tuning_guidance = "Add authorized firmware update parent processes or full paths to %global_allowed_admin_tools. Add authorized service accounts that run firmware update tasks to %global_allowed_service_accounts. Scope by principal.hostname to known imaging or provisioning hosts if volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match processes that interact with boot/firmware write mechanisms.
    // Pattern 1: bcdedit modifying boot configuration store (persistence vector).
    // Pattern 2: bootrec /fixmbr or /fixboot rewrites boot sectors.
    // Pattern 3: diskpart with script targeting disk 0 (raw sector access).
    // Pattern 4: PowerShell or cmd invoking dd-equivalent or raw disk device paths.
    // Pattern 5: Direct physical device path access \\.\PhysicalDrive0 in command line.
    (
      (
        $proc.target.process.file.full_path = /\\bcdedit\.exe$/ nocase
        and $proc.target.process.command_line = /(\/set|\/create|\/delete|\/import|\/copy)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\bootrec\.exe$/ nocase
        and $proc.target.process.command_line = /(\/fixmbr|\/fixboot|\/rebuildbcd)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd)\.exe$/ nocase
        and $proc.target.process.command_line = /(\\\\\\.\\\\PhysicalDrive|\\\\\.\\PhysicalDrive)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and $proc.target.process.command_line = /(WriteAllBytes|BinaryWriter|FileStream).*(efi|boot|bcd)/  nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\diskpart\.exe$/ nocase
        and $proc.target.process.command_line = /\/s/ nocase
      )
    )

    // Exclude known-good administrative tooling parent processes.
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorized service accounts running scheduled firmware updates.
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
