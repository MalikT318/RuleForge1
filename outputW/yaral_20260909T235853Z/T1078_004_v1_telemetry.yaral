/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:22:09.703307+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_Cloud_Account_Privilege_Escalation_Via_Role_Assignment {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects assignment of privileged cloud roles to user or service principal accounts, a common persistence and privilege escalation technique using valid cloud accounts."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires identity provider audit logs capturing role and permission changes."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate administrator onboarding, break-glass account activation, service principal configuration during application deployment, automated identity governance workflows."
    tuning_guidance = "Add authorized service principals and automation accounts to %global_allowed_cloud_principals. Exclude expected administrative users via %global_allowed_admin_users."

  events:
    $event.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    (
      $event.target.resource.attribute.labels["role_name"] = /(?i)(global.?admin|company.?admin|tenant.?admin|application.?admin|privileged.?role.?admin|user.?admin|security.?admin|compliance.?admin|exchange.?admin|sharepoint.?admin|cloud.?application.?admin|authentication.?admin|directory.?writer|owner|contributor.?admin)/ or
      $event.target.resource.attribute.labels["permission_scope"] = /(?i)(directory\.readwrite\.all|rolemanagement\.readwrite\.directory|application\.readwrite\.all|user\.readwrite\.all|group\.readwrite\.all|domain\.readwrite\.all|privilegedaccess\.readwrite\.azurerm)/ or
      $event.target.user.attribute.labels["assigned_role"] = /(?i)(global.?admin|company.?admin|tenant.?admin|application.?admin|privileged.?role.?admin|user.?admin|security.?admin|compliance.?admin|exchange.?admin|sharepoint.?admin|cloud.?application.?admin|authentication.?admin|directory.?writer|owner|contributor.?admin)/
    )
    not $event.principal.user.userid in %global_allowed_cloud_principals
    not $event.principal.user.userid in %global_allowed_admin_users
    not $event.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($event.principal.user.userid)
    $target_account = array_distinct($event.target.user.userid)
    $assigned_role = array_distinct($event.target.resource.attribute.labels["role_name"])

  condition:
    $event
}
