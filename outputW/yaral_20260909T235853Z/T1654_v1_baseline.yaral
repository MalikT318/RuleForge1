/*
  MITRE Technique : T1654 - Log Enumeration
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:25:49.126127+00:00
  Reference       : https://attack.mitre.org/techniques/T1654
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1654_001_Log_Enumeration_Windows {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects log enumeration activity on Windows using built-in utilities such as wevtutil.exe or PowerShell cmdlets to query, export, or clear Windows event logs. Adversaries enumerate logs to identify authentication records, installed software, and network topology during discovery phases."
    mitre_tactic = "Discovery"
    mitre_technique = "T1654"
    mitre_technique_name = "Log Enumeration"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with command-line logging enabled. PowerShell script-block logging (Event ID 4104) also surfaces this activity."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SIEM agents, backup tools, and monitoring software that legitimately query event logs. IT administrators running ad-hoc diagnostics. Scheduled compliance scripts exporting logs to a SIEM."
    tuning_guidance = "Add known-good service account identifiers to %global_allowed_service_accounts and approved tooling parent processes to %global_allowed_admin_tools. Narrow the rule by adding a volume threshold or restricting to sensitive log channels (Security, System) if false-positive rates are high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match wevtutil.exe invocations performing enumeration or export actions
    // OR PowerShell/pwsh invoking Get-EventLog / Get-WinEvent cmdlets
    (
      (
        $proc.target.process.file.full_path = /\\wevtutil(\.exe)?$/ nocase
        and
        $proc.target.process.command_line = /\b(el|enum-logs|gl|get-log|qe|query-events|epl|export-log|gli|get-log-info)\b/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)(\.exe)?$/ nocase
        and
        $proc.target.process.command_line = /\b(Get-EventLog|Get-WinEvent|wevtutil)\b/ nocase
      )
    )

    // Exclude known-good service accounts performing automated log collection
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative and security tooling as parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved backup processes that legitimately read event logs
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1654")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_observed = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
