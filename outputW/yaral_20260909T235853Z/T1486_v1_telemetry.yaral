/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:24:18.575757+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_001_ESXi_VM_Datastore_File_Mass_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects mass or anomalous modification of VM datastore files on ESXi hosts, a key artifact of ransomware encrypting virtual machine disk images (VMDK, VMEM, VSWP, flat files). Ransomware targeting ESXi typically modifies or renames these files in bulk after stopping VMs. This rule pivots on the FILE_MODIFICATION event produced by ESXi hostd/vmkernel telemetry rather than process command-line arguments, providing coverage that survives command-line evasion."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires ESXi file activity telemetry normalised into Chronicle UDM FILE_MODIFICATION events. Hostd and vmkernel logs must be forwarded to Chronicle via syslog or a Chronicle forwarder. The log source must produce target.file.full_path populated with datastore paths."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate storage vMotion operations, authorised datastore migrations, snapshot consolidation jobs, backup agents writing to datastores (e.g. Veeam, Commvault). Storage DRS rebalancing may also trigger this rule."
    tuning_guidance = "Add authorised backup service account identifiers to %global_allowed_backup_processes and authorised admin accounts to %global_allowed_admin_users. Consider narrowing the file extension regex if the environment uses only specific VM disk formats. Raise the threshold or add a match window if false positives from migration jobs persist."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target datastore paths on ESXi - datastores are mounted under /vmfs/volumes/
    $file.target.file.full_path = /^\/vmfs\/volumes\// nocase

    // Match VM disk and memory artefact extensions that ransomware targets on ESXi
    // VMDK = virtual disk descriptor, -flat.vmdk = raw disk data, vmem/vswp = memory/swap
    // Also catch files that have been renamed with a ransomware extension appended
    $file.target.file.full_path = /\.(vmdk|vmem|vswp|nvram|vmx|vmxf|vmsd|vmsn|vmss|log)(\.[a-z0-9]{2,10})?$/ nocase

    // The modifying process should NOT be a known authorised backup or storage agent
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known authorised admin accounts performing legitimate datastore work
    not $file.principal.user.userid in %global_allowed_admin_users

    // Exclude known authorised service accounts (vCenter, storage DRS, HA agents)
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude VMware's own internal management processes by path prefix
    // hostd, vpxa, fdm are legitimate ESXi daemons that touch VM files
    not $file.principal.process.file.full_path = /^\/(bin|sbin|usr\/lib\/vmware)\/(hostd|vpxa|fdm|storageRM|vmkfstools)/ nocase

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
