/*
  MITRE Technique : T1652 - Device Driver Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:25:14.153229+00:00
  Reference       : https://attack.mitre.org/techniques/T1652
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1652_001_Device_Driver_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects enumeration of installed device drivers on Windows via driverquery.exe, PowerShell Get-WmiObject Win32_SystemDriver, or sc.exe querying driver-type services. Adversaries use driver enumeration to identify security tools, virtualization artifacts, or exploitable vulnerable drivers for privilege escalation."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1652"
    mitre_technique_name = "Device Driver Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "IT asset inventory tools, vulnerability scanners, software deployment agents, and system health monitoring scripts that legitimately enumerate drivers. Administrators running driverquery interactively for troubleshooting."
    tuning_guidance = "Add known-good parent processes (e.g., RMM agents, inventory collectors) to %global_allowed_admin_tools. Add authorised service accounts that run scheduled inventory jobs to %global_allowed_service_accounts. Consider raising severity if the parent process is an Office application, browser, or script interpreter spawned from a user session."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the three primary Windows driver enumeration mechanisms:
    // 1. driverquery.exe (built-in driver enumeration utility)
    // 2. PowerShell / pwsh querying Win32_SystemDriver or Win32_PnPSignedDriver via WMI/CIM
    // 3. sc.exe querying services of type=driver
    (
      $proc.target.process.file.full_path = /\\driverquery\.exe$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /Win32_SystemDriver/ nocase
          or
          $proc.target.process.command_line = /Win32_PnPSignedDriver/ nocase
          or
          $proc.target.process.command_line = /EnumDeviceDrivers/ nocase
          or
          $proc.target.process.command_line = /Get-WmiObject.*driver/ nocase
          or
          $proc.target.process.command_line = /Get-CimInstance.*driver/ nocase
        )
      )
      or
      (
        $proc.target.process.file.full_path = /\\sc\.exe$/ nocase
        and
        $proc.target.process.command_line = /type=\s*driver/ nocase
      )
    )

    // Exclude known-good administrative tooling and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1652")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
