/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:12:32.471082+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_SSP_Registry_Write_Then_DLL_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage SSP persistence pattern: a process modifies the LSA Security Packages registry key to register a new SSP, followed by a DLL file being written to disk on the same host within 10 minutes. Adversaries abuse this to load malicious DLLs into LSASS at boot or via AddSecurityPackage, gaining access to plaintext credentials."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires EDR or Sysmon registry modification events (Event ID 13) and file creation events (Event ID 11) normalised to UDM REGISTRY_MODIFICATION and FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security software (e.g., smart-card middleware, third-party authentication providers) that registers a new SSP DLL during installation. Windows updates may also touch these keys."
    tuning_guidance = "Add known-good installer processes to %global_allowed_admin_tools and known-good SSP DLL paths to %global_allowed_security_tools. Scope by principal.process.file.full_path of the writing process."

  events:
    // Event 1: Registry modification of LSA Security Packages key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\(OSConfig\\)?Security Packages$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    // Event 2: DLL file written to disk on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\.dll$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    // Chronological ordering: registry write precedes DLL drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_keys = array_distinct($reg.target.registry.registry_key)
    $dropped_dll_paths = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($reg.principal.process.file.full_path)
    $file_writing_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
