/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:38:36.059630+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_Create_Process_With_Token {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process creation where the launching process identity differs from the token owner, indicating CreateProcessWithTokenW or runas-style token abuse. Targets cases where a non-interactive, non-service parent spawns a child under a different user context, which is the core OS mechanism of T1134.002."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires EDR or Sysmon process telemetry that populates both principal.user (parent process token) and target.user (child process token), or Windows Security Event 4688 with subject/new-process-token fields. Principal and target user fields must be distinct for the signal to fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate runas.exe usage by administrators, RMM agents launching processes as SYSTEM, software deployment tools (SCCM, Intune), scheduled tasks running under alternate accounts, antivirus/EDR self-protection spawning child processes under SYSTEM."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools. Add service and automation accounts to %global_allowed_service_accounts. Add approved admin users to %global_allowed_admin_users. Consider narrowing by requiring the child process to be a shell (cmd.exe, powershell.exe, pwsh.exe) for higher fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent process user must be populated and not SYSTEM itself initiating normal child work
    $proc.principal.user.userid != ""
    $proc.target.user.userid != ""

    // Core signal: the token under which the child runs differs from the parent's token owner
    $proc.principal.user.userid != $proc.target.user.userid

    // Exclude SYSTEM-to-SYSTEM transitions (normal OS behaviour)
    not $proc.principal.user.userid = /(?i)^(nt authority\\system|system)$/
    not $proc.target.user.userid = /(?i)^(nt authority\\system|system)$/

    // Exclude LOCAL SERVICE and NETWORK SERVICE spawning children (normal Windows service model)
    not $proc.principal.user.userid = /(?i)^(nt authority\\(local service|network service))$/
    not $proc.target.user.userid = /(?i)^(nt authority\\(local service|network service))$/

    // Exclude machine accounts (domain controllers, computer accounts)
    not $proc.principal.user.userid = /\$$/
    not $proc.target.user.userid = /\$$/

    // Exclude known-good administrative tooling parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved service and automation accounts performing expected cross-user spawning
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.target.user.userid in %global_allowed_service_accounts

    // Exclude approved admin users performing deliberate runas operations
    not $proc.principal.user.userid in %global_allowed_admin_users

    // Increase fidelity: child is a shell, script host, or common lateral movement target
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|certutil)\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $parent_user = array_distinct($proc.principal.user.userid)
    $child_user = array_distinct($proc.target.user.userid)
    $child_cmdline = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
