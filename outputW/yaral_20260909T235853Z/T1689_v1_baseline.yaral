/*
  MITRE Technique : T1689 - Downgrade Attack
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:31:38.291981+00:00
  Reference       : https://attack.mitre.org/techniques/T1689
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1689_001_PowerShell_Version_Downgrade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PowerShell being launched with an explicit version flag targeting version 2, which predates Script Block Logging (SBL) and AMSI. Adversaries use this to evade script-based defenses while executing malicious code."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1689"
    mitre_technique_name = "Downgrade Attack"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy automation scripts or compatibility wrappers that explicitly target PowerShell v2 for legitimate reasons. Legacy test harnesses in CI/CD pipelines."
    tuning_guidance = "Add known-good parent processes or script hosts that legitimately invoke PowerShell v2 to %global_allowed_script_hosts. Scope by principal.hostname for known legacy systems."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh)\.exe$/
    $proc.target.process.command_line = /(?i)-ve?r(s(i(on?)?)?)?\s+2/
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1689")
    $primary_entity = array_distinct($proc.principal.hostname)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
