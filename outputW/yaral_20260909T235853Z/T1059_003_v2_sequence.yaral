/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:12:27.459639+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_CmdShell_Drops_File_Then_Executes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage sequence where cmd.exe creates a file in a suspicious writable location, followed by a process launch originating from that same location on the same host. This pattern is consistent with cmd.exe being used to stage and execute a payload, providing additive coverage beyond simple command-line matching."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Event ID 11) and process-launch telemetry (Event ID 1 / 4688) normalised into UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that use cmd.exe to extract and run components; build pipelines writing and executing artefacts in temp directories; RMM agents staging updates."
    tuning_guidance = "Add known-good parent processes to %global_allowed_admin_tools. Add known-good staging hosts to %global_allowed_script_hosts. Narrow the file-path regex if specific directories generate noise."

  events:
    // Stage 1: cmd.exe creates a file in a suspicious writable location
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\cmd\.exe$/ nocase
    $file.target.file.full_path = /(?i)(\\temp\\|\\tmp\\|\\appdata\\|\\programdata\\|\\users\\public\\|\\windows\\temp\\)/ nocase
    $file.target.file.full_path = /(?i)\.(exe|bat|cmd|ps1|vbs|js|hta|dll|scr|com)$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $staged_path

    // Stage 2: A new process is launched from the same suspicious path on the same host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $staged_path
    $proc.principal.hostname = $hostname
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

    // Enforce chronological ordering: file must be created before execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $staged_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $staged_file_paths = array_distinct($proc.target.process.file.full_path)
    $cmd_parent_process = array_distinct($file.principal.process.file.full_path)
    $launched_process_cmdline = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
