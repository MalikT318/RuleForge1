/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:39:28.595582+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_M365_AuditBypass_Then_MailboxAccess {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a mailbox audit bypass or advanced auditing modification followed by mailbox resource access for the same user within 10 minutes. This pattern indicates an adversary disabling M365 audit logging before accessing mailbox data to evade detection, consistent with T1685.002 abuse of Set-MailboxAuditBypassAssociation or license downgrade activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Log"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log ingested into Chronicle via the M365 connector. Audit log must include Exchange admin audit events (Set-MailboxAuditBypassAssociation, Set-AdminAuditLogConfig, Disable-OrganizationCustomization) and mailbox access events (MailItemsAccessed, FolderBind, MessageBind)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Authorized Exchange administrators performing bulk mailbox migrations or compliance configuration changes. Automated provisioning pipelines that adjust audit settings as part of onboarding or offboarding workflows. License management tooling that legitimately downgrades or upgrades user licenses."
    tuning_guidance = "Add known Exchange admin service accounts to %global_allowed_service_accounts to suppress expected administrative activity. Add authorized automation principals to %global_allowed_cloud_principals. Narrow the target.user.userid join field to high-value or sensitive mailboxes if alert volume is high."

  events:
    // Event 1: Audit bypass or audit configuration modification targeting a specific user
    $audit.metadata.event_type = "SETTING_MODIFICATION"
    $audit.target.user.userid != ""
    (
      $audit.target.resource.name = /(?i)mailboxauditbypass/ or
      $audit.target.resource.name = /(?i)adminauditlog/ or
      $audit.target.resource.name = /(?i)auditconfig/ or
      $audit.target.resource.name = /(?i)organizationcustomization/ or
      $audit.target.resource.name = /(?i)mailboxaudit/
    )
    not $audit.principal.user.userid in %global_allowed_service_accounts
    not $audit.principal.user.userid in %global_allowed_cloud_principals
    $audit.target.user.userid = $target_userid

    // Event 2: Mailbox resource access by the same user whose audit was modified
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid != ""
    (
      $access.target.resource.name = /(?i)mail/ or
      $access.target.resource.name = /(?i)inbox/ or
      $access.target.resource.name = /(?i)folder/ or
      $access.target.resource.name = /(?i)message/ or
      $access.target.resource.name = /(?i)mailitem/
    )
    not $access.principal.user.userid in %global_allowed_service_accounts
    $access.principal.user.userid = $target_userid

    // Chronological ordering: audit bypass must precede mailbox access
    $audit.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $target_userid over 10m

  outcome:
    $risk_score = max(82)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($target_userid)
    $audit_setting_modified = array_distinct($audit.target.resource.name)
    $audit_actor = array_distinct($audit.principal.user.userid)
    $accessed_resources = array_distinct($access.target.resource.name)
    $access_count = count($access.metadata.event_timestamp.seconds)

  condition:
    $audit and $access
}
