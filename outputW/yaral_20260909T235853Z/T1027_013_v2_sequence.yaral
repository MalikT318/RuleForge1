/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:58:35.857306+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Encoded_File_Written_Then_Decoded_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage obfuscated payload pattern on Linux: a file is written to a suspicious staging directory (e.g. /tmp, /dev/shm, /var/tmp) and shortly afterward a decoding or decryption process reads or operates on that same path. This sequence is characteristic of T1027.013 where an encoded payload is dropped and then decoded at runtime, bypassing static signature detection."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM, producing FILE_CREATION and PROCESS_LAUNCH events with principal.hostname, target.file.full_path, and target.process.command_line populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate software installers that unpack to /tmp; container image build steps; backup agents writing compressed archives; developer tooling (ansible, terraform) staging encoded configs."
    tuning_guidance = "Add known-good parent processes to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the staging path regex if /var/tmp generates excessive noise from package managers. Raise the time window if legitimate multi-stage installers exceed 5 minutes."

  events:
    // Stage 1: an encoded or encrypted file is written to a world-writable / volatile staging path
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/)/ nocase
    // Restrict to file extensions commonly used for encoded/encrypted payloads
    $file.target.file.full_path = /\.(b64|enc|dat|bin|blob|gz|xz|zst|bz2|lz4|aes|gpg|pgp|zip|tar)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    // Capture the written file path as the join key
    $file.target.file.full_path = $staged_path

    // Stage 2: a decode/decrypt process launches and references the same staged file path
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    // Match common decode/decrypt binaries on Linux
    $proc.target.process.file.full_path = /\/(base64|openssl|gpg|gpg2|python[23]?|perl|ruby|php|node|bash|sh|dash|zsh|ksh|xxd|dd|tar|gzip|gunzip|xz|unxz|bzip2|bunzip2|zstd|lz4|7z|unzip)$/ nocase
    // The command line must reference the staged file path
    re.regex($proc.target.process.command_line, $staged_path)
    // Decode/decrypt indicators in the command line
    $proc.target.process.command_line = /(\-d\b|--decode|decrypt|deobfuscat|decompress|inflate|extract|unpack|base64|aes|openssl\s+enc)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: file written before decode process launches
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $staged_path, $hostname over 5m

  outcome:
    $risk_score          = max(78)
    $mitre_technique_id  = array_distinct("T1027.013")
    $primary_entity      = array_distinct($hostname)
    $staged_file_paths   = array_distinct($file.target.file.full_path)
    $decode_commands     = array_distinct($proc.target.process.command_line)
    $writing_processes   = array_distinct($file.principal.process.file.full_path)
    $decoding_processes  = array_distinct($proc.target.process.file.full_path)
    $event_count         = count($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
