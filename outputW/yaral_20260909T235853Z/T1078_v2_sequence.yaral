/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:19:37.035993+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_IaaS_Impossible_Travel_Then_Privilege_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user who authenticates successfully from an external IP address and then performs a privilege or permission change within the same hour. This pattern is consistent with valid-account abuse where a compromised identity is used to escalate access or persist in a cloud/IaaS environment. The correlation joins an external login event to a subsequent permission-change event on the same user identity."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires identity provider sign-in logs and directory audit logs normalised to UDM USER_LOGIN and USER_CHANGE_PERMISSIONS events. Both event types must populate principal.user.userid and metadata.event_timestamp."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate administrators travelling or working remotely who also perform routine permission management. Automated provisioning pipelines using service accounts. Break-glass account usage during incidents."
    tuning_guidance = "Add known service and automation accounts to %global_allowed_service_accounts. Add approved administrator accounts to %global_allowed_admin_users. Add known corporate egress IPs to %global_allowed_mgmt_sources to suppress expected remote-admin logins."

  events:
    // Event 1: Successful login from an external (non-RFC1918) IP address
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources
    $auth.principal.user.userid = $userid

    // Event 2: Permission or privilege change by the same user shortly after
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid != ""
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users
    $perm.principal.user.userid = $userid

    // Chronological ordering: login must precede the permission change
    $auth.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $userid over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($userid)
    $login_source_ips = array_distinct($auth.principal.ip)
    $permission_targets = array_distinct($perm.target.user.userid)
    $login_count = count($auth.metadata.event_timestamp.seconds)
    $perm_change_count = count($perm.metadata.event_timestamp.seconds)

  condition:
    $auth and $perm
}
