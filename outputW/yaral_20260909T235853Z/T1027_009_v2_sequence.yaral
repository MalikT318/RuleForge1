/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:55:29.630318+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_EmbeddedPayload_FileWrite_Then_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a suspicious file written to a user-writable or temp directory by a document/script host process, followed by execution of that file within 5 minutes. This pattern is consistent with embedded payload extraction and launch, a core T1027.009 technique where a benign-looking carrier drops and executes a concealed payload."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Requires EDR or Sysmon telemetry providing FILE_CREATION events with principal process path and PROCESS_LAUNCH events with parent process path. Both event types must populate principal.hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that extract and run components, Office add-ins, software update mechanisms, and developer toolchains that compile and execute binaries from temp directories."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Add approved script hosts to %global_allowed_script_hosts. Narrow the file path regex if specific temp subdirectories are noisy."

  events:
    // Event 1: A document/script host drops a file into a user-writable or temp location
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|mspub|onenote|acrord32|wscript|cscript|mshta|wmic|regsvr32|rundll32|msiexec)\.exe$/
    $file.target.file.full_path = /(?i)(\\AppData\\|\\Temp\\|\\ProgramData\\|\\Users\\Public\\).+\.(exe|dll|bat|cmd|ps1|vbs|js|hta|scr|com|pif)$/
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    // Capture the dropped file path to join with the execution event
    re.capture($file.target.file.full_path, "(?i)(.*\\\\[^\\\\]+\\.(?:exe|dll|bat|cmd|ps1|vbs|js|hta|scr|com|pif))$") = $dropped_path

    // Event 2: The dropped file is subsequently executed
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)(\\AppData\\|\\Temp\\|\\ProgramData\\|\\Users\\Public\\).+\.(exe|dll|bat|cmd|ps1|vbs|js|hta|scr|com|pif)$/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname
    re.capture($proc.target.process.file.full_path, "(?i)(.*\\\\[^\\\\]+\\.(?:exe|dll|bat|cmd|ps1|vbs|js|hta|scr|com|pif))$") = $dropped_path

    // Enforce chronological ordering: file written before execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $dropped_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity = array_distinct($hostname)
    $carrier_process = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($file.target.file.full_path)
    $executing_process = array_distinct($proc.target.process.file.full_path)
    $execution_parent = array_distinct($proc.principal.process.file.full_path)

  condition:
    $file and $proc
}
