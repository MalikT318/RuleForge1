/*
  MITRE Technique : T1669 - Wi-Fi Networks
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:28:05.853373+00:00
  Reference       : https://attack.mitre.org/techniques/T1669
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1669_WiFi_Unauthorized_Association_Attempt {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects repeated or anomalous wireless association attempts observed by IDS/IPS telemetry, indicative of an adversary attempting to connect to a Wi-Fi network for initial access. This includes patterns consistent with credential stuffing against WPA-Enterprise, rogue client associations, and repeated authentication failures against wireless infrastructure. Targets the nearest-neighbor attack vector where a dual-homed system bridges wired and wireless segments."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1669"
    mitre_technique_name = "Wi-Fi Networks"
    log_prerequisites = "Requires IDS/IPS or wireless intrusion prevention system (WIPS) logs normalised into Chronicle UDM. Wireless controller or access point syslog forwarded through a network security appliance is sufficient. NETWORK_CONNECTION or NETWORK_FLOW events with security alert annotations are expected."
    platform = "Linux"
    log_source = "ips"
    false_positives = "Legitimate roaming clients reconnecting after signal loss, corporate devices cycling through access points during mobility, network scanning tools run by authorised security teams, captive portal probes from guest devices."
    tuning_guidance = "Add known-good internal wireless management subnets to %rfc1918_internal exclusions. Add authorised scanner source addresses to %global_allowed_scanners. Add approved wireless management principals to %global_allowed_admin_users. Raise the threshold or narrow the target port range if guest Wi-Fi generates excessive volume."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Alert or detection verdict from the IDS/IPS - look for wireless-related
    // security result categories. Vendor UDM mapping varies, so we anchor on
    // the category_details and summary fields which are more consistently
    // populated than security_result.action alone.
    (
      $net.security_result.category_details = /(?i)(wireless|wifi|wi-fi|wlan|802\.11|eap|wpa|dot11|association|deauth|disassoc|pmkid|handshake|beacon|probe.request)/ or
      $net.security_result.summary = /(?i)(wireless|wifi|wi-fi|wlan|802\.11|eap|wpa|dot11|association|deauth|disassoc|pmkid|handshake|beacon|probe.request)/
    )

    // Exclude traffic originating from known authorised internal management
    // sources such as wireless controllers and WIPS sensors.
    not $net.principal.ip in %rfc1918_internal

    // Exclude authorised security scanners performing wireless assessments.
    not $net.principal.hostname in %global_allowed_scanners

    // Exclude approved remote management sources.
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1669")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ip = array_distinct($net.principal.ip)
    $alert_summary = array_distinct($net.security_result.summary)
    $alert_category = array_distinct($net.security_result.category_details)

  condition:
    $net
}
