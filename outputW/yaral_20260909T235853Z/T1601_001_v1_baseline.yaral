/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:18:09.260973+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Network_Device_Image_Transfer_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects external network connections to network device management interfaces using file transfer protocols commonly used for firmware/OS image uploads (TFTP, FTP, SCP). Adversaries patch network device system images by transferring modified firmware files."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Requires firewall or perimeter network logs with destination port and IP visibility."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate firmware updates from approved vendor repositories, authorized network device maintenance windows, automated backup and configuration management systems."
    tuning_guidance = "Add approved firmware distribution sources to %global_allowed_mgmt_sources. Correlate with change management tickets during maintenance windows."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 69 or
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 115
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = /^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)/ nocase

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($net.principal.ip)
    $external_destinations = array_distinct($net.target.ip)
    $transfer_ports = array_distinct($net.target.port)

  condition:
    $net
}
