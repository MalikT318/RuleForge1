/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:14:26.264660+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSASS_Driver_File_Then_Registry_Correlation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage LSASS driver persistence attempt: a DLL or SYS file is written to a system directory, followed within 10 minutes by a registry modification to the LSA Security Packages or Authentication Packages keys on the same host. This combination strongly indicates an adversary registering a malicious LSASS driver for persistence or credential access."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (FILE_CREATION) and registry-modification telemetry (REGISTRY_MODIFICATION) normalised to UDM. Both event types must be present for the same host."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security software (AV, EDR agents) installing LSA plugins; Microsoft patches updating authentication DLLs; third-party MFA or smart-card middleware registering SSP/AP packages."
    tuning_guidance = "Add known-good parent processes or file paths to %global_allowed_security_tools. Add authorised service accounts performing these writes to %global_allowed_service_accounts. Scope the registry key regex more tightly if specific packages are known-good in your environment."

  events:
    // Stage 1: A DLL or SYS file is written to a Windows system path
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\(system32|syswow64|windows\\system)\\[^\\]+\.(dll|sys)$/
    not $file.target.file.full_path = /(?i)\\(system32|syswow64)\\(wbem|catroot|driverstore|spool)\\/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Stage 2: Registry modification to LSA Security Packages or Authentication Packages
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)HKLM\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Control\\Lsa/
    $reg.target.registry.registry_value_name = /(?i)^(Security Packages|Authentication Packages|Notification Packages)$/
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Chronological ordering: file write must precede registry modification
    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($hostname)
    $written_file_paths = array_distinct($file.target.file.full_path)
    $modified_registry_keys = array_distinct($reg.target.registry.registry_key)
    $modified_registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $registry_process = array_distinct($reg.principal.process.file.full_path)
    $actor_userid = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
