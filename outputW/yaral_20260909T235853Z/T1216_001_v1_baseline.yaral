/*
  MITRE Technique : T1216.001 - PubPrn
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:50:17.463476+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_001_PubPrn_Script_Proxy_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects abuse of PubPrn.vbs to proxy execution of remote scriptlets via the script: moniker. Adversaries invoke cscript.exe with PubPrn.vbs and a second parameter referencing a remote .sct file over HTTP/HTTPS, bypassing application control and script signing restrictions."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1216.001"
    mitre_technique_name = "System Script Proxy Execution: PubPrn"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate use of PubPrn.vbs with LDAP:// parameter for printer publishing in AD environments. Legitimate invocations will not contain the script: moniker or remote HTTP references."
    tuning_guidance = "This rule targets the script: moniker specifically, which has no legitimate use in modern Windows 10+ environments. On legacy systems, verify the second parameter is not LDAP://. Add known administrative hosts to %global_allowed_admin_tools if needed, though the script: moniker should never appear in legitimate usage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)\\cscript\.exe$/
    $proc.target.process.command_line = /(?i)pubprn(\.vbs)?/
    $proc.target.process.command_line = /(?i)script:/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
