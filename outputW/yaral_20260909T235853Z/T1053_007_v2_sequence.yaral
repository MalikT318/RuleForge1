/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:08:38.175262+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_K8s_CronJob_Created_Then_Pod_Launched {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Kubernetes CronJob or Job resource creation followed by a container process launch within the same namespace/cluster context. Adversaries abuse CronJob scheduling to persist malicious workloads across cluster nodes. This correlation rule provides additive coverage beyond command-line inspection by joining the control-plane API creation event to the resulting in-container execution event."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes API server audit logs (RESOURCE_CREATION for CronJob/Job objects) and container runtime process telemetry (PROCESS_LAUNCH from within pods). Both must be normalised into Chronicle UDM."
    platform = "Containers"
    log_source = "container"
    false_positives = "Legitimate CI/CD pipelines that create CronJobs for batch processing, scheduled backup jobs, cluster maintenance automation, and monitoring agents that spawn periodic tasks."
    tuning_guidance = "Add known CI/CD service accounts to %global_allowed_service_accounts. Add approved orchestration principals to %global_allowed_cloud_principals. Narrow the process filter in the second event to known-bad interpreter patterns if false-positive volume is high."

  events:
    // Event 1: Kubernetes API server records creation of a CronJob or Job resource
    $api.metadata.event_type = "RESOURCE_CREATION"
    $api.target.resource.type = /(?i)(cronjob|job)/
    not $api.principal.user.userid in %global_allowed_service_accounts
    not $api.principal.user.userid in %global_allowed_cloud_principals
    $api.principal.user.userid = $k8s_user

    // Event 2: A container process launches - likely the scheduled workload executing
    // Exclude known-good orchestration and security tooling to suppress noise
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    // Target interpreters and shells that adversaries embed in malicious Job specs
    $proc.target.process.file.full_path = /(?i)\/(sh|bash|ash|dash|python[23]?|perl|ruby|node|curl|wget)$/
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    $proc.principal.hostname = $container_node

    // Chronological ordering: resource creation must precede the process launch
    $api.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $k8s_user, $container_node over 1h

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $created_resource_types = array_distinct($api.target.resource.type)
    $scheduling_principals = array_distinct($api.principal.user.userid)
    $launched_processes = array_distinct($proc.target.process.file.full_path)
    $affected_nodes = array_distinct($proc.principal.hostname)

  condition:
    $api and $proc
}
