/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:46:22.561444+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications to Windows Firewall policy keys that control firewall state, profile enablement, or rule configurations. Attackers modify these keys to disable firewall profiles or add permissive rules without invoking command-line utilities, evading process-creation detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Windows Host Firewall"
    log_prerequisites = "Requires EDR or Sysmon registry event telemetry (e.g., Sysmon Event ID 13/14, CrowdStrike registry write events) normalised to UDM REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy application (SYSTEM context from svchost/lsass applying GPO), Windows Security Center service, authorised endpoint management agents (SCCM, Intune MDM), and firewall management software."
    tuning_guidance = "Add known management service accounts to %global_allowed_service_accounts and approved management tooling paths to %global_allowed_admin_tools. Consider scoping to non-SYSTEM users if GPO noise is high. Narrow on specific value names (EnableFirewall, DefaultInboundAction) if broad key coverage is too noisy."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the canonical Windows Firewall policy registry paths:
    // - SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy covers
    //   DomainProfile, StandardProfile (private), and PublicProfile sub-keys.
    // - SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\FirewallRules
    //   covers individual rule entries added or modified directly in the registry.
    // - SOFTWARE\Policies\Microsoft\WindowsFirewall covers GPO-applied firewall policy
    //   which attackers can write to locally to override settings.
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy\\/

    // Focus on high-value value names that directly control firewall state or rules.
    // EnableFirewall = 0 disables a profile; DefaultInboundAction = 1 blocks all inbound;
    // FirewallRules sub-key entries define individual allow/block rules.
    (
      $reg.target.registry.registry_value_name = /(?i)^EnableFirewall$/ or
      $reg.target.registry.registry_value_name = /(?i)^DefaultInboundAction$/ or
      $reg.target.registry.registry_value_name = /(?i)^DefaultOutboundAction$/ or
      $reg.target.registry.registry_value_name = /(?i)^DoNotAllowExceptions$/ or
      $reg.target.registry.registry_key = /(?i)\\FirewallRules\\/
    )

    // Exclude known-good service accounts performing legitimate management
    not $reg.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good administrative and management tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude the Windows Security Center / firewall service itself writing its own keys
    // (mpssvc is the Windows Firewall service; BFE is Base Filtering Engine)
    not $reg.principal.process.file.full_path = /(?i)\\(svchost|MpsSvc|BFE)\.exe$/

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_registry_key = array_distinct($reg.target.registry.registry_key)
    $affected_value_name = array_distinct($reg.target.registry.registry_value_name)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
