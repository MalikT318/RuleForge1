/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:11:18.387218+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_TimeProvider_Registry_Then_DLL_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage Time Provider persistence technique: a new subkey is written under the W32Time TimeProviders registry path (DllName value), followed by a DLL file creation on the same host within 10 minutes. This combination indicates an adversary registering a malicious time provider DLL for execution at boot under the Local Service account."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires EDR or Sysmon registry modification events (Event ID 13) and file creation events (Event ID 11) normalised to UDM REGISTRY_MODIFICATION and FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate NTP client software or Windows updates that register a new time provider DLL. Third-party time synchronisation products (e.g., enterprise NTP appliance agents) may write to this key during installation."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Scope the DLL path filter more tightly if your environment always installs time providers to a fixed directory such as System32."

  events:
    // Stage 1: Registry modification registering a DllName value under the W32Time TimeProviders key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\System\\CurrentControlSet\\Services\\W32Time\\TimeProviders\\/  nocase
    $reg.target.registry.registry_value_name = /DllName/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    // Stage 2: A DLL file is created on the same host shortly after
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\.dll$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: registry write precedes file drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys_modified = array_distinct($reg.target.registry.registry_key)
    $dll_paths_created = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($reg.principal.process.file.full_path)
    $file_drop_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
