/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:51:49.204256+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_Suspicious_Binary_Modification_In_Staging_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file modification events targeting executable or shared-library artifacts in world-writable or staging directories commonly used to stage and re-pack binaries after indicator stripping. Attackers who discover their tool was detected will modify the binary on-disk (strip symbols, patch bytes, repack) rather than re-download, producing a FILE_MODIFICATION event at the artifact layer rather than a detectable command line."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires Linux EDR or auditd FILE_MODIFICATION telemetry with target.file.full_path populated. Auditd rule: -w /tmp -p wa -k staging_write and equivalent for /dev/shm, /var/tmp."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers updating shared libraries in /tmp during install; legitimate build pipelines writing compiled artifacts to /tmp or /var/tmp; container image build steps; developer workstations compiling and staging binaries locally."
    tuning_guidance = "Add known CI/CD service account names to %global_allowed_service_accounts and known build-system parent process paths to %global_allowed_admin_tools. Narrow the path regex if your environment never stages ELF binaries in /dev/shm."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target must be an ELF binary, shared object, or archive in a
    // world-writable / staging location - the artifact layer indicator
    // that a tool has been re-packed or patched in place.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/run\/user\/[0-9]+\/)/ nocase
    $file.target.file.full_path = /\.(elf|so(\.[0-9]+)*|a|bin|out|run|sh|py|pl|rb)$/ nocase

    // Exclude known-good backup and security tooling that legitimately
    // writes into staging paths.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude service accounts expected to perform automated deployments.
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude root-owned package-manager processes that legitimately
    // unpack into temp paths (dpkg, rpm, yum, apt helpers).
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|yum|apt|dnf|zypper|pacman)(\/|$)/ nocase

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file_path = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
