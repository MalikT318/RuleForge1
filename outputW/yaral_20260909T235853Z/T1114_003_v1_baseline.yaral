/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:35:50.906581+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_Email_Forwarding_Rule_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of email forwarding rules that redirect messages to external recipients, a common persistence and data exfiltration technique."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace unified audit logs with mailbox rule creation events."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate auto-forwarding for shared mailboxes, executive assistants managing executive inboxes, approved business process automation, vacation auto-responders with forwarding."
    tuning_guidance = "Add service accounts and approved automation principals to %global_allowed_service_accounts. Exclude known shared mailbox configurations."

  events:
    $rule.metadata.event_type = "SETTING_CREATION"
    (
      $rule.target.resource.attribute.labels["operation"] = /New-InboxRule/ nocase or
      $rule.target.resource.attribute.labels["operation"] = /Set-InboxRule/ nocase or
      $rule.target.resource.attribute.labels["operation"] = /UpdateInboxRules/ nocase or
      $rule.target.resource.attribute.labels["workload"] = /Exchange/ nocase
    )
    (
      $rule.target.resource.attribute.labels["parameters"] = /ForwardTo/ nocase or
      $rule.target.resource.attribute.labels["parameters"] = /ForwardAsAttachmentTo/ nocase or
      $rule.target.resource.attribute.labels["parameters"] = /RedirectTo/ nocase
    )
    not $rule.principal.user.userid in %global_allowed_service_accounts
    not $rule.principal.user.userid = /svc-|service-|automation-/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($rule.principal.user.userid)

  condition:
    $rule
}
