/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:40:18.383438+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_Domain_Account_Creation_Network_Observable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable domain account creation activity via firewall/perimeter logs. Adversaries may create domain accounts over LDAP (389/636) or Kerberos (88) from unexpected internal sources to establish persistent credentialed access. Flags connections from non-management sources to domain controller ports associated with account provisioning protocols."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Requires firewall or network perimeter flow logs with source/destination IP and port visibility. LDAP (TCP 389), LDAPS (TCP 636), and Kerberos (TCP/UDP 88) traffic must be logged."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate domain join operations, authorized identity management systems, directory synchronization tools, LDAP-integrated applications performing account provisioning, vulnerability scanners."
    tuning_guidance = "Add authorized identity management and directory service source IPs to %global_allowed_mgmt_sources. Add known scanner sources to %global_allowed_scanners. Narrow the rule by restricting to known DC IP ranges if those are stable in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target domain controller ports: LDAP, LDAPS, Kerberos (TCP and UDP both surface as NETWORK_CONNECTION)
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 88
    )

    // Source must be internal (RFC1918) - external-to-DC traffic is a separate concern
    $net.principal.ip in %rfc1918_internal

    // Destination must also be internal - DC-to-DC or client-to-DC
    $net.target.ip in %rfc1918_internal

    // Exclude authorized management and directory service sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude known scanner sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
