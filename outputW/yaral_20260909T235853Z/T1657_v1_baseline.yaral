/*
  MITRE Technique : T1657 - Financial Theft
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:26:06.038595+00:00
  Reference       : https://attack.mitre.org/techniques/T1657
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1657_001_BEC_Suspicious_Mailbox_Rule_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of mailbox inbox rules that forward, redirect, or delete messages - a primary Business Email Compromise (BEC) technique used to intercept financial communications, hide fraud activity, and facilitate unauthorized fund transfers. Adversaries establish these rules after compromising an account to silently exfiltrate email or suppress security alerts while conducting financial theft."
    mitre_tactic = "Impact"
    mitre_technique = "T1657"
    mitre_technique_name = "Financial Theft"
    log_prerequisites = "Requires Microsoft 365 unified audit logs with Exchange mailbox auditing enabled. Operations: New-InboxRule, Set-InboxRule, UpdateInboxRules."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate user-created inbox rules for email organisation, approved IT-managed mail flow rules, CRM or helpdesk integrations that auto-route email."
    tuning_guidance = "Add known service accounts that legitimately manage inbox rules to %global_allowed_service_accounts. Add approved automation principals to %global_allowed_cloud_principals. Consider scoping to rules that combine forwarding AND deletion actions for higher fidelity."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Match inbox rule creation or modification operations (normalised from New-InboxRule, Set-InboxRule, UpdateInboxRules)
    $cloud.metadata.product_event_type = /(?i)(new-inboxrule|set-inboxrule|updateinboxrules|new-transportrule|set-transportrule)/

    // Rule must involve a forwarding, redirection, or deletion action - the hallmarks of BEC mail manipulation
    (
      $cloud.target.resource.attribute.labels.key = "ForwardTo" or
      $cloud.target.resource.attribute.labels.key = "ForwardAsAttachmentTo" or
      $cloud.target.resource.attribute.labels.key = "RedirectTo" or
      $cloud.target.resource.attribute.labels.key = "DeleteMessage" or
      $cloud.target.resource.attribute.labels.key = "MoveToFolder" or
      $cloud.security_result.description = /(?i)(forwardto|redirectto|forwardasattachmentto|deletemessage)/
    )

    // Exclude known legitimate service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1657")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $operation_performed = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
