/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:19:46.919244+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_001_IaaS_System_Info_Discovery_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects authenticated cloud API calls that enumerate instance or virtual machine metadata, system configuration, and platform details. Adversaries performing IaaS-based system information discovery invoke describe/get/list APIs against compute resources to gather OS version, hardware, patch level, and architecture details before follow-on actions. This rule fires on the resulting audit log entry rather than any command-line invocation, providing coverage that is resilient to process-logging evasion."
    mitre_tactic = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). USER_RESOURCE_ACCESS events must be ingested with target.resource.name and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate infrastructure automation, configuration management tools (Ansible, Terraform, Chef), monitoring agents, and cloud-native health checks routinely call these APIs. Security scanners and compliance tooling also enumerate instance metadata at scale."
    tuning_guidance = "Add authorised automation service principals to %global_allowed_cloud_principals. Add approved scanner source identities to %global_allowed_scanners. Raise severity if the calling principal has never previously accessed compute describe APIs (requires baselining via a separate threshold rule). Consider suppressing events where the principal matches %global_allowed_service_accounts."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match API method names that enumerate instance/VM system information.
    // Covers AWS DescribeInstances/DescribeInstanceAttribute/GetConsoleOutput,
    // Azure VirtualMachines/read and similar, GCP compute.instances.get/list.
    // Pattern is intentionally broad at the verb level so renamed or future
    // API variants are captured without hardcoding vendor-specific strings.
    $cloud.target.resource.name = /(?i)(describe.?instance|get.?instance|list.?instance|describe.?image|describe.?platform|describe.?host|get.?console|virtual.?machine.*read|compute\.instance|instance.*metadata|describe.?attribute|get.?system.?info|describe.?snapshot|describe.?volume|describe.?region|list.?location|get.?sku|describe.?availability)/

    // Require a resolved principal identity - anonymous or unauthenticated
    // calls are handled by separate authentication anomaly rules.
    $cloud.principal.user.userid != ""

    // Exclude known-good automation and cloud service principals.
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
