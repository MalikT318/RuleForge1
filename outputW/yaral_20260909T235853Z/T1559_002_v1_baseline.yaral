/*
  MITRE Technique : T1559.002 - Dynamic Data Exchange
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:09:29.547180+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_002_DDE_Office_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Microsoft Office applications spawning shell interpreters or scripting hosts, a primary indicator of DDE (Dynamic Data Exchange) abuse. DDE allows Office documents to execute arbitrary commands via inter-process communication without VBA macros, making it a common phishing payload delivery mechanism."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.002"
    mitre_technique_name = "Inter-Process Communication: Dynamic Data Exchange"
    log_prerequisites = "Requires EDR process telemetry with parent-child process lineage (Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, or equivalent). Parent and child process full paths must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or plugins that legitimately invoke shell processes; mail merge workflows; developer environments with Office automation scripts; some PDF-to-Office conversion tools."
    tuning_guidance = "Add known-good Office automation parent processes or specific child process paths to %global_allowed_admin_tools. If specific service accounts drive Office automation pipelines, add them to %global_allowed_service_accounts. Narrow scope by requiring additional command-line indicators if false-positive rate is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Office application acting as parent - DDE executes in the context of the document host
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|msaccess|outlook|onenote|mspub)\.exe$/ nocase

    // Child process is a shell interpreter, scripting host, or download utility
    // DDE payloads typically chain through these to execute further stages
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic|msiexec|conhost)\.exe$/ nocase

    // Exclude known-good administrative tooling and service accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1559.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $username = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
