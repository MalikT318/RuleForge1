/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:59:03.274313+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_Reflection_Amplification_Outbound_Spoofed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential reflection amplification attack traffic characterized by high-volume outbound responses to spoofed source addresses on amplifiable protocols (DNS, NTP, SNMP, memcached, SSDP)."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Requires firewall or network flow logs with source/destination IP, port, protocol, and byte counts."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate high-volume DNS servers, public NTP servers, SNMP monitoring infrastructure, CDN edge nodes."
    tuning_guidance = "Add authorized public-facing service IPs to %global_allowed_scanners. Adjust byte threshold based on baseline traffic patterns."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    (
      $net.target.port = 53 or
      $net.target.port = 123 or
      $net.target.port = 161 or
      $net.target.port = 11211 or
      $net.target.port = 1900 or
      $net.target.port = 389 or
      $net.target.port = 19
    )
    $net.network.sent_bytes > 10000
    $net.network.sent_bytes > $net.network.received_bytes * 5
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
