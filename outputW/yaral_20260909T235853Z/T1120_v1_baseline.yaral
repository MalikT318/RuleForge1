/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:36:26.637765+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_001_Peripheral_Device_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects peripheral device discovery activity on Windows via common enumeration utilities and PowerShell WMI queries targeting device classes such as USB controllers, printers, cameras, and smart card readers. Adversaries use these techniques to profile attached hardware before lateral movement or data exfiltration."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (Process Create) with full command-line logging enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "IT asset inventory tools, hardware auditing scripts, helpdesk remote support sessions, driver installation utilities, and endpoint management agents (RMM, SCCM, Intune) that enumerate device classes during normal operations."
    tuning_guidance = "Add known asset-management or RMM parent process paths to %global_allowed_admin_tools. Add authorised service accounts that run scheduled hardware audits to %global_allowed_service_accounts. Consider narrowing the rule to alert only when the parent process is an Office application, script interpreter, or browser to reduce noise from administrative tooling."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the broad set of binaries and command patterns used for peripheral enumeration.
    // Each branch targets a distinct OS mechanism so renaming a single tool does not evade detection.
    (
      // wmic querying device classes associated with peripherals
      (
        $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /(?i)(usb|printer|camera|smartcard|keyboard|mouse|removable|diskdrive|cdrom|imagedevice|win32_pnpentity|win32_usbcontroller|win32_usbhub|win32_printer|win32_pointingdevice|win32_keyboard)/ nocase
        )
      )
      or
      // PowerShell WMI or CIM queries for device/PnP classes
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /(?i)(Get-WmiObject|Get-CimInstance|gwmi)\s.*(Win32_PnPEntity|Win32_USBController|Win32_USBHub|Win32_Printer|Win32_PointingDevice|Win32_Keyboard|Win32_DiskDrive|Win32_CDROMDrive)/
          or
          $proc.target.process.command_line = /(?i)(Get-PnpDevice|Get-Disk|Get-Volume)\b/
        )
      )
      or
      // devcon.exe - Windows Device Console used to list/query devices
      (
        $proc.target.process.file.full_path = /\\devcon\.exe$/ nocase
        and $proc.target.process.command_line = /(?i)(find|findall|listclass|status|hwids|stack)\b/
      )
      or
      // pnputil.exe - built-in PnP utility that can enumerate drivers and devices
      (
        $proc.target.process.file.full_path = /\\pnputil\.exe$/ nocase
        and $proc.target.process.command_line = /(?i)(\/enum-devices|\/enum-drivers|-e\b)/
      )
      or
      // fsutil querying volume/drive information as a proxy for removable media discovery
      (
        $proc.target.process.file.full_path = /\\fsutil\.exe$/ nocase
        and $proc.target.process.command_line = /(?i)(fsinfo\s+drives|volume\s+list|driveType)/
      )
    )

    // Exclude known-good administrative tooling parent processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service accounts performing scheduled hardware audits
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
