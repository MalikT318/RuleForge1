/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:23:02.483584+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_Linux_Credential_File_Read_Then_Exfil_Stage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage credential dumping pattern on Linux: a process reads a sensitive credential file (/etc/shadow, /etc/passwd, or similar) followed within 10 minutes by creation of a file in a world-writable staging directory (/tmp, /dev/shm, /var/tmp). This sequence indicates an adversary reading credential material and staging it for exfiltration, distinct from simple command-line invocation of known dump tools."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. Auditd rules must include -w /etc/shadow -p r and -w /etc/gshadow -p r to capture FILE_READ events. EDR must emit FILE_CREATION events for /tmp, /dev/shm, and /var/tmp."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup agents reading /etc/shadow for system snapshots, configuration management tools (Ansible, Puppet, Chef) auditing credential files, authorised security scanners, shadow-utils during password changes."
    tuning_guidance = "Add backup and configuration management process paths to %global_allowed_backup_processes and %global_allowed_security_tools. Add authorised scanner source hosts to %global_allowed_scanners. Scope the staging-directory pattern more narrowly if /tmp file creation volume is high in the environment."

  events:
    // Event 1: A process reads a sensitive credential or authentication file
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /^\/etc\/(shadow|gshadow|passwd|master\.passwd|security\/passwd)$/
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.user.userid in %global_allowed_service_accounts
    $read.principal.hostname = $hostname

    // Event 2: Within the same window, a file is created in a world-writable staging area
    $stage.metadata.event_type = "FILE_CREATION"
    $stage.target.file.full_path = /^\/(?:tmp|dev\/shm|var\/tmp|run\/shm)\//
    not $stage.principal.process.file.full_path in %global_allowed_backup_processes
    not $stage.principal.user.userid in %global_allowed_service_accounts
    $stage.principal.hostname = $hostname

    // Chronological ordering: credential read must precede staging
    $read.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($read.principal.hostname)
    $credential_files_read = array_distinct($read.target.file.full_path)
    $staging_files_created = array_distinct($stage.target.file.full_path)
    $reading_processes = array_distinct($read.principal.process.file.full_path)
    $staging_processes = array_distinct($stage.principal.process.file.full_path)
    $actor_userids = array_distinct($read.principal.user.userid)

  condition:
    $read and $stage
}
