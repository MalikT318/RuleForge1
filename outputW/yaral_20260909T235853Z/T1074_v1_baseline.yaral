/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:32:23.245520+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_Data_Staged_Bulk_Copy_To_Staging_Dir {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects processes copying or moving files into common staging directories used by adversaries prior to exfiltration. Adversaries stage collected data in a central location (e.g. Temp, ProgramData, a user-created archive folder) before exfiltrating. This rule targets the process-launch signal of bulk copy/move commands directed at non-standard staging paths."
    mitre_tactic    = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Backup agents, software deployment tools, IT admin scripts performing legitimate bulk copies, developer build pipelines staging artifacts."
    tuning_guidance = "Add known backup or deployment parent process paths to %global_allowed_backup_processes. Add authorised admin accounts to %global_allowed_admin_users. Narrow the staging path regex to directories not used by approved tooling in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target a native Windows copy/move utility or shell interpreter performing bulk data movement
    $proc.target.process.file.full_path = /\\(cmd\.exe|powershell\.exe|pwsh\.exe|robocopy\.exe|xcopy\.exe|copy\.exe|move\.exe|expand\.exe)$/ nocase

    // Command line must reference a staging-indicative destination path pattern:
    // %TEMP%, %TMP%, ProgramData, AppData, a root-level folder, or a hidden/dot folder
    $proc.target.process.command_line = /(?i)(\\temp\\|\\tmp\\|\\programdata\\|\\appdata\\local\\temp\\|\\appdata\\roaming\\|[a-z]:\\[^\\]{1,20}\\(data|dump|stage|collect|exfil|archive|backup|out|loot|drop|gather|pkg|package|upload|transfer|files|docs|documents|work)\b)/ nocase

    // Command line must contain a copy/move verb or robocopy-style invocation
    $proc.target.process.command_line = /(?i)(copy\s|xcopy\s|robocopy\s|move\s|cp\s|mv\s|-recurse|-r\s|\/s\s|\/e\s|Copy-Item|Move-Item|Get-ChildItem.*\|\s*Copy|compress-archive)/ nocase

    // Exclude known-good backup and admin tooling parents
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing scheduled data movement
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good admin users
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score        = max(60)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity    = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
