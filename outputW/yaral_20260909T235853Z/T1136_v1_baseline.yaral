/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:40:04.047674+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_ESXi_User_Account_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of new user accounts on ESXi hosts via cloud control plane API calls, indicating potential persistence establishment."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136"
    mitre_technique_name = "Create Account"
    log_prerequisites = "Requires cloud provider audit logs (CloudTrail, Azure Activity, GCP Audit) with ESXi resource management events."
    platform = "ESXi"
    log_source = "cloud_audit"
    false_positives = "Legitimate administrator provisioning, automated infrastructure-as-code deployments, orchestration platforms creating service accounts, backup and DR automation."
    tuning_guidance = "Add authorized automation service principals to %global_allowed_cloud_principals and approved administrator accounts to %global_allowed_admin_users."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.target.resource.name = /user|account/ nocase
    $cloud.target.resource.product_object_id = /esxi|vsphere|vcenter/ nocase
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1136")
    $primary_entity = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
