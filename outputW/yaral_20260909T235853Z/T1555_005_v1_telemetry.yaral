/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:31:55.214656+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Password_Manager_DB_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file read or copy access to password manager database files on Linux (e.g., KeePass .kdbx, pass store, Bitwarden vault, 1Password .agilekeychain/.opvault). Adversaries targeting password managers frequently stage or exfiltrate the encrypted database file as a precursor to offline cracking or memory extraction. This rule fires on FILE_CREATION or FILE_MODIFICATION events where a known password manager database extension or path pattern appears as the target, covering copy-out and staging scenarios that evade process-launch detection."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires Linux EDR or auditd file-access telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate backup agents copying password manager databases, user-initiated exports, synchronisation daemons (Dropbox, Nextcloud, Syncthing) syncing vault files, automated backup scripts."
    tuning_guidance = "Add known backup process paths to %global_allowed_backup_processes. Add sync daemon process paths to %global_allowed_admin_tools. Scope by principal.user.userid to exclude service accounts listed in %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a password manager database file or vault directory
    // Covers: KeePass (.kdbx), pass (~/.password-store), Bitwarden (data.json vault),
    // 1Password (.agilekeychain, .opvault), LastPass (lastpass_db), Enpass (.enpassdb),
    // KWallet (.kwl), GNOME Keyring (.keystore), dashlane vault files
    $file.target.file.full_path = /\.(kdbx|kdbx\.lock|kdb|agilekeychain|opvault|enpassdb|kwl|keystore)$/ nocase

    // Exclude the owning user's own home directory writes (normal save-on-unlock)
    // by requiring the destination to be outside the standard home path
    // OR flag writes to /tmp, /dev/shm, /var, /run (staging indicators)
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/|\/run\/|\/proc\/)/ nocase

    // Exclude known backup and security tooling
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $target_file = array_distinct($file.target.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
