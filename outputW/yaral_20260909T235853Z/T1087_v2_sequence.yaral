/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:20:44.966949+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_ESXi_Login_Then_Account_Enum {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive or SSH login to an ESXi host followed by rapid enumeration of local accounts or roles via shell built-ins (e.g., cat /etc/passwd, esxcli system account list, vim-cmd). This correlation provides additive coverage beyond process command-line rules by anchoring discovery activity to a preceding authentication event, reducing false positives from scheduled automation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Requires ESXi hostd/shell authentication events normalised to USER_LOGIN and ESXi shell process telemetry normalised to PROCESS_LAUNCH. Both event types must share principal.hostname."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised ESXi administrators performing routine health checks, monitoring agents running scheduled account audits, VMware vCenter orchestration tasks."
    tuning_guidance = "Add known administrative service accounts to %global_allowed_service_accounts. Add approved management hosts to %global_allowed_mgmt_sources. Raise the threshold or narrow the match window if the environment has frequent legitimate admin logins."

  events:
    // Event 1: Interactive or SSH login to the ESXi host
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $esxi_host
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Event 2: Account/role enumeration process launched on the same host
    // Targets shell built-ins and ESXi-native tools used to list accounts,
    // roles, or permissions - not a simple command-line string match but
    // anchored to the authenticated session on the same host.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $esxi_host
    (
      $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(cat|grep|awk|esxcli|vim-cmd|localcli)$/ nocase
      or
      $proc.target.process.command_line = /\/etc\/(passwd|shadow|group)/ nocase
      or
      $proc.target.process.command_line = /system\s+account\s+list/ nocase
      or
      $proc.target.process.command_line = /system\s+permission\s+list/ nocase
      or
      $proc.target.process.command_line = /userworld\s+list/ nocase
    )
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: login must precede enumeration
    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $esxi_host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($auth.principal.hostname)
    $authenticated_user = array_distinct($auth.principal.user.userid)
    $enumeration_commands = array_distinct($proc.target.process.command_line)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth and $proc
}
