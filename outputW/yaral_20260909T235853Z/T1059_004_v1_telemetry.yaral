/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:12:46.527970+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_ESXi_Shell_Script_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of shell script files in sensitive ESXi filesystem locations. Adversaries abusing Unix shell on ESXi frequently drop shell scripts to /tmp, /scratch, /vmfs/volumes, or the ESXi shell configuration directories to achieve execution or persistence. This rule targets the file artifact produced by the attack rather than the command line used to create it, providing a complementary detection layer to process-creation rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires ESXi file activity telemetry normalised into Chronicle UDM FILE_CREATION or FILE_MODIFICATION events. Typically sourced from hostd, ESXi shell audit logs, or an EDR/XDR agent deployed on the hypervisor."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate VMware patch bundles writing scripts to /tmp or /scratch during installation; authorised vSphere lifecycle manager operations; backup agents staging scripts under /vmfs/volumes; vendor-supplied health-check scripts run by support personnel."
    tuning_guidance = "Add known-good parent process paths (e.g. esxcli, vmware-fdm) to %global_allowed_admin_tools. Add authorised service accounts that perform scripted maintenance to %global_allowed_service_accounts. Narrow the path regex if a specific datastore or volume is generating noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target sensitive ESXi filesystem locations where adversaries stage scripts
    $file.target.file.full_path = /^(\/tmp\/|\/scratch\/|\/vmfs\/volumes\/|\/etc\/rc\.local\.d\/|\/etc\/init\.d\/|\/store\/|\/bootbank\/|\/altbootbank\/)/ nocase

    // Match shell script extensions or common script naming patterns on ESXi
    // Covers .sh, .ash, .bash, extensionless files with shell-like names, and busybox wrappers
    $file.target.file.full_path = /(\.sh|\.ash|\.bash|\.zsh|\.ksh|busybox)$/ nocase

    // Exclude known-good administrative tooling by parent process
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing scripted maintenance
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good backup processes that may stage scripts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_script_path = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
