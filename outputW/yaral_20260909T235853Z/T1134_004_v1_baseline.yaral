/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:39:27.548266+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_PPID_Spoofing_Suspicious_Parent_Child {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects likely Parent PID (PPID) spoofing by identifying high-risk child processes (shells, script interpreters, injection-capable binaries) whose recorded parent process is an implausible or high-value spoofing target (e.g. explorer.exe, svchost.exe, lsass.exe, winlogon.exe) but whose grandparent lineage is absent or inconsistent with normal Windows behaviour. The core OS mechanism abused is CreateProcess with an explicit PROCESS_INFORMATION structure that overrides the true calling process, causing EDR/Sysmon to record a fabricated parent. Detection focuses on the resulting anomalous parent-child pair rather than any specific tool name."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry that populates both principal.process (parent) and target.process (child) fields, including full image paths and command lines. Windows Security Event 4688 with command-line auditing enabled is an acceptable alternative if the EDR normalises parent process path."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "UAC elevation via consent.exe/svchost.exe legitimately reparents processes; some RMM and deployment tools spawn shells under explorer.exe; software installers may use svchost as a nominal parent. Tune using %global_allowed_admin_tools and %global_allowed_remote_mgmt."
    tuning_guidance = "Add known-good parent binaries to %global_allowed_admin_tools. If a specific host runs a legitimate orchestration product that spawns shells under explorer.exe, add it to %global_allowed_script_hosts. Raise severity to Critical if the child process is lsass.exe or a known injection host."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child process is a high-value target for PPID spoofing:
    // shells, script interpreters, or binaries commonly used post-exploitation.
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|certutil|bitsadmin|installutil|cmstp|msbuild|regasm|regsvcs|ieexec|forfiles|pcalua|bash|wsl)\.exe$/ nocase

    // Recorded (possibly spoofed) parent is a high-value impersonation target:
    // explorer.exe, svchost.exe, lsass.exe, winlogon.exe, services.exe, taskhost/taskhostw.
    // Attackers choose these because they appear benign and are always running.
    $proc.principal.process.file.full_path = /\\(explorer|svchost|lsass|winlogon|services|taskhost|taskhostw|dwm|csrss|smss|wininit)\.exe$/ nocase

    // Exclude cases where the grandparent (principal's parent) is consistent with
    // the recorded parent legitimately launching a shell - e.g. UAC via consent.exe.
    // We detect the mismatch by requiring that the child's command line carries
    // indicators of interactive or scripted execution that would be unusual for
    // the claimed parent to initiate autonomously.
    // Specifically: encoded commands, download cradles, or reflective-load flags
    // passed to the child are strong indicators of adversarial intent.
    $proc.target.process.command_line = /(\-[Ee]nc(odedCommand)?|\-[Ee][Cc]\s|FromBase64String|IEX\s|Invoke-Expression|DownloadString|DownloadFile|WebClient|Net\.WebRequest|bitsadmin.*\/transfer|certutil.*\-decode|regsvr32.*\/s.*\/u|rundll32.*javascript|mshta.*vbscript|wscript.*\/e:|cscript.*\/e:)/ nocase

    // Exclude approved administrative and remote-management tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.target.process.file.full_path   in %global_allowed_admin_tools
    not $proc.target.process.file.full_path   in %global_allowed_script_hosts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $spoofed_parent    = array_distinct($proc.principal.process.file.full_path)
    $child_process     = array_distinct($proc.target.process.file.full_path)
    $child_cmdline     = array_distinct($proc.target.process.command_line)
    $affected_user     = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
