/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 3  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:47:25.783551+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_SaaS_Security_Service_Principal_Privilege_Escalation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects privilege escalation or role assignment to service principals or applications that may be exploited to impair security controls in SaaS environments. Adversaries exploiting SaaS vulnerabilities often grant elevated permissions to compromised service accounts to disable monitoring or bypass security boundaries."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Evasion"
    log_prerequisites = "Requires identity provider audit logs capturing role and permission changes."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate service principal configuration during application deployment, automated identity governance workflows, approved security tool integrations."
    tuning_guidance = "Add authorized automation accounts to %global_allowed_service_accounts and approved cloud principals to %global_allowed_cloud_principals."

  events:
    $event.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    (
      $event.target.user.user_display_name = /(?i)(service|app|application|api|automation|integration)/ or
      $event.target.user.userid = /(?i)(service|app|application|api|automation|integration)/
    )
    (
      $event.security_result.summary = /(?i)(security|compliance|audit|monitor|protection|defender|sentinel|guard|detect|prevent|firewall|dlp|casb)/ or
      $event.target.resource.name = /(?i)(security|compliance|audit|monitor|protection|defender|sentinel|guard|detect|prevent|firewall|dlp|casb)/ or
      $event.target.group.group_display_name = /(?i)(security|compliance|audit|monitor|protection|defender|sentinel|guard|detect|prevent|firewall|dlp|casb)/
    )
    (
      $event.security_result.summary = /(?i)(admin|owner|contributor|write|modify|manage|global|privileged|elevated)/ or
      $event.target.resource.attribute.labels.value = /(?i)(admin|owner|contributor|write|modify|manage|global|privileged|elevated)/
    )
    not $event.principal.user.userid in %global_allowed_service_accounts
    not $event.principal.user.userid in %global_allowed_cloud_principals
    not $event.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($event.principal.user.userid)

  condition:
    $event
}
