/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:54:05.446967+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Stripped_Payload_Network_Delivery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network-observable characteristics of stripped binary payload delivery from external sources. Stripped ELF binaries and obfuscated payloads transferred over HTTP/S or raw TCP from external hosts to Linux systems exhibit specific size and port patterns. This rule pivots to the network side to complement endpoint-based T1027.008 detections, catching delivery of stripped payloads before execution."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Requires firewall or perimeter proxy logs normalised to Chronicle UDM NETWORK_HTTP or NETWORK_CONNECTION events. HTTP content-type and URL path fields must be populated. Outbound and inbound flow byte counts should be present."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate software distribution via CDN or package mirrors serving ELF binaries (e.g., curl downloading a vendor agent). CI/CD pipelines pulling compiled artifacts from external build systems. Container image layer pulls over HTTP. Authorised red-team or penetration testing activity."
    tuning_guidance = "Add known-good software distribution domains to %global_allowed_domains. Add approved scanner or deployment source IPs to %global_allowed_scanners. Narrow the response byte range if legitimate large binary transfers are common in the environment. Consider correlating with a subsequent PROCESS_LAUNCH or FILE_CREATION event on the endpoint for higher-fidelity alerting."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // External source only - exclude internal RFC1918 space
    not $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good distribution domains
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

    // HTTP response carrying a binary payload - content-type signals executable or octet-stream
    // Stripped ELF binaries are commonly served as application/octet-stream or with no declared type
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300

    // URL path patterns associated with payload staging:
    // /tmp/, /var/tmp/, direct binary names, or suspiciously short random-looking paths
    // Stripped binaries are often dropped with generic or randomised names
    $net.target.url = /(?i)(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/|\.elf$|\.bin$|\.so\.[0-9]|\/[a-z0-9]{6,16}$)/ nocase

    // Response body size consistent with a stripped ELF binary:
    // Small enough to be a minimal implant (>4KB to exclude trivial scripts),
    // large enough to be a real binary. Stripped binaries are often compact.
    $net.network.sent_bytes > 4096
    $net.network.sent_bytes < 52428800

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.008")
    $primary_entity = array_distinct($net.target.ip)
    $destination_url = array_distinct($net.target.url)
    $source_ip = array_distinct($net.principal.ip)
    $response_bytes = max($net.network.sent_bytes)
    $http_response_code = max($net.network.http.response_code)

  condition:
    $net
}
