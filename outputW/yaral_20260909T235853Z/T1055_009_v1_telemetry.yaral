/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:05:07.783120+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Proc_Memory_Map_Write_Artifact {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-level writes to /proc/<pid>/mem, which is the primary mechanism used in proc memory injection (T1055.009). Legitimate processes rarely write directly to another process's /proc/[pid]/mem pseudo-file; this activity indicates an attempt to overwrite a live process's address space, consistent with ROP payload injection or shellcode staging."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd configured to capture file-open/write syscalls against /proc filesystem paths (auditd rules targeting openat/write on /proc/*/mem, or equivalent EDR file-event telemetry normalised to UDM FILE_MODIFICATION)."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Debugging tools (gdb, lldb, strace) when run by authorised developers; some legitimate memory-profiling agents; Java JVM self-inspection on certain distributions. These should be added to %global_allowed_security_tools or %global_allowed_admin_tools."
    tuning_guidance = "Add authorised debugger and profiler binary paths to %global_allowed_security_tools. If a specific service account runs legitimate memory inspection, add it to %global_allowed_service_accounts. Scope by principal.hostname if noise is isolated to specific build or CI hosts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target must be a /proc/<numeric-pid>/mem pseudo-file.
    // Pattern: /proc/ followed by one or more digits (the PID), then /mem
    $file.target.file.full_path = /\/proc\/[0-9]+\/mem$/ nocase

    // Exclude known-good security and admin tooling
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts (e.g., JVM agents, authorised profilers)
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity    = array_distinct($file.principal.hostname)
    $injecting_process = array_distinct($file.principal.process.file.full_path)
    $target_mem_path   = array_distinct($file.target.file.full_path)
    $acting_user       = array_distinct($file.principal.user.userid)

  condition:
    $file
}
