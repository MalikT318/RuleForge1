/*
  MITRE Technique : T1491.001 - Internal Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:53:57.778202+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_001_ESXi_Internal_Defacement {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of ESXi host-facing files commonly targeted for internal defacement: DCUI welcome banners, shell message-of-the-day files, and hostd/vpxa configuration files that control login presentation. Adversaries alter these to intimidate users or signal compromise after achieving their primary objectives."
    mitre_tactic    = "Impact"
    mitre_technique = "T1491.001"
    mitre_technique_name = "Defacement: Internal Defacement"
    log_prerequisites = "Requires ESXi shell/hostd file-activity telemetry normalised to UDM FILE_MODIFICATION, or EDR coverage of the ESXi host. Events must populate target.file.full_path and principal.process.file.full_path."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised VMware administrators updating MOTD banners, legitimate hostd configuration changes during patching, VMware lifecycle manager operations."
    tuning_guidance = "Add known-good administrative service accounts to %global_allowed_service_accounts. Add approved management tooling paths to %global_allowed_admin_tools. Scope alerts to changes originating outside approved management source addresses."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target the ESXi files used for login banners, DCUI presentation,
    // and host-level message-of-the-day — the primary defacement surfaces.
    $file.target.file.full_path = /(?i)(\/etc\/motd|\/etc\/issue|\/etc\/vmware\/hostd\/|\/etc\/vmware\/vpxa\/|\/etc\/vmware\/config|\/usr\/lib\/vmware\/hostd\/docroot\/|\/var\/run\/vmware\/|\/etc\/vmware\/welcome|\/etc\/banner)/

    // Exclude processes that are part of normal VMware lifecycle management
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service and automation accounts performing authorised changes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1491.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
