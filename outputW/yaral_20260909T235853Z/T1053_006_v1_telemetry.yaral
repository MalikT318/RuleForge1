/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:07:42.868513+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Timer_Unit_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of systemd .timer or paired .service unit files in privileged or user-level systemd directories. Attackers abuse systemd timers for persistence and scheduled execution. This rule pivots on the file artifact produced rather than the command line used to create it, providing coverage that evades process-creation logging gaps."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires Linux EDR or auditd file-event telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION. Auditd rules must watch -w /etc/systemd/system -p wa and -w /usr/lib/systemd/system -p wa and user-level ~/.config/systemd paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate software package installations (apt, yum, dnf, rpm) writing unit files; configuration management tools (Ansible, Puppet, Chef, SaltStack); container orchestration agents; authorised administrator provisioning of scheduled jobs."
    tuning_guidance = "Add known-good package manager and configuration management process paths to %global_allowed_admin_tools. Add authorised service account identifiers to %global_allowed_service_accounts. Consider narrowing to alert only when the writing process is NOT a known package manager (e.g., not /usr/bin/dpkg, /usr/bin/rpm)."

  events:
    $file.metadata.event_type in ["FILE_CREATION", "FILE_MODIFICATION"]

    // Match .timer unit files OR .service files written into systemd unit directories.
    // Privileged system-wide paths and user-level paths are both covered.
    // The combination of directory AND extension is the key behavioural indicator.
    (
      $file.target.file.full_path = /(?i)\/etc\/systemd\/system\/[^\/]+\.(timer|service)$/ nocase
      or
      $file.target.file.full_path = /(?i)\/usr\/lib\/systemd\/system\/[^\/]+\.(timer|service)$/ nocase
      or
      $file.target.file.full_path = /(?i)\/usr\/local\/lib\/systemd\/system\/[^\/]+\.(timer|service)$/ nocase
      or
      $file.target.file.full_path = /\/\.config\/systemd\/user\/[^\/]+\.(timer|service)$/
      or
      $file.target.file.full_path = /\/run\/systemd\/system\/[^\/]+\.(timer|service)$/
    )

    // Exclude known-good package managers and deployment tooling by writing process
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts (e.g., configuration management agents)
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $unit_file_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
