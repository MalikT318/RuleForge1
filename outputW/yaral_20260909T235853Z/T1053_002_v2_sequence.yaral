/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:06:05.536198+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_At_Job_File_Then_Scheduled_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the Windows 'at' job scheduling mechanism by correlating a FILE_CREATION event under the legacy AT job spool directory (C:\\Windows\\System32\\Tasks or the at-job scratch path) followed within 1 hour by a PROCESS_LAUNCH where the parent is the Task Scheduler service host (taskeng.exe or svchost hosting Schedule). This provides additive coverage beyond command-line matching by catching the artefact-then-execution chain regardless of how the job was registered (at.exe, WMI Win32_ScheduledJob, or direct API)."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Event ID 11) and process-launch telemetry (Event ID 1 / 4688). Both must be normalised into Chronicle UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative use of legacy at jobs; software deployment tools that write task artefacts; backup agents that trigger scheduled work via the Task Scheduler service."
    tuning_guidance = "Add known-good parent processes to %global_allowed_admin_tools. Add authorised service accounts that create at-job artefacts to %global_allowed_service_accounts. Narrow the file path regex if your environment uses a non-default spool path."

  events:
    // Leg 1: A file is created in the Windows AT-job spool or Tasks directory.
    // Legacy at.exe writes job files to C:\Windows\System32\Tasks or
    // the historic C:\Windows\System32\AT*.job scratch space.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\(Tasks\\|AT\d+\.job)/ 
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Leg 2: Within the time window, a process is launched whose parent is
    // the Task Scheduler engine (taskeng.exe) or the generic service host
    // carrying the Schedule service. This is the at-job payload executing.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(?i)\\(taskeng|svchost)\.exe$/
    // Exclude common, benign children of the scheduler to reduce noise.
    not $proc.target.process.file.full_path = /(?i)\\(MpCmdRun|TrustedInstaller|wuauclt|SearchIndexer|defrag|cleanmgr|sfc)\.exe$/
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname

    // Chronological ordering: file creation must precede process launch.
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($hostname)
    $at_job_files_created = array_distinct($file.target.file.full_path)
    $spawned_processes = array_distinct($proc.target.process.file.full_path)
    $spawned_command_lines = array_distinct($proc.target.process.command_line)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
