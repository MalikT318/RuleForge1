/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:34:02.075554+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_CnC_Web_Protocol_Beaconing_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential C2 over HTTP/HTTPS by identifying outbound web connections to non-standard ports or suspicious patterns observable at the firewall/proxy perimeter. Targets connections on ports commonly abused for C2 web traffic (e.g., high ports, non-standard HTTP/S ports) from internal hosts to external destinations, which may indicate beaconing or tunnelling over web protocols."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires firewall or proxy perimeter logs normalised to UDM NETWORK_CONNECTION or NETWORK_HTTP. Logs must populate target.port, target.ip, and principal.ip."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate applications using non-standard HTTP/S ports (e.g., development servers, some SaaS products, IoT management platforms). Authorised remote management tools. Vulnerability scanners. Backup agents communicating over non-standard ports."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Add approved remote management sources to %global_allowed_remote_mgmt. Narrow the port range if specific non-standard ports are known-good in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Originating from internal address space
    $net.principal.ip in %rfc1918_internal

    // Destined for external address space (not internal)
    not $net.target.ip in %rfc1918_internal

    // Target port is HTTP/S on non-standard ports, or high ports commonly
    // abused for C2 web tunnelling. Standard ports (80, 443, 8080, 8443)
    // are intentionally included to catch direct C2 on canonical ports
    // while the companion rule covers process-level detail.
    // Focus on ports that are web-protocol-adjacent but atypical:
    // 80, 443 on direct outbound (bypassing proxy), plus common C2 ports.
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 8888 or
      $net.target.port = 4443 or
      $net.target.port = 4444 or
      $net.target.port = 9443 or
      $net.target.port = 2083 or
      $net.target.port = 2087 or
      $net.target.port = 2096
    )

    // Exclude authorised scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
