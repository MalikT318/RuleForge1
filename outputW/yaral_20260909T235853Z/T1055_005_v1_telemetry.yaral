/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:03:42.257307+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious cross-process handle acquisition consistent with TLS callback injection preparation. TLS callback injection requires an adversary to obtain a handle to a target process with PROCESS_VM_WRITE and PROCESS_VM_OPERATION access rights in order to manipulate PE memory offsets and redirect execution before the legitimate entry point. This rule pivots on the PROCESS_OPEN telemetry layer rather than command-line arguments, providing additive coverage over process-creation rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10) telemetry normalised to UDM PROCESS_OPEN events, including target process path and granted access rights. CrowdStrike, SentinelOne, and Microsoft Defender for Endpoint all emit this telemetry."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers (Visual Studio, WinDbg), legitimate memory profilers, some AV/EDR self-protection routines, JIT compilers, and certain game anti-cheat engines that open handles to other processes for inspection."
    tuning_guidance = "Add known-good parent process paths (debuggers, profilers, security agents) to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow scope further by excluding processes whose principal and target share the same base executable name (self-opens for crash reporting)."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The opener must not be a recognised security or admin tool
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Opener is an interpreter or script host - high-risk parent class for injection staging
    // OR a non-system binary opening a system process (unusual cross-boundary open)
    (
      $open.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|certutil|bitsadmin)\.exe$/ nocase
      or
      (
        // Principal lives outside system directories - user-land binary opening a process
        not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww][Ii][Nn][Dd][Oo][Ww][Ss]\\/
        and
        not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Pp]rogram [Ff]iles\\/
      )
    )

    // Target is a legitimate system or user process - typical injection target
    // Exclude self-opens (same executable name) used by crash reporters
    $open.target.process.file.full_path = /\\(svchost|lsass|explorer|RuntimeBroker|SearchHost|sihost|taskhostw|dllhost|spoolsv|winlogon|csrss|services|wininit)\.exe$/ nocase

    // Exclude the opener being the same binary as the target (self-open)
    not $open.principal.process.file.full_path = $open.target.process.file.full_path

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $opener_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
