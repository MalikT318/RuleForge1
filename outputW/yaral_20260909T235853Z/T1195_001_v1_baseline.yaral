/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:44:36.857590+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Suspicious_Package_Manager_Post_Install_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a package manager (pip, npm, gem, cargo, composer) spawning a shell interpreter or network utility as a child process, which is the primary behavioral signal of a malicious dependency executing a post-install hook. Compromised or typosquatted packages commonly abuse post-install lifecycle scripts to drop payloads, establish persistence, or exfiltrate secrets at install time."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with parent-child process lineage (principal = parent, target = child). Fields needed: principal.process.file.full_path, target.process.file.full_path, target.process.command_line, principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate packages with build steps that invoke compilers or shell scripts (e.g., native extension compilation via pip). CI/CD build agents running automated installs. Developer workstations running trusted packages with post-install scripts."
    tuning_guidance = "Add known-good CI/CD runner hostnames to %global_allowed_script_hosts. Add approved build service accounts to %global_allowed_service_accounts. Narrow the child process regex if curl/wget false-positives are high in your environment by requiring additional command-line indicators such as piping to sh or writing to /tmp."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent must be a package manager or its interpreter wrapper
    $proc.principal.process.file.full_path = /\/(pip[23]?|pip_legacy_resolver|npm|node|gem|cargo|composer|yarn|pnpm|poetry|pipenv|conda|easy_install)$/ nocase

    // Child is a shell, interpreter, or network retrieval utility - the classic post-install hook abuse pattern
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash|python[23]?|python3\.[0-9]+|perl|ruby|node|curl|wget|nc|ncat|netcat|socat|openssl)$/

    // Exclude child processes that are simply the package manager re-invoking itself or a known safe compiler
    not $proc.target.process.file.full_path = /\/(gcc|g\+\+|cc|make|cmake|ld|ar|strip|pkg-config)$/

    // Exclude approved build hosts and CI runners
    not $proc.principal.hostname in %global_allowed_script_hosts

    // Exclude approved service/automation accounts performing sanctioned installs
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved admin tooling wrappers
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
