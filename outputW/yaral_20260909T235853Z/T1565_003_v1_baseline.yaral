/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:12:42.855611+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_Runtime_Data_Manipulation_FileAssoc_Hijack {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects registry modifications that redirect file associations or application command handlers to unexpected binaries, a core mechanism for runtime data manipulation. Adversaries abuse ProgID shell/open/command keys or UserChoice overrides to intercept how data is rendered to end users, silently substituting a malicious binary for a legitimate viewer or editor."
    mitre_tactic    = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Runtime Data Manipulation"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13/14 or equivalent EDR registry events) normalised to UDM REGISTRY_MODIFICATION."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers registering new file handlers; browser or PDF reader updates changing their own ProgID entries; application repair operations."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Scope the registry key regex more tightly if specific ProgIDs are causing noise. Consider adding a parent-process allowlist for software deployment systems."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the canonical Windows file-association and application-handler keys
    // where adversaries substitute their own binary for a legitimate viewer/editor.
    // Covers:
    //   HKCR\<ProgID>\shell\open\command
    //   HKCU\Software\Classes\<ProgID>\shell\open\command
    //   HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\<ext>\UserChoice
    //   HKLM\SOFTWARE\Classes\<ProgID>\shell\open\command
    $reg.target.registry.registry_key = /(?i)\\(HKEY_CLASSES_ROOT|HKCR|HKEY_CURRENT_USER\\Software\\Classes|HKCU\\Software\\Classes|HKEY_LOCAL_MACHINE\\SOFTWARE\\Classes)\\[^\\]+\\shell\\(open|edit|print|printto|play|preview)\\command$/

    // The new command value must reference an executable outside the standard
    // Windows system directories - a strong indicator of substitution.
    // Legitimate handlers almost always live under System32, SysWOW64, or
    // well-known Program Files paths registered by installers.
    not $reg.target.registry.registry_value_data = /(?i)^"?C:\\Windows\\(System32|SysWOW64|WinSxS)\\/
    not $reg.target.registry.registry_value_data = /(?i)^"?C:\\Program Files( \(x86\))?\\/

    // Exclude processes that are expected to legitimately modify these keys
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service/automation accounts
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $new_handler = array_distinct($reg.target.registry.registry_value_data)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
