/*
  MITRE Technique : T1008 - Fallback Channels
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:27:56.294700+00:00
  Reference       : https://attack.mitre.org/techniques/T1008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1008_001_Fallback_Channel_Repeated_Outbound_Port_Cycling {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a single host making outbound connections to multiple distinct external destinations across a set of ports commonly abused as C2 fallback channels (80, 443, 8080, 8443, 53, 4444, 1194). Fallback channel behaviour is characterised by a host cycling through alternative destinations and ports when a primary C2 path is blocked. A single firewall flow event matching an uncommon high-risk port to a non-RFC-1918 destination is flagged; volume-based correlation is left to the SIEM aggregation layer."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1008"
    mitre_technique_name = "Fallback Channels"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Fields required: principal.hostname or principal.ip, target.ip, target.port, network.ip_protocol."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "VPN clients (port 1194/UDP), legitimate DNS-over-HTTPS resolvers (port 443), developer tools using non-standard ports, authorised remote-access software. Tune by adding known-good source hosts to %global_allowed_remote_mgmt and known-good destinations to %global_allowed_domains."
    tuning_guidance = "Add approved management source IPs or hostnames to %global_allowed_mgmt_sources. Add approved external service FQDNs to %global_allowed_domains. Narrow the port list to only those not expected in your environment. Consider raising severity to Critical if port 4444 is matched."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target must be an external (non-RFC-1918) address
    not $net.target.ip in %rfc1918_internal

    // Ports commonly cycled through as C2 fallback channels:
    // 80  - HTTP fallback
    // 443 - HTTPS fallback
    // 8080 - alternate HTTP
    // 8443 - alternate HTTPS
    // 53  - DNS tunnelling fallback
    // 4444 - common RAT/shell default
    // 1194 - OpenVPN (abused for tunnelling)
    (
        $net.target.port = 4444 or
        $net.target.port = 1194 or
        $net.target.port = 8080 or
        $net.target.port = 8443 or
        $net.target.port = 53   or
        $net.target.port = 80   or
        $net.target.port = 443
    )

    // Exclude approved management and scanner sources
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved external destinations
    not $net.target.hostname in %global_allowed_domains

  outcome:
    // Higher risk for ports that have no legitimate outbound use in most enterprises
    $risk_score = if(
        $net.target.port = 4444, 95,
        if($net.target.port = 1194, 80,
        if($net.target.port = 8080 or $net.target.port = 8443, 70,
        if($net.target.port = 53, 75,
        60))))

    $mitre_technique_id = "T1008"
    $primary_entity     = $net.principal.hostname

  condition:
    $net
}
