/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:16:57.520018+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_Disable_Crypto_Hardware {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects configuration changes on network devices that disable or modify hardware crypto acceleration settings. Adversaries who gain control of a network device may disable dedicated hardware encryption to force software-based encryption, weakening the overall cryptographic posture and enabling traffic interception or manipulation."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Weaken Encryption: Disable Crypto Hardware"
    log_prerequisites = "Requires network device management-plane syslog or configuration audit logs normalised into Chronicle UDM SETTING_MODIFICATION events. Devices must log configuration changes with command or setting detail in target.resource.attribute.labels or security_result.description."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized network engineers performing planned maintenance, hardware replacement, or firmware upgrades that temporarily disable crypto offload. Automated provisioning systems applying baseline configurations."
    tuning_guidance = "Add authorized administrator accounts to %global_allowed_admin_users and authorized management source addresses to %global_allowed_mgmt_sources. Consider narrowing the regex if the environment uses a consistent naming convention for crypto engine settings."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"

    // Match configuration changes referencing hardware crypto, crypto engine,
    // or crypto acceleration being disabled, removed, or set to software mode.
    // Covers common CLI patterns across major network OS families without
    // hardcoding vendor-specific product names.
    (
      $setting.target.resource.attribute.labels.value = /(?i)(no\s+crypto\s+engine|crypto\s+engine\s+software|disable.*crypto.*hardware|no\s+crypto\s+accelerat|crypto\s+accelerat.*off|hw.?crypto.*disabl|crypto.*offload.*disabl|no\s+platform\s+hardware\s+crypto|crypto\s+engine.*slot.*off)/
      or
      $setting.security_result.description = /(?i)(no\s+crypto\s+engine|crypto\s+engine\s+software|disable.*crypto.*hardware|no\s+crypto\s+accelerat|crypto\s+accelerat.*off|hw.?crypto.*disabl|crypto.*offload.*disabl|no\s+platform\s+hardware\s+crypto|crypto\s+engine.*slot.*off)/
    )

    // Exclude authorized management source addresses
    not $setting.principal.ip in %global_allowed_mgmt_sources

    // Exclude authorized administrator accounts performing planned changes
    not $setting.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity = array_distinct($setting.principal.hostname)
    $actor_user = array_distinct($setting.principal.user.userid)
    $target_device = array_distinct($setting.target.hostname)
    $change_detail = array_distinct($setting.security_result.description)

  condition:
    $setting
}
