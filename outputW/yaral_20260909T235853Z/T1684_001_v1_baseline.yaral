/*
  MITRE Technique : T1684.001 - Impersonation
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:31:06.365244+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_001_BEC_Impersonation_Suspicious_Email_Keywords {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects inbound email transactions containing social engineering keywords commonly used in business email compromise (BEC) and impersonation campaigns. Adversaries impersonate executives, colleagues, or vendors and use urgency-driven language to manipulate recipients into transferring funds or divulging sensitive information. This rule targets the EMAIL_TRANSACTION event for messages arriving from external senders with subject lines or bodies containing high-risk BEC indicators."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.001"
    mitre_technique_name = "Impersonation"
    log_prerequisites = "Requires Microsoft 365 unified audit logs with email transaction telemetry normalised to UDM EMAIL_TRANSACTION events, including network.email.subject and principal.user.email_addresses fields."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate urgent payment requests from finance teams, vendor invoice emails, executive communications about wire transfers. High volume expected in finance and accounts-payable roles."
    tuning_guidance = "Add known-good external sender domains to %global_allowed_domains. Add internal service accounts that generate automated payment notifications to %global_allowed_service_accounts. Consider scoping to specific high-risk recipient roles (finance, HR, executives) if volume is excessive."

  events:
    $email.metadata.event_type = "EMAIL_TRANSACTION"

    // Email arrives from an external sender not in the allowed domain list
    not $email.network.email.from in %global_allowed_domains

    // Subject line contains BEC social engineering keywords
    // Matches urgency, financial, and authority-abuse patterns common in impersonation campaigns
    $email.network.email.subject = /(?i)(urgent|wire\s*transfer|payment\s*(request|required|needed|due)|invoice\s*(attached|enclosed|overdue)|bank\s*(details|account|transfer)|fund(s)?\s*(transfer|request)|immediate(ly)?|confidential(ly)?|act\s*now|time\s*sensitive|ceo\s*(request|approval|instruction)|executive\s*(request|approval)|direct(or)?\s*(request|approval)|please\s*(process|approve|confirm|send|transfer)|do\s*not\s*(discuss|forward|share)|outside\s*(normal|regular)\s*channel|bypass|override|personal(ly)?\s*(request|ask)|gift\s*card|itunes|amazon\s*card)/

    // Exclude internal senders (self-to-self or internal relay)
    not $email.principal.user.email_addresses in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = "T1684.001"
    $primary_entity = $email.target.user.email_addresses
    $sender_address = $email.network.email.from
    $email_subject = $email.network.email.subject

  condition:
    $email
}
