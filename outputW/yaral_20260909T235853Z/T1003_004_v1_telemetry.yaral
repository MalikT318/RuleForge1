/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:25:18.592306+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Registry_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects registry read or modification access to HKLM\\SECURITY\\Policy\\Secrets, the storage location for LSA secrets. Legitimate access to this key is extremely rare and almost exclusively performed by the SYSTEM account during normal OS operations. Any non-SYSTEM or unexpected process touching this key is a strong indicator of credential dumping activity consistent with T1003.004."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 or equivalent EDR registry events) normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION. Windows SACL auditing on HKLM\\SECURITY\\Policy\\Secrets will also surface these via Security Event 4657."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows LSASS during boot or credential refresh cycles (principal.user.userid = SYSTEM). Domain join operations. Authorised backup agents reading the security hive. Security tooling performing authorised credential audits."
    tuning_guidance = "Add authorised backup or security agent process paths to %global_allowed_backup_processes or %global_allowed_security_tools. If SYSTEM-context access is noisy from legitimate OS activity, add a filter on principal.user.userid = 'SYSTEM' combined with the known-good process path. Scope further by requiring the accessing process to NOT be lsass.exe or services.exe."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\HKEY_LOCAL_MACHINE\\SECURITY\\Policy\\Secrets/
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\lsass\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\services\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\svchost\.exe$/ nocase

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $accessing_process = array_distinct($reg.principal.process.file.full_path)
    $accessing_user = array_distinct($reg.principal.user.userid)
    $registry_key_accessed = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
