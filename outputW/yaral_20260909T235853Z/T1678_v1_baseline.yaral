/*
  MITRE Technique : T1678 - Delay Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:29:51.216114+00:00
  Reference       : https://attack.mitre.org/techniques/T1678
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1678_001_Delay_Execution_Ping_Loop_Or_Sleep {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects common delay-execution patterns on Windows: ping used as a sleep substitute with high repeat counts, PowerShell Start-Sleep with long durations, cmd timeout, or choice /t used to stall execution. Adversaries use these LOLBin techniques to evade sandbox time thresholds and blend malicious activity into normal timing windows."
    mitre_tactic = "Stealth"
    mitre_technique = "T1678"
    mitre_technique_name = "Delay Execution"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Network diagnostic scripts using ping with high counts, legitimate automation scripts using Start-Sleep, installer scripts using timeout to wait for services, IT tooling using choice /t for interactive prompts."
    tuning_guidance = "Add known-good parent processes (deployment agents, RMM tools, patch management) to %global_allowed_admin_tools. Raise the ping count threshold or sleep duration threshold if false-positive volume is high in your environment. Consider correlating with a subsequent suspicious child process to increase fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Pattern 1: ping used as sleep substitute - high repeat count (>= 10 iterations)
    // Pattern 2: PowerShell Start-Sleep with a meaningful duration
    // Pattern 3: cmd.exe timeout /t with a meaningful wait
    // Pattern 4: choice /t used as a delay primitive
    (
      (
        $proc.target.process.file.full_path = /\\ping\.exe$/ nocase
        and $proc.target.process.command_line = /\-n\s+[1-9][0-9]{1,}/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and $proc.target.process.command_line = /(?i)start[\s\-]sleep/ nocase
        and $proc.target.process.command_line = /\-s(econds?)?\s+[1-9][0-9]{1,}/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\cmd\.exe$/ nocase
        and $proc.target.process.command_line = /(?i)timeout\s+\/t\s+[1-9][0-9]{1,}/ nocase
        and $proc.target.process.command_line = /\/nobreak/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\choice\.exe$/ nocase
        and $proc.target.process.command_line = /\/t\s+[1-9][0-9]{1,}/ nocase
        and $proc.target.process.command_line = /\/d\s+[yn]/ nocase
      )
    )

    // Suspicious parent lineage: delay launched from a script host, Office app, or browser
    $proc.principal.process.file.full_path = /\\(wscript|cscript|mshta|powershell|pwsh|cmd|winword|excel|powerpnt|msedge|chrome|firefox|rundll32|regsvr32|msiexec|wmic)\.exe$/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1678")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
