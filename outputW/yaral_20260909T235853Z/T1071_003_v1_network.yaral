/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:35:11.336949+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_Mail_Protocol_C2_Network_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound connections to standard and non-standard mail protocol ports (SMTP, SMTPS, POP3, POP3S, IMAP, IMAPS) from internal hosts to external destinations. Adversaries abuse mail protocols for C2 to blend with legitimate email traffic. Firewall/perimeter telemetry provides additive coverage beyond endpoint process-launch rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW. Source IP must be populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate mail clients, mail transfer agents (Postfix, Sendmail, Exim), mail gateways, and newsletter/marketing services sending outbound email. Authorised mail relay hosts will generate high volumes of these connections."
    tuning_guidance = "Add known-good mail relay and gateway source IPs to %global_allowed_mgmt_sources. Add approved external mail domains to %global_allowed_domains. Consider narrowing to non-standard ports (e.g. 587 only from non-MTA hosts) if standard port 25 is too noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Mail protocol ports: SMTP(25), Submission(587), SMTPS(465), POP3(110), POP3S(995), IMAP(143), IMAPS(993)
    (
      $net.target.port = 25 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 110 or
      $net.target.port = 995 or
      $net.target.port = 143 or
      $net.target.port = 993
    )

    // Source must be an internal host (exclude scanner/mgmt sources)
    not $net.principal.ip in %rfc1918_internal or $net.principal.ip != ""

    // Destination must be external (not RFC1918)
    not $net.target.ip in %rfc1918_internal

    // Exclude approved mail relay infrastructure and management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude known-good external mail domains if hostname is resolved
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $destination_host = array_distinct($net.target.hostname)

  condition:
    $net
}
