/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:01:38.974884+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_001_Internal_Spearphishing_Mail_Tool_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a compromised internal account using command-line mail transfer agents (sendmail, msmtp, swaks, mutt, mail, s-nail) to send messages to internal recipients from an interactive shell or scripting context. This is a primary behavioral signal for internal spearphishing on Linux: a legitimate but compromised account programmatically sends mail, often with attachments or embedded links, to pivot laterally within the organization."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with command-line arguments captured. Auditd execve syscall records or EDR PROCESS_LAUNCH events with full argv are required."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate automated notification scripts, cron-driven alerting pipelines, monitoring daemons, and CI/CD pipelines that send mail programmatically. Backup or deployment tooling may invoke sendmail or msmtp as part of normal operations."
    tuning_guidance = "Add known-good automation parent processes (e.g., cron, monitoring agents) to %global_allowed_script_hosts. Add authorized service accounts that send automated mail to %global_allowed_service_accounts. Narrow the rule by requiring the parent process to be an interactive shell (bash, sh, zsh, fish) if false-positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match command-line mail transfer agents and mail clients commonly abused
    // for internal spearphishing on Linux. Pattern anchored to binary name only
    // so renaming the binary to a path variant is still caught.
    $proc.target.process.file.full_path = /\/(sendmail|msmtp|swaks|mutt|s-nail|nail|mail|mailx|ssmtp|postfix\/sendmail)$/ nocase

    // Require at least one recipient argument or a flag indicating message
    // composition/sending. This filters out --help or --version invocations.
    // Covers: -t (read recipients from headers), -s (subject), -- (end of opts
    // before recipient), or a bare address-like argument.
    $proc.target.process.command_line = /(\s-[ts]\s|\s--to\s|\s--subject\s|\s--attach\s|\s--body\s|@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,})/ nocase

    // Exclude known-good service and automation accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good parent processes such as monitoring agents and
    // authorized automation frameworks
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

    // Exclude backup and imaging processes that may trigger mail on completion
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_user = array_distinct($proc.principal.user.userid)
    $mail_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
