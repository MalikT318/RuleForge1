/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:48:16.563453+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Obfuscated_Payload_Network_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP transfers over non-standard or high ports carrying high-entropy or encoded payloads characteristic of obfuscated file transfer. On network devices and IDS/IPS sensors this manifests as HTTP traffic on unexpected ports with large body sizes or encoding indicators in the URI/headers, consistent with adversaries staging obfuscated payloads in transit (T1027)."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_HTTP events. The appliance must decode HTTP metadata including URI, method, port, and content-type or user-agent fields."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Legitimate encrypted backup transfers over non-standard ports, CDN or update services using base64-encoded URIs, authorised file transfer tools using custom ports, developer CI/CD pipelines pushing encoded artifacts."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add approved scanner sources to %global_allowed_scanners. Raise the port threshold or restrict to specific monitored segments if false-positive volume is high. Consider narrowing to inbound-only traffic if egress is separately monitored."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Traffic must be destined for an external address - exclude RFC1918 internal space
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external destinations (CDNs, update services, approved vendors)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanner sources
    not $net.principal.ip in %global_allowed_scanners

    // Focus on non-standard HTTP ports - standard web ports (80, 443, 8080, 8443)
    // are excluded to reduce noise; obfuscated payload staging often uses unusual ports
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port > 1024

    // URI contains base64-like or percent-encoded high-density strings
    // indicative of encoded/obfuscated payload paths or parameters
    $net.network.http.request_url = /\/[A-Za-z0-9+\/]{40,}={0,2}([?&\/]|$)/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $request_url = array_distinct($net.network.http.request_url)

  condition:
    $net
}
