/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:04:39.801634+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_ROMMONkit_TFTP_Firmware_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects potential ROMMONkit activity by identifying TFTP traffic (UDP/69) originating from or destined to network device management addresses from external or unexpected sources. Adversaries abuse TFTP to remotely upload a malicious ROMMON firmware image to a Cisco network device, providing persistent, difficult-to-detect access. This rule fires on TFTP flows where the source is not an approved management address."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs with UDP port 69 (TFTP) visibility. Flows must be normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW with target.port and principal/target IP fields populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network operations teams performing legitimate firmware upgrades via TFTP from approved jump hosts or management servers. Automated provisioning systems using TFTP for device bootstrapping (e.g., ZTP/PnP pipelines)."
    tuning_guidance = "Add approved TFTP server and management jump-host addresses to %global_allowed_mgmt_sources to suppress known-good firmware distribution servers. Add approved scanner IPs to %global_allowed_scanners if vulnerability scanning tools probe UDP/69."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // TFTP uses UDP port 69 exclusively
    $net.target.port = 69

    // Exclude traffic from approved management sources such as authorised
    // TFTP servers, jump hosts, and provisioning systems
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude internal-to-internal traffic that may represent legitimate
    // provisioning; internal ranges are maintained in the reference list
    not $net.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
