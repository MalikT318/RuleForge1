/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:25:23.836727+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_002_Cloud_Storage_Access_After_Suspicious_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user who authenticates from an unusual or anonymous network context (e.g., no MFA, suspicious ASN, or failed-then-succeeded pattern) and then performs bulk or sensitive cloud storage resource access within a short window. This correlation targets adversarial collection of SaaS-hosted data following credential compromise, providing additive coverage beyond command-line-based detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM USER_LOGIN and USER_RESOURCE_ACCESS events. The USER_LOGIN event must populate security_result.action or authentication details. USER_RESOURCE_ACCESS events must populate target.resource.name and principal.user.userid."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate bulk downloads by data migration scripts, authorised backup service accounts, or power users performing large exports. Developers accessing storage APIs programmatically during normal workflows."
    tuning_guidance = "Add known service and automation accounts to %global_allowed_service_accounts. Add approved cloud principals performing bulk access to %global_allowed_cloud_principals. Raise the threshold on the outcome risk_score for environments with frequent bulk-download workflows."

  events:
    // Event 1: Suspicious login - authentication succeeded but with anomaly signals
    // such as missing MFA claim, risky sign-in category, or legacy protocol
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.severity = "HIGH"
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    $auth.principal.user.userid = $userid

    // Event 2: Cloud storage resource access following the suspicious login
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid = $userid
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals
    // Target must reference a cloud storage resource (drive, blob, bucket, file share)
    $access.target.resource.name = /(?i)(drive|onedrive|sharepoint|blob|bucket|storage|s3|gcs|dropbox|confluence|share)/
    // Exclude internal management plane sources
    not $access.principal.ip in %rfc1918_internal

    // Chronological ordering: login must precede storage access
    $auth.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $userid over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1530")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $accessed_resources = array_distinct($access.target.resource.name)
    $source_ips = array_distinct($access.principal.ip)
    $auth_severity = array_distinct($auth.security_result.severity)
    $access_event_count = count($access.metadata.id)

  condition:
    $auth and $access
}
