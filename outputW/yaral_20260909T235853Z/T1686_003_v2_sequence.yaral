/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:46:43.721230+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Registry_Then_Lateral_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects Windows host firewall suppression via registry modification (disabling firewall profiles or enabling rule bypass) followed by an outbound network connection from the same host within 10 minutes. This provides additive coverage beyond command-line detection by targeting the registry mechanism adversaries use to persist firewall changes."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Windows Host Firewall"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION) and network connection telemetry (NETWORK_CONNECTION) normalised to UDM. Both event types must be present for the correlation to fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy application of firewall settings by legitimate IT management tooling, endpoint security agents writing firewall policy, and authorised network management software. Backup or deployment agents may also touch firewall registry keys during provisioning."
    tuning_guidance = "Add known IT management and deployment service account names to %global_allowed_service_accounts. Add approved administrative hosts to %global_allowed_admin_tools. Narrow the network filter by adding trusted internal management subnets to %rfc1918_internal exclusions if internal lateral movement is not in scope."

  events:
    // Event 1: Registry modification targeting Windows Firewall policy keys
    // Covers: EnableFirewall = 0 (disable), DefaultInboundAction, DefaultOutboundAction,
    // and per-profile keys under SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy\\/
    (
      $reg.target.registry.registry_value_name = /(?i)EnableFirewall/ or
      $reg.target.registry.registry_value_name = /(?i)DefaultInboundAction/ or
      $reg.target.registry.registry_value_name = /(?i)DefaultOutboundAction/ or
      $reg.target.registry.registry_value_name = /(?i)DoNotAllowExceptions/ or
      $reg.target.registry.registry_value_name = /(?i)DisableNotifications/
    )
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    // Event 2: Outbound network connection from the same host after the registry change
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 0
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    $net.principal.hostname = $hostname

    // Chronological ordering: registry change must precede the network connection
    $reg.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_keys = array_distinct($reg.target.registry.registry_key)
    $modified_registry_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $network_destination_ips = array_distinct($net.target.ip)
    $network_destination_ports = array_distinct($net.target.port)
    $network_process = array_distinct($net.principal.process.file.full_path)
    $actor_userid = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $net
}
