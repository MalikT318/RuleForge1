/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:22:04.462343+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_LDAP_Domain_Enum_Then_External_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux host making LDAP/LDAPS queries (port 389/636) to a domain controller, followed within 10 minutes by an outbound connection from the same host to a non-internal destination. This pattern is consistent with domain account enumeration via ldapsearch or similar tools, followed by data staging or exfiltration of discovered account information."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires firewall or network perimeter flow logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Both LDAP query events and subsequent outbound connections must be visible to the perimeter sensor."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate directory-integrated applications (e.g., SSSD, PAM-LDAP, monitoring agents) that routinely query LDAP and also make external connections. Vulnerability scanners and authorised security tooling. Backup agents that authenticate via LDAP before uploading to cloud storage."
    tuning_guidance = "Add known-good LDAP client source IPs to %global_allowed_scanners or %global_allowed_backup_processes reference lists. Add approved external destinations to %global_allowed_domains. Raise the risk score if the external destination port is also unusual (not 80/443)."

  events:
    // Event 1: Outbound LDAP or LDAPS connection from an internal host to a domain controller
    $ldap.metadata.event_type = "NETWORK_CONNECTION"
    ($ldap.target.port = 389 or $ldap.target.port = 636)
    not $ldap.principal.ip in %rfc1918_internal or $ldap.target.ip in %rfc1918_internal
    // Restrict to connections where the source is internal (principal is internal)
    $ldap.principal.ip in %rfc1918_internal
    not $ldap.principal.ip in %global_allowed_scanners
    not $ldap.principal.ip in %global_allowed_backup_processes
    $ldap.principal.hostname = $src_host

    // Event 2: Outbound connection from the same host to an external (non-RFC1918) destination
    $ext.metadata.event_type = "NETWORK_CONNECTION"
    $ext.principal.hostname = $src_host
    not $ext.target.ip in %rfc1918_internal
    not $ext.target.hostname in %global_allowed_domains
    not $ext.principal.ip in %global_allowed_scanners
    not $ext.principal.ip in %global_allowed_backup_processes

    // Chronological ordering: LDAP query must precede the external connection
    $ldap.metadata.event_timestamp.seconds <= $ext.metadata.event_timestamp.seconds

  match:
    $src_host over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($src_host)
    $ldap_target_ips = array_distinct($ldap.target.ip)
    $ldap_ports_observed = array_distinct($ldap.target.port)
    $external_destination_ips = array_distinct($ext.target.ip)
    $external_destination_ports = array_distinct($ext.target.port)
    $ldap_event_count = count($ldap.metadata.event_timestamp.seconds)
    $ext_event_count = count($ext.metadata.event_timestamp.seconds)

  condition:
    $ldap and $ext
}
