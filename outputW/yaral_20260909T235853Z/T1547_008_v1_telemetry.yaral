/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:14:06.391583+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSASS_Driver_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of DLL/SYS files in the Windows System32 LSA or security subsystem directories, which is the artifact-level indicator of an adversary installing or replacing an LSASS driver for persistence. Legitimate LSA driver updates are rare outside of Windows Update or domain controller provisioning."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires EDR or Sysmon file-creation/modification telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Update patching LSA components (e.g., lsasrv.dll, msv1_0.dll), domain controller provisioning, legitimate security software installing authentication packages, antivirus/EDR agents updating their own LSA plugins."
    tuning_guidance = "Add known-good parent processes (e.g., TrustedInstaller, Windows Update agent) to %global_allowed_admin_tools. Add authorised security product processes to %global_allowed_security_tools. Scope further by excluding writes that occur within a maintenance window if your SOAR can inject time context."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target the LSA/security subsystem directories where LSASS drivers reside.
    // Matches System32 root and the LSA subdirectory, covering both direct
    // driver replacements and new illegitimate package drops.
    $file.target.file.full_path = /(?i)\\Windows\\System32\\(lsa\\|security\\)?[^\\]+\.(dll|sys)$/

    // Narrow to files whose names overlap with known LSA package naming patterns
    // OR are entirely novel names placed alongside legitimate LSA components.
    // We match the directory rather than specific filenames to survive renaming.
    // Additional specificity: exclude writes from Windows-signed update paths.
    not $file.principal.process.file.full_path = /(?i)\\Windows\\(WinSxS|SoftwareDistribution|servicing)\\/ 
    not $file.principal.process.file.full_path = /(?i)\\TrustedInstaller\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
