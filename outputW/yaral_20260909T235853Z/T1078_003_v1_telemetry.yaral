/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:21:13.539800+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Local_Account_Suspicious_Login_Pattern {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects authentication events from local (non-domain) accounts that exhibit characteristics consistent with adversary abuse of local credentials: login outside business hours, use of built-in or default-named local accounts, or authentication from unexpected source addresses. Local account abuse is a common persistence and lateral movement technique that bypasses domain-level controls and is difficult to detect via process telemetry alone."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires identity provider or Windows Security Event Log authentication events normalised to UDM USER_LOGIN. Windows Event IDs 4624 (successful logon) and 4625 (failed logon) with logon type 3 (network) or 10 (remote interactive) are the primary source. Chronicle must ingest and normalise these to UDM."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate remote administration using local accounts (break-glass scenarios), backup agents authenticating with local service accounts, helpdesk tooling using local credentials on workstations."
    tuning_guidance = "Add approved local service account names to %global_allowed_service_accounts. Add approved administrative users to %global_allowed_admin_users. Add approved management source addresses to %global_allowed_mgmt_sources. Consider narrowing the hour range to match the organisation's business hours."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Target a local account: UPN or domain portion absent or matches the
    // local hostname, indicating a local (SAM-style) account rather than a
    // domain account. Local accounts typically have no domain prefix or carry
    // the machine name as the domain.
    $auth.target.user.userid = /^[^\\@]+$/ nocase

    // Exclude well-known system pseudo-accounts that generate high-volume
    // benign noise (SYSTEM, NETWORK SERVICE, LOCAL SERVICE, ANONYMOUS LOGON).
    not $auth.target.user.userid = /(?i)^(system|network service|local service|anonymous logon|iis apppool)$/

    // Exclude approved service and automation accounts.
    not $auth.target.user.userid in %global_allowed_service_accounts

    // Exclude approved administrator accounts expected to use local credentials.
    not $auth.target.user.userid in %global_allowed_admin_users

    // Restrict to network or remote interactive logon types, which are the
    // vectors most commonly abused for lateral movement and remote access.
    // Logon type 3 = Network, 10 = RemoteInteractive (RDP).
    // UDM normalises Windows logon type into extensions.auth.auth_details or
    // the event_subtype; filter on network-origin events by requiring a
    // non-empty source address that is not the loopback address.
    $auth.principal.ip != "127.0.0.1"
    $auth.principal.ip != "::1"

    // Exclude traffic originating from approved management source ranges.
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Exclude internal scanner and vulnerability assessment sources.
    not $auth.principal.ip in %global_allowed_scanners

    // Flag authentications occurring outside typical business hours (before
    // 06:00 or after 22:00 UTC). Adjust the hour window to match the
    // organisation's operational timezone via tuning.
    (
      timestamp.get_hour($auth.metadata.event_timestamp, "UTC") < 6 or
      timestamp.get_hour($auth.metadata.event_timestamp, "UTC") > 22
    )

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ip = array_distinct($auth.principal.ip)
    $target_hostname = array_distinct($auth.target.hostname)

  condition:
    $auth
}
