/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:20:32.672099+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Domain_Account_SSH_Authorized_Keys_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of SSH authorized_keys files outside of expected administrative tooling. Adversaries who have obtained domain account credentials on Linux systems frequently add their own public keys to authorized_keys files to establish persistent, credential-independent access. This rule fires on the resulting file artifact rather than the command used to write it, providing coverage that survives command-line obfuscation or direct syscall writes."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events. Auditd rule: -w /root/.ssh -p wa -k ssh_keys and equivalent per-user rules, or EDR file monitoring covering /home/*/.ssh/ and /root/.ssh/."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate configuration management tools (Ansible, Puppet, Chef) writing authorized_keys during provisioning; IT administrators manually adding keys for break-glass access; automated certificate rotation pipelines."
    tuning_guidance = "Add known configuration management service account identifiers to %global_allowed_service_accounts. Add approved automation process paths to %global_allowed_admin_tools. Consider narrowing to non-business hours or to accounts not in %global_allowed_admin_users."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target the authorized_keys artifact in any user home directory or root
    // Matches: /home/<any_user>/.ssh/authorized_keys and /root/.ssh/authorized_keys
    $file.target.file.full_path = /(?i)(\/home\/[^\/]+|\/root)\/.ssh\/authorized_keys(2)?$/

    // Exclude writes by known-good service and automation accounts
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

    // Exclude known configuration management and admin tooling processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude backup agents that legitimately read/write SSH material
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $affected_user = array_distinct($file.principal.user.userid)
    $modified_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
