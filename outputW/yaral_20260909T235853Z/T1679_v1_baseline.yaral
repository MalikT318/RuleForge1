/*
  MITRE Technique : T1679 - Selective Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:30:12.241894+00:00
  Reference       : https://attack.mitre.org/techniques/T1679
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1679_001_Ransomware_Selective_Exclusion_Cmdline {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects processes whose command line contains patterns consistent with ransomware selective exclusion logic - explicitly skipping known system-critical extensions (.dll, .exe, .lnk, .sys) or directories (Windows, System32, ProgramData) while iterating files. This is a strong behavioral indicator of ransomware payload preparation or active encryption with deliberate exclusion lists."
    mitre_tactic = "Stealth"
    mitre_technique = "T1679"
    mitre_technique_name = "Selective Exclusion"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (Sysmon Event ID 1, Windows Security 4688 with command-line auditing enabled, or equivalent EDR telemetry)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup software specifying file-type exclusions, legitimate archiving or compression tools with skip-extension flags, IT automation scripts performing selective file operations, software deployment tools."
    tuning_guidance = "Add known backup and archiving parent process paths to %global_allowed_backup_processes. Add approved automation accounts to %global_allowed_service_accounts. Narrow scope by requiring additional ransomware-adjacent signals (e.g., high file-write volume) via correlation."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match command lines that reference multiple system-critical extensions
    // in an exclusion or skip context - characteristic of ransomware exclusion lists.
    // Pattern: any combination of .dll/.exe/.sys/.lnk/.msi appearing together
    // in a single command line, which is unusual for legitimate tooling.
    (
      $proc.target.process.command_line = /(?i)(\.dll).*(\.exe)/ or
      $proc.target.process.command_line = /(?i)(\.exe).*(\.sys)/ or
      $proc.target.process.command_line = /(?i)(\.dll).*(\.lnk)/ or
      $proc.target.process.command_line = /(?i)(skip|exclu|avoid|ignore|bypass).*(\.dll|\.exe|\.sys|\.lnk|\.msi)/
    )

    // Must also reference file-system traversal or encryption-adjacent keywords
    // to reduce false positives from benign multi-extension references.
    (
      $proc.target.process.command_line = /(?i)(encrypt|crypt|lock|ransom|cipher|wiper|destro)/ or
      $proc.target.process.command_line = /(?i)(recurse|subdir|traverse|walk|enum|iterate|foreach)/ or
      $proc.target.process.command_line = /(?i)(GetFiles|EnumerateFiles|DirectoryInfo|SearchPattern)/
    )

    // Exclude known-good scripting hosts and admin tools operating legitimately.
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1679")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $spawning_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
