/*
  MITRE Technique : T1673 - Virtual Machine Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:28:35.307930+00:00
  Reference       : https://attack.mitre.org/techniques/T1673
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1673_001_ESXi_VM_Discovery_Via_Hypervisor_CLI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of ESXi hypervisor CLI commands used to enumerate running virtual machines. Adversaries with shell access to an ESXi host commonly run esxcli or vim-cmd to list VMs as a precursor to ransomware deployment or lateral movement."
    mitre_tactic = "Discovery"
    mitre_technique = "T1673"
    mitre_technique_name = "Virtual Machine Discovery"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised to UDM PROCESS_LAUNCH. Enable ESXi shell logging and forward hostd/shell logs to Chronicle."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised VMware administrators performing routine inventory checks, monitoring agents querying VM state, backup orchestration software enumerating VMs before snapshot."
    tuning_guidance = "Add known administrative service accounts to %global_allowed_service_accounts. Add approved management hosts or orchestration processes to %global_allowed_admin_tools to suppress scheduled inventory jobs."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match the two primary ESXi VM enumeration binaries
    (
      $proc.target.process.file.full_path = /\/bin\/esxcli$/ nocase
      or
      $proc.target.process.file.full_path = /\/bin\/vim-cmd$/ nocase
    )

    // Match VM listing sub-commands on either binary
    (
      $proc.target.process.command_line = /vm\s+process\s+list/ nocase
      or
      $proc.target.process.command_line = /vmsvc\/getallvms/ nocase
      or
      $proc.target.process.command_line = /vmsvc\/get\.summary/ nocase
      or
      $proc.target.process.command_line = /vmsvc\/power\.getstate/ nocase
    )

    // Exclude known authorised service and automation accounts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude known authorised administrative tooling (e.g. backup agents, monitoring)
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1673")
    $primary_entity = array_distinct($proc.principal.hostname)
    $executing_user = array_distinct($proc.principal.user.userid)
    $command_observed = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
