/*
  MITRE Technique : T1606.002 - SAML Tokens
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:20:33.513703+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_002_SAML_Token_Anomalous_Lifetime_Or_Claims {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects authentication events with anomalous SAML token lifetimes or unusual claim patterns indicative of forged SAML tokens. Monitors for tokens with extended validity periods or privilege escalation claims inconsistent with normal user behavior."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.002"
    mitre_technique_name = "Forge Web Credentials: SAML Tokens"
    log_prerequisites = "Requires identity provider audit logs with SAML token metadata (Entra ID, Okta, ADFS)."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate service principals with extended token lifetimes, federated trust configuration changes by authorized administrators, emergency access accounts with elevated privileges."
    tuning_guidance = "Add known service principals with long-lived tokens to %global_allowed_service_accounts. Add authorized federation administrators to %global_allowed_admin_users. Adjust token lifetime threshold based on organizational policy."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.security_result.summary = /(?i)saml.*token/ or
      $auth.security_result.summary = /(?i)federation/ or
      $auth.target.application = /(?i)saml/ or
      $auth.network.application_protocol = "SAML"
    )
    (
      $auth.security_result.summary = /(?i)(lifetime|validity|duration).*(hour|day|week|month)/ or
      $auth.security_result.summary = /(?i)extended.*token/ or
      $auth.security_result.summary = /(?i)claim.*admin/ or
      $auth.security_result.summary = /(?i)claim.*global/ or
      $auth.security_result.summary = /(?i)privilege.*escalat/ or
      $auth.security_result.summary = /(?i)role.*admin/ or
      $auth.extensions.auth.auth_details = /(?i)notOnOrAfter/ or
      $auth.extensions.auth.auth_details = /(?i)accessTokenLifetime/
    )
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.target.application in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1606.002")
    $primary_entity = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
