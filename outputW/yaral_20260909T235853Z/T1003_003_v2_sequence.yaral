/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:25:01.939506+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_ShadowCopy_Then_NTDS_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage NTDS credential theft pattern: first a Volume Shadow Copy is created or accessed via a Windows built-in mechanism, then a file creation or copy event targeting the NTDS.dit database occurs on the same host within 10 minutes. This provides additive coverage beyond command-line matching by correlating the VSS staging event with the resulting file artefact."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires EDR or Sysmon telemetry normalised to UDM with PROCESS_LAUNCH and FILE_CREATION events. The EDR must capture file creation events including shadow copy mount paths and NTDS.dit copies."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised Active Directory backup solutions (Windows Server Backup, Veeam, Commvault) that legitimately snapshot VSS and copy NTDS.dit. Domain controller patching pipelines that invoke ntdsutil for authoritative restores."
    tuning_guidance = "Add backup agent process paths to %global_allowed_backup_processes and backup service accounts to %global_allowed_service_accounts to suppress authorised backup activity. Scope the rule to domain controller asset groups if your SIEM supports asset tagging."

  events:
    // Stage 1: VSS creation or shadow copy access via a Windows built-in
    // Matches vssadmin, wmic, powershell, or diskshadow invoking shadow copy operations
    $vss.metadata.event_type = "PROCESS_LAUNCH"
    (
      $vss.target.process.file.full_path = /\\vssadmin\.exe$/ nocase or
      $vss.target.process.file.full_path = /\\wmic\.exe$/ nocase or
      $vss.target.process.file.full_path = /\\diskshadow\.exe$/ nocase or
      $vss.target.process.file.full_path = /\\powershell\.exe$/ nocase or
      $vss.target.process.file.full_path = /\\pwsh\.exe$/ nocase
    )
    (
      $vss.target.process.command_line = /shadow/ nocase or
      $vss.target.process.command_line = /shadowcopy/ nocase or
      $vss.target.process.command_line = /shadowstorage/ nocase or
      $vss.target.process.command_line = /vssadmin/ nocase
    )
    not $vss.principal.process.file.full_path in %global_allowed_backup_processes
    not $vss.principal.user.userid in %global_allowed_service_accounts
    $vss.principal.hostname = $hostname

    // Stage 2: NTDS.dit file creation or copy artefact appears on the same host
    // Covers copies to temp dirs, shadow mount paths, or any non-standard location
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)ntds\.dit$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: VSS action precedes file artefact
    $vss.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($vss.principal.hostname)
    $vss_process = array_distinct($vss.target.process.file.full_path)
    $vss_commandline = array_distinct($vss.target.process.command_line)
    $ntds_copy_path = array_distinct($file.target.file.full_path)
    $actor_user = array_distinct($vss.principal.user.userid)
    $file_actor_user = array_distinct($file.principal.user.userid)

  condition:
    $vss and $file
}
