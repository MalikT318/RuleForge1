/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:06:22.254359+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_ProcessOpen_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-browser, non-system process opening a handle to a remote process (PROCESS_OPEN) followed by an outbound network connection from the same host within 5 minutes. Extra Window Memory injection requires a cross-process handle to write shellcode and redirect EWM pointers; the subsequent network connection suggests the injected payload establishing C2. This is additive coverage over command-line rules: it targets the handle-open and post-injection network behaviour rather than process creation arguments."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry that emits PROCESS_OPEN events (e.g. Sysmon Event ID 10) and NETWORK_CONNECTION events normalised into UDM. Both event types must be present for the correlation to fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), security agents opening process handles, RMM tools, backup agents, and AV/EDR products that routinely open handles to other processes. Approved security tooling should be added to %global_allowed_security_tools."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_security_tools and %global_allowed_admin_tools. Narrow the rule further by restricting target processes to high-value ones (lsass.exe, explorer.exe, svchost.exe) if false-positive volume is high. Consider raising the risk score if the opening process is also unsigned or running from a user-writable directory."

  events:
    // Event 1: A process opens a handle to another process (cross-process handle open)
    // This is the mechanism EWM injection uses to write into the target's address space.
    $open.metadata.event_type = "PROCESS_OPEN"
    // The opening process must not be a known security or admin tool
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    // Exclude common system paths to reduce noise from OS-internal handle opens
    not $open.principal.process.file.full_path = /(?i)^C:\\Windows\\System32\\(svchost|lsass|csrss|wininit|services|smss|winlogon|dwm|taskhostw|sihost|fontdrvhost|spoolsv|SearchIndexer|WmiPrvSE|dllhost|conhost|RuntimeBroker|ShellExperienceHost|StartMenuExperienceHost|ApplicationFrameHost|SystemSettings|MicrosoftEdge|msedge|chrome|firefox|iexplore)\.exe$/
    // The target of the handle open must be a GUI-capable or commonly targeted process
    // (processes that register window classes and therefore have EWM)
    $open.target.process.file.full_path = /(?i)\\(explorer|svchost|dwm|winlogon|csrss|RuntimeBroker|ShellExperienceHost|ApplicationFrameHost|taskhostw|sihost)\.exe$/
    // Bind the joining placeholder to the host
    $open.principal.hostname = $hostname

    // Event 2: An outbound network connection from the same host shortly after,
    // originating from a process that is NOT a known browser or system updater.
    // This represents the injected payload phoning home.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    // Exclude common browser and update processes that legitimately make external connections
    not $net.principal.process.file.full_path = /(?i)\\(msedge|chrome|firefox|iexplore|MicrosoftEdgeUpdate|MicrosoftEdge|OneDrive|Teams|Skype|outlook|svchost|wuauclt|UsoClient|TiWorker|SearchApp|WinStore\.App)\.exe$/
    // The network connection must be on a suspicious or commonly abused port
    // (exclude well-known update/browser ports to reduce noise)
    $net.target.port > 0
    $net.principal.hostname = $hostname

    // Chronological ordering: handle open must precede the network connection
    $open.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($open.principal.hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $network_destination_ips = array_distinct($net.target.ip)
    $network_destination_ports = array_distinct($net.target.port)
    $connecting_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $open and $net
}
