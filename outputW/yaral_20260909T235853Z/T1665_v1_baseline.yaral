/*
  MITRE Technique : T1665 - Hide Infrastructure
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:26:47.968927+00:00
  Reference       : https://attack.mitre.org/techniques/T1665
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1665_001_DNS_Long_Subdomain_High_Entropy_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS queries exhibiting characteristics of hidden C2 infrastructure: abnormally long subdomain labels, high-entropy algorithmically generated subdomains, or abuse of uncommon record types (TXT, NULL) commonly used for DNS tunneling and C2 channel concealment. Adversaries use these techniques to blend malicious traffic with legitimate DNS and evade infrastructure detection."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1665"
    mitre_technique_name = "Hide Infrastructure"
    log_prerequisites = "Requires DNS query/resolver logs normalised to UDM NETWORK_DNS events. Fields required: network.dns.questions.name, network.dns.questions.type, principal.hostname or principal.ip."
    platform = "Network Devices"
    log_source = "dns"
    false_positives = "CDN providers with long subdomain labels (e.g., Akamai, Cloudflare), legitimate TXT queries for SPF/DKIM/DMARC validation, automated monitoring systems performing bulk DNS lookups, cloud services with GUID-based hostnames."
    tuning_guidance = "Add known-good high-entropy domains (CDN, cloud, SaaS) to %global_allowed_domains. Adjust the subdomain length threshold in the regex if legitimate internal naming conventions exceed 50 characters. TXT-only detections can be scoped to external resolvers if internal mail infrastructure generates false positives."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"

    // Exclude known-good domains from detection
    not $dns.network.dns.questions.name in %global_allowed_domains

    // Exclude internal resolvers and scanners
    not $dns.principal.ip in %rfc1918_internal
    not $dns.principal.ip in %global_allowed_scanners

    (
      // Signal 1: Abnormally long subdomain label (>50 chars before first dot)
      // indicative of DNS tunneling or encoded C2 beacons
      $dns.network.dns.questions.name = /^[a-zA-Z0-9\-_]{50,}\.[a-zA-Z0-9\-\.]{3,}$/ nocase

      or

      // Signal 2: High-entropy subdomain pattern - long hex/base32/base64-like label
      // typical of DGA or encoded payload subdomains
      $dns.network.dns.questions.name = /^[a-f0-9]{32,}\.[a-zA-Z0-9\-\.]{3,}$/ nocase

      or

      // Signal 3: Multiple deeply nested subdomains (4+ labels) with long segments
      // characteristic of DNS exfiltration chunking data across labels
      $dns.network.dns.questions.name = /^[a-zA-Z0-9\-_]{10,}\.[a-zA-Z0-9\-_]{10,}\.[a-zA-Z0-9\-_]{5,}\.[a-zA-Z0-9\-_]{5,}\.[a-zA-Z]{2,}$/ nocase

      or

      // Signal 4: NULL record type query (type 10) - rarely used legitimately,
      // commonly abused for DNS C2 channel data transfer
      $dns.network.dns.questions.type = 10

      or

      // Signal 5: TXT record queries to non-apex, deeply nested subdomains
      // SPF/DKIM query at apex; TXT to long subdomains indicates C2 or tunneling
      (
        $dns.network.dns.questions.type = 16
        and $dns.network.dns.questions.name = /^[a-zA-Z0-9\-_]{20,}\.[a-zA-Z0-9\-\.]{4,}$/ nocase
      )
    )

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1665")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domain = array_distinct($dns.network.dns.questions.name)
    $query_type = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
