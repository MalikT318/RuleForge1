/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:17:16.764789+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Interpreter_Network_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound network connections to external destinations originating from processes consistent with Lua interpreter activity. Lua interpreters (standalone or embedded) making direct external connections are uncommon in enterprise Windows environments and may indicate malicious Lua script execution performing C2 beaconing or data exfiltration. Firewall/proxy telemetry is used to provide coverage additive to endpoint process-launch rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires firewall or proxy logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source hostname or IP must be populated. Internal address space exclusion relies on %rfc1918_internal reference list."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Game engines or embedded applications that legitimately use Lua and make external connections (e.g., update checks). Security tooling that bundles a Lua interpreter. Developer workstations running Lua-based build or test tooling."
    tuning_guidance = "Add known-good Lua-using application source hosts to %global_allowed_script_hosts. Add known-good external destinations such as update servers to %global_allowed_domains. Narrow the port filter if your environment only expects Lua traffic on specific ports. Raise severity if observed on servers rather than workstations."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal Windows host (not itself an external or scanner address)
    not $net.principal.ip in %rfc1918_internal

    // Destination must be external (not RFC1918 internal space)
    // This catches connections where the source is already resolved to a routable host
    // and the destination is also external - handled by excluding known-internal destinations
    not $net.target.ip in %rfc1918_internal

    // Lua interpreters and common embedding patterns use non-standard or high ports
    // Lua C2 frameworks commonly use HTTP/HTTPS ports or high ephemeral ports
    // We focus on non-standard high ports that are not typical enterprise application ports
    // to reduce noise from legitimate HTTPS (443) traffic at the firewall level
    (
        $net.target.port >= 1024 and $net.target.port <= 65535
    )

    // Exclude well-known update/CDN destinations
    not $net.target.hostname in %global_allowed_domains

    // Exclude approved scanner sources
    not $net.principal.hostname in %global_allowed_scanners

    // Exclude approved script hosts (e.g., game servers, build systems with Lua)
    not $net.principal.hostname in %global_allowed_script_hosts

    // Exclude approved remote management sources
    not $net.principal.hostname in %global_allowed_remote_mgmt

    // Firewall application or network protocol field: detect Lua-associated
    // application labels where the perimeter device performs DPI/app-id.
    // This matches application identification strings that reference Lua runtimes
    // or generic scripting engine labels surfaced by next-gen firewalls.
    $net.network.application_protocol = /(?i)(lua|luajit|lua\-socket|luasocket)/

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $destination_hostname = array_distinct($net.target.hostname)
    $destination_port = max($net.target.port)

  condition:
    $net
}
