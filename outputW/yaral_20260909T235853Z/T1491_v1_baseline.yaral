/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:53:42.278519+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_ESXi_MOTD_Banner_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi message-of-the-day or login banner files, commonly targeted for defacement attacks to display attacker messages or intimidation content."
    mitre_tactic = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "Requires ESXi shell command logging or file modification events from hostd."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorized banner customization by administrators, compliance-driven banner updates, automated configuration management tools."
    tuning_guidance = "Add authorized configuration management processes to %global_allowed_admin_tools and approved admin accounts to %global_allowed_admin_users."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    (
      $file.target.file.full_path = /\/etc\/issue/ nocase or
      $file.target.file.full_path = /\/etc\/motd/ nocase or
      $file.target.file.full_path = /\/etc\/vmware\/welcome/ nocase or
      $file.target.file.full_path = /\/etc\/ssh\/sshd_banner/ nocase
    )
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
