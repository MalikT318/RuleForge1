/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:08:05.602622+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Timer_File_Then_Service_Enable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation of a systemd .timer unit file outside of standard package-managed paths, followed by a systemctl enable or start command on the same host within 1 hour. This sequence is characteristic of an adversary installing a persistent systemd timer for scheduled malicious execution. Variant 2 of 2 for T1053.006 - focuses on the file-write-then-enable lifecycle rather than command-line arguments alone."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires Linux EDR or auditd telemetry producing FILE_CREATION and PROCESS_LAUNCH UDM events with full file paths and process command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate software packages writing systemd timer units during installation or upgrade (e.g., apt/dpkg, rpm, snap). Configuration management tools such as Ansible, Puppet, or Chef deploying scheduled jobs. Administrators manually creating timers for operational tasks."
    tuning_guidance = "Add known-good parent processes (package managers, CM agents) to %global_allowed_admin_tools. Add authorised service accounts that deploy timers to %global_allowed_service_accounts. Narrow the file path regex to exclude /usr/lib/systemd/system/ if package-manager noise is high in your environment."

  events:
    // Event 1: A .timer unit file is written to a systemd unit directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/systemd\/(system|user)\/[^\/]+\.timer$/ nocase
    // Exclude writes by known package managers and admin tooling
    not $file.principal.process.file.full_path = /\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper|snap|flatpak)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Event 2: systemctl is invoked to enable or start a timer/service on the same host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/systemctl$/
    $proc.target.process.command_line = /\b(enable|start|daemon-reload)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Chronological ordering: file write must precede or coincide with systemctl invocation
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($hostname)
    $timer_file_paths = array_distinct($file.target.file.full_path)
    $systemctl_cmdlines = array_distinct($proc.target.process.command_line)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
