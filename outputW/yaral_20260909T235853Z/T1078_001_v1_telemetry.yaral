/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:19:56.170599+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_Container_Default_Account_API_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud audit log events where a well-known container or Kubernetes default service account (e.g., default, system:serviceaccount:default, root) performs privileged API operations such as resource creation, permission changes, or sensitive resource access. Adversaries abuse default accounts that have not been rotated or restricted post-deployment to gain persistence or escalate privileges within container orchestration environments."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires cloud provider audit logs (e.g., GCP Audit, AWS CloudTrail, Azure Activity Logs) normalised into Chronicle UDM. Kubernetes API server audit logs forwarded to the cloud SIEM are also sufficient. No endpoint telemetry required."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Newly provisioned clusters where default accounts have not yet been replaced. Automated CI/CD pipelines that have not been updated to use dedicated service accounts. Infrastructure-as-code tooling running under default identities during initial bootstrap."
    tuning_guidance = "Add approved automation service account identifiers to %global_allowed_service_accounts. Add approved cloud principals to %global_allowed_cloud_principals. Narrow the principal.user.userid regex if your environment uses a consistent naming convention for legitimate default-named accounts."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match well-known default account patterns used in Kubernetes and cloud container environments.
    // Covers: "default", "system:serviceaccount:default:default", "root", "admin", "kubernetes-admin"
    // Uses inline (?i) flag because nocase is not valid inside re.regex().
    re.regex(
      $cloud.principal.user.userid,
      /(?i)^(default|root|admin|kubernetes\-admin|system:serviceaccount:[a-z0-9\-]+:default)$/
    )

    // Restrict to privileged or sensitive API operations that indicate meaningful abuse,
    // not just read-only list/get calls that might be routine health checks.
    (
      $cloud.target.resource.name = /(?i)(secret|configmap|clusterrolebinding|rolebinding|serviceaccount|pod|deployment|daemonset|namespace|persistentvolume)/
    )

    // Exclude known-good cloud principals and service accounts.
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude internal scanner or security tooling sources.
    not $cloud.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = "T1078.001"
    $primary_entity = $cloud.principal.user.userid

  condition:
    $cloud
}
