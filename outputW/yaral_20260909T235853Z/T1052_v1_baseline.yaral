/*
  MITRE Technique : T1052 - Exfiltration Over Physical Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:31:47.492604+00:00
  Reference       : https://attack.mitre.org/techniques/T1052
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_Exfiltration_Over_Removable_Media {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects bulk file copy operations targeting removable or external drive paths (e.g. E:\\ through Z:\\), which are characteristic of data exfiltration over a physical medium such as a USB drive or external hard disk. Focuses on command-line tools and scripting engines used to copy files to non-system drive letters."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1052"
    mitre_technique_name = "Exfiltration Over Physical Medium"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (Process Create) with full command-line logging enabled."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate backup software copying to external drives, IT imaging workflows, authorized data migration tasks, removable media used by approved backup agents."
    tuning_guidance = "Add authorized backup parent processes to %global_allowed_backup_processes. Restrict the drive-letter regex to letters not used by approved backup destinations in your environment. Consider narrowing to specific sensitive source paths if volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target process is a native copy/move utility or scripting engine
    // capable of bulk file transfer
    $proc.target.process.file.full_path = /\\(cmd\.exe|robocopy\.exe|xcopy\.exe|powershell\.exe|pwsh\.exe|wscript\.exe|cscript\.exe|mshta\.exe|bitsadmin\.exe)$/ nocase

    // Command line references a removable/external drive letter (E: through Z:)
    // System drives are typically A-D; E-Z strongly suggests removable media
    $proc.target.process.command_line = /[EeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvWwXxYyZz]:\\/ nocase

    // Command line contains a copy, move, or transfer verb
    $proc.target.process.command_line = /(\bcopy\b|\bmove\b|\brobocopy\b|\bxcopy\b|\bcp\b|Copy-Item|Move-Item|Start-BitsTransfer|\bdd\b)/ nocase

    // Exclude approved backup parent processes
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude approved administrative tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1052")
    $primary_entity = array_distinct($proc.principal.hostname)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
