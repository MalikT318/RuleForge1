/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:40:39.174700+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_004_Auditd_Config_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation or modification of Linux Audit system configuration and rules files (/etc/audit/audit.rules, /etc/audit/auditd.conf, /etc/audit/rules.d/*). Adversaries with root access may tamper with these files to disable or weaken audit logging, hiding malicious activity. This rule targets the resulting file artifact rather than the command line used to make the change, providing coverage that evades process-creation-only detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR or auditd file-watch telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events. Auditd must have a -w watch on /etc/audit/ with -p wa permissions, or the EDR agent must emit file-write events for that path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate auditd package upgrades (e.g., yum/apt updating audit package), authorised security hardening scripts, configuration management tools such as Ansible, Puppet, or Chef applying baseline audit rules."
    tuning_guidance = "Add known configuration-management service accounts to %global_allowed_service_accounts and known admin tooling paths to %global_allowed_admin_tools to suppress expected automation noise. Consider narrowing the rule to alert only when the modifying process is NOT a known package manager (rpm, dpkg, apt, yum, dnf)."

  events:
    $file.metadata.event_type in ["FILE_CREATION", "FILE_MODIFICATION"]

    // Target the canonical auditd configuration and rules file paths
    $file.target.file.full_path = /^\/etc\/audit\// nocase

    // Match the specific high-value files: main rules file, conf file, and drop-in rules directory
    (
      $file.target.file.full_path = /\/etc\/audit\/audit\.rules$/ nocase or
      $file.target.file.full_path = /\/etc\/audit\/auditd\.conf$/ nocase or
      $file.target.file.full_path = /\/etc\/audit\/rules\.d\// nocase
    )

    // Exclude known-good service accounts performing authorised changes
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude known configuration management and admin tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
