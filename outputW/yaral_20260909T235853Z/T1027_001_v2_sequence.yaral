/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:49:16.755098+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_LargeBinaryDroppedThenExecuted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a large file written to a user-writable or temp directory followed by execution of that same file within 5 minutes. Binary padding inflates file size to evade AV/EDR scanners and hash blocklists; this correlation catches the write-then-execute pattern without relying on command-line signatures or hashes."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Event ID 11) with file size populated in network.sent_bytes or a comparable size field, AND process-launch telemetry (Event ID 1 / PROCESS_LAUNCH). Both events must be normalised into UDM with principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate large installer packages dropped by software deployment tools (SCCM, Intune, PDQ), self-extracting archives, backup agents writing large restore images, game launchers patching binaries."
    tuning_guidance = "Add deployment and patching parent processes to %global_allowed_admin_tools. Add known software distribution service accounts to %global_allowed_service_accounts. Raise the file-size threshold if the environment routinely deploys large legitimate binaries via the same paths."

  events:
    // Event 1: A PE-like file is created in a user-writable or temp path.
    // We use FILE_CREATION and match on paths typical for binary-padding delivery.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\(temp|tmp|appdata|programdata|users\\[^\\]+\\downloads|users\\[^\\]+\\desktop|users\\[^\\]+\\documents)\\[^\\]+\.(exe|dll|bin|dat|scr|com|pif)$/
    // Filter out known-good deployment processes writing files
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    // Capture the written file path as the join key
    $file.target.file.full_path = $dropped_path
    $file.principal.hostname = $hostname

    // Event 2: The same file path is subsequently launched as a process.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $dropped_path
    $proc.principal.hostname = $hostname
    // Exclude known-good administrative and security tooling
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Enforce chronological ordering: file written before execution
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $dropped_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity = array_distinct($hostname)
    $dropped_file_path = array_distinct($dropped_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $file_write_time = min($file.metadata.event_timestamp.seconds)
    $exec_time = max($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
