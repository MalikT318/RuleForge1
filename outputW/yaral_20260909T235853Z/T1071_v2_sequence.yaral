/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:33:44.427741+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_Network_Device_Beaconing_Pattern {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects periodic beaconing from network device to external destination, indicating potential C2 channel over application layer protocol."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires firewall or proxy flow/connection logs with timestamp granularity."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate periodic polling to cloud management platforms, NTP servers, update services, monitoring endpoints."
    tuning_guidance = "Add known management destinations to %global_allowed_domains or %global_allowed_mgmt_sources. Adjust connection count threshold if environment has high legitimate periodic traffic."

  events:
    $conn1.metadata.event_type = "NETWORK_CONNECTION"
    $conn1.principal.asset.asset_type = /(?i)(router|switch|firewall|load.?balancer|network.?device)/
    not $conn1.target.ip in %rfc1918_internal
    not $conn1.target.hostname in %global_allowed_domains
    not $conn1.target.ip in %global_allowed_mgmt_sources
    $conn1.target.port != 123
    $conn1.target.port != 53
    $conn1.principal.hostname = $device
    $conn1.target.ip = $destination

    $conn2.metadata.event_type = "NETWORK_CONNECTION"
    $conn2.principal.asset.asset_type = /(?i)(router|switch|firewall|load.?balancer|network.?device)/
    not $conn2.target.ip in %rfc1918_internal
    not $conn2.target.hostname in %global_allowed_domains
    not $conn2.target.ip in %global_allowed_mgmt_sources
    $conn2.target.port != 123
    $conn2.target.port != 53
    $conn2.principal.hostname = $device
    $conn2.target.ip = $destination

    $conn1.metadata.event_timestamp.seconds < $conn2.metadata.event_timestamp.seconds
    $conn2.metadata.event_timestamp.seconds - $conn1.metadata.event_timestamp.seconds >= 30
    $conn2.metadata.event_timestamp.seconds - $conn1.metadata.event_timestamp.seconds <= 180

  match:
    $device, $destination over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($conn1.principal.hostname)
    $beacon_destination = array_distinct($destination)
    $destination_ports = array_distinct($conn1.target.port, $conn2.target.port)
    $connection_count = count($conn1.metadata.event_timestamp.seconds)

  condition:
    $conn1 and $conn2 and #conn1 >= 3
}
