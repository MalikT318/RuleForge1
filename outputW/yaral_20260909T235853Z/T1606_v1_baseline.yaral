/*
  MITRE Technique : T1606 - Forge Web Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:19:36.336173+00:00
  Reference       : https://attack.mitre.org/techniques/T1606
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_Forge_Web_Credentials_Network_Observable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable indicators of forged web credential usage: repeated authentication attempts to cloud identity or SaaS endpoints from a single source using short-lived or anomalous token patterns, or connections to federation/token issuance endpoints from unexpected sources. Forged credentials (SAML tokens, JWT, OAuth tokens) typically result in authentication flows that bypass normal login pages and hit token validation or federation endpoints directly."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606"
    mitre_technique_name = "Forge Web Credentials"
    log_prerequisites = "Requires firewall or proxy logs with HTTP metadata including URL paths, response codes, and source/destination IP. Proxy logs with full URI are preferred for highest fidelity."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate SSO/federation integrations, automated service accounts performing token refresh, CI/CD pipelines authenticating to cloud APIs, vulnerability scanners probing auth endpoints."
    tuning_guidance = "Add known-good service account source IPs or identity provider addresses to %global_allowed_scanners or %global_allowed_cloud_principals. Narrow the URL pattern if specific federation products are in scope. Raise risk_score if source is external and not in %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Target federation, token issuance, or SAML assertion endpoints
    // These are the network-observable paths hit when forged credentials are presented
    $net.target.url = /(?i)\/(oauth|token|saml|federation|adfs|auth|sts|sso|assertion|wsfed|openid|connect|authorize|realms|protocol\/openid-connect|GetFederationToken|AssumeRole|AssumeRoleWithSAML|AssumeRoleWithWebIdentity)/

    // HTTP 200 or 302 on auth endpoints from unexpected sources indicates successful
    // credential acceptance - forged tokens often succeed where stolen creds would fail MFA
    (
      $net.network.http.response_code = 200 or
      $net.network.http.response_code = 302
    )

    // Exclude known internal management sources (approved federation infrastructure)
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude known-good cloud/identity service principals
    not $net.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known-good external domains (CDN, vendor update services)
    not $net.target.hostname in %global_allowed_domains

    // Exclude internal-to-internal traffic (internal IdP serving internal clients is expected)
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1606")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_auth_url = array_distinct($net.target.url)
    $target_host = array_distinct($net.target.hostname)
    $http_response = max($net.network.http.response_code)

  condition:
    $net
}
