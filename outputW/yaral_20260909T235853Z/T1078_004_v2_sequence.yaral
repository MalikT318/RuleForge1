/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:22:26.079207+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_Cloud_Account_Login_Then_Privilege_Escalation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud/identity account that successfully authenticates and then, within 1 hour, is granted elevated permissions or added to a privileged group. This pattern is consistent with adversaries leveraging compromised cloud accounts to escalate privileges or establish persistence via identity provider audit logs."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires identity provider sign-in logs and directory audit logs normalised to UDM USER_LOGIN and USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION events. Tested against Entra ID and Okta UDM feeds."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate onboarding workflows where a new account is provisioned and immediately granted a role; automated identity governance tooling; break-glass account activation by authorised administrators."
    tuning_guidance = "Add known automation and provisioning service accounts to %global_allowed_service_accounts. Add authorised admin users who routinely self-elevate to %global_allowed_admin_users. Narrow the match window if false-positive volume is high."

  events:
    // Event 1: Successful cloud account login
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.summary = /success/ nocase
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    $auth.principal.user.userid = $cloud_user

    // Event 2: Privilege change or group modification targeting the same user
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $priv.target.user.userid = $cloud_user
    not $priv.principal.user.userid in %global_allowed_service_accounts
    not $priv.target.user.userid in %global_allowed_admin_users

    // Chronological ordering: login must precede the privilege change
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $cloud_user over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($cloud_user)
    $auth_principal_hostname = array_distinct($auth.principal.hostname)
    $priv_actor = array_distinct($priv.principal.user.userid)
    $login_count = count($auth.metadata.event_timestamp.seconds)
    $privilege_change_count = count($priv.metadata.event_timestamp.seconds)

  condition:
    $auth and $priv
}
