/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:36:04.240630+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_Clipboard_Access_Via_PowerShell_Or_Clip {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects process execution accessing clipboard data via PowerShell Get-Clipboard cmdlet or clip.exe, excluding approved automation tools."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires EDR process telemetry or PowerShell script-block logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate automation scripts, password managers, clipboard management utilities, remote support tools, developer IDEs with clipboard integration."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_script_hosts or specific clipboard utilities to %global_allowed_admin_tools."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        $proc.target.process.command_line = /get-clipboard/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\clip\.exe$/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
