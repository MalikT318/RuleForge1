/*
  MITRE Technique : T1651 - Cloud Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:24:56.807374+00:00
  Reference       : https://attack.mitre.org/techniques/T1651
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1651_Cloud_Admin_Command_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects use of cloud management services (e.g., AWS SSM RunCommand, Azure RunCommand, GCP OS Config) to execute commands inside virtual machines via cloud control-plane APIs. Adversaries with administrative cloud access can abuse these services to run arbitrary scripts on VMs without direct SSH/RDP access."
    mitre_tactic = "Execution"
    mitre_technique = "T1651"
    mitre_technique_name = "Cloud Administration Command"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). The target.resource.name or metadata.product_event_type fields must be populated with the management API call details."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate IT operations using SSM Run Command, Azure RunCommand, or GCP OS Config for patch management, configuration management, or automated remediation. Authorised DevOps pipelines and runbooks. Scheduled maintenance scripts executed by approved service accounts."
    tuning_guidance = "Add approved automation and service account identifiers to %global_allowed_service_accounts. Add approved cloud management principals to %global_allowed_cloud_principals. Consider scoping to specific high-value resource groups or AWS accounts if noise is high. Alert on executions outside business hours or from unexpected source locations."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match cloud VM command execution API calls across major providers:
    // AWS: ssm:SendCommand, ssm:StartSession
    // Azure: Microsoft.Compute/virtualMachines/runCommand/action
    // GCP: osconfig.googleapis.com patch/exec, compute.instances.setMetadata used for startup scripts
    $cloud.metadata.product_event_type = /(?i)(SendCommand|StartSession|runCommand|RunShellScript|RunPowerShellScript|patchJobs\.execute|osconfig|StartAutomationExecution|InvokeRunbook|runShellScript|runPowerShellScript|executeCommand|StartRunbook)/

    // Ensure a principal (human or service) is identified
    $cloud.principal.user.userid != ""

    // Exclude known-good automation service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good cloud management principals (e.g., approved CICD pipelines)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Capture the target resource for context
    $cloud.target.resource.name != ""

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1651")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $api_call = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
