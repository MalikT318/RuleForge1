/*
  MITRE Technique : T1074.002 - Remote Data Staging
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:32:59.150483+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_002_Remote_Data_Staging_Network_Exfil_Prep {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects large outbound data transfers to external destinations that may indicate staged data being exfiltrated after remote collection. Adversaries staging data from multiple systems often produce high-volume, sustained outbound flows to a single external host. Targets firewall/perimeter telemetry for the network-observable phase of T1074.002."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.002"
    mitre_technique_name = "Data Staged: Remote Data Staging"
    log_prerequisites = "Requires firewall or perimeter flow logs with bytes_sent/network.sent_bytes populated. Flows must be exported with per-session byte counts."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised backup jobs, cloud sync agents (OneDrive, Dropbox), software update distribution, large file transfers to known CDN or vendor endpoints, vulnerability scanner traffic."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add authorised backup source IPs or scanner IPs to %global_allowed_backup_processes or %global_allowed_scanners. Raise the bytes threshold if the environment has legitimate high-volume egress. Exclude known management sources via %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Outbound only - destination must be external (not RFC1918)
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external destinations
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanners and backup sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Large outbound byte count indicative of staged data transfer
    // Threshold: 50 MB per session - tune upward for high-egress environments
    $net.network.sent_bytes >= 52428800

    // Target common exfiltration-capable ports: HTTPS, HTTP, FTP, SFTP, custom high ports
    // Broad port filter - adversaries use 443/80 to blend in, or high ports for custom C2
    (
      $net.target.port = 443 or
      $net.target.port = 80 or
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port >= 1024
    )

    // Capture source host for grouping and outcome
    $net.principal.hostname = $src_host

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1074.002")
    $primary_entity = array_distinct($src_host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hostnames = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
