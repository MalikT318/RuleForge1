/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:48:59.989486+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Socket_Filter_Backdoor_Network_Trigger {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects inbound network connections to uncommon high ports from external sources that may trigger socket filter backdoors. Socket filters listen passively on network interfaces and activate payloads when receiving crafted packets matching specific criteria."
    mitre_tactic = "Command and Control, Persistence, Defense Evasion"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Requires firewall or network perimeter logs with source/destination IP and port visibility."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate external management connections to non-standard ports, peer-to-peer applications, custom business applications with external access requirements, vulnerability scanners."
    tuning_guidance = "Add authorized external management sources to %global_allowed_mgmt_sources. Exclude known application ports. Monitor for repeated single-packet connections from the same external source to multiple internal hosts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    $net.target.port >= 49152
    $net.target.port <= 65535
    $net.network.sent_bytes < 500
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity = array_distinct($net.target.ip)

  condition:
    $net
}
