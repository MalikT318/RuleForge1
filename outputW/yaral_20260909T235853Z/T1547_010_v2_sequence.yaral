/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:15:35.471931+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_PortMonitor_Registry_Then_DLL_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the two-stage Port Monitor persistence technique: a new subkey is written under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors followed by a DLL being created in the System32 directory from the same host within 10 minutes. The print spooler (spoolsv.exe) will load the registered DLL at next boot under SYSTEM privileges."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires EDR or Sysmon registry and file telemetry normalised to UDM REGISTRY_MODIFICATION/REGISTRY_CREATION and FILE_CREATION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver installations (e.g., HP, Xerox, Canon) that register a custom port monitor DLL. Software deployment tools pushing print infrastructure. Patch management agents updating spooler components."
    tuning_guidance = "Add known-good printer driver installer processes to %global_allowed_admin_tools. Add authorised software deployment service accounts to %global_allowed_service_accounts. Scope the DLL path regex more tightly if only specific monitor names are expected in your environment."

  events:
    // Event 1: Registry modification creating or updating a Port Monitor Driver value
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors\\/  nocase
    $reg.target.registry.registry_value_name = /(?i)^Driver$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: DLL file created in System32 (where spoolsv.exe will load it from)
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\[^\\]+\.dll$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Chronological ordering: registry write precedes or coincides with DLL drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $monitor_registry_key = array_distinct($reg.target.registry.registry_key)
    $dropped_dll_path = array_distinct($file.target.file.full_path)
    $writing_process_reg = array_distinct($reg.principal.process.file.full_path)
    $writing_process_file = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $file
}
