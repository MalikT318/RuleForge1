/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:03:05.863625+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_002_Linux_Decode_Then_Write_Suspicious_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage deobfuscation pattern on Linux: a decode/decompress utility (base64, openssl, xxd, gunzip, zcat, python/perl one-liner) runs and is shortly followed by a file being written to a suspicious staging path (/tmp, /dev/shm, /var/tmp, /run). This sequence is additive coverage over command-line-only rules and targets the file artefact produced by the decode step."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM PROCESS_LAUNCH and FILE_CREATION events. Auditd rules should capture execve and file write syscalls."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate software installers that unpack to /tmp, developer tooling (pip, npm, cargo), backup agents writing compressed archives, container image build steps."
    tuning_guidance = "Add known-good parent processes to %global_allowed_backup_processes or %global_allowed_admin_tools. Narrow the file path regex to exclude specific installer staging directories if false-positive volume is high."

  events:
    // Event 1: a decode/decompress utility launches on the host
    $dec.metadata.event_type = "PROCESS_LAUNCH"
    $dec.target.process.file.full_path = /\/(base64|openssl|xxd|gunzip|bunzip2|zcat|unzip|python[23]?|perl|ruby|php)$/ nocase
    not $dec.principal.process.file.full_path in %global_allowed_backup_processes
    not $dec.principal.process.file.full_path in %global_allowed_admin_tools
    $dec.principal.hostname = $hostname

    // Event 2: a file is created in a suspicious staging path on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|dev\/shm|var\/tmp|run)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Chronological ordering: decode runs before the file appears
    $dec.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($dec.principal.hostname)
    $decode_process = array_distinct($dec.target.process.file.full_path)
    $decode_cmdline = array_distinct($dec.target.process.command_line)
    $written_file_path = array_distinct($file.target.file.full_path)
    $parent_process = array_distinct($dec.principal.process.file.full_path)

  condition:
    $dec and $file
}
