/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:16:19.031417+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Weaken_Encryption_Network_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable signals of weakened or disabled encryption on network devices. Specifically targets connections using known weak cipher suites, deprecated protocol versions (SSLv2, SSLv3, TLS 1.0, TLS 1.1), or cleartext protocols (Telnet, HTTP, FTP) on management-plane ports where encrypted equivalents are expected. This may indicate an adversary has manipulated device encryption capabilities per T1600."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Requires firewall or perimeter logs with TLS inspection metadata, or flow records capturing protocol and port information. TLS version and cipher suite fields must be populated by the log source."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy devices or embedded systems that only support older TLS versions; internal monitoring systems using Telnet for legacy polling; load balancer health checks over HTTP on management ports; authorized vulnerability scanner activity."
    tuning_guidance = "Add known legacy device source IPs to %global_allowed_scanners for scanner exclusions. Add authorized management source addresses to %global_allowed_mgmt_sources. Narrow the port list if management ports differ from defaults in your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Detect cleartext management-plane protocols (Telnet=23, FTP=21, HTTP=80)
    // or connections on management ports using weak/deprecated TLS
    // Target management-plane and data-plane ports associated with encryption negotiation
    (
      // Cleartext management protocols that should be encrypted
      $net.target.port = 23 or   // Telnet - should be SSH
      $net.target.port = 21 or   // FTP control - should be SFTP/FTPS
      $net.target.port = 80      // HTTP management - should be HTTPS
    )

    // Exclude known authorised management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude internal scanner/assessment traffic
    not $net.principal.ip in %global_allowed_scanners

    // Exclude internal RFC1918 source ranges that are expected management subnets
    not $net.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
