/*
  MITRE Technique : T1052.001 - Exfiltration over USB
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:32:03.746704+00:00
  Reference       : https://attack.mitre.org/techniques/T1052/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_USB_Exfiltration_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file write or copy operations targeting USB-mounted media on Linux systems. Adversaries may stage or copy sensitive data to a USB device as a final exfiltration step, particularly in air-gapped or restricted environments. This rule fires on FILE_CREATION events where the target path resolves to a typical USB mount point under /media, /mnt, or /run/media."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052.001"
    mitre_technique_name = "Exfiltration Over Physical Medium: Exfiltration over USB"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION events. The agent must populate target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Authorised data transfers to USB drives by IT staff, backup operations writing to removable media, OS-level automount test writes, and media-import workflows (e.g., photo import daemons)."
    tuning_guidance = "Add known-good backup or media-management process paths to %global_allowed_backup_processes. Add authorised service accounts that perform sanctioned USB transfers to %global_allowed_service_accounts. Consider narrowing the rule to specific sensitive source directories by adding a principal.process.file.full_path filter for shells or data-handling tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target path must resolve to a USB removable media mount point.
    // Linux automount daemons (udisks2, udev, gvfs) use /media, /run/media, or /mnt.
    $file.target.file.full_path = /^\/(?:media|mnt|run\/media)\// nocase

    // Exclude kernel and automount housekeeping files that appear at mount time.
    not $file.target.file.full_path = /\/\.(?:Trash|gvfs|dbus|autorun|metadata_never_index)/ nocase
    not $file.target.file.full_path = /\/\.(?:DS_Store|Spotlight|fseventsd)/ nocase

    // Exclude known-good backup processes writing to removable media.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude authorised service accounts performing sanctioned transfers.
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1052.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $target_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
