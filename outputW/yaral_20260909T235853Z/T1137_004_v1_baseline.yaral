/*
  MITRE Technique : T1137.004 - Outlook Home Page
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:41:41.537646+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_004_Outlook_Home_Page_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Outlook folder Home Page registry keys, a persistence mechanism that causes Outlook to load an attacker-controlled URL when a folder is opened. The WebView registry subkey under Outlook folder definitions controls this feature."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.004"
    mitre_technique_name = "Office Application Startup: Outlook Home Page"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry normalised to UDM REGISTRY_MODIFICATION events. Windows Registry auditing must be enabled for HKCU\\Software\\Microsoft\\Office\\*\\Outlook\\WebView."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Outlook folder customisation by enterprise IT teams, SharePoint or intranet portal integrations that configure Outlook folder home pages via GPO or deployment scripts."
    tuning_guidance = "Add authorised deployment accounts to %global_allowed_admin_users and authorised parent processes (e.g. GPO client, deployment agents) to %global_allowed_admin_tools. Consider scoping to interactive user sessions by excluding known service account SIDs via %global_allowed_service_accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the WebView subkey under any Outlook version profile
    // Matches: HKCU\Software\Microsoft\Office\<version>\Outlook\WebView\<FolderName>
    $reg.target.registry.registry_key = /(?i)\\Software\\Microsoft\\Office\\[0-9]+\.[0-9]+\\Outlook\\WebView\\/

    // The URL value is the primary indicator - adversaries set this to their payload
    (
      $reg.target.registry.registry_value_name = /(?i)^URL$/ or
      $reg.target.registry.registry_value_name = /(?i)^HomePage$/
    )

    // Exclude writes originating from known administrative tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service and automation accounts
    not $reg.principal.user.userid in %global_allowed_service_accounts

    // Exclude known admin users performing authorised configuration
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
