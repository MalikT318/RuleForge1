/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:11:39.102919+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_Loads_Assembly_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "PowerShell loads .NET reflection assembly followed by external network connection, indicating in-memory payload execution or C2 communication."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires EDR module-load telemetry and network connection events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate PowerShell scripts using Invoke-WebRequest or Invoke-RestMethod for API calls, software deployment tools, monitoring agents using PowerShell for data collection."
    tuning_guidance = "Add approved automation scripts to %global_allowed_script_hosts or whitelist known management source IPs in %global_allowed_mgmt_sources."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $mod.target.file.full_path = /\\system\.reflection\.assembly\.dll$/ nocase
    $mod.principal.hostname = $hostname
    $mod.target.process.pid = $pid

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_domains
    $net.principal.hostname = $hostname
    $net.principal.process.pid = $pid

    $mod.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $powershell_path = array_distinct($mod.target.process.file.full_path)

  condition:
    $mod and $net
}
