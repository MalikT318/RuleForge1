/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:18:45.858823+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_ESXi_Shell_Login_Then_Net_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects an interactive shell login to an ESXi host followed by a network connectivity discovery process (ping, traceroute, nc, curl, wget, esxcli network) launched within 10 minutes. This sequence is additive coverage over command-line-only rules: it correlates the authentication event with the subsequent discovery activity, raising confidence that a human operator or adversary is actively probing outbound connectivity from the hypervisor shell."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires ESXi shell/SSH authentication events (USER_LOGIN) and ESXi shell process launch events (PROCESS_LAUNCH) forwarded to Chronicle via syslog or the VMware ESXi log source. Both event types must be normalised to UDM by the Chronicle parser."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised ESXi administrators performing routine connectivity checks, automated health-monitoring scripts running under service accounts, VMware support sessions."
    tuning_guidance = "Add known service and automation account identifiers to %global_allowed_service_accounts. Add approved management source addresses to %global_allowed_mgmt_sources. Raise severity if the login source IP is external (not in %rfc1918_internal)."

  events:
    // Event 1: Interactive login to the ESXi shell or SSH service
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $esxi_host
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Event 2: A network discovery process launched on the same ESXi host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $esxi_host
    $proc.target.process.file.full_path = /\/(ping|ping6|traceroute|traceroute6|tracepath|nc|ncat|curl|wget|esxcli)$/ nocase
    // Narrow to invocations that probe outbound/internet connectivity
    $proc.target.process.command_line = /(\-c\s+\d|\-n\s+\d|network\s+diag|network\s+ip\s+route|http|https|traceroute|tracepath|nc\s+\-z)/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: login must precede the discovery command
    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $esxi_host over 10m

  outcome:
    $risk_score          = max(72)
    $mitre_technique_id  = array_distinct("T1016.001")
    $primary_entity      = array_distinct($esxi_host)
    $actor_userid        = array_distinct($auth.principal.user.userid)
    $login_source_ip     = array_distinct($auth.principal.ip)
    $discovery_commands  = array_distinct($proc.target.process.command_line)
    $discovery_binaries  = array_distinct($proc.target.process.file.full_path)

  condition:
    $auth and $proc
}
