/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:07:16.683292+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_ProcessHollowing_SuspendedChildThenProcessOpen {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process hollowing sequence: a non-shell parent spawns a known hollowing-target process (e.g. svchost, notepad, explorer, regsvr32) followed shortly by a PROCESS_OPEN handle acquisition targeting that same child process from the same parent host. This two-event join covers the CreateProcess(suspended) + VirtualAllocEx/WriteProcessMemory handle-open phase without relying on command-line strings, providing additive coverage over existing PROCESS_LAUNCH command-line rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires EDR or Sysmon telemetry normalised to UDM PROCESS_LAUNCH and PROCESS_OPEN events. Sysmon Event IDs 1 (process create) and 10 (process access) are the primary sources. CrowdStrike, Defender for Endpoint, and SentinelOne all emit equivalent telemetry."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software that programmatically launches and then immediately inspects child processes (e.g. some JVM launchers, crash-reporting frameworks, application virtualisation wrappers). Security tooling such as EDR agents may also open handles to child processes for monitoring."
    tuning_guidance = "Add confirmed-benign parent process paths to %global_allowed_security_tools or %global_allowed_admin_tools. If a specific host generates persistent false positives, add it to %global_allowed_script_hosts as a suppression anchor and review the parent binary."

  events:
    // Event 1: A suspicious parent spawns a well-known hollowing-target process.
    // We deliberately exclude common shells/interpreters as parents because those
    // are already covered by the existing PROCESS_LAUNCH rule variant 1.
    $launch.metadata.event_type = "PROCESS_LAUNCH"

    // Target child must be a canonical hollowing victim (system binaries used as
    // sacrificial processes). Regex is anchored to the filename only.
    $launch.target.process.file.full_path = /(?i)\\(svchost|notepad|explorer|regsvr32|rundll32|dllhost|msiexec|werfault|conhost|calc|mspaint)\.exe$/

    // Parent must NOT itself be a known-good system launcher for these binaries.
    // services.exe, wininit.exe, and smss.exe legitimately spawn svchost etc.
    not $launch.principal.process.file.full_path = /(?i)\\(services|wininit|smss|csrss|wuauclt|msiexec|TrustedInstaller|svchost)\.exe$/

    // Exclude approved tooling parents.
    not $launch.principal.process.file.full_path in %global_allowed_admin_tools
    not $launch.principal.process.file.full_path in %global_allowed_security_tools

    $launch.principal.hostname = $hostname
    $launch.target.process.pid = $child_pid

    // Event 2: The same host opens a handle to a process shortly after launch.
    // PROCESS_OPEN is the UDM event type for handle-acquisition (Sysmon Event 10).
    $open.metadata.event_type = "PROCESS_OPEN"

    // The handle opener must NOT be a known security or backup tool.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // The opened target process must match the same child PID spawned above,
    // confirming the opener is reaching into the newly created process.
    $open.target.process.pid = $child_pid

    $open.principal.hostname = $hostname

    // Chronological ordering: launch must precede the handle open.
    $launch.metadata.event_timestamp.seconds <= $open.metadata.event_timestamp.seconds

  match:
    $hostname, $child_pid over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($launch.principal.hostname)
    $parent_process = array_distinct($launch.principal.process.file.full_path)
    $hollowed_target = array_distinct($launch.target.process.file.full_path)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $event_count = count($open.metadata.event_timestamp.seconds)

  condition:
    $launch and $open
}
