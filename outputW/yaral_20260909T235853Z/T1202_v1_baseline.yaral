/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:46:15.765464+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_001_Indirect_Command_Execution_LOLBin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects indirect command execution via Windows utilities that can invoke programs or shell commands without directly calling cmd.exe or powershell.exe. Covers forfiles.exe, pcalua.exe, scriptrunner.exe, ssh.exe (ProxyCommand/LocalCommand), and similar LOLBins used to bypass command-line restrictions and monitoring controls."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line logging enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate use of forfiles.exe in scheduled maintenance scripts, pcalua.exe for compatibility shims, ssh.exe ProxyCommand in developer or DevOps workflows, scriptrunner.exe in authorized deployment pipelines."
    tuning_guidance = "Add known-good parent processes or script hosts to %global_allowed_script_hosts. Add authorized admin tooling to %global_allowed_admin_tools. Narrow scope by requiring a suspicious child process or external network connection in a correlated rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match known indirect execution utilities by filename
    $proc.target.process.file.full_path = /\\(forfiles|pcalua|scriptrunner|wsl|wslhost|bash|ssh)\.exe$/  nocase

    // Require at least one indicator of command redirection or execution chaining
    // forfiles /c, pcalua -a, scriptrunner -appcompat, ssh -o ProxyCommand/LocalCommand
    $proc.target.process.command_line = /(\s\/[cC]\s|\s\-a\s|\-appcompat|\-o\s*(ProxyCommand|LocalCommand)|\s\-\-\s|\s&&\s|\s\|\s|\s;\s|cmd\.exe|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|msiexec)/ nocase

    // Exclude known-good administrative and script host parents
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($proc.principal.hostname)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $username = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
