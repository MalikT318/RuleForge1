/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:39:09.331022+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_M365_Mailbox_Audit_Bypass_Or_Audit_Disable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects configuration changes in M365 that disable or bypass mailbox auditing, disable Advanced Auditing, or modify tenant-level audit log settings. Adversaries with sufficient permissions may suppress audit telemetry to conceal mail collection or other malicious activity. This rule targets the resulting setting-change event rather than the command line used to invoke it, providing coverage that is harder to evade."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Log"
    log_prerequisites = "Requires M365 Unified Audit Log ingested into Chronicle. Relevant operations include Set-MailboxAuditBypassAssociation, Set-AdminAuditLogConfig, Set-OrganizationConfig, and license-downgrade events. Ensure UAL collection is enabled at the tenant level and forwarded to Chronicle."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Authorized IT administrators performing licensed downgrade migrations, bulk mailbox provisioning scripts, or approved audit-policy changes during change-management windows."
    tuning_guidance = "Add known administrative service accounts to %global_allowed_service_accounts. Add approved automation principals to %global_allowed_cloud_principals. Scope alerts to non-change-window hours using timestamp.get_hour() if needed."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"

    // Match audit-suppression operations by targeting the resource or operation
    // name patterns that M365 UAL normalises into UDM setting fields.
    // Chronicle normalises the M365 operation name into target.resource.name
    // and the affected object into target.resource.attribute.labels values.
    (
      $setting.target.resource.name = /(?i)mailboxauditbypass/ or
      $setting.target.resource.name = /(?i)adminauditlog/ or
      $setting.target.resource.name = /(?i)organizationconfig/ or
      $setting.target.resource.name = /(?i)auditlog/ or
      $setting.target.resource.name = /(?i)unifiedauditlog/ or
      // Catch license-downgrade events that strip Advanced Auditing
      $setting.target.resource.name = /(?i)licenseassign/
    )

    // Narrow to changes that disable, bypass, or reduce audit coverage.
    // Chronicle maps the new value or parameter into security_result.description
    // or target.resource.attribute.labels; match the disable/bypass semantics.
    (
      $setting.security_result.description = /(?i)(disable|bypass|false|remove|downgrade|strip|suppress|off)/ or
      $setting.target.resource.attribute.labels.value = /(?i)(disable|bypass|false|remove|downgrade|strip|suppress|off)/
    )

    // Exclude approved service and automation accounts
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $affected_resource = array_distinct($setting.target.resource.name)
    $actor_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
