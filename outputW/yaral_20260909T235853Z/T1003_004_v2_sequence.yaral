/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:25:35.807503+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Registry_Access_Then_Exfil_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage LSA Secrets harvesting pattern: (1) a privileged process opens or modifies the HKLM\\SECURITY\\Policy\\Secrets registry hive, followed within 10 minutes by (2) creation of a file with naming patterns consistent with credential dumping output on the same host. This provides additive coverage beyond command-line detections by correlating registry access with artifact staging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 12/13/14 or equivalent UDM REGISTRY_MODIFICATION) and file creation telemetry (Event ID 11 or equivalent UDM FILE_CREATION). Registry auditing for HKLM\\SECURITY must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup agents reading the SECURITY hive, domain join operations, some AV/EDR products performing credential hygiene checks, Windows LSASS during normal policy refresh."
    tuning_guidance = "Add known backup and security agent process paths to %global_allowed_backup_processes and %global_allowed_security_tools. Scope file path regex more tightly if specific dump-staging directories are known in your environment."

  events:
    // Stage 1: Registry access to the LSA Secrets key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\HKEY_LOCAL_MACHINE\\SECURITY\\Policy\\Secrets/
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    // Stage 2: File creation consistent with credential dump staging
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(lsa|secret|cred|dump|ntds|sam|security|hive|reg\.save)/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    // Enforce chronological ordering
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys_accessed = array_distinct($reg.target.registry.registry_key)
    $dump_files_created = array_distinct($file.target.file.full_path)
    $registry_processes = array_distinct($reg.principal.process.file.full_path)
    $file_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
