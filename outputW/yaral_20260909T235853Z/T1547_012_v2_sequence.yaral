/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:16:10.147376+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_PrintProcessor_Registry_Then_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the two-stage print processor persistence technique: a registry key is written under the Print Processors path (registering a new processor DLL) followed by a DLL being dropped into the system print-processor directory on the same host within 10 minutes. The print spooler runs as SYSTEM, so a successful install yields SYSTEM-level code execution at boot."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires EDR or Sysmon registry-modification and file-creation telemetry normalised into Chronicle UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver installation packages (e.g., vendor print management software) may write to the Print Processors registry path and drop DLLs into the spool directory. Patch management or imaging tools may also trigger this sequence."
    tuning_guidance = "Add known-good printer management parent processes to %global_allowed_admin_tools. Add authorised service accounts that perform driver deployment to %global_allowed_service_accounts."

  events:
    // Event 1: Registry key creation or modification under the Print Processors path
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\(CurrentControlSet|ControlSet001)\\Control\\Print\\Environments\\Windows (x64|x86)\\Print Processors\\/
    $reg.target.registry.registry_value_name = /(?i)driver/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: DLL file creation in the system print-processor spool directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\spool\\prtprocs\\w64\\.+\.dll$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Chronological ordering: registry write must precede or coincide with file drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys_written = array_distinct($reg.target.registry.registry_key)
    $dll_paths_dropped = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($reg.principal.process.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $file
}
