/*
  MITRE Technique : T1671 - Cloud Application Integration
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:28:20.561803+00:00
  Reference       : https://attack.mitre.org/techniques/T1671
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1671_001_OAuth_App_Consent_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects OAuth application consent grants in Microsoft 365, a primary persistence mechanism where adversaries register or co-opt an OAuth application and obtain user or admin consent to maintain access to tenant data even after account compromise or MFA enforcement."
    mitre_tactic = "Persistence"
    mitre_technique = "T1671"
    mitre_technique_name = "Cloud Application Integration"
    log_prerequisites = "Requires Microsoft 365 unified audit logs ingested into Chronicle UDM. Relevant operations include consent grants, OAuth app additions, and service principal creation events."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate IT-approved OAuth application onboarding, enterprise app deployments by authorized administrators, and vendor-managed integrations. Admin consent grants during planned software rollouts are expected."
    tuning_guidance = "Add known-approved service principals and automation accounts to %global_allowed_cloud_principals. Add authorized admin accounts performing planned app deployments to %global_allowed_admin_users. Consider scoping to high-privilege scope grants (e.g., Mail.ReadWrite, Files.ReadWrite.All) if audit logs surface scope details in resource fields."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    (
      $cloud.metadata.product_event_type = /(?i)consent to application/ or
      $cloud.metadata.product_event_type = /(?i)add oauth2permissiongrant/ or
      $cloud.metadata.product_event_type = /(?i)add service principal/ or
      $cloud.metadata.product_event_type = /(?i)add application/ or
      $cloud.metadata.product_event_type = /(?i)update application/ or
      $cloud.metadata.product_event_type = /(?i)add delegated permission grant/
    )
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1671")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $event_action = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
