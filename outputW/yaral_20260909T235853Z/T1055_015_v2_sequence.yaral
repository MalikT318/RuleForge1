/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:09:58.864576+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_Handle_Then_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects process opening a handle to a SysListView32 control followed by remote thread creation or memory write, indicating potential ListPlanting injection."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires EDR telemetry with PROCESS_OPEN and PROCESS_INJECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate UI automation tools, accessibility software, screen readers, remote desktop clients, debugging tools."
    tuning_guidance = "Add approved automation tools to %global_allowed_admin_tools and accessibility software to %global_allowed_security_tools."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(explorer|iexplore|chrome|firefox|msedge|outlook|thunderbird|teams|slack|mmc|taskmgr)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    $open.principal.hostname = $hostname
    $open.principal.process.pid = $pid

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(explorer|iexplore|chrome|firefox|msedge|outlook|thunderbird|teams|slack|mmc|taskmgr)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    $inj.principal.hostname = $hostname
    $inj.principal.process.pid = $pid

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($open.principal.hostname)
    $injector_process = array_distinct($open.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)

  condition:
    $open and $inj
}
