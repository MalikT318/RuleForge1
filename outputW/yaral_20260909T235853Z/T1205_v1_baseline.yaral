/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:46:35.793251+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Port_Knocking_Sequential_Closed_Port_Probes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential port-knocking or traffic-signaling behavior on network devices: a single external source making rapid, sequential connection attempts to multiple distinct closed/rejected ports on the same destination. Adversaries use this technique to trigger hidden services or open firewall rules via a magic packet sequence (T1205/T1205.001)."
    mitre_tactic = "Defense Evasion, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Requires firewall deny/reject logs with source IP, destination IP, destination port, and connection state or action. Perimeter firewall or stateful inspection logs normalised to Chronicle UDM NETWORK_CONNECTION events."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Misconfigured hosts scanning their own network, vulnerability scanners (covered by exclusion list), network monitoring probes, legitimate port-scan audits, misconfigured applications retrying on wrong ports."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners. Add known management source ranges to %global_allowed_mgmt_sources. Raise the threshold or narrow the port range if false-positive volume is high in environments with aggressive internal scanning. Consider pairing with a Threshold rule grouping by source IP over a short window for higher confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be external - exclude RFC1918 internal space
    not $net.principal.ip in %rfc1918_internal

    // Exclude authorised scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Target must be a specific destination port - focus on uncommon/high ports
    // that are not standard services, which are typical knock sequence targets.
    // Ports below 1024 that are not common services, or high ephemeral-range ports
    // used as knock targets. Exclude well-known service ports to reduce noise.
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 25
    $net.target.port != 22
    $net.target.port != 21

    // The connection must have been blocked/rejected by the firewall,
    // which is the observable signal in port-knocking: probing closed ports.
    // Chronicle normalises block/deny actions into security_result fields.
    // We look for the absence of an established session (bytes = 0 or very low)
    // combined with a non-standard port, indicating a rejected probe.
    $net.network.sent_bytes < 100

    // Destination must not be in internal space (firewall protecting perimeter)
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
