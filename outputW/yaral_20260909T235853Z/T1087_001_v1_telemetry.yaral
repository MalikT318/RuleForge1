/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:21:08.579670+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_Local_Account_Enum_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file artifacts produced by local account enumeration on Windows. Adversaries frequently redirect the output of net user, net localgroup, or similar commands to a file for offline review. This rule fires on FILE_CREATION events where the target path matches patterns consistent with reconnaissance output staging - e.g. files written to temp, staging, or working directories with names suggestive of user/account enumeration. Detecting the resulting artifact is harder to evade than suppressing command-line logging."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file telemetry must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT asset inventory scripts writing user lists to temp directories; helpdesk automation; software deployment agents; authorised audit tooling."
    tuning_guidance = "Add known-good parent process paths (e.g. RMM agents, deployment tools) to %global_allowed_admin_tools. Add known-good service accounts that legitimately produce such files to %global_allowed_service_accounts. Narrow the filename regex if the pattern generates noise in a specific environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // File written to a staging or temp-like location commonly used to exfiltrate
    // enumeration output: %TEMP%, %TMP%, C:\Windows\Temp, C:\ProgramData, or
    // any user's AppData\Local\Temp, or the root of a drive.
    $file.target.file.full_path = /(?i)(\\temp\\|\\tmp\\|\\programdata\\|\\appdata\\local\\temp\\|^[a-z]:\\[^\\]+\.(txt|csv|log|out|dat)$)/ nocase

    // Filename contains terms strongly associated with account/user enumeration output.
    // Matches patterns like: users.txt, localusers.csv, accounts.log, userlist.out,
    // localgroup.txt, admins.csv, members.log, passwd.txt, sam_dump.txt, etc.
    $file.target.file.full_path = /(?i)(user|account|local.?group|member|admin|passwd|sam.?dump|netuser|whoami|localuser)(s|list|_list|_dump|_out|_enum|_recon)?[\._-]?[0-9]*\.(txt|csv|log|out|dat)$/

    // The writing process is a shell, script host, or common enumeration parent -
    // this anchors the artifact to an interactive or scripted enumeration session.
    $file.principal.process.file.full_path = /(?i)\\(cmd\.exe|powershell\.exe|pwsh\.exe|wscript\.exe|cscript\.exe|net\.exe|net1\.exe|python[0-9]*\.exe|perl\.exe|ruby\.exe|bash\.exe)$/

    // Exclude known-good administrative tooling and service accounts.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
