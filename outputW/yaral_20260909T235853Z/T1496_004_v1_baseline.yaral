/*
  MITRE Technique : T1496.004 - Cloud Service Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:56:47.641359+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_004_Cloud_Service_Hijacking_Messaging_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential cloud service hijacking via abuse of messaging or AI/LLM SaaS APIs. Adversaries who compromise cloud credentials may invoke high-volume email, SMS, or AI inference APIs to exhaust quotas, incur costs, or conduct phishing campaigns. This rule fires on resource access events targeting messaging or AI service endpoints from principals not in the approved cloud principals list."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.004"
    mitre_technique_name = "Cloud Service Hijacking"
    log_prerequisites = "Requires cloud provider audit logs normalised to UDM USER_RESOURCE_ACCESS. Events must populate target.resource.name or target.url with the API endpoint and principal.user.userid with the caller identity."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate bulk email campaigns, marketing automation, authorised AI/LLM integrations, and approved notification services. Service accounts used by CI/CD pipelines may trigger this rule."
    tuning_guidance = "Add approved service principals and automation accounts to %global_allowed_cloud_principals. Add approved SaaS domains to %global_allowed_domains. Raise the threshold variant of this rule if volume-based detection is preferred."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target a messaging, notification, or AI/LLM service endpoint.
    // Matches SES, SNS, SendGrid, Twilio, OpenAI, Bedrock, Vertex AI, etc.
    // Pattern is intentionally broad to cover normalised UDM resource names
    // across multiple cloud providers without hardcoding vendor strings.
    (
      $cloud.target.resource.name = /(?i)(send.*message|send.*email|send.*sms|publish|invoke.*model|generate.*content|chat.*completion|inference|llm|bedrock|vertex.*ai|openai|sagemaker.*endpoint|sns|ses|sendgrid|twilio|messagebird|pinpoint)/ nocase
      or
      $cloud.target.url = /(?i)(send.*message|send.*email|send.*sms|publish|invoke.*model|generate.*content|chat.*completion|inference|llm|bedrock|vertex.*ai|openai|sagemaker|sns|ses|sendgrid|twilio|messagebird|pinpoint)/ nocase
    )

    // Exclude known-good cloud service principals (automation, CI/CD, approved integrations)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known-good SaaS domains that are approved for outbound messaging
    not $cloud.target.resource.name in %global_allowed_domains

    // Require a non-empty caller identity to reduce noise from unauthenticated probes
    $cloud.principal.user.userid != ""

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1496.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $accessed_url = array_distinct($cloud.target.url)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
