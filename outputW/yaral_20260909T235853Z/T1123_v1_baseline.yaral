/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:36:45.562944+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_001_Audio_Capture_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes commonly used to capture audio from microphone devices on Linux. Adversaries may invoke command-line audio recording utilities (arecord, sox, ffmpeg, parecord, parec, aplay in record mode, gst-launch) targeting ALSA or PulseAudio devices to capture ambient audio and write recordings to disk for later exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with command-line arguments. Auditd syscall rules for execve are sufficient."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate audio recording applications, video conferencing software, podcast/streaming tools, accessibility software, automated testing of audio hardware, and system sound configuration utilities."
    tuning_guidance = "Add known-good parent processes (e.g., desktop environment launchers, conferencing apps) to %global_allowed_admin_tools. Scope by principal.user.userid to exclude service accounts in %global_allowed_service_accounts. Consider restricting to non-interactive sessions or unusual parent processes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match known Linux audio capture binaries by process name or full path
    (
      $proc.target.process.file.full_path = /\/(arecord|sox|ffmpeg|parecord|parec|gst-launch(-1\.0)?)$/ nocase
      or
      $proc.target.process.command_line = /\/(arecord|sox|ffmpeg|parecord|parec|gst-launch(-1\.0)?)(\s|$)/ nocase
    )

    // Require command-line indicators of audio device access or recording mode
    (
      // ALSA device references
      $proc.target.process.command_line = /\-D\s*(hw|plughw|default|pulse|sysdefault)/ nocase
      or
      // PulseAudio source references
      $proc.target.process.command_line = /\-\-(source|device|monitor)/ nocase
      or
      // ffmpeg audio input device flags
      $proc.target.process.command_line = /\-f\s+(alsa|pulse|oss|sndio)/ nocase
      or
      // sox recording from audio device
      $proc.target.process.command_line = /\/(dev\/snd|dev\/dsp|dev\/audio)/ nocase
      or
      // gstreamer ALSA or pulse source elements
      $proc.target.process.command_line = /alsasrc|pulsesrc|osssrc|autoaudiosrc/ nocase
      or
      // arecord duration or file output flags indicating intentional recording
      $proc.target.process.command_line = /\-(d|D|t|r|c|f)\s+[0-9]/ nocase
    )

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity = array_distinct($proc.principal.hostname)
    $recording_process = array_distinct($proc.target.process.file.full_path)
    $recording_cmdline = array_distinct($proc.target.process.command_line)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
