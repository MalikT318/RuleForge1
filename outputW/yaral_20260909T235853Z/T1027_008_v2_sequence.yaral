/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:54:49.158404+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Stripped_Payload_Download_Then_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects download of a binary file from an external source followed by immediate outbound connection to a different external destination, indicating potential stripped payload staging and C2 callback."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Requires firewall or proxy logs with HTTP/HTTPS visibility and flow telemetry."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Software update processes, CDN-hosted installers, legitimate application auto-updates, cloud sync clients."
    tuning_guidance = "Add known update domains to %global_allowed_domains. Exclude approved software distribution sources from the download event."

  events:
    $download.metadata.event_type = "NETWORK_HTTP"
    $download.network.http.method = "GET"
    $download.network.http.response_code >= 200
    $download.network.http.response_code < 300
    re.regex($download.target.url, /(?i)\.(exe|elf|bin|so|dylib|dll|scr|com|msi|pkg|deb|rpm|apk|jar|app)(\?.*)?$/)
    not $download.target.ip in %rfc1918_internal
    not re.regex($download.target.url, /(?i)%global_allowed_domains/)
    $download.principal.ip = $internal_ip

    $outbound.metadata.event_type = "NETWORK_CONNECTION"
    not $outbound.target.ip in %rfc1918_internal
    $outbound.target.port != 80
    $outbound.target.port != 443
    $outbound.target.ip != $download.target.ip
    $outbound.principal.ip = $internal_ip

    $download.metadata.event_timestamp.seconds <= $outbound.metadata.event_timestamp.seconds

  match:
    $internal_ip over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.008")
    $primary_entity = array_distinct($download.principal.ip)
    $download_urls = array_distinct($download.target.url)
    $download_sources = array_distinct($download.target.ip)
    $outbound_destinations = array_distinct($outbound.target.ip)
    $outbound_ports = array_distinct($outbound.target.port)

  condition:
    $download and $outbound
}
