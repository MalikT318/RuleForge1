/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:12:22.130974+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_Transmitted_Data_Manipulation_Intercept {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process launches consistent with in-transit data manipulation on Linux: tools capable of intercepting, modifying, or replaying network streams (e.g., ncat, socat, mitmproxy, iptables NFQUEUE/REDIRECT, tc with netem/mirred, tee-based pipe splicing, or SSL-stripping proxies). These are the OS mechanisms an adversary uses to intercept transmitted data between processes or across the network."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH. Auditd syscall execve rules or EDR exec hooks must be enabled."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate network debugging by administrators (socat, ncat for port forwarding), authorised penetration testing, QA traffic replay tools, load-balancer configuration scripts using iptables REDIRECT."
    tuning_guidance = "Add authorised administrator accounts to %global_allowed_admin_users. Add approved tooling parent processes (e.g., CI/CD runners, pentest frameworks) to %global_allowed_security_tools. Scope by hostname or user if the rule is too broad in environments with active network engineering teams."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match process names or command lines associated with traffic interception,
    // stream manipulation, or transparent proxy capabilities on Linux.
    // Using alternation within a single regex to avoid OR-ing event types.
    (
      // Interception / proxy tools by process name
      $proc.target.process.file.full_path = /\/(socat|ncat|netcat|nc|mitmproxy|mitmdump|mitmweb|sslstrip|bettercap|ettercap|tcpreplay|tcprewrite|hping3|scapy)$/ nocase
      or
      // iptables/nftables used to redirect or queue traffic for manipulation
      (
        $proc.target.process.file.full_path = /\/(iptables|ip6tables|nft)$/ nocase
        and
        $proc.target.process.command_line = /(?i)(REDIRECT|NFQUEUE|TPROXY|DNAT)/ nocase
      )
      or
      // tc (traffic control) with mirred or netem for packet mangling
      (
        $proc.target.process.file.full_path = /\/tc$/ nocase
        and
        $proc.target.process.command_line = /(?i)(mirred|netem|action)/ nocase
      )
      or
      // Shell-level pipe splicing: tee writing to a file while passing data through
      // Detect shell spawning tee with a redirect that could intercept a stream
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh)$/ nocase
        and
        $proc.target.process.command_line = /(?i)tee\s+.*\|\s*(nc|ncat|socat|curl|wget)/
      )
      or
      // socat with SSL or TCP relay arguments indicating MITM proxy setup
      (
        $proc.target.process.command_line = /(?i)socat.*ssl.*fork/
      )
      or
      // Python/Perl one-liners acting as transparent proxies or stream editors mid-pipe
      (
        $proc.target.process.file.full_path = /\/(python[23]?|perl|ruby)$/ nocase
        and
        $proc.target.process.command_line = /(?i)(socket\..*bind|TCPServer|StreamRequestHandler|ssl\.wrap_socket|SOCK_STREAM.*listen)/
        and
        $proc.target.process.command_line = /(?i)(replace|sub|re\.sub|translate|encode|decode|struct\.pack)/
      )
    )

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
