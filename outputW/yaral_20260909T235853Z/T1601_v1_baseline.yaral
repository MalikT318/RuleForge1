/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:17:14.775181+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Network_Device_Image_Transfer_Detected {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects potential network device OS image modification via large file transfers over management-plane protocols (TFTP/FTP/SCP/HTTP) from or to network device management interfaces. Adversaries targeting T1601 typically transfer a modified monolithic OS image to or from the device using these protocols. A large outbound or inbound transfer on these ports from a non-approved source is a high-fidelity signal."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Requires firewall or perimeter flow logs with byte counts, ports, and IP addresses normalised into UDM NETWORK_FLOW or NETWORK_CONNECTION events. network.sent_bytes or network.received_bytes must be populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised firmware upgrade windows initiated by network operations teams, backup jobs copying device configs, vulnerability scanner probes against management ports, legitimate TFTP boot services in PXE environments."
    tuning_guidance = "Add authorised management source addresses to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Consider narrowing the byte threshold (currently 5 MB) to match the smallest OS image in your environment, reducing false positives from large config backups."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Management-plane file-transfer protocols used to stage or exfiltrate OS images:
    // TFTP=69, FTP-data=20, FTP-control=21, SCP/SSH=22, HTTP=80, HTTPS=443, HTTP-alt=8080
    (
      $net.target.port = 69  or
      $net.target.port = 20  or
      $net.target.port = 21  or
      $net.target.port = 22  or
      $net.target.port = 80  or
      $net.target.port = 443 or
      $net.target.port = 8080
    )

    // Large transfer threshold: 5 MB in either direction is consistent with a
    // monolithic OS image; adjust per environment via tuning_guidance above.
    (
      $net.network.sent_bytes >= 5242880 or
      $net.network.received_bytes >= 5242880
    )

    // Exclude traffic originating from approved management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude known authorised scanner sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude purely internal RFC-1918 lateral traffic that is expected
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)
    $bytes_received = max($net.network.received_bytes)

  condition:
    $net
}
