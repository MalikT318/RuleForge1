/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:10:36.581393+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_AuthPkg_Registry_Then_DLL_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects the two-stage Authentication Package persistence technique: a process first modifies the LSA Authentication Packages registry key to register a new DLL, then a DLL file is written to a system directory on the same host within 10 minutes. This combination strongly indicates an adversary staging a boot-persistent LSA authentication package."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires EDR or Sysmon registry modification events (Event ID 13) and file creation events (Event ID 11) normalised to UDM REGISTRY_MODIFICATION and FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security software (e.g., smart-card middleware, third-party MFA providers) that registers custom LSA authentication packages. Domain controller hardening scripts may also touch this key."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_security_tools or %global_allowed_admin_tools. Scope exclusions narrowly to the specific process writing the registry key, not the key itself."

  events:
    // Event 1: Registry modification of the LSA Authentication Packages key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Control\\Lsa$/
    $reg.target.registry.registry_value_name = /(?i)^Authentication Packages$/
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    // Event 2: DLL file written to a Windows system directory on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)^[A-Za-z]:\\(Windows\\(System32|SysWOW64|security)|Windows)\\[^\\]+\.dll$/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Chronological ordering: registry write must precede or coincide with DLL drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $reg_key_modified = array_distinct($reg.target.registry.registry_key)
    $dll_path_written = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $reg_modifying_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg and $file
}
