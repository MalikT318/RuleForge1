/*
  MITRE Technique : T1578.001 - Create Snapshot
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:14:09.882154+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_001_Cloud_Snapshot_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a cloud compute snapshot (VM, volume, or virtual disk) via cloud provider audit logs. Adversaries may create snapshots to bypass access restrictions on existing compute infrastructure, mount the snapshot to an attacker-controlled instance, and exfiltrate or tamper with data without touching the original resource."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.001"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Snapshot"
    log_prerequisites = "Requires cloud provider audit logs ingested into Chronicle UDM (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs). The snapshot creation API call must be captured as a RESOURCE_CREATION event."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized backup and DR automation, scheduled snapshot policies, infrastructure-as-code pipelines, and approved admin operations. Service accounts performing routine snapshots will generate volume."
    tuning_guidance = "Add known backup automation service principals to %global_allowed_backup_processes and approved cloud service accounts to %global_allowed_service_accounts. Consider narrowing by time-of-day or requiring the principal to be outside %global_allowed_admin_users for higher fidelity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Match snapshot creation API operations across AWS, Azure, and GCP
    // AWS: CreateSnapshot, CreateSnapshots
    // Azure: Microsoft.Compute/snapshots/write
    // GCP: compute.disks.createSnapshot, compute.snapshots.insert
    $cloud.target.resource.name = /(?i)(snapshot|disk.*snap|snap.*disk|createSnapshot|snapshots\/write|snapshots\.insert)/

    // Exclude known-good backup service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_backup_processes
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1578.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $snapshot_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
