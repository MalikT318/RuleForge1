/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:15:36.167351+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_NetDevice_Login_Then_Config_Change {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a management-plane login to a network device followed by a configuration modification within 5 minutes. Adversaries abusing the network device CLI (T1059.008) typically authenticate via SSH or Telnet and then issue configuration commands to alter routing, ACLs, startup config, or disable logging. This correlation surfaces that two-step pattern using firewall/perimeter management-plane telemetry without relying on process-level telemetry."
    mitre_tactic    = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites = "Requires management-plane authentication events (USER_LOGIN) and configuration-change events (SETTING_MODIFICATION) normalised into Chronicle UDM from network device syslog, AAA (TACACS+/RADIUS) logs, or SNMP trap feeds ingested via a syslog forwarder."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorised network engineers performing scheduled maintenance, automated configuration management tools (Ansible, NAPALM, Netconf/YANG orchestrators), and change-window deployments. Service accounts used by NMS platforms will also trigger this rule."
    tuning_guidance = "Add authorised administrator accounts to %global_allowed_admin_users and approved automation service accounts to %global_allowed_service_accounts. Scope the match window or add a source-IP exclusion via %global_allowed_mgmt_sources to suppress known management jump-hosts."

  events:
    // Event 1: Management-plane authentication to the network device
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.port >= 22
    $auth.target.port <= 23
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources
    $auth.target.hostname = $device_hostname

    // Event 2: Configuration change on the same device shortly after
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users
    $cfg.target.hostname = $device_hostname

    // Enforce chronological ordering: login must precede config change
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $device_hostname over 5m

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity    = array_distinct($device_hostname)
    $actor_userid      = array_distinct($auth.principal.user.userid)
    $source_ips        = array_distinct($auth.principal.ip)
    $login_port        = array_distinct($auth.target.port)
    $changed_settings  = array_distinct($cfg.target.resource.name)

  condition:
    $auth and $cfg
}
