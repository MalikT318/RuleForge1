/*
  MITRE Technique : T1580 - Cloud Infrastructure Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:15:24.715792+00:00
  Reference       : https://attack.mitre.org/techniques/T1580
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1580_001_Cloud_Infrastructure_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects broad cloud infrastructure enumeration via discovery-oriented API calls against compute, storage, and database resources. Adversaries use these read-only APIs to map available IaaS resources before lateral movement or data exfiltration. Covers AWS DescribeInstances/ListBuckets/DescribeDBInstances patterns, GCP compute list operations, and Azure VM/storage enumeration normalised to UDM USER_RESOURCE_ACCESS."
    mitre_tactic = "Discovery"
    mitre_technique = "T1580"
    mitre_technique_name = "Cloud Infrastructure Discovery"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail, Azure Activity Log, or GCP Cloud Audit Logs) ingested and normalised to Chronicle UDM. Management-plane read events must be enabled (CloudTrail management events, GCP Admin Activity, Azure Activity Log)."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud monitoring agents, CSPM tools, authorised security scanners, DevOps automation pipelines, and cloud-native services performing health checks. Service accounts used by infrastructure-as-code tooling (Terraform, Pulumi) will also trigger this rule."
    tuning_guidance = "Add known automation and service account identifiers to %global_allowed_service_accounts. Add approved scanner principals to %global_allowed_scanners. Add approved cloud service principals to %global_allowed_cloud_principals. Consider narrowing to specific resource types or adding a threshold wrapper if volume is high."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match discovery-oriented API operation names normalised into UDM
    // Covers: AWS Describe*/List*/Get*PublicAccess/Head*, GCP list/get compute, Azure list VM/storage
    $cloud.target.resource.name = /(?i)(describe|list|get|head)(instances|buckets|volumes|snapshots|images|addresses|firewalls|networks|subnets|vpcs|securitygroups|dbinstances|clusters|functions|tables|queues|topics|keys|secrets|publicaccessblock|storageclasses|disks|virtualmachines|storageaccounts|databases|namespaces|services|loadbalancers|targetgroups|repositories|registries)/

    // Exclude approved automation and service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1580")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
