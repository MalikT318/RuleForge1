/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:43:38.079810+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_001_Browser_Session_Hijacking_Process_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-browser, non-security process opening a handle to a browser process, which is the primary OS mechanism required for browser session hijacking. Adversaries must open the browser process with sufficient rights to inject code or read memory containing cookies, session tokens, and SSL certificates. Legitimate handle openers are limited to EDR/AV agents and debuggers."
    mitre_tactic = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires EDR or Sysmon process-open (handle) telemetry. Sysmon Event ID 10 (ProcessAccess) or equivalent EDR PROCESS_OPEN events normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents, crash reporters (WerFault.exe), legitimate debuggers, screen-capture or accessibility software, and some RMM tools that inspect browser processes."
    tuning_guidance = "Add known-good opener binaries (EDR agents, crash handlers, accessibility tools) to %global_allowed_security_tools or %global_allowed_admin_tools. Scope further by requiring high-privilege access rights flags if your EDR surfaces them in the command_line or a dedicated field."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be a browser process - match the executable name
    $open.target.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|opera|brave|vivaldi|chromium)\.exe$/ nocase

    // The opener must NOT itself be a browser (tab/renderer processes open each other legitimately)
    not $open.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|opera|brave|vivaldi|chromium)\.exe$/ nocase

    // Exclude Windows crash reporter and system processes that legitimately open browser handles
    not $open.principal.process.file.full_path = /\\(WerFault|werfault|svchost|csrss|lsass|services|smss|wininit|taskmgr|msiexec)\.exe$/ nocase

    // Exclude approved security tooling and admin tools
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Require a non-empty opener path to avoid noise from unresolved PIDs
    $open.principal.process.file.full_path = /.+/ nocase

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $target_browser = array_distinct($open.target.process.file.full_path)
    $affected_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
