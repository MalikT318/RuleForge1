/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:34:53.603932+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Linux_Email_Collection_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes accessing local mail spool files or maildir structures on Linux, which is a primary mechanism for email collection. Adversaries read /var/mail, /var/spool/mail, or user Maildir directories to harvest email content from compromised hosts."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires Linux EDR or auditd file-open/read telemetry producing FILE_READ or PROCESS_LAUNCH events with command-line arguments. Auditd rules should monitor /var/mail and /var/spool/mail with -w and -p r flags."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate MUA clients (mutt, thunderbird, evolution) reading user mailboxes, mail delivery agents (postfix, sendmail, dovecot) accessing spool files, backup agents reading mail directories, system monitoring scripts."
    tuning_guidance = "Add known mail server daemon process paths to %global_allowed_backup_processes. Add authorized mail client parent processes to %global_allowed_admin_tools. Scope by user if only specific accounts are expected to read mail spools."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target processes that read, copy, archive, or exfiltrate mail content
    // Match common data-staging and exfil tools operating on mail paths
    $proc.target.process.command_line = /\/var\/(mail|spool\/mail|spool\/postfix)/ nocase

    // Restrict to tools commonly abused for collection: archivers, readers, network tools, interpreters
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin)\/(cat|grep|find|tar|zip|gzip|cp|mv|python[23]?|perl|ruby|bash|sh|curl|wget|nc|ncat|openssl|base64|awk|sed|xargs|rsync|scp|sftp)$/ nocase

    // Exclude known legitimate mail infrastructure daemons as parent processes
    not $proc.principal.process.file.full_path = /\/(postfix|sendmail|dovecot|exim|procmail|fetchmail|getmail|offlineimap)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
