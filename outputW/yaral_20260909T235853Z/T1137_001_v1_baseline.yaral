/*
  MITRE Technique : T1137.001 - Office Template Macros
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:41:12.194768+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_001_Office_Template_Macro_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification or upload of Office template files (e.g., Normal.dotm, Personal.xlsb, *.dotm, *.xltm, *.xlsm) via M365 unified audit logs. Adversaries abuse Office templates to embed persistent VBA macros that execute each time the application starts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.001"
    mitre_technique_name = "Office Application Startup: Office Template Macros"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log with SharePoint, OneDrive, and Exchange file activity events normalised into Chronicle UDM. FileModified, FileUploaded, and FileCreated operations must be ingested."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate IT administrators deploying standardised Office templates across the organisation. Corporate template management workflows that push Normal.dotm or shared .dotm files to user profiles via OneDrive or SharePoint. Macro-enabled workbook templates used by finance or operations teams."
    tuning_guidance = "Add known template-management service accounts to %global_allowed_service_accounts. Add approved administrative users who routinely deploy templates to %global_allowed_admin_users. Scope exclusions narrowly to avoid masking abuse of the same accounts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Match macro-enabled Office template file extensions and known template filenames
    // Covers Word (.dotm), Excel macro-enabled templates (.xltm, .xlsm, .xlsb),
    // PowerPoint macro-enabled templates (.potm), and the canonical persistence files
    $file.target.file.full_path = /(?i)\.(dotm|xltm|xlsm|xlsb|potm)$/

    // Narrow to the well-known persistent template filenames where possible
    // Normal.dotm (Word), Personal.xlsb (Excel XLSTART), shared .dotm templates
    // Use a broad regex so renamed-but-macro-enabled templates are also caught
    // The extension filter above is the primary signal; this adds fidelity for known names
    $file.target.file.full_path = /(?i)(normal\.dotm|personal\.xlsb|xlstart|templates)/

    // Exclude known-good service and automation accounts
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude known administrative users performing legitimate template deployments
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1137.001")
    $primary_entity = array_distinct($file.principal.user.userid)
    $modified_template_path = array_distinct($file.target.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
