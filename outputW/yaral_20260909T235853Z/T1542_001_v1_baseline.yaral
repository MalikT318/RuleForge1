/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:03:41.028515+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_Network_Device_Firmware_Update_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects anomalous firmware-related traffic on network devices observable at the firewall perimeter. Firmware update protocols (TFTP on UDP/69, SCP on TCP/22, HTTP/HTTPS on TCP/80/443) originating from or destined to unexpected external sources may indicate an adversary attempting to push malicious firmware to network devices. This rule focuses on TFTP (UDP/69), which is the most common legacy firmware transfer protocol and rarely legitimate from external sources."
    mitre_tactic = "Persistence"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Requires firewall flow or connection logs with source/destination IP, port, and protocol fields normalised into UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network operations teams performing scheduled firmware upgrades from approved jump hosts or management servers. Internal TFTP-based PXE boot infrastructure. Approved vulnerability scanners probing management ports."
    tuning_guidance = "Add approved firmware management source addresses to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Consider restricting the rule to inbound direction if your firewall logs include directionality."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // TFTP (UDP/69) is the canonical firmware transfer protocol on network devices
    // and has virtually no legitimate use from external/untrusted sources
    $net.target.port = 69

    // Exclude known-good management sources such as approved jump hosts and NMS servers
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude authorised scanners that may probe management ports
    not $net.principal.ip in %global_allowed_scanners

    // Exclude internal RFC1918 space - TFTP from internal management VLANs is expected;
    // external TFTP is the high-fidelity signal
    not $net.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = max($net.target.port)

  condition:
    $net
}
