/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:51:28.308613+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_CompileAfterDelivery_NetworkToCompilerOutput {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network-observable pattern consistent with Compile After Delivery on Linux: an inbound or outbound HTTP/HTTPS connection to a non-internal destination is followed within 5 minutes by a new executable or object file appearing in a world-writable or staging directory (e.g. /tmp, /dev/shm, /var/tmp). The correlation is anchored on the destination IP observed at the perimeter, linking the download event to the subsequent file-creation event seen in network flow telemetry (e.g. a second outbound beacon from the same source after the file lands). This provides additive coverage beyond process-launch command-line rules by using only firewall/proxy telemetry."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP or NETWORK_CONNECTION events. Both the inbound source-code download and the subsequent outbound connection (post-compilation beacon or second-stage fetch) must be visible at the perimeter. Internal RFC-1918 space is excluded via %rfc1918_internal."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developer workstations fetching source tarballs and immediately running build pipelines; CI/CD agents pulling code and then phoning home to artifact registries; package managers (apt, yum, pip) downloading source packages. Tune by adding known build-server source IPs to %global_allowed_scanners or known artifact registry destinations to %global_allowed_domains."
    tuning_guidance = "Add approved build-server external IPs to %global_allowed_mgmt_sources. Add known package-repository and artifact-registry domains to %global_allowed_domains. Narrow the destination port filter if your environment only uses standard ports for legitimate builds."

  events:
    // Event 1: Inbound HTTP/HTTPS download of source-code-like content from an
    // external destination. Firewall/proxy logs surface the URL or content-type.
    // We detect the download by matching URL path extensions associated with
    // source code or compressed source archives delivered over HTTP.
    $download.metadata.event_type = "NETWORK_HTTP"
    $download.target.url = /\.(c|cc|cpp|cs|go|py|sh|pl|rb|java|rs|tar\.gz|tgz|zip|tar\.bz2|tar\.xz)(\?|$)/ nocase
    not $download.principal.ip in %rfc1918_internal
    not $download.target.hostname in %global_allowed_domains
    $download.principal.ip = $src_ip

    // Event 2: Within the same time window, the same source IP makes a second
    // outbound network connection to a different external destination on a
    // non-standard port, consistent with a compiled payload beaconing out or
    // fetching a second stage. This is the network-observable artefact of a
    // successful compile-and-execute cycle.
    $beacon.metadata.event_type = "NETWORK_CONNECTION"
    not $beacon.principal.ip in %rfc1918_internal
    not $beacon.target.ip in %rfc1918_internal
    not $beacon.target.hostname in %global_allowed_domains
    $beacon.target.port != 80
    $beacon.target.port != 443
    $beacon.target.port != 53
    $beacon.target.port != 22
    $beacon.principal.ip = $src_ip

    // Chronological ordering: download precedes the outbound beacon
    $download.metadata.event_timestamp.seconds <= $beacon.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity = array_distinct($src_ip)
    $download_urls = array_distinct($download.target.url)
    $beacon_destinations = array_distinct($beacon.target.ip)
    $beacon_ports = array_distinct($beacon.target.port)
    $event_count = count($beacon.metadata.event_timestamp.seconds)

  condition:
    $download and $beacon
}
