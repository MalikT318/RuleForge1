/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:43:18.703458+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_IDE_Extension_Network_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound network connections from IDE processes (VS Code, IntelliJ, Eclipse) to external destinations on uncommon ports, which may indicate a malicious IDE extension establishing persistence, exfiltrating data, or beaconing to a C2. Firewall/proxy telemetry is used to observe the network-observable behaviour without requiring endpoint process context."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "IDE Extensions"
    log_prerequisites = "Requires firewall or proxy logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source IP must be resolvable to an internal host. External destination filtering relies on %rfc1918_internal exclusion."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate IDE extension marketplace traffic (e.g., marketplace.visualstudio.com, plugins.jetbrains.com), extension auto-update checks, developer tools fetching dependencies, CI/CD pipeline agents making outbound calls. Tune by adding known-good destinations to %global_allowed_domains."
    tuning_guidance = "Add approved extension marketplace domains and CDN ranges to %global_allowed_domains. Add authorised scanner or proxy source IPs to %global_allowed_scanners. Consider narrowing the port range if the environment uses a fixed egress proxy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Traffic originates from an internal source (IDE running on a developer workstation or server)
    $net.principal.ip = $src_ip
    $net.principal.ip in %rfc1918_internal

    // Destination is external (not RFC1918)
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external domains (marketplace, update, CDN endpoints)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanners and security tooling sources
    not $net.principal.ip in %global_allowed_scanners

    // Focus on ports that are anomalous for IDE marketplace/update traffic:
    // exclude standard HTTPS (443) and HTTP (80) to reduce noise from legitimate
    // extension update checks; flag non-standard egress which extensions may use
    // for tunnelling or C2 (e.g., 4443, 8080, 8443, high ephemeral ports used as listeners)
    // We flag connections NOT on 80/443 as higher suspicion, OR on 443 to
    // non-standard destinations already filtered above.
    // Detect high-numbered non-ephemeral destination ports commonly abused for C2
    (
      $net.target.port >= 1024 and
      $net.target.port != 8080 and
      $net.target.port != 8443 and
      $net.target.port != 443 and
      $net.target.port != 80
    )

    // Minimum data transfer threshold to reduce noise from pure SYN/RST probes
    // network.sent_bytes > 0 is a proxy for an established session
    $net.network.sent_bytes > 0

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($src_ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $destination_hostname = array_distinct($net.target.hostname)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
