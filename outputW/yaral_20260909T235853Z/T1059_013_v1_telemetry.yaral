/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:18:43.628047+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_API_Exec_Audit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects container exec/attach API calls recorded in cloud audit logs that indicate an adversary is executing commands inside a running container via the container runtime API or Kubernetes exec endpoint. This is a control-plane signal that fires even when process-creation telemetry is absent or suppressed."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Requires cloud provider audit logs (e.g., GCP Audit, AWS CloudTrail, Azure Activity) normalised to Chronicle UDM. Kubernetes API server audit logging must be enabled and forwarded. The exec/attach/portforward verbs must be captured."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Authorised SRE/DevOps engineers performing live debugging, CI/CD pipelines running acceptance tests inside containers, monitoring agents using exec to collect health metrics."
    tuning_guidance = "Add known automation service accounts to %global_allowed_service_accounts. Add approved administrative users to %global_allowed_admin_users. Scope by namespace or cluster label if your environment has a dedicated debug namespace."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match Kubernetes or container runtime exec/attach/portforward API verbs.
    // These are the control-plane actions that result from `kubectl exec`,
    // `docker exec`, or direct API calls - a layer above process creation.
    $cloud.target.resource.name = /(?i)(exec|attach|portforward)/

    // Restrict to pod/container resource types to avoid matching unrelated
    // exec-style verbs on non-container resources (e.g., cloud function invocations).
    $cloud.target.resource.type = /(?i)(pod|container)/

    // Exclude known-good service accounts performing automated operations.
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good administrative users performing approved operations.
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Exclude approved scanners and security tooling that may exec into containers.
    not $cloud.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
