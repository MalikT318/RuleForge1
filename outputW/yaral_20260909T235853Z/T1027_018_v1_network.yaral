/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:01:57.554844+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_Invisible_Unicode_Suspicious_HTTP_Encoding {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests containing percent-encoded invisible Unicode characters (zero-width spaces, variation selectors, bidirectional controls, private-use area codepoints) in the URL or User-Agent. Adversaries abusing T1027.018 encode payloads using these non-printing characters and transmit them over HTTP to C2 infrastructure or exfiltration endpoints. Firewall and proxy logs capture the raw URL before browser rendering strips the invisible characters, making this a high-fidelity network-side signal."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires firewall or forward-proxy logs with full URL and User-Agent fields normalised into UDM NETWORK_HTTP events. The proxy must log raw (un-decoded) URLs."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Internationalised web applications that legitimately embed Unicode variation selectors or RTL marks in URLs; some CMS platforms encode content this way. Bidirectional text in Arabic/Hebrew web apps may trigger on the bidi controls pattern."
    tuning_guidance = "Add known-good domains that legitimately use Unicode-encoded URLs to %global_allowed_domains. Raise severity if the destination is not in %global_allowed_domains and the encoded sequence appears in the path rather than a query parameter."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Exclude internal destinations - firewall logs show routable targets
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

    // Match percent-encoded invisible Unicode codepoints in the request URL.
    // Categories covered:
    //   %E2%80%8B-%E2%80%8F  : U+200B-U+200F  zero-width space, ZWNJ, ZWJ, LRM, RLM
    //   %E2%80%AA-%E2%80%AE  : U+202A-U+202E  bidi embedding/override controls
    //   %E2%81%A0-%E2%81%A4  : U+2060-U+2064  word joiner, invisible operators
    //   %EF%B8%80-%EF%B8%8F  : U+FE00-U+FE0F  variation selectors VS1-VS16
    //   %EF%BF%B9-%EF%BF%BB  : U+FFF9-U+FFFB  interlinear annotation anchors
    //   %F3%A0%80%80+        : U+E0000 block   tags / private-use invisible chars
    //   %C2%AD               : U+00AD          soft hyphen (commonly abused)
    (
      $net.network.http.request_url = /(?:%E2%80%8[B-F]|%E2%80%A[A-E]|%E2%81%A[0-4]|%EF%B8%8[0-9A-Fa-f]|%EF%BF%B[9ABab]|%F3%A0%80|%C2%AD)/
      or
      $net.network.http.user_agent = /(?:%E2%80%8[B-F]|%E2%80%A[A-E]|%E2%81%A[0-4]|%EF%B8%8[0-9A-Fa-f]|%EF%BF%B[9ABab]|%F3%A0%80|%C2%AD)/
    )

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
