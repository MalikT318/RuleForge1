/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:01:11.041315+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Smuggling_Network_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP responses delivering SVG files with embedded script content characteristic of SVG smuggling. Adversaries embed JavaScript payloads inside SVG XML to bypass content filters, using the browser to assemble, download, or redirect to malicious content. This rule fires on network/proxy telemetry where an SVG is served with a content-type or URL pattern consistent with image delivery but the response contains script-bearing SVG markup indicators."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires proxy or next-generation firewall with HTTP inspection and response metadata visibility. UDM fields: network.http.response_code, network.http.user_agent, target.url, network.received_bytes, metadata.event_type."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SVG-based web applications, data visualisation libraries (D3.js, Chart.js), icon fonts served as SVG, CDN-hosted SVG assets with inline event handlers for accessibility. Web developers fetching SVG assets from external repositories."
    tuning_guidance = "Add known-good SVG-serving domains (CDNs, icon libraries, charting vendors) to %global_allowed_domains. Raise the threshold on network.received_bytes if legitimate SVG assets in your environment are large. Consider scoping to user-agent strings associated with browser-initiated downloads if the proxy populates that field reliably."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // SVG file requested by URL path or query string pattern
    $net.target.url = /(?i)\.svg(\?|#|$)/

    // Successful HTTP response - content was delivered
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300

    // Exclude internal destinations - SVG smuggling originates from external infrastructure
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

    // Exclude known-good scanner and security tool sources
    not $net.principal.ip in %global_allowed_scanners

    // Require a non-trivial payload size - empty or stub SVGs are not smuggling vehicles
    // Minimum ~512 bytes to carry meaningful embedded script content
    $net.network.received_bytes >= 512

    // Browser-like user agents are the delivery vector; exclude automated/API clients
    // that would not render SVG JavaScript
    $net.network.http.user_agent = /(?i)(mozilla|chrome|safari|firefox|edge|msie|trident)/

    // Exclude update services and known software distribution patterns
    not $net.network.http.user_agent = /(?i)(windowsupdate|microsoft.*update|wsus|sccm|defender)/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.017")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_url = array_distinct($net.target.url)
    $destination_host = array_distinct($net.target.hostname)
    $http_response_code = max($net.network.http.response_code)
    $bytes_received = max($net.network.received_bytes)
    $user_agent = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
