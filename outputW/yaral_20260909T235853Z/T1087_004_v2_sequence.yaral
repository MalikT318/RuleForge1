/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:23:21.149943+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_Cloud_Account_Enum_Identity_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud account enumeration pattern in identity provider logs: a successful authentication followed by a burst of directory read operations (user/role/group listing) within a short window. This is consistent with adversaries authenticating and immediately querying cloud account listings via the identity provider API."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM (Entra ID, Okta, or equivalent). USER_LOGIN and USER_RESOURCE_ACCESS events must be present with principal.user.userid and target.resource.name populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Automated provisioning pipelines, HR system integrations, and identity governance tools that enumerate users or roles as part of normal operations. Helpdesk staff performing bulk user lookups."
    tuning_guidance = "Add known service accounts performing legitimate directory reads to %global_allowed_service_accounts. Add approved automation principals to %global_allowed_cloud_principals. Raise the threshold or narrow target.resource.name patterns if provisioning tools generate excessive noise."

  events:
    // Event 1: Successful authentication to the identity provider
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    $auth.principal.user.userid = $userid

    // Event 2: Directory enumeration - reading user, role, group, or service-account listings
    $read.metadata.event_type = "USER_RESOURCE_ACCESS"
    $read.principal.user.userid = $userid
    $read.target.resource.name = /(?i)(list.?users?|list.?roles?|list.?groups?|list.?members?|list.?service.?accounts?|get.?role.?members?|get.?iam.?policy|user.?list|role.?list|group.?list|directory.?read)/
    not $read.principal.user.userid in %global_allowed_service_accounts
    not $read.principal.user.userid in %global_allowed_cloud_principals

    // Chronological ordering: login must precede the enumeration read
    $auth.metadata.event_timestamp.seconds <= $read.metadata.event_timestamp.seconds

  match:
    $userid over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($userid)
    $enumeration_operations = array_distinct($read.target.resource.name)
    $enumeration_count = count($read.target.resource.name)
    $source_ips = array_distinct($auth.principal.ip)
    $read_source_ips = array_distinct($read.principal.ip)

  condition:
    $auth and $read
}
