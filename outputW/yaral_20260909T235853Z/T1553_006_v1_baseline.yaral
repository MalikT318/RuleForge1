/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:06:29.807383+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_Code_Signing_Policy_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects modification of Windows code signing enforcement policies, including Driver Signature Enforcement (DSE) disablement via bcdedit, enabling TESTSIGNING boot mode, or registry changes that disable mandatory driver signing. Adversaries use these techniques to load unsigned or self-signed drivers and DLLs, bypassing kernel-level integrity controls."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (process creation) with full command-line logging enabled. Registry modification events (Sysmon Event ID 13) also surface the registry-based variant."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Kernel developers and driver developers legitimately enabling test signing on development workstations. Security researchers and penetration testers. Some hardware vendor installers temporarily enable test signing during driver installation."
    tuning_guidance = "Add known developer workstation hostnames to a suppression list. Scope the rule to production and server asset groups where driver development is not expected. Add approved admin accounts to %global_allowed_admin_users for developer environments."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match bcdedit.exe being used to disable DSE or enable test signing
    // Covers: bcdedit /set nointegritychecks on
    //         bcdedit /set testsigning on
    //         bcdedit /set loadoptions DDISABLE_INTEGRITY_CHECKS
    //         bcdedit /set {default} ... variants
    (
      $proc.target.process.file.full_path = /(?i)\\bcdedit\.exe$/ and
      (
        $proc.target.process.command_line = /(?i)nointegritychecks/ or
        $proc.target.process.command_line = /(?i)testsigning/ or
        $proc.target.process.command_line = /(?i)DDISABLE_INTEGRITY_CHECKS/ or
        $proc.target.process.command_line = /(?i)loadoptions/
      )
    )
    or
    // Match PowerShell or cmd invoking bcdedit with the same flags
    (
      $proc.target.process.command_line = /(?i)bcdedit/ and
      (
        $proc.target.process.command_line = /(?i)nointegritychecks/ or
        $proc.target.process.command_line = /(?i)testsigning/ or
        $proc.target.process.command_line = /(?i)DDISABLE_INTEGRITY_CHECKS/
      )
    )

    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $actor_userid = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
