/*
  MITRE Technique : T1006 - Direct Volume Access
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:27:10.109725+00:00
  Reference       : https://attack.mitre.org/techniques/T1006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1006_Direct_Volume_Access_Via_Raw_Disk_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects large volume of data transfer from network devices to external destinations using raw disk access patterns, indicated by sustained high-bandwidth flows to uncommon ports or protocols that bypass standard file transfer mechanisms."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1006"
    mitre_technique_name = "Direct Volume Access"
    log_prerequisites = "Requires firewall or proxy flow logs with byte count and duration metrics."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate backup operations to cloud storage, database replication, large file transfers via non-standard applications, CDN synchronization, authorized data migration activities."
    tuning_guidance = "Add approved backup destinations to %global_allowed_domains and %global_allowed_backup_processes. Adjust byte threshold based on baseline network behavior. Exclude known backup windows by time if necessary."

  events:
    $flow.metadata.event_type = "NETWORK_FLOW"
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.hostname in %global_allowed_domains
    $flow.network.sent_bytes > 104857600
    (
      $flow.target.port < 1024 and 
      $flow.target.port != 80 and 
      $flow.target.port != 443 and 
      $flow.target.port != 22 and 
      $flow.target.port != 21
    ) or (
      $flow.target.port > 49152
    )
    $flow.network.ip_protocol != "ICMP"
    not $flow.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1006")
    $primary_entity = array_distinct($flow.principal.ip)
    $destination_ips = array_distinct($flow.target.ip)
    $total_bytes_sent = max($flow.network.sent_bytes)

  condition:
    $flow
}
