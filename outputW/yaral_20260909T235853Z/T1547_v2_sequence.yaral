/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:09:20.944318+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_Autostart_Registry_Write_Then_Logon_Exec {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage persistence pattern: a process writes to a well-known Windows autostart registry key (Run/RunOnce/Winlogon/LSA/AppInit), then within 10 minutes a new process launches from the path that was registered. This correlation provides additive coverage beyond command-line matching by tying the registry write to the subsequent execution triggered at logon or boot."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION) and process-launch telemetry (PROCESS_LAUNCH) normalised into UDM. Both event types must be present for the correlation to fire."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers registering legitimate startup entries, RMM agents, endpoint security products, and Windows Update components writing to Run keys. Logon scripts deployed via GPO may also trigger this pattern."
    tuning_guidance = "Add known-good installer and RMM parent process paths to %global_allowed_admin_tools. Add authorised service accounts that perform software deployment to %global_allowed_service_accounts. Narrow the registry key regex if only specific sub-keys are relevant in your environment."

  events:
    // Stage 1: registry write to a known autostart location
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(SOFTWARE\\(Microsoft\\Windows\\CurrentVersion\\Run(Once)?|Microsoft\\Windows NT\\CurrentVersion\\(Winlogon|Image File Execution Options)|Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run)|SYSTEM\\CurrentControlSet\\Control\\(Session Manager\\(AppCertDlls|KnownDLLs)|Lsa))/  nocase
    // Capture the registered executable path from the registry value data
    re.regex($reg.target.registry.registry_value_data, /\.(exe|dll|bat|cmd|ps1|vbs|js|scr|com)/)
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Stage 2: a process launches whose image path overlaps with the written value
    // We match on the host; the analyst correlates the specific path in the alert.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\.(exe|scr|com)$/ nocase
    // Exclude common high-volume, well-known system launchers to avoid Cartesian explosion
    not $proc.target.process.file.full_path = /\\(svchost|RuntimeBroker|sihost|taskhostw|ctfmon|SearchIndexer|spoolsv|lsass|csrss|wininit|services|smss)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Chronological ordering: registry write must precede process launch
    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1547")
    $primary_entity      = array_distinct($hostname)
    $autostart_reg_key   = array_distinct($reg.target.registry.registry_key)
    $reg_value_data      = array_distinct($reg.target.registry.registry_value_data)
    $writing_process     = array_distinct($reg.principal.process.file.full_path)
    $launched_process    = array_distinct($proc.target.process.file.full_path)
    $affected_user       = array_distinct($proc.principal.user.userid)

  condition:
    $reg and $proc
}
