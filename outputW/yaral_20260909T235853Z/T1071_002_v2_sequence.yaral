/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:34:55.608670+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_NetDev_FTP_Login_Then_Outbound_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network device management-plane login followed within 5 minutes by an outbound FTP/TFTP/FTPS flow to an external destination. Adversaries abuse file transfer protocols for C2 by authenticating to a network device and then exfiltrating configuration or staging payloads via FTP (TCP 21), FTPS (TCP 990), or TFTP (UDP 69). The correlation of a management login with a subsequent outbound file-transfer flow from the same device is a strong indicator of abuse."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires network device syslog forwarded to Chronicle (management-plane login events normalised to USER_LOGIN) and firewall/flow telemetry normalised to NETWORK_FLOW or NETWORK_CONNECTION showing the device as principal."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Scheduled configuration backups via TFTP/FTP to authorised management servers, automated firmware upgrade jobs, and network monitoring systems polling devices via FTP."
    tuning_guidance = "Add authorised backup/management server IPs to %global_allowed_backup_processes (used here as a string list of known-good destination addresses). Add approved service accounts performing scheduled transfers to %global_allowed_service_accounts. Narrow the port list if TFTP (UDP 69) is not used in your environment."

  events:
    // Event 1: Management-plane login to a network device
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %rfc1918_internal
    $auth.target.hostname = $device_hostname

    // Event 2: Outbound file-transfer protocol flow originating from the same device
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $device_hostname
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.ip in %global_allowed_mgmt_sources
    (
      $flow.target.port = 21 or
      $flow.target.port = 990 or
      $flow.target.port = 69
    )

    // Chronological ordering: login must precede the outbound transfer
    $auth.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($device_hostname)
    $login_user = array_distinct($auth.principal.user.userid)
    $login_source_ip = array_distinct($auth.principal.ip)
    $transfer_destination_ip = array_distinct($flow.target.ip)
    $transfer_destination_port = array_distinct($flow.target.port)
    $bytes_sent = max($flow.network.sent_bytes)

  condition:
    $auth and $flow
}
