/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:25:54.404058+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_SSSD_AuthCache_File_Read {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-read or file-open access to SSSD or Quest Authentication Services credential cache databases on Linux. Adversaries with root or sudo access read these files to extract cached Active Directory credential hashes for offline cracking. This rule fires on the file artifact access rather than on command-line invocation, providing coverage that evades process-creation log gaps."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires Linux EDR or auditd file-access telemetry normalised to Chronicle UDM FILE_READ events. Auditd rules must include '-a always,exit -F arch=b64 -S open,openat -F path=/var/lib/sss/db -F perm=r' and equivalent for /var/opt/quest/vas/authcache/."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "SSSD daemon itself reading its own cache during normal operation; sssd_be and sssd_nss processes; backup agents reading /var/lib/sss/db; monitoring agents performing integrity checks."
    tuning_guidance = "Add the SSSD daemon process paths (sssd, sssd_be, sssd_nss) and approved backup process paths to %global_allowed_backup_processes. Add authorised security scanning processes to %global_allowed_scanners. Scope the rule further by requiring the accessing process to be outside /usr/sbin/sssd*."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Match SSSD cache database files or Quest VAS auth cache
    $file.target.file.full_path = /\/var\/lib\/sss\/db\/cache\.[^\/]+\.ldb$/ nocase or
    $file.target.file.full_path = /\/var\/lib\/sss\/db\/ccache_/ nocase or
    $file.target.file.full_path = /\/var\/opt\/quest\/vas\/authcache\/vas_auth\.vdb$/ nocase or
    $file.target.file.full_path = /\/var\/opt\/quest\/vas\/authcache\// nocase

    // Exclude the SSSD daemon and its child processes performing legitimate reads
    not $file.principal.process.file.full_path = /\/usr\/sbin\/sssd/ nocase
    not $file.principal.process.file.full_path = /\/usr\/libexec\/sssd\// nocase

    // Exclude approved backup and security tooling
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity    = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $cache_file_accessed = array_distinct($file.target.file.full_path)
    $accessing_user    = array_distinct($file.principal.user.userid)

  condition:
    $file
}
