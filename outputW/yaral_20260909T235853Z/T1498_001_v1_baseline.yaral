/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:58:48.602453+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Direct_Network_Flood_High_Volume_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects potential direct network flood activity by identifying a single internal source generating an abnormally high volume of outbound connections to external destinations within a short window. Stateless protocols (UDP) and high packet rates to diverse external IPs are characteristic of flood-based DoS/DDoS participation."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Requires firewall or perimeter flow logs with per-connection or per-flow records including source IP, destination IP, protocol, and byte/packet counts."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate high-throughput backup or replication jobs, CDN edge nodes, authorized load testing, video streaming appliances, or misconfigured network devices generating broadcast storms."
    tuning_guidance = "Add known high-volume legitimate source IPs to %global_allowed_scanners or %global_allowed_backup_processes. Raise the connection count threshold if the environment has legitimate bulk-transfer hosts. Narrow protocol filter to UDP-only if TCP floods are not a concern."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    not $net.principal.ip in %rfc1918_internal or not $net.target.ip in %rfc1918_internal

    // Exclude purely internal traffic - at least the target must be external
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good sources such as authorised scanners and backup agents
    not $net.principal.ip in %global_allowed_scanners

    // Capture the source for grouping
    $net.principal.ip = $src_ip

  match:
    $src_ip over 1m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $distinct_destinations = count(distinct $net.target.ip)
    $total_flows = count($net.metadata.event_timestamp.seconds)
    $destination_ports = array_distinct($net.target.port)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net > 500
}
