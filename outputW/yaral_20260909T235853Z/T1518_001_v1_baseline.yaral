/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:59:45.443424+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_IaaS_Security_Agent_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of cloud-native security monitoring agents and services via cloud provider APIs. Adversaries query CloudWatch, Azure Monitor, GCP Cloud Monitoring, Security Hub, Defender for Cloud, or Security Command Center to discover installed security tooling before deciding whether to proceed with further actions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM: AWS CloudTrail, Azure Activity Log, or GCP Audit Log. The rule targets USER_RESOURCE_ACCESS events where the API action enumerates security monitoring or agent resources."
    platform = "IaaS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate DevOps pipelines querying monitoring agent status, infrastructure-as-code tooling (Terraform, Ansible) performing inventory checks, cloud security posture management (CSPM) tools, authorised vulnerability scanners, and cloud provider health checks."
    tuning_guidance = "Add known automation and CSPM service principals to %global_allowed_cloud_principals. Add authorised scanner source identities to %global_allowed_scanners. If a specific user or service account generates high volume of benign hits, add it to %global_allowed_service_accounts."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match API actions that enumerate security agents, monitoring services,
    // or security posture resources across AWS, Azure, and GCP.
    // AWS: Describe/List on CloudWatch, GuardDuty, SecurityHub, Inspector, Macie, SSM agents
    // Azure: Microsoft.Security/* read, Microsoft.Compute/virtualMachines/extensions/read
    // GCP: cloudasset.assets.searchAllResources on monitoring/security resources
    $cloud.target.resource.name = /(?i)(cloudwatch|guardduty|securityhub|inspector|macie|security.center|security.command.center|cloud.monitor|azure.monitor|microsoft\.security|vm.agent|ssm.agent|cloud.watch.agent|amazon.ssm|amazon.cloudwatch|cloud.armor|web.security.scanner|container.analysis|event.threat.detection)/

    // Restrict to read/list/describe/get style operations - enumeration verbs
    $cloud.network.http.method = /(?i)(get|list|describe|search|query|read)/

    // Exclude known-good automation principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
