/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:13:45.654772+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_LKM_File_Drop_Then_Module_Load {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a kernel module file (.ko) written to a suspicious or non-standard path, followed within 10 minutes by a process that loads a kernel module (insmod/modprobe/kmod) on the same host. This two-stage correlation provides additive coverage beyond command-line-only detections by anchoring the alert to the file-drop event that precedes the load."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that emits FILE_CREATION events for kernel object files and PROCESS_LAUNCH events for module-loading utilities (insmod, modprobe, kmod). Auditd rules should watch -w /tmp -p wa and -a always,exit -F arch=b64 -S finit_module,init_module."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate kernel module installation by package managers (apt, yum, dnf) writing to /lib/modules or /usr/lib/modules; DKMS rebuilding out-of-tree modules after a kernel update; hardware vendor drivers installed by administrator scripts."
    tuning_guidance = "Exclude known-good parent processes (package managers, DKMS) by adding their full paths to %global_allowed_admin_tools. Narrow the file path regex to exclude /lib/modules and /usr/lib/modules if those are well-managed in your environment. Raise severity to Critical if the drop path is /tmp, /dev/shm, or /var/tmp."

  events:
    // Event 1: A .ko kernel module file is created in a suspicious or
    // non-standard location (outside the canonical /lib/modules tree).
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.ko$/
    not $file.target.file.full_path = /(?i)\/lib\/modules\//
    not $file.target.file.full_path = /(?i)\/usr\/lib\/modules\//
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Event 2: A kernel module loader is launched on the same host.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(insmod|modprobe|kmod)$/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Chronological ordering: file drop must precede the load attempt.
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity    = array_distinct($hostname)
    $dropped_ko_paths  = array_distinct($file.target.file.full_path)
    $loader_processes  = array_distinct($proc.target.process.file.full_path)
    $loader_cmdlines   = array_distinct($proc.target.process.command_line)
    $drop_parent_procs = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $proc
}
