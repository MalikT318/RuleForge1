/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:37:54.056039+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_Access_Token_Manipulation_Suspicious_Token_Impersonation {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes launched via token impersonation or privilege escalation patterns on Windows. Specifically targets use of runas, token-duplication-capable tools, or processes spawned under SYSTEM context from non-SYSTEM parents - a core OS mechanism exploited by T1134. Focuses on command-line and process-lineage signals rather than specific tool names."
    mitre_tactic    = "Privilege Escalation, Defense Evasion"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with command-line logging enabled. Windows Security Event 4688 with process command-line auditing also satisfies this requirement."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate runas usage by administrators, RMM tools performing privileged operations, software deployment agents, and IT automation scripts that legitimately impersonate service accounts."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools. Add authorised service and automation accounts to %global_allowed_service_accounts. Narrow scope by adding specific parent process exclusions for your RMM or deployment tooling."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Detect runas-based token manipulation or processes launched with explicit
    // alternate credentials - a primary OS mechanism for T1134.
    // Also catch PowerShell and scripting hosts invoking token-related APIs
    // via Start-Process -Credential or similar constructs.
    (
      // runas with /user flag signals explicit alternate-credential process creation
      (
        $proc.target.process.file.full_path = /\\runas\.exe$/ nocase
        and $proc.target.process.command_line = /\/user:/ nocase
      )
      or
      // PowerShell spawning processes with -Credential or using token APIs
      (
        $proc.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and $proc.target.process.command_line = /(-Credential|-RunAs|ImpersonateLoggedOnUser|DuplicateToken|OpenProcessToken|AdjustTokenPrivileges|CreateProcessWithToken|LogonUser)/ nocase
      )
      or
      // Script hosts (wscript/cscript) spawning privileged child processes -
      // common post-exploitation pattern for token theft pivoting to SYSTEM
      (
        $proc.principal.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
        and $proc.target.process.command_line = /\/user:|runas|token/ nocase
      )
      or
      // cmd.exe or powershell launched directly under a high-integrity parent
      // that is itself a non-interactive shell - indicates token-based lateral movement
      (
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh)\.exe$/ nocase
        and $proc.target.process.command_line = /\/user:\S+\\(administrator|system|admin)/ nocase
      )
    )

    // Exclude known-good administrative tooling and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $target_user       = array_distinct($proc.target.user.userid)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $child_cmdline     = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
