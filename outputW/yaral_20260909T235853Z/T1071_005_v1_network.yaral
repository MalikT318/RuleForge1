/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:36:25.463062+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_PubSub_Protocol_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections to external destinations on ports commonly used by publish/subscribe messaging protocols (MQTT 1883/8883, AMQP 5671/5672, STOMP 61613/61614, XMPP 5222/5269). Adversaries abuse these protocols to blend C2 traffic with legitimate messaging infrastructure. Firewall/perimeter observation - no process context available."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires firewall or perimeter flow logs with destination IP and port visibility. Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events with target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "IoT device management platforms using MQTT, enterprise messaging middleware (RabbitMQ, ActiveMQ), legitimate XMPP chat clients, cloud IoT services (AWS IoT, Azure IoT Hub), CI/CD pipelines using AMQP-backed queues."
    tuning_guidance = "Add known-good external broker destinations to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Narrow scope by restricting principal.ip to workstation subnets if server-to-server AMQP/MQTT is expected in your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Pub/sub protocol ports: MQTT (1883, 8883 TLS), AMQP (5672, 5671 TLS),
    // STOMP (61613, 61614 TLS), XMPP client (5222), XMPP server (5269)
    (
      $net.target.port = 1883 or
      $net.target.port = 8883 or
      $net.target.port = 5672 or
      $net.target.port = 5671 or
      $net.target.port = 61613 or
      $net.target.port = 61614 or
      $net.target.port = 5222 or
      $net.target.port = 5269
    )

    // Exclude RFC1918 internal destinations - pub/sub C2 routes externally
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external broker domains resolved to these IPs
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised vulnerability scanners generating synthetic traffic
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved remote management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
