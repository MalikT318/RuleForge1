/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:01:01.660743+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process opening a handle to a remote process with permissions consistent with PE injection (PROCESS_VM_WRITE + PROCESS_CREATE_THREAD or PROCESS_VM_OPERATION). Attackers performing portable executable injection must request these access rights via OpenProcess before writing shellcode or a PE image into the target's virtual address space. This rule pivots on the process handle request rather than command-line telemetry, providing additive coverage that is harder to evade."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised to UDM PROCESS_OPEN. The source process file path and granted access mask must be populated in principal.process and target.process fields respectively."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, x64dbg), profilers (VTune, dotTrace), crash reporters, AV/EDR agents performing memory scanning, backup agents, and some RMM tools that inject helper DLLs. Security tooling is the dominant false-positive source."
    tuning_guidance = "Add known-good parent process paths (debuggers, profilers, security agents) to %global_allowed_security_tools and %global_allowed_admin_tools. Consider narrowing by requiring the principal process to reside outside of known system directories using a regex exclusion on principal.process.file.full_path."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The requesting (injecting) process must not be a known Windows system binary.
    // Legitimate system processes rarely need cross-process write+execute access.
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\/ 
    not $open.principal.process.file.full_path = /(?i)\\windows\\syswow64\\/
    not $open.principal.process.file.full_path = /(?i)\\windows\\sysnative\\/

    // The target process being opened must be a running process (has a path populated).
    // Targeting high-value system processes is a strong injection signal.
    $open.target.process.file.full_path = /(?i)\\(lsass|svchost|explorer|winlogon|csrss|services|spoolsv|taskhost|taskhostw|dllhost|werfault|msiexec|rundll32|regsvr32|wscript|cscript|mshta)\.exe$/

    // Access mask values consistent with PE injection:
    // PROCESS_VM_WRITE (0x0020), PROCESS_VM_OPERATION (0x0008), PROCESS_CREATE_THREAD (0x0002).
    // Sysmon/EDR normalise the granted access mask into this field.
    // A mask of 0x1fffff (PROCESS_ALL_ACCESS) or combinations including write+create_thread are flagged.
    $open.target.process.access_mask = /(?i)^(0x1f0fff|0x1fffff|0x0022|0x002[0-9a-f]|0x00[2-9a-f][0-9a-f])$/

    // Exclude approved security and admin tooling that legitimately opens process handles.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($open.principal.hostname)

  condition:
    $open
}
