/*
  MITRE Technique : T1207 - Rogue Domain Controller
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:49:21.096098+00:00
  Reference       : https://attack.mitre.org/techniques/T1207
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1207_001_DCShadow_Rogue_DC_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects DCShadow-style rogue Domain Controller registration via modification of the AD Configuration partition. Attackers write new server or nTDSDSA objects into the Configuration NC registry keys or trigger replication registration from a non-DC host. This rule targets the registry modification that occurs when a rogue DC registers itself by writing DC-related configuration entries."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1207"
    mitre_technique_name = "Rogue Domain Controller"
    log_prerequisites = "Requires EDR registry telemetry (Sysmon Event ID 13/14) or Windows Security Event 4657. The modifying process and registry key path must be populated in UDM."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate Domain Controller promotion (dcpromo / AD DS role installation), authorised AD schema extensions by Microsoft tooling, domain join operations performed by approved provisioning systems."
    tuning_guidance = "Add authorised DC provisioning hosts to %global_allowed_admin_tools and authorised service accounts performing AD DS promotion to %global_allowed_service_accounts. Scope by principal.hostname to known DC build hosts if the environment uses a dedicated provisioning VLAN."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Configuration partition path where nTDSDSA and server objects are registered.
    // DCShadow writes under HKLM\SYSTEM\CurrentControlSet\Services\NTDS or
    // manipulates the AD replication service registration keys.
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Services\\NTDS/

    // The specific value names written during rogue DC registration relate to
    // DSA object GUIDs, replication epochs, or service principal names.
    // Match any write to DSA-related value names.
    (
      $reg.target.registry.registry_value_name = /(?i)(DSA|nTDSDSA|invocationId|replicationEpoch|msDS-ReplicationEpoch|serviceAccountName|LdapSystemPort|GlobalCatalogPort)/
      or
      $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Services\\NTDS\\Parameters/
    )

    // The modifying process should NOT be the legitimate NTDS or lsass process.
    // Rogue DC tools (e.g. mimikatz dcshadow) run from user-space processes.
    not $reg.principal.process.file.full_path = /(?i)\\(lsass|ntdsutil|dcpromo|dfsvc|mmc|ServerManager)\.exe$/

    // Exclude known-good administrative and provisioning tooling.
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service accounts performing legitimate AD DS operations.
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1207")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key_written = array_distinct($reg.target.registry.registry_key)
    $registry_value_written = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
