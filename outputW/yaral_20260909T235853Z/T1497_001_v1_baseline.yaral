/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:57:31.669681+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_VM_Sandbox_Evasion_System_Checks {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes querying multiple VM/sandbox artifact indicators in a single command line. Adversaries enumerate WMI, registry, or system properties to detect virtual machine environments (VMware, VirtualBox, Hyper-V, Sandbox) before executing payloads. This rule targets the command-line pattern of chaining VM-detection queries, which is a strong behavioral signal regardless of the tool used."
    mitre_tactic    = "Defense Evasion, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line logging enabled. WMI query logging or PowerShell script-block logging (Event ID 4104) also surfaces this technique."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "IT asset inventory tools, legitimate VM management software, hypervisor agents running inside VMs, and some EDR/AV self-checks. Baseline hosts running approved admin tooling."
    tuning_guidance = "Add known asset-inventory or VM-management parent process paths to %global_allowed_admin_tools. Add service accounts that run inventory scripts to %global_allowed_service_accounts. Consider narrowing the rule to non-VM hosts if your environment is predominantly physical."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting hosts and query tools commonly abused for VM checks
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wmic|wscript|cscript|cmd)\.exe$/ nocase

    // Match command lines that reference VM/hypervisor/sandbox artifact strings.
    // Using alternation within a single regex to catch the most common VM fingerprint terms.
    $proc.target.process.command_line = /(?i)(vmware|virtualbox|vbox|qemu|xen|hyper\-v|bochs|parallels|virtual\s*machine|sandboxie|cuckoo|anubis|joebox|threatexpert|cwsandbox|vmtoolsd|vmsrvc|vboxservice|vboxtray|vmwaretray|vmwareuser|vmacthlp|vmusr|vmtoolsd|vmwarehgfs|vmhgfs|vmci|vmxnet|vmx_svga|innotek|vboxguest|vboxmouse|vboxsf|vboxvideo)/ nocase

    // Additionally require that the command line contains a discovery-oriented action
    // (WMI query, registry read, process list, or system info) to reduce noise
    $proc.target.process.command_line = /(?i)(select|get\-wmiobject|get\-ciminstance|gwmi|reg\s+query|systeminfo|tasklist|wmic\s+(computersystem|bios|diskdrive|process|baseboard))/ nocase

    // Exclude approved administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
