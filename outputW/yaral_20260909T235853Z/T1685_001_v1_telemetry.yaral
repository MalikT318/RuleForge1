/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:38:27.594346+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Service_Registry_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications that disable or reconfigure the Windows EventLog service or its per-channel audit settings. Attackers modify the Start value of the EventLog service key, or set individual channel Enabled values to 0, to suppress logging without spawning a detectable command line. This rule fires on the resulting registry state change rather than the process that caused it, providing a complementary detection layer to any existing command-line rules."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13 or equivalent EDR registry-write events) normalised to UDM REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy application of audit policy changes by authorised administrators; backup or imaging software reconfiguring log channels; some RMM tools that manage log retention settings."
    tuning_guidance = "Add authorised administrator accounts to %global_allowed_admin_users and authorised tooling paths to %global_allowed_admin_tools to suppress known-good policy management activity. Consider narrowing to specific high-value channels (Security, System, Application) if noise from third-party application log channels is excessive."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Match the EventLog service Start value (set to 4 = disabled) OR
    // any EventLog channel Enabled value OR
    // the AutoBackupLogFiles / MaxSize suppression keys
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Services\\EventLog/

    // Capture writes to the service Start key or per-channel control values
    (
      $reg.target.registry.registry_value_name = /(?i)^Start$/
      or
      $reg.target.registry.registry_value_name = /(?i)^Enabled$/
      or
      $reg.target.registry.registry_value_name = /(?i)^AutoBackupLogFiles$/
      or
      $reg.target.registry.registry_value_name = /(?i)^Retention$/
    )

    // Exclude authorised admin accounts performing policy management
    not $reg.principal.user.userid in %global_allowed_admin_users

    // Exclude authorised tooling (GPO client, RMM agents, backup software)
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_registry_key = array_distinct($reg.target.registry.registry_key)
    $affected_value_name = array_distinct($reg.target.registry.registry_value_name)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
