/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:29:25.544981+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Securityd_Memory_Proc_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a non-system process opening /proc/<pid>/mem or /proc/<pid>/maps of the securityd or keychain-related daemon for direct memory reading. On Linux systems running analogous credential daemons (gnome-keyring-daemon, kwallet, etc.), adversaries with root access may read process memory via the /proc filesystem to extract plaintext credentials without invoking any suspicious command-line arguments. This rule fires on FILE_READ events targeting /proc/*/mem or /proc/*/maps where the accessing process is not a known-good system or security tool."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux EDR or auditd with file-read/open syscall auditing enabled (e.g., auditd rules: -a always,exit -F arch=b64 -S open,openat,read -F path=/proc). Chronicle UDM must normalise these as FILE_READ events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace) used by developers; system monitoring agents reading /proc for performance metrics; EDR/AV agents performing memory scanning; crash dump collectors."
    tuning_guidance = "Add authorised debugging and monitoring process paths to %global_allowed_security_tools or %global_allowed_admin_tools. Scope further by correlating the target PID to a known credential daemon process name if your EDR enriches /proc path events with the target process name."

  events:
    $open.metadata.event_type = "FILE_READ"

    // Target must be a /proc/<pid>/mem or /proc/<pid>/maps path - direct memory access vectors
    $open.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|environ|fd\/[0-9]+)$/ nocase

    // The accessing process must not be a known-good system binary
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude kernel threads and common benign /proc readers
    // Kernel threads have no file path; exclude common system monitors
    not $open.principal.process.file.full_path = /\/(usr\/)?bin\/(ps|top|htop|cat|ls|stat|find|awk|grep|sed|sort|uniq|wc|xargs|strace|ltrace|gdb|python[23]?|perl|ruby|bash|sh|dash|zsh|ksh)$/ nocase

    // Require a principal hostname to be present (filters out incomplete events)
    $open.principal.hostname != ""

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $accessing_process = array_distinct($open.principal.process.file.full_path)
    $target_proc_path = array_distinct($open.target.file.full_path)
    $actor_userid = array_distinct($open.principal.user.userid)

  condition:
    $open
}
