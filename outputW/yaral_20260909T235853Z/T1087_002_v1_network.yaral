/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:21:46.073012+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_Domain_Account_LDAP_Recon_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound LDAP or LDAPS connections from non-domain-controller internal hosts to port 389 or 636, characteristic of domain account enumeration tools querying Active Directory directly. Adversaries performing T1087.002 discovery (net user /domain, ldapsearch, PowerShell Get-ADUser) generate LDAP connections that are visible at the network perimeter or internal firewall. This rule fires on connections originating from internal space destined for LDAP ports on external or unexpected hosts, or on high-volume LDAP flows indicative of bulk enumeration."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires firewall, next-gen firewall, or network flow logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source and destination IP, destination port, and byte counts must be populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate LDAP clients (HR systems, monitoring tools, approved identity-aware proxies) querying domain controllers. Vulnerability scanners in %global_allowed_scanners. Approved admin tooling in %global_allowed_admin_tools."
    tuning_guidance = "Add known-good LDAP client source IPs to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Raise the network.sent_bytes threshold if bulk AD sync tools generate false positives. Narrow scope by restricting target.ip to your DC subnet using net.ip_in_range_cidr() if DC ranges are stable."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // LDAP (389) or LDAPS (636) destination ports
    (
      $net.target.port = 389 or
      $net.target.port = 636
    )

    // Source must be an internal address (RFC1918); external-to-external is not our concern
    $net.principal.ip in %rfc1918_internal

    // Destination must NOT be internal - flags connections leaving the perimeter
    // or reaching unexpected external LDAP endpoints (exfil via LDAP, rogue DC)
    not $net.target.ip in %rfc1918_internal

    // Exclude approved management and scanner sources
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // Require non-trivial data transfer to reduce noise from connection probes
    // that immediately reset; genuine LDAP queries carry a response payload
    $net.network.sent_bytes > 200

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = max($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
