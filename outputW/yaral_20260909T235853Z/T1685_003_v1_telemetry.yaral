/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:39:53.722013+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Security_Tool_Config_Tamper_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file modification of security tool configuration, status, or UI-facing files on Linux that could indicate an adversary spoofing or falsifying the apparent health state of a security agent. Attackers disable or degrade EDR/AV/logging agents and then overwrite their config or status files to maintain the appearance of normal operation. This rule pivots on the resulting file artifact rather than the command line used to produce it."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_MODIFICATION or FILE_CREATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate security agent self-updates, package manager upgrades of security software (apt/yum/dnf), authorised configuration management tools (Ansible, Puppet, Chef), and backup restoration jobs."
    tuning_guidance = "Add known-good automation service accounts to %global_allowed_service_accounts. Add authorised configuration management or deployment processes to %global_allowed_admin_tools. Scope by principal.process.file.full_path to exclude package managers if they generate excessive noise."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target: configuration, status, socket, or UI-facing files belonging to
    // common Linux security agents (EDR, AV, HIDS, audit, syslog, osquery).
    // Regex covers paths such as:
    //   /etc/ossec/ossec.conf, /var/ossec/etc/ossec.conf
    //   /etc/auditd/auditd.conf, /etc/audit/audit.rules
    //   /etc/rsyslog.conf, /etc/rsyslog.d/*.conf
    //   /etc/syslog-ng/syslog-ng.conf
    //   /var/lib/osquery/osquery.db (status store)
    //   /etc/osquery/osquery.conf
    //   /etc/clamav/clamd.conf, /etc/clamav/freshclam.conf
    //   /var/lib/clamav/ (signature/status files)
    //   /etc/falco/falco.yaml, /etc/falco/falco_rules.yaml
    //   /opt/[vendor]/[agent]/conf* or status* files
    //   /var/log/audit/audit.log (direct log tampering)
    //   /var/log/syslog, /var/log/messages (syslog tampering)
    $file.target.file.full_path = /(?i)(\/etc\/(ossec|auditd?|audit|rsyslog|syslog-ng|clamav|falco|osquery)|\/var\/(ossec|lib\/(clamav|osquery)|log\/(audit\/audit|syslog|messages|secure))|\/opt\/[^\/]+\/[^\/]*(conf|config|status|health|ui)[^\/]*)/ nocase

    // Exclude writes by the security agent processes themselves (self-update
    // or normal runtime writes). The exclusion list covers known-good binaries;
    // anything NOT in the list that writes these files is suspicious.
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude authorised service accounts (config management, package managers)
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude known admin/deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude root-owned package manager writes (apt, dpkg, rpm, yum, dnf)
    // by matching the writing process path - these are expected during upgrades.
    not $file.principal.process.file.full_path = /(?i)\/usr\/(bin|sbin)\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper)/

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
