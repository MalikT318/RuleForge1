/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:22:05.675005+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_Container_Resource_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of container and Kubernetes resources via API calls. Adversaries query pods, nodes, deployments, services, secrets, and namespaces to map the environment before lateral movement or privilege escalation. This rule fires on broad LIST/GET operations against core Kubernetes resource types from non-approved principals."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Requires Kubernetes API server audit logs normalised into Chronicle UDM USER_RESOURCE_ACCESS events. The audit policy must capture LIST and GET verbs at the metadata or request level."
    platform = "Containers"
    log_source = "container"
    false_positives = "Kubernetes controllers (kube-controller-manager, scheduler), monitoring agents (Prometheus, Datadog), CI/CD pipelines, and authorised cluster-admin users performing routine inspection."
    tuning_guidance = "Add known service accounts used by monitoring and CI/CD tooling to %global_allowed_service_accounts. Add approved cluster-admin user identities to %global_allowed_admin_users. Consider narrowing the resource_type regex to the most sensitive resource types (secrets, serviceaccounts) for a higher-fidelity, lower-volume variant."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Kubernetes API verbs that enumerate resources
    $cloud.network.http.method = /(?i)^(GET|LIST)$/

    // Target Kubernetes resource types commonly enumerated during discovery
    $cloud.target.resource.name = /(?i)(pods|nodes|deployments|replicasets|daemonsets|statefulsets|services|endpoints|namespaces|secrets|configmaps|serviceaccounts|persistentvolumes|persistentvolumeclaims|ingresses|roles|rolebindings|clusterroles|clusterrolebindings)/

    // Exclude known-good service accounts and admin users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

    // Exclude approved cloud principals (e.g., managed controllers, operators)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)
    $http_method = array_distinct($cloud.network.http.method)

  condition:
    $cloud
}
