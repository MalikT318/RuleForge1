/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:10:56.457950+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_TimeProvider_Registry_DllName_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects registry modifications to the W32Time TimeProviders subkeys that set or change the DllName value. Adversaries register a malicious DLL as a time provider under HKLM\\System\\CurrentControlSet\\Services\\W32Time\\TimeProviders\\ to achieve persistence and execution as Local Service at boot. This rule targets the resulting registry state change rather than the process command line, providing coverage that survives command-line evasion."
    mitre_tactic         = "Persistence, Privilege Escalation"
    mitre_technique      = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites    = "Requires EDR or Sysmon registry event telemetry normalised to UDM REGISTRY_MODIFICATION or REGISTRY_CREATION. Sysmon Event ID 13 (RegistryValueSet) or equivalent EDR registry telemetry."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Legitimate NTP client software or Windows updates that register a new time provider DLL; Group Policy changes to W32Time configuration; third-party time synchronisation products (e.g., Meinberg NTP, VMware Tools time sync). Validate the DllName value points to a known-good, signed DLL in a system directory."
    tuning_guidance      = "Add parent process paths of known-good time-sync installers to %global_allowed_admin_tools. If a specific time-provider DLL path is approved, add the writing process to %global_allowed_admin_tools. Consider narrowing by excluding writes where the DllName value resolves to %SystemRoot%\\System32\\w32time.dll or other known-good paths."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the W32Time TimeProviders registry path
    $reg.target.registry.registry_key = /(?i)\\System\\CurrentControlSet\\Services\\W32Time\\TimeProviders\\/

    // Only alert when the DllName value is being set - this is the persistence mechanism
    $reg.target.registry.registry_value_name = /(?i)^DllName$/

    // Flag DLL paths that are NOT in expected Windows system directories
    // Legitimate providers live in System32; anything else is suspicious
    not $reg.target.registry.registry_value_data = /(?i)%systemroot%\\system32\\/
    not $reg.target.registry.registry_value_data = /(?i)C:\\Windows\\System32\\/

    // Exclude known-good administrative and deployment tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity    = array_distinct($reg.principal.hostname)
    $modified_key      = array_distinct($reg.target.registry.registry_key)
    $dll_value         = array_distinct($reg.target.registry.registry_value_data)
    $writing_process   = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
