/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:30:51.814586+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_Network_Logon_Script_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Group Policy or Active Directory logon script registry keys, indicating potential persistence via network logon scripts."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires Windows endpoint telemetry with registry modification events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Group Policy updates by domain administrators, automated GPO deployment tools, configuration management systems."
    tuning_guidance = "Add authorized GPO management tools to %global_allowed_admin_tools and service accounts performing GPO updates to %global_allowed_service_accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\software\\microsoft\\windows\\currentversion\\group policy\\scripts\\(logon|logoff|startup|shutdown)/ nocase
      or $reg.target.registry.registry_key = /\\software\\policies\\microsoft\\windows\\system\\scripts\\(logon|logoff|startup|shutdown)/ nocase
      or $reg.target.registry.registry_key = /\\environment\\userinitialmprlogonscript/ nocase
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($reg.principal.hostname)

  condition:
    $reg
}
