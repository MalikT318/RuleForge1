/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:16:28.325885+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of .desktop files in XDG Autostart directories (/etc/xdg/autostart or ~/.config/autostart). Adversaries abuse these files to achieve persistence by configuring malicious executables to launch when a user's desktop environment loads. This rule targets the file artifact produced by the technique rather than the process that created it, providing coverage orthogonal to command-line detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate desktop application installers (browsers, office suites, collaboration tools) writing their own autostart entries. Package managers (apt, dnf, snap, flatpak) installing GUI applications. User-initiated configuration of startup applications via GNOME/KDE settings panels."
    tuning_guidance = "Add known-good installer or package-manager process paths to %global_allowed_admin_tools to suppress noise from software deployment. If a specific set of approved autostart filenames is known, extend the exclusion logic with a reference list. Raise severity to Critical if the writing process originates from a suspicious parent such as a shell spawned by a web service."

  events:
    $file.metadata.event_type in ["FILE_CREATION", "FILE_MODIFICATION"]

    // Target must be a .desktop file inside an XDG Autostart directory.
    // Covers system-wide path /etc/xdg/autostart/ and per-user ~/.config/autostart/
    $file.target.file.full_path = /(?i)(\/etc\/xdg\/autostart\/|\/\.config\/autostart\/).+\.desktop$/

    // Exclude known-good administrative and deployment tooling writing autostart entries
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude recognised package managers and system update processes
    not $file.principal.process.file.full_path = /(?i)\/(apt|apt-get|dpkg|rpm|dnf|yum|zypper|snap|flatpak|packagekitd|gnome-software|discover)$/

    // Exclude writes originating from the user's own desktop settings daemon
    not $file.principal.process.file.full_path = /(?i)\/(gnome-session|gnome-control-center|kwriteconfig5|plasma-settings|xfce4-session|mate-session)$/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $autostart_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
