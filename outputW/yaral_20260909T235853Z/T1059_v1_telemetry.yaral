/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Office Suite
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:10:17.936399+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_Office_Suite_Script_Execution_Via_Audit_Log {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of scripts or macros within Office Suite environments (Microsoft 365 / Google Workspace) by pivoting on audit log events that record script-related resource access or setting changes. Adversaries abuse Office scripting capabilities (macros, Apps Script, Power Automate flows, add-ins) to execute arbitrary code without spawning a detectable process on an endpoint. This rule targets the resulting audit event rather than process-creation telemetry, providing coverage that evades command-line logging gaps."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log or Google Workspace Admin/Drive audit logs normalised into Chronicle UDM. Relevant operations include macro execution, Apps Script runs, Power Automate flow triggers, and add-in invocations."
    platform = "Office Suite"
    log_source = "vmware_esxi"
    false_positives = "Legitimate business automation flows, approved macro-enabled templates, sanctioned Apps Script deployments, IT-managed add-ins. Finance and operations teams frequently run macro-heavy workbooks."
    tuning_guidance = "Add known automation service accounts to %global_allowed_service_accounts. Add approved script-hosting principals to %global_allowed_script_hosts. Narrow the resource name regex to exclude known-good document libraries or shared drives."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource name indicates a macro-enabled Office document or a
    // scripting-capable resource (Apps Script project, Power Automate flow,
    // Office add-in manifest, or macro-enabled file extensions).
    // Regex covers: .xlsm .xlsb .xltm .docm .dotm .pptm .potm .ppam
    // .bas .vbs .gs (Google Apps Script) and "script" / "macro" / "flow"
    // in resource names as normalised by Chronicle UDM.
    $cloud.target.resource.name = /(?i)(\.xlsm|\.xlsb|\.xltm|\.docm|\.dotm|\.pptm|\.potm|\.ppam|\.bas|\.vbs|\.gs|macro|script|appscript|flow|add.?in)/

    // Exclude known-good service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved script-hosting principals (e.g., IT-managed automation)
    not $cloud.principal.user.userid in %global_allowed_script_hosts

    // Exclude approved cloud principals (sanctioned service accounts / apps)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_hostname = array_distinct($cloud.principal.hostname)

  condition:
    $cloud
}
