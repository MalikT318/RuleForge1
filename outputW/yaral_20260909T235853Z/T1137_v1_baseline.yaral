/*
  MITRE Technique : T1137 - Office Application Startup
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:40:54.260570+00:00
  Reference       : https://attack.mitre.org/techniques/T1137
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_Office_Application_Startup_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications consistent with Office Application Startup persistence mechanisms, including Office add-in registration, trusted template paths, and Outlook home page/form abuse. Adversaries abuse these Office startup hooks to achieve persistence across reboots."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137"
    mitre_technique_name = "Office Application Startup"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry normalised to UDM REGISTRY_MODIFICATION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office add-in installations, enterprise Group Policy deploying Office templates, IT management tools configuring Office settings, software deployment agents (SCCM, Intune)."
    tuning_guidance = "Add known-good deployment and management process paths to %global_allowed_admin_tools. Add authorised service accounts performing Office configuration to %global_allowed_service_accounts. Scope by principal.process.file.full_path to exclude trusted installers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target Office startup persistence registry locations:
    // - Add-ins (COM add-ins, WLL, XLL, VSTO)
    // - Trusted template/startup paths
    // - Outlook home page and WebView abuse
    // - Outlook form regions
    // - Office security and macro trust overrides that enable persistence payloads
    $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Office\\[0-9]+\.[0-9]+\\(Word|Excel|PowerPoint|Outlook|Access|OneNote)\\(Addins|Add-ins|Resiliency\\StartupItems|Options\\Startup|Security\\Trusted Locations|WebView|FormRegions|Outlook\\WebView)/

    // Exclude reads from known-good administrative and security tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

    // Exclude common legitimate Office update/install processes
    not $reg.principal.process.file.full_path = /(?i)\\(OfficeClickToRun|OfficeC2RClient|setup|msiexec|MicrosoftEdgeUpdate)\.exe$/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1137")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
