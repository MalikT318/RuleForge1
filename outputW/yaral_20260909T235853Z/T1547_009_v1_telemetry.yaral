/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:14:44.595290+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_LNK_File_Created_In_Startup_Location {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of .lnk shortcut files in Windows startup folders (per-user and all-users). Adversaries abuse startup shortcuts to achieve persistence by placing malicious .lnk files that execute payloads at user login or system boot. This rule targets the file artifact rather than the process command line, providing coverage that is harder to evade."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires EDR or Sysmon file-creation/modification telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers placing shortcuts in startup folders, RMM agents deploying managed shortcuts, user-initiated pinning of approved applications to startup."
    tuning_guidance = "Add known-good parent process paths (e.g. installer engines, deployment agents) to %global_allowed_admin_tools. Add known-good service accounts that perform software deployment to %global_allowed_service_accounts. Scope exclusions narrowly to avoid masking attacker activity."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a .lnk file
    $file.target.file.full_path = /\.lnk$/  nocase

    // Match both per-user and all-users startup folder paths.
    // Per-user:  C:\Users\<username>\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\
    // All-users: C:\ProgramData\Microsoft\Windows\Start Menu\Programs\StartUp\
    $file.target.file.full_path = /(?i)\\(Users\\[^\\]+\\AppData\\Roaming|ProgramData)\\Microsoft\\Windows\\Start Menu\\Programs\\Start[Uu]p\\/

    // Exclude known-good administrative and deployment tooling by parent process
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing software deployment
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $lnk_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
