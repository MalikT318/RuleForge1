/*
  MITRE Technique : T1578.004 - Revert Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:14:52.556305+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_004_Revert_Cloud_Instance {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud instance revert activity via snapshot restore or VM restore operations in cloud provider audit logs. Adversaries may restore a VM or storage snapshot to erase evidence of malicious activity and evade detection. Covers restore-from-snapshot, disk restore, and instance revert API calls normalized to UDM USER_RESOURCE_ACCESS."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.004"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Revert Cloud Instance"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs) ingested and normalized to UDM. Key API actions: RestoreSnapshotFromRecycleBin, CreateRestoreImageTask, RestoreDBInstanceToPointInTime, Microsoft.Compute/disks/write (from snapshot), compute.instances.insert (from snapshot), gcloud compute disks restore."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized disaster recovery runbooks, scheduled backup restoration tests, DevOps pipeline rollbacks, and infrastructure-as-code provisioning that clones from snapshots."
    tuning_guidance = "Add known automation service principals performing legitimate restores to %global_allowed_cloud_principals. Add known DR orchestration source addresses to %global_allowed_mgmt_sources. Narrow the regex if specific restore API verbs generate excessive noise in your environment."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match cloud API operations that indicate a snapshot or image restore / instance revert.
    // Covers AWS (RestoreSnapshot*, CreateRestoreImageTask, RestoreDBInstance*),
    // Azure (restore, createFromSnapshot, createFromImage in resource URIs),
    // and GCP (restoreSnapshot, createFromSnapshot, instancesInsert from snapshot source).
    $cloud.target.resource.name = /(?i)(restore|revert|rollback|createfromsnapshot|createfromimage|restorefromrecyclebin|restoredisk|restoreinstance|restoredbinstance|createrestoreimagetask|restoresnapshot)/ nocase

    // Restrict to compute or storage resource types to avoid matching unrelated restore verbs
    // (e.g., restoring a deleted IAM policy). Covers VM, disk, volume, snapshot, image, DB instance.
    $cloud.target.resource.resource_type = /(?i)(instance|virtualmachine|disk|volume|snapshot|image|dbinstance|computeengine|ec2|vm)/ nocase

    // Exclude known automation and DR service principals performing authorized restores
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known management/automation source addresses
    not $cloud.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1578.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
