/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:27:44.904665+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Mem_Read_Then_Outbound_File {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage credential harvesting pattern on Linux: a process opens /proc/<PID>/mem or /proc/<PID>/maps for reading (stage 1), followed within 10 minutes by the creation of a file in a world-writable or temporary location on the same host (stage 2). This combination is consistent with an adversary dumping in-memory credentials via the proc filesystem and staging the output for exfiltration. Intentionally avoids command-line matching to provide additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. FILE_READ events must be generated for /proc/<PID>/mem and /proc/<PID>/maps access (auditd -a always,exit -F arch=b64 -S open,openat -F dir=/proc -F exit>=0 recommended). FILE_CREATION events must be generated for /tmp, /dev/shm, /var/tmp, and similar staging paths."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, strace, ltrace) reading /proc/<PID>/mem for attached processes; Java/JVM runtimes inspecting their own memory maps; container runtimes and orchestration agents; security tools performing memory forensics; crash reporters (apport, systemd-coredump)."
    tuning_guidance = "Add known-good parent process paths (debuggers, JVM launchers, security agents) to %global_allowed_security_tools. Add authorised service accounts that perform memory inspection to %global_allowed_service_accounts. Narrow the staging-file regex if /tmp write activity is high in the environment."

  events:
    // Stage 1: process reads /proc/<PID>/mem or /proc/<PID>/maps
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps)$/
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.user.userid in %global_allowed_service_accounts
    $open.principal.hostname = $hostname

    // Stage 2: a file is created in a world-writable / staging directory on the same host
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|dev\/shm|var\/tmp|run\/shm)\//
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: proc read must precede the staged file write
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1003.007")
    $primary_entity      = array_distinct($hostname)
    $proc_mem_paths      = array_distinct($open.target.file.full_path)
    $staged_file_paths   = array_distinct($file.target.file.full_path)
    $reading_process     = array_distinct($open.principal.process.file.full_path)
    $writing_process     = array_distinct($file.principal.process.file.full_path)
    $acting_user         = array_distinct($open.principal.user.userid)

  condition:
    $open and $file
}
