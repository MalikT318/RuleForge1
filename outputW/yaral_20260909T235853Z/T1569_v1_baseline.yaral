/*
  MITRE Technique : T1569 - System Services
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:12:59.726507+00:00
  Reference       : https://attack.mitre.org/techniques/T1569
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_Linux_Service_Execution_Via_Systemctl_Or_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects abuse of Linux service management utilities (systemctl, service) to execute commands or programs. Adversaries may create transient systemd services or invoke existing service management tools to execute malicious payloads, achieve one-time execution, or establish persistence. This rule focuses on high-risk invocation patterns such as running services from world-writable or temporary directories, or using systemd-run to launch transient units from suspicious paths."
    mitre_tactic = "Execution"
    mitre_technique = "T1569"
    mitre_technique_name = "System Services"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events. Auditd syscall rules for execve are sufficient."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate administrators using systemctl or systemd-run for authorised service management. Configuration management tools (Ansible, Puppet, Chef) invoking service utilities. Container orchestration agents. Package manager post-install scripts."
    tuning_guidance = "Add known-good parent processes (e.g. configuration management agents, package managers) to %global_allowed_admin_tools. Add authorised service account identifiers to %global_allowed_service_accounts. Narrow the suspicious path regex if specific directories generate noise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target must be a Linux service management utility
    $proc.target.process.file.full_path = /\/(systemctl|systemd-run|service)$/ nocase

    // Match high-risk invocation patterns:
    // 1. systemd-run used to launch a transient unit (always suspicious from non-admin context)
    // 2. systemctl start/restart/enable targeting a unit file path in a suspicious location
    // 3. service <name> start/stop/restart where the binary or unit originates from tmp/dev/shm
    (
      $proc.target.process.command_line = /systemd-run/ nocase
      or
      $proc.target.process.command_line = /(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/shm\/)/ nocase
      or
      $proc.target.process.command_line = /--unit=/ nocase
    )

    // Exclude known-good administrative tooling and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1569")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_command = array_distinct($proc.target.process.command_line)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
