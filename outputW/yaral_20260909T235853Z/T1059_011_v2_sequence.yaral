/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:17:35.462954+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Drop_Then_Outbound_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Lua script file written to a world-writable or temporary Linux path followed by an outbound network connection from the same host within 5 minutes. This pattern is consistent with adversaries staging and executing Lua payloads that beacon or exfiltrate data. Variant 2 of 2 for T1059.011 - network-observable coverage via firewall telemetry joined with endpoint file-creation events."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires Linux EDR or auditd FILE_CREATION events AND firewall/perimeter NETWORK_CONNECTION or NETWORK_FLOW logs. Both sources must populate principal.hostname consistently for the join to succeed."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate applications that bundle Lua as a scripting engine (e.g., game servers, monitoring agents, network device management tools) may write .lua files to /tmp or /var and subsequently make outbound calls. Backup or deployment automation writing Lua configuration scripts. Security scanners writing test artefacts."
    tuning_guidance = "Add known-good source hosts to %global_allowed_scanners or %global_allowed_backup_processes. Add approved external destinations to %global_allowed_domains. Narrow the file path regex if your environment never legitimately writes Lua scripts to /tmp or /var/tmp. Raise risk_score if the destination port is non-standard (not 80/443)."

  events:
    // Event 1: A .lua script file is created in a suspicious Linux path
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/|\/var\/run\/).*\.lua$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Event 2: Outbound network connection from the same host to a non-internal destination
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.hostname in %global_allowed_remote_mgmt
    $net.principal.hostname = $hostname

    // Enforce chronological ordering: file drop before network connection
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($hostname)
    $lua_file_paths = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $net
}
