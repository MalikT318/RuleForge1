/*
  MITRE Technique : T1496.003 - SMS Pumping
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:56:28.849181+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_003_SMS_Pumping_Burst_Detection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects anomalous bursts of SMS send API calls in cloud audit logs, indicative of SMS pumping fraud. Threat actors abuse OTP/verification endpoints backed by cloud messaging services (e.g., SNS, Cognito, Twilio) to generate large volumes of SMS traffic to attacker-controlled phone number ranges, earning telco revenue at the victim's expense. This rule fires on a single high-volume SMS dispatch event or a cloud API call that sends SMS to an unusually large number of recipients in one operation."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.003"
    mitre_technique_name = "Resource Hijacking: SMS Pumping"
    log_prerequisites = "Requires cloud provider audit logs (e.g., AWS CloudTrail for SNS Publish, Cognito InitiateAuth, or equivalent GCP/Azure messaging API events) normalised into Chronicle UDM. The SMS send action must be captured as USER_RESOURCE_ACCESS or RESOURCE_CREATION with the target resource reflecting the messaging service."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate bulk SMS marketing campaigns, scheduled notification broadcasts, incident alerting systems, or multi-factor authentication services with high legitimate traffic. Allowlist known service principals in %global_allowed_cloud_principals."
    tuning_guidance = "Add authorised bulk-SMS service principals or automation accounts to %global_allowed_cloud_principals. Narrow the target.resource.name regex to match only the messaging service namespaces relevant to the client environment. Consider pairing with a threshold rule grouping by principal.user.userid over a short window for higher fidelity."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target a cloud messaging / SMS publish API action
    // Matches SNS Publish, Cognito SMS, or equivalent normalised action names
    $cloud.target.resource.name = /(?i)(sns|cognito|messaging|sms|notify|notification|publish|send.?message|send.?sms|otp|verification)/

    // The API method must reflect an outbound SMS or publish operation
    $cloud.network.http.method = /(?i)(publish|send|create|post|initiate)/

    // Exclude known-good cloud service principals (automation, approved bulk senders)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude internal scanner or security tooling sources
    not $cloud.principal.ip in %global_allowed_scanners

    // Require an external (non-RFC1918) source to reduce internal automation noise
    not $cloud.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1496.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
