/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:33:05.396477+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_SecretsManager_BulkAccess_After_NewPrincipal {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a cloud principal that first authenticates or assumes a role (or is newly observed) and then performs bulk secret retrieval operations against a cloud secrets management service within a short window. This pattern is consistent with a compromised or newly-minted identity harvesting credentials from a secrets manager (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault). The rule joins an initial access/authentication event to a burst of secret-read API calls by the same principal on the same host/source."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM. AWS CloudTrail (GetSecretValue, AssumeRole), GCP Audit (accessSecretVersion, generateAccessToken), or Azure Activity (SecretGet, GetToken) events must be ingested and mapped to USER_LOGIN / USER_RESOURCE_ACCESS event types."
    platform        = "IaaS"
    log_source      = "cloud_audit"
    false_positives = "Automated deployment pipelines and CI/CD systems that legitimately retrieve multiple secrets at startup; secret-rotation Lambda/Cloud Functions; infrastructure-as-code tooling (Terraform, Ansible) running against secrets stores; authorised security scanning."
    tuning_guidance = "Add known automation and service account identifiers to %global_allowed_service_accounts. Add approved cloud principals (e.g. deployment service accounts) to %global_allowed_cloud_principals. Raise the match window or add a minimum secret-access count threshold in the outcome if the environment has high-volume legitimate pipelines."

  events:
    // Event 1: Principal authentication or role/token assumption event
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    // Capture join key: the cloud principal identity
    $auth.principal.user.userid = $cloud_principal

    // Event 2: Secret retrieval API call(s) against a secrets management service
    $sec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $sec.principal.user.userid = $cloud_principal
    not $sec.principal.user.userid in %global_allowed_service_accounts
    not $sec.principal.user.userid in %global_allowed_cloud_principals
    // Match on normalised API method names for secret read operations across AWS / GCP / Azure
    // AWS: GetSecretValue, GCP: accessSecretVersion, Azure: SecretGet / GetSecret
    $sec.target.resource.name = /(?i)(getsecretvalue|accesssecretversion|secretget|getsecret|keyvault.*secret)/
    // Chronological ordering: auth must precede secret access
    $auth.metadata.event_timestamp.seconds <= $sec.metadata.event_timestamp.seconds

  match:
    $cloud_principal over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1555.006")
    $primary_entity      = array_distinct($cloud_principal)
    $secrets_accessed    = array_distinct($sec.target.resource.name)
    $source_ips          = array_distinct($sec.principal.ip)
    $auth_event_count    = count($auth.metadata.id)
    $secret_access_count = count($sec.metadata.id)

  condition:
    $auth and $sec
}
