/*
  MITRE Technique : T1092 - Communication Through Removable Media
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:33:53.087795+00:00
  Reference       : https://attack.mitre.org/techniques/T1092
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1092_001_Removable_Media_CnC_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation of script or executable artifacts in the root of a removable/USB drive path, a primary indicator of T1092 where adversaries stage commands or exfiltrated data on removable media to bridge air-gapped or disconnected networks."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1092"
    mitre_technique_name = "Communication Through Removable Media"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR FILE_CREATION events) with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers or portable applications written to USB drives by IT staff; backup tools writing to removable media; user-initiated file copies to USB storage."
    tuning_guidance = "Add authorised backup or deployment processes to %global_allowed_backup_processes. Add known-good script hosts or deployment tools to %global_allowed_admin_tools. Narrow the file extension regex if specific extensions generate excessive noise in your environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target a removable drive root or shallow path - Windows assigns drive
    // letters beyond C: for removable media; D: through Z: are common.
    // Matching root or one directory deep maximises signal for staged C2 drops.
    $file.target.file.full_path = /^[D-Zd-z]:\\[^\\]{0,64}\.(ps1|bat|cmd|vbs|js|hta|exe|dll|lnk|py|sh)$/ nocase

    // Restrict to processes that have no business writing scripts/executables
    // to removable media - flag interpreter and shell parents specifically.
    // Broad match: any process writing a script/executable to removable media
    // is suspicious; exclusions handle legitimate cases.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1092")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
