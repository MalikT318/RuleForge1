/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 3  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:47:43.518607+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_002_IaaS_Security_Policy_Disable_Then_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a sequence where a security policy or monitoring configuration is accessed or modified (potential exploitation of a defensive control) followed by a privilege or permission change on the same identity within 10 minutes. This pattern is consistent with an adversary exploiting cloud security tooling to impair defenses and then escalating or persisting via permission manipulation."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires identity provider audit logs capturing resource access events against security/policy resources and permission change events. Entra ID, Okta, or equivalent IdP audit streams normalized to UDM."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Authorized security administrators performing routine policy reviews followed by role assignments. Automated provisioning pipelines that update security configurations and then adjust permissions. Change-management windows where security posture changes are expected."
    tuning_guidance = "Add authorized security administrator accounts to %global_allowed_admin_users. Add approved automation service principals to %global_allowed_service_accounts. Add approved cloud management sources to %global_allowed_cloud_principals to suppress known-good provisioning workflows."

  events:
    // Event 1: Access or modification of a security-related resource (policy, conditional access, MFA, audit config)
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.resource.name = /(?i)(conditional.access|security.policy|audit.log|mfa|identity.protection|threat.protection|compliance.policy|defender|sentinel|monitor|alert.rule|diagnostic.setting)/
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals
    $access.principal.user.userid = $actor

    // Event 2: Permission or privilege change following the security resource access
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    $perm.principal.user.userid = $actor

    // Chronological ordering: security resource access must precede the permission change
    $access.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($actor)
    $security_resources_accessed = array_distinct($access.target.resource.name)
    $permission_targets = array_distinct($perm.target.user.userid)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $access and $perm
}
