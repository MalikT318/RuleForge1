/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:23:39.448547+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Dump_File_After_Process_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a non-system process opening a handle to lsass.exe followed by creation of a minidump-style file on the same host within 10 minutes. This two-stage correlation catches LSASS memory dumping via procdump, comsvcs.dll, custom tooling, or WerFault abuse without relying on command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_OPEN events (Sysmon Event ID 10) and FILE_CREATION events. Both must be normalised into Chronicle UDM with principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised EDR/AV agents performing LSASS scanning, Windows Error Reporting (WerFault.exe) during legitimate crash handling, approved backup or forensic tooling."
    tuning_guidance = "Add authorised security agent paths to %global_allowed_security_tools and approved backup process paths to %global_allowed_backup_processes. Narrow the dump-file regex if the environment uses a specific naming convention."

  events:
    // Event 1: A process opens a handle to lsass.exe (Sysmon Event ID 10 / EDR equivalent)
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /(?i)\\lsass\.exe$/
    // Exclude known-good security tooling from triggering on the open
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    $open.principal.hostname = $hostname

    // Event 2: A dump-style file is created on the same host shortly after
    $file.metadata.event_type = "FILE_CREATION"
    // Match common dump extensions and naming patterns used by procdump, comsvcs, custom tools
    $file.target.file.full_path = /(?i)\.(dmp|mdmp|dump|bin)$/
    // Exclude Windows system crash dump paths that are routine
    not $file.target.file.full_path = /(?i)\\Windows\\(System32\\config\\systemprofile|Minidump|LiveKernelReports)\\/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    // Chronological ordering: handle open must precede file creation
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity = array_distinct($hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $dump_file_path = array_distinct($file.target.file.full_path)
    $dump_writer_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $open and $file
}
