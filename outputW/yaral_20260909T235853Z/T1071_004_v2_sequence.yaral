/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:36:09.750872+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_DNS_Tunneling_High_Volume_Subdomain_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects DNS tunneling / beaconing behaviour observable at the network perimeter: a host first generates an unusually high volume of DNS queries to a single parent domain (indicative of data exfiltration or C2 channel establishment via long/encoded subdomains), then follows up with a successful DNS resolution to the same domain. This two-stage correlation reduces false positives from legitimate burst DNS activity while catching the sustained query pattern characteristic of DNS tunneling tools."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Requires firewall or DNS gateway logs normalised to UDM NETWORK_DNS events. The log source must populate principal.hostname or principal.ip, network.dns.questions.name, and metadata.event_timestamp."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "CDN-heavy SaaS applications with many subdomains (e.g. Akamai, Cloudflare), software update services, legitimate DNS-over-HTTPS fallback resolvers, vulnerability scanners listed in %global_allowed_scanners."
    tuning_guidance = "Add known-good high-query domains (CDN, update, telemetry) to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Raise the query-count threshold in the outcome risk_score logic if the environment has noisy DNS clients."

  events:
    // Event 1: Burst of DNS queries from the same host to the same parent domain
    // within the window - pre-filtered to external destinations only.
    $dns_burst.metadata.event_type = "NETWORK_DNS"
    $dns_burst.network.dns.questions.name = /\.[a-z]{2,}/
    not $dns_burst.network.dns.questions.name in %global_allowed_domains
    not $dns_burst.principal.ip in %rfc1918_internal
    not $dns_burst.principal.hostname in %global_allowed_scanners
    $dns_burst.principal.hostname = $src_host

    // Capture the apex/parent domain from the query name for the join.
    // We match queries whose name contains at least two labels (subdomain.domain.tld)
    // which is the hallmark of tunneled traffic embedding data in subdomains.
    $dns_burst.network.dns.questions.name = /^[^.]+\.[^.]+\.[a-z]{2,}/ nocase
    re.capture($dns_burst.network.dns.questions.name, /([^.]+\.[a-z]{2,})$/) = $apex_domain

    // Event 2: A subsequent DNS resolution (answer received) to the same apex domain
    // from the same host - confirms the channel is active, not just a scan.
    $dns_resolve.metadata.event_type = "NETWORK_DNS"
    $dns_resolve.network.dns.questions.name = /\.[a-z]{2,}/
    not $dns_resolve.network.dns.questions.name in %global_allowed_domains
    not $dns_resolve.principal.ip in %rfc1918_internal
    not $dns_resolve.principal.hostname in %global_allowed_scanners
    $dns_resolve.principal.hostname = $src_host
    re.capture($dns_resolve.network.dns.questions.name, /([^.]+\.[a-z]{2,})$/) = $apex_domain

    // Chronological ordering: burst precedes or coincides with the resolution event.
    $dns_burst.metadata.event_timestamp.seconds <= $dns_resolve.metadata.event_timestamp.seconds

  match:
    $src_host, $apex_domain over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($dns_burst.principal.hostname)
    $queried_domains = array_distinct($dns_burst.network.dns.questions.name)
    $resolved_domains = array_distinct($dns_resolve.network.dns.questions.name)
    $source_ips = array_distinct($dns_burst.principal.ip)
    $dns_query_count = count($dns_burst.network.dns.questions.name)

  condition:
    $dns_burst and $dns_resolve
}
