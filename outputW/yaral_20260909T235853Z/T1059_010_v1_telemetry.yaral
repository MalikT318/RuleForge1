/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:16:33.248405+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoHotKey_AutoIT_Script_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of AutoHotKey (.ahk) or AutoIT (.au3) script files on disk. Adversaries use these scripting languages to automate malicious tasks including keylogging, payload execution, and phishing delivery. This rule pivots on the file artifact rather than process command-line arguments, providing coverage that is harder to evade than process-creation logging."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events. Sysmon Event ID 11 or equivalent EDR file-write telemetry must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate automation engineers writing AHK or AutoIT scripts for UI testing, RPA workflows, or IT helpdesk tooling. Software deployment pipelines that stage AutoIT-compiled installers. Game macro users."
    tuning_guidance = "Add known-good parent process paths (e.g., IDE executables, build agents) to %global_allowed_script_hosts. Consider scoping to high-risk directories such as user temp, AppData, or Downloads by tightening the path regex. Reduce severity for hosts in %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(ahk|au3)$/
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
