/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:23:58.855860+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Registry_Export_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects file creation events consistent with exporting the SAM or SYSTEM registry hives to disk. Adversaries use 'reg save HKLM\\sam' or volume shadow copy techniques to dump the SAM database for offline credential extraction. This rule fires on the resulting file artifact rather than the command line, providing coverage when process telemetry is absent or obfuscated."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event) normalised into UDM FILE_CREATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised backup software exporting registry hives for disaster recovery; Windows in-box backup (wbadmin, Windows Server Backup); some RMM agents that snapshot registry state."
    tuning_guidance = "Add the full path of known backup process binaries to %global_allowed_backup_processes to suppress. If specific output directories are always used by approved tooling, scope the regex to exclude those paths. Raise severity to Critical if the creating process is not a known backup agent."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match files whose names strongly suggest a SAM, SYSTEM, or SECURITY hive export.
    // Covers common naming conventions: sam, sam.hive, sam.bak, system, system.hive,
    // security, security.hive, ntds (belt-and-suspenders), and numeric suffixes.
    $file.target.file.full_path = /(?i)(\\|\/)(sam|system|security|ntds)(\.hive|\.bak|\.save|\.dmp|\.reg|[0-9]{0,6})?$/ nocase

    // Exclude paths that are legitimate Windows OS locations for these files.
    // The real SAM lives at %SystemRoot%\System32\config - writes there are OS-internal.
    not $file.target.file.full_path = /(?i)\\windows\\system32\\config\\(sam|system|security|software)$/ nocase

    // Exclude known backup and security tooling by the process that created the file.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $output_file_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
