/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:18:28.111050+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Network_Device_Image_Downgrade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects potential network device OS image downgrade activity observable at the firewall/perimeter layer. An adversary replacing a network device OS image with an older version must typically transfer the image file via TFTP, FTP, SCP, or HTTP from an external or unexpected source. This rule fires on large inbound transfers over image-transfer protocols from non-internal sources to network device management addresses, which is the network-observable signature of staging a replacement OS image."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Downgrade System Image"
    log_prerequisites = "Requires firewall flow or connection logs with bytes transferred, destination port, and source/destination IP. Flows must be normalised to UDM NETWORK_FLOW with network.sent_bytes or network.received_bytes populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network device OS upgrades performed by network engineering teams, automated patch management systems, or vendor-managed services. Legitimate large TFTP/FTP transfers for configuration backups."
    tuning_guidance = "Add authorised management source addresses to %global_allowed_mgmt_sources to suppress known-good upgrade sources. Add authorised scanner or management hosts to %global_allowed_scanners. Raise the bytes threshold if legitimate large transfers are common in the environment. Consider restricting to destination ports 69 (TFTP), 21 (FTP), 22 (SCP), 80, 443 if the environment is well-segmented."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Image transfer protocols commonly used to stage OS images on network devices:
    // TFTP (69/UDP), FTP (21/TCP), SCP/SSH (22/TCP), HTTP (80/TCP), HTTPS (443/TCP)
    (
      $net.target.port = 69 or
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 80 or
      $net.target.port = 443
    )

    // Large transfer volume is a strong signal - OS images are typically tens to hundreds of MB.
    // 10 MB threshold (10485760 bytes) filters noise while catching image-sized payloads.
    $net.network.received_bytes >= 10485760

    // Source must not be an approved management or scanner source
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // Source must not be internal (unexpected external origin is the high-fidelity signal)
    not $net.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = max($net.target.port)
    $bytes_received = max($net.network.received_bytes)

  condition:
    $net
}
