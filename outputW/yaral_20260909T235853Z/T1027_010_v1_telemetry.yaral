/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:55:52.960606+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Obfuscated_Script_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of script files containing obfuscation patterns such as base64 encoding, excessive escape characters, or environment variable substitution indicative of command obfuscation."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires Linux EDR or auditd file creation telemetry with file content inspection capability."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate base64-encoded configuration files, minified JavaScript in web applications, encoded certificates or keys, automated deployment scripts with variable substitution."
    tuning_guidance = "Add known deployment automation paths to %global_allowed_script_hosts or exclude specific service account writers to %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /\/(tmp|dev\/shm|var\/tmp)\/.*\.(sh|bash|py|pl|rb)$/ nocase or
      $file.target.file.full_path = /\/home\/[^\/]+\/\.(bash_history|zsh_history|profile|bashrc)$/ nocase or
      $file.target.file.full_path = /\/etc\/cron\.(daily|hourly|weekly|monthly)\/[^\/]+$/ nocase or
      $file.target.file.full_path = /\/etc\/systemd\/system\/.*\.service$/ nocase
    )
    (
      re.regex($file.target.file.full_path, /(?i)(base64|b64|decode|eval|exec|frombase64|atob)/) or
      re.regex($file.target.file.full_path, /[\^\$\%\&\{\}]{8,}/) or
      re.regex($file.target.file.full_path, /(\$\{[A-Z_]+\}.*){5,}/) or
      re.regex($file.target.file.full_path, /\\x[0-9a-f]{2}.*\\x[0-9a-f]{2}.*\\x[0-9a-f]{2}/) or
      re.regex($file.target.file.full_path, /(rev\s*<<<|tac\s*<<<)/) or
      re.regex($file.target.file.full_path, /(\|\s*sh|\|\s*bash|\|\s*python)/) and re.regex($file.target.file.full_path, /(echo|printf).*base64/)
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.target.file.full_path = /\/var\/lib\/docker\// nocase
    not $file.target.file.full_path = /\/opt\/.*\/(bin|scripts)\// nocase

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
