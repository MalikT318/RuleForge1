/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:48:55.267651+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Large_Executable_Written_To_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of an executable file in common Linux staging or temporary paths where the file size exceeds a threshold consistent with binary padding. Adversaries pad binaries with junk data to evade hash-based blocklists and overwhelm file-scanning tools. This rule targets the resulting file artifact rather than the command used to produce it, providing coverage orthogonal to process-creation detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates target.file.full_path, target.file.size, and target.file.mime_type or target.file.full_path extension on FILE_CREATION or FILE_MODIFICATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate large binaries deployed to /tmp or /var/tmp by package managers, container runtimes, or CI/CD pipelines. Backup agents staging compressed archives. Self-extracting installers written to /dev/shm."
    tuning_guidance = "Add known-good parent processes (package managers, deployment agents) to %global_allowed_backup_processes or %global_allowed_admin_tools. Raise the size threshold if the environment routinely deploys large legitimate binaries to staging paths. Scope exclusions to specific subdirectories if only a subset of /tmp is used by approved tooling."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target staging and world-writable paths commonly abused on Linux.
    // Legitimate production binaries are rarely written here at runtime.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/var\/run\/|\/run\/user\/[0-9]+\/)/ nocase

    // Match files with executable-like extensions or no extension (common for
    // padded ELF binaries dropped without a suffix). Avoid matching archives,
    // logs, or data files that are legitimately large.
    $file.target.file.full_path = /(\.(elf|bin|sh|py|pl|rb|out|run|so|ko|x86_64|aarch64|arm|amd64)$|\/[^\/\.]+$)/ nocase

    // File size threshold: 50 MB (52428800 bytes). Binary padding routinely
    // inflates binaries well beyond this to defeat scanners and VirusTotal's
    // upload cap. Adjust upward if legitimate large binaries trigger this.
    $file.target.file.size >= 52428800

    // Exclude known-good backup and deployment processes that legitimately
    // write large files to staging paths.
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $written_file_path = array_distinct($file.target.file.full_path)
    $file_size_bytes = max($file.target.file.size)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
