/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:15:16.141513+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_Network_Device_CLI_Remote_Mgmt_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects inbound network connections to network device management-plane ports (SSH, Telnet, NETCONF, REST API) originating from addresses outside approved management source ranges. Adversaries abusing T1059.008 must first establish a CLI session; detecting unexpected management-plane access from non-approved sources provides network-side coverage complementary to any endpoint process-creation rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Script Interpreter: Network Device CLI"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs that record inbound sessions to network device management ports (TCP 22, 23, 830, 443, 8443, 8080). Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events with target.port and principal.ip populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network engineers connecting from jump hosts or management subnets not yet added to %global_allowed_mgmt_sources. Vulnerability scanners covered by %global_allowed_scanners. Automated monitoring systems polling device APIs."
    tuning_guidance = "Add all approved management source IPs and subnets to %global_allowed_mgmt_sources. Add scanner source IPs to %global_allowed_scanners. Consider narrowing target.ip to the specific management-plane address range of network devices in scope. Raise severity to Critical if Telnet (port 23) is observed, as it indicates cleartext credential exposure."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Management-plane ports: SSH(22), Telnet(23), NETCONF-SSH(830),
    // HTTPS management(443, 8443), HTTP management(8080)
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 830 or
      $net.target.port = 443 or
      $net.target.port = 8443 or
      $net.target.port = 8080
    )

    // Source is not from approved internal management address space
    not $net.principal.ip in %rfc1918_internal

    // Source is not an approved management source (jump hosts, NOC ranges)
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Source is not an authorised scanner
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(
      if($net.target.port = 23, 95,
        if($net.target.port = 22, 80,
          75
        )
      )
    )
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
