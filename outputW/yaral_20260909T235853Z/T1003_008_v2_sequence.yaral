/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:28:20.882838+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_Read_Then_Crackfile_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a two-stage credential dumping pattern: a process reads /etc/shadow (or /etc/passwd) followed by creation of a file in a world-writable or temporary directory on the same host within 10 minutes. This is consistent with unshadow or similar utilities combining credential files for offline cracking."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. FILE_READ events for /etc/shadow and FILE_CREATION events for output files must be present. Auditd rules: -w /etc/shadow -p r -k shadow_read and -w /tmp -p w -k tmp_write."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup agents reading /etc/shadow for integrity checks, authorised security scanners, PAM modules during authentication, shadow-utils package management operations."
    tuning_guidance = "Add authorised backup and security tool process paths to %global_allowed_backup_processes and %global_allowed_security_tools. Add known-good service account names to %global_allowed_service_accounts."

  events:
    // Stage 1: process reads /etc/shadow or /etc/passwd
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /^\/etc\/(shadow|passwd|shadow-)$/
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.user.userid in %global_allowed_service_accounts
    $read.principal.hostname = $hostname

    // Stage 2: a file is created in a temp or world-writable location on the same host
    $create.metadata.event_type = "FILE_CREATION"
    $create.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/|\/var\/run\/)/
    not $create.principal.process.file.full_path in %global_allowed_backup_processes
    not $create.principal.user.userid in %global_allowed_service_accounts
    $create.principal.hostname = $hostname

    // Enforce chronological ordering: shadow read must precede output file creation
    $read.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($read.principal.hostname)
    $reading_process = array_distinct($read.principal.process.file.full_path)
    $reading_user = array_distinct($read.principal.user.userid)
    $credential_file_accessed = array_distinct($read.target.file.full_path)
    $output_file_created = array_distinct($create.target.file.full_path)
    $creating_process = array_distinct($create.principal.process.file.full_path)

  condition:
    $read and $create
}
