/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:20:15.983163+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_DefaultAccount_Login_Then_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a successful management-plane login using a well-known default account username followed by a configuration change on the same network device within 1 hour. This pattern is consistent with adversaries exploiting unchanged factory credentials on network appliances to gain privileged access and modify device configuration for persistence or lateral movement."
    mitre_tactic = "Initial Access, Persistence, Privilege Escalation"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires network device syslog or management-plane authentication logs normalised to UDM USER_LOGIN, and configuration audit logs normalised to UDM SETTING_MODIFICATION. Both event types must populate principal.hostname and principal.user.userid."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network engineers using shared default-named accounts that have not been renamed post-deployment; automated provisioning systems that authenticate with vendor default credentials during initial bootstrap; vulnerability scanners testing management-plane access."
    tuning_guidance = "Add approved service accounts that legitimately retain default-style names to %global_allowed_service_accounts. Add authorised scanner source addresses to %global_allowed_scanners. Add approved management source addresses to %global_allowed_mgmt_sources to suppress expected management-plane access from jump hosts or NMS platforms."

  events:
    // Event 1: Successful login to the management plane using a default-style account name
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = /(?i)^(admin|administrator|root|cisco|enable|manager|guest|default|operator|support|user|netadmin|superuser|sysadmin|device|monitor|readonly|ro|rw|tech|service|setup|test|ubnt|pi|vagrant|ansible|deploy|noc|helpdesk|backup)$/
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.ip in %rfc1918_internal
    $auth.target.hostname = $device_hostname

    // Event 2: Configuration modification on the same device after the login
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname = $device_hostname
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.ip in %global_allowed_mgmt_sources

    // Chronological ordering: login must precede the config change
    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $device_hostname over 1h

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($device_hostname)
    $default_accounts_observed = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $config_change_count = count($cfg.metadata.event_timestamp.seconds)
    $auth_event_count = count($auth.metadata.event_timestamp.seconds)

  condition:
    $auth and $cfg
}
