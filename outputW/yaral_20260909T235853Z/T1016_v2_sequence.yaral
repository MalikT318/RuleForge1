/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:18:06.958106+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_NetConfig_Discovery_Burst_Then_External_Flow {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Medium"
    description     = "Detects a pattern consistent with automated network-configuration reconnaissance on Linux: a short burst of outbound connections to many distinct external destinations originating from the same internal source, followed by an unusual outbound flow to a non-standard port. Firewall telemetry only - no process context required. This provides additive coverage beyond endpoint command-line rules for T1016 by catching the network-observable footprint of post-discovery lateral movement or data exfiltration staging."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Requires perimeter firewall or network flow logs normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Both allowed and denied flows should be ingested."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Vulnerability scanners, monitoring agents performing health checks, CDN origin probing, load balancer health probes, and legitimate DevOps CI/CD pipelines that fan out to many endpoints. Authorised scanners should be added to %global_allowed_scanners."
    tuning_guidance = "Add known scanner source IPs to %global_allowed_scanners. Add approved management source ranges to %global_allowed_mgmt_sources. Raise the distinct-destination threshold or widen the time window if the environment has high-fan-out services. Narrow the non-standard port range if specific high-numbered ports are legitimately used."

  events:
    // Leg 1: burst of outbound connections from a single internal source
    // to multiple distinct external destinations within the window.
    // We pre-filter to external destinations only and exclude approved scanners.
    $burst.metadata.event_type = "NETWORK_CONNECTION"
    not $burst.principal.ip in %rfc1918_internal
    not $burst.target.ip in %rfc1918_internal
    not $burst.principal.ip in %global_allowed_scanners
    not $burst.principal.ip in %global_allowed_mgmt_sources
    $burst.principal.ip = $src_ip

    // Leg 2: a subsequent outbound flow from the same source to a
    // non-standard high port (>1024, excluding common service ports)
    // that is not in the approved management or scanner lists.
    // This represents the staging or exfil step that often follows discovery.
    $flow.metadata.event_type = "NETWORK_FLOW"
    not $flow.principal.ip in %rfc1918_internal
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    not $flow.principal.ip in %global_allowed_mgmt_sources
    not $flow.target.ip in %global_allowed_domains
    $flow.target.port > 1024
    $flow.target.port != 3306
    $flow.target.port != 5432
    $flow.target.port != 6379
    $flow.target.port != 8080
    $flow.target.port != 8443
    $flow.target.port != 9200
    $flow.principal.ip = $src_ip

    // Chronological ordering: burst of connections must precede the flow
    $burst.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($src_ip)
    $distinct_burst_destinations = count(distinct $burst.target.ip)
    $flow_destination_ips = array_distinct($flow.target.ip)
    $flow_destination_ports = array_distinct($flow.target.port)
    $flow_bytes_sent = max($flow.network.sent_bytes)

  condition:
    $burst and $flow
}
