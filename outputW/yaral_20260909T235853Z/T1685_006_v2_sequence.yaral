/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:44:05.834287+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_006_Log_Truncation_Then_Deletion_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage log destruction pattern on Linux: a process truncates or zeroes a system log file (FILE_MODIFICATION) followed by deletion of a log file in /var/log/ (FILE_DELETION) within 10 minutes on the same host. This additive coverage targets the file-system artefacts of log clearing rather than command-line invocations."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1485.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM with FILE_MODIFICATION and FILE_DELETION event types. Auditd rules must watch /var/log/ with -w /var/log/ -p wra -k log_access."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Log rotation daemons (logrotate, newsyslog) that truncate and remove old log files; backup agents archiving and removing logs; security tools compressing audit logs."
    tuning_guidance = "Add logrotate, rsyslog, and backup agent process paths to %global_allowed_backup_processes. Add authorised log-management service accounts to %global_allowed_service_accounts. Narrow the file path regex if only specific log families are relevant."

  events:
    // Event 1: A process truncates or overwrites a file under /var/log/
    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.target.file.full_path = /^\/var\/log\// nocase
    // Exclude known-good backup and log-rotation processes
    not $mod.principal.process.file.full_path in %global_allowed_backup_processes
    not $mod.principal.user.userid in %global_allowed_service_accounts
    $mod.principal.hostname = $hostname

    // Event 2: A process deletes a file under /var/log/ on the same host
    $del.metadata.event_type = "FILE_DELETION"
    $del.target.file.full_path = /^\/var\/log\// nocase
    not $del.principal.process.file.full_path in %global_allowed_backup_processes
    not $del.principal.user.userid in %global_allowed_service_accounts
    $del.principal.hostname = $hostname

    // Chronological ordering: truncation precedes deletion
    $mod.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1485.006")
    $primary_entity = array_distinct($mod.principal.hostname)
    $modified_log_files = array_distinct($mod.target.file.full_path)
    $deleted_log_files = array_distinct($del.target.file.full_path)
    $modifying_processes = array_distinct($mod.principal.process.file.full_path)
    $deleting_processes = array_distinct($del.principal.process.file.full_path)
    $acting_users = array_distinct($mod.principal.user.userid)

  condition:
    $mod and $del
}
