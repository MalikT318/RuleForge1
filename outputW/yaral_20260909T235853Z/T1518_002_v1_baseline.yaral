/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:00:10.430123+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Linux_Backup_Software_Discovery {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects process execution patterns consistent with backup software discovery on Linux. Adversaries enumerate installed backup agents, their configurations, and running services to identify targets for data destruction, ransomware, or inhibiting system recovery. Signals include querying package managers for known backup packages, listing backup-related systemd units or init scripts, and reading backup configuration directories."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1518.002"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events, including command-line arguments."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "System administrators auditing backup coverage, configuration management tools (Ansible, Puppet, Chef), monitoring agents performing inventory, and backup software self-checks."
    tuning_guidance = "Add known automation and configuration management service accounts to %global_allowed_service_accounts. Add approved inventory or monitoring parent processes to %global_allowed_admin_tools. Narrow scope by requiring the event to originate from an interactive shell session if noise is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match package manager queries or service/process enumeration commands
    // that target known Linux backup software families
    (
      // Package manager enumeration: dpkg, rpm, apt, yum, dnf, snap, flatpak
      (
        $proc.target.process.file.full_path = /\/(dpkg|rpm|apt|apt-cache|yum|dnf|snap|flatpak)$/ nocase
        and $proc.target.process.command_line = /(?i)(list|query|info|show|search|installed|packages)/ nocase
        and $proc.target.process.command_line = /(?i)(veeam|acronis|bacula|amanda|bareos|duplicati|rsnapshot|backuppc|borg|restic|timeshift|deja.dup|clonezilla|commvault|netbackup|tivoli|tsm|arcserve|carbonite|crashplan|backblaze|rclone|duplicity|dar\b|afio|mondo)/ nocase
      )
      or
      // systemctl / service enumeration targeting backup-related units
      (
        $proc.target.process.file.full_path = /\/(systemctl|service|initctl|chkconfig)$/ nocase
        and $proc.target.process.command_line = /(?i)(status|list|is.active|is.enabled|show)/ nocase
        and $proc.target.process.command_line = /(?i)(veeam|acronis|bacula|bareos|duplicati|rsnapshot|backuppc|borg|restic|timeshift|commvault|netbackup|tsm|arcserve|crashplan)/ nocase
      )
      or
      // Process listing (ps, pgrep) searching for backup agent processes
      (
        $proc.target.process.file.full_path = /\/(ps|pgrep|pidof)$/ nocase
        and $proc.target.process.command_line = /(?i)(veeam|acronis|bacula|bareos|duplicati|rsnapshot|backuppc|borg|restic|commvault|netbackup|tsm|arcserve|crashplan)/ nocase
      )
      or
      // find / ls targeting backup configuration directories
      (
        $proc.target.process.file.full_path = /\/(find|ls)$/ nocase
        and $proc.target.process.command_line = /(?i)(\/etc\/(veeam|acronis|bacula|bareos|duplicati|rsnapshot|backuppc|borg|amanda|commvault|netbackup|tsm|arcserve|crashplan)|\/opt\/(veeam|acronis|bacula|bareos|commvault|netbackup|tsm|arcserve)|\/var\/(lib|log)\/(veeam|acronis|bacula|bareos|duplicati|backuppc|commvault|netbackup|tsm))/ nocase
      )
      or
      // cat / grep reading backup config files directly
      (
        $proc.target.process.file.full_path = /\/(cat|grep|head|tail|less|more|strings)$/ nocase
        and $proc.target.process.command_line = /(?i)(\/etc\/(veeam|acronis|bacula|bareos|duplicati|rsnapshot|backuppc|borg|amanda|commvault|netbackup|tsm|arcserve|crashplan)|\/opt\/(veeam|acronis|bacula|bareos|commvault|netbackup|tsm|arcserve)|\/var\/(lib|log)\/(veeam|acronis|bacula|bareos|duplicati|backuppc|commvault|netbackup|tsm))/ nocase
      )
    )

    // Exclude known-good service accounts and admin tooling
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_user   = array_distinct($proc.principal.user.userid)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
