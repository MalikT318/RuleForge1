/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:56:17.944285+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Obfuscated_Script_Drops_File_Correlation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage obfuscation pattern: a script interpreter (PowerShell, cmd, wscript, cscript, mshta) launches with indicators of command obfuscation (base64, environment variable expansion, string concatenation, or escape characters), followed within 5 minutes by a file creation event on the same host. This sequence is additive to single-event command-line rules and targets the downstream artifact of obfuscated execution rather than the command line alone."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires EDR process telemetry (PROCESS_LAUNCH) and file telemetry (FILE_CREATION) from a Windows EDR or Sysmon-equivalent source normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers using PowerShell with encoded commands to drop legitimate payloads; SCCM/Intune deployment scripts; developer toolchains that base64-encode payloads during build pipelines; RMM agents that write configuration files."
    tuning_guidance = "Add known-good parent processes to %global_allowed_script_hosts. Add known-good service accounts to %global_allowed_service_accounts. Narrow the FILE_CREATION path regex to exclude known software installation directories such as Program Files if false-positive volume is high."

  events:
    // Event 1: Script interpreter launch with obfuscation indicators
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase

    // Obfuscation indicators: base64 encoded command, environment variable expansion,
    // string concatenation patterns, or heavy use of escape/special characters
    (
      $proc.target.process.command_line = /(?i)-e(nc(odedcommand)?)?[\s]+[A-Za-z0-9+\/]{20,}={0,2}/ nocase or
      $proc.target.process.command_line = /(?i)\^[a-zA-Z]\^/ nocase or
      $proc.target.process.command_line = /(?i)%[a-zA-Z_][a-zA-Z0-9_]*:~[0-9\-]+,[0-9\-]+%/ nocase or
      $proc.target.process.command_line = /(?i)\$env:[a-zA-Z]+\[[0-9]+\]/ nocase or
      $proc.target.process.command_line = /(?i)\[char\]\s*[0-9]+/ nocase or
      $proc.target.process.command_line = /(?i)frombase64string/ nocase
    )

    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    $proc.principal.hostname = $hostname

    // Event 2: File creation on the same host within the window
    $file.metadata.event_type = "FILE_CREATION"

    // Target suspicious drop locations: user temp, appdata, public, root of system drive
    $file.target.file.full_path = /(?i)\\(temp|tmp|appdata\\(local|roaming)|users\\public|windows\\temp|programdata)\\[^\\]+\.(exe|dll|ps1|vbs|js|bat|cmd|hta|lnk|scr|jar|wsf)$/

    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

    $file.principal.hostname = $hostname

    // Chronological ordering: process launch must precede file creation
    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($hostname)
    $obfuscated_process = array_distinct($proc.target.process.file.full_path)
    $obfuscated_cmdline = array_distinct($proc.target.process.command_line)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $initiating_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
