/*
  MITRE Technique : T1497.002 - User Activity Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:57:53.117893+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_002_UserActivity_SandboxEvasion_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects processes enumerating user activity artifacts on Linux to determine whether the host is a sandbox or analysis environment. Adversaries query shell history files, browser profile directories, recently accessed files, and common user directories to infer real user presence before activating a payload. A non-interactive or low-privilege process reading multiple such paths in a single command is a strong indicator of T1497.002 user-activity-based sandbox evasion."
    mitre_tactic    = "Defense Evasion, Discovery"
    mitre_technique = "T1497.002"
    mitre_technique_name = "Virtualization/Sandbox Evasion: User Activity Based Checks"
    log_prerequisites = "Requires Linux EDR or auditd process-launch telemetry with full command-line capture (execve syscall arguments). Auditd rule: -a always,exit -F arch=b64 -S execve -k user_activity_check."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate shell scripts performing backup or profile migration; IT provisioning tools enumerating home directories; security scanners; user-space monitoring daemons. Tune by adding known-good parent processes to %global_allowed_script_hosts."
    tuning_guidance = "Add authorised automation parent processes (e.g. Ansible, Chef, Puppet runner paths) to %global_allowed_script_hosts. Narrow the regex if a specific legitimate tool repeatedly triggers the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target: shell or scripting interpreter executing the activity check
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|node)$/ nocase

    // Command line must reference at least one user-activity artifact path.
    // Covers: shell history, browser profiles, recently-used files (GTK/KDE),
    // desktop/Downloads/Documents dirs, thumbnail caches, and /proc self maps.
    $proc.target.process.command_line = /(\~\/\.bash_history|\/home\/[^\/]+\/\.bash_history|\/root\/\.bash_history|\~\/\.zsh_history|\/home\/[^\/]+\/\.zsh_history|\/home\/[^\/]+\/\.local\/share\/recently-used\.xbel|\/home\/[^\/]+\/\.recently-used|\/home\/[^\/]+\/Desktop|\/home\/[^\/]+\/Downloads|\/home\/[^\/]+\/Documents|\/home\/[^\/]+\/\.config\/google-chrome|\/home\/[^\/]+\/\.mozilla\/firefox|\/home\/[^\/]+\/\.cache\/thumbnails|\/proc\/self\/maps|\/proc\/[0-9]+\/maps)/ nocase

    // Exclude known-good script hosts (RMM, provisioning, backup agents)
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

    // Exclude known-good service accounts (backup, monitoring daemons)
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good security tooling (EDR agents reading proc maps legitimately)
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1497.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user       = array_distinct($proc.principal.user.userid)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
