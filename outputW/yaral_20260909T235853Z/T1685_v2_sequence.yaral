/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:38:08.607234+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_Container_Security_Tool_Tampering_Cloud_Audit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage defense impairment pattern in container environments via cloud audit logs: first, a privileged or security-relevant resource access or permission change targeting a container security control (e.g., admission controller, security policy, logging agent config), followed by deletion or disabling of a related resource within the same time window. This indicates an adversary attempting to blind monitoring or remove enforcement controls before or during an attack."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "Requires cloud provider audit logs (e.g., CloudTrail, GCP Audit, Azure Activity) normalized to Chronicle UDM. Must capture Kubernetes API server audit events or cloud-native container service control-plane events including resource access, permission changes, and resource deletions."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Authorized platform engineers rotating or upgrading security tooling, CI/CD pipelines decommissioning old policy objects, cluster lifecycle management automation removing deprecated admission webhooks or policy resources."
    tuning_guidance = "Add authorized service account identifiers to %global_allowed_service_accounts. Add authorized cloud principals performing cluster maintenance to %global_allowed_cloud_principals. Narrow the resource name regex to match your specific security tooling naming conventions."

  events:
    // Stage 1: Actor accesses or modifies a container security control resource
    // (admission webhook, network policy, audit policy, security context constraint, logging config)
    $access.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $access.principal.user.userid != ""
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals
    $access.target.resource.name = /(?i)(admissionwebhook|validatingwebhook|mutatingwebhook|networkpolic|podsecuritypolic|securitycontextconstraint|auditpolic|falco|opa|gatekeeper|kyverno|logging|monitoring|sysdig|twistlock|aqua|stackdriver|cloudwatch|fluentd|fluent-bit|logstash|filebeat)/ nocase
    $access.principal.user.userid = $actor

    // Stage 2: Same actor deletes a resource (removing the security control entirely)
    $del.metadata.event_type = "RESOURCE_DELETION"
    $del.principal.user.userid = $actor
    not $del.principal.user.userid in %global_allowed_service_accounts
    not $del.principal.user.userid in %global_allowed_cloud_principals
    $del.target.resource.name = /(?i)(admissionwebhook|validatingwebhook|mutatingwebhook|networkpolic|podsecuritypolic|securitycontextconstraint|auditpolic|falco|opa|gatekeeper|kyverno|logging|monitoring|sysdig|twistlock|aqua|stackdriver|cloudwatch|fluentd|fluent-bit|logstash|filebeat)/ nocase

    // Enforce chronological ordering: permission change precedes deletion
    $access.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($access.principal.user.userid)
    $modified_resources = array_distinct($access.target.resource.name)
    $deleted_resources = array_distinct($del.target.resource.name)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $access and $del
}
