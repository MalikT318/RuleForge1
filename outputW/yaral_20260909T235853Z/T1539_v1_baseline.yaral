/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:03:03.620805+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_001_Impossible_Travel_Session_Reuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects authentication events to Microsoft 365 services originating from an IP address that is not associated with the user's known geography or that exhibits characteristics consistent with stolen session cookie reuse - specifically logins from anonymising infrastructure (Tor, VPN, hosting ASNs) combined with a user-agent mismatch or missing MFA claim. In M365 unified audit logs, stolen cookie reuse often surfaces as a successful USER_LOGIN from an unexpected location with no MFA step because the session token already carries the auth claim."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log (UAL) ingested into Chronicle via the M365 connector. Ensure Azure AD Sign-In logs are forwarded. The event_type USER_LOGIN must be populated with network.ip_protocol, principal.ip, target.application, and extensions.auth fields."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate users connecting via corporate VPN or privacy-focused ISPs; users travelling internationally; shared service accounts accessed from multiple regions; automated service principals using token-based auth."
    tuning_guidance = "Add known corporate VPN egress IPs to %global_allowed_mgmt_sources. Add approved service principals to %global_allowed_service_accounts. Add approved cloud principals to %global_allowed_cloud_principals. Raise risk_score threshold for accounts in %global_allowed_admin_users."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Successful authentication - session token accepted without re-challenge
    $auth.security_result.summary = /(?i)success|succeeded|granted/

    // Target must be an M365 cloud application - avoids noise from unrelated services
    $auth.target.application = /(?i)(office\s*365|microsoft\s*365|sharepoint|exchange|teams|onedrive|outlook|azure\s*active\s*directory|graph\.microsoft|login\.microsoftonline)/

    // Source IP must not be a known internal/management source
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // User must not be an approved service account or cloud principal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals

    // Detect logins from anonymising or suspicious infrastructure:
    // Tor exit nodes, commercial VPN providers, hosting/cloud ASNs, or
    // data-centre ranges are common relay points for stolen cookie replay.
    // Chronicle populates network.asn or location fields from GeoIP enrichment.
    (
      $auth.principal.location.country_or_region = /(?i)(anonymous|tor|vpn)/ or
      $auth.network.asn_organization = /(?i)(tor\s*project|mullvad|nordvpn|expressvpn|protonvpn|private\s*internet|cyberghost|ipvanish|hide\.me|perfect\s*privacy|windscribe|surfshark|digital\s*ocean|linode|vultr|ovh|hetzner|choopa|peg\s*tech|serverius|m247|datacamp|frantech|buyvm)/
    )

    // Additional signal: user-agent absent or indicates a non-browser client
    // while the auth flow claims an interactive browser session - consistent
    // with token replay tools (Evilginx2, Muraena) that strip or forge UA.
    $auth.network.http.user_agent = /(?i)(python-requests|curl|wget|go-http|java\/|okhttp|axios|node-fetch|libwww|mechanize|scrapy|headless|phantomjs|selenium|puppeteer)/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ip = array_distinct($auth.principal.ip)
    $target_app = array_distinct($auth.target.application)
    $source_country = array_distinct($auth.principal.location.country_or_region)
    $suspicious_asn = array_distinct($auth.network.asn_organization)
    $user_agent = array_distinct($auth.network.http.user_agent)

  condition:
    $auth
}
