/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:17:08.035945+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_ActiveSetup_StubPath_Registry_Write {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects creation or modification of a StubPath value under the Active Setup Installed Components registry key. Adversaries abuse this mechanism to achieve persistence by executing arbitrary programs at user logon. This rule fires on the registry state change itself, providing coverage orthogonal to process-creation / command-line rules."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry that populates target.registry.registry_key and target.registry.registry_value_name on REGISTRY_CREATION and REGISTRY_MODIFICATION events."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers (Office, .NET, IE, Windows components) that write their own GUID entries under Active Setup during installation or patching. Baseline known-good GUIDs and add the responsible process to %global_allowed_admin_tools."
    tuning_guidance = "Add installer and deployment processes (e.g., msiexec, setup.exe wrappers) to %global_allowed_admin_tools. Consider scoping to StubPath values that reference paths outside of %SystemRoot% and %ProgramFiles% for higher-fidelity alerting."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target the Active Setup Installed Components hive (both 32-bit and 64-bit views)
    $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\Active Setup\\Installed Components\\/

    // Only alert when the StubPath value is being written - this is the execution trigger
    $reg.target.registry.registry_value_name = /(?i)^StubPath$/

    // Exclude known-good administrative and deployment tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved service accounts performing automated software deployment
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity    = array_distinct($reg.principal.hostname)
    $writing_process   = array_distinct($reg.principal.process.file.full_path)
    $registry_key      = array_distinct($reg.target.registry.registry_key)
    $stub_value        = array_distinct($reg.target.registry.registry_value_data)
    $acting_user       = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
