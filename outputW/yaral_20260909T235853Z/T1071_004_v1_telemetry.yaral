/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:35:47.310036+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_ESXi_DNS_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi DNS configuration files or network resolver settings that may indicate an adversary redirecting DNS resolution to attacker-controlled infrastructure for DNS tunneling or C2 beaconing. Targets the file artifact produced by DNS configuration tampering rather than the command used to perform it."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Requires ESXi hostd or shell file-activity telemetry forwarded to Chronicle via syslog or VMware vSphere log integration. FILE_MODIFICATION events must be generated for /etc/resolv.conf, /etc/hosts, and ESXi network configuration paths."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate infrastructure changes by vSphere administrators reconfiguring DNS servers, automated provisioning scripts updating resolver configuration, VMware vCenter-pushed network policy changes."
    tuning_guidance = "Add authorised administrative service accounts to %global_allowed_service_accounts. Add approved automation principals to %global_allowed_admin_users. If vCenter-managed hosts generate frequent false positives, scope by principal.hostname to specific unmanaged hosts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target ESXi DNS resolver and network configuration files
    // resolv.conf controls upstream DNS servers; hosts controls local resolution;
    // esx.conf and network config files control persistent DNS settings
    $file.target.file.full_path = /\/(etc\/resolv\.conf|etc\/hosts|etc\/vmware\/esx\.conf|etc\/vmware\/hostd\/config\.xml|etc\/vmware\/netconfig\.xml|etc\/vmware\/rhttpproxy\/config\.xml)$/ nocase

    // Exclude known-good service and automation accounts
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

    // Exclude approved administrative tooling processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $actor_userid = array_distinct($file.principal.user.userid)
    $actor_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
