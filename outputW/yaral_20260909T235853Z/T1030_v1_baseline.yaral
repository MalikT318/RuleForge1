/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:30:00.677106+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_001_Chunked_Exfil_Size_Limits {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects repeated small outbound network flows to the same external destination that are consistent with data exfiltration using fixed-size chunk limits (T1030). Adversaries split data into small, uniform transfers to stay below threshold-based alerts. This rule fires on a single flow event where bytes sent fall within a narrow band typical of deliberate chunking (1-65535 bytes) to a non-internal destination on a non-standard port."
    mitre_tactic         = "Exfiltration"
    mitre_technique      = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites    = "Requires firewall or perimeter flow logs with bytes_sent, destination IP, and destination port populated in UDM network fields."
    platform             = "Linux"
    log_source           = "firewall"
    false_positives      = "Legitimate chunked uploads to cloud storage or CDN endpoints, streaming media clients, IoT telemetry, application heartbeat traffic, and VPN keepalives may produce similar small-flow patterns."
    tuning_guidance      = "Add known-good external destinations to %global_allowed_domains. Add approved scanner or backup source IPs to %global_allowed_scanners or %global_allowed_backup_processes reference lists. Narrow the bytes_sent range or add a minimum flow count threshold via a Threshold rule variant if false-positive volume is high."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Outbound only - source is internal, destination is external
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal

    // Exclude approved external destinations
    not $net.target.hostname in %global_allowed_domains

    // Exclude approved scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Bytes sent falls within a narrow chunked range:
    // Lower bound: non-trivial payload (> 512 bytes, avoids keepalives)
    // Upper bound: below typical bulk-transfer sizes (< 65536 bytes = 64 KB)
    // This band is characteristic of deliberate size-limited chunking
    $net.network.sent_bytes > 512
    $net.network.sent_bytes < 65536

    // Exclude common legitimate high-volume service ports
    // (HTTP/S, DNS, NTP, SMTP, IMAP, POP3, LDAP, SMB, RDP excluded)
    not $net.target.port = 80
    not $net.target.port = 443
    not $net.target.port = 53
    not $net.target.port = 123
    not $net.target.port = 25
    not $net.target.port = 465
    not $net.target.port = 587
    not $net.target.port = 143
    not $net.target.port = 993
    not $net.target.port = 110
    not $net.target.port = 995
    not $net.target.port = 389
    not $net.target.port = 636
    not $net.target.port = 445
    not $net.target.port = 3389

    // Require a meaningful connection duration to distinguish from
    // single-packet probes (duration > 0 seconds)
    $net.network.session_duration.seconds > 0

  outcome:
    $risk_score        = max(55)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
