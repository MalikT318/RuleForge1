/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-09T23:59:28.606450+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Suspicious_Proc_Mem_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious read access to /proc/<pid>/mem or /proc/<pid>/maps files, often used for process injection on Linux. Attackers read process memory maps to locate injection targets, then write to /proc/pid/mem to inject code."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires Linux EDR or auditd file access telemetry with FILE_READ events for /proc filesystem."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debugging tools (gdb, strace, lldb), memory profilers, forensic tools, security agents performing memory scanning, container runtime engines."
    tuning_guidance = "Add approved debugging and monitoring tools to %global_allowed_security_tools. Exclude known service accounts performing legitimate memory inspection to %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|pagemap|syscall)$/ nocase
    not $file.principal.process.file.full_path = /^\/(usr\/)?s?bin\/(gdb|strace|ltrace|perf|valgrind|systemd-coredump)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\/containerd-shim/ nocase
    not $file.principal.process.file.full_path = /\/dockerd$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
