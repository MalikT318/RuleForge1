/*
  MITRE Technique : T1537 - Transfer Data to Cloud Account
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:02:20.008481+00:00
  Reference       : https://attack.mitre.org/techniques/T1537
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1537_001_Cloud_Data_Transfer_External_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud audit events indicating data transfer, snapshot/backup creation, or resource sharing to an external or cross-account destination within the same cloud provider. Adversaries abuse cloud-native APIs to copy storage objects, create instance snapshots, or generate shared access links (e.g. SAS URIs, pre-signed URLs, anonymous share links) targeting accounts they control, bypassing traditional exfiltration monitoring that focuses on external network egress."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1537"
    mitre_technique_name = "Transfer Data to Cloud Account"
    log_prerequisites = "Requires cloud provider control-plane audit logs (e.g. AWS CloudTrail, Azure Activity Log, GCP Audit Log) normalised into Chronicle UDM. Key operations: storage object copy/replication, snapshot creation and share, cross-account policy attachment, SAS/pre-signed URL generation, anonymous access enablement."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Authorised disaster recovery and backup workflows, approved cross-account data sharing pipelines, legitimate DevOps snapshot automation, cloud-native replication for HA/DR. Service accounts in %global_allowed_service_accounts and principals in %global_allowed_cloud_principals should be excluded."
    tuning_guidance = "Add approved automation service accounts to %global_allowed_service_accounts. Add approved cloud service principals (e.g. backup roles, replication agents) to %global_allowed_cloud_principals. Narrow the resource name regex to exclude known-good bucket/container naming conventions used by your DR pipelines."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target operations that create transferable copies or externally accessible handles:
    // snapshot creation, backup creation, object copy/replication, SAS/pre-signed URL
    // generation, anonymous share link creation, cross-account policy attachment.
    // The UDM operation field captures the normalised API method name.
    $cloud.target.resource.name = /(?i)(snapshot|backup|copy|replicate|clone|sas|presign|shared.?access|anonymous|public.?access|cross.?account|transfer|export|image|ami|disk.?export|object.?copy)/

    // Exclude known-good internal cloud principals (service accounts, automation roles)
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Require an acting principal to be present (filter out system-generated noise)
    $cloud.principal.user.userid != ""

    // Capture the resource and actor for outcome
    $cloud.principal.user.userid = $actor
    $cloud.target.resource.name = $resource_name

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1537")
    $primary_entity = array_distinct($actor)
    $affected_resource = array_distinct($resource_name)
    $source_principal = array_distinct($cloud.principal.user.userid)

  condition:
    $cloud
}
