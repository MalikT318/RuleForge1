/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:08:04.965666+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Doppelganging_Orphan_Process_No_File {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Critical"
    description     = "Detects a hallmark of Process Doppelganging: a process is opened/injected into (PROCESS_OPEN) and shortly afterward a new process launches whose image path does not correspond to any file visible on disk (FILE_CREATION absent, or the launched image resolves to a transacted-but-rolled-back path). The correlation joins a suspicious PROCESS_OPEN against a subsequent PROCESS_LAUNCH on the same host where the child process image path is in a writable or temp-like directory, indicating the TxF-backed image was never committed to disk. This provides additive coverage beyond command-line matching."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelganging"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_OPEN events (handle acquisition) and PROCESS_LAUNCH events with full image paths. Sysmon Event ID 10 (ProcessAccess) and Event ID 1 (ProcessCreate) cover both legs."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate software installers that open process handles and then launch child processes from temp directories (e.g., Windows Update, MSI installers, some AV remediation tools). Sandbox or test environments running process-injection research tooling."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Add authorised software deployment accounts to %global_allowed_service_accounts. Narrow the writable-path regex if temp-directory launches are common in the environment."

  events:
    // Leg 1: A non-system process opens a handle to another process (process injection precursor).
    // PROCESS_OPEN is the UDM event type for handle acquisition against a live process.
    $open.metadata.event_type = "PROCESS_OPEN"
    // The opener must not be a known security or admin tool.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    // Exclude well-known system openers (lsass, csrss, services, svchost doing normal work).
    not $open.principal.process.file.full_path = /(?i)\\(lsass|csrss|services|svchost|smss|wininit|winlogon|taskmgr|msiexec)\.exe$/
    // The target of the open must be a real user-space process, not a kernel process.
    $open.target.process.file.full_path = /(?i)\\[^\\]+\.exe$/
    // Capture the host for the join.
    $open.principal.hostname = $hostname

    // Leg 2: Shortly after, a new process launches from a writable / transient path on the same host.
    // Process Doppelganging causes the spawned image to appear under a temp or system path
    // because the TxF transaction was rolled back and no real file exists at the path.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $hostname
    // The child image path is in a user-writable or transient location — a strong indicator
    // that the image was never durably written to a protected directory.
    $proc.target.process.file.full_path = /(?i)\\(windows\\temp|users\\[^\\]+\\appdata\\(local\\temp|roaming)|programdata\\[^\\]+\\temp|temp\\)[^\\]*\.exe$/
    // Exclude known-good processes that legitimately launch from temp paths.
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: handle open must precede the suspicious process launch.
    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $opened_target  = array_distinct($open.target.process.file.full_path)
    $launched_image = array_distinct($proc.target.process.file.full_path)
    $acting_user    = array_distinct($proc.principal.user.userid)

  condition:
    $open and $proc
}
