/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:44:55.579578+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_SupplyChain_SoftwareUpdate_Suspicious_Network_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network connections from software update or installer processes to unexpected external destinations, a key observable of software supply chain compromise. Compromised update mechanisms typically beacon to attacker-controlled infrastructure shortly after installation or update. This rule fires on outbound connections from common software distribution paths to non-internal destinations over suspicious or uncommon ports, or at high volume, as seen in supply chain attacks such as SolarWinds and CCleaner."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Compromise Software Supply Chain: Compromise Software Supply Chain"
    log_prerequisites = "Requires firewall or perimeter proxy logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Logs must include source IP, destination IP, destination port, and byte counts."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate software update services contacting vendor CDNs and update endpoints. Patch management systems (WSUS, SCCM, Intune) making bulk outbound connections. Security tools performing cloud lookups."
    tuning_guidance = "Add known-good vendor update domains to %global_allowed_domains. Add approved scanner and patch management source IPs to %global_allowed_scanners. Adjust the port list or byte threshold to match the environment baseline. Consider narrowing to specific source subnets hosting software distribution servers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Exclude traffic to known-good internal address space
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external update and CDN domains
    not $net.target.hostname in %global_allowed_domains

    // Exclude approved scanners and patch management sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved backup processes communicating externally
    not $net.principal.ip in %global_allowed_backup_processes

    // Flag connections on ports commonly abused by implants dropped via supply chain:
    // 443 (TLS C2), 80 (HTTP C2), 8080, 8443, 4443, 4444, 1080 (SOCKS proxy)
    // Detect non-standard high ports that legitimate updaters rarely use
    (
      $net.target.port = 4444 or
      $net.target.port = 4443 or
      $net.target.port = 1080 or
      $net.target.port = 8443 or
      $net.target.port = 8080
    )

    // Require meaningful data transfer - beaconing implants send/receive data
    $net.network.sent_bytes > 1024

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
