/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:57:08.594732+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_Linux_Sandbox_VM_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects processes querying Linux virtual machine and sandbox artifacts via /proc, DMI, CPUID-related files, and hypervisor-specific paths. Adversaries enumerate these artifacts to detect analysis environments and alter malware behavior accordingly (T1497)."
    mitre_tactic = "Defense Evasion, Discovery"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with process launch events including command-line arguments. Auditd execve syscall capture or EDR process telemetry required."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "System inventory tools (e.g., dmidecode run by admins), cloud-init on cloud VMs, hardware discovery during OS provisioning, monitoring agents querying /proc/cpuinfo for capacity planning, legitimate system profiling scripts."
    tuning_guidance = "Add known inventory and provisioning parent processes to %global_allowed_admin_tools. Add authorized service accounts that run hardware discovery to %global_allowed_service_accounts. Consider scoping to interactive or short-lived processes rather than long-running daemons."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target processes that read VM/sandbox detection artifacts
    // Covers: dmidecode (DMI/BIOS vendor), systemd-detect-virt, virt-what,
    //         cpuid, reading /proc/cpuinfo for hypervisor flags,
    //         reading /sys/class/dmi/id/* for vendor strings,
    //         reading /proc/scsi/scsi for virtual disk signatures,
    //         reading /proc/bus/pci/devices for virtual PCI devices
    (
      $proc.target.process.file.full_path = /\/(dmidecode|virt-what|cpuid|systemd-detect-virt|imvirt)$/ nocase
      or
      $proc.target.process.command_line = /\/proc\/cpuinfo/ nocase
      or
      $proc.target.process.command_line = /\/sys\/class\/dmi\/id/ nocase
      or
      $proc.target.process.command_line = /\/proc\/scsi\/scsi/ nocase
      or
      $proc.target.process.command_line = /\/proc\/bus\/pci/ nocase
      or
      $proc.target.process.command_line = /\/sys\/devices\/virtual/ nocase
      or
      $proc.target.process.command_line = /\/proc\/self\/status/ nocase
      or
      $proc.target.process.command_line = /hypervisor|vmware|virtualbox|xen|kvm|qemu|bochs|vbox/ nocase
    )

    // Exclude known legitimate admin and provisioning tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude common legitimate parent processes that routinely run hardware discovery
    not $proc.principal.process.file.full_path = /\/(cloud-init|ansible|puppet|chef|salt-minion|systemd|init)$/ nocase

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_process = array_distinct($proc.target.process.file.full_path)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
