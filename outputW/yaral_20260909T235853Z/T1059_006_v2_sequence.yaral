/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:14:18.700993+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_ESXi_Python_After_Interactive_Shell_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive shell login to an ESXi host followed by Python interpreter execution within a short window. Adversaries who gain shell access to ESXi (via SSH or DCUI) may invoke Python to execute payloads, manipulate VMs, or interact with the hypervisor management plane. This correlation rule provides additive coverage beyond simple command-line matching by requiring the authentication precursor event."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Requires ESXi shell/SSH authentication events (hostd or sshd) and process launch telemetry from the ESXi shell, both normalised to UDM by the Chronicle VMware ESXi ingestion parser."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised VMware administrators using Python-based management scripts (e.g., pyVmomi, vSphere SDK automation). Monitoring agents or backup solutions that authenticate and invoke Python utilities. Scheduled maintenance scripts run by service accounts."
    tuning_guidance = "Add known automation and service account identifiers to %global_allowed_service_accounts to suppress expected automation. Add approved management source addresses to %global_allowed_mgmt_sources. Reduce severity if the authenticating user is in %global_allowed_admin_users."

  events:
    // Event 1: Interactive login to the ESXi shell (SSH or local shell session)
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $esxi_host
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources
    $auth.principal.user.userid = $shell_user

    // Event 2: Python interpreter launched on the same ESXi host after login
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/bin\/python/ nocase
    $proc.principal.hostname = $esxi_host
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

    // Chronological ordering: login must precede Python execution
    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $esxi_host, $shell_user over 5m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($esxi_host)
    $triggered_user = array_distinct($shell_user)
    $python_command_line = array_distinct($proc.target.process.command_line)
    $python_binary_path = array_distinct($proc.target.process.file.full_path)
    $login_source_ip = array_distinct($auth.principal.ip)

  condition:
    $auth and $proc
}
