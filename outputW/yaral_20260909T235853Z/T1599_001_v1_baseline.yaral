/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:16:03.068946+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_NAT_Config_Modification_Traversal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of NAT configuration on network boundary devices. Adversaries with control of a perimeter device may alter NAT rules to bridge trusted and untrusted network segments, bypass routing restrictions, or obscure traffic flows. This rule fires on management-plane configuration change events that reference NAT-related constructs."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Address Translation Traversal"
    log_prerequisites = "Requires network device management-plane or syslog telemetry normalised into UDM SETTING_MODIFICATION events. The device must log configuration change commands or audit events that include the changed setting name or CLI fragment in a UDM field such as target.resource.name, security_result.description, or principal.user.userid."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network engineers applying planned NAT changes during maintenance windows; automated provisioning systems pushing configuration baselines; firewall policy deployment pipelines."
    tuning_guidance = "Add authorised change-management service accounts to %global_allowed_service_accounts. Add approved automation sources to %global_allowed_admin_tools. Consider restricting the rule to fire only outside approved maintenance windows by correlating with a change-management feed."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Match NAT-related configuration keywords in the changed setting name or
    // description field. Covers common CLI/audit log fragments across vendors
    // after UDM normalisation: "ip nat", "nat pool", "nat overload",
    // "nat translation", "static nat", "dynamic nat", "nat rule", "pat rule".
    (
      $cfg.target.resource.name = /(?i)(nat\s+(pool|rule|policy|overload|translation|static|dynamic|inside|outside|source|destination)|static\s+nat|dynamic\s+nat|pat\s+rule|ip\s+nat|overload\s+nat)/ nocase
      or
      $cfg.security_result.description = /(?i)(nat\s+(pool|rule|policy|overload|translation|static|dynamic|inside|outside|source|destination)|static\s+nat|dynamic\s+nat|pat\s+rule|ip\s+nat|overload\s+nat)/ nocase
    )

    // Exclude known authorised service and automation accounts
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative tooling sources (e.g., TACACS-authenticated
    // management hosts, provisioning systems)
    not $cfg.principal.hostname in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $actor_userid = array_distinct($cfg.principal.user.userid)
    $changed_resource = array_distinct($cfg.target.resource.name)
    $change_description = array_distinct($cfg.security_result.description)

  condition:
    $cfg
}
