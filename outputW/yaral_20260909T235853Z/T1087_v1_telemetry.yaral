/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:20:26.342300+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_IaaS_Bulk_Directory_User_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or repeated read access to identity provider directory user/group listing APIs. Adversaries abuse directory read permissions to enumerate valid accounts, email addresses, and group memberships as a precursor to targeted phishing, credential stuffing, or lateral movement. This rule fires on USER_RESOURCE_ACCESS events where the accessed resource path indicates a user or group listing operation, providing coverage at the audit-log layer rather than the command-line layer."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Requires identity provider audit logs normalised into Chronicle UDM. Covers Entra ID (Azure AD) sign-in and directory audit logs, Okta System Log, and equivalent IdP sources. The log source must populate metadata.event_type = USER_RESOURCE_ACCESS with target.resource.name or target.url reflecting the directory API path."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "HR or provisioning systems performing scheduled user sync, IT helpdesk tooling querying the directory, approved identity governance platforms (IGA), SCIM provisioning connectors, and authorised security tooling performing access reviews."
    tuning_guidance = "Add known provisioning service principals and automation accounts to %global_allowed_service_accounts. Add approved identity governance or SCIM connector principals to %global_allowed_cloud_principals. Narrow the resource name regex if your IdP uses a non-standard path convention."

  events:
    $auth.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match directory listing API paths for users, groups, or members
    // Covers patterns like: /users, /groups, /members, /directoryObjects,
    // /servicePrincipals, /listUsers, /ListUsers, /list-users, /iam/users
    $auth.target.resource.name = /(?i)(\/users$|\/users\?|\/groups$|\/groups\?|\/members$|\/members\?|\/directoryobjects|\/serviceprincipals|listusers|list.users|\/iam\/users|\/iam\/list|accounts\.list|directory\.list)/

    // Exclude known-good automation and service accounts
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals

    // Exclude approved scanner and security tooling sources
    not $auth.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $accessed_resource = array_distinct($auth.target.resource.name)
    $source_ip = array_distinct($auth.principal.ip)

  condition:
    $auth
}
