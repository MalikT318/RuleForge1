/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:04:03.897407+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Injection_ProcessOpen_Then_RemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a suspicious process opening a handle to a remote process (PROCESS_OPEN) followed by a PROCESS_INJECTION event on the same host within 5 minutes. This sequence is consistent with TLS callback injection, where an adversary manipulates PE memory in a target process before its entry point executes. This rule provides additive coverage beyond command-line detections by focusing on cross-process handle acquisition and injection telemetry."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing PROCESS_OPEN and PROCESS_INJECTION UDM events with principal/target process fields populated. Sysmon Event IDs 10 (ProcessAccess) and 8 (CreateRemoteThread) are typical sources."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tooling (EDR agents, AV), debuggers (WinDbg, x64dbg), JIT compilers (.NET CLR, JVM), legitimate process monitoring utilities, and some RMM agents that inject into processes for monitoring purposes."
    tuning_guidance = "Add known-good security and monitoring tool paths to %global_allowed_security_tools. Add approved admin tooling to %global_allowed_admin_tools. Narrow the rule further by restricting target processes to high-value ones such as lsass.exe, svchost.exe, or explorer.exe if noise is high."

  events:
    // Event 1: A non-system process opens a handle to a remote process
    // This is the precursor step for TLS callback injection (memory manipulation in target)
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\\/ nocase
    // Exclude common system paths to reduce noise from legitimate OS operations
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\/ nocase
    not $open.principal.process.file.full_path = /(?i)\\windows\\syswow64\// nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    // Target must be a running process (not self-open)
    $open.target.process.file.full_path = /\.exe$/  nocase
    $open.principal.hostname = $hostname

    // Event 2: A process injection event on the same host shortly after
    // Covers remote thread creation or equivalent injection primitives
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\/ nocase
    not $inj.principal.process.file.full_path = /(?i)\\windows\\system32\\/ nocase
    not $inj.principal.process.file.full_path = /(?i)\\windows\\syswow64\// nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    $inj.principal.hostname = $hostname

    // Chronological ordering: handle open must precede injection
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $opened_target = array_distinct($open.target.process.file.full_path)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $injection_target = array_distinct($inj.target.process.file.full_path)
    $open_event_count = count($open.metadata.event_timestamp.seconds)
    $inj_event_count = count($inj.metadata.event_timestamp.seconds)

  condition:
    $open and $inj
}
