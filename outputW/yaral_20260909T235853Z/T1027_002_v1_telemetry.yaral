/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:49:40.424610+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Packed_Executable_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of executable files in suspicious locations that exhibit characteristics consistent with software packing: written by non-standard parent processes, placed in writable user-controlled directories, or bearing packed-executable naming patterns. Targets the file artifact produced by packing rather than the packer command line, providing coverage that survives command-line evasion."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file-write events) normalised to UDM FILE_CREATION. The principal.process fields must be populated with the writing process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that self-extract to TEMP, software update agents writing compressed payloads, game launchers unpacking assets, and developer build pipelines producing packed release binaries."
    tuning_guidance = "Add known-good installer and update processes (e.g., msiexec.exe, setup.exe from approved vendors) to %global_allowed_admin_tools. Add authorised build-system service accounts to %global_allowed_service_accounts. Narrow the path regex if a specific business application legitimately writes packed executables to user-writable directories."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be a Windows executable or DLL
    $file.target.file.full_path = /(?i)\.(exe|dll|sys|scr|com)$/

    // Written into user-writable or staging directories commonly abused
    // to drop packed payloads: TEMP, AppData, ProgramData subdirs,
    // Downloads, or the root of a drive (C:\<name>.exe)
    $file.target.file.full_path = /(?i)(\\Temp\\|\\AppData\\|\\ProgramData\\|\\Downloads\\|\\Users\\[^\\]+\\[^\\]+\\|^[A-Za-z]:\\[^\\]+\.(exe|dll|scr|com|sys)$)/

    // The writing process is NOT a known OS component or package manager.
    // Legitimate OS writers (TrustedInstaller, msiexec, wusa) are excluded
    // via the reference list; anything else writing an executable here is
    // suspicious.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude service accounts used by authorised deployment pipelines
    not $file.principal.user.userid in %global_allowed_service_accounts

    // The writing process is itself NOT a standard Windows system binary
    // (i.e., it is not living under System32 / SysWOW64 / WinSxS).
    // Packed droppers are typically written by user-space or LOLBin processes.
    not $file.principal.process.file.full_path = /(?i)\\Windows\\(System32|SysWOW64|WinSxS)\\/

    // Exclude security tooling that legitimately quarantines or unpacks samples
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($file.target.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
