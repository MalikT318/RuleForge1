/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:15:59.296350+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_SaaS_ServicePrincipal_BulkAPIExecution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-interactive service principal or application identity performing a high volume of privileged API operations against SaaS/IaaS resources via identity provider audit logs. Adversaries abusing cloud APIs with stolen application access tokens or service principal credentials will generate bursts of USER_RESOURCE_ACCESS events from a non-human identity, often outside normal working hours, targeting administrative resource categories such as IAM, compute, storage, or security policies. This rule fires on a single event where the actor is a service principal (non-user) performing a sensitive resource action, providing coverage at the identity-plane telemetry layer rather than the command-line layer."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires identity provider audit logs (e.g., Entra ID, Okta, Google Workspace) normalised to Chronicle UDM. USER_RESOURCE_ACCESS events must include principal.user.user_display_name or principal.user.userid, target.resource.name, and target.resource.resource_type."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate automation pipelines, CI/CD service accounts, backup agents, and monitoring tools that use service principals to access cloud resources. Approved service accounts should be added to %global_allowed_service_accounts."
    tuning_guidance = "Add known-good automation service principal identifiers to %global_allowed_service_accounts. Narrow the target.resource.resource_type regex to the specific resource categories relevant to each client. Consider adding a threshold wrapper (Sequence rule) to require N events within a window before alerting if false-positive volume is high."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Actor must be a service principal / application identity, not an interactive human user.
    // Service principals typically carry identifiers such as "app:", "spn:", "@", or end in
    // well-known suffixes. We match on the absence of a human UPN pattern and presence of
    // application-style identifiers using a broad regex that covers Entra SP object IDs,
    // Okta service accounts, and GWS service accounts.
    $cloud.principal.user.userid = /(?i)(^app:|^spn:|service.?principal|svc[-_.]|[-_]svc|automation|pipeline|ci[-_]cd|deploy|robot|daemon|func[-_]|lambda|runbook)/

    // Target a sensitive resource category - IAM, compute, storage, network, or security policy.
    $cloud.target.resource.resource_type = /(?i)(iam|role|policy|permission|compute|instance|vm|storage|bucket|blob|secret|keyvault|key.?vault|network|firewall|security.?group|directory|group|user|credential|token|certificate)/

    // Exclude known-good service accounts approved for privileged automation.
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good cloud principals (e.g., vendor-managed identities).
    not $cloud.principal.user.email_addresses in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $targeted_resource = array_distinct($cloud.target.resource.name)
    $targeted_resource_type = array_distinct($cloud.target.resource.resource_type)

  condition:
    $cloud
}
