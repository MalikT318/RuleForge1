/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:26:53.913585+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_Protocol_Service_Impersonation_CmdLine {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes launching with command-line arguments indicative of protocol or service impersonation for C2 communications. Looks for scripting hosts or network-capable binaries using flags that configure fake TLS/SSL handshakes, HTTP header manipulation, or URI masquerading to blend C2 traffic with legitimate web services. This targets the behavioral outcome of T1001.003 rather than specific tool names."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture, or Sysmon Event ID 1. Command-line logging must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate penetration testing frameworks, curl/wget-style tools used by developers to set custom User-Agent or Host headers, PowerShell Invoke-WebRequest with custom headers for API integrations, Burp Suite or Fiddler proxy tooling."
    tuning_guidance = "Add known-good parent processes (e.g., CI/CD agents, approved RMM tools) to %global_allowed_admin_tools. Add approved script hosts to %global_allowed_script_hosts. Narrow the regex if a specific header pattern generates excessive noise from a known-good application."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting hosts and network-capable built-ins commonly abused for C2
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|certutil|bitsadmin|curl|python[0-9]*|wmic)\.exe$/ nocase

    // Match command-line patterns that indicate protocol/service impersonation:
    // - Custom User-Agent strings mimicking browsers or known services
    // - Host header overrides to masquerade as trusted domains
    // - SSL/TLS flag abuse (e.g., -ssl, --ssl-no-revoke, IgnoreCertificate)
    // - URI path patterns mimicking well-known web services (drive, mail, calendar APIs)
    // - HTTP method manipulation or header injection flags
    $proc.target.process.command_line = /(?i)(useragent|user-agent|UserAgent|Headers\s*=|Add\s*\(\s*["\']Host["\']|Host\s*:|--header|curl.*-H\s|Invoke-WebRequest.*-Headers|WebClient.*Headers|HttpClient.*DefaultRequestHeaders|ssl-no-revoke|IgnoreCertificateErrors|ServerCertificateValidationCallback|bypass.*ssl|skip.*cert|no-check-certificate|--insecure.*https|fake.*tls|mimik|impersonat)/

    // Secondary signal: URI or endpoint patterns mimicking legitimate cloud/mail services
    // combined with non-browser process lineage
    $proc.target.process.command_line = /(?i)(\/drive\/|\/gmail\/|\/mail\/|\/calendar\/|\/api\/v[0-9]|\/oauth2\/|\/token|\/upload\/|\/download\/|accounts\.google|login\.microsoft|graph\.microsoft|api\.dropbox|s3\.amazonaws|blob\.core\.windows)/

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
