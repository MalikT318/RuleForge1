/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:34:36.180729+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_001_MultiStage_C2_Dropper_Exec {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects a multi-stage C2 pattern where a process spawned from a common first-stage delivery parent (script host, document renderer, browser, archive tool) immediately writes an executable artifact to a user-writable or temp directory and then launches it. This matches the canonical T1104 pattern: first-stage RAT downloads and executes a second-stage payload from a staging path."
    mitre_tactic    = "Command and Control"
    mitre_technique = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with parent process lineage and full command-line capture. Sysmon Event ID 1 or equivalent EDR PROCESS_LAUNCH events normalised to UDM."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers that self-extract and launch child executables from TEMP; legitimate updater processes (e.g., browser auto-update); developer toolchains that compile and immediately run binaries from scratch directories."
    tuning_guidance = "Add known-good parent processes (e.g., software deployment agents, patch management) to %global_allowed_admin_tools. Add known-good script hosts to %global_allowed_script_hosts. Narrow the staging-path regex if a specific temp directory pattern generates excessive noise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // First-stage parent: script hosts, document renderers, archive tools,
    // browsers, and generic loaders commonly used as initial-access beachheads.
    // Matching on the parent process path covers renamed children because the
    // parent identity is harder to spoof in EDR telemetry.
    $proc.principal.process.file.full_path = /(?i)\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|wmic|cmd|explorer|winword|excel|powerpnt|outlook|7z|winrar|winzip|java|javaw|python|pythonw|node|wscript|bitsadmin|certutil|curl|wget)\.exe$/

    // Child process (second-stage payload) launched from a user-writable or
    // staging directory. These paths are not used by legitimate system software
    // as a launch origin for persistent binaries.
    $proc.target.process.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData\\(Local\\Temp|Roaming)|Downloads|Desktop)|\\Windows\\Temp|\\ProgramData\\[^\\]+\\Temp|\\Temp\\)/

    // The second-stage binary must be an executable type. This avoids matching
    // on document or script opens that happen to live in temp directories.
    $proc.target.process.file.full_path = /(?i)\.(exe|dll|scr|com|pif|cpl)$/

    // Exclude known-good administrative and deployment tooling parents.
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude approved script hosts (e.g., sanctioned automation frameworks).
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

    // Exclude backup and imaging software that legitimately writes and runs
    // executables from staging paths.
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process  = array_distinct($proc.target.process.file.full_path)
    $child_cmdline  = array_distinct($proc.target.process.command_line)
    $acting_user    = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
