/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:45:24.024447+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Cloud_Firewall_Rule_Creation_After_Login_From_New_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud user login followed within 10 minutes by creation or modification of a cloud firewall rule or security group, which may indicate an adversary opening ingress paths after gaining initial access. Covers AWS security group rule changes, Azure NSG rule modifications, and GCP firewall rule creation via normalised UDM cloud audit telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Cloud Firewall"
    log_prerequisites = "Requires cloud provider audit logs normalised to UDM: USER_LOGIN and RESOURCE_CREATION or RESOURCE_PERMISSIONS_CHANGE events from AWS CloudTrail, Azure Activity Logs, or GCP Audit Logs."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorised cloud administrators performing routine firewall maintenance, infrastructure-as-code pipelines applying planned changes, and approved security tooling performing automated remediation."
    tuning_guidance = "Add known automation and CI/CD service principals to %global_allowed_cloud_principals. Add known management source IPs to %global_allowed_mgmt_sources. Narrow the firewall-related operation regex to match only the API call names observed in your environment."

  events:
    // Event 1: A user or principal logs in to the cloud control plane
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    not $auth.principal.ip in %global_allowed_mgmt_sources
    $auth.principal.user.userid = $cloud_user

    // Event 2: The same principal creates or modifies a firewall rule / security group
    $fw.metadata.event_type = "RESOURCE_CREATION"
    $fw.principal.user.userid = $cloud_user
    not $fw.principal.user.userid in %global_allowed_cloud_principals
    // Match normalised operation names for firewall/security-group mutations across AWS, Azure, GCP
    $fw.target.resource.name = /(?i)(firewall|security.?group|network.?acl|nsg|ingress|egress|authorize|revoke.?security|create.?rule|update.?rule|put.?rule|patch.?rule)/

    // Chronological ordering: login must precede the firewall change
    $auth.metadata.event_timestamp.seconds <= $fw.metadata.event_timestamp.seconds

  match:
    $cloud_user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($cloud_user)
    $login_source_ips = array_distinct($auth.principal.ip)
    $firewall_resources_modified = array_distinct($fw.target.resource.name)
    $login_event_count = count($auth.metadata.event_timestamp.seconds)
    $firewall_change_count = count($fw.metadata.event_timestamp.seconds)

  condition:
    $auth and $fw
}
