/*
  MITRE Technique : T1125 - Video Capture
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:37:05.932811+00:00
  Reference       : https://attack.mitre.org/techniques/T1125
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1125_001_Linux_Video_Capture_Device_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes accessing Linux video capture devices (/dev/video*) or writing video/image files to disk from unexpected processes, indicative of webcam or camera capture activity by malware or scripts. Targets the OS-level device access mechanism that video capture depends on."
    mitre_tactic = "Collection"
    mitre_technique = "T1125"
    mitre_technique_name = "Video Capture"
    log_prerequisites = "Requires Linux EDR telemetry or auditd with file open/access syscall auditing on /dev/video* and process launch events. Auditd rules: -a always,exit -F arch=b64 -S open,openat -F path=/dev/video0 -k video_capture"
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate video conferencing applications (Zoom, Teams, WebEx), OBS Studio, cheese, ffmpeg used by authorized users, security cameras managed by approved software, accessibility tools."
    tuning_guidance = "Add authorized video applications and parent processes to %global_allowed_security_tools or %global_allowed_admin_tools. Scope by user context if video conferencing is common in the environment. Consider suppressing known desktop session PIDs during business hours."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target processes that interact with video capture devices or write video artifacts
    // Match processes invoking video device access via common CLI tools or interpreters
    // that would be used by malware/scripts rather than legitimate GUI apps
    (
      $proc.target.process.file.full_path = /\/(python[23]?|perl|ruby|bash|sh|dash|zsh|ksh|node|nodejs)$/ nocase
      or
      $proc.target.process.file.full_path = /\/(ffmpeg|v4l2-ctl|v4l2grab|streamer|fswebcam|uvccapture|luvcview|guvcview|capture)$/  nocase
    )

    // Command line must reference a video device node or output a video/image file
    // to a world-writable or temp location, indicating covert capture
    (
      $proc.target.process.command_line = /\/dev\/video/ nocase
      or
      $proc.target.process.command_line = /\/dev\/v4l/ nocase
      or
      (
        $proc.target.process.command_line = /\.(mp4|avi|mkv|mov|webm|mjpeg|jpg|jpeg|png|gif)/ nocase
        and
        $proc.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/|\/proc\/)/ nocase
      )
    )

    // Exclude known authorized security and admin tooling
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known backup processes that may interact with media
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1125")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
