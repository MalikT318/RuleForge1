/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:02:30.341531+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Process_Open_Followed_By_Remote_Thread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process opening a handle to another process followed by remote thread creation, indicating potential thread execution hijacking."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR telemetry capturing PROCESS_OPEN and PROCESS_INJECTION events with handle and thread context."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers, security tools performing memory analysis, backup agents, RMM tools, legitimate inter-process communication frameworks."
    tuning_guidance = "Add approved security tools and debuggers to %global_allowed_security_tools. Add backup software to %global_allowed_backup_processes."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.pid != $open.target.process.pid
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path = /\\windows\\system32\\/ nocase
    not $open.principal.process.file.full_path = /\\windows\\syswow64\\/ nocase
    $open.principal.hostname = $hostname
    $open.principal.process.pid = $pid

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.pid = $pid
    $inj.principal.hostname = $hostname
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.target.process.file.full_path = /\\windows\\system32\\svchost\.exe$/ nocase or (
      $inj.target.process.file.full_path = /\\windows\\system32\\svchost\.exe$/ nocase and
      not $inj.principal.process.file.full_path = /\\windows\\system32\\/ nocase
    )

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($open.principal.hostname)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $target_processes = array_distinct($open.target.process.file.full_path)

  condition:
    $open and $inj
}
