/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:18:59.814352+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_SNMP_MIB_Dump_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects SNMP queries (UDP/161 or UDP/162) originating from external, non-RFC1918 source addresses targeting network infrastructure. Adversaries perform SNMP MIB walks to enumerate device configuration, routing tables, interface details, and software inventory for network mapping and pre-exploitation reconnaissance."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Requires firewall or perimeter flow logs that record UDP traffic with source/destination IP and port. SNMP must not be blocked silently at the perimeter - the log must capture the allowed or attempted connection."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised external network monitoring vendors, managed service NOC polling from known external ranges, vulnerability scanners with approved external IPs."
    tuning_guidance = "Add approved external SNMP polling sources to %global_allowed_scanners. If your environment uses a dedicated monitoring VLAN that appears external in firewall logs, add those source addresses to %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // SNMP agent port (queries) or SNMP trap port (notifications)
    (
      $net.target.port = 161 or
      $net.target.port = 162
    )

    // UDP is the canonical SNMP transport; also catch TCP SNMP (RFC 3430)
    (
      $net.network.ip_protocol = "UDP" or
      $net.network.ip_protocol = "TCP"
    )

    // Source must be external - exclude RFC1918 internal space
    not $net.principal.ip in %rfc1918_internal

    // Destination must be internal infrastructure (RFC1918 managed devices)
    $net.target.ip in %rfc1918_internal

    // Exclude approved external scanning and monitoring sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ip = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)
    $protocol = array_distinct($net.network.ip_protocol)

  condition:
    $net
}
