/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:03:46.332308+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_Container_Cron_File_Then_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cron or scheduled-task file written inside a running container followed by a process execution originating from that same container within one hour. Writing cron files or systemd unit files inside a container is unusual and may indicate an adversary establishing persistence or lateral movement via scheduled task abuse in a containerised environment."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053"
    mitre_technique_name = "Scheduled Task/Job"
    log_prerequisites = "Requires container runtime audit logs normalised to Chronicle UDM. FILE_CREATION and PROCESS_LAUNCH events must include principal.resource.name (container/pod identifier) and target.file.full_path / target.process.file.full_path respectively."
    platform = "Linux"
    log_source = "container"
    false_positives = "Legitimate CI/CD pipelines that install cron jobs as part of image build steps executed at runtime; configuration management tooling (Ansible, Chef) running inside containers; init containers that pre-populate cron directories before handing off to the main workload."
    tuning_guidance = "Add known CI/CD service account identifiers to %global_allowed_service_accounts. Add approved container image names or pod name prefixes to %global_allowed_admin_tools if your runtime populates principal.process.file.full_path with the image entrypoint. Narrow the file path regex if only specific cron directories are relevant in your environment."

  events:
    // Event 1: A cron-related or systemd unit file is created inside a container
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\/etc\/cron\.|\/etc\/crontab|\/var\/spool\/cron|\/etc\/anacrontab|\/etc\/systemd\/system\/|\/run\/systemd\/system\/|\/usr\/lib\/systemd\/system\/|\/tmp\/.*\.(cron|timer|service))/
    // Bind to the container/pod identifier so we can join to the exec event
    $file.principal.resource.name = $container_id
    not $file.principal.resource.name = ""
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Event 2: A process is launched from the same container after the file write
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.resource.name = $container_id
    not $proc.principal.resource.name = ""
    // Narrow to shells and interpreters that cron/systemd would invoke
    $proc.target.process.file.full_path = /(?i)\/(sh|bash|dash|ash|ksh|zsh|python[23]?|perl|ruby|node|php|awk|lua|tclsh)(\.[\w]+)?$/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: file write must precede the process launch
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $container_id over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053")
    $primary_entity = array_distinct($container_id)
    $written_cron_paths = array_distinct($file.target.file.full_path)
    $launched_processes = array_distinct($proc.target.process.file.full_path)
    $actor_users = array_distinct($file.principal.user.userid)
    $exec_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
