/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:32:40.267177+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_ESXi_Local_Data_Staging {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects local data staging activity on ESXi hosts where shell commands are used to copy, move, or archive VM-related files (VMDKs, flat files, snapshots, configs) into a staging directory. Adversaries stage data in a central location prior to exfiltration."
    mitre_tactic    = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Local Data Staging"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised to UDM PROCESS_LAUNCH. ESXi shell must be enabled and shell command logging active (hostd or syslog forwarding to Chronicle)."
    platform        = "ESXi"
    log_source      = "vmware_esxi"
    false_positives = "Authorised backup jobs using vmkfstools or storage vMotion, snapshot management by vCenter, disaster recovery automation, and storage maintenance scripts run by infrastructure teams."
    tuning_guidance = "Add known backup service account usernames to %global_allowed_service_accounts and known backup process paths to %global_allowed_backup_processes. Scope by time-of-day if backups run on a fixed schedule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Shell utilities used to copy, move, or archive data on ESXi
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(cp|mv|tar|gzip|vmkfstools|dd|cat|rsync|zip)$/ nocase

    // Command line must reference VM-related file types or datastore paths
    // that indicate staging of VM data rather than routine OS activity
    $proc.target.process.command_line = /\.(vmdk|flat\.vmdk|vmx|vmxf|nvram|vmsn|vmsd|vmem|log)/ nocase

    // Target path must be a datastore, scratch, or tmp-style staging location
    // rather than the canonical VM home directory being the sole destination
    $proc.target.process.command_line = /\/(vmfs\/volumes|scratch|tmp|var\/tmp|store|tardisks)/ nocase

    // Exclude known-good backup and administrative processes
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known service accounts performing authorised backup operations
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $staging_command   = array_distinct($proc.target.process.command_line)
    $acting_user       = array_distinct($proc.principal.user.userid)
    $staging_binary    = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
