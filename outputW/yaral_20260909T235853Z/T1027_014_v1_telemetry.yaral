/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:58:57.666194+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Polymorphic_Executable_Written_To_Volatile_Path {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects executable files written to volatile or world-writable Linux paths (/tmp, /dev/shm, /var/tmp, /run/user, /proc/*/fd). Polymorphic malware frequently writes a mutated copy of itself to these locations before execution, producing a distinct file-creation artifact even when command-line logging is absent or evaded. The rule targets the state change (file artifact) rather than the process invocation."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry with target.file.full_path and target.file.mime_type or target.process.file.full_path populated. Auditd rule '-a always,exit -F arch=b64 -S open,openat,creat -F a1&0100 -k exec_write' captures executable-flag writes."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Package managers extracting temporary files, container runtimes unpacking layers to /tmp, legitimate JIT compilers writing shared objects to /tmp (e.g., JVM, Node.js), build systems using /tmp as a scratch space, Go/Rust test binaries."
    tuning_guidance = "Add known build or JIT parent processes to %global_allowed_script_hosts. Narrow the path regex to exclude specific subdirectories used by approved tooling. Raise severity if the writing process is itself located in a volatile path."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target must be in a volatile or world-writable path
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/user\/|\/proc\/[0-9]+\/fd\/)/ nocase

    // File must have an executable-like extension or no extension at all
    // Polymorphic droppers often write ELF binaries with random or no extension
    (
      $file.target.file.full_path = /\.(elf|so|bin|sh|py|pl|rb|out)$/ nocase
      or
      $file.target.file.full_path = /\/[^\/\.]{4,32}$/
    )

    // Exclude writes originating from approved package managers, backup agents,
    // or known administrative tooling
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

    // Exclude writes by known package managers by path pattern
    not $file.principal.process.file.full_path = /\/(apt|dpkg|rpm|yum|dnf|zypper|snap|flatpak|pip[0-9]?|npm|cargo|go)$/

    // Exclude writes by container runtimes
    not $file.principal.process.file.full_path = /\/(dockerd|containerd|runc|crun|podman|buildkitd)$/

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity    = array_distinct($file.principal.hostname)
    $written_path      = array_distinct($file.target.file.full_path)
    $writing_process   = array_distinct($file.principal.process.file.full_path)
    $writing_user      = array_distinct($file.principal.user.userid)

  condition:
    $file
}
