/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:07:04.517697+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Scheduled_Task_XML_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation of XML task definition files in the Windows Task Scheduler store directories. Adversaries writing tasks via WMI, .NET, netapi32, or direct API calls produce these artifacts without invoking schtasks.exe, bypassing command-line detections. Legitimate software installers and RMM agents also write task XML files, so context and exclusions are important."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent EDR file event) normalised to UDM FILE_CREATION. The creating process must be populated in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers, Windows Update, RMM agents (e.g. deployment tooling), antivirus/EDR agents, and Group Policy processing all legitimately write task XML files to the Tasks store. Add known-good parent processes to %global_allowed_admin_tools and %global_allowed_security_tools."
    tuning_guidance = "Populate %global_allowed_admin_tools with full paths of approved deployment and RMM binaries. Populate %global_allowed_security_tools with EDR/AV agent paths. Consider adding a secondary filter on principal.process.file.full_path to flag unexpected parents such as scripting hosts, Office applications, or browsers."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Task XML files land under the Tasks store; match both the flat root and
    // any Microsoft\Windows\* subdirectory used by built-in tasks.
    $file.target.file.full_path = /(?i)\\Windows\\System32\\Tasks\\.+/ nocase

    // Task definitions are XML; filter on extension to reduce noise from
    // transient temp files written during task registration.
    $file.target.file.full_path = /(?i)\.xml$/ nocase

    // Exclude known-good administrative and security tooling that legitimately
    // registers scheduled tasks as part of their normal operation.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude the Windows task engine itself writing its own files.
    not $file.principal.process.file.full_path = /(?i)\\Windows\\System32\\taskeng\.exe$/
    not $file.principal.process.file.full_path = /(?i)\\Windows\\System32\\taskhostw\.exe$/
    not $file.principal.process.file.full_path = /(?i)\\Windows\\System32\\svchost\.exe$/

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $task_file_path = array_distinct($file.target.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
