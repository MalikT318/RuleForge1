/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:11:39.018963+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Critical_File_Manipulation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification or creation of critical system files on Linux that may indicate data manipulation for impact. Monitors writes to sensitive configuration, log, cron, and systemd paths by unexpected processes, which is a primary behavioral signal for T1565 integrity attacks."
    mitre_tactic = "Impact"
    mitre_technique = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites = "Requires Linux EDR or auditd file write telemetry normalized to UDM FILE_MODIFICATION or FILE_CREATION events with principal process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers (apt, yum, dnf, rpm) updating system files; configuration management agents (Ansible, Puppet, Chef, Salt); backup agents writing to monitored paths; legitimate cron or systemd service deployments by administrators."
    tuning_guidance = "Add known configuration management and package manager process paths to %global_allowed_admin_tools. Add authorized service accounts performing scheduled maintenance to %global_allowed_service_accounts. Narrow the file path regex if specific subdirectories generate excessive noise."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"

    // Target high-value Linux file paths: system config, cron, systemd units, sudoers, passwd/shadow, log infrastructure, and shell profiles
    $file.target.file.full_path = /^(\/etc\/(passwd|shadow|sudoers|sudoers\.d\/|cron\.|crontab|cron\/|ssh\/|hosts|hostname|resolv\.conf|nsswitch\.conf|ld\.so\.conf|profile|environment|bash\.bashrc|sysctl\.conf|security\/|pam\.d\/|audit\/)|\/var\/spool\/cron\/|\/etc\/systemd\/system\/|\/lib\/systemd\/system\/|\/usr\/lib\/systemd\/system\/|\/var\/log\/(auth|syslog|messages|secure|audit\/audit)|\/root\/(\.bashrc|\.bash_profile|\.profile|\.ssh\/)|\/home\/[^\/]+\/(\.bashrc|\.bash_profile|\.profile|\.ssh\/authorized_keys))/ nocase

    // Exclude known-good administrative process paths
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing authorized writes
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good backup processes
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Flag writes from shells, interpreters, and network-facing or unusual processes - these are high-risk writers to critical paths
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[23]?|perl|ruby|php|curl|wget|nc|ncat|socat|lua|node|nodejs)$/ nocase

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
