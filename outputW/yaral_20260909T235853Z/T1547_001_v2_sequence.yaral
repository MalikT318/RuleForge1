/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:09:55.135032+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_RunKey_Write_Then_Logon {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a registry Run/RunOnce key modification followed by a user logon on the same host within 10 minutes. This sequence indicates a persistence mechanism was written and then triggered, providing higher-fidelity coverage than command-line matching alone."
    mitre_tactic    = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 13 or equivalent UDM REGISTRY_MODIFICATION) and Windows Security logon events (Event ID 4624 or equivalent UDM USER_LOGIN)."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Software installers that write run keys and immediately trigger a logon (e.g., after reboot during install), legitimate RMM agents, antivirus or EDR self-registration, Windows Update components."
    tuning_guidance = "Add known-good parent processes that write run keys to %global_allowed_admin_tools. Add authorised service accounts to %global_allowed_service_accounts. Narrow the registry key regex if only specific hives are relevant."

  events:
    // Event 1: A process writes to a registry Run or RunOnce key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run(Once(Ex)?)?$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: A user interactively logs on to the same host
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: run key written before or at logon
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1547.001")
    $primary_entity      = array_distinct($hostname)
    $modified_run_key    = array_distinct($reg.target.registry.registry_key)
    $run_key_value_name  = array_distinct($reg.target.registry.registry_value_name)
    $writing_process     = array_distinct($reg.principal.process.file.full_path)
    $writing_user        = array_distinct($reg.principal.user.userid)
    $logon_user          = array_distinct($auth.principal.user.userid)

  condition:
    $reg and $auth
}
