/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:04:50.035720+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injection_Proc_Mem_Access_Sequence {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage ptrace-based process injection pattern on Linux: a non-debugger process opens or reads /proc/<pid>/mem (the primary mechanism for ptrace-assisted memory writes) and is subsequently observed launching a child process or shell, suggesting successful code injection and execution in a remote process context. This provides additive coverage beyond command-line ptrace detection by focusing on /proc filesystem access patterns and post-injection execution."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM. Auditd rules must capture openat/open syscalls against /proc/*/mem and /proc/*/maps. EDR must emit FILE_READ or FILE_OPEN events for /proc filesystem access and PROCESS_LAUNCH for child process creation."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate debuggers (gdb, lldb, strace, ltrace), profiling tools (perf, valgrind), Java/JVM JIT introspection, container runtimes performing process inspection, security agents reading /proc for telemetry."
    tuning_guidance = "Add known debugger and profiling binary paths to %global_allowed_security_tools. Add authorised security agent hostnames to %global_allowed_admin_tools. Narrow the child process regex if shell spawns from specific parent processes are expected in your environment."

  events:
    // Stage 1: A process reads /proc/<pid>/mem or /proc/<pid>/maps,
    // which is the kernel interface used by ptrace to read/write remote
    // process memory. Filter to non-trivial processes to reduce noise.
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps|pagemap|task\/[0-9]+\/mem)$/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path = /\/(gdb|lldb|strace|ltrace|perf|valgrind|systemd|dockerd|containerd|runc|java|python[0-9.]*|ruby|node)$/
    $file.principal.hostname = $hostname

    // Stage 2: The same host launches a shell or interpreter as a child
    // process shortly after the /proc/mem access, consistent with injected
    // shellcode or a loader executing a follow-on payload.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|node|busybox)$/
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Enforce chronological ordering: memory access precedes shell spawn
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($hostname)
    $injecting_process = array_distinct($file.principal.process.file.full_path)
    $target_proc_path = array_distinct($file.target.file.full_path)
    $spawned_shell = array_distinct($proc.target.process.file.full_path)
    $spawned_cmdline = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
