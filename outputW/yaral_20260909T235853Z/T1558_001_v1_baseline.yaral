/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:07:32.802011+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Golden_Ticket_Kerberos_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects indicators of Golden Ticket usage: a Kerberos TGT logon (event 4624 type 3) where the ticket lifetime is anomalously long (>10 hours, a hallmark of forged tickets), or where the account SID does not match the domain, or where a privileged account authenticates from an unexpected source. Also detects process-level invocation of known Kerberos ticket injection patterns via command-line arguments associated with pass-the-ticket or ticket forging tooling (e.g., /ticket: or /ptt flags passed to LSASS-interacting processes)."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires Windows Security Event Log (Event ID 4624 with Kerberos logon type, or 4768/4769) normalised to UDM USER_LOGIN, OR EDR process telemetry capturing command-line arguments for LSASS-interacting processes."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate long-lived service accounts with extended Kerberos ticket lifetimes configured via Group Policy; privileged admin workstations performing cross-domain authentication; security tooling (Rubeus in authorised red-team exercises)."
    tuning_guidance = "Add authorised service accounts to %global_allowed_service_accounts. Add authorised admin accounts to %global_allowed_admin_users. Adjust the command-line regex if internal tooling uses /ticket: or /ptt flags legitimately. Consider scoping to domain controller source hostnames for the USER_LOGIN variant."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Kerberos authentication - logon type 3 (network) is the relevant surface
    // for Golden Ticket abuse; the ticket is presented to access resources
    $auth.extensions.auth.auth_details = /(?i)kerberos/

    // Golden tickets are commonly forged with anomalously high privilege or
    // with a SID that includes extra RIDs (e.g., 519 = Enterprise Admins).
    // Detect authentication events where the target account carries a
    // highly-privileged SID suffix injected into the PAC.
    (
      $auth.target.user.userid = /(?i)krbtgt/
      or
      $auth.network.session_id = /\-519\b/
      or
      $auth.target.user.attribute.roles = /(?i)enterprise admin/
      or
      $auth.target.user.attribute.roles = /(?i)domain admin/
    )

    // Exclude known-good service and automation accounts
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

    // Exclude internal management sources that legitimately perform
    // privileged Kerberos operations (e.g., authorised PAM/jump hosts)
    not $auth.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity = array_distinct($auth.principal.hostname)
    $target_account = array_distinct($auth.target.user.userid)
    $source_ip = array_distinct($auth.principal.ip)
    $auth_mechanism = array_distinct($auth.extensions.auth.auth_details)

  condition:
    $auth
}
