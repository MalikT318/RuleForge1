/*
  MITRE Technique : T1667 - Email Bombing
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:27:19.938379+00:00
  Reference       : https://attack.mitre.org/techniques/T1667
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1667_001_Email_Bombing_High_Volume_Inbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a high volume of inbound email messages delivered to a single recipient within a short window, consistent with email bombing. Adversaries flood a target inbox to bury legitimate security alerts or business communications, often as a precursor to social engineering or vishing attacks."
    mitre_tactic = "Impact"
    mitre_technique = "T1667"
    mitre_technique_name = "Email Bombing"
    log_prerequisites = "Requires Microsoft 365 unified audit logs with Exchange Online message trace or mail flow events normalised to UDM EMAIL_TRANSACTION. The rule uses a threshold over a 5-minute window."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate high-volume mailing list subscriptions, marketing campaign replies, automated ticketing system notifications, or bulk calendar invitations. Shared mailboxes used for support queues may also trigger this rule."
    tuning_guidance = "Add known high-volume service account senders to %global_allowed_service_accounts. Add approved bulk-mail domains to %global_allowed_domains. Raise the threshold or widen the window for shared mailbox recipients that legitimately receive high volumes."

  events:
    $mail.metadata.event_type = "EMAIL_TRANSACTION"

    // Inbound mail only - sender domain is external (not the recipient domain)
    // Use a broad match on the recipient being a real user address
    $mail.network.email.to = /^[^@]+@[^@]+\.[^@]+$/

    // Exclude known bulk/automated senders that are approved
    not $mail.network.email.from in %global_allowed_domains

    // Exclude approved service accounts that legitimately send high volumes
    not $mail.principal.user.userid in %global_allowed_service_accounts

    // Capture the recipient for grouping
    $mail.network.email.to = $recipient

  match:
    $recipient over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1667")
    $primary_entity = array_distinct($recipient)
    $sender_count = count(distinct $mail.network.email.from)
    $message_count = count($mail.network.email.to)
    $sample_senders = array_distinct($mail.network.email.from)

  condition:
    // Fire when a single recipient receives an anomalously high number of
    // messages in 5 minutes - consistent with automated bombing behaviour
    #mail >= 50
}
