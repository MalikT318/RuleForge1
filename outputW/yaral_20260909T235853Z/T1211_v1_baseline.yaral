/*
  MITRE Technique : T1211 - Exploitation for Stealth
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:49:44.943277+00:00
  Reference       : https://attack.mitre.org/techniques/T1211
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1211_001_Linux_Logging_Suppression_Evasion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process launches consistent with exploitation for stealth on Linux: attempts to suppress, redirect, or tamper with audit/logging subsystems (auditd, syslog, rsyslog, journald) via command-line manipulation. Adversaries exploit vulnerabilities or abuse legitimate tooling to silence telemetry pipelines and evade detection while maintaining access."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1211"
    mitre_technique_name = "Exploitation for Defense Evasion"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH. Auditd rules should capture execve syscalls."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate system administrators stopping/restarting logging services for maintenance, configuration management tools (Ansible, Puppet, Chef) managing auditd or syslog, OS package upgrades that restart logging daemons."
    tuning_guidance = "Add authorised configuration management service accounts to %global_allowed_service_accounts. Add approved admin tooling paths to %global_allowed_admin_tools. Scope by time-of-day if maintenance windows are predictable."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target commands that interact with logging/audit subsystems
    // Match systemctl/service operations against logging daemons
    (
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(systemctl|service)$/ nocase
        and
        (
          $proc.target.process.command_line = /(?i)(stop|disable|mask|kill)\s.*(auditd|rsyslog|syslog|syslogd|journald|systemd-journald|logrotate)/ nocase
          or
          $proc.target.process.command_line = /(?i)(auditd|rsyslog|syslog|syslogd|journald|systemd-journald).*(stop|disable|mask|kill)/
        )
      )
      or
      // auditctl used to disable all rules or set audit to immutable-off / flush
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/auditctl$/ nocase
        and
        (
          $proc.target.process.command_line = /(?i)-D(\s|$)/
          or
          $proc.target.process.command_line = /(?i)--backlog-limit\s+0/
          or
          $proc.target.process.command_line = /(?i)-e\s+0/
        )
      )
      or
      // Redirecting or truncating core log files to /dev/null or emptying them
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin)\/(bash|sh|dash|zsh|python[23]?|perl|ruby)$/ nocase
        and
        (
          $proc.target.process.command_line = /(?i)(\/var\/log\/(audit\/audit\.log|syslog|messages|auth\.log|secure))\s*>\s*\/dev\/null/
          or
          $proc.target.process.command_line = /(?i)truncate\s+.*\/var\/log\/(audit|syslog|messages|auth\.log|secure)/
          or
          $proc.target.process.command_line = /(?i)>\s*\/var\/log\/(audit\/audit\.log|syslog|messages|auth\.log|secure)/
        )
      )
      or
      // kill signals sent directly to logging daemons
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/kill(all)?$/ nocase
        and
        $proc.target.process.command_line = /(?i)(auditd|rsyslogd|syslogd|journald|systemd-journald)/
      )
    )

    // Exclude known-good service accounts and admin tooling
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1211")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_user = array_distinct($proc.principal.user.userid)
    $triggering_cmdline = array_distinct($proc.target.process.command_line)
    $triggering_binary = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
