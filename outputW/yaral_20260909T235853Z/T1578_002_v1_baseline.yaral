/*
  MITRE Technique : T1578.002 - Create Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:14:22.551328+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_002_Cloud_Instance_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new cloud compute instance or virtual machine via cloud provider audit logs. Adversaries may create new instances to bypass existing firewall rules, security policies, or monitoring controls applied to existing instances, enabling defense evasion and lateral data staging."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578.002"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Cloud Instance"
    log_prerequisites = "Requires cloud provider audit logs normalized to Chronicle UDM (AWS CloudTrail RunInstances, Azure Activity Microsoft.Compute/virtualMachines/write, GCP Audit compute.instances.insert)."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized infrastructure-as-code deployments (Terraform, CloudFormation, Ansible), auto-scaling group launches, CI/CD pipeline provisioning, approved cloud admin activity."
    tuning_guidance = "Add known automation and deployment service principals to %global_allowed_cloud_principals. Add known orchestration source accounts to %global_allowed_service_accounts. Consider scoping to off-hours or unexpected regions if baseline is well established."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.target.resource.resource_type = "VIRTUAL_MACHINE"

    // Exclude known-good automation principals and service accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Capture the acting principal and resource for outcome
    $cloud.principal.user.userid = $actor
    $cloud.principal.hostname = $src_host

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1578.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_name = array_distinct($cloud.target.resource.name)
    $resource_type = array_distinct($cloud.target.resource.resource_type)
    $cloud_environment = array_distinct($cloud.target.resource.attribute.cloud.environment)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
