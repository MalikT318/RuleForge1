/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:11:57.823772+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Registry_Mod_Then_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects modification of Winlogon helper registry keys (Notify, Userinit, Shell) followed by a user login on the same host within 10 minutes. This sequence indicates a Winlogon Helper DLL persistence mechanism that will execute at the next logon. Additive coverage over process-launch rules by correlating the registry write with the subsequent logon trigger."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Event ID 13) and Windows Security logon events (Event ID 4624) or equivalent EDR USER_LOGIN telemetry, both normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that modify Winlogon keys (e.g., credential providers, accessibility tools, enterprise authentication agents). Domain join or Group Policy application may also touch these keys."
    tuning_guidance = "Add known-good parent processes (e.g., msiexec.exe, trusted deployment agents) to %global_allowed_admin_tools. Add authorised service accounts that perform software deployment to %global_allowed_service_accounts to suppress the registry-write event."

  events:
    // Event 1: Registry modification of a Winlogon helper key
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon$/
    $reg.target.registry.registry_value_name = /(?i)^(Notify|Userinit|Shell)$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: User login on the same host after the registry modification
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: registry write must precede the login
    $reg.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $logged_in_user = array_distinct($auth.principal.user.userid)

  condition:
    $reg and $auth
}
