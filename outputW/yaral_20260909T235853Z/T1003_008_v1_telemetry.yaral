/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:28:03.036885+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_Passwd_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects file-read access to /etc/shadow or /etc/passwd by a process other than expected system daemons. Attackers reading these files to dump credentials produce a FILE_READ event regardless of which tool they use, providing evasion-resistant coverage complementary to command-line detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux EDR or auditd with file-read (open/read syscall) telemetry normalised to UDM FILE_READ events. Auditd rule: -a always,exit -F path=/etc/shadow -F perm=r -k shadow_read"
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "PAM modules, sssd, systemd-logind, passwd/chpasswd/shadow utilities during legitimate password changes, backup agents reading /etc/passwd for user enumeration."
    tuning_guidance = "Add expected system daemons (sssd, pam, systemd-logind) to %global_allowed_backup_processes or %global_allowed_security_tools. Scope further by excluding reads where principal.user.userid = 'root' only if root-level reads are expected in your environment."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target must be /etc/shadow or /etc/passwd
    $file.target.file.full_path = /^\/etc\/(shadow|passwd|shadow-|passwd-)$/ nocase

    // Exclude well-known legitimate system readers via process path
    not $file.principal.process.file.full_path = /^\/(usr\/)?s?bin\/(passwd|chpasswd|chage|newgrp|login|su|sudo|sshd|sssd|pam|systemd|dbus-daemon|cron|crond|rsyslogd|auditd|nscd|nslcd|ldap|getent)$/ nocase

    // Exclude approved backup and security tooling
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude approved admin tools (e.g. configuration management agents)
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $target_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
