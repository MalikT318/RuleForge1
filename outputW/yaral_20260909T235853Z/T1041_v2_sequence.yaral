/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:23:55.526842+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_002_C2_Exfil_Sustained_Outbound_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects potential exfiltration over a C2 channel by correlating an initial outbound connection to a non-internal destination with a sustained high-volume data transfer to the same external host within a 1-hour window. The pattern — establish channel, then push large volumes of data — is characteristic of C2-based exfiltration on Linux hosts. Firewall/perimeter telemetry only; no endpoint process context required."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to UDM NETWORK_CONNECTION and NETWORK_FLOW events, with network.sent_bytes and connection metadata populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate backup jobs pushing data to cloud storage, software update mirrors, CDN origin pulls, authorised bulk data transfers to SaaS platforms, VPN concentrators aggregating traffic."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add approved scanner or backup source IPs to %global_allowed_backup_processes or %global_allowed_scanners. Raise the sent_bytes threshold if the environment has large legitimate outbound transfers. Consider narrowing to specific internal subnets if only certain segments host Linux servers."

  events:
    // Event 1: Initial outbound connection established to an external destination
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    not $conn.target.ip in %rfc1918_internal
    not $conn.target.hostname in %global_allowed_domains
    not $conn.principal.ip in %global_allowed_scanners
    $conn.network.sent_bytes > 0
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip

    // Event 2: Sustained high-volume outbound flow to the same external destination
    $flow.metadata.event_type = "NETWORK_FLOW"
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.hostname in %global_allowed_domains
    not $flow.principal.ip in %global_allowed_backup_processes
    $flow.network.sent_bytes >= 10000000
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip

    // Chronological ordering: connection established before or at the time of the large flow
    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity = array_distinct($src_ip)
    $destination_ip = array_distinct($dst_ip)
    $destination_hostname = array_distinct($flow.target.hostname)
    $total_bytes_sent = max($flow.network.sent_bytes)
    $destination_port = array_distinct($flow.target.port)
    $connection_count = count($flow.metadata.id)

  condition:
    $conn and $flow
}
