/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:26:18.441683+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_CachedCreds_RegRead_Then_FileWrite {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage cached domain credential harvesting pattern on Windows: (1) a non-system process opens or reads the LSA Secrets / NL$KM registry key where DCC2 hashes are stored, followed within 10 minutes by (2) a file write to a staging location consistent with credential dumping output. This correlation provides additive coverage beyond command-line matching by focusing on the registry access and file-drop artefacts rather than the tool invocation."
    mitre_tactic         = "Credential Access"
    mitre_technique      = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites    = "Requires EDR or Sysmon registry-event telemetry (Sysmon Event IDs 12/13/14 or equivalent EDR registry events) and file-creation telemetry normalised to UDM REGISTRY_MODIFICATION and FILE_CREATION."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Backup agents reading the registry hive for system-state backups; authorised security assessment tooling; Windows in-box components such as lsass.exe performing routine credential cache maintenance."
    tuning_guidance      = "Add backup and security agent process paths to %global_allowed_backup_processes and %global_allowed_security_tools. Narrow the file-path regex if your environment uses a specific staging directory convention."

  events:
    // --- Event 1: Registry access to the cached-credentials key ---
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    // NL$KM is the key that stores the DCC2 session key; SECURITY\Cache stores the hashes themselves
    $reg.target.registry.registry_key = /\\SECURITY\\(Cache|Policy\\Secrets\\NL\$KM)/
    // Exclude lsass and the registry service itself - they legitimately touch this key
    not $reg.principal.process.file.full_path = /\\(lsass|svchost|services)\.exe$/
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    // --- Event 2: File creation consistent with credential dump staging ---
    $file.metadata.event_type = "FILE_CREATION"
    // Common output extensions used by secretsdump, reg save, and similar tooling
    $file.target.file.full_path = /\.(dmp|dit|ntds|sam|hive|out|bin|dat|secrets)$/
    // Written outside standard Windows system directories to a writable staging path
    $file.target.file.full_path = /(?i)(\\Users\\|\\Temp\\|\\Windows\\Temp\\|\\ProgramData\\|\\AppData\\)/
    not $file.principal.process.file.full_path = /\\(lsass|svchost|services|werfault)\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    // --- Chronological ordering: registry access precedes file write ---
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score        = max(85)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity    = array_distinct($hostname)
    $reg_keys_accessed = array_distinct($reg.target.registry.registry_key)
    $files_written     = array_distinct($file.target.file.full_path)
    $reg_processes     = array_distinct($reg.principal.process.file.full_path)
    $file_processes    = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
