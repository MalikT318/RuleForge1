/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:28:39.827312+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_Bluetooth_Exfiltration_Process_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process activity indicative of Bluetooth-based data exfiltration on Windows. Monitors for processes invoking Bluetooth APIs, utilities, or PowerShell cmdlets associated with Bluetooth device interaction and file transfer, which may indicate an adversary attempting to exfiltrate data over a Bluetooth channel rather than the primary network."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Bluetooth"
    log_prerequisites = "Requires EDR process telemetry with command-line capture (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1). Command-line arguments must be logged."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Bluetooth file transfer utilities used by IT staff, Windows built-in Bluetooth pairing and settings processes, enterprise MDM or device management tools interacting with Bluetooth, accessibility software using Bluetooth peripherals."
    tuning_guidance = "Add approved Bluetooth management parent processes to %global_allowed_admin_tools. Add authorised service accounts performing device management to %global_allowed_service_accounts. Narrow scope by correlating with proximity to sensitive data access events."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Detect PowerShell or scripting hosts invoking Bluetooth-related cmdlets or APIs
    // OR native Windows Bluetooth utilities being launched with transfer-indicative arguments
    (
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript)\.exe$/ nocase
        and
        (
          $proc.target.process.command_line = /(?i)bluetooth/
          or
          $proc.target.process.command_line = /(?i)InTheHand|32feet|BluetoothClient|BluetoothDeviceInfo/
          or
          $proc.target.process.command_line = /(?i)ObexPush|obex|rfcomm|bthprops/
          or
          $proc.target.process.command_line = /(?i)Get-PnpDevice.*bluetooth/
          or
          $proc.target.process.command_line = /(?i)Add-Type.*bluetooth/
        )
      )
      or
      (
        // fsquirt.exe is the Windows Bluetooth File Transfer Wizard
        $proc.target.process.file.full_path = /\\fsquirt\.exe$/ nocase
      )
      or
      (
        // bthudtask.exe and bthand processes are Bluetooth stack components
        // being launched by unusual parents (not services or svchost)
        $proc.target.process.file.full_path = /\\(bthudtask|btstackserver|bttray)\.exe$/ nocase
        and not $proc.principal.process.file.full_path = /\\(svchost|services|wininit)\.exe$/ nocase
      )
      or
      (
        // rundll32 loading Bluetooth-related DLLs
        $proc.target.process.file.full_path = /\\rundll32\.exe$/ nocase
        and $proc.target.process.command_line = /(?i)bthprops\.cpl|BluetoothAuthenticationAgent|fsquirt/
      )
    )

    // Exclude known administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggered_process = array_distinct($proc.target.process.file.full_path)
    $triggered_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
