/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:38:59.805834+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_Make_And_Impersonate_Token {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process creating a new logon session token via LogonUser API, indicating token creation for impersonation and privilege escalation."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Requires EDR telemetry with API call monitoring or Sysmon Event ID 10 (ProcessAccess) with CallTrace containing LogonUser."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Service installers, RunAs utilities, credential vaults, remote management tools, scheduled task creation with alternate credentials, backup software."
    tuning_guidance = "Add approved service installers and RMM tools to %global_allowed_admin_tools. Exclude known service accounts from %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"
    (
      $proc.target.process.command_line = /(?i)logonuser/ or
      $proc.target.process.command_line = /(?i)createprocesswithtokenw/ or
      $proc.target.process.command_line = /(?i)createprocessasuser/
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path = /\\windows\\system32\\services\.exe$/ nocase
    not $proc.principal.process.file.full_path = /\\windows\\system32\\svchost\.exe$/ nocase
    not $proc.principal.process.file.full_path = /\\windows\\system32\\lsass\.exe$/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path = /\\windows\\system32\\taskeng\.exe$/ nocase
    not $proc.principal.process.file.full_path = /\\windows\\system32\\taskhostw\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
