/*
  MITRE Technique : T1525 - Implant Internal Image
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:00:26.163330+00:00
  Reference       : https://attack.mitre.org/techniques/T1525
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1525_Implant_Internal_Container_Image {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects adversaries implanting or backdooring container images within a cloud registry. Monitors for image push, import, or tag mutation operations performed by non-service principals or from unexpected sources, which may indicate an attempt to establish persistence via a malicious container image."
    mitre_tactic = "Persistence"
    mitre_technique = "T1525"
    mitre_technique_name = "Implant Internal Image"
    log_prerequisites = "Requires cloud provider audit logs (e.g., CloudTrail, GCP Audit Logs, Azure Activity Logs) with container registry API events normalised into Chronicle UDM. Events should include resource type, API method, and principal identity."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines pushing new image versions, authorised DevOps engineers tagging releases, automated build systems updating base images."
    tuning_guidance = "Add known CI/CD service account identifiers to %global_allowed_service_accounts. Add approved automation principals to %global_allowed_cloud_principals. Consider scoping to sensitive registries or production namespaces if staging registries generate excessive noise."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target a container image registry resource type
    $cloud.target.resource.resource_type = /(?i)(container.?image|container.?registry|image.?repository|artifact.?registry)/

    // Match image push, import, tag, or mutation API methods
    $cloud.target.resource.attribute.labels["api_method"] = /(?i)(push|import|put.?image|create.?image|tag.?image|upload.?layer|initiate.?layer.?upload|complete.?layer.?upload|put.?manifest|replicate.?image)/

    // Exclude known-good service accounts and automation principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Capture the acting principal and resource for outcome
    $cloud.principal.user.userid = $actor
    $cloud.target.resource.name = $image_resource

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1525")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $image_name = array_distinct($image_resource)
    $acting_user = array_distinct($actor)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
