/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:05:41.105792+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_At_Job_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of at job files in /var/spool/cron/atjobs or /var/spool/at, indicating scheduled task persistence via the at utility. Focuses on the resulting artifact rather than command-line execution."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires Linux EDR or auditd file monitoring with FILE_CREATION events for /var/spool directories."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate administrative automation, backup scripts, system maintenance tasks scheduled via at, monitoring tools creating scheduled jobs."
    tuning_guidance = "Add authorized automation service accounts to %global_allowed_service_accounts. Review principal.user.userid for expected administrative users."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /^\/var\/spool\/cron\/atjobs\/a[0-9a-f]+$/ nocase or
      $file.target.file.full_path = /^\/var\/spool\/at\/a[0-9a-f]+$/ nocase or
      $file.target.file.full_path = /^\/var\/spool\/cron\/atjobs\/\.SEQ$/ nocase or
      $file.target.file.full_path = /^\/var\/spool\/at\/\.SEQ$/ nocase
    )
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
