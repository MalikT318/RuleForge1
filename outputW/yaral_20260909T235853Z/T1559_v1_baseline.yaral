/*
  MITRE Technique : T1559 - Inter-Process Communication
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:08:53.090291+00:00
  Reference       : https://attack.mitre.org/techniques/T1559
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Object_Abuse_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects abuse of COM (Component Object Model) IPC mechanisms via scripting hosts invoking COM automation to execute code. Adversaries use COM objects through wscript, cscript, powershell, or mshta to spawn child processes or execute arbitrary commands, a core T1559.001 behavior."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires EDR process telemetry with parent-child process lineage and command-line arguments (e.g., Sysmon Event ID 1, CrowdStrike, Defender for Endpoint, SentinelOne)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative scripts using COM automation, software installers invoking COM objects, RMM tools, Office macros in managed environments, and developer tooling."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_script_hosts. Add known-good admin accounts to %global_allowed_admin_users. Narrow scope by requiring additional suspicious child process indicators if false-positive rate is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent is a COM-capable scripting or automation host commonly abused for IPC execution
    $proc.principal.process.file.full_path = /\\(wscript|cscript|mshta|powershell|pwsh|regsvr32|rundll32|dllhost|svchost)\.exe$/  nocase

    // Child process is a shell, interpreter, or execution utility - indicates COM-triggered code execution
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|certutil|bitsadmin|regsvr32|rundll32|msiexec|wmic|cmstp|installutil|msbuild|csc|vbc)\.exe$/ nocase

    // Exclude cases where the parent and child are the same binary (self-invocation noise)
    // Require at least one suspicious command-line indicator suggesting COM-driven execution
    $proc.target.process.command_line = /(\-enc|\-encodedcommand|\/e:|CreateObject|GetObject|WScript\.Shell|Shell\.Application|Scripting\.FileSystemObject|CLSID|ProgID|regsvr32|\/scrobj|javascript:|vbscript:)/  nocase

    // Exclude approved script hosts and admin tooling
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
