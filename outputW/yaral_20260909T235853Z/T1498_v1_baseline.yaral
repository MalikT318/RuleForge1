/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:58:32.651112+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Network_DoS_High_Volume_Outbound_Flows {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential Network Denial of Service activity by identifying a single source generating an abnormally high volume of outbound network bytes in a single flow record, as observed in firewall or perimeter logs. This is consistent with flood-based DoS/DDoS participation, including UDP floods, ICMP floods, and TCP SYN floods originating from or transiting a cloud-hosted resource."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Requires firewall or network perimeter flow logs with bytes_sent or network.sent_bytes populated per flow record. Flows must be exported with per-connection or per-interval aggregation."
    platform = "IaaS"
    log_source = "firewall"
    false_positives = "Legitimate large data transfers such as backup jobs, media streaming egress, CDN origin pulls, or bulk data replication between cloud regions. Authorised load testing or performance benchmarking. Vulnerability scanners generating high connection volume."
    tuning_guidance = "Raise the network.sent_bytes threshold to reduce false positives from bulk transfer workloads. Add known backup or replication source IPs to %global_allowed_backup_processes exclusion context, or add known scanner sources to %global_allowed_scanners. Consider narrowing to specific destination ports associated with amplification protocols (UDP/53, UDP/123, UDP/1900) for higher fidelity."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Source must be an internal (cloud-hosted) address - exclude known scanners
    not $net.principal.ip in %global_allowed_scanners

    // Destination must be external (not RFC1918 internal space)
    not $net.target.ip in %rfc1918_internal

    // Exclude approved backup and replication processes/sources
    not $net.principal.ip in %global_allowed_backup_processes

    // High outbound byte volume in a single flow record - threshold indicative of flood behaviour
    // 500 MB per flow record is anomalous for most workloads; tune upward for bulk-transfer environments
    $net.network.sent_bytes > 524288000

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
