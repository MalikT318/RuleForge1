/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:44:25.180602+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Firewall_Disabled_New_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects new or unusual inbound/outbound network connections from Linux hosts to external addresses on ports commonly blocked by host firewalls (e.g., raw shell ports, uncommon management ports). A sudden burst of previously unseen external connections from a Linux host may indicate that the host firewall has been disabled or modified, allowing traffic that was previously blocked. This rule provides network-side coverage complementary to endpoint process-launch detections for firewall modification commands."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW. Flows must include source/destination IP and destination port."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate administrative sessions opened after a maintenance window; newly provisioned Linux hosts not yet enrolled in firewall policy; authorised vulnerability scanners; backup or monitoring agents using non-standard ports."
    tuning_guidance = "Add authorised management source addresses to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Narrow the port list to ports not used in your environment. Raise the risk score if the destination port is in the 4444-4445 or 31337 range."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Traffic must be leaving an internal host toward an external destination
    $net.principal.ip = /./
    not $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal

    // Ports that are almost universally blocked by default Linux host firewalls
    // and whose sudden appearance in perimeter logs is a strong indicator that
    // the firewall has been disabled or a permissive rule added.
    // Covers: raw TCP shells (4444, 4445), legacy rsh/rexec (512-514),
    // telnet (23), TFTP (69/udp), X11 (6000-6005), IRC (6667),
    // and high-entropy C2 staging ports (1337, 31337).
    (
      $net.target.port = 23   or
      $net.target.port = 69   or
      $net.target.port = 512  or
      $net.target.port = 513  or
      $net.target.port = 514  or
      $net.target.port = 1337 or
      $net.target.port = 4444 or
      $net.target.port = 4445 or
      $net.target.port = 6000 or
      $net.target.port = 6001 or
      $net.target.port = 6002 or
      $net.target.port = 6003 or
      $net.target.port = 6004 or
      $net.target.port = 6005 or
      $net.target.port = 6667 or
      $net.target.port = 31337
    )

    // Exclude authorised management and scanner sources
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
