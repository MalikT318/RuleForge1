/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:38:14.894069+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_Token_Impersonation_Theft {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process handle acquisition patterns consistent with token impersonation or theft. Adversaries open handles to privileged processes (LSASS, winlogon, services) from unexpected parents using tools that invoke DuplicateToken/ImpersonateLoggedOnUser/SetThreadToken. This rule targets the PROCESS_OPEN event where a low-privilege or unusual process opens a handle to a high-value target process, which is the prerequisite OS mechanism for token duplication and impersonation."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires EDR or Sysmon process open/handle telemetry (Sysmon Event ID 10 or equivalent EDR handle acquisition events normalised to PROCESS_OPEN in UDM)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tooling (EDR agents, AV), authorised privilege management software, legitimate administrative scripts, WMI providers, and backup agents that legitimately open handles to system processes."
    tuning_guidance = "Add known-good security and administrative tool paths to %global_allowed_security_tools and %global_allowed_admin_tools. Scope further by correlating with the principal process path and excluding known-good parent directories such as Program Files vendor subdirectories."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be a high-value system process that holds privileged tokens
    $open.target.process.file.full_path = /\\(lsass|winlogon|services|svchost|csrss|wininit|lsm)\.exe$/ nocase

    // The opening (principal) process must NOT itself be a known system binary
    // running from the canonical Windows system directory
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\(lsass|winlogon|services|svchost|csrss|wininit|lsm|taskmgr|mmc|wbem\\wmiprvse|antimalware|MsMpEng)\.exe$/

    // Exclude processes running from canonical Windows directories that are
    // expected to open handles to system processes for legitimate reasons
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww]indows\\[Ss]ystem32\\/
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww]indows\\[Ss]ys[Ww][Oo][Ww]64\\/
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww]indows\\[Ww][Ii][Nn]SxS\\/

    // Exclude approved security and administrative tooling
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Principal process must exist (not a kernel/system handle with no path)
    $open.principal.process.file.full_path != ""
    $open.principal.process.file.full_path != "-"

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $principal_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
