/*
  MITRE Technique : T1558.002 - Silver Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:07:53.208765+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_002_Silver_Ticket_Anomalous_Service_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential Silver Ticket usage by identifying Kerberos service ticket authentication events that lack a corresponding TGT request (Event 4768 absent before 4769), or where the ticket encryption type is RC4-HMAC (0x17) — a common indicator of forged tickets — combined with a service account logon that bypasses the KDC. Silver tickets are forged TGS tickets created offline using a service account's NTLM hash, allowing access to specific services without KDC interaction."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.002"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Silver Ticket"
    log_prerequisites = "Requires Windows Security Event Log forwarded to Chronicle. Key events: 4769 (Kerberos Service Ticket Request) with ticket encryption type and failure code fields populated in UDM. Kerberos audit policy must be enabled (Audit Kerberos Service Ticket Operations)."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legacy applications and services that legitimately negotiate RC4-HMAC encryption (older SQL Server, IIS, or third-party Kerberos clients). Service accounts in environments that have not enforced AES encryption. Misconfigured SPNs causing unexpected ticket patterns."
    tuning_guidance = "Add known legacy service accounts that legitimately use RC4 to %global_allowed_service_accounts. Enforce AES256 Kerberos encryption across the environment to reduce RC4 baseline noise. Correlate with absence of Event 4768 for the same user within a short window for higher fidelity. Raise severity if the target service is a Tier-0 asset (DC, CA, SQL)."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Kerberos service ticket authentication — ticket encryption type RC4-HMAC (0x17)
    // is the primary indicator of a forged silver ticket; AES tickets are 0x12/0x11
    $auth.extensions.auth.auth_details = /(?i)rc4|0x17|arcfour/

    // Silver tickets are used to authenticate directly to a service;
    // the logon type will reflect a network/service authentication
    $auth.extensions.auth.mechanism = "KERBEROS"

    // Exclude machine accounts (end with $) — silver tickets target service SPNs,
    // not computer accounts in typical usage; adjust if targeting computer SPNs
    not $auth.principal.user.userid = /\$$/

    // Exclude known service accounts that legitimately use RC4
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude known admin accounts expected to perform privileged Kerberos operations
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Exclude internal management sources performing authorised Kerberos operations
    not $auth.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = "T1558.002"
    $primary_entity = $auth.principal.user.userid

  condition:
    $auth
}
