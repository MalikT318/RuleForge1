/*
  MITRE Technique : T1680 - Local Storage Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:30:28.687952+00:00
  Reference       : https://attack.mitre.org/techniques/T1680
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1680_001_ESXi_Storage_Discovery_Via_ESXCLI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects adversaries enumerating local storage on ESXi hosts using esxcli or related hypervisor CLI commands to list datastores, volumes, or VMDK files. This behaviour is a common precursor to ransomware encryption or lateral movement on ESXi infrastructure."
    mitre_tactic = "Discovery"
    mitre_technique = "T1680"
    mitre_technique_name = "Local Storage Discovery"
    log_prerequisites = "Requires ESXi shell/hostd process telemetry normalised to UDM PROCESS_LAUNCH. ESXi shell must be enabled and shell command logging must be forwarded to Chronicle via syslog or the VMware log integration."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised VMware administrators performing routine storage health checks, capacity planning scripts, backup agents enumerating datastores, and monitoring tools polling storage metrics."
    tuning_guidance = "Add known administrative service accounts to %global_allowed_service_accounts and approved automation hosts to %global_allowed_admin_tools. Consider narrowing the match window to off-hours if storage enumeration is only expected during maintenance windows."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target the esxcli binary or vim-cmd used for storage enumeration on ESXi
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/lib\/vmware\/bin)\/esxcli$/ nocase

    // Storage-related subcommands: storage, volume, filesystem, adapter, device
    $proc.target.process.command_line = /storage|vsan|filesystem|datastore|adapter|device|volume/ nocase

    // List/get operations indicating enumeration rather than configuration change
    $proc.target.process.command_line = /\b(list|get|info|show)\b/ nocase

    // Exclude known authorised service accounts performing scheduled storage checks
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude known authorised administrative tooling (backup agents, monitoring)
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1680")
    $primary_entity = array_distinct($proc.principal.hostname)
    $executing_user = array_distinct($proc.principal.user.userid)
    $storage_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
