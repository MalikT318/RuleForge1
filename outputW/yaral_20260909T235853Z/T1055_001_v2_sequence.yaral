/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:00:38.457340+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_WriteFile_Then_ProcessOpen {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage DLL injection pattern: a non-system process writes a DLL to a user-writable or temp directory, then opens a handle to a remote process shortly after. This sequence mirrors the classic VirtualAllocEx/WriteProcessMemory/CreateRemoteThread injection workflow without relying on command-line matching."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry normalised to UDM. FILE_CREATION events must capture target.file.full_path. PROCESS_OPEN events must capture principal.process.file.full_path and target.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers dropping DLLs to temp directories; JIT compilers (e.g., .NET CLR, JVM) writing native images; security agents performing in-memory patching; application virtualisation frameworks."
    tuning_guidance = "Add known-good parent processes (installers, JIT runtimes, security agents) to %global_allowed_security_tools or %global_allowed_admin_tools. Add approved service accounts to %global_allowed_service_accounts. Narrow the file path regex to exclude vendor-specific temp subdirectories once baselining is complete."

  events:
    // Stage 1: a non-system process drops a DLL into a user-writable or temp location
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\.(dll)$/
    $file.target.file.full_path = /(?i)(\\temp\\|\\tmp\\|\\appdata\\|\\programdata\\|\\users\\)/
    not $file.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww]indows\\[Ss]ystem32\\/
    not $file.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww]indows\\[Ss]ys[Ww][Oo][Ww]64\\/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $userid

    // Stage 2: the same host opens a handle to a different (remote) process — hallmark of cross-process injection
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /(?i)\.(exe)$/
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww]indows\\[Ss]ystem32\\/
    not $open.principal.process.file.full_path = /(?i)^[Cc]:\\[Ww]indows\\[Ss]ys[Ww][Oo][Ww]64\\/
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.user.userid in %global_allowed_service_accounts
    // The opener and the target must be different processes (cross-process handle)
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    $open.principal.hostname = $hostname
    $open.principal.user.userid = $userid

    // Chronological ordering: DLL drop must precede the process open
    $file.metadata.event_timestamp.seconds <= $open.metadata.event_timestamp.seconds

  match:
    $hostname, $userid over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($hostname)
    $dropped_dll_paths = array_distinct($file.target.file.full_path)
    $injecting_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $affected_user = array_distinct($userid)

  condition:
    $file and $open
}
