/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:22:44.977345+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Handle_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a non-system process opening a handle to lsass.exe with permissions consistent with memory reading (credential dumping). Attackers must request a process handle to lsass before they can extract credentials from its memory. This fires on the PROCESS_OPEN event rather than process creation, providing a layer of detection that survives command-line obfuscation and tool renaming."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised to UDM PROCESS_OPEN. The sensor must capture the target process name and the granted access mask."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents opening lsass for memory scanning, backup agents, Windows Error Reporting (WerFault.exe), Task Manager opened by administrators, some RMM tools performing health checks."
    tuning_guidance = "Add known-good security and backup agent paths to %global_allowed_security_tools and %global_allowed_backup_processes. Consider scoping by access mask if the EDR populates security_result.description with the raw mask value."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Target must be lsass - the Local Security Authority Subsystem
    $open.target.process.file.full_path = /(?i)\\lsass\.exe$/

    // The opening (principal) process must NOT itself be lsass or the System process
    not $open.principal.process.file.full_path = /(?i)\\lsass\.exe$/
    not $open.principal.process.file.full_path = /(?i)\\system$/

    // Exclude common Windows OS paths that legitimately open lsass
    not $open.principal.process.file.full_path = /(?i)\\Windows\\System32\\svchost\.exe$/
    not $open.principal.process.file.full_path = /(?i)\\Windows\\System32\\csrss\.exe$/
    not $open.principal.process.file.full_path = /(?i)\\Windows\\System32\\wininit\.exe$/
    not $open.principal.process.file.full_path = /(?i)\\Windows\\System32\\services\.exe$/
    not $open.principal.process.file.full_path = /(?i)\\Windows\\System32\\WerFault\.exe$/
    not $open.principal.process.file.full_path = /(?i)\\Windows\\System32\\taskmgr\.exe$/

    // Exclude approved security tooling and backup agents via reference lists
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude approved admin tools (e.g. authorised RMM agents)
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

    // Require a hostname to be present for grouping and SOAR enrichment
    $open.principal.hostname != ""

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($open.principal.hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $opening_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
