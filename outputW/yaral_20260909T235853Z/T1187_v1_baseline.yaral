/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:43:56.006633+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_001_Forced_SMB_Auth_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound SMB or WebDAV connections to external (non-RFC1918) destinations, which may indicate forced authentication attacks where a victim host is coerced into authenticating to an adversary-controlled server, exposing NTLM credential hashes. SMB uses TCP 445/139; WebDAV typically uses TCP 80/443."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Requires firewall or perimeter network flow logs with source/destination IP and port visibility. Outbound SMB (TCP 445/139) should be blocked at the perimeter in most environments; any allowed flow is high-fidelity. WebDAV (TCP 80/443) requires port-based correlation."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SMB to cloud file-sharing services (rare but possible in misconfigured environments). WebDAV to approved cloud storage providers on TCP 80/443. Authorized vulnerability scanners testing perimeter controls."
    tuning_guidance = "Add approved external SMB/WebDAV destinations to %global_allowed_domains. Add authorized scanner source IPs to %global_allowed_scanners. If WebDAV on 80/443 generates excessive noise, consider raising severity threshold or scoping to TCP 445/139 only as a starting point."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source must be an internal (RFC1918) host initiating the connection
    $net.principal.ip in %rfc1918_internal

    // Destination must NOT be internal - external forced-auth target
    not $net.target.ip in %rfc1918_internal

    // Target ports: SMB (445, 139) or WebDAV fallback (80, 443)
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 80  or
      $net.target.port = 443
    )

    // Exclude known-good external domains (CDNs, approved cloud services)
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorized scanners that may probe these ports
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved remote management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    // SMB ports (445/139) are critical - direct credential theft vector
    // WebDAV (80/443) is lower fidelity due to legitimate HTTPS traffic
    $risk_score = max(
      if($net.target.port = 445, 90,
      if($net.target.port = 139, 85,
      if($net.target.port = 80,  55, 60)))
    )
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $destination_hostname = array_distinct($net.target.hostname)

  condition:
    $net
}
