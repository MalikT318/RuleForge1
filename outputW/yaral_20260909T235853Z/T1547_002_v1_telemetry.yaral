/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:10:20.075958+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_Authentication_Package_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects modification of the LSA Authentication Packages registry key, used to load malicious DLLs at system boot for persistence and privilege escalation."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires EDR registry telemetry or Sysmon Event ID 13."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security software installing authentication packages, enterprise SSO solutions, smart card middleware, third-party credential providers."
    tuning_guidance = "Add approved security software processes to %global_allowed_security_tools. Validate that the target DLL is signed and from a trusted vendor."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\?$/ nocase
    $reg.target.registry.registry_value_name = /(?i)authentication packages/
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\windows\\system32\\svchost\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\windows\\system32\\lsass\.exe$/ nocase

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($reg.principal.hostname)

  condition:
    $reg
}
