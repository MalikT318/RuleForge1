/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:33:21.039266+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_AppLayerProtocol_HighFreqExternalConnections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects high-frequency or anomalous outbound network connections from Linux hosts to external IP addresses on common application-layer protocol ports (HTTP, HTTPS, DNS, FTP, SMTP). Adversaries abuse these protocols to blend C2 traffic with legitimate traffic. This rule fires on individual connection events to external destinations and is intended to complement endpoint process-launch detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires firewall, perimeter proxy, or network flow logs normalised to Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events. Source IP must be populated with the internal Linux host address."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate software update services, monitoring agents, CDN health checks, backup agents making frequent outbound connections. Authorised vulnerability scanners and remote management tooling."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Add approved remote management sources to %global_allowed_remote_mgmt. Raise the port filter to exclude additional approved services if needed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Restrict to common application-layer protocol ports used for C2 blending
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 53 or
      $net.target.port = 21 or
      $net.target.port = 25 or
      $net.target.port = 587 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )

    // Exclude RFC1918 / internal destinations - use reference list, not hardcoded ranges
    not $net.target.ip in %rfc1918_internal

    // Exclude known-good external domains if hostname is populated
    not $net.target.hostname in %global_allowed_domains

    // Exclude authorised scanners initiating from internal sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved remote management sources
    not $net.principal.ip in %global_allowed_remote_mgmt

    // Require a source (internal Linux host) to be present
    $net.principal.ip != ""

    // Exclude loopback - belt-and-suspenders guard
    not $net.target.ip = "127.0.0.1"

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_hostname = array_distinct($net.target.hostname)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
