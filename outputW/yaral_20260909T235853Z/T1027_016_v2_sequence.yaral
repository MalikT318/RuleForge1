/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:00:49.224932+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_JunkCode_SuspiciousFileWrite_Then_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a suspicious file written to a user-writable or temp directory by a script host or document application, followed within 5 minutes by execution of that same file from the same host. This pattern is consistent with junk-code-obfuscated payloads dropped and launched by a stager, where static analysis is hindered by dead-code insertion. Variant 2 of 2 for T1027.016."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION and PROCESS_LAUNCH telemetry normalised to UDM. Both event types must be present for the same host."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers unpacking and running legitimate executables from temp directories; developer toolchains compiling and running binaries in scratch folders; RMM agents deploying patches."
    tuning_guidance = "Add known-good parent processes (e.g., installer frameworks, build agents) to %global_allowed_admin_tools. Add authorised service accounts that perform deployments to %global_allowed_service_accounts. Narrow the file path regex if a specific temp directory is generating noise."

  events:
    // Event 1: A script host, document app, or interpreter writes an executable
    // to a user-writable or temporary location.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\(temp|tmp|appdata\\local\\temp|appdata\\roaming|users\\[^\\]+\\downloads|programdata|public)\\[^\\]+\.(exe|dll|scr|com|pif|cpl|bat|ps1|vbs|js|hta)$/
    $file.principal.process.file.full_path = /(?i)\\(winword|excel|powerpnt|outlook|mshta|wscript|cscript|powershell|pwsh|cmd|msiexec|regsvr32|rundll32|certutil|bitsadmin|curl|wget)\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $dropped_path

    // Event 2: The dropped file is subsequently executed on the same host.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $dropped_path
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Enforce chronological ordering: file must be written before execution.
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $dropped_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity = array_distinct($proc.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $executing_process = array_distinct($proc.target.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)
    $file_path_written = array_distinct($file.target.file.full_path)

  condition:
    $file and $proc
}
