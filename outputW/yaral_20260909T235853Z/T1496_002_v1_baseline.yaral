/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:56:10.438172+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_High_Volume_Outbound_Connections_Single_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects sustained high-volume outbound network connections to a single external destination, indicative of bandwidth hijacking, proxyjacking, or botnet participation."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Resource Hijacking: Bandwidth Hijacking"
    log_prerequisites = "Requires firewall or proxy logs with connection volume metrics."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate high-bandwidth applications (backup to cloud, video conferencing, CDN sync, software updates, large file transfers to vendors)."
    tuning_guidance = "Add approved high-bandwidth destinations to %global_allowed_domains or exclude known backup/sync traffic by destination IP. Adjust network.sent_bytes threshold based on baseline traffic patterns."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    not $net.target.ip in %rfc1918_internal
    $net.network.sent_bytes >= 104857600
    not $net.target.hostname in %global_allowed_domains
    not $net.target.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($net.principal.ip)

  condition:
    $net
}
