/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:37:05.854133+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_001_ESXi_Suspicious_File_Creation_Datastore {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of new files in ESXi locations that are not typical VM artefacts (vmdk, vmx, nvram, log). Adversaries transferring tools onto a compromised ESXi host via wget, curl, scp, or sftp will produce a FILE_CREATION event in scratch space, /tmp, /var/run, or directly on a datastore path. This rule pivots on the resulting file artifact rather than the command line used to fetch it, providing coverage that survives command-line obfuscation or log-source gaps."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires ESXi shell/hostd file-audit telemetry forwarded to Chronicle via syslog or the VMware ESXi log source. FILE_CREATION events must be normalised into UDM by the Chronicle parser."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "ESXi patch bundles staged by vSphere Lifecycle Manager, authorised backup agents writing to scratch, vendor-supplied VIB installation workflows, legitimate OVA/OVF deployments."
    tuning_guidance = "Add authorised backup and patching process names to %global_allowed_backup_processes. Add known-good management source hostnames to %global_allowed_mgmt_sources. Narrow the path regex if specific datastore mount points are known to receive legitimate staged files."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target paths that are meaningful on ESXi: scratch, tmp, ramdisk,
    // datastore roots, and the VMFS volume mount points.
    // Legitimate VM artefacts live under these paths too, so we exclude
    // known-good extensions in the condition via a negative path regex.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/scratch\/|\/vmfs\/volumes\/|\/store\/|\/var\/run\/)/ nocase

    // Exclude well-known VM artefact extensions that are written routinely
    // by vmkernel during normal VM operations.
    not $file.target.file.full_path = /\.(vmdk|vmx|nvram|vmsd|vmsn|vmxf|log|lck|hlog|sf|vswp|vmem|vmss|vmtm|iso|flp)$/ nocase

    // Exclude authorised backup and patching processes
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude known management sources (e.g. vCenter appliance hostnames)
    not $file.principal.hostname in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
