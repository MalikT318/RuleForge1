/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:02:20.140161+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_InvisibleUnicode_ScriptFile_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a script interpreter writing a file with a suspicious extension (potential invisible-Unicode payload drop) followed by an outbound network connection from the same host within 5 minutes. Adversaries abusing T1027.018 often reconstruct hidden payloads at runtime via eval/dynamic execution, then beacon out. This rule correlates the file-creation artefact with the subsequent network egress observable in firewall/perimeter logs, providing coverage additive to command-line inspection rules."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires EDR/Sysmon FILE_CREATION telemetry (event 11) for the first leg and firewall/perimeter NETWORK_CONNECTION or NETWORK_FLOW logs for the second leg. Both must be ingested into Chronicle and normalised to UDM."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate scripting frameworks (Ansible, Chef, Puppet) that write temporary files and then call home to update servers; developer toolchains running build scripts; software update agents. Tune by adding known-good hosts to %global_allowed_script_hosts and known-good destinations to %global_allowed_domains."
    tuning_guidance = "Add approved script-execution hosts to %global_allowed_script_hosts. Add authorised external update/CDN destinations to %global_allowed_domains. Narrow the file extension regex if specific script types dominate false positives in your environment."

  events:
    // Leg 1: EDR/Sysmon - a script interpreter creates a file with a
    // script-like or encoded-payload extension. The combination of a
    // script host parent AND an unusual output extension is the
    // behavioural indicator; neither alone is sufficient.
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /(?i)\\(powershell|pwsh|wscript|cscript|mshta|node|python|ruby|perl|cmd)\.exe$/
    $file.target.file.full_path = /(?i)\.(ps1|vbs|js|hta|wsf|bat|cmd|py|rb|tmp|dat|txt)$/
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $hostname

    // Leg 2: Firewall/perimeter - an outbound connection from the same
    // host to a non-RFC1918 destination shortly after the file drop.
    // Firewall logs do not carry process context, so we match only on
    // network-observable fields.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    // Chronological ordering: file creation must precede the network event.
    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($hostname)
    $script_interpreter = array_distinct($file.principal.process.file.full_path)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hostnames = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $file and $net
}
