/*
  MITRE Technique : T1561.002 - Disk Structure Wipe
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:10:32.380749+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_002_Disk_Structure_Wipe_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects attempts to overwrite or wipe disk structures (MBR, partition table, boot sectors) on Linux systems. Adversaries write directly to raw block devices (/dev/sd*, /dev/hd*, /dev/nvme*, /dev/vd*) using tools such as dd, shred, or similar utilities, rendering the system unbootable. This targets the OS mechanism directly: raw block device writes bypassing the filesystem."
    mitre_tactic = "Impact"
    mitre_technique = "T1561.002"
    mitre_technique_name = "Disk Wipe: Disk Structure Wipe"
    log_prerequisites = "Requires Linux EDR telemetry (e.g., Crowdstrike Falcon, SentinelOne, Elastic Endpoint) or auditd with execve syscall auditing enabled. Auditd rule: -a always,exit -F arch=b64 -S execve -k disk_wipe"
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorized disk imaging or provisioning workflows (e.g., PXE boot setup, disk cloning), backup software writing to raw devices, storage administrators using dd for legitimate disk operations, OS installation processes."
    tuning_guidance = "Add authorized imaging or provisioning parent processes to %global_allowed_backup_processes. Add authorized admin accounts performing disk operations to %global_allowed_admin_users. Consider narrowing to non-root users or unexpected parent processes if false positive volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target raw block device write tools commonly abused for MBR/partition wipe
    $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/(dd|shred|wipefs|sgdisk|fdisk|parted|sfdisk|blockdev)$/ nocase

    // Command line must reference a raw block device path (MBR/partition table lives at offset 0)
    // Match /dev/sda, /dev/hda, /dev/nvme0, /dev/vda, /dev/xvda, /dev/sdb etc.
    $proc.target.process.command_line = /\/dev\/(sd[a-z]|hd[a-z]|nvme[0-9]+n[0-9]+|vd[a-z]|xvd[a-z]|mmcblk[0-9]+)([^0-9p]|$)/ nocase

    // For dd specifically, also catch if=, of= pointing to raw device or /dev/zero/urandom as source
    // This broad regex covers: of=/dev/sda, if=/dev/zero combined with of=/dev/sda patterns
    // We rely on the block device path match above as the primary signal

    // Exclude authorized backup and imaging processes
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude authorized admin users performing legitimate disk operations
    not $proc.principal.user.userid in %global_allowed_admin_users

    // Exclude authorized admin tools (e.g., provisioning agents)
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1561.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $target_command = array_distinct($proc.target.process.command_line)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
