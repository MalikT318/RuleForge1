/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:29:38.385419+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_001_Scheduled_Transfer_Periodic_Outbound_Bursts {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects network flows to external destinations that exhibit characteristics consistent with scheduled data exfiltration: large outbound byte counts on non-standard or high-numbered ports during a single connection, originating from internal hosts. Adversaries schedule periodic transfers to blend with normal traffic patterns. A single high-volume outbound flow to an external IP on an unusual port is a strong indicator of staged data being pushed on a timer."
    mitre_tactic    = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Requires firewall or perimeter flow logs with byte counts, source/destination IP, and destination port. Chronicle UDM fields network.sent_bytes and target.port must be populated by the log source."
    platform        = "Windows"
    log_source      = "firewall"
    false_positives = "Backup agents pushing to cloud storage, software update services, video conferencing uploads, large file transfers to SaaS platforms, CDN origin pushes."
    tuning_guidance = "Raise the network.sent_bytes threshold to reduce noise from legitimate large transfers. Add known-good external destinations to %global_allowed_domains. Add approved scanner source IPs to %global_allowed_scanners. Adjust the port exclusion list to match your environment's approved high-port services."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"

    // Must originate from internal address space
    $net.principal.ip in %rfc1918_internal

    // Destination must be external (not internal)
    not $net.target.ip in %rfc1918_internal

    // Exclude approved scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Large outbound transfer - indicative of staged data being pushed
    // Threshold: 50 MB; tune upward for environments with large legitimate transfers
    $net.network.sent_bytes >= 52428800

    // Target port is non-standard: exclude well-known web/mail ports
    // Scheduled exfiltration often uses high ports or uncommon protocols
    // to avoid inspection. Exclude 80, 443, 25, 587, 465, 22, 21, 53.
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 25
    $net.target.port != 587
    $net.target.port != 465
    $net.target.port != 22
    $net.target.port != 21
    $net.target.port != 53

    // Port must be in the registered or dynamic range - avoids noise from
    // low-numbered well-known service ports not listed above
    $net.target.port >= 1024

  outcome:
    $risk_score        = max(65)
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity    = array_distinct($net.principal.ip)
    $destination_ip    = array_distinct($net.target.ip)
    $destination_port  = array_distinct($net.target.port)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
