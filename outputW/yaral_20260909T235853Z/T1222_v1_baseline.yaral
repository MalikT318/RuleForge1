/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:51:32.610424+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_Linux_File_Permission_Modification {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Medium"
    description     = "Detects chmod or chown invocations targeting sensitive Linux paths or using permissive/world-writable mode flags. Adversaries modify file and directory permissions to bypass ACLs, enable persistence, or facilitate privilege escalation."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM PROCESS_LAUNCH events capturing full command-line arguments."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Package managers (apt, yum, rpm) adjusting permissions post-install; configuration management tools (Ansible, Puppet, Chef); container build pipelines; legitimate admin scripts run by authorised service accounts."
    tuning_guidance = "Add authorised automation and deployment parent processes to %global_allowed_admin_tools. Add service/automation accounts to %global_allowed_service_accounts. Narrow the sensitive path regex if the rule is too noisy in environments with frequent legitimate permission changes under /etc or /var."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target chmod or chown (including recursive variants via flags)
    $proc.target.process.file.full_path = /\/(usr\/bin\/|bin\/|usr\/local\/bin\/)?ch(mod|own|attr)$/ nocase

    // Match any of:
    //   1. World-writable or setuid/setgid mode flags (chmod 777, 4755, 6755, a+w, o+w, +s, +t abuse)
    //   2. Sensitive filesystem paths being targeted
    (
      $proc.target.process.command_line = /\b(777|775|776|4[0-9]{3}|6[0-9]{3}|2[0-9]{3})\b/ nocase
      or
      $proc.target.process.command_line = /[ao]\+[wx]/ nocase
      or
      $proc.target.process.command_line = /\+s\b/ nocase
      or
      $proc.target.process.command_line = /\/(etc|bin|sbin|usr\/bin|usr\/sbin|usr\/local\/bin|lib|lib64|boot|proc|sys|dev|run|var\/log|var\/cron|cron\.(d|daily|weekly|monthly|hourly)|systemd\/(system|user)|init\.d|rc[0-9S]\.d|security|pam\.d|sudoers|ssh|crontabs)/ nocase
    )

    // Exclude known-good administrative tooling and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($proc.principal.hostname)
    $actor_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $target_binary = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
