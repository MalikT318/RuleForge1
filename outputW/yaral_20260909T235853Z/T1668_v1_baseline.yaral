/*
  MITRE Technique : T1668 - Exclusive Control
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:27:46.984744+00:00
  Reference       : https://attack.mitre.org/techniques/T1668
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1668_001_Exclusive_Control_Competitor_Eviction {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects behaviors consistent with an adversary attempting to maintain exclusive control of a compromised Linux system by evicting competing threat actors or closing access vectors. Signals include: bulk removal of cron jobs, deletion of SSH authorized_keys, disabling of services via systemctl, stripping of SUID bits, or mass killing of processes - all performed by non-root interactive sessions or unexpected parent processes. These actions collectively indicate an adversary 'closing the door' after initial compromise."
    mitre_tactic = "Persistence"
    mitre_technique = "T1668"
    mitre_technique_name = "Exclusive Control"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with command-line arguments. Auditd execve syscall logging or EDR PROCESS_LAUNCH events are required."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "System administrators performing legitimate hardening, patch management scripts removing malware, configuration management tools (Ansible, Puppet, Chef) enforcing baseline, security teams running incident response playbooks."
    tuning_guidance = "Add known configuration management and IR tooling parent processes to %global_allowed_admin_tools. Add authorized service accounts to %global_allowed_service_accounts. Scope by principal.user.userid if specific admin accounts are known-good."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Detect the cluster of exclusive-control behaviors via command-line patterns.
    // Each branch targets a distinct eviction/lockout mechanism on Linux.
    (
      // 1. Removing SSH authorized_keys to lock out other actors or defenders
      (
        $proc.target.process.command_line = /authorized_keys/ nocase and
        (
          $proc.target.process.command_line = /rm\s/ nocase or
          $proc.target.process.command_line = /truncate/ nocase or
          $proc.target.process.command_line = />\s*\// nocase
        )
      )
      or
      // 2. Disabling or stopping services to close vulnerable entry points
      (
        $proc.target.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin)\/systemctl$/ nocase and
        $proc.target.process.command_line = /(disable|stop|mask)/ nocase
      )
      or
      // 3. Removing or overwriting cron jobs to evict persistence of competing actors
      (
        $proc.target.process.command_line = /crontab/ nocase and
        $proc.target.process.command_line = /(\-r|\-\-remove|\/dev\/null)/ nocase
      )
      or
      // 4. Stripping SUID/SGID bits - removing privilege escalation paths used by others
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/chmod$/ nocase and
        $proc.target.process.command_line = /(\-s|[0-9]{4}|u\-s|g\-s)/ nocase and
        $proc.target.process.command_line = /\/(bin|sbin|usr)/ nocase
      )
      or
      // 5. Mass process termination - killing competing malware or miner processes
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/kill(all|5)?$/ nocase and
        $proc.target.process.command_line = /(\-9|\-SIGKILL|\-KILL)/ nocase
      )
      or
      // 6. Removing files from common malware staging directories used by other actors
      (
        $proc.target.process.file.full_path = /\/(bin|usr\/bin)\/rm$/ nocase and
        $proc.target.process.command_line = /(\-rf?|\-fr?)\s+\/(tmp|dev\/shm|var\/tmp|run)\/[^\s]+/ nocase
      )
      or
      // 7. Locking or expiring user accounts to prevent competing actor re-entry
      (
        $proc.target.process.file.full_path = /\/(usr\/sbin|sbin)\/(usermod|passwd|chage)$/ nocase and
        $proc.target.process.command_line = /(\-L|\-\-lock|\-e\s+1970|\-\-expiredate\s+1970|\-\-expiredate\s+0)/ nocase
      )
      or
      // 8. Flushing iptables/nftables rules then adding restrictive rules - closing network access
      (
        $proc.target.process.file.full_path = /\/(sbin|usr\/sbin)\/(iptables|nftables|nft|ip6tables)$/ nocase and
        $proc.target.process.command_line = /(\-F|\-\-flush|flush)/ nocase
      )
    )

    // Exclude known-good administrative tooling and service accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1668")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_observed = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
