/*
  MITRE Technique : T1137.005 - Outlook Rules
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:42:00.452642+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_005_Outlook_Malicious_Inbox_Rule_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of Outlook inbox rules that may indicate persistence via T1137.005. Malicious rules commonly redirect, delete, or forward messages based on attacker-controlled keywords, or invoke server-side actions. Flags rule creation events where the rule targets message body/subject content or performs forwarding/redirect/delete actions, which are hallmarks of adversary-planted rules designed to trigger on crafted emails."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.005"
    mitre_technique_name = "Office Application Startup: Outlook Rules"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log with Exchange mailbox auditing enabled. Operations: New-InboxRule, Set-InboxRule, UpdateInboxRules must be captured and normalized into Chronicle UDM SETTING_MODIFICATION events."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate users creating inbox rules for email organization, IT administrators deploying shared mailbox rules, mail flow automation tools, and approved service accounts managing mailbox configurations."
    tuning_guidance = "Add known service and automation accounts to %global_allowed_service_accounts. Add approved administrative users who routinely manage mailbox rules to %global_allowed_admin_users. Consider narrowing scope to rules that combine forwarding/redirect actions with keyword-based triggers, which is the highest-fidelity signal."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"

    // Match inbox rule creation or modification operations normalized from
    // Exchange UAL operations: New-InboxRule, Set-InboxRule, UpdateInboxRules
    $setting.metadata.product_event_type = /(?i)(new-inboxrule|set-inboxrule|updateinboxrules)/

    // The actor performing the rule change must be a real user principal
    $setting.principal.user.userid != ""

    // Detect rules with high-risk actions: forwarding, redirecting, or deleting
    // messages - core mechanisms used in T1137.005 persistence chains.
    // These are normalized into the target resource name or description fields.
    (
      $setting.target.resource.name = /(?i)(forwardto|redirectto|deletemessage|movetofolderid|forwardasattachmentto)/ or
      $setting.security_result.description = /(?i)(forwardto|redirectto|deletemessage|forwardasattachmentto)/
    )

    // Exclude known-good service and automation accounts
    not $setting.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good administrative users who routinely manage mailbox rules
    not $setting.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = "T1137.005"
    $primary_entity = $setting.principal.user.userid

  condition:
    $setting
}
