/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:01:23.616100+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_OpenThenRemoteThread {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a suspicious process opening a handle to a remote process (PROCESS_OPEN) followed by a new thread creation event in that same target process within 5 minutes on the same host. This two-stage pattern is characteristic of PE injection via VirtualAllocEx/WriteProcessMemory/CreateRemoteThread without relying on command-line strings, providing additive coverage beyond existing PROCESS_LAUNCH rules."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR or Sysmon telemetry that generates PROCESS_OPEN events (Sysmon Event ID 10) and PROCESS_INJECTION or equivalent remote-thread events. Both events must be normalised into UDM by Chronicle ingestion."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (Visual Studio, WinDbg), security tools (EDR agents, AV), JIT compilers, and some RMM agents that inject into processes for monitoring. Backup and DLP agents may also open cross-process handles."
    tuning_guidance = "Add known-good injecting processes (EDR agents, debuggers, JIT hosts) to %global_allowed_security_tools or %global_allowed_admin_tools. Add authorised service accounts to %global_allowed_service_accounts. Narrow the rule further by excluding well-known parent/child pairs such as antivirus engines opening browser processes."

  events:
    // Event 1: A non-system process opens a handle to a remote process.
    // PROCESS_OPEN is generated by Sysmon Event ID 10 / EDR cross-process access telemetry.
    $open.metadata.event_type = "PROCESS_OPEN"
    // Exclude the process opening itself (self-injection is a different variant).
    $open.principal.process.pid != $open.target.process.pid
    // Exclude known-good security and admin tooling from the opening side.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    // Exclude system-level openers (pid 4 = System, pid 0 = Idle).
    $open.principal.process.pid > 4
    // Capture the hostname and the target process pid for the join.
    $open.principal.hostname = $hostname
    $open.target.process.pid = $target_pid

    // Event 2: A remote-thread / injection event fires in the same target process
    // on the same host shortly after the handle-open.
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $hostname
    $inj.target.process.pid = $target_pid
    // Exclude injection by authorised security tooling on the injecting side.
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.user.userid in %global_allowed_service_accounts

    // Enforce chronological ordering: handle open must precede the injection.
    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $target_pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $target_process = array_distinct($inj.target.process.file.full_path)
    $injecting_user = array_distinct($inj.principal.user.userid)
    $open_event_count = count($open.metadata.event_timestamp.seconds)

  condition:
    $open and $inj
}
