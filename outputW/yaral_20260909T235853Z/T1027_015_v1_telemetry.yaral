/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:59:45.225031+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Compressed_Payload_Written_To_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects compressed or encoded binary blobs written to registry value data, a technique used to store obfuscated payloads for fileless execution. Adversaries compress shellcode or PE files and persist them in the registry to evade file-based scanning. This rule fires on the resulting registry state change rather than the process command line, providing coverage that is orthogonal to process-creation detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscate Infrastructure: Compression"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 13) telemetry that captures registry value data writes, normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_value_data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software that caches compressed data in the registry (e.g., some browser extensions, update agents, or DRM licensing components). Backup or deployment agents writing encoded configuration blobs."
    tuning_guidance = "Add known-good parent process paths to %global_allowed_admin_tools or %global_allowed_backup_processes. Narrow the registry key path regex to exclude well-known vendor subtrees if false-positive volume is high. Consider raising the minimum data length threshold if noise persists."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"

    // Target suspicious registry hive locations commonly abused for fileless storage
    // Run keys, policy extensions, COM hijack locations, and arbitrary user-writable paths
    $reg.target.registry.registry_key = /(?i)\\(CurrentVersion\\Run|CurrentVersion\\RunOnce|CurrentVersion\\RunServices|Policies\\|Classes\\CLSID\\|Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\|Environment|SessionManager\\|ControlSet[0-9]+\\Services\\)/

    // Registry value data that begins with known compressed or encoded magic bytes
    // represented as base64 or hex strings written by scripts, OR raw binary blobs
    // Detect base64-encoded ZIP (UklGG / 7z (N3q), gzip (H4sI), PK header encoded)
    // or hex-encoded equivalents commonly written by PowerShell loaders
    $reg.target.registry.registry_value_data = /(?i)^(H4sI|UEsDB|N3q8rycc|TVqQ|AAAB|7z|PK|MZ|0x4d5a|4d5a|504b|1f8b|377abcaf)/

    // Exclude writes by known-good administrative and security tooling
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude known-good service accounts performing automated configuration
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_registry_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $writing_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
