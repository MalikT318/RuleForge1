/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:15:45.586072+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_Network_Boundary_Bridging_Policy_Bypass {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network flows traversing a perimeter firewall on ports or protocols that are typically blocked by policy. An adversary who has compromised a boundary device may reconfigure it to pass prohibited traffic across trust boundaries, enabling C2 or data exfiltration. This rule flags connections where a non-RFC-1918 source reaches an internal destination on high-risk or non-standard ports, or where internal hosts initiate outbound flows on ports associated with tunnelling and boundary evasion."
    mitre_tactic    = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Requires firewall or perimeter device flow/session logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW. Fields needed: principal.ip, target.ip, target.port, network.ip_protocol, network.sent_bytes."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorised VPN concentrators, approved split-tunnel configurations, sanctioned penetration testing, legitimate high-port application traffic. Tune by adding approved scanner IPs to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources."
    tuning_guidance = "Add known-good external management IPs to %global_allowed_mgmt_sources. Add approved remote-access tooling sources to %global_allowed_remote_mgmt. Raise the sent_bytes threshold if large authorised transfers trigger the rule. Narrow target.port ranges to those actually prohibited in your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Source is external (not RFC-1918 internal space)
    not $net.principal.ip in %rfc1918_internal

    // Destination is internal (RFC-1918) - traffic crossing the boundary inbound
    $net.target.ip in %rfc1918_internal

    // Exclude authorised scanners and management sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Target ports associated with tunnelling, covert channels, or
    // protocols that perimeter policy typically prohibits:
    //   22   SSH (inbound from untrusted)
    //   23   Telnet
    //   3389 RDP
    //   5900 VNC
    //   4444 Common reverse-shell default
    //   6667 IRC / legacy C2
    //   8080 Alternate HTTP proxy
    //   1080 SOCKS proxy
    //   1194 OpenVPN
    //   500  IKE/IPsec (unexpected initiator)
    //   4500 NAT-T IPsec
    //   1723 PPTP
    //   1701 L2TP
    (
      $net.target.port = 22   or
      $net.target.port = 23   or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 4444 or
      $net.target.port = 6667 or
      $net.target.port = 8080 or
      $net.target.port = 1080 or
      $net.target.port = 1194 or
      $net.target.port = 500  or
      $net.target.port = 4500 or
      $net.target.port = 1723 or
      $net.target.port = 1701
    )

    // Require meaningful data transfer to reduce noise from port scans
    $net.network.sent_bytes > 1024

  outcome:
    $risk_score        = max(75)
    $mitre_technique_id = "T1599"
    $primary_entity    = $net.target.ip

  condition:
    $net
}
