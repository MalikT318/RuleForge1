/*
  MITRE Technique : T1496 - Resource Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:55:12.704819+00:00
  Reference       : https://attack.mitre.org/techniques/T1496
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_Container_Cryptominer_Process_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of cryptocurrency mining processes within containers based on command-line patterns and resource-intensive flags commonly used by cryptominers."
    mitre_tactic = "Impact"
    mitre_technique = "T1496"
    mitre_technique_name = "Resource Hijacking"
    log_prerequisites = "Requires container runtime telemetry (containerd, CRI-O, Docker) or Kubernetes audit logs with process execution events."
    platform = "Linux"
    log_source = "container"
    false_positives = "Legitimate distributed computing workloads, scientific computing containers, authorized blockchain node operations, performance testing tools."
    tuning_guidance = "Add approved compute-intensive container images to %global_allowed_service_accounts or exclude known namespace/pod patterns via reference list."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /--donate-level\s*=\s*0/ nocase or
      $proc.target.process.command_line = /-o\s+[a-z0-9]+:\/\/[^\s]+:[0-9]{4,5}/ nocase or
      $proc.target.process.command_line = /--algo\s*=\s*(rx\/0|cn\/[a-z0-9]+|kawpow|ethash|randomx)/ nocase or
      $proc.target.process.command_line = /--coin\s*=\s*(xmr|monero|eth|ethereum|rvn|ergo)/ nocase or
      $proc.target.process.command_line = /-a\s+(cryptonight|randomx|ethash|kawpow|autolykos2)/ nocase or
      $proc.target.process.command_line = /--cuda|--opencl|--cpu-priority\s*=\s*[0-5]/ nocase or
      $proc.target.process.command_line = /stratum\+tcp:\/\/|stratum\+ssl:\/\// nocase or
      $proc.target.process.command_line = /--threads\s*=\s*[0-9]+.*--url\s*=/ nocase or
      $proc.target.process.command_line = /--user\s*=\s*[a-zA-Z0-9]{95,}/ nocase or
      $proc.target.process.command_line = /--pool\s+[a-z0-9\-]+\.(moneroocean|hashvault|supportxmr|nanopool|f2pool)\./ nocase or
      $proc.target.process.file.full_path = /\/(xmrig|ethminer|t-rex|nbminer|phoenixminer|lolminer|gminer|nanominer|srbminer|wildrig|teamredminer|ccminer)$/ nocase or
      $proc.target.process.file.full_path = /\/tmp\/\.(xmr|miner|pool|stratum|kdevtmpfsi|[a-z]{3,8}miner)/ nocase or
      $proc.target.process.file.full_path = /\/dev\/shm\/[a-z0-9]{6,12}$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1496")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
