/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:08:26.135024+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_VDSO_Hijack_Shared_Object_Drop {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file creation or modification of shared object files (.so) in world-writable or suspicious staging directories commonly abused during VDSO hijacking. An adversary performing VDSO hijacking must load a malicious shared object into the target process address space; this requires the .so payload to be written to disk or a memory-backed filesystem before injection. Detecting the artifact write provides coverage orthogonal to process-launch command-line rules."
    mitre_tactic    = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to Chronicle UDM FILE_CREATION or FILE_MODIFICATION events with target.file.full_path populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Package managers (apt, yum, dnf, rpm) installing or upgrading legitimate libraries; build systems (cmake, make, gcc) compiling shared libraries into /tmp or /var/tmp during CI/CD pipelines; container image build steps; legitimate JIT runtimes (JVM, .NET) writing native stubs to /tmp or /dev/shm."
    tuning_guidance = "Add known build-system or package-manager parent process paths to %global_allowed_admin_tools. Scope the path regex to exclude your CI/CD working directories if they reside under /tmp. If false-positive volume is high on build hosts, consider restricting the rule to interactive user sessions by filtering on principal.user.userid not matching service accounts in %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Shared object payload written to a world-writable or memory-backed
    // staging location. Legitimate library installs target /lib, /usr/lib,
    // /usr/local/lib etc. and are handled by package managers - not these paths.
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/shm\/|\/proc\/[0-9]+\/fd\/)/ nocase
    $file.target.file.full_path = /\.so(\.[0-9]+)*$/ nocase

    // Exclude known-good administrative and build tooling parent processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known service/automation accounts performing legitimate library staging
    not $file.principal.user.userid in %global_allowed_service_accounts

    // Exclude backup agents that may stage files in temp locations
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_so_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
