/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:08:33.927077+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Ccache_File_Access_Or_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious access to or copying of Kerberos credential cache (ccache) files on Linux. Adversaries steal ccache files from /tmp (krb5cc_* or krb5.ccache) to perform Pass-the-Ticket attacks without knowing the user's password. This rule fires when a process that is not a known Kerberos utility reads or copies ccache files, or when ccache files are created in unusual locations outside /tmp."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with file-open/read events and process context. Auditd rules should include -a always,exit -F arch=b64 -S open,openat,read -F dir=/tmp -F name_regex=krb5cc_.* and equivalent for FILE_CREATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate Kerberos utilities (kinit, klist, kvno, ksu, sssd, krb5-user daemons), PAM modules performing ticket refresh, backup agents reading /tmp, and monitoring agents inspecting credential state."
    tuning_guidance = "Add legitimate Kerberos-aware process paths to %global_allowed_security_tools or %global_allowed_backup_processes. Scope exclusions to the specific process full path rather than process name to avoid bypasses. If sssd or realmd generates noise, add their binary paths to %global_allowed_service_accounts exclusion logic."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target must be a ccache file in /tmp or a non-standard location
    // krb5cc_<UID> is the canonical Linux ccache naming convention
    $file.target.file.full_path = /\/tmp\/krb5cc_[0-9]+/ nocase
    or $file.target.file.full_path = /\/tmp\/krb5\.ccache/ nocase
    or $file.target.file.full_path = /\/tmp\/krb5cc_[^\/]+/ nocase
    or $file.target.file.full_path = /\/var\/tmp\/krb5cc_[^\/]+/ nocase
    or $file.target.file.full_path = /\/dev\/shm\/krb5cc_[^\/]+/ nocase

    // Exclude legitimate Kerberos tooling that routinely reads ccache files
    not $file.principal.process.file.full_path = /\/(bin|sbin|usr\/bin|usr\/sbin|usr\/lib|usr\/libexec)\/(kinit|klist|kdestroy|kvno|ksu|kswitch|kgetcred|sssd|krb5-child|gss-proxy|kadmind|kpropd|krb5kdc)$/
    not $file.principal.process.file.full_path = /\/usr\/lib\/jvm\// nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $ccache_file_accessed = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
