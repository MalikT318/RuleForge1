/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:16:55.331690+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoHK_AutoIT_Script_Then_Network_Beacon {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects an AutoHotKey or AutoIT interpreter spawning a child process that subsequently makes an outbound network connection to a non-RFC1918 address. This pattern is consistent with AHK/AutoIT scripts used as loaders or droppers that execute a secondary payload which then beacons out. Variant 2 of 2 for T1059.010 - additive coverage beyond command-line process-launch detection."
    mitre_tactic         = "Execution"
    mitre_technique      = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites    = "Requires EDR or Sysmon process-launch telemetry (parent/child lineage) and network-connection telemetry normalised into UDM PROCESS_LAUNCH and NETWORK_CONNECTION event types."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Legitimate AutoIT-packaged installers or AutoHotKey productivity scripts that fetch update manifests or telemetry endpoints. RMM agents bundled with AutoIT wrappers. Software deployment tooling."
    tuning_guidance      = "Add known-good AutoIT/AHK wrapper parent processes to %global_allowed_admin_tools. Add approved external destinations to %global_allowed_domains. Narrow the child-process filter if specific LOLBins are not observed in your environment."

  events:
    // Event 1: AutoHotKey or AutoIT interpreter launches a child process
    // that is itself a scripting host, shell, or downloader - indicating
    // the script is executing a secondary stage rather than benign automation.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(?i)\\(AutoHotkey|AutoHotkeyU32|AutoHotkeyU64|AutoHotkeyA32|AutoIt3|AutoIt3_x64|Au3Check|Aut2Exe)\.exe$/
    $proc.target.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|wget|wmic|msiexec|explorer)\.exe$/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Event 2: The child process (or a process on the same host sharing
    // the interpreter lineage) makes an outbound connection to a public IP.
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|wget|wmic|msiexec|explorer)\.exe$/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    // Chronological ordering: process launch must precede network connection
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $interpreter_path  = array_distinct($proc.principal.process.file.full_path)
    $child_process     = array_distinct($proc.target.process.file.full_path)
    $destination_ips   = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $proc and $net
}
