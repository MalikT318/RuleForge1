/*
  MITRE Technique : T1619 - Cloud Storage Object Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:23:21.592007+00:00
  Reference       : https://attack.mitre.org/techniques/T1619
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1619_001_Cloud_Storage_Object_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of objects within cloud storage buckets or blob containers via cloud provider audit APIs (e.g., ListObjectsV2, List Blobs, ListObjects). Adversaries perform this discovery to identify valuable data for exfiltration or follow-on actions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1619"
    mitre_technique_name = "Cloud Storage Object Discovery"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs) normalised into Chronicle UDM. Storage data-plane or management-plane logging must be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup agents, data pipeline services, ETL jobs, authorised security scanners, and cloud-native monitoring tools routinely enumerate storage objects. Service accounts performing scheduled data processing will also trigger this rule."
    tuning_guidance = "Add known-good service account identifiers to %global_allowed_service_accounts. Add approved scanner identities to %global_allowed_scanners. Add approved backup process identities to %global_allowed_backup_processes. Narrow the match by requiring a minimum object count threshold if the log source supports it, or promote to a threshold rule if single-event noise is high."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Match cloud storage list/enumeration API operations across AWS, Azure, and GCP
    // AWS: ListObjectsV2, ListObjects, ListObjectVersions, ListMultipartUploads
    // Azure: List Blobs, List Containers
    // GCP: storage.objects.list, storage.buckets.list
    $cloud.target.resource.name = /(?i)(listobject|list_object|listblob|list_blob|storage\.objects\.list|storage\.buckets\.list|listmultipart|listbucket)/

    // Exclude known-good service and automation accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    // Exclude authorised backup processes
    not $cloud.principal.user.userid in %global_allowed_backup_processes

    // Exclude authorised security scanners
    not $cloud.principal.user.userid in %global_allowed_scanners

    // Exclude approved cloud principals (e.g., CI/CD, monitoring agents)
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1619")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
