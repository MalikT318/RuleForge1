/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:52:11.983740+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_Linux_Chmod_Chown_Sensitive_Paths {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects chmod or chown invocations targeting sensitive Linux paths (shell configs, cron, systemd units, SSH keys, sudoers, /etc, /var/spool/cron, /dev/shm, /tmp). Adversaries use these commands to modify file permissions or ownership to evade ACLs, establish persistence, or enable lateral movement."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events, including full command-line arguments."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Package managers (apt, yum, rpm, dpkg) adjusting file ownership post-install; configuration management tools (Ansible, Puppet, Chef, Salt); container build processes; legitimate admin scripts run by root during provisioning."
    tuning_guidance = "Add trusted parent processes (e.g. package managers, CM agents) to %global_allowed_admin_tools. Add authorised service accounts performing routine permission changes to %global_allowed_service_accounts. Narrow the sensitive path regex if /tmp or /var/tmp generate excessive noise from known-good build pipelines."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match chmod or chown binaries (absolute path or bare name after normalisation)
    $proc.target.process.file.full_path = /\/(usr\/bin\/|usr\/sbin\/|bin\/|sbin\/)?(chmod|chown)$/ nocase

    // Command line must reference a sensitive path category:
    //   /etc/*, shell rc files, cron dirs, systemd units, SSH keys/config,
    //   sudoers, /dev/shm, /tmp, /var/tmp, /var/spool/cron, /proc/
    $proc.target.process.command_line = /(\s|'|")(\/etc\/|\/var\/spool\/cron|\/var\/cron|\/dev\/shm|\/tmp\/|\/var\/tmp\/|\/proc\/|~\/\.ssh\/|\/root\/\.ssh\/|\/home\/[^\/]+\/\.ssh\/|\.bashrc|\.bash_profile|\.profile|\.zshrc|\.zprofile|systemd\/system\/|\/lib\/systemd\/|\/etc\/sudoers|\/etc\/cron\.|\/etc\/init\.d\/)/ nocase

    // Exclude known-good administrative tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised service accounts performing routine operations
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $affected_user     = array_distinct($proc.principal.user.userid)
    $command_executed  = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
