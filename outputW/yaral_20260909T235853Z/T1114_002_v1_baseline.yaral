/*
  MITRE Technique : T1114.002 - Remote Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:35:24.836390+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_002_Remote_Email_Collection_Mailbox_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects anomalous mailbox access patterns indicative of remote email collection. Fires when a principal accesses another user's mailbox resources (delegate or impersonation access) from an unexpected context, or when bulk mailbox folder enumeration is observed via unified audit logs. This targets the core T1114.002 behaviour of an adversary using valid credentials or tokens to harvest email from Exchange Online or similar cloud mail services."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.002"
    mitre_technique_name = "Email Collection: Remote Email Collection"
    log_prerequisites = "Requires Microsoft 365 unified audit logs ingested into Chronicle UDM. Mailbox access, delegate access, and impersonation events must be enabled in the M365 audit configuration (MailItemsAccessed, FolderBind, SearchQueryInitiated)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate helpdesk or compliance officers with delegated mailbox access, e-discovery tooling, backup services, and authorised service accounts performing mailbox operations."
    tuning_guidance = "Add known delegated-access service accounts to %global_allowed_service_accounts. Add approved compliance or e-discovery principals to %global_allowed_admin_users. Narrow the target.resource.name regex to exclude shared mailboxes that are legitimately accessed by multiple users."

  events:
    $auth.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource must look like a mailbox folder path or mail item
    // Matches paths such as /mail/, /inbox/, /messages/, /folders/, /items/
    $auth.target.resource.name = /(?i)(\/mail\/|\/inbox|\/sentitems|\/deleteditems|\/messages|\/folders|\/items\/|mailboxes\/)/

    // The accessing principal must not be the mailbox owner -
    // delegate, impersonation, or service-principal access patterns
    // are captured by checking that the principal user differs from the target user
    $auth.principal.user.userid != $auth.target.user.userid

    // Exclude empty or system-generated principal identifiers
    $auth.principal.user.userid != ""
    $auth.target.user.userid != ""

    // Exclude known authorised service and admin accounts
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Exclude approved cloud service principals (e.g., backup, compliance tools)
    not $auth.principal.application in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1114.002")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $accessed_mailbox = array_distinct($auth.target.user.userid)
    $accessed_resource = array_distinct($auth.target.resource.name)
    $accessing_application = array_distinct($auth.principal.application)

  condition:
    $auth
}
