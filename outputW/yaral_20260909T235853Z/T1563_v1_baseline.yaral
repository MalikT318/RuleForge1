/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:10:49.365799+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Remote_Session_Hijack_Suspicious_SSH_Lateral {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable indicators of SSH session hijacking or lateral movement via remote service session takeover. Looks for high-frequency or anomalous SSH connections from internal hosts to internal hosts on standard remote-service ports (22, 23, 3389), which may indicate an adversary commandeering existing sessions to move laterally. Excludes known management sources and internal scanners."
    mitre_tactic    = "Lateral Movement"
    mitre_technique = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites = "Requires firewall or network perimeter flow logs with source/destination IP, port, and byte counts normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Authorized jump-host or bastion activity, automated configuration management (Ansible, Salt, Puppet), scheduled backup jobs using SSH, legitimate RMM tooling traversing the perimeter."
    tuning_guidance = "Add approved bastion/jump-host source addresses to %global_allowed_mgmt_sources. Add authorized scanner IPs to %global_allowed_scanners. Raise the sent_bytes threshold if large legitimate file transfers trigger the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target remote-service ports commonly abused for session hijacking:
    // 22 = SSH, 23 = Telnet, 3389 = RDP (may appear in mixed Linux/Windows environments)
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 3389
    )

    // Source must be an internal address (RFC-1918 space) - lateral movement
    // originates from within the network, not from the internet
    $net.principal.ip in %rfc1918_internal

    // Destination must also be internal - this is lateral movement, not exfil
    $net.target.ip in %rfc1918_internal

    // Exclude approved management sources (bastions, jump hosts, RMM)
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude authorised vulnerability scanners
    not $net.principal.ip in %global_allowed_scanners

    // Require a non-trivial data transfer to filter out keepalives and
    // pure SYN/RST probe traffic; session hijacking involves real interaction
    $net.network.sent_bytes > 1024

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity    = array_distinct($net.principal.ip)
    $target_host       = array_distinct($net.target.ip)
    $target_port       = array_distinct($net.target.port)
    $bytes_sent        = max($net.network.sent_bytes)

  condition:
    $net
}
