/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:37:27.386608+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_002_Firewall_LargeOutboundThenInboundFile_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with ingress tool transfer observed at the network perimeter: an internal host first makes an outbound connection to an external destination on a non-standard or file-transfer-associated port, followed within 5 minutes by a significant inbound data transfer from the same external destination. This network-observable sequence is characteristic of a C2 channel pulling down tooling or staged payloads without relying on process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to UDM NETWORK_FLOW or NETWORK_CONNECTION with bytes_in/bytes_out populated. Both legs of the connection must be logged."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software update services pulling large patches, backup agents syncing to cloud storage, authorised file-transfer services (SFTP/FTPS), vulnerability scanners, CDN content delivery. Tune using %global_allowed_domains, %global_allowed_scanners, and %rfc1918_internal."
    tuning_guidance = "Add known-good external update and CDN destinations to %global_allowed_domains. Add approved scanner source IPs to %global_allowed_scanners. Raise the network.received_bytes threshold if large legitimate transfers are common in the environment. Narrow the port list if only specific transfer protocols are relevant."

  events:
    // Leg 1: Internal host initiates outbound connection to external IP
    // on a port associated with file transfer or non-standard channels.
    $out.metadata.event_type = "NETWORK_CONNECTION"
    not $out.target.ip in %rfc1918_internal
    not $out.principal.ip in %rfc1918_internal
    $out.target.port >= 20
    $out.target.port <= 65535
    // Exclude common web browsing ports to reduce noise; focus on
    // non-standard and file-transfer-associated ports.
    not $out.target.port = 80
    not $out.target.port = 443
    not $out.target.ip in %global_allowed_domains
    not $out.principal.ip in %global_allowed_scanners
    $out.target.ip = $ext_ip
    $out.principal.ip = $src_ip

    // Leg 2: Significant inbound data transfer from the same external IP
    // back to the same internal host within the time window.
    $in.metadata.event_type = "NETWORK_FLOW"
    $in.principal.ip = $ext_ip
    $in.target.ip = $src_ip
    not $in.principal.ip in %rfc1918_internal
    not $in.principal.ip in %global_allowed_domains
    not $in.principal.ip in %global_allowed_scanners
    // Threshold: inbound transfer must be meaningful in size (>= 100 KB)
    // to distinguish tool staging from small keepalive or beacon traffic.
    $in.network.received_bytes >= 102400

    // Chronological ordering: outbound connection precedes inbound transfer.
    $out.metadata.event_timestamp.seconds <= $in.metadata.event_timestamp.seconds

  match:
    $src_ip, $ext_ip over 5m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($src_ip)
    $external_destination = array_distinct($ext_ip)
    $destination_ports = array_distinct($out.target.port)
    $max_bytes_received = max($in.network.received_bytes)
    $connection_count = count($out.metadata.event_timestamp.seconds)

  condition:
    $out and $in
}
