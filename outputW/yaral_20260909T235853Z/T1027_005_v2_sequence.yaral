/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:52:10.018605+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_AV_Quarantine_Then_Modified_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with indicator removal from tools: an AV/EDR quarantine or threat-remediation registry write (indicating a file was flagged) followed shortly by a new file creation on the same host, suggesting the adversary modified and re-dropped the tool to evade the signature that triggered the quarantine."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires Windows EDR or Sysmon telemetry normalised to UDM. The REGISTRY_MODIFICATION event must capture AV/EDR quarantine registry writes (e.g., Windows Defender ThreatHistory or quarantine state keys). FILE_CREATION events must be captured for user-writable directories."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that write to security-adjacent registry keys and then drop files; AV remediation workflows that restore cleaned files; backup agents restoring files after quarantine."
    tuning_guidance = "Add known-good backup and security orchestration processes to %global_allowed_backup_processes. Add approved security tooling to %global_allowed_security_tools. Narrow the file path regex to high-risk directories (Temp, AppData, Downloads) if false-positive volume is high."

  events:
    // Event 1: AV/EDR quarantine or threat-state registry write on the host
    // Windows Defender writes quarantine and threat history under these key paths.
    // Other EDRs write similar remediation state keys under their own vendor paths.
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Windows Defender|WinDefend|MpEngine|MpThreat|Quarantine|ThreatHistory|ThreatTracking|SecurityHealth|SecurityCenter|AntiVirusProduct)/
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    $reg.principal.hostname = $hostname

    // Event 2: A new executable or script file is created on the same host
    // shortly after the quarantine registry write, suggesting a re-drop attempt.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData|Downloads|Desktop|Documents)|\\Windows\\Temp|\\ProgramData|\\Temp)\\[^\\]+\.(exe|dll|ps1|vbs|js|bat|cmd|hta|scr|pif|com)$/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    // Chronological ordering: quarantine write must precede the file re-drop
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($hostname)
    $quarantine_registry_keys = array_distinct($reg.target.registry.registry_key)
    $dropped_file_paths = array_distinct($file.target.file.full_path)
    $dropping_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $reg and $file
}
