/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:50:35.709341+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_SyncAppvPublishingServer_PowerShell_Proxy {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects abuse of SyncAppvPublishingServer.vbs to proxy PowerShell command execution, bypassing execution policy and defensive controls. Adversaries invoke wscript.exe with the script and embed PowerShell commands in the argument string using the 'n;' separator pattern."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture normalised to UDM PROCESS_LAUNCH."
    platform        = "Windows"
    log_source      = "windows_endpoint"
    false_positives = "Legitimate App-V publishing synchronisation triggered by SCCM, Intune, or App-V infrastructure. Genuine invocations will not contain embedded PowerShell commands after the 'n;' separator."
    tuning_guidance = "Scope exclusions to known App-V management hosts via %global_allowed_admin_tools or %global_allowed_script_hosts. Inspect the full command line for embedded PowerShell payloads before suppressing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // wscript.exe is the canonical host for this VBS script
    $proc.target.process.file.full_path = /\\wscript\.exe$/ nocase

    // The script must be SyncAppvPublishingServer.vbs, typically from System32
    $proc.target.process.command_line = /SyncAppvPublishingServer\.vbs/ nocase

    // The malicious pattern: PowerShell commands embedded after the 'n;' separator
    // Matches: "n; <any PowerShell>", "n;{...}", "n; Invoke-", etc.
    $proc.target.process.command_line = /n\s*;/ nocase

    // At least one PowerShell-indicative keyword must follow to reduce noise
    // from legitimate App-V sync invocations that also use wscript + this script
    $proc.target.process.command_line = /(?i)(invoke-|iex|downloadstring|webclient|net\.webclient|bypass|encodedcommand|-enc\s|frombase64|reflection\.assembly|start-process|hidden|noprofile|scriptblock|powershell)/ nocase

    // Exclude known App-V management and deployment tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $command_line      = array_distinct($proc.target.process.command_line)
    $parent_process    = array_distinct($proc.principal.process.file.full_path)
    $username          = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
