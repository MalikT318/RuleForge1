/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:41:31.362256+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_EventLog_File_Deletion_After_Privilege_Escalation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage defense impairment pattern: a process first opens or modifies the Windows Event Log service registry configuration, then a file deletion or modification event targets the .evtx log store under C:\\Windows\\System32\\winevt\\logs\\. This correlation catches adversaries who tamper with the Event Log service and then directly delete or overwrite log files, bypassing command-line-only detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing REGISTRY_MODIFICATION events for HKLM\\SYSTEM\\CurrentControlSet\\Services\\EventLog and FILE_DELETION or FILE_MODIFICATION events for C:\\Windows\\System32\\winevt\\logs\\. Both event types must be normalised into Chronicle UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Log archival and backup software rotating .evtx files; Windows Update or OS maintenance touching the EventLog service registry key; authorised SIEM forwarder agents managing log files."
    tuning_guidance = "Add backup and archival process paths to %global_allowed_backup_processes. Add authorised log-management service accounts to %global_allowed_service_accounts. Narrow the registry key match if only specific channels (Security, System, Application) are of interest."

  events:
    // Stage 1: Registry modification targeting the Windows Event Log service
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\CurrentControlSet\\Services\\EventLog/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Stage 2: File deletion or modification of .evtx files in the winevt log store
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(?i)\\Windows\\System32\\winevt\\[Ll]ogs\\.*\.evtx$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Enforce chronological ordering: registry tamper precedes file operation
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.005")
    $primary_entity = array_distinct($hostname)
    $reg_keys_modified = array_distinct($reg.target.registry.registry_key)
    $evtx_files_touched = array_distinct($file.target.file.full_path)
    $offending_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $reg and $file
}
