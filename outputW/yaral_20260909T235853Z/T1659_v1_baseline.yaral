/*
  MITRE Technique : T1659 - Content Injection
  Tactic(s)       : Initial Access, Command and Control
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:26:27.259434+00:00
  Reference       : https://attack.mitre.org/techniques/T1659
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1659_001_Content_Injection_Suspicious_HTTP_Response_Anomaly {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects network-observable indicators of content injection (T1659) at the perimeter: an internal host receives an unusually large HTTP response on a non-standard or high port, or receives an HTTP response from an external IP on a port that is not 80/443/8080/8443, which may indicate adversary-in-the-middle or man-on-the-side injection of malicious payloads into legitimate traffic channels."
    mitre_tactic    = "Initial Access, Command and Control"
    mitre_technique = "T1659"
    mitre_technique_name = "Content Injection"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to Chronicle UDM NETWORK_HTTP or NETWORK_FLOW events with network.received_bytes, target.port, and principal/target IP fields populated."
    platform        = "Linux"
    log_source      = "firewall"
    false_positives = "Large software update downloads, CDN-delivered media content, authorised bulk data transfers, internal proxy servers relaying large responses, vulnerability scanners."
    tuning_guidance = "Add known-good external CDN and update service domains to %global_allowed_domains. Add authorised scanner source IPs to %global_allowed_scanners. Raise the received_bytes threshold if large legitimate downloads are common in the environment. Exclude known internal proxy relay addresses via %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // Traffic must originate from an external (non-RFC1918) source to an internal host
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal

    // Exclude known-good external domains (CDNs, update services, etc.)
    not $net.network.http.response_code = 301
    not $net.network.http.response_code = 302

    // Flag responses on non-standard ports that are not typical HTTPS/HTTP ports
    // OR flag suspiciously large responses on any port (potential payload delivery)
    // Port not in the set of standard web ports: 80, 443, 8080, 8443
    (
      (
        $net.target.port != 80
        $net.target.port != 443
        $net.target.port != 8080
        $net.target.port != 8443
      )
      or
      // Large response body suggesting payload injection (>= 5 MB)
      $net.network.received_bytes >= 5242880
    )

    // Exclude authorised scanners and known-good sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude known-good external domains
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1659")
    $primary_entity    = array_distinct($net.target.ip)
    $source_ip         = array_distinct($net.principal.ip)
    $destination_port  = array_distinct($net.target.port)
    $bytes_received    = max($net.network.received_bytes)
    $http_method       = array_distinct($net.network.http.method)

  condition:
    $net
}
