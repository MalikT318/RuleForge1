/*
  MITRE Technique : T1561 - Disk Wipe
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:09:51.229182+00:00
  Reference       : https://attack.mitre.org/techniques/T1561
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_Disk_Wipe_Linux_Destructive_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects execution of Linux commands commonly used to wipe or overwrite disk data, including direct writes to block devices, MBR destruction, and filesystem-level wiping utilities. Targets the OS mechanism of raw disk access and destructive data overwrite on Linux endpoints."
    mitre_tactic = "Impact"
    mitre_technique = "T1561"
    mitre_technique_name = "Disk Wipe"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd syscall/execve logs normalised to UDM PROCESS_LAUNCH. The command_line field must be populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised disk imaging, forensic acquisition tools, secure erase utilities run by storage administrators, backup software performing low-level disk operations."
    tuning_guidance = "Add authorised disk management parent processes to %global_allowed_backup_processes and authorised admin accounts to %global_allowed_admin_users. Consider narrowing the block device regex to specific device nodes present in the environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match destructive disk utilities and raw write patterns
    (
      // dd writing to a raw block device or /dev/zero/null sourced wipe
      (
        $proc.target.process.file.full_path = /\/dd$/ nocase and
        $proc.target.process.command_line = /of=\/dev\/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]|xvd[a-z]|mmcblk[0-9])/ nocase
      )
      or
      // shred targeting a block device or file
      (
        $proc.target.process.file.full_path = /\/shred$/ nocase and
        $proc.target.process.command_line = /\/dev\/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]|xvd[a-z]|mmcblk[0-9])/ nocase
      )
      or
      // wipefs - filesystem signature removal
      $proc.target.process.file.full_path = /\/wipefs$/ nocase
      or
      // wipe utility
      $proc.target.process.file.full_path = /\/wipe$/ nocase
      or
      // mkfs forced format of a mounted or root device (destructive reformatting)
      (
        $proc.target.process.file.full_path = /\/mkfs(\.[a-z0-9]+)?$/ nocase and
        $proc.target.process.command_line = /\/dev\/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]|xvd[a-z]|mmcblk[0-9])/ nocase
      )
      or
      // hdparm secure erase
      (
        $proc.target.process.file.full_path = /\/hdparm$/ nocase and
        $proc.target.process.command_line = /--security-erase/ nocase
      )
      or
      // badblocks write mode - destructive disk test
      (
        $proc.target.process.file.full_path = /\/badblocks$/ nocase and
        $proc.target.process.command_line = /\-w/ nocase
      )
      or
      // scrub - disk scrubbing utility
      $proc.target.process.file.full_path = /\/scrub$/ nocase
      or
      // blkdiscard - discard/zero all blocks on a device
      $proc.target.process.file.full_path = /\/blkdiscard$/ nocase
    )

    // Exclude authorised backup and imaging processes
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude authorised admin users performing legitimate disk operations
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1561")
    $primary_entity = array_distinct($proc.principal.hostname)
    $executing_user = array_distinct($proc.principal.user.userid)
    $command_observed = array_distinct($proc.target.process.command_line)
    $process_path = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
