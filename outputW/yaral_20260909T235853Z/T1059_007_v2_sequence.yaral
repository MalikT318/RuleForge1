/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:14:59.242688+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_NodeJS_Script_Then_Network_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Node.js or similar JavaScript runtime process launching from a suspicious parent or location, followed by an outbound network connection from the same host within 5 minutes. This correlation targets post-execution C2 or data exfiltration behaviour rather than command-line content, providing additive coverage beyond process-creation rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM, including PROCESS_LAUNCH and NETWORK_CONNECTION events with principal.hostname and process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate Node.js web applications, CI/CD pipeline runners (Jenkins, GitLab Runner), npm install operations, developer workstations running local JS projects."
    tuning_guidance = "Add known CI/CD service accounts to %global_allowed_service_accounts. Add approved Node.js application parent processes to %global_allowed_script_hosts. Add known-good external domains to %global_allowed_domains."

  events:
    // Event 1: JavaScript runtime launched from a suspicious parent or writable path
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(node|nodejs|deno|bun)$/ nocase
    // Suspicious parent processes: shells, interpreters, or processes from writable dirs
    (
      $proc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh)$/ nocase
      or
      $proc.target.process.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/user\/)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Event 2: Outbound network connection from the same host shortly after
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $hostname
    // Exclude RFC1918 internal destinations - external connections only
    not $net.target.ip in %rfc1918_internal
    // Narrow to JS runtime or shell making the connection
    $net.principal.process.file.full_path = /\/(node|nodejs|deno|bun|bash|sh|dash|zsh|curl|wget|python|python3)$/ nocase
    not $net.principal.user.userid in %global_allowed_service_accounts

    // Chronological ordering: process launch must precede network connection
    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $js_runtime_path = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $triggered_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $net
}
