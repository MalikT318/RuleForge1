/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:01:17.180240+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_001_IaaS_Account_Access_Removal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects bulk or suspicious account access removal events in identity provider audit logs, including account disablement, credential resets, permission revocations, and group membership removals that may indicate an adversary inhibiting legitimate user access as part of an impact operation."
    mitre_tactic = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "Requires identity provider audit logs (e.g., Entra ID, Okta, Google Workspace) normalised to UDM USER_CHANGE_PASSWORD, USER_CHANGE_PERMISSIONS, or GROUP_MODIFICATION events."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate IT offboarding workflows, automated provisioning/deprovisioning pipelines, HR-driven bulk account disablement, password rotation policies enforced by service accounts."
    tuning_guidance = "Add known provisioning and offboarding service accounts to %global_allowed_service_accounts. Add approved admin users performing bulk offboarding to %global_allowed_admin_users. Narrow the target.user.userid regex if specific naming conventions apply."

  events:
    // Match identity audit events that represent access removal actions
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // The acting principal must not be a known allowed service account
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // The acting principal must not be a known allowed admin user
    not $auth.principal.user.userid in %global_allowed_admin_users

    // The action must relate to permission revocation or account disablement
    // Identity providers normalise these into security_result.description or
    // target.resource.attribute.labels; match on common UDM description patterns
    (
      $auth.security_result.description = /(?i)(disable|revok|remov|delet|block|suspend|lock)/ or
      $auth.target.resource.attribute.labels.value = /(?i)(disable|revok|remov|delet|block|suspend|lock)/
    )

    // Ensure the target is a user account, not a non-human resource
    $auth.target.user.userid = /.+/

    // Exclude self-service actions (user modifying their own account)
    // by requiring principal and target to differ
    $auth.principal.user.userid != $auth.target.user.userid

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $affected_account = array_distinct($auth.target.user.userid)
    $action_description = array_distinct($auth.security_result.description)

  condition:
    $auth
}
