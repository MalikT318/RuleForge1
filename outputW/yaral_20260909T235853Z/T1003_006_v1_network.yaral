/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:26:39.896945+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_Network_Replication_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects network-observable DCSync behaviour: a non-domain-controller host initiating an outbound connection to a domain controller on the MS-DRSR replication port (TCP 135 RPC endpoint mapper or high RPC ports associated with DRSUAPI). DCSync abuses the Directory Replication Service Remote Protocol to pull credential material. Firewall/perimeter logs will surface unexpected hosts opening connections to DC ports used by replication. Excludes known internal management sources and approved scanners."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires firewall or network flow telemetry that records internal east-west connections with source IP, destination IP, and destination port. Flow logs must capture intra-LAN traffic (not just perimeter). Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate domain controllers replicating with each other, backup domain controllers, Azure AD Connect hosts performing directory synchronisation, authorised identity management platforms (e.g. Okta AD agent, SailPoint), vulnerability scanners performing AD enumeration."
    tuning_guidance = "Add known DC-to-DC replication source IPs and Azure AD Connect server IPs to %global_allowed_mgmt_sources. Add approved scanner IPs to %global_allowed_scanners. Consider narrowing to high RPC ports (49152-65535) if your environment generates excessive noise on port 135 alone."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // DCSync uses MS-DRSR over RPC. The RPC endpoint mapper listens on TCP 135,
    // and the actual DRSUAPI calls are dispatched to dynamic high ports (49152-65535).
    // We target port 135 (RPC endpoint mapper) as the reliable, low-noise anchor
    // for initial replication negotiation, plus the well-known Kerberos (88) and
    // LDAP (389/636/3268/3269) ports that accompany a DCSync session.
    (
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269 or
      $net.target.port = 88
    )

    // Source must be an internal host (not an external attacker directly,
    // and not already excluded as a management source).
    $net.principal.ip in %rfc1918_internal

    // Destination must also be internal (DC is always internal).
    $net.target.ip in %rfc1918_internal

    // Exclude approved management and replication sources (DC-to-DC, AD Connect, etc.).
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude authorised vulnerability scanners.
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved cloud/identity principals performing directory sync.
    not $net.principal.hostname in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)
    $source_hostname = array_distinct($net.principal.hostname)

  condition:
    $net
}
