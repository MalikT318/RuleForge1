/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:59:21.773594+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Polymorphic_File_Write_Then_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a pattern consistent with polymorphic code execution: a script interpreter or memory-manipulation process writes a new executable or script file to a writable user-accessible path, followed shortly by execution of that newly written file from the same host. This two-stage sequence (write-then-run from a non-standard location) is a hallmark of polymorphic or self-mutating malware that rewrites itself before each execution to evade static signatures."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (FILE_CREATION) and process-launch telemetry (PROCESS_LAUNCH) normalised into UDM. Both event types must be populated with principal.hostname, target.file.full_path, and target.process.file.full_path respectively."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that extract and immediately run a payload (e.g., self-extracting archives, legitimate update agents). Scripted build pipelines that compile and execute code in temp directories. Some RMM agents that stage scripts before execution."
    tuning_guidance = "Add known-good parent processes (update agents, build tools) to %global_allowed_admin_tools. Add known-good service accounts that perform staged deployments to %global_allowed_service_accounts. Narrow the writable-path regex if your environment uses a non-standard temp layout."

  events:
    // Event 1: A script host or suspicious parent writes a PE or script file
    // into a user-writable or temporary location.
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|cmd|rundll32|regsvr32|certutil|bitsadmin|wmic)\.exe$/ nocase
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData\\(Local|Roaming)|Downloads)|\\Windows\\Temp|\\ProgramData|\\Temp)\\[^\\]+\.(exe|dll|ps1|vbs|js|bat|hta|scr|com)$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $dropped_path

    // Event 2: The dropped file is subsequently launched as a new process
    // from the same host within the time window.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $dropped_path
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Enforce chronological ordering: file must be written before it is executed.
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $dropped_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $executed_file = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
