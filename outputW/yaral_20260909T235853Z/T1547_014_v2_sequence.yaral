/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:17:28.363384+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_Active_Setup_Registry_Then_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation or modification of Active Setup registry key followed by user login and subsequent execution of the StubPath binary, indicating persistence via Active Setup mechanism."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires EDR registry telemetry and process launch events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers using Active Setup for per-user configuration; Windows updates; enterprise application deployment."
    tuning_guidance = "Add known-good StubPath binaries to %global_allowed_admin_tools. Exclude service accounts performing automated deployments via %global_allowed_service_accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    re.regex($reg.target.registry.registry_key, `(?i)\\software\\microsoft\\active setup\\installed components\\`) nocase
    $reg.target.registry.registry_value_name = "StubPath" nocase
    $reg.target.registry.registry_value_data != ""
    not re.regex($reg.target.registry.registry_value_data, `(?i)^(rundll32\.exe.*advpack\.dll|regsvr32\.exe /s)`) nocase
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    re.regex($proc.target.process.command_line, `(?i)\\software\\microsoft\\active setup\\installed components\\`) nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $stubpath_values = array_distinct($reg.target.registry.registry_value_data)
    $executed_processes = array_distinct($proc.target.process.file.full_path)
    $modifying_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $proc
}
