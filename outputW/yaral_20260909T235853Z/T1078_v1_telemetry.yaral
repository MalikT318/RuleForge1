/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:19:19.564286+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_SaaS_Dormant_Account_Login_Privilege_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a privilege or group change applied to a user account via an identity provider audit log. Adversaries abusing valid accounts — including dormant or compromised accounts — frequently escalate privileges or modify group membership to expand access. This rule fires on the resulting directory state change rather than on any command-line activity, providing coverage that is orthogonal to existing process-creation detections."
    mitre_tactic = "Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM (Entra ID, Okta, or equivalent). Events must populate principal.user.userid, target.user.userid, and metadata.event_type = USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate IT or HR-driven role assignments, automated provisioning workflows, and onboarding processes. Service accounts performing scheduled group synchronisation may also trigger this rule."
    tuning_guidance = "Add known provisioning service accounts to %global_allowed_service_accounts. Add approved admin users who routinely manage roles to %global_allowed_admin_users. Consider narrowing to high-value groups or privileged roles using a regex on target.group.group_display_name if that field is populated."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"

    // The actor performing the change must not be a known-good service account
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // The actor must not be a named administrator expected to perform this action
    not $auth.principal.user.userid in %global_allowed_admin_users

    // The actor and the target must be different accounts — self-service password
    // resets and profile updates are excluded; we want lateral/escalation moves
    $auth.principal.user.userid != $auth.target.user.userid

    // Exclude cloud/automation principals that legitimately manage permissions
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($auth.target.user.userid)
    $actor_userid = array_distinct($auth.principal.user.userid)
    $target_userid = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
