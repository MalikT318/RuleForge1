/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:45:07.635702+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Cloud_Firewall_Rule_Permissive_Ingress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud firewall or security group rule modifications that introduce overly permissive ingress access (e.g., 0.0.0.0/0 or ::/0 on sensitive ports). Adversaries with sufficient cloud permissions may modify or create firewall rules to allow unrestricted inbound connectivity to cloud-hosted resources, bypassing network segmentation controls. This rule targets the resulting configuration state change in cloud audit logs rather than the API call invocation, providing a complementary detection layer to command-line or API-name based rules."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Cloud Firewall"
    log_prerequisites = "Requires cloud provider audit logs normalised into Chronicle UDM. AWS CloudTrail (AuthorizeSecurityGroupIngress, CreateSecurityGroup, ModifyNetworkAclEntry), Azure Activity Logs (Microsoft.Network/networkSecurityGroups/securityRules/write), or GCP Audit Logs (compute.firewalls.insert / compute.firewalls.patch) must be ingested and UDM-normalised."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorised cloud infrastructure engineers opening ports for legitimate services; automated IaC pipelines (Terraform, CloudFormation, Pulumi) applying approved firewall changes; vulnerability scanners or penetration testing engagements; load balancer health-check rule provisioning."
    tuning_guidance = "Add known automation and deployment service principals to %global_allowed_cloud_principals. Add known scanner source identities to %global_allowed_scanners. Consider narrowing the port regex to only the highest-risk ports (22, 3389, 5985, 5986, 1433, 3306, 5432, 6379, 27017) if noise is high. Pair with a threshold rule to suppress single isolated changes from known-good pipelines."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"

    // Target resource must be a firewall, security group, network ACL, or equivalent
    $cloud.target.resource.name = /(?i)(firewall|security.?group|network.?acl|nsg|sg\-|fw\-|ingress|securityrule)/

    // The change must introduce a permissive CIDR (any-source IPv4 or IPv6)
    // Detected via the request or change description captured in the security result or resource attribute
    (
      $cloud.security_result.description = /(?i)(0\.0\.0\.0\/0|::\s*\/\s*0)/
      or
      $cloud.target.resource.attribute.labels.value = /(?i)(0\.0\.0\.0\/0|::\s*\/\s*0)/
    )

    // Exclude known authorised cloud automation principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known authorised scanner identities
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $actor_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
