/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:06:43.345070+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_ESXi_Crontab_Write_After_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a suspicious sequence on ESXi hosts where an interactive shell login is followed by a modification to the crontab file within one hour. Adversaries targeting ESXi (e.g., ransomware groups deploying ESXiArgs) write directly to /var/spool/cron/crontabs/root to establish persistence because ESXi lacks the standard crontab binary workflow. Correlating the login event with the file modification provides additive coverage beyond command-line process-launch rules."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Requires ESXi shell/hostd logs normalised to UDM USER_LOGIN and FILE_MODIFICATION or SETTING_MODIFICATION events. Ensure the ESXi syslog is forwarded to Chronicle and that file-write telemetry for /var/spool/cron is captured (requires ESXi audit logging or an EDR agent on the host)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised ESXi administrators performing scheduled maintenance via shell; automated configuration management tools (Ansible, vSphere Lifecycle Manager) that write crontab entries; backup agents that register scheduled jobs."
    tuning_guidance = "Add known administrative service accounts to %global_allowed_service_accounts. Add approved management source IPs to %global_allowed_mgmt_sources. If a specific automation principal consistently triggers this, add it to %global_allowed_admin_users."

  events:
    // Event 1: Interactive or SSH login to the ESXi shell
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $esxi_host
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Event 2: Crontab file modification following the login on the same host
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/var\/spool\/cron(tabs)?\// nocase
    $file.principal.hostname = $esxi_host
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

    // Chronological ordering: login must precede the crontab write
    $auth.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $esxi_host over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity = array_distinct($esxi_host)
    $triggering_users = array_distinct($auth.principal.user.userid)
    $modified_crontab_paths = array_distinct($file.target.file.full_path)
    $login_count = count($auth.metadata.event_timestamp.seconds)
    $crontab_write_count = count($file.metadata.event_timestamp.seconds)

  condition:
    $auth and $file
}
