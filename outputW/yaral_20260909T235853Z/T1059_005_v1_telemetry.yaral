/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:13:24.632624+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_VBScript_Artifact_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation of VBScript or VBA-related artifacts (.vbs, .vbe, .wsf, .wsc, .hta) in suspicious locations such as user-writable directories, temp paths, and Office macro staging areas. Attackers frequently drop VB payloads to disk as a precursor to execution, and file-creation telemetry is harder to suppress than command-line logging."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry normalised to UDM FILE_CREATION events with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office macro exports, developer workstations authoring VBScript, IT automation scripts deployed via RMM tooling, software installers that stage .vbs helpers."
    tuning_guidance = "Add known-good parent process paths (e.g., installer engines, RMM agents) to %global_allowed_admin_tools. Add authorised script-staging hosts to %global_allowed_script_hosts. Narrow the path regex to exclude specific approved directories if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Match VBScript and VBA-adjacent file extensions
    $file.target.file.full_path = /(?i)\.(vbs|vbe|wsf|wsc|hta)$/

    // Restrict to suspicious write locations:
    // - User profile temp/appdata paths
    // - Windows temp directories
    // - Public and shared folders
    // - Office startup/XLSTART macro staging paths
    // - Downloads and Desktop (common phishing drop zones)
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData\\(Local\\Temp|Roaming\\Microsoft\\(Word\\STARTUP|Excel\\XLSTART|Templates)|Downloads|Desktop)|\\Windows\\(Temp|Tasks)|\\ProgramData\\[^\\]+\\Temp|\\Temp\\|\\Public\\)/

    // Exclude known-good parent processes (admin/deployment tooling)
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude authorised script-staging hosts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
