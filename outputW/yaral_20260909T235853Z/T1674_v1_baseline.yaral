/*
  MITRE Technique : T1674 - Input Injection
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:28:56.794064+00:00
  Reference       : https://attack.mitre.org/techniques/T1674
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1674_001_Input_Injection_Suspicious_Shell_Via_SendInput_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects input injection attacks where a process spawns a command interpreter or scripting host from an unusual parent, consistent with simulated keystrokes (e.g. Win32 SendInput, keybd_event, or HID emulation) launching shells. Covers the BackSwap-style pattern of injecting keystrokes into browser windows to open developer consoles, and USB HID rubber-ducky style attacks that launch PowerShell or cmd from explorer or accessibility processes."
    mitre_tactic = "Execution"
    mitre_technique = "T1674"
    mitre_technique_name = "Input Injection"
    log_prerequisites = "Requires EDR process launch telemetry with parent process lineage (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1). Parent process full path and child command line must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate automation tools (AutoHotKey, AutoIt) used by IT staff, accessibility software, RMM agents launching shells, and developer tooling that programmatically opens terminals. Browser-integrated developer tools opened by users."
    tuning_guidance = "Add known-good parent process paths (RMM agents, automation frameworks) to %global_allowed_admin_tools. Add known-good script hosts to %global_allowed_script_hosts. Narrow scope by requiring the parent to be a browser or accessibility binary if false-positive rate is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child process is a shell, scripting host, or download utility
    // commonly launched via injected keystrokes
    $proc.target.process.file.full_path = /\\(cmd\.exe|powershell\.exe|pwsh\.exe|wscript\.exe|cscript\.exe|mshta\.exe|rundll32\.exe|regsvr32\.exe|certutil\.exe|bitsadmin\.exe)$/ nocase

    // Parent is a process that handles user input or is a common HID/injection target:
    // browsers, explorer, accessibility hosts, on-screen keyboard, screen readers,
    // or the Windows shell itself receiving injected keystrokes
    $proc.principal.process.file.full_path = /\\(chrome\.exe|msedge\.exe|firefox\.exe|iexplore\.exe|opera\.exe|brave\.exe|explorer\.exe|osk\.exe|narrator\.exe|magnify\.exe|utilman\.exe|winlogon\.exe|logonui\.exe|SearchUI\.exe|SearchApp\.exe|ShellExperienceHost\.exe|RuntimeBroker\.exe)$/ nocase

    // Exclude empty command lines (telemetry gaps) - require some command line content
    $proc.target.process.command_line = /.+/

    // Exclude known-good administrative and script host parent paths
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt

    // Exclude known-good service accounts performing automation
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1674")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_cmdline = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
