/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:35:30.911990+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_NetDev_MailProto_C2_Flow_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network device initiating an outbound connection on a mail protocol port (SMTP/25, SMTP-S/465, SMTP-STARTTLS/587, POP3/110, POP3-S/995, IMAP/143, IMAP-S/993) followed by sustained bidirectional flow volume on the same port within 5 minutes. Network devices have no legitimate reason to originate mail-protocol sessions; this pattern is consistent with C2 over mail protocols (T1071.003) where an implant on a compromised device uses SMTP/IMAP/POP3 to beacon or exfiltrate."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs normalised to UDM NETWORK_CONNECTION and NETWORK_FLOW. Both event types must carry principal.ip, target.ip, target.port, and network.sent_bytes / network.received_bytes."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Dedicated mail relay appliances, mail security gateways, or SMTP proxy devices that legitimately originate mail sessions. Authorised vulnerability scanners probing mail ports."
    tuning_guidance = "Add known mail relay and security gateway source IPs to %global_allowed_scanners or %rfc1918_internal exclusions. Raise the byte-volume threshold in the outcome comment if the environment has high-volume legitimate mail appliances. Narrow target.port list if only specific mail protocols are in scope."

  events:
    // Event 1: Network device originates an outbound connection on a mail protocol port
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
        $conn.target.port = 25 or
        $conn.target.port = 110 or
        $conn.target.port = 143 or
        $conn.target.port = 465 or
        $conn.target.port = 587 or
        $conn.target.port = 993 or
        $conn.target.port = 995
    )
    not $conn.principal.ip in %rfc1918_internal
    not $conn.target.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    $conn.principal.ip = $device_ip
    $conn.target.port = $mail_port

    // Event 2: Sustained bidirectional flow on the same mail port from the same source
    $flow.metadata.event_type = "NETWORK_FLOW"
    (
        $flow.target.port = 25 or
        $flow.target.port = 110 or
        $flow.target.port = 143 or
        $flow.target.port = 465 or
        $flow.target.port = 587 or
        $flow.target.port = 993 or
        $flow.target.port = 995
    )
    not $flow.principal.ip in %rfc1918_internal
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    $flow.network.sent_bytes > 0
    $flow.network.received_bytes > 0
    $flow.principal.ip = $device_ip
    $flow.target.port = $mail_port

    // Chronological ordering: connection must precede or coincide with flow record
    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_ip, $mail_port over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($conn.principal.ip)
    $destination_ips = array_distinct($flow.target.ip)
    $observed_mail_ports = array_distinct($flow.target.port)
    $total_sent_bytes = max($flow.network.sent_bytes)
    $total_received_bytes = max($flow.network.received_bytes)
    $connection_count = count($flow.metadata.event_timestamp.seconds)

  condition:
    $conn and $flow
}
