/*
  MITRE Technique : T1578 - Modify Cloud Compute Infrastructure
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:13:53.372582+00:00
  Reference       : https://attack.mitre.org/techniques/T1578
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_Modify_Cloud_Compute_Infrastructure {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of cloud compute infrastructure components such as instance deletion, snapshot creation/deletion, disk detachment, or image modification. Adversaries abuse these operations to evade defenses, remove forensic evidence, or gain access to data outside normal access controls."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1578"
    mitre_technique_name = "Modify Cloud Compute Infrastructure"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail, Azure Activity Log, or GCP Audit Logs) normalised into Chronicle UDM. API-level compute resource events must be ingested."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized DevOps pipelines performing instance lifecycle management, auto-scaling group terminations, scheduled snapshot policies, disaster recovery runbooks, and infrastructure-as-code deployments (Terraform, CloudFormation, Pulumi)."
    tuning_guidance = "Add known automation and deployment service principals to %global_allowed_cloud_principals. Add known CI/CD source addresses to %global_allowed_mgmt_sources. Narrow the operation regex to the specific cloud provider API verbs observed in your environment."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"

    // Match high-risk compute infrastructure modification API operations across
    // AWS, Azure, and GCP as normalised into UDM target.resource.name /
    // metadata.description. The regex covers:
    //   AWS:   TerminateInstances, DeleteSnapshot, DeleteImage, DetachVolume,
    //          StopInstances, DeregisterImage, DeleteVolume
    //   Azure: deallocate, delete (virtualMachines, disks, snapshots, images)
    //   GCP:   instances.delete, snapshots.delete, images.delete, disks.delete
    $cloud.metadata.description = /(?i)(terminateinstance|deletesnapshot|deleteimage|detachvolume|stopinstance|deregisterimage|deletevolume|instances\.delete|snapshots\.delete|images\.delete|disks\.delete|virtualmachines.*delete|disks.*delete|snapshots.*delete|images.*delete|deallocate)/

    // Require an authenticated principal - exclude anonymous/unauthenticated
    $cloud.principal.user.userid != ""

    // Exclude known-good automation and service principals
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known management source addresses (CI/CD runners, IaC agents)
    not $cloud.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1578")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)
    $operation = array_distinct($cloud.metadata.description)

  condition:
    $cloud
}
