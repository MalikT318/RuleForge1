/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:55:30.177995+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Container_Compute_Hijacking_API_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cloud audit log events indicative of container compute hijacking for cryptomining. Adversaries exploit exposed container APIs or Kubernetes control planes to create or modify workloads that consume excessive compute resources. This rule targets suspicious resource creation or access patterns on container orchestration APIs from unexpected principals or with anomalous resource configurations such as privileged containers, host namespace sharing, or unusual image sources."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Requires cloud provider audit logs (e.g., GCP Audit Logs, AWS CloudTrail, Azure Activity Logs) normalised into Chronicle UDM. Kubernetes API server audit logging must be enabled. Events should include resource creation and access operations on container workload resource types."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines creating pods or jobs at scale; autoscaling controllers creating new workloads; authorised batch processing jobs; infrastructure-as-code deployments via service accounts."
    tuning_guidance = "Add known CI/CD and automation service account identifiers to %global_allowed_service_accounts. Add approved cloud principals to %global_allowed_cloud_principals. Narrow the resource type regex if your environment uses a consistent naming convention for legitimate workloads."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"

    // Target container orchestration resource types - pods, jobs, deployments, daemonsets
    // These are the workload types adversaries create to run cryptominers at scale
    $cloud.target.resource.type = /(?i)(pod|job|deployment|daemonset|statefulset|replicaset|cronjob|container)/

    // Detect creation via direct API calls rather than through a controller manager,
    // which is the typical adversary pattern when abusing exposed APIs
    // Legitimate orchestration controllers use system: prefixed service accounts
    not $cloud.principal.user.userid = /(?i)^system:/

    // Exclude known automation and service accounts
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

    // Exclude known internal scanner or security tooling sources
    not $cloud.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $resource_type = array_distinct($cloud.target.resource.type)
    $resource_name = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
