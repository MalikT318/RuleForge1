/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:21:26.458703+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_Linux_Passwd_Read_Then_Recon_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a sequence where /etc/passwd or /etc/shadow is read (FILE_READ) followed within 10 minutes by a local account enumeration process launch on the same host. This correlation provides additive coverage beyond simple command-line matching by requiring both a sensitive file access and a follow-on recon process, reducing false positives from either event in isolation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "Requires Linux EDR or auditd telemetry producing FILE_READ events on /etc/passwd or /etc/shadow and PROCESS_LAUNCH events. Auditd rules must include -w /etc/passwd -p r and -w /etc/shadow -p r."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "System management tools (e.g., PAM, SSSD, nscd, ldap clients), backup agents, configuration management (Ansible, Puppet, Chef), monitoring agents, and legitimate admin scripts that read /etc/passwd and then invoke id or getent."
    tuning_guidance = "Add known-good parent processes (backup agents, config management) to %global_allowed_backup_processes or %global_allowed_admin_tools. Add authorised service accounts to %global_allowed_service_accounts."

  events:
    // Event 1: Sensitive account file read
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/etc\/(passwd|shadow|group|gshadow)$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Event 2: Local account enumeration process launched on the same host
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(id|groups|getent|finger|who|w|last|lastlog|users|awk|cut|grep|sort|uniq)$/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Chronological ordering: file read must precede the recon process
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $sensitive_files_accessed = array_distinct($file.target.file.full_path)
    $recon_processes_launched = array_distinct($proc.target.process.file.full_path)
    $triggering_users = array_distinct($file.principal.user.userid)
    $recon_parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    $file and $proc
}
