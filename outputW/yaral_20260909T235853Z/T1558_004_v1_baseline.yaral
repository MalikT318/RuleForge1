/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:08:13.653372+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_ASREP_Roasting_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects AS-REP Roasting activity via process command-line arguments characteristic of tools that enumerate accounts with Kerberos pre-authentication disabled and request AS-REP tickets for offline cracking. Targets the behavioral pattern of querying LDAP for accounts with the DONT_REQ_PREAUTH flag and requesting Kerberos AS-REP responses without pre-authentication."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture (Sysmon Event ID 1, Windows Security Event 4688 with command-line auditing enabled, or equivalent EDR telemetry)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorized penetration testing or red team exercises, security assessment tooling run by the security team, legitimate Kerberos diagnostic utilities."
    tuning_guidance = "Add authorized security assessment hosts or parent processes to %global_allowed_security_tools or %global_allowed_admin_tools. Scope by principal.hostname to known pentest assets during authorized engagements."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match PowerShell or script hosts commonly used to execute AS-REP roasting
    // OR native Windows binaries used in conjunction with roasting scripts
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd)\.exe$/ nocase

    // Detect command-line patterns strongly associated with AS-REP roasting:
    // 1. References to DONT_REQ_PREAUTH LDAP attribute flag (decimal 4194304 or hex 0x400000)
    // 2. References to known AS-REP roasting function/module names used across tooling
    // 3. References to userAccountControl LDAP filter used to enumerate vulnerable accounts
    (
      $proc.target.process.command_line = /DONT_REQ_PREAUTH/ nocase
      or
      $proc.target.process.command_line = /Get-ASREPHash/ nocase
      or
      $proc.target.process.command_line = /Invoke-ASREPRoast/ nocase
      or
      $proc.target.process.command_line = /Get-NPUsers/ nocase
      or
      $proc.target.process.command_line = /userAccountControl.*4194304/ nocase
      or
      $proc.target.process.command_line = /4194304.*userAccountControl/ nocase
      or
      $proc.target.process.command_line = /asreproast/ nocase
      or
      $proc.target.process.command_line = /krb5asrep/ nocase
      or
      $proc.target.process.command_line = /\-request\b.*\-format\b/ nocase
    )

    // Exclude known authorized security and admin tooling
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
