/*
  MITRE Technique : T1666 - Modify Cloud Resource Hierarchy
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:27:04.331854+00:00
  Reference       : https://attack.mitre.org/techniques/T1666
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1666_001_Modify_Cloud_Resource_Hierarchy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects modifications to cloud resource hierarchy structures such as removing accounts from organizations, creating new subscriptions, transferring subscriptions between tenants, or modifying management groups. Adversaries abuse these capabilities to evade logging, deploy resources outside monitored environments, or hijack compute capacity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1666"
    mitre_technique_name = "Modify Cloud Resource Hierarchy"
    log_prerequisites = "Requires cloud provider audit logs normalized to UDM. AWS CloudTrail (LeaveOrganization, CreateAccount, RemoveAccountFromOrganization, MoveAccount), Azure Activity Logs (subscription creation, management group modification, subscription transfer), or GCP Audit Logs (organization/folder modification events)."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Authorized cloud architects restructuring organizational units, legitimate subscription provisioning by finance or procurement teams, automated infrastructure-as-code pipelines performing account vending, and authorized tenant migrations."
    tuning_guidance = "Add authorized cloud administrator identities to %global_allowed_cloud_principals. Add authorized automation service accounts to %global_allowed_service_accounts. Consider scoping by time-of-day if hierarchy changes are only expected during maintenance windows."

  events:
    $cloud.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"

    // Match hierarchy-modifying API operations across AWS, Azure, and GCP
    // using normalized UDM target resource type and operation name fields.
    // Patterns cover: AWS LeaveOrganization, RemoveAccountFromOrganization,
    // MoveAccount, CreateAccount; Azure management group and subscription
    // operations; GCP organization/folder modifications.
    $cloud.target.resource.name = /(?i)(organization|management.?group|subscription|folder|account|billing.?account)/

    $cloud.metadata.product_event_type = /(?i)(leave|remove|delete|move|transfer|create|update|modify|detach|disassociate).*(organization|account|subscription|management.?group|folder|billing)/

    // Require an authenticated principal - anonymous calls are noise
    $cloud.principal.user.userid != ""

    // Exclude approved cloud principals and automation accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1666")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $affected_resource = array_distinct($cloud.target.resource.name)
    $operation_performed = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
