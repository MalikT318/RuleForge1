/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:16:19.054806+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_CloudAPI_ServicePrincipalLoginThenPrivilegedAction {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a service principal or application identity authenticating via cloud API and then immediately performing a privileged IAM or permissions-change action within a short window. This pattern is consistent with adversaries abusing application access tokens or compromised service principals to execute privileged cloud API calls for lateral movement, persistence, or resource manipulation."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires identity provider audit logs normalised to UDM (Entra ID, Okta, or equivalent). Events must include USER_LOGIN for service principal / non-interactive sign-ins and USER_CHANGE_PERMISSIONS or GROUP_MODIFICATION for downstream privileged actions."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate automation pipelines and CI/CD service principals that authenticate and then modify IAM roles or group memberships as part of normal deployment workflows. Approved provisioning tools listed in %global_allowed_service_accounts."
    tuning_guidance = "Add known automation service-account identifiers to %global_allowed_service_accounts. Add approved cloud management principals to %global_allowed_cloud_principals. Narrow the rule further by scoping to specific high-value target resource types if the environment has stable naming conventions."

  events:
    // Event 1: Non-interactive / service-principal login via cloud API
    $auth.metadata.event_type = "USER_LOGIN"
    // Target application or resource indicates a cloud management or API endpoint
    $auth.target.application = /(?i)(management|api|graph|arm|iam|resource|compute|storage|directory)/
    // Exclude known-good service accounts
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    // Capture the authenticating identity as the join key
    $auth.principal.user.userid = $cloud_user

    // Event 2: Privileged permissions or group change shortly after login
    $priv.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    // The same identity performs the privileged action
    $priv.principal.user.userid = $cloud_user
    // Exclude known-good service accounts on the action side as well
    not $priv.principal.user.userid in %global_allowed_service_accounts
    not $priv.principal.user.userid in %global_allowed_cloud_principals

    // Enforce chronological ordering: login must precede the privileged action
    $auth.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $cloud_user over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($cloud_user)
    $login_target_application = array_distinct($auth.target.application)
    $privileged_action_count = count($priv.metadata.event_timestamp.seconds)
    $affected_target_resources = array_distinct($priv.target.resource.name)

  condition:
    $auth and $priv
}
