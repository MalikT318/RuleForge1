/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:32:18.224757+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_PasswordManager_ProcessOpen_Then_FileRead {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-password-manager process opening a handle to a password manager process followed by creation or modification of a file in a sensitive staging location on the same host within 10 minutes. This pattern is consistent with credential extraction from password manager memory (e.g. KeePass, 1Password, Bitwarden) by an injecting or scraping process."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires EDR process-open (handle) telemetry and file-creation/modification telemetry normalised to UDM PROCESS_OPEN and FILE_CREATION. CrowdStrike Falcon, Microsoft Defender for Endpoint, and Sysmon (Event ID 10 + 11) all produce this data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate backup agents reading password manager databases, EDR/AV scanning password manager files, authorised IT tooling performing credential audits, password manager auto-backup features writing to temp directories."
    tuning_guidance = "Add authorised backup and security agent paths to %global_allowed_backup_processes and %global_allowed_security_tools. Add approved service accounts to %global_allowed_service_accounts. Narrow the file-write path regex if your environment uses non-default temp or staging directories."

  events:
    // Event 1: A suspicious process opens a handle to a known password manager process.
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(KeePass|KeePassXC|1Password|Bitwarden|Dashlane|LastPass|RoboForm|Enpass|Keeper|NordPass|Sticky Password|PasswordSafe|pwsafe)/ nocase
    not $open.principal.process.file.full_path = /\\(KeePass|KeePassXC|1Password|Bitwarden|Dashlane|LastPass|RoboForm|Enpass|Keeper|NordPass|Sticky Password|PasswordSafe|pwsafe)/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.user.userid in %global_allowed_service_accounts
    $open.principal.hostname = $hostname

    // Event 2: A file is created or modified in a temp/staging location shortly after,
    // on the same host, by a process that is not the password manager itself.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\\Temp\\|\\AppData\\Local\\Temp\\|\\AppData\\Roaming\\|\\ProgramData\\|\\Users\\Public\\)/ 
    $file.target.file.full_path = /(?i)\.(txt|csv|xml|json|log|dat|bin|kdbx|agilekeychain|opvault)$/
    not $file.principal.process.file.full_path = /\\(KeePass|KeePassXC|1Password|Bitwarden|Dashlane|LastPass|RoboForm|Enpass|Keeper|NordPass|Sticky Password|PasswordSafe|pwsafe)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Chronological ordering: process open must precede the file write
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($hostname)
    $opening_process = array_distinct($open.principal.process.file.full_path)
    $targeted_pm_process = array_distinct($open.target.process.file.full_path)
    $written_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($open.principal.user.userid)

  condition:
    $open and $file
}
