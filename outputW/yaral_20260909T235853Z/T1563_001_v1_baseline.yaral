/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:11:02.667031+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_SSH_Agent_Socket_Hijack_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable SSH lateral movement consistent with SSH session hijacking. SSH hijacking abuses existing authenticated sessions via the SSH agent socket, resulting in outbound SSH connections (TCP/22) that originate from internal hosts to other internal or external destinations without a corresponding new authentication handshake visible at the perimeter. This rule flags high-frequency or anomalous outbound SSH flows from internal sources to destinations not in the approved management source list, which is a network-level indicator of agent-forwarding abuse or session hijacking."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites = "Requires firewall or network perimeter flow logs with source IP, destination IP, destination port, and byte counts normalised into Chronicle UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised administrators using SSH agent forwarding for legitimate jump-host workflows; automated deployment pipelines using SSH; vulnerability scanners performing SSH banner checks."
    tuning_guidance = "Add approved management source IPs to %global_allowed_mgmt_sources and approved remote management tools to %global_allowed_remote_mgmt. Consider raising the minimum bytes threshold to reduce noise from short-lived probe connections in your environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
