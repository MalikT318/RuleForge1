/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:21:30.703674+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_001_Container_Escape_Privileged_Host_Mount {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "Critical"
    description     = "Detects container escape attempts via privileged container execution or host filesystem bind-mount abuse. Adversaries launch processes inside containers that interact with host-level paths (/etc, /proc, /var, cron directories, systemd units) or invoke namespace-escape primitives (unshare, nsenter, keyctl) to break out of container isolation and gain access to the underlying host."
    mitre_tactic    = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "Requires container runtime EDR telemetry or Kubernetes audit logs normalised to Chronicle UDM PROCESS_LAUNCH events. The runtime must record the process command line and the container context (container name or image) on the principal."
    platform        = "Linux"
    log_source      = "container"
    false_positives = "Legitimate container orchestration agents (e.g., node-level DaemonSets) that intentionally mount host paths; privileged init containers used by storage or networking plugins; authorised security tooling that uses nsenter for diagnostics."
    tuning_guidance = "Add known-good orchestration service accounts to %global_allowed_service_accounts. Add approved privileged tooling binaries to %global_allowed_admin_tools. Narrow the host-path regex if your environment mounts specific subdirectories legitimately."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // The process must originate from within a container context.
    // Chronicle normalises the container/pod name into principal.resource.name
    // and the image into principal.resource.product_object_id.
    $proc.principal.resource.name != ""

    // Exclude approved service accounts that legitimately run privileged containers
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved admin tooling (e.g., authorised DaemonSet agents)
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

    // Match any of the primary escape primitives or suspicious host-path interactions.
    // Group A: namespace / privilege escape binaries
    (
      $proc.target.process.file.full_path = /\/(unshare|nsenter|keyctl|runc|ctr|nerdctl)$/ nocase
      or
      // Group B: standard shells or interpreters writing to host-mounted sensitive paths
      // detected via command-line references to host filesystem locations
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|ash|python[23]?|perl|ruby)$/ nocase
        and
        $proc.target.process.command_line = /(?i)(\/etc\/cron\.|\/etc\/crontab|\/var\/spool\/cron|\/etc\/systemd\/system|\/proc\/sysrq-trigger|\/proc\/sys\/kernel|\/proc\/1\/|\/host\/etc|\/host\/proc|\/host\/var|docker\.sock|\/run\/containerd|\/run\/docker\.sock)/ nocase
      )
      or
      // Group C: direct invocation of cron, systemctl, or modprobe from within a container
      // targeting host-level service management — strong indicator of escape
      $proc.target.process.file.full_path = /\/(crontab|modprobe|insmod|rmmod|systemctl|service)$/ nocase
      or
      // Group D: chroot into a host-mounted filesystem root
      (
        $proc.target.process.file.full_path = /\/chroot$/ nocase
        and
        $proc.target.process.command_line = /(?i)(\/host|\/mnt\/host|\/rootfs|\/proc\/1\/root)/
      )
    )

  outcome:
    $risk_score        = max(95)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity    = array_distinct($proc.principal.hostname)
    $container_name    = array_distinct($proc.principal.resource.name)
    $escape_binary     = array_distinct($proc.target.process.file.full_path)
    $escape_cmdline    = array_distinct($proc.target.process.command_line)
    $actor_user        = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
