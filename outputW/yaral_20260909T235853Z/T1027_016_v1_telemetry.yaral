/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:00:27.495053+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_Junk_Code_Insertion_Suspicious_Executable_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of executable files in world-writable or staging directories on Linux, which is a common artifact of junk-code-obfuscated malware being dropped or compiled in place. Junk code insertion produces a file artifact with unusual characteristics: an ELF binary written to /tmp, /dev/shm, /var/tmp, or hidden directories under user home paths. This rule targets the file-write state change rather than the process command line, providing additive coverage over process-creation rules."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_CREATION or FILE_MODIFICATION events, including target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate build systems writing compiled binaries to /tmp during CI/CD pipelines; package managers staging files in /var/tmp; Go/Rust/C toolchains writing intermediate objects; container image build steps."
    tuning_guidance = "Add known CI/CD runner process paths to %global_allowed_admin_tools. Add authorised build-host hostnames to %global_allowed_script_hosts. Narrow the path regex if /tmp ELF writes are common in your environment by restricting to /dev/shm or hidden dot-directories only."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: ELF binary written to a world-writable or staging path,
    // or to a hidden directory under a user home, which is characteristic
    // of obfuscated payloads being staged rather than installed via package manager.
    $file.target.file.full_path = /^(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/shm\/|\/home\/[^\/]+\/\.[^\/]+\/|\/root\/\.[^\/]+\/)/ nocase

    // The file has an ELF-like name or no extension at all (common for
    // stripped/obfuscated binaries; junk-code-padded malware rarely uses .so/.py).
    // Match files with no dot-extension or explicit elf/bin/out suffixes.
    $file.target.file.full_path = /\/(elf|bin|out|run|exec|payload|agent|srv|svc|update|patch|helper|loader|init|daemon|worker|task|job|proc|mod|core|srv[0-9]|[a-z0-9]{8,16})$/ nocase

    // The writing process is NOT a known package manager or build tool.
    // Exclude common legitimate writers.
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|yum|dnf|pip3?|cargo|go|gcc|g\+\+|clang|make|cmake|ninja|bazel|mvn|gradle|ansible|puppet|chef|salt|terraform)$/ nocase

    // Exclude known-good administrative and backup tooling.
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude security tooling that may stage files legitimately.
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity = array_distinct($file.principal.hostname)
    $written_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
