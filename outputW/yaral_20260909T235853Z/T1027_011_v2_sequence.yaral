/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:57:08.319911+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Fileless_Storage_SharedMem_Exec_Sequence {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage fileless storage pattern on Linux: a file is written into a RAM-backed shared memory directory (/dev/shm, /run/shm, /var/run, /var/lock) and then a process is launched from that same path within a short window. This indicates an adversary staging a payload in a non-disk-backed location to evade file-based AV and read-only filesystem protections."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to Chronicle UDM, producing FILE_CREATION and PROCESS_LAUNCH events with full path fields populated."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Container runtimes (Docker, containerd, podman) staging temporary socket or lock files; legitimate IPC libraries using /dev/shm for shared memory segments; some database engines (PostgreSQL, Redis) using /var/run for socket files. Tune using %global_allowed_backup_processes or %global_allowed_admin_tools for known-good writers."
    tuning_guidance = "Add known-good parent process paths that legitimately write to shared memory directories to %global_allowed_admin_tools. Narrow the file extension regex if your environment only sees specific payload types. Increase the time window if staging and execution are separated by more than 5 minutes in your telemetry."

  events:
    // Stage 1: A file is created inside a RAM-backed shared memory directory.
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(?:dev\/shm|run\/shm|var\/run|var\/lock)\// nocase
    // Exclude known socket and lock file extensions that are benign IPC artefacts.
    not $file.target.file.full_path = /\.(?:sock|socket|pid|lock|lck)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    // Capture the written path as a join key.
    $file.target.file.full_path = $shm_path

    // Stage 2: A process is launched whose executable path matches the written file.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(?:dev\/shm|run\/shm|var\/run|var\/lock)\// nocase
    not $proc.target.process.file.full_path = /\.(?:sock|socket|pid|lock|lck)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    // Join on the exact file path that was written then executed.
    $proc.target.process.file.full_path = $shm_path

    // Enforce chronological ordering: write must precede execution.
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $shm_path over 5m

  outcome:
    $risk_score          = max(85)
    $mitre_technique_id  = array_distinct("T1027.011")
    $primary_entity      = array_distinct($file.principal.hostname)
    $writing_process     = array_distinct($file.principal.process.file.full_path)
    $executing_process   = array_distinct($proc.principal.process.file.full_path)
    $affected_host       = array_distinct($proc.principal.hostname)
    $shm_paths_observed  = array_distinct($proc.target.process.file.full_path)

  condition:
    $file and $proc
}
