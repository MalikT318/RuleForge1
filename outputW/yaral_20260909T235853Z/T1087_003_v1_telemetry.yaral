/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:22:21.831041+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_GAL_Enumeration_Resource_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects bulk or repeated access to the Global Address List (GAL), directory, or address book resources in Microsoft 365 unified audit logs. Adversaries authenticated to Exchange Online may query the GAL to enumerate email accounts and build target lists for phishing or lateral movement. This rule fires on USER_RESOURCE_ACCESS events targeting known GAL/directory API paths and address book objects, providing artifact-layer coverage that complements existing process-creation detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log ingested into Chronicle. Relevant operations include AddressBook, GlobalAddressList, OAB (Offline Address Book), and EWS/Graph directory queries normalised to USER_RESOURCE_ACCESS."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate mail clients performing autodiscover or OAB sync, HR/IT tooling that reads the directory for provisioning, approved third-party integrations using the Graph API to enumerate users."
    tuning_guidance = "Add known service principal identifiers to %global_allowed_cloud_principals and known automation account userids to %global_allowed_service_accounts. Raise the threshold or narrow the resource name regex if HR/provisioning tools generate volume."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target resource must reference a GAL, address book, OAB, or directory listing object.
    // Covers Exchange Online OAB download paths, EWS address book operations,
    // Graph API /users enumeration, and Workspace Directory API paths.
    $cloud.target.resource.name = /(?i)(globaladdresslist|global.address.list|addressbook|address.book|offline.address|oab|\/users\?|directory\.list|directory\/v1\/users|people\/v1\/people:listDirectoryPeople)/ nocase

    // Restrict to authenticated user sessions - exclude anonymous or system-internal access.
    $cloud.principal.user.userid != ""

    // Exclude known-good service principals and automation accounts.
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $accessed_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
