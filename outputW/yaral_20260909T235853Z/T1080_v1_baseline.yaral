/*
  MITRE Technique : T1080 - Taint Shared Content
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:33:16.905073+00:00
  Reference       : https://attack.mitre.org/techniques/T1080
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1080_001_Taint_Shared_Content_Network_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable writes or uploads to shared storage paths (NFS, SMB, WebDAV, internal file shares) that may indicate tainted shared content delivery for lateral movement. Looks for HTTP PUT/POST or large outbound flows to internal file-sharing ports from non-approved sources."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1080"
    mitre_technique_name = "Taint Shared Content"
    log_prerequisites = "Requires firewall or proxy logs normalised to Chronicle UDM NETWORK_HTTP or NETWORK_FLOW events. HTTP method must be populated in network.http.method."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate file synchronisation tools (rsync over HTTP, backup agents), authorised DevOps CI/CD pipelines pushing artefacts to internal repositories, approved remote management tooling writing to shared mounts."
    tuning_guidance = "Add approved source addresses to %global_allowed_mgmt_sources. Add approved internal file-share domains or hostnames to %global_allowed_domains. Narrow target.port to the specific ports used in your environment if NFS/SMB are not exposed on standard ports."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"

    // HTTP write methods used to push content to shared storage (WebDAV, internal repos, file servers)
    (
      $net.network.http.method = "PUT" or
      $net.network.http.method = "POST" or
      $net.network.http.method = "MKCOL" or
      $net.network.http.method = "COPY" or
      $net.network.http.method = "MOVE"
    )

    // Target URL paths indicative of shared storage locations on Linux-hosted services
    // e.g. /share/, /mnt/, /nfs/, /smb/, /files/, /uploads/, /repo/, /svn/, /git/
    $net.target.url = /(?i)\/(share|mnt|nfs|smb|cifs|files|upload|uploads|repo|repos|svn|git|artifacts|artefacts|common|public|shared)\// nocase

    // Destination must be internal (not external CDN or internet)
    // Exclude known-good internal domains
    not $net.target.hostname in %global_allowed_domains

    // Exclude approved source addresses (scanners, backup, mgmt)
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

    // Exclude approved service accounts or automation principals if userid is populated
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1080")
    $primary_entity = array_distinct($net.principal.ip)
    $target_url = array_distinct($net.target.url)
    $http_method = array_distinct($net.network.http.method)
    $target_host = array_distinct($net.target.hostname)

  condition:
    $net
}
