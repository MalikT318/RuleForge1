/*
  MITRE Technique : T1480.001 - Environmental Keying
  Tactic(s)       : Stealth
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:53:02.047412+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Environmental_Keying_Recon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process command lines consistent with environmental keying reconnaissance - collecting target-specific values (domain membership, IP addresses, volume serial numbers, system UUIDs, installed software) that adversaries use to derive cryptographic keys for conditionally-executing payloads. A single process querying multiple environment-fingerprinting sources in one command line is a strong indicator of guardrail implementation."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1480.001"
    mitre_technique_name = "Execution Guardrails: Environmental Keying"
    log_prerequisites = "Requires EDR process telemetry with full command-line capture, or Sysmon Event ID 1. Command-line logging must be enabled in Windows Security audit policy (Event 4688) or equivalent EDR."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate asset inventory scripts, SCCM/WMI-based hardware auditing, IT helpdesk diagnostic tools, software licensing checks that query volume serial or domain membership."
    tuning_guidance = "Add known asset-inventory or software-deployment parent processes to %global_allowed_admin_tools. Add authorised script-execution hosts to %global_allowed_script_hosts. Narrow scope by requiring the parent process to be an Office application, browser, or document renderer for higher fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target scripting and query engines commonly used to collect environmental values
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|cmd|mshta|wmic)\.exe$/ nocase

    // Match command lines that probe multiple environment-fingerprinting sources.
    // Each pattern targets a distinct class of environmental value used for key derivation.
    (
      // Domain membership and AD environment
      $proc.target.process.command_line = /NetBIOS|DomainName|Win32_ComputerSystem|UserDomain|USERDOMAIN|LOGONSERVER/ nocase
      or
      // Volume serial number - classic Gauss-style keying
      $proc.target.process.command_line = /VolumeSerialNumber|vol\s+[a-zA-Z]:/ nocase
      or
      // Hardware UUID / BIOS serial - device-specific keying
      $proc.target.process.command_line = /Win32_BIOS|Win32_ComputerSystemProduct|UUID|SerialNumber/ nocase
      or
      // Network adapter MAC or IP - network-environment keying
      $proc.target.process.command_line = /MACAddress|Win32_NetworkAdapterConfiguration|IPAddress|ipconfig/ nocase
      or
      // Installed software enumeration - software-version keying
      $proc.target.process.command_line = /Win32_Product|HKLM.*SOFTWARE.*DisplayVersion|Get-WmiObject.*software/ nocase
      or
      // System time or locale - time-based keying
      $proc.target.process.command_line = /Win32_TimeZone|Get-Date.*ticks|GetSystemTime|LocaleID/ nocase
    )

    // Combine with encoded or obfuscated execution, which is common when
    // the collected value is immediately used to derive a decryption key
    (
      $proc.target.process.command_line = /\-[Ee][Nn][Cc]/ nocase
      or $proc.target.process.command_line = /\-[Ee][Nn][Cc][Oo][Dd][Ee][Dd][Cc][Oo][Mm][Mm][Aa][Nn][Dd]/ nocase
      or $proc.target.process.command_line = /FromBase64String/ nocase
      or $proc.target.process.command_line = /\[Convert\]::/ nocase
      or $proc.target.process.command_line = /iex\s*\(/ nocase
      or $proc.target.process.command_line = /Invoke-Expression/ nocase
      or $proc.target.process.command_line = /\-[Ww]indow[Ss]tyle\s+[Hh]idden/ nocase
    )

    // Exclude known-good administrative and security tooling
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1480.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $suspicious_cmdline = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
