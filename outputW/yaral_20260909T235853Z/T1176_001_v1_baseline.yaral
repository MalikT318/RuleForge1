/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:42:56.769286+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Malicious_Browser_Extension_Install {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious browser extension installation on Windows by monitoring file creation events in Chromium-based and Firefox browser extension directories. Adversaries silently install malicious extensions by dropping files into extension profile directories or modifying browser preference files. This rule targets the file-system mechanism that all browser extension installs depend on."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Browser Extensions"
    log_prerequisites = "Requires EDR file telemetry (e.g., Sysmon Event ID 11 or equivalent) normalised to UDM FILE_CREATION. The creating process must be populated in principal.process.file.full_path."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate browser extension installs by end users via the official Chrome Web Store or Firefox Add-ons site; enterprise-managed extension deployments via GPO or MDM; browser auto-updates installing bundled extensions."
    tuning_guidance = "Add approved software deployment and browser management processes to %global_allowed_admin_tools. Add known-good extension installer parent processes to the exclusion list. Scope to high-value asset groups if noise is excessive in environments with frequent user-driven extension installs."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target: extension manifest or packed extension dropped into a browser extension directory
    // Covers Chromium-based (Chrome, Edge, Brave) and Firefox profile extension paths
    $file.target.file.full_path = /(?i)\\AppData\\(Local|Roaming)\\.*\\(User Data|Profiles)\\.*\\Extensions\\[a-z]{32}\\/ nocase

    // Also match Firefox extension directories and packed .xpi/.crx drops
    $file.target.file.full_path = /(?i)(manifest\.json|\.crx|\.xpi|Secure Preferences|Preferences)$/

    // The creating process is NOT the browser itself performing a legitimate store install
    // and NOT an approved admin/deployment tool
    not $file.principal.process.file.full_path = /(?i)\\(chrome|msedge|brave|firefox|chromium)\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good software deployment and update mechanisms
    not $file.principal.process.file.full_path = /(?i)\\(GoogleUpdate|MicrosoftEdgeUpdate|BraveUpdate|setup|installer)\.exe$/

    // Exclude backup processes that may touch these paths
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Must have a hostname to anchor the alert
    $file.principal.hostname != ""

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $extension_path = array_distinct($file.target.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
