/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:43:48.963141+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_006_Linux_Log_File_Truncation_Or_Zeroing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file-level evidence of Linux system log truncation or zeroing. Attackers clear logs by truncating files to zero bytes or overwriting them with empty content. This rule fires on FILE_MODIFICATION events where a known system log file under /var/log/ is written, providing coverage at the artifact layer rather than the command-line layer."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1485.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry normalised to UDM FILE_MODIFICATION events. Auditd rules must include -w /var/log -p wa to capture writes to log files."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Log rotation daemons (logrotate, rsyslog) that truncate and recreate log files as part of scheduled rotation. Backup agents reading or touching log files. Monitoring agents that write state files under /var/log/."
    tuning_guidance = "Add the process paths of authorised log rotation and backup agents to %global_allowed_backup_processes. If logrotate runs under a known service account, add that account to %global_allowed_service_accounts. Consider narrowing the rule to off-hours using timestamp.get_hour() if log rotation is strictly scheduled."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/var\/log\// nocase
    $file.target.file.full_path = /\/(messages|secure|auth\.log|syslog|kern\.log|cron(\.log)?|wtmp|btmp|utmp|lastlog|audit\/audit\.log|httpd\/access_log|httpd\/error_log|nginx\/access\.log|nginx\/error\.log|dpkg\.log|faillog|mail\.log|maillog|daemon\.log|debug|user\.log)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1485.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_log_file = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
