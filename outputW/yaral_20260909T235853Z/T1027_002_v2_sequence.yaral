/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:50:00.175823+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Packed_Binary_Written_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a packed or compressed binary written to a suspicious staging directory (e.g. /tmp, /dev/shm, /var/tmp) followed by execution of that same file within a short window. This pattern is consistent with T1027.002 Software Packing, where adversaries drop a packed payload and immediately execute it in memory after decompression. The rule does not rely on command-line matching and is additive to existing process-creation detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires Linux EDR or auditd telemetry producing FILE_CREATION and PROCESS_LAUNCH UDM events with target.file.full_path and target.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate software installers that unpack to /tmp before executing (e.g. self-extracting archives from vendors). Build pipelines that compile and immediately test binaries in temp directories. Package managers staging files during installation."
    tuning_guidance = "Add known-good installer parent processes to %global_allowed_admin_tools. Add authorised build or CI/CD service accounts to %global_allowed_service_accounts. Narrow the staging path regex if /tmp activity is too noisy in a specific environment."

  events:
    // Event 1: A file is written to a world-writable or volatile staging directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(?:tmp|var\/tmp|dev\/shm|run\/shm)\// nocase
    // Exclude known-good backup and admin tooling from triggering the file write side
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    // Capture the written file path as the join key
    $file.target.file.full_path = $staged_path

    // Event 2: The same path is subsequently executed as a process
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(?:tmp|var\/tmp|dev\/shm|run\/shm)\// nocase
    // Exclude authorised service accounts that legitimately run from temp paths
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    // Join on the exact file path that was written then executed
    $proc.target.process.file.full_path = $staged_path

    // Enforce chronological ordering: file must be written before it is executed
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $staged_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $executing_hostname = array_distinct($proc.principal.hostname)
    $staged_file_paths = array_distinct($staged_path)

  condition:
    $file and $proc
}
