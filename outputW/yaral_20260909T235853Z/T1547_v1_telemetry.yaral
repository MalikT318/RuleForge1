/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Network Devices
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:08:58.862472+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_NetworkDevice_Autostart_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of boot or startup configuration on network devices via management-plane telemetry. Adversaries may alter startup-config, boot statements, or autostart references to persist across reboots. This rule targets the resulting SETTING_MODIFICATION event rather than the CLI command that caused it, providing coverage at a layer harder to evade than command-line logging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires network device management-plane syslog or SNMP trap telemetry normalised to Chronicle UDM SETTING_MODIFICATION events. Cisco IOS/NX-OS, Juniper Junos, Arista EOS, and Palo Alto PAN-OS all emit configuration-change syslog messages that Chronicle parsers normalise to this event type."
    platform = "Network Devices"
    log_source = "macos_endpoint"
    false_positives = "Authorised network engineers performing planned maintenance, automated configuration management tools (Ansible, Terraform, NAPALM), scheduled backup-and-restore operations, and vendor-initiated firmware upgrade procedures that rewrite startup config."
    tuning_guidance = "Add known automation service account identifiers to %global_allowed_service_accounts. Add approved management source addresses to %global_allowed_mgmt_sources. Consider narrowing the target.resource.name regex to the specific config artifact names used in your environment (e.g., startup-config, boot.cfg, juniper.conf)."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"

    // Target the startup / boot configuration artifact by name.
    // Network devices expose the modified object name in target.resource.name
    // after Chronicle UDM normalisation of syslog config-change messages.
    // Matches: startup-config, startup_config, boot.cfg, boot-config,
    //          juniper.conf (Junos commit), system.cfg, running-to-startup, etc.
    $cfg.target.resource.name = /(?i)(startup[\-_]config|boot[\-_]config|boot\.cfg|system\.cfg|juniper\.conf|running[\-_]to[\-_]startup|autostart|init\.cfg|nvram:startup)/

    // Restrict to management-plane protocols used to push config changes.
    // SSH (22), NETCONF (830), RESTCONF (443), TFTP (69), SCP (22 shared),
    // HTTPS management (443), and legacy Telnet (23).
    $cfg.network.application_protocol = /(?i)(ssh|netconf|restconf|tftp|scp|https|telnet)/

    // Exclude changes originating from approved management source addresses.
    not $cfg.principal.ip in %global_allowed_mgmt_sources

    // Exclude known automation and service accounts performing routine config pushes.
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved scanner or security tooling sources.
    not $cfg.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $modified_config_object = array_distinct($cfg.target.resource.name)
    $actor_user = array_distinct($cfg.principal.user.userid)
    $source_ip = array_distinct($cfg.principal.ip)
    $management_protocol = array_distinct($cfg.network.application_protocol)

  condition:
    $cfg
}
