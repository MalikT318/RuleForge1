/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:44:47.480834+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_NetDev_Firewall_Modify_Then_New_Flow {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a firewall policy modification on a network device followed within 10 minutes by a new outbound or inbound flow on a non-standard port, suggesting the rule change opened a previously blocked communication path. This is additive coverage over process-launch detections and targets the network-observable consequence of firewall tampering."
    mitre_tactic    = "Defense Evasion"
    mitre_technique = "T1562.004"
    mitre_technique_name = "Impair Defenses: Disable or Modify System Firewall"
    log_prerequisites = "Requires network device syslog or management-plane logs normalised to UDM SETTING_MODIFICATION, and firewall flow/connection logs normalised to UDM NETWORK_FLOW or NETWORK_CONNECTION. Both must share a principal.hostname or principal.ip that identifies the network device."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Authorised network engineers applying approved change-management firewall updates; automated orchestration systems pushing policy; scheduled maintenance windows; vulnerability scanner probes from approved sources."
    tuning_guidance = "Add authorised management accounts to %global_allowed_admin_users, approved scanner sources to %global_allowed_scanners, and approved management source addresses to %global_allowed_mgmt_sources. Narrow the non-standard port filter to the ports most relevant to your environment."

  events:
    // Event 1: A firewall policy or ACL setting is modified on the network device
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname != ""
    // Must reference a firewall-related setting - filter on common syslog keywords
    // normalised into the security_result or target.resource fields
    (
      $cfg.target.resource.name = /(?i)(firewall|acl|access.list|policy|rule|filter|permit|deny|iptables|nftables|pf|ipfw)/
      or
      $cfg.security_result.summary = /(?i)(firewall|acl|access.list|policy|rule|filter|permit|deny)/
    )
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.ip in %global_allowed_mgmt_sources
    $cfg.principal.hostname = $device_hostname

    // Event 2: A network flow originates from or through the same device on a
    // non-standard port (not 80, 443, 22, 23, 25, 53, 161, 162, 179, 443, 514)
    // shortly after the configuration change
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $device_hostname
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    // Exclude well-known management and data-plane ports
    $flow.target.port != 22
    $flow.target.port != 23
    $flow.target.port != 25
    $flow.target.port != 53
    $flow.target.port != 80
    $flow.target.port != 123
    $flow.target.port != 161
    $flow.target.port != 162
    $flow.target.port != 179
    $flow.target.port != 443
    $flow.target.port != 514
    $flow.target.port != 636
    $flow.target.port != 830
    $flow.target.port > 0

    // Chronological ordering: config change must precede the suspicious flow
    $cfg.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_hostname over 10m

  outcome:
    $risk_score          = max(80)
    $mitre_technique_id  = array_distinct("T1562.004")
    $primary_entity      = array_distinct($device_hostname)
    $modified_resource   = array_distinct($cfg.target.resource.name)
    $modifying_user      = array_distinct($cfg.principal.user.userid)
    $suspicious_dest_ips = array_distinct($flow.target.ip)
    $suspicious_ports    = array_distinct($flow.target.port)
    $flow_count          = count($flow.metadata.event_timestamp.seconds)

  condition:
    $cfg and $flow
}
