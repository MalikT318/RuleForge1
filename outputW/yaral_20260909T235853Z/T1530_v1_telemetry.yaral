/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:25:02.145928+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_001_CloudStorage_BulkResourceAccess_OfficeSuite {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Threshold"
    severity        = "High"
    description     = "Detects a single user accessing an unusually high volume of cloud storage objects (OneDrive / SharePoint / Google Drive) within a short window. Bulk enumeration or download of cloud-stored files is a strong indicator of T1530 data collection activity, and is captured at the resource-access audit layer rather than at the command line, providing coverage that process-creation rules cannot."
    mitre_tactic    = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Requires Microsoft 365 Unified Audit Log (UAL) ingested into Chronicle. Relevant operations: FileAccessed, FileDownloaded, FileSyncDownloadedFull, FileAccessedExtended, or equivalent Google Workspace Drive audit events normalised to USER_RESOURCE_ACCESS."
    platform        = "Office Suite"
    log_source      = "m365"
    false_positives = "Backup agents, migration tooling, sync clients performing initial sync, and power users doing legitimate bulk downloads. Tune using %global_allowed_backup_processes for service accounts and %global_allowed_service_accounts for automation identities."
    tuning_guidance = "Raise the threshold (currently 50 events per 10 minutes) if sync clients generate noise. Add known migration or backup service account identifiers to %global_allowed_service_accounts. Add known scanner identities to %global_allowed_scanners."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"

    // Target must be a cloud storage resource path (OneDrive, SharePoint, Drive)
    $access.target.resource.name = /(?i)(onedrive|sharepoint|drive\.google|sites\/|personal\/|\/documents\/|\/shared documents\/)/

    // Capture the acting user
    $access.principal.user.userid = $userid

    // Exclude known-good service and automation accounts
    not $access.principal.user.userid in %global_allowed_service_accounts

    // Exclude known backup processes accessing storage
    not $access.principal.application in %global_allowed_backup_processes

    // Exclude known cloud principals (e.g., approved sync or migration apps)
    not $access.principal.user.userid in %global_allowed_cloud_principals

  match:
    $userid over 10m

  outcome:
    $risk_score        = max(72)
    $mitre_technique_id = array_distinct("T1530")
    $primary_entity    = array_distinct($userid)
    $accessed_resources = array_distinct($access.target.resource.name)
    $source_ips        = array_distinct($access.principal.ip)
    $event_count       = count($access.metadata.event_timestamp.seconds)

  condition:
    // Fire when a single user touches more than 50 distinct resource-access
    // events in the 10-minute window — indicative of bulk enumeration or download
    #access > 50
}
