/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:17:53.760917+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Firewall_Rule_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi firewall rules, a common result of esxcli abuse to enable persistence or disable security controls."
    mitre_tactic = "Execution, Defense Evasion"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "Requires ESXi hostd or vmkernel logs forwarded to Chronicle with firewall configuration change events."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorized hypervisor maintenance, security hardening by infrastructure teams, automated configuration management tools."
    tuning_guidance = "Add approved service accounts performing firewall changes to %global_allowed_service_accounts. Add approved management sources to %global_allowed_mgmt_sources."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.target.resource.name = /firewall/ nocase or
      $setting.target.resource.attribute.labels.key = /firewall/ nocase or
      $setting.target.resource.attribute.labels.value = /firewall/ nocase or
      $setting.about.resource.name = /firewall/ nocase
    )
    (
      $setting.target.resource.name = /ruleset/ nocase or
      $setting.target.resource.attribute.labels.key = /ruleset/ nocase or
      $setting.target.resource.attribute.labels.value = /ruleset/ nocase or
      $setting.about.resource.name = /ruleset/ nocase or
      $setting.target.resource.name = /allowedip/ nocase or
      $setting.target.resource.attribute.labels.key = /allowedip/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($setting.principal.hostname)

  condition:
    $setting
}
