/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:07:11.537097+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_Kerberos_Ticket_Theft_Linux {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects process launches on Linux that indicate Kerberos ticket theft or forging activity. Covers use of klist, kinit, kvno, and access to ccache/keytab credential stores from unexpected parent processes or locations. Adversaries abuse Kerberos on Linux (MIT Kerberos, Heimdal, SSSD) to steal TGTs/service tickets for lateral movement."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to UDM PROCESS_LAUNCH events. Auditd rules should capture execve syscalls."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate Kerberos administration by sysadmins, automated service account kinit renewals, SSSD/PAM daemons performing ticket refresh, backup agents accessing keytab files."
    tuning_guidance = "Add authorised service account usernames to %global_allowed_service_accounts. Add approved admin tooling paths to %global_allowed_admin_tools. Narrow the parent process regex to exclude known-good daemons (sssd, pam_krb5) if they generate noise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Match Kerberos tooling: klist (list tickets), kinit (obtain/renew TGT),
    // kvno (enumerate service principal versions - used in kerberoasting),
    // ktutil (keytab manipulation), kadmin (admin interface for ticket ops)
    $proc.target.process.file.full_path = /\/(klist|kinit|kvno|ktutil|kadmin|kgetcred|k5start|krenew)$/ nocase

    // Suspicious command-line patterns indicating credential harvesting:
    // - klist -e (encryption type enumeration)
    // - klist -c with explicit ccache path (targeting specific credential caches)
    // - kinit with keytab (-k -t) from non-standard paths
    // - kvno with service principal enumeration
    // - ktutil read/write keytab operations
    (
      $proc.target.process.command_line = /klist\s+.*-[ce]/ nocase or
      $proc.target.process.command_line = /klist\s+.*-c\s+\/(tmp|dev\/shm|var|proc)/ nocase or
      $proc.target.process.command_line = /kinit\s+.*-k/ nocase or
      $proc.target.process.command_line = /kvno\s+.+\// nocase or
      $proc.target.process.command_line = /ktutil/ nocase or
      $proc.target.process.command_line = /kadmin\s+.*-k/ nocase or
      $proc.target.process.command_line = /k5start|krenew/ nocase
    )

    // Suspicious parent processes: shells, scripting engines, or unknown parents
    // indicate interactive or scripted abuse rather than legitimate daemon renewal
    $proc.principal.process.file.full_path = /\/(bash|sh|zsh|dash|ksh|python[23]?|perl|ruby|node|php|lua)$/ nocase

    // Exclude known-good service accounts performing automated Kerberos operations
    not $proc.principal.user.userid in %global_allowed_service_accounts

    // Exclude approved administrative tooling invoking Kerberos utilities
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($proc.principal.hostname)
    $triggering_user = array_distinct($proc.principal.user.userid)
    $triggering_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
