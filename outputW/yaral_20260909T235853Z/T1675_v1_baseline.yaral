/*
  MITRE Technique : T1675 - ESXi Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:29:11.683057+00:00
  Reference       : https://attack.mitre.org/techniques/T1675
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1675_ESXi_Guest_Operations_API_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of guest operations via ESXi management APIs (StartProgramInGuest, ListProcessesInGuest, InitiateFileTransferFromGuest) which may indicate remote command execution on hosted VMs."
    mitre_tactic = "Execution"
    mitre_technique = "T1675"
    mitre_technique_name = "ESXi Administration Command"
    log_prerequisites = "Requires ESXi hostd logs with guest operations API calls."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate vCenter automation, backup solutions using guest operations APIs, monitoring tools querying VM processes, authorized orchestration platforms."
    tuning_guidance = "Add approved management sources to %global_allowed_mgmt_sources and authorized service principals to %global_allowed_cloud_principals."

  events:
    $api.metadata.event_type = "PROCESS_LAUNCH"
    (
      $api.target.process.command_line = /StartProgramInGuest/ nocase or
      $api.target.process.command_line = /ListProcessesInGuest/ nocase or
      $api.target.process.command_line = /InitiateFileTransferFromGuest/ nocase or
      $api.target.process.command_line = /InitiateFileTransferToGuest/ nocase or
      $api.target.process.command_line = /ListFilesInGuest/ nocase or
      $api.target.process.command_line = /DeleteFileInGuest/ nocase or
      $api.target.process.command_line = /CreateTemporaryFileInGuest/ nocase
    )
    not $api.principal.ip in %global_allowed_mgmt_sources
    not $api.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1675")
    $primary_entity = array_distinct($api.target.hostname)

  condition:
    $api
}
