/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:19:16.262055+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_Network_Device_Config_Dump {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects potential network device configuration dump activity via SNMP (UDP/161, UDP/162) or Cisco Smart Install (TCP/4786) from sources outside approved management address space. Adversaries abuse these protocols to retrieve running or startup configurations from network devices."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Network Device Configuration Dump: Network Device Configuration Dump"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs with source IP, destination port, and protocol fields normalised into UDM NETWORK_CONNECTION or NETWORK_FLOW events."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network management systems (NMS), SNMP polling from monitoring platforms, legitimate Smart Install deployments. Add approved management source IPs to %global_allowed_mgmt_sources."
    tuning_guidance = "Populate %global_allowed_mgmt_sources with all authorised NMS, SNMP poller, and management-plane source addresses. Consider narrowing to specific destination subnets containing network infrastructure if the environment is well-segmented."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Target the management-plane protocols used to dump device configurations:
    // UDP 161  - SNMP GET/GETBULK (primary config retrieval vector)
    // UDP 162  - SNMP Trap (can be abused to exfiltrate config data)
    // TCP 4786 - Cisco Smart Install (unauthenticated config retrieval)
    (
      $net.target.port = 161 or
      $net.target.port = 162 or
      $net.target.port = 4786
    )

    // Exclude traffic originating from approved management sources
    not $net.principal.ip in %global_allowed_mgmt_sources

    // Exclude internal-to-internal traffic that matches approved scanner profiles
    not $net.principal.ip in %global_allowed_scanners

    // Exclude traffic sourced from internal RFC1918 space that is already
    // covered by the management allowlist; external sources are the primary
    // concern but internal rogue hosts are also in scope if not allowlisted
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ip = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
