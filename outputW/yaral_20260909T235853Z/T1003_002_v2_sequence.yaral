/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:24:21.241378+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Registry_Export_Then_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects the two-stage SAM database extraction pattern: a process opens or reads the HKLM\\SAM or HKLM\\SYSTEM registry hive (registry read/modification event), followed by creation of a file consistent with a saved hive dump on the same host within 10 minutes. This covers tooling that uses the Windows Registry backup path (reg save, Volume Shadow Copy, or direct hive access) rather than command-line invocation alone."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires EDR or Sysmon telemetry producing REGISTRY_MODIFICATION/REGISTRY_CREATION events for HKLM\\SAM and HKLM\\SYSTEM hive access, and FILE_CREATION events. Both event types must be normalised into UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised backup software performing VSS-based system state backups, Windows Server Backup, SCCM/Intune imaging agents, and some AV/EDR products that snapshot registry hives for integrity monitoring."
    tuning_guidance = "Add backup and imaging process paths to %global_allowed_backup_processes. Add authorised service accounts that perform system-state backups to %global_allowed_service_accounts. Narrow the file name regex if the environment uses a known naming convention for legitimate hive exports."

  events:
    // Event 1: A process accesses the SAM or SYSTEM registry hive.
    // reg.exe, ntdsutil, or any tool performing a hive save will trigger
    // a REGISTRY_MODIFICATION or REGISTRY_CREATION event against these keys.
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\REGISTRY\\MACHINE\\(SAM|SYSTEM|SECURITY)($|\\)/  nocase
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    // Event 2: A file is created on the same host that matches common hive
    // dump naming patterns (sam, system, security, ntds with optional
    // extensions such as .bak, .hiv, .sav, or no extension).
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\\|\/)(sam|system|security|ntds)(\.bak|\.hiv|\.sav|\.dmp|\.bin|\.dat|\.out)?$/
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Chronological ordering: registry access precedes or coincides with file creation.
    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($hostname)
    $registry_keys_accessed = array_distinct($reg.target.registry.registry_key)
    $dumped_file_paths = array_distinct($file.target.file.full_path)
    $accessing_process = array_distinct($reg.principal.process.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $file
}
