/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:04:05.180404+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Component_Firmware_Write_Tool_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects execution of known firmware flashing and low-level hardware access utilities that are the primary OS-visible mechanism for T1542.002 Component Firmware attacks. Adversaries use these tools to write malicious firmware to drives, NICs, BMCs, or other peripheral components. Detection targets the process launch of firmware update utilities invoked outside of expected administrative or vendor update contexts."
    mitre_tactic = "Persistence, Defense Evasion"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Requires EDR process launch telemetry with command-line arguments captured (CrowdStrike, Defender for Endpoint, SentinelOne, or Sysmon Event ID 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate vendor firmware update utilities run by IT during scheduled maintenance (Dell OMSA, HP SSA, Lenovo System Update, Western Digital Dashboard). OEM update agents running from vendor-signed update paths. Storage controller firmware updates during provisioning."
    tuning_guidance = "Add authorised firmware update parent processes (e.g., vendor update agents, SCCM, Intune management processes) to %global_allowed_admin_tools. Scope exclusions to known-good parent process paths rather than suppressing the entire rule. Consider restricting to non-business-hours alerts if maintenance windows are predictable."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Target firmware flashing and low-level hardware access tool patterns.
    // Matches common firmware update CLI utilities by behavioural naming convention
    // rather than exact binary names, surviving minor renames.
    // Covers: hdparm (disk firmware), nvme-cli, fwupd, flashrom equivalents,
    // IPMI/BMC tools (ipmitool, ipmiutil), and generic firmware flash patterns.
    (
      $proc.target.process.file.full_path = /(?i)\\(hdparm|nvmecli|nvme|fwupdate|fwupdmgr|flashrom|ipmitool|ipmiutil|ipmiview|bmctool|hponcfg|conrep|syscfg|afuwin|afudos|meinfo|fptw|fpt|intelflash|afulnx|afuefi|fwflash|fwburn|firmwareupdate|fwupd)\.exe$/
      or
      $proc.target.process.file.full_path = /(?i)\\(wdckit|seachest|seatools|hdsentinel|crystaldiskinfo|smartctl|smartmontools)\.exe$/
    )

    // Require at least one firmware-write-indicative argument to reduce noise
    // from read-only diagnostic invocations of the same tools.
    // Covers write, flash, update, burn, program, erase, download operations.
    $proc.target.process.command_line = /(?i)(--write|--flash|--update|--burn|--program|--erase|--download|\/write|\/flash|\/update|\/burn|\/program|\/erase|\/download|-w\s|-f\s|write\s|flash\s|update\s|burn\s|program\s|erase\s)/

    // Exclude authorised administrative and vendor tooling paths
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts running scheduled vendor updates
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $initiating_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
