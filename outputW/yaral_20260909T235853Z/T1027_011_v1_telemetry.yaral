/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:56:47.635147+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Registry_Binary_Data_Storage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of registry values containing large binary data, indicating potential fileless payload storage in the Windows Registry."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires EDR registry telemetry or Sysmon Event ID 13 (Registry value set)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software storing configuration or cached data in registry binary values (browser profiles, application settings, COM registration). Windows Update and system components may write large binary blobs to registry during normal operation."
    tuning_guidance = "Add known-good parent processes to %global_allowed_admin_tools. Exclude specific registry paths used by approved applications. Monitor for unusual parent processes or registry locations outside standard software installation paths."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Software\\/ nocase or
      $reg.target.registry.registry_key = /\\CurrentVersion\\/ nocase or
      $reg.target.registry.registry_key = /HKCU\\/ nocase or
      $reg.target.registry.registry_key = /HKLM\\/ nocase
    )
    not $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\Installer/ nocase
    not $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\Component Based Servicing/ nocase
    not $reg.target.registry.registry_key = /\\Classes\\CLSID/ nocase
    not $reg.target.registry.registry_key = /\\Policies\\Microsoft\\Windows\\Installer/ nocase
    $reg.target.registry.registry_value_data = /(?i)^[a-f0-9]{200,}/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\svchost\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\msiexec\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\explorer\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($reg.principal.hostname)

  condition:
    $reg
}
