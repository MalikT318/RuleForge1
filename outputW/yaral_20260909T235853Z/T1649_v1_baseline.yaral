/*
  MITRE Technique : T1649 - Steal or Forge Authentication Certificates
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T02:24:40.034198+00:00
  Reference       : https://attack.mitre.org/techniques/T1649
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1649_Steal_Forge_Auth_Certificates_IDP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects suspicious certificate-based authentication events in identity provider logs that may indicate stolen or forged authentication certificates. Triggers on successful logins using certificate authentication from unexpected or non-compliant contexts, or where the authentication method is certificate-based but the principal lacks expected device compliance signals."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1649"
    mitre_technique_name = "Steal or Forge Authentication Certificates"
    log_prerequisites = "Requires identity provider audit and sign-in logs (Entra ID, Okta, ADFS) normalised to UDM USER_LOGIN events with authentication method details populated in security_result or extensions fields."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate certificate-based authentication from managed devices, service accounts using certificate auth, PKI-integrated SSO flows, smart card users."
    tuning_guidance = "Add known service accounts performing certificate auth to %global_allowed_service_accounts. Add approved certificate-auth source IPs to %global_allowed_mgmt_sources. Scope to high-value user populations or privileged roles to reduce noise."

  events:
    $auth.metadata.event_type = "USER_LOGIN"

    // Certificate-based authentication method - identity providers normalise this
    // into the authentication details. Match on certificate or smart-card auth signals.
    $auth.extensions.auth.auth_details = /(?i)(certificate|cert\-based|x509|smartcard|smart.card|pki|client.cert)/

    // Exclude known-good service accounts that legitimately use certificate auth
    not $auth.principal.user.userid in %global_allowed_service_accounts

    // Exclude known-good administrative users expected to use certificate auth
    not $auth.principal.user.userid in %global_allowed_admin_users

    // Exclude known management and PKI infrastructure source addresses
    not $auth.principal.ip in %global_allowed_mgmt_sources

    // Exclude internal RFC1918 sources (managed corporate devices on internal network)
    // External certificate auth is higher risk - forged certs used from outside
    not $auth.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1649")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ip = array_distinct($auth.principal.ip)
    $target_resource = array_distinct($auth.target.resource.name)
    $auth_method = array_distinct($auth.extensions.auth.auth_details)

  condition:
    $auth
}
