/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:06:50.345253+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Process_Hollowing_Handle_Request {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects PROCESS_OPEN events where a process requests a combination of memory-write and thread-control access rights against a target process whose image is a common Windows system binary. Process hollowing requires the injector to open a handle to the victim process with at minimum PROCESS_VM_WRITE and PROCESS_SUSPEND_RESUME (or equivalent all-access masks) before unmapping and rewriting its memory. Detecting the handle request rather than the spawning command line provides a second, harder-to-evade detection layer."
    mitre_tactic         = "Defense Evasion, Privilege Escalation"
    mitre_technique      = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites    = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised into Chronicle UDM PROCESS_OPEN events. The access mask field must be populated (target.process.access_mask or equivalent). Sysmon must be configured with a ProcessAccess rule that captures GrantedAccess values."
    platform             = "Windows"
    log_source           = "windows_endpoint"
    false_positives      = "Debuggers (WinDbg, x64dbg, Visual Studio), legitimate process monitors (Process Explorer, Process Hacker), EDR/AV agents opening handles to inspect child processes, JIT compilers, and some backup or virtualisation agents."
    tuning_guidance      = "Add known-good parent process paths (debuggers, security tools) to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow the target process list if the victim binary set generates too many false positives in a specific environment. Consider raising the threshold by requiring the principal process to reside outside System32."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // The injector (principal) must NOT itself be a known system binary in System32
    // to reduce noise from legitimate OS-level handle operations.
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\/ 
    not $open.principal.process.file.full_path = /(?i)\\windows\\syswow64\//

    // The victim (target) is a common hollowing target: a legitimate Windows binary
    // that provides a plausible cover process. Attackers choose these because they
    // are expected to be running and blend into normal process lists.
    $open.target.process.file.full_path = /(?i)\\(svchost|lsass|explorer|rundll32|dllhost|werfault|msiexec|conhost|spoolsv|taskhost|taskhostw|sihost|RuntimeBroker|SearchIndexer|SearchHost|WmiPrvSE|csrss|winlogon|services|smss)\.exe$/

    // The access mask must include both memory-write capability and thread-manipulation
    // capability - the two rights that process hollowing cannot avoid requesting.
    // PROCESS_ALL_ACCESS (0x1fffff / 0x1f0fff on older OS), PROCESS_VM_WRITE (0x0020)
    // combined with PROCESS_SUSPEND_RESUME (0x0800) or PROCESS_VM_OPERATION (0x0008).
    // EDRs normalise these into the access_mask field; match the high-privilege patterns.
    $open.target.process.access_mask = /(?i)^(0x001f0fff|0x001fffff|0x0020|0x0028|0x0820|0x0828|0x1f0fff|0x1fffff)$/

    // Exclude the process opening a handle to itself (self-injection is a different technique).
    not $open.principal.process.pid = $open.target.process.pid

    // Exclude known-good security tooling that legitimately opens handles to system processes.
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity    = array_distinct($open.principal.hostname)
    $injector_process  = array_distinct($open.principal.process.file.full_path)
    $victim_process    = array_distinct($open.target.process.file.full_path)
    $access_mask_seen  = array_distinct($open.target.process.access_mask)

  condition:
    $open
}
