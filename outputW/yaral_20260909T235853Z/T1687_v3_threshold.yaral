/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 3  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:47:57.674528+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_003_Repeated_Auth_Failures_Defense_Impairment {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a high volume of authentication failures from a single user within a short window. Adversaries exploiting identity provider vulnerabilities or abusing authentication flows to impair MFA enforcement, lock out defenders, or probe for weaknesses in security controls may generate repeated failed login attempts. Individual failures are benign; sustained bursts from one account indicate potential defense impairment or credential-based exploitation."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires identity provider sign-in audit logs normalised to UDM USER_LOGIN with security_result.action = FAIL or equivalent failure outcome."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Misconfigured service accounts with stale credentials, automated integration tests, users locked out after password change, legitimate MFA prompt loops during SSO federation issues."
    tuning_guidance = "Raise the threshold count if the environment has noisy service accounts. Add expected automation accounts to %global_allowed_service_accounts. Consider narrowing to external-origin logins only by excluding %rfc1918_internal source addresses."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.action = "FAIL"
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %rfc1918_internal
    $auth.principal.user.userid = $userid

  match:
    $userid over 10m

  outcome:
    $risk_score = max(
      if(count($auth.metadata.id) >= 50, 90,
      if(count($auth.metadata.id) >= 30, 75,
      65))
    )
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $failed_login_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $target_resources = array_distinct($auth.target.resource.name)

  condition:
    #auth >= 20
}
