/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:27:24.127763+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Mem_Maps_File_Read {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects file-read access to /proc/<PID>/mem or /proc/<PID>/maps by a process other than the process that owns the PID. Adversaries with root privileges read these pseudo-files to extract credentials from memory of running processes (e.g., browsers, SSH agents, sudo). This rule fires on the FILE_READ artifact rather than the command line, providing coverage that evades process-creation log suppression."
    mitre_tactic    = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Linux EDR or auditd with file-read (openat/read) syscall auditing enabled. Auditd rules: -a always,exit -F arch=b64 -S openat,open -F dir=/proc -F success=1 -k proc_mem_read"
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Debuggers (gdb, strace, ltrace), legitimate memory profilers (valgrind, perf), security scanners, and some JVM/Go runtimes that inspect their own /proc entries. The %global_allowed_security_tools and %global_allowed_scanners lists should cover authorised tooling."
    tuning_guidance = "Add authorised debugging and profiling binaries to %global_allowed_security_tools. Add vulnerability scanner hosts to %global_allowed_scanners. Consider narrowing the rule to cross-process reads by comparing the reading process PID against the PID embedded in the target path using re.capture() if your EDR populates both fields."

  events:
    $file.metadata.event_type = "FILE_READ"

    // Target must be /proc/<numeric PID>/mem or /proc/<numeric PID>/maps
    // These are the two pseudo-files used for in-memory credential extraction
    $file.target.file.full_path = /\/proc\/[0-9]+\/(mem|maps)$/

    // Exclude reads where the reading process is a known-good security tool
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    // Exclude authorised scanners
    not $file.principal.hostname in %global_allowed_scanners

    // Exclude backup processes that may inspect process state
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude reads originating from /proc itself (kernel-internal references)
    // and common benign self-inspection paths
    not $file.principal.process.file.full_path = /\/usr\/lib\/(jvm|go)\// nocase

    // Exclude known safe parent paths: system monitoring daemons
    not $file.principal.process.file.full_path = /\/(usr\/bin\/(ps|top|htop|atop|pidstat|pmap)|usr\/sbin\/lsof)$/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $target_proc_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
