/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:52:55.423668+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_HTML_Smuggling_Suspicious_Download_Then_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects HTML Smuggling on Linux by correlating a suspicious HTTP response from a perimeter proxy/firewall (large payload delivered as text/html or text/plain to a writable path) followed by a process launch originating from a temporary or user-writable directory. HTML smuggling abuses JavaScript Blobs and Data URLs to deliver payloads disguised as benign MIME types, bypassing content filters. This rule joins network and process telemetry over a 5-minute window on the initiating host."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires firewall or proxy logs forwarded to Chronicle with UDM NETWORK_HTTP events including network.http.response_code, network.http.response_body_bytes, and network.http.user_agent. Also requires Linux EDR or auditd PROCESS_LAUNCH events with principal.hostname and target.process.file.full_path populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate large HTML downloads from CDNs or SaaS portals; software update mechanisms that deliver payloads via HTTP; developer tooling fetching build artifacts. Tune by adding known-good domains to %global_allowed_domains and approved source hosts to %global_allowed_script_hosts."
    tuning_guidance = "Lower response_body_bytes threshold if smuggled payloads are smaller in your environment. Add trusted external domains to %global_allowed_domains. Add known automation hosts to %global_allowed_script_hosts. Adjust the writable-path regex to match site-specific staging directories."

  events:
    // Event 1: Firewall/proxy observes a large HTTP response with a text/html or
    // text/plain content type from an external destination - characteristic of
    // HTML smuggling where the payload is embedded in a benign MIME type.
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    $net.network.http.response_body_bytes >= 500000
    (
      $net.network.http.response_code = 200 or
      $net.network.http.response_code = 201
    )
    $net.network.http.user_agent != ""
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %rfc1918_internal
    $net.principal.hostname = $hostname

    // Event 2: Within 5 minutes, a process is launched from a writable or
    // temporary directory on the same Linux host - consistent with a smuggled
    // payload being written and then executed.
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/user\/|\/home\/[^\/]+\/Downloads\/|\/home\/[^\/]+\/\.cache\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    // Chronological ordering: network download precedes process launch
    $net.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(82)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity = array_distinct($hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $launched_binaries = array_distinct($proc.target.process.file.full_path)
    $http_response_bytes = max($net.network.http.response_body_bytes)
    $initiating_users = array_distinct($proc.principal.user.userid)

  condition:
    $net and $proc
}
