/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:19:25.722716+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_WiFi_Credential_File_Read_Then_Exfil_Staging {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "High"
    description     = "Detects a two-stage Wi-Fi credential discovery pattern on Linux: a process reads NetworkManager connection profiles (which store Wi-Fi SSIDs and PSKs) and within 10 minutes a file is created in a staging location such as /tmp, /dev/shm, or /var/tmp. This combination suggests credential harvesting followed by local staging for exfiltration, and is distinct from simple command-line enumeration rules."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces PROCESS_LAUNCH events with file path context and FILE_CREATION events. Auditd rules must include -w /etc/NetworkManager/system-connections -p r and file creation watches on /tmp, /dev/shm, /var/tmp."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "NetworkManager daemon itself reading its own config on restart; backup agents reading /etc; configuration management tools (Ansible, Puppet) auditing network settings; legitimate sysadmin scripts."
    tuning_guidance = "Add NetworkManager service account and approved config-management principals to %global_allowed_service_accounts. Add approved backup processes to %global_allowed_backup_processes. Narrow the staging path regex if /tmp file creation is too noisy in your environment."

  events:
    // Event 1: a process opens/reads a NetworkManager Wi-Fi connection profile
    $open.metadata.event_type = "FILE_READ"
    $open.target.file.full_path = /\/etc\/NetworkManager\/system-connections\// nocase
    not $open.principal.process.file.full_path = /\/usr\/sbin\/NetworkManager/ nocase
    not $open.principal.user.userid in %global_allowed_service_accounts
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    $open.principal.hostname = $hostname

    // Event 2: within the window the same host creates a file in a staging directory
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|dev\/shm|var\/tmp|run\/shm)\// nocase
    not $file.principal.process.file.full_path = /\/usr\/sbin\/NetworkManager/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    // Chronological ordering: read must precede staging file creation
    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score          = max(78)
    $mitre_technique_id  = array_distinct("T1016.002")
    $primary_entity      = array_distinct($hostname)
    $reading_process     = array_distinct($open.principal.process.file.full_path)
    $reading_user        = array_distinct($open.principal.user.userid)
    $wifi_profile_read   = array_distinct($open.target.file.full_path)
    $staging_file        = array_distinct($file.target.file.full_path)
    $staging_process     = array_distinct($file.principal.process.file.full_path)

  condition:
    $open and $file
}
