/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:14:39.298956+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_JS_Script_File_Drop_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation of JavaScript-based script artifacts (JS, JSE, HTA, WSF, WSH) in suspicious locations outside of expected software installation paths. Adversaries executing JScript or JavaScript via the Windows Script Host or Internet Explorer engine frequently drop these artifacts to disk before or during execution. This rule pivots on the resulting file artifact rather than the process command line, providing coverage that is harder to evade."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires EDR or Sysmon FileCreate events normalised into UDM FILE_CREATION events with target.file.full_path and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web developers writing JS files to project directories; software installers dropping HTA setup wizards; legitimate RMM or deployment tooling writing WSF/WSH scripts; browser cache writes."
    tuning_guidance = "Add known-good parent processes (e.g. installer frameworks, IDE helpers) to %global_allowed_admin_tools. Scope exclusions to specific target directory prefixes if broad paths generate noise. Consider raising severity if the writing process is itself a script host (wscript, cscript, mshta)."

  events:
    $file.metadata.event_type = "FILE_CREATION"

    // Target file has a JavaScript-family extension used by Windows Script Host / IE engine
    $file.target.file.full_path = /\.(js|jse|hta|wsf|wsh)$/ nocase

    // Written into user-writable or temporary locations commonly abused by adversaries
    $file.target.file.full_path = /(?i)(\\Users\\[^\\]+\\(AppData\\(Local\\Temp|Roaming)|Downloads|Desktop|Documents)|\\Windows\\Temp|\\ProgramData\\|\\Temp\\)/

    // Parent process is a suspicious or unexpected writer - not a browser or IDE
    // Catch script hosts writing secondary payloads, Office apps, or LOLBins
    $file.principal.process.file.full_path = /(?i)\\(wscript|cscript|mshta|wmic|powershell|pwsh|cmd|rundll32|regsvr32|msiexec|winword|excel|powerpnt|outlook|msaccess|onenote|certutil|bitsadmin|curl|wget)\.exe$/

    // Exclude known-good administrative and deployment tooling
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    // Exclude known-good service accounts performing automated deployment
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
