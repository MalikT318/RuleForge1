/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 2  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:05:51.470658+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects PROCESS_OPEN events where a non-system process requests broad access to another process's memory space, consistent with the Extra Window Memory (EWM) injection pattern. EWM injection requires an attacker to open a handle to the target process with VM_READ/VM_WRITE/VM_OPERATION rights in order to write shellcode into shared sections and redirect execution via SetWindowLong. This rule fires on suspicious cross-process handle requests from unusual parent contexts, targeting the state change produced by the injection setup rather than any command-line indicator."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires EDR or Sysmon (Event ID 10 - ProcessAccess) telemetry normalised into UDM PROCESS_OPEN events. The EDR must capture cross-process handle requests including the requesting process path and the target process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debuggers (WinDbg, Visual Studio), profilers, AV/EDR agents opening process handles for inspection, RMM tools performing memory diagnostics, crash-dump collectors."
    tuning_guidance = "Add known-good security tooling and debugger paths to %global_allowed_security_tools. Add approved RMM and admin tooling to %global_allowed_admin_tools. Narrow scope further by correlating with the target process being a GUI/windowed application (e.g. explorer.exe, notepad.exe) if your EDR populates target process name."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"

    // Requesting process is NOT a known system binary - must come from user-space or unusual path
    // System processes live under System32/SysWOW64; flag anything outside those canonical paths
    not $open.principal.process.file.full_path = /(?i)\\windows\\system32\\/ nocase
    not $open.principal.process.file.full_path = /(?i)\\windows\\syswow64\\/ nocase
    not $open.principal.process.file.full_path = /(?i)\\windows\\sysnative\\/ nocase

    // Exclude empty/unpopulated principal process paths to avoid noise from unresolved events
    $open.principal.process.file.full_path = /.+/

    // Target process is a GUI-capable or commonly injected-into Windows process
    // EWM injection requires a windowed target that has registered a window class
    $open.target.process.file.full_path = /(?i)\\(explorer|notepad|mspaint|wordpad|calc|iexplore|msedge|chrome|firefox|winlogon|lsass|svchost|taskhost|taskhostw|dwm|ctfmon|rundll32|dllhost|msiexec|werfault|conhost|csrss)\.exe$/

    // Exclude the requesting process being the same binary as the target (self-open is normal)
    // and exclude known-good security and admin tooling
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    // Exclude service accounts performing legitimate automation
    not $open.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($open.principal.hostname)
    $requesting_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
