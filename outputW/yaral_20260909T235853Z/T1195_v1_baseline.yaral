/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 1  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:44:16.640599+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_Supply_Chain_Package_Postinst_Dropper {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Single-Event"
    severity        = "High"
    description     = "Detects supply chain compromise indicators on Linux: a package manager post-install or maintainer script spawning a shell, interpreter, or network utility from a transient or world-writable path. Legitimate packages rarely need to download and execute arbitrary code from /tmp, /dev/shm, or /var/tmp during installation. This pattern is consistent with a trojanised package executing a secondary payload as part of its install lifecycle."
    mitre_tactic    = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry normalised to UDM PROCESS_LAUNCH events, including principal (parent) and target (child) process fields."
    platform        = "Linux"
    log_source      = "linux_endpoint"
    false_positives = "Legitimate packages that compile from source during install (e.g. some pip/npm packages), developer workstations running custom build scripts via dpkg/rpm hooks, configuration management tools (Chef, Puppet, Ansible) that invoke package managers with post-install hooks."
    tuning_guidance = "Add known-good package manager wrapper scripts to %global_allowed_admin_tools. Add authorised build hosts to %global_allowed_script_hosts. Narrow the child-process regex if curl/wget false-positives are high in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent is a package manager or its maintainer-script runner
    $proc.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|pip3?|pip|npm|yarn|gem|cargo|go)$/ nocase

    // Child process is a shell, interpreter, or network retrieval tool
    // that should not normally be spawned directly by a package manager hook
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python3?|perl|ruby|curl|wget|nc|ncat|netcat|socat|php|lua|node|nodejs)$/

    // Child is executing something from a transient or world-writable location,
    // OR the command line references a remote URI or pipe-to-shell pattern
    (
      $proc.target.process.command_line = /\s(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|\/run\/shm\/)/ nocase
      or
      $proc.target.process.command_line = /https?:\/\// nocase
      or
      $proc.target.process.command_line = /\|\s*(bash|sh|dash|python3?|perl)/ nocase
      or
      $proc.target.process.command_line = /curl.+\|\s*(bash|sh)/ nocase
      or
      $proc.target.process.command_line = /wget.+\|\s*(bash|sh)/ nocase
      or
      $proc.target.process.command_line = /\-c\s+['"]?(curl|wget|nc |socat)/ nocase
    )

    // Exclude approved administrative tooling and authorised build hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score        = max(80)
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity    = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
