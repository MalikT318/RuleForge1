/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T00:38:48.624313+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Service_Registry_Then_Stop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a two-stage Windows Event Log suppression pattern: first a registry modification disabling or reconfiguring the EventLog service start type, followed by a process launch that stops or disables the EventLog service on the same host. This correlation provides additive coverage beyond command-line-only detections by anchoring on the registry change as the leading indicator."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (Event ID 13 or equivalent UDM REGISTRY_MODIFICATION) and process launch telemetry (Event ID 1 / 4688 or equivalent UDM PROCESS_LAUNCH). Both event types must be ingested and normalised into Chronicle UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorized system hardening scripts that legitimately disable the EventLog service in isolated lab or kiosk environments. Group Policy baseline enforcement tools may also touch the EventLog service registry key during policy application."
    tuning_guidance = "Add authorized service-management accounts to %global_allowed_service_accounts. Add approved administrative tooling (sc.exe wrappers, RMM agents) to %global_allowed_admin_tools. Narrow the registry key regex if only specific log channels are targeted."

  events:
    // Leg 1: Registry modification targeting the EventLog service Start value
    // Adversaries set Start=4 (disabled) or Start=3 (manual) to prevent auto-start
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)\\SYSTEM\\CurrentControlSet\\Services\\EventLog$/
    $reg.target.registry.registry_value_name = /(?i)^Start$/
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    // Leg 2: Process launch that stops or disables the EventLog service
    // Covers: sc.exe stop/config, net.exe stop, powershell Stop-Service / Set-Service
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)\\(sc|net|powershell|pwsh)\.exe$/
    $proc.target.process.command_line = /(?i)(eventlog|wevsvc)/
    $proc.target.process.command_line = /(?i)(stop|disabled|stopped|start=\s*disabled)/
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    // Enforce chronological ordering: registry change precedes service stop
    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($hostname)
    $registry_key_modified = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $stop_command_line = array_distinct($proc.target.process.command_line)
    $actor_user = array_distinct($proc.principal.user.userid)
    $stop_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $reg and $proc
}
