/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 2  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-10T01:20:08.391044+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_002_NetDevice_Login_Then_Mgmt_Plane_Burst {
  meta:
    author          = "TELUS Automated Detection Pipeline"
    rule_type       = "Sequence"
    severity        = "Medium"
    description     = "Detects a management-plane login to a network device followed by an unusual burst of short-lived outbound connections from that same device within 10 minutes. On network devices, system-information discovery (e.g. 'show version', 'show inventory') is often preceded by an interactive management session and followed by data exfiltration probes or C2 check-ins as the adversary shapes follow-on actions. This rule correlates the authentication event with the subsequent network activity burst as a behavioural proxy for post-login reconnaissance."
    mitre_tactic    = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Requires firewall/perimeter logs that capture management-plane authentication events (USER_LOGIN) and outbound flow records (NETWORK_FLOW) from network device management interfaces. Both event types must be normalised to UDM and share a common principal.hostname or principal.ip."
    platform        = "Network Devices"
    log_source      = "firewall"
    false_positives = "Automated network management platforms (SNMP pollers, Ansible, Terraform) that authenticate and then probe external update or telemetry endpoints. NTP synchronisation bursts post-reboot. Legitimate out-of-band monitoring solutions."
    tuning_guidance = "Add authorised management source IPs to %global_allowed_mgmt_sources and authorised service accounts to %global_allowed_service_accounts. Raise the flow-count threshold in the outcome or narrow the destination port filter if false-positive rates are high in environments with dense automated management tooling."

  events:
    // Leg 1: interactive or scripted login to the network device management plane
    $auth.metadata.event_type = "USER_LOGIN"
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.user.userid in %global_allowed_service_accounts
    $auth.target.hostname = $device_host

    // Leg 2: outbound flow(s) originating from the same device to external destinations
    // shortly after the login - consistent with post-discovery exfil probing
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.hostname = $device_host
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.ip in %global_allowed_mgmt_sources
    // Narrow to ports commonly used for management-plane data retrieval or C2
    // (SSH 22, Telnet 23, HTTPS 443, HTTP 80, SNMP 161, syslog 514, custom mgmt 8080/8443)
    $flow.target.port >= 22

    // Chronological ordering: login must precede the outbound flow burst
    $auth.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $device_host over 10m

  outcome:
    $risk_score          = max(65)
    $mitre_technique_id  = array_distinct("T1082")
    $primary_entity      = array_distinct($device_host)
    $auth_user           = array_distinct($auth.principal.user.userid)
    $auth_source_ip      = array_distinct($auth.principal.ip)
    $external_dest_ips   = array_distinct($flow.target.ip)
    $dest_ports_observed = array_distinct($flow.target.port)
    $flow_count          = count($flow.metadata.event_timestamp.seconds)

  condition:
    $auth and $flow
}
