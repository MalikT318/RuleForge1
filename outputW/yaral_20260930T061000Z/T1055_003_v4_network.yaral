/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 5  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:10:16.014830+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Injected_Thread_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects external network connection from a process whose parent terminated before the connection, indicating possible thread execution hijacking where injected code establishes C2 from a hijacked process."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR network telemetry with process lineage context."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Long-running system services whose parent svchost.exe instances cycle; browser renderer processes after parent browser update; legitimate process daemonization."
    tuning_guidance = "Add known-good orphaned processes to %global_allowed_service_accounts or exclude specific parent-child pairs via %global_allowed_remote_mgmt."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.process.parent_process.file.full_path != ""
    $net.principal.process.parent_process.file.full_path = /\\(explorer|winlogon|services|lsass|csrss|smss|wininit)\.exe$/ nocase
    $net.principal.process.file.full_path = /\\(svchost|dllhost|rundll32|regsvr32|msiexec|taskhost|taskhostw|conhost)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.target.port in %list(80, 443, 53)

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($net.principal.hostname)

  condition:
    $net
}
