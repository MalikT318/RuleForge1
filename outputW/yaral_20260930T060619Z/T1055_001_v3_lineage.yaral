/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 5  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:07:27.095681+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process opening handles to remote processes from unexpected parent lineages, indicative of DLL injection preparation. Focuses on Office apps, web servers, database services, and print spoolers spawning injection-capable tooling."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR process handle telemetry (PROCESS_OPEN events with access rights)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debugging tools launched from IDEs, RMM agents performing diagnostics, security software performing memory scanning, backup agents reading process memory."
    tuning_guidance = "Add approved parent processes to %global_allowed_security_tools or %global_allowed_backup_processes. Exclude known debugging workflows by adding parent paths to %global_allowed_admin_tools."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    (
      $open.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio)\.exe$/ nocase or
      $open.principal.process.file.full_path = /\\w3wp\.exe$/ nocase or
      $open.principal.process.file.full_path = /\\(sqlservr|oracle|mysqld|postgres)\.exe$/ nocase or
      $open.principal.process.file.full_path = /\\spoolsv\.exe$/ nocase or
      $open.principal.process.file.full_path = /\\(iexplore|msedge|chrome|firefox)\.exe$/ nocase
    )
    $open.target.process.file.full_path != ""
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)

  condition:
    $open
}
