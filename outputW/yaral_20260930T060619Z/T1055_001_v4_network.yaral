/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 5  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:07:43.887798+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Injection_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects external network connection from a process that was spawned by a common injection target, indicating potential DLL injection followed by C2 communication. Excludes internal address space and approved remote management tooling."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR network telemetry with process lineage context."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate plugins or extensions in browsers, Office applications, or system services that communicate externally. Approved remote management agents spawned by system processes."
    tuning_guidance = "Add approved parent-child-destination combinations to %global_allowed_remote_mgmt. Add known-good external domains to %global_allowed_domains."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.parent_process.file.full_path = /\\(svchost|explorer|rundll32|dllhost|taskhost|searchindexer|spoolsv|lsass|winlogon)\.exe$/ nocase or
      $net.principal.process.parent_process.file.full_path = /\\(iexplore|chrome|firefox|msedge|outlook|winword|excel|powerpnt)\.exe$/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path = /\\windows\\system32\\/ nocase
    not $net.principal.process.file.full_path = /\\windows\\syswow64\\/ nocase
    $net.target.port != 80
    $net.target.port != 443

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($net.principal.hostname)

  condition:
    $net
}
