/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 5  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:08:15.730040+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process injection API calls (VirtualAllocEx, WriteProcessMemory, CreateRemoteThread) originating from unexpected parent processes such as Office applications, web servers, or system services that should not perform memory manipulation."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR telemetry capturing API call events or process open/injection events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate debugging tools, application updaters, security software performing memory scanning, RMM agents."
    tuning_guidance = "Add approved parent processes to %global_allowed_security_tools or %global_allowed_admin_tools. Exclude specific service accounts to %global_allowed_service_accounts."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote)\.exe$/ nocase or
    $inj.principal.process.file.full_path = /\\(w3wp|httpd|nginx|tomcat\d*|java)\.exe$/ nocase or
    $inj.principal.process.file.full_path = /\\(spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase or
    $inj.principal.process.file.full_path = /\\(msiexec|regsvr32|rundll32|mshta|wscript|cscript)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($inj.principal.hostname)

  condition:
    $inj
}
