/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 5  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:08:48.043085+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_Via_Process_Open_Handle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process opening a handle to another process with memory write and thread creation permissions, indicative of PE injection preparation. Focuses on non-security tooling accessing protected processes."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR telemetry capturing process handle operations with access rights detail."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV engines, debugging tools, memory analysis utilities, backup software, RMM agents."
    tuning_guidance = "Add approved security and backup tooling to %global_allowed_security_tools. Add approved debugging/admin tools to %global_allowed_admin_tools."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    (
      $open.target.process.file.full_path = /\\(lsass|csrss|services|winlogon|svchost)\.exe$/ nocase or
      $open.target.process.file.full_path = /\\system32\\/ nocase
    )
    (
      re.regex($open.security_result.summary, /(?i)(PROCESS_VM_WRITE|PROCESS_CREATE_THREAD)/) or
      re.regex($open.security_result.summary, /(?i)(0x1F0FFF|0x001FFFFF|PROCESS_ALL_ACCESS)/)
    )
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path = /\\(MsMpEng|SenseCE|SenseIR|SenseNdr|SenseCncProxy|SenseSampleUploader)\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(procexp|procexp64|procmon|procmon64)\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($open.principal.hostname)

  condition:
    $open
}
