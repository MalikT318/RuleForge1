/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 5  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:06:56.835206+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Injected_Process_Unexpected_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network connections from processes that rarely initiate external traffic, indicating possible process injection. Focuses on signed Microsoft binaries and system utilities that attackers commonly inject into for stealth."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires EDR network telemetry with process context."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate plugins or extensions in browsers, Office add-ins fetching external content, security tools performing updates, RMM agents injecting into system processes."
    tuning_guidance = "Add approved remote management tools to %global_allowed_remote_mgmt. Exclude known-good destinations via %global_allowed_domains. For persistent FPs from specific processes, add to %global_allowed_security_tools."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /\\(svchost|lsass|csrss|winlogon|services|smss|wininit|spoolsv|taskhost|taskhostw|dllhost|rundll32|regsvr32|mmc|msiexec)\.exe$/ nocase or
      $net.principal.process.file.full_path = /\\system32\\(wbem\\wmiprvse|conhost|fontdrvhost|dwm|sihost)\.exe$/ nocase or
      $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|wordpad)\.exe$/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    $net.target.port != 80
    $net.target.port != 443

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($net.principal.hostname)
    $suspicious_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
