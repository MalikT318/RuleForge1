/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 5  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:08:29.548715+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_Injected_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network connection from a process that was opened by another process, indicating potential PE injection followed by C2 communication. Excludes internal destinations and approved security tooling."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR network telemetry with process handle tracking."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tools opening handles to browsers for inspection; debugging tools; RMM agents injecting into legitimate processes for monitoring."
    tuning_guidance = "Add approved security tools to %global_allowed_security_tools. Add known-good destinations to %global_allowed_domains."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.additional.fields["process_opened_by_another"] = "true"
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    $net.target.port != 80
    $net.target.port != 443

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($net.principal.hostname)

  condition:
    $net
}
