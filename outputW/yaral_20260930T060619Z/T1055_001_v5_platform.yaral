/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 5  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:08:00.222281+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_Cross_Process_Handle_With_Memory_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process opening a handle to another process with memory write and thread creation permissions, indicative of DLL injection preparation."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR telemetry capturing PROCESS_OPEN events with access mask details."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers, security tools, backup agents, RMM software, legitimate inter-process communication by system services."
    tuning_guidance = "Add approved debugging and security tooling to %global_allowed_security_tools. Add backup software to %global_allowed_backup_processes."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    (
      $open.target.process.access_mask = /0x1F3FFF/ nocase or
      $open.target.process.access_mask = /0x1FFFFF/ nocase or
      $open.target.process.access_mask = /PROCESS_ALL_ACCESS/ nocase or
      (
        $open.target.process.access_mask = /PROCESS_VM_WRITE/ nocase and
        $open.target.process.access_mask = /PROCESS_CREATE_THREAD/ nocase
      ) or
      (
        $open.target.process.access_mask = /0x0028/ nocase or
        $open.target.process.access_mask = /0x0438/ nocase
      )
    )
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path = /\\windows\\system32\\/ nocase
    not $open.principal.process.file.full_path = /\\windows\\syswow64\\/ nocase
    not $open.target.process.file.full_path = $open.principal.process.file.full_path

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)

  condition:
    $open
}
