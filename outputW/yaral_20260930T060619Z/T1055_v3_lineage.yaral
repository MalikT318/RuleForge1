/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 5  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:06:38.984186+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Linux_Service_Spawns_Shell_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Linux system services or daemons spawning interactive shell interpreters, indicative of process injection or exploitation leading to code execution in a privileged service context."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry with parent-child process relationships."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate service management scripts, configuration management tools (Ansible, Puppet, Chef), container orchestration startup scripts, systemd service ExecStartPre/ExecStartPost hooks."
    tuning_guidance = "Add approved service management parent processes to %global_allowed_service_accounts or %global_allowed_admin_tools. Review services that legitimately spawn shells during normal operation."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.principal.process.file.full_path = /^\/usr\/sbin\// nocase or
      $proc.principal.process.file.full_path = /^\/sbin\// nocase or
      $proc.principal.process.file.full_path = /^\/usr\/lib\/systemd\// nocase or
      $proc.principal.process.file.full_path = /^\/lib\/systemd\// nocase or
      $proc.principal.process.file.full_path = /\/httpd$/ nocase or
      $proc.principal.process.file.full_path = /\/apache2$/ nocase or
      $proc.principal.process.file.full_path = /\/nginx$/ nocase or
      $proc.principal.process.file.full_path = /\/mysqld$/ nocase or
      $proc.principal.process.file.full_path = /\/postgres$/ nocase or
      $proc.principal.process.file.full_path = /\/sshd$/ nocase or
      $proc.principal.process.file.full_path = /\/cupsd$/ nocase or
      $proc.principal.process.file.full_path = /\/crond$/ nocase or
      $proc.principal.process.file.full_path = /\/rsyslogd$/ nocase or
      $proc.principal.process.file.full_path = /\/systemd-/ nocase or
      $proc.principal.process.file.full_path = /\/dockerd$/ nocase or
      $proc.principal.process.file.full_path = /\/containerd$/ nocase
    )
    (
      $proc.target.process.file.full_path = /\/bash$/ nocase or
      $proc.target.process.file.full_path = /\/sh$/ nocase or
      $proc.target.process.file.full_path = /\/dash$/ nocase or
      $proc.target.process.file.full_path = /\/zsh$/ nocase or
      $proc.target.process.file.full_path = /\/ksh$/ nocase or
      $proc.target.process.file.full_path = /\/csh$/ nocase or
      $proc.target.process.file.full_path = /\/tcsh$/ nocase or
      $proc.target.process.file.full_path = /\/python[0-9.]*$/ nocase or
      $proc.target.process.file.full_path = /\/perl$/ nocase or
      $proc.target.process.file.full_path = /\/ruby$/ nocase or
      $proc.target.process.file.full_path = /\/php$/ nocase or
      $proc.target.process.file.full_path = /\/node$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
