/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 5  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:09:05.372896+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Injection_Capable_Process_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects processes capable of thread injection (PowerShell, rundll32, regsvr32) spawned by anomalous parents such as Office applications, web servers, or system services that should not launch scripting engines."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros executing legitimate automation scripts, web application frameworks spawning PowerShell for admin tasks, print spooler plugins, database maintenance scripts."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts. Exclude service accounts performing legitimate automation via %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    
    (
      $proc.principal.process.file.full_path = /(?i)\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio)\.exe$/ or
      $proc.principal.process.file.full_path = /(?i)\\w3wp\.exe$/ or
      $proc.principal.process.file.full_path = /(?i)\\(sqlservr|oracle|mysqld)\.exe$/ or
      $proc.principal.process.file.full_path = /(?i)\\spoolsv\.exe$/ or
      $proc.principal.process.file.full_path = /(?i)\\(tomcat|java|javaw)\.exe$/ or
      $proc.principal.process.file.full_path = /(?i)\\(nginx|httpd|apache)\.exe$/
    )
    
    (
      $proc.target.process.file.full_path = /(?i)\\(powershell|pwsh)\.exe$/ or
      $proc.target.process.file.full_path = /(?i)\\rundll32\.exe$/ or
      $proc.target.process.file.full_path = /(?i)\\regsvr32\.exe$/ or
      $proc.target.process.file.full_path = /(?i)\\mshta\.exe$/ or
      $proc.target.process.file.full_path = /(?i)\\wmic\.exe$/ or
      $proc.target.process.file.full_path = /(?i)\\cscript\.exe$/ or
      $proc.target.process.file.full_path = /(?i)\\wscript\.exe$/
    )
    
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($proc.principal.hostname)

  condition:
    $proc
}
