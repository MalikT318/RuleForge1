/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 5  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-4-5) via gap_ruleforge.py
  Generated at    : 2026-09-30T06:07:10.461242+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Linux_Proc_Mem_Access_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process opening /proc/[pid]/mem of another process for write access, indicating potential process injection via direct memory manipulation on Linux."
    mitre_tactic = "Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires Linux EDR or auditd with file access monitoring enabled for /proc filesystem."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers (gdb, strace), memory profilers, security tools, container runtime engines, system monitoring agents."
    tuning_guidance = "Add legitimate debugging and monitoring tools to %global_allowed_security_tools. Exclude container runtime processes to %global_allowed_backup_processes if generating excessive noise."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/mem$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path = /\/gdb$/ nocase
    not $file.principal.process.file.full_path = /\/strace$/ nocase
    not $file.principal.process.file.full_path = /\/ltrace$/ nocase
    not $file.principal.process.file.full_path = /\/valgrind$/ nocase
    not $file.principal.process.file.full_path = /\/containerd/ nocase
    not $file.principal.process.file.full_path = /\/dockerd$/ nocase
    not $file.principal.process.file.full_path = /\/runc$/ nocase

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($file.principal.hostname)

  condition:
    $file
}
