/*
  MITRE Technique : T1585 - Establish Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:35:04.263566+00:00
  Reference       : https://attack.mitre.org/techniques/T1585
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_External_Account_Signup_Then_Verification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Low"
    description = "A single internal source submits an account-registration request (HTTP POST to a signup or register path) and then follows an email-verification or activation link on the same external site within ten minutes. This sequence is the network-observable footprint of account creation on a third-party service. It can indicate persona or account establishment from inside the environment (insider, compromised host, or adversary-operated infrastructure). T1585 normally happens outside victim visibility, so this rule is a low-fidelity hunting lead and should be triaged with user context."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585"
    mitre_technique_name = "Establish Accounts"
    log_prerequisites = "Requires perimeter or proxy logs normalised to UDM NETWORK_HTTP with network.http.method, target.url, target.hostname and principal.ip populated. TLS inspection is needed to see URL paths on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate employee signups for SaaS trials, vendor portals, or conferences; marketing and social-media teams; security researchers and red teams building test personas; automated QA or onboarding workflows; web crawlers behind NAT."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Tune the signup and verification URL regexes to match local proxy URL normalisation. Where principal.ip is a NAT or proxy address, join on a user or host identifier instead. Consider raising severity only when the source is a server or sensitive subnet."

  events:
    $signup.metadata.event_type = "NETWORK_HTTP"
    $signup.network.http.method = "POST"
    $signup.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|join)(\/|\?|$)/ nocase
    not $signup.target.hostname in %global_allowed_domains
    not $signup.target.ip in %rfc1918_internal
    $signup.principal.ip = $src_ip
    $signup.target.hostname = $site

    $verify.metadata.event_type = "NETWORK_HTTP"
    $verify.network.http.method = "GET"
    $verify.target.url = /(verify|confirm|activate)[-_]?(email|account|user|registration)?[^\s]*(token|code|key)=/ nocase
    not $verify.target.hostname in %global_allowed_domains
    not $verify.target.ip in %rfc1918_internal
    $verify.principal.ip = $src_ip
    $verify.target.hostname = $site

    $signup.metadata.event_timestamp.seconds <= $verify.metadata.event_timestamp.seconds

  match:
    $src_ip, $site over 10m

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1585")
    $primary_entity = array_distinct($signup.principal.ip)
    $signup_sites = array_distinct($signup.target.hostname)
    $signup_urls = array_distinct($signup.target.url)
    $signup_count = count($signup.metadata.id)
    $verify_count = count($verify.metadata.id)

  condition:
    $signup and $verify
}
