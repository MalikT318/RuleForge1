/*
  MITRE Technique : T1595.002 - Vulnerability Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:54:07.008602+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_002_External_Port_Sweep_Then_HTTP_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an external source that sweeps many common service ports on perimeter-facing hosts and then generates a burst of HTTP error responses (4xx/5xx) against the same environment within ten minutes. This sequence is typical of automated vulnerability scanning: service discovery first, then application-layer probing."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.002"
    mitre_technique_name = "Active Scanning: Vulnerability Scanning"
    log_prerequisites = "Requires perimeter firewall connection logs normalised to NETWORK_CONNECTION and proxy/WAF/reverse-proxy web logs normalised to NETWORK_HTTP with response codes populated and an external client IP in principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, uptime or synthetic monitors, search engine and internet research crawlers, penetration tests, and misconfigured clients retrying against closed services."
    tuning_guidance = "Add authorised external scanner and pentest source addresses to %global_allowed_scanners. Raise or lower the #net and #http thresholds per client based on normal internet background noise. Narrow the port list if the client legitimately exposes several of these services. Use %global_allowed_mgmt_sources for approved management sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 25 or
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5432 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.response_code >= 400
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $net.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1595.002")
    $primary_entity = array_distinct($src_ip)
    $distinct_ports_probed = count_distinct($net.target.port)
    $distinct_targets_probed = count_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)
    $http_error_count = count($http.metadata.id)
    $targeted_ips = array_distinct($net.target.ip)

  condition:
    $net and $http and #net >= 10 and #http >= 10
}
