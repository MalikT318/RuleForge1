/*
  MITRE Technique : T1592.004 - Client Configurations
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:41:12.410818+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_004_External_Probe_Client_Config_Resources {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting client-configuration and fingerprinting resources (proxy auto-config, browser or client policy files, autodiscover documents) on perimeter-protected web services and receiving a non-error response. These resources reveal client and environment settings and are commonly probed during reconnaissance."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.004"
    mitre_technique_name = "Gather Victim Host Information: Client Configurations"
    log_prerequisites = "Requires firewall, proxy or WAF logs normalised to NETWORK_HTTP with target.url, network.http.response_code and principal.ip populated. If the response code is not populated by the log source, the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate remote clients fetching proxy auto-config or autodiscover documents, mail clients using autodiscover, Flash or Silverlight legacy clients requesting policy files, authorised external scanners not yet in the allowlist, and search engine crawlers."
    tuning_guidance = "Add authorised scanning and testing source addresses to %global_allowed_scanners. Add known-good external service sources to %global_allowed_domains where applicable. If autodiscover generates noise in mail-hosting environments, remove it from the path regex for those clients."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(?i)\/(wpad\.dat|proxy\.pac|browserconfig\.xml|clientaccesspolicy\.xml|crossdomain\.xml|autodiscover\/autodiscover\.xml|\.well-known\/(browserconfig|client-config)[^\/]*)(\?|$)/
    $net.network.http.response_code < 400
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1592.004")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $http_user_agents = array_distinct($net.network.http.user_agent)
    $targeted_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
