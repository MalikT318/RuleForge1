/*
  MITRE Technique : T1585 - Establish Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:34:44.915941+00:00
  Reference       : https://attack.mitre.org/techniques/T1585
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_External_Account_Signup_Via_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal host submitting an HTTP POST to an external account-registration endpoint (signup, register, create-account paths) through the perimeter. This is the only part of persona or account establishment that the defender can observe: account creation with external services from monitored infrastructure. Most T1585 activity happens outside the victim's visibility, so this rule is a low-fidelity hunting and triage signal. It is not a high-confidence detection."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585"
    mitre_technique_name = "Establish Accounts"
    log_prerequisites = "Requires perimeter or proxy logs normalised to UDM NETWORK_HTTP with network.http.method, target.url and target.hostname populated. TLS inspection is needed to see URL paths for HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees registering for legitimate SaaS trials, webinars, vendor portals and conferences; marketing and recruiting staff creating business social media accounts; developers signing up for package registries or cloud services; automated QA testing of the organisation's own signup flows."
    tuning_guidance = "Add sanctioned vendor and SaaS domains to %global_allowed_domains. Add automation and testing accounts to %global_allowed_service_accounts. Restrict deployment to sensitive segments, or route to a hunting queue rather than alerting. Without TLS inspection the URL path is not visible and the rule will rarely fire."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\/(signup|sign-up|sign_up|register|registration|create[-_]?account|join)(\/|\?|$)/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1585")
    $primary_entity = array_distinct($net.principal.hostname)
    $signup_hosts = array_distinct($net.target.hostname)
    $signup_urls = array_distinct($net.target.url)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
