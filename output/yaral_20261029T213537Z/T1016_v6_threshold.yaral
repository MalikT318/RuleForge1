/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:48:54.771691+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_ESXi_Network_Config_Discovery_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of ESXi shell commands that enumerate network configuration (NICs, VMkernel interfaces, routes, neighbours, DNS, virtual switches, port groups) on a single hypervisor host within ten minutes. Each query is benign alone, but many different ones in a short window indicate scripted reconnaissance, typical of ransomware and intruder pre-staging on hypervisors."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "ESXi shell command execution must be forwarded and parsed into UDM PROCESS_LAUNCH events with target.process.command_line populated (shell and hostd logs, or host-level audit forwarding)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators troubleshooting host networking over SSH or the shell; host provisioning and post-install configuration scripts; configuration-management and compliance tooling that audits host network settings; monitoring or inventory collectors that run on the host; host profile remediation."
    tuning_guidance = "Add approved automation and inventory tooling to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Raise the #proc threshold (default 6) in environments with chatty provisioning scripts. Review the host's SSH and shell enablement events around the same window to prioritise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(esxcli|localcli)\s+network\s+(nic|ip|vswitch|firewall|vm|diag)\b|\besxcfg-(nics|vmknic|route|vswitch)\b|\bvim-cmd\s+hostsvc\/net\b|\bvim-cmd\s+vmsvc\/get\.networks\b/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($host)
    $command_count = count($proc.metadata.id)
    $distinct_commands = array_distinct($proc.target.process.command_line)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 6
}
