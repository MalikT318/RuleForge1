/*
  MITRE Technique : T1543.004 - Launch Daemon
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:27:24.627367+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_004_LaunchDaemon_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by an unexpected parent process (Office application, web server, database service or print service) that touches /Library/LaunchDaemons or loads a job with launchctl. Server-side and document-borne processes have no legitimate reason to install system-level launch daemons, so this lineage points to exploitation or macro-driven persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.004"
    mitre_technique_name = "Create or Modify System Process: Launch Daemon"
    log_prerequisites = "macOS endpoint telemetry (EDR or unified log) that populates PROCESS_LAUNCH with parent process path, child process path and command line."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Administrators running web or database software installers from a service context, application installers that run helper scripts under an Office or database parent, developer or QA environments on shared macOS hosts, and MDM or deployment agents that launch scripts via an unusual parent."
    tuning_guidance = "Add approved deployment or management parent binaries to %global_allowed_admin_tools and approved script-launching parents to %global_allowed_script_hosts. Extend the parent regex with local line-of-business server daemons if needed. Review hosts that fire repeatedly before allowlisting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(Microsoft Word|Microsoft Excel|Microsoft PowerPoint|Microsoft Outlook|httpd|apache2|nginx|php-fpm|php|mysqld|postgres|mongod|redis-server|cupsd|cups-lpd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|zsh|dash|osascript|python[0-9.]*|perl|ruby|launchctl)$/ nocase
    $proc.target.process.command_line = /(\/Library\/LaunchDaemons\/|launchctl\s+(load|bootstrap|submit|enable|kickstart))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1543.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
