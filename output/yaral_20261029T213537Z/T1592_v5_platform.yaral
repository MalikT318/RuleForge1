/*
  MITRE Technique : T1592 - Gather Victim Host Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:34:52.849803+00:00
  Reference       : https://attack.mitre.org/techniques/T1592
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_Inbound_Host_Fingerprint_Service_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source connecting inbound to a host-information-disclosing service port (RPC/portmap, NetBIOS, SNMP, IPMI, SSDP, mDNS) on the perimeter. These services return hostname, OS, hardware and configuration details, so probes against them are typical reconnaissance for victim host information. Intended as a low-severity early-warning and enrichment signal."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592"
    mitre_technique_name = "Gather Victim Host Information"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION, with network.direction, principal.ip, target.ip and target.port populated. Ingress traffic must be logged, including permitted and denied connections."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet background scanning, authorised external vulnerability scanners and attack-surface monitoring services, managed service provider monitoring over SNMP, partner or VPN peers using NetBIOS/RPC, and misconfigured devices exposing mDNS/SSDP."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management source addresses to %global_allowed_mgmt_sources. If internet background noise is high, keep this rule as an enrichment signal and route it to a lower-priority queue, or promote it to a threshold rule grouped by source address. Confirm the firewall populates network.direction; if it does not, rely on the external-source exclusion alone."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    (
      $net.target.port = 111 or
      $net.target.port = 135 or
      $net.target.port = 137 or
      $net.target.port = 139 or
      $net.target.port = 161 or
      $net.target.port = 623 or
      $net.target.port = 1900 or
      $net.target.port = 5353
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1592")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
