/*
  MITRE Technique : T1546.004 - Unix Shell Configuration Modification
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:28:44.402474+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_004_Linux_Shell_Startup_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Linux shell startup and logout scripts (/etc/profile, /etc/profile.d/*, /etc/bash.bashrc, /etc/zsh*, and per-user .bashrc, .bash_profile, .profile, .zshrc and similar) by a process outside approved tooling. Adversaries append commands to these files so their payload runs whenever a user or system shell starts. This is a file-integrity detection on FILE_MODIFICATION and does not rely on process command lines."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.004"
    mitre_technique_name = "Event Triggered Execution: Unix Shell Configuration Modification"
    log_prerequisites = "Linux EDR file telemetry or auditd file-watch rules (-w on /etc/profile, /etc/profile.d, /etc/bash.bashrc, /etc/zsh, /home, /root) normalised to UDM FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers updating /etc/profile.d scripts, configuration management agents (Ansible, Puppet, Chef, Salt), user provisioning tools writing skeleton files, administrators and users legitimately editing their own .bashrc or .profile, and developer tools (nvm, pyenv, conda, SDKMAN) that append initialisation lines to rc files."
    tuning_guidance = "Add configuration-management and deployment binaries to %global_allowed_admin_tools, expected automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Add file integrity or EDR agents to %global_allowed_security_tools. If developer tooling is noisy, scope exclusions by writer process rather than by file path."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(etc\/(profile|bash\.bashrc|bashrc|bash\.bash_logout|csh\.cshrc|csh\.login|zshrc|zprofile|zlogin|zlogout|zshenv|profile\.d\/[^\/]+|zsh\/(zshrc|zprofile|zlogin|zlogout|zshenv))|(home\/[^\/]+|root)\/\.(bashrc|bash_profile|bash_login|bash_logout|profile|zshrc|zprofile|zlogin|zlogout|zshenv))$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|unattended-upgrade|packagekitd)$/ nocase

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1546.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
