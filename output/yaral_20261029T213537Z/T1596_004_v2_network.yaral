/*
  MITRE Technique : T1596.004 - CDNs
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:04:47.332743+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_004_CDN_Misconfiguration_Probing_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects external clients sending HTTP requests to CDN-fronted web assets that probe for storage listing and misconfiguration exposure. Examples are object-store listing query parameters, bucket ACL/policy sub-resources, and hidden configuration or version-control paths. This is the network-side signature of adversaries harvesting CDN data and hunting for content leaked through a misconfigured CDN or origin."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.004"
    mitre_technique_name = "Search Open Technical Databases: CDNs"
    log_prerequisites = "Requires IPS or network security appliance logs with HTTP inspection that populate network.http.method, target.url and principal.ip. SSL/TLS decryption or inspection is needed to see URLs on HTTPS traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface management services; web applications that legitimately use delimiter or list-type query parameters; partner or SaaS integrations that enumerate storage objects; search-engine crawlers requesting robots-style or hidden paths."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. If a known client integration uses listing parameters, scope it out via %global_allowed_cloud_principals or by tuning the URL regex. Consider raising severity or converting to a threshold rule (count by source IP) for noisy internet-facing sensors."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD|OPTIONS)$/ nocase
    $http.target.url = /([?&](list-type=[0-9]|delimiter=|max-keys=|continuation-token=)|\?(acl|policy|versions|location)(=|&|$)|\/\.(git|env|aws|svn|ds_store|htaccess)(\/|\?|$)|\/(web\.config|server-status)(\?|$))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1596.004")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $probed_urls = array_distinct($http.target.url)

  condition:
    $http
}
