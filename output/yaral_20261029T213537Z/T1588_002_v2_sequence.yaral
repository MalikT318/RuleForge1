/*
  MITRE Technique : T1588.002 - Tool
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:56:13.317072+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_002_Tool_Download_Then_NonStandard_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an internal source that downloads an executable, script or archive over HTTP from a non-allowlisted external site, then within 10 minutes opens an outbound connection to an external address on a non-standard high port. This sequence is consistent with an adversary staging a freely available or commercial tool and then using it for remote tasking."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.002"
    mitre_technique_name = "Obtain Capabilities: Tool"
    log_prerequisites = "Requires proxy or firewall logs that provide HTTP URL and response code (NETWORK_HTTP), plus perimeter connection logs (NETWORK_CONNECTION) with the source IP populated consistently in both."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers and admins downloading installers or archives and then using non-standard ports (VPN clients, game or collaboration clients, custom internal apps, P2P-style updaters). Software deployment and patching workflows. Security testing and red team exercises."
    tuning_guidance = "Add trusted vendor and update domains to %global_allowed_domains. Exclude scanner and authorised testing sources by adding them to the allowed lists and extending the rule to filter on them. Narrow or widen the file extension list and the port threshold per client. Increase severity when the destination IP of the second event is also the host that served the download."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.network.http.response_code = 200
    $http.target.url = /\.(exe|msi|dll|ps1|bat|jar|zip|7z|rar)(\?.*)?$/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port > 1024
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1588.002")
    $primary_entity = array_distinct($src_ip)
    $download_urls = array_distinct($http.target.url)
    $download_hosts = array_distinct($http.target.hostname)
    $egress_dest_ips = array_distinct($net.target.ip)
    $egress_ports = array_distinct($net.target.port)
    $egress_count = count($net.metadata.id)

  condition:
    $http and $net
}
