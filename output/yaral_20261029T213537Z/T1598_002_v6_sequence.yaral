/*
  MITRE Technique : T1598.002 - Spearphishing Attachment
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:14:31.476306+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_002_Document_Download_Then_Credential_Post {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An internal client downloads a document or HTML-type file from an external host, then within 10 minutes submits an HTTP POST to a different external host on a URL with credential-themed path keywords. This pattern is consistent with a spearphishing-for-information attachment or HTML-smuggled fake login portal harvesting credentials."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.002"
    mitre_technique_name = "Phishing for Information: Spearphishing Attachment"
    log_prerequisites = "Requires firewall or proxy logs with HTTP/URL inspection (decrypted or URL-logging) normalised to NETWORK_HTTP, with principal.ip, target.url, target.hostname and network.http.method populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Single sign-on and SaaS onboarding flows that fetch a form or PDF from one vendor and post to an identity provider on another domain; web-based document-signing services; legitimate partner portals; users registering for vendor services; NAT or shared proxy egress addresses that merge unrelated users into one principal.ip."
    tuning_guidance = "Add known-good vendor, SSO and identity provider domains to %global_allowed_domains. If egress is NAT-ed so principal.ip does not identify a single client, join on a user or X-Forwarded-For field instead. Tighten the URL keyword regex or the file extension list per client."

  events:
    $get.metadata.event_type = "NETWORK_HTTP"
    $get.network.http.method = "GET"
    $get.target.url = /\.(html?|xlsx?|xlsm|docx?|docm|pdf|iso|zip|one)(\?|$)/ nocase
    not $get.target.ip in %rfc1918_internal
    not $get.target.hostname in %global_allowed_domains
    $get.principal.ip = $client

    $post.metadata.event_type = "NETWORK_HTTP"
    $post.network.http.method = "POST"
    $post.target.url = /(login|signin|logon|auth|verify|validate|account|password|credential|secure)/ nocase
    not $post.target.ip in %rfc1918_internal
    not $post.target.hostname in %global_allowed_domains
    $post.principal.ip = $client

    $get.target.hostname != $post.target.hostname

    $get.metadata.event_timestamp.seconds <= $post.metadata.event_timestamp.seconds

  match:
    $client over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598.002")
    $primary_entity = array_distinct($client)
    $download_hosts = array_distinct($get.target.hostname)
    $download_urls = array_distinct($get.target.url)
    $post_hosts = array_distinct($post.target.hostname)
    $post_urls = array_distinct($post.target.url)
    $post_count = count($post.metadata.id)

  condition:
    $get and $post
}
