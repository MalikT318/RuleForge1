/*
  MITRE Technique : T1037.002 - Login Hook
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:54:15.909388+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_002_macOS_LoginWindow_Plist_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the system loginwindow preferences plist (com.apple.loginwindow.plist), the file where LoginHook and LogoutHook keys are stored. A hook points to a script that runs as root at user logon or logout. This detects the resulting file state change rather than the defaults command line, so it still fires when command-line logging is evaded or the defaults binary is renamed or bypassed."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.002"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Login Hook"
    log_prerequisites = "macOS endpoint telemetry that records file modification events with the target file path and the responsible process, including writes to /Library/Preferences."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Administrators changing login window settings in System Settings (login message, hidden users, fast user switching); MDM or configuration profile enforcement of loginwindow settings; macOS upgrades and installers; enrollment and imaging workflows; the loginwindow process recording last-user state (excluded by default)."
    tuning_guidance = "File events cannot show which key changed, so analysts should confirm that LoginHook or LogoutHook is present in the plist. Add approved MDM and configuration agents to %global_allowed_admin_tools and EDR agents to %global_allowed_security_tools. If the telemetry source reports plist rewrites as FILE_CREATION (atomic write and rename), deploy a sibling copy of this rule using that event type. Raise severity for hosts without an MDM-managed loginwindow baseline."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^(\/private)?\/(Library|var\/root\/Library)\/Preferences\/com\.apple\.loginwindow\.plist$/ nocase
    not $file.principal.process.file.full_path = /\/loginwindow$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1037.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
