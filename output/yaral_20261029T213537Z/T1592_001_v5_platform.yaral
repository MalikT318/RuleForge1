/*
  MITRE Technique : T1592.001 - Hardware
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:36:35.725509+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_001_External_Hardware_Mgmt_Interface_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting web endpoints that expose hardware inventory or out-of-band management information (BMC/Redfish, IPMI-over-web, hypervisor SDK version discovery, generic hardware or system info CGI/API paths). This is typical of reconnaissance that fingerprints host hardware before targeting. The rule uses perimeter HTTP telemetry only and is independent of any endpoint process data."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.001"
    mitre_technique_name = "Gather Victim Host Information: Hardware"
    log_prerequisites = "Requires firewall, proxy or WAF logs normalised to NETWORK_HTTP with principal.ip and target.url populated. The device must log the full request URL (TLS inspection or reverse-proxy visibility) for the rule to evaluate."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface-management services, partner or MSP remote hardware monitoring through published management endpoints, hardware vendor support portals, and search-engine or internet-census crawlers that clients accept as background noise."
    tuning_guidance = "Add approved scanner source IPs to %global_allowed_scanners and approved remote management source addresses to %global_allowed_mgmt_sources. Management interfaces should not be exposed to the internet, so any hit that returns a successful response should be escalated. If perimeter noise is high, wrap this in a threshold variant grouped by principal.ip."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(redfish\/v1\/(systems|chassis|managers)|rest\/v1\/(systems|chassis|managers)|ipmi|sdk\/vimServiceVersions\.xml|cgi-bin\/(hwinfo|sysinfo|hardware|system_info)|api\/(v[0-9]+\/)?(system|hardware)\/(info|inventory))(\/|\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1592.001")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
