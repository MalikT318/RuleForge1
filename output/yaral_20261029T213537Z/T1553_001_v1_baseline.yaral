/*
  MITRE Technique : T1553.001 - Gatekeeper Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:38:30.526399+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_001_Quarantine_Attribute_Removal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the xattr utility being used to delete the com.apple.quarantine extended attribute or to clear all extended attributes. Removing the quarantine flag stops Gatekeeper from prompting the user before a downloaded program runs for the first time."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.001"
    mitre_technique_name = "Subvert Trust Controls: Gatekeeper Bypass"
    log_prerequisites = "Requires macOS endpoint process-launch telemetry that includes full command lines (EDR or unified log process execution events)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developers and IT staff clearing the quarantine flag on trusted internal builds, Homebrew cask or package installers, MDM and software deployment scripts, and users opening a known-good app that macOS blocked."
    tuning_guidance = "Add approved deployment and packaging tooling to %global_allowed_admin_tools. Add named administrators or build accounts to %global_allowed_admin_users. Expect more noise on developer workstations than on standard user endpoints."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/xattr$/ nocase
    $proc.target.process.command_line = /(\s-[a-z]*d[a-z]*\s+(\S+\s+)*com\.apple\.quarantine|\s-[a-z]*c[a-z]*(\s|$))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1553.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
