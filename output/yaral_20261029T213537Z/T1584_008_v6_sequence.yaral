/*
  MITRE Technique : T1584.008 - Network Devices
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:33:19.472061+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_008_Edge_Device_Mgmt_Probe_Then_Outbound_Relay {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An external source connects to a management-plane port on an internal or edge network device, and within ten minutes the same device initiates outbound connections to an external destination on proxy, relay, SSH, Telnet or SMTP ports. This sequence is consistent with an edge device or SOHO router being compromised and used as proxy or relay infrastructure for later operations."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.008"
    mitre_technique_name = "Compromise Infrastructure: Network Devices"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs that record both inbound and outbound sessions with source and destination IP and destination port, normalised to UDM NETWORK_CONNECTION."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Administrators or MSPs managing a device from an unlisted external address while the device legitimately initiates SSH, SMTP or proxy connections; devices configured as mail relays or upstream proxy clients; vendor remote support sessions; external vulnerability scans that are not yet allowlisted."
    tuning_guidance = "Add authorised management source addresses to %global_allowed_mgmt_sources and approved scanning sources to %global_allowed_scanners. Adjust the port sets to match the management and relay services in use at the client. Where the firewall logs post-NAT addresses, confirm the device address is consistent across the inbound and outbound records so the join on device IP works."

  events:
    $inb.metadata.event_type = "NETWORK_CONNECTION"
    $inb.target.ip = $device_ip
    (
      $inb.target.port = 22 or
      $inb.target.port = 23 or
      $inb.target.port = 161 or
      $inb.target.port = 2222 or
      $inb.target.port = 8291 or
      $inb.target.port = 8443 or
      $inb.target.port = 10443
    )
    not $inb.principal.ip in %rfc1918_internal
    not $inb.principal.ip in %global_allowed_mgmt_sources
    not $inb.principal.ip in %global_allowed_scanners

    $outb.metadata.event_type = "NETWORK_CONNECTION"
    $outb.principal.ip = $device_ip
    (
      $outb.target.port = 22 or
      $outb.target.port = 23 or
      $outb.target.port = 25 or
      $outb.target.port = 1080 or
      $outb.target.port = 3128 or
      $outb.target.port = 8080 or
      $outb.target.port = 8888 or
      $outb.target.port = 9050
    )
    not $outb.target.ip in %rfc1918_internal

    $inb.metadata.event_timestamp.seconds <= $outb.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1584.008")
    $primary_entity = array_distinct($device_ip)
    $probing_sources = array_distinct($inb.principal.ip)
    $probed_ports = array_distinct($inb.target.port)
    $outbound_destinations = array_distinct($outb.target.ip)
    $outbound_ports = array_distinct($outb.target.port)
    $outbound_conn_count = count($outb.metadata.id)

  condition:
    $inb and $outb
}
