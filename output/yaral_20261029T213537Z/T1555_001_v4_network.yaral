/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:40:17.397788+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Keychain_Binary_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the native macOS security command-line utility (the Keychain interface) making an outbound network connection to a non-internal address. The security binary normally works locally against the login, system and iCloud keychains. A direct external connection from it suggests it is being used or proxied for credential exfiltration, for example a reverse shell or an injected or hijacked process dumping keychain contents to a remote host. This is the network-side view of Keychain credential access and does not depend on command-line matching."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "macOS endpoint telemetry that records network connections with the initiating process path populated (principal.process.file.full_path), normalised to UDM NETWORK_CONNECTION."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "security subcommands that trigger online certificate or trust checks (OCSP/CRL), such as verify-cert; MDM or device-enrolment tooling that shells out to security for certificate or identity provisioning; enterprise SSO or certificate enrolment agents; developer code-signing workflows that talk to Apple services."
    tuning_guidance = "Add approved enrolment, MDM and certificate tooling to %global_allowed_admin_tools. Add EDR or security agents that wrap security to %global_allowed_security_tools. Add known-good vendor and Apple service domains to %global_allowed_domains. Review the destination_ips and destination_ports outcome fields to separate trust-validation traffic from exfiltration."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/usr\/bin\/security$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $acting_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
