/*
  MITRE Technique : T1592.004 - Client Configurations
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:42:05.606731+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_004_External_Client_Config_Probing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens a high volume of connections to common service and banner-bearing ports within ten minutes. This is consistent with active scanning used to collect client and server configuration details such as listening ports, banners and OS fingerprints. A single connection is benign; the volume and port spread are not."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.004"
    mitre_technique_name = "Gather Victim Host Information: Client Configurations"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, including inbound and denied connections."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, search-engine and internet-census crawlers, uptime and health-check monitors, partner or CDN probes, and NAT gateways that aggregate many legitimate users behind one address."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Raise the #net threshold on internet-facing segments with heavy legitimate traffic. Review the $distinct_ports outcome, because a high count of distinct ports indicates a sweep rather than a busy client. Use %global_allowed_mgmt_sources for approved external management sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 25 or
      $net.target.port = 53 or
      $net.target.port = 80 or
      $net.target.port = 110 or
      $net.target.port = 143 or
      $net.target.port = 443 or
      $net.target.port = 445 or
      $net.target.port = 993 or
      $net.target.port = 995 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(50)
    $event_count = count($net.metadata.id)
    $distinct_ports = count_distinct($net.target.port)
    $targeted_ips = array_distinct($net.target.ip)
    $mitre_technique_id = array_distinct("T1592.004")
    $primary_entity = array_distinct($src_ip)

  condition:
    #net >= 40
}
