/*
  MITRE Technique : T1590.006 - Network Security Appliances
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:22:15.387710+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_006_External_Probe_Of_Security_Appliance_Endpoints {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting URLs that point to network security appliance functions (firewall, UTM, WAF, IDS/IPS, VPN gateway, proxy auto-config, bastion) and receiving a client or server error response. This pattern is characteristic of reconnaissance that fingerprints the presence and type of perimeter security appliances. It is network-side coverage seen by the IPS/inline sensor and complements endpoint command-line detections."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.006"
    mitre_technique_name = "Gather Victim Network Information: Network Security Appliances"
    log_prerequisites = "IPS or inline network security sensor logs that include HTTP URL and HTTP response code, normalised to NETWORK_HTTP. Source IP (principal.ip) must be the original external client, not a NAT or proxy address."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface management services not yet in the scanner list; search-engine and internet-census crawlers; misconfigured remote-user VPN clients or browsers requesting stale portal paths; external partners or MSP staff using bookmarked appliance URLs; broken proxy auto-config or wpad lookups from roaming devices."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and trusted external management or partner sources to %global_allowed_mgmt_sources. If VPN-portal 4xx noise is high, tighten the URL regex to the appliance classes exposed by the client. For repeat-probe escalation, group alerts by $primary_entity downstream in SOAR."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(ssl-?vpn|web-?vpn|firewall|fw-?admin|waf|ips|ids|utm|wpad\.dat|proxy\.pac|bastion|jumpbox)(\/|\.|\?|$)/ nocase
    $http.network.http.response_code >= 400
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1590.006")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_urls = array_distinct($http.target.url)
    $probed_hosts = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
