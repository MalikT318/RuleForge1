/*
  MITRE Technique : T1583.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:10:34.519616+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_006_Bulk_External_Account_Signup_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host sends repeated HTTP POST requests to account signup or registration paths on external, non-allowlisted web services within ten minutes. Individual signups are benign, but bulk registration from one host can indicate automated creation of web-service accounts that adversaries later use for C2, exfiltration or phishing infrastructure. This is the only part of T1583.006 observable from perimeter telemetry, because most registration happens outside the victim network."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.006"
    mitre_technique_name = "Acquire Infrastructure: Web Services"
    log_prerequisites = "Requires perimeter proxy or firewall logs with HTTP URL and method visibility (for example TLS inspection or a forward proxy) normalised to UDM NETWORK_HTTP with principal.hostname populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Marketing or social-media teams creating multiple accounts, QA or developer sign-up testing, onboarding of staff to SaaS platforms, security awareness or phishing-simulation tooling, web crawlers or browser automation run by approved scripts."
    tuning_guidance = "Add known-good SaaS and vendor domains to %global_allowed_domains. Add approved scanners and test hosts to %global_allowed_scanners. Raise the #http threshold for noisy environments. Review the destination domains in the outcome to separate sanctioned onboarding from bulk registration."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|join)(\/|\?|$)/ nocase
    $http.principal.hostname = $host
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.006")
    $primary_entity = array_distinct($host)
    $event_count = count($http.metadata.id)
    $signup_domains = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 5
}
