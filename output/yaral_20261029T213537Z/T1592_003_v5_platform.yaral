/*
  MITRE Technique : T1592.003 - Firmware
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:40:01.218926+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_003_External_Probe_Of_Firmware_Management_Interfaces {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects connections from an external source to out-of-band management and firmware-level service ports (IPMI/RMCP, ASF-RMCP, Intel AMT/vPro web and redirection). External probing of these interfaces is a network-observable proxy for adversaries fingerprinting host firmware type and version (BMC, AMT, and similar) before targeting. Purely firmware-level reconnaissance from open data sets (job postings, invoices) is not visible to this rule."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.003"
    mitre_technique_name = "Gather Victim Host Information: Firmware"
    log_prerequisites = "Perimeter firewall or network flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, covering inbound traffic from the internet. Logs of denied connections are strongly preferred, because most probes are blocked."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability or attack-surface scanners, managed service provider or vendor remote hardware management over the internet, cloud-hosted monitoring that polls BMC/AMT, and unrelated services that happen to use ports in the 16992-16995 range."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management source addresses to %global_allowed_mgmt_sources. If the perimeter logs pre-NAT addresses, confirm that internal sources are covered by %rfc1918_internal. Management interfaces that are reachable from the internet should be remediated rather than allowlisted."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 623 or
      $net.target.port = 664 or
      $net.target.port = 16992 or
      $net.target.port = 16993 or
      $net.target.port = 16994 or
      $net.target.port = 16995
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1592.003")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
