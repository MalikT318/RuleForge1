/*
  MITRE Technique : T1593 - Search Open Websites/Domains
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:43:01.137446+00:00
  Reference       : https://attack.mitre.org/techniques/T1593
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_Search_Dork_Operators_In_Inbound_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects inbound HTTP requests from external sources where the request URL or referring URL carries search-engine dork operators (inurl, intitle, intext, filetype and similar) in a query parameter. This indicates a visitor arrived from, or is replaying, an open-web dorking search aimed at the organisation's exposed web assets. It is network-side evidence of T1593 reconnaissance."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593"
    mitre_technique_name = "Search Open Websites/Domains"
    log_prerequisites = "IDS/IPS or inline network security appliance logging HTTP transactions with URL and referrer populated in UDM (target.url, network.http.referral_url). Requires visibility of inbound traffic to internet-facing web servers; TLS inspection is needed for HTTPS visibility."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security researchers and bug-bounty participants; authorised external attack-surface or SEO audits; site-search features legitimately passing operator-like text; marketing and crawler tools that replay search queries; the organisation's own red team or external penetration testers."
    tuning_guidance = "Add authorised testing and attack-surface scanning source addresses to %global_allowed_scanners. Referrer data is often stripped by modern browsers, so expect low volume and treat hits as context for correlation with later scanning or phishing activity rather than as standalone incidents. Raise severity if the same source also hits sensitive paths."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    (
      $http.network.http.referral_url = /[?&](q|query|p|search|s|text)=[^&]*(inurl|allinurl|intitle|allintitle|intext|allintext|filetype|ext)(:|%3a)/ nocase or
      $http.target.url = /[?&](q|query|p|search|s|text)=[^&]*(inurl|allinurl|intitle|allintitle|intext|allintext|filetype|ext)(:|%3a)/ nocase
    )
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1593")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)
    $referrer = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
