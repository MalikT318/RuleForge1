/*
  MITRE Technique : T1588.004 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:00:49.634686+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_004_ACME_Certificate_Issuance_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source issues a high volume of ACME protocol requests (new-account, new-order, authz, challenge, finalize, cert) to external hosts within ten minutes. Each request is benign on its own. A burst of them from a host that is not a managed certificate client can indicate automated acquisition of TLS certificates for adversary-controlled or hijacked domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.004"
    mitre_technique_name = "Obtain Capabilities: Digital Certificates"
    log_prerequisites = "Requires forward-proxy or perimeter HTTP logs with the full request URL populated in target.url, normalised to NETWORK_HTTP. TLS-inspection or explicit proxy logging is needed to see URL paths."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate certificate automation: ACME clients on web servers, load balancers, ingress controllers and cert-manager style agents renewing certificates; PKI or DevOps staff testing issuance; internal ACME-compatible CAs."
    tuning_guidance = "Add known certificate-automation destinations to %global_allowed_domains. Exclude approved ACME client sources by adding their source addresses to %global_allowed_mgmt_sources and extending the exclusion in the rule. Raise the #http threshold in noisy environments with many auto-renewing hosts."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/acme\/(new-nonce|new-acct|new-order|new-authz|authz|chall|finalize|cert|renewal-info|revoke-cert)|\/acme\/[a-z0-9_-]*\/?directory/ nocase
    $http.principal.ip = $src
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(if(count($http.metadata.id) >= 30, 70, 45))
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1588.004")
    $primary_entity = array_distinct($src)
    $acme_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 10
}
