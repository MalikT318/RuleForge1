/*
  MITRE Technique : T1598.003 - Spearphishing Link
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:16:26.160239+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_003_Lookalike_Domain_Lookup_Then_Credential_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a client resolving a deceptive, credential-lure style domain (punycode or login/verify/SSO keywords combined with hyphenation) and then submitting an HTTP POST to an external login-style URL within 10 minutes. This pattern matches a user following a spearphishing link to a fake login portal and submitting credentials."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.003"
    mitre_technique_name = "Phishing for Information: Spearphishing Link"
    log_prerequisites = "Requires perimeter or proxy telemetry with NETWORK_DNS events (query name populated) and NETWORK_HTTP events (HTTP method and target URL populated, e.g. from a TLS-inspecting proxy or firewall). Client source IP must be populated in both."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate third-party SSO, HR, payroll, or benefits portals on hyphenated vendor domains; internationalised (punycode) domains used by legitimate businesses; security awareness phishing simulations; sanctioned SaaS login flows not yet in the allowlist."
    tuning_guidance = "Add known-good vendor and SSO domains to %global_allowed_domains. Add authorised phishing-simulation sources to %global_allowed_scanners. Exclude known-good internal client or proxy egress sources via %global_allowed_mgmt_sources. Raise or lower the keyword set in the DNS regex to suit client naming conventions."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(xn--|(login|signin|verify|secure|webmail|sso|password|account)[a-z0-9]*-[a-z0-9-]+\.[a-z]{2,}$|-[a-z0-9]*(login|signin|verify|secure|webmail|sso|password|account)\.[a-z]{2,}$)/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %rfc1918_internal
    $dns.principal.ip = $client_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /(login|signin|logon|verify|auth|password|account|sso|webmail)/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    $http.principal.ip = $client_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $client_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1598.003")
    $primary_entity = array_distinct($client_ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $post_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $post_count = count($http.metadata.id)

  condition:
    $dns and $http
}
