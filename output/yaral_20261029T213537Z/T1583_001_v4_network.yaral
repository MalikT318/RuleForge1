/*
  MITRE Technique : T1583.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:59:24.913129+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_001_Punycode_IDN_Domain_DNS_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for internationalized domain names encoded as punycode (an 'xn--' label). Adversaries register IDN homograph lookalike domains (T1583.001) to impersonate trusted brands for phishing, drive-by delivery and C2. Queries for domains in the known-good list, or that resolve to internal address space, are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.001"
    mitre_technique_name = "Acquire Infrastructure: Domains"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate internationalized domains (non-Latin-script sites, regional news, e-commerce and government sites), browsers or mail clients resolving IDN links, multilingual organisations, and security-awareness or phishing-simulation tooling."
    tuning_guidance = "Add known-good IDN domains and CDNs to %global_allowed_domains. If the tenant legitimately uses many IDNs, treat this as a hunting or enrichment signal and raise the score only when combined with other signals. Internal-resolving answers are excluded using %rfc1918_internal."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)xn--[a-z0-9-]{3,}(\.|$)/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1583.001")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $resolved_data = array_distinct($dns.network.dns.answers.data)

  condition:
    $dns
}
