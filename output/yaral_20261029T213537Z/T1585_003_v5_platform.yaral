/*
  MITRE Technique : T1585.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:39:08.522392+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_003_Cloud_Account_Signup_Via_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an outbound HTTP POST seen at the network perimeter to an external host whose URL path matches an account registration or signup workflow. This is the network-observable footprint of creating a cloud, SaaS or hosting account that could later support staging, exfiltration or infrastructure acquisition (T1585.003). Domains are not hardcoded, so the rule matches the registration behaviour across any provider. Known-good destinations are excluded through a reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.003"
    mitre_technique_name = "Establish Accounts: Cloud Accounts"
    log_prerequisites = "Requires perimeter or proxy HTTP logs normalised to UDM NETWORK_HTTP with network.http.method, target.url, target.hostname and target.ip populated. TLS inspection or URL-level logging must be enabled, otherwise URL paths are not visible."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees legitimately registering for business SaaS trials, vendor portals, webinar or conference sign-ups, and personal account registration during browsing. Marketing and procurement teams are the most common sources. Internal web applications behind a reverse proxy can also match."
    tuning_guidance = "Add approved vendor and SaaS registration domains to %global_allowed_domains. Review the matched hostnames and source IPs in the outcome variables to separate expected business sign-ups from unsanctioned storage or hosting accounts. Where this is noisy, correlate by source over time in a downstream playbook or raise severity only for sources that also show large outbound transfers."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|account\/(create|new)|accounts\/new|get[-_]?started\/create)(\/|\?|#|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1585.003")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
