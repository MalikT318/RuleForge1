/*
  MITRE Technique : T1583.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:09:27.704611+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_006_External_Web_Service_Account_Registration_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal client submitting an HTTP POST to an account-registration or sign-up URL path on an external web service, as seen at the proxy or firewall. This is the network-observable side of registering a web service (code hosting, paste, cloud storage, social, mail) that could later be used for C2, exfiltration or phishing. The rule matches the behavioural URL structure of a registration flow rather than any specific service domain. It is a low-fidelity hunting and triage signal, not a confirmed-malicious alert."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.006"
    mitre_technique_name = "Acquire Infrastructure: Web Services"
    log_prerequisites = "Requires a forward proxy, SWG, or TLS-inspecting firewall that logs full HTTP method and URL (path included) as NETWORK_HTTP events. Without TLS inspection the URL path is not visible and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees legitimately registering for SaaS trials, webinars, vendor portals or developer accounts; marketing and procurement staff; sanctioned onboarding to new business applications; QA or automation testing of signup flows; browsers or apps issuing POSTs to registration endpoints for approved services."
    tuning_guidance = "Add sanctioned external service domains to %global_allowed_domains. Add known-good egress or test sources to %global_allowed_scanners or %global_allowed_mgmt_sources via a copy of this rule if needed. Raise severity only when combined with other signals, such as a first-seen domain or later high-volume uploads to the same host. Consider limiting scope to server or sensitive-segment source ranges, where user self-registration is not expected."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(signup|sign-up|sign_up|register|registration|create-account|create_account|createaccount|account\/new|join)(\/|\?|$)/ nocase
    $http.target.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1583.006")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)
    $request_count = count($http.metadata.id)

  condition:
    $http
}
