/*
  MITRE Technique : T1574.004 - Dylib Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:54:31.252615+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_004_Mass_Dylib_Drop_In_Hijackable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several .dylib files are created within ten minutes on one macOS host, in user-writable locations or inside application bundle directories that the dynamic loader searches (@rpath, Frameworks, MacOS). Dropping multiple dylibs into these locations is consistent with planting dylibs named after missing or weakly linked libraries. A single drop is common and benign; the volume is the signal."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.004"
    mitre_technique_name = "Hijack Execution Flow: Dylib Hijacking"
    log_prerequisites = "Requires macOS endpoint telemetry that reports file creation events with the writing process path (EDR or unified log file-system events)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developers building or unpacking projects in home directories, application self-updaters (Sparkle-style updaters), drag-and-drop installs of apps that bundle many frameworks, package installers, Electron or Python virtualenv extraction, and IT software deployment."
    tuning_guidance = "Add deployment and patching tooling to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Raise the #file threshold for developer fleets, or add developer build tools to %global_allowed_script_hosts and extend the exclusion. Review the writer_processes and dylib_paths outcome values to find recurring benign updaters."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(Users\/[^\/]+\/(Library|Downloads|Desktop|Documents)|Users\/Shared|private\/tmp|tmp|private\/var\/tmp|Applications\/[^\/]+\.app\/Contents\/(Frameworks|MacOS|Resources))\/.*\.dylib$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(installd|system_installd|Installer|storedownloadd|softwareupdated|Autoupdate|ShipIt)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1574.004")
    $primary_entity = array_distinct($host)
    $dylib_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
