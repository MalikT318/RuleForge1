/*
  MITRE Technique : T1037.002 - Login Hook
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:53:59.680895+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_002_LoginHook_Plist_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the defaults or PlistBuddy utility writing a LoginHook or LogoutHook key into the com.apple.loginwindow preference domain. A hook makes macOS run the referenced script as root at the next user logon or logoff, which gives persistence and privilege escalation. The rule matches the combination of the loginwindow domain, a hook key name and a write-style verb, so it does not depend on the script path, filename or payload."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.002"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Login Hook"
    log_prerequisites = "macOS endpoint telemetry with process-launch events that include full command-line arguments."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy enterprise management or imaging scripts that still configure login or logout hooks (for example older lab or kiosk provisioning, directory-binding or compliance tooling), and administrators maintaining legacy hooks by hand. Hooks were deprecated in macOS 10.11, so legitimate use should be rare and easy to baseline."
    tuning_guidance = "Add the parent process of approved provisioning or management tooling to %global_allowed_admin_tools. Review the hook script path in the command line and confirm it is root-owned and in an expected location. If a client has no legacy hooks, keep severity at High and escalate every hit."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(defaults|PlistBuddy)$/ nocase
    $proc.target.process.command_line = /loginwindow/ nocase
    $proc.target.process.command_line = /(login|logout)hook/ nocase
    $proc.target.process.command_line = /\b(write|import|add|set|merge)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1037.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $hook_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
