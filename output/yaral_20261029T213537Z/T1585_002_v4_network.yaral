/*
  MITRE Technique : T1585.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:37:09.521546+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_002_Webmail_Account_Signup_Post {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an HTTP POST to an account-registration URL path on an external mail-oriented hostname. This is the network-observable step of creating a free or disposable email account (T1585.002). Adversary account creation normally happens outside the defender's visibility, so this fires only when the signup is made from a monitored network, such as a compromised host, an insider, or an adversary operating from client infrastructure. Treat it as a low-fidelity hunting lead that needs enrichment."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.002"
    mitre_technique_name = "Establish Accounts: Email Accounts"
    log_prerequisites = "Requires a proxy or perimeter firewall with TLS inspection or URL logging that populates network.http.method, target.url and target.hostname. Without URL visibility the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees legitimately registering for corporate-approved mail or marketing platforms, IT staff provisioning accounts at hosted email vendors, security awareness or phishing-simulation tooling, QA testing of the organisation's own signup flows, and web crawlers or scanners submitting registration forms."
    tuning_guidance = "Add sanctioned vendor domains to %global_allowed_domains. Add authorised testing sources to %global_allowed_scanners. If volume is high, restrict to unmanaged or server subnets, or promote to a Threshold rule that counts signup POSTs per source."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.hostname = /(mail|inbox)/ nocase
    $net.target.url = /(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|account[-_]?creation)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1585.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $request_urls = array_distinct($net.target.url)

  condition:
    $net
}
