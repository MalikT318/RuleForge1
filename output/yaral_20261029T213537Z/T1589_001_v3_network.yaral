/*
  MITRE Technique : T1589.001 - Credentials
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:07:01.776755+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_001_Exposed_Credential_File_Probe_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "External source requests well-known credential-bearing or secret-exposing resources (environment files, VCS metadata, cloud credential stores, private key material, config backups) on an organisation-facing web service. This is the network-side footprint of an adversary harvesting credentials that were accidentally exposed on public infrastructure. A successful (HTTP 200) response scores higher because it means credentials were likely disclosed."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.001"
    mitre_technique_name = "Gather Victim Identity Information: Credentials"
    log_prerequisites = "Requires perimeter proxy, reverse proxy, WAF or firewall logs with L7 inspection that populate network.http fields and target.url for inbound web requests, normalised to NETWORK_HTTP. Pure L3/L4 firewall logs will not populate target.url."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, bug bounty researchers, internet-wide research crawlers, and misconfigured internal tooling that egresses through a public address. Internet background noise will trigger low-severity hits on any internet-facing site."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Confirm %rfc1918_internal covers the client's internal ranges. Alert on HTTP 200 responses first (risk 80); 3xx/4xx hits (risk 50) can be routed to a lower-priority queue or aggregated per source IP in SOAR. Add verified managed-attack-surface vendors to %global_allowed_scanners."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/\.git\/(config|HEAD|index)|\/\.svn\/(entries|wc\.db)|\/\.hg\/|\/\.env(\.[a-z0-9_-]+)?([?#]|$)|\/\.aws\/credentials|\/\.ssh\/(id_[a-z0-9]+|authorized_keys)|\/\.htpasswd|\/\.npmrc|\/\.pgpass|\/\.netrc|\/\.docker\/config\.json|\/credentials\.json|\/secrets?\.(json|ya?ml|txt)|\/wp-config\.php(\.|~|_)?(bak|old|orig|save|swp|txt)?|\/web\.config(\.|~)(bak|old|orig|txt)|\/config\.(php|json|ya?ml)\.(bak|old|orig|save|txt)|\/[a-z0-9_-]+\.(sql|bak)(\.gz|\.zip)?([?#]|$))/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(if($http.network.http.response_code = 200, 80, 50))
    $mitre_technique_id = array_distinct("T1589.001")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $http_response_codes = array_distinct($http.network.http.response_code)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
