/*
  MITRE Technique : T1583.008 - Malvertising
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:13:07.914407+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_008_Malvertising_AdClick_To_Installer_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a web request for an executable, installer, disk image or archive where the request URL or its referring page carries an advertising click-identifier parameter (gclid, gbraid, wbraid, msclkid, yclid). This is the observable end of a malvertising chain: a user clicks a paid ad and is steered to a lookalike landing page that serves a trojanized installer. The detection keys on the paid-click parameter plus a software-download extension, not on specific domains or brands."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.008"
    mitre_technique_name = "Acquire Infrastructure: Malvertising"
    log_prerequisites = "Requires proxy or firewall HTTP logging with full URL (including query string) and referral URL populated; TLS inspection is needed for HTTPS visibility of URL paths."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate software vendors that advertise downloads through paid search and serve installers from the same ad-tagged landing page; marketing-driven download campaigns; IT staff downloading approved tools via a search ad."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. If the environment lacks TLS inspection or referral URL logging, the rule will have limited coverage. Consider raising severity for user segments that cannot install software. Pair with a proxy category or newly-registered-domain enrichment to raise the risk score."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    (
      $http.target.url = /[?&](gclid|gbraid|wbraid|msclkid|yclid)=/ nocase or
      $http.network.http.referral_url = /[?&](gclid|gbraid|wbraid|msclkid|yclid)=/ nocase
    )
    $http.target.url = /\.(exe|msi|msix|appx|dmg|pkg|iso|img|scr|zip|7z|rar)([?#]|$)/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.008")
    $primary_entity = array_distinct($http.principal.ip)
    $download_urls = array_distinct($http.target.url)
    $referral_urls = array_distinct($http.network.http.referral_url)
    $destination_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
