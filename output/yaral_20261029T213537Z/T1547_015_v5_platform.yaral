/*
  MITRE Technique : T1547.015 - Login Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:47:49.918561+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_015_macOS_LoginItem_Store_Tampered {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the per-user macOS login item stores (shared file list .sfl2/.sfl3 files and the Background Task Management backgroundItems .btm file) by a process other than the Apple components that legitimately maintain them. Direct writes by scripts, dropped binaries or installers indicate login item persistence being planted without going through System Settings. This is file-based coverage and does not depend on the osascript or command-line content that process-creation rules inspect."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.015"
    mitre_technique_name = "Boot or Logon Autostart Execution: Login Items"
    log_prerequisites = "macOS endpoint telemetry with file modification events that include the writing process path (EDR file events or Endpoint Security framework file write events). Hidden /Users/*/Library paths must be covered by file monitoring."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or configuration management agents that provision login items; backup or migration tools restoring user profiles (Migration Assistant, Time Machine restores); third-party application installers or updaters that register a helper as a login item; user profile sync tools."
    tuning_guidance = "Add approved MDM and deployment agent binary paths to %global_allowed_admin_tools and restore or imaging tools to %global_allowed_backup_processes. Where the EDR attributes writes to the Apple daemons on behalf of other processes (for example sharedfilelistd acting for osascript), pair this rule with the existing process-based detection, since the daemon exclusion hides those writes. Review the file path in the alert to tell shared file list persistence from SMAppService/BTM entries."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/Users\/[^\/]+\/Library\/Application Support\/(com\.apple\.sharedfilelist\/[^\/]*\.sfl[0-9]*|com\.apple\.backgroundtaskmanagementagent\/backgroundItems[^\/]*\.btm)$/ nocase
    not $file.principal.process.file.full_path = /\/(sharedfilelistd|backgroundtaskmanagementd|backgroundtaskmanagementagent|smd|Finder|System Settings|System Preferences|coreservicesd|launchservicesd|mds|mdworker|mdworker_shared)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.015")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $modified_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
