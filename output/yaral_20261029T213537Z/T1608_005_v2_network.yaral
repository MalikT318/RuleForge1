/*
  MITRE Technique : T1608.005 - Link Target
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:28:35.928851+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_005_Link_Target_Credential_Lure_On_Bare_IP_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client requesting an external URL whose host is a bare IPv4 address and whose path or query looks like a credential-harvesting or account-verification lure (login, signin, verify, password, webmail, SSO). This is the network-side footprint of a user following a phishing link to an adversary-staged link target (T1608.005). Legitimate services almost never serve login pages from a raw IP address."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.005"
    mitre_technique_name = "Stage Capabilities: Link Target"
    log_prerequisites = "Requires proxy or perimeter firewall logs normalised to NETWORK_HTTP with target.url populated (full URL visibility, either through explicit proxy or TLS inspection) and principal.ip or target.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal or vendor appliances and web management consoles reached by IP with login pages (printers, IPMI/BMC, NAS, network gear) where the destination is routable or not listed in %rfc1918_internal; captive portals; IoT or SaaS onboarding flows using IP-literal URLs; authorised phishing simulations and red team exercises; vulnerability scanners crawling login pages."
    tuning_guidance = "Add authorised scanners and phishing-simulation sources to %global_allowed_scanners. Add known-good destination hostnames to %global_allowed_domains. Make sure %rfc1918_internal covers all private address space in use. Raise severity or add response-code filtering for clients where proxy logs reliably populate network.http.response_code. Extend the lure keyword group per client if needed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /^(https?:\/\/)?(\w+(:[^@\/]*)?@)?\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?\/.*(log[-_]?in|sign[-_]?in|signon|verify|validate|account|passw(or)?d|credential|webmail|owa|sso|auth|secure)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1608.005")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
