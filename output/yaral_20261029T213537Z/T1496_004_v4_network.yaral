/*
  MITRE Technique : T1496.004 - Cloud Service Hijacking
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:20:06.596105+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_004_External_Scripted_Client_Messaging_Or_Inference_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP request to a cloud messaging (bulk email/SMS/notification) or hosted AI inference API operation, made from a non-internal source address by a scripted, non-browser client and attributed to an identity that is not an approved service principal. This is the network-side pattern of cloud service hijacking: stolen credentials driving spam/phishing delivery or LLM reverse-proxy abuse from attacker infrastructure."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.004"
    mitre_technique_name = "Resource Hijacking: Cloud Service Hijacking"
    log_prerequisites = "Cloud audit or API gateway telemetry normalised to NETWORK_HTTP with principal.ip, principal.user.userid, target.url and network.http.user_agent populated. If the client's control-plane logs do not populate these fields, the rule will not evaluate."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate marketing, notification or transactional-messaging applications calling from external (non-RFC1918) egress IPs; developers or data scientists testing inference APIs from home or office NAT addresses with SDKs or scripts; CI/CD pipelines and SaaS integrations running from external hosted runners."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add approved admin accounts to %global_allowed_admin_users. Add approved vendor endpoints to %global_allowed_domains. Add approved egress and management source addresses to %global_allowed_mgmt_sources. Extend the user-agent pattern if the client's approved SDKs are not covered, and consider raising severity for identities with no prior history of these API calls."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(?i)(send(bulk|raw|templated|custom)?(verification)?(email|sms|message|messages|voice)|publishbatch|invokemodel|invoke-with-response-stream|converse(stream)?|chat\/completions|\/v1\/(completions|messages|responses))/
    $net.network.http.user_agent = /(?i)(python|curl|wget|go-http|aiohttp|httpx|requests|node|axios|okhttp|java|libwww|sdk|^$)/
    $net.principal.user.userid != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_cloud_principals
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1496.004")
    $primary_entity = array_distinct($net.principal.user.userid)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
