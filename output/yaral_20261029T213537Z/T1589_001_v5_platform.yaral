/*
  MITRE Technique : T1589.001 - Credentials
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:07:39.035550+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_001_External_Request_For_Exposed_Credential_Files {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external source successfully retrieving (HTTP 2xx) well-known credential and secret files from an internet-facing web server or reverse proxy. Examples are dotenv files, cloud CLI credential files, git credential stores, SSH private keys, and backup copies of application config files. This is the observable result of credential-gathering reconnaissance against the organisation's external footprint. It also indicates the credentials are exposed and should be treated as compromised. The rule is path-based and platform-neutral, covering Linux/Unix-style web roots and cloud-hosted web workloads rather than Windows endpoints."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.001"
    mitre_technique_name = "Gather Victim Identity Information: Credentials"
    log_prerequisites = "Requires perimeter, reverse-proxy, WAF or load-balancer HTTP logs normalised to UDM NETWORK_HTTP with target.url, principal.ip and network.http.response_code populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external penetration tests or attack-surface scanners not yet in the scanner list; a legitimate public file that happens to share a secret-style name, such as a published sample config; security research or bug-bounty traffic against intentionally exposed assets; honeypot or canary web paths."
    tuning_guidance = "Add authorised scanner and pen-test source IPs to %global_allowed_scanners. If the proxy does not populate network.http.response_code, remove the 2xx condition and expect higher volume (attempts as well as successes), then lower severity to Medium. Treat any hit that passes the filters as a confirmed credential exposure and rotate the affected secrets."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/\.(env|git-credentials|git\/config|npmrc|netrc|pgpass|htpasswd|aws\/credentials|docker\/config\.json|kube\/config|ssh\/(id_rsa|id_ed25519|id_ecdsa)))(\?|#|$|\.[a-z0-9_-]+$)|\/(wp-config|config|settings|database|secrets|credentials|application)\.(php|py|ya?ml|json|properties|inc|ini)(\.(bak|old|orig|save|swp|txt|zip|tar\.gz)|~)(\?|$)|\/(id_rsa|id_dsa|id_ecdsa|id_ed25519)(\?|$)/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1589.001")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
