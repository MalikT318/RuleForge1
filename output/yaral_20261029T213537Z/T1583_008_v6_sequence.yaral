/*
  MITRE Technique : T1583.008 - Malvertising
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:14:32.289793+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_008_Malvertising_AdClick_Then_Installer_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a client making an HTTP request carrying an advertising click identifier (the signature of a visit arriving via a paid ad) to an external site, followed within 10 minutes by a download of an executable or installer package from an external host. This sequence is consistent with malvertising that sends users to cloned vendor sites hosting trojanized software."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.008"
    mitre_technique_name = "Acquire Infrastructure: Malvertising"
    log_prerequisites = "Requires proxy or firewall logs with full HTTP URL visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP with target.url, target.hostname, target.ip and principal.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users legitimately reaching vendor download pages from search or social ads (software vendors, SaaS onboarding); marketing teams testing campaigns; software update portals that use tracking parameters on installer links."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. If principal.ip is a NAT or proxy address in a client environment, tighten the join by adding a per-user field or lengthen exclusions. Extend or reduce the installer extension list in the download regex to match the client's software policy."

  events:
    $click.metadata.event_type = "NETWORK_HTTP"
    $click.target.url = /[?&](gclid|gbraid|wbraid|dclid|msclkid|fbclid)=/ nocase
    not $click.target.hostname in %global_allowed_domains
    not $click.target.ip in %rfc1918_internal
    $click.principal.ip = $src_ip

    $dl.metadata.event_type = "NETWORK_HTTP"
    $dl.target.url = /\.(exe|msi|msix|appx|scr|dmg|pkg|iso|img)(\?|$)/ nocase
    not $dl.target.hostname in %global_allowed_domains
    not $dl.target.ip in %rfc1918_internal
    $dl.principal.ip = $src_ip

    $click.metadata.event_timestamp.seconds <= $dl.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.008")
    $primary_entity = array_distinct($src_ip)
    $ad_click_urls = array_distinct($click.target.url)
    $download_urls = array_distinct($dl.target.url)
    $download_hosts = array_distinct($dl.target.hostname)
    $download_count = count($dl.metadata.id)

  condition:
    $click and $dl
}
