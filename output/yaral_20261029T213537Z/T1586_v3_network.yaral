/*
  MITRE Technique : T1586 - Compromise Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:40:35.495972+00:00
  Reference       : https://attack.mitre.org/techniques/T1586
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_External_Scripted_Login_Failure_Web {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source sending a failed (HTTP 401/403) credential POST to an authentication endpoint using a scripted HTTP client user-agent. This is the network-side signature of automated credential stuffing or password-reuse attempts used to compromise existing accounts."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586"
    mitre_technique_name = "Compromise Accounts"
    log_prerequisites = "Requires perimeter proxy, WAF or reverse-proxy HTTP logs that populate network.http.method, network.http.response_code, network.http.user_agent, target.url and principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised penetration tests or vulnerability scans not yet in the allowlist, customer-owned API integrations or monitoring probes that authenticate with scripted clients and use stale credentials, partner automation after a password rotation, and uptime or synthetic-login monitors."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. For high-volume tenants, pair this rule with a threshold variant that groups by principal.ip, or promote severity once the same source repeats."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(login|signin|sign-in|logon|auth|authenticate|session|sso|oauth2?\/token|owa\/auth)(\/|\?|\.|$)/ nocase
    $http.network.http.response_code >= 401
    $http.network.http.response_code <= 403
    $http.network.http.user_agent = /^(python-requests|python-urllib|aiohttp|httpx|curl|wget|go-http-client|okhttp|libwww-perl|axios|node-fetch|java|apache-httpclient)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1586")
    $primary_entity = array_distinct($http.principal.ip)
    $target_host = array_distinct($http.target.hostname)
    $target_url = array_distinct($http.target.url)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
