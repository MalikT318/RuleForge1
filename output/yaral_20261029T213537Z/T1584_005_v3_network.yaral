/*
  MITRE Technique : T1584.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:26:12.337293+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_005_Botnet_DNS_Long_Label_TXT_NULL_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries of type TXT or NULL whose name contains a very long, random-looking alphanumeric label. This pattern is typical of botnet C2 channels, DNS tunnelling and algorithmically generated domains used to coordinate compromised third-party hosts. Known-good registered domains are excluded through a reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.005"
    mitre_technique_name = "Compromise Infrastructure: Botnet"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS, with network.dns.questions.name and network.dns.questions.type populated. Resolver logs that record the real client address (principal.ip) give the best triage context."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security records (DKIM, SPF, DMARC TXT lookups with long selectors), CDN and cloud load-balancer hostnames with long generated labels, DNS-based blocklist or reputation lookups, endpoint security products that use DNS for telemetry or licensing, and software update services using hashed subdomains."
    tuning_guidance = "Add known-good registered domains (for example email security vendors, CDNs, update services) to %global_allowed_domains. The exclusion matches the lowercased last two labels of the queried name. For multi-label public suffixes such as co.uk, list the full suffix form. Adjust the {28,} label-length threshold per client. Internal-client exclusion is deliberately not applied, because on recursive resolver logs principal.ip is the internal client and excluding %rfc1918_internal would suppress every event. If the log source is an external-facing authoritative server, add 'not $dns.principal.ip in %rfc1918_internal'."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /(?i)(^|\.)[a-z0-9]{28,}\./
    $dns.network.dns.questions.name = /(?i)([a-z][0-9]|[0-9][a-z])/
    $reg_domain = strings.to_lower(re.capture($dns.network.dns.questions.name, "([^.]+\\.[^.]+)\\.?$"))
    not $reg_domain in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584.005")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $registered_domains = array_distinct($reg_domain)

  condition:
    $dns
}
