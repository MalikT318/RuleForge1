/*
  MITRE Technique : T1589 - Gather Victim Identity Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:05:27.793973+00:00
  Reference       : https://attack.mitre.org/techniques/T1589
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_External_User_Enumeration_Endpoint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting web endpoints that reveal whether a username or email address is valid (CMS user-listing APIs, author-ID enumeration, credential-type or account-exists lookups, autodiscover email probes). This is the network-side signature of victim identity gathering."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589"
    mitre_technique_name = "Gather Victim Identity Information"
    log_prerequisites = "Requires proxy, web gateway or perimeter firewall logs that populate the HTTP request URL (target.url) and the external source IP (principal.ip) as NETWORK_HTTP events. TLS inspection or reverse-proxy visibility is needed for URL-level data."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and penetration tests, SEO and uptime crawlers that follow author archive links, legitimate mail clients performing autodiscover, partner SSO or registration flows that call account-availability checks, and sign-up forms that validate usernames."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners. Add trusted partner or vendor domains to %global_allowed_domains. If the environment has no externally exposed CMS or identity services, the rule can be narrowed to the autodiscover and account-lookup patterns only."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/wp-json\/wp\/v2\/users|[?&]author=\d+(&|$)|\/GetCredentialType|\/autodiscover\/autodiscover\.json.*[?&]email=|\/(user|username|email|account)[_-]?(exists|check|lookup|available|validate)|\/api\/v\d+\/(users|accounts)\/(lookup|exists|check))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1589")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
