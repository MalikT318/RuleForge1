/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:09:12.954984+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_macOS_Script_Client_Mailbox_Forwarding_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS command-line or scripting process (curl, python, osascript, node and similar) sending a write request (POST, PATCH or PUT) to a mailbox API path that creates inbox rules, forwarding addresses, auto-forwarding settings or mail filters. Legitimate mail clients rarely do this from a scripting runtime. Attackers with stolen tokens or credentials commonly create forwarding rules this way to collect mail and keep access after a password reset. Internal destinations and approved domains are excluded."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires macOS endpoint network telemetry that records the HTTP URL and method, such as an EDR with TLS-aware network events or a decrypting proxy or secure web gateway forwarding NETWORK_HTTP events with principal process context. Plain NETWORK_CONNECTION events do not carry URL paths."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "IT automation or migration scripts that provision mailbox rules through the Graph or Gmail APIs, approved mail-management tooling, developers testing mail integrations, and helpdesk scripts run for users."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools and approved script parents or hosts to %global_allowed_script_hosts. Add sanctioned mail-provider API domains to %global_allowed_domains if provisioning is expected. Add approved service accounts to %global_allowed_service_accounts. If the telemetry reports URL paths in a different field, adapt the URL match accordingly."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PATCH|PUT)$/ nocase
    $net.target.url = /\/(mailFolders\/[^\/]+\/messageRules|settings\/(forwardingAddresses|autoForwarding|filters))(\/|\?|$)/ nocase
    $net.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|osascript|node|ruby|perl|pwsh|bash|zsh|sh)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $target_url = array_distinct($net.target.url)
    $target_host = array_distinct($net.target.hostname)

  condition:
    $net
}
