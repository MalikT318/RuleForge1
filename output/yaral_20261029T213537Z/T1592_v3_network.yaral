/*
  MITRE Technique : T1592 - Gather Victim Host Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:34:20.661404+00:00
  Reference       : https://attack.mitre.org/techniques/T1592
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_External_Host_Fingerprint_Endpoint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source successfully requesting web endpoints that disclose host configuration (server status pages, PHP/runtime info pages, framework environment or diagnostic endpoints, dotenv files). This is network-side evidence of an adversary gathering victim host information (OS, software versions, configuration) before targeting. Matches the behaviour of requesting host-disclosure endpoints with a successful response, not a specific tool or user-agent."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592"
    mitre_technique_name = "Gather Victim Host Information"
    log_prerequisites = "Requires perimeter proxy, WAF or firewall logs with HTTP inspection that populate target.url, network.http.response_code and the source IP. Plain L3/L4 firewall logs without URL visibility will not produce matches."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services; external uptime or health monitors polling status or info endpoints; CDN or load-balancer health probes; developers and vendors testing from outside the corporate range; intentionally public status pages."
    tuning_guidance = "Add authorised scanner and monitor source addresses to %global_allowed_scanners. Add approved external probe sources to %global_allowed_mgmt_sources. If response codes are not populated by the log source, remove the response_code condition and raise the threshold in a companion rule. Extend the URL regex with client-specific diagnostic endpoints. Consider a Threshold variant to alert only on several distinct endpoints per source."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(server-status|server-info|phpinfo\.php|info\.php|\.env|actuator\/(env|info|configprops|health\/details)|cgi-bin\/(test-cgi|printenv)|elmah\.axd|trace\.axd|_profiler\/phpinfo)(\?|\/|$)/ nocase
    $http.network.http.response_code = 200
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1592")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_urls = array_distinct($http.target.url)
    $probed_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
