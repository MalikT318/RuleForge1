/*
  MITRE Technique : T1548.004 - Elevated Execution with Prompt
  Tactic(s)       : Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:34:15.771165+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_004_macOS_LaunchDaemon_Dropped_By_UserSpace_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a launchd plist created in /Library/LaunchDaemons or /Library/LaunchAgents by a process running from a user-writable location (Downloads, Desktop, temp, mounted disk image). Writing to these directories requires root. An unsigned or fake installer launched from user space that gains root through a credential prompt (AuthorizationExecuteWithPrivileges) and then installs persistence produces this file-creation pattern. The rule detects the result of the elevation rather than the process command line."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.004"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Elevated Execution with Prompt"
    log_prerequisites = "macOS endpoint telemetry that reports file creation events with the creating process path (EDR file events or Endpoint Security framework data) normalised to UDM FILE_CREATION."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate third-party installers or updaters run from a mounted DMG (/Volumes) or the Downloads folder that install a helper daemon. Package installers staging from /private/var/folders. MDM or software deployment agents that stage payloads in temp paths. Developer tools installing privileged helpers on first run."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and approved EDR or security agents to %global_allowed_security_tools. Add known installer service accounts to %global_allowed_service_accounts. Add named administrators who legitimately install software to %global_allowed_admin_users. Review recurring hits by creating-process path and add the vendor installer to %global_allowed_admin_tools if it is confirmed benign."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/Launch(Daemons|Agents)\/[^\/]+\.plist$/ nocase
    $file.principal.process.file.full_path = /^(\/Users\/[^\/]+\/(Downloads|Desktop|Documents|Public|Library\/Caches|Library\/Application Support)\/|\/private\/tmp\/|\/tmp\/|\/Volumes\/|\/private\/var\/folders\/|\/private\/var\/tmp\/|\/Users\/Shared\/)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_plist = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
