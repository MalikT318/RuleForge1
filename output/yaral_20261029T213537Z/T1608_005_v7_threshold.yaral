/*
  MITRE Technique : T1608.005 - Link Target
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:30:00.103798+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_005_Credential_Lure_Page_Request_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes repeated HTTP requests within ten minutes to external, non-allowlisted sites whose URL paths look like login, sign-in, verification or credential-recovery pages. Each request is benign on its own. A burst of them to unfamiliar domains is consistent with a user following links to adversary-staged link-target resources such as cloned login pages, or with automated analysis of those pages."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.005"
    mitre_technique_name = "Stage Capabilities: Link Target"
    log_prerequisites = "Requires perimeter or proxy HTTP logs normalised to UDM NETWORK_HTTP with target.url, target.hostname, target.ip and principal.ip populated. TLS inspection or a forward proxy is needed to see URL paths for HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees signing in to many legitimate SaaS or vendor portals, SSO or MFA redirect chains, password-manager and browser auto-login behaviour, web crawlers or QA tooling on internal hosts, and users on shared egress or NAT addresses."
    tuning_guidance = "Add known-good vendor and SaaS login domains to %global_allowed_domains. If a shared NAT or proxy address generates noise, exclude it upstream or raise the threshold. Raise the threshold from 5 to 8-10 on tenants with heavy SaaS use. Triage by reviewing $distinct_domains and $sample_urls for look-alike domains."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(log[-_]?in|sign[-_]?in|logon|sso|webmail|owa|verify|validate|account[-_]?(update|verify|recovery|confirm)|password[-_]?(reset|recovery)|secure[-_]?login)[^\/]*(\.(php|html?|aspx?|jsp))?(\?|$)/ nocase
    $http.principal.ip = $src_ip
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($http.metadata.id)
    $distinct_domains = array_distinct($http.target.hostname)
    $sample_urls = array_distinct($http.target.url)
    $mitre_technique_id = array_distinct("T1608.005")
    $primary_entity = array_distinct($src_ip)

  condition:
    #http >= 5
}
