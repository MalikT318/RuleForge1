/*
  MITRE Technique : T1598.004 - Spearphishing Voice
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:18:02.037733+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_004_Lure_Browsing_Then_External_SIP_Callback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Low"
    description = "Detects an internal client requesting an external web resource whose URL contains support, billing or urgency lure wording, followed within 10 minutes by an outbound SIP signalling connection from the same client to an external address. This sequence is a network-observable proxy for callback-style voice phishing, where a lure page prompts the user to phone the adversary. The voice call itself is not visible to network telemetry, so this is a low-fidelity, hunting-oriented signal."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.004"
    mitre_technique_name = "Phishing for Information: Spearphishing Voice"
    log_prerequisites = "Requires perimeter or proxy logs that populate NETWORK_HTTP (target.url, target.hostname, principal.ip) and firewall NETWORK_CONNECTION or NETWORK_FLOW events (principal.ip, target.ip, target.port) with a consistent source IP across both. Source IPs should be pre-NAT or the two log sources must see the same address."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users of corporate softphones, hosted PBX or UCaaS clients who browse support or billing pages of vendors and then place a call. Help-desk staff researching vendor support portals. Legitimate customer-service workflows that involve both web portals and VoIP."
    tuning_guidance = "Add known-good vendor and UCaaS domains to %global_allowed_domains. Restrict the rule to user VLANs or exclude voice VLAN sources if the firewall exposes them. Where no SIP is permitted outbound, raise severity. Tune the lure keyword list to the client's business vocabulary."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.target.url = /(support|helpdesk|callback|call[-_]?now|urgent|verify|suspend|billing|invoice|refund|security[-_]?alert)/ nocase
    not $http.target.hostname in %global_allowed_domains
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port >= 5060
    $net.target.port <= 5061
    not $net.target.ip in %rfc1918_internal
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1598.004")
    $primary_entity = array_distinct($src_ip)
    $lure_urls = array_distinct($http.target.url)
    $sip_destination_ips = array_distinct($net.target.ip)
    $sip_connection_count = count($net.metadata.id)

  condition:
    $http and $net
}
