/*
  MITRE Technique : T1647 - Plist File Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:35:36.027094+00:00
  Reference       : https://attack.mitre.org/techniques/T1647
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1647_Plist_Modification_Burst_macOS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of plist-modifying command-line utilities (defaults, plutil, PlistBuddy) writing, inserting, replacing or deleting keys in launchd, Dock, loginwindow or application Info.plist files on a single macOS host within 10 minutes. A single plist edit is routine; repeated edits in a short window suggest persistence, hidden-app (LSUIElement) or environment-variable tampering."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1647"
    mitre_technique_name = "Plist File Modification"
    log_prerequisites = "macOS endpoint telemetry with process launch events and full command-line capture (EDR or unified log)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM and configuration-management agents applying preference profiles, IT provisioning or imaging scripts, developer build scripts that patch Info.plist (Xcode build phases, packaging tools), user-initiated Dock or Finder customisation scripts, and software installers or updaters."
    tuning_guidance = "Add approved MDM, provisioning and build tooling to %global_allowed_admin_tools (matched on the parent process path). Add trusted shell or script hosts to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on developer-heavy fleets, or lower it for high-security hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(defaults|plutil|PlistBuddy)$/ nocase
    $proc.target.process.command_line = /(\bwrite\b|\s-(replace|insert|remove)\b|\s-c\s+.*\b(set|add|delete|merge|import)\b)/ nocase
    $proc.target.process.command_line = /(\.plist|com\.apple\.(dock|loginwindow)|LSUIElement|LSEnvironment)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1647")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $tools = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 4
}
