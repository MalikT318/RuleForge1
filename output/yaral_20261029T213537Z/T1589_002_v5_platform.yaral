/*
  MITRE Technique : T1589.002 - Email Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:09:26.681378+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_002_External_Email_Enumeration_Endpoint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source sending HTTP requests to mail or identity discovery endpoints (autodiscover, credential-type lookups, EWS, OWA auth, ActiveSync) with an email address embedded in the URL. This is the pattern used for active username and email enumeration against public-facing mail infrastructure, where the response difference reveals whether the mailbox exists."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.002"
    mitre_technique_name = "Gather Victim Identity Information: Email Addresses"
    log_prerequisites = "Requires reverse proxy, WAF or perimeter proxy HTTP logs that populate target.url and principal.ip for traffic to published mail and identity services."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate mail clients (Outlook, mobile devices) running autodiscover for a user's own mailbox from external networks, onboarding of new devices, authorised external penetration tests, and third-party mail migration tools."
    tuning_guidance = "Add authorised testing sources to %global_allowed_scanners and approved external management sources to %global_allowed_mgmt_sources. Pair with a downstream count of distinct addresses per source IP before escalating. A single hit is often a real user; many hits from one source are enumeration."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(autodiscover|getcredentialtype|\/ews\/|\/owa\/auth|\/ecp\/|activesync|\/mapi\/)/ nocase
    $http.target.url = /[a-z0-9._%+\-]+(@|%40)[a-z0-9\-]+(\.|%2e)[a-z0-9.\-]{2,}/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1589.002")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
