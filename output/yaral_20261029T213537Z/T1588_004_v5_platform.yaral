/*
  MITRE Technique : T1588.004 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:00:09.873392+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_004_ACME_Certificate_Issuance_From_Internal_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host sending ACME protocol requests (account registration, order creation, nonce or directory fetch) to an external certificate authority through the perimeter. T1588.004 is mostly invisible to a victim. This rule covers the observable part: an unapproved host or account obtaining TLS certificates that could front adversary C2 or phishing infrastructure. Detection keys on the ACME URL structure defined by the protocol, not on any specific CA, domain or tool."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.004"
    mitre_technique_name = "Obtain Capabilities: Digital Certificates"
    log_prerequisites = "Requires proxy or perimeter logs that record the full HTTP request URL (TLS inspection or explicit proxy) normalised to NETWORK_HTTP. Without TLS inspection the URL path is not visible and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate certificate automation on web servers, load balancers and Kubernetes clusters (certbot, cert-manager, acme.sh, built-in ACME clients), developer workstations testing certificate issuance, and approved internal or external CAs."
    tuning_guidance = "Add approved CA domains, including internal ACME endpoints, to %global_allowed_domains. Add certificate-automation service accounts to %global_allowed_service_accounts. Review hits from hosts that are not web-facing or have no business need for certificates."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/acme\/(.*\/)?(new-?order|new-?acct|new-?account|new-?nonce|directory)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1588.004")
    $primary_entity = array_distinct($http.principal.hostname)
    $acme_urls = array_distinct($http.target.url)
    $ca_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
