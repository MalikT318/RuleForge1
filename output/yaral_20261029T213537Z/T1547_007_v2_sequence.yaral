/*
  MITRE Technique : T1547.007 - Re-opened Applications
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:45:05.181088+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_007_Reopen_Apps_Payload_Staged_Then_Loginwindow_Plist_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single non-system process first drops a file into a user-writable staging location (tmp, Downloads, ~/Library/Application Support or Caches, /Users/Shared, hidden user directory) and then modifies a ~/Library/Preferences/ByHost/com.apple.loginwindow.[UUID].plist file within 10 minutes. This pattern indicates a payload being staged and then registered for relaunch at next login through the macOS Reopen windows feature. Legitimate writes to this plist come from loginwindow or cfprefsd, not from arbitrary processes."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.007"
    mitre_technique_name = "Boot or Logon Autostart Execution: Re-opened Applications"
    log_prerequisites = "Requires macOS endpoint telemetry with file creation and file modification events that populate principal.process.file.full_path and target.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Installers or updaters that unpack to a temp directory and then reset login window state; MDM or configuration management agents that manage loginwindow preferences; admin scripts that run 'defaults' against ByHost; user profile migration tools."
    tuning_guidance = "Add approved MDM, deployment and migration binaries to %global_allowed_admin_tools and EDR agents to %global_allowed_security_tools. Extend the system-process exclusion regex if additional Apple daemons that legitimately write this plist are observed. Tighten or widen the staging path regex to match client conventions."

  events:
    $drop.metadata.event_type = "FILE_CREATION"
    $drop.target.file.full_path = /^\/(private\/)?(tmp|var\/tmp|var\/folders)\/|^\/Users\/(Shared\/|[^\/]+\/(Library\/(Application Support|Caches)\/|Downloads\/|\.[^\/]+\/))/ nocase
    not $drop.target.file.full_path = /com\.apple\.loginwindow\..*\.plist$/ nocase
    not $drop.principal.process.file.full_path = /\/(loginwindow|cfprefsd|Finder|mdworker|mdworker_shared|XProtectService|softwareupdated|installd|system_installd|Spotlight|Safari|com\.apple\.[^\/]+)$/ nocase
    not $drop.principal.process.file.full_path in %global_allowed_admin_tools
    not $drop.principal.process.file.full_path in %global_allowed_security_tools
    $drop.principal.hostname = $hostname
    $drop.principal.process.file.full_path = $writer

    $reg.metadata.event_type = "FILE_MODIFICATION"
    $reg.target.file.full_path = /\/Library\/Preferences\/ByHost\/com\.apple\.loginwindow\..*\.plist$/ nocase
    not $reg.principal.process.file.full_path = /\/(loginwindow|cfprefsd|Finder|UserEventAgent|sharedfilelistd|System Settings|System Preferences)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname
    $reg.principal.process.file.full_path = $writer

    $drop.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname, $writer over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.007")
    $primary_entity = array_distinct($hostname)
    $writer_process = array_distinct($writer)
    $staged_files = array_distinct($drop.target.file.full_path)
    $modified_plist = array_distinct($reg.target.file.full_path)
    $user = array_distinct($reg.principal.user.userid)
    $staged_count = count($drop.metadata.id)

  condition:
    $drop and $reg
}
