/*
  MITRE Technique : T1593.003 - Code Repositories
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:46:46.554666+00:00
  Reference       : https://attack.mitre.org/techniques/T1593/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_003_External_Code_Search_Secret_Hunting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external client issuing code-search requests with secret-hunting keywords (passwords, tokens, API or private keys) against a self-hosted, internet-facing code repository. The ATT&CK technique mostly happens on third-party platforms the victim cannot see. This rule covers the observable part: reconnaissance against repositories the organisation exposes itself."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593.003"
    mitre_technique_name = "Search Open Websites/Domains: Code Repositories"
    log_prerequisites = "IDS/IPS or inline network security appliance with HTTP inspection that populates the request URL (target.url) in UDM NETWORK_HTTP events. Requires TLS inspection or a reverse-proxy position in front of the repository. Searches on third-party public repository platforms cannot be seen and are out of scope."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate external contributors or contractors searching a public repository for terms such as 'token' or 'password' while working on authentication code; authorised penetration tests and secret-scanning services; search-engine crawlers following search links."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners. If the repository is only reachable via a known reverse proxy or VPN egress, add that source to %global_allowed_mgmt_sources and extend the exclusion. Raise severity or add a Threshold variant for repeated searches from one source."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/api\/v[0-9]+\/(projects\/[^\/?]+\/)?search|\/search\/code|\/-\/search|\/search\?)/ nocase
    $http.target.url = /(scope=blobs|type=code|search_type=blobs|search_type=code|\/search\/code)/ nocase
    $http.target.url = /(passw(or)?d|secret|api[_%-]?key|token|credential|private[_%-]?key|access[_%-]?key|begin(%20|\+|\s)(rsa|openssh|private))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1593.003")
    $primary_entity = array_distinct($http.principal.ip)
    $target_hosts = array_distinct($http.target.hostname)
    $search_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
