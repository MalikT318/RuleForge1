/*
  MITRE Technique : T1132.002 - Non-Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:09:45.270745+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_002_ESXi_Encoded_Blob_In_Host_Setting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host configuration or advanced-setting change whose value contains a long base64-style encoded blob. Adversaries with hypervisor access can stage or relay C2 data through host settings, annotations, or banner and config values using a custom or modified encoding. This covers the management-plane configuration channel rather than process command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.002"
    mitre_technique_name = "Data Encoding: Non-Standard Encoding"
    log_prerequisites = "ESXi hostd and shell logs forwarded to Chronicle and parsed to SETTING_MODIFICATION events, with the change text populated in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host profile or desired-state remediation pushed from the management plane, certificate or SSH key and thumbprint updates, lockdown exception lists, syslog or NTP bulk configuration, and admin-pasted licence keys or long annotations."
    tuning_guidance = "Add the change-management accounts and approved automation accounts to %global_allowed_admin_users and %global_allowed_service_accounts. If a client regularly pushes long values (host profiles, certificates), extend the key/cert exclusion keywords or lengthen the {120,} blob threshold."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /(?i)(UserVars|Annotations|Config\.|Misc\.|Net\.|motd|issue|advanced\s+(setting|option))[^\n]{0,120}[A-Za-z0-9+\/_-]{120,}={0,2}/ nocase
    not $setting.metadata.description = /(?i)(ssh|authorized_keys|certificate|cert|thumbprint|ssl|license|host\s*profile)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1132.002")
    $primary_entity = array_distinct(strings.coalesce($setting.target.hostname, $setting.principal.hostname))
    $acting_user = array_distinct($setting.principal.user.userid)

  condition:
    $setting
}
