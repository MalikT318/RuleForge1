/*
  MITRE Technique : T1589.002 - Email Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:09:11.726674+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_002_Email_Enumeration_Endpoint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external client requesting identity or mail-discovery endpoints with an email address in the request. These are autodiscover with an email parameter, the credential-type lookup and the user-realm lookup. Attackers use these endpoints to confirm valid mailboxes and usernames without authenticating. Detection is based on the URL path and query structure, not on any specific tool, domain or source address."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.002"
    mitre_technique_name = "Gather Victim Identity Information: Email Addresses"
    log_prerequisites = "Requires perimeter proxy, reverse proxy, WAF or firewall HTTP logging that populates target.url and principal.ip (URL-aware inspection or TLS decryption)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate mail clients performing autodiscover for a mailbox (including mobile and Outlook clients on external networks), federated sign-in flows that call the realm or credential-type lookups, authorised external penetration tests, and monitoring or synthetic-transaction services."
    tuning_guidance = "Add authorised scanners and pentest sources to %global_allowed_scanners. Add known-good vendor or identity-provider hostnames to %global_allowed_domains. If legitimate remote clients are noisy, consider a companion threshold rule on distinct email values per source. Raise severity when the same source requests many distinct addresses."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/autodiscover\/autodiscover\.json[^#]*[?&]email(address)?=[^&]*(@|%40)|\/common\/GetCredentialType|\/getuserrealm\.srf[^#]*[?&]login=[^&]*(@|%40))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1589.002")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
