/*
  MITRE Technique : T1590.006 - Network Security Appliances
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:22:57.234969+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_006_External_Probe_Of_Security_Appliance_Endpoints {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-RFC1918) source issuing HTTP requests for URL paths that expose the existence, status, or management interface of a firewall, IPS/IDS, WAF, UTM, VPN gateway, proxy, or bastion device. This pattern is typical of adversary reconnaissance fingerprinting network security appliances before targeting. Network-side detection that complements endpoint command-line coverage."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.006"
    mitre_technique_name = "Gather Victim Network Information: Network Security Appliances"
    log_prerequisites = "Requires IDS/IPS or network security appliance HTTP inspection logs (or inline proxy/WAF logs) normalised to UDM NETWORK_HTTP with principal.ip and target.url populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, penetration tests, remote administrators or MSP staff legitimately browsing to a published VPN or firewall portal from the internet, uptime or health-check monitors, and search-engine or internet-census crawlers."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and known-good monitoring destinations to %global_allowed_domains. If published VPN or management portals generate noise, exclude those destination hostnames via %global_allowed_domains. Pair with threshold or correlation variants for repeated attempts from one source."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(?i)\/(fw|firewall|ips|ids|nids|waf|utm|ngfw|vpn|proxy|bastion|gateway)[-_]?(admin|login|console|manager|mgr|mgmt|management|status|config|portal|dashboard)\b|\/(system|device|appliance)[-_]?(status|info|version|health)\.(json|xml|cgi|php|html)|\/cgi-bin\/(status|sysinfo|system|diag|config)|\/(snmp|syslog|rules|signatures|policy)[-_]?(status|list|export|download|view)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1590.006")
    $primary_entity = array_distinct($net.principal.ip)
    $probed_urls = array_distinct($net.target.url)
    $probed_hosts = array_distinct($net.target.hostname)
    $probed_ips = array_distinct($net.target.ip)

  condition:
    $net
}
