/*
  MITRE Technique : T1591 - Gather Victim Org Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:26:01.240270+00:00
  Reference       : https://attack.mitre.org/techniques/T1591
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_Org_Info_Page_Enumeration_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Low"
    description = "A single external source makes many HTTP requests within ten minutes to URL paths that expose organisation information (about, team, staff, leadership, careers, contact, directory, org chart). One request is benign. Sustained enumeration is consistent with reconnaissance to gather victim organisation details for later phishing or social engineering."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591"
    mitre_technique_name = "Gather Victim Org Information"
    log_prerequisites = "Requires IDS/IPS or inline network security appliance logs that record HTTP requests with the request URL populated in UDM target.url. TLS inspection or a web-aware inspection profile is needed for URL visibility."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate search engine and SEO crawlers, uptime and brand monitoring services, partner or recruiter integrations, job-board aggregators, and genuine visitors browsing the careers or team pages."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners. Raise the #http threshold for high-traffic public sites. Extend the path regex with client-specific organisation page names. Add trusted external monitoring services to %global_allowed_domains if they appear as the target host."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(about|about-us|team|our-team|staff|leadership|management|executives|people|careers|jobs|contact|contact-us|directory|org-chart|departments|investors)(\/|\.|\?|$)/ nocase
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(40)
    $event_count = count($http.metadata.id)
    $distinct_urls = count_distinct($http.target.url)
    $mitre_technique_id = array_distinct("T1591")
    $primary_entity = array_distinct($src_ip)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    #http >= 15
}
