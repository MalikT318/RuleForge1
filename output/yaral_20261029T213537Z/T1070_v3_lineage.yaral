/*
  MITRE Technique : T1070 - Indicator Removal
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:01:49.810285+00:00
  Reference       : https://attack.mitre.org/techniques/T1070
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_ESXi_Anomalous_Parent_Spawns_Artifact_Removal_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file-removal or truncation utility (rm, truncate, shred, unlink) launched on an ESXi host by an unexpected parent. The parent is either a management-plane daemon (hostd, rhttpproxy, vpxa, fdm, sfcbd, openwsman, python) or a binary running from a writable staging location (/tmp, /var/tmp, /dev/shm, /scratch, /vmfs/volumes). Management daemons do not normally delete or truncate logs and shell history. Doing so suggests exploited service code or a dropped implant clearing artifacts. The detection is based on process lineage, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070"
    mitre_technique_name = "Indicator Removal"
    log_prerequisites = "ESXi shell and process execution telemetry (hostd, shell.log, auditd-style process events) forwarded and normalised to UDM PROCESS_LAUNCH with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) paths."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Management daemons or vendor plug-ins and VIBs that clean up temporary files; patching, upgrade and host-profile remediation scripts; backup and agent software run from /scratch or a datastore; in-house automation executed from a datastore path."
    tuning_guidance = "Add approved automation and patching binaries to %global_allowed_admin_tools, trusted wrapper scripts and hosts to %global_allowed_script_hosts, backup agents to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. If a vendor VIB legitimately spawns rm from a management daemon, allowlist that parent path through %global_allowed_admin_tools instead of widening the child regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(\/(hostd|rhttpproxy|vpxa|fdm|sfcbd|openwsmand|wsman|python[0-9.]*)$|^\/(tmp|var\/tmp|dev\/shm|scratch|vmfs\/volumes)\/)/ nocase
    $proc.target.process.file.full_path = /\/(rm|truncate|shred|unlink|busybox)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
