/*
  MITRE Technique : T1583.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:05:31.617557+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_004_Outbound_To_Adversary_Server_Listener_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal source making an outbound perimeter connection to an external address on a port commonly used by self-hosted staging, listener, and C2 services rather than by mainstream internet services. This is the network-observable result of an adversary running its own server (T1583.004). Telemetry is perimeter-only, so the rule uses destination, port, and direction rather than endpoint process fields. The PRE platform requirement overrides the alternate-platform angle, so no Windows paths or host-based Linux/macOS artefacts are used."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.004"
    mitre_technique_name = "Acquire Infrastructure: Server"
    log_prerequisites = "Requires firewall or proxy perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.direction populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers and engineers testing services on non-standard ports, game clients and peer-to-peer or VoIP software using high ports, legitimate SaaS or vendor integrations on custom ports, authorised penetration tests and vulnerability scans."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners and approved management or jump-host source addresses to %global_allowed_mgmt_sources. Adjust the port set to client baselines. Review the destination ASN and geography of hits for newly provisioned hosting infrastructure."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    (
      $net.target.port = 4444 or
      $net.target.port = 4443 or
      $net.target.port = 1337 or
      $net.target.port = 31337 or
      $net.target.port = 5555 or
      $net.target.port = 6666 or
      $net.target.port = 7777 or
      $net.target.port = 8888 or
      $net.target.port = 9999
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
