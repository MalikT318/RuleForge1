/*
  MITRE Technique : T1584.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:28:48.652827+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_006_Scripted_Client_Write_To_External_Web_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser, scripted HTTP client sending write-style requests (POST/PUT/PATCH) to API, upload, or webhook paths on an external web service, as seen at the proxy or perimeter. This is the network-observable pattern of internal systems using a third-party web service (possibly a compromised account) as attacker-controlled infrastructure. The rule does not rely on named domains, IPs, or tools, and excludes known-good external domains through a reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.006"
    mitre_technique_name = "Compromise Infrastructure: Web Services"
    log_prerequisites = "Requires proxy, secure web gateway, or firewall logs with HTTP inspection that populate network.http.method, network.http.user_agent, and target.url (TLS inspection needed for HTTPS visibility)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate automation using SaaS APIs (CI/CD pipelines, monitoring agents, backup and ticketing integrations, developer scripts), software update checkers, and vendor telemetry uploaded by command-line clients."
    tuning_guidance = "Add sanctioned SaaS and vendor API domains to %global_allowed_domains. Add authorised scanner or automation source addresses to %global_allowed_scanners. Add approved management or automation egress sources to %global_allowed_mgmt_sources. Tighten the URL path regex or user-agent list per client if volume is high."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|okhttp|apache-httpclient|java|powershell|windowspowershell|node-fetch|axios|ruby|php)/ nocase
    $net.target.url = /\/(api|v[0-9]+|upload|uploads|gists?|paste|pastes|webhook|webhooks|hooks|repos|contents|files|messages|send|mail|drive|bot[^\/]*)(\/|\?|$)/ nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1584.006")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_host = array_distinct($net.target.hostname)
    $destination_url = array_distinct($net.target.url)
    $user_agent = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
