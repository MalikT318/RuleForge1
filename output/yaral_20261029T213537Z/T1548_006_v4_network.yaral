/*
  MITRE Technique : T1548.006 - TCC Manipulation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:35:43.100960+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_006_macOS_TCC_Privileged_Scripting_Host_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of TCC abuse follow-on activity on macOS. Scripting and database hosts that adversaries use to drive TCC-protected resources or edit TCC.db (osascript, sqlite3, Script Editor, Automator) normally have no reason to open connections to external addresses. When they do, the likely cause is a script that has inherited TCC grants (Full Disk Access, Automation, Screen Recording) and is staging data or fetching a payload. Internal address space is excluded through a reference list."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.006"
    mitre_technique_name = "Abuse Elevation Control Mechanism: TCC Manipulation"
    log_prerequisites = "Requires macOS endpoint telemetry that reports network connections with the originating process path (NETWORK_CONNECTION events with principal.process.file.full_path populated)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Admin or MDM-driven osascript and shell workflows that call external services, in-house automation that uses sqlite3 or osascript to fetch data from SaaS APIs, Automator workflows that sync to cloud services, and software installers that run AppleScript and check for updates."
    tuning_guidance = "Add approved admin and automation binaries to %global_allowed_admin_tools. Add known-good external domains to %global_allowed_domains. Add approved scripting hosts to %global_allowed_script_hosts. Review the source hostname and destination in the outcome, then correlate with endpoint TCC.db modification telemetry."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(\/usr\/bin\/(osascript|sqlite3)$|\/Script Editor\.app\/Contents\/MacOS\/|\/Automator\.app\/Contents\/MacOS\/)/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1548.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
