/*
  MITRE Technique : T1608.002 - Upload Tool
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:23:02.896470+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_002_Tool_Staging_Download_From_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client using a scripting or command-line HTTP client to fetch an executable, script or archive file from an external web host. This is the network-side signature of a tool staged on adversary-controlled or third-party infrastructure (Upload Tool) being pulled into the environment (Ingress Tool Transfer). Destinations on the known-good domain list and approved script hosts are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.002"
    mitre_technique_name = "Stage Capabilities: Upload Tool"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection that populate the request URL, HTTP method and user agent, normalised to UDM NETWORK_HTTP. TLS-intercepted or cleartext web traffic is required. Without decryption, URL-level visibility is not available."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Admins and developers using curl, wget or PowerShell to fetch installers, scripts or packages from vendor or open-source sites. Software update mechanisms and CI/CD build agents using non-browser user agents. Package managers (pip, Maven, Go modules) downloading archives or jars. Security researchers and red teams."
    tuning_guidance = "Add legitimate vendor, CDN and package repository domains to %global_allowed_domains. Add build servers, jump hosts and admin workstations that legitimately script downloads to %global_allowed_script_hosts. Narrow or widen the file-extension and user-agent regexes per client. If the proxy does not log user agent, remove that condition and raise the threshold of review by also filtering on direct-IP URLs."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\.(exe|dll|msi|ps1|bat|vbs|hta|jar|elf|sh|bin|zip|7z|rar|gz)(\?.*)?$/ nocase
    $net.network.http.user_agent = /(curl|wget|powershell|python|go-http-client|winhttp|libwww|java\/|okhttp)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.002")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $requested_url = array_distinct($net.target.url)
    $user_agent = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
