/*
  MITRE Technique : T1564.009 - Resource Forking
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:46:45.888953+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_009_MacOS_Resource_Fork_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a write to a file's resource fork through the ..namedfork/rsrc path. Adversaries hide payloads or executable content in resource forks to evade scanners that inspect only the data fork. Detection is based on the resulting file artifact rather than the command line, so it still fires when the writing tool, shell or script is renamed or obfuscated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.009"
    mitre_technique_name = "Hide Artifacts: Resource Forking"
    log_prerequisites = "macOS endpoint telemetry that records file modification events with the full target path, including the ..namedfork pseudo-path (EDR file events or Endpoint Security framework data). Without it, resource fork writes are not visible."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Finder and system services copying legacy files that carry resource forks, developer tooling (Xcode, Rez, SetFile) in build pipelines, legacy font and creative applications, archive and sync utilities that preserve forks, and migration or backup tools."
    tuning_guidance = "Add approved developer, packaging and deployment tools to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add backup and imaging software to %global_allowed_backup_processes. Consider a companion copy of this rule on FILE_CREATION if the sensor reports the first fork write as a creation. Raise severity when the writing process runs from /tmp, /private/tmp, /Users/*/Downloads or /Users/Shared."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/\.\.namedfork\/rsrc$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path = /\/(Finder|mds|mdworker|mdworker_shared|fseventsd|cloudd|bird)$/ nocase

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1564.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $fork_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
