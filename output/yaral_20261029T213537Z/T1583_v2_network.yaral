/*
  MITRE Technique : T1583 - Acquire Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:56:36.241884+00:00
  Reference       : https://attack.mitre.org/techniques/T1583
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_DNS_Algorithmic_Domain_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for a registered-domain label that is long, random-looking and has a long run of consonants. This pattern is typical of algorithmically generated or throwaway domains that adversaries register as C2, staging or phishing infrastructure. Queries that resolve to internal addresses, reverse lookups and known-good domains are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583"
    mitre_technique_name = "Acquire Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS, with network.dns.questions.name populated. Answer data (network.dns.answers.data) is used for internal-address exclusion when present."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-storage hostnames with long random labels, email-security and anti-spam lookups, software update and telemetry services, browser safe-browsing checks, and legitimate vendors that use machine-generated hostnames."
    tuning_guidance = "Add known-good FQDNs to %global_allowed_domains. Add internal resolver or monitoring hosts to %global_allowed_scanners if they generate noisy lookups. To reduce noise, raise the label length from 15 to 20 or the consonant run from 6 to 7. To increase sensitivity, lower these values."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9]{15,}\.[a-z]{2,24}$/ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz]{6,}/ nocase
    not $dns.network.dns.questions.name = /\.arpa$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1583")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
