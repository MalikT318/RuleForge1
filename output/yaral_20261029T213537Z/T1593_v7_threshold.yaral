/*
  MITRE Technique : T1593 - Search Open Websites/Domains
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:43:52.393909+00:00
  Reference       : https://attack.mitre.org/techniques/T1593
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_External_Source_OSINT_Page_Harvesting_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Low"
    description = "A single external source makes many GET requests within 10 minutes to public, information-rich pages on protected web assets (robots.txt, sitemaps, security.txt, careers, team, staff, contact, press). Each request is benign on its own. The volume suggests systematic harvesting of organisation, personnel and technology details for targeting. This is the victim-visible side of searching open websites."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593"
    mitre_technique_name = "Search Open Websites/Domains"
    log_prerequisites = "Requires IDS/IPS or inline network security appliance logs with HTTP visibility (URL and method) for inbound traffic to protected web servers, normalised to NETWORK_HTTP."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and availability monitors, partner or vendor integrations, job aggregators indexing careers pages, brand-monitoring services, and authorised security scanners."
    tuning_guidance = "Add known crawlers, monitors and approved assessment sources to %global_allowed_scanners. Raise the #net threshold on high-traffic public sites, or lower it for low-traffic ones. Scale response with the risk_score outcome rather than the threshold. Review $requested_urls to separate crawler-style enumeration from targeted people and technology lookups."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.target.url = /\/(robots\.txt|sitemap[^\/\?]*\.xml|security\.txt|careers?|jobs|about|team|staff|people|employees|contact|directory|press|news)(\/|\?|$)/ nocase
    $net.principal.ip = $src_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if(count($net.metadata.id) >= 60, 70, if(count($net.metadata.id) >= 35, 55, 35)))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1593")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $targeted_hosts = array_distinct($net.target.hostname)

  condition:
    #net >= 20
}
