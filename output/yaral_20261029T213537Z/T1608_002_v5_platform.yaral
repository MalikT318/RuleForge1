/*
  MITRE Technique : T1608.002 - Upload Tool
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:23:37.025377+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_002_Tool_Download_From_Raw_IP_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client fetching an executable, script, or archive payload over HTTP directly from a raw IP-literal URL on an external host. This is the perimeter-visible result of an adversary staging a tool on infrastructure they control (Upload Tool) and a victim retrieving it. Legitimate software distribution almost always uses named, resolvable domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.002"
    mitre_technique_name = "Stage Capabilities: Upload Tool"
    log_prerequisites = "Requires forward proxy or perimeter firewall logs with HTTP URL visibility (explicit proxy or TLS inspection) normalised to NETWORK_HTTP with target.url populated. Without URL visibility the rule cannot evaluate."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal or lab software distribution from IP-addressed external servers, IoT or OT firmware downloads from vendor IP endpoints, developers pulling build artifacts from cloud VMs addressed by IP, and authorised red-team or penetration testing activity."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains (matched against target.hostname). Internal destinations are already excluded through %rfc1918_internal. If the client has legitimate IP-based distribution points, add the corresponding hostnames to %global_allowed_domains. Extend or trim the extension list to match client policy."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\/[^?#]*\.(exe|dll|msi|ps1|bat|vbs|jar|sh|elf|bin|zip|7z|rar|gz|tgz)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
