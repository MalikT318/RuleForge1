/*
  MITRE Technique : T1592.002 - Software
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:38:39.181437+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_002_External_Service_Probing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens a high volume of connections to commonly fingerprinted service ports (remote access, mail, web, database, management) within ten minutes. Each connection is benign on its own, but the volume across many service ports indicates active scanning to enumerate victim software, versions and banners."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.002"
    mitre_technique_name = "Gather Victim Host Information: Software"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and attack-surface monitoring services, uptime and health-check monitors, search-engine or internet-census crawlers, busy NAT gateways or CDN egress addresses, and legitimate partners making many connections to web or mail services."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Raise the #net threshold for internet-facing hosts with high legitimate traffic. Add known partner or management source addresses to %global_allowed_mgmt_sources. Adjust the port list to the services your clients expose."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 25 or
      $net.target.port = 80 or
      $net.target.port = 110 or
      $net.target.port = 143 or
      $net.target.port = 443 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5432 or
      $net.target.port = 5900 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1592.002")
    $primary_entity = array_distinct($net.principal.ip)
    $event_count = count($net.metadata.id)
    $distinct_ports = count_distinct($net.target.port)
    $distinct_targets = count_distinct($net.target.ip)
    $targeted_ips = array_distinct($net.target.ip)

  condition:
    #net >= 30
}
