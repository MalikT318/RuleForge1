/*
  MITRE Technique : T1598.001 - Spearphishing Service
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:11:49.919721+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_001_Credential_Form_Post_To_Unapproved_External_Site {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client submitting an HTTP POST to a credential-style URL path (login, signin, verify, password reset and similar) on an external domain that is not in the approved domain list. This is the network-side result of a user following a spearphishing link delivered through a third-party service (webmail, social media, messaging) and submitting information to a harvesting page. The referral URL is captured in the outcome to show the originating service."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.001"
    mitre_technique_name = "Phishing for Information: Spearphishing Service"
    log_prerequisites = "Requires web proxy or perimeter firewall with URL visibility (TLS inspection or URL filtering) populating network.http.method and target.url, normalised to NETWORK_HTTP. Without URL-level logging this rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS or SSO sign-in to vendor domains missing from the approved domain list, new business partner portals, employees signing in to personal webmail or social media from the corporate network, and password-manager or single-sign-on redirects."
    tuning_guidance = "Add sanctioned SaaS, identity-provider and vendor domains to %global_allowed_domains. Narrow or widen the URL keyword group to match client proxy URL logging depth. If personal webmail use is permitted, expect noise and consider raising severity only when the referral URL is present."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /\/(login|log-in|signin|sign-in|logon|verify|verification|validate|secure|account|auth|authenticate|password|reset|credential|webmail|owa)[^\/?#]*([\/?#]|$)/ nocase
    $http.target.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1598.001")
    $primary_entity = array_distinct($http.principal.ip)
    $client_user = array_distinct($http.principal.user.userid)
    $dest_host = array_distinct($http.target.hostname)
    $dest_url = array_distinct($http.target.url)
    $referral_url = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
