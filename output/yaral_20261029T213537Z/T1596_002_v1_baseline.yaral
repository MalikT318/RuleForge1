/*
  MITRE Technique : T1596.002 - WHOIS
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:00:42.735000+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_002_WHOIS_Query_Outbound_TCP43 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a connection to an external host on TCP port 43 (WHOIS), as seen by an IDS/IPS or network security appliance. WHOIS is the transport adversaries and command-line clients use to pull registrant, netblock and nameserver data about a target. Ordinary business traffic rarely uses it, so a client talking to port 43 outside approved sources is a reconnaissance indicator."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.002"
    mitre_technique_name = "Search Open Technical Databases: WHOIS"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW with target.port and target.ip populated. The appliance must inspect egress traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Domain and IP administrators checking registration data, brand-protection and threat-intelligence teams, abuse-desk staff, security researchers, mail gateways or anti-spam systems doing registrar lookups, and authorised OSINT or attack-surface tooling."
    tuning_guidance = "Add authorised scanners and OSINT sources to %global_allowed_scanners. Add approved management or jump-host source addresses to %global_allowed_mgmt_sources. Add named domain-admin accounts to %global_allowed_admin_users if user context is present in the logs. Raise severity if the source is a server or a host that has no business doing registry lookups."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 43
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596.002")
    $primary_entity = array_distinct($net.principal.ip)
    $whois_server_ips = array_distinct($net.target.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $connection_count = count($net.metadata.id)

  condition:
    $net
}
