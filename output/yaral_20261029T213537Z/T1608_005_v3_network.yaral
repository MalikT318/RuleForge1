/*
  MITRE Technique : T1608.005 - Link Target
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:28:51.173855+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_005_Raw_IP_Credential_Link_Target {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound HTTP request through a proxy or perimeter device to an external raw-IPv4 URL with a credential-themed path (login, signin, verify, webmail, SSO). Legitimate services are almost never reached this way. This pattern is characteristic of adversary-staged link-target pages, such as cloned login portals, being opened by users who followed a phishing link."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.005"
    mitre_technique_name = "Stage Capabilities: Link Target"
    log_prerequisites = "Requires firewall, web proxy, or secure web gateway logs that normalise to NETWORK_HTTP with target.url populated (full URL visibility, e.g. TLS inspection for HTTPS). The %rfc1918_internal and %global_allowed_domains reference lists must be populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Appliance, camera, router, or NAS web admin consoles reached by IP (login pages) when the address is not in the internal list; captive portals; vendor-hosted licence or SSO pages reached by IP; penetration tests and phishing simulations; security researchers browsing suspicious links."
    tuning_guidance = "Add known-good external domains or hostnames to %global_allowed_domains. Make sure %rfc1918_internal covers all private ranges the client uses. Raise severity for clients with a high phishing-targeting profile. To reduce noise, restrict the pattern to HTTP GET or to specific proxy categories where the log source provides them."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.target.url = /^https?:\/\/(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?\/[^?#]*(login|log-in|logon|signin|sign-in|verify|validate|account|password|webmail|sso|auth|secure|portal)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.005")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
