/*
  MITRE Technique : T1583.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:11:52.179218+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_007_Serverless_Platform_NonBrowser_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects proxy or perimeter-observed HTTP requests to hostnames on public serverless function platforms (edge workers, function-as-a-service URLs, API gateway endpoints, serverless containers) from a client with a non-browser user agent. Adversary-controlled serverless runtimes are used as C2 responders or redirectors that blend into traffic to major cloud providers. Scripted or implant-style clients calling these hosts directly are far less common than browser traffic."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.007"
    mitre_technique_name = "Acquire Infrastructure: Serverless"
    log_prerequisites = "Requires web proxy or next-generation firewall logs with HTTP inspection that populate target.hostname and network.http.user_agent (TLS inspection or SNI-based logging for HTTPS). Normalised to UDM NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS integrations, webhooks and CI/CD tooling that call serverless endpoints with scripted clients (curl, Python, Go, Java SDKs); developer and DevOps workstations testing their own functions; monitoring or uptime probes; vendor agents that use serverless back ends."
    tuning_guidance = "Add known-good serverless hostnames used by the business or its vendors to %global_allowed_domains. Exclude developer or CI egress ranges by adding their sources to %global_allowed_mgmt_sources. Adjust the serverless suffix regex to the providers relevant to the client. Review repeated hits from one source IP to a single unfamiliar subdomain first."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /\.(workers\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app|azurewebsites\.net|pages\.dev|netlify\.app|vercel\.app)$/ nocase
    $http.network.http.user_agent != ""
    not $http.network.http.user_agent = /(mozilla|chrome|safari|firefox|edg)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1583.007")
    $primary_entity = array_distinct($http.principal.ip)
    $serverless_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
