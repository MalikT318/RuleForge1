/*
  MITRE Technique : T1593.003 - Code Repositories
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:47:42.721349+00:00
  Reference       : https://attack.mitre.org/techniques/T1593/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_003_Exposed_Repo_Metadata_Probing_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source makes repeated HTTP requests for version-control metadata paths (.git, .svn, .hg, .bzr and related repository files) on protected web assets within ten minutes. A single request is benign noise. Volume indicates active harvesting of source code, credentials or developer information from exposed repositories, which supports repository-based reconnaissance against the organisation."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593.003"
    mitre_technique_name = "Search Open Websites/Domains: Code Repositories"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with HTTP inspection that populate target.url and principal.ip. Sensors must see inbound traffic to internet-facing web servers, ideally after TLS inspection."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external attack-surface or vulnerability scanners not yet in the scanner list, security researchers or bug bounty testers, developers legitimately browsing repository paths on a self-hosted code portal, and web crawlers that follow links into repository directories."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Raise the #http threshold for internet-facing assets that are scanned heavily. If the organisation hosts a legitimate public code portal, scope it out by destination host. Severity and risk score escalate in outcome when core repository files such as config or HEAD are requested."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/\.(git|svn|hg|bzr)(\/|$)|\/\.(gitignore|gitconfig|git-credentials|gitlab-ci\.yml)$/ nocase
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($http.target.url = /\/\.(git|svn|hg|bzr)\/(config|HEAD|index|entries|wc\.db)$/ nocase, 80, 55))
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1593.003")
    $primary_entity = array_distinct($src_ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    #http >= 5
}
