/*
  MITRE Technique : T1583.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:10:17.146407+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_006_Web_Service_Account_Registration_After_DNS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Low"
    description = "Detects an internal source resolving an external domain and then sending an HTTP POST to an account-registration style URL path on that same domain within ten minutes. This is the closest network-observable behaviour for web service account registration, which normally happens outside the victim's telemetry. It is useful when an adversary stages accounts from a compromised host or a sloppy operator workstation. Treat it as a hunting lead rather than a confirmed compromise."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.006"
    mitre_technique_name = "Acquire Infrastructure: Web Services"
    log_prerequisites = "Requires perimeter or proxy logs that populate both DNS queries and HTTP method and URL. The HTTP side needs TLS inspection or a forward proxy, otherwise URL paths are not visible for HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees legitimately signing up for SaaS trials or vendor portals, marketing and procurement staff, developers registering for API or cloud services, and partner onboarding workflows."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Review the matched domains and source IPs in the outcome. Where the signup path regex is too noisy, narrow it. This rule is only reliable where the proxy decrypts or logs full URLs."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = $domain
    $dns.network.dns.questions.name != ""
    not $dns.network.dns.questions.name in %global_allowed_domains
    $dns.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|join)(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.target.hostname = $domain
    $http.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip, $domain over 10m

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1583.006")
    $primary_entity = array_distinct($src_ip)
    $registered_domains = array_distinct($domain)
    $signup_urls = array_distinct($http.target.url)
    $post_count = count($http.metadata.id)

  condition:
    $dns and $http
}
