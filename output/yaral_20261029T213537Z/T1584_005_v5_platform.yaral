/*
  MITRE Technique : T1584.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:26:55.262483+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_005_DNS_DGA_Style_Botnet_Domain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries whose registered-domain label is long and contains a long run of consonants or digits. This is typical of algorithmically generated domains that botnet clients use to reach rotating C2 infrastructure, including after a botnet takeover. The rule uses only DNS resolver telemetry and does not rely on named domains or IPs. Platform is PRE (pre-compromise / external-facing telemetry), so the angle of pivoting to a non-Windows host platform does not apply."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.005"
    mitre_technique_name = "Compromise Infrastructure: Botnet"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Resolver logs must cover internal clients so queries can be attributed to a source."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-provider hostnames with random-looking labels, security vendor reputation or telemetry lookups, anti-spam DNSBL lookups, email-tracking and marketing domains, software update services, and DNS-based licensing checks."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains (full query names, so add the frequent noisy FQDNs seen in your environment). Raise the label length threshold from 16 to 20 or more, or the consonant/digit run from 6 to 7, in noisy environments. Triage by checking whether one client generates many distinct hits."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^([a-z0-9_-]+\.)*[a-z0-9]{16,63}\.[a-z]{2,24}$/ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz0-9]{6,}\.[a-z]{2,24}$/ nocase
    not $dns.network.dns.questions.name = /\.(local|lan|internal|arpa|corp|home|localdomain)$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.005")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
