/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:39:11.627701+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_Registry_Hive_File_Read_SYSTEM_Then_SECURITY {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single non-system process reads the SYSTEM registry hive file and then the SECURITY registry hive file on the same host within 10 minutes. The SECURITY hive holds the cached domain credentials (MS-Cache v2 / DCC2 hashes, in the NL$KM secret and cache values). The SYSTEM hive holds the boot key needed to decrypt it offline. Reading both is the file-level signature of credential dumping with reg save, shadow-copy extraction or offline secretsdump-style tooling. This is behavioural file-access coverage and does not depend on command-line matching."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires endpoint telemetry that records file read or open events on registry hive files under \\Windows\\System32\\config, including shadow copy and RegBack paths, with the acting process path populated. Both files must be reported as UDM FILE_READ events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, VSS-based snapshot tooling, EDR/AV scanners reading hive files, forensic and IR collection tools, and disk migration utilities."
    tuning_guidance = "Add backup agent executable paths to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools and approved IT/IR tooling to %global_allowed_admin_tools. If your telemetry reports SECURITY before SYSTEM for common tools, review event ordering and the 10m window. Confirm FILE_READ telemetry for the config directory is enabled before deployment."

  events:
    $sys_hive.metadata.event_type = "FILE_READ"
    $sys_hive.target.file.full_path = /\\config\\SYSTEM$/ nocase
    $sys_hive.principal.process.file.full_path != ""
    not $sys_hive.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|lsass|smss|wininit|services)\.exe$/ nocase
    not $sys_hive.principal.process.file.full_path in %global_allowed_backup_processes
    not $sys_hive.principal.process.file.full_path in %global_allowed_security_tools
    not $sys_hive.principal.process.file.full_path in %global_allowed_admin_tools
    $sys_hive.principal.hostname = $host
    $sys_hive.principal.process.file.full_path = $proc_path

    $sec_hive.metadata.event_type = "FILE_READ"
    $sec_hive.target.file.full_path = /\\config\\SECURITY$/ nocase
    $sec_hive.principal.process.file.full_path != ""
    not $sec_hive.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|lsass|smss|wininit|services)\.exe$/ nocase
    not $sec_hive.principal.process.file.full_path in %global_allowed_backup_processes
    not $sec_hive.principal.process.file.full_path in %global_allowed_security_tools
    not $sec_hive.principal.process.file.full_path in %global_allowed_admin_tools
    $sec_hive.principal.hostname = $host
    $sec_hive.principal.process.file.full_path = $proc_path

    $sys_hive.metadata.event_timestamp.seconds <= $sec_hive.metadata.event_timestamp.seconds

  match:
    $host, $proc_path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity = array_distinct($host)
    $acting_process = array_distinct($proc_path)
    $acting_user = array_distinct($sec_hive.principal.user.userid)
    $hive_files_read = array_distinct($sec_hive.target.file.full_path)
    $sys_hive_files_read = array_distinct($sys_hive.target.file.full_path)
    $first_read = min($sys_hive.metadata.event_timestamp.seconds)
    $last_read = max($sec_hive.metadata.event_timestamp.seconds)

  condition:
    $sys_hive and $sec_hive
}
