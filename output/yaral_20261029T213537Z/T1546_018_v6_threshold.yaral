/*
  MITRE Technique : T1546.018 - Python Startup Hooks
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:32:54.020424+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_018_Linux_Python_Startup_Hook_File_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Multiple Python startup hook files (.pth files in site-packages/dist-packages, or sitecustomize.py/usercustomize.py) are created on a single Linux host within 10 minutes. These files execute automatically whenever the Python interpreter starts, so a burst of creations outside package-manager activity suggests persistence staging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.018"
    mitre_technique_name = "Event Triggered Execution: Python Startup Hooks"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and configuration management installing Python libraries (editable installs, namespace packages that ship .pth files), virtualenv or conda environment builds, CI/CD runners, and developers bootstrapping environments."
    tuning_guidance = "Add approved deployment, packaging and configuration-management binaries to %global_allowed_admin_tools, and approved build hosts or parent interpreters to %global_allowed_script_hosts. Raise the #file threshold on build servers. Treat sitecustomize.py or usercustomize.py creations as higher fidelity than .pth creations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\/(site-packages|dist-packages)\/[^\/]+\.pth|\/(sitecustomize|usercustomize)\.py)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\/(sitecustomize|usercustomize)\.py$/ nocase, 80, 60))
    $mitre_technique_id = array_distinct("T1546.018")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
