/*
  MITRE Technique : T1583 - Acquire Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:58:03.903639+00:00
  Reference       : https://attack.mitre.org/techniques/T1583
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_DNS_Long_Label_Then_TXT_Same_Domain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single client issues a DNS query containing an abnormally long, encoded-looking subdomain label and then a TXT or NULL record query to the same registered domain within ten minutes. This pattern is consistent with newly acquired adversary-controlled domain infrastructure being used for DNS-based staging, C2 or tunnelling."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583"
    mitre_technique_name = "Acquire Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with the client source IP (principal.ip), the queried name and the query type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services using long hashed hostnames, DKIM/SPF/DMARC and other TXT lookups by mail security gateways, anti-spam DNSBL lookups, email and domain-verification tooling, security products doing cloud lookups over DNS, and internal DNS resolvers that forward on behalf of many clients."
    tuning_guidance = "Add known-good registered domains (CDNs, mail security vendors, update services) to %global_allowed_domains. If recursive resolvers are the logged source, point collection at client-facing logs, or the join will group by resolver IP. Adjust the 40-character label threshold in the first event to tune sensitivity."

  events:
    $dns1.metadata.event_type = "NETWORK_DNS"
    $dns1.network.dns.questions.name = /[a-z0-9_\-]{40,}\.[^.]+\.[^.]+$/ nocase
    not $dns1.network.dns.questions.name = /\.arpa$/ nocase
    $domain = re.capture($dns1.network.dns.questions.name, "([^.]+\\.[^.]+)$")
    not $domain in %global_allowed_domains
    $dns1.principal.ip = $client_ip

    $dns2.metadata.event_type = "NETWORK_DNS"
    $dns2.network.dns.questions.type = 16
    $dns2.network.dns.questions.name = /[^.]+\.[^.]+\.[^.]+$/ nocase
    not $dns2.network.dns.questions.name = /\.arpa$/ nocase
    $domain = re.capture($dns2.network.dns.questions.name, "([^.]+\\.[^.]+)$")
    $dns2.principal.ip = $client_ip

    $dns1.metadata.event_timestamp.seconds <= $dns2.metadata.event_timestamp.seconds

  match:
    $client_ip, $domain over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583")
    $primary_entity = array_distinct($client_ip)
    $suspect_domain = array_distinct($domain)
    $long_label_queries = array_distinct($dns1.network.dns.questions.name)
    $txt_queries = count($dns2.metadata.id)

  condition:
    $dns1 and $dns2
}
