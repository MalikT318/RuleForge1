/*
  MITRE Technique : T1595.002 - Vulnerability Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:55:13.866944+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_002_External_Source_Multi_Port_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source IP makes a high volume of connections to non-web ports on protected address space within ten minutes. Each connection is benign on its own; the volume and port spread are characteristic of service and vulnerability scanning."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.002"
    mitre_technique_name = "Active Scanning: Vulnerability Scanning"
    log_prerequisites = "Requires perimeter firewall or network flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover inbound traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet-wide research scanners, uptime and availability monitors, partner or vendor systems with legitimate multi-service access, load testing, and inbound mail, VPN or VoIP servers with many peers."
    tuning_guidance = "Add authorised external scanners and testing sources to %global_allowed_scanners. Add approved management or partner source addresses to %global_allowed_mgmt_sources. Raise the #net threshold in noisy environments. Review the distinct port list in the outcome to separate scanning from busy services."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $distinct_port_count = count_distinct($net.target.port)
    $risk_score = max(if($distinct_port_count >= 50, 85, if($distinct_port_count >= 20, 70, 50)))
    $mitre_technique_id = array_distinct("T1595.002")
    $primary_entity = array_distinct($src_ip)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 100
}
