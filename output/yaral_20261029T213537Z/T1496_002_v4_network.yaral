/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:19:37.999189+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_Container_Temp_Process_P2P_Or_Socks_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process executing from a world-writable directory (/tmp, /var/tmp, /dev/shm) inside a container or on a container host that opens an outbound connection to a non-internal address on a port used for BitTorrent-style peer seeding or SOCKS proxying. This is characteristic of bandwidth hijacking: torrent seeding, proxyjacking and proxyware relay nodes."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Resource Hijacking: Bandwidth Hijacking"
    log_prerequisites = "Container runtime or node-level network telemetry that populates principal.process.file.full_path, target.ip and target.port for NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "container"
    false_positives = "Peer-to-peer image or artifact distribution agents staged in temp directories, CI/CD build jobs fetching dependencies over SOCKS or torrent-based mirrors, developer test containers, and approved network diagnostic tooling run from /tmp."
    tuning_guidance = "Add approved binaries to %global_allowed_admin_tools, approved agents to %global_allowed_security_tools, and known-good external destinations to %global_allowed_domains. Add or remove ports in the port group to match client policy. Raise severity where the client prohibits P2P and proxy traffic from workloads."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    (
      ($net.target.port >= 6881 and $net.target.port <= 6999) or
      $net.target.port = 51413 or
      $net.target.port = 1080
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
