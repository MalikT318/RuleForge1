/*
  MITRE Technique : T1037.004 - RC Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:55:58.047183+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_004_ESXi_Unexpected_Parent_Modifies_RC_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or busybox child process that writes to an ESXi RC script (/etc/rc.local.d/local.sh, /etc/rc.local, /etc/init.d/*) when its parent is a management daemon, network-facing service, or download/script utility. Administrators normally edit these files from an interactive SSH shell, so this lineage suggests exploitation of a management service or a remote-execution implant establishing persistence across reboots."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.004"
    mitre_technique_name = "Boot or Logon Initialization Scripts: RC Scripts"
    log_prerequisites = "Requires ESXi shell process-execution logging forwarded to Chronicle, with parent and child process paths and the child command line populated in UDM (for example shell.log or auditd-style process telemetry)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Orchestration or lifecycle tooling that rewrites local.sh via a script interpreter (host profile or auto-deploy scripts, configuration-management agents, vendor driver or agent installers that register boot hooks). Admin automation launched from python or perl wrappers."
    tuning_guidance = "Add approved automation parents to %global_allowed_script_hosts, approved deployment tooling to %global_allowed_admin_tools, and named administrator or service identities to %global_allowed_admin_users or %global_allowed_service_accounts. Extend or narrow the parent-process regex to match the management daemons present in the client's ESXi build."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child: shell or busybox applet performing the edit
    $proc.target.process.file.full_path = /\/(sh|ash|bash|busybox)$/ nocase

    // Child command line references an ESXi RC/boot script location
    $proc.target.process.command_line = /(\/etc\/rc\.local\.d\/|\/etc\/rc\.local|\/etc\/init\.d\/|\/etc\/rc\.d\/)/ nocase

    // Child command line shows a write or modify operation
    $proc.target.process.command_line = /(>>?|\btee\b|\bsed\s+-i|\bcp\b|\bmv\b|\becho\b|\bprintf\b|\bchmod\b)/ nocase

    // Parent lineage anomaly: management daemon, network service, or downloader/script runtime
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|fdm|rhttpproxy|sfcbd|sfcb-[a-z_]+|openwsmand|slpd|snmpd|vmsyslogd|python[0-9.]*|perl|wget|curl|nc|netcat|httpd|lighttpd)$/ nocase

    // Tuning exclusions
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
