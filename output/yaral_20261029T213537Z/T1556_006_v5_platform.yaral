/*
  MITRE Technique : T1556.006 - Multi-Factor Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:41:39.116835+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_006_Office_Suite_MFA_Disabled_Or_Method_Removed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects disabling of MFA or removal or administrative registration of an authentication method for an account in a Microsoft 365 or Google Workspace tenant. Adversaries with a compromised account or admin session use these changes to weaken MFA for persistence, or to register a method they control. This rule covers the SaaS control plane through audit-log operations and has no endpoint process dependency."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.006"
    mitre_technique_name = "Modify Authentication Process: Multi-Factor Authentication"
    log_prerequisites = "Requires identity and unified audit log ingestion (directory and security-info change operations) so that the operation name is populated in metadata.product_event_type and the actor and affected account in principal.user.userid and target.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Helpdesk resetting MFA for users who lost or replaced a phone, user offboarding, MFA migration projects (per-user MFA to Conditional Access or security defaults), authentication-method cleanup by identity teams, and automated identity governance or provisioning tooling."
    tuning_guidance = "Add helpdesk and identity administrator accounts to %global_allowed_admin_users and provisioning or governance automation accounts to %global_allowed_service_accounts. Suppress during planned MFA migration windows. If the audit pipeline maps these operations to a different UDM event type, adjust metadata.event_type for that tenant. Consider raising severity when the affected account holds a privileged role."

  events:
    $mfa.metadata.event_type = "SETTING_MODIFICATION"
    $mfa.metadata.product_event_type = /(disable\s+strong\s+authentication|(admin|user)\s+deleted\s+security\s+info|admin\s+registered\s+security\s+info|delete\s+authentication\s+method|reset\s+strong\s+authentication|2sv_disable)/ nocase
    $mfa.target.user.userid != ""
    not $mfa.principal.user.userid in %global_allowed_admin_users
    not $mfa.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.006")
    $primary_entity = array_distinct($mfa.target.user.userid)
    $actor = array_distinct($mfa.principal.user.userid)
    $operation = array_distinct($mfa.metadata.product_event_type)
    $source_ip = array_distinct($mfa.principal.ip)

  condition:
    $mfa
}
