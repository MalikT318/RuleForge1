/*
  MITRE Technique : T1591 - Gather Victim Org Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:24:40.643041+00:00
  Reference       : https://attack.mitre.org/techniques/T1591
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_External_Org_Info_Harvest_Web_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source using a scripted or blank-user-agent HTTP client to request organisational-information resources (org charts, staff or employee directories, phone books, rosters) on an internet-facing web server. This is the network-side footprint of an adversary harvesting victim organisation details for targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591"
    mitre_technique_name = "Gather Victim Org Information"
    log_prerequisites = "IDS/IPS or inline network security appliance with HTTP inspection that populates network.http.user_agent and target.url (decrypted traffic or reverse-proxy visibility), on sensors covering internet-facing web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability or attack-surface scanners, search-engine and SEO crawlers using scripted clients, partner or vendor integrations that legitimately pull a staff or contact directory, uptime monitors, and the organisation's own automation reaching its public site from an external egress address."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add known integration or monitoring sources to %global_allowed_mgmt_sources. Add benign vendor-owned destinations to %global_allowed_domains. If the organisation intentionally publishes a staff directory, narrow the URL regex or raise the logic to a Threshold rule on distinct URLs per source."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(org[-_ ]?chart|organi[sz]ation[-_ ]?chart|staff[-_ ]?(list|directory|roster)|employee[-_ ]?(list|directory|roster)|phone[-_ ]?(book|directory)|address[-_ ]?book|company[-_ ]?directory|personnel[-_ ]?list|who[-_ ]?works[-_ ]?here)/ nocase
    (
      $http.network.http.user_agent = "" or
      $http.network.http.user_agent = /^(python-requests|python-urllib|curl|wget|go-http-client|libwww-perl|java|okhttp|scrapy|aiohttp|node-fetch|axios|httpclient)/ nocase
    )
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1591")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
