/*
  MITRE Technique : T1583.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:05:50.189241+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_004_Algorithmic_DNS_Then_Direct_External_NonStd_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an internal source that resolves a long, random-looking, non-allowlisted domain and then, within ten minutes, opens a connection to an external address on a non-standard high port. This pairing is a network-observable sign of a host reaching newly stood-up adversary-controlled server infrastructure (T1583.004) used for staging or command and control. Detection is by behaviour (name shape, destination port, sequence), not by indicator."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.004"
    mitre_technique_name = "Acquire Infrastructure: Server"
    log_prerequisites = "Requires perimeter or firewall telemetry normalised to UDM NETWORK_DNS (DNS query logging or DNS inspection) and NETWORK_CONNECTION with principal.ip populated on both event types."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "CDN and cloud hostnames with long generated labels, software update services, peer-to-peer or VoIP applications using high ports, gaming clients, and developer or test workloads connecting to self-hosted services."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains, approved scanning or testing sources to %global_allowed_scanners, and approved admin sources to %global_allowed_mgmt_sources. Adjust the label-length threshold in the regex and the excluded port list to suit each client's environment."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^[a-z0-9\-]{16,}\.[a-z0-9\-\.]+$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $src_ip

    $conn.metadata.event_type = "NETWORK_CONNECTION"
    not $conn.target.ip in %rfc1918_internal
    $conn.target.port >= 1024
    $conn.target.port != 8080
    $conn.target.port != 8443
    $conn.target.port != 8000
    $conn.target.port != 3389
    not $conn.principal.ip in %global_allowed_mgmt_sources
    not $conn.principal.ip in %global_allowed_scanners
    $conn.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $conn.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.004")
    $primary_entity = array_distinct($src_ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $destination_ips = array_distinct($conn.target.ip)
    $destination_ports = array_distinct($conn.target.port)
    $connection_count = count($conn.metadata.id)

  condition:
    $dns and $conn
}
