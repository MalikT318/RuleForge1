/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:40:36.528781+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_macOS_Keychain_File_Direct_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process directly reading a macOS Keychain database file (login, System, or local-items keychain). Legitimate credential access goes through the securityd/Security framework, so a third-party process opening the keychain file itself is consistent with credential theft or offline keychain extraction. This is file-access telemetry, not command-line matching, so it still fires when the security utility is not used."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "macOS endpoint telemetry that records file read/open events with the acting process path (for example Endpoint Security framework file-open events). Full Disk Access or equivalent sensor coverage is required to see reads of protected Library paths."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Backup and imaging software (Time Machine helpers, third-party backup agents), enterprise MDM or identity agents that inspect keychains, password managers or migration assistants importing keychain data, forensic or DFIR collection tools, and security agents scanning user files."
    tuning_guidance = "Add approved backup binaries to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and MDM or IT tooling to %global_allowed_admin_tools. The Apple system binary exclusion covers /System and /usr/libexec paths; extend it only if a client has a verified in-house keychain management utility."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/Library\/Keychains\/(([^\/]+\/)?keychain-2\.db|([^\/]+\/)*[^\/]*\.keychain(-db)?)$/ nocase
    not $file.principal.process.file.full_path = /^\/(System\/|usr\/(libexec|sbin)\/)/ nocase
    not $file.principal.process.file.full_path = /\/(securityd|secd|trustd|CloudKeychainProxy|accountsd|cloudd|backupd|mds|mds_stores|mdworker|mdworker_shared|Keychain Access)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $keychain_files = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
