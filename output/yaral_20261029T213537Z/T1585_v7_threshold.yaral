/*
  MITRE Technique : T1585 - Establish Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:35:18.003874+00:00
  Reference       : https://attack.mitre.org/techniques/T1585
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_Bulk_Account_Registration_Web_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single internal source submitting repeated HTTP POST requests to account sign-up or registration endpoints on external sites within ten minutes. One registration is benign. Repeated registrations from one source can indicate bulk account or persona creation for resource development (T1585)."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585"
    mitre_technique_name = "Establish Accounts"
    log_prerequisites = "Requires perimeter proxy or firewall telemetry normalised to NETWORK_HTTP with network.http.method and target.url populated. Visibility into the URL path requires TLS inspection or an explicit forward proxy."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Marketing, QA or web-development staff testing sign-up flows, user-onboarding automation, SaaS administrators provisioning accounts, shared NAT or proxy egress addresses aggregating many users, and security-awareness or phishing-simulation platforms."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Add authorised testing or automation source addresses to %global_allowed_scanners. If the source is a shared NAT or proxy address, group by principal.user.userid instead. Raise the #http threshold for noisy environments."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|join(now)?)(\/|\?|$|\.)/ nocase
    $http.principal.ip = $src
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1585")
    $primary_entity = array_distinct($src)
    $registration_attempts = count($http.metadata.id)
    $destination_hosts = array_distinct($http.target.hostname)
    $sample_urls = array_distinct($http.target.url)

  condition:
    #http >= 5
}
