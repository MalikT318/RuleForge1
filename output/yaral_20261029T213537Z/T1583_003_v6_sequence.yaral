/*
  MITRE Technique : T1583.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:03:53.186197+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_003_External_Probe_Then_Scripted_HTTP_Same_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An external source IP probes perimeter administrative or remote-access ports and then, within ten minutes, sends HTTP requests with a scripted-client user agent to a perimeter web service. This is a reconnaissance pattern typical of attacker-rented VPS infrastructure being used for targeting. It relies on behaviour and does not use IP, ASN or provider lists."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.003"
    mitre_technique_name = "Acquire Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires perimeter firewall connection logs and proxy, WAF or reverse-proxy HTTP logs with the user agent populated, both normalised to UDM with network direction. Both sources must expose the external source address as principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and external penetration tests, uptime and availability monitors, partner or customer automation using scripted HTTP clients, security research crawlers, and admins connecting from a new location who also run scripts."
    tuning_guidance = "Add authorised scanner and pen-test sources to %global_allowed_scanners. Add trusted management source addresses to %global_allowed_mgmt_sources. Extend the port list or user agent pattern per client exposure. Raise severity if the target hosts are internet-facing admin systems."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.network.direction = "INBOUND"
    (
      $conn.target.port = 22 or
      $conn.target.port = 23 or
      $conn.target.port = 445 or
      $conn.target.port = 3389 or
      $conn.target.port = 5900 or
      $conn.target.port = 5985 or
      $conn.target.port = 5986
    )
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    $conn.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.direction = "INBOUND"
    $http.network.http.user_agent = /(?i)(^|[^a-z])(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl|java\/[0-9]|okhttp|scrapy|aiohttp|httpclient)/
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.003")
    $primary_entity = array_distinct($src_ip)
    $probed_ports = array_distinct($conn.target.port)
    $probed_hosts = array_distinct($conn.target.hostname)
    $http_targets = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)
    $first_seen = min($conn.metadata.event_timestamp.seconds)
    $last_seen = max($http.metadata.event_timestamp.seconds)

  condition:
    $conn and $http
}
