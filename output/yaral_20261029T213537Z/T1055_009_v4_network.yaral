/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:35:55.238494+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Linux_Daemon_Unexpected_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a core Linux system daemon (cron, atd, dbus, logind, udev, getty, rsyslog, polkit, auditd) that never legitimately initiates external connections. Network-side post-injection indicator for proc memory injection (T1055.009): code written into a live process via /proc/[pid]/mem or /proc/[pid]/maps (for example with dd) often runs inside such a trusted daemon and calls back to attacker infrastructure. This is an indirect indicator of the injection result, not of the /proc write itself."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd (connect syscall) network telemetry normalised to NETWORK_CONNECTION with the initiating process path populated in principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Custom or vendor-modified daemons with outbound features (cron wrappers sending alerts via external SMTP relay, rsyslog forwarding to an external collector, auditd remote logging plugins, polkit or dbus helpers on managed or cloud-integrated hosts), and EDR attribution errors that report a parent daemon as the connection owner."
    tuning_guidance = "Add approved forwarding or relay processes to %global_allowed_admin_tools and EDR/agent binaries to %global_allowed_security_tools. Ensure %rfc1918_internal covers the client's internal address space. For clients that forward syslog or audit logs to external collectors, exclude the process via %global_allowed_admin_tools. Pair with endpoint rules for writes to /proc/*/mem for higher confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(cron|crond|atd|dbus-daemon|systemd-logind|systemd-udevd|agetty|rsyslogd|irqbalance|polkitd|auditd)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($net.principal.hostname)
    $injected_candidate_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
