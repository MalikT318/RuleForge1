/*
  MITRE Technique : T1590.004 - Network Topology
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:18:48.990270+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_004_External_Probe_Of_Topology_Revealing_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a connection from an external source to a service that exposes network topology: SNMP (161/162), BGP (179), RIP (520) or Cisco Smart Install (4786). These services return routing tables, device inventories, interface lists and configurations. Adversaries probe them during reconnaissance to map the victim's network, and legitimate internet peers rarely reach them. IPS and network security appliances see this traffic at the perimeter, so the rule complements endpoint rules."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.004"
    mitre_technique_name = "Gather Victim Network Information: Network Topology"
    log_prerequisites = "IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover internet-facing (perimeter) interfaces. Populate %rfc1918_internal with the internal address strings seen in the logs."
    platform = "PRE"
    log_source = "ips"
    false_positives = "ISP or upstream provider BGP peering, managed-service SNMP polling from external monitoring platforms, authorised external vulnerability scanners and penetration tests, partner or MSP management tooling, and misconfigured devices sending SNMP traps to a public address."
    tuning_guidance = "Add approved external monitoring and management sources to %global_allowed_mgmt_sources, and authorised scanner sources to %global_allowed_scanners. If BGP peering with a provider is expected, add the peer address to %global_allowed_mgmt_sources. Add or remove ports in the rule to match the services your estate exposes. For higher fidelity, run this alongside a threshold variant that counts distinct destination ports or hosts per source."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 162 or
      $net.target.port = 179 or
      $net.target.port = 520 or
      $net.target.port = 4786
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1590.004")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_hosts = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    $net
}
