/*
  MITRE Technique : T1583 - Acquire Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:57:41.254976+00:00
  Reference       : https://attack.mitre.org/techniques/T1583
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_DNS_Long_HighEntropy_Label_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for names containing an unusually long, machine-generated-looking label (32+ alphanumeric characters) under a domain not on the known-good list. Long random labels are typical of algorithmically generated domains, freshly acquired adversary infrastructure, and DNS-based C2 or tunnelling. Reverse (arpa) lookups and allowlisted domains are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583"
    mitre_technique_name = "Acquire Infrastructure"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. %global_allowed_domains should be populated for each client."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-provider hostnames with long hashed labels, DKIM/DMARC and other email-security lookups, anti-malware and reputation cloud lookups, software-update and telemetry services that use encoded labels, browser safe-browsing prefixes, and mDNS or service-discovery names."
    tuning_guidance = "Add the registered domain of verified benign sources to %global_allowed_domains (the rule checks both the full queried name and the last two labels). Raise the label length from 32 to 40 or more in noisy environments. Review the matching principal.ip values to find hosts querying many distinct generated names."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9-]{32,}\./ nocase
    $dns.network.dns.questions.name = /[0-9]/
    not $dns.network.dns.questions.name = /\.arpa\.?$/ nocase
    $reg_domain = re.capture($dns.network.dns.questions.name, "([^.]+\\.[^.]+)\\.?$")
    not $reg_domain in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583")
    $primary_entity = array_distinct($dns.principal.ip)
    $client_hostname = array_distinct($dns.principal.hostname)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
