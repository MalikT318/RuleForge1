/*
  MITRE Technique : T1588.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:55:34.972593+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_001_Repeated_Executable_Payload_Downloads_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes repeated HTTP requests to external destinations for executable or script payload file types within ten minutes. Individual downloads are common, but a burst of them suggests a malware or tooling acquisition staging pattern."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.001"
    mitre_technique_name = "Obtain Capabilities: Malware"
    log_prerequisites = "Requires firewall or proxy logs with URL visibility (HTTP inspection or TLS decryption) normalised to NETWORK_HTTP, with target.url, target.hostname, target.ip and principal.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software deployment and patching, developer package and build pipelines, IT staff or sandbox hosts downloading installers, and update mechanisms for vendors not in the allowed domain list."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Raise the #net threshold for build, developer or software distribution segments. Scale the response with the $download_count and $distinct_destinations outcome values."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(exe|dll|msi|scr|ps1|bat|vbs|hta|jar|cmd)(\?|#|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1588.001")
    $primary_entity = array_distinct($src_ip)
    $download_count = count($net.metadata.id)
    $distinct_destinations = count_distinct($net.target.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 5
}
