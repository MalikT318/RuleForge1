/*
  MITRE Technique : T1608 - Stage Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:19:00.980465+00:00
  Reference       : https://attack.mitre.org/techniques/T1608
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_Direct_IP_Payload_Download_Staged_Capability {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client fetching an executable, script, installer, archive or disk-image payload over HTTP(S) from an external server addressed by a bare IP literal rather than a domain name. This is characteristic of adversary-staged capabilities on rented or compromised infrastructure (T1608) and is observed from the network side only."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608"
    mitre_technique_name = "Stage Capabilities"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL visibility (explicit proxy or TLS inspection) normalised to UDM NETWORK_HTTP with target.url populated. Without URL visibility for HTTPS traffic, only cleartext HTTP is covered."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software vendors or appliances that distribute updates from IP-addressed hosts, internal-style test servers exposed on public IPs, developer or lab downloads, and CDN or edge nodes addressed directly by IP."
    tuning_guidance = "Add known-good vendor update domains to %global_allowed_domains. Add authorised scanners and testing sources to %global_allowed_scanners. Ensure %rfc1918_internal covers all client internal ranges. Raise severity if the downloading client is a server or a high-value asset."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?\/[^?#]*\.(exe|dll|msi|scr|ps1|psm1|bat|cmd|vbs|js|hta|jar|zip|7z|rar|iso|img|lnk|docm|xlsm)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608")
    $primary_entity = array_distinct($net.principal.ip)
    $staged_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
