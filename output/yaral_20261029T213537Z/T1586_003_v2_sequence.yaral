/*
  MITRE Technique : T1586.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:45:09.207871+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_003_Auth_Failures_Then_Success_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An external source generates repeated authentication failures (HTTP 401/403 on login-style endpoints) against a cloud-facing host and then gets a successful login response from the same host within 10 minutes. This pattern is consistent with password spraying or credential stuffing that ends in a compromised cloud account, as in T1586.003."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.003"
    mitre_technique_name = "Compromise Accounts: Cloud Accounts"
    log_prerequisites = "Requires firewall, reverse proxy, or perimeter logs that normalise to NETWORK_HTTP with network.http.method, network.http.response_code, target.url, principal.ip and target.hostname populated. Needs TLS inspection or a reverse-proxy position to see HTTP status codes."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users who mistype a password several times and then log in successfully, especially behind shared NAT or VPN egress addresses. Also SSO or MFA retry flows that return 401 before a token exchange succeeds, mobile apps with stale tokens, and authorised penetration tests or credential audits."
    tuning_guidance = "Add authorised test sources to %global_allowed_scanners. Raise the #fail threshold for tenants with large NAT populations. Restrict the target.url regex to the tenant's identity endpoints if login paths are noisy. Add known corporate egress addresses to %global_allowed_mgmt_sources if they are a persistent source of benign retries."

  events:
    $fail.metadata.event_type = "NETWORK_HTTP"
    $fail.network.http.method = "POST" nocase
    ($fail.network.http.response_code = 401 or $fail.network.http.response_code = 403)
    $fail.target.url = /(login|logon|signin|sign-in|authenticate|oauth2?\/token|\/auth)/ nocase
    not $fail.principal.ip in %rfc1918_internal
    not $fail.principal.ip in %global_allowed_scanners
    not $fail.principal.ip in %global_allowed_mgmt_sources
    $fail.principal.ip = $src_ip
    $fail.target.hostname = $target_host

    $success.metadata.event_type = "NETWORK_HTTP"
    $success.network.http.method = "POST" nocase
    $success.network.http.response_code = 200
    $success.target.url = /(login|logon|signin|sign-in|authenticate|oauth2?\/token|\/auth)/ nocase
    not $success.principal.ip in %rfc1918_internal
    not $success.principal.ip in %global_allowed_scanners
    not $success.principal.ip in %global_allowed_mgmt_sources
    $success.principal.ip = $src_ip
    $success.target.hostname = $target_host

    $fail.metadata.event_timestamp.seconds <= $success.metadata.event_timestamp.seconds

  match:
    $src_ip, $target_host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1586.003")
    $primary_entity = array_distinct($src_ip)
    $targeted_host = array_distinct($target_host)
    $failure_count = count($fail.metadata.id)
    $success_count = count($success.metadata.id)
    $targeted_urls = array_distinct($success.target.url)
    $first_failure = min($fail.metadata.event_timestamp.seconds)
    $first_success = min($success.metadata.event_timestamp.seconds)

  condition:
    #fail >= 5 and $success
}
