/*
  MITRE Technique : T1590.004 - Network Topology
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:19:57.089091+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_004_External_Probe_Of_Topology_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source reaching network-infrastructure services that disclose topology (SNMP, BGP, RIP, vendor smart-install, NETCONF) through the perimeter. Also detects traffic that an IPS signature has labelled as SNMP, routing-protocol, or topology reconnaissance. This is pre-compromise network topology gathering by an Internet-based actor."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.004"
    mitre_technique_name = "Gather Victim Network Information: Network Topology"
    log_prerequisites = "IDS/IPS or perimeter network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and, where available, security_result.rule_name. The sensor must see inbound Internet-sourced traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate external BGP or routing peers, managed-service-provider SNMP monitoring, ISP or NOC polling, authorised external attack-surface scanners and penetration tests, and cloud monitoring probes."
    tuning_guidance = "Add approved external monitoring and peering source addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to %global_allowed_scanners. If the sensor does not populate security_result.rule_name, the port-based logic still applies. For noisy perimeters, move to a Threshold variant or raise severity only after repeated hits from one source."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 162 or
      $net.target.port = 179 or
      $net.target.port = 520 or
      $net.target.port = 830 or
      $net.target.port = 4786 or
      $net.security_result.rule_name = /(snmp|\bbgp\b|\brip\b|smart.?install|traceroute|topology|network.?(map|enum|recon)|router.?(scan|enum))/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1590.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
