/*
  MITRE Technique : T1598.001 - Spearphishing Service
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:12:25.545911+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_001_Unvetted_Domain_Resolve_Then_Credential_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A host resolves an external domain that is not on the known-good list and then, within 10 minutes, submits an HTTP POST to the same domain on a URL that looks like a login, verification or information-collection page. This is the network-observable result of a user following a spearphishing-for-information lure delivered through a third-party service (social media, personal webmail) and submitting details to the adversary's page."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.001"
    mitre_technique_name = "Phishing for Information: Spearphishing Service"
    log_prerequisites = "Requires perimeter firewall or proxy telemetry that records both DNS queries and HTTP requests (full URL and POST method), normalised to UDM NETWORK_DNS and NETWORK_HTTP, with the source IP populated on both. HTTP URL visibility needs TLS inspection or a forward proxy; without it the HTTP leg will not populate."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate sign-in to SaaS, partner or vendor portals not yet in the known-good domain list; employees using personal webmail or social media; newly onboarded business applications; customer survey or payment portals; authorised phishing-awareness simulations."
    tuning_guidance = "Add sanctioned SaaS, partner and vendor domains to %global_allowed_domains. Add authorised phishing-simulation and vulnerability-scanner sources to %global_allowed_scanners. Widen or narrow the URL keyword regex per client. If the firewall does not log the HTTP method, remove the POST condition and raise the risk threshold in SOAR instead."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /\./
    not $dns.network.dns.questions.name = /\.(local|internal|lan|corp|localdomain|arpa)$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $src_ip
    $dns.network.dns.questions.name = $domain

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /(login|signin|sign-in|logon|verify|validation|account|password|credential|survey|recruit|careers)/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip
    $http.target.hostname = $domain

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip, $domain over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1598.001")
    $primary_entity = array_distinct($src_ip)
    $suspect_domain = array_distinct($domain)
    $post_urls = array_distinct($http.target.url)
    $post_count = count($http.metadata.id)

  condition:
    $dns and $http
}
