/*
  MITRE Technique : T1037.005 - Startup Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:57:35.796470+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_005_macOS_StartupItems_Create_Then_Chmod {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a file being created under /Library/StartupItems followed, within 10 minutes on the same host, by a chmod that makes a StartupItems file executable. This is the typical way to register a legacy startup item that runs as root at boot. Detection is based on the behaviour and does not depend on any filename, hash, or payload."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.005"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Startup Items"
    log_prerequisites = "Requires macOS endpoint telemetry that reports both file creation events and process launch events with full command lines."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy third-party installers that still register StartupItems, IT deployment or packaging scripts, and admins maintaining old startup items by hand. /Library/StartupItems is deprecated, so legitimate activity is rare on modern macOS."
    tuning_guidance = "Add approved installer, deployment, and MDM binaries to %global_allowed_admin_tools. The list is applied to the parent process path of both events. If a client has legacy software that legitimately uses StartupItems, scope the exclusion by process path rather than by directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/StartupItems\/.+/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/chmod$/ nocase
    $proc.target.process.command_line = /\/Library\/StartupItems\// nocase
    $proc.target.process.command_line = /(\+[a-z]*x|\b0?[0-7][0-7][157]\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.005")
    $primary_entity = array_distinct($hostname)
    $startup_item_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $chmod_command_lines = array_distinct($proc.target.process.command_line)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
