/*
  MITRE Technique : T1590.005 - IP Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:20:29.675853+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_005_External_IP_Enumeration_IPS_Verdict {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IDS/IPS detection verdict for reconnaissance-class activity (scan, sweep, probe, enumeration, fingerprinting) originating from a non-internal source address. This is the network-side footprint of an adversary mapping which public IP addresses are live for a victim organization."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.005"
    mitre_technique_name = "Gather Victim Network Information: IP Addresses"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION, with signature or rule names populated in security_result.rule_name or security_result.summary, and principal.ip populated with the external source."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and penetration tests not yet allowlisted, external attack-surface monitoring services engaged by the customer, uptime and monitoring probes, and benign internet-wide research scanners that trigger generic scan signatures."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Narrow or widen the signature keyword regex to match the client's IPS signature naming conventions. Where volume is high, route to a lower-priority queue or pair with a downstream threshold rule keyed on principal.ip."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip != ""
    (
      $net.security_result.rule_name = /(port\s?scan|host\s?sweep|network\s?scan|ping\s?sweep|scan|sweep|probe|recon|enumerat|fingerprint)/ nocase or
      $net.security_result.summary = /(port\s?scan|host\s?sweep|network\s?scan|ping\s?sweep|scan|sweep|probe|recon|enumerat|fingerprint)/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1590.005")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
