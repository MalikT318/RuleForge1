/*
  MITRE Technique : T1546.014 - Emond
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:31:36.766625+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_014_Emond_Process_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Event Monitor Daemon (emond), or a process directly spawned by it, making an outbound network connection to a non-internal address. emond normally only processes local system events and has no legitimate reason to talk to external hosts. External traffic from emond or its children indicates a malicious emond rule acting as a downloader, reverse shell or beacon."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.014"
    mitre_technique_name = "Event Triggered Execution: Emond"
    log_prerequisites = "Requires macOS endpoint network telemetry that records the originating process and its parent process path for outbound connections (NETWORK_CONNECTION)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Approved management or security agents launched from emond rules (rare), MDM or compliance scripts wired into emond by IT, and diagnostic tooling run by administrators."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools or %global_allowed_security_tools. Add approved management hosts to %global_allowed_mgmt_sources. Add known-good external destinations to %global_allowed_domains if the telemetry populates a destination hostname."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /\/sbin\/emond$/ nocase or
      $net.principal.process.parent_process.file.full_path = /\/sbin\/emond$/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.014")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
