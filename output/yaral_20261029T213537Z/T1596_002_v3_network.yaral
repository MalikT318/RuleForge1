/*
  MITRE Technique : T1596.002 - WHOIS
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:01:08.745557+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_002_WHOIS_Port43_Outbound_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a network connection to TCP/43 (the WHOIS service) on an external address, as seen by an IDS/IPS or network security appliance. Direct WHOIS lookups from a host are a command-line or tool-driven way of collecting registration, netblock, and nameserver data about a domain or IP range. Hosts in a monitored network rarely have a business need to query WHOIS servers directly."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.002"
    mitre_technique_name = "Search Open Technical Databases: WHOIS"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs that normalise to UDM NETWORK_CONNECTION with target.port and target.ip populated, covering egress traffic. The sensor must see traffic from internal segments to the internet."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security analysts and threat intelligence teams doing authorised domain research; mail gateways or anti-spam systems that query WHOIS for domain-age checks; domain registrar or brand-protection tooling; network engineers troubleshooting IP ownership; authorised external attack-surface scanners."
    tuning_guidance = "Add authorised research sources, mail security gateways, and approved scanners to %global_allowed_scanners (matched on source IP). Add approved management or jump-host source addresses to %global_allowed_mgmt_sources. Raise severity for hosts that also show other reconnaissance activity. If the sensor reports only inbound-direction events, confirm egress visibility before relying on this rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 43
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596.002")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
