/*
  MITRE Technique : T1069 - Permission Groups Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:00:53.616460+00:00
  Reference       : https://attack.mitre.org/techniques/T1069
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_Linux_Group_Database_Mass_Read_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single user on a single Linux host repeatedly reading local group, privilege and sudo configuration files (/etc/group, /etc/gshadow, /etc/sudoers, /etc/sudoers.d) within ten minutes. A single read is routine, because libc name resolution and many utilities read these files. A high volume of reads by a non-system process indicates programmatic enumeration of groups and elevated-permission membership. This covers file-access telemetry and is additive to command-line based discovery rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069"
    mitre_technique_name = "Permission Groups Discovery"
    log_prerequisites = "Requires auditd file watch rules (-w /etc/group -p r, /etc/gshadow, /etc/sudoers, /etc/sudoers.d) or EDR file-read telemetry normalized to UDM FILE_READ with principal.user.userid and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt), identity and directory sync services, compliance and audit scanners, package managers, backup agents, and administrators auditing group membership with scripts."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools, EDR/audit agents to %global_allowed_security_tools, scanners to %global_allowed_scanners, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on hosts where auditd watches are noisy, or extend the system daemon exclusion regex for local identity services."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/etc\/(group-?|gshadow-?|sudoers|sudoers\.d\/.+)$/ nocase
    $file.principal.hostname = $host
    $file.principal.user.userid = $user
    not $file.principal.process.file.full_path = /\/(sshd|systemd|systemd-logind|systemd-userdbd|nscd|sssd|sssd_nss|crond?|sudo|su|login|polkitd|dbus-daemon|accounts-daemon|auditd|rsyslogd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_scanners
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host, $user over 10m

  outcome:
    $risk_score = max(50)
    $event_count = count($file.metadata.id)
    $files_read = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $mitre_technique_id = array_distinct("T1069")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 15
}
