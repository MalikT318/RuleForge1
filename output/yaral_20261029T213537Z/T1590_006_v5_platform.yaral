/*
  MITRE Technique : T1590.006 - Network Security Appliances
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:23:42.729022+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_006_IPS_Firewall_IDS_Fingerprinting_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source triggering network security appliance (IDS/IPS) signatures associated with firewall and IDS fingerprinting, such as ACK/FIN/NULL/Xmas scans, firewalking, TTL probing and evasion-style fragmentation. These are the probing techniques adversaries use to map firewall rulesets and detection controls before targeting. The rule keys on the signature classification, not on the verdict, so it fires whether the probe was blocked or only detected."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.006"
    mitre_technique_name = "Gather Victim Network Information: Network Security Appliances"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION, with security_result.rule_name or security_result.description populated with the signature name."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and penetration tests, internet-wide research scanners, external attack-surface monitoring services, and noisy signatures that flag benign asymmetric routing or broken TCP stacks as scan-like."
    tuning_guidance = "Add authorised scan sources to %global_allowed_scanners and approved management addresses to %global_allowed_mgmt_sources. If the signature naming scheme differs for a client, extend the regex terms for that client. Use alongside volume-based scan rules to prioritise persistent sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.rule_name = /(firewalk|(ack|fin|null|xmas|window|maimon|idle)[ _-]?scan|ids[ _-]?evasion|fragment(ation)?[ _-]?(overlap|evasion)|ttl[ _-]?(expir|probe)|firewall[ _-]?(probe|fingerprint|enum)|os[ _-]?fingerprint)/ nocase or
      $net.security_result.description = /(firewalk|(ack|fin|null|xmas|window|maimon|idle)[ _-]?scan|ids[ _-]?evasion|fragment(ation)?[ _-]?(overlap|evasion)|ttl[ _-]?(expir|probe)|firewall[ _-]?(probe|fingerprint|enum)|os[ _-]?fingerprint)/ nocase
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1590.006")
    $primary_entity = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $signatures = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
