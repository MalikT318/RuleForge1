/*
  MITRE Technique : T1598.002 - Spearphishing Attachment
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:14:13.091643+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_002_Credential_Form_POST_No_Referrer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client submitting an HTTP POST to an external destination whose URL looks like a credential-harvesting form, with no referrer or a local file:// referrer. This pattern is typical of an HTML attachment (HTML smuggling or a fillable credential page) opened from a spearphishing email and posted back to attacker infrastructure. Detection is based on the network-observable behaviour, not on specific domains or IPs."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.002"
    mitre_technique_name = "Phishing for Information: Spearphishing Attachment"
    log_prerequisites = "Requires perimeter or proxy HTTP logs normalised to NETWORK_HTTP with network.http.method, target.url, target.hostname and target.ip populated. TLS inspection is needed for URL visibility on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS or SSO login posts that arrive with no referrer (privacy-stripped referrers, API clients, mobile apps, password managers), vendor portals not yet in the allowlist, and automated health checks against login endpoints."
    tuning_guidance = "Add known-good SaaS, identity-provider and vendor domains to %global_allowed_domains. Exclude internal address space via %rfc1918_internal. If TLS inspection is unavailable, expect reduced coverage because the URL path will not be visible."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /(login|log-in|signin|sign-in|logon|verify|validate|password|passwd|credential|authenticate|webmail|account[-_]?(update|security|recovery))/ nocase
    ($net.network.http.referral_url = "" or $net.network.http.referral_url = /^file:\/\// nocase)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1598.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $posted_urls = array_distinct($net.target.url)

  condition:
    $net
}
