/*
  MITRE Technique : T1586.001 - Social Media Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:41:58.397986+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_001_Credential_Stuffing_Login_Burst_After_DNS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects one internal source that resolves an authentication-style hostname and then sends a burst of HTTP POST requests to login or authentication endpoints on external hosts within ten minutes. This behaviour matches automated credential stuffing or brute forcing against externally hosted accounts such as social media personas, which adversaries use to compromise accounts for later social engineering. It is network-observable at the perimeter and does not depend on endpoint process telemetry."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.001"
    mitre_technique_name = "Compromise Accounts: Social Media Accounts"
    log_prerequisites = "Requires perimeter or proxy logs that record DNS queries (NETWORK_DNS) and HTTP method and URL (NETWORK_HTTP). HTTP method and URL visibility needs TLS inspection or an explicit forward proxy. Without them, the HTTP leg will not populate."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Corporate social media management or marketing automation tools, password managers and SSO or identity-provider integrations that sign in to many external services, QA and synthetic-monitoring probes that log in to external web apps, and web crawlers or testing suites run by authorised teams."
    tuning_guidance = "Add authorised testing and monitoring source addresses to %global_allowed_scanners and trusted login destinations (SSO providers, SaaS vendors) to %global_allowed_domains. Raise or lower the #http threshold per client depending on the proxy's logging granularity and normal login volume. Consider scoping to egress addresses of non-user segments."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^(login|accounts?|auth|signin|sso|id|secure|m|www|api)\./ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /\/(log[-_]?in|sign[-_]?in|session|authenticate|auth|oauth\/token|checkpoint|ajax\/login)(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1586.001")
    $primary_entity = array_distinct($src_ip)
    $login_attempts = count($http.metadata.id)
    $login_destinations = array_distinct($http.target.hostname)
    $resolved_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns and #http >= 10
}
