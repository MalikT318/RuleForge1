/*
  MITRE Technique : T1586 - Compromise Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:40:03.768388+00:00
  Reference       : https://attack.mitre.org/techniques/T1586
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_Scripted_Auth_Failures_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source sending a scripted or library-based HTTP client POST to an authentication endpoint and receiving an authentication failure (401/403). Automated credential guessing, password spraying and credential stuffing are the main ways adversaries compromise existing accounts (T1586), and this is the network-side signature of that activity."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586"
    mitre_technique_name = "Compromise Accounts"
    log_prerequisites = "Requires proxy, WAF or perimeter logs that populate HTTP method, URL, response code and user agent in UDM NETWORK_HTTP events, with external source IPs preserved (no NAT masking on the inbound path)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Uptime or synthetic-monitoring probes with expired credentials, partner or customer API integrations with rotated secrets, mobile or desktop apps whose user agent is a default HTTP library, and authorised penetration tests."
    tuning_guidance = "Add authorised testing sources to %global_allowed_scanners and known partner or monitoring source addresses to %global_allowed_mgmt_sources. Pair this rule with a downstream aggregation (for example SOAR counting alerts per source IP) to separate sustained spraying from isolated failures. Raise severity for sources that also match threat intelligence."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(?i)\/(login|signin|sign-in|logon|auth|authenticate|oauth2?\/token|session|sso|owa\/auth|wp-login|api\/(v\d+\/)?(login|auth|token))([\/?.#]|$)/
    $http.network.http.response_code >= 401
    $http.network.http.response_code <= 403
    $http.network.http.user_agent = /(?i)(python-requests|python-urllib|aiohttp|curl\/|wget\/|go-http-client|okhttp|libwww-perl|java\/|apache-httpclient|axios|node-fetch|httpx|scrapy|powershell|^$)/
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1586")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $targeted_url = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
