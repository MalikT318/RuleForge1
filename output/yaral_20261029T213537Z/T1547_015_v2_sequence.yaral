/*
  MITRE Technique : T1547.015 - Login Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:46:56.638228+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_015_MacOS_Dropped_Payload_Then_LoginItem_Store_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an executable-like file (app bundle binary, script, command file) written to a user-writable staging location, followed within 10 minutes on the same host by a modification of the macOS login item stores (shared file list login items or the background task management database). This sequence indicates a freshly staged payload being registered to launch at user login, without relying on osascript command-line content."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.015"
    mitre_technique_name = "Boot or Logon Autostart Execution: Login Items"
    log_prerequisites = "Requires macOS endpoint file telemetry (FILE_CREATION and FILE_MODIFICATION) with principal process and target file path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate user-installed applications (chat, sync, music or VPN clients) that are downloaded and then register themselves as login items; MDM or software deployment agents staging installers in /private/tmp; developer tooling writing scripts then enabling login items."
    tuning_guidance = "Add approved deployment and MDM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Narrow the staging path regex if a client's software distribution stages in Downloads or /Users/Shared. Raise severity when the same host also shows an osascript or launchctl process launch in the window."

  events:
    $drop.metadata.event_type = "FILE_CREATION"
    $drop.target.file.full_path = /^\/(private\/)?(tmp|var\/tmp)\/|^\/Users\/(Shared|[^\/]+\/(Downloads|Public))\// nocase
    $drop.target.file.full_path = /\/Contents\/MacOS\/[^\/]+$|\.(command|sh|scpt|scptd|py)$/ nocase
    not $drop.principal.process.file.full_path = /\/(installd|system_installd|package_script_service|softwareupdated)$/ nocase
    not $drop.principal.process.file.full_path in %global_allowed_admin_tools
    not $drop.principal.process.file.full_path in %global_allowed_security_tools
    $drop.principal.hostname = $hostname

    $login.metadata.event_type = "FILE_MODIFICATION"
    $login.target.file.full_path = /\/com\.apple\.sharedfilelist\/.*(Session|Login)Items.*\.sfl[0-9]*$|\/com\.apple\.backgroundtaskmanagementagent\/backgroundItems-v[0-9]+\.btm$|\/com\.apple\.loginitems\.plist$/ nocase
    not $login.principal.process.file.full_path = /\/(System Settings|System Preferences)$/ nocase
    not $login.principal.process.file.full_path in %global_allowed_admin_tools
    not $login.principal.process.file.full_path in %global_allowed_security_tools
    $login.principal.hostname = $hostname

    $drop.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.015")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($drop.target.file.full_path)
    $dropper_processes = array_distinct($drop.principal.process.file.full_path)
    $login_item_stores = array_distinct($login.target.file.full_path)
    $login_item_writers = array_distinct($login.principal.process.file.full_path)
    $affected_users = array_distinct($login.principal.user.userid)

  condition:
    $drop and $login
}
