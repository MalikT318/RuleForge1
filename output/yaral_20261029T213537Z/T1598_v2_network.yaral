/*
  MITRE Technique : T1598 - Phishing for Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:09:24.325962+00:00
  Reference       : https://attack.mitre.org/techniques/T1598
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_Credential_Form_Submission_To_Suspicious_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client submitting an HTTP POST to a credential-style URL path on an external host that is not allowlisted and has a suspicious host pattern (raw IP literal or a heavily hyphenated, deceptive hostname). This is the network-side signature of a user submitting information to a phishing-for-information landing page."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598"
    mitre_technique_name = "Phishing for Information"
    log_prerequisites = "Requires firewall or proxy logs normalised to NETWORK_HTTP with the HTTP method, target URL and target hostname populated. TLS inspection is needed to see the URL path for HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate vendor or SaaS login portals reached by IP or hyphenated hostnames, internal staging or lab authentication pages, partner-hosted SSO or payment pages, and security awareness phishing simulations."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Exclude authorised phishing simulation and scanning sources via %global_allowed_scanners. Tighten or widen the path keyword and hostname regexes to fit the client's proxy URL logging depth. If the log source does not populate target.url, move the logic to NETWORK_DNS."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(login|log-in|signin|sign-in|verify|password|passwd|credential|account|secure|webmail|sso|auth)/ nocase
    (
      $http.target.hostname = /^(\d{1,3}\.){3}\d{1,3}$/ or
      $http.target.hostname = /^[^.]*(-[^.]*){3,}\./ nocase
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)

  condition:
    $http
}
