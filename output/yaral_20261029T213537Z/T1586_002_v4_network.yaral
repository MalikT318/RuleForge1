/*
  MITRE Technique : T1586.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:44:00.564077+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_002_External_Legacy_Mail_Protocol_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects inbound connections from external address space to mail retrieval services (POP3/IMAP, cleartext and implicit TLS) published at the perimeter. Credential-stuffing and password-spray tooling used to compromise email accounts for later phishing or spam operations commonly targets these legacy-authentication protocols. Cleartext POP3/IMAP from the internet is the strongest signal."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.002"
    mitre_technique_name = "Compromise Accounts: Email Accounts"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.direction populated. Mail retrieval ports must be published or NAT-forwarded through the monitored perimeter."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate remote users and mobile devices using POP3/IMAP clients directly against the corporate mail service; third-party mail aggregation or migration services; authorised vulnerability scanners and external attack-surface monitoring; partner or managed-mail integrations."
    tuning_guidance = "Add authorised scanner and attack-surface monitoring source addresses to %global_allowed_scanners. Add trusted partner or management source addresses to %global_allowed_mgmt_sources. If clients legitimately use implicit-TLS IMAP/POP3 (993/995), remove those ports and keep the cleartext ports (110/143), or escalate to a Threshold variant keyed on source IP. Confirm network.direction is populated by the firewall parser; if it is not, remove that condition and rely on the internal-source exclusion."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    (
      $net.target.port = 110 or
      $net.target.port = 143 or
      $net.target.port = 993 or
      $net.target.port = 995
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1586.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
