/*
  MITRE Technique : T1574.004 - Dylib Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:53:00.634989+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_004_MacOS_Dylib_Dropped_In_App_Bundle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a .dylib file inside the executable or framework search locations of an application bundle (Contents/MacOS, Contents/Frameworks, Contents/PlugIns) by a process that is not a known installer, updater or build tool. Planting a library with an expected or missing name in these @rpath-searched locations is the file-level artifact of dylib hijacking, and it is visible even when command-line logging is evaded."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.004"
    mitre_technique_name = "Hijack Execution Flow: Dylib Hijacking"
    log_prerequisites = "macOS endpoint telemetry that reports file creation events with the writing (principal) process path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Application self-updaters (Sparkle-style), drag-and-drop installs from disk images, software deployment and MDM agents, developer builds that emit dylibs into .app bundles, package managers, and plug-in installers that add libraries to a host application."
    tuning_guidance = "Add approved deployment, MDM and patching binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add developer hosts' build tooling to the executable-name exclusion if builds are noisy. Consider raising severity when the writing process is a user-writable path, a scripting interpreter or a browser."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.app\/Contents\/(MacOS|Frameworks|PlugIns)\/.*\.dylib$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(installer|installd|system_installd|package_script_service|softwareupdated|Autoupdate|xcodebuild|XCBBuildService|swift-frontend|clang|ld)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_dylib = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
