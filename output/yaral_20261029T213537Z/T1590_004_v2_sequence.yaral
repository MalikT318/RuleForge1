/*
  MITRE Technique : T1590.004 - Network Topology
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:19:08.077520+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_004_External_Infra_Port_Probe_Then_Web_Enum {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an external source that probes multiple network-infrastructure management ports (SSH, Telnet, SNMP, BGP, NETCONF, Smart Install, router admin APIs) and then generates repeated HTTP error responses against perimeter hosts within ten minutes. This pattern is consistent with external network topology and device reconnaissance."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.004"
    mitre_technique_name = "Gather Victim Network Information: Network Topology"
    log_prerequisites = "Requires IDS/IPS or network security appliance telemetry normalised to UDM NETWORK_CONNECTION and NETWORK_HTTP, with principal.ip, target.ip, target.port and network.http.response_code populated. The sensor must sit at the internet-facing perimeter."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface-monitoring services, internet-wide research scanners (benign noise), penetration tests, and uptime or monitoring probes that check management ports and web endpoints."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners. Add approved external management sources to %global_allowed_mgmt_sources. Raise the #scan and #http thresholds in the condition for noisy perimeters, or narrow the port list to the services the customer actually exposes."

  events:
    $scan.metadata.event_type = "NETWORK_CONNECTION"
    (
      $scan.target.port = 22 or
      $scan.target.port = 23 or
      $scan.target.port = 161 or
      $scan.target.port = 179 or
      $scan.target.port = 830 or
      $scan.target.port = 4786 or
      $scan.target.port = 8291 or
      $scan.target.port = 8728
    )
    not $scan.principal.ip in %rfc1918_internal
    not $scan.principal.ip in %global_allowed_scanners
    not $scan.principal.ip in %global_allowed_mgmt_sources
    $scan.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.response_code >= 400
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $scan.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1590.004")
    $primary_entity = array_distinct($src_ip)
    $probed_ports = array_distinct($scan.target.port)
    $probed_hosts = array_distinct($scan.target.ip)
    $http_targets = array_distinct($http.target.ip)
    $scan_count = count($scan.metadata.id)
    $http_error_count = count($http.metadata.id)

  condition:
    #scan >= 5 and #http >= 3
}
