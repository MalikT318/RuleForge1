/*
  MITRE Technique : T1584.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:19:50.153994+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_002_DNS_Tunnel_Long_Label_TXT_NULL_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for TXT or NULL records where a subdomain label is 40 or more characters of encoded-looking text. This is the typical pattern of command-and-control or data transfer over DNS. It can indicate a client talking to an adversary-controlled or compromised third-party DNS server, which is the infrastructure described by T1584.002. Known-good domains are excluded through a reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.002"
    mitre_technique_name = "Compromise Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam DNS blocklist lookups, DKIM and SPF TXT lookups with long selectors, CDN or vendor telemetry using encoded subdomains, antivirus cloud-lookup services, and DNS-based licensing or software update checks."
    tuning_guidance = "Add known-good parent domains to %global_allowed_domains. The list is matched against the full queried name, so include the exact FQDNs seen in benign hits. Raise or lower the label length (currently 40) per environment. Pivot on the principal.hostname outcome to find the client, then review query volume to the same parent domain."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{40,}\./ nocase
    not $dns.network.dns.questions.name = /\.(arpa|local|localdomain)$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $client_ips = array_distinct($dns.principal.ip)

  condition:
    $dns
}
