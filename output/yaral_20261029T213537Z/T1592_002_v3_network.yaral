/*
  MITRE Technique : T1592.002 - Software
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:37:49.789773+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_002_External_Software_Version_Probing_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-internal) source issuing HTTP requests to generic software and version disclosure endpoints, such as server status or info pages, phpinfo, actuator info and env, changelog, readme and version files, and admin consoles that reveal product versions. These are network-side signs of victim software fingerprinting ahead of targeting. The rule is path-category based, so it does not depend on a specific scanner name, hash, or hosting infrastructure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.002"
    mitre_technique_name = "Gather Victim Host Information: Software"
    log_prerequisites = "Requires perimeter proxy, web gateway, or WAF-style HTTP logs normalised to NETWORK_HTTP with principal.ip and target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability or attack-surface scanners, uptime and health monitors polling status or version endpoints, search-engine crawlers fetching readme or manifest files, partner integrations that query version endpoints, and developers or customers checking release notes."
    tuning_guidance = "Add authorised external scanner and monitoring source IPs to %global_allowed_scanners and approved partner or management source addresses to %global_allowed_mgmt_sources. If health-check traffic is noisy, narrow the path regex or raise severity only when several distinct paths are probed from one source (convert to a Threshold variant)."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.target.url = /\/(server-status|server-info|phpinfo(\.php)?|info\.php|actuator\/(info|env|health)|jmx-console|elmah\.axd|solr\/admin\/info|(readme|changelog|release[-_]?notes|version)(\.(txt|md|html|json|php))?|wp-includes\/version\.php|CHANGELOG|VERSION)(\?.*|\/)?$/ nocase

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1592.002")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_hosts = array_distinct($http.target.hostname)
    $probed_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
