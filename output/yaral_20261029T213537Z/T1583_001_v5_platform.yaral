/*
  MITRE Technique : T1583.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:59:39.568006+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_001_Punycode_IDN_Lookalike_Domain_DNS_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a DNS query for a name with a punycode (xn--) label under an ASCII top-level domain. Adversaries acquire internationalized domain names (IDN homographs) that visually mimic legitimate brands for phishing, drive-by delivery and C2 (T1583.001). Internationalized TLDs are excluded to reduce noise from legitimate national domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.001"
    mitre_technique_name = "Acquire Infrastructure: Domains"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS with network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate internationalized domains (non-Latin-script businesses, regional news, academic sites), browsers prefetching IDN sites, and security research or brand-protection monitoring that resolves lookalike domains."
    tuning_guidance = "Add known-good IDN domains (fully qualified names) to %global_allowed_domains. Exclude brand-protection or threat-intel resolver hosts through your client baseline. Raise severity when the same client queries several distinct punycode domains. Expect higher volume in environments that serve non-Latin-script users."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)xn--[a-z0-9-]{4,}(\.[a-z0-9-]+)*\.[a-z]{2,24}\.?$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.001")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $client_ips = array_distinct($dns.principal.ip)

  condition:
    $dns
}
