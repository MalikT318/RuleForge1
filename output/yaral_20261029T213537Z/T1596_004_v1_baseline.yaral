/*
  MITRE Technique : T1596.004 - CDNs
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:04:30.018630+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_004_CDN_Storage_Enumeration_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source sending HTTP GET/HEAD requests whose URL carries bucket or object-listing query parameters or paths to commonly leaked repository, environment or backup artifacts. These requests are typical of adversaries probing CDN-fronted or CDN-origin content for misconfigurations that expose data not meant to be public."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.004"
    mitre_technique_name = "Search Open Technical Databases: CDNs"
    log_prerequisites = "IDS/IPS or network security appliance logs that record HTTP transactions (inspected or decrypted) and populate network.http.method, target.url, principal.ip and target.hostname."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface management services, partner or application integrations that legitimately use object-listing APIs against public storage, search-engine crawlers, bug-bounty researchers within scope, and sync clients for public buckets."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Tighten the URL regex if legitimate listing APIs are in use. Raise severity for sources seen across multiple target hosts, or pair with a threshold rule on principal.ip."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(GET|HEAD)$/ nocase
    $net.target.url = /([?&](list-type=[0-9]+|prefix=|delimiter=|max-keys=|marker=|versions(&|=|$)|uploads(&|=|$))|\/\.(git|svn|hg|env|aws|ds_store)(\/|$|\?)|\/[^\/?]*(backup|dump|database)[^\/?]*\.(zip|tar|gz|tgz|sql|bak|7z)(\?|$))/ nocase
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1596.004")
    $primary_entity = array_distinct($net.principal.ip)
    $target_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
