/*
  MITRE Technique : T1586 - Compromise Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:40:56.898392+00:00
  Reference       : https://attack.mitre.org/techniques/T1586
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_Scripted_Client_Failed_Login_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source sending a scripted, non-browser HTTP client POST to an authentication endpoint and receiving an authentication failure (401/403). This is the network-side footprint of credential stuffing or password-spraying against externally exposed login portals, a common way to compromise existing accounts before use in later operations. Each event is one failed automated login attempt, so triage should pivot on repeated alerts from the same source."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586"
    mitre_technique_name = "Compromise Accounts"
    log_prerequisites = "Requires perimeter proxy, WAF, reverse-proxy or firewall logs with URL inspection that populate NETWORK_HTTP with method, target.url, response code and user agent. Plain L3/L4 firewall logs without HTTP fields will not trigger this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate API clients and mobile apps using default library user agents with expired credentials or tokens; partner or customer integrations with misconfigured secrets; uptime and synthetic-monitoring probes against login pages; authorised penetration tests."
    tuning_guidance = "Add authorised testing and monitoring source addresses to %global_allowed_scanners. Add trusted management or partner source addresses to %global_allowed_mgmt_sources. Add trusted partner domains to %global_allowed_domains if the target field is populated with partner hostnames. Alert on repeated hits per source IP in SOAR or a downstream threshold rule."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.network.http.response_code >= 401
    $http.network.http.response_code <= 403
    $http.target.url = /\/(login|logon|signin|sign-in|auth|authenticate|session|sso|oauth2?\/token|wp-login)([\/\?\.]|$)/ nocase
    $http.network.http.user_agent = /(python-requests|python-urllib|aiohttp|curl\/|wget\/|go-http-client|okhttp|libwww-perl|java\/|apache-httpclient|node-fetch|axios|^mozilla\/[0-9.]+$|^$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1586")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $targeted_url = array_distinct($http.target.url)
    $targeted_user = array_distinct($http.target.user.userid)
    $user_agent = array_distinct($http.network.http.user_agent)
    $response_code = array_distinct($http.network.http.response_code)

  condition:
    $http
}
