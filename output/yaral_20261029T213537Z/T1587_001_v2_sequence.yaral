/*
  MITRE Technique : T1587.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:48:14.532901+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_001_Executable_Download_Then_Nonstandard_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an internal source that downloads an executable or script payload over HTTP from an external, non-allowlisted host and then, within ten minutes, opens an outbound connection to an external address on a non-standard high port. This is the network-observable result of custom-developed malware (T1587.001) being staged and then calling back over a bespoke C2 protocol. Resource development itself happens off-network, so this rule detects the first footprint of a freshly built implant."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.001"
    mitre_technique_name = "Develop Capabilities: Malware"
    log_prerequisites = "Requires perimeter or proxy logs normalised to NETWORK_HTTP (with target.url and target.hostname populated) and firewall connection logs normalised to NETWORK_CONNECTION (with target.port populated). Both sources must report the internal source address in principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software updaters and installers fetched from vendor sites not yet in the allowed-domain list, developers or build servers downloading packages and then using custom service ports, legitimate applications using non-standard high ports (VoIP, gaming, P2P, VPN), and IT staff retrieving scripts and then testing remote services."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add scanners and authorised testing hosts to %global_allowed_scanners. Add sanctioned build or RMM source addresses to %global_allowed_mgmt_sources. Extend the port exclusions in the connection event to match client-specific sanctioned services, or raise the minimum port threshold."

  events:
    $dl.metadata.event_type = "NETWORK_HTTP"
    $dl.target.url = /\.(exe|dll|scr|msi|ps1|bat|vbs|hta|jar|elf|apk)(\?|$)/ nocase
    not $dl.target.ip in %rfc1918_internal
    not $dl.target.hostname in %global_allowed_domains
    not $dl.principal.ip in %global_allowed_scanners
    not $dl.principal.ip in %global_allowed_mgmt_sources
    $dl.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port >= 1024
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

    $dl.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1587.001")
    $primary_entity = array_distinct($src_ip)
    $download_urls = array_distinct($dl.target.url)
    $download_hosts = array_distinct($dl.target.hostname)
    $egress_ips = array_distinct($net.target.ip)
    $egress_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $dl and $net
}
