/*
  MITRE Technique : T1543.001 - Launch Agent
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:25:47.236075+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_001_Unexpected_Parent_Spawns_Shell_For_LaunchAgent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or shell on macOS spawned by a parent process that should never launch one (Office application, web browser, document viewer, mail client, web server or database service) where the child's activity touches LaunchAgents locations or loads a job via launchctl. This lineage anomaly indicates a Launch Agent persistence being planted by an exploited or weaponised application rather than by an installer, MDM agent or administrator."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.001"
    mitre_technique_name = "Create or Modify System Process: Launch Agent"
    log_prerequisites = "macOS endpoint telemetry that records process launches with both the parent (principal.process) and child (target.process) image paths and full command line."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developer tooling where a Node, Java or PHP service legitimately installs a user agent; browser or Office updaters and installers that run helper shell scripts; web hosting control panels or local dev stacks that register launchd jobs; IT automation launched from an unexpected parent."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, and EDR agents to %global_allowed_security_tools. Extend or narrow the parent-process regex to match the application inventory of each client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(Microsoft Word|Microsoft Excel|Microsoft PowerPoint|Microsoft Outlook|Safari|Google Chrome|firefox|Preview|Mail|Adobe Acrobat|Acrobat Reader|httpd|nginx|php-fpm|apache2|tomcat|java|node|mysqld|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|zsh|dash|ksh|osascript|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(\/LaunchAgents\/|launchctl\s+(load|bootstrap|submit|enable|kickstart))/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1543.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
