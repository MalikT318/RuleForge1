/*
  MITRE Technique : T1585 - Establish Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:34:28.859121+00:00
  Reference       : https://attack.mitre.org/techniques/T1585
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_Outbound_Account_Signup_HTTP_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal client sending an HTTP POST to an external web endpoint whose URL path matches account-registration patterns (signup, register, create account). This is the network-observable footprint of account creation on third-party services, including email providers, social media and code-hosting platforms, that an adversary may use to build personas. Because it is low-fidelity on its own, treat it as a hunting and enrichment signal, especially on hosts that have no business reason to register accounts."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585"
    mitre_technique_name = "Establish Accounts"
    log_prerequisites = "Requires forward proxy or perimeter logs that record the HTTP method and full URL (TLS inspection enabled, or explicit proxy logging). Without URL visibility for HTTPS traffic, the rule cannot evaluate."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees registering for legitimate SaaS trials, webinars, vendor portals or conference sites; marketing and recruiting staff; developers signing up for API or code-hosting services; IT staff registering vendor support accounts; automated QA tests against external signup flows."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Scope or suppress by source host for marketing, HR and developer segments. Raise severity only when combined with other signals, such as repeated signups from one source or signups to free email and social platforms from servers or non-user subnets."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|account\/create)(\/|\?|\.|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1585")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $signup_urls = array_distinct($http.target.url)

  condition:
    $http
}
