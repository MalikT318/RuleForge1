/*
  MITRE Technique : T1598.004 - Spearphishing Voice
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:17:03.786072+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_004_Direct_SIP_Signaling_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client opening a SIP signaling connection (TCP/UDP 5060 or 5061) directly to an external address. Vishing and callback-phishing campaigns can use softphone or VoIP clients on user systems to place calls to targets, or to carry the follow-on voice session. Voice traffic normally goes through a corporate PBX, SBC or approved UC platform, so direct SIP from an ordinary client to the internet is a low-volume anomaly worth review. This is an indirect network signal and is not a definitive indicator of vishing."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.004"
    mitre_technique_name = "Phishing for Information: Spearphishing Voice"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress SIP must traverse the monitored perimeter."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Corporate softphones or UC clients registering directly with a cloud telephony or SIP trunk provider, contact-centre agents, remote workers using VoIP apps, PBX/SBC appliances egressing to carriers, and VoIP-capable conferencing clients."
    tuning_guidance = "Add PBX, SBC and approved UC gateway source addresses to %global_allowed_mgmt_sources. Add known telephony provider domains to %global_allowed_domains. If the tenant legitimately uses cloud telephony from user subnets, raise severity only for hosts outside voice VLANs or scope the rule to those subnets."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 5060 or $net.target.port = 5061)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1598.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
