/*
  MITRE Technique : T1590.005 - IP Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:21:54.161582+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_005_External_Source_Mass_Probing_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source address generates a high volume of connection events seen by the IPS/network security appliance within ten minutes. This is typical of address-space enumeration, where an adversary maps which public IP addresses in the organisation's allocation are live. Each connection is benign on its own; the volume from one source is the signal."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.005"
    mitre_technique_name = "Gather Victim Network Information: IP Addresses"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated. The appliance must sit at the internet-facing perimeter so that external source addresses are visible."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, internet-wide research scanners (benign background noise), search-engine and uptime-monitoring crawlers, CDN or reverse-proxy health checks, large NAT gateways or partner egress addresses that aggregate many legitimate users, and load tests."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Add known partner or management source addresses to %global_allowed_mgmt_sources. Raise the #net threshold (default 100) for high-traffic perimeters, or lower it for small environments. If the appliance logs only blocked traffic, the threshold can be relaxed. Severity and risk_score rise when the source touches administrative service ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 22 or $net.target.port = 23 or $net.target.port = 445 or $net.target.port = 3389 or $net.target.port = 5900, 65, 40))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1590.005")
    $primary_entity = array_distinct($src)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 100
}
