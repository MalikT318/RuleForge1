/*
  MITRE Technique : T1584.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:26:34.579341+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_005_DNS_Botnet_C2_Long_Label_Or_TXT_NULL_Tunnel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries characteristic of botnet command-and-control or DGA/tunnelling traffic: an unusually long, machine-generated-looking subdomain label, or a moderately long label combined with a TXT or NULL record request. Known-good registered domains and queries that resolve to internal address space are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.005"
    mitre_technique_name = "Compromise Infrastructure: Botnet"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated. Answer data (network.dns.answers.data) improves internal-resolution filtering."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-storage hostnames with long generated labels, email security and anti-spam DNSBL lookups, DKIM/SPF TXT lookups with long selectors, security-vendor reputation lookups, software update and telemetry services, mDNS or service-discovery names, and legitimate DNS-based licensing checks."
    tuning_guidance = "Add known-good registered domains to %global_allowed_domains (the rule compares the last two labels of the query name, so add multi-part public suffix domains such as example.co.uk in the form the rule extracts). Raise or lower the label-length thresholds (40 and 25) per client baseline. Internal zones are suppressed when answers resolve to addresses in %rfc1918_internal, so keep that list current."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name != ""
    (
      $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{40,}\./ nocase or
      (
        ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10) and
        $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{25,}\./ nocase
      )
    )
    $registered_domain = re.capture($dns.network.dns.questions.name, "([^.]+\\.[^.]+)\\.?$")
    not $registered_domain in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.005")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $query_types = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
