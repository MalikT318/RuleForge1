/*
  MITRE Technique : T1653 - Power Settings
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:38:07.792996+00:00
  Reference       : https://attack.mitre.org/techniques/T1653
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1653_Unexpected_Parent_Power_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a service process (web server, application server, database, print service) spawning a shell or power-management utility whose command line masks or disables sleep, suspend, hibernate, or shutdown behaviour, or edits logind or idle-action power settings. Service processes do not normally change host power policy, so this lineage points to a web shell, injection, or compromised service account trying to keep the host awake for persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1653"
    mitre_technique_name = "Power Settings"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process launch telemetry populating principal.process.file.full_path (parent), target.process.file.full_path (child), and target.process.command_line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management or provisioning run through a service wrapper (for example a Java-based deployment agent or Node-based tooling), appliance-style products that tune power settings at install time, and administrators using a web-based control panel to change power policy."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. If the generic runtime parents (java, node) are noisy in an environment, add the specific deployment agent to those lists instead of removing the parent from the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9.]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|systemctl|systemd-inhibit|gsettings|dconf|loginctl)$/ nocase
    $proc.target.process.command_line = /(systemctl\s+(mask|disable)\s+.*(sleep|suspend|hibernate|hybrid-sleep)\.target|systemd-inhibit|logind\.conf|Handle(LidSwitch|PowerKey|SuspendKey)|IdleAction|sleep-inactive-(ac|battery)-(type|timeout)|rm\s+.*(shutdown|reboot|poweroff|halt))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1653")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
