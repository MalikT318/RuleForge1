/*
  MITRE Technique : T1647 - Plist File Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:34:14.675143+00:00
  Reference       : https://attack.mitre.org/techniques/T1647
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1647_macOS_Plist_Modified_Persistence_Or_Bundle_Config {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of an existing launchd plist (LaunchAgents or LaunchDaemons) or an application bundle Info.plist by a process that is not a known installer, updater, or approved tool. Adversaries edit these plists to hide app windows (LSUIElement), inject environment variables, or add persistent execution. The rule works on the resulting file-modification artifact, so it fires regardless of how the edit was made (defaults, PlistBuddy, plutil, a script, or a native binary) and is not affected by command-line obfuscation."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1647"
    mitre_technique_name = "Plist File Modification"
    log_prerequisites = "macOS endpoint telemetry that reports file modification events (FILE_MODIFICATION) with the target file path and the acting process path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Software installers and updaters (Sparkle-style auto-updaters, package installers), MDM and configuration management agents, developer IDEs and build tooling re-signing or editing Info.plist, and package managers that update launchd plists."
    tuning_guidance = "Add approved deployment, MDM and updater binaries to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. If developer build hosts are noisy, scope them out in the client's tenant configuration. Extend the system-installer process regex for client-specific updaters."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(\/Library\/(LaunchAgents|LaunchDaemons)\/[^\/]+\.plist$|\.app\/Contents\/Info\.plist$)/ nocase
    not $file.principal.process.file.full_path = /\/(installd|system_installd|softwareupdated|mdmclient|Installer|storedownloadd|appstoreagent|pkd|xpcproxy|launchd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1647")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_plist = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
