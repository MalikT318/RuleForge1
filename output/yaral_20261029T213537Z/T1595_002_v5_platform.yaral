/*
  MITRE Technique : T1595.002 - Vulnerability Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:54:58.290574+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_002_External_Sensitive_Path_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting well-known exposure-discovery paths on a perimeter-facing web service, such as environment files, source-control metadata, server status pages, framework debug endpoints and backup configuration files. Legitimate users never browse to these paths, so a hit is a strong indicator of automated vulnerability and misconfiguration scanning. It does not depend on scanner names, user agents or specific CVE payloads."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.002"
    mitre_technique_name = "Active Scanning: Vulnerability Scanning"
    log_prerequisites = "Requires proxy, reverse proxy, WAF or perimeter firewall logs with URL inspection, normalised to UDM NETWORK_HTTP with principal.ip (client) and target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface-management services not yet allowlisted, penetration tests, uptime or security-posture monitors that request these paths, and search-engine or research crawlers. A developer legitimately exposing one of these paths on an internet-facing host would also trigger it."
    tuning_guidance = "Add authorised external scanner source addresses to %global_allowed_scanners. Add approved partner or management source addresses to %global_allowed_mgmt_sources. To reduce volume, convert the rule to a Threshold rule grouped by source IP, or add a network.http.response_code filter if the client's logs populate it reliably."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(\.env|\.git\/(config|head)|\.svn\/entries|\.aws\/credentials|\.htpasswd|\.ds_store|phpinfo\.php|server-status|server-info|actuator\/(env|heapdump|configprops)|wp-config\.php(\.bak|\.old|~)?|config\.(php|json|yml)\.(bak|old|orig))(\?|#|$)/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1595.002")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $probed_urls = array_distinct($http.target.url)

  condition:
    $http
}
