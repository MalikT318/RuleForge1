/*
  MITRE Technique : T1598.003 - Spearphishing Link
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:15:37.003129+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_003_Obfuscated_URL_Host_Web_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound web requests whose URL uses spearphishing-link obfuscation: embedded userinfo before an @ symbol (text before the @ is discarded by browsers) or a hostname written as a bare decimal or hexadecimal integer. Phishing lures use these quirks to disguise the real destination of credential-harvesting links."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.003"
    mitre_technique_name = "Phishing for Information: Spearphishing Link"
    log_prerequisites = "Requires proxy or firewall web logs normalised to NETWORK_HTTP with target.url populated (URL-aware inspection or TLS decryption for HTTPS). Source IPs should be populated in principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legacy internal or vendor tools that embed credentials in URLs (user:pass@host), automated health checks or API clients that use integer-form addresses, and security awareness or phishing simulation platforms."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Internal destinations are already excluded by %rfc1918_internal. Raise severity or add a corroborating NETWORK_DNS or email event when the source is a high-value user. Suppress noisy sources by adding them to %global_allowed_scanners."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^(https?:\/\/)?([^\/?#]*@|[0-9]{8,10}([:\/?#]|$)|0x[0-9a-f]{6,8}([:\/?#]|$))/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1598.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
