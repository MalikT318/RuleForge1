/*
  MITRE Technique : T1589.001 - Credentials
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:06:40.809958+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_001_Credential_File_Probe_Then_Login_Attempts {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single external source requests files that commonly expose credentials (environment files, VCS credential stores, config backups, key material) and then makes repeated POST requests to authentication endpoints within ten minutes. This pattern indicates credential harvesting followed by testing of the gathered credentials."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.001"
    mitre_technique_name = "Gather Victim Identity Information: Credentials"
    log_prerequisites = "Requires firewall, web proxy, WAF, or reverse-proxy logs normalised to NETWORK_HTTP with target.url, network.http.method and principal.ip populated. Logs must be captured on the external-facing perimeter so that the real client address is visible."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised penetration tests and external attack-surface scanners not yet in the allowlist; uptime or synthetic-login monitors that also touch sensitive paths; security researchers running bug-bounty testing; users behind a shared NAT or proxy address where one host probes and another logs in."
    tuning_guidance = "Add approved scanner and testing source addresses to %global_allowed_scanners. Raise the #auth threshold in the condition for internet-facing login portals with heavy legitimate traffic. If client logs carry reliable response codes, add a network.http.response_code filter to the probe event to focus on successful disclosures."

  events:
    $probe.metadata.event_type = "NETWORK_HTTP"
    $probe.target.url = /\/(\.env|\.git\/config|\.git-credentials|\.aws\/credentials|\.htpasswd|\.npmrc|\.ssh\/id_rsa|id_rsa|wp-config\.php(\.bak|\.old|\.save|~)?|config\.php\.bak|credentials\.json|secrets\.(json|yml|yaml))(\?.*)?$/ nocase
    not $probe.principal.ip in %rfc1918_internal
    not $probe.principal.ip in %global_allowed_scanners
    $probe.principal.ip = $src_ip

    $auth.metadata.event_type = "NETWORK_HTTP"
    $auth.network.http.method = "POST" nocase
    $auth.target.url = /\/(login|signin|sign-in|wp-login\.php|xmlrpc\.php|owa\/auth\.owa|oauth2?\/token|admin\/login|user\/login|api\/(v[0-9]+\/)?(auth|login))(\/|\?|$)/ nocase
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_scanners
    $auth.principal.ip = $src_ip

    $probe.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1589.001")
    $primary_entity = array_distinct($src_ip)
    $probed_urls = array_distinct($probe.target.url)
    $login_urls = array_distinct($auth.target.url)
    $targeted_hosts = array_distinct($auth.target.hostname)
    $probe_count = count($probe.metadata.id)
    $login_attempt_count = count($auth.metadata.id)

  condition:
    $probe and #auth >= 3
}
