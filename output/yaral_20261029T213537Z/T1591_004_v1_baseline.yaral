/*
  MITRE Technique : T1591.004 - Identify Roles
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:31:34.058339+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_004_External_Role_Directory_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source querying a staff, team or directory web resource with role, title or department search parameters that contain senior or privileged job-title keywords. This pattern is consistent with adversaries harvesting organisational roles and key personnel for targeting (T1591.004). Plain browsing of a team page does not match; the query must filter by role or title."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.004"
    mitre_technique_name = "Gather Victim Org Information: Identify Roles"
    log_prerequisites = "IDS/IPS or network security appliance logs that populate HTTP URL inspection (target.url, network.http.method) and principal.ip for traffic to externally exposed web applications."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate job applicants or recruiters using the careers or team search, search-engine crawlers indexing directory pages, partner or customer staff-lookup portals, authorised external vulnerability or attack-surface scanners, and marketing or sales-intelligence tools run on the organisation's behalf."
    tuning_guidance = "Add authorised scanner and attack-surface-monitoring source addresses to %global_allowed_scanners. If a directory path is intentionally public and heavily used, narrow the path regex. Raise severity or promote to a threshold or sequence rule if the same source repeatedly triggers this detection."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\/(staff|employees?|people|team|directory|leadership|management|executives?|org-?chart|our-team|who-we-are|contacts?)([\/?#]|$)/ nocase
    $http.target.url = /[?&](title|job_?title|role|position|department|dept|function)=[^&]*(ceo|cfo|cto|ciso|cio|chief|director|vice|president|administrator|admin|manager|head|finance|payroll|hr|it)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1591.004")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
