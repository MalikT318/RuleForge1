/*
  MITRE Technique : T1690 - Prevent Command History Logging
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:44:55.092680+00:00
  Reference       : https://attack.mitre.org/techniques/T1690
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1690_Linux_Shell_History_Logging_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Linux process launches whose command line disables or neuters shell command history. Covers unsetting HISTFILE, pointing HISTFILE at /dev/null, setting HISTSIZE or HISTFILESIZE to 0, turning off history with 'set +o history', setting HISTCONTROL to ignorespace/ignoreboth, and symlinking a history file to /dev/null. Adversaries use these to hide interactive activity on a compromised host."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1690"
    mitre_technique_name = "Prevent Command History Logging"
    log_prerequisites = "Requires Linux endpoint process telemetry (EDR or auditd EXECVE/SYSCALL records) with full command-line capture, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admins or provisioning scripts (Ansible, cloud-init, image builds) that intentionally disable history for secrecy hygiene when handling credentials; hardening or CIS baseline scripts; containers or CI runners that set HISTFILE=/dev/null; users who set HISTCONTROL=ignorespace in ad-hoc shells; automation wrappers that run 'bash -c' with history disabled."
    tuning_guidance = "Add approved configuration-management or provisioning parent binaries to %global_allowed_admin_tools, trusted build/automation hosts or parent shells to %global_allowed_script_hosts, and named administrators to %global_allowed_admin_users. Service accounts that legitimately run these commands go in %global_allowed_service_accounts. If HISTCONTROL noise is high, remove the ignorespace/ignoreboth branch."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\bunset\s+(-v\s+)?HISTFILE\b|\bHISTFILE=(\/dev\/null|\s|;|$)|\bHIST(FILE)?SIZE=0\b|\bset\s+\+o\s+history\b|\bHISTCONTROL=\S*ignore(space|both)|\bln\s+-\S+\s+\/dev\/null\s+\S*(bash_history|zsh_history|sh_history|\.history))/ nocase
    not $proc.target.process.file.full_path = /\/(grep|egrep|fgrep|rg|ag|cat|less|more|man|vi|vim|nano|diff|auditctl|ausearch)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1690")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
