/*
  MITRE Technique : T1598 - Phishing for Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:10:24.628877+00:00
  Reference       : https://attack.mitre.org/techniques/T1598
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_Credential_Lure_DNS_Then_External_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a internal client resolving a credential-lure style hostname (login, verify, secure, account, and similar keywords joined by hyphens or dots) and then submitting an HTTP POST to a similarly named external host within ten minutes. This sequence is consistent with a user following a phishing link and submitting information to a harvesting page."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598"
    mitre_technique_name = "Phishing for Information"
    log_prerequisites = "Requires perimeter or proxy telemetry normalised to UDM NETWORK_DNS (with client principal.ip and DNS question names) and NETWORK_HTTP (with method, target.hostname, and client principal.ip). HTTP POST visibility to external hosts requires TLS inspection or a forward proxy; without it NETWORK_HTTP events will not be populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS login portals and SSO providers not yet in the allowlist, vendor customer-portal logins on hyphenated or keyword-style hostnames, password manager and MFA services, and security awareness phishing simulations."
    tuning_guidance = "Add known-good external login and SSO domains to %global_allowed_domains. Add vulnerability scanners and phishing simulation source addresses to %global_allowed_scanners. Narrow or widen the keyword regex per client. If DNS is resolved by an internal forwarder, the DNS principal.ip will be the resolver rather than the client; in that case rely on the HTTP-only variant or adjust the join."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(login|signin|sign-in|verify|secure|account|password|webmail|sso)[-.]|[-.](login|signin|sign-in|verify|secure|account|password|webmail|sso)/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $client_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.hostname = /(login|signin|sign-in|verify|secure|account|password|webmail|sso)[-.]|[-.](login|signin|sign-in|verify|secure|account|password|webmail|sso)/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $client_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $client_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598")
    $primary_entity = array_distinct($client_ip)
    $lure_domains = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $post_count = count($http.metadata.id)

  condition:
    $dns and $http
}
