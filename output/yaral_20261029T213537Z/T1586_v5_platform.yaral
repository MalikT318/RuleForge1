/*
  MITRE Technique : T1586 - Compromise Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:41:15.568307+00:00
  Reference       : https://attack.mitre.org/techniques/T1586
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_External_Scripted_Failed_Login_Against_Auth_Endpoint {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external, non-internal source sending a POST to an authentication endpoint using a scripted HTTP client and receiving a 401 or 403 rejection. This is the network-observable footprint of credential stuffing or password-reuse attempts, which adversaries use to compromise existing accounts before using them in later operations. It is intended as a per-event lead for analyst triage and is meant to be paired with a volume-based variant."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586"
    mitre_technique_name = "Compromise Accounts"
    log_prerequisites = "Requires perimeter proxy, WAF or firewall HTTP logs that populate the request URL, HTTP method, response code and user agent. TLS inspection or termination at the perimeter is needed to see these fields for HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate mobile apps or API integrations that use scripted HTTP libraries and have expired or mistyped credentials. Partner or SaaS integrations with rotated secrets. Uptime and synthetic-monitoring probes against login pages. Authorised penetration tests not yet listed as scanners."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add monitored login URL patterns by narrowing the target.url regex to the client's authentication paths. Alert on volume by pairing this rule with a threshold variant grouped by source IP. Scripted clients that spoof browser user agents will not match, so rely on the threshold variant for those."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /(login|logon|signin|sign-in|auth|oauth|token|session|sso|owa|account)/ nocase
    ($net.network.http.response_code = 401 or $net.network.http.response_code = 403)
    $net.network.http.user_agent = /(python-requests|python-urllib|aiohttp|curl\/|wget\/|go-http-client|okhttp|libwww-perl|java\/|apache-httpclient|node-fetch|axios|httpx|scrapy|powershell)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1586")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
