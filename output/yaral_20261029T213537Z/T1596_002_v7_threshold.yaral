/*
  MITRE Technique : T1596.002 - WHOIS
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:02:09.820557+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_002_Excessive_WHOIS_Port43_Queries {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Low"
    description = "A single internal host opens many outbound TCP connections to the WHOIS service port (43) in a short window. One lookup is benign, but a burst suggests automated WHOIS harvesting of domain, IP block and contact data for targeting. The same pattern can come from a compromised host or a tool run by an adversary with a foothold."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.002"
    mitre_technique_name = "Search Open Technical Databases: WHOIS"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection or flow logs, normalized to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Domain registrars and brand-protection teams, abuse and SOC analysts running bulk WHOIS lookups, mail gateways or anti-spam systems doing registration-data checks, approved scanners and OSINT tooling, network inventory scripts."
    tuning_guidance = "Add approved scanner and OSINT hosts to %global_allowed_scanners. Raise the #net threshold if a client has a team that runs legitimate bulk WHOIS lookups. Lower the threshold only for clients with no business need for WHOIS. Note that most hosts have no reason to use port 43 at all, so any hit is worth reviewing."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 43
    $net.principal.hostname = $host
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(45)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1596.002")
    $primary_entity = array_distinct($host)
    $whois_server_ips = array_distinct($net.target.ip)

  condition:
    #net >= 10
}
