/*
  MITRE Technique : T1037.005 - Startup Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:57:51.159596+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_005_MacOS_StartupItems_Burst_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple files created under /Library/StartupItems on a single macOS host within 10 minutes. A startup item is a directory holding an executable and a StartupParameters.plist, so two or more creations in the window indicate a startup item being registered for boot-time persistence as root. StartupItems is deprecated and rarely used by modern software, so any burst there is suspicious. The risk score is raised when a StartupParameters.plist is among the created files."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.005"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Startup Items"
    log_prerequisites = "macOS endpoint telemetry that reports FILE_CREATION events with the target file path and the creating (principal) process path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy third-party installers that still deploy StartupItems, IT packaging or deployment runs that install old agents, and admins deliberately maintaining legacy boot items."
    tuning_guidance = "Add approved deployment or packaging binaries to %global_allowed_admin_tools, and trusted agents to %global_allowed_security_tools. Add named admin accounts that legitimately install legacy software to %global_allowed_admin_users. Raise the #file threshold if legacy installers are common in a client estate."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/StartupItems\/./ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path = /\/(installer|system_installd|softwareupdated)$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /StartupParameters\.plist$/ nocase, 90, 75))
    $mitre_technique_id = array_distinct("T1037.005")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $created_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 2
}
