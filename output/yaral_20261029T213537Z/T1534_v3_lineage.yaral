/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:24:03.652122+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_Linux_Mail_Or_Webmail_Parent_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a mail transfer/delivery agent, mail filter, or desktop mail client spawning a shell or script interpreter whose command line shows payload staging or remote-execution behaviour (download, reverse shell, encoded payload, inline interpreter code, staging from world-writable directories). A mail-handling process spawning an interpreter in this way is a strong lineage anomaly consistent with a compromised internal mail path being used to deliver or distribute internal spearphishing content."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with populated parent process path, child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Postfix local/pipe delivery or procmail/maildrop recipes invoking shell or script filters, Exim transports that pipe to scripts, Dovecot sieve extprograms, amavis/MIMEDefang filters calling helper scripts, mailing-list managers, and administrators testing mail pipelines."
    tuning_guidance = "Add approved mail-filter or delivery parent binaries to %global_allowed_script_hosts and approved admin tooling to %global_allowed_admin_tools. Exclude known service accounts via %global_allowed_service_accounts. Tighten or widen the command-line regex per client mail stack."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(\/(sendmail|exim4?|dovecot|dovecot-lda|procmail|maildrop|amavisd|mimedefang|thunderbird|evolution|geary)|\/postfix\/(sbin\/)?(master|local|pipe|smtpd|pickup))$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\bcurl\b|\bwget\b|\/dev\/(tcp|udp)\/|\bnc(at)?\s|\bmkfifo\b|base64\s+(-d|--decode)|\b(python[0-9.]*|perl|ruby|php)\s+-[ce]\s|\bchmod\s+\+?[0-7x]+\s+\/(tmp|var\/tmp|dev\/shm)|\/(tmp|var\/tmp|dev\/shm)\/[^\s]+)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
