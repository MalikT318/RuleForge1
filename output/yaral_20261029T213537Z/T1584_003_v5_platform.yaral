/*
  MITRE Technique : T1584.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:22:42.539974+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_003_Raw_IP_HTTP_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP(S) request to an external host addressed by a bare IPv4 literal in the URL instead of a domain name. Infrastructure built on compromised third-party VPS instances is commonly reached by raw IP, because the adversary has no registered domain or reputation history for it. This is a network-observable proxy for use of compromised VPS infrastructure and is a low-fidelity hunting lead."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.003"
    mitre_technique_name = "Compromise Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires perimeter proxy or firewall logs with URL-level visibility (NETWORK_HTTP) that populate target.url and target.ip. TLS inspection is needed to see URLs for HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software updaters and installers that fetch from raw IPs, IoT and appliance health checks, captive portal and connectivity checks, developer tooling and internal test scripts, vulnerability scanners and monitoring probes, CDN or cloud-metadata style endpoints addressed by IP."
    tuning_guidance = "Add scanner and probe sources to %global_allowed_scanners by hostname. Add known-good destinations to %global_allowed_domains where the proxy populates target.hostname. Raise severity or require a non-standard port (target.port not 80 or 443) when volume is high. Pair with threat-intel or ASN enrichment of the destination downstream."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /^https?:\/\/[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]{1,5})?(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.hostname in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1584.003")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_urls = array_distinct($http.target.url)

  condition:
    $http
}
