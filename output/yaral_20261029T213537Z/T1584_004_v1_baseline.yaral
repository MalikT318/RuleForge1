/*
  MITRE Technique : T1584.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:23:28.570989+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_004_Outbound_Direct_SMTP_From_Internal_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound SMTP (TCP/25) connection to an external address. A compromised server that is repurposed as adversary infrastructure, such as a mail relay for phishing or spam, produces this firewall-visible egress. Third-party server compromise cannot be observed directly, so this rule detects the network behavior of the resulting abuse."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.004"
    mitre_technique_name = "Compromise Infrastructure: Server"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalized to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, and covering egress traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate corporate mail gateways and relays, marketing or transactional mail platforms, applications sending directly to external MX hosts, and security appliances that send alert email."
    tuning_guidance = "Add the IP addresses of approved mail relays and gateways to %global_allowed_mgmt_sources. Most clients need this once at onboarding. To widen coverage to submission ports such as 465 and 587, duplicate the rule with those ports. Raise severity when the source is an internet-facing server."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 25
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)

  condition:
    $net
}
