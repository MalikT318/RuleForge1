/*
  MITRE Technique : T1547.007 - Re-opened Applications
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:44:41.866289+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_007_Loginwindow_ReopenApps_Plist_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of a per-user com.apple.loginwindow.<UUID>.plist in a ByHost preferences directory by a process other than the login window itself. This plist lists the applications macOS relaunches at the next login when 'Reopen windows when logging back in' is enabled. Adding an application path to it gives an adversary persistence at user login. The rule works from the file state change, so it still fires when command-line logging is evaded or the tool is renamed."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.007"
    mitre_technique_name = "Boot or Logon Autostart Execution: Re-opened Applications"
    log_prerequisites = "macOS endpoint telemetry that reports file modification events with the acting process path and the full target file path, including paths under /Users/*/Library/Preferences/ByHost."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "The normal logout, restart or shutdown flow writes this plist (loginwindow, or cfprefsd acting on its behalf). Managed-Mac tooling that resets user login preferences, user-profile migration or restore tools, and backup or imaging software restoring ByHost preferences can also trigger it."
    tuning_guidance = "Add approved MDM, deployment and migration tooling to %global_allowed_admin_tools and EDR or backup agents to %global_allowed_security_tools. cfprefsd is deliberately not excluded because it performs the write for 'defaults write' and similar preference APIs, so excluding it would blind the rule to that method. If logout noise from cfprefsd is high in a client environment, scope an exclusion to that client only. Alert on the combination of a non-loginwindow writer and an interactive user context."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/(Users\/[^\/]+|var\/root)\/Library\/Preferences\/ByHost\/com\.apple\.loginwindow\.[0-9a-f\-]+\.plist$/ nocase
    not $file.principal.process.file.full_path = /\/loginwindow$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1547.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_plist = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
