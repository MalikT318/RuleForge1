/*
  MITRE Technique : T1070.010 - Relocate Malware
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:04:48.284356+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_010_Network_Device_Cleartext_File_Transfer_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects perimeter-observed TFTP or FTP control connections between an internal source and an external destination. Network devices and other infrastructure have no endpoint telemetry, and adversaries commonly stage, copy and relocate payloads (for example into device flash or alternate storage) using these cleartext file-transfer protocols. This is a network-side view of payload relocation and staging. It complements process-creation rules and does not depend on any process or command-line field. The rule observes the transfer channel only, not the file name or content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.010"
    mitre_technique_name = "Indicator Removal: Relocate Malware"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated. Egress traffic must be logged, including management-plane traffic from network devices."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate firmware or configuration pulls and pushes from vendor or ISP TFTP/FTP servers, automated configuration backup jobs run by network teams, legacy partner file exchanges over FTP, and lab or provisioning activity such as PXE or zero-touch deployment."
    tuning_guidance = "Add authorised management and backup source addresses to %global_allowed_mgmt_sources. Add known-good vendor or update domains to %global_allowed_domains. Review %rfc1918_internal so that internal address space is fully covered. If FTP is widely used for business purposes, restrict the rule to TFTP only by removing the port 21 condition."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 21)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1070.010")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
