/*
  MITRE Technique : T1587.004 - Exploits
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:52:50.831136+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_004_External_Fuzzing_Errors_Then_Success {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects the perimeter-observable result of exploit development and testing against an exposed service: one external source triggers a burst of HTTP 5xx server errors on a destination (a typical fuzzing or crash-probing pattern) and then gets a successful 200 response from the same destination within the window. The rule cannot see exploit development on adversary infrastructure. It flags probable exploit testing against the client's own perimeter, which is the only observable stage of T1587.004."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.004"
    mitre_technique_name = "Develop Capabilities: Exploits"
    log_prerequisites = "Requires perimeter proxy, WAF or firewall HTTP-inspection logs normalised to UDM NETWORK_HTTP with principal.ip, target.ip and network.http.response_code populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised penetration tests and vulnerability scans, load or QA testing from external partners, a misbehaving client hitting a failing backend (the 5xx errors then come from an application outage), and search-engine or monitoring crawlers."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners. Raise or lower the #err threshold per client traffic profile. Add known partner sources to %global_allowed_mgmt_sources. If an outage causes alerts, exclude that destination for the duration."

  events:
    $err.metadata.event_type = "NETWORK_HTTP"
    $err.network.http.response_code >= 500
    $err.network.http.response_code < 600
    not $err.principal.ip in %rfc1918_internal
    not $err.principal.ip in %global_allowed_scanners
    $err.principal.ip = $src
    $err.target.ip = $dst

    $ok.metadata.event_type = "NETWORK_HTTP"
    $ok.network.http.response_code = 200
    not $ok.principal.ip in %rfc1918_internal
    not $ok.principal.ip in %global_allowed_scanners
    $ok.principal.ip = $src
    $ok.target.ip = $dst

    $err.metadata.event_timestamp.seconds <= $ok.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1587.004")
    $primary_entity = array_distinct($src)
    $targeted_ips = array_distinct($dst)
    $error_count = count($err.metadata.id)
    $success_count = count($ok.metadata.id)
    $http_methods = array_distinct($err.network.http.method)
    $first_error_time = min($err.metadata.event_timestamp.seconds)
    $last_success_time = max($ok.metadata.event_timestamp.seconds)

  condition:
    #err >= 10 and $ok
}
