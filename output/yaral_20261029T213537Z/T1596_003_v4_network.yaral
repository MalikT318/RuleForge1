/*
  MITRE Technique : T1596.003 - Digital Certificates
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:03:10.421189+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_003_External_TLS_Certificate_Recon_IPS_Verdict {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source flagged by an IDS/IPS signature or verdict that describes TLS/SSL certificate enumeration, harvesting, or fingerprinting against an internet-facing asset. Certificate data is public, so this is early-stage reconnaissance (T1596.003) and mainly helps with threat hunting and attack-surface awareness. The rule keys on the verdict text rather than the action taken, because vendor mapping of security_result.action is inconsistent."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.003"
    mitre_technique_name = "Search Open Technical Databases: Digital Certificates"
    log_prerequisites = "IDS/IPS or network security appliance events normalised to UDM NETWORK_CONNECTION with security_result.rule_name or security_result.description populated from the signature name. The sensor must see traffic to external-facing TLS services."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability or attack-surface scanners not yet listed, internet-wide research scanners, search-engine and certificate-transparency crawlers, partner or customer TLS health checks, and SSL monitoring or uptime services."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners. If the sensor emits verdict text in another field, adjust the regex to match your signature naming. Because certificate data is public, treat this as low-fidelity and enrich or correlate with follow-on activity (active scanning, auth attempts) before escalating. Raise the risk score only when the same source also appears in other recon or exploit signatures."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.rule_name = /(ssl|tls|x\.?509|certificate|cert)[^a-z0-9]{0,3}.{0,40}(scan|enum|probe|recon|harvest|fingerprint|grab|discovery|sweep)/ nocase or
      $net.security_result.rule_name = /(scan|enum|probe|recon|harvest|fingerprint|grab|discovery|sweep).{0,40}(ssl|tls|x\.?509|certificate|cert)/ nocase or
      $net.security_result.description = /(ssl|tls|x\.?509|certificate|cert)[^a-z0-9]{0,3}.{0,40}(scan|enum|probe|recon|harvest|fingerprint|grab|discovery|sweep)/ nocase or
      $net.security_result.description = /(scan|enum|probe|recon|harvest|fingerprint|grab|discovery|sweep).{0,40}(ssl|tls|x\.?509|certificate|cert)/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596.003")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
