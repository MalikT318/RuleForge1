/*
  MITRE Technique : T1548.006 - TCC Manipulation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:34:48.381313+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_006_TCC_Database_Modified_By_NonTccd {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the macOS TCC (Transparency, Consent, and Control) database, including its SQLite journal and WAL sidecar files, by a process other than the TCC daemon or approved management tooling. Direct writes to TCC.db are a state-change artifact of TCC manipulation, where an adversary grants itself Full Disk Access, screen recording, accessibility or other protected permissions without a user prompt. This works at the file-artifact layer and does not depend on command-line logging."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.006"
    mitre_technique_name = "Abuse Elevation Control Mechanism: TCC Manipulation"
    log_prerequisites = "macOS endpoint telemetry that reports file modification events with the acting (principal) process path, covering /Library/Application Support/com.apple.TCC and /Users/*/Library/Application Support/com.apple.TCC."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM agents applying privacy preference policy payloads, endpoint security or backup agents that are being provisioned with Full Disk Access, OS upgrades and migration or restore assistants, and IT automation that legitimately seeds TCC entries during device enrollment. With SIP enabled, direct writes to the system TCC.db by arbitrary processes are rare, so most hits are worth review."
    tuning_guidance = "Add approved MDM and deployment binaries to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. If the telemetry does not populate principal.process.file.full_path for some sensors, review those events manually before adding exclusions. Do not exclude by directory; exclude by executable name or list."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/Library\/Application Support\/com\.apple\.TCC\/TCC\.db(-journal|-wal|-shm)?$/ nocase
    not $file.principal.process.file.full_path = /\/(tccd|mdmclient)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $acting_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
