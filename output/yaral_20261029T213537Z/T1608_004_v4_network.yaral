/*
  MITRE Technique : T1608.004 - Drive-by Target
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:27:11.585974+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_004_Drive_By_Payload_From_Direct_IP_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a browser-originated HTTP request that successfully retrieves script, exploit-delivery or executable content (js, hta, jar, swf, xap, exe, dll, msi, ps1, vbs, lnk) from an external server addressed by raw IPv4 address instead of a domain name. Staged drive-by content is often served from freshly acquired or compromised hosts without DNS names. This is the network-side view of a user landing on drive-by infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.004"
    mitre_technique_name = "Stage Capabilities: Drive-by Target"
    log_prerequisites = "Requires perimeter or proxy HTTP logs that populate network.http.method, network.http.response_code, network.http.user_agent and target.url (forward-proxy or TLS-inspecting firewall). Encrypted traffic without inspection will not expose the URL."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software or firmware updates fetched directly from IP-addressed vendor or CDN nodes, internal-lab or staging servers reached through NAT or public addressing, IoT or appliance management portals, authorised red-team or breach-and-attack simulation, and security scanners fetching test content."
    tuning_guidance = "Add known-good vendor or CDN domains to %global_allowed_domains and authorised scanner or test sources to %global_allowed_scanners. If the proxy does not log browser user agents, remove the user_agent condition. Extend or narrow the extension list to match client web-filtering policy."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.response_code = 200
    $net.network.http.user_agent = /mozilla/ nocase
    $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\/[^?#]*\.(js|hta|jar|swf|xap|exe|dll|msi|ps1|vbs|lnk)([?#]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
