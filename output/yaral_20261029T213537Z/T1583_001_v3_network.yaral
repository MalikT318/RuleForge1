/*
  MITRE Technique : T1583.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:59:08.834895+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_001_Punycode_IDN_Domain_DNS_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for internationalized domain names encoded as punycode (xn-- labels), the form used in IDN homograph lookalike domains that adversaries acquire for phishing, drive-by delivery and C2. Queries for known-good domains and queries that resolve to internal address space are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.001"
    mitre_technique_name = "Acquire Infrastructure: Domains"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS with network.dns.questions.name populated. Answer data (network.dns.answers.data) improves internal-zone exclusion but is not required."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate internationalized domains used by international business partners, non-Latin-script websites and email domains, browsers prefetching IDN links, and security tooling resolving suspicious domains for analysis."
    tuning_guidance = "Add legitimate IDN domains to %global_allowed_domains. Internal zones that resolve to private addresses are already excluded through %rfc1918_internal. Raise severity or add a threshold variant for hosts querying many distinct punycode domains. Pivot on matched domains with a registration-age or reputation lookup in the SOAR playbook."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)xn--[a-z0-9-]{2,}(\.|$)/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.001")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
