/*
  MITRE Technique : T1033 - System Owner/User Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:52:42.417381+00:00
  Reference       : https://attack.mitre.org/techniques/T1033
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1033_Linux_Service_Parent_Spawns_User_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a user or session discovery utility (whoami, id, w, who, users, last and similar) launched directly by a web server, application server, or database service process. These services do not normally enumerate the logged-in user, so this lineage is a strong indicator of web shell activity, command injection, or SQL-to-OS command execution. It pivots on parent-child lineage and does not depend on command-line content."
    mitre_tactic = "Discovery"
    mitre_technique = "T1033"
    mitre_technique_name = "System Owner/User Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH, with parent (principal.process) and child (target.process) executable paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legacy CGI or PHP admin panels that call id or whoami to check the runtime account; application health-check or deployment scripts run by the web server user; database maintenance jobs that use shell-outs (for example PostgreSQL COPY PROGRAM in approved ETL); monitoring plugins running under the service account."
    tuning_guidance = "Add approved parent processes or hosts to %global_allowed_script_hosts and sanctioned tooling to %global_allowed_admin_tools. If a specific application legitimately calls id or whoami, allowlist its parent binary rather than widening the child regex. Extend the parent regex with local service names (for example custom application runtimes) if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|gunicorn|uwsgi|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(whoami|id|w|who|users|logname|last|lastlog|finger|pinky)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1033")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
