/*
  MITRE Technique : T1596 - Search Open Technical Databases
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:58:13.733512+00:00
  Reference       : https://attack.mitre.org/techniques/T1596
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_External_Service_Probe_Then_Fingerprint_Http {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects the perimeter footprint of internet-wide technical-database collection (Shodan/Censys-style data gathering). One external source connects to common exposed service ports and then, within ten minutes, sends HTTP fingerprinting requests (favicon, robots.txt, well-known paths, server-status or similar) to the same perimeter. Open-database searching is passive and invisible to the victim. This rule therefore detects the active scanning that populates such databases, or an adversary validating a database result, and not the lookup itself."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596"
    mitre_technique_name = "Search Open Technical Databases"
    log_prerequisites = "Requires IPS/network security appliance telemetry normalised to UDM NETWORK_CONNECTION (with principal.ip, target.ip, target.port) and NETWORK_HTTP (with principal.ip, target.url, network.http.method). Sensor must sit on the internet-facing perimeter so that external source IPs are visible."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability or attack-surface scanners, uptime and availability monitors, search-engine and web crawlers, CDN or WAF health checks, SEO tools, partner integrations that legitimately request favicon, robots.txt or well-known paths."
    tuning_guidance = "Add authorised external scanner and monitoring source IPs to %global_allowed_scanners. Narrow the target port list or URL regex to the client's exposed services. If volume is high, add a perimeter-asset restriction on target.hostname in a client-specific copy of the rule."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
      $conn.target.port = 21 or
      $conn.target.port = 22 or
      $conn.target.port = 23 or
      $conn.target.port = 25 or
      $conn.target.port = 80 or
      $conn.target.port = 443 or
      $conn.target.port = 445 or
      $conn.target.port = 3389 or
      $conn.target.port = 8080 or
      $conn.target.port = 8443
    )
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    $conn.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\/(favicon\.ico|robots\.txt|sitemap\.xml|\.well-known\/[^\/]*|server-status|server-info|manager\/html|owa\/auth\/logon\.aspx)(\?.*)?$/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1596")
    $primary_entity = array_distinct($src_ip)
    $distinct_ports_probed = count_distinct($conn.target.port)
    $probed_ports = array_distinct($conn.target.port)
    $targeted_ips = array_distinct($conn.target.ip)
    $fingerprint_urls = array_distinct($http.target.url)

  condition:
    $conn and $http
}
