/*
  MITRE Technique : T1583.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:04:54.639588+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_004_Proxy_HTTP_Direct_To_IP_Literal_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP/HTTPS request through a proxy or perimeter device to an external server addressed by a raw IP literal in the URL instead of a domain name. Adversary-operated servers (T1583.004) used for staging payloads, phishing kits or C2 are frequently reached by bare IP because no domain was registered or resolved. Internal destinations are excluded through a reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.004"
    mitre_technique_name = "Acquire Infrastructure: Server"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP URL inspection (explicit proxy, SSL inspection, or URL-aware firewall) normalised to NETWORK_HTTP with target.url populated. Plain L3/L4 firewall logs without URL data will not trigger this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software updaters or appliances that call vendor servers by IP, IoT and OT devices, captive-portal or connectivity checks, load-balancer and monitoring health checks, internal tools reaching public cloud instances by IP, and authorised security testing."
    tuning_guidance = "Add authorised scanning or testing sources to %global_allowed_scanners, add known-good vendor or CDN names to %global_allowed_domains, and confirm %rfc1918_internal covers all private ranges. If device update traffic is noisy, filter by principal.hostname for that device class. Consider raising severity when the same source repeats requests to multiple distinct IP-literal destinations."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /^(?i)(https?:\/\/)?([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]{1,5})?(\/|$|\?)/
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.004")
    $primary_entity = array_distinct(strings.coalesce($http.principal.hostname, $http.principal.ip))
    $destination_ips = array_distinct($http.target.ip)
    $destination_urls = array_distinct($http.target.url)
    $destination_ports = array_distinct($http.target.port)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
