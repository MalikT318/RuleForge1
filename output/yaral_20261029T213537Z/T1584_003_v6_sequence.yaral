/*
  MITRE Technique : T1584.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:23:01.836058+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_003_DNS_Resolved_Host_Then_NonStandard_Port_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An internal host resolves a domain that is not in the known-good list, then within 10 minutes connects to the exact external IP returned in that DNS answer on a non-standard high port. This is a network-observable pattern of staging or command-and-control traffic to adversary-controlled infrastructure on a compromised third-party VPS. The rule cannot confirm that a VPS is compromised. It surfaces the resolve-then-connect-on-odd-port behaviour for analyst review."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.003"
    mitre_technique_name = "Compromise Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires perimeter or firewall telemetry with both DNS query/answer logging (NETWORK_DNS with answers populated) and connection logging (NETWORK_CONNECTION) that carry a consistent internal source IP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Video conferencing and VoIP clients using high UDP/TCP ports, peer-to-peer or game traffic, vendor SaaS agents using custom ports, developer and testing traffic to cloud-hosted services, and NAT or DNS-proxy setups where the source IP is the resolver rather than the client."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Add approved internal sources to %global_allowed_mgmt_sources. Extend the excluded port list for business applications that legitimately use high ports. If DNS answers are not populated by the firewall parser, the join will not fire and the rule should be disabled for that client."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.response_code = 0
    $dns.network.dns.answers.data = $dest_ip
    $dns.principal.ip = $src_ip
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_mgmt_sources

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.ip = $dest_ip
    $net.principal.ip = $src_ip
    $net.target.port >= 1024
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip, $dest_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.003")
    $primary_entity = array_distinct($src_ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $destination_ips = array_distinct($dest_ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $dns and $net
}
