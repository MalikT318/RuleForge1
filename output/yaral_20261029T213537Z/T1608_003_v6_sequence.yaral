/*
  MITRE Technique : T1608.003 - Install Digital Certificate
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:25:50.120000+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_003_ACME_Validation_Then_Nonstandard_TLS_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a protected external-facing server receiving an ACME certificate-validation HTTP request (/.well-known/acme-challenge/) and, within 10 minutes, an external connection to the same server on a non-standard TLS port. This pattern fits an adversary installing a new TLS certificate on freshly staged infrastructure (T1608.003) before using it for C2 or credential-harvesting."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.003"
    mitre_technique_name = "Stage Capabilities: Install Digital Certificate"
    log_prerequisites = "Requires perimeter firewall, proxy or WAF telemetry normalised to UDM NETWORK_HTTP (with target.url populated) and NETWORK_CONNECTION (with target.port populated), covering inbound traffic to externally exposed servers."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate automated certificate issuance and renewal (ACME clients) on servers that also expose admin or application consoles on alternate TLS ports such as 8443 or 10443; hosting control panels; authorised scanners probing alternate ports; newly deployed internal services."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners, approved management source addresses to %global_allowed_mgmt_sources, and known-good hostnames to %global_allowed_domains. If a client legitimately exposes services on alternate TLS ports, adjust the port list in the $net block."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/\.well-known\/acme-challenge\// nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.target.ip = $dest

    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 8443 or
      $net.target.port = 4443 or
      $net.target.port = 9443 or
      $net.target.port = 10443 or
      $net.target.port = 2083 or
      $net.target.port = 2087
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.target.ip = $dest

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $dest over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1608.003")
    $primary_entity = array_distinct($dest)
    $acme_urls = array_distinct($http.target.url)
    $tls_ports = array_distinct($net.target.port)
    $connecting_sources = array_distinct($net.principal.ip)
    $connection_count = count($net.metadata.id)

  condition:
    $http and $net
}
