/*
  MITRE Technique : T1553.001 - Gatekeeper Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:39:11.825248+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_001_macOS_Gatekeeper_Bypass_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects removal of the com.apple.quarantine extended attribute, or disabling of Gatekeeper assessment through spctl, by a process launched from an unexpected parent. The parents covered are Microsoft Office applications, Mail, web server processes, database services and the print spooler. These parents should never need to strip quarantine flags or change Gatekeeper policy, and when they do it usually indicates a macro, webshell or exploited service staging an untrusted payload."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.001"
    mitre_technique_name = "Subvert Trust Controls: Gatekeeper Bypass"
    log_prerequisites = "macOS endpoint telemetry (EDR or unified log) providing PROCESS_LAUNCH events with parent process path, child process path and full command line."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Office add-ins or macros from legitimate software installers that clear quarantine on bundled helpers; web or CI servers on developer Macs running xattr -cr on build artefacts; managed deployment scripts launched from a service parent; IT automation that clears quarantine on internally distributed packages."
    tuning_guidance = "Add approved deployment and management tooling parent paths to %global_allowed_admin_tools and EDR/security agent paths to %global_allowed_security_tools. Developer fleets can remove web server or database parents from the parent regex, or exclude by host using the allowlists. Review the command_line and parent_process outcome values before triage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(\/Microsoft (Word|Excel|PowerPoint|Outlook|OneNote)\.app\/Contents\/MacOS\/|\/Mail\.app\/Contents\/MacOS\/Mail$|\/(httpd|nginx|php-fpm|php-cgi|mysqld|mariadbd|postgres|cupsd)$)/ nocase
    $proc.target.process.file.full_path = /\/(xattr|spctl|sh|bash|zsh|osascript|python3?|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(xattr\s+(-[a-z]+\s+)*-[a-z]*[dc][a-z]*\s.*(com\.apple\.quarantine|\S+)|spctl\s+.*(--master-disable|--global-disable))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
