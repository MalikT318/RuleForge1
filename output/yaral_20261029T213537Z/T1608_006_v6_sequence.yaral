/*
  MITRE Technique : T1608.006 - SEO Poisoning
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:31:41.760178+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_006_Search_Referral_Then_Payload_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a client landing on an external site via a search-engine results referral and then downloading an executable, installer, script or archive from the same destination host within 10 minutes. This is the network-observable result of SEO-poisoned lures leading to payload delivery (drive-by or fake software download)."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.006"
    mitre_technique_name = "Stage Capabilities: SEO Poisoning"
    log_prerequisites = "Requires forward or transparent proxy, or firewall with URL inspection, producing NETWORK_HTTP events with target.url, target.hostname and network.http.referral_url populated. HTTPS inspection is needed for visibility into encrypted traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users legitimately searching for and downloading software from vendor or open-source sites not yet in the allowlist, IT staff downloading installers or ISOs, developers fetching release archives after a web search, and software vendors that use search-style query parameters in their own download pages."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Internal destinations are already excluded via %rfc1918_internal. Narrow the file-extension list or add more query-parameter names to match the proxy's referrer behaviour. Consider raising severity for unmanaged or high-risk user groups."

  events:
    $search.metadata.event_type = "NETWORK_HTTP"
    $search.network.http.referral_url = /[?&](q|query|search_query|keyword|keywords|searchterm)=/ nocase
    $search.target.hostname != ""
    not $search.target.hostname in %global_allowed_domains
    not $search.target.ip in %rfc1918_internal
    $search.principal.ip = $src_ip
    $search.target.hostname = $dest_host

    $dl.metadata.event_type = "NETWORK_HTTP"
    $dl.target.url = /\.(exe|msi|iso|img|zip|rar|7z|scr|js|vbs|dmg|apk)(\?|$)/ nocase
    $dl.network.http.method = "GET"
    not $dl.target.hostname in %global_allowed_domains
    not $dl.target.ip in %rfc1918_internal
    $dl.principal.ip = $src_ip
    $dl.target.hostname = $dest_host

    $search.metadata.event_timestamp.seconds <= $dl.metadata.event_timestamp.seconds

  match:
    $src_ip, $dest_host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.006")
    $primary_entity = array_distinct($src_ip)
    $destination_host = array_distinct($dest_host)
    $referral_urls = array_distinct($search.network.http.referral_url)
    $download_urls = array_distinct($dl.target.url)
    $download_count = count($dl.metadata.id)

  condition:
    $search and $dl
}
