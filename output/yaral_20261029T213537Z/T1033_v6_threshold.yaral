/*
  MITRE Technique : T1033 - System Owner/User Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:53:12.290011+00:00
  Reference       : https://attack.mitre.org/techniques/T1033
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1033_Multi_User_Logon_Enumeration_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source host generates a high volume of user logon events across multiple distinct accounts within ten minutes. Each logon is benign on its own. In volume, it can indicate user and session discovery or account enumeration used to identify the primary or active users of systems. This is authentication-based coverage and does not depend on process command lines."
    mitre_tactic = "Discovery"
    mitre_technique = "T1033"
    mitre_technique_name = "System Owner/User Discovery"
    log_prerequisites = "Requires Windows Security event log (4624/4625 logon events) or EDR authentication telemetry normalised to USER_LOGIN with principal.hostname and target.user.userid populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Jump hosts and terminal/RDS servers, shared kiosks and lab machines, patch and inventory agents authenticating as many accounts, identity-aware proxies and VDI brokers, vulnerability scanners and helpdesk tooling."
    tuning_guidance = "Add scanner sources to %global_allowed_scanners, automation identities to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Raise the #auth threshold on hosts that legitimately serve many users, such as RDS servers and jump hosts. Review the distinct_users and target_hosts outcome values when triaging."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $host
    $auth.target.user.userid != ""
    not $auth.target.user.userid = /\$$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1033")
    $primary_entity = array_distinct($host)
    $logon_count = count($auth.metadata.id)
    $distinct_users = count_distinct($auth.target.user.userid)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    #auth >= 8
}
