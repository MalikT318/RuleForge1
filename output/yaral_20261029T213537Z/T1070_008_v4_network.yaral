/*
  MITRE Technique : T1070.008 - Clear Mailbox Data
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:03:48.501409+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_008_Linux_Scripted_Mailbox_Protocol_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host where a scripting interpreter or generic network utility opens an outbound connection to an external IMAP or POP3 port (143, 993, 110, 995). Servers rarely speak mailbox-access protocols to the internet through scripts. This behaviour is characteristic of programmatic mailbox manipulation (IMAP delete/expunge, message purge) used to remove evidence of phishing, collection or exfiltration. This is the network-side view: it does not see the delete command itself, so it should be paired with endpoint and mail-server telemetry for confirmation."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.008"
    mitre_technique_name = "Indicator Removal: Clear Mailbox Data"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd with network socket/connect auditing) that populates NETWORK_CONNECTION with principal.process.file.full_path, target.ip and target.port. Reference lists %rfc1918_internal, %global_allowed_script_hosts and %global_allowed_service_accounts must be populated per client."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Mail-migration or backup scripts using Python/Perl IMAP libraries, monitoring checks (Nagios-style plugins using openssl s_client or curl against IMAPS), helpdesk or admin troubleshooting of mail connectivity, mail-archiving jobs and legitimate fetch scripts run by service accounts."
    tuning_guidance = "Add hosts or parent processes that legitimately run mail scripts to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Populate %rfc1918_internal fully so internal mail relays are excluded. Extend the process regex with approved in-house mail tooling or remove noisy interpreters per client. Consider raising severity when the host is a server that is not expected to access mail."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 143 or
      $net.target.port = 993 or
      $net.target.port = 110 or
      $net.target.port = 995
    )
    $net.principal.process.file.full_path = /\/(python[0-9.]*|perl|ruby|php[0-9.]*|node|lua|curl|wget|openssl|nc|ncat|netcat|socat|telnet|bash|dash|sh)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1070.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
