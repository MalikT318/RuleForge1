/*
  MITRE Technique : T1583.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:09:57.809684+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_006_Scripted_Web_Service_Account_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client using a scripted or command-line HTTP user agent to POST to an account-registration or signup path on an external web service. This is the network-observable side of adversary-driven registration of web services (T1583.006) from monitored egress. Reaching this activity from a managed network is rare, so treat it as a hunting lead. The rule matches the registration request pattern, not specific services or domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.006"
    mitre_technique_name = "Acquire Infrastructure: Web Services"
    log_prerequisites = "Requires perimeter or proxy logs normalised to UDM NETWORK_HTTP with network.http.method, network.http.user_agent, target.url and target.hostname populated. TLS inspection is needed to see URL paths on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers or QA automation testing signup flows of SaaS products; CI/CD jobs provisioning accounts on vendor platforms; IT onboarding scripts registering licensed SaaS accounts; sanctioned red-team or pentest activity."
    tuning_guidance = "Add known-good SaaS and vendor domains to %global_allowed_domains. Add build servers, automation hosts and developer jump hosts to %global_allowed_script_hosts. Tighten or widen the user agent and URL path regexes to match local proxy logging."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST"
    $net.target.url = /\/(signup|sign-up|sign_up|register|registration|join|create[-_]?account|accounts?\/new)(\/|\?|$)/ nocase
    $net.network.http.user_agent = /\b(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl|okhttp|node-fetch|axios|powershell|httpie)\b/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1583.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $request_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
