/*
  MITRE Technique : T1585.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:39:43.243013+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_003_Repeated_Cloud_Account_Registration_Requests {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source sends repeated HTTP POST requests to external account-registration endpoints (signup/register/create-account paths) within ten minutes. One signup is benign, but bursts suggest scripted or bulk creation of cloud accounts for use as attacker infrastructure, storage or staging. The rule is behavioural: it matches registration URL structure, not specific providers or domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.003"
    mitre_technique_name = "Establish Accounts: Cloud Accounts"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL and HTTP method visibility (for example TLS-inspected web traffic) normalised to NETWORK_HTTP. Without URL visibility the rule cannot evaluate. Account creation on the provider side is outside defender visibility, so this only catches activity originating from the monitored network."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees onboarding to approved SaaS tools, marketing or QA teams testing signup flows, sandbox or lab networks, web crawlers or automated test suites, and shared egress NAT addresses aggregating many users."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Add QA, lab and scanner hosts to %global_allowed_scanners. Raise the threshold (#http >= 5) for shared NAT egress addresses. Narrow the path regex if a client's internal applications use registration paths."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(signup|sign-up|sign_up|register|registration|createaccount|create-account|create_account|account\/create)(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners
    $http.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(50)
    $event_count = count($http.metadata.id)
    $distinct_target_hosts = array_distinct($http.target.hostname)
    $target_urls = array_distinct($http.target.url)
    $mitre_technique_id = array_distinct("T1585.003")
    $primary_entity = array_distinct($src_ip)

  condition:
    #http >= 5
}
