/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:51:55.045406+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_Linux_Alternate_Medium_Exfil_Tooling {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Linux use of native utilities that move data over a non-primary network medium: Bluetooth OBEX or RFCOMM transfers to a remote device, NetworkManager creating a Wi-Fi access point or hotspot, or ModemManager bringing up a cellular data bearer. Each branch combines a binary with the arguments that show an outbound or alternate channel is actually being established, not just that the tool exists."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated target.process.file.full_path, target.process.command_line and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop users pairing or sending files to phones over Bluetooth, administrators or field engineers configuring Wi-Fi hotspots or tethering, IoT or kiosk provisioning scripts, laptop fleets with cellular modems managed by connection scripts, lab and test hosts."
    tuning_guidance = "Add provisioning and network-management parent processes to %global_allowed_admin_tools. Add named network or field-engineering administrators to %global_allowed_admin_users. Add approved management tooling to %global_allowed_remote_mgmt. On servers, which should not use Bluetooth, Wi-Fi AP or cellular, consider raising severity. On developer or laptop fleets, restrict the rule to server host groups."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/(obexftp|bluetooth-sendto|ussp-push|obexpushd|rfcomm)$/ nocase and
        $proc.target.process.command_line = /(--?(put|send|push|device|dest|channel)\b|\b(put|push|connect|bind|listen)\b|[0-9a-f]{2}(:[0-9a-f]{2}){5})/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\/nmcli$/ nocase and
        $proc.target.process.command_line = /(\bdevice\s+wifi\s+hotspot\b|\bmode\s+ap\b|\b802-11-wireless\.mode\s+ap\b|\bipv4\.method\s+shared\b)/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\/mmcli$/ nocase and
        $proc.target.process.command_line = /(--simple-connect|--simple-enable|--3gpp-register)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
