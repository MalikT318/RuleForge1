/*
  MITRE Technique : T1585.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:37:42.813349+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_002_Mail_Provider_Signup_Then_Inbox_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single internal host submits a POST to an account registration path on a mail-oriented web host, then within 10 minutes loads a verification, activation or inbox path on the same host. This sequence is consistent with creating a new (often disposable) email account for later use in phishing or infrastructure acquisition."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.002"
    mitre_technique_name = "Establish Accounts: Email Accounts"
    log_prerequisites = "Requires perimeter or proxy HTTP logs normalised to NETWORK_HTTP with network.http.method, target.url, target.hostname and principal.hostname populated. TLS inspection is needed for URL paths over HTTPS; without it the rule will not see paths."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees registering personal or test webmail accounts, IT staff creating mailboxes on hosted mail platforms, QA teams testing signup flows, marketing or sandbox teams provisioning trial mailboxes."
    tuning_guidance = "Add approved mail providers and vendor portals to %global_allowed_domains. If the source is a shared NAT or proxy and principal.hostname is not unique, adjust the join to principal.ip or the authenticated user. Tighten or loosen the mail keyword regex on target.hostname to match client web filtering categories."

  events:
    $signup.metadata.event_type = "NETWORK_HTTP"
    $signup.network.http.method = "POST"
    $signup.target.hostname = /(mail|inbox|mailbox)/ nocase
    $signup.target.url = /\/(signup|sign-up|register|registration|create[-_]?account|new[-_]?account|join)(\/|\?|$)/ nocase
    not $signup.target.hostname in %global_allowed_domains
    not $signup.target.ip in %rfc1918_internal
    $signup.principal.hostname = $hostname
    $signup.target.hostname = $mailhost

    $verify.metadata.event_type = "NETWORK_HTTP"
    $verify.network.http.method = "GET"
    $verify.target.hostname = /(mail|inbox|mailbox)/ nocase
    $verify.target.url = /\/(verify|verification|confirm|confirmation|activate|activation|inbox|welcome)(\/|\?|$)/ nocase
    not $verify.target.hostname in %global_allowed_domains
    not $verify.target.ip in %rfc1918_internal
    $verify.principal.hostname = $hostname
    $verify.target.hostname = $mailhost

    $signup.metadata.event_timestamp.seconds <= $verify.metadata.event_timestamp.seconds

  match:
    $hostname, $mailhost over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1585.002")
    $primary_entity = array_distinct($signup.principal.hostname)
    $mail_host = array_distinct($signup.target.hostname)
    $signup_urls = array_distinct($signup.target.url)
    $verify_urls = array_distinct($verify.target.url)
    $first_signup = min($signup.metadata.event_timestamp.seconds)
    $last_verify = max($verify.metadata.event_timestamp.seconds)

  condition:
    $signup and $verify
}
