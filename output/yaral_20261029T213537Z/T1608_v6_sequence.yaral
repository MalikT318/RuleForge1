/*
  MITRE Technique : T1608 - Stage Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:20:08.488908+00:00
  Reference       : https://attack.mitre.org/techniques/T1608
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_Executable_Upload_Then_External_Retrieval {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an external client uploading (PUT/POST) an executable, script or archive-type object to a web resource, followed within 10 minutes by a different external client successfully retrieving the same URL. This is the network-observable pattern of an adversary staging a capability on compromised or exposed web infrastructure and then serving it to a victim."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608"
    mitre_technique_name = "Stage Capabilities"
    log_prerequisites = "Requires firewall, proxy or web-gateway logs normalised to NETWORK_HTTP with populated network.http.method, network.http.response_code, target.url and principal.ip. TLS inspection or reverse-proxy visibility is needed to see HTTP details."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate file-sharing or artifact repositories (package registries, software distribution portals), customer upload portals that are later downloaded by other users, CI/CD artifact stores exposed through a reverse proxy, and WebDAV or document-collaboration services."
    tuning_guidance = "Add known-good hosting domains to %global_allowed_domains and trusted upload sources to %global_allowed_mgmt_sources. Extend the extension list for the client environment, or tighten it to executable types only for noisy tenants. Confirm the proxy logs the full URL, since the join depends on target.url."

  events:
    $put.metadata.event_type = "NETWORK_HTTP"
    $put.network.http.method = /^(PUT|POST)$/ nocase
    $put.target.url = /\.(exe|dll|msi|bat|ps1|hta|js|jar|sh|elf|bin|iso|zip|7z|rar)(\?.*)?$/ nocase
    $put.network.http.response_code >= 200
    $put.network.http.response_code < 300
    not $put.principal.ip in %rfc1918_internal
    not $put.principal.ip in %global_allowed_mgmt_sources
    not $put.target.hostname in %global_allowed_domains
    $put.target.url = $url

    $get.metadata.event_type = "NETWORK_HTTP"
    $get.network.http.method = "GET" nocase
    $get.target.url = /\.(exe|dll|msi|bat|ps1|hta|js|jar|sh|elf|bin|iso|zip|7z|rar)(\?.*)?$/ nocase
    $get.network.http.response_code = 200
    not $get.principal.ip in %rfc1918_internal
    not $get.target.hostname in %global_allowed_domains
    $get.target.url = $url

    $put.principal.ip != $get.principal.ip
    $put.metadata.event_timestamp.seconds <= $get.metadata.event_timestamp.seconds

  match:
    $url over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608")
    $primary_entity = array_distinct($get.target.hostname)
    $uploader_ips = array_distinct($put.principal.ip)
    $downloader_ips = array_distinct($get.principal.ip)
    $staged_url = array_distinct($url)
    $upload_count = count($put.metadata.id)
    $download_count = count($get.metadata.id)

  condition:
    $put and $get
}
