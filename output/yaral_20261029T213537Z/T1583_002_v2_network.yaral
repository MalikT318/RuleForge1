/*
  MITRE Technique : T1583.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:00:45.167021+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_002_DNS_Tunnel_Query_To_External_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS queries for TXT or NULL records with an abnormally long subdomain label, sent to a non-internal DNS server. This is the network pattern of DNS-based C2 or exfiltration served by an adversary-operated authoritative DNS server."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.002"
    mitre_technique_name = "Acquire Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated. Resolver address (target.ip) is needed for the external-resolver filter."
    platform = "PRE"
    log_source = "dns"
    false_positives = "DKIM/SPF/DMARC and other TXT lookups with long labels, anti-spam and reputation DNSBL services, CDN or cloud services using long hashed subdomains, software licensing and telemetry beacons, security products performing DNS-based lookups."
    tuning_guidance = "Add legitimate parent domains to %global_allowed_domains. Make sure %rfc1918_internal covers your internal resolvers so only queries to external DNS servers are evaluated. Raise the label length threshold (40) if noisy, or lower it to 30 for higher sensitivity."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    // TXT (16) or NULL (10) record queries, commonly used for DNS tunnelling payloads
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    // Long, encoded-looking leftmost label in front of a registered domain
    $dns.network.dns.questions.name = /^[a-z0-9_\-]{40,}\.([a-z0-9\-]+\.)+[a-z]{2,}$/ nocase
    // Network-side angle: query sent to a non-internal DNS server
    not $dns.target.ip in %rfc1918_internal
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1583.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $source_ips = array_distinct($dns.principal.ip)
    $resolver_ips = array_distinct($dns.target.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
