/*
  MITRE Technique : T1589.003 - Employee Names
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:11:12.479674+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_003_External_Employee_Name_Enumeration_Web {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external client making HTTP requests to a perimeter-protected web property that enumerate people or user records. Covers sequential author or user ID probing, user-listing REST endpoints, and name-parameterised staff or directory searches. Attackers use these to harvest employee names for email-address derivation and phishing lures."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.003"
    mitre_technique_name = "Gather Victim Identity Information: Employee Names"
    log_prerequisites = "Requires proxy, WAF or perimeter HTTP logs normalised to UDM NETWORK_HTTP with target.url and principal.ip populated. Inbound (reverse-proxy) traffic must be visible."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Search-engine and SEO crawlers indexing staff or team pages, legitimate visitors using a public staff directory search, headless-CMS front ends calling user or author APIs, uptime and monitoring probes, and authorised external penetration tests."
    tuning_guidance = "Add authorised external scanners and pentest sources to %global_allowed_scanners. If a public staff directory is intentional, narrow the directory alternative in the URL regex or pair with a Threshold variant. Deploy this rule only on log feeds that carry inbound traffic to client-owned web properties."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /([?&]author=[0-9]+|\/(wp-json\/wp\/v2|api(\/v[0-9]+)?|rest\/v[0-9]+)\/users(\/|\?|$)|\/(staff|employee|employees|people|team|directory)[^?]*\?[^#]*(name|first|last|q|search|query)=)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1589.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
