/*
  MITRE Technique : T1590.004 - Network Topology
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:20:14.419198+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_004_External_Source_Probing_Network_Infrastructure_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source generates a high volume of connection events to network-infrastructure and management service ports (SSH, Telnet, SNMP, BGP, NETCONF, smart-install and similar) within ten minutes. Any one connection is benign, but the volume indicates reconnaissance of network devices and topology."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.004"
    mitre_technique_name = "Gather Victim Network Information: Network Topology"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection or flow logs normalised to UDM with principal.ip, target.ip and target.port populated, covering inbound traffic from external sources."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services not yet in the scanner list, upstream ISP or MSP monitoring probes, partner or remote-admin sources that legitimately manage network devices, and internet-wide research scanners (noisy but low-risk)."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners and approved management source addresses to %global_allowed_mgmt_sources. Raise the #net threshold in noisy internet-facing environments. Lower it for segments that should receive no inbound management-port traffic."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 162 or
      $net.target.port = 179 or
      $net.target.port = 830 or
      $net.target.port = 2000 or
      $net.target.port = 4786 or
      $net.target.port = 8291 or
      $net.target.port = 10000
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 161 or $net.target.port = 179 or $net.target.port = 4786 or $net.target.port = 830, 75, 55))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1590.004")
    $primary_entity = array_distinct($src)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 25
}
