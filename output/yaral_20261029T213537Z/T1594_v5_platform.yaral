/*
  MITRE Technique : T1594 - Search Victim-Owned Websites
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:49:14.580038+00:00
  Reference       : https://attack.mitre.org/techniques/T1594
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1594_Recon_Hidden_Path_Probe_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting hidden or sensitive web paths on a victim-owned site, as seen by an IDS/IPS or network security appliance. The paths are VCS metadata, environment and credential files, backup and archive artefacts, and server diagnostic pages. These are typical of forced browsing and wordlist scanning used to find unlinked content. It matches the combination of an external source, a read-style HTTP method, and a sensitive path pattern, rather than any specific scanner or tool signature."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1594"
    mitre_technique_name = "Search Victim-Owned Websites"
    log_prerequisites = "Requires IDS/IPS or network security appliance HTTP inspection logs normalised to UDM NETWORK_HTTP with network.http.method, target.url and principal.ip populated. The appliance must inspect traffic to the web servers, via TLS inspection or a decrypted segment."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and external attack-surface assessments, penetration tests, search engine and SEO crawlers, uptime or monitoring probes, legitimate downloads of files whose names match the backup or archive pattern, and developers who deliberately expose diagnostic pages."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add known-good monitoring or vendor source addresses to %global_allowed_mgmt_sources. Narrow or extend the path regex for the customer's web stack. Because this is a single-event rule, consider alerting only on repeat offenders in a downstream SOAR step, or promote it to a threshold rule grouped by source IP if volume is high."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD)$/ nocase
    $http.target.url = /\/(\.(git|svn|hg|env|htpasswd|htaccess|ds_store|bash_history|aws|ssh)(\/|\?|$)|[^\/?]*(backup|dump|database|db|site|www|config)[^\/?]*\.(zip|tar|tgz|gz|sql|bak|7z|rar)(\?|$)|[^\/?]+\.(bak|old|orig|swp|save)(\?|$)|(phpinfo|server-status|server-info)(\.php)?(\?|$))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1594")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
