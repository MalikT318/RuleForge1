/*
  MITRE Technique : T1584.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:24:55.945026+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_004_Payload_Download_Then_NonStandard_Port_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An internal host downloads an executable, script or archive over HTTP from an external server, then connects to the same external IP on a non-web port within 10 minutes. This staging-then-callback pattern is consistent with adversary use of a compromised third-party server for payload staging and command and control."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.004"
    mitre_technique_name = "Compromise Infrastructure: Server"
    log_prerequisites = "Requires perimeter firewall or proxy logs that normalise to UDM NETWORK_HTTP (with URL and method) and NETWORK_CONNECTION (with source IP, destination IP and port). Source and destination IPs must be populated on both event types."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software updaters and installers that download packages and then use a proprietary port on the same vendor host. Developers and build systems fetching artifacts from self-hosted repositories. Remote support or RMM tooling that downloads an agent and then connects on a custom port. Games and collaboration clients on consumer-grade hosts."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Make sure %rfc1918_internal covers all of the client's internal address space. For client-specific update services that use custom ports, add the destination domain to %global_allowed_domains. Widen or narrow the file-extension list in the URL regex to match client policy. Raise the severity for hosts in sensitive network segments."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(exe|dll|msi|ps1|bat|vbs|hta|jar|scr|zip|7z|rar|iso|elf|sh)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.ip = $src_ip
    $http.target.ip = $dst_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port > 1024
    not $net.target.ip in %rfc1918_internal
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1584.004")
    $primary_entity = array_distinct($src_ip)
    $external_server = array_distinct($dst_ip)
    $downloaded_urls = array_distinct($http.target.url)
    $callback_ports = array_distinct($net.target.port)
    $callback_count = count($net.metadata.id)

  condition:
    $http and $net
}
