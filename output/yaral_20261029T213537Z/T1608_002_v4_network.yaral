/*
  MITRE Technique : T1608.002 - Upload Tool
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:23:22.919177+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_002_External_Tool_Download_From_Staging_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client retrieving an executable, script, or archive tool file over HTTP from an external host that is either addressed by a raw IP literal or fetched by a scripted or command-line HTTP client. Both patterns are characteristic of tools staged on adversary-controlled or compromised infrastructure for later Ingress Tool Transfer."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.002"
    mitre_technique_name = "Stage Capabilities: Upload Tool"
    log_prerequisites = "Requires web proxy or perimeter firewall logs with HTTP inspection that populate the full URL (target.url) and the user agent. TLS-encrypted traffic is only visible if the proxy performs TLS inspection."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Administrators or developers downloading installers and scripts with curl or wget; software deployment and patching from vendor IP-addressed mirrors; CI/CD build agents pulling artifacts; legitimate package repositories that serve archives by IP; security teams testing download controls."
    tuning_guidance = "Add known-good vendor, CDN, and update domains to %global_allowed_domains. Review noisy source subnets or hosts and exempt them via a client-specific copy of the rule. The file extension list and user agent regex can be narrowed per client. Internal destinations are already excluded using %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\.(exe|dll|msi|ps1|psm1|bat|vbs|hta|jar|elf|sh|bin|iso|7z|rar|zip)(\?|#|$)/ nocase
    (
      $net.target.url = /^(https?:\/\/)?(\d{1,3}\.){3}\d{1,3}([:\/]|$)/ nocase or
      $net.network.http.user_agent = /(curl|wget|python-requests|python-urllib|powershell|winhttp|go-http-client|libwww-perl)/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
