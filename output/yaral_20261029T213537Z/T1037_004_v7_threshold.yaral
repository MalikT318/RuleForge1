/*
  MITRE Technique : T1037.004 - RC Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:56:22.866926+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_004_ESXi_RC_Script_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated shell commands on a single ESXi host that write to or alter the boot-persistence RC scripts (/etc/rc.local.d/local.sh, /etc/rc.local) within ten minutes. ESXi discards most changes on reboot, so these scripts are one of the few persistence mechanisms available. A single edit can be benign; several write-type operations in a short window suggest payload staging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.004"
    mitre_technique_name = "Boot or Logon Initialization Scripts: RC Scripts"
    log_prerequisites = "ESXi shell command auditing (shell.log / hostd) or syslog forwarding that is parsed into UDM PROCESS_LAUNCH events with target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately editing local.sh during host build or hardening, configuration-management or automation scripts that deploy startup settings, and vendor driver or agent installers that register startup hooks."
    tuning_guidance = "Add approved automation and deployment binaries to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Raise the count threshold on hosts under active build-out. Lower it to 2 for hardened production hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\/etc\/rc\.local(\.d\/[^\s;|&"']*)?|rc\.local\.d\/[^\s;|&"']*)/ nocase
    $proc.target.process.command_line = /(>>?|\btee\b|\bsed\s+-[a-z]*i|\bcp\b|\bmv\b|\bchmod\b|\bvi\b|\bvim\b|\bprintf\b|\becho\b|\bcat\b.*<<)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1037.004")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
