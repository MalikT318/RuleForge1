/*
  MITRE Technique : T1684.001 - Impersonation
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:43:42.829431+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_001_Email_Impersonation_ReplyTo_Mismatch_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single sender emits several messages within 10 minutes that combine urgency or payment-themed subject language with a Reply-To address different from the From address. This is a common business email compromise pattern for impersonating an executive, colleague or vendor. One such message is common and benign, but repeated volume from one sender points to a campaign."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.001"
    mitre_technique_name = "Impersonation"
    log_prerequisites = "Requires email transaction audit telemetry that populates network.email.from, network.email.reply_to and network.email.subject (message trace or mail audit logs)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Marketing and newsletter platforms sending on behalf of the organisation, helpdesk and ticketing systems, billing and invoicing systems that set a shared Reply-To mailbox, shared-mailbox workflows, and legitimate finance staff sending bulk payment reminders."
    tuning_guidance = "Add automation and bulk-mailer account identifiers to %global_allowed_service_accounts. Raise the #mail threshold for tenants with heavy invoicing traffic. Extend or narrow the subject regex to match the client's business vocabulary."

  events:
    $mail.metadata.event_type = "EMAIL_TRANSACTION"
    $mail.network.email.from = $sender
    $mail.network.email.reply_to != ""
    $mail.network.email.reply_to != $mail.network.email.from
    $mail.network.email.subject = /\b(urgent|immediate(ly)?|payment|invoice|wire transfer|overdue|gift card|bank details|confidential|past due)\b/ nocase
    not $mail.principal.user.userid in %global_allowed_service_accounts

  match:
    $sender over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1684.001")
    $primary_entity = array_distinct($mail.network.email.from)
    $event_count = count($mail.metadata.id)
    $reply_to_addresses = array_distinct($mail.network.email.reply_to)
    $subjects_seen = array_distinct($mail.network.email.subject)

  condition:
    #mail >= 5
}
