/*
  MITRE Technique : T1590.001 - Domain Properties
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:14:59.720875+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_001_External_Domain_Property_Probing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source issues a high volume of HTTP requests to domain-metadata and tenant-discovery endpoints (autodiscover, realm lookup, OpenID/federation metadata) within ten minutes. A single request is routine, but repeated enumeration from one source indicates reconnaissance of the victim's domain properties and identity configuration."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.001"
    mitre_technique_name = "Gather Victim Network Information: Domain Properties"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_HTTP with principal.ip and target.url populated (URL visibility, e.g. TLS inspection or reverse-proxy placement, is required)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Outlook/mobile mail clients behind a shared NAT or corporate egress hitting autodiscover; federation partners and SaaS integrations polling OpenID or federation metadata; authorised external attack-surface or vulnerability scans; uptime monitors."
    tuning_guidance = "Add authorised scanners and partner egress addresses to %global_allowed_scanners. Raise the #http threshold (default 25) for tenants with many NAT-ed mail users. Review $distinct_urls and $targeted_hosts in the outcome to separate broad enumeration from repeated legitimate client polling."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/autodiscover\/autodiscover\.(xml|json)|getuserrealm|\/\.well-known\/openid-configuration|federationmetadata\.xml|\/autodiscover\/)/ nocase
    $http.principal.ip = $src
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($http.metadata.id)
    $distinct_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)
    $mitre_technique_id = array_distinct("T1590.001")
    $primary_entity = array_distinct($src)

  condition:
    #http >= 25
}
