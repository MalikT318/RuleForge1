/*
  MITRE Technique : T1608.005 - Link Target
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:29:06.898644+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_005_Credential_Lure_Link_Target_Raw_IP_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP request to an external web server addressed by a raw IPv4 literal (no domain name) whose URL path looks like a credential-harvesting page (login, sign-in, verify, webmail, SSO). This is the network-side footprint of a user following a phishing link to adversary-staged infrastructure (Link Target). Legitimate services almost never serve login pages from a bare IP address."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.005"
    mitre_technique_name = "Stage Capabilities: Link Target"
    log_prerequisites = "Requires proxy or perimeter firewall with URL logging (NETWORK_HTTP events populating target.url). TLS inspection is needed to see the full URL for HTTPS traffic; without it, only plain HTTP is covered."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet-facing appliance or device admin portals (printers, cameras, routers, NAS, VPN gateways) accessed by IP; developers or testers using staging servers by IP; partner or vendor portals addressed by IP; authorised phishing simulation platforms."
    tuning_guidance = "Add approved vendor or partner domains to %global_allowed_domains (matched on target.hostname). Add phishing-simulation and security testing sources to %global_allowed_scanners. If appliance portals produce noise, remove the generic keywords 'account' and 'secure' from the path regex or raise the severity only when combined with other signals."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /^https?:\/\/[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]{1,5})?\/[^?#]*(login|log-in|logon|signin|sign-in|verify|webmail|owa|sso|auth|password|account|secure)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.005")
    $primary_entity = array_distinct($http.principal.hostname)
    $requested_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
