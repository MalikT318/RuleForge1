/*
  MITRE Technique : T1591.003 - Identify Business Tempo
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:30:55.854471+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_003_Business_Tempo_Crawl_Discovery_Then_Schedule_Pages {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Low"
    description = "Detects one external source that fetches crawler-discovery files (robots.txt or sitemap) and then, within ten minutes, repeatedly requests pages that expose business tempo, such as operating hours, holiday or shipping schedules, delivery windows, and event or press calendars. This pattern is consistent with pre-compromise reconnaissance of the organisation's operational rhythm."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.003"
    mitre_technique_name = "Gather Victim Org Information: Identify Business Tempo"
    log_prerequisites = "Requires IDS/IPS or network security appliance HTTP inspection that populates network.http.method, target.url and principal.ip for inbound web traffic to protected servers. Not suitable for sources that log only connection metadata."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and brand-monitoring services, partner or customer portals checking delivery schedules, price-comparison bots, and legitimate visitors who browse several schedule pages after a sitemap fetch."
    tuning_guidance = "Add authorised scanners and known monitoring sources to %global_allowed_scanners. Raise the #tempo threshold (default 3) on high-traffic public sites. Extend the URL keyword alternation for industry-specific tempo pages. Consider restricting to hosts that front customer-facing web servers."

  events:
    $discover.metadata.event_type = "NETWORK_HTTP"
    $discover.network.http.method = "GET"
    $discover.target.url = /\/(robots\.txt|sitemap[^\/?]*\.xml)(\?.*)?$/ nocase
    not $discover.principal.ip in %rfc1918_internal
    not $discover.principal.ip in %global_allowed_scanners
    $discover.principal.ip = $src_ip

    $tempo.metadata.event_type = "NETWORK_HTTP"
    $tempo.network.http.method = "GET"
    $tempo.target.url = /\/[^?]*(opening-hours|business-hours|store-hours|hours-of-operation|office-hours|holiday|shipping|delivery-schedule|schedule|events|press|careers)/ nocase
    not $tempo.principal.ip in %rfc1918_internal
    not $tempo.principal.ip in %global_allowed_scanners
    $tempo.principal.ip = $src_ip

    $discover.metadata.event_timestamp.seconds <= $tempo.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1591.003")
    $primary_entity = array_distinct($src_ip)
    $tempo_request_count = count($tempo.metadata.id)
    $tempo_urls = array_distinct($tempo.target.url)
    $discovery_urls = array_distinct($discover.target.url)
    $targeted_hosts = array_distinct($tempo.target.hostname)

  condition:
    $discover and #tempo >= 3
}
