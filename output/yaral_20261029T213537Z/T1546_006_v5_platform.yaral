/*
  MITRE Technique : T1546.006 - LC_LOAD_DYLIB Addition
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:30:24.131810+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_006_macOS_Dylib_Dropped_In_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a .dylib file in a user-writable or staging location on macOS (/tmp, /var/tmp, /Users/Shared, Downloads, or hidden directories under a home folder) by a process that is not an approved installer, compiler or management tool. Adversaries who add an LC_LOAD_DYLIB command to a Mach-O binary need the malicious dylib staged where the tainted binary can load it. This rule detects that staging step through file-creation telemetry rather than process command lines."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.006"
    mitre_technique_name = "Event Triggered Execution: LC_LOAD_DYLIB Addition"
    log_prerequisites = "macOS endpoint telemetry that reports file creation events with the writing process path (EDR or unified log file-event collection)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developer toolchains (Xcode, Homebrew, language package managers) building native libraries in temp or hidden directories, software installers and updaters unpacking libraries to /tmp, and Electron or browser apps that unpack helper dylibs in Downloads."
    tuning_guidance = "Add approved build, deployment and installer binaries to %global_allowed_admin_tools. Add developer-host build tooling to %global_allowed_script_hosts. Extend the toolchain directory exclusion regex for client-specific dev environments. Consider raising severity on hosts that are not developer workstations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/private)?\/(tmp|var\/tmp)\/.+\.dylib$|^\/Users\/Shared\/.+\.dylib$|^\/Users\/[^\/]+\/(Downloads|\.[^\/]+)\/.+\.dylib$/ nocase
    not $file.target.file.full_path = /\/\.(npm|cache|cargo|rustup|pyenv|nvm|conda|vscode|local|gradle|m2|docker|Trash|pub-cache|rbenv)\// nocase
    not $file.principal.process.file.full_path = /\/(installer|Installer|softwareupdated|package_script_service|system_installd|ld|clang|swift-frontend|xcodebuild|brew|mdworker_shared)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1546.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $dylib_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
