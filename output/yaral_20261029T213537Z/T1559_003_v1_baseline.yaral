/*
  MITRE Technique : T1559.003 - XPC Services
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:43:13.104595+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_003_XPC_Privileged_Helper_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a launchd-managed privileged helper tool (/Library/PrivilegedHelperTools) or an XPC service bundle binary (*.xpc/Contents/MacOS) spawning a shell or scripting interpreter with command-execution arguments. This is the typical result of abusing an XPC service handler through improper client validation or unsanitised input, giving local code execution in the context of the XPC service, which is often root."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.003"
    mitre_technique_name = "Inter-Process Communication: XPC Services"
    log_prerequisites = "Requires macOS endpoint process telemetry (EDR or Endpoint Security framework) populating parent and child process paths and command lines."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate third-party installers, updaters, VPN clients, disk utilities and MDM or management agents whose privileged helpers shell out to run scripts or utilities; developer tooling that runs XPC services during debugging."
    tuning_guidance = "Add approved helper tool or agent paths to %global_allowed_admin_tools and endpoint security agent helpers to %global_allowed_security_tools. Review recurring benign parent and command-line pairs per client and allowlist by parent executable path rather than by directory version."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(^\/Library\/PrivilegedHelperTools\/|\.xpc\/Contents\/MacOS\/)/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|zsh|dash|ksh|osascript|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(\s-c\s|\s-e\s|curl|wget|base64|chmod\s|\/dev\/tcp|nc\s|launchctl|dscl|sudoers|osascript)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1559.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_helper = array_distinct($proc.principal.process.file.full_path)
    $spawned_process = array_distinct($proc.target.process.file.full_path)
    $spawned_command = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
