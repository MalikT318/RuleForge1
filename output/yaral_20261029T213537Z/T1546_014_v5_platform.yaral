/*
  MITRE Technique : T1546.014 - Emond
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:31:48.002844+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_014_Emond_Rule_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file in the emond rules directory (/etc/emond.d/rules/) or the emond QueueDirectories path (/private/var/db/emondClients/). Emond loads plist rules from the first location and only starts when the second contains a file. Writing to either is a rare event on modern macOS and is the core step in establishing emond persistence and privilege escalation, because emond runs as root. This rule is file-telemetry based and complements any process command-line detections."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.014"
    mitre_technique_name = "Event Triggered Execution: Emond"
    log_prerequisites = "Requires macOS endpoint file-creation telemetry that records the full target path and the acting process. Both /etc/... and /private/etc/... path forms are covered because /etc is a symlink to /private/etc."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or configuration management agents that deploy emond rules, IT admins who deliberately configure emond, OS upgrades or installers that recreate the default emond directories, and security or inventory agents that touch these paths. Legitimate emond use is very rare on modern macOS."
    tuning_guidance = "Add approved deployment or management binaries to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. If a client intentionally uses emond, scope the exclusion to the specific writer process rather than the path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/private)?\/(etc\/emond\.d\/rules\/|var\/db\/emondClients\/).+/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
