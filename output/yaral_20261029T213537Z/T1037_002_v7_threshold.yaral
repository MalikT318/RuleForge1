/*
  MITRE Technique : T1037.002 - Login Hook
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:55:36.168062+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_002_MacOS_LoginHook_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple attempts within ten minutes on a single macOS host to write a LoginHook or LogoutHook key into the loginwindow preferences using defaults or PlistBuddy. Repeated writes suggest an adversary setting both hooks, retrying after failure, or testing a root-level persistence script."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.002"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Login Hook"
    log_prerequisites = "Requires macOS endpoint process telemetry (EDR or unified log) with full command-line capture for PROCESS_LAUNCH events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy MDM or imaging workflows that still configure login or logout hooks, IT administrators running provisioning scripts, and lab or kiosk build processes. Login hooks are deprecated, so legitimate use should be rare and well known."
    tuning_guidance = "Add approved provisioning or management binaries to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Raise the #proc threshold if a deployment tool legitimately sets both hooks in one run. Severity can be raised when the hook target script sits in a user-writable or temporary directory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(defaults|PlistBuddy)$/ nocase
    $proc.target.process.command_line = /\b(write|add|set|merge|import)\b/ nocase
    $proc.target.process.command_line = /(loginwindow.*(login|logout)hook|(login|logout)hook.*loginwindow)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.002")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 2
}
