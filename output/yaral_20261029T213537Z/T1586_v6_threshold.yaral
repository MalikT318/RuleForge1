/*
  MITRE Technique : T1586 - Compromise Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:41:32.338733+00:00
  Reference       : https://attack.mitre.org/techniques/T1586
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_Credential_Stuffing_Login_POST_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source sends a high volume of HTTP POST requests to authentication endpoints within ten minutes. Each login attempt is benign on its own, but the volume matches credential stuffing or password-reuse brute forcing used to compromise existing accounts (T1586). Responses of 401 or 403 raise the risk score."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586"
    mitre_technique_name = "Compromise Accounts"
    log_prerequisites = "Requires perimeter proxy, web gateway or firewall logs with HTTP inspection that populate network.http.method, target.url and principal.ip. Response codes are optional and only affect scoring."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, load or synthetic-monitoring probes, shared NAT or corporate egress addresses where many real users log in at once, API clients or mobile apps that authenticate frequently, and users behind a captive portal."
    tuning_guidance = "Add authorised scanning and testing sources to %global_allowed_scanners. Add monitoring or partner egress addresses to %global_allowed_mgmt_sources. If shared NAT addresses cause noise, raise the threshold from 20. Use $distinct_targets and $response_codes in outcome to separate single-application brute force from broad spraying."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(?i)(login|logon|signin|sign-in|sso|oauth2?|authenticate|auth\/|session|token|owa\/auth|wp-login)/ nocase
    $http.principal.ip = $src
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($http.network.http.response_code = 401 or $http.network.http.response_code = 403, 80, 55))
    $mitre_technique_id = array_distinct("T1586")
    $primary_entity = array_distinct($http.principal.ip)
    $event_count = count($http.metadata.id)
    $distinct_targets = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)
    $sample_urls = array_distinct($http.target.url)

  condition:
    #http >= 20
}
