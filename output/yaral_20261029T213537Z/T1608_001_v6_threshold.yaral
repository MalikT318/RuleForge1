/*
  MITRE Technique : T1608.001 - Upload Malware
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:22:10.413000+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_001_Repeated_Executable_Payload_Downloads_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host issues repeated HTTP GET requests for executable, script, or disk-image payload file types from external destinations within 10 minutes. One download is routine; a burst suggests retrieval of malware staged on third-party or adversary-controlled web infrastructure (T1608.001 staging seen from the victim side). The rule uses only perimeter-visible URL, method, and destination data."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.001"
    mitre_technique_name = "Stage Capabilities: Upload Malware"
    log_prerequisites = "Requires firewall or web proxy logs with HTTP inspection (URL and method) normalised to NETWORK_HTTP. SSL/TLS inspection is needed to see URLs on HTTPS traffic. Connection-only logs will not populate target.url."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software update services, package managers and developer build hosts fetching installers or scripts; patch and deployment servers; IT staff downloading tool kits; CI/CD runners pulling artifacts; security sandboxes and analysts."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Add scanner and sandbox hosts to %global_allowed_scanners. Add patching and deployment servers to %global_allowed_admin_tools. Raise the #http threshold on build or developer subnets. The window is fixed at 10m."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(exe|dll|scr|msi|ps1|vbs|hta|jar|iso|img|lnk|bat|apk|elf|sh)(\?.*)?$/ nocase
    $http.principal.hostname = $host
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($http.target.url = /\.(exe|dll|scr|msi|hta|iso|img|lnk)(\?.*)?$/ nocase, 75, 55))
    $mitre_technique_id = array_distinct("T1608.001")
    $primary_entity = array_distinct($host)
    $download_count = count($http.metadata.id)
    $distinct_dest_hosts = count_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $sample_urls = array_distinct($http.target.url)

  condition:
    #http >= 5
}
