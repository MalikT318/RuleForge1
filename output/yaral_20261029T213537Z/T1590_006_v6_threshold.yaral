/*
  MITRE Technique : T1590.006 - Network Security Appliances
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:24:05.216122+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_006_External_Probing_Of_Security_Appliance_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source makes a high volume of connection attempts to ports commonly used by firewall, VPN, proxy and appliance management services within ten minutes. Each connection is benign on its own. The volume suggests reconnaissance to fingerprint network security appliances (firewalls, proxies, bastion hosts, IDS/IPS management interfaces)."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.006"
    mitre_technique_name = "Gather Victim Network Information: Network Security Appliances"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and external attack-surface monitoring services, legitimate remote administrators or VPN users with repeated reconnects, partner or MSP management traffic, internet-wide research scanners (noisy but not targeted), misconfigured clients retrying a VPN or proxy."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management source addresses to %global_allowed_mgmt_sources. Raise the #net threshold on internet-exposed environments that see heavy background scanning, and lower it for tightly restricted perimeters."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 500 or
      $net.target.port = 541 or
      $net.target.port = 1080 or
      $net.target.port = 3128 or
      $net.target.port = 4433 or
      $net.target.port = 4443 or
      $net.target.port = 4500 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 10443
    )
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 23 or $net.target.port = 161 or $net.target.port = 541, 75, 60))
    $mitre_technique_id = array_distinct("T1590.006")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $probed_ports = array_distinct($net.target.port)
    $targeted_ips = array_distinct($net.target.ip)

  condition:
    #net >= 25
}
