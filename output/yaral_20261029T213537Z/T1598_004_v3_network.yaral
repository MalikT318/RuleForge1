/*
  MITRE Technique : T1598.004 - Spearphishing Voice
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:17:20.655208+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_004_Outbound_SIP_From_NonVoice_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects outbound SIP signalling (TCP/UDP 5060 or 5061) from an internal source to an external address. Callback phishing and vishing campaigns can lead users to place calls through softphones or browser-based VoIP clients. A SIP session leaving the perimeter from an address not registered as a PBX, session border controller or approved voice source is a network-side proxy for a user-initiated voice session with an external party. This is a weak, low-fidelity indicator and is best used as hunting or enrichment context alongside user reports of suspicious calls."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.004"
    mitre_technique_name = "Phishing for Information: Spearphishing Voice"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate UCaaS and SIP trunk traffic from PBXs, session border controllers and approved softphones; IP phones in the office or home-worker VPN pools; conferencing clients that use SIP signalling; vendor-managed voice systems."
    tuning_guidance = "Add PBX, SBC, IP phone VLAN and approved softphone source addresses to %global_allowed_mgmt_sources. Internal destinations are already excluded via %rfc1918_internal. If SIP is not permitted at the perimeter, raise severity, since any hit is then a policy violation. Correlate with help-desk or user reports of suspicious phone calls before escalating."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 5060 or $net.target.port = 5061)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1598.004")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
