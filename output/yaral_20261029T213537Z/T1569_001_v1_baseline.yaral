/*
  MITRE Technique : T1569.001 - Launchctl
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:51:08.482244+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_001_Launchctl_Load_Or_Submit_Suspicious_Job {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects launchctl used to load, bootstrap, start or submit a launchd job from a persistence or user-writable location (LaunchAgents/LaunchDaemons, /tmp, /var/folders, /Users/Shared, hidden user directories), or launchctl submit, which runs an arbitrary command as a launchd job without a plist. This is the core execution mechanism of T1569.001."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.001"
    mitre_technique_name = "System Services: Launchctl"
    log_prerequisites = "Requires macOS endpoint process-launch telemetry that includes full command-line arguments and parent process path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party software installers and updaters loading their own LaunchDaemons, MDM and RMM agents, developers testing launchd jobs (Homebrew services), and IT scripts that reload agents after configuration changes."
    tuning_guidance = "Add approved MDM/deployment parent binaries to %global_allowed_admin_tools, remote management agents to %global_allowed_remote_mgmt, and EDR/AV agents to %global_allowed_security_tools. If developer endpoints are noisy, scope them out through %global_allowed_script_hosts or add the Homebrew parent process to %global_allowed_admin_tools. Review the command_line outcome for the plist path; any user-writable or hidden location is highly suspicious."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/launchctl$/ nocase
    $proc.target.process.command_line = /\b(load|bootstrap|kickstart|start)\b.*(\/tmp\/|\/var\/tmp\/|\/private\/(var\/)?tmp\/|\/var\/folders\/|\/Users\/Shared\/|\/Users\/[^\/]+\/(Library\/LaunchAgents|Downloads|Desktop|\.[^\/]+)\/|\/Library\/Launch(Agents|Daemons)\/)|\bsubmit\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
