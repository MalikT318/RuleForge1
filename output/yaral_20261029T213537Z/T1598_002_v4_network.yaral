/*
  MITRE Technique : T1598.002 - Spearphishing Attachment
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:13:52.110181+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_002_External_Credential_Form_Post_No_Referrer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client sending an HTTP POST to an external, non-allowlisted destination whose URL looks like a credential or form-collection endpoint, with no web referrer or a file:// referrer. This is the network footprint of a user opening a spearphishing attachment (an HTML-smuggled fake login page or fillable form) and returning the harvested information. A page opened locally from an attachment has no HTTP referrer, unlike a normal browsing flow that starts from a web page."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.002"
    mitre_technique_name = "Phishing for Information: Spearphishing Attachment"
    log_prerequisites = "Requires proxy or perimeter firewall logs normalised to NETWORK_HTTP with HTTP method, target URL and, where available, referral URL populated (TLS inspection needed for HTTPS visibility)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Native or desktop applications that post sign-in data without a referrer, SSO or MFA flows from unlisted vendors, API clients and scripts posting to authentication endpoints, and legitimate SaaS login redirects that strip the referrer header."
    tuning_guidance = "Add known-good SaaS and identity provider domains to %global_allowed_domains. Add corporate egress or proxy sources and authorised testing hosts to %global_allowed_scanners. Tighten or extend the URL keyword regex per client. If the proxy does not populate referral_url, the empty-referrer condition will match all POSTs, so raise the keyword specificity or keep the rule at alert-only severity."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(?i)\/[^?#]*(login|logon|signin|sign-in|sso|auth|verify|validate|password|credential|webmail|owa|secure|submit|collect|upload)/
    (
      $http.network.http.referral_url = "" or
      $http.network.http.referral_url = /^file:/ nocase
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1598.002")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
