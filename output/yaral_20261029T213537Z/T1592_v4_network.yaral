/*
  MITRE Technique : T1592 - Gather Victim Host Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:34:37.459045+00:00
  Reference       : https://attack.mitre.org/techniques/T1592
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_External_Host_Info_Disclosure_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting well-known host-information disclosure endpoints (server status/info pages, PHP info pages, framework environment/diagnostic endpoints, trace pages) on a protected web host. This is the network-side signature of an adversary gathering victim host details such as OS, software versions, configuration and environment before targeting. Requests that return HTTP 200 are scored higher because they suggest the information was actually disclosed."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592"
    mitre_technique_name = "Gather Victim Host Information"
    log_prerequisites = "Requires firewall, web proxy, WAF or reverse-proxy logs that are normalised to NETWORK_HTTP and populate the request URL (target.url) and the external source IP (principal.ip). The HTTP response code is optional but improves scoring."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface-management services, uptime and health monitors that poll status or info endpoints, third-party penetration testers, and CDN or load-balancer health probes arriving from public addresses."
    tuning_guidance = "Add known external scanner and ASM source addresses to %global_allowed_scanners. Add monitoring or management source addresses to %global_allowed_mgmt_sources. If health-check endpoints such as actuator/health are legitimately polled, remove them from the URL regex for that client. To cut noise further, raise severity only when the response code is 200, or promote the rule to a Threshold variant keyed on principal.ip."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(server-status|server-info|phpinfo(\.php)?|info\.php|\.env|actuator\/(env|info|configprops|beans|mappings)|sysinfo|systeminfo|cgi-bin\/(printenv|test-cgi)|elmah\.axd|trace\.axd|debug\/default\/view)(\?|\/|#|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(if($http.network.http.response_code = 200, 60, 35))
    $mitre_technique_id = array_distinct("T1592")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
