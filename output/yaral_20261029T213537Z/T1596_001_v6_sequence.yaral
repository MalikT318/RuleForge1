/*
  MITRE Technique : T1596.001 - DNS/Passive DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:00:14.359559+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_001_External_DNS_Probe_Then_Host_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An external source opens TCP/53 sessions to internal DNS servers (the transport used for zone transfers and bulk record enumeration), then sends name-based HTTP requests to internal web hosts within ten minutes. This pattern suggests DNS reconnaissance followed by probing of the discovered hosts."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.001"
    mitre_technique_name = "Search Open Technical Databases: DNS/Passive DNS"
    log_prerequisites = "Requires IDS/IPS or network security appliance telemetry that records TCP connections (including destination port and protocol) and HTTP transactions with the host populated, covering internet-facing DNS and web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate secondary or partner DNS servers performing zone transfers, authorised external vulnerability or attack-surface scanners, uptime and monitoring services, and search-engine crawlers that happen to hit DNS and web hosts."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners. Add approved secondary DNS or partner source addresses to %global_allowed_mgmt_sources. If the rule is noisy, raise the number of distinct HTTP hosts (see $distinct_http_hosts in outcome) before alerting, or require more than one DNS connection."

  events:
    $dns.metadata.event_type = "NETWORK_CONNECTION"
    $dns.target.port = 53
    $dns.network.ip_protocol = "TCP"
    not $dns.principal.ip in %rfc1918_internal
    not $dns.principal.ip in %global_allowed_scanners
    not $dns.principal.ip in %global_allowed_mgmt_sources
    $dns.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /./
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1596.001")
    $primary_entity = array_distinct($src_ip)
    $dns_servers_probed = array_distinct($dns.target.ip)
    $dns_connection_count = count($dns.metadata.id)
    $http_hosts_requested = array_distinct($http.target.hostname)
    $distinct_http_hosts = count_distinct($http.target.hostname)

  condition:
    $dns and $http
}
