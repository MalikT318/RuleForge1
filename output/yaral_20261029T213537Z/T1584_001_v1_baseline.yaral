/*
  MITRE Technique : T1584.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:17:19.386248+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_001_Dangling_CNAME_NXDOMAIN_Subdomain_Takeover {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a DNS response where a subdomain resolves through a CNAME record but the lookup ends in NXDOMAIN. This indicates a dangling DNS entry pointing at a deprovisioned or non-existent resource, which is the precondition for subdomain hijacking and domain shadowing. Subdomain takeover is a form of domain compromise, and an adversary can claim the dead target to serve content under the trusted parent domain."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.001"
    mitre_technique_name = "Compromise Infrastructure: Domains"
    log_prerequisites = "Requires DNS resolver or query logs that include the response code and answer records (type and data), normalised to UDM NETWORK_DNS."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Decommissioned services whose CNAME records have not yet been cleaned up, short-lived DNS propagation after a migration, misconfigured split-horizon DNS, CDN or SaaS onboarding in progress, typo-squatted lookups by users that happen to pass through a CNAME, and security scanners enumerating subdomains."
    tuning_guidance = "Add known-good parent or vendor domains to %global_allowed_domains. Add scanner source addresses to %global_allowed_scanners. If the same dangling name is queried repeatedly by many clients, remove the DNS record or add the confirmed-decommissioned name to the allowlist after review. Raise severity for subdomains of domains the customer owns."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.response_code = 3
    $dns.network.dns.answers.type = 5
    $dns.network.dns.answers.data = /\./
    $dns.network.dns.questions.name = /^[^.]+\.[^.]+\.[^.]+/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.001")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $cname_targets = array_distinct($dns.network.dns.answers.data)

  condition:
    $dns
}
