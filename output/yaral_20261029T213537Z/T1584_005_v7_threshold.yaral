/*
  MITRE Technique : T1584.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:27:31.945841+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_005_DNS_Botnet_DGA_Query_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single DNS client issues a high volume of queries for long, consonant-heavy, algorithmically generated looking domain names within ten minutes. This is consistent with a bot using a domain generation algorithm to find C2 or rendezvous infrastructure in a botnet. Individual lookups are benign; the volume from one client is not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.005"
    mitre_technique_name = "Compromise Infrastructure: Botnet"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and principal.ip populated. Logs should come from the internal recursive resolver so that the real client address is visible."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services with randomised hostnames, security and anti-spam DNS blocklist lookups, email authentication and reputation queries, browser or telemetry beacons using hashed labels, software update and content-addressed services, and internal DNS-based service discovery."
    tuning_guidance = "Add known-good domains (CDNs, vendors, reputation services) to %global_allowed_domains. Add scanner or resolver-testing hosts to %global_allowed_scanners. Raise the threshold (#dns >= 20) for large NAT or shared-resolver environments where the client IP aggregates many users. If principal.ip is not populated, group by principal.hostname instead."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^([a-z0-9-]+\.)*[a-z0-9]{12,}\.[a-z]{2,}\.?$/ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz]{5,}/ nocase
    $dns.principal.ip = $client
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.hostname in %global_allowed_scanners

  match:
    $client over 10m

  outcome:
    $risk_score = max(if(count($dns.metadata.id) >= 50, 85, 60))
    $event_count = count($dns.metadata.id)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $mitre_technique_id = array_distinct("T1584.005")
    $primary_entity = array_distinct($dns.principal.ip)

  condition:
    #dns >= 20
}
