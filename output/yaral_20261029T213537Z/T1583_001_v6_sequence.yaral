/*
  MITRE Technique : T1583.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:59:54.807684+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_001_IDN_Lookup_Then_Long_Label_TXT_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A client resolves an internationalized (punycode, xn--) domain, a pattern commonly seen with homograph lookalike domains acquired by adversaries. The same client then issues a TXT query containing an unusually long, machine-like subdomain label within 10 minutes. This suggests the acquired domain is being used for tunnelling or C2."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.001"
    mitre_technique_name = "Acquire Infrastructure: Domains"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated, and a client identifier in principal.ip."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate internationalized domains visited by multilingual users. Email security, DKIM, SPF or DMARC lookups and anti-spam services that issue TXT queries with long labels. CDN or cloud services that use long hashed hostnames. Some security product telemetry lookups."
    tuning_guidance = "Add known-good external domains (vendors, CDNs, mail security services) to %global_allowed_domains. Raise the label-length threshold in the regex (currently 30 characters) if noisy. Consider restricting to resolvers that log the original client IP rather than a forwarder address."

  events:
    $dns_idn.metadata.event_type = "NETWORK_DNS"
    $dns_idn.network.dns.questions.name = /(^|\.)xn--[a-z0-9\-]+(\.|$)/ nocase
    not $dns_idn.network.dns.questions.name in %global_allowed_domains
    $dns_idn.principal.ip = $client

    $dns_txt.metadata.event_type = "NETWORK_DNS"
    $dns_txt.network.dns.questions.type = 16
    $dns_txt.network.dns.questions.name = /^[a-z0-9\-_]{30,}\.[a-z0-9\-]+\.[a-z0-9\-\.]+$/ nocase
    not $dns_txt.network.dns.questions.name in %global_allowed_domains
    $dns_txt.principal.ip = $client

    $dns_idn.metadata.event_timestamp.seconds <= $dns_txt.metadata.event_timestamp.seconds

  match:
    $client over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1583.001")
    $primary_entity = array_distinct($client)
    $idn_domains = array_distinct($dns_idn.network.dns.questions.name)
    $txt_queries = array_distinct($dns_txt.network.dns.questions.name)
    $txt_query_count = count($dns_txt.metadata.id)

  condition:
    $dns_idn and $dns_txt
}
