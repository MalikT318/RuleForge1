/*
  MITRE Technique : T1596.004 - CDNs
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:05:43.430024+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_004_CDN_Misconfiguration_And_Edge_Info_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects external clients, as seen by network security appliance HTTP inspection, requesting CDN-edge diagnostic endpoints, object-storage-style listing parameters, or sensitive leftover files that are commonly exposed by CDN or origin misconfiguration. This is typical of adversaries harvesting CDN data about a victim before targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.004"
    mitre_technique_name = "Search Open Technical Databases: CDNs"
    log_prerequisites = "IDS/IPS or network security appliance HTTP inspection logs normalised to UDM NETWORK_HTTP, with network.http.method, target.url and principal.ip populated. TLS inspection or a reverse-proxy sensor is needed to see URLs."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, CDN health checks and edge-diagnostic tooling, SEO and uptime crawlers, developers and partners troubleshooting CDN routing, and legitimate storage clients using list-style query parameters against organisation-owned content."
    tuning_guidance = "Add scanner and attack-surface-management source addresses to %global_allowed_scanners. Add known partner or monitoring sources to %global_allowed_mgmt_sources. Raise severity or add an upstream threshold rule when the same source repeats these probes. Pair with WAF or CDN logs where available."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD)$/ nocase
    (
      $http.target.url = /\/cdn-cgi\/(trace|rum|l\/chk_)/ nocase or
      $http.target.url = /[?&](list-type=2|max-keys=|delimiter=|versions(&|=|$)|uploads(&|=|$))/ nocase or
      $http.target.url = /\/(\.git|\.svn|\.env|\.aws|\.ds_store|\.htpasswd|web\.config\.(bak|old)|wp-config\.php\.(bak|old|txt)|[^\/?]*(backup|dump)[^\/?]*\.(zip|tar|gz|sql|bak))(\/|\?|$)/ nocase
    )
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1596.004")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
