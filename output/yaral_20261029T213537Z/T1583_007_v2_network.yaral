/*
  MITRE Technique : T1583.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:11:13.569928+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_007_Serverless_Platform_Egress_NonBrowser_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests from a non-browser, scripted or automation HTTP client to hostnames that follow public serverless function and edge-worker naming structures. Adversaries stand up serverless runtimes as redirectors or C2 responders because the traffic blends into trusted cloud provider domains. Matching on platform hostname structure combined with a non-browser client identifier avoids any attacker-specific indicator."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.007"
    mitre_technique_name = "Acquire Infrastructure: Serverless"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection (SSL inspection or explicit proxy) that populate target.hostname and network.http.user_agent, normalised to UDM NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate internal applications and CI/CD jobs that call company-owned serverless APIs (edge workers, function URLs, API gateways); developer scripts using curl or Python against test functions; SaaS integrations and monitoring agents that call vendor-hosted serverless endpoints."
    tuning_guidance = "Add known-good serverless endpoints (corporate function domains, vendor webhook hosts) to %global_allowed_domains. Add trusted scanner and monitoring sources to %global_allowed_scanners. If client user-agent telemetry is not populated for a tenant, this rule will not fire and a DNS-based variant should be used instead."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.hostname = /(\.workers\.dev|\.pages\.dev|\.lambda-url\.[a-z0-9-]+\.on\.aws|\.execute-api\.[a-z0-9-]+\.amazonaws\.com|\.cloudfunctions\.net|\.run\.app|\.azurewebsites\.net|\.netlify\.app|\.vercel\.app)$/ nocase
    $net.network.http.user_agent = /(curl|wget|python|powershell|go-http-client|java\/|okhttp|libwww|winhttp|node-fetch|axios|undici)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1583.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $serverless_hosts = array_distinct($net.target.hostname)
    $user_agents = array_distinct($net.network.http.user_agent)
    $source_ips = array_distinct($net.principal.ip)

  condition:
    $net
}
