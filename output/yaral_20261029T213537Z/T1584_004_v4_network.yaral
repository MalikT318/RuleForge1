/*
  MITRE Technique : T1584.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:24:20.447687+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_004_Outbound_Direct_IP_Alt_Port_Server_Contact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host making an outbound TCP connection to an external address on an alternate web, admin or proxy port with no associated destination hostname. Third-party servers compromised by an adversary for staging or C2 are typically contacted this way, because the operator reaches the implant by raw IP on a non-standard service port rather than through a registered domain."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.004"
    mitre_technique_name = "Compromise Infrastructure: Server"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.direction populated. target.hostname is expected to be empty when no name was resolved or observed."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal applications or SaaS agents that talk to vendor APIs by raw IP on port 8080 or 8443, software update services, IoT or OT devices with hardcoded cloud endpoints, developer or test traffic, and unlogged DNS or SNI on the firewall (which leaves hostname empty)."
    tuning_guidance = "Add authorised scanners and known-good sources to %global_allowed_scanners. Add approved vendor destinations to %global_allowed_domains where the log carries a hostname. Narrow or extend the port list per client baseline. Consider raising severity for hosts whose destinations are first-seen."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.network.ip_protocol = "TCP"
    (
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 8888 or
      $net.target.port = 8000 or
      $net.target.port = 4443 or
      $net.target.port = 9001 or
      $net.target.port = 9090
    )
    $net.target.hostname = ""
    $net.target.ip != ""
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1584.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
