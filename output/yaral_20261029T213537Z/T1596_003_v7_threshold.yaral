/*
  MITRE Technique : T1596.003 - Digital Certificates
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:04:11.937298+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_003_External_TLS_Certificate_Harvesting_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens a high volume of connections to TLS service ports on perimeter assets within ten minutes. A single TLS handshake is benign, but this volume indicates certificate harvesting or TLS fingerprinting of the organisation's exposed services. Adversaries use it to learn organisation names, SAN hostnames and hosting details before targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.003"
    mitre_technique_name = "Search Open Technical Databases: Digital Certificates"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection telemetry normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated for inbound traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Internet-wide research scanners and search engine crawlers, uptime and availability monitors, CDN or WAF health probes, partner or customer integrations making frequent API connections, and externally hosted vulnerability scanners that are not yet allowlisted."
    tuning_guidance = "Add authorised external scanners and monitoring sources to %global_allowed_scanners. Raise or lower the #net threshold per client to match baseline inbound HTTPS volume. Review the distinct_destinations and destination_ports outcomes to separate wide sweeps from repeated use of a single service."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 443 or
      $net.target.port = 8443 or
      $net.target.port = 465 or
      $net.target.port = 993 or
      $net.target.port = 995 or
      $net.target.port = 636
    )
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $distinct_destinations = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $risk_score = if($event_count >= 200, 70, 45)
    $mitre_technique_id = array_distinct("T1596.003")
    $primary_entity = array_distinct($src)

  condition:
    #net >= 50
}
