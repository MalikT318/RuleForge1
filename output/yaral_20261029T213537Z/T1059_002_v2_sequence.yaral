/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:36:48.327007+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_AppleScript_Dropped_Then_Executed_By_Osascript {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an AppleScript file (.scpt, .scptd, .applescript, .osa) written to a user-writable staging location (temp, shared, Downloads, user Caches) and then run by osascript on the same host within five minutes. The file-drop-then-execute sequence is additive to single-event osascript command-line detections and catches staged AppleScript payloads from droppers, phishing downloads, and malicious installers."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "Requires macOS endpoint telemetry that produces both FILE_CREATION events with the creating process and PROCESS_LAUNCH events with full command lines."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developer and IT workflows that generate then run AppleScripts from temp folders, Automator or Script Editor exports, software installers that stage helper scripts, MDM and configuration management agents, and users running scripts downloaded from internal repositories."
    tuning_guidance = "Add approved deployment and MDM binaries to %global_allowed_admin_tools (matched on the file-creating process). Add trusted parent processes or hosts that legitimately run AppleScript to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If Downloads produces noise, narrow the staging-path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(scpt|scptd|applescript|osa)$/ nocase
    $file.target.file.full_path = /^\/(private\/)?(tmp|var\/tmp|var\/folders)\/|^\/Users\/Shared\/|^\/Users\/[^\/]+\/(Downloads|Library\/Caches)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/usr\/bin\/osascript$/ nocase
    $proc.target.process.command_line = /\.(scpt|scptd|applescript|osa)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($hostname)
    $dropped_script_paths = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $osascript_commands = array_distinct($proc.target.process.command_line)
    $osascript_parents = array_distinct($proc.principal.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
