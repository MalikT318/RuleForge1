/*
  MITRE Technique : T1584.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:24:01.536135+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_004_Compromised_Server_Script_POST_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client sending an HTTP POST to a server-side script endpoint (php/asp/aspx/jsp/cgi) on an external host over a non-standard port. This pattern is characteristic of command-and-control or staging through a compromised third-party web server running a script handler or web shell."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.004"
    mitre_technique_name = "Compromise Infrastructure: Server"
    log_prerequisites = "Requires perimeter proxy or firewall logs with HTTP inspection, normalised to NETWORK_HTTP with network.http.method, target.url and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS or partner APIs exposed on non-standard ports behind script endpoints, internally hosted applications published on external IPs, developer or test traffic to staging servers, and vendor update or telemetry services using custom ports."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Add approved scanner or testing source addresses to %global_allowed_scanners. Add approved management source addresses to %global_allowed_mgmt_sources. If non-standard web ports are common in a client environment, narrow the port condition or add the client's approved ports."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\.(php|aspx?|jsp|cgi)(\?|$)/ nocase
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.004")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
