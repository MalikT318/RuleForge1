/*
  MITRE Technique : T1037 - Boot or Logon Initialization Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:53:42.054112+00:00
  Reference       : https://attack.mitre.org/techniques/T1037
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_Perimeter_Mgmt_Session_Then_Device_Outbound_Script_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an externally sourced management session (SSH/Telnet) to a network device, followed within 10 minutes by that same device initiating an outbound TFTP or FTP transfer to a non-internal destination. This pattern is consistent with an adversary logging in to a device and having it pull a boot or startup script or configuration from external infrastructure, which gives persistence through boot or logon initialization."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037"
    mitre_technique_name = "Boot or Logon Initialization Scripts"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The logs must cover both inbound management traffic to the device and outbound traffic initiated by the device's own management or loopback address."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSP engineers managing devices from external addresses and then staging firmware or configuration over FTP/TFTP. Scheduled automated configuration backup or image pulls from an off-site server. Zero-touch provisioning of new devices."
    tuning_guidance = "Add approved management jump hosts and MSP egress addresses to %global_allowed_mgmt_sources. Add known vendor or update domains to %global_allowed_domains. Add automation or backup service account hosts to %global_allowed_admin_tools if they are visible in the logs. Narrow the destination ports if FTP is widely used for legitimate backups in the environment."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    not $mgmt.principal.ip in %rfc1918_internal
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    $mgmt.target.ip = $device_ip

    $pull.metadata.event_type = "NETWORK_CONNECTION"
    ($pull.target.port = 69 or $pull.target.port = 21)
    not $pull.target.ip in %rfc1918_internal
    not $pull.target.ip in %global_allowed_mgmt_sources
    not $pull.target.hostname in %global_allowed_domains
    $pull.principal.ip = $device_ip

    $mgmt.metadata.event_timestamp.seconds <= $pull.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1037")
    $primary_entity = array_distinct($device_ip)
    $mgmt_source_ips = array_distinct($mgmt.principal.ip)
    $fetch_destination_ips = array_distinct($pull.target.ip)
    $fetch_ports = array_distinct($pull.target.port)
    $fetch_count = count($pull.metadata.id)

  condition:
    $mgmt and $pull
}
