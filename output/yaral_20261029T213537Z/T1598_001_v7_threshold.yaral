/*
  MITRE Technique : T1598.001 - Spearphishing Service
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:12:43.776655+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_001_Excessive_Personal_Messaging_Webmail_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Low"
    description = "Detects a single internal host generating a high volume of HTTP requests to external webmail or messaging-style hostnames within ten minutes. This is a low-fidelity precursor signal for users engaging with spearphishing delivered through personal webmail or messaging services, which are outside enterprise mail controls. A single request is benign. Sustained volume from one host is worth analyst triage, especially when correlated with later credential-entry or file-download activity."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.001"
    mitre_technique_name = "Phishing for Information: Spearphishing Service"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_HTTP with principal.hostname and target.hostname populated. Logs must be able to see HTTP hostnames (SNI or proxy inspection)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees legitimately using personal webmail or chat services, corporate collaboration and chat platforms not yet in the allowed-domains list, help-desk or support chat widgets, shared kiosks or VDI hosts that aggregate many users behind one hostname, and automated mail-client polling."
    tuning_guidance = "Add sanctioned mail, chat and collaboration domains to %global_allowed_domains. Add jump hosts and VDI gateways to %global_allowed_remote_mgmt if they are the grouping entity. Raise the #http threshold for noisy environments. If the firewall does not populate principal.hostname, normalise the host or user identity upstream. Corroborate with proxy category data where available."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.hostname = $host
    $http.target.hostname = /(webmail|messenger|inbox|chat|(^|[.-])mail[.-])/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_remote_mgmt

  match:
    $host over 10m

  outcome:
    $risk_score = max(35)
    $event_count = count($http.metadata.id)
    $distinct_destinations = array_distinct($http.target.hostname)
    $mitre_technique_id = array_distinct("T1598.001")
    $primary_entity = array_distinct($host)

  condition:
    #http >= 25
}
