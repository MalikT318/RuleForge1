/*
  MITRE Technique : T1069 - Permission Groups Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:00:36.003775+00:00
  Reference       : https://attack.mitre.org/techniques/T1069
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_Windows_SAM_Client_Library_Loaded_By_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a script host or LOLBin interpreter loading the Windows SAM client libraries (samcli.dll / samlib.dll), which expose the local and domain user and group enumeration APIs. This is module-load telemetry and does not depend on command-line text. It catches in-memory or API-based group discovery that never launches net.exe, for example PowerShell or .NET reflection calling NetLocalGroupEnum and SamEnumerate*. The Windows-only platform requirement for this task overrides the alternate-platform angle, so this variant gets its additive coverage from PROCESS_MODULE_LOAD instead of PROCESS_LAUNCH."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069"
    mitre_technique_name = "Permission Groups Discovery"
    log_prerequisites = "Requires Windows endpoint module/image-load telemetry (EDR image-load events or Sysmon Event ID 7) normalised to PROCESS_MODULE_LOAD, with the loaded module in target.process.file.full_path and the loading process in principal.process.file.full_path. Image-load logging must be enabled and not filtered at the sensor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrative PowerShell modules (local account and group cmdlets), inventory and compliance scripts, RMM and patching agents running scripts, IT helpdesk tooling, logon scripts that check group membership, and some installers calling rundll32 to query local groups."
    tuning_guidance = "Add approved admin and inventory binaries to %global_allowed_admin_tools, trusted script-running hosts to %global_allowed_script_hosts, and named administrator accounts to %global_allowed_admin_users. Add EDR and security agents to %global_allowed_security_tools. If PowerShell is too noisy, keep the rule on the non-PowerShell interpreters and send PowerShell to a threshold variant."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.process.file.full_path = /\\(samcli|samlib)\.dll$/ nocase
    $mod.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil|regasm|regsvcs)\.exe$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.hostname in %global_allowed_script_hosts
    not $mod.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1069")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $loaded_module = array_distinct($mod.target.process.file.full_path)
    $acting_user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
