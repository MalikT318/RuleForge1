/*
  MITRE Technique : T1590.002 - DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:15:14.542822+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_002_External_TCP_DNS_Zone_Transfer_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-internal) source opening a TCP session to port 53 on a protected host as seen by an IDS/IPS or network security appliance. Zone transfer (AXFR/IXFR) attempts and bulk record enumeration use TCP/53, whereas ordinary external DNS lookups use UDP/53. This indicates possible adversary DNS reconnaissance against the organisation's authoritative name servers."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.002"
    mitre_technique_name = "Gather Victim Network Information: DNS"
    log_prerequisites = "IDS/IPS or network security appliance logs that record connection events with source IP, destination IP, destination port and IP protocol, mapped to UDM NETWORK_CONNECTION. The sensor must sit on the perimeter or in front of authoritative DNS servers so it sees inbound traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate secondary or partner name servers performing scheduled zone transfers; external recursive resolvers falling back to TCP for truncated or large (DNSSEC, TXT) responses; authorised external vulnerability scanners and attack-surface monitoring; DNS health-check or monitoring services; MSSP or customer pen-test sources."
    tuning_guidance = "Add known secondary DNS and partner name server source addresses to %global_allowed_mgmt_sources. Add authorised scanning and attack-surface monitoring sources to %global_allowed_scanners. If TCP fallback from public resolvers is noisy, restrict deployment to sensors in front of authoritative DNS servers only. Consider a companion Threshold rule that counts repeated TCP/53 sessions per source."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    $net.network.ip_protocol = "TCP"
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1590.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_hostnames = array_distinct($net.target.hostname)

  condition:
    $net
}
