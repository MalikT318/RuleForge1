/*
  MITRE Technique : T1593 - Search Open Websites/Domains
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:42:22.597077+00:00
  Reference       : https://attack.mitre.org/techniques/T1593
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_Search_Engine_Dork_Referral_To_External_Asset {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects inbound HTTP requests to an external-facing asset whose referral URL carries a search query using advanced search operators (inurl, intitle, intext, filetype and similar). This is the observable residue of an adversary using search-engine dorking to locate pages, documents or exposed content belonging to the organisation. Detection keys on the operator syntax in the referring query string, not on any specific search provider or domain."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593"
    mitre_technique_name = "Search Open Websites/Domains"
    log_prerequisites = "Requires IDS/IPS or inline network security appliance HTTP inspection that populates network.http.referral_url for traffic inbound to external-facing web assets. HTTPS must be decrypted, or inspected at a reverse proxy or WAF tier, for the referral header to be visible."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security researchers or bug-bounty participants using dorks against in-scope assets; the organisation's own red team and OSINT or brand-protection services; SEO and web-crawler audit tooling; web admins checking their own site's indexing; occasional technically minded visitors using operator syntax for legitimate searches."
    tuning_guidance = "Add authorised external scanners and testing sources to %global_allowed_scanners. Add monitored brand-protection and OSINT provider source addresses to the same list. Treat this as a low-severity enrichment signal. Escalate when the same source IP then shows probing of the URLs or documents the dork targeted. Narrow the operator list or query-parameter names if a client's own search features generate matches."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.referral_url = /[?&#](q|query|p|text|wd|k|search)=[^&]*(inurl|intitle|intext|allinurl|allintitle|allintext|inanchor|filetype)(:|%3a|%253a)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1593")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_urls = array_distinct($http.target.url)
    $referral_urls = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
