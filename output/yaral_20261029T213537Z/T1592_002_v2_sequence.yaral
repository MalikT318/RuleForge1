/*
  MITRE Technique : T1592.002 - Software
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:37:31.910130+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_002_External_Port_Probe_Then_Version_Disclosure_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An external source probes several common service ports on one perimeter destination and then requests version-disclosing web paths (server status, phpinfo, version, readme, changelog) on the same destination within ten minutes. This pattern is typical of active software and banner reconnaissance of internet-facing hosts."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.002"
    mitre_technique_name = "Gather Victim Host Information: Software"
    log_prerequisites = "Requires perimeter firewall or proxy logs that normalise to UDM NETWORK_CONNECTION (with principal.ip, target.ip, target.port) and NETWORK_HTTP (with target.url and network.http.method). Both must record the external source address, not a NAT address."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and external attack-surface monitoring services not yet in the allowlist, search-engine and uptime crawlers, customer or partner health checks, and legitimate users browsing release notes or readme pages after hitting several ports."
    tuning_guidance = "Add authorised scanner and ASM source addresses to %global_allowed_scanners. Raise the #net threshold or widen the port list for noisy environments. Extend or narrow the URL regex to match the web stack exposed by the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 25 or
      $net.target.port = 80 or
      $net.target.port = 110 or
      $net.target.port = 143 or
      $net.target.port = 443 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD|OPTIONS)$/ nocase
    $http.target.url = /\/(server-status|server-info|phpinfo\.php|info\.php|version|readme(\.txt|\.md|\.html)?|changelog(\.txt|\.md)?|release-notes|license\.txt)(\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip
    $http.target.ip = $dst_ip

    $net.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1592.002")
    $primary_entity = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)
    $probe_count = count($net.metadata.id)
    $requested_urls = array_distinct($http.target.url)
    $target_ips = array_distinct($net.target.ip)

  condition:
    #net >= 3 and $http
}
