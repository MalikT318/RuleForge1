/*
  MITRE Technique : T1592.003 - Firmware
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:39:27.005852+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_003_External_Firmware_Inventory_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting out-of-band management API resources that expose host firmware details (firmware inventory, BIOS settings, update service) through a perimeter proxy, WAF or firewall with HTTP inspection. External parties that query these endpoints are gathering firmware type and version information for targeting. Internal sources, approved scanners and approved management sources are excluded."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.003"
    mitre_technique_name = "Gather Victim Host Information: Firmware"
    log_prerequisites = "Requires perimeter proxy, reverse proxy, WAF or firewall logs with HTTP inspection that populate NETWORK_HTTP with principal.ip and target.url. Needs visibility of inbound requests to published services."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners or attack-surface monitoring services not yet in the scanner list, vendor or MSP remote hardware support portals, and legitimate remote administrators reaching a published management interface. Internet-wide research scanners will also trigger this rule and are low-priority noise, but an exposed management interface is itself a finding."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners and approved administrator or vendor source addresses to %global_allowed_mgmt_sources. Combine with response-code context in triage: a successful response means the firmware inventory is exposed to the internet and should be remediated. Raise severity if the target host is known to be a server BMC."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(redfish\/v1\/(UpdateService|Systems\/[^\/?]+\/(Bios|FirmwareInventory)|Managers\/[^\/?]+\/(NetworkProtocol|EthernetInterfaces))|rest\/v1\/(UpdateService|Systems|Managers))(\/|\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1592.003")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
