/*
  MITRE Technique : T1593.003 - Code Repositories
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:47:19.903163+00:00
  Reference       : https://attack.mitre.org/techniques/T1593/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_003_External_Probe_For_Exposed_Code_Repository_Metadata {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting version-control metadata paths (.git, .svn, .hg, .bzr) from an organisation's web servers, as seen by an IDS/IPS or network security appliance. This is the only part of T1593.003 that is visible in victim-side telemetry. The adversary's searches of third-party public repositories (GitHub, GitLab, etc.) never touch victim infrastructure. Successful retrieval of repository metadata exposes source code, embedded credentials, API keys and employee names, which is the same information adversaries seek in public repositories."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593.003"
    mitre_technique_name = "Search Open Websites/Domains: Code Repositories"
    log_prerequisites = "IDS/IPS or network security appliance logs with HTTP inspection that populate target.url and the source address (principal.ip), normalised to NETWORK_HTTP. Requires visibility of inbound HTTP or decrypted HTTPS traffic to externally exposed web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface-management services, penetration tests, bug-bounty researchers, CI/CD or deployment systems that legitimately fetch repository metadata over HTTP from an external address, and opportunistic internet-wide scanners (high volume, low targeting value)."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add approved deployment or management source addresses to %global_allowed_mgmt_sources. Escalate severity when the same source probes several hosts, or when the appliance reports a successful (2xx) response. Where the response code is reliably populated, add a network.http.response_code filter to alert only on successful retrievals. For noisy internet-facing estates, route the alert to a low-priority queue unless the appliance verdict shows the request was allowed."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/\.(git|svn|hg|bzr)(\/|$)(config|HEAD|index|entries|packed-refs|wc\.db|logs\/HEAD|objects|refs|branches|dirstat)?/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1593.003")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $http_response_codes = array_distinct($net.network.http.response_code)

  condition:
    $net
}
