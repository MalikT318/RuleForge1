/*
  MITRE Technique : T1596.002 - WHOIS
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:01:22.700990+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_002_WHOIS_Outbound_Port43_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a network connection to TCP/43 (WHOIS) on an external address, as seen by an IDS/IPS or network security appliance. WHOIS queries are a common way for adversaries to gather registrant, netblock and nameserver data before targeting. A single connection is a reconnaissance indicator, not proof of compromise. Use it to enrich and prioritise other alerts for the same source."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.002"
    mitre_technique_name = "Search Open Technical Databases: WHOIS"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection logs normalised to UDM NETWORK_CONNECTION with target.ip, target.port and principal.ip populated. The appliance must see egress traffic (or traffic mirrored from the egress path)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Domain administrators and IT staff doing legitimate registrar lookups; brand-protection and threat-intelligence teams; authorised security assessments and vulnerability scanners enriching targets; mail gateways or anti-abuse tooling that performs WHOIS lookups; legacy network inventory scripts."
    tuning_guidance = "Add approved scanner and assessment source IPs to %global_allowed_scanners. Add approved management or jump-host source addresses to %global_allowed_mgmt_sources. Make sure %rfc1918_internal covers every internal range used by the client so internal WHOIS-like services are excluded. To reduce volume, deploy as a low-severity enrichment rule or promote to a threshold rule when a single source queries many distinct WHOIS servers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 43
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
