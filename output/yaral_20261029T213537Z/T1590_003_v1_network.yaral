/*
  MITRE Technique : T1590.003 - Network Trust Dependencies
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:16:56.771500+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_003_External_Trust_Metadata_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting identity-federation and trust metadata endpoints (federation metadata documents, WS-Trust/MEX endpoints, SAML IdP metadata, ADFS trust services) as seen in IPS or network security appliance HTTP inspection. These documents reveal federated partners, token-signing relationships and third-party trust dependencies, so requests to them are consistent with reconnaissance of network trust dependencies ahead of targeting or Trusted Relationship abuse."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.003"
    mitre_technique_name = "Gather Victim Network Information: Network Trust Dependencies"
    log_prerequisites = "IPS or network security appliance with HTTP inspection that populates target.url and principal.ip in NETWORK_HTTP events. For HTTPS, TLS inspection or a termination point visible to the sensor is required."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate federation partners and SaaS service providers fetching metadata during trust setup or certificate rollover; identity-aware cloud applications polling metadata documents; authorised external attack-surface or penetration test scans; uptime and monitoring services checking federation endpoints."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners. Source addresses of known federation partners can be added to the same list or handled with a client-specific allowlist. If a client does not publish federation services externally, consider raising severity. If a client has many partners, restrict the URL pattern to the metadata and MEX paths only."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(federationmetadata\/[0-9\-]+\/federationmetadata\.xml|federationmetadata\.xml|\/adfs\/services\/trust|\/adfs\/ls\/idpinitiatedsignon|\/trust\/mex|\/services\/trust\/mex|\/ws-trust|\/saml2?\/(idp\/)?metadata|\/idp\/shibboleth|\/sts\/metadata)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1590.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
