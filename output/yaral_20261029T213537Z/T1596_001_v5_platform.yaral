/*
  MITRE Technique : T1596.001 - DNS/Passive DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:59:56.810971+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_001_IPS_External_DNS_Recon_Signature {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IDS/IPS detection or prevention verdict on DNS-port traffic (port 53) from an external source, where the signature indicates DNS reconnaissance such as zone transfer (AXFR/IXFR) attempts, subdomain enumeration or brute forcing, or DNS information disclosure. Adversaries query victim-owned nameservers directly to map subdomains, mail servers and internal addressing."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.001"
    mitre_technique_name = "Search Open Technical Databases: DNS/Passive DNS"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION, with signature name or summary populated in security_result for traffic to DNS servers. Passive DNS lookups against third-party repositories are not visible to this rule. Only direct queries against the victim's nameservers are."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface management services, secondary or partner nameservers legitimately performing zone transfers, third-party DNS hosting or migration providers, and red team or penetration test activity."
    tuning_guidance = "Add approved scanner source IPs to %global_allowed_scanners. Add known secondary nameserver and partner source IPs to %global_allowed_mgmt_sources. If the appliance maps signature names to a different security_result field, adjust the field in the regex group. Raise severity for source IPs that also appear in later web or VPN login events."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    not $net.principal.ip in %rfc1918_internal
    (
      $net.security_result.rule_name = /(?i)(axfr|ixfr|zone[\s_\-]?transfer|dns[\s_\-]?(enum|recon|brute|footprint|info[\s_\-]?(leak|disclos))|subdomain[\s_\-]?(enum|brute)|dns[\s_\-]?(version|bind)[\s_\-]?(query|probe)?)/ or
      $net.security_result.summary = /(?i)(axfr|ixfr|zone[\s_\-]?transfer|dns[\s_\-]?(enum|recon|brute|footprint|info[\s_\-]?(leak|disclos))|subdomain[\s_\-]?(enum|brute)|dns[\s_\-]?(version|bind)[\s_\-]?(query|probe)?)/ or
      $net.security_result.description = /(?i)(axfr|ixfr|zone[\s_\-]?transfer|dns[\s_\-]?(enum|recon|brute|footprint|info[\s_\-]?(leak|disclos))|subdomain[\s_\-]?(enum|brute))/
    )
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1596.001")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_dns_servers = array_distinct($net.target.ip)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
