/*
  MITRE Technique : T1069 - Permission Groups Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:00:14.978660+00:00
  Reference       : https://attack.mitre.org/techniques/T1069
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// NOTE: the request combines meta.platform = "SaaS" with log_source = "linux_endpoint".
// The rule logic targets SaaS audit-log telemetry (the platform requirement).
// log_source is set exactly as supplied, so confirm the mapping before deployment.
rule MSSP_T1069_SaaS_Group_Membership_Export_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an exported file artifact (CSV/XLSX/JSON/TXT) whose name indicates a dump of group, role, or permission membership in a SaaS application. Detects the resulting state change (the export artifact) rather than command-line activity, which covers bulk permission-group discovery through admin consoles, reporting features, or API-driven exports."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069"
    mitre_technique_name = "Permission Groups Discovery"
    log_prerequisites = "SaaS application audit logs normalised to UDM FILE_CREATION events with target.file.full_path and principal.user.userid populated (for example collaboration, storage, or identity-provider admin export events). No endpoint process telemetry is required."
    platform = "SaaS"
    log_source = "linux_endpoint"
    false_positives = "Access reviews and recertification campaigns, internal audit and compliance exports, IT administrators reconciling group membership, identity governance tooling, onboarding and offboarding reports."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or governance accounts to %global_allowed_service_accounts. Raise severity when the user is not an administrator or the export occurs outside business hours."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.user.userid != ""
    (
      $file.target.file.full_path = /(group|role|permission|entitlement)s?[^\/]*(member|membership|export|dump|report|assignment|list)[^\/]*\.(csv|xlsx|json|txt)$/ nocase or
      $file.target.file.full_path = /(member|membership|export|dump|report|assignment|list)[^\/]*(group|role|permission|entitlement)s?[^\/]*\.(csv|xlsx|json|txt)$/ nocase
    )
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1069")
    $primary_entity = array_distinct($file.principal.user.userid)
    $exported_files = array_distinct($file.target.file.full_path)
    $source_ips = array_distinct($file.principal.ip)

  condition:
    $file
}
