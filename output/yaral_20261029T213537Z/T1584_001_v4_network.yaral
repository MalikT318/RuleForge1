/*
  MITRE Technique : T1584.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:18:36.958227+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_001_DNS_Shadowed_Subdomain_Random_Label_Resolves {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects successful DNS resolution of a subdomain whose leftmost label is long, random-looking and alphanumeric (mixed letters and digits) under a parent domain that is not on the known-good list. Domain shadowing and hijacked-domain abuse typically create many machine-generated subdomains under a legitimate registered domain, and these resolve only while the adversary's records are live. This is a network-side proxy for T1584.001 and is best used as an indicator of hijacked or shadowed infrastructure being contacted."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.001"
    mitre_technique_name = "Compromise Infrastructure: Domains"
    log_prerequisites = "Requires DNS query/resolver logs normalised to NETWORK_DNS with network.dns.questions.name and network.dns.answers.data populated, and the tenant reference lists %global_allowed_domains and %rfc1918_internal."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud edge hostnames with machine-generated labels, email security and anti-spam DNS lookups, software update and telemetry services, DNS-based blocklist lookups, and tracking or marketing platforms using unique per-recipient subdomains."
    tuning_guidance = "Add the registered parent domains of legitimate generated-subdomain services to %global_allowed_domains. Adjust the label length threshold (18 to 63) upward to reduce noise or downward for more coverage. Ensure internal resolution results are covered by %rfc1918_internal. Review hits against the parent domain's age and prior subdomain history."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.response_code = 0
    $dns.network.dns.answers.data != ""
    $dns.network.dns.questions.name = /^[a-z0-9]{18,63}\./ nocase
    $dns.network.dns.questions.name = /^[a-z0-9]*[0-9]/ nocase
    $dns.network.dns.questions.name = /^[0-9]*[a-z]/ nocase
    $parent = strings.to_lower(re.capture($dns.network.dns.questions.name, `([^.]+\.[^.]+)\.?$`))
    $parent != ""
    not $parent in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.001")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $parent_domains = array_distinct($parent)
    $resolved_answers = array_distinct($dns.network.dns.answers.data)
    $client_hostnames = array_distinct($dns.principal.hostname)

  condition:
    $dns
}
