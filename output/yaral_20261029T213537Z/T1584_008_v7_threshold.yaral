/*
  MITRE Technique : T1584.008 - Network Devices
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:33:38.217514+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_008_External_Source_Repeated_Mgmt_Port_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source address makes repeated connections to network-device management and remote administration ports within ten minutes. Each connection is benign on its own, but the volume matches compromised SOHO or edge devices being used to probe or brute-force perimeter devices, or acting as relay infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.008"
    mitre_technique_name = "Compromise Infrastructure: Network Devices"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. The logs must cover inbound traffic from the internet."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners, MSP or vendor remote support from fixed public addresses, monitoring probes, cloud-hosted admin jump hosts, and legitimate remote admins reconnecting repeatedly after session drops."
    tuning_guidance = "Add authorised scanners to %global_allowed_scanners and trusted admin source addresses to %global_allowed_mgmt_sources. Raise the #net threshold in high-noise environments, or lower it for devices that should never expose management ports. Adjust the port list to the management services exposed in the client environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 2323 or
      $net.target.port = 7547 or
      $net.target.port = 8291 or
      $net.target.port = 8728 or
      $net.target.port = 8443
    )
    $net.principal.ip = $src_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port = 23 or $net.target.port = 2323 or $net.target.port = 7547, 75, 55))
    $mitre_technique_id = array_distinct("T1584.008")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 15
}
