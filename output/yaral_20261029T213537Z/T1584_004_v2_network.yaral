/*
  MITRE Technique : T1584.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:23:45.288218+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_004_Payload_Staging_From_Bare_IP_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client retrieving an executable, script, or archive payload over HTTP(S) from an external server addressed by a bare IP literal, with no domain name. Third-party servers that an adversary has compromised and repurposed for staging are typically reached this way, because no domain has been registered for them. The rule works on the network side only and does not depend on the initiating process."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.004"
    mitre_technique_name = "Compromise Infrastructure: Server"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL-level visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP with target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Vendor appliance or firmware updates fetched from a literal IP, internal-facing software distribution from public IPs, CDN or cloud storage endpoints addressed by IP, legitimate IT scripts pulling installers from IP-addressed repositories, authorised red team or scanner traffic."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains and authorised scanning or testing sources to %global_allowed_scanners. If the tenant has many IP-addressed update servers, narrow the extension list. Confirm the proxy logs the full URL; without it the rule will not fire."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /^https?:\/\/[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]{1,5})?\/[^?#]*\.(exe|dll|msi|ps1|bat|hta|vbs|jar|sh|bin|elf|zip|7z|rar|iso)([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584.004")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
