/*
  MITRE Technique : T1590 - Gather Victim Network Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:13:16.667200+00:00
  Reference       : https://attack.mitre.org/techniques/T1590
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_IPS_External_Source_Network_Probing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source generates a high volume of connection events recorded by the IPS within 10 minutes. Each event is benign on its own, but the volume matches network reconnaissance such as sweeping or enumerating a victim's address space and exposed services. The risk score rises as the event count grows."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590"
    mitre_technique_name = "Gather Victim Network Information"
    log_prerequisites = "IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The sensor must see inbound internet-facing traffic, including traffic it blocks or alerts on."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and external attack-surface assessments not yet allowlisted, search-engine and internet-measurement crawlers, uptime and monitoring probes, busy NAT gateways or proxies that aggregate many users behind one address, and load tests."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners, and approved management or monitoring sources to %global_allowed_mgmt_sources. Raise the #net threshold on sensors in front of very busy services, or lower it for quiet segments. Scale the risk_score tiers in outcome to client appetite."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.port > 0
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = if($event_count >= 500, 85, if($event_count >= 200, 70, 50))
    $mitre_technique_id = array_distinct("T1590")
    $primary_entity = array_distinct($src_ip)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 100
}
