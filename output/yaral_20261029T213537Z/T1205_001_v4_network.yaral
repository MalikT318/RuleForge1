/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:13:58.316206+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Port_Knock_Sequence_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "An external source makes connection attempts to a small, bounded set of distinct destination ports on one perimeter address within a short window. This is the network signature of a port-knock sequence (3 to 8 distinct ports). Wide port sweeps are deliberately excluded by an upper bound, so this does not duplicate scan detections. Common service ports are excluded to reduce noise."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Perimeter firewall or network device connection logs, including denied or dropped connection attempts, normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. If drops are not logged, knock packets to closed ports are invisible to this rule."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Unauthorised or unlisted vulnerability scanners and internet-wide research scanners probing a few ports. Misconfigured clients or applications retrying across several alternate ports. VoIP/SIP or gaming clients using port ranges. Sanctioned port-knocking admin access from remote staff. Peer-to-peer or NAT traversal traffic."
    tuning_guidance = "Add authorised scanners to %global_allowed_scanners and approved admin or remote-access source addresses (including legitimate knock users) to %global_allowed_mgmt_sources. Adjust the distinct-port range in the condition, and the 5m window, to suit client traffic volume. Extend the excluded service-port list for environments that expose other common services. Correlate hits with a later successful inbound connection to the same destination from the same source to raise confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    $net.target.ip = $dst
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 123
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src, $dst over 5m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($dst)
    $source_ips = array_distinct($src)
    $distinct_ports = count_distinct($net.target.port)
    $knocked_ports = array_distinct($net.target.port)
    $attempt_count = count($net.metadata.id)

  condition:
    $net and $distinct_ports >= 3 and $distinct_ports <= 8 and $attempt_count >= 3
}
