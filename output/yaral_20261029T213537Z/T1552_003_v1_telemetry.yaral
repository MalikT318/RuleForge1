/*
  MITRE Technique : T1552.003 - Shell History
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:37:41.728294+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_003_macOS_Shell_History_Staged_Copy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file whose name matches a shell history artifact (zsh, bash, fish or sh history, or zsh session files) in a world-writable staging location or on a mounted volume. This is the file-artifact result of an adversary copying, archiving or dumping shell history to search it for credentials or to exfiltrate it. It pivots on the resulting file rather than the command line, so it still fires when the copy tool is renamed or command-line logging is evaded."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.003"
    mitre_technique_name = "Unsecured Credentials: Shell History"
    log_prerequisites = "macOS endpoint telemetry that records file creation events with the target file path and the initiating process path (for example Endpoint Security framework based file events)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Backup or migration tooling copying home directories to /Volumes, MDM or IT support staging of user profiles for device refresh, developers or admins deliberately archiving dotfiles, and forensic or incident response collection."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes, EDR and security agents to %global_allowed_security_tools, and IT migration or deployment tools to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users if collection by IT staff is routine. Narrow or widen the staging directory list in the regex to suit the client environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(tmp|private\/tmp|var\/tmp|private\/var\/tmp|Users\/Shared|Volumes\/[^\/]+)\/.*(zsh_history|bash_history|fish_history|zsh_sessions|sh_history)/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1552.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $staged_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
