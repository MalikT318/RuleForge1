/*
  MITRE Technique : T1585.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:38:36.301916+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_003_Cloud_Account_Signup_HTTP_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects HTTP POST requests to external hosts on URL paths characteristic of account registration or sign-up flows. This is the network-side footprint of cloud account creation (storage, VPS, serverless) that may be used to stage tooling, exfiltrate data or acquire infrastructure. Allowed domains and internal destinations are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.003"
    mitre_technique_name = "Establish Accounts: Cloud Accounts"
    log_prerequisites = "Requires firewall or proxy logs with HTTP/URL inspection (TLS inspection or explicit proxy) that populate network.http.method, target.url and target.hostname."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees legitimately registering for SaaS trials or vendor portals, marketing and procurement staff, developers creating sandbox cloud accounts, conference or webinar registrations, and customer-facing registration pages on partner sites."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Confirm internal destinations are covered by %rfc1918_internal. Raise severity when a source repeatedly hits sign-up paths on unsanctioned storage or hosting providers, or when it is combined with later large uploads to the same destination. Consider pairing with a threshold variant for rapid repeated registrations from a single source."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|account\/create|start[-_]?free[-_]?trial)(\/|\?|$)/ nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1585.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $source_ips = array_distinct($net.principal.ip)

  condition:
    $net
}
