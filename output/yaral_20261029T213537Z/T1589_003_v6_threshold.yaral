/*
  MITRE Technique : T1589.003 - Employee Names
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:11:30.842862+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_003_Employee_Directory_Harvesting_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source makes a high volume of HTTP requests to staff directory, team page, and author or user enumeration paths within ten minutes. Each request is benign on its own. The volume suggests scripted harvesting of employee names for email derivation and phishing lures."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.003"
    mitre_technique_name = "Gather Victim Identity Information: Employee Names"
    log_prerequisites = "Requires proxy, WAF, or perimeter firewall HTTP logs with URL visibility (reverse proxy or TLS inspection) normalised to NETWORK_HTTP, with principal.ip and target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Search engine and SEO crawlers, uptime or content monitors, authorised vulnerability scanners and penetration tests, partner or recruiter integrations that sync staff pages, CMS plugins calling their own user or author endpoints."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add approved partner or monitoring sources to %global_allowed_mgmt_sources. Raise the #net threshold on high-traffic public sites with large staff directories. Adjust the path regex to match the customer's CMS and site structure."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.target.url = /(?i)(\/(staff|our-team|the-team|team|people|leadership|management|executives|employees|directory|meet-the[a-z-]*|about\/team|about-us\/team|contact\/directory)(\/|\?|$)|[?&]author=\d+|\/wp-json\/wp\/v2\/users|\/author\/[^\/]+)/
    not $net.network.http.user_agent = /(?i)(googlebot|bingbot|duckduckbot|baiduspider|yandexbot|applebot)/

  match:
    $src over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1589.003")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $requested_urls = array_distinct($net.target.url)
    $target_hosts = array_distinct($net.target.hostname)

  condition:
    #net >= 15
}
