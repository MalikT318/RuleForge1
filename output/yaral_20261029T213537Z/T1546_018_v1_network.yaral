/*
  MITRE Technique : T1546.018 - Python Startup Hooks
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:32:18.801829+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_018_Python_Library_HTTP_Egress_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP(S) requests to external destinations carrying a Python HTTP-library user agent, as seen at a firewall or proxy. A malicious .pth, sitecustomize.py or usercustomize.py hook runs on every Python start, so it can beacon or fetch a second stage each time. This gives network-side coverage that complements endpoint process and file rules. It does not rely on process fields, which perimeter logs do not carry."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.018"
    mitre_technique_name = "Event Triggered Execution: Python Startup Hooks"
    log_prerequisites = "Requires firewall or web-proxy logs normalised to UDM NETWORK_HTTP with network.http.user_agent and target.hostname populated. TLS-inspecting proxies give the best coverage, because without inspection the user agent is not visible for HTTPS."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Legitimate Python automation, such as pip or package installs, Homebrew Python tooling, data-science notebooks, developer scripts, and monitoring or cloud CLI tools built on Python HTTP libraries. Corporate patching and inventory scripts that use urllib or requests."
    tuning_guidance = "Add known-good vendor, package-index and update domains to %global_allowed_domains. Add build servers, developer jump hosts and approved automation hosts to %global_allowed_script_hosts. If the proxy or firewall enriches asset platform data, add a macOS asset filter to narrow scope. For higher fidelity, correlate hits with endpoint FILE_CREATION events for .pth, sitecustomize.py or usercustomize.py under a site-packages directory."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(python-requests|python-urllib|python-httpx|aiohttp|urllib3|python\/\d)/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1546.018")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
