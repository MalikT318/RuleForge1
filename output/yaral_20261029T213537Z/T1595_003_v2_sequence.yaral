/*
  MITRE Technique : T1595.003 - Wordlist Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:55:52.938499+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_003_Wordlist_Scan_404_Burst_Then_Sensitive_Hit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects wordlist-style content discovery against web infrastructure. One external source generates a burst of HTTP 404 responses across many distinct URLs, then receives a successful (200) response on a sensitive path such as an admin, login, backup or configuration endpoint, all within 10 minutes. The burst followed by a hit indicates the scan found hidden content."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.003"
    mitre_technique_name = "Active Scanning: Wordlist Scanning"
    log_prerequisites = "Requires perimeter proxy, web gateway or firewall logs with HTTP inspection that populate principal.ip, target.url and network.http.response_code. Raw L3/L4 connection logs without HTTP fields will not trigger this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests not yet in the scanner list; search-engine and SEO crawlers hitting stale URLs; uptime or link-checker monitors; broken-link storms after a site migration followed by a legitimate visit to a login page."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add trusted management or monitoring sources to %global_allowed_mgmt_sources if they are common false-positive sources. Raise or lower the #miss threshold (default 25) based on the client's baseline of 404 noise. Extend the sensitive-path regex in $hit with application-specific admin paths per client."

  events:
    $miss.metadata.event_type = "NETWORK_HTTP"
    $miss.network.http.response_code = 404
    not $miss.principal.ip in %rfc1918_internal
    not $miss.principal.ip in %global_allowed_scanners
    not $miss.principal.ip in %global_allowed_mgmt_sources
    $miss.principal.ip = $src

    $hit.metadata.event_type = "NETWORK_HTTP"
    $hit.network.http.response_code = 200
    $hit.target.url = /\/(admin|administrator|wp-admin|wp-login|login|phpmyadmin|manager|console|dashboard|backup|backups|config|\.git|\.env|\.svn|\.htpasswd|server-status|actuator)([\/\?\.]|$)/ nocase
    not $hit.principal.ip in %rfc1918_internal
    not $hit.principal.ip in %global_allowed_scanners
    not $hit.principal.ip in %global_allowed_mgmt_sources
    $hit.principal.ip = $src

    $miss.metadata.event_timestamp.seconds <= $hit.metadata.event_timestamp.seconds

  match:
    $src over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1595.003")
    $primary_entity = array_distinct($src)
    $distinct_missed_urls = count_distinct($miss.target.url)
    $sensitive_urls_found = array_distinct($hit.target.url)
    $targeted_hosts = array_distinct($hit.target.hostname)
    $first_probe_time = min($miss.metadata.event_timestamp.seconds)
    $hit_time = max($hit.metadata.event_timestamp.seconds)

  condition:
    #miss >= 25 and $hit
}
