/*
  MITRE Technique : T1586.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:44:14.933880+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_002_Direct_External_Mail_Submission_From_Internal_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal source connecting to an external address on SMTP or mail-submission ports (25, 465, 587) at the network perimeter. This is the network footprint of a compromised or attacker-controlled mailbox, or of a host with stolen mail credentials, being used to send phishing or spam directly to an external mail service. It is perimeter-only coverage and does not depend on endpoint process or command-line data."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.002"
    mitre_technique_name = "Compromise Accounts: Email Accounts"
    log_prerequisites = "Requires firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress traffic on ports 25, 465 and 587 must be logged and not dropped before logging."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Corporate mail servers and relays, mail gateways, and approved SaaS mail relays. Multifunction printers and scanners that send scan-to-email, monitoring and alerting systems, line-of-business applications with direct SMTP sending, and users with legitimate mail clients on unmanaged devices."
    tuning_guidance = "Add the source addresses of approved mail servers, relays, printers and application servers to %global_allowed_mgmt_sources. Tune per client by restricting the port set if only port 25 is permitted outbound from mail gateways. Correlate repeated hits from one source in SOAR to separate bulk spam from isolated legitimate sends."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port >= 25
    ($net.target.port = 25 or $net.target.port = 465 or $net.target.port = 587)
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1586.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
