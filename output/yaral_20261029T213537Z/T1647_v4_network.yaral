/*
  MITRE Technique : T1647 - Plist File Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:34:47.673318+00:00
  Reference       : https://attack.mitre.org/techniques/T1647
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1647_Plist_Fetched_By_Script_Or_Transfer_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a macOS command-line transfer tool or script interpreter (curl, wget, nscurl, osascript, python, perl, ruby) retrieving a .plist file from an external host over HTTP(S). Adversaries stage remote plists to overwrite or plant launch agent, launch daemon, Dock, or application Info.plist content. Observing this on the network side catches the fetch even when the endpoint-side file write is not captured or is obfuscated."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1647"
    mitre_technique_name = "Plist File Modification"
    log_prerequisites = "Requires macOS endpoint or network telemetry that normalizes to NETWORK_HTTP with target.url and principal.process.file.full_path populated (EDR network events or a proxy/agent that attributes the originating process). Rules relying on URL data will not fire if only NETWORK_CONNECTION without URL is available."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developers and admins downloading sample or template plists from public repositories; MDM, configuration profile, and software deployment tooling that pulls plist manifests; package managers and installers that fetch plist metadata; vendor update checkers retrieving version plists."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add approved deployment or MDM helper binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Scope to developer fleets cautiously, as they will generate more benign matches. Raise severity if the same host also shows a plist file write under LaunchAgents or LaunchDaemons shortly afterward."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.plist([?#].*)?$/ nocase
    $net.principal.process.file.full_path = /\/(curl|wget|nscurl|osascript|python[0-9.]*|perl|ruby)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1647")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $requesting_process = array_distinct($net.principal.process.file.full_path)
    $requesting_command_line = array_distinct($net.principal.process.command_line)
    $plist_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
