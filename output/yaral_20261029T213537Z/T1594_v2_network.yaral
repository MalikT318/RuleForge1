/*
  MITRE Technique : T1594 - Search Victim-Owned Websites
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:48:18.579270+00:00
  Reference       : https://attack.mitre.org/techniques/T1594
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1594_Web_Hidden_Path_Probing_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting hidden or sensitive web artifacts (version-control metadata, environment and credential files, backup and database dumps, server status pages) on a victim-owned website. This is characteristic of wordlist or directory scanning used to gather targeting information. Observed from the network side by an IDS/IPS or network security appliance that logs HTTP requests."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1594"
    mitre_technique_name = "Search Victim-Owned Websites"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to NETWORK_HTTP with network.http and target.url populated (HTTP inspection or decrypted traffic)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and external attack-surface assessments, penetration tests, search-engine and SEO crawlers that probe common paths, uptime monitors, and developers testing their own deployments from external networks."
    tuning_guidance = "Add scanner and pen-test source IPs to %global_allowed_scanners. Internal sources are already excluded through %rfc1918_internal. To reduce noise on internet-facing sites that attract constant background scanning, convert this rule to a Threshold rule that groups by source IP, or raise the alerting priority only when the source also triggers other detections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(\.git|\.svn|\.hg|\.ssh|\.aws)(\/|$|\?)|\/\.(env|htpasswd|htaccess|ds_store|bash_history)(\.[a-z0-9]+)?(\?|$)|\/(wp-config|web|config|settings|database)\.(php|inc|xml|json|yml|yaml)\.(bak|old|orig|save|swp|txt|zip)(\?|$)|\/(backup|backups|site|www|db|database|dump|dumps|export)\.(zip|tar|tgz|gz|7z|rar|sql|bak)(\?|$)|\/(phpinfo|info)\.php(\?|$)|\/server-(status|info)(\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1594")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
