/*
  MITRE Technique : T1684 - Social Engineering
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:43:28.999761+00:00
  Reference       : https://attack.mitre.org/techniques/T1684
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_Linux_Pasted_Download_Exec_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several download-and-execute command lines (curl/wget piped into a shell, or base64-decoded content piped into a shell) run on one Linux host within ten minutes. This pattern is typical of users being socially engineered into pasting adversary-supplied terminal instructions (fake fix, install, or support steps). A single occurrence is common in developer workflows, but repeated occurrences on one host suggest the user is working through a scripted lure."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684"
    mitre_technique_name = "Social Engineering"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and admins using vendor one-line installers (package managers, language toolchains, container runtimes), configuration management bootstrap scripts, CI/CD runners, and lab or build hosts that routinely pipe curl into a shell."
    tuning_guidance = "Add approved automation parents to %global_allowed_script_hosts, deployment tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the condition threshold on developer or build hosts. Severity can be raised for hosts where interactive use of this pattern is never expected."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $host
    $proc.target.process.command_line = /((curl|wget)\b[^|]*\|\s*(sudo\s+)?(ba|da|z|k)?sh\b)|(base64\s+(-d|--decode)\b[^|]*\|\s*(sudo\s+)?(ba|da|z|k)?sh\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1684")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
