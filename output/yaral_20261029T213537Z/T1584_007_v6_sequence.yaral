/*
  MITRE Technique : T1584.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:31:21.123027+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_007_Serverless_DNS_Then_HTTP_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single internal source resolves a serverless-platform hostname and then sends POST/PUT web requests to a serverless-platform hostname on an external address within 10 minutes. This pattern matches adversary-compromised serverless functions (edge workers, lambda-style URLs, function apps) used as C2 responders or redirectors."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.007"
    mitre_technique_name = "Compromise Infrastructure: Serverless"
    log_prerequisites = "Requires perimeter DNS logs (resolver or firewall DNS inspection) and proxy or firewall HTTP logs with the source IP, request method and destination hostname populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal applications and SaaS integrations that legitimately call serverless APIs, developer workstations testing functions, webhook and CI/CD tooling, and monitoring agents posting to serverless endpoints."
    tuning_guidance = "Add known-good serverless hostnames to %global_allowed_domains. Add authorised scanner or test sources to %global_allowed_scanners. If the proxy does not populate network.http.method, remove that filter and raise the threshold on the HTTP event count."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /\.(workers\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app|azurewebsites\.net|vercel\.app|netlify\.app)\.?$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT)$/ nocase
    $http.target.hostname = /\.(workers\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app|azurewebsites\.net|vercel\.app|netlify\.app)\.?$/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.007")
    $primary_entity = array_distinct($src_ip)
    $resolved_domains = array_distinct($dns.network.dns.questions.name)
    $contacted_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $http_request_count = count($http.metadata.id)

  condition:
    $dns and $http
}
