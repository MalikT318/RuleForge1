/*
  MITRE Technique : T1586.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:46:29.928296+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_003_Cloud_Account_Auth_Failure_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source generates a high volume of failed (401/403) POST requests to authentication-style URLs within ten minutes. This pattern matches password spraying or credential stuffing used to compromise cloud and identity accounts for later adversary use. Each failed login is benign on its own; the volume from one source is the signal."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.003"
    mitre_technique_name = "Compromise Accounts: Cloud Accounts"
    log_prerequisites = "Requires perimeter proxy, WAF or reverse-proxy logs normalised to NETWORK_HTTP with populated principal.ip, target.url, network.http.method and network.http.response_code."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users behind a shared NAT or corporate egress who mistype passwords, misconfigured mobile or mail clients retrying with stale credentials, expired service credentials in automation, authorised penetration tests or vulnerability scanners, and uptime monitors probing login pages."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Raise the #http threshold for tenants with large NAT egress pools. Lower it for tenants with few externally exposed login endpoints. Add known-good partner domains to %global_allowed_domains if target.hostname is a trusted federated service."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(login|signin|sign-in|logon|oauth2?|token|authenticate|auth)/ nocase
    $http.network.http.response_code >= 401
    $http.network.http.response_code <= 403
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  match:
    $src_ip over 10m

  outcome:
    $event_count = count($http.metadata.id)
    $risk_score = max(if($event_count >= 100, 85, if($event_count >= 50, 70, 55)))
    $mitre_technique_id = array_distinct("T1586.003")
    $primary_entity = array_distinct($src_ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $targeted_urls = array_distinct($http.target.url)

  condition:
    #http >= 20
}
