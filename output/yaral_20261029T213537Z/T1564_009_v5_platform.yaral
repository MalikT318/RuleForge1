/*
  MITRE Technique : T1564.009 - Resource Forking
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:47:52.296839+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_009_macOS_Resource_Fork_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a write to a file's resource fork via the ..namedfork/rsrc pseudo-path on macOS. Adversaries hide payloads or executable content in resource forks, which most file-based scanners and directory listings do not show. This rule is file-event based, not command-line based, so it also catches API-driven writes and writes by renamed or custom binaries."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.009"
    mitre_technique_name = "Hide Artifacts: Resource Forking"
    log_prerequisites = "macOS endpoint telemetry that reports file write events with the full target path, including the ..namedfork pseudo-path. Not all sensors resolve the fork path; confirm coverage per client."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Finder and Launch Services setting custom icons, legacy Carbon or Classic applications and installers that still write resource forks, design and media tools such as font and graphics utilities, and Apple developer tooling such as Xcode and Rez/SetFile. Backup, sync and archive utilities restoring files with forks."
    tuning_guidance = "Add approved administrative tooling to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. If Finder icon customisation or specific developer tools are noisy, add them to %global_allowed_admin_tools, or extend the process-name regex exclusion. Raise severity for writes by processes launched from /tmp, /private/tmp or /Users/*/Downloads."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/\.\.namedfork\/rsrc$/ nocase
    not $file.principal.process.file.full_path = /\/(Finder|Xcode|mdworker|mdworker_shared|fseventsd|cfprefsd|quicklookd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $fork_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
