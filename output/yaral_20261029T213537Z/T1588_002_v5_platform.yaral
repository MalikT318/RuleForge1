/*
  MITRE Technique : T1588.002 - Tool
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:57:06.027936+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_002_Direct_IP_Tool_Download_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client using an HTTP GET to fetch an executable, script, library, or archive from a bare external IP address (no domain name). Adversaries staging acquired tooling (offensive frameworks, remote-admin utilities, cracked software) commonly host it on throwaway infrastructure addressed by IP. This rule is perimeter-based and works from proxy or firewall HTTP logs. It does not rely on endpoint process fields, tool names, or hardcoded infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.002"
    mitre_technique_name = "Obtain Capabilities: Tool"
    log_prerequisites = "Requires firewall or proxy logs with HTTP inspection (or TLS inspection) that populate network.http.method and target.url. Plain NETWORK_CONNECTION logs without URL data will not trigger this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software vendors or appliance firmware updates served from bare IPs, internal-looking CDN or lab hosts with public IPs, developers testing against cloud VMs by IP, legitimate admin tooling downloads from IP-addressed repositories, and authorised red team or penetration test exercises."
    tuning_guidance = "Add known-good source addresses (scanners, pen-test hosts) to %global_allowed_scanners and trusted vendor domains to %global_allowed_domains. Narrow or widen the file-extension list to match client risk appetite. Where proxy logs only record the CONNECT host, ensure TLS inspection is enabled so the full URL is available."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /^https?:\/\/(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?\/[^?#]*\.(exe|dll|msi|ps1|bat|vbs|elf|sh|bin|jar|py|zip|7z|rar|apk|dmg|pkg)([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1588.002")
    $primary_entity = array_distinct($http.principal.ip)
    $download_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
