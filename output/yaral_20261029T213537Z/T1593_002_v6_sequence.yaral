/*
  MITRE Technique : T1593.002 - Search Engines
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:46:11.366187+00:00
  Reference       : https://attack.mitre.org/techniques/T1593/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_002_Search_Referred_Sensitive_Access_Then_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an external source arriving on a sensitive file or exposed repository path with a search-engine style query referrer (typical of search-engine dorking results), then probing admin, login or configuration paths within 10 minutes. Indicates reconnaissance that began with search engine discovery and moved to active targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593.002"
    mitre_technique_name = "Search Engines"
    log_prerequisites = "Requires IPS/network security appliance or inline web inspection logs normalised to NETWORK_HTTP, with principal.ip, target.url and network.http.referral_url populated (HTTP inspection or TLS-decrypted traffic)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate users following a search result to a public document or log download, then visiting a login page; SEO and web-indexing audits; customers or partners using search to find public downloads; authorised external scanners not yet in the allowlist."
    tuning_guidance = "Add authorised external scanners and testing sources to %global_allowed_scanners. If public downloads cause noise, narrow the sensitive-extension regex in the dork event. Raise the probe threshold by also requiring multiple probe URLs on high-traffic sites."

  events:
    $dork.metadata.event_type = "NETWORK_HTTP"
    $dork.network.http.referral_url = /[?&#](q|query|search|p|wd|text|keyword)=/ nocase
    $dork.target.url = /(\.(sql|bak|old|env|log|conf|cfg|ini|pem|key|kdbx|csv|xls|xlsx|zip|tar|gz)|\/\.git\/|\/\.svn\/)(\?.*)?$/ nocase
    not $dork.principal.ip in %rfc1918_internal
    not $dork.principal.ip in %global_allowed_scanners
    $dork.principal.ip = $src_ip

    $probe.metadata.event_type = "NETWORK_HTTP"
    $probe.target.url = /\/(admin|administrator|login|signin|wp-login|wp-admin|phpmyadmin|manager\/html|console|actuator|\.env|\.git|backup)(\/|\.|\?|$)/ nocase
    not $probe.principal.ip in %rfc1918_internal
    not $probe.principal.ip in %global_allowed_scanners
    $probe.principal.ip = $src_ip

    $dork.metadata.event_timestamp.seconds <= $probe.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1593.002")
    $primary_entity = array_distinct($src_ip)
    $dork_urls = array_distinct($dork.target.url)
    $search_referrers = array_distinct($dork.network.http.referral_url)
    $probed_urls = array_distinct($probe.target.url)
    $targeted_hosts = array_distinct($probe.target.hostname)
    $probe_count = count($probe.metadata.id)

  condition:
    $dork and $probe
}
