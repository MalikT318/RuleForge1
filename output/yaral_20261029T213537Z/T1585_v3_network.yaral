/*
  MITRE Technique : T1585 - Establish Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:34:13.134393+00:00
  Reference       : https://attack.mitre.org/techniques/T1585
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_External_Account_Registration_HTTP_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects HTTP POST requests from internal sources to external account sign-up or registration endpoints. This is the network-observable step of account creation on third-party services, which adversaries use to build personas and mailboxes for social engineering or phishing. The rule is low-fidelity on its own and is intended as a hunting and enrichment signal. It is most useful when correlated with other activity on the same source, or when the source is a server or other non-interactive asset."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585"
    mitre_technique_name = "Establish Accounts"
    log_prerequisites = "Requires forward or transparent proxy, or a perimeter firewall with URL visibility (TLS inspection or URL categorisation), populating network.http.method and target.url."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees legitimately registering for SaaS trials, vendor portals, webinars, or conference sites; developers creating accounts on package registries or code-hosting services; marketing and recruiting staff signing up for third-party platforms; QA automation exercising sign-up flows."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Limit scope to server or non-interactive subnets if user-driven sign-ups are too noisy. Raise severity when the source also shows phishing-related activity or access to webmail providers. Add approved automation accounts to %global_allowed_service_accounts if the proxy logs the authenticated user."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|join)(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1585")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)

  condition:
    $http
}
