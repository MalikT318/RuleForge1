/*
  MITRE Technique : T1680 - Local Storage Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:40:10.594971+00:00
  Reference       : https://attack.mitre.org/techniques/T1680
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1680_Linux_Disk_Enum_Then_Raw_Block_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user enumerating local disks, partitions or mounts with native Linux utilities and then reading a raw block device directly on the same host within 10 minutes. This sequence is consistent with ransomware or wiper preparation, or with a precursor to Direct Volume Access."
    mitre_tactic = "Discovery"
    mitre_technique = "T1680"
    mitre_technique_name = "Local Storage Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH, with command_line and principal user populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging jobs, disk-cloning or forensic work by administrators, provisioning and configuration-management scripts, storage health checks, and installers that probe disks before partitioning."
    tuning_guidance = "Add approved admin tooling parent processes to %global_allowed_admin_tools, imaging and backup software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. If still noisy, restrict the raw-device event to unexpected parents or add approved admin accounts via %global_allowed_admin_users."

  events:
    $disc.metadata.event_type = "PROCESS_LAUNCH"
    $disc.target.process.file.full_path = /\/(lsblk|fdisk|sfdisk|parted|blkid|lshw|findmnt|df|lsscsi|hdparm|smartctl)$/ nocase
    $disc.principal.hostname = $hostname
    $disc.principal.user.userid = $user
    not $disc.principal.process.file.full_path in %global_allowed_admin_tools
    not $disc.principal.user.userid in %global_allowed_service_accounts
    not $disc.principal.user.userid in %global_allowed_admin_users

    $raw.metadata.event_type = "PROCESS_LAUNCH"
    $raw.target.process.command_line = /(^|\s|\/)(dd|ddrescue|xxd|hexdump|cat|strings|shred)\s.*\/dev\/(sd[a-z]|nvme[0-9]|vd[a-z]|xvd[a-z]|hd[a-z]|dm-[0-9]|mapper\/)/ nocase
    $raw.principal.hostname = $hostname
    $raw.principal.user.userid = $user
    not $raw.principal.process.file.full_path in %global_allowed_backup_processes
    not $raw.principal.process.file.full_path in %global_allowed_admin_tools
    not $raw.principal.user.userid in %global_allowed_service_accounts

    $disc.metadata.event_timestamp.seconds <= $raw.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1680")
    $primary_entity = array_distinct($hostname)
    $acting_user = array_distinct($user)
    $discovery_commands = array_distinct($disc.target.process.command_line)
    $raw_access_commands = array_distinct($raw.target.process.command_line)
    $discovery_count = count($disc.metadata.id)

  condition:
    $disc and $raw
}
