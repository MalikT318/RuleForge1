/*
  MITRE Technique : T1543.001 - Launch Agent
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:26:36.169457+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_001_Mass_LaunchAgent_Plist_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several launchd property list files are created under /Library/LaunchAgents or /Users/*/Library/LaunchAgents on one macOS host within ten minutes. A single plist drop is common for software installs, but a burst of them suggests persistence staging or a malware dropper installing several disguised launch agents."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.001"
    mitre_technique_name = "Create or Modify System Process: Launch Agent"
    log_prerequisites = "Requires macOS endpoint file-creation telemetry (EDR or unified log) that populates target.file.full_path and principal.process.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Bulk software installs or upgrades (package installers, developer toolchains), MDM or RMM deployment of several agents, OS migration or restore from backup, and user profile provisioning."
    tuning_guidance = "Add approved installers, MDM and deployment binaries to %global_allowed_admin_tools, and EDR or security agents to %global_allowed_security_tools. Raise the #file threshold in condition for environments with heavy software deployment, or lower it for high-security hosts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/Users\/[^\/]+)?\/Library\/LaunchAgents\/[^\/]+\.plist$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($file.target.file.full_path, /(?i)^\/Library\//), 85, 70))
    $mitre_technique_id = array_distinct("T1543.001")
    $primary_entity = array_distinct($host)
    $plist_count = count($file.metadata.id)
    $plist_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
