/*
  MITRE Technique : T1049 - System Network Connections Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:58:12.387756+00:00
  Reference       : https://attack.mitre.org/techniques/T1049
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1049_macOS_Outbound_Enumeration_Protocols_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of a macOS host connecting to a non-internal destination on protocols used to enumerate remote sessions and connections (RPC 135, NetBIOS session 139, SMB 445, SNMP 161). These are internal management and discovery protocols, so a Mac reaching them outside internal address space suggests remote connection and session discovery, a scan, or relay activity (T1049). It complements process and command-line rules by observing the behaviour at the perimeter rather than on the endpoint."
    mitre_tactic = "Discovery"
    mitre_technique = "T1049"
    mitre_technique_name = "System Network Connections Discovery"
    log_prerequisites = "Firewall or perimeter NETWORK_CONNECTION events with principal.hostname, target.ip and target.port populated. principal.platform must be populated, for example through asset enrichment of the source host. No endpoint process fields are used."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Macs on VPN or in remote-office split tunnels reaching corporate file servers through a public or NAT address that is not in the internal list; cloud-hosted SMB or SNMP services; authorised vulnerability scanning or network monitoring run from a Mac; misconfigured SNMP monitoring clients."
    tuning_guidance = "Make sure %rfc1918_internal covers the client's internal and VPN address space. Add authorised scanning or monitoring hosts to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. If the firewall does not populate principal.platform, enrich the source host from asset inventory or scope the rule to Mac subnets. Narrow the port set per client if a legitimate external SMB or SNMP dependency exists."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.platform = "MAC"
    $net.principal.hostname != ""
    (
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 161 or
      $net.target.port = 445
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1049")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
