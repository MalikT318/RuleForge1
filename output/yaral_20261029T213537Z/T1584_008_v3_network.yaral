/*
  MITRE Technique : T1584.008 - Network Devices
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:32:29.192193+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_008_Inbound_External_To_Proxy_Relay_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a connection from an external source to an internal address on a port conventionally used by proxy or relay services (SOCKS, HTTP proxy). Compromised edge or SOHO network devices are commonly turned into relay nodes for adversary traffic. A perimeter log showing external hosts using internal devices as proxies is a network-side sign of a device being used as adversary infrastructure. This is a coarse behavioural proxy, not a definitive indicator."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.008"
    mitre_technique_name = "Compromise Infrastructure: Network Devices"
    log_prerequisites = "Firewall or perimeter connection logs that populate principal.ip, target.ip and target.port, with the log capturing traffic arriving at the perimeter (ingress). The %rfc1918_internal list must be populated for the tenant."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Intentionally published forward proxies or SOCKS gateways, partner or vendor access to proxy services, authorised external penetration tests or vulnerability scans, and internet-wide scanners probing common proxy ports (high volume but low value)."
    tuning_guidance = "Add authorised scanning sources to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Add known service identities to %global_allowed_service_accounts if the log populates principal.user.userid. If internet scanner noise is high, deploy a threshold variant or alert only when the destination is a known network device. Validate that %rfc1918_internal covers the tenant's address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1080 or
      $net.target.port = 3128 or
      $net.target.port = 8118 or
      $net.target.port = 8888 or
      $net.target.port = 9050
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
