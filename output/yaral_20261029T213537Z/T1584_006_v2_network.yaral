/*
  MITRE Technique : T1584.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:27:53.616139+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_006_Scripted_Client_Upload_To_Unlisted_Web_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host sending data (POST/PUT/PATCH) to an external web service that is not on the known-good domain list, using a scripted or library HTTP client rather than a browser. This is the network-observable pattern of malware or operators using a compromised or attacker-controlled third-party web service (code hosting, file sharing, messaging, email API) as infrastructure for C2 or exfiltration."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.006"
    mitre_technique_name = "Compromise Infrastructure: Web Services"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection (TLS decryption or explicit proxy) that populate network.http.method, network.http.user_agent and target.hostname, normalised to NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate automation: CI/CD agents, backup or monitoring agents, package managers and SDK-based line-of-business applications posting to SaaS APIs; IT scripts calling vendor APIs; telemetry from unlisted software vendors."
    tuning_guidance = "Add sanctioned SaaS and vendor API domains to %global_allowed_domains. Add known automation, build or jump hosts to %global_allowed_script_hosts. Add approved scanning sources to %global_allowed_scanners. If volume is high, enable a threshold variant grouped by source host."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.network.http.user_agent = /(curl|wget|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|okhttp|apache-httpclient|java\/|powershell|winhttp|node-fetch|axios)/ nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $user_agents = array_distinct($net.network.http.user_agent)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
