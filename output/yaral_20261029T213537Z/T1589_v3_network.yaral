/*
  MITRE Technique : T1589 - Gather Victim Identity Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:05:09.876754+00:00
  Reference       : https://attack.mitre.org/techniques/T1589
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_External_Username_Enumeration_Endpoint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting well-known user-enumeration URL patterns on a web-facing service, such as CMS user listings, author-ID iteration, credential-existence lookups, webfinger account queries, and password-reset lookups keyed on a user or email parameter. These requests are used to harvest valid usernames and email addresses before credential attacks (T1589). The rule is based on URL behaviour seen at the perimeter, not on endpoint telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589"
    mitre_technique_name = "Gather Victim Identity Information"
    log_prerequisites = "Requires perimeter proxy, WAF or firewall logs with HTTP inspection that populate target.url and principal.ip, normalised to NETWORK_HTTP. L3/L4-only firewall logs without URL visibility cannot support this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised penetration tests and vulnerability scanners not yet in the allowlist; search-engine and SEO crawlers requesting CMS author archives or the public REST user listing; legitimate single-page apps or mobile clients that call user-lookup or password-reset endpoints; uptime or monitoring probes."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners. Internal sources are already excluded via %rfc1918_internal. For noisy public sites, add a client-specific URL exclusion or raise severity only when the same source repeats the behaviour (use a companion threshold rule grouped by principal.ip)."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/wp-json\/wp\/v2\/users|[?&]author=[0-9]+|\/getcredentialtype|\/\.well-known\/webfinger\?[^ ]*resource=acct:|\/(forgot|reset)[-_]?password[^ ]*[?&](user|username|email)=|\/api\/v[0-9]+\/(users|accounts)\/(lookup|search|exists))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1589")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
