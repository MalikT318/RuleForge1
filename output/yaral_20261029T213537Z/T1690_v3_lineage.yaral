/*
  MITRE Technique : T1690 - Prevent Command History Logging
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:44:29.060940+00:00
  Reference       : https://attack.mitre.org/techniques/T1690
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1690_ESXi_Mgmt_Daemon_Spawns_Shell_Impairing_History {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management, web or scripting daemon (hostd, vpxa, rhttpproxy, sfcbd, openwsman, lighttpd, python, etc.) spawning a shell whose command line disables or tampers with command history (unset HISTFILE, HISTSIZE/HISTFILESIZE=0, HISTFILE=/dev/null, HISTCONTROL=ignorespace/ignoreboth, set +o history, history -c, or touching .ash_history/.bash_history). Shells on ESXi are normally spawned by sshd, dropbear or the DCUI, so history tampering from a service parent suggests remote code execution or a webshell-style backdoor."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1690"
    mitre_technique_name = "Prevent Command History Logging"
    log_prerequisites = "ESXi shell and process execution telemetry forwarded to Chronicle with parent and child process paths and command lines populated (for example via syslog parsing, or an agent or auditd-style process-launch source on the host)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup agents and approved automation that run through a service parent and deliberately set HISTFILE or HISTSIZE in wrapper scripts; scripted maintenance run under python or hostd-spawned helpers; hardening scripts that set HISTCONTROL or HISTSIZE for compliance."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If hardening scripts trigger the rule, narrow the HISTCONTROL branch of the command-line regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|rhttpproxy|sfcbd|sfcb-[a-z_-]+|openwsman|wsman|slpd|vmware-fdm|fdm|vobd|vmsyslogd|lighttpd|nginx|httpd|python[0-9.]*|perl|busybox)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|busybox)$/ nocase
    $proc.target.process.command_line = /(unset\s+(HISTFILE|HISTSIZE|HISTFILESIZE)|(HISTFILE|HISTFILESIZE|HISTSIZE)=("|')?(0|\/dev\/null)("|')?(\s|;|$)|HISTCONTROL=("|')?(ignorespace|ignoreboth|ignoredups)|set\s+\+o\s+history|history\s+-[cdw]|ln\s+-\w*\s+\/dev\/null\s+\S*(ash|bash|sh)_history|\/dev\/null\s*>\s*\S*(ash|bash|sh)_history|(rm|truncate)\s+.*\.(ash|bash|sh)_history)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1690")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
