/*
  MITRE Technique : T1584.008 - Network Devices
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:32:42.630031+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_008_Outbound_To_External_Edge_Device_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client connecting to an external (non-RFC1918) address on ports typical of SOHO router and edge-device proxy or management services (SOCKS, HTTP proxy, MikroTik Winbox, TR-069, and common router exploitation ports). Compromised third-party network devices are often used as proxy relays, payload hosts, or C2 hops, and legitimate users rarely connect directly to such services on the internet."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.008"
    mitre_technique_name = "Compromise Infrastructure: Network Devices"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users or developers with an approved external SOCKS or HTTP proxy, VPN or proxy-based security services, remote administration of branch or partner routers over Winbox or TR-069, ISP-managed CPE provisioning, and authorised scanners or pen-test sources."
    tuning_guidance = "Add authorised admin or scanner source addresses to %global_allowed_mgmt_sources or %global_allowed_scanners. Adjust the port list to match client-approved proxy services. Check whether the destination is a known SOHO or consumer ISP address range, and review how many distinct internal hosts contact the same destination."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 1080 or
    $net.target.port = 3128 or
    $net.target.port = 8291 or
    $net.target.port = 7547 or
    $net.target.port = 37215 or
    $net.target.port = 52869
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.008")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
