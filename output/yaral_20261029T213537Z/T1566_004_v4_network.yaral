/*
  MITRE Technique : T1566.004 - Spearphishing Voice
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:48:48.379759+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_004_macOS_Vishing_Support_Installer_Download_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS client (identified by HTTP user agent) downloading a disk image or installer package (.dmg/.pkg/.mpkg) from an external host, where the URL carries remote-support or help-desk wording. This is the network-side signature of a vishing victim being walked through installing remote access software during a phone call. It works from proxy or firewall HTTP telemetry and does not depend on endpoint process data."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.004"
    mitre_technique_name = "Phishing: Spearphishing Voice"
    log_prerequisites = "Requires firewall or proxy logs normalised to NETWORK_HTTP with target.url, network.http.user_agent and target.hostname populated. Requires TLS inspection or explicit proxy logging to expose full URLs and user agents."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Legitimate help-desk or IT-initiated remote support sessions where staff download a support client. Sanctioned software distribution portals, vendor installer downloads with 'support' or 'connect' in the URL, and developers or admins fetching packages with curl."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Review internal egress for the client's approved remote support workflow and allowlist its distribution domain. Extend the URL keyword group if the client uses different support portal naming. Consider raising severity when the source host is a non-IT user segment."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /(Macintosh|Mac OS X|Darwin|CFNetwork|curl)/ nocase
    $http.target.url = /\.(dmg|pkg|mpkg)(\?|#|$)/ nocase
    $http.target.url = /(support|helpdesk|help-desk|remote|assist|session|connect|join|screenshare|rescue)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1566.004")
    $primary_entity = array_distinct($http.principal.ip)
    $download_urls = array_distinct($http.target.url)
    $destination_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
