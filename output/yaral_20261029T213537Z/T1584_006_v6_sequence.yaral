/*
  MITRE Technique : T1584.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:29:06.812773+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_006_Fresh_Domain_Resolved_Then_Data_Posted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An internal host resolves an external domain that is not on the known-good domain list and, within 10 minutes, sends a successful HTTP POST or PUT to that same domain through the perimeter. This DNS-then-upload pattern is consistent with a host using third-party web-service infrastructure that an adversary has taken over, such as a compromised account on a code-hosting, storage, or messaging service, for command and control or exfiltration. The rule cannot confirm that the service account itself was compromised. It surfaces uncommon destinations that receive upload traffic."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.006"
    mitre_technique_name = "Compromise Infrastructure: Web Services"
    log_prerequisites = "Requires perimeter firewall or proxy telemetry normalised to UDM NETWORK_DNS (resolver or DNS-inspection logs) and NETWORK_HTTP (proxy or TLS-inspection logs with method and target hostname). principal.hostname must be populated on both event types so they can be joined."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "SaaS applications, telemetry or crash-reporting endpoints, software updaters, and API-driven business integrations that upload to domains not yet in the allowlist. Developers and automation pushing to newly adopted cloud services also match."
    tuning_guidance = "Add vetted external domains to %global_allowed_domains, and add automation and integration identities to %global_allowed_service_accounts. If the DNS logs include a trailing dot on the queried name, normalise it in the log parser so the domain join matches. Raise the risk score or add a volume threshold on max_sent_bytes for noisy tenants."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.hostname = $host
    $dns.network.dns.questions.name = $domain
    not $dns.network.dns.questions.name in %global_allowed_domains

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.hostname = $host
    $http.target.hostname = $domain
    $http.network.http.method = /^(POST|PUT)$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    not $http.principal.user.userid in %global_allowed_service_accounts

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $host, $domain over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.006")
    $primary_entity = array_distinct($host)
    $contacted_domain = array_distinct($domain)
    $destination_ips = array_distinct($http.target.ip)
    $upload_request_count = count($http.metadata.id)
    $max_sent_bytes = max($http.network.sent_bytes)

  condition:
    $dns and $http
}
