/*
  MITRE Technique : T1547.007 - Re-opened Applications
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:46:10.951928+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_007_Reopened_Apps_LoginWindow_Plist_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated modification of the per-user loginwindow ByHost plist (com.apple.loginwindow.[UUID].plist) on a single macOS host within ten minutes by processes other than loginwindow. A normal logout or restart writes this file once, so repeated writes by other processes suggest an attempt to plant an application in the 'Reopen windows when logging back in' list for persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.007"
    mitre_technique_name = "Boot or Logon Autostart Execution: Re-opened Applications"
    log_prerequisites = "Requires macOS endpoint telemetry that reports file modification events with the acting process path and the full target file path (EDR file events or Endpoint Security framework events)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or configuration management agents writing login window preferences, admin scripts that run defaults write against loginwindow settings, and IT imaging or migration tooling. Users who log out or restart several times in ten minutes can also trigger it when the writer is attributed to a helper process."
    tuning_guidance = "Add approved MDM and configuration tooling executable paths to %global_allowed_admin_tools, and endpoint security agents to %global_allowed_security_tools. The default threshold of 3 modifications in 10m is conservative; raise it if user logout/restart churn is noisy, and lower it for high-value hosts. Review the writer process in the outcome fields to separate cfprefsd-mediated writes from direct script writes."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(Users\/[^\/]+|var\/root)\/Library\/Preferences\/ByHost\/com\.apple\.loginwindow\.[^\/]+\.plist$/ nocase
    not $file.principal.process.file.full_path = /\/loginwindow$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1547.007")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $modified_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
