/*
  MITRE Technique : T1213.002 - Sharepoint
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:15:32.011220+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_002_SharePoint_Sensitive_Search_API_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request to the SharePoint REST search endpoint whose query text contains credential, secret, or network and architecture documentation keywords. This pattern is typical of an adversary mining SharePoint for credentials and network or system documentation. Scripted HTTP clients raise the risk score. Internal destinations are excluded, so the rule targets SharePoint Online or externally hosted SharePoint."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.002"
    mitre_technique_name = "Data from Information Repositories: Sharepoint"
    log_prerequisites = "Requires NETWORK_HTTP events with target.url populated, for example from a web proxy, secure web gateway, or TLS-inspecting egress control. Identity provider sign-in logs alone do not contain HTTP URLs. Correlate hits with identity sign-in telemetry for the same user, and confirm that HTTP telemetry is normalised into UDM for this client before relying on this rule."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Helpdesk, compliance, and security staff searching SharePoint for policy or password-reset documentation; legitimate eDiscovery and DLP crawlers; search-driven intranet applications; users searching for the word 'password' in policy documents."
    tuning_guidance = "Add automation and crawler accounts to %global_allowed_service_accounts. Add authorised scanners and crawlers to %global_allowed_scanners. For on-premises SharePoint, remove the %rfc1918_internal exclusion and add known-good sources to %global_allowed_mgmt_sources. Extend or trim the keyword list to match client terminology."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/_api\/search\/(post)?query[^ ]*querytext=[^&]*(password|passwd|credential|secret|vpn|api[_%20+-]?key|connection[_%20+-]?string|network[_%20+-]*diagram|architecture|runbook)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(if(re.regex($http.network.http.user_agent, /(?i)(powershell|python|curl|wget|go-http|java|okhttp|httpclient|axios|node)/), 80, 55))
    $mitre_technique_id = array_distinct("T1213.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $user = array_distinct($http.principal.user.userid)
    $requested_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
