/*
  MITRE Technique : T1547.015 - Login Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:47:31.374609+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_015_MacOS_LoginItem_Helper_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a macOS process running from a login-item helper bundle (Contents/Library/LoginItems, the Service Management login item location) or from a user-writable Library persistence location (/Users/*/Library/LaunchAgents, Application Support, Caches) that opens an outbound connection to a non-internal address. Persistent login items beaconing to external infrastructure are a network-side indicator of T1547.015 persistence. This complements process command-line detections by observing the network behaviour of the persisted payload."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.015"
    mitre_technique_name = "Boot or Logon Autostart Execution: Login Items"
    log_prerequisites = "Requires macOS endpoint telemetry that records NETWORK_CONNECTION events with the initiating process path populated in principal.process.file.full_path and the destination in target.ip."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate third-party apps whose login-item helpers phone home (cloud sync, chat, VPN, music, password managers, updaters), and apps that keep updater or agent binaries under ~/Library/Application Support. Expect the highest volume right after user login and app updates."
    tuning_guidance = "Add approved management agents to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Add known-good vendor destinations to %global_allowed_domains. Review the process path outcome across clients to identify common sanctioned apps, then allowlist them by executable path. Raise severity for rare binaries seen on only one host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(\/Contents\/Library\/LoginItems\/[^\/]+\.app\/Contents\/MacOS\/[^\/]+$|^\/Users\/[^\/]+\/Library\/(LaunchAgents|Application Support|Caches)\/.+)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1547.015")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
