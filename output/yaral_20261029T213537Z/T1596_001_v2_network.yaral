/*
  MITRE Technique : T1596.001 - DNS/Passive DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:59:06.759389+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_001_External_DNS_Zone_Transfer_Enumeration_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IDS/IPS verdict for DNS zone transfer (AXFR/IXFR) or DNS enumeration and reconnaissance activity. The traffic comes from an external source and targets DNS service port 53 on protected infrastructure. Attackers use these queries to harvest subdomains, mail servers and internal addressing from victim-operated nameservers."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.001"
    mitre_technique_name = "Search Open Technical Databases: DNS/Passive DNS"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to NETWORK_CONNECTION with target.port and security_result.rule_name or security_result.description populated. The sensor must inspect traffic to internet-facing authoritative or recursive DNS servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners or attack-surface management services, secondary or slave nameservers and DNS hosting providers performing legitimate zone transfers, partner or MSP DNS migration work, and penetration tests."
    tuning_guidance = "Add sanctioned scanner and testing sources to %global_allowed_scanners. Add secondary nameserver and DNS provider addresses to %global_allowed_mgmt_sources. Confirm that the IPS signature name or description for zone transfer and DNS enumeration is mapped into security_result.rule_name or security_result.description. Raise severity if the target is a primary authoritative server that permits transfers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    (
      $net.security_result.rule_name = /(zone[\s_\-]?transfer|\baxfr\b|\bixfr\b|dns[\s_\-]*(enumeration|recon|reconnaissance|brute|subdomain|zone))/ nocase or
      $net.security_result.description = /(zone[\s_\-]?transfer|\baxfr\b|\bixfr\b|dns[\s_\-]*(enumeration|recon|reconnaissance|brute|subdomain|zone))/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1596.001")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_dns_servers = array_distinct($net.target.ip)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
