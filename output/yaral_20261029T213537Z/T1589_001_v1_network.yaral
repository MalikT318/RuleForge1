/*
  MITRE Technique : T1589.001 - Credentials
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:06:20.493319+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_001_External_Credential_File_Harvest_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external client successfully retrieving a well-known credential-bearing file or secrets artifact over HTTP, such as environment files, VCS config, cloud credential files, htpasswd, key material or config backups. This is the network-side signature of an adversary harvesting credentials from exposed web assets, and a successful response means the credential material was actually disclosed."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.001"
    mitre_technique_name = "Gather Victim Identity Information: Credentials"
    log_prerequisites = "Requires perimeter proxy, WAF, reverse-proxy or firewall HTTP logs normalised to NETWORK_HTTP with target.url, principal.ip and network.http.response_code populated. Inbound (internet-to-DMZ) web traffic must be logged."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface-management or penetration-test sources that were not allowlisted; bug-bounty researchers; legitimately public config or JSON files whose names match the pattern; internal developer tooling that reaches the service through a NAT or proxy address."
    tuning_guidance = "Add authorised scanner and pen-test source IPs to %global_allowed_scanners. If a site legitimately serves a matching file, narrow the pattern or allowlist the source. If the log source does not populate network.http.response_code, remove the response-code condition and lower severity to Medium. Consider alerting on repeated hits from one source in a separate threshold rule."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD|POST)$/ nocase
    $http.target.url = /\/(\.env(\.[a-z0-9_-]+)?|\.git\/(config|HEAD|credentials)|\.aws\/credentials|\.htpasswd|\.htaccess\.bak|\.npmrc|\.pgpass|\.netrc|\.ssh\/id_[a-z0-9]+|wp-config\.php(\.bak|\.old|\.orig|\.save|\.txt|~)|web\.config\.(bak|old|txt)|credentials\.json|secrets?\.(json|ya?ml|txt)|config\.(json|ya?ml|php|inc)\.(bak|old|orig|save))(\?.*)?$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1589.001")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
