/*
  MITRE Technique : T1057 - Process Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:59:48.046369+00:00
  Reference       : https://attack.mitre.org/techniques/T1057
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1057_ESXi_Process_Discovery_Volume_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A high volume of process-enumeration commands (ps, esxcli/localcli system process list, lsof, top/esxtop, /proc walking) runs on a single ESXi host within ten minutes. One lookup is routine administration. Repeated enumeration is typical of automated discovery by ransomware operators or intruders who have enabled the ESXi shell and are deciding which VM processes to terminate."
    mitre_tactic = "Discovery"
    mitre_technique = "T1057"
    mitre_technique_name = "Process Discovery"
    log_prerequisites = "ESXi shell/hostd logs forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with target.process.command_line populated (ESXi shell command auditing enabled)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators troubleshooting a hung VM or host over SSH, esxtop performance sessions, support-bundle collection (vm-support), monitoring or inventory scripts, backup and patching tooling that lists processes before acting."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and monitoring or patching tooling to %global_allowed_admin_tools. Raise the #proc threshold if a client runs scheduled health scripts. Restrict to SSH-originated sessions if the parser exposes that."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /((^|[\/\s])(ps|lsof|top|esxtop)(\s|$))|((esxcli|localcli)\s+system\s+process\s+(list|stats))|(\/proc\/([0-9]+|\*|self)\/(status|cmdline|stat|comm))|(ls\s+(-[a-z]+\s+)?\/proc(\s|\/|$))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.command_line, `(?i)(esxcli|localcli)\s+system\s+process|/proc/`), 70, 55))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1057")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 10
}
