/*
  MITRE Technique : T1615 - Group Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:32:54.551249+00:00
  Reference       : https://attack.mitre.org/techniques/T1615
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1615_SYSVOL_Policies_Enumeration_CommandLine {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a shell, interpreter or file-copy utility whose command line enumerates, reads or copies content from the domain SYSVOL Policies share (\\\\<domain>\\SYSVOL\\<domain>\\Policies). This is a native way to discover Group Policy Object structure and settings without gpresult or GPO cmdlets. The rule is written for Windows only; no non-Windows variant is provided because Group Policy is Windows/Active Directory specific."
    mitre_tactic = "Discovery"
    mitre_technique = "T1615"
    mitre_technique_name = "Group Policy Discovery"
    log_prerequisites = "Requires EDR or Sysmon process creation telemetry with full command-line capture, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain administrators auditing or backing up GPOs, GPO migration and baseline-comparison scripts, software deployment and RMM tooling reading SYSVOL, logon scripts that copy files from SYSVOL, security assessment tools run by internal teams."
    tuning_guidance = "Add approved administration tooling to %global_allowed_admin_tools, approved parent script hosts to %global_allowed_script_hosts, and named GPO administrators to %global_allowed_admin_users. Raise severity for non-admin users or servers that are not domain controllers or management hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|powershell_ise|findstr|robocopy|xcopy)\.exe$/ nocase
    $proc.target.process.command_line = /\\sysvol\\[^\\\s"']+\\policies/ nocase
    $proc.target.process.command_line = /\b(dir|type|findstr|get-childitem|gci|ls|get-content|gc|cat|select-string|sls|copy|copy-item|robocopy|xcopy|tree)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1615")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
