/*
  MITRE Technique : T1037.002 - Login Hook
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:54:31.860844+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_002_MacOS_LoginHook_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects defaults or PlistBuddy modifying the com.apple.loginwindow LoginHook or LogoutHook keys when the process was spawned by an unexpected parent, such as an Office application, browser, web server, database service, print service or language runtime. Admin-driven login hook changes normally come from an interactive shell or management tooling, not from these parents. A hook set from one of them suggests exploitation or a malicious document or script establishing root-level logon persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.002"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Login Hook"
    log_prerequisites = "Requires macOS endpoint process telemetry that populates the parent process path, child process path and full command line."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Enterprise management or deployment agents that launch defaults from a runtime such as java or node; legacy MDM or imaging workflows that still configure login hooks; developers testing login hooks from an IDE or language runtime; the Terminal application and interactive shells are intentionally not treated as unexpected parents."
    tuning_guidance = "Add approved management agent parent binaries to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. Extend or trim the parent process regex to match the server roles present at the client. Login hooks are deprecated, so any remaining legitimate use should be documented and allowlisted per client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(Microsoft (Word|Excel|PowerPoint|Outlook)|httpd|nginx|apache2|php|php-fpm|java|node|tomcat|mysqld|postgres|mongod|cupsd|cups-lpd|Safari|Google Chrome|firefox)$/ nocase
    $proc.target.process.file.full_path = /\/(defaults|PlistBuddy)$/ nocase
    $proc.target.process.command_line = /com\.apple\.loginwindow/ nocase
    $proc.target.process.command_line = /(LoginHook|LogoutHook)/ nocase
    $proc.target.process.command_line = /\b(write|add|set|merge|import)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1037.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
