/*
  MITRE Technique : T1591.001 - Determine Physical Locations
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:26:22.540465+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_001_External_Automated_Scraping_Of_Location_Pages {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external client using a scripted HTTP library or command-line client to request location-themed pages (contact, locations, offices, facilities, directions, store locator) on a protected web asset. This is a network-side indicator of automated gathering of victim physical-location information. Low-fidelity, early-stage reconnaissance signal. Use it for enrichment and correlation, not stand-alone escalation."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.001"
    mitre_technique_name = "Gather Victim Org Information: Determine Physical Locations"
    log_prerequisites = "IDS/IPS or inline network security appliance that logs HTTP transactions with URL, source IP and User-Agent mapped to UDM (target.url, principal.ip, network.http.user_agent). Requires inspection of traffic to externally exposed web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Uptime and synthetic monitoring, SEO and marketing crawlers using scripted clients, partner or customer integrations consuming a store-locator or contact page, authorised penetration tests and scanners, legitimate API consumers fetching office information."
    tuning_guidance = "Add authorised scanner and testing source IPs to %global_allowed_scanners. Review top source IPs and extend the exclusion list for known monitoring services. Tighten the URL regex to the customer's actual location pages, or raise severity only when the same source IP also appears in other reconnaissance detections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\/(contact(-us)?|locations?|store-?locator|find-?us|offices?|facilities|directions|branches|data-?cent(er|re)s?|campus(es)?)(\/|\.[a-z]+|\?|#|$)/ nocase
    $http.network.http.user_agent = /(curl|wget|python-requests|python-urllib|scrapy|go-http-client|libwww-perl|okhttp|apache-httpclient|aiohttp|node-fetch|axios|headlesschrome|phantomjs)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1591.001")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $web_targets = array_distinct($http.target.hostname)

  condition:
    $http
}
