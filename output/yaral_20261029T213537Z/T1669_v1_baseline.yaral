/*
  MITRE Technique : T1669 - Wi-Fi Networks
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:39:24.417549+00:00
  Reference       : https://attack.mitre.org/techniques/T1669
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1669_Wireless_Intrusion_Verdict_From_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an IPS or wireless-aware network security appliance verdict that reports hostile or unauthorized wireless activity: a rogue or evil-twin access point, an unauthorized wireless station or association, a deauthentication or disassociation attack, or an ad-hoc network. These are the observable network-side results of an adversary gaining initial access over Wi-Fi. The rule matches the verdict wording in security_result, not an action value, and does not rely on any vendor, SSID, address or signature ID."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1669"
    mitre_technique_name = "Wi-Fi Networks"
    log_prerequisites = "Requires IPS or network security appliance logs (ideally with wireless intrusion prevention) normalized to UDM NETWORK_CONNECTION, with security_result.rule_name or security_result.description populated and principal.ip set."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Authorized wireless site surveys and penetration tests, neighbouring or guest access points flagged as rogue by an over-sensitive policy, BYOD or IoT devices not yet onboarded, lab or test SSIDs, and misconfigured controllers that raise deauthentication alerts during roaming or failover."
    tuning_guidance = "Add authorized survey and testing sources to %global_allowed_scanners. Add approved controller and management sources to %global_allowed_mgmt_sources. If a signature is noisy, tighten the regex per tenant or lower the risk score through the SOAR playbook. Where the appliance reports wireless alerts as a different event type, deploy a sibling rule for that type."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip != ""
    (
      $net.security_result.rule_name = /(rogue.{0,10}(ap|access.?point)|evil.?twin|unauthori[sz]ed.{0,20}(wireless|wi-?fi|wlan|access.?point|station|client)|wireless.{0,20}(intrusion|attack|association)|wlan.{0,20}(attack|intrusion)|deauth|disassoc.{0,10}flood|ad.?hoc.{0,10}network)/ nocase or
      $net.security_result.description = /(rogue.{0,10}(ap|access.?point)|evil.?twin|unauthori[sz]ed.{0,20}(wireless|wi-?fi|wlan|access.?point|station|client)|wireless.{0,20}(intrusion|attack|association)|wlan.{0,20}(attack|intrusion)|deauth|disassoc.{0,10}flood|ad.?hoc.{0,10}network)/ nocase
    )
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1669")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $rule_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
