/*
  MITRE Technique : T1590.002 - DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:15:31.613195+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_002_External_DNS_Enumeration_Then_TCP_Zone_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single external source sends repeated UDP/53 flows to DNS infrastructure and then opens a TCP/53 connection within ten minutes. This pattern is consistent with DNS record enumeration followed by a zone transfer (AXFR/IXFR) attempt, used to map a target's name servers, subdomains, mail servers and hosts."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.002"
    mitre_technique_name = "Gather Victim Network Information: DNS"
    log_prerequisites = "Requires IDS/IPS or network security appliance flow and connection logs that record source IP, destination port, and IP protocol for traffic to DNS servers. Both inbound UDP/53 flows and TCP/53 connections must be logged, including allowed traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Secondary or slave name servers performing legitimate zone transfers; external DNS monitoring and uptime services; authorised vulnerability scanners and external attack-surface management tools; recursive resolvers of large ISPs that retry over TCP after truncated UDP responses."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners and known secondary DNS or partner name server addresses to %global_allowed_mgmt_sources. Raise or lower the #udp threshold in the condition to match the client's DNS exposure. Public authoritative servers with heavy resolver traffic may need a higher threshold."

  events:
    $udp.metadata.event_type = "NETWORK_FLOW"
    $udp.target.port = 53
    $udp.network.ip_protocol = "UDP"
    not $udp.principal.ip in %rfc1918_internal
    not $udp.principal.ip in %global_allowed_scanners
    not $udp.principal.ip in %global_allowed_mgmt_sources
    $udp.principal.ip = $src_ip

    $tcp.metadata.event_type = "NETWORK_CONNECTION"
    $tcp.target.port = 53
    $tcp.network.ip_protocol = "TCP"
    not $tcp.principal.ip in %rfc1918_internal
    not $tcp.principal.ip in %global_allowed_scanners
    not $tcp.principal.ip in %global_allowed_mgmt_sources
    $tcp.principal.ip = $src_ip

    $udp.metadata.event_timestamp.seconds <= $tcp.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1590.002")
    $primary_entity = array_distinct($src_ip)
    $udp_flow_count = count($udp.metadata.id)
    $dns_servers_udp = array_distinct($udp.target.ip)
    $dns_servers_tcp = array_distinct($tcp.target.ip)
    $first_seen = min($udp.metadata.event_timestamp.seconds)
    $last_seen = max($tcp.metadata.event_timestamp.seconds)

  condition:
    #udp >= 3 and $tcp
}
