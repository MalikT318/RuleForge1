/*
  MITRE Technique : T1591.002 - Business Relationships
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:28:04.874335+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_002_Automated_Business_Relationship_Page_Harvesting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external client using a scripted or non-browser HTTP user agent to request web paths that disclose business relationships (partners, suppliers, vendors, customers, resellers, contractors, supply chain). This is the network-side footprint of an adversary harvesting second- and third-party relationship information from victim-owned web properties for later targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.002"
    mitre_technique_name = "Gather Victim Org Information: Business Relationships"
    log_prerequisites = "IDS/IPS or inline network security appliance that decodes HTTP (URL and user agent) for inbound traffic to organisation-owned web servers, normalised to UDM NETWORK_HTTP with principal.ip, target.url and network.http.user_agent populated. Requires TLS inspection or a reverse-proxy or WAF tap for HTTPS traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate search-engine, SEO, brand-monitoring and uptime crawlers; partner or customer integrations that poll partner and vendor portal pages with scripts; the organisation's own marketing or web-analytics tooling; authorised external vulnerability scanners and penetration tests; business-intelligence and sales-prospecting services that scrape public pages."
    tuning_guidance = "Add authorised scanner and testing source addresses to %global_allowed_scanners. Internal sources are already excluded via %rfc1918_internal. Adjust the path keyword list to match the client's site structure. Where monitored sites legitimately expose partner pages to API consumers, exclude known integration source IPs with %global_allowed_scanners. This is a low-fidelity reconnaissance signal: use it for enrichment or correlation with other recon detections from the same source IP rather than as a standalone paging alert."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/(business[-_]?partners?|partners?|suppliers?|vendors?|customers|clients|resellers|distributors|alliances|subcontractors|contractors|supply[-_]?chain|managed[-_]?service[-_]?providers?)([\/\.\?#_-]|$)/ nocase
    $net.network.http.user_agent = /(curl|wget|python|go-http-client|scrapy|libwww|okhttp|java\/|httpclient|aiohttp|node-fetch|axios|headless|phantomjs|powershell|httpie)/ nocase
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1591.002")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $targeted_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
