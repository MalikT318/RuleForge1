/*
  MITRE Technique : T1593.002 - Search Engines
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:45:42.965845+00:00
  Reference       : https://attack.mitre.org/techniques/T1593/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_002_Search_Engine_Dork_Referral_Inbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects inbound HTTP requests to externally exposed web assets whose referral URL carries a search-engine query using advanced dork operators (inurl, intitle, intext, filetype and similar). This indicates an external party used search engine syntax to hunt for exposed content on the protected site, then followed a result. The match is on query operator syntax in the referrer query string, not on any specific search engine domain."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593.002"
    mitre_technique_name = "Search Open Websites/Domains: Search Engines"
    log_prerequisites = "Requires IDS/IPS or inline network security appliance logs with HTTP inspection (URL and Referer header) normalised to NETWORK_HTTP with network.http.referral_url populated. TLS inspection or a decrypted web path is needed to see the referrer on HTTPS traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security researchers and SEO or site-audit staff checking their own indexed content; authorised external attack-surface or vulnerability scanners; bug bounty participants; web crawlers that replay search referrers; employees working from external or home networks."
    tuning_guidance = "Add authorised scanner and assessment source IPs to %global_allowed_scanners. Add known staff egress or VPN addresses to %global_allowed_mgmt_sources. If volume is high, raise severity only when the same source also shows scanning or blocked-request patterns against the same target. Many search engines strip the query from the Referer header, so absence of a hit does not mean absence of reconnaissance."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.referral_url = /[?&#](q|query|p|text|search|wd|k)=[^&#]*(inurl|allinurl|intitle|allintitle|intext|allintext|filetype)(:|%3a|%253a)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1593.002")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $referral_urls = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
