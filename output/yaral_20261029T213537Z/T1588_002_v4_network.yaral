/*
  MITRE Technique : T1588.002 - Tool
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:56:46.933985+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_002_Tool_Download_Raw_IP_Or_Scripted_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host fetching an executable, script, installer or archive over HTTP from an external destination, where the URL points at a raw IP address or the request comes from a command-line or scripted HTTP client. This is the network-side footprint of an adversary pulling a freshly obtained tool (post-exploitation framework, remote admin utility, archive-packed toolkit) from attacker-controlled staging infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.002"
    mitre_technique_name = "Obtain Capabilities: Tool"
    log_prerequisites = "Requires proxy or perimeter firewall logs normalised to NETWORK_HTTP with target.url populated. The network.http.user_agent field improves coverage but is not required for the raw-IP branch."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Administrators or build pipelines downloading installers from internal-facing IP-addressed repositories that are not in RFC1918 space, IoT or appliance firmware updates fetched by IP, package managers and update agents using scripted user agents against vendor CDNs not yet in the known-good domain list, and developers pulling release archives with command-line clients."
    tuning_guidance = "Add legitimate vendor, CDN and update domains to %global_allowed_domains. Confirm %rfc1918_internal covers all internal address space for the client. If scripted-client noise is high, raise severity only for the raw-IP branch or remove the user-agent branch for that tenant."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(exe|dll|msi|ps1|bat|vbs|hta|scr|jar|zip|7z|rar|iso)(\?|#|$)/ nocase
    (
      $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}([:\/]|$)/ nocase or
      $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|powershell|windowspowershell|winhttp|microsoft bits|certutil)/ nocase
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1588.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $download_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
