/*
  MITRE Technique : T1608.005 - Link Target
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:28:19.356620+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_005_Link_Target_Credential_Lure_On_Bare_IP_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request through the perimeter to an external host addressed by a bare IP literal, where the URL path looks like a credential-harvesting or login lure (login, signin, verify, password, webmail, sso). Adversaries staging link-target resources for phishing often serve cloned login pages from raw infrastructure without a registered domain. The rule flags the user-facing result of that staging: a client reaching the lure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.005"
    mitre_technique_name = "Stage Capabilities: Link Target"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_HTTP with target.url populated (URL-aware inspection or SSL decryption for HTTPS)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Appliance, printer, or IoT management portals reached by IP; legitimate SaaS or vendor login pages served from IP-addressed hosts; internal-facing portals on public IPs; authorised phishing simulations."
    tuning_guidance = "Add approved scanners and phishing-simulation sources to %global_allowed_scanners, known-good external domains to %global_allowed_domains, and keep %rfc1918_internal current. Tighten the keyword list or require a specific HTTP method if volume is high."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /^(https?:\/\/)?(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?\/[^?#]*(login|log-in|logon|signin|sign-in|verify|validate|password|passwd|webmail|sso|account|secure|auth)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1608.005")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
