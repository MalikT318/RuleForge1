/*
  MITRE Technique : T1590.002 - DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:16:39.875490+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_002_External_DNS_TCP_Probe_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens many TCP connections to DNS (port 53) on internal or perimeter hosts within ten minutes. Inbound TCP/53 is normally rare because ordinary queries use UDP. Repeated TCP/53 sessions from one source are consistent with zone-transfer (AXFR/IXFR) attempts, name-server enumeration and DNS record harvesting during pre-compromise reconnaissance. A single connection is benign; the volume from one source is the signal."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.002"
    mitre_technique_name = "Gather Victim Network Information: DNS"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated. The sensor must see inbound traffic on the perimeter or DMZ segment."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate secondary or slave name servers performing zone transfers or large-response TCP fallback; public recursive resolvers or DNS-based CDN and monitoring services querying authoritative servers over TCP; authorised external vulnerability scanners and pentest sources; DNS health-check or uptime-monitoring providers; email security services doing bulk SPF/MX lookups."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners and partner or secondary DNS server IPs to %global_allowed_mgmt_sources. The threshold of 10 TCP/53 connections per source in 10 minutes is conservative. Raise it for tenants that host authoritative DNS with many secondary servers, or lower it for tenants that do not expose DNS externally. Scope the sensor to perimeter traffic to reduce noise."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    $net.network.ip_protocol = "TCP"
    $net.principal.ip = $src_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 50, 75, 50))
    $mitre_technique_id = array_distinct("T1590.002")
    $primary_entity = array_distinct($src_ip)
    $targeted_dns_servers = array_distinct($net.target.ip)
    $targeted_hosts = array_distinct($net.target.hostname)

  condition:
    #net >= 10
}
