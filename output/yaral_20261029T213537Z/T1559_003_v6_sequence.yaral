/*
  MITRE Technique : T1559.003 - XPC Services
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:44:36.572245+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_003_XPC_Helper_Dropped_Then_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a privileged helper tool being written to /Library/PrivilegedHelperTools and, within 10 minutes on the same host, that same helper binary launching a shell, scripting interpreter or download utility. Helpers are launched by launchd as root and receive requests over XPC. A helper spawning an interpreter is the observable result of malicious content being passed to an XPC service handler, such as through weak client validation or unsanitised input."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.003"
    mitre_technique_name = "Inter-Process Communication: XPC Services"
    log_prerequisites = "Requires macOS endpoint telemetry (EDR or unified log) that provides both FILE_CREATION and PROCESS_LAUNCH events with parent process path and hostname populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate third-party installers or updaters (VPN clients, disk utilities, creative suites) that drop a helper and then have it run an install script; MDM or software deployment agents; developers testing SMJobBless/privileged helper code."
    tuning_guidance = "Add approved installer, updater and deployment tooling paths to %global_allowed_admin_tools. Add approved security agents to %global_allowed_security_tools. If a specific vendor helper legitimately runs scripts, add its helper path to %global_allowed_admin_tools rather than loosening the interpreter regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/PrivilegedHelperTools\/[^\/]+$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $helper

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /^\/Library\/PrivilegedHelperTools\/[^\/]+$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|zsh|dash|tcsh|osascript|python[0-9.]*|perl|ruby|curl)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname
    $proc.principal.process.file.full_path = $helper

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $helper over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1559.003")
    $primary_entity = array_distinct($hostname)
    $helper_path = array_distinct($helper)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $spawned_processes = array_distinct($proc.target.process.file.full_path)
    $spawned_command_lines = array_distinct($proc.target.process.command_line)
    $spawn_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
