/*
  MITRE Technique : T1608.003 - Install Digital Certificate
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:25:25.803297+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_003_ACME_Certificate_Issuance_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests to external hosts that follow the ACME certificate issuance protocol (directory, account, nonce, order, authorization and challenge endpoints, or the well-known HTTP-01 challenge path). Automated TLS certificate enrolment from a client-side or perimeter vantage point can indicate an adversary installing a certificate on compromised or attacker-staged infrastructure, either to encrypt C2 or to make a credential-harvesting site look credible. The rule keys on the standardised protocol path structure, not on any specific CA, domain, or client tool."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.003"
    mitre_technique_name = "Stage Capabilities: Install Digital Certificate"
    log_prerequisites = "Requires firewall or proxy logs with HTTP URL visibility (TLS inspection or plaintext HTTP) normalised to UDM NETWORK_HTTP with target.url and target.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate web servers, load balancers, mail gateways and reverse proxies that auto-renew certificates through ACME; DevOps and container platforms; approved certificate management automation."
    tuning_guidance = "Add known certificate-automation hosts to %global_allowed_script_hosts. Add known-good internal sources to %global_allowed_mgmt_sources. Add approved external domains to %global_allowed_domains. Raise severity when the source is a workstation or a server with no history of certificate enrolment."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/\.well-known\/acme-challenge\/|\/acme(-v[0-9]+)?\/(directory|new-acct|new-nonce|new-order|order|authz|chall))/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.hostname in %global_allowed_script_hosts
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1608.003")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
