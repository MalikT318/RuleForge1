/*
  MITRE Technique : T1098.004 - SSH Authorized Keys
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:06:37.816320+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_004_External_SSH_To_Internal_Mgmt_Plane {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an inbound SSH or NETCONF-over-SSH connection from an external address to an internal device. A firewall cannot see authorized_keys changes, so this is the network-observable consequence of key-based persistence: an adversary logging in remotely with a planted key. It is complementary coverage to endpoint command-line rules."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.004"
    mitre_technique_name = "Account Manipulation: SSH Authorized Keys"
    log_prerequisites = "Requires firewall, proxy or perimeter connection/flow logs that record source IP, destination IP and destination port for traffic entering the network. Logs must be normalised to UDM NETWORK_CONNECTION."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor or MSP remote support over SSH, administrators working remotely without a registered jump host, third-party managed network services, authorised penetration tests and external vulnerability scans."
    tuning_guidance = "Add approved jump hosts, VPN egress and MSP source addresses to %global_allowed_mgmt_sources. Add authorised scanning sources to %global_allowed_mgmt_sources. Raise severity for management-plane destinations such as network devices and hypervisors, and lower it for internet-facing bastions designed to receive SSH."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 830)
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1098.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
