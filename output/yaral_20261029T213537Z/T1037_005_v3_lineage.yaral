/*
  MITRE Technique : T1037.005 - Startup Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:57:00.993819+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_005_MacOS_Unexpected_Parent_StartupItems {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or file-manipulation utility referencing /Library/StartupItems when it was spawned by an unexpected parent: an Office application, web server, database service or print service. Legitimate StartupItems are installed by package installers or admin tooling, not by these parents. Their involvement suggests exploitation or macro or web-shell abuse to plant boot-time persistence that runs as root."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.005"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Startup Items"
    log_prerequisites = "Requires macOS endpoint process telemetry (EDR or unified log) populating parent process path, child process path and full command line for PROCESS_LAUNCH events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy third-party installers or management agents that deploy StartupItems through a web or database-hosted admin console; developer or test servers where a web or database process legitimately runs deployment scripts; Office add-in installers that run helper scripts."
    tuning_guidance = "Add approved parent binaries (deployment and packaging tools) to %global_allowed_admin_tools. Add known script-hosting parents to %global_allowed_script_hosts. Extend the parent regex with local server software if needed. Validate that Microsoft Office app bundle paths match the client's install layout."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office apps, web servers, database services, print service
    (
      $proc.principal.process.file.full_path = /\/Microsoft (Word|Excel|PowerPoint|Outlook)\.app\/Contents\/MacOS\/Microsoft (Word|Excel|PowerPoint|Outlook)$/ nocase or
      $proc.principal.process.file.full_path = /\/(httpd|apache2|nginx|php-fpm[0-9.]*|lighttpd|mysqld|mariadbd|postgres|mongod|cupsd)$/ nocase
    )

    // Child: shell, interpreter or file utility
    $proc.target.process.file.full_path = /\/(sh|bash|zsh|dash|ksh|tcsh|osascript|python[0-9.]*|perl|ruby|php|cp|mv|tee|chmod|mkdir|install|ditto|cat|touch)$/ nocase

    // Action touches the StartupItems directory
    $proc.target.process.command_line = /\/Library\/StartupItems(\/|\s|$|"|')/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1037.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
