/*
  MITRE Technique : T1588.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:55:04.604363+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_001_CLI_Download_Of_Unix_Payload_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host using a command-line HTTP client (curl, wget and similar) to fetch a Unix/Linux/macOS-style executable or payload artifact (ELF/binary, shell script, shared object, kernel module, disk image or installer package) from an external destination. Acquisition of malware (T1588.001) happens off-network, so this rule detects the observable result: a payload being pulled through the perimeter by a non-browser client. It is written for Unix-like tooling as an alternate to Windows .exe/.dll download coverage."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.001"
    mitre_technique_name = "Obtain Capabilities: Malware"
    log_prerequisites = "Requires firewall or web proxy logs normalised to NETWORK_HTTP with target.url and network.http.user_agent populated (TLS inspection or explicit proxy required for HTTPS visibility)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Package and software installation scripts, configuration management and CI/CD agents fetching install scripts or binaries, developers pulling release artifacts, vendor agent installers, legitimate OS or application update mechanisms."
    tuning_guidance = "Add known-good vendor, repository and CDN domains to %global_allowed_domains. Add patching, build and management server source addresses to %global_allowed_mgmt_sources. Raise severity or require repeat hits per host if internal build farms generate noise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(curl|wget|libwww-perl|python-urllib|python-requests|fetch)\b/ nocase
    $net.target.url = /\.(elf|sh|bash|bin|so|ko|dylib|pkg|dmg|run|appimage)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1588.001")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $download_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
