/*
  MITRE Technique : T1608.002 - Upload Tool
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:24:12.170185+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_002_Burst_Tool_Archive_Downloads_From_External_Hosts {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source retrieves several executable, script, or archive-type files over HTTP from external hosts within ten minutes. This is the network-observable result of tooling staged on third-party or adversary-controlled web infrastructure (T1608.002) and then pulled into the environment. One such download is routine; a burst of them from one source is not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.002"
    mitre_technique_name = "Stage Capabilities: Upload Tool"
    log_prerequisites = "Requires firewall or proxy logs with HTTP URL visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP, with principal.ip and target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software update and patching clients, developer package and dependency fetches, CI/CD build agents, IT staff downloading installers, vulnerability or security scanners fetching test files, and users downloading ISO or archive files from vendors not yet in the allowlist."
    tuning_guidance = "Add trusted vendor, CDN, and update domains to %global_allowed_domains. Add scanner and authorised testing source addresses to %global_allowed_scanners. Raise the #net threshold for environments with heavy developer or build traffic. Narrow the extension regex if archive downloads are common."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /(?i)\.(exe|dll|msi|ps1|bat|vbs|jar|elf|bin|sh|7z|zip|rar|iso)(\?|#|$)/
    $net.principal.ip = $src_ip
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1608.002")
    $primary_entity = array_distinct($src_ip)
    $download_hosts = array_distinct($net.target.hostname)
    $download_urls = array_distinct($net.target.url)

  condition:
    #net >= 5
}
