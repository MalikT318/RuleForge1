/*
  MITRE Technique : T1598.003 - Spearphishing Link
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:15:23.952166+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_003_Obfuscated_URL_Phishing_Link_Web_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound web requests whose URL uses classic spearphishing-link obfuscation. Two forms are matched: a host written as an integer, hexadecimal or dotted-hex value, and a URL whose userinfo section (the text before an '@') looks like a legitimate domain, which disguises the real destination host. Both are tricks MITRE describes for links in spearphishing-for-information emails. Observed from the network side at the perimeter, so it works whatever the endpoint or mail client."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.003"
    mitre_technique_name = "Phishing for Information: Spearphishing Link"
    log_prerequisites = "Requires perimeter web proxy or firewall URL-logging telemetry normalised to UDM NETWORK_HTTP with target.url populated. Firewalls without URL inspection will not populate this field."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legacy applications or scripts that embed credentials in URLs (user:pass@host); security awareness or phishing-simulation platforms; internal developer or QA tooling using numeric hosts; URL-shortener or tracking redirectors that encode hosts as integers; vulnerability scanners and red-team exercises."
    tuning_guidance = "Add known-good destination hostnames to %global_allowed_domains. Add authorised phishing-simulation and scanner source addresses to %global_allowed_scanners. Internal destinations are already excluded via %rfc1918_internal. If hex or integer hosts are common in a client's environment, split the regex branches and lower severity for that client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    (
      $http.target.url = /^[a-z][a-z0-9+.\-]*:\/\/(0x[0-9a-f]+(\.(0x)?[0-9a-f]+){0,3}|[0-9]{8,10})(:[0-9]+)?([\/?#]|$)/ nocase or
      $http.target.url = /^[a-z][a-z0-9+.\-]*:\/\/[^\/?#@]*\.[a-z]{2,}[^\/?#@]*@[^\/?#@]+/ nocase
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
