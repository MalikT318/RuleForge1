/*
  MITRE Technique : T1588.005 - Exploits
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:01:56.456366+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_005_External_Probe_Then_Exploit_Pattern {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "T1588.005 is not directly observable because exploit acquisition happens off-network. This rule detects the perimeter-visible result of adversaries using acquired exploits. One external source generates repeated client-error (4xx) probe responses against an internal web target, then sends a request to the same target whose URL carries generic exploit-technique markers: directory traversal, encoded traversal, null byte, command-injection metacharacters, or expression-interpolation syntax. It matches technique classes rather than specific CVE payloads."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.005"
    mitre_technique_name = "Obtain Capabilities: Exploits"
    log_prerequisites = "Requires firewall, proxy or WAF-style perimeter logs normalised to NETWORK_HTTP with principal.ip, target.ip, target.url and network.http.response_code populated. TLS inspection or reverse-proxy logging is needed to see URLs on HTTPS."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners or penetration tests not yet in the allowlist, misconfigured web crawlers, applications that legitimately embed encoded paths or template syntax in URLs, and developers testing their own exposed applications."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners. Add known-good external domains to %global_allowed_domains if partner integrations trigger the URL pattern. Raise the #probe threshold in the condition for noisy internet-facing estates, or narrow the URL regex to the client's exposed application stack."

  events:
    $probe.metadata.event_type = "NETWORK_HTTP"
    $probe.network.http.response_code >= 400
    $probe.network.http.response_code < 500
    not $probe.principal.ip in %rfc1918_internal
    not $probe.principal.ip in %global_allowed_scanners
    $probe.principal.ip = $src
    $probe.target.ip = $dst

    $exploit.metadata.event_type = "NETWORK_HTTP"
    $exploit.target.url = /(\.\.(\/|\\|%2f|%5c)|%2e%2e|%00|\$\{[a-z]+:|(;|\||`|%7c|%60)\s*(wget|curl|bash|sh|nc|powershell)\b|\/etc\/passwd|\/windows\/win\.ini)/ nocase
    not $exploit.principal.ip in %rfc1918_internal
    not $exploit.principal.ip in %global_allowed_scanners
    not $exploit.target.hostname in %global_allowed_domains
    $exploit.principal.ip = $src
    $exploit.target.ip = $dst

    $probe.metadata.event_timestamp.seconds <= $exploit.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1588.005")
    $primary_entity = array_distinct($src)
    $targeted_ips = array_distinct($dst)
    $probe_count = count($probe.metadata.id)
    $exploit_urls = array_distinct($exploit.target.url)
    $exploit_response_codes = array_distinct($exploit.network.http.response_code)

  condition:
    #probe >= 3 and $exploit
}
