/*
  MITRE Technique : T1588.002 - Tool
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:56:30.046641+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_002_Scripted_Tool_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host using a non-browser, scripting or command-line HTTP client to fetch an executable, library, script or archive payload from an external destination. This is the network-observable result of an adversary staging obtained tooling (T1588.002) onto an environment. Tool acquisition itself happens outside the victim's visibility, so this rule covers the point where acquired tooling is pulled in. It matches on client behaviour and payload type only, with no tool names, domains or IPs."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.002"
    mitre_technique_name = "Obtain Capabilities: Tool"
    log_prerequisites = "Requires proxy, secure web gateway or perimeter firewall with URL inspection that populates network.http.user_agent and target.url in NETWORK_HTTP events."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Package managers and build pipelines using curl, wget or Python clients; patching and software deployment scripts; DevOps or admin scripts downloading installers; vendor update utilities with non-browser user agents."
    tuning_guidance = "Add known-good vendor, repository and CDN domains to %global_allowed_domains. Add trusted internal egress sources (build servers, patch servers) to %global_allowed_mgmt_sources or %global_allowed_admin_tools. Raise severity for user workstations and lower it for server or build subnets. If the proxy does not populate user agent, this rule will not fire."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.user_agent = /(?i)^(curl|wget|python-requests|python-urllib|go-http-client|powershell|windowspowershell|winhttp|microsoft-cryptoapi|libwww-perl|java\/|okhttp|aiohttp)/
    $net.target.url = /(?i)\.(exe|dll|msi|ps1|bat|sh|elf|bin|jar|zip|7z|rar|iso|gz|tgz)(\?.*)?$/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1588.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $download_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
