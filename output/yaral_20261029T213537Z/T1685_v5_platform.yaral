/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:41:36.100757+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_ESXi_Logging_And_Security_Setting_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi host advanced settings that control remote syslog forwarding, local log location, log retention, management agent log verbosity, or the execInstalledOnly execution control. Adversaries (notably ransomware operators) change these settings to blind defenders and stop log forwarding before encrypting datastores. This rule works from host configuration-change events, not process command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "ESXi hostd configuration-change events must be forwarded to Chronicle and parsed to SETTING_MODIFICATION. The changed setting name must be populated in target.resource.name or metadata.description. Logs must be sent from a path that survives a syslog redirect, such as vCenter event forwarding or a second syslog target."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned SIEM or syslog collector migrations, host build and baseline automation (host profiles, Ansible, PowerCLI), log capacity tuning by virtualization admins, and temporary log verbosity increases during VMware support troubleshooting."
    tuning_guidance = "Add named virtualization administrators to %global_allowed_admin_users and automation or host-profile accounts to %global_allowed_service_accounts. Add approved change-automation or jump host source addresses to %global_allowed_mgmt_sources. Correlate with change tickets; any change made from an unlisted source, or just before a bulk VM power-off or shell enablement event, should be treated as hostile."

  events:
    $s.metadata.event_type = "SETTING_MODIFICATION"
    (
      $s.target.resource.name = /(Syslog\.global\.(logHost|logDir|logDirUnique|defaultRotate|defaultSize|auditRecord\.[a-z]+)|Syslog\.loggers\.[a-z]+\.[a-z]+|Config\.HostAgent\.log\.level|VMkernel\.Boot\.execInstalledOnly)/ nocase
      or
      $s.metadata.description = /(Syslog\.global\.(logHost|logDir|logDirUnique|defaultRotate|defaultSize|auditRecord\.[a-z]+)|Syslog\.loggers\.[a-z]+\.[a-z]+|Config\.HostAgent\.log\.level|VMkernel\.Boot\.execInstalledOnly)/ nocase
    )
    not $s.principal.user.userid in %global_allowed_admin_users
    not $s.principal.user.userid in %global_allowed_service_accounts
    not $s.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($s.principal.hostname)
    $acting_user = array_distinct($s.principal.user.userid)
    $source_ip = array_distinct($s.principal.ip)
    $changed_setting = array_distinct($s.target.resource.name)

  condition:
    $s
}
