/*
  MITRE Technique : T1583.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:03:16.176592+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_003_Direct_IP_HTTP_NonStandard_Port_VPS_Infra {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects internal clients making HTTP requests to an external bare IP address (no domain name) on a high, non-standard port. The rental of a VPS is not directly observable, so this rule targets how freshly provisioned VPS-hosted adversary infrastructure typically appears at the perimeter: IP-literal URLs, no DNS-resolved hostname, and ephemeral service ports. Treat it as a heuristic indicator of rented infrastructure, not proof."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.003"
    mitre_technique_name = "Acquire Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection that populate target.url, target.ip and target.port, normalised to UDM NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal tools, IoT devices and appliances that call home by IP; software updaters and developer or test workloads using IP-literal URLs; legitimate partner services exposed on custom ports; vulnerability scanners."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Internal address space is excluded through %rfc1918_internal; keep that list current for each client. Raise the port threshold or add a minimum request count at the SOAR layer if volume is high. Pair with threat-intel or ASN enrichment downstream to confirm hosting-provider ownership."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d+)?(\/|$)/ nocase
    $net.target.port > 1024
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
