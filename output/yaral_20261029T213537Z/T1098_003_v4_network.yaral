/*
  MITRE Technique : T1098.003 - Additional Cloud Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:06:23.896342+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_003_SaaS_External_Role_Grant_API_Call {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a state-changing API request (POST/PUT/PATCH) to a role-assignment, policy-attachment, policy-version or IAM-binding endpoint, issued from a non-internal source address by an identity that is not an approved administrator, service account or cloud principal. This is the network-side view of an adversary granting additional roles or permissions to a compromised or attacker-controlled cloud account for persistence or privilege escalation."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.003"
    mitre_technique_name = "Account Manipulation: Additional Cloud Roles"
    log_prerequisites = "Requires cloud control-plane or SaaS admin API audit telemetry normalised to NETWORK_HTTP, with network.http.method, target.url, principal.ip and principal.user.userid populated. Tenants whose audit logs map only to USER_RESOURCE_ACCESS or RESOURCE_PERMISSIONS_CHANGE will not trigger this rule."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Administrators working remotely over home or mobile networks, IaC pipelines and CI/CD runners hosted outside the corporate range, identity-governance or access-review tooling, SaaS-to-SaaS provisioning integrations, and break-glass accounts used during incidents."
    tuning_guidance = "Add approved admin identities to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved service principals to %global_allowed_cloud_principals. Add trusted egress or VPN addresses to %global_allowed_mgmt_sources. If the URL pattern is noisy for a tenant, narrow the regex to the role-grant endpoints used by that tenant's platform. Consider raising severity when the grantee is the same identity as the caller."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.target.url = /(roleassignments?|role-assignments?|roledefinitions?|attach[a-z]*polic(y|ies)|create[a-z]*policyversion|put[a-z]*polic(y|ies)|setiampolicy|add[a-z]*(member|user)[a-z]*to[a-z]*(role|group)|add[a-z]*role|grant[a-z]*role|memberof|directoryroles)/ nocase
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.003")
    $primary_entity = array_distinct($net.principal.user.userid)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
