/*
  MITRE Technique : T1584.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:30:18.617101+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_007_Serverless_Endpoint_NonBrowser_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host making an HTTP request through a proxy or perimeter device to a public serverless function hostname (edge worker, function URL, API gateway, script runtime) using a scripted, library or empty user agent rather than a browser. Adversary-compromised serverless functions are used as C2 responders or redirectors, and the traffic blends into traffic to the cloud provider."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.007"
    mitre_technique_name = "Compromise Infrastructure: Serverless"
    log_prerequisites = "Requires proxy or perimeter logs that record the HTTP host (target.hostname) and the user agent (network.http.user_agent), normalised to NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers and DevOps scripts calling the organisation's own serverless APIs, SaaS integrations hosted on serverless platforms, monitoring or webhook senders, and CI/CD jobs using command-line HTTP clients."
    tuning_guidance = "Add known-good serverless hostnames, such as the organisation's own function endpoints and vendor APIs, to %global_allowed_domains. Add developer, automation and build hosts to %global_allowed_script_hosts. Raise severity when the same host repeats the request at regular intervals or when the destination is not in a tenant baseline."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /(\.workers\.dev|\.lambda-url\.[a-z0-9-]+\.on\.aws|\.execute-api\.[a-z0-9-]+\.amazonaws\.com|\.cloudfunctions\.net|\.run\.app|script\.google\.com|script\.googleusercontent\.com|\.azurewebsites\.net)$/ nocase
    $http.network.http.user_agent = /(?i)(^$|^(curl|wget|python|go-http-client|java|okhttp|libwww|axios|node)|powershell|winhttp|windowshttpclient)/
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.007")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
