/*
  MITRE Technique : T1591.004 - Identify Roles
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:33:22.354095+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_004_External_Role_Enumeration_Web_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source makes many HTTP requests to organisation, leadership, staff-directory and team-profile pages within ten minutes. Each request is benign on its own, but the volume suggests automated harvesting of roles and key personnel ahead of targeted phishing or account attacks."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.004"
    mitre_technique_name = "Gather Victim Org Information: Identify Roles"
    log_prerequisites = "Requires IDS/IPS or network security appliance HTTP inspection logs that populate target.url and principal.ip, normalised to UDM NETWORK_HTTP. The sensor must sit in front of or inspect traffic to public web properties."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine crawlers and SEO tooling, uptime and content monitors, authorised external vulnerability scanners and penetration tests, corporate proxies or NAT gateways aggregating many legitimate visitors, recruiters and journalists browsing team pages through shared egress IPs, and website QA or accessibility checkers."
    tuning_guidance = "Add authorised scanner and testing source addresses to %global_allowed_scanners. Add approved partner or monitoring source addresses to %global_allowed_mgmt_sources. Raise the #http threshold for high-traffic public sites, or lower it for low-traffic sites. Extend or trim the role-page path keywords to match the customer's site structure."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(about|about-us|team|our-team|meet-the-team|leadership|management|executives?|staff|people|directory|board|who-we-are|bio|profiles?)(\/|\.|\?|#|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $risk_score = max(if(re.regex($http.target.url, /(?i)(executive|ceo|cfo|ciso|board|leadership|directory)/), 65, 45))
    $mitre_technique_id = array_distinct("T1591.004")
    $primary_entity = array_distinct($src)
    $event_count = count($http.metadata.id)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    #http >= 10
}
