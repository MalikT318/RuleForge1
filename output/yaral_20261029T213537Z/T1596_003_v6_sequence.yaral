/*
  MITRE Technique : T1596.003 - Digital Certificates
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:03:54.709507+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_003_External_TLS_Probe_Then_Cert_Path_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Low"
    description = "Detects an external source that connects to a TLS-serving port on a protected asset and then, within ten minutes, requests certificate-related or CA-validation web paths from the same asset. This pattern is consistent with certificate and TLS reconnaissance ahead of targeting. Passive lookups of public certificate data (CT logs, lookup sites) are not visible to the victim, so this rule covers only the active, observable part of the technique."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.003"
    mitre_technique_name = "Search Open Technical Databases: Digital Certificates"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION (with principal.ip, target.port) and NETWORK_HTTP (with target.url). The sensor must see inbound traffic to internet-facing assets, with TLS decrypted or HTTP logged on the web tier."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Certificate authority domain-validation servers during ACME or other certificate issuance and renewal, external uptime and TLS-expiry monitors, authorised third-party vulnerability scanners and attack-surface management services, search-engine crawlers, partners validating the client's certificates."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners, and approved external management sources to %global_allowed_mgmt_sources. If CA validation traffic is noisy, extend the exclusions or narrow the URL regex. Adjust the TLS port list to the services exposed by each client. Raise severity when the same source also appears in port-scan or web-scan detections."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    ($conn.target.port = 443 or $conn.target.port = 8443 or $conn.target.port = 4443 or $conn.target.port = 465 or $conn.target.port = 993 or $conn.target.port = 995 or $conn.target.port = 636)
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    $conn.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/\.well-known\/(pki-validation|acme-challenge)\/|\/[^\/?]*(cert|ssl|tls|pki)[^\/?]*\.(crt|pem|cer|der|p7b|pfx)(\?.*)?$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1596.003")
    $primary_entity = array_distinct($src_ip)
    $probed_target_ips = array_distinct($conn.target.ip)
    $probed_ports = array_distinct($conn.target.port)
    $requested_urls = array_distinct($http.target.url)
    $conn_count = count($conn.metadata.id)
    $http_count = count($http.metadata.id)

  condition:
    $conn and $http
}
