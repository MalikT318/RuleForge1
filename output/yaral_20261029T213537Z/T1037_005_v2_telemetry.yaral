/*
  MITRE Technique : T1037.005 - Startup Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:56:45.409888+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_005_MacOS_StartupItems_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file creation inside a subdirectory of the legacy macOS StartupItems folder (/Library/StartupItems). A startup item is a directory holding an executable and a StartupParameters.plist. These run as root during the final phase of boot, so a new file here is a persistence and privilege escalation mechanism. The rule works at the file-artifact layer, so it fires regardless of how the item was written (shell, script, installer, or custom binary) and does not depend on command-line logging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.005"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Startup Items"
    log_prerequisites = "Requires macOS endpoint telemetry that records file creation events with the full target path and the creating (principal) process path, for example an EDR file-event feed or an Endpoint Security framework based sensor."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy third-party software installers that still ship StartupItems, IT deployment and patching tools placing legacy startup items, and admins deliberately testing or maintaining old-style startup items. StartupItems is deprecated, so legitimate activity is rare on modern macOS."
    tuning_guidance = "Add approved deployment or installer binaries (full process path) to %global_allowed_admin_tools and approved endpoint security agents to %global_allowed_security_tools. If a legacy application is known to install a startup item, allow its installer by process path rather than by the item's directory name. Review any hit where the creating process is a shell, interpreter, or a binary running from a user-writable location such as /tmp or /Users."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(System\/)?Library\/StartupItems\/[^\/]+\/.+/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
