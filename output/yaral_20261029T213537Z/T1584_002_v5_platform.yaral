/*
  MITRE Technique : T1584.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:20:59.037592+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_002_DNS_Tunnel_TXT_NULL_LongLabel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for TXT or NULL records that contain an abnormally long subdomain label (45 or more characters) under a domain not in the known-good list. This pattern is typical of encoded C2 or exfiltration over DNS, including through third-party DNS infrastructure that an adversary has compromised or controls (T1584.002). The rule uses the PRE (external-facing DNS) angle: it relies only on resolver query telemetry and no endpoint fields."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.002"
    mitre_technique_name = "Compromise Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam DNSBL lookups, DKIM/SPF/DMARC TXT lookups with long selectors, CDN or cloud services that use long hashed hostnames, domain-verification TXT records, and content-filtering or AV cloud-lookup services that encode data in labels."
    tuning_guidance = "Add legitimate registered domains (for example email security vendors and CDNs) to %global_allowed_domains. The registered domain is extracted as the last two labels, so for multi-part public suffixes such as co.uk, add the full value that re.capture returns. Raise the label length threshold from 45 to 55 or more in noisy environments. Narrow the record types to TXT only if NULL queries are not relevant to the client."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{45,}\.[^.]+\.[^.]+$/ nocase
    $reg_domain = re.capture($dns.network.dns.questions.name, `([^.]+\.[^.]+)$`)
    not $reg_domain in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584.002")
    $primary_entity = array_distinct(strings.coalesce($dns.principal.hostname, $dns.principal.ip))
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $source_ips = array_distinct($dns.principal.ip)

  condition:
    $dns
}
