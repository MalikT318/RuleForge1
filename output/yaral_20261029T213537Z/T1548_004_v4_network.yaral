/*
  MITRE Technique : T1548.004 - Elevated Execution with Prompt
  Tactic(s)       : Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:34:00.185659+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_004_macOS_Privileged_Staged_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of the outcome of AuthorizationExecuteWithPrivileges abuse on macOS. A root-owned process launched from a user-writable staging location (mounted DMG volume, /tmp, Downloads, user Library, per-user temp folders), or spawned by the authorization trampoline helper, makes an outbound connection to a non-internal address. This is typical of installer droppers that gain root through the credential prompt and then pull down a second-stage payload."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.004"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Elevated Execution with Prompt"
    log_prerequisites = "Requires macOS endpoint network telemetry (NETWORK_CONNECTION) with principal process path, principal user and, ideally, parent process path populated. Complements endpoint process-creation rules for this technique."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate installers or updaters run from a mounted DMG or Downloads folder that elevate through the authorization prompt and then fetch components or licence checks; software deployment tooling staging payloads in /tmp; developer build tools running as root from user directories."
    tuning_guidance = "Add approved deployment, MDM and patching binaries to %global_allowed_admin_tools. Add EDR and security agents to %global_allowed_security_tools. Add approved remote management tooling to %global_allowed_remote_mgmt. Review recurring vendor installers and allowlist by executable path only after confirming the signer."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.user.userid = "root" nocase
    (
      $net.principal.process.file.full_path = /^\/(Volumes\/[^\/]+\/|private\/tmp\/|tmp\/|private\/var\/folders\/|Users\/[^\/]+\/(Downloads|Desktop|Library)\/)/ nocase
      or
      $net.principal.process.parent_process.file.full_path = /\/security_authtrampoline$/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $parent_path = array_distinct($net.principal.process.parent_process.file.full_path)

  condition:
    $net
}
