/*
  MITRE Technique : T1587.002 - Code Signing Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:49:54.751074+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_002_Timestamp_Service_DNS_Then_Signing_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An internal source resolves a trusted-timestamping (RFC 3161 style) service name and then sends an HTTP POST to an external timestamp or TSA endpoint within 10 minutes. Self-signed code signing workflows commonly counter-sign with a public timestamp authority. When the source is not a known build or signing host, this can indicate code signing activity for adversary tooling. Pre-compromise certificate creation is rarely observable, so this is a low-fidelity hunting-grade indicator of signing activity."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.002"
    mitre_technique_name = "Develop Capabilities: Code Signing Certificates"
    log_prerequisites = "Requires perimeter or proxy logs that populate NETWORK_DNS (query name) and NETWORK_HTTP (method, target URL, source IP). A proxy or TLS-inspecting firewall is needed to see the HTTP POST."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software build and CI/CD servers, developer workstations signing legitimate releases, release engineering and packaging pipelines, and security or IT teams signing internal scripts."
    tuning_guidance = "Add known build and signing hosts to %global_allowed_script_hosts. Add approved timestamp authority domains to %global_allowed_domains. Raise severity for sources outside engineering or build network segments. Without TLS inspection the HTTP leg will not populate, so consider the rule inactive for that client."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(timestamp|(^|\.)tsa[0-9\-]*\.)/ nocase
    not $dns.principal.hostname in %global_allowed_script_hosts
    $dns.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /(timestamp|\/tsa\b|rfc3161)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts
    $http.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1587.002")
    $primary_entity = array_distinct($src_ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $signing_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $request_count = count($http.metadata.id)

  condition:
    $dns and $http
}
