/*
  MITRE Technique : T1556 - Modify Authentication Process
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:40:43.624247+00:00
  Reference       : https://attack.mitre.org/techniques/T1556
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_LSASS_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Local Security Authority process (lsass.exe) initiating a network connection to a non-internal address. Legitimate LSASS traffic (Kerberos, LDAP, NetLogon, SMB/RPC) goes to internal domain controllers and servers. A tampered authentication process, such as a malicious password filter, authentication package, SSP or patched LSASS, can send harvested credentials or authentication material to external infrastructure. This is the network-side counterpart to endpoint rules for T1556 and does not depend on command-line matching."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556"
    mitre_technique_name = "Modify Authentication Process"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path, with NETWORK_CONNECTION events normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Entra ID (Azure AD) joined or hybrid-joined hosts where LSASS CloudAP contacts Microsoft identity endpoints; certificate revocation (CRL/OCSP) or AIA lookups made by LSASS during PKINIT or smart-card logon; Kerberos to external realms or cross-forest trusts routed over public address space; domain controllers with externally hosted KDC proxy or ADFS dependencies."
    tuning_guidance = "Add known-good identity and certificate endpoints (for example Microsoft identity and CRL/OCSP domains) to %global_allowed_domains. Add approved EDR or security agents that proxy through LSASS to %global_allowed_security_tools. If the tenant uses non-RFC1918 internal ranges, add them to %rfc1918_internal. If a trust or KDC proxy legitimately sends LSASS traffic externally, scope it per client rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hostnames = array_distinct($net.target.hostname)

  condition:
    $net
}
