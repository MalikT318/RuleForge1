/*
  MITRE Technique : T1546.006 - LC_LOAD_DYLIB Addition
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:29:45.422735+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_006_MacOS_DylibTooling_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Mach-O modification tooling (install_name_tool, vtool, codesign_allocate, codesign) launched by an unexpected parent such as an Office application, browser, mail client, web server, database service, print spooler or osascript. Legitimate dylib or signature manipulation comes from developer toolchains, not from document, browser or server processes. This indicates tampering with a binary's LC_LOAD_DYLIB load commands or its code signature for persistence. Detection pivots on process lineage rather than command-line content."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.006"
    mitre_technique_name = "Event Triggered Execution: LC_LOAD_DYLIB Addition"
    log_prerequisites = "macOS endpoint telemetry that populates both parent and child process image paths on process launch events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Application auto-updaters (browser or Office updaters) re-signing or relinking bundles, developer tooling launched from a web or database service in build or CI environments, MDM or packaging scripts invoked via osascript, and administrators patching binaries manually."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. Build servers can be excluded via %global_allowed_script_hosts. Narrow or extend the parent regex to match the client's application estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(install_name_tool|vtool|codesign_allocate|codesign)$/ nocase
    $proc.principal.process.file.full_path = /(\/Microsoft (Word|Excel|PowerPoint|Outlook)\.app\/|\/(Safari|Google Chrome|Firefox|Mail|Preview)\.app\/|\/(httpd|nginx|php-fpm|mysqld|postgres|cupsd|osascript)$)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
