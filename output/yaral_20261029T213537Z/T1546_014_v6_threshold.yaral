/*
  MITRE Technique : T1546.014 - Emond
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:32:02.031277+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_014_Emond_Rule_Files_Bulk_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple file creations within ten minutes under the emond rules directory (/etc/emond.d/rules) or the emond QueueDirectories path (/private/var/db/emondClients) on a single macOS host. Writing a rule plist plus the queue-directory trigger file is the setup needed for emond-based persistence and privilege escalation. Any single file write is rare and low-signal, but several in a short window point to deliberate staging. This is a file-creation volume detection and does not rely on process command lines."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.014"
    mitre_technique_name = "Event Triggered Execution: Emond"
    log_prerequisites = "Requires macOS endpoint file-creation telemetry (EDR or unified log) with target.file.full_path, principal.hostname and principal.process.file.full_path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Authorised MDM or configuration management pushing emond rules, OS upgrades or installers that recreate /etc/emond.d content, administrators or security researchers testing emond, and backup or restore tooling repopulating /private/var/db."
    tuning_guidance = "Add approved deployment, MDM and configuration-management binaries to %global_allowed_admin_tools, and EDR or security agents to %global_allowed_security_tools. Raise the #file threshold on fleets where emond is legitimately managed. Review the creating process and user in the outcome fields to separate admin activity from implant staging."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(private\/)?(etc\/emond\.d\/rules\/|var\/db\/emondClients\/)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /emond\.d\/rules\// nocase, 80, 65))
    $mitre_technique_id = array_distinct("T1546.014")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $created_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $creating_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
