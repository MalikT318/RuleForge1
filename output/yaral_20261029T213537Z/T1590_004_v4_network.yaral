/*
  MITRE Technique : T1590.004 - Network Topology
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:19:39.364622+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_004_External_Probe_Of_Network_Topology_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source connecting to network-infrastructure and routing/management services (SNMP, BGP, RIP, vendor Smart Install, NETCONF over SSH) that expose network topology details such as device inventory, routes, neighbours and gateway configuration. Observed from the IDS/IPS network perimeter, this is characteristic of pre-compromise topology reconnaissance."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.004"
    mitre_technique_name = "Gather Victim Network Information: Network Topology"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for perimeter-facing sensors."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Managed service provider or ISP monitoring of customer-edge routers (SNMP polling), legitimate BGP peers with an external address, authorised vulnerability scanners and penetration tests, cloud or partner network-monitoring platforms, and Internet-wide research scanners that probe these ports continuously."
    tuning_guidance = "Add authorised scanners and testing sources to %global_allowed_scanners, and approved monitoring or peering addresses to %global_allowed_mgmt_sources. Add approved NOC or service accounts to %global_allowed_service_accounts if the sensor populates principal.user.userid. Tune the port list to the services the client actually exposes. For noisy internet-facing sensors, consider promoting this to a threshold rule grouped on source IP."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 179 or
      $net.target.port = 520 or
      $net.target.port = 521 or
      $net.target.port = 830 or
      $net.target.port = 4786
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1590.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
