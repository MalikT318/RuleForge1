/*
  MITRE Technique : T1594 - Search Victim-Owned Websites
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:48:54.647192+00:00
  Reference       : https://attack.mitre.org/techniques/T1594
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1594_External_Hidden_Path_Probing_Web {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting hidden, sensitive or leftover files on a victim-owned website (version-control metadata, environment and credential files, editor or backup leftovers, database dumps, server config and diagnostic pages). These requests are characteristic of wordlist-driven content discovery and manual site reconnaissance. Observed from the network side via IDS/IPS HTTP inspection."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1594"
    mitre_technique_name = "Search Victim-Owned Websites"
    log_prerequisites = "IDS/IPS or network security appliance with HTTP inspection that populates network.http fields and target.url (or target.hostname plus the URI path). Sensors must see traffic to externally exposed web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and penetration tests not yet in the scanner list, search-engine and internet-measurement crawlers, uptime or compliance monitors, legitimate partner or developer access to backup or diagnostic endpoints, and web applications that deliberately serve paths such as /.well-known/."
    tuning_guidance = "Populate %global_allowed_scanners with authorised scanning and testing source addresses. Internal sources are excluded through %rfc1918_internal. To reduce volume, add a response-code filter (for example network.http.response_code = 200 to see only successful exposure) or raise the rule to a Threshold variant grouped by principal.ip. Extend the path regex with application-specific sensitive paths per client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(\.git|\.svn|\.hg|\.env|\.htpasswd|\.htaccess|\.ds_store|\.ssh|\.aws|\.bash_history)(\/|\?|$)|\/(wp-config\.php|web\.config|phpinfo\.php|server-status|server-info|config\.php)(\.(bak|old|orig|txt|save))?(\?|$)|\.(bak|old|orig|swp|sql)(\?|$)|\/(backup|backups|dump|database|db)\.(sql|zip|tar|tgz|gz)(\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1594")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
