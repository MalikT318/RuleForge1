/*
  MITRE Technique : T1587.003 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:51:13.699023+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_003_SelfSigned_TLS_Cert_External_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host completing a TLS connection to an external server whose presented certificate is self-signed (issuer equals subject). Adversaries commonly generate self-signed certificates for C2 and staging infrastructure. This is the network-observable result of that activity, seen from the client side."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.003"
    mitre_technique_name = "Develop Capabilities: Digital Certificates"
    log_prerequisites = "Requires firewall or proxy logs with TLS inspection or TLS metadata that populate network.tls.server.certificate.issuer and subject. Without these fields the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Self-signed certificates on legitimate external appliances, IoT or lab devices, vendor management interfaces, small-business or hosted services, and developer test servers reached over the internet."
    tuning_guidance = "Add known-good external domains (matched on TLS server name) to %global_allowed_domains. Tune %rfc1918_internal if the tenant uses non-standard internal space. Consider scoping to egress interfaces in the ingestion parser. Review repeated hits to the same destination across hosts, as these are stronger C2 candidates."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.tls.server.certificate.issuer != ""
    $net.network.tls.server.certificate.subject != ""
    $net.network.tls.server.certificate.issuer = $net.network.tls.server.certificate.subject
    not $net.target.ip in %rfc1918_internal
    not $net.network.tls.client.server_name in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1587.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $tls_server_names = array_distinct($net.network.tls.client.server_name)
    $cert_subjects = array_distinct($net.network.tls.server.certificate.subject)

  condition:
    $net
}
