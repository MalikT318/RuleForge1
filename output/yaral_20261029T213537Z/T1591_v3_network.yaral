/*
  MITRE Technique : T1591 - Gather Victim Org Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:24:56.152075+00:00
  Reference       : https://attack.mitre.org/techniques/T1591
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_Scripted_Org_Info_Page_Harvesting_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source using a scripted or library HTTP client to request organisation-information pages (staff directory, org chart, leadership, team, departments) on an inspected web service. Automated harvesting of these pages is a common precursor to targeted phishing and social engineering."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591"
    mitre_technique_name = "Gather Victim Org Information"
    log_prerequisites = "Requires IPS or network security appliance logs that perform HTTP inspection and populate network.http.user_agent and target.url (or equivalent path) in UDM NETWORK_HTTP events."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and availability monitors, partner or vendor integrations that poll staff or directory pages, authorised penetration tests and external attack-surface scans, and legitimate API clients that call people or directory endpoints."
    tuning_guidance = "Add authorised scanning and testing sources to %global_allowed_scanners. If your web applications legitimately expose people or directory APIs to automation, narrow the URL regex to the specific pages of concern, or exclude trusted destinations by adding their hostnames to %global_allowed_domains. Treat as a low-fidelity signal and use it for enrichment or correlation with other reconnaissance alerts from the same source."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(org[-_]?chart|staff[-_]?(directory|list)|employee[s]?|leadership|management[-_]?team|our[-_]?team|meet[-_]?the[-_]?team|people|directory|departments?)(\/|\?|\.|$)/ nocase
    $http.network.http.user_agent = /(curl|wget|python-requests|python-urllib|go-http-client|scrapy|libwww|okhttp|java\/|httpclient|aiohttp|node-fetch|axios)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1591")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
