/*
  MITRE Technique : T1591.002 - Business Relationships
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:28:56.503534+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_002_Automated_Business_Relationship_Page_Harvest {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "An external client using a scripted HTTP library user agent requests web content that exposes business relationships (partners, suppliers, vendors, subcontractors, resellers, supply chain). This is passive reconnaissance to identify third parties with trusted access to the organisation. The rule is built on the HTTP request pattern and does not depend on a named tool or fixed infrastructure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.002"
    mitre_technique_name = "Gather Victim Org Information: Business Relationships"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with HTTP inspection that populate target.url, network.http.user_agent and principal.ip, normalised to NETWORK_HTTP. The appliance must sit in front of or inline with externally reachable web properties."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers using library-based user agents, uptime and synthetic monitors, partner or customer integrations that poll partner-portal URLs, commercial attack-surface or brand-monitoring services engaged by the client, and legitimate API consumers."
    tuning_guidance = "Add authorised scanners and monitoring source IPs to %global_allowed_scanners. If a client has no public partner or supplier pages, the path pattern can be narrowed to client-specific section names. To reduce volume, convert to a Threshold rule that groups by principal.ip and requires several distinct matching URLs. Validate that the appliance populates network.http.user_agent before deploying."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(partners?|suppliers?|vendors?|subcontractors?|resellers?|distributors?|supply[-_]?chain|procurement|channel[-_]partners?|our[-_]clients|customers)(\/|\.|\?|$)/ nocase
    $http.network.http.user_agent = /(curl|wget|python-requests|python-urllib|go-http-client|libwww|okhttp|java\/|scrapy|httpclient|aiohttp|node-fetch|axios)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1591.002")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
