/*
  MITRE Technique : T1591.003 - Identify Business Tempo
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:31:16.634662+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_003_External_Business_Tempo_Page_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Low"
    description = "A single external source makes a high volume of web requests to pages that disclose business tempo (operating hours, holiday or delivery schedules, locations, events calendars) within ten minutes. One request is benign. Repeated enumeration of these pages from one address is consistent with automated reconnaissance for business tempo (T1591.003). This activity is largely off-network and only partly observable, so the rule is a low-fidelity early-warning signal. Use it for enrichment or correlation with other recon indicators, not as a standalone incident trigger."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.003"
    mitre_technique_name = "Gather Victim Org Information: Identify Business Tempo"
    log_prerequisites = "IPS or network security appliance with HTTP/URL inspection that populates target.url and principal.ip on NETWORK_HTTP events for inbound traffic to internet-facing web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and availability monitors, partner or customer integrations that poll schedule or location pages, legitimate customers behind shared NAT or proxy addresses, authorised external scanners."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Raise the #http threshold (default 8 per 10m) for high-traffic public sites. Extend or trim the URL keyword regex to match the customer's website structure. Use only as a correlation input if the client has a public-facing marketing site with heavy crawler traffic."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(business[-_]?hours|opening[-_]?hours|hours[-_]?of[-_]?operation|store[-_]?hours|office[-_]?hours|holiday[-_]?schedule|delivery[-_]?schedule|shipping|events|calendar|locations?|store[-_]?locator)(\/|\.|\?|$)/ nocase
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $event_count = count($http.metadata.id)
    $risk_score = if($event_count >= 30, 50, 30)
    $mitre_technique_id = array_distinct("T1591.003")
    $primary_entity = array_distinct($src_ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    #http >= 8
}
