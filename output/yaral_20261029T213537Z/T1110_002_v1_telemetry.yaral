/*
  MITRE Technique : T1110.002 - Password Cracking
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:07:58.583875+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_002_Tenant_Password_Auth_Policy_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a tenant-level configuration change to password or authentication policy (complexity, length, expiry, lockout, legacy or basic authentication) made by an account that is not an approved administrator or service account. Adversaries who recover plaintext credentials by cracking hashes offline often weaken these controls to keep access that does not depend on MFA or password rotation. This rule works at the configuration-change layer and does not rely on process or command-line telemetry. It does not observe the offline cracking itself, which happens outside the tenant, and covers only the post-compromise policy change."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.002"
    mitre_technique_name = "Brute Force: Password Cracking"
    log_prerequisites = "Requires identity provider and productivity-suite directory or admin audit logs that are normalised to SETTING_MODIFICATION with target.resource.name populated and principal.user.userid identifying the actor."
    platform = "Office Suite"
    log_source = "identity"
    false_positives = "Planned password policy reviews by the identity team, compliance-driven policy hardening, onboarding of a legacy application that needs basic authentication, tenant migrations, and delegated administrators who are not yet in the approved lists."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or provisioning identities to %global_allowed_service_accounts. Add approved cloud or app principals to %global_allowed_cloud_principals. If a client logs many policy edits, narrow the target.resource.name regex to the policy names that matter for that tenant. Correlate hits with prior sign-in anomalies for the same actor."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(password.{0,20}(policy|complexity|length|expir|lockout|protection|reset)|(legacy|basic).{0,10}auth|smart.?lockout|lockout.{0,10}(threshold|duration)|self.?service.{0,10}password)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1110.002")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
