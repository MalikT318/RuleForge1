/*
  MITRE Technique : T1608.004 - Drive-by Target
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:26:23.159884+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_004_Web_Content_Upload_To_Hosted_Site {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful HTTP write (PUT, PATCH or POST) from an external source directly to a static web content file such as JS, HTML, CSS or SVG. Static files are normally served, not written to. A write like this indicates an adversary uploading or injecting drive-by content (for example malicious JavaScript) into a web property, via WebDAV, a compromised CMS or a web shell, to stage a watering-hole or drive-by compromise."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.004"
    mitre_technique_name = "Stage Capabilities: Drive-by Target"
    log_prerequisites = "Requires firewall, reverse proxy or WAF logs that record the HTTP method, full URL, response code and source IP (SSL inspection or termination in front of the web tier)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate CMS or content editors publishing pages from external IPs, WebDAV-based publishing, CI/CD or deployment pipelines pushing static assets, SaaS site builders, and form handlers that POST to .html endpoints."
    tuning_guidance = "Add trusted publisher and deployment source addresses to %global_allowed_mgmt_sources and authorised testing sources to %global_allowed_scanners. If the firewall logs post-NAT addresses, confirm the source IP is the true client. Raise severity for hosts known to serve high-traffic or customer-facing sites."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(PUT|PATCH|POST)$/ nocase
    $http.target.url = /\.(js|mjs|html?|css|svg)(\?.*)?$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608.004")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $uploaded_urls = array_distinct($http.target.url)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
