/*
  MITRE Technique : T1596.001 - DNS/Passive DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:00:30.077996+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_001_External_DNS_Service_Probing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens many TCP connections to DNS port 53 within ten minutes. This pattern is consistent with zone-transfer (AXFR/IXFR) attempts, subdomain enumeration, or DNS record harvesting against victim-owned name servers. A single TCP/53 session is usually benign, but sustained volume from one external address is not."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.001"
    mitre_technique_name = "Search Open Technical Databases: DNS/Passive DNS"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection or flow logs that record source IP, destination port and transport protocol for traffic reaching externally exposed DNS servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Secondary or partner name servers performing legitimate zone transfers or large-response TCP fallback, external monitoring and uptime services, recursive resolvers of large ISPs querying authoritative servers, and authorised external scanners or penetration tests."
    tuning_guidance = "Add authorised external scanners to %global_allowed_scanners. Add trusted secondary DNS and partner source addresses to %global_allowed_mgmt_sources. Raise the #net threshold for authoritative DNS servers with heavy TCP fallback. Limit the rule to externally exposed DNS server ranges in the IPS policy if internet-wide noise is high."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    $net.network.ip_protocol = "TCP"
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $distinct_targets = count_distinct($net.target.ip)
    $mitre_technique_id = array_distinct("T1596.001")
    $primary_entity = array_distinct($src)
    $targeted_dns_servers = array_distinct($net.target.ip)

  condition:
    #net >= 20
}
