/*
  MITRE Technique : T1583 - Acquire Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:56:57.369983+00:00
  Reference       : https://attack.mitre.org/techniques/T1583
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_DNS_Long_Label_Algorithmic_Domain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries containing an abnormally long, unbroken alphanumeric subdomain label (40+ characters) that resolve outside internal address space. This is the network-side footprint of algorithmically generated or freshly provisioned attacker infrastructure (DGA, tunnelling, or C2 staging domains). Adversaries acquiring domains and servers under T1583 typically use machine-generated names rather than human-readable ones."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583"
    mitre_technique_name = "Acquire Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Answer data (network.dns.answers.data) is used for the internal-address exclusion when available."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-provider hostnames with long generated labels, DKIM/DMARC or other email-authentication lookups, anti-virus and reputation cloud lookups that encode hashes in the label, Kerberos or service-discovery names, content-addressed storage hosts, and browser or telemetry beacons."
    tuning_guidance = "Add known-good domains (CDNs, vendors, update services) to %global_allowed_domains. Add authorised scanning or testing hosts to %global_allowed_scanners. To reduce noise, raise the label-length threshold from 40 to 50 or more in the regex. To increase sensitivity, lower it to 32. Internal-resolving answers are excluded via %rfc1918_internal."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)(^|\.)[a-z0-9]{40,}\./
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal
    not $dns.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1583")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
