/*
  MITRE Technique : T1588.004 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:59:14.283672+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_004_ACME_Certificate_Issuance_Request_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal source sending ACME protocol (RFC 8555) certificate-issuance requests (account registration, new order, finalize, challenge) to an external certificate authority. Outside approved certificate automation, this can indicate unauthorized certificate acquisition for C2 or phishing infrastructure. The rule matches the protocol's URL structure, not a specific CA, domain or tool."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.004"
    mitre_technique_name = "Obtain Capabilities: Digital Certificates"
    log_prerequisites = "Requires perimeter or proxy logs with full HTTP URL visibility (TLS inspection or explicit proxy) populating network.http and target.url. Without URL visibility this rule will not fire. Pair with the DNS-based variant for _acme-challenge lookups."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate certificate automation: web servers, load balancers, reverse proxies, Kubernetes cert-manager, developer workstations and lab hosts using ACME clients; managed hosting and CDN onboarding; internal ACME-capable PKI addressed by a public IP."
    tuning_guidance = "Add approved CA and enterprise ACME endpoints to %global_allowed_domains. Add known certificate-automation hosts to %global_allowed_script_hosts. Review hits from user workstations or non-server segments first; they carry the highest signal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(acme|acme-v[0-9]+|v[0-9]+\/acme)\/(directory|new-(acct|account|order|nonce|authz)|finalize|order|chall|challenge|cert|revoke-cert)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1588.004")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $request_urls = array_distinct($http.target.url)

  condition:
    $http
}
