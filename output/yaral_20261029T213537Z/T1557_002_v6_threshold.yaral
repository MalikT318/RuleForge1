/*
  MITRE Technique : T1557.002 - ARP Cache Poisoning
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:42:46.468117+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_002_ARP_Spoofing_Alert_Volume_Per_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single internal source (typically a macOS endpoint on the LAN segment) repeatedly named in network-perimeter or switching-layer ARP integrity events, such as ARP spoofing or poisoning alerts, duplicate IP/MAC conflicts, gratuitous ARP floods, or ARP inspection violations. Any one such event is routine, but a sustained burst from one source within ten minutes indicates active ARP cache poisoning for an adversary-in-the-middle position. The rule uses network-observable telemetry only; the firewall cannot see the initiating process or the OS."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.002"
    mitre_technique_name = "Adversary-in-the-Middle: ARP Cache Poisoning"
    log_prerequisites = "Firewall or network-perimeter logs (including L2/ARP inspection or anti-spoofing events) normalised to UDM NETWORK_FLOW with the alert text populated in security_result.summary or security_result.description. The logging device must sit on, or inspect, the client VLAN."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "IP address conflicts from DHCP misconfiguration, failover and HA pairs (VRRP/HSRP virtual MAC moves), VM or container live migration, NIC teaming, laptops roaming between wired and Wi-Fi, network scanners, and noisy anti-spoofing sensors on guest or BYOD networks."
    tuning_guidance = "Add scanner and network-test hostnames to %global_allowed_scanners. Raise the #net threshold for segments with frequent HA failover or VM mobility. Lower it for high-trust server VLANs. Tighten the summary and description regex to match the alert wording your firewall or switch emits."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    (
      $net.security_result.summary = /(arp.{0,20}(spoof|poison|conflict|flood|inspection|violation|mismatch)|(spoof|poison|duplicate|conflict|gratuitous).{0,20}arp|duplicate\s+(ip|mac)|mac\s+(flap|move|conflict))/ nocase or
      $net.security_result.description = /(arp.{0,20}(spoof|poison|conflict|flood|inspection|violation|mismatch)|(spoof|poison|duplicate|conflict|gratuitous).{0,20}arp|duplicate\s+(ip|mac)|mac\s+(flap|move|conflict))/ nocase
    )
    $net.principal.ip = $src
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 20, 85, 60))
    $mitre_technique_id = array_distinct("T1557.002")
    $primary_entity = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $first_seen = min($net.metadata.event_timestamp.seconds)
    $last_seen = max($net.metadata.event_timestamp.seconds)

  condition:
    #net >= 5
}
