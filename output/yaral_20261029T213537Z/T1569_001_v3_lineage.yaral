/*
  MITRE Technique : T1569.001 - Launchctl
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:51:41.792478+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_001_Launchctl_Unexpected_Parent_macOS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects launchctl running a load, bootstrap, submit, start or kickstart subcommand when its parent is an unexpected process. Unexpected parents are an Office application, browser, mail client, document reader or collaboration app, or a scripting interpreter referencing a user-writable plist location. This lineage suggests launchd is being abused to execute a payload after document, browser or script-based initial access."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.001"
    mitre_technique_name = "System Services: Launchctl"
    log_prerequisites = "Requires macOS endpoint process telemetry (EDR or unified log) that populates the parent process path, child process path and child command line for PROCESS_LAUNCH events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Application auto-updaters or helper installers launched from a browser or Office app, enterprise MDM or software deployment scripts run through interpreters, developer tooling (Homebrew services, Python or Ruby based installers), and IT admins testing launch agents from scripts."
    tuning_guidance = "Add approved deployment, MDM and packaging tools to %global_allowed_admin_tools. Add trusted automation parents to %global_allowed_script_hosts. Add admin accounts to %global_allowed_admin_users and service accounts to %global_allowed_service_accounts. To broaden or narrow the interpreter branch, adjust the plist location regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/launchctl$/ nocase
    $proc.target.process.command_line = /\b(load|bootstrap|submit|start|kickstart)\b/ nocase
    (
      $proc.principal.process.file.full_path = /\/(Microsoft Word|Microsoft Excel|Microsoft PowerPoint|Microsoft Outlook|Safari|Google Chrome|firefox|Mail|Preview|Adobe Acrobat|Acrobat Reader|zoom\.us|Slack|Microsoft Teams|Keynote|Pages|Numbers)$/ nocase
      or
      (
        $proc.principal.process.file.full_path = /\/(osascript|python[0-9.]*|perl|ruby|php|node|curl|wget)$/ nocase
        and $proc.target.process.command_line = /(\/tmp\/|\/private\/tmp\/|\/private\/var\/tmp\/|\/var\/tmp\/|\/Users\/Shared\/|\/Users\/[^\/]+\/(Library\/LaunchAgents|Downloads|Library\/Caches|\.[^\/]+)\/)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1569.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $launchctl_command = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
