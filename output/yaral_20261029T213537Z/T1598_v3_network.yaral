/*
  MITRE Technique : T1598 - Phishing for Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:09:37.325572+00:00
  Reference       : https://attack.mitre.org/techniques/T1598
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_Credential_Post_To_IP_Literal_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client sending an HTTP POST to an external host addressed by raw IP literal, with a URL path typical of credential-harvesting pages (login, signin, verify, password, webmail). Legitimate sites rarely collect credentials on a bare IP address, so this pattern is characteristic of phishing-for-information landing pages. It is observed on the network side, independent of endpoint telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598"
    mitre_technique_name = "Phishing for Information"
    log_prerequisites = "Requires proxy or perimeter firewall logs normalised to UDM NETWORK_HTTP with network.http.method and target.url populated (TLS inspection is needed for HTTPS paths)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Appliance, camera, or IoT management portals reached by IP; internal-facing apps published on public IPs; captive portals; developer or test servers addressed by IP; authorised phishing simulations."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains and authorised phishing-simulation or scanner sources to %global_allowed_scanners. If a client has legitimate IP-addressed portals, list their addresses in %global_allowed_mgmt_sources. Extend the path keyword list per client if needed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\// nocase
    $http.target.url = /(login|log-in|logon|signin|sign-in|verify|validation|account|password|credential|webmail|secure-?auth)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598")
    $primary_entity = array_distinct(strings.coalesce($http.principal.hostname, $http.principal.ip))
    $destination_ips = array_distinct($http.target.ip)
    $destination_urls = array_distinct($http.target.url)

  condition:
    $http
}
