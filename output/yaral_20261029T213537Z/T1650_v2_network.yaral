/*
  MITRE Technique : T1650 - Acquire Access
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:36:08.780326+00:00
  Reference       : https://attack.mitre.org/techniques/T1650
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1650_DNS_TXT_NULL_Long_Label_Implant_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS TXT or NULL queries with an unusually long subdomain label, a pattern used by DNS-tunnelled C2 and loader channels. Limitation: the purchase of access (T1650) happens off-network and cannot be observed. This rule is a proxy that detects the network footprint of a broker-sold implant or load beaconing out over DNS, not the acquisition itself."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1650"
    mitre_technique_name = "Acquire Access"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam DNS blocklist lookups, DKIM/SPF/DMARC validation with long selectors, CDN and cloud service discovery records, software licensing and telemetry services that encode data in subdomains, and some AV cloud lookups."
    tuning_guidance = "Add known-good parent domains to %global_allowed_domains. The list match is exact on the queried name, so add the full names of recurring noisy FQDNs. Adjust the label length threshold (40) per environment. Pair with query-volume analytics for higher fidelity."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_\-]{40,}(\.|$)/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1650")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $source_ips = array_distinct($dns.principal.ip)

  condition:
    $dns
}
