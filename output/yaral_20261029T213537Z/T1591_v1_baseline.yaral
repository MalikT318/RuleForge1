/*
  MITRE Technique : T1591 - Gather Victim Org Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:24:22.904245+00:00
  Reference       : https://attack.mitre.org/techniques/T1591
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_Automated_Org_Info_Page_Harvesting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source using a scripted or library HTTP client to request web paths that expose organization information (staff directories, org charts, leadership or team pages, department listings). Browsers fetch these pages with browser user agents, so scripted retrieval indicates automated victim-organization reconnaissance."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591"
    mitre_technique_name = "Gather Victim Org Information"
    log_prerequisites = "IDS/IPS or inline network security appliance that logs HTTP transactions with URL and User-Agent, normalized to UDM NETWORK_HTTP. Requires TLS inspection or a plaintext HTTP sensor in front of public web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search-engine and SEO crawlers using library user agents, uptime and availability monitors, partner or vendor integrations polling team or contact pages, authorized external attack-surface assessments, and the organization's own marketing or HR scraping jobs."
    tuning_guidance = "Add authorised scanner and assessment source IPs to %global_allowed_scanners. If the tenant has legitimate monitors or partner integrations that poll these paths, add their source IPs to %global_allowed_scanners. Narrow or extend the URL path and User-Agent regexes to match the tenant's web content. Pair with the other T1591 variants (volume, enumeration breadth) before escalating."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\/(org[-_]?chart|organi[sz]ation[-_]?chart|staff[-_]?(directory|list)|employee[-_]?(directory|list)|company[-_]?directory|leadership|management[-_]?team|executive[-_]?team|our[-_]?team|meet[-_]?the[-_]?team|departments?|people|team[-_]?members)(\/|\.|\?|$)/ nocase
    $net.network.http.user_agent = /^(python-requests|python-urllib|aiohttp|curl|wget|go-http-client|libwww-perl|java|apache-httpclient|okhttp|node-fetch|axios|php|ruby|httpie)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1591")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_host = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
