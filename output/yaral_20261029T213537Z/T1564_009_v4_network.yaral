/*
  MITRE Technique : T1564.009 - Resource Forking
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:47:38.301426+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_009_macOS_Network_Egress_From_Resource_Fork_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external network connection made by a macOS process whose command line or image path references a resource fork (..namedfork/rsrc or the com.apple.ResourceFork attribute). Adversaries hide payloads in resource forks, extract and run them, and the payload then calls out for staging or C2. Resource-fork-backed execution is rare in legitimate software, so this network-side view adds to process-creation coverage."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.009"
    mitre_technique_name = "Hide Artifacts: Resource Forking"
    log_prerequisites = "Requires macOS endpoint telemetry that records network connections with the originating process path and command line populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy Classic-era or cross-platform file utilities that read resource forks and sync to remote services, backup or archive tools that copy forks, and developer or packaging scripts that read ..namedfork/rsrc and upload artifacts."
    tuning_guidance = "Add approved backup and archive binaries to %global_allowed_backup_processes, IT tooling to %global_allowed_admin_tools, and security agents to %global_allowed_security_tools. Add known-good vendor destinations to %global_allowed_domains. Review %rfc1918_internal coverage if internal traffic is still alerting."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.command_line = /(\.\.namedfork\/rsrc|com\.apple\.ResourceFork)/ nocase or
      $net.principal.process.file.full_path = /(\.\.namedfork\/rsrc|com\.apple\.ResourceFork)/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.009")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_cmdline = array_distinct($net.principal.process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
