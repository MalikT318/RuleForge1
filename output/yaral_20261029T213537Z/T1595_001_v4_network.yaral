/*
  MITRE Technique : T1595.001 - Scanning IP Blocks
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:52:52.600191+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_001_Inbound_Sweep_Across_Many_Destinations {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens inbound connections to many distinct destination addresses within ten minutes. This is the network signature of an IP-block sweep that maps which hosts in an organisation's public address space are live. The rule is deliberately a volume-based Threshold rule, because one connection event cannot show a sweep."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.001"
    mitre_technique_name = "Active Scanning: Scanning IP Blocks"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and network.direction populated. Logs must record both allowed and denied connection attempts, otherwise blocked sweeps are invisible."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, search-engine and internet-census crawlers, CDN or reverse-proxy health checkers, partner or monitoring probes, and misconfigured clients retrying across a load-balanced address pool."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners and approved external management or partner sources to %global_allowed_mgmt_sources. Raise the distinct-destination threshold (20) for large address allocations or noisy perimeters, or lower it for small ones. Extend the match window if slow, low-rate sweeps are a concern."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    $net.principal.ip = $src
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1595.001")
    $primary_entity = array_distinct($src)
    $dst_count = count_distinct($net.target.ip)
    $port_count = count_distinct($net.target.port)
    $probed_ports = array_distinct($net.target.port)
    $conn_count = count($net.metadata.id)

  condition:
    $net and $dst_count >= 20
}
