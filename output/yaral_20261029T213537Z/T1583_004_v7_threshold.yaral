/*
  MITRE Technique : T1583.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:06:07.223442+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_004_External_Server_Probing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source address generates a high volume of connections into the environment within ten minutes. Individual connections are benign, but the volume is consistent with adversary-operated servers (T1583.004) being used to scan, probe or stage against the perimeter. Severity and breadth are conveyed through distinct port and target counts in the outcome."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.004"
    mitre_technique_name = "Acquire Infrastructure: Server"
    log_prerequisites = "Requires firewall or perimeter network connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and external attack-surface monitoring, search engine and uptime-monitoring crawlers, partner or customer systems with legitimately high connection rates, CDN or NAT egress addresses shared by many users."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management or partner sources to %global_allowed_mgmt_sources. Raise or lower the #net threshold per client based on baseline perimeter traffic volume. Review the distinct_ports and distinct_targets outcome values to separate high-volume legitimate clients from sweeping scans."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.port > 0
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.004")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $distinct_ports = count_distinct($net.target.port)
    $distinct_targets = count_distinct($net.target.ip)
    $target_ips = array_distinct($net.target.ip)

  condition:
    #net >= 100
}
