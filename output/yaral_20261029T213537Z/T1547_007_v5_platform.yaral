/*
  MITRE Technique : T1547.007 - Re-opened Applications
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:45:57.249473+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_007_macOS_Loginwindow_ByHost_Plist_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the per-user loginwindow ByHost preference file (com.apple.loginwindow.[UUID].plist) by a process other than the normal macOS session-management daemons. This file lists applications reopened at the next login, so a write by an unexpected process (shell, scripting interpreter, dropped binary, plist editor) is a Re-opened Applications persistence indicator. This is a file-telemetry detection, not process command-line matching, and it still fires if the attacker renames the editing tool or uses a different plist-editing method."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.007"
    mitre_technique_name = "Boot or Logon Autostart Execution: Re-opened Applications"
    log_prerequisites = "macOS endpoint telemetry that reports file modification events with the acting (principal) process path, including writes under /Users/*/Library/Preferences/ByHost."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or configuration management agents that manage login window preferences; IT admins running defaults or PlistBuddy during imaging or hardening; user-profile migration tools (Migration Assistant, backup restore); OS upgrades rewriting preference files."
    tuning_guidance = "Add approved MDM, imaging and configuration tooling executable paths to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. cfprefsd and loginwindow are excluded because they write this file on every normal logout; edits made through 'defaults write' may be attributed to cfprefsd and need command-line or process-lineage coverage elsewhere. Pair with a FILE_CREATION variant if the sensor reports first-time creation separately."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/Library\/Preferences\/ByHost\/com\.apple\.loginwindow\.[^\/]+\.plist$/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(loginwindow|cfprefsd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_plist = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
