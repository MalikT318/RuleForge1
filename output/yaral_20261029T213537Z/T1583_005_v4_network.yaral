/*
  MITRE Technique : T1583.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:07:42.444317+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_005_DNS_Algorithmic_Botnet_Domain_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for domains with a long, vowel-free random-looking label. This is the lookup pattern of botnet and ORB nodes resolving algorithmically generated rendezvous domains for command and control, or reaching booter/stresser infrastructure. The rule matches the structure of the name rather than any specific domain."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.005"
    mitre_technique_name = "Acquire Infrastructure: Botnet"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-provider hostnames with machine-generated labels, email authentication and anti-spam lookups (DKIM, DNSBL), software update and telemetry endpoints, security vendor reputation lookups, and device-ID subdomains used by IoT or SaaS products."
    tuning_guidance = "Add known-good domains to %global_allowed_domains first. The internal-range exclusion is applied to target.ip, so it assumes queries reach the resolver or upstream by external address. If your logs record an internal resolver as target.ip, switch the exclusion to the field that holds the external or upstream address, or remove it. To reduce noise, raise the label length bounds or the vowel-free run length in the regex, or add a match window with a threshold on distinct queried domains per client."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)(^|\.)[a-z0-9]{4,}[bcdfghjklmnpqrstvwxyz0-9]{8,}[a-z0-9]{4,}\.[a-z0-9.-]+$/
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.005")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
