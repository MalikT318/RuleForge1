/*
  MITRE Technique : T1037.002 - Login Hook
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:55:21.381936+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_002_MacOS_LoginHook_Set_Then_LoginWindow_Plist_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a command-line utility (defaults or PlistBuddy) setting a LoginHook or LogoutHook key for com.apple.loginwindow, followed within ten minutes by modification of the system-level /Library/Preferences/com.apple.loginwindow.plist on the same host. Together these indicate a root-level script has been registered to run at user logon or logout."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.002"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Login Hook"
    log_prerequisites = "Requires macOS endpoint telemetry that populates PROCESS_LAUNCH with full command lines and FILE_MODIFICATION with target file paths and the acting process."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy MDM or configuration management that still deploys login or logout hooks, IT imaging and provisioning scripts, administrators testing legacy login scripts, and older enterprise software installers that register a login hook."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools. Add named administrators who legitimately manage hooks to %global_allowed_admin_users. Since login hooks are deprecated, most environments should have no legitimate activity, so tune sparingly."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(defaults|PlistBuddy)$/ nocase
    $proc.target.process.command_line = /com\.apple\.loginwindow/ nocase
    $proc.target.process.command_line = /\b(LoginHook|LogoutHook)\b/ nocase
    $proc.target.process.command_line = /\b(write|add|set|merge|import)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(private\/)?Library\/Preferences\/com\.apple\.loginwindow\.plist$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1037.002")
    $primary_entity = array_distinct($hostname)
    $acting_users = array_distinct($proc.principal.user.userid)
    $hook_commands = array_distinct($proc.target.process.command_line)
    $modified_plists = array_distinct($file.target.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc and $file
}
