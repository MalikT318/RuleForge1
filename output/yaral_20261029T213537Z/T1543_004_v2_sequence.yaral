/*
  MITRE Technique : T1543.004 - Launch Daemon
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:27:08.351661+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_004_LaunchDaemon_Plist_Dropped_Then_Launchd_Runs_Untrusted_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A new plist is written to /Library/LaunchDaemons and, within 10 minutes on the same host, launchd starts a binary from a user-writable or hidden location (temp directories, /Users/Shared, Downloads, Desktop, hidden directories). This is the result of a Launch Daemon being installed and executed for persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.004"
    mitre_technique_name = "Create or Modify System Process: Launch Daemon"
    log_prerequisites = "macOS endpoint telemetry that reports file creation events with the creating process, and process launch events with the parent process path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party software installers and updaters that register a daemon and launch a helper from a temporary extraction directory; MDM and RMM agents during enrolment or upgrade; developer machines running locally built daemons from hidden or Downloads directories."
    tuning_guidance = "Add approved installer, MDM and deployment binaries to %global_allowed_admin_tools (matched against both the plist-writing process and the launched binary). Narrow the launched-path regex if a client's software legitimately runs from /Users/Shared."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/LaunchDaemons\/[^\/]+\.plist$/ nocase
    not $file.principal.process.file.full_path = /^\/System\/Library\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /^\/sbin\/launchd$/ nocase
    $proc.target.process.file.full_path = /^(\/private)?\/(tmp|var\/tmp|var\/folders)\/|^\/Users\/Shared\/|^\/Users\/[^\/]+\/(Downloads|Desktop)\/|\/\.[A-Za-z0-9_-]+\// nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1543.004")
    $primary_entity = array_distinct($hostname)
    $plist_paths = array_distinct($file.target.file.full_path)
    $plist_writers = array_distinct($file.principal.process.file.full_path)
    $launched_binaries = array_distinct($proc.target.process.file.full_path)
    $launched_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
