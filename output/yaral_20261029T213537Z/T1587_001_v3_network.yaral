/*
  MITRE Technique : T1587.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:48:30.341651+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_001_Custom_C2_Raw_IP_HTTP_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host sending an HTTP POST to an external destination addressed by a raw IP literal in the URL, with no domain name. Custom-developed malware and bespoke C2 protocols often beacon or exfiltrate this way because the operator has not registered or resolved a domain. This is network-side coverage that does not depend on endpoint process telemetry."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.001"
    mitre_technique_name = "Develop Capabilities: Malware"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL-level HTTP visibility (TLS inspection or cleartext HTTP) normalised to NETWORK_HTTP, with network.http.method, target.url and target.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Appliance and IoT management check-ins to IP-addressed endpoints, legacy line-of-business applications posting to hard-coded IPs, internal developers testing against cloud-hosted VMs, and monitoring agents reporting to IP-addressed collectors."
    tuning_guidance = "Add known-good IP-addressed destinations or vendor domains to %global_allowed_domains. Add approved internal egress sources or proxies to %global_allowed_mgmt_sources. Add vulnerability scanners and security testing sources to %global_allowed_scanners. Raise severity for hosts that have no business reason to talk to raw IPs, such as servers in restricted zones."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /(?i)^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?(\/|$)/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1587.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
