/*
  MITRE Technique : T1547.015 - Login Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:47:15.315546+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_015_LoginItem_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a login item being created through osascript or sfltool when the parent process is one that should never do this, such as an Office application, web browser, mail client, PDF viewer, web server, database service or print service. Login item persistence launched from a document, browser or server process indicates macro, phishing or web-shell execution. The detection is based on parent-child lineage."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.015"
    mitre_technique_name = "Boot or Logon Autostart Execution: Login Items"
    log_prerequisites = "macOS endpoint telemetry that records PROCESS_LAUNCH events with parent process path, child process path and command line."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Office add-ins or installers that register a helper app at login, browser-based installers or updaters that call osascript, MDM or enrolment scripts launched from a management agent, and web-hosted admin consoles that legitimately configure login items."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts or %global_allowed_admin_tools, and add trusted accounts to %global_allowed_admin_users. Widen or narrow the parent regex to match the applications used in each client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(Microsoft Word|Microsoft Excel|Microsoft PowerPoint|Microsoft Outlook|Safari|Google Chrome( Helper)?|firefox|Preview|Mail|httpd|nginx|php-fpm|mysqld|postgres|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(osascript|sfltool)$/ nocase
    $proc.target.process.command_line = /(login ?item|sfltool|sharedfilelist|backgroundtaskmanagement|SMLoginItem)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.015")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
