/*
  MITRE Technique : T1543.004 - Launch Daemon
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:26:49.792055+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_004_MacOS_LaunchDaemon_Plist_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a property list file directly in /Library/LaunchDaemons by a process that is not an approved installer, management tool or Apple system component. Launch Daemons run as root at boot before any user logs in, so a new plist there is a strong persistence and privilege-escalation artifact. This rule works at the file-artifact layer, so it still fires when command-line logging is evaded or obfuscated."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.004"
    mitre_technique_name = "Create or Modify System Process: Launch Daemon"
    log_prerequisites = "Requires macOS endpoint telemetry that reports file creation events with the writing process path (EDR file events or Endpoint Security framework data) normalized to UDM FILE_CREATION."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party software installers and updaters (browsers, VPN clients, collaboration tools), MDM and software deployment agents, backup and security agents installing their own helper daemons, and admins hand-deploying legitimate daemons."
    tuning_guidance = "Add approved installers, MDM and deployment binaries to %global_allowed_admin_tools and security or EDR agent binaries to %global_allowed_security_tools. Review the writer process in the outcome. Writers in /tmp, /Users, /private/var/tmp, or interpreters such as osascript, bash, python are higher risk and should not be allowlisted."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/LaunchDaemons\/[^\/]+\.plist$/ nocase
    not $file.principal.process.file.full_path = /^\/(System\/Library|usr\/libexec)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $plist_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
