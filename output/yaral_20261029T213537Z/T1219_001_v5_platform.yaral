/*
  MITRE Technique : T1219.001 - IDE Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:16:51.190416+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_001_Linux_VSCode_Tunnel_State_Or_Service_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of IDE remote-tunnel artefacts on Linux: the VS Code CLI tunnel registration or token files under a user's .vscode/cli directory, or a systemd unit installed to keep a code tunnel alive across reboots. These files are written when a tunnel is registered or made persistent, so the rule fires on the result of tunnel setup rather than on command-line text. This is file-creation coverage that complements process-creation rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.001"
    mitre_technique_name = "Remote Access Tools: IDE Tunneling"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (watch rules on home directories, /etc/systemd/system and ~/.config/systemd/user) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers legitimately enabling VS Code Remote Tunnels on workstations or lab and build servers; approved remote-development platforms; golden image or dev-container provisioning that pre-creates these files."
    tuning_guidance = "Add approved developer accounts to %global_allowed_admin_users and approved provisioning or configuration-management binaries to %global_allowed_admin_tools. If tunnels are sanctioned only on specific dev hosts, scope the rule per client with a hostname exclusion. Consider raising severity on servers that are not developer workstations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/\.vscode(-server)?\/cli\/(code_tunnel|token)\.json$|\/systemd\/(user|system)\/[^\/]*code[-_]?tunnel[^\/]*\.service$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1219.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
