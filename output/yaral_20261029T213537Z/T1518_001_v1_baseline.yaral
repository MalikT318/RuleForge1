/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:21:44.693422+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_IaaS_Cloud_Security_Agent_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects, on a Linux cloud instance (IaaS), either (a) a cloud CLI call that enumerates security and monitoring services (threat detection, security posture, audit trail, config recorder, SSM inventory) or (b) a service, package or process lookup that targets cloud monitoring agents and defensive sensors. Adversaries use this to find out which defences or telemetry agents are present before choosing follow-on actions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Linux endpoint process telemetry (EDR or auditd execve) with full command lines from IaaS-hosted VMs. Cloud audit logs (CloudTrail, Azure Activity, GCP Audit) are not used by this rule; pair it with separate API-level detections."
    platform = "IaaS"
    log_source = "linux_endpoint"
    false_positives = "Cloud administrators and DevOps staff validating agent health, configuration management runs (Ansible, Chef, Puppet, cloud-init), compliance and posture checks, instance bootstrap scripts, and monitoring agents' own self-checks."
    tuning_guidance = "Add approved tooling parent processes to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and sanctioned agents or health-check wrappers to %global_allowed_security_tools. If configuration management is noisy, add its runner to %global_allowed_admin_tools. Raise severity when the user is interactive and the parent is a web server or a reverse shell."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/(aws|az|gcloud)$/ nocase
        $proc.target.process.command_line = /(guardduty\s+(list-detectors|get-detector)|securityhub\s+(describe-hub|get-enabled-standards)|cloudtrail\s+(describe-trails|get-trail-status)|configservice\s+describe-configuration-recorder|ssm\s+(describe-instance-information|list-inventory-entries)|inspector2?\s+(list-coverage|list-findings)|security\s+(pricing|assessment|setting|contact)\s+(list|show)|scc\s+(sources|settings))/ nocase
      )
      or
      (
        $proc.target.process.command_line = /\b(systemctl|service|pgrep|pidof|dpkg|rpm|snap|which|ls|find)\b.*(amazon-cloudwatch-agent|amazon-ssm-agent|google-cloud-ops-agent|google_osconfig_agent|google-guest-agent|walinuxagent|waagent|azuremonitoragent|stackdriver|auditd|clamd|osqueryd|falco)/ nocase
      )
    )
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $discovery_commands = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
