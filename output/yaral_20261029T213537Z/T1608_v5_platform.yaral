/*
  MITRE Technique : T1608 - Stage Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:19:51.536673+00:00
  Reference       : https://attack.mitre.org/techniques/T1608
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_Payload_Fetch_From_IP_Literal_Staging_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client using a non-browser command-line HTTP client (curl, wget, python, Go) to fetch an executable, script, or archive payload from an external host addressed by bare IP literal. This is the network-observable result of an adversary having staged capabilities on infrastructure they control (T1608). The pattern is typical of Linux and macOS post-exploitation tooling but is visible on perimeter telemetry for any platform. The rule uses only proxy and firewall HTTP fields and no endpoint process data."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608"
    mitre_technique_name = "Stage Capabilities"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection (TLS inspection for HTTPS) that populate network.http.method, network.http.user_agent, and target.url, normalised to UDM NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate installers and bootstrap scripts that download from an IP-addressed internal-facing mirror or cloud metadata-style endpoint, DevOps and CI runners pulling build artifacts from IP-addressed repositories, vulnerability scanners, and administrators testing downloads."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add known-good vendor and mirror domains to %global_allowed_domains. Extend the user-agent or extension lists per client, or raise severity if the destination is also seen in threat intelligence."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl|powershell)/ nocase
    $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\/[^?#]*\.(sh|elf|bin|py|pl|so|dmg|pkg|run|appimage|tar|tgz|gz|zip|7z|jar)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $staging_ips = array_distinct($net.target.ip)
    $payload_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
