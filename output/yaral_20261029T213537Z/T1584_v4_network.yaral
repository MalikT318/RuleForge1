/*
  MITRE Technique : T1584 - Compromise Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:16:10.254301+00:00
  Reference       : https://attack.mitre.org/techniques/T1584
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_DNS_Long_Label_Tunnel_Or_Compromised_Infra_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries containing an abnormally long single label (45+ characters of encoded-looking data) in a name that is not in the known-good domain list. This is characteristic of DNS tunnelling, exfiltration or C2, and of hosts reaching out to adversary-controlled or compromised third-party DNS infrastructure. Network-side, resolver-level observation only; it does not prove infrastructure compromise on its own."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584"
    mitre_technique_name = "Compromise Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services using long hashed or generated hostnames, DKIM/DMARC and other email-authentication lookups, domain-verification tokens, anti-virus and EDR cloud lookups that encode data in subdomains, DNS-based blocklist queries, software update services."
    tuning_guidance = "Add the registered domain (for example example.com) of legitimate long-label services to %global_allowed_domains. The rule matches either the full query name or its last two labels against that list. Adjust the label length threshold in the regex (45) to suit client noise. Split-horizon names that resolve to internal addresses are excluded through %rfc1918_internal."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)(^|\.)[a-z0-9_-]{45,}\./
    not $dns.network.dns.questions.name = /(?i)\.(arpa|local|internal|lan)$/
    not $dns.network.dns.questions.name in %global_allowed_domains
    not re.capture($dns.network.dns.questions.name, `([^.]+\.[^.]+)$`) in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $source_ips = array_distinct($dns.principal.ip)

  condition:
    $dns
}
