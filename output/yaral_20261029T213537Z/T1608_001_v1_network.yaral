/*
  MITRE Technique : T1608.001 - Upload Malware
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:20:41.838689+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_001_Direct_IP_Payload_Download_Observed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal client fetching an executable, script, installer, disk-image or archive payload over HTTP directly from a bare IP-address URL on an external host. Adversaries stage malware on rented or compromised servers and serve it by IP, without a registered domain, to support Ingress Tool Transfer. This rule observes the staged payload being retrieved from the network side, using proxy or firewall URL logs, and does not depend on endpoint process telemetry."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.001"
    mitre_technique_name = "Stage Capabilities: Upload Malware"
    log_prerequisites = "Requires proxy or firewall logs with HTTP URL visibility (full target.url including path), normalised to NETWORK_HTTP. HTTPS traffic needs TLS inspection to expose the URL path."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers or admins downloading installers or archives from internal-style lab servers or appliances addressed by IP; vendor appliances, IoT or OT devices pulling firmware by IP; software deployment or patching systems that fetch packages from IP-addressed mirrors; authorised red-team or penetration-test activity."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Add authorised scanning and testing sources to %global_allowed_scanners. Add approved patching or deployment hosts to %global_allowed_admin_tools. Narrow or extend the file-extension list in the target.url regex to fit the client's environment. If the log source does not populate network.http.method, remove that condition."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /^(https?:\/\/)?(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?\/[^?#]*\.(exe|dll|msi|scr|ps1|psm1|bat|cmd|vbs|vbe|js|jse|hta|jar|lnk|iso|img|vhd|vhdx|zip|7z|rar|cab|apk|elf|bin|sh)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
