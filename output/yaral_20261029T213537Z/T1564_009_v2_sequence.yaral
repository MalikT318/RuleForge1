/*
  MITRE Technique : T1564.009 - Resource Forking
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:47:08.469894+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_009_Resource_Fork_Read_Then_Staged_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a scripting or file utility reading a file's resource fork (..namedfork/rsrc) and, within 10 minutes on the same host, a binary being launched from a user-writable staging location (tmp, Users/Shared, user Library caches). This matches the pattern of hidden payloads extracted from a resource fork, written out and executed. It is based on file-read and process-path telemetry rather than process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.009"
    mitre_technique_name = "Hide Artifacts: Resource Forking"
    log_prerequisites = "Requires macOS endpoint telemetry that records file read/open events (including named-fork paths) and process launch events with executable paths."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Backup and imaging tools, Spotlight/indexing helpers, archive and migration utilities handling legacy Mac files, developer build scripts that read resource forks and then run test binaries from /tmp, and software installers that run helpers from temp directories."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and installer or deployment parents to %global_allowed_admin_tools. Extend the helper-process exclusion regex for any recurring indexing or sync daemons. If the execution side is noisy, tighten the staging path regex."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\/\.\.namedfork\/rsrc$/ nocase
    $read.principal.process.file.full_path = /\/(dd|tail|head|cat|cp|ditto|sh|bash|zsh|python3?|perl|ruby|osascript|xxd|hexdump)$/ nocase
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    $read.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/((private\/)?(tmp|var\/tmp)|Users\/Shared|Users\/[^\/]+\/Library\/(Caches|Application Support))\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname

    $read.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1564.009")
    $primary_entity = array_distinct($hostname)
    $forks_read = array_distinct($read.target.file.full_path)
    $reader_processes = array_distinct($read.principal.process.file.full_path)
    $executed_paths = array_distinct($proc.target.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    $read and $proc
}
