/*
  MITRE Technique : T1543.004 - Launch Daemon
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:27:41.100408+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_004_LaunchDaemon_Staged_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of Launch Daemon persistence. A binary running from a world-writable or hidden staging location, started by launchd (the parent of every Launch Daemon), makes an outbound connection to a non-internal address. Legitimate system daemons run from /System, /usr, /Library or /Applications. A launchd-spawned process beaconing from /tmp, /Users/Shared or a hidden directory is characteristic of a malicious plist in /Library/LaunchDaemons pointing at a dropped payload."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.004"
    mitre_technique_name = "Create or Modify System Process: Launch Daemon"
    log_prerequisites = "Requires macOS endpoint network telemetry that records the originating process path and its parent process path for outbound connections (NETWORK_CONNECTION)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Software installers or updaters that run helper binaries from temporary directories under launchd, developer tooling in hidden directories run as a daemon, MDM or deployment agents staging payloads in /private/tmp, and home-grown automation daemons installed in /Users/Shared."
    tuning_guidance = "Add approved management and deployment binaries to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and approved remote management tooling to %global_allowed_remote_mgmt. Add vendor update domains to %global_allowed_domains if DNS context is joined. Extend or narrow the staging path regex to match client conventions."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/launchd$/ nocase
    (
      $net.principal.process.file.full_path = /^\/(private\/)?(tmp|var\/tmp)\// nocase or
      $net.principal.process.file.full_path = /^\/private\/var\/folders\// nocase or
      $net.principal.process.file.full_path = /^\/Users\/Shared\// nocase or
      $net.principal.process.file.full_path = /\/\.[^\/]+\/[^\/]+$/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1543.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $parent_path = array_distinct($net.principal.process.parent_process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
