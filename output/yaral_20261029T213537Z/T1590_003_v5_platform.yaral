/*
  MITRE Technique : T1590.003 - Network Trust Dependencies
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:18:08.689409+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_003_External_Trust_Metadata_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting federation, trust and identity-provider metadata endpoints (federation metadata XML, MEX trust endpoints, OpenID configuration, SAML metadata) on an internet-facing web service, as observed by an IDS/IPS inspecting HTTP traffic. These documents disclose which identity providers, partner organisations and third-party realms the victim trusts, so requests from unapproved external sources are consistent with network trust dependency reconnaissance."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.003"
    mitre_technique_name = "Gather Victim Network Information: Network Trust Dependencies"
    log_prerequisites = "IDS/IPS or network security appliance with HTTP inspection that populates UDM NETWORK_HTTP events with principal.ip and target.url, sitting in front of or in line with internet-facing federation, SSO or web services."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate federation partners, SaaS applications and cloud identity providers that retrieve metadata for trust setup or certificate rollover; OpenID and SAML client libraries; authorised external attack-surface or penetration testing; uptime and synthetic monitoring of SSO endpoints."
    tuning_guidance = "Add authorised scanner and testing sources to %global_allowed_scanners and approved partner or management source addresses to %global_allowed_mgmt_sources. Raise severity for hosts that expose federation endpoints but have no partners. If volume is high, consider converting to a Threshold rule grouped by source IP."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(federationmetadata\/[0-9\-]+\/federationmetadata\.xml|adfs\/services\/trust\/mex|services\/trust\/mex|\.well-known\/openid-configuration|saml\/metadata|saml2\/metadata|metadata\/saml|sso\/metadata|idp\/shibboleth)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1590.003")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
