/*
  MITRE Technique : T1596.001 - DNS/Passive DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:58:48.847270+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_001_External_DNS_Zone_Transfer_Recon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IDS/IPS verdict on DNS-service traffic (port 53) from an external, non-allowlisted source whose signature indicates zone transfer (AXFR/IXFR) attempts, DNS enumeration or brute-forcing, or nameserver fingerprinting. These are direct queries against a victim's nameservers to harvest subdomain, mail server and host records."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.001"
    mitre_technique_name = "Search Open Technical Databases: DNS/Passive DNS"
    log_prerequisites = "IDS/IPS or network security appliance logs normalized to UDM NETWORK_CONNECTION with security_result.rule_name or security_result.description populated and DNS signatures enabled on the perimeter or DMZ segment that protects authoritative nameservers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate secondary or slave nameservers performing scheduled zone transfers; third-party DNS hosting or monitoring providers; authorised external vulnerability scanners and attack-surface management tools; registrar or CDN health checks."
    tuning_guidance = "Add authorised secondary DNS server addresses to %global_allowed_mgmt_sources, and approved external scanners or attack-surface testing sources to %global_allowed_scanners. Review the matching signature names for the deployed appliance and adjust the regex if the vendor uses different wording. To reduce noise, restrict the rule to hosts that serve DNS."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    (
      $net.security_result.rule_name = /(axfr|ixfr|zone[\s_\-]?transfer|dns[\s_\-]?(enum|brute|recon|footprint|version[\s_\-]?query)|version\.bind)/ nocase or
      $net.security_result.description = /(axfr|ixfr|zone[\s_\-]?transfer|dns[\s_\-]?(enum|brute|recon|footprint|version[\s_\-]?query)|version\.bind)/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1596.001")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_dns_servers = array_distinct($net.target.ip)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
