/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:10:09.997056+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_Account_Creation_Tool_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows account-creation utility or cmdlet (net user /add, dsadd user, New-ADUser, New-LocalUser) whose process opens a network connection to a non-internal address on an SMB, RPC or directory-service port. Account creation should normally stay inside the internal network (local SAM or domain controller). The same process reaching an external host suggests remote account management over an exposed path, a tunnel or relay, or account creation against infrastructure the attacker controls."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136"
    mitre_technique_name = "Create Account"
    log_prerequisites = "Requires endpoint network telemetry that populates principal.process.file.full_path and principal.process.command_line on NETWORK_CONNECTION events. Sysmon Event ID 3 alone does not carry the command line, so the EDR must enrich it."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hybrid-identity or directory synchronisation scripts run by administrators over site-to-site VPN where the DC sits in address space missing from %rfc1918_internal. Remote IT support or onboarding automation creating accounts across routed or public-IP-addressed networks. Lab or test hosts with public addressing."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or onboarding accounts to %global_allowed_service_accounts. Make sure %rfc1918_internal covers the client's private and VPN-routed address space, including CGNAT if used. Raise severity to Critical for non-administrator accounts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(net|net1|dsadd|powershell|pwsh)\.exe$/ nocase
    $net.principal.process.command_line = /(\bnet1?(\.exe)?\s+user\b.*\/add\b|\bdsadd(\.exe)?\s+user\b|\bnew-aduser\b|\bnew-localuser\b)/ nocase
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1136")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)
    $command_lines = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
