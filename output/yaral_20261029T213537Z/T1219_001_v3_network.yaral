/*
  MITRE Technique : T1219.001 - IDE Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:16:15.082137+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_001_macOS_IDE_Tunnel_Relay_Network_Observed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound web or TLS-inspected sessions from an internal host to the managed relay and tunnel-broker service families used by IDE remote-development tunnels (for example the VS Code 'code tunnel' feature). The tunnel is brokered through a third-party relay, so this is a network-side view of the technique and does not depend on endpoint process telemetry. The pattern matches the service family, not attacker-controlled infrastructure."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.001"
    mitre_technique_name = "Remote Access Tools: IDE Tunneling"
    log_prerequisites = "Requires web proxy or firewall logs with TLS inspection or SNI/hostname visibility, normalised to UDM NETWORK_HTTP with target.hostname and target.ip populated. Without hostname visibility this rule cannot fire."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Developers who legitimately use remote tunnels or remote development; sanctioned cloud development environments; IT-approved remote-support workflows; security testing of IDE tunnelling."
    tuning_guidance = "Add approved developer workstation hostnames to %global_allowed_script_hosts. Add any sanctioned tunnel service hostnames to %global_allowed_domains if the deployment requires it. If the proxy reports a client OS or user-agent, restrict to macOS clients per-tenant. Correlate with the endpoint-side process rule before escalating. Raise severity for non-developer subnets or servers."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /(^|\.)(devtunnels\.ms|tunnels\.api\.visualstudio\.com)$/ nocase
    $http.principal.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1219.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $tunnel_hostnames = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $source_users = array_distinct($http.principal.user.userid)

  condition:
    $http
}
