/*
  MITRE Technique : T1584.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:18:52.838419+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_001_DNS_Shadowed_Subdomain_Random_Label {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for a subdomain whose left-most label is very long, machine-generated in appearance (letters mixed with digits) and sits under a domain not on the known-good list. This pattern is typical of domain shadowing and hijacked-subdomain abuse, where an adversary who controls a compromised domain or dangling record creates many random subdomains for C2, phishing or payload staging."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.001"
    mitre_technique_name = "Compromise Infrastructure: Domains"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-hosted services with generated hostnames, email security and DKIM or anti-spam lookups, software update and telemetry endpoints, DNS-based blocklist lookups, and security-vendor cloud lookups that encode data in the leftmost label."
    tuning_guidance = "Add known-good parent domains to %global_allowed_domains. If CDN or telemetry noise persists, raise the label-length threshold in the regex from 28 to 36 or longer."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^[a-z0-9\-]{28,}\.[a-z0-9\-]+\.[a-z0-9\-\.]+$/ nocase
    $dns.network.dns.questions.name = /^[a-z\-]*[0-9][a-z0-9\-]*\./ nocase
    $dns.network.dns.questions.name = /^[0-9\-]*[a-z][a-z0-9\-]*\./ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.001")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
