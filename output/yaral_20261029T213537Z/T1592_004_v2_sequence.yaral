/*
  MITRE Technique : T1592.004 - Client Configurations
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:40:56.676196+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_004_External_Service_Probe_Then_Config_Disclosure_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An external source probes several non-web service ports (banner-grabbing candidates) and, within ten minutes, sends HTTP requests that enumerate server or client configuration. Examples are configuration-disclosure paths and banner-grabbing methods such as OPTIONS or TRACE. The pairing indicates reconnaissance of client and server configurations."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.004"
    mitre_technique_name = "Gather Victim Host Information: Client Configurations"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION (with target.port) and NETWORK_HTTP (with target.url and network.http.method). The HTTP side needs a proxy, WAF or SSL-inspecting firewall that logs URLs."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners, uptime and availability monitors, search engine and internet-census crawlers, partner integrations that call OPTIONS for CORS preflight, and CDN health checks."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Adjust the probed port set and URL regex to match the client's exposed services. If the HTTP side is noisy, require additional distinct URLs by raising the threshold in the SOAR playbook using the $probed_urls outcome."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 25 or
      $net.target.port = 110 or
      $net.target.port = 143 or
      $net.target.port = 445 or
      $net.target.port = 3389
    )
    $net.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    (
      $http.target.url = /\/(server-status|server-info|phpinfo\.php|info\.php|\.env|\.git\/config|web\.config|config\.json|browserconfig\.xml|cgi-bin\/(printenv|test-cgi))(\?|$)/ nocase or
      $http.network.http.method = /^(OPTIONS|TRACE|TRACK)$/ nocase
    )
    $http.principal.ip = $src_ip

    $net.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1592.004")
    $primary_entity = array_distinct($src_ip)
    $probed_ports = array_distinct($net.target.port)
    $probed_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $net and $http
}
