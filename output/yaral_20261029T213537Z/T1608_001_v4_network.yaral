/*
  MITRE Technique : T1608.001 - Upload Malware
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:21:35.690714+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_001_Proxy_Executable_Download_From_Raw_IP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal client fetching an executable, script, or package file over HTTP from an external server addressed by a raw IP instead of a domain name. This is the network-side signature of a victim retrieving malware an adversary staged on their own or compromised infrastructure. It complements endpoint command-line detections by observing the staging server at the perimeter."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.001"
    mitre_technique_name = "Stage Capabilities: Upload Malware"
    log_prerequisites = "Requires proxy or firewall HTTP logs with full URL inspection (cleartext HTTP, or TLS-intercepting proxy) normalised to NETWORK_HTTP with target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software or firmware updates served from appliance IPs, internal-style dev or test servers reached via a public IP, vendor installers hosted on bare IPs, vulnerability scanners and security testing tools, and CDN edge nodes addressed by IP."
    tuning_guidance = "Add authorised scanning sources to %global_allowed_scanners and known-good vendor or update destinations to %global_allowed_domains. Extend or trim the file extension list to match the client's software distribution patterns. Review proxy TLS-inspection coverage, since HTTPS without inspection will not populate the full URL."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /^https?:\/\/(\d{1,3}\.){3}\d{1,3}(:\d+)?\/[^?#]*\.(exe|dll|msi|ps1|bat|hta|scr|jar|vbs|bin|apk|elf)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
