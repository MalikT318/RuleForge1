/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:05:10.497939+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_Anomalous_Parent_Spawns_Shell_Staging_Data {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an unexpected parent process (Office application, web server, print spooler or database service) spawning a shell or script interpreter whose command line copies, moves or archives data into a common staging location such as Temp, ProgramData, PerfLogs, Public or the Recycle Bin. Pivots on process lineage rather than the copy action alone."
    mitre_tactic = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins exporting reports to a temp folder, web applications that legitimately shell out to archive or copy uploads, database maintenance jobs (SQL Agent via xp_cmdshell) writing exports or backups to ProgramData, print or document workflows using temp spool directories."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Add known service accounts to %global_allowed_service_accounts. If a web or database server legitimately runs export jobs, exclude it by host or parent in the allow lists rather than loosening the regexes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|w3wp|httpd|nginx|tomcat[0-9]*|spoolsv|sqlservr|mysqld)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /\b(copy|xcopy|robocopy|move|move-item|copy-item|compress-archive|7z|7za|rar|tar|makecab)\b/ nocase
    $proc.target.process.command_line = /\\(temp|programdata|perflogs|users\\public|\$recycle\.bin|windows\\debug)\\/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
