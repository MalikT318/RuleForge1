/*
  MITRE Technique : T1608.006 - SEO Poisoning
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:30:32.750199+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_006_SEO_Poisoning_Search_Referred_Payload_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful web download of an executable, installer, disk image, script or archive where the HTTP referrer is a search results page (the referrer URL carries a search query parameter). This is the network-side result of SEO poisoning: a user is lured from search results to an attacker-promoted site hosting a payload. The rule matches the behaviour (search-referred payload download from an external, non-allowlisted host) and does not rely on specific search engines, domains or filenames."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.006"
    mitre_technique_name = "Stage Capabilities: SEO Poisoning"
    log_prerequisites = "Requires proxy or firewall logs with HTTP visibility (URL inspection or TLS decryption) that populate network.http.referral_url, target.url and network.http.response_code. Without referrer logging the rule cannot fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users legitimately searching for and downloading software, drivers, documents archives or installers from vendor sites not yet in the allowlist; developers downloading release artifacts after a search; IT staff fetching tools. Referrers from in-site search pages on legitimate download portals may also match."
    tuning_guidance = "Add known-good vendor, CDN and software distribution domains to %global_allowed_domains. Ensure %rfc1918_internal is current so internal destinations are excluded. If the extension list is too noisy for a client, narrow it to executable and installer types (exe|msi|iso|scr|js|vbs). Raise severity for users or segments with no software-installation rights."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    $http.network.http.referral_url = /[?&#](q|query|search|search_query|p|wd|text|k|keyword)=[^&#]+/ nocase
    $http.target.url = /\.(exe|msi|msix|appx|iso|img|scr|js|vbs|jar|zip|rar|7z|dmg|apk)([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1608.006")
    $primary_entity = array_distinct($http.principal.ip)
    $download_url = array_distinct($http.target.url)
    $referrer_url = array_distinct($http.network.http.referral_url)
    $destination_host = array_distinct($http.target.hostname)

  condition:
    $http
}
