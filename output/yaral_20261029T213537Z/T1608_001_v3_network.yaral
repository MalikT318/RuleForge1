/*
  MITRE Technique : T1608.001 - Upload Malware
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:21:19.428349+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_001_Network_Payload_Download_From_Staging_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client fetching an executable or payload-type file over HTTP(S) from an external host that is addressed by raw IP literal or served from a content-addressed (IPFS/IPNS) gateway path. This is the network-side footprint of malware staged on adversary-controlled or abused infrastructure (T1608.001) being pulled into the environment. It complements endpoint command-line detections by observing the transfer itself at the perimeter."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.001"
    mitre_technique_name = "Stage Capabilities: Upload Malware"
    log_prerequisites = "Requires web proxy or firewall logs with URL visibility (NETWORK_HTTP events with target.url populated), for example TLS-inspecting proxy or NGFW URL logging. Without URL logging, plain HTTPS flows will not match."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software vendors and appliance firmware updates served from bare IP addresses, internal tooling or lab environments pulling installers from IP-addressed external mirrors, legitimate use of IPFS gateways by developers or Web3 teams, and package or ISO downloads from small hosting providers."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Exclude approved scanner or test sources by adding them to %global_allowed_scanners if they appear as clients. Raise severity or add a Threshold variant for hosts that download multiple payloads. Narrow the extension list (for example drop sh or jar) if developer subnets generate noise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(exe|dll|msi|ps1|scr|hta|jar|bat|vbs|iso|img|bin|apk|elf|sh)(\?.*)?$/ nocase
    (
      $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\// nocase or
      $net.target.url = /\/(ipfs|ipns)\/[a-z0-9]{40,}/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $client_ips = array_distinct($net.principal.ip)
    $staging_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
