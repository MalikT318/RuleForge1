/*
  MITRE Technique : T1595.001 - Scanning IP Blocks
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:53:29.727231+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_001_External_Source_Mass_Connection_Sweep {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source address generates a high volume of connection events toward the perimeter within 10 minutes. Each connection is benign on its own, but sustained volume from one source across many destination addresses and ports is characteristic of IP block scanning and host discovery. The outcome lists the distinct destination IPs and ports touched so analysts can judge sweep breadth."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.001"
    mitre_technique_name = "Active Scanning: Scanning IP Blocks"
    log_prerequisites = "Requires perimeter firewall or network-flow logs that record inbound connection attempts, including denied or dropped traffic, with principal.ip and target.ip populated and normalised to UDM NETWORK_CONNECTION."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet-wide research scanners, uptime and availability monitors, CDN or reverse-proxy health probes, partner or B2B systems with high connection rates, NAT gateways aggregating many users behind one address, and authorised external vulnerability assessments."
    tuning_guidance = "Add authorised scanner and monitoring sources to %global_allowed_scanners and approved external management sources to %global_allowed_mgmt_sources. The default of 200 events in 10 minutes is conservative. Raise it for high-traffic internet-facing environments, or lower it for small perimeters. Confirm that the firewall logs denied connections, because scans are mostly dropped traffic."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1595.001")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 200
}
