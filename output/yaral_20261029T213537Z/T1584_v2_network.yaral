/*
  MITRE Technique : T1584 - Compromise Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:15:30.297217+00:00
  Reference       : https://attack.mitre.org/techniques/T1584
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_DNS_Long_Label_Subdomain_Infrastructure {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries whose leftmost subdomain label is 40 or more characters of encoded-looking data (hex, base32, base64-like) under a registered domain that is not allow-listed. Such queries are characteristic of compromised third-party infrastructure used as DNS-based C2, staging or data-relay channels. Names that resolve only to internal address space are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584"
    mitre_technique_name = "Compromise Infrastructure"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-storage hostnames with long generated labels, DKIM/DMARC and other email-authentication TXT lookups, security-vendor reputation lookups (hash-based DNS blocklists), anti-virus cloud lookups, DNS-based service discovery, and some software-update or telemetry domains."
    tuning_guidance = "Add known-good registered domains (for example telemetry or CDN domains) to %global_allowed_domains. Raise or lower the label length quantifier {40,} to fit the environment. Review the $query_types outcome (16 = TXT, 10 = NULL) to prioritise alerts."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)[a-z0-9_\-]{40,}\.[a-z0-9\-]+\.[a-z]{2,}\.?$/
    $domain = re.capture($dns.network.dns.questions.name, /([^.]+\.[^.]+)\.?$/)
    not $domain in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domain = array_distinct($domain)
    $query_names = array_distinct($dns.network.dns.questions.name)
    $query_types = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
