/*
  MITRE Technique : T1583.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:00:08.540449+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_001_Punycode_IDN_Domain_Query_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single DNS client issues repeated queries for internationalized (punycode, xn--) domain labels within ten minutes. Individual IDN lookups are benign, but sustained volume from one client can indicate lookalike or homograph domains acquired by an adversary being resolved through phishing or drive-by delivery or C2 staging."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.001"
    mitre_technique_name = "Acquire Infrastructure: Domains"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and a populated principal.ip (client address)."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Users browsing legitimately internationalized sites, non-Latin language content, browser IDN spoof-protection lookups, security awareness or phishing simulation tooling, web crawlers, and shared resolvers or forwarders that aggregate many users behind one client IP."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. If the DNS source is a shared forwarder or NAT, move to a per-user or per-host key where available, or raise the #dns threshold. Scale severity upward for repeated alerts from the same client."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)xn--[a-z0-9-]+/ nocase
    $dns.principal.ip = $client
    not $dns.network.dns.questions.name in %global_allowed_domains

  match:
    $client over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.001")
    $primary_entity = array_distinct($client)
    $query_count = count($dns.metadata.id)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    #dns >= 5
}
