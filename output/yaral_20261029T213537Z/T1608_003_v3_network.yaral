/*
  MITRE Technique : T1608.003 - Install Digital Certificate
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:25:05.407102+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_003_Outbound_TLS_AltPort_No_SNI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host making an outbound connection to an external address on a common alternate TLS/HTTPS service port (8443, 4443, 9443, 10443, 444) with no TLS server name (SNI) visible. Adversary-staged infrastructure often serves self-signed or freshly installed certificates on non-standard TLS ports, and clients reaching it by raw IP (no SNI or hostname) is a network-side indicator of that staging (T1608.003). The SNI condition narrows the match only where the firewall populates TLS metadata. Where it does not, the rule falls back to alternate-port outbound connections to destinations with no allow-listed hostname."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.003"
    mitre_technique_name = "Stage Capabilities: Install Digital Certificate"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated. TLS SNI (network.tls.client.server_name) is optional but improves precision."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS, vendor management consoles, VPN or SSL-portal appliances, and web applications on alternate HTTPS ports (8443/9443); IoT or camera cloud connectors; developer or test traffic to cloud-hosted services reached by IP."
    tuning_guidance = "Add known-good vendor destinations to %global_allowed_domains. Adjust the port set per client if a business application legitimately uses one of these ports. Raise severity if the same destination IP is seen from multiple internal hosts. If TLS inspection is available and SNI is populated, precision improves automatically."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 8443 or
      $net.target.port = 4443 or
      $net.target.port = 9443 or
      $net.target.port = 10443 or
      $net.target.port = 444
    )
    $net.network.tls.client.server_name = ""
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1608.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
