/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:24:40.292360+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_Linux_Service_Parent_Spawns_Shell_Cookie_Store_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, database or other network-facing service process spawning a shell or script interpreter whose command line references browser cookie or session stores (Chromium-family Cookies, Firefox cookies.sqlite). Service daemons have no legitimate reason to touch a user's browser profile, so this lineage anomaly indicates post-exploitation session cookie theft, for example through a web shell or injected application code."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Linux EDR or auditd (execve) process telemetry with full command line and parent process path populated in UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Enterprise backup or migration scripts launched by a service wrapper, browser automation or headless testing frameworks (CI runners spawned by java or node), forensic or DLP collection tooling started from an application service, admin troubleshooting through a management daemon."
    tuning_guidance = "Add legitimate parent processes or hosts to %global_allowed_script_hosts, and approved automation or collection tooling to %global_allowed_admin_tools. If java or node parents are noisy on build or test servers, scope them out via %global_allowed_script_hosts. The parent process regex can be extended with client-specific service daemons."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash|python[0-9.]*|perl|ruby|php[0-9.]*|lua|node)$/ nocase
    $proc.target.process.command_line = /(cookies\.sqlite|\/(Default|Profile [0-9]+)\/(Network\/)?Cookies|\.config\/(google-chrome|chromium|BraveSoftware|microsoft-edge|opera|vivaldi)|\.mozilla\/firefox|snap\/(chromium|firefox)\/common)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
