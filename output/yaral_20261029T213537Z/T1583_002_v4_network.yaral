/*
  MITRE Technique : T1583.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:01:20.486339+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_002_DNS_Tunnel_Long_Label_TXT_NULL_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for TXT or NULL records with an abnormally long, encoded-looking subdomain label sent to an external resolver. This is characteristic of DNS-based C2 or exfiltration served by attacker-operated authoritative DNS infrastructure, where data is carried in the query name and instructions return in TXT/NULL responses."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.002"
    mitre_technique_name = "Acquire Infrastructure: DNS Server"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated. The resolver or destination IP (target.ip) should be present so internal resolvers can be excluded."
    platform = "PRE"
    log_source = "dns"
    false_positives = "DKIM/DMARC/SPF and other TXT lookups with long selector labels, CDN and cloud services using long hashed hostnames, anti-spam and anti-virus reputation lookups (DNSBL/hash-based), software licensing or telemetry services that encode data in DNS names, and security products performing DNS-based file reputation checks."
    tuning_guidance = "Add known-good registered domains (two-label form, e.g. example.com) to %global_allowed_domains. Raise the label length threshold (currently 40) if noisy. Add trusted internal and sanctioned resolver addresses to %rfc1918_internal. Consider a companion threshold rule on query volume per host for the same domains."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /(?i)(^|\.)[a-z0-9_\-]{40,}\.[^.]+\.[^.]+$/
    $reg_domain = re.capture(strings.to_lower($dns.network.dns.questions.name), "([^.]+\\.[^.]+)$")
    not $reg_domain in %global_allowed_domains
    not $dns.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1583.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $resolver_ips = array_distinct($dns.target.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
