/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:38:14.031169+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Service_Parent_Spawns_Account_Mgmt {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service process (web server, application server, database, print or file service) directly spawning a local account or credential management binary or a privilege-switching binary such as su or sudo. Legitimate services do not create users, change passwords or switch accounts. This lineage indicates a compromised service being used to create, modify or assume a local account for persistence or privilege escalation. The rule pivots on process lineage rather than command-line content."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) file paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web hosting control panels or self-service portals that provision local accounts through a service-owned helper; database or application installers and package post-install scripts that create service users; legacy admin web UIs that wrap passwd or sudo; configuration management agents running under a service parent."
    tuning_guidance = "Add approved provisioning parent binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. For hosting or control-panel environments, scope exclusions to the specific parent path rather than disabling the rule. Extend the parent regex with client-specific service binaries (for example application runtimes) if required."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd|vsftpd|proftpd)$/ nocase
    $proc.target.process.file.full_path = /\/(useradd|adduser|usermod|chpasswd|passwd|gpasswd|newusers|chage|su|sudo)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
