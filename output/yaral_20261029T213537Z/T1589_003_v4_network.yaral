/*
  MITRE Technique : T1589.003 - Employee Names
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:10:52.324107+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_003_External_Employee_Directory_Enumeration_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external client requesting web endpoints that expose employee or user names in bulk or by sequential ID. Examples are CMS author or user enumeration, SharePoint site user lists, staff directory exports, and generic user or employee listing APIs. This is network-side observation of employee name harvesting, which adversaries use to derive email addresses and craft lures."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.003"
    mitre_technique_name = "Gather Victim Identity Information: Employee Names"
    log_prerequisites = "Requires firewall, web proxy or reverse proxy logs with HTTP URL visibility (TLS inspection or a WAF/reverse-proxy position) normalised to UDM NETWORK_HTTP with target.url and principal.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Search engine and SEO crawlers, uptime and content monitors, legitimate public-facing applications or mobile apps that call user or people APIs, authenticated partners using staff directory integrations, and unregistered vulnerability scanners or penetration tests."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Because rule_type is Single-Event, expect some noise from crawlers on public staff or team pages; convert to a Threshold rule grouped by principal.ip if volume is high. Narrow the URL regex to the applications actually exposed by the client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\?|&)author=\d+|\/wp-json\/wp\/v2\/users|\/_api\/web\/(siteusers|siteuserinfolist)|\/_vti_bin\/listdata\.svc\/userinformationlist|\/(employee|employees|staff|personnel)[-_]?(directory|list|roster|export)|\/api\/(v[0-9]+\/)?(users|employees|people)(\/|\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1589.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
