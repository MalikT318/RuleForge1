/*
  MITRE Technique : T1204 - User Execution
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:12:51.142754+00:00
  Reference       : https://attack.mitre.org/techniques/T1204
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_Container_Script_Download_External_Http {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound HTTP request from a Linux container or host workload to an external destination, made by a command-line or scripting HTTP client, that fetches a script or executable payload. This is the network-side signature of a user being tricked into running a download-and-execute command, such as a pasted 'curl | sh' one-liner or a trojanized setup instruction. It complements process command-line detections by observing the transfer itself."
    mitre_tactic = "Execution"
    mitre_technique = "T1204"
    mitre_technique_name = "User Execution"
    log_prerequisites = "Requires HTTP-layer telemetry that populates network.http.user_agent and target.url (egress proxy, service mesh or sidecar, or network sensor), normalised to UDM NETWORK_HTTP and attributed to the container or node via principal.hostname."
    platform = "Linux"
    log_source = "container"
    false_positives = "Legitimate bootstrap and installer scripts (package manager convenience installers, CI/CD build steps, container entrypoints pulling init scripts), configuration management agents, and developers fetching tooling from vendor sites."
    tuning_guidance = "Add known-good vendor, CDN and mirror domains to %global_allowed_domains. Add build and CI hosts to %global_allowed_script_hosts. Add approved deployment tooling to %global_allowed_admin_tools. Expand the user-agent or extension regex per client if their environment uses different HTTP clients."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl)/ nocase
    $net.target.url = /\.(sh|bash|elf|bin|run|py|pl)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1204")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
