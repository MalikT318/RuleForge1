/*
  MITRE Technique : T1584.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:25:11.501047+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_004_Repeated_External_NonStandard_Port_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes a high volume of connections to external addresses on non-standard ports within ten minutes. Each connection is benign on its own. The volume can indicate beaconing or staging against third-party infrastructure an adversary has compromised and repurposed as a server (T1584.004). Observed from the victim side, this is the network-visible result of that resource development."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.004"
    mitre_technique_name = "Compromise Infrastructure: Server"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "VoIP/SIP and video-conferencing clients, game or P2P traffic on guest networks, VPN clients on custom ports, mail relays, SaaS agents using high ports, authorised vulnerability scanners and monitoring probes."
    tuning_guidance = "Add scanner and monitoring source IPs to %global_allowed_scanners. Add known-good external hostnames to %global_allowed_domains. Raise the #net threshold on noisy egress segments, or extend the port exclusions for ports that are legitimate for the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 123
    $net.target.port != 25
    $net.target.port != 587
    $net.target.port != 993
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  match:
    $src over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($net.metadata.id)
    $distinct_dest_ips = count_distinct($net.target.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $mitre_technique_id = array_distinct("T1584.004")
    $primary_entity = array_distinct($src)

  condition:
    #net >= 20
}
