/*
  MITRE Technique : T1548.004 - Elevated Execution with Prompt
  Tactic(s)       : Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:33:43.368194+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_004_AuthTrampoline_Spawns_Shell_Or_UserWritable_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the macOS authorization helper (security_authtrampoline), which is invoked when an application calls AuthorizationExecuteWithPrivileges after a credential prompt, launching a shell, script interpreter, or a binary from a user-writable location as the elevated child. Legitimate installers usually elevate a packaged helper from /Applications, /Library or /usr, so this lineage is an anomaly that suggests a trojanised installer or a masquerading prompt."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.004"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Elevated Execution with Prompt"
    log_prerequisites = "macOS endpoint telemetry with PROCESS_LAUNCH events that populate parent (principal.process) and child (target.process) executable paths, for example EDR process events or Endpoint Security framework data."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party application installers and self-updaters that still use the deprecated AuthorizationExecuteWithPrivileges API and run a shell wrapper, such as legacy vendor updaters and drivers. Also IT packaging or deployment scripts run interactively by administrators."
    tuning_guidance = "Add approved installer or updater child binaries to %global_allowed_admin_tools. Review the child path and user in the outcome. Legitimate vendor elevations normally run signed helpers from /Library or /Applications, while shells, osascript, or binaries from /tmp, /Users or /Volumes are suspicious."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/security_authtrampoline$/ nocase
    $proc.target.process.file.full_path = /(^\/(private\/)?(tmp|var\/tmp|var\/folders)\/|^\/Users\/[^\/]+\/|^\/Volumes\/|\/(bash|sh|zsh|dash|ksh|tcsh|osascript|python[0-9.]*|perl|ruby)$)/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1548.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
