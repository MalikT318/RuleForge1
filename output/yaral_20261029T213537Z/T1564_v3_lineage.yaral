/*
  MITRE Technique : T1564 - Hide Artifacts
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:46:22.506683+00:00
  Reference       : https://attack.mitre.org/techniques/T1564
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_ESXi_Unexpected_Parent_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned on a hypervisor host by an unexpected parent: a management or agent daemon (host agent, proxy, CIM broker, WS-Man, SNMP, SLP) or a binary running from a temporary, ramdisk or hidden directory. Management daemons do not normally spawn interactive shells. Binaries in hidden or volatile locations that spawn shells are a common way to hide attacker tooling and activity from administrators and monitoring. This rule pivots on process lineage, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564"
    mitre_technique_name = "Hide Artifacts"
    log_prerequisites = "Requires hypervisor shell or process execution telemetry that populates both the parent (principal.process.file.full_path) and child (target.process.file.full_path) process paths. Shell audit forwarding to Chronicle must be enabled."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Hardware vendor or third-party management modules (CIM providers) that call helper scripts. HA and host-agent maintenance scripts. Backup or patching agents staged under /tmp or /scratch. Administrators running scripts from a temporary directory over SSH. Monitoring agents that wrap shell commands."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools, %global_allowed_script_hosts or %global_allowed_backup_processes. Add approved automation accounts to %global_allowed_service_accounts. Add EDR or monitoring agents to %global_allowed_security_tools. Review hits by principal.hostname to find noisy third-party CIM providers before alerting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|busybox|python[0-9.]*|perl)$/ nocase
    $proc.principal.process.file.full_path = /(\/(hostd|hostd-worker|vpxa|rhttpproxy|sfcbd|sfcb-[a-z0-9_-]+|openwsman|snmpd|slpd|vobd|lwsmd)$)|(^\/(tmp|var\/tmp|dev\/shm|scratch\/tmp|var\/run)\/)|(\/\.[a-z0-9_][^\/]*\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
