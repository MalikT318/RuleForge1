/*
  MITRE Technique : T1584.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:22:24.573797+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_003_Outbound_Proxy_Tunnel_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external address on a port commonly used by SOCKS proxies, reverse shells and tunnel listeners. Adversaries who compromise third-party VPS infrastructure typically run such listeners for C2 or relaying, so this observes the victim-side egress that exposes that infrastructure. The rule is behavioural: it matches the combination of internal source, external destination and non-standard relay port, with no IP, domain or hash indicators."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.003"
    mitre_technique_name = "Compromise Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress traffic must be logged, not just denied traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers or admins using SOCKS or alternate-port proxies, legitimate SaaS or VPN services listening on 1080, 8888 or 9001, Tor or privacy tooling used by policy-exempt users, penetration tests and red team exercises, and games or peer-to-peer applications using high ports."
    tuning_guidance = "Add authorised internal source addresses (jump hosts, proxies, VPN concentrators) to %global_allowed_mgmt_sources. Add authorised testing sources to %global_allowed_scanners. Add known-good destination domains to %global_allowed_domains. Edit the port list to match each client's egress policy, and raise severity when the destination is also seen by threat intelligence enrichment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1080 or
      $net.target.port = 4444 or
      $net.target.port = 4443 or
      $net.target.port = 5555 or
      $net.target.port = 8888 or
      $net.target.port = 9001 or
      $net.target.port = 9050 or
      $net.target.port = 31337
    )
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
