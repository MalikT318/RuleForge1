/*
  MITRE Technique : T1583.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:09:11.801283+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_006_Web_Service_Account_Registration_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an HTTP POST from an internal client to an external account-registration or sign-up endpoint that is not on the known-good domain list. This is the network-visible footprint of registering for a web service (code hosting, paste, cloud storage, social or mail platforms) that could later be abused for C2, exfiltration or phishing. It matches generic URL path semantics rather than specific service domains. Treat it as a low-fidelity hunting and shadow-IT signal."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.006"
    mitre_technique_name = "Acquire Infrastructure: Web Services"
    log_prerequisites = "Requires firewall or secure web proxy logs with URL visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP, with network.http.method and target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees signing up for legitimate SaaS or vendor portals, marketing or HR staff registering for events and services, developers creating accounts on package or code-hosting platforms, shadow IT, sanctioned vendor onboarding workflows, and web crawlers or QA automation exercising sign-up forms."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Scope or exclude approved egress sources with %global_allowed_mgmt_sources. Exclude sanctioned automation identities with %global_allowed_service_accounts. Raise severity only for hosts in sensitive segments, or correlate with later uploads or C2 to the same domain."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST"
    $net.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|join)(\/|\?|$)/ nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1583.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
