/*
  MITRE Technique : T1585.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:39:26.105105+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_003_Cloud_Signup_Then_Bulk_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an internal source POSTing to an external account sign-up or registration URL and then sending a large volume of data to an external destination within 10 minutes. This pattern is consistent with a newly created cloud account being used as an exfiltration or staging channel. Adversary account creation itself happens outside the victim's visibility, so this rule covers only the observable aftermath on the perimeter."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.003"
    mitre_technique_name = "Establish Accounts: Cloud Accounts"
    log_prerequisites = "Requires perimeter or proxy logs normalised to UDM NETWORK_HTTP (with TLS inspection so the URL path and method are visible) and NETWORK_CONNECTION or flow records with network.sent_bytes populated. Without TLS inspection the HTTP leg will not match."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees legitimately registering for SaaS trials and then uploading large files, developers onboarding to cloud platforms, marketing or IT staff creating vendor portal accounts, and software backups to a newly provisioned cloud service."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Adjust the sent_bytes threshold (default about 10 MB) per client bandwidth profile. Add known egress or proxy source addresses to %global_allowed_mgmt_sources if they mask real client IPs. Consider narrowing the sign-up URL regex if a client portal triggers it."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|join)(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.sent_bytes > 10485760
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1585.003")
    $primary_entity = array_distinct($src_ip)
    $signup_hosts = array_distinct($http.target.hostname)
    $signup_urls = array_distinct($http.target.url)
    $upload_destination_ips = array_distinct($net.target.ip)
    $max_bytes_sent = max($net.network.sent_bytes)

  condition:
    $http and $net
}
