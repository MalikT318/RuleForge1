/*
  MITRE Technique : T1190 - Exploit Public-Facing Application
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:12:13.967151+00:00
  Reference       : https://attack.mitre.org/techniques/T1190
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1190_Container_K8s_API_External_Anonymous_Success {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful (2xx) request from an external source address to a sensitive Kubernetes API resource (secrets, pods, exec, attach, port-forward, RBAC bindings, nodes, configmaps) made by the anonymous identity. This is the network-side RESULT of exploiting an exposed or misconfigured cluster control plane. It does not depend on a specific CVE, payload or tool."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1190"
    mitre_technique_name = "Exploit Public-Facing Application"
    log_prerequisites = "Requires cluster control-plane audit logs ingested and normalised so that API requests appear as NETWORK_HTTP events with principal.ip (client source address), principal.user.userid (authenticated username), target.url (request URI) and network.http.response_code populated. Audit policy must record at least Metadata level for secrets, pods, exec and RBAC resources."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Clusters deliberately configured to allow anonymous reads through a public ingress or API gateway; external uptime or health monitors hitting resource endpoints; authorised external vulnerability scanners and penetration tests; managed-provider or load-balancer source addresses logged as the client IP when the API server sits behind a proxy."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management or bastion egress addresses to %global_allowed_mgmt_sources. If the API server sits behind a proxy that masks client addresses, confirm principal.ip holds the original client address. Populate %rfc1918_internal with the client's internal address space. For clusters that intentionally expose anonymous endpoints, narrow the resource regex or add the endpoint's source to the allow lists."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.user.userid = /^system:anonymous$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    $http.target.url = /\/(secrets|pods|exec|attach|portforward|clusterrolebindings|rolebindings|configmaps|nodes)(\/|\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1190")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $response_codes = array_distinct($http.network.http.response_code)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
