/*
  MITRE Technique : T1588.006 - Vulnerabilities
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:03:11.430384+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_006_External_Source_Connect_Then_Vuln_Probe_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An external source connects to web-facing ports on the perimeter and then sends at least three HTTP requests within 10 minutes with URL patterns typical of vulnerability probing (path traversal, sensitive file access, exposed management endpoints). This is the network-observable result of an adversary applying acquired vulnerability knowledge during targeting. T1588.006 itself happens off-network, so this rule detects the external reconnaissance that follows it."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.006"
    mitre_technique_name = "Obtain Capabilities: Vulnerabilities"
    log_prerequisites = "Requires perimeter firewall or proxy/WAF telemetry normalised to UDM NETWORK_CONNECTION and NETWORK_HTTP, with principal.ip and target.url populated for inbound traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners or pen-test sources not yet in the allow list, search-engine and internet-measurement crawlers, uptime monitors, and legitimate applications with URLs that contain management-style paths."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners and trusted management source addresses to %global_allowed_mgmt_sources. Raise the #http threshold on noisy internet-facing sites. Extend the target.port list to match the client's published web ports."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    (
      $conn.target.port = 80 or
      $conn.target.port = 443 or
      $conn.target.port = 8080 or
      $conn.target.port = 8443
    )
    $conn.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.target.url = /(\.\.\/|%2e%2e%2f|\/etc\/passwd|\/\.env|\/\.git\/|\/actuator\/|\/cgi-bin\/|\/phpunit\/|\/manager\/html)/ nocase
    $http.principal.ip = $src_ip

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1588.006")
    $primary_entity = array_distinct($src_ip)
    $probe_urls = array_distinct($http.target.url)
    $probed_ports = array_distinct($conn.target.port)
    $targeted_ips = array_distinct($conn.target.ip)
    $probe_count = count($http.metadata.id)

  condition:
    $conn and #http >= 3
}
