/*
  MITRE Technique : T1588.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:54:12.329472+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_001_Executable_Payload_Download_From_IP_Literal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal client successfully downloading an executable, script, installer or archive payload over HTTP from an external server addressed by a raw IP literal rather than a domain name. This is the closest perimeter-observable signal of adversary-acquired malware (T1588.001) being staged for delivery. The acquisition itself occurs outside victim telemetry, so this rule detects the resulting payload retrieval from unmanaged infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.001"
    mitre_technique_name = "Obtain Capabilities: Malware"
    log_prerequisites = "Requires proxy or firewall logs with URL-level HTTP visibility (TLS inspection or cleartext HTTP) that populate network.http.method, network.http.response_code, target.url and target.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal software distribution from IP-addressed servers, IoT or OT firmware updates, appliance or hypervisor patch downloads, developer or lab tooling, and legitimate vendors that serve installers from IP-addressed hosts."
    tuning_guidance = "Add known-good external update domains to %global_allowed_domains and authorised scanning or testing sources to %global_allowed_scanners. Add expected file extensions or response conditions if the environment generates noise. If the log source lacks TLS inspection, this rule only covers cleartext HTTP."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.response_code = 200
    $http.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\/[^?#]*\.(exe|dll|msi|scr|ps1|bat|cmd|vbs|hta|jar|iso|img|7z|rar|zip|lnk)([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1588.001")
    $primary_entity = array_distinct(strings.coalesce($http.principal.hostname, $http.principal.ip))
    $destination_ips = array_distinct($http.target.ip)
    $download_urls = array_distinct($http.target.url)

  condition:
    $http
}
