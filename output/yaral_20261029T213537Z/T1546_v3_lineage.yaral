/*
  MITRE Technique : T1546 - Event Triggered Execution
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:28:26.808059+00:00
  Reference       : https://attack.mitre.org/techniques/T1546
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_Event_Trigger_Host_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by a process that only acts as a parent when an event trigger fires. These parents are the WMI script event consumer host (scrcons.exe, used by WMI event subscription persistence) and the Windows accessibility binaries launched from the logon screen (utilman, sethc, osk, narrator, magnify, displayswitch, atbroker, used by accessibility feature hijacking). The rule keys on parent-child lineage rather than command-line content, so it complements command-line detections for T1546."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546"
    mitre_technique_name = "Event Triggered Execution"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (or Windows Security Event 4688 with parent process populated) normalised to UDM PROCESS_LAUNCH, with principal.process.file.full_path (parent) and target.process.file.full_path (child) populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy management or inventory scripts that run through WMI script consumers (scrcons.exe), administrators deliberately launching a command prompt from the logon-screen Ease of Access menu for recovery or troubleshooting, and accessibility tooling that starts helper scripts."
    tuning_guidance = "Add legitimate parent processes (for example sanctioned WMI-based management agents) to %global_allowed_script_hosts. Add known automation accounts to %global_allowed_service_accounts. Review hosts that fire repeatedly, since legacy WMI consumers tend to recur on the same hosts, and tune the child process list if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(scrcons|utilman|sethc|osk|narrator|magnify|displayswitch|atbroker)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
