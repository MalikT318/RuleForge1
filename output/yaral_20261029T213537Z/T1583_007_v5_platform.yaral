/*
  MITRE Technique : T1583.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:12:11.765081+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_007_Serverless_Function_Host_Scripted_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making HTTP requests to a serverless function hosting endpoint (edge workers, function-as-a-service URLs, managed container-run URLs) using a non-browser, scripted HTTP client. Adversaries who stand up serverless runtimes as C2 responders or redirectors (T1583.007) are reached through these provider subdomains, and implant HTTP libraries usually present a scripting or library user agent rather than a browser. The rule matches the combination of a serverless host pattern and a non-browser client, not any specific attacker domain, so it survives infrastructure rotation."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.007"
    mitre_technique_name = "Acquire Infrastructure: Serverless"
    log_prerequisites = "Requires forward or web proxy, or firewall with URL and application inspection, that populates NETWORK_HTTP with target.hostname and network.http.user_agent. TLS inspection or SNI logging is needed for HTTPS visibility."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate internal applications, monitoring probes and CI/CD or DevOps tooling that call the organisation's own or a vendor's serverless APIs using curl, python-requests, Go or Java HTTP clients; SaaS integrations hosted on serverless platforms; developer workstations testing their own functions."
    tuning_guidance = "Add sanctioned vendor and in-house function domains to %global_allowed_domains. Add authorised testing or monitoring source addresses to %global_allowed_scanners. If volume is high from developer subnets, scope the rule to non-developer segments in the client deployment, or raise severity only for hosts that have no prior history of calling the same function host."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /\.(workers\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app|azurewebsites\.net|netlify\.app|vercel\.app|pages\.dev|deno\.dev)$/ nocase
    $http.network.http.user_agent = /(curl|wget|python|go-http-client|powershell|winhttp|java\/|okhttp|libwww|node-fetch|axios|httpclient|^$)/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1583.007")
    $primary_entity = array_distinct($http.principal.hostname)
    $serverless_host = array_distinct($http.target.hostname)
    $user_agent = array_distinct($http.network.http.user_agent)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
