/*
  MITRE Technique : T1592.004 - Client Configurations
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:41:29.639566+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_004_External_Client_Config_Probe_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external (non-internal) source requesting well-known client-configuration disclosure resources (proxy auto-config, browser/cross-domain policy files, mail autodiscover configuration) over HTTP at the network perimeter. These resources expose client proxy settings, browser behaviour and mail client configuration, and are commonly probed during pre-compromise reconnaissance of client configurations."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.004"
    mitre_technique_name = "Gather Victim Host Information: Client Configurations"
    log_prerequisites = "Requires firewall, reverse proxy or web gateway logs normalised to NETWORK_HTTP with principal.ip and target.url populated (URL inspection or TLS decryption enabled for inbound web traffic)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate external mail clients and mobile devices using autodiscover; remote workers whose browsers request proxy auto-config files; Flash/Silverlight legacy applications requesting cross-domain policy files; search engine crawlers and approved external attack-surface monitoring services."
    tuning_guidance = "Add authorised external scanner and attack-surface monitoring source addresses to %global_allowed_scanners. If autodiscover generates noise, remove the autodiscover alternation or scope the rule to hosts that do not publish mail services. Consider raising severity when the same source also appears in other reconnaissance detections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(wpad\.dat|proxy\.pac|browserconfig\.xml|crossdomain\.xml|clientaccesspolicy\.xml|autodiscover\/autodiscover\.(xml|json))([?#]|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1592.004")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
