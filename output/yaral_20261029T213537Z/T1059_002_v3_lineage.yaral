/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:37:03.151593+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_macOS_Unexpected_Parent_Spawns_Osascript {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the macOS AppleScript interpreter (osascript) launched by a parent process that should never run scripts. Parents covered are Microsoft Office applications, Outlook, Mail, Preview, web server processes, database services, and the print spooler. This pattern is typical of macro-based or exploit-driven execution, web shell activity, and database or service compromise. The rule pivots on process lineage rather than command-line content, so it complements command-line rules for osascript."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "macOS endpoint telemetry (EDR or unified log) providing process launch events with parent and child executable paths."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Office add-ins or macros that automate other apps through AppleScript, Outlook or Mail rules and plug-ins running approved scripts, locally hosted dev web stacks (httpd/php) invoking osascript for notifications, and vendor installers launched from a database or print service."
    tuning_guidance = "Add approved parent processes or hosts to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Remove noisy parent names from the parent regex only after confirming the behaviour is business-justified. Use the parent_process and child_command_line outcome fields for triage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/osascript$/ nocase
    $proc.principal.process.file.full_path = /(\/Microsoft (Word|Excel|PowerPoint|Outlook)|\/Mail|\/Preview|\/(httpd|nginx|apache2|php|php-fpm|mysqld|postgres|mongod|redis-server|cupsd|cups-exec|smbd))$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
