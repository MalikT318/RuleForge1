/*
  MITRE Technique : T1592.004 - Client Configurations
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:41:47.904203+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_004_External_Client_Config_Discovery_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "An external source requests files whose purpose is to describe or configure client software (proxy auto-config, WPAD, browser configuration, cross-domain policy, mobile configuration profiles, Autodiscover) on an internet-facing web service. This is typical of reconnaissance that harvests client configuration details, and it is observed at the perimeter proxy or firewall. It is network-observable behaviour only and does not depend on any process or command-line telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.004"
    mitre_technique_name = "Gather Victim Host Information: Client Configurations"
    log_prerequisites = "Requires perimeter proxy, web gateway or firewall logs with HTTP inspection that populate network.http.method and target.url, normalised to NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate external clients and mobile devices fetching Autodiscover or mobile configuration profiles, partner or browser-plugin clients requesting cross-domain policy files, internet-wide research crawlers, and authorised external penetration tests or vulnerability scans."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners. If Autodiscover or mobile enrolment services are intentionally published, add their hostnames to %global_allowed_domains, or require a 4xx response code for lower-noise alerting. For higher fidelity, aggregate by source address in a threshold variant."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD|POST|OPTIONS)$/ nocase
    $http.target.url = /\/(wpad\.dat|proxy\.pac|browserconfig\.xml|crossdomain\.xml|clientaccesspolicy\.xml|autodiscover\.xml|[^\/?]+\.mobileconfig)(\?.*)?$/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1592.004")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
