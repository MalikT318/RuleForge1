/*
  MITRE Technique : T1591 - Gather Victim Org Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:25:46.049729+00:00
  Reference       : https://attack.mitre.org/techniques/T1591
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_External_Site_Mapping_Then_Org_Page_Harvest {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Low"
    description = "An external source requests site-structure discovery files (robots.txt, sitemap) and then requests several organisation-information pages (team, leadership, staff directory, careers, contact) within ten minutes. This pattern is consistent with adversary gathering of victim organisation details (divisions, roles, key personnel) ahead of targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591"
    mitre_technique_name = "Gather Victim Org Information"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with HTTP inspection that populate principal.ip and target.url for NETWORK_HTTP events."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and website monitoring services, legitimate job seekers or journalists browsing careers and leadership pages, partner or vendor due diligence, and authorised external scanners."
    tuning_guidance = "Add authorised external scanners and monitoring sources to %global_allowed_scanners. Raise the #org threshold in the condition for high-traffic public websites. Lengthen or shorten the match window per client baseline. Consider raising severity when the source is also seen in other IPS verdicts."

  events:
    $meta.metadata.event_type = "NETWORK_HTTP"
    $meta.target.url = /\/(robots\.txt|sitemap[^\/\?]*\.xml)(\?|$)/ nocase
    not $meta.principal.ip in %rfc1918_internal
    not $meta.principal.ip in %global_allowed_scanners
    $meta.principal.ip = $src_ip

    $org.metadata.event_type = "NETWORK_HTTP"
    $org.target.url = /\/(about(-us)?|our-team|team|staff|leadership|management|executives|directory|people|departments?|careers|jobs|contact(-us)?|investors|org(anization)?-chart)(\/|\.[a-z]{3,4})?(\?|$)/ nocase
    not $org.principal.ip in %rfc1918_internal
    not $org.principal.ip in %global_allowed_scanners
    $org.principal.ip = $src_ip

    $meta.metadata.event_timestamp.seconds <= $org.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1591")
    $primary_entity = array_distinct($src_ip)
    $org_pages_requested = array_distinct($org.target.url)
    $org_page_count = count_distinct($org.target.url)
    $discovery_files = array_distinct($meta.target.url)
    $targeted_hosts = array_distinct($org.target.hostname)

  condition:
    $meta and #org >= 3
}
