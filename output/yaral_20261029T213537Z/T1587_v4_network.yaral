/*
  MITRE Technique : T1587 - Develop Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:47:09.419540+00:00
  Reference       : https://attack.mitre.org/techniques/T1587
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_Outbound_HTTP_IP_Literal_NonStandard_Port_NoBrowserUA {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests from an internal client to an external IP-literal URL on a non-standard port, where the user agent is empty or belongs to a generic scripting or HTTP library. This is the network pattern typical of adversary-developed, in-house tooling (custom implants, loaders, exploit payload stagers) that has not been polished to blend with browser traffic. The development activity itself happens on adversary infrastructure and is not directly visible, so this is an indirect, network-side indicator of a custom capability in use. Treat it as a hunting lead."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587"
    mitre_technique_name = "Develop Capabilities"
    log_prerequisites = "Requires perimeter proxy or firewall logs with HTTP inspection that populate target.url, target.port, target.ip and network.http.user_agent. Plain L4 firewall logs without HTTP metadata will not trigger this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal developers or QA testing against external IP-addressed hosts, IoT and OT devices phoning home to bare IPs, legacy update agents, monitoring probes, and health checks from SaaS integrations that use library user agents."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Confirm %rfc1918_internal covers the client's internal ranges. If a client has many developers, consider restricting this rule to user-facing network segments or raising severity only when combined with other alerts for the same source."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?(\/|$)/ nocase
    $http.target.port != 80
    $http.target.port != 443
    (
      $http.network.http.user_agent = "" or
      $http.network.http.user_agent = /^(python-requests|python-urllib|go-http-client|java|libwww-perl|okhttp|winhttp)/ nocase
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1587")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_ports = array_distinct($http.target.port)
    $destination_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
