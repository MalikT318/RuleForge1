/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:43:20.217335+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Strip_Tool_Output_Staged_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A symbol-stripping utility (strip, objcopy, sstrip, eu-strip, llvm-strip, upx) writes a file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm), and that same path is executed on the same host within 5 minutes. This pattern indicates a payload stripped of symbols and strings and then run, rather than ordinary developer use of the tool. It is detected through the file-write to execute chain, not through command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with both FILE_CREATION (with the writing process populated) and PROCESS_LAUNCH events normalised into UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and CI hosts, developers testing compiled binaries from /tmp, package build chroots, and software-packaging pipelines that strip binaries in scratch directories and run self-tests."
    tuning_guidance = "Add build and CI service accounts to %global_allowed_service_accounts. Add approved build or packaging tooling used as the parent process to %global_allowed_admin_tools. If strip is used in place, the output may appear as a temporary file or a rename, so ensure FILE_CREATION events cover the output path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(strip|objcopy|sstrip|eu-strip|llvm-strip|upx)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname
    not $file.principal.user.userid in %global_allowed_service_accounts

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $proc.target.process.file.full_path = $path
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.008")
    $primary_entity = array_distinct($hostname)
    $stripped_file_path = array_distinct($path)
    $strip_tool = array_distinct($file.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $launch_command = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
