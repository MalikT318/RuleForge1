/*
  MITRE Technique : T1590 - Gather Victim Network Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:12:59.661679+00:00
  Reference       : https://attack.mitre.org/techniques/T1590
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_IPS_External_Network_Recon_Verdict {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IDS/IPS detection or prevention verdict for network-reconnaissance behaviour (host sweeps, port scans, SNMP or DNS zone-transfer enumeration, fingerprinting) from an external, non-RFC1918 source. This gathers victim network information such as live hosts, topology and DNS records. The rule keys on the verdict name or category, not on any attacker tool or specific payload, and is independent of process-creation telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590"
    mitre_technique_name = "Gather Victim Network Information"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with security_result.rule_name or security_result.category_details populated and principal.ip set to the connection source. Appliances that do not map signature names into these fields will not trigger this rule."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and penetration tests, internet-wide research scanners (benign survey crawlers), external uptime and monitoring probes, and MSP or partner network discovery tools run from public addresses."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add trusted partner or MSP management source addresses to %global_allowed_scanners as well. If the signature regex is too noisy, narrow it to the verdict families that your IPS vendor maps into security_result.rule_name. For high-volume internet-facing sensors, consider a companion Threshold rule grouped by principal.ip."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.rule_name = /(port.?scan|host.?sweep|network.?scan|ping.?sweep|zone.?transfer|axfr|snmp.{0,20}(sweep|scan|walk|enum|community)|enumerat|fingerprint|banner.?grab|traceroute|recon|probe|discovery)/ nocase or
      $net.security_result.category_details = /(port.?scan|host.?sweep|network.?scan|ping.?sweep|zone.?transfer|axfr|snmp.{0,20}(sweep|scan|walk|enum|community)|enumerat|fingerprint|banner.?grab|traceroute|recon|probe|discovery)/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1590")
    $primary_entity = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)
    $signatures = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
