/*
  MITRE Technique : T1608.003 - Install Digital Certificate
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:26:06.334024+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_003_Repeated_NonStandard_TLS_Port_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host makes many outbound connections within ten minutes to external destinations on non-standard TLS or alternate HTTPS ports. Adversary-staged infrastructure with an installed TLS certificate (T1608.003), used for encrypted C2 or credential-harvesting sites, commonly listens on these ports. The certificate install itself happens off-network and is not observable. This rule detects the perimeter-visible result: repeated use of alternate encrypted-service ports on external hosts. A single connection is benign; sustained volume from one host is the signal."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.003"
    mitre_technique_name = "Stage Capabilities: Install Digital Certificate"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated. Egress traffic must be logged."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Vendor SaaS and management consoles that use alternate HTTPS ports, remote-access and VPN clients, web-management interfaces of appliances, developer or test traffic, and legitimate software update services on alternate TLS ports."
    tuning_guidance = "Add known-good vendor domains to %global_allowed_domains, and add scanning and security-testing hosts to %global_allowed_scanners. The threshold of 10 connections and the port list can be adjusted per client. Raise the threshold for noisy environments and review the destination_ips outcome for repeated single-destination patterns."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 8443 or
      $net.target.port = 4443 or
      $net.target.port = 9443 or
      $net.target.port = 10443 or
      $net.target.port = 2083 or
      $net.target.port = 2087 or
      $net.target.port = 2096 or
      $net.target.port = 7443
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners
    $net.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1608.003")
    $primary_entity = array_distinct($host)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
