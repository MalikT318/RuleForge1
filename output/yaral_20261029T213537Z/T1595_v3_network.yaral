/*
  MITRE Technique : T1595 - Active Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:50:40.772510+00:00
  Reference       : https://attack.mitre.org/techniques/T1595
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_External_Sensitive_Path_Probing_Web_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting well-known sensitive or misconfiguration-indicator paths (environment files, VCS metadata, credential files, debug and status endpoints) on an internet-facing web service. Requests for these paths are characteristic of automated active scanning and content discovery. The rule uses network-side HTTP telemetry only and does not depend on any scanner binary or user-agent."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595"
    mitre_technique_name = "Active Scanning"
    log_prerequisites = "Requires perimeter proxy, WAF, reverse-proxy or firewall logs with HTTP inspection that populate target.url and principal.ip as NETWORK_HTTP events."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners or penetration tests not yet in the allowlist, search engine and security-research crawlers, uptime monitors that probe status endpoints, and legitimate applications that deliberately expose a status or actuator health path."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Ensure %rfc1918_internal is populated so internal clients are excluded. Narrow the path regex if a client intentionally publishes a status endpoint. Consider raising severity for repeated hits from one source by pairing with a threshold variant."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(\.env|\.git\/(config|HEAD)|\.svn\/entries|\.aws\/credentials|\.ds_store|\.htpasswd|phpinfo\.php|server-status|actuator\/(env|heapdump)|wp-config\.php(\.bak|\.old)?|id_rsa)(\?|\/|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1595")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $probed_urls = array_distinct($http.target.url)

  condition:
    $http
}
