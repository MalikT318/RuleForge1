/*
  MITRE Technique : T1583.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:02:15.044175+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_002_DNS_Long_Label_Query_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single client issues a high volume of DNS queries containing very long subdomain labels within ten minutes. Individual long-label queries are benign, but repeated ones are characteristic of DNS tunnelling or C2 and exfiltration against an adversary-operated authoritative DNS server."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.002"
    mitre_technique_name = "Acquire Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with principal.hostname and network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services using long hashed hostnames, DNS-based security and reputation lookups (DNSBL, AV cloud lookups), email authentication (DKIM) lookups, content-addressed or telemetry services, and software licensing checks."
    tuning_guidance = "Add known-good domains to %global_allowed_domains and approved scanners or monitoring hosts to %global_allowed_scanners. Raise the #dns threshold or the label-length quantifier (40) for noisy environments. If resolver logs only carry client IPs, change the grouping field from principal.hostname to principal.ip."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{40,}\.[a-z0-9_-]+\.[a-z0-9_-]+$/ nocase
    $dns.principal.hostname = $host
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($dns.metadata.id)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $mitre_technique_id = array_distinct("T1583.002")
    $primary_entity = array_distinct($host)

  condition:
    #dns >= 15
}
