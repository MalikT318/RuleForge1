/*
  MITRE Technique : T1584.008 - Network Devices
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:31:58.012030+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_008_External_Access_To_Network_Device_Mgmt_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects external, non-allowlisted sources opening TCP connections to well-known network-device management and CPE exploitation ports (Telnet, alternate Telnet, TR-069, MikroTik Winbox, common SOHO router service ports). Exposure of these services on edge devices is the precursor adversaries use to compromise third-party network devices and repurpose them as relay, proxy or payload-hosting infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.008"
    mitre_technique_name = "Compromise Infrastructure: Network Devices"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Logs must record inbound (denied and allowed) connections."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet-wide research scanners, ISP or MSP remote management of CPE (TR-069 ACS), legitimate remote administration of branch routers, penetration tests, external vulnerability scans not yet in the allowlists."
    tuning_guidance = "Add authorised management source addresses to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. Correlate repeated hits per target.ip in SOAR; consider raising severity when the destination is a known edge device and the connection was allowed rather than denied."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    (
      $net.target.port = 23 or
      $net.target.port = 2323 or
      $net.target.port = 7547 or
      $net.target.port = 8291 or
      $net.target.port = 37215 or
      $net.target.port = 52869
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
