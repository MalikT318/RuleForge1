/*
  MITRE Technique : T1584 - Compromise Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:15:51.051824+00:00
  Reference       : https://attack.mitre.org/techniques/T1584
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_DNS_Tunnel_Long_Label_TXT_NULL_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS TXT or NULL record queries whose subdomain label is 45 or more characters long, for domains not on the known-good list. This pattern is typical of DNS tunnelling and C2 or exfiltration through attacker-controlled or compromised third-party DNS infrastructure. Queries that resolve to internal address space (split-horizon or internal zones) are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584"
    mitre_technique_name = "Compromise Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated. Answer data (network.dns.answers.data) improves the internal-zone exclusion but is not required."
    platform = "PRE"
    log_source = "dns"
    false_positives = "DKIM, SPF, DMARC and domain-verification TXT lookups with long selectors; anti-spam and anti-virus DNS blocklist or reputation lookups; CDN and cloud-provider hostnames with long generated labels; some endpoint security agents that use DNS for telemetry or file reputation; mDNS or service-discovery-style queries."
    tuning_guidance = "Add legitimate vendor, CDN, and reputation-service domains to %global_allowed_domains, using the registered domain (for example example.com). The registered domain is extracted as the last two labels, so multi-label public suffixes such as co.uk may need the full registered domain or the full query name listed. Add internal zones to %global_allowed_domains if they are not already covered. Raise the label-length threshold (45) in the regex for noisy tenants. Combine with a volume-based variant for higher confidence."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /(?i)[a-z0-9_\-]{45,}\.[a-z0-9\-]+\.[a-z0-9\-]+\.?$/
    $reg_domain = re.capture($dns.network.dns.questions.name, "([^.]+\\.[^.]+)\\.?$")
    not $reg_domain in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $queried_domains = array_distinct($reg_domain)

  condition:
    $dns
}
