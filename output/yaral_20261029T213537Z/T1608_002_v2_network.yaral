/*
  MITRE Technique : T1608.002 - Upload Tool
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:22:43.263743+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_002_Raw_IP_Tool_Download_Via_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP GET through a firewall or proxy for an executable, script, installer or archive hosted on a bare IPv4-literal URL with no domain name. Tools staged on adversary-controlled infrastructure are commonly served this way, so the rule observes the network-side result of T1608.002 (Upload Tool) when a victim retrieves the staged tool. Internal destinations and allowlisted domains are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.002"
    mitre_technique_name = "Stage Capabilities: Upload Tool"
    log_prerequisites = "Requires firewall or proxy logs normalised to NETWORK_HTTP with network.http.method and target.url populated. SSL inspection is needed to see URLs for HTTPS traffic; without it only plain HTTP is covered."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Vendor appliances, IoT or OT devices and embedded systems that pull firmware or updates from a bare IP; internal software distribution on non-RFC1918 or NAT-translated addresses; authorised penetration tests and red-team staging; legacy update mechanisms from CDNs addressed by IP."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add authorised scanning or testing sources to %global_allowed_scanners. Add source addresses of approved patching or management hosts to %global_allowed_mgmt_sources. Extend or narrow the file-extension list if the client's proxy volume is high."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?\/[^?#]*\.(exe|dll|msi|scr|ps1|psm1|bat|cmd|hta|vbs|js|jar|sh|elf|bin|7z|zip|rar|gz|iso)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1608.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
