/*
  MITRE Technique : T1584.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:30:35.930787+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_007_Serverless_Endpoint_Scripted_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host making HTTP requests to a generic serverless function endpoint (edge worker, function URL, API gateway or cloud function hostname) using a scripted or non-browser client. Adversaries who compromise serverless runtimes use them as C2 redirectors or responders, and the traffic blends in with ordinary cloud provider traffic. This rule matches the provider-wide serverless hostname structure combined with a non-browser client, so it does not depend on any specific adversary-owned name."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.007"
    mitre_technique_name = "Compromise Infrastructure: Serverless"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection that populate network.http.user_agent and target.hostname (TLS inspection or SNI-derived hostname). The log source must be mapped to UDM NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate internal applications, SaaS integrations, webhooks, monitoring probes or developer scripts calling a business-owned serverless API; CI/CD pipelines and automation tools that use scripted HTTP clients against cloud function endpoints."
    tuning_guidance = "Add sanctioned serverless API hostnames to %global_allowed_domains. Add scanner and monitoring source addresses to %global_allowed_scanners. Add known automation source hosts to %global_allowed_script_hosts. Review the user agent and destination hostname in the outcome before escalating."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.hostname = /\.(workers\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app|azurewebsites\.net|azurefd\.net|netlify\.app|vercel\.app)$/ nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|aiohttp|go-http-client|okhttp|java|libwww-perl|powershell|winhttp|node-fetch|axios|ruby|httpclient)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.007")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hostnames = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
