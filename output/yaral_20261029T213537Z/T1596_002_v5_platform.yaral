/*
  MITRE Technique : T1596.002 - WHOIS
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:01:35.885525+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_002_Outbound_WHOIS_Port43_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal source making an outbound TCP connection to an external host on port 43, the WHOIS protocol, as seen by an IDS/IPS or network security appliance. Native WHOIS clients and scripted lookups reach registry servers this way, so this is a platform-neutral network-layer signal. It does not depend on the OS or the client binary, and it covers Linux and macOS command-line whois as well as cloud-hosted workloads. Web-based WHOIS lookups over HTTPS are not covered."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.002"
    mitre_technique_name = "Search Open Technical Databases: WHOIS"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection or flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, and with egress traffic visible to the sensor."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Network or security staff running whois lookups, domain and brand-protection tooling, mail gateways or anti-spam systems that query WHOIS, threat-intelligence enrichment hosts, authorised external scanners and reconnaissance tooling."
    tuning_guidance = "Add authorised scanner and enrichment source addresses to %global_allowed_scanners and approved management or analyst jump hosts to %global_allowed_mgmt_sources. Raise severity or add a threshold variant if one internal source queries many distinct external WHOIS servers. Consider keeping the rule disabled on tenants whose business runs WHOIS lookups at scale, such as registrars."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 43
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596.002")
    $primary_entity = array_distinct($net.principal.ip)
    $whois_server_ips = array_distinct($net.target.ip)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
