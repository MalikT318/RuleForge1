/*
  MITRE Technique : T1590.006 - Network Security Appliances
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:23:22.941630+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_006_External_Security_Appliance_Fingerprinting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects external sources fingerprinting network security appliances (firewall/VPN/gateway portals and management interfaces). Fires on an IPS reconnaissance/scan/fingerprint verdict, or on an HTTP request to a security appliance portal or admin path that returns a client-error response, which is typical of automated appliance discovery."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.006"
    mitre_technique_name = "Gather Victim Network Information: Network Security Appliances"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_HTTP with principal.ip, target.url, network.http.response_code and security_result signature fields populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services not yet listed in the allowlists, legitimate remote users mistyping VPN or portal URLs, search-engine and internet-census crawlers, and broad IPS scan signatures that fire on benign traffic."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved external administration sources to %global_allowed_mgmt_sources. If the IPS signature naming differs from the recon/scan/probe/fingerprint keywords, adjust the signature regex. Consider wrapping this rule in a threshold or host-level correlation to prioritise sources that touch several appliance paths."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    (
      $net.security_result.rule_name = /(recon|scan|probe|fingerprint|enumerat)/ nocase or
      $net.security_result.threat_name = /(recon|scan|probe|fingerprint|enumerat)/ nocase or
      (
        $net.target.url = /\/(remote\/login|dana-na|global-protect|\+CSCOE\+|sslvpn|cgi-bin\/luci|webui|fwadmin|admin\/login|vpn\/index\.html|userportal)/ nocase and
        $net.network.http.response_code >= 400
      )
    )

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1590.006")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
