/*
  MITRE Technique : T1137.004 - Outlook Home Page
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:11:20.979644+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_004_Outlook_Folder_HomePage_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a mailbox folder configuration change in the unified audit log that references a folder home page or web view property. Outlook Home Page persistence works by setting a URL on a mailbox folder, which Outlook loads whenever the folder is opened. Detecting the stored configuration change does not depend on endpoint command-line telemetry."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.004"
    mitre_technique_name = "Office Application Startup: Outlook Home Page"
    log_prerequisites = "Requires unified audit logs with mailbox audit and admin audit enabled, ingested and normalised to SETTING_MODIFICATION. Folder property changes must be audited, and the operation name must be mapped to metadata.product_event_type. The property name must appear in target.resource.name or metadata.description. If the tenant's parser does not surface the property name, this rule will not fire."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Mailbox migration or folder-provisioning tooling, shared-mailbox or public-folder administration, legacy line-of-business apps that use folder web views, and admins deliberately configuring folder properties."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and provisioning or migration identities to %global_allowed_service_accounts. Review the operation-name regex against product_event_type values in the tenant's parsed audit data. If the property name is carried in a different UDM field, extend the OR group accordingly. Any hit where the actor is not the mailbox owner or an administrator should be treated as high confidence."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(Set-?MailboxFolder|Set-?FolderProperty|Update-?Folder|Modify-?Folder|Set-?Folder|FolderBind|^Update$)/ nocase
    (
      $setting.target.resource.name = /(web_?view|home_?page|folder_?home)/ nocase or
      $setting.metadata.description = /(web_?view|home_?page|folder_?home)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.004")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $target_mailbox = array_distinct($setting.target.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
