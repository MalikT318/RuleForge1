/*
  MITRE Technique : T1683.001 - Written Content
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:42:33.944513+00:00
  Reference       : https://attack.mitre.org/techniques/T1683/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1683_001_Lure_Domain_Then_Algorithmic_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single client querying a domain whose name uses phishing-lure vocabulary (credential, invoice, document-signing or account-verification themes) and, within ten minutes, querying a different name with an abnormally long, machine-generated-looking label. This pattern suggests a user followed written lure content (T1683.001) and the host then began staging or beaconing to attacker infrastructure. Only resolver-side telemetry is used."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1683.001"
    mitre_technique_name = "Written Content"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with principal.hostname and network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate e-signature, invoicing, payroll and SSO vendors; CDN and cloud storage hostnames with long auto-generated labels; email security and link-rewriting services; software update and telemetry endpoints; security awareness phishing simulations."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. If DNS logs only carry resolver IPs, switch the join key to principal.ip. Adjust the lure keyword list and the 25-character label threshold to the client's baseline. Allowlist phishing simulation domains in %global_allowed_domains."

  events:
    $lure.metadata.event_type = "NETWORK_DNS"
    $lure.network.dns.questions.name = /(login|signin|logon|secure|verify|validate|invoice|payroll|docusign|onedrive|sharepoint|webmail|account|mfa|helpdesk|benefits|remittance)[a-z0-9\-]*\./ nocase
    $lure.network.dns.questions.name = /[a-z0-9]+-[a-z0-9\-]+\.[a-z]{2,}$/ nocase
    not $lure.network.dns.questions.name = /\.(arpa|local|internal)$/ nocase
    not $lure.network.dns.questions.name in %global_allowed_domains
    $lure.principal.hostname = $hostname

    $beacon.metadata.event_type = "NETWORK_DNS"
    $beacon.network.dns.questions.name = /^[a-z0-9\-_]{25,}\./ nocase
    not $beacon.network.dns.questions.name = /\.(arpa|local|internal)$/ nocase
    not $beacon.network.dns.questions.name in %global_allowed_domains
    $beacon.principal.hostname = $hostname

    $lure.metadata.event_timestamp.seconds <= $beacon.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1683.001")
    $primary_entity = array_distinct($hostname)
    $lure_domains = array_distinct($lure.network.dns.questions.name)
    $beacon_domains = array_distinct($beacon.network.dns.questions.name)
    $beacon_query_count = count($beacon.metadata.id)

  condition:
    $lure and $beacon
}
