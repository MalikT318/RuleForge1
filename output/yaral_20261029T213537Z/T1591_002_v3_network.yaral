/*
  MITRE Technique : T1591.002 - Business Relationships
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:28:21.541458+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_002_External_Scripted_Partner_Page_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "An external source uses a non-browser, scripted HTTP client to request web paths that disclose business relationships (partners, suppliers, vendors, contractors, resellers, supply chain). This is network-side evidence of reconnaissance on the victim's business relationships. It is a low-fidelity, early-stage signal intended for correlation and enrichment, not standalone escalation."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.002"
    mitre_technique_name = "Gather Victim Org Information: Business Relationships"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to NETWORK_HTTP with target.url, network.http.user_agent and principal.ip populated. The appliance must inspect HTTP for inbound traffic to client web servers (decrypted or terminated TLS)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and availability monitors, partner or vendor integrations that poll partner-directory pages with scripted clients, external vulnerability or attack-surface scanners, press and market-intelligence aggregators, and developers testing public APIs."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners. Add known-good crawler or partner-integration source addresses to the same list. Raise severity or correlate with other T1590/T1591/T1593/T1594 reconnaissance rules when the same principal.ip also shows multiple distinct URLs or other reconnaissance. Adjust the URL keyword group if the client's web taxonomy uses different terms for partner or supplier content."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\/(partners?|suppliers?|vendors?|contractors?|resellers?|distributors?|supply-?chain|business-partners?|our-partners|third-party)([\/\?\.\-_#]|$)/ nocase
    $http.network.http.user_agent = /^(curl|wget|python|go-http-client|java|libwww|okhttp|scrapy|aiohttp|httpx|node-fetch|axios|apache-httpclient)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1591.002")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
