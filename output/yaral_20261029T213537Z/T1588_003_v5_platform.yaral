/*
  MITRE Technique : T1588.003 - Code Signing Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:58:28.801161+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_003_Code_Signing_Key_Material_Over_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request crossing the network perimeter whose URL path points to private-key-bearing code signing container files (PKCS#12 / PFX, PVK). Acquisition or movement of stolen signing material is rarely visible directly (Resource Development occurs largely outside the victim). The perimeter-observable residue is internal hosts uploading or downloading these containers to or from external destinations. The rule is OS-agnostic and relies only on perimeter HTTP telemetry."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.003"
    mitre_technique_name = "Obtain Capabilities: Code Signing Certificates"
    log_prerequisites = "Requires firewall or proxy logs with URL visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP with target.url populated. Without URL visibility the rule cannot fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate build or release engineering fetching or publishing signing containers from approved external vendors or cloud key stores; certificate enrollment portals; IT staff transferring certificates to approved SaaS; vulnerability scanners requesting these paths."
    tuning_guidance = "Add approved certificate vendors and key-management domains to %global_allowed_domains. Add authorised scanner sources to %global_allowed_scanners. Consider raising severity when the source is a server segment that does not normally perform builds or signing. Visibility is limited to unencrypted or inspected traffic."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(pfx|p12|pvk)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1588.003")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
