/*
  MITRE Technique : T1615 - Group Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:32:20.855541+00:00
  Reference       : https://attack.mitre.org/techniques/T1615
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1615_Group_Policy_Discovery_Process_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Group Policy discovery on Windows. It fires on gpresult.exe run with a result-reporting switch (/r, /v, /z, /h, /, /scope), on PowerShell calling the Group Policy module cmdlets that enumerate or report on GPOs, and on cmd or PowerShell commands that enumerate the SYSVOL Policies share."
    mitre_tactic = "Discovery"
    mitre_technique = "T1615"
    mitre_technique_name = "Group Policy Discovery"
    log_prerequisites = "Requires Windows process creation telemetry with full command lines from an EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Help desk and sysadmins troubleshooting policy application with gpresult, GPO management or audit scripts run by domain administrators, RMM and compliance tooling that reports on GPOs, and security assessment tools such as AD health checks."
    tuning_guidance = "Add approved admin tooling parents to %global_allowed_admin_tools, named administrators to %global_allowed_admin_users, and authorised assessment sources to %global_allowed_scanners. Add service accounts that run scheduled GPO audits to %global_allowed_service_accounts. Raise severity when the host is a non-admin workstation or the user is a standard account."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\gpresult\.exe$/ nocase and
        $proc.target.process.command_line = /(^|\s)[\/\-](r|v|z|h|x|scope)(\s|$)/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase and
        $proc.target.process.command_line = /\b(Get-GPO|Get-GPOReport|Get-GPResultantSetOfPolicy|Get-GPInheritance|Get-GPPermission|Get-GPPrefRegistryValue|Get-GPStarterGPO)\b/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh)\.exe$/ nocase and
        $proc.target.process.command_line = /\b(dir|ls|gci|get-childitem|findstr|select-string|tree)\b.*\\sysvol\\[^\\\s"']+\\policies/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1615")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
