/*
  MITRE Technique : T1590.005 - IP Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:21:36.871833+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_005_IPS_Inbound_Recon_Sweep_Verdict {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an IPS or network security appliance verdict naming reconnaissance, scanning, sweep, or probe activity from an external source against internal address space. Such activity is how adversaries enumerate which of an organisation's public IP addresses are live and what they host. The rule keys on the detection signature name or summary, not on the allow/block action, because action mapping varies by vendor."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.005"
    mitre_technique_name = "Gather Victim Network Information: IP Addresses"
    log_prerequisites = "IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION, with the signature name or summary mapped to security_result.rule_name or security_result.summary. Perimeter placement is required so that the source IP is the true external address."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and penetration tests, internet-wide research scanners (benign survey crawlers), uptime or monitoring probes, and partner or ISP connectivity checks."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners. If volume is high, add the scanning source to %global_allowed_scanners or narrow the signature regex. Pair with a threshold rule on repeated source IPs if single-verdict alerting is too noisy for the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.rule_name = /(port\s*scan|port\s*sweep|host\s*sweep|ping\s*sweep|network\s*scan|address\s*scan|recon|probe|fingerprint|enumerat)/ nocase or
      $net.security_result.summary = /(port\s*scan|port\s*sweep|host\s*sweep|ping\s*sweep|network\s*scan|address\s*scan|recon|probe|fingerprint|enumerat)/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1590.005")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
