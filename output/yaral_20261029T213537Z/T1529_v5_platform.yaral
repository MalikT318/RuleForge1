/*
  MITRE Technique : T1529 - System Shutdown/Reboot
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:23:23.980358+00:00
  Reference       : https://attack.mitre.org/techniques/T1529
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1529_NetDevice_Unapproved_Mgmt_Plane_Access_Reload_Vector {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter or firewall telemetry shows a connection to a network-device management-plane service (Telnet, SNMP, NETCONF over SSH, or the Smart Install director port) from a source that is not an approved management source. Interactive CLI, SNMP write, or configuration-protocol access is the prerequisite for issuing a remote reload or shutdown of a router, switch, or firewall. A firewall log cannot see the reload command itself, so this rule detects the network-observable precursor to T1529 on network devices."
    mitre_tactic = "Impact"
    mitre_technique = "T1529"
    mitre_technique_name = "System Shutdown/Reboot"
    log_prerequisites = "Firewall or perimeter logs that normalise to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must sit on the path between non-management networks and the device management interfaces."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network engineers working from an unlisted jump host or VPN pool, NMS/SNMP polling platforms not yet in the management-source list, vulnerability scanners, and legacy equipment that still relies on Telnet."
    tuning_guidance = "Add approved jump hosts, NMS pollers, and VPN management pools to %global_allowed_mgmt_sources, and add authorised scanners to %global_allowed_scanners. Scope the log feed to the management VLAN or device interfaces where possible. If SNMP polling is noisy, remove port 161 from the rule for that tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 830 or
      $net.target.port = 4786
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1529")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $mgmt_ports = array_distinct($net.target.port)

  condition:
    $net
}
