/*
  MITRE Technique : T1596.001 - DNS/Passive DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:59:22.211552+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_001_External_DNS_Zone_Transfer_TCP53 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source opening a TCP connection to DNS port 53 on an internal host. TCP/53 is the transport for AXFR/IXFR zone transfers, which adversaries use to enumerate a victim's subdomains, mail servers and hosts during DNS reconnaissance. Normal client lookups use UDP/53."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.001"
    mitre_technique_name = "Search Open Technical Databases: DNS/Passive DNS"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection logs that populate principal.ip, target.port and network.ip_protocol, with inbound traffic to DNS servers inspected."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate secondary or slave DNS servers performing zone transfers, external resolvers retrying over TCP after truncated UDP responses, DNS monitoring or uptime services, and authorised external scanners."
    tuning_guidance = "Add approved secondary DNS and partner source addresses to %global_allowed_mgmt_sources. Add authorised scanning sources to %global_allowed_scanners. Restrict to known authoritative DNS server hosts through client-side parser or log source scoping if resolver TCP fallback is noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    $net.network.ip_protocol = "TCP"
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1596.001")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_dns_hosts = array_distinct($net.target.ip)
    $ids_signature = array_distinct($net.security_result.summary)

  condition:
    $net
}
