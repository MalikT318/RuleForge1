/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:19:07.451333+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Stratum_Mining_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound TCP connections from internal hosts to external destinations on ports conventionally used by Stratum cryptocurrency mining pools. This is a network-side indicator of compute hijacking (cryptomining) that does not depend on the miner binary name, hash or pool domain."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate applications that use the same high ports (remote debugging, Android Debug Bridge on 5555, lab or test tooling, game servers, custom internal-to-partner services), authorised security testing, and sanctioned cryptocurrency research or mining workloads."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved sources to %global_allowed_mgmt_sources. Trim the port list if a client legitimately uses one of these ports (for example 5555 or 4444). Internal destinations are excluded through %rfc1918_internal. Pair with endpoint alerts for high CPU or miner process activity to raise confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    (
      $net.target.port = 3333 or
      $net.target.port = 4444 or
      $net.target.port = 5555 or
      $net.target.port = 7777 or
      $net.target.port = 14433 or
      $net.target.port = 14444 or
      $net.target.port = 45560 or
      $net.target.port = 45700
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
