/*
  MITRE Technique : T1548.004 - Elevated Execution with Prompt
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:33:07.318404+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_004_macOS_Root_LaunchD_Plist_Written_By_UserPath_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a launchd plist created in /Library/LaunchDaemons or /Library/LaunchAgents by a root-owned process whose executable runs from a user-writable location (home directory, /tmp, /var/folders, /Volumes, /Users/Shared). This is the file artifact left when an unsigned or untrusted binary obtains root through a credential prompt (AuthorizationExecuteWithPrivileges) and installs persistence. It does not depend on command-line logging."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.004"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Elevated Execution with Prompt"
    log_prerequisites = "macOS endpoint telemetry that reports file creation events with the creating process path and effective user (root)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party app installers or updaters run from a mounted disk image (/Volumes) or a Downloads folder that legitimately register a helper daemon; MDM or software deployment agents staging from /private/tmp; developers testing launchd services."
    tuning_guidance = "Add approved installer, updater and deployment binaries to %global_allowed_admin_tools. Add EDR or other security agent binaries to %global_allowed_security_tools. If /Volumes installers are common in the environment, remove that path from the creating-process regex or allow-list the specific installer processes."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/Launch(Daemons|Agents)\/[^\/]+\.plist$/ nocase
    $file.principal.user.userid = "root"
    $file.principal.process.file.full_path = /^\/(Users\/[^\/]+\/|Users\/Shared\/|private\/tmp\/|tmp\/|private\/var\/folders\/|var\/folders\/|Volumes\/)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $plist_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
