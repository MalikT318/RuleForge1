/*
  MITRE Technique : T1588.003 - Code Signing Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:57:43.676294+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_003_Code_Signing_Key_Material_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client uploading (POST/PUT) a file whose URL ends in a code-signing or private-key container extension (pfx, p12, pvk, jks, spc) to an external destination. The acquisition of code signing certificates (T1588.003) happens outside the victim's network and cannot be observed directly. This rule covers the observable part: theft or movement of signing material across the perimeter, whether stolen from the client or staged for an adversary."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.003"
    mitre_technique_name = "Obtain Capabilities: Code Signing Certificates"
    log_prerequisites = "Requires proxy or firewall logs with URL inspection (TLS decryption or explicit proxy) that populate network.http.method and target.url. Encrypted traffic without URL visibility will not match."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers or release engineers uploading certificates to a legitimate CA portal, cloud key vault, or CI/CD secrets store. Managed PKI or MDM enrollment flows. Vendor-supplied certificate renewal portals."
    tuning_guidance = "Add approved CA, key-vault and PKI portal domains to %global_allowed_domains. Add build and release automation identities to %global_allowed_service_accounts. Add named PKI administrators to %global_allowed_admin_users. Raise severity for uploads from non-developer subnets or user accounts."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.target.url = /\.(pfx|p12|pvk|jks|spc)(\?.*)?$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1588.003")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $uploaded_urls = array_distinct($net.target.url)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
