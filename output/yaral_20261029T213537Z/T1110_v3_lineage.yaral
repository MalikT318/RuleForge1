/*
  MITRE Technique : T1110 - Brute Force
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:07:11.770187+00:00
  Reference       : https://attack.mitre.org/techniques/T1110
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_Linux_ServiceParent_Spawns_AuthClient {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning an interactive authentication client (ssh, su, sudo, sshpass, ftp, telnet, smbclient, rpcclient, ldapsearch, kinit). Service daemons do not normally launch credential-checking clients. This lineage is consistent with a compromised web or database service being used as a pivot to guess passwords against other accounts or hosts. The rule keys on the parent-child relationship, not command-line content."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110"
    mitre_technique_name = "Brute Force"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH, with parent (principal.process) and child (target.process) executable paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web or application platforms that legitimately shell out to ssh/ftp for deployments or file transfers (Jenkins or Java-based CI agents, Node.js deploy scripts). Database maintenance jobs launched from the DB service that call ssh or smbclient for backup transfers. Monitoring plugins run under a service parent that test su, ssh or LDAP authentication. Kerberos health checks using kinit."
    tuning_guidance = "Add approved parent process paths or automation hosts to %global_allowed_script_hosts. Add sanctioned deployment and monitoring binaries to %global_allowed_admin_tools. Add known service accounts to %global_allowed_service_accounts. If java or node parents are too noisy, narrow the parent regex per client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod)$/ nocase
    $proc.target.process.file.full_path = /\/(su|sudo|ssh|sshpass|ftp|telnet|smbclient|rpcclient|ldapsearch|kinit)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1110")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
