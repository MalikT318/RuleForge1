/*
  MITRE Technique : T1596.005 - Scan Databases
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:06:59.597973+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_005_Inbound_Scan_Recon_Signature_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source triggering an IDS/IPS reconnaissance, scan, probe, or fingerprinting verdict against an internal asset. Internet-wide scan databases are queried on the adversary's side and are not visible to the victim. The observable result is the inbound banner-grabbing and service-enumeration traffic that populates those databases, or that follows a lookup. This rule alerts on that traffic as an early reconnaissance indicator."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.005"
    mitre_technique_name = "Search Open Technical Databases: Scan Databases"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with security_result.summary or security_result.category_details populated from the signature or verdict name. Requires the perimeter or external-facing sensor to see inbound traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and external attack-surface monitoring services, internet-wide research scanners that the customer accepts as background noise, penetration tests, and uptime or health-check probes that match a reconnaissance signature name."
    tuning_guidance = "Add authorised scanner and attack-surface-management source addresses to %global_allowed_scanners. Add approved testing or management sources to %global_allowed_mgmt_sources. Raise severity or add a threshold variant if the volume of known internet background noise is high. Verify that the IPS signature or category naming maps into security_result.summary or security_result.category_details."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.summary = /(scan|probe|recon|fingerprint|banner|enumerat|sweep)/ nocase or
      $net.security_result.category_details = /(scan|probe|recon|fingerprint|banner|enumerat|sweep)/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596.005")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)
    $signature_summary = array_distinct($net.security_result.summary)

  condition:
    $net
}
