/*
  MITRE Technique : T1219.001 - IDE Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:16:35.362775+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_001_IDE_Tunnel_Relay_Web_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound web traffic observed at the proxy or perimeter to the managed relay service used by IDE remote-development tunnels. Adversaries use these relays to build an authenticated, encrypted interactive C2 channel that rides on a trusted developer-service domain. Detection is network-side only and complements endpoint command-line coverage."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.001"
    mitre_technique_name = "Remote Access Tools: IDE Tunneling"
    log_prerequisites = "Requires proxy, secure web gateway, or NGFW logs normalised to NETWORK_HTTP with target.hostname populated. TLS inspection or SNI logging is needed for HTTPS visibility."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers legitimately using IDE remote tunnels or dev-tunnel port forwarding for demos, webhooks testing, or remote work; CI and engineering lab hosts; security awareness or red-team exercises."
    tuning_guidance = "Add approved developer workstations or build hosts to %global_allowed_script_hosts. Add sanctioned relay hostnames to %global_allowed_domains. Review %rfc1918_internal if internal proxies log their own address as the target. Consider raising severity for non-engineering subnets or servers."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /(^|\.)(devtunnels\.ms|tunnels\.api\.visualstudio\.com)$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1219.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $relay_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
