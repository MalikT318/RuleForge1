/*
  MITRE Technique : T1587.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:49:03.981507+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_001_Custom_Implant_IP_Literal_HTTP_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the network-side artefact of adversary-developed implants (T1587.001). An internal client sends an HTTP POST or PUT to an external IP-literal URL with no browser-style User-Agent. This pattern is typical of custom C2 protocols and bespoke backdoors that skip DNS and do not mimic a browser. The rule cannot observe malware development itself, which happens outside the victim's telemetry. It flags the delivered result: homegrown tooling calling out through the perimeter proxy or firewall."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.001"
    mitre_technique_name = "Develop Capabilities: Malware"
    log_prerequisites = "Requires perimeter proxy or firewall logs with HTTP inspection, normalised to UDM NETWORK_HTTP with target.url, network.http.method and network.http.user_agent populated. TLS interception, or a proxy that logs CONNECT URLs, improves coverage of HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate software that talks to IP-literal endpoints (some IoT and OT devices, appliance telemetry, licence or update agents, CLI tools such as curl or wget in admin scripts, internal-facing services behind NAT with public addressing), and authorised penetration tests or red-team exercises."
    tuning_guidance = "Add authorised vulnerability scanners and pentest sources to %global_allowed_scanners. Add known-good vendor destinations to %global_allowed_domains. Tune the User-Agent filter per client if an approved agent uses a non-browser UA and is not covered by those lists. Consider raising severity when the same source host triggers repeatedly."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT)$/ nocase
    $http.target.url = /^([a-z][a-z0-9+.\-]*:\/\/)?[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]{1,5})?(\/|\?|$)/ nocase
    not $http.network.http.user_agent = /(mozilla|chrome|safari|firefox|edge|opera)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1587.001")
    $primary_entity = array_distinct(strings.coalesce($http.principal.hostname, $http.principal.ip))
    $destination_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
