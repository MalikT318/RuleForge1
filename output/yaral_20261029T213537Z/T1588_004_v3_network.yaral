/*
  MITRE Technique : T1588.004 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:59:32.413816+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_004_ACME_Certificate_Request_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests to ACME protocol endpoints (directory, new-nonce, new-account, new-order) seen at the perimeter. This is the network-observable behaviour of automated TLS certificate acquisition. Hosts that are not approved certificate-management systems requesting certificates may indicate an adversary obtaining certificates for C2 or adversary-in-the-middle infrastructure. The rule matches the ACME protocol path structure, not specific certificate authorities or domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.004"
    mitre_technique_name = "Obtain Capabilities: Digital Certificates"
    log_prerequisites = "Requires proxy or firewall logs with URL visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP with target.url populated. Without TLS inspection, HTTPS paths are not visible and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Web servers, load balancers, and reverse proxies using automated certificate clients; DevOps and CI/CD hosts; container platforms with certificate managers; legitimate PKI and IT automation; developers testing ACME clients."
    tuning_guidance = "Add known certificate-management hosts or accounts to %global_allowed_service_accounts, and approved CA or vendor domains to %global_allowed_domains. Consider raising severity for workstation or user-segment sources and lowering it for server segments."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/acme(-v[0-9]+)?\/(directory|new-nonce|new-acct|new-account|new-order|new-authz|newnonce|newaccount|neworder)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1588.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
