/*
  MITRE Technique : T1588.007 - Artificial Intelligence
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:03:42.129556+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_007_LLM_API_Inference_Request_Observed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound HTTP POST to a path used by generative AI / LLM inference APIs (chat-completion, text-completion, embeddings, messages or generateContent style endpoints). The rule keys on the API request structure rather than on provider domains, so it also catches self-hosted gateways, resellers and newly launched providers. Indicates that a host or user is obtaining and using AI tooling, which may support adversary resource development when seen from unapproved sources."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.007"
    mitre_technique_name = "Obtain Capabilities: Artificial Intelligence"
    log_prerequisites = "Requires a forward proxy, secure web gateway or TLS-inspecting perimeter firewall that logs the full request URL and HTTP method, normalised to UDM NETWORK_HTTP. Without TLS inspection the URL path is not visible and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Sanctioned corporate AI assistants and developer tooling, approved SaaS products with embedded LLM features, internal data-science and engineering teams testing LLM APIs, security research and red-team staff, and non-AI REST APIs that reuse similar path names (for example generic /v1/messages or /v1/completions endpoints)."
    tuning_guidance = "Add sanctioned AI service hostnames to %global_allowed_domains. Add approved admin or research accounts to %global_allowed_admin_users. Add authorised testing sources to %global_allowed_scanners. Use as a visibility rule, or raise severity only for sources that are not expected to use AI services (servers, DMZ segments, guest networks). If the firewall log carries only IP addresses, map principal.ip to the hostname in the SOAR enrichment step."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(\/v[0-9]+(beta[0-9]*)?\/(chat\/completions|completions|responses|messages|embeddings)|:(stream)?generatecontent)(\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_admin_users
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1588.007")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)
    $source_users = array_distinct($http.principal.user.userid)

  condition:
    $http
}
