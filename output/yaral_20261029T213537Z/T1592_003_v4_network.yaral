/*
  MITRE Technique : T1592.003 - Firmware
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:39:45.560299+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_003_External_Probe_Of_Firmware_Management_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a connection from an external source to out-of-band and firmware-level management service ports on an internal asset. These are IPMI/RMCP (623, 664) and Intel AMT/ME (16992-16995). These services disclose BMC, AMT and firmware version details to unauthenticated or lightly authenticated queries, so external contact is a network-side sign of firmware reconnaissance (T1592.003). Such ports should never be reachable from the internet, so a permitted or logged connection also indicates exposure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.003"
    mitre_technique_name = "Gather Victim Host Information: Firmware"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip and target.port. Logs must record inbound traffic, including denied or dropped connections, for best coverage."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners or attack-surface-management services, managed service provider or vendor out-of-band support over a VPN or NAT egress, hardware vendor remote support sessions, and cloud or colocation management consoles that legitimately reach BMC/AMT services."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved remote management or provider egress addresses to %global_allowed_mgmt_sources. If the firewall logs post-NAT addresses, confirm principal.ip is the true external source. Raise severity for clients where the destination should be fully isolated from the internet."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 623 or
      $net.target.port = 664 or
      $net.target.port = 16992 or
      $net.target.port = 16993 or
      $net.target.port = 16994 or
      $net.target.port = 16995
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1592.003")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
