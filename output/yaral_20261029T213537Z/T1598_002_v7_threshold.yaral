/*
  MITRE Technique : T1598.002 - Spearphishing Attachment
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:14:47.762874+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_002_Repeated_External_Credential_Form_Posts {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source sends repeated HTTP POST requests to external destinations whose URLs resemble credential or verification forms within 10 minutes. This is consistent with a user submitting information to a fake login portal or to a form delivered by a spearphishing attachment (for example an HTML-smuggled page). A single POST is benign; repeated submissions from one source are not."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.002"
    mitre_technique_name = "Phishing for Information: Spearphishing Attachment"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP with network.http.method, target.url and principal.ip populated. TLS inspection is needed to see the URL and method on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users repeatedly signing in to legitimate SaaS or SSO portals, mistyped passwords and retries, web-based password managers, single-page applications that POST to auth endpoints, and automated health or login checks from internal tooling."
    tuning_guidance = "Add known-good vendor and SSO domains to %global_allowed_domains. Add authorised scanners and test sources to %global_allowed_scanners. Raise the threshold from 5 on tenants with heavy SaaS login traffic. Narrow the URL keyword regex if it is noisy."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(login|logon|signin|sign-in|verify|validate|account|password|credential|secure|webmail|sso)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($http.target.url = /(password|passwd|credential)/ nocase, 70, 45))
    $event_count = count($http.metadata.id)
    $distinct_destinations = count_distinct($http.target.hostname)
    $destination_hosts = array_distinct($http.target.hostname)
    $mitre_technique_id = array_distinct("T1598.002")
    $primary_entity = array_distinct($src)

  condition:
    #http >= 5
}
