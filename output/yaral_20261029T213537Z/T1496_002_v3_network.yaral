/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:19:20.695886+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_Outbound_BitTorrent_Peer_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections from an internal host to external destinations on the well-known BitTorrent peer and tracker ports (6881-6889, 6969). Seeding or participating in torrent swarms from a managed Windows host is a network-side indicator of bandwidth hijacking, where a compromised system's bandwidth is used to seed torrents or for other resource-intensive tasks. Uses firewall telemetry only and does not rely on endpoint process fields."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Resource Hijacking: Bandwidth Hijacking"
    log_prerequisites = "Requires firewall, proxy or perimeter NETWORK_CONNECTION logs with populated principal.hostname, target.ip and target.port for traffic leaving the internal network."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Users running legitimate torrent clients, such as Linux ISO downloads or game and software updaters that use P2P delivery; guest or BYOD networks where torrenting is tolerated; authorised security testing or scanning sources; software distribution that uses peer-to-peer caching."
    tuning_guidance = "Add authorised scanning or testing hosts to %global_allowed_scanners. Populate %rfc1918_internal with the client's internal address space. Where P2P is tolerated on specific segments, scope the rule by network or host group in the SIEM. To reduce volume, convert to a Threshold rule that counts distinct external destination IPs per source host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port >= 6881 and $net.target.port <= 6889) or $net.target.port = 6969
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
