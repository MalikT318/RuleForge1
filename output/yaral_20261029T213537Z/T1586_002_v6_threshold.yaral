/*
  MITRE Technique : T1586.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:44:31.080262+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_002_Mail_Service_Auth_Volume_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens a high volume of connections to mail access and submission ports (IMAP, POP3, SMTP submission) within ten minutes. Each connection is benign on its own, but the volume is consistent with credential stuffing or brute forcing against mailboxes, a common way adversaries compromise email accounts for later phishing or spam use."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.002"
    mitre_technique_name = "Compromise Accounts: Email Accounts"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for inbound traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Third-party mail clients or mobile devices behind a shared NAT that reconnect repeatedly, misconfigured mail clients with stale passwords, authorised vulnerability scanners, uptime monitors, mail migration or sync services, and partner mail relays."
    tuning_guidance = "Add authorised scanners and monitoring sources to %global_allowed_scanners, and known partner or relay addresses to %global_allowed_mgmt_sources. Raise the #net threshold for tenants with large NAT-shared user populations. Narrow the port list to the services the tenant actually exposes."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 143 or
      $net.target.port = 110 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 993 or
      $net.target.port = 995
    )
    $net.principal.ip = $src_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1586.002")
    $primary_entity = array_distinct($src_ip)
    $targeted_mail_hosts = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 25
}
