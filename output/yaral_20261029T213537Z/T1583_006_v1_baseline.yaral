/*
  MITRE Technique : T1583.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:08:57.544735+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_006_External_Web_Service_Account_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a successful HTTP POST to an account sign-up or registration endpoint on an external web service, seen at the perimeter proxy or firewall. This is the network-observable part of registering a web service (code hosting, paste, cloud storage, social, mail) that could later be used for C2, exfiltration or phishing. It cannot see registrations made from adversary-owned infrastructure outside the client network. It covers registration from within the monitored environment, such as a compromised host, an insider or a staging system. Treat it as a low-severity hunting lead that needs context."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.006"
    mitre_technique_name = "Acquire Infrastructure: Web Services"
    log_prerequisites = "Requires perimeter or proxy logs normalised to UDM NETWORK_HTTP with HTTP method, target URL, target hostname and response code populated. TLS inspection is required to see URL paths on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees signing up for legitimate SaaS, vendor portals, webinars or newsletters; marketing and procurement staff; developers creating accounts on approved developer platforms; automated QA or synthetic-transaction testing."
    tuning_guidance = "Add approved vendor and SaaS domains to %global_allowed_domains. Add authorised testing sources to %global_allowed_scanners. Add approved IT and automation accounts to %global_allowed_service_accounts. Raise severity only when the source host is a server or a host with other suspicious activity."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(signup|sign-up|sign_up|register|registration|create-account|create_account|createaccount|join)(\/|\?|$)/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 400
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1583.006")
    $primary_entity = array_distinct(strings.coalesce($http.principal.hostname, $http.principal.ip))
    $registered_service_hosts = array_distinct($http.target.hostname)
    $registration_urls = array_distinct($http.target.url)

  condition:
    $http
}
