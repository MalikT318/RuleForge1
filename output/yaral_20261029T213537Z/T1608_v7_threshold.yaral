/*
  MITRE Technique : T1608 - Stage Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:20:26.230231+00:00
  Reference       : https://attack.mitre.org/techniques/T1608
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_Repeated_External_Payload_Uploads_To_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated HTTP PUT/POST uploads of executable, script or archive-type artifacts from external sources to a single internal web-facing host within 10 minutes. This pattern is consistent with an adversary staging capabilities (payloads, tools, web-delivered resources) on compromised or exposed infrastructure. A single upload is benign; the volume against one host is the signal."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608"
    mitre_technique_name = "Stage Capabilities"
    log_prerequisites = "Requires perimeter proxy, reverse proxy or web gateway logs normalised to UDM NETWORK_HTTP with network.http.method, target.url, target.hostname and principal.ip populated. Plain firewall flow logs without URL visibility cannot evaluate this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate partner or customer file-exchange portals, software vendors publishing build artifacts to an internet-facing repository, CI/CD systems pushing packages, and authorised penetration tests or vulnerability scans."
    tuning_guidance = "Add known external uploaders and testing sources to %global_allowed_scanners, trusted management or partner source addresses to %global_allowed_mgmt_sources, and expected destination domains to %global_allowed_domains. Raise the #net threshold on hosts that legitimately accept file uploads. Review the $distinct_urls and $source_ips outcome values when triaging."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|POST)$/ nocase
    $net.target.url = /\.(exe|dll|msi|ps1|bat|hta|sh|elf|jar|war|iso|zip|7z|rar)(\?|$)/ nocase
    $net.target.hostname = $host
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($net.network.http.response_code = 200, 75, 55))
    $mitre_technique_id = array_distinct("T1608")
    $primary_entity = array_distinct($host)
    $event_count = count($net.metadata.id)
    $source_ips = array_distinct($net.principal.ip)
    $distinct_urls = array_distinct($net.target.url)

  condition:
    #net >= 3
}
