/*
  MITRE Technique : T1584.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:25:49.652338+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_005_Botnet_DGA_Style_DNS_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for long, algorithmically generated looking names. The first label is 16 or more alphanumeric characters and contains a run of 5 or more consecutive consonants, which is typical of domain-generation algorithms used by botnet bots to locate C2 infrastructure. Queries resolving to internal addresses and registered domains in the known-good list are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.005"
    mitre_technique_name = "Compromise Infrastructure: Botnet"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Populating the answer data field improves internal-address filtering."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud storage hostnames with random-looking labels, email security and anti-spam DNSBL lookups, software update and telemetry services, DKIM or domain-verification records, and mDNS or service-discovery names with long identifiers."
    tuning_guidance = "Add known-good registered domains (CDNs, vendors, update services) to %global_allowed_domains. Tune the label length (16) and consonant-run (5) thresholds per environment. Queries that resolve to internal addresses are already excluded through %rfc1918_internal."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)^[a-z0-9]{16,}\.[a-z0-9.-]+$/
    $dns.network.dns.questions.name = /(?i)[bcdfghjklmnpqrstvwxz]{5,}/
    $reg_domain = re.capture($dns.network.dns.questions.name, `(?i)([a-z0-9-]+\.[a-z]{2,})$`)
    not $reg_domain in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.005")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $registered_domain = array_distinct($reg_domain)

  condition:
    $dns
}
