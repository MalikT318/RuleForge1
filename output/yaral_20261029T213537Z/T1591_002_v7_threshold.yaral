/*
  MITRE Technique : T1591.002 - Business Relationships
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:29:33.427639+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_002_Business_Relationship_Page_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Low"
    description = "A single external source makes a high volume of HTTP requests to business-relationship content (partners, suppliers, vendors, customers, resellers, contractors, supply chain, case studies) on victim-owned web assets within 10 minutes. Each request is benign on its own. The volume suggests systematic harvesting of third-party and supply-chain relationships for targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.002"
    mitre_technique_name = "Gather Victim Org Information: Business Relationships"
    log_prerequisites = "Requires IDS/IPS or network security appliance telemetry with HTTP inspection that populates principal.ip and target.url on NETWORK_HTTP events."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, partner-portal users or procurement staff browsing supplier pages, uptime and synthetic monitors, authorised external attack-surface scanners, marketing analytics bots."
    tuning_guidance = "Add authorised scanner and monitor source addresses to %global_allowed_scanners. Raise the #http threshold for high-traffic public sites, or lower it for sites with little legitimate partner-page traffic. Extend the URL keyword regex with client-specific partner section names."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(partners?|suppliers?|vendors?|customers?|clients?|resellers?|distributors?|contractors?|affiliates?|alliances?|supply-?chain|case-?studies|testimonials|investors?|procurement|subsidiar(y|ies))(\/|\.|\?|$)/ nocase
    $http.principal.ip = $src
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1591.002")
    $primary_entity = array_distinct($src)
    $event_count = count($http.metadata.id)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    #http >= 15
}
