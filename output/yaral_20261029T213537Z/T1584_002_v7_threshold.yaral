/*
  MITRE Technique : T1584.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:21:37.445889+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_002_DNS_Long_Label_Query_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host issues a high volume of DNS queries with abnormally long, encoded-looking subdomain labels within ten minutes. A single query is benign, but the volume suggests tunnelling or C2 through attacker-controlled or compromised third-party DNS infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.002"
    mitre_technique_name = "Compromise Infrastructure: DNS Server"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated and a client identifier in principal.hostname."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services with long hashed hostnames, DNS-based security and reputation lookups (DNSBL, AV cloud queries), email authentication lookups (DKIM selectors), software update services, and service discovery."
    tuning_guidance = "Add known-good parent domains to %global_allowed_domains. The exclusion matches the full queried name, so include any high-volume service names that trip the rule. Raise the #dns threshold for noisy environments. If the resolver logs only client IP, normalise that value into principal.hostname or change the grouping field."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^[a-z0-9_\-]{32,}\.[a-z0-9_\-\.]+$/ nocase
    $dns.principal.hostname = $host
    not $dns.network.dns.questions.name in %global_allowed_domains

  match:
    $host over 10m

  outcome:
    $event_count = count($dns.metadata.id)
    $risk_score = max(if($event_count >= 50, 85, 60))
    $mitre_technique_id = array_distinct("T1584.002")
    $primary_entity = array_distinct($host)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    #dns >= 15
}
