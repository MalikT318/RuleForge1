/*
  MITRE Technique : T1567.004 - Exfiltration Over Webhook
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:49:39.834826+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_004_Webhook_Exfil_Proxy_HTTP_Post {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP POST/PUT requests whose URL path matches the structure of chat and automation webhook endpoints (long opaque token segments under /webhooks/ or /services/T../B../ paths). Observed at the network perimeter, this indicates data being pushed to an external webhook, a common exfiltration channel that blends into HTTPS traffic. Matching is on URL path structure, not on specific domains, so renamed tools and new webhook hosts are still covered."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.004"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration Over Webhook"
    log_prerequisites = "Proxy or firewall logs with URL visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP with network.http.method and target.url populated. Without TLS inspection the URL path is not visible and this rule will not fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate chat or ticketing integrations (CI/CD notifications, monitoring alerts, helpdesk bots) posting to team webhooks; business automation flows; developers testing webhooks."
    tuning_guidance = "Add sanctioned webhook destination hostnames to %global_allowed_domains. Add known automation or monitoring hosts to %global_allowed_service_accounts if user identity is populated. Raise severity for workstation sources not in a server or automation segment."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT)$/ nocase
    $http.target.url = /\/api\/(v\d+\/)?webhooks\/\d{15,20}\/[A-Za-z0-9_-]{40,}|\/services\/T[A-Z0-9]{8,}\/B[A-Z0-9]{8,}\/[A-Za-z0-9]{20,}|\/webhookb2\/[0-9a-f-]{30,}@[0-9a-f-]{30,}\/IncomingWebhook\/[0-9a-f]{20,}\/[0-9a-f-]{30,}/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567.004")
    $primary_entity = array_distinct($http.principal.ip)
    $source_hostnames = array_distinct($http.principal.hostname)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)
    $max_sent_bytes = max($http.network.sent_bytes)

  condition:
    $http
}
