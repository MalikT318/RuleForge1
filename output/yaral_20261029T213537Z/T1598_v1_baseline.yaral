/*
  MITRE Technique : T1598 - Phishing for Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:09:09.453805+00:00
  Reference       : https://attack.mitre.org/techniques/T1598
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_Credential_Harvest_Form_Post_Suspicious_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal client submitting an HTTP POST to a credential-style URL (login, signin, verify, password and similar) on an external host that is an IP literal, a punycode hostname, or a URL with embedded userinfo. These host patterns are typical of phishing-for-information landing pages that harvest credentials, and are rare for legitimate authentication endpoints."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598"
    mitre_technique_name = "Phishing for Information"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection (TLS inspection for HTTPS) that populate network.http.method and target.url."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal or lab login portals reached by IP, appliance and device admin consoles on external addresses, legitimate internationalised (punycode) domains, and vendor SSO portals that use userinfo-style URLs."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Add scanner or test-harness hosts to %global_allowed_scanners. If the volume of IP-literal hits is high, remove the IP-literal alternative from the first target.url regex and keep the punycode and userinfo checks."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /^https?:\/\/((\d{1,3}\.){3}\d{1,3}|[^\/?#]*xn--[^\/?#]*|[^\/?#]*@)/ nocase
    $http.target.url = /(login|log-in|logon|signin|sign-in|verify|validate|account|password|passwd|credential|webmail|secure|auth)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1598")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_url = array_distinct($http.target.url)
    $destination_ip = array_distinct($http.target.ip)
    $source_user = array_distinct($http.principal.user.userid)

  condition:
    $http
}
