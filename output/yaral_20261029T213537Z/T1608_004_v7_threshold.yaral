/*
  MITRE Technique : T1608.004 - Drive-by Target
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:28:04.935822+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_004_Repeated_Web_Content_Upload_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source sends many write-type HTTP requests (PUT/POST/PATCH) targeting script or web-page content paths within ten minutes. This can indicate staging or injection of drive-by content, such as malicious JavaScript or HTML, on a web property. Each request is benign on its own; the volume from one source is the signal."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.004"
    mitre_technique_name = "Stage Capabilities: Drive-by Target"
    log_prerequisites = "Requires perimeter proxy, web gateway or firewall logs with HTTP inspection that populate network.http.method and target.url for traffic to client-hosted web servers."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "CMS editors and web developers publishing content, CI/CD pipelines deploying to web servers, SaaS integrations calling upload APIs, authorised penetration tests, and web application scanners."
    tuning_guidance = "Add trusted publishing or deployment sources to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. Raise the #http threshold for busy CMS or API front ends. Known-good publishing hostnames can be added to %global_allowed_domains."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(PUT|POST|PATCH)$/ nocase
    $http.target.url = /\.(js|mjs|html?|php|aspx?|jsp|jspx)(\?|#|$)/ nocase
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1608.004")
    $primary_entity = array_distinct($src_ip)
    $target_hosts = array_distinct($http.target.hostname)
    $target_urls = array_distinct($http.target.url)

  condition:
    #http >= 10
}
