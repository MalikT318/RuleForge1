/*
  MITRE Technique : T1590.001 - Domain Properties
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:14:06.706316+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_001_External_Domain_Property_Endpoint_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting identity and domain-discovery endpoints (realm lookup, federation metadata, OpenID configuration, autodiscover) on a web service, using network-side HTTP telemetry. These endpoints return domain properties such as federation status, namespace type and mail routing, which adversaries collect during pre-compromise reconnaissance. Known mail-client user agents and approved scanners are excluded."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.001"
    mitre_technique_name = "Gather Victim Network Information: Domain Properties"
    log_prerequisites = "IPS or network security appliance logs with HTTP/URL inspection (decrypted or reverse-proxy visibility) mapped to NETWORK_HTTP, with principal.ip, target.url and network.http.user_agent populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate mail clients and mobile devices using autodiscover with unusual user agents; federated-identity partners and SaaS integrations fetching federation or OpenID metadata; external vulnerability scanners or attack-surface-management services not yet in the allowlist; uptime monitors."
    tuning_guidance = "Add authorised scanner and ASM source IPs to %global_allowed_scanners. Extend the user-agent exclusion for client software common in your environment. If autodiscover noise is high, raise severity only when combined with other recon from the same source IP. Consider a threshold variant per source IP for distinct-endpoint counts."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/autodiscover\/autodiscover\.(xml|json)|\/getuserrealm\.srf|\/common\/userrealm|\/\.well-known\/openid-configuration|\/federationmetadata\/[0-9\-]+\/federationmetadata\.xml)/ nocase
    not $http.network.http.user_agent = /(outlook|msoffice|microsoft office|activesync|msrpc|exchangeservicesclient)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1590.001")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
