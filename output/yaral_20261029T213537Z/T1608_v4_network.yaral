/*
  MITRE Technique : T1608 - Stage Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:19:32.270461+00:00
  Reference       : https://attack.mitre.org/techniques/T1608
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_Raw_IP_Payload_Download_Via_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client issuing an HTTP GET through the perimeter to an external server addressed by raw IP for an executable, script, installer, disk image or archive payload. Capabilities staged on adversary-controlled infrastructure are commonly served this way, without a domain name, to avoid DNS-based reputation controls. This is the network-side view of the staged capability being retrieved."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608"
    mitre_technique_name = "Stage Capabilities"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP with network.http.method, target.url and target.ip populated. TLS-inspected or cleartext HTTP traffic is required for the full URL to be visible."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Vendor or appliance firmware and update downloads served from bare IPs, internal software distribution on public address space, developers or admins fetching tooling from lab or test servers, CDN edge nodes addressed by IP, and authorised red-team or scanner activity."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains (matched on target.hostname). Make sure %rfc1918_internal covers the client's internal address space. For clients with legitimate public-IP software distribution, extend %global_allowed_domains with those hostnames. Narrow or extend the file-extension list in the regex to suit the client's risk appetite."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?\/[^?#]*\.(exe|dll|msi|ps1|psm1|bat|cmd|vbs|vbe|js|jse|hta|scr|jar|lnk|iso|img|zip|7z|rar|gz|elf|sh|bin)([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1608")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
