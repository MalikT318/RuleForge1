/*
  MITRE Technique : T1590.003 - Network Trust Dependencies
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:17:16.659867+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_003_Trust_Service_Probe_Then_Federation_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an external source that probes trust-related network services (IKE/IPsec VPN, PPTP, BGP, LDAP, Kerberos) and then, within ten minutes, requests federation, SAML or OpenID metadata endpoints. This combination suggests reconnaissance of third-party and partner trust dependencies before a trusted-relationship attack."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.003"
    mitre_technique_name = "Gather Victim Network Information: Network Trust Dependencies"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION (with principal.ip, target.port) and NETWORK_HTTP (with target.url) events for traffic arriving from external sources."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, partner or MSP federation onboarding, SaaS and SSO clients that fetch federation metadata automatically, and legitimate site-to-site VPN peers that also use federated sign-in."
    tuning_guidance = "Add authorised scanner and attack-surface-management source IPs to %global_allowed_scanners. Add partner or MSP management source addresses to %global_allowed_mgmt_sources. Adjust the trust-related port list and the metadata URL pattern to match the services each client exposes."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
      $conn.target.port = 500 or
      $conn.target.port = 4500 or
      $conn.target.port = 1723 or
      $conn.target.port = 179 or
      $conn.target.port = 389 or
      $conn.target.port = 636 or
      $conn.target.port = 3268 or
      $conn.target.port = 88
    )
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    $conn.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/\.well-known\/openid-configuration|\/federationmetadata\/|\/adfs\/ls|\/adfs\/services\/trust|\/saml2?\/metadata|\/idp\/shibboleth|\/autodiscover\/autodiscover\.xml)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1590.003")
    $primary_entity = array_distinct($src_ip)
    $probed_ports = array_distinct($conn.target.port)
    $probed_targets = array_distinct($conn.target.ip)
    $metadata_urls = array_distinct($http.target.url)
    $probe_count = count($conn.metadata.id)

  condition:
    $conn and $http
}
