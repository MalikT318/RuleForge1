/*
  MITRE Technique : T1598.002 - Spearphishing Attachment
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:13:33.680565+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_002_Office_Client_External_Template_Or_Auth_Challenge {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office-family HTTP client requesting a document or template file from an external destination, or receiving an HTTP 401 authentication challenge from one. This is the network-side signature of a spearphishing attachment that uses remote template injection or a credential-prompt lure to harvest credentials. It is observed at the perimeter without any endpoint process data."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.002"
    mitre_technique_name = "Phishing for Information: Spearphishing Attachment"
    log_prerequisites = "Requires proxy or perimeter logs that populate the HTTP user agent, target URL, and response code, normalised to NETWORK_HTTP. TLS-inspected or cleartext traffic is needed for the user agent and URL to be visible."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users opening documents from external SharePoint, OneDrive, or partner portals that require authentication; legitimate external template or add-in repositories; Office clients on third-party collaboration platforms; B2B document exchange with partners that use HTTP auth."
    tuning_guidance = "Add known-good external document and collaboration domains to %global_allowed_domains. If one source generates repeated benign hits, such as a proxy or egress gateway, review its address range first. The 401 branch is the noisiest; remove it if the client's partners use HTTP basic auth heavily."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /(microsoft office|ms-office|office\/\d|\bword\/\d|winword|excel\/\d|powerpoint\/\d)/ nocase
    (
      $http.target.url = /\.(docm|docx|dotm|dotx|dot|doc|xlsm|xlsx|xls)(\?|#|$)/ nocase or
      $http.network.http.response_code = 401
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1598.002")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
