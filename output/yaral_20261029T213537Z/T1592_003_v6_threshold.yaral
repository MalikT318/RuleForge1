/*
  MITRE Technique : T1592.003 - Firmware
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:40:19.215804+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_003_External_Firmware_Mgmt_Port_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source makes repeated connections to out-of-band and firmware-level management service ports (IPMI/RMCP and Intel AMT/vPro) within ten minutes. These services expose BMC and firmware version information to unauthenticated probes. Individual connections are low-signal, but sustained volume from one source indicates reconnaissance of host firmware."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.003"
    mitre_technique_name = "Gather Victim Host Information: Firmware"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. Logs must include inbound traffic from external sources."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, managed service provider out-of-band administration over the internet, data-centre or hosting providers' remote management from unlisted source addresses, internet-wide research scanners hitting exposed management ports."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners and approved administrative source addresses to %global_allowed_mgmt_sources. Raise the #net threshold for internet-facing environments with high background scan noise. Consider blocking these ports at the perimeter, as exposure to the internet is itself a finding."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 623 or
      $net.target.port = 664 or
      $net.target.port = 16992 or
      $net.target.port = 16993 or
      $net.target.port = 16994 or
      $net.target.port = 16995
    )
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 623, 70, 60))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1592.003")
    $primary_entity = array_distinct($src)
    $targeted_hosts = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
