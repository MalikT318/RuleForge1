/*
  MITRE Technique : T1583 - Acquire Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:58:18.925218+00:00
  Reference       : https://attack.mitre.org/techniques/T1583
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_Burst_Long_Label_DNS_Queries {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host issues a burst of DNS queries for names containing very long, machine-generated-looking labels within ten minutes. This pattern is typical of algorithmically generated domains, freshly acquired attacker infrastructure, and DNS tunnelling or C2 beacons. A single such query is benign, but sustained volume from one host is not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583"
    mitre_technique_name = "Acquire Infrastructure"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and principal.hostname populated. If the resolver logs only client IPs, map the client to principal.hostname through asset enrichment."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services that use long hashed hostnames, email security and anti-spam DNS lookups (DNSBL, DKIM, SPF macros), software update and telemetry services, content-addressed storage endpoints, browser safe-browsing lookups, and DNS-based service discovery."
    tuning_guidance = "Add known-good domains to %global_allowed_domains. The list is matched against the full queried name, so include the FQDNs of noisy CDN and vendor hosts. Raise the #dns threshold or the label length (currently 30 or more characters) in noisy environments, or lower the threshold for high-security segments. Scale response through $risk_score and the distinct query count in $queried_names."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9\-]{30,}\./ nocase
    not $dns.network.dns.questions.name = /\.(arpa|local)$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    $dns.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($dns.metadata.id)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $mitre_technique_id = array_distinct("T1583")
    $primary_entity = array_distinct($host)

  condition:
    #dns >= 10
}
