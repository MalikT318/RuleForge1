/*
  MITRE Technique : T1596.002 - WHOIS
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:01:51.660629+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_002_WHOIS_Lookup_Followed_By_External_Service_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a source making an outbound WHOIS (TCP/43) connection to an external server, then within ten minutes opening external connections to common remotely exposed service ports. This pattern matches registry reconnaissance followed by active probing of discovered infrastructure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.002"
    mitre_technique_name = "Search Open Technical Databases: WHOIS"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The appliance must see egress traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Network administrators or security analysts running WHOIS lookups and then connecting to remote services, domain and abuse-desk tooling, authorised external attack-surface scanners, and mail or anti-spam systems that query WHOIS and then connect to SSH or RDP."
    tuning_guidance = "Add authorised scanner and analyst source addresses to %global_allowed_scanners. Raise the follow-on port list or add a count threshold on distinct destinations in the condition if the rule is noisy. Egress filtering that blocks TCP/43 reduces visibility, so confirm that the appliance logs blocked attempts."

  events:
    $whois.metadata.event_type = "NETWORK_CONNECTION"
    $whois.target.port = 43
    not $whois.target.ip in %rfc1918_internal
    not $whois.principal.ip in %global_allowed_scanners
    $whois.principal.ip = $src_ip

    $probe.metadata.event_type = "NETWORK_CONNECTION"
    (
      $probe.target.port = 22 or
      $probe.target.port = 23 or
      $probe.target.port = 445 or
      $probe.target.port = 1433 or
      $probe.target.port = 3306 or
      $probe.target.port = 3389 or
      $probe.target.port = 5900
    )
    not $probe.target.ip in %rfc1918_internal
    not $probe.principal.ip in %global_allowed_scanners
    $probe.principal.ip = $src_ip

    $whois.metadata.event_timestamp.seconds <= $probe.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1596.002")
    $primary_entity = array_distinct($src_ip)
    $whois_destinations = array_distinct($whois.target.ip)
    $probed_destinations = array_distinct($probe.target.ip)
    $probed_ports = array_distinct($probe.target.port)
    $probe_count = count($probe.metadata.id)

  condition:
    $whois and $probe
}
