/*
  MITRE Technique : T1595 - Active Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:50:24.700218+00:00
  Reference       : https://attack.mitre.org/techniques/T1595
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_External_Port_Probe_Then_Web_Error_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an external source that opens many connections to commonly probed service ports and then generates HTTP error responses (4xx/5xx) against perimeter web services within 10 minutes. This pattern is typical of active scanning: port discovery followed by web service fingerprinting or content enumeration."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595"
    mitre_technique_name = "Active Scanning"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION (with principal.ip, target.ip, target.port) and NETWORK_HTTP (with network.http.response_code)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests not yet allowlisted, internet-wide research scanners, uptime and monitoring services, search engine crawlers hitting stale URLs, partners with misconfigured integrations."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and trusted management or partner sources to %global_allowed_mgmt_sources. Raise the #scan threshold on internet-facing segments with heavy legitimate traffic. Adjust the monitored port list to the client's exposed services."

  events:
    $scan.metadata.event_type = "NETWORK_CONNECTION"
    $scan.principal.ip = $src_ip
    not $scan.principal.ip in %rfc1918_internal
    not $scan.principal.ip in %global_allowed_scanners
    not $scan.principal.ip in %global_allowed_mgmt_sources
    (
      $scan.target.port = 21 or
      $scan.target.port = 22 or
      $scan.target.port = 23 or
      $scan.target.port = 25 or
      $scan.target.port = 445 or
      $scan.target.port = 1433 or
      $scan.target.port = 3306 or
      $scan.target.port = 3389 or
      $scan.target.port = 5900 or
      $scan.target.port = 8080
    )

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.network.http.response_code >= 400

    $scan.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1595")
    $primary_entity = array_distinct($src_ip)
    $probed_ports = array_distinct($scan.target.port)
    $probed_targets = array_distinct($scan.target.ip)
    $http_error_codes = array_distinct($http.network.http.response_code)
    $connection_count = count($scan.metadata.id)
    $http_error_count = count($http.metadata.id)

  condition:
    #scan >= 10 and #http >= 3
}
