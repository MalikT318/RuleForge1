/*
  MITRE Technique : T1587.003 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:51:30.824979+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_003_Self_Signed_TLS_Cert_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host completing a TLS connection to an external destination whose server certificate is self-signed (issuer equals subject). Adversary-created self-signed certificates are commonly used on C2 and staging infrastructure. This is network-observable pre-compromise and C2 infrastructure telemetry, which is additive to any process-creation coverage."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.003"
    mitre_technique_name = "Develop Capabilities: Digital Certificates"
    log_prerequisites = "Requires perimeter telemetry that records TLS server certificate issuer and subject in UDM (network.tls.server.certificate.*), such as a firewall or proxy with TLS inspection or certificate logging. The rule does not fire if these fields are not populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Self-signed certificates on legitimate external appliances, SaaS or vendor management portals, IoT and OT devices, small-business VPN gateways, and developer or test servers that are reachable externally."
    tuning_guidance = "Add known-good external domains (matched on the TLS SNI) to %global_allowed_domains. If one source is noisy, such as a sanctioned external scanning host, pair the exclusion with %global_allowed_scanners on principal.ip. Raise severity when the destination is also rare or newly observed in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.tls.server.certificate.subject != ""
    $net.network.tls.server.certificate.issuer = $net.network.tls.server.certificate.subject
    not $net.target.ip in %rfc1918_internal
    not $net.network.tls.client.server_name in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1587.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $cert_subjects = array_distinct($net.network.tls.server.certificate.subject)
    $tls_sni = array_distinct($net.network.tls.client.server_name)

  condition:
    $net
}
