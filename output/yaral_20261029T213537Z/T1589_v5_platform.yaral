/*
  MITRE Technique : T1589 - Gather Victim Identity Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:05:45.192903+00:00
  Reference       : https://attack.mitre.org/techniques/T1589
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_External_Username_Enumeration_Endpoint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting HTTP endpoints whose purpose is to reveal whether a username, account or email address exists (identity-provider realm and credential lookups, CMS user-listing and author-ID enumeration, and application 'user exists' or 'availability' APIs). Adversaries probe these endpoints to build valid-identity lists before password spraying or phishing. Complements existing endpoint command-line coverage by working from perimeter HTTP telemetry on the pre-compromise side."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589"
    mitre_technique_name = "Gather Victim Identity Information"
    log_prerequisites = "Requires perimeter proxy, reverse-proxy or WAF logs normalised to NETWORK_HTTP with principal.ip and target.url populated. TLS inspection or termination at the perimeter is needed to see the URL path."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Self-service sign-up forms that call a username or email availability API, SSO login flows that call realm discovery, public CMS sites that expose the user API for legitimate integrations, authorised penetration tests and external attack-surface scanners."
    tuning_guidance = "Add authorised external scanners and pen-test sources to %global_allowed_scanners. Add known-good partner or integration source addresses to %global_allowed_mgmt_sources. Add benign hostnames to %global_allowed_domains. Raise severity or pair this rule with a threshold rule that counts distinct probes per source IP."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/getcredentialtype|\/common\/userrealm|\/wp-json\/wp\/v2\/users|[?&]author=\d+|\/api\/[^?\s]*(user|account|email|username)[^?\s]*(exist|lookup|validate|available|check))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1589")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $probed_url = array_distinct($http.target.url)

  condition:
    $http
}
