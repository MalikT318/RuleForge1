/*
  MITRE Technique : T1110 - Brute Force
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:07:30.556351+00:00
  Reference       : https://attack.mitre.org/techniques/T1110
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_IdP_Network_Failed_Auth_Endpoint_Scripted_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a failed HTTP authentication response (4xx) on an identity provider sign-in or token endpoint, requested by a scripted HTTP client from an external source address. Interactive users sign in through browsers, so scripted clients repeatedly hitting credential-validation endpoints are characteristic of password guessing or spraying. Alerts from the same source IP should be aggregated downstream to reveal volume."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110"
    mitre_technique_name = "Brute Force"
    log_prerequisites = "Requires NETWORK_HTTP telemetry from the identity provider front end, reverse proxy, WAF or CDN, populating target.url, network.http.user_agent, network.http.response_code and principal.ip."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Approved vulnerability scanners and penetration tests, legitimate automation or sync clients with expired credentials, monitoring probes against sign-in endpoints, mobile or desktop apps using HTTP libraries that fail after a password change."
    tuning_guidance = "Add approved scanner and test sources to %global_allowed_scanners and approved management or automation source addresses to %global_allowed_mgmt_sources. Extend the user-agent regex with client libraries seen in your environment's legitimate automation. Aggregate alerts per principal.ip downstream to prioritise high-volume sources."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(oauth2(\/v[0-9.]+)?\/token|api\/v1\/authn|adfs\/oauth2\/token|adfs\/services\/trust\/2005\/usernamemixed|login\/(login|authenticate)|signin)/ nocase
    $http.network.http.response_code >= 400
    $http.network.http.response_code <= 403
    $http.network.http.user_agent = /(curl|wget|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|okhttp|java\/[0-9]|apache-httpclient|node-fetch|axios|powershell|httpclient)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1110")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_url = array_distinct($http.target.url)
    $client_user_agent = array_distinct($http.network.http.user_agent)
    $response_codes = array_distinct($http.network.http.response_code)
    $targeted_user = array_distinct($http.target.user.userid)

  condition:
    $http
}
