/*
  MITRE Technique : T1593 - Search Open Websites/Domains
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:42:43.207523+00:00
  Reference       : https://attack.mitre.org/techniques/T1593
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_Outbound_Search_Engine_Dorking_Operators {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects outbound HTTP requests whose query string uses advanced search operators (inurl, intitle, intext, filetype and similar) that are characteristic of search-engine 'Google hacking' reconnaissance. This is the network-side view of an internal host or user searching open websites for information about a target. Visibility is limited to traffic the IPS can see (cleartext, or TLS-inspected traffic with URL logging). Domains are deliberately not hardcoded, so the rule matches the query-string behaviour rather than any specific search provider."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593"
    mitre_technique_name = "Search Open Websites/Domains"
    log_prerequisites = "IPS or network security appliance logs normalised to NETWORK_HTTP with target.url populated. Requires TLS inspection, or a proxy-integrated sensor, to see URLs of HTTPS traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security researchers and red teams doing authorised OSINT, SEO and marketing staff running operator searches, developers and sysadmins using filetype or inurl searches for documentation, threat intelligence analysts, and approved vulnerability scanners or OSINT tooling."
    tuning_guidance = "Add authorised OSINT, red-team and scanner source hostnames to %global_allowed_scanners. Add trusted search or documentation domains to %global_allowed_domains. If the rule is noisy, restrict the sensor scope to user and server egress segments only. Query parameter names in the regex (q, query, p, text, wd) can be extended for regional search providers."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /[?&](q|query|p|text|wd)=([^&]*(\+|%20|%22))?(inurl|allinurl|intitle|allintitle|intext|allintext|filetype|inanchor)(:|%3a)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.hostname in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1593")
    $primary_entity = array_distinct($http.principal.hostname)
    $search_urls = array_distinct($http.target.url)
    $destination_hosts = array_distinct($http.target.hostname)
    $source_users = array_distinct($http.principal.user.userid)

  condition:
    $http
}
