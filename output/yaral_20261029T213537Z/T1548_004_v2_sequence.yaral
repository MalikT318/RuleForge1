/*
  MITRE Technique : T1548.004 - Elevated Execution with Prompt
  Tactic(s)       : Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:33:25.866322+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_004_AuthTrampoline_From_UserWritable_Then_Persistence_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the macOS authorization trampoline (the helper used by AuthorizationExecuteWithPrivileges to run a program as root after a credential prompt) launched by a binary from a user-writable location (home directory, /tmp, mounted DMG volume, per-user temp folder), followed within 10 minutes on the same host by creation of a launchd plist or a binary in a system persistence or executable path. This links the privilege prompt to the privileged persistence it enabled."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.004"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Elevated Execution with Prompt"
    log_prerequisites = "macOS endpoint telemetry with process launch events (including parent process path) and file creation events with the creating process path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party application installers or updaters run from a downloaded DMG or the Downloads folder that legitimately request admin rights and install a launch daemon or helper tool; developer builds that install privileged helpers; IT onboarding scripts."
    tuning_guidance = "Add approved deployment or installer tooling to %global_allowed_admin_tools (applies to the parent of the trampoline and to the process creating the persistence file). Add endpoint security agents to %global_allowed_security_tools. Narrow the user-writable parent path regex or the persistence path regex per client if needed."

  events:
    $auth.metadata.event_type = "PROCESS_LAUNCH"
    $auth.target.process.file.full_path = /\/security_authtrampoline$/ nocase
    $auth.principal.process.file.full_path = /^\/(Users\/[^\/]+\/|private\/tmp\/|tmp\/|Volumes\/|private\/var\/folders\/)/ nocase
    not $auth.principal.process.file.full_path in %global_allowed_admin_tools
    not $auth.principal.process.file.full_path in %global_allowed_security_tools
    $auth.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/(LaunchDaemons|LaunchAgents)\/[^\/]+\.plist$|^\/Users\/[^\/]+\/Library\/LaunchAgents\/[^\/]+\.plist$|^\/Library\/PrivilegedHelperTools\/[^\/]+$|^\/usr\/local\/bin\/[^\/]+$/ nocase
    not $file.principal.process.file.full_path = /\/(installer|system_installd|softwareupdated|mdmclient|storedownloadd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $auth.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.004")
    $primary_entity = array_distinct($hostname)
    $calling_processes = array_distinct($auth.principal.process.file.full_path)
    $prompting_users = array_distinct($auth.principal.user.userid)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $auth_event_count = count($auth.metadata.id)
    $file_event_count = count($file.metadata.id)

  condition:
    $auth and $file
}
