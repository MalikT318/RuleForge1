/*
  MITRE Technique : T1615 - Group Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:33:13.458967+00:00
  Reference       : https://attack.mitre.org/techniques/T1615
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1615_Rapid_Group_Policy_Discovery_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated Group Policy discovery activity on a single host within 10 minutes. Matches gpresult reporting switches, the GroupPolicy PowerShell module cmdlets (Get-GPO, Get-GPOReport, Get-GPInheritance, Get-GPPermission, Get-GPResultantSetOfPolicy), LDAP queries for groupPolicyContainer objects, and command lines that reference SYSVOL Policies paths. One such command is routine administration, but several in a short window suggest an adversary enumerating GPOs to plan privilege escalation or policy manipulation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1615"
    mitre_technique_name = "Group Policy Discovery"
    log_prerequisites = "Requires EDR or Sysmon process creation telemetry with full command lines (Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing) normalised to UDM PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Helpdesk and sysadmin troubleshooting with gpresult, GPO audit and backup scripts using the GroupPolicy module, RMM and compliance agents that collect resultant set of policy, and configuration-baseline assessment tools."
    tuning_guidance = "Add approved admin and RMM parent processes to %global_allowed_admin_tools, approved admin accounts to %global_allowed_admin_users, and security agents to %global_allowed_security_tools. Raise the #proc threshold in condition for noisy environments, or lower it for high-value servers such as domain controllers and jump hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\bgpresult(\.exe)?["']?\s+.*[\/-](r|v|z|h|x|scope)\b|\bGet-GP(O|Inheritance|Permission|ResultantSetOfPolicy)|grouppolicycontainer|\\sysvol\\[^\\\s]+\\policies)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1615")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 4
}
