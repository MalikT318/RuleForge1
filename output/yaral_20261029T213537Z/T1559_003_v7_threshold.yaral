/*
  MITRE Technique : T1559.003 - XPC Services
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:44:51.967474+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_003_XPC_Helper_Repeated_Interpreter_Spawn {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a privileged helper tool or XPC service bundle binary repeatedly spawning shells or scripting interpreters on one macOS host within 10 minutes. A single spawn can be routine helper behaviour, but a burst of child interpreters suggests malicious content is being fed through an XPC handler to reach code execution, often as root."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.003"
    mitre_technique_name = "Inter-Process Communication: XPC Services"
    log_prerequisites = "Requires macOS endpoint process telemetry (EDR or unified log) that populates the parent process path and child process path for PROCESS_LAUNCH events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party installers and updaters whose privileged helper runs shell scripts, VPN and network agents, MDM and software deployment helpers, disk utilities, and developer tooling with bundled XPC services that invoke scripts."
    tuning_guidance = "Add approved helper binaries or parent paths to %global_allowed_admin_tools, EDR and security agent helpers to %global_allowed_security_tools, and approved management agents to %global_allowed_remote_mgmt. Raise the #proc threshold on hosts with heavy installer or developer activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(\/Library\/PrivilegedHelperTools\/|\.xpc\/Contents\/MacOS\/)/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|zsh|dash|ksh|osascript|python[0-9.]*|perl|ruby|curl)$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.file.full_path, /(?i)\/(osascript|python[0-9.]*|perl|ruby|curl)$/), 80, 60))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1559.003")
    $primary_entity = array_distinct($host)
    $parent_helpers = array_distinct($proc.principal.process.file.full_path)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 5
}
