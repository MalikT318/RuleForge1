/*
  MITRE Technique : T1497.002 - User Activity Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:20:25.039428+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_002_ScriptHost_External_IP_Geo_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a script interpreter (WScript, CScript, MSHTA, PowerShell) making an outbound HTTP request to an external host whose URL path matches a public IP, geolocation or environment-lookup pattern. Malware uses these lookups for sandbox and analysis-environment awareness before it decides whether to run its payload. Detection is based on the process making the request and the request path, not on specific lookup services or domains."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.002"
    mitre_technique_name = "Virtualization/Sandbox Evasion: User Activity Based Checks"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network telemetry that populates the initiating process path and the full URL for HTTP requests. Web proxy or TLS-inspection logs are needed to see URL paths on HTTPS."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or inventory scripts that look up the public IP address, PowerShell modules that check geolocation or licensing, software installers using script hosts, and developers testing APIs."
    tuning_guidance = "Add approved script parents and automation binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. Add known-good lookup or vendor domains to %global_allowed_domains. If HTTPS paths are not visible, pair this rule with the endpoint-side variants for this technique. Tighten the process regex or the path pattern per client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\\(wscript|cscript|mshta|powershell|pwsh)\.exe$/ nocase
    $net.target.url = /\/(json|ip|myip|checkip|geoip|geo|country|location|whoami)([\/?#]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1497.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $requested_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
