/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:21:21.046062+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_ESXi_Remote_Software_Inventory_Via_Management_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external, non-allow-listed source querying the ESXi management HTTP interface (hostd Managed Object Browser) for installed software, image profile, VIB or patch-manager data. This is a network-side view of software discovery against the hypervisor. Attackers use it to learn the ESXi build and installed packages, and to see which security or agent VIBs are present, before choosing follow-on actions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "Requires ESXi management-plane HTTP telemetry (hostd/rhttpproxy request logging, or a network sensor or proxy decoding traffic to the ESXi management port) normalised to NETWORK_HTTP with principal.ip and target.url populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Patch and lifecycle management servers, monitoring or CMDB discovery tools, inventory platforms and vulnerability scanners that poll host software and version data. Administrators browsing the MOB from a jump host or VPN pool whose addresses are not yet in the allow-lists."
    tuning_guidance = "Add approved patching, inventory and monitoring source addresses to %global_allowed_mgmt_sources and approved scanner sources to %global_allowed_scanners. This rule is scoped to non-internal sources through %rfc1918_internal, which suits ESXi hosts that should never be reachable from outside. To cover internal sources, remove the %rfc1918_internal exclusion and rely on %global_allowed_mgmt_sources. Expect higher volume if you do."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/mob\/?(\?|$|.*)/ nocase
    $http.target.url = /(imageConfigManager|FetchSoftwarePackages|patchManager|QueryHostPatch|config\.product|summary\.config\.product|hostSoftware|installedVib|vibs?\b)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
