/*
  MITRE Technique : T1583.008 - Malvertising
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:14:50.220785+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_008_Malvertising_Ad_Click_Redirect_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes many outbound HTTP requests carrying advertising click-identifier parameters (e.g. gclid, msclkid, dclid, fbclid) to external destinations outside the known-good domain list within 10 minutes. One ad click is benign. A burst of ad-click-driven requests from one source suggests a malvertising redirect chain, ad-fraud or adware activity, or automated ad-click traffic, and warrants review of the landing destinations."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.008"
    mitre_technique_name = "Acquire Infrastructure: Malvertising"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL-level visibility (web proxy or TLS-inspecting firewall) normalised to NETWORK_HTTP with target.url populated. Without URL visibility the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Heavy legitimate web browsing from search engine ads, marketing and SEO staff testing ad campaigns, ad-verification and competitive-intelligence tooling, shared NAT or proxy egress addresses aggregating many users, and web crawlers or QA automation."
    tuning_guidance = "Add known-good ad, CDN, and vendor domains to %global_allowed_domains. Raise the #http threshold for NAT or proxy egress addresses that aggregate many users. Exclude authorised marketing or testing sources via %global_allowed_scanners. Scale the threshold per client based on baseline browsing volume."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /[?&](gclid|gbraid|wbraid|msclkid|dclid|gad_source|fbclid)=/ nocase
    $http.principal.ip = $src_ip
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1583.008")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($http.metadata.id)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 10
}
