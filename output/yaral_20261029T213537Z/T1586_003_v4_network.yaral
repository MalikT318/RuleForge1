/*
  MITRE Technique : T1586.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:45:51.128013+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_003_Large_Upload_To_External_Cloud_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound HTTP PUT or POST from an internal source to an external object-storage or messaging-API style hostname that is not in the known-good domain list. Compromised cloud accounts are used for staging, tool upload, exfiltration and bulk messaging, and this surfaces the network-side signature of that use. The rule matches structural hostname labels, not specific provider or attacker domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.003"
    mitre_technique_name = "Compromise Accounts: Cloud Accounts"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP, with method, target hostname and sent-bytes populated (TLS inspection or a explicit proxy for HTTPS visibility)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Sanctioned cloud backup or sync clients, developers pushing build artifacts to object storage, marketing or notification platforms sending large API payloads, and bulk uploads to unlisted vendor storage."
    tuning_guidance = "Add approved storage and messaging domains to %global_allowed_domains. Raise or lower the sent_bytes threshold per client baseline. Keep %rfc1918_internal current for the client's address space. Consider scoping to egress-zone logs only."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|POST)$/ nocase
    $net.network.sent_bytes >= 5000000
    $net.target.hostname = /(^|\.)(s3[.-][a-z0-9.-]+|[a-z0-9-]*blob|[a-z0-9-]*storage|[a-z0-9-]*bucket[a-z0-9-]*|api|smtp|mail|messaging|sms)\.[a-z0-9.-]+\.[a-z]{2,}$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1586.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
