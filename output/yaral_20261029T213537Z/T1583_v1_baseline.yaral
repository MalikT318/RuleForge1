/*
  MITRE Technique : T1583 - Acquire Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:56:15.701992+00:00
  Reference       : https://attack.mitre.org/techniques/T1583
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_DNS_Long_Random_Label_Infrastructure_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries whose leftmost label is 24 or more alphanumeric characters and mixes letters and digits. This pattern is typical of algorithmically generated or machine-generated hostnames on freshly acquired adversary infrastructure (DGA domains, throwaway C2 and staging domains, tunnelling endpoints). Known-good domains are excluded through a reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583"
    mitre_technique_name = "Acquire Infrastructure"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Source IP or client identity should be present in principal.ip."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud provider hostnames with long generated labels, anti-virus and reputation lookup services, email authentication and DKIM selectors, software update and telemetry services, Kubernetes or cloud-generated internal names, and browser safe-browsing or tracking beacons."
    tuning_guidance = "Add the registered domains of benign CDN, vendor, and telemetry services to %global_allowed_domains. Adjust the label length threshold (24) upward in noisy environments. Because exact-match list semantics apply, also add frequently seen generated subdomain FQDNs to the list. Pair with the other T1583 variants for newly-observed-domain and record-type abuse coverage."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)(^|\.)[a-z0-9]{24,}\.[^.]+\.[^.]+$/
    $dns.network.dns.questions.name = /(?i)[a-z][0-9]|[0-9][a-z]/
    not $dns.network.dns.questions.name = /(?i)\.(arpa|local|internal|lan)$/
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
