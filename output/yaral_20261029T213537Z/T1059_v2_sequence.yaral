/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Identity Provider
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:36:15.672184+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_IdP_Mgmt_Login_Then_Shell_Service_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A management-plane authentication to a hypervisor host is followed within five minutes by a configuration change that enables an interactive shell or SSH service on the same host. Enabling these interpreters is a common precursor to adversary command execution. This rule uses authentication and setting-change telemetry only, not process command lines. The task specified Identity Provider as the platform and vmware_esxi as the log source, so the rule correlates the identity-bearing management login with the service change."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires hypervisor management logs (hostd authentication events and host configuration or service change events) ingested and normalised to USER_LOGIN and SETTING_MODIFICATION, with target.hostname populated on both."
    platform = "Identity Provider"
    log_source = "vmware_esxi"
    false_positives = "Planned maintenance or troubleshooting by administrators who briefly enable SSH or the shell. Automated provisioning, patching or lifecycle tooling that enables SSH during host builds. Break-glass access during incidents."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users. Add automation identities to %global_allowed_service_accounts. Add jump hosts and management subnets to %global_allowed_mgmt_sources. Extend the 5m window if the logging pipeline has significant latency."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.target.hostname = $host
    $login.principal.user.userid != ""
    not $login.principal.user.userid in %global_allowed_admin_users
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.ip in %global_allowed_mgmt_sources

    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.target.hostname = $host
    $set.target.resource.name = /(tsm|ssh|esxishell|shell)/ nocase
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_timestamp.seconds <= $set.metadata.event_timestamp.seconds

  match:
    $host over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($host)
    $login_users = array_distinct($login.principal.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $changed_settings = array_distinct($set.target.resource.name)
    $change_actors = array_distinct($set.principal.user.userid)

  condition:
    $login and $set
}
