/*
  MITRE Technique : T1584.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:29:58.688528+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_007_Serverless_Function_Endpoint_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP(S) requests from internal hosts to hostnames that follow public serverless function endpoint naming (edge workers, function URLs, API gateway invoke endpoints, hosted script macros). Adversaries who compromise serverless runtimes use these endpoints to answer infected machines or relay C2 traffic, and the traffic blends into ordinary cloud provider traffic. This is a hunting-grade lead that surfaces egress to serverless endpoints not already approved for the tenant."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.007"
    mitre_technique_name = "Compromise Infrastructure: Serverless"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.hostname populated. For HTTPS, the proxy needs SNI or TLS inspection to expose the hostname."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS and in-house applications hosted on serverless platforms, developer and DevOps testing of functions, third-party vendors that publish APIs on function-URL or API-gateway hostnames, and marketing or automation tools built on hosted scripts."
    tuning_guidance = "Add sanctioned serverless endpoint hostnames to %global_allowed_domains. Extend the regex alternation if the tenant uses other serverless platforms. Prioritise hits where the same source repeatedly contacts a single function hostname (beaconing). In tenants with heavy serverless use, restrict to user-workstation source segments."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.hostname = /(\.workers\.dev|\.lambda-url\.[a-z0-9-]+\.on\.aws|\.execute-api\.[a-z0-9-]+\.amazonaws\.com|\.cloudfunctions\.net|\.run\.app|^script\.google\.com|^script\.googleusercontent\.com)$/ nocase
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1584.007")
    $primary_entity = array_distinct($net.principal.ip)
    $serverless_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
