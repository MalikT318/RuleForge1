/*
  MITRE Technique : T1553.001 - Gatekeeper Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:39:28.522372+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_001_macOS_CLI_Download_Quarantine_Bypass_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound external network connection made by a command-line download utility (curl, wget, nscurl, aria2c) whose command line writes the payload to a user-writable staging location. Files fetched this way do not receive the com.apple.quarantine extended attribute, so Gatekeeper never prompts when the payload is later executed. This is the network-side view of a Gatekeeper bypass through quarantine-free delivery."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.001"
    mitre_technique_name = "Subvert Trust Controls: Gatekeeper Bypass"
    log_prerequisites = "macOS endpoint telemetry (EDR or unified log) producing NETWORK_CONNECTION events with the originating process path and command line populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developers and admins downloading tools or archives with curl/wget, Homebrew and other package managers, MDM or software-deployment bootstrap scripts, CI build agents on Mac hosts, dotfile and installer scripts run by users."
    tuning_guidance = "Add approved admin or deployment tooling paths to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and known-good scripted hosts to %global_allowed_script_hosts. Raise the risk score or add a follow-on correlation with xattr -d / chmod +x activity for higher-fidelity alerting."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|nscurl|aria2c)$/ nocase
    $net.principal.process.command_line = /\s(-[a-zA-Z]*[oO]|--output|--remote-name|--remote-name-all|--output-dir)(\s|=|$)/ nocase
    $net.principal.process.command_line = /(\/private\/tmp\/|\/tmp\/|\/var\/tmp\/|\/Users\/Shared\/|\/Users\/[^\/]+\/(Downloads|Library|Desktop|Documents)\/|\/Users\/[^\/]+\/\.[^\/]+\/)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1553.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $download_commands = array_distinct($net.principal.process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
