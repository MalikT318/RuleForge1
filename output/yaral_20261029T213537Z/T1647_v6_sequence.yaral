/*
  MITRE Technique : T1647 - Plist File Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:35:21.471784+00:00
  Reference       : https://attack.mitre.org/techniques/T1647
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1647_Plist_Edit_Command_Then_Persistence_Plist_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A built-in plist editing utility is run with write, insert or replace arguments against a sensitive key or location (LSUIElement, launchd keys, Dock preferences, environment variables). A plist in a LaunchAgents or LaunchDaemons directory, a Dock preferences plist, or an application Info.plist is then modified on the same host within 10 minutes. This pairing indicates deliberate plist tampering to hide applications, persist, or alter runtime behaviour."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1647"
    mitre_technique_name = "Plist File Modification"
    log_prerequisites = "Requires macOS endpoint process telemetry with command lines (PROCESS_LAUNCH) and file modification telemetry (FILE_MODIFICATION) with full paths."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM and configuration management agents deploying launchd plists or managed preferences, software installers and updaters editing Info.plist or LaunchAgents, developers editing app bundles in Xcode build scripts, and admins customising the Dock with defaults write."
    tuning_guidance = "Add MDM, deployment and packaging tool binary paths to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add approved build or provisioning hosts to %global_allowed_script_hosts. If Dock customisation is common in the environment, remove the Dock term from the command-line regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(defaults|plutil|PlistBuddy)$/ nocase
    $proc.target.process.command_line = /\b(write|-insert|-replace|-c\s+['"]?(add|set|merge|import))\b/ nocase
    $proc.target.process.command_line = /(LSUIElement|LSBackgroundOnly|LSEnvironment|EnvironmentVariables|ProgramArguments|RunAtLoad|KeepAlive|LaunchAgents|LaunchDaemons|com\.apple\.dock|com\.apple\.loginitems|Info\.plist)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(\/Library\/LaunchAgents\/[^\/]+\.plist|\/Library\/LaunchDaemons\/[^\/]+\.plist|\/Users\/[^\/]+\/Library\/Preferences\/com\.apple\.dock\.plist|\.app\/Contents\/Info\.plist)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1647")
    $primary_entity = array_distinct($hostname)
    $users = array_distinct($proc.principal.user.userid)
    $edit_commands = array_distinct($proc.target.process.command_line)
    $modified_plists = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $plist_edit_count = count($proc.metadata.id)

  condition:
    $proc and $file
}
