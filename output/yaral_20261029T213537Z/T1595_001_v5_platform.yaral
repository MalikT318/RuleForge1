/*
  MITRE Technique : T1595.001 - Scanning IP Blocks
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:53:10.701396+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_001_Inbound_ICMP_Sweep_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects inbound ICMP traffic from a non-internal source to an internal destination at the network perimeter. This is the signature of a ping sweep used to enumerate live hosts in a victim IP block. It is a low-severity reconnaissance signal and a building block for hunting and escalation, not a standalone compromise indicator."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.001"
    mitre_technique_name = "Active Scanning: Scanning IP Blocks"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with network.ip_protocol, principal.ip and target.ip populated. ICMP must be logged (allowed and, ideally, denied) on the external interface."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet-wide research scanners, uptime and availability monitoring services, CDN or ISP health probes, path MTU discovery, customer-authorised external vulnerability scans, and partner connectivity checks."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners and approved external management sources to %global_allowed_mgmt_sources. Expect high volume on internet-facing segments, so deploy at Low severity and use the output for hunting or enrichment. To alert on actual sweeps, clone this as a Threshold rule grouped by source IP (principal.ip) with a distinct-destination count over 10m. Confirm the %rfc1918_internal list covers the client's private addressing so internal sources are excluded."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "ICMP"
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1595.001")
    $primary_entity = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $sensor_host = array_distinct($net.principal.hostname)

  condition:
    $net
}
