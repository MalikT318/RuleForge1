/*
  MITRE Technique : T1608.004 - Drive-by Target
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:27:28.180994+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_004_External_Write_Of_Web_Script_Content {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external, non-allowlisted source successfully writing script or markup content (js, html, svg, hta, jar, swf) to a web server through an HTTP write method (PUT, POST or PATCH). Adversaries abusing exposed upload or WebDAV functions to inject or stage drive-by content on a watering-hole site produce this pattern at the perimeter. The rule looks at the HTTP method, the target content type and a successful response, not at a specific payload."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.004"
    mitre_technique_name = "Stage Capabilities: Drive-by Target"
    log_prerequisites = "Requires perimeter proxy, WAF-in-line firewall or reverse-proxy logs normalised to NETWORK_HTTP with network.http.method, target.url and network.http.response_code populated (TLS inspection or reverse-proxy visibility is needed for URL-level fields)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "CMS and web-publishing workflows where editors or CI/CD pipelines upload HTML or JS from external addresses; WebDAV-based content management; SaaS integrations pushing static assets; authorised penetration tests."
    tuning_guidance = "Add trusted publishing and deployment source addresses to %global_allowed_mgmt_sources, authorised testers to %global_allowed_scanners, and automation sources to %global_allowed_service_accounts if the source user id is populated. Narrow the extension list or the HTTP methods if the environment legitimately uploads such content."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|POST|PATCH)$/ nocase
    $net.target.url = /\.(js|html?|svg|hta|jar|swf)(\?.*)?$/ nocase
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1608.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
