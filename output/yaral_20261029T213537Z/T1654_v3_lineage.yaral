/*
  MITRE Technique : T1654 - Log Enumeration
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:38:34.386288+00:00
  Reference       : https://attack.mitre.org/techniques/T1654
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1654_ESXi_Log_Enumeration_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or log-reading utility on an ESXi host that touches system log locations (hostd, vmkernel, shell, auth, vpxa, syslog) or syslog/support-bundle commands, when it is spawned by an unexpected parent. Unexpected parents are management daemons, web/proxy services, scripting interpreters, and network download or transfer tools. Legitimate interactive log review normally descends from sshd, a login shell or the DCUI, so this lineage points to a web-service compromise, a dropped script, or a remote-execution framework collecting logs to learn about the host or to monitor defender activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1654"
    mitre_technique_name = "Log Enumeration"
    log_prerequisites = "ESXi shell/process audit telemetry (shell.log or syslog forwarding with process execution detail) normalised to UDM PROCESS_LAUNCH with parent process path, child process path and command line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host health-check or monitoring scripts run from python or perl, vendor hardware-monitoring agents reading logs, management daemons running built-in diagnostic collection, support-bundle generation by management tooling, and automation frameworks pushing log collection jobs."
    tuning_guidance = "Add approved automation, monitoring and diagnostic parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add approved automation accounts to %global_allowed_service_accounts. To reduce noise, remove generic readers such as cat or grep from the child regex, or narrow the log-name list to the logs most relevant to your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|rhttpproxy|vpxa|fdm|sfcbd|sfcb-[a-z_-]+|openwsman|python[0-9.]*|perl|php|lua|wget|curl|nc|ncat|netcat|busybox-httpd|httpd|lighttpd|nginx)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|cat|tail|head|grep|egrep|zcat|less|more|awk|sed|strings|tar|gzip|find|cp|scp|esxcli|vm-support)$/ nocase
    $proc.target.process.command_line = /(\/var\/(run\/)?log\/|\/scratch\/log\/|esxcli\s+system\s+syslog|vm-support|\b(hostd|vmkernel|vmkwarning|shell|auth|vpxa|vobd|syslog|esxupdate)\.log)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1654")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
