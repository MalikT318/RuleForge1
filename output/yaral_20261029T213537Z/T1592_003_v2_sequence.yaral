/*
  MITRE Technique : T1592.003 - Firmware
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:39:12.331884+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_003_External_Mgmt_Port_Probe_Then_Firmware_URL_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An external source connects to an out-of-band management service port (IPMI, Intel AMT) and then, within 10 minutes, requests firmware, BIOS or BMC inventory URLs over HTTP. This sequence is typical of reconnaissance that fingerprints host firmware type and version before targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.003"
    mitre_technique_name = "Gather Victim Host Information: Firmware"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION (with target.port) and NETWORK_HTTP (with target.url) for inbound or external-facing traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners or attack-surface monitoring services, hardware vendor remote support sessions, MSP or datacentre staff using out-of-band management over the internet, search-engine style internet scanners that are not malicious but still enumerate exposed management interfaces."
    tuning_guidance = "Add approved scanner sources to %global_allowed_scanners and approved management source addresses to %global_allowed_mgmt_sources. Add trusted automation source accounts to %global_allowed_admin_users if the proxy populates principal.user.userid. Raise severity if the destination is a known internet-exposed BMC. Extend the port or URL patterns per environment if needed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 623 or
      $net.target.port = 664 or
      $net.target.port = 16992 or
      $net.target.port = 16993 or
      $net.target.port = 16994 or
      $net.target.port = 16995
    )
    $net.principal.ip = $src_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(redfish\/v1|firmware|fwupdate|fw_update|bios|bmc|ipmi|cgi-bin\/(version|sysinfo|fwinfo)|api\/(firmware|system\/info|v1\/firmware)|sysinfo|dev\/info)(\/|\?|$)/ nocase
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

    $net.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1592.003")
    $primary_entity = array_distinct($src_ip)
    $probed_ports = array_distinct($net.target.port)
    $requested_urls = array_distinct($http.target.url)
    $target_ips = array_distinct($http.target.ip)
    $http_request_count = count($http.metadata.id)

  condition:
    $net and $http
}
