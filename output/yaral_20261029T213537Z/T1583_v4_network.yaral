/*
  MITRE Technique : T1583 - Acquire Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:57:20.559872+00:00
  Reference       : https://attack.mitre.org/techniques/T1583
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_DGA_Like_Domain_DNS_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for a registered domain label that is long (16+ characters) and contains a run of six or more consecutive consonants. This is typical of algorithmically generated or throwaway domains that adversaries register or rent as staging and C2 infrastructure. Queries are excluded when they resolve to internal address space or the domain is on the known-good list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583"
    mitre_technique_name = "Acquire Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS with network.dns.questions.name populated. Answer data (network.dns.answers.data) is used for the internal-address exclusion when present."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-provider hostnames with long machine-generated labels, security vendor reputation and telemetry lookups, DNS-based blocklist queries, software update and licensing services, mail anti-spam lookups, and long hash-like names used by legitimate SaaS tenants."
    tuning_guidance = "Add known-good registered domains to %global_allowed_domains. Raise the label length threshold (16) or the consonant run length (6) to reduce noise, or lower them for higher sensitivity. Review hits by joining with first-seen domain intelligence before escalating."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9-]{16,}\.[a-z]{2,24}$/ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz]{6,}[a-z0-9-]*\.[a-z]{2,24}$/ nocase
    not $dns.network.dns.questions.name = /\.arpa$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583")
    $primary_entity = array_distinct(strings.coalesce($dns.principal.hostname, $dns.principal.ip))
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $resolved_answers = array_distinct($dns.network.dns.answers.data)

  condition:
    $dns
}
