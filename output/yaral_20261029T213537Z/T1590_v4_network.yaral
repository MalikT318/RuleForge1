/*
  MITRE Technique : T1590 - Gather Victim Network Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:12:39.122519+00:00
  Reference       : https://attack.mitre.org/techniques/T1590
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_IPS_External_Network_Recon_Signature {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IPS/network security appliance verdict classifying inbound traffic from an external source as network reconnaissance (port scan, host or ping sweep, network mapping, fingerprinting, DNS zone transfer or enumeration). This is the network-side view of an adversary gathering victim network information. It uses the appliance's own detection verdict and does not rely on endpoint process telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590"
    mitre_technique_name = "Gather Victim Network Information"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION, with security_result.category or security_result.rule_name populated with the signature or detection name. Requires the principal.ip field to carry the external source."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and penetration tests not yet in the allowlist, internet-wide research scanners and uptime or monitoring services, partner or MSP network discovery tools, and noisy generic signatures that fire on benign health-check traffic."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. Tune the signature-name regex to the client's IPS naming convention. Raise severity or add a threshold variant for repeated hits from one source. Confirm the client's IPS maps signature names into security_result.rule_name or the NETWORK_RECON category."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.category = "NETWORK_RECON" or
      $net.security_result.rule_name = /(port[ _-]?scan|host[ _-]?sweep|ping[ _-]?sweep|network[ _-]?(scan|sweep|mapping)|reconnaissance|fingerprint|dns[ _-]?(zone[ _-]?transfer|axfr|enum)|topology[ _-]?discovery)/ nocase
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1590")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
