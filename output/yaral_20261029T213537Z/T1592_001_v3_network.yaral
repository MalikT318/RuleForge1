/*
  MITRE Technique : T1592.001 - Hardware
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:36:02.933245+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_001_External_Probe_Hardware_Mgmt_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a connection from an external (non-internal) source to a port used by hardware management and device-identification services: SNMP (161), IPMI/BMC (623), raw print/JetDirect (9100), IPP (631) and LPD (515). These services expose hardware make, model, firmware and component details to unauthenticated or weakly authenticated queries. Inbound probing of them from the internet is characteristic of hardware reconnaissance and banner or fingerprint harvesting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.001"
    mitre_technique_name = "Gather Victim Host Information: Hardware"
    log_prerequisites = "Perimeter firewall or proxy logs that record accepted and attempted inbound connections, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Denied or dropped traffic must be logged, because most internet probing is blocked."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners or attack-surface monitoring services; managed service provider or vendor monitoring over SNMP or IPMI via site-to-site or VPN-terminated addresses; cloud-hosted print services; remote administrators reaching BMC interfaces from a non-internal address."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add approved management source addresses (MSP, VPN egress, NOC) to %global_allowed_mgmt_sources. If a client legitimately publishes one of these services, narrow the port list for that tenant. If volume is high, pair the rule with a threshold variant that counts distinct target.ip values per source."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 623 or
      $net.target.port = 9100 or
      $net.target.port = 631 or
      $net.target.port = 515
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1592.001")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_hosts = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    $net
}
