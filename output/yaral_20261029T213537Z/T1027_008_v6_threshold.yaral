/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:43:44.101319+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Linux_Binutils_Strip_Temp_Files_Staging_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated creation of binutils-style temporary files (strip/objcopy write a six-character 'st' temp file next to the target before renaming it over the original) inside world-writable staging directories (/tmp, /var/tmp, /dev/shm) on a single host within ten minutes. This file-artifact angle indicates payloads being stripped of symbols in place in attacker staging areas. It does not depend on command-line matching and still fires if the strip utility is renamed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records that populate target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and packaging jobs running make install-strip, CI runners, developer workstations, package builders and software compilation inside /tmp build directories, and container image build steps."
    tuning_guidance = "Add legitimate build tools and CI agents to %global_allowed_admin_tools. Add approved build hosts' wrapper processes to %global_allowed_script_hosts. Raise the #file threshold on developer or build-server hosts. Review the target_files outcome for unexpected ELF names."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*\/)?st[A-Za-z0-9]{6}$/
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.008")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $target_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
