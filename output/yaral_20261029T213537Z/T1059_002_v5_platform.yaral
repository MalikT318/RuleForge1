/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:37:34.877054+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_macOS_AppleScript_File_Staged_Autorun_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an AppleScript artifact (.scpt, .scptd, .applescript, .workflow) in a location that triggers automatic execution (Mail rule scripts, Folder Action scripts) or in a world-writable staging directory (/tmp, /var/tmp, /Users/Shared). This covers AppleScript execution paths that never call osascript on the command line, such as Mail rules, Folder Actions and Automator workflows, by detecting the file drop instead of the process command line."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "macOS endpoint telemetry with file-creation events (EDR or unified log) populating target.file.full_path and principal.process.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Users or admins authoring Mail rule or Folder Action scripts, MDM and IT automation that deploys .scpt or .workflow files, software installers that place helper scripts in /tmp, and developers building AppleScript tooling."
    tuning_guidance = "Add approved deployment and MDM binaries to %global_allowed_admin_tools and trusted script-hosting parents to %global_allowed_script_hosts. If Script Editor or Automator use is common in your environment, review the built-in executable-name exclusions. Narrow the staging directories if /Users/Shared is used for sanctioned script distribution."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/Users\/[^\/]+\/Library\/(Scripts\/(Folder Action Scripts|Mail Scripts)|Workflows\/Applications\/Folder Actions|Application Scripts\/com\.apple\.mail)|\/Library\/Scripts\/Folder Action Scripts|\/(private\/)?(tmp|var\/tmp)|\/Users\/Shared)\/[^\/]+\.(scpt|scptd|applescript|workflow)$/ nocase
    not $file.principal.process.file.full_path = /\/(Script Editor|Automator|installd|system_installd|softwareupdated)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
