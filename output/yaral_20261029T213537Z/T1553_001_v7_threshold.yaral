/*
  MITRE Technique : T1553.001 - Gatekeeper Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:40:20.299223+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_001_Gatekeeper_Bypass_Repeated_Quarantine_Removal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated attempts on a single macOS host to strip the com.apple.quarantine extended attribute (xattr -d / -c / -cr) or to weaken Gatekeeper policy (spctl --master-disable / --add) within ten minutes. One invocation is often benign; a burst suggests an adversary or dropper clearing quarantine flags on multiple downloaded payloads so they run without a Gatekeeper prompt. Risk score is raised when Gatekeeper is disabled globally."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.001"
    mitre_technique_name = "Subvert Trust Controls: Gatekeeper Bypass"
    log_prerequisites = "Requires macOS EDR or unified log process-launch telemetry with full command lines populated (target.process.command_line) and parent process path (principal.process.file.full_path)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developers and CI/build hosts clearing quarantine on freshly downloaded or compiled tools, IT packaging and deployment scripts (MDM, Munki-style workflows), Homebrew cask installs, power users opening trusted unsigned apps, and admins running spctl during provisioning."
    tuning_guidance = "Add MDM, deployment and packaging parent processes to %global_allowed_admin_tools. Add automation and build accounts to %global_allowed_service_accounts. If developer or build hosts are noisy, raise the threshold (#proc >= 3) to 5 or higher for those clients, or route their hosts through a client-specific copy of the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/xattr$/ nocase
        $proc.target.process.command_line = /(\s-[a-z]*d[a-z]*\s+(-[a-z]+\s+)*com\.apple\.quarantine|\s-[a-z]*c[a-z]*(\s|$))/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/spctl$/ nocase
        $proc.target.process.command_line = /(--master-disable|--global-disable|--add\b|--disable\b)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.command_line, `(?i)(--master-disable|--global-disable)`), 85, 60))
    $mitre_technique_id = array_distinct("T1553.001")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $first_seen = min($proc.metadata.event_timestamp.seconds)
    $last_seen = max($proc.metadata.event_timestamp.seconds)

  condition:
    #proc >= 3
}
