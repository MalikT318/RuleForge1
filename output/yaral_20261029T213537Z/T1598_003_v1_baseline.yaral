/*
  MITRE Technique : T1598.003 - Spearphishing Link
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:15:08.262207+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_003_Obfuscated_URL_Credential_Lure_Click {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal client making an outbound HTTP request to a URL that uses the obfuscation tricks typical of spearphishing links: a deceptive domain-like string in the userinfo portion before an '@', or a hostname written as an integer, hexadecimal or octal value instead of a normal domain. These URL-schema quirks are named in the MITRE technique description and are rarely used in legitimate browsing, so a request to one is a strong sign that a user clicked a phishing link."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.003"
    mitre_technique_name = "Phishing for Information: Spearphishing Link"
    log_prerequisites = "Requires perimeter or proxy logs that normalise to NETWORK_HTTP with target.url populated (full URL including scheme and any userinfo). Proxies that strip userinfo before logging will not produce the '@' signal; the integer/hex host signal still works."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legacy internal applications or devices using http://user@host style URLs; embedded device or IoT management interfaces addressed by integer or hex IP; security awareness phishing simulations; URL scanners and sandboxes replaying links; some tracking or redirect services that put a domain in the userinfo portion."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Phishing-simulation and URL-scanning platforms can be added there too if their hostnames are what appear in target.hostname. Internal destinations are already excluded through %rfc1918_internal. Raise severity or route to SOAR for user follow-up when the same source host repeats the pattern."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^[a-z][a-z0-9+.\-]*:\/\/([^\/?#@]*\.[^\/?#@]*@|(0x[0-9a-f]{1,8}|[0-9]{8,10})([:\/?#]|$)|(0x[0-9a-f]+|0[0-7]+)(\.(0x[0-9a-f]+|[0-7]+)){1,3}([:\/?#]|$))/ nocase
    not $net.target.hostname in %global_allowed_domains
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1598.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $suspicious_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
