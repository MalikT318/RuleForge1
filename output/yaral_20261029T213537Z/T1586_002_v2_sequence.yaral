/*
  MITRE Technique : T1586.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:43:24.335720+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_002_External_Mail_Protocol_Probe_Then_Webmail_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single external source repeatedly connects to mail-access ports (IMAP, POP3, SMTP submission) and then issues repeated POST requests to webmail, autodiscover or mail-sync endpoints within 10 minutes. This cross-protocol pattern is typical of credential stuffing or password spraying against mailboxes, which adversaries use to take over email accounts for later phishing or infrastructure acquisition (T1586.002)."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.002"
    mitre_technique_name = "Compromise Accounts: Email Accounts"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION (with principal.ip, target.port) and NETWORK_HTTP (with target.url, network.http.method) for the mail-facing services. Inbound traffic must be logged."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Remote users on mobile or roaming networks with misconfigured mail clients, corporate NAT or VPN egress addresses not in the internal list, partner or vendor mail integrations, uptime or synthetic monitoring of mail services, and authorised penetration tests."
    tuning_guidance = "Add authorised scanner and monitoring sources to %global_allowed_scanners. Add known partner egress addresses to %global_allowed_mgmt_sources if appropriate for the client. Raise the #conn and #http thresholds for tenants with heavy roaming mail use. Confirm %rfc1918_internal covers the client's internal address space."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
      $conn.target.port = 993 or
      $conn.target.port = 995 or
      $conn.target.port = 587 or
      $conn.target.port = 465 or
      $conn.target.port = 143 or
      $conn.target.port = 110
    )
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    $conn.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /(\/owa\/auth|\/ews\/exchange|\/autodiscover\/autodiscover|\/microsoft-server-activesync|\/mapi\/|\/webmail|\/roundcube|\/rcmail|\/squirrelmail|\/horde\/login)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1586.002")
    $primary_entity = array_distinct($src_ip)
    $mail_port_connections = count($conn.metadata.id)
    $webmail_posts = count($http.metadata.id)
    $targeted_ips = array_distinct($conn.target.ip)
    $targeted_ports = array_distinct($conn.target.port)
    $targeted_urls = array_distinct($http.target.url)

  condition:
    #conn >= 10 and #http >= 3
}
