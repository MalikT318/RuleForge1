/*
  MITRE Technique : T1584.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:17:46.326959+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_001_DNS_Shadowed_Subdomain_Random_Label {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries that resolve to external addresses and use a long, machine-generated-looking leftmost label (24+ alphanumeric characters with several digits) under a domain not on the known-good list. This pattern is characteristic of domain shadowing and subdomain takeover, where an adversary who controls a compromised or hijacked domain creates many throwaway subdomains for C2, staging or phishing, while the parent domain keeps its legitimate records."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.001"
    mitre_technique_name = "Compromise Infrastructure: Domains"
    log_prerequisites = "Requires DNS query/resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.answers.data populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud edge hostnames with hashed labels, software update and telemetry services, email security and URL-rewriting services, DNS-based blocklist lookups, anti-virus cloud lookups, session-ID subdomains used by SaaS products, and mDNS/service-discovery names."
    tuning_guidance = "Add the registered domains of CDNs, SaaS and update vendors to %global_allowed_domains. The rule excludes by the last two and last three labels of the queried name, so add either form (for example example.com or example.co.uk). Adjust the label length ({24,}) and digit count ({4}) thresholds per client. Internal answers are excluded via %rfc1918_internal. Pair with a threshold variant to find many unique random subdomains under one parent domain."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^[a-z0-9]{24,}\.[a-z0-9-]+(\.[a-z0-9-]+)+\.?$/ nocase
    $dns.network.dns.questions.name = /^([a-z]*[0-9]){4}/ nocase
    $dns.network.dns.answers.data != ""
    not $dns.network.dns.answers.data in %rfc1918_internal
    $d2 = re.capture($dns.network.dns.questions.name, `(?i)([a-z0-9-]+\.[a-z0-9-]+)\.?$`)
    $d3 = re.capture($dns.network.dns.questions.name, `(?i)([a-z0-9-]+\.[a-z0-9-]+\.[a-z0-9-]+)\.?$`)
    not $d2 in %global_allowed_domains
    not $d3 in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1584.001")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $resolved_addresses = array_distinct($dns.network.dns.answers.data)

  condition:
    $dns
}
