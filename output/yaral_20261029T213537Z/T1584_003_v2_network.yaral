/*
  MITRE Technique : T1584.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:22:00.362658+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_003_Outbound_HTTP_To_Raw_IP_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client sending an HTTP POST to an external server addressed by a bare IPv4 literal in the Host/hostname field, with no domain name. T1584.003 happens on third-party infrastructure and is not directly observable by the victim. This rule is a network-side proxy that flags use of rented or compromised VPS-style infrastructure, which is commonly contacted by raw IP for C2 or staging. It does not confirm that a VPS was compromised."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.003"
    mitre_technique_name = "Compromise Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires proxy, secure web gateway, or firewall logs with HTTP inspection that populate network.http.method and target.hostname, normalised to UDM NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software that talks to appliances or APIs by IP literal, such as IoT or device cloud check-ins, licence servers, legacy update agents, captive portal checks, and penetration tests or scanners run from internal ranges."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and known-good IP-addressed destinations to %global_allowed_domains. Add approved management sources to %global_allowed_mgmt_sources. If volume is high, raise severity only for hosts that repeat the behaviour. Consider a companion Threshold rule."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.hostname = /^\d{1,3}(\.\d{1,3}){3}$/
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1584.003")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_ports = array_distinct($http.target.port)

  condition:
    $http
}
