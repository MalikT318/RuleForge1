/*
  MITRE Technique : T1596.004 - CDNs
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:06:01.921002+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_004_CDN_Content_Probe_Then_Origin_Port_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An external source requests sensitive or misconfiguration-prone resources (VCS metadata, environment/config files, backup artifacts, path traversal on static or CDN paths) and then, within ten minutes, connects to non-standard ports from the same address. This pattern indicates CDN or origin reconnaissance followed by direct origin probing."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.004"
    mitre_technique_name = "Search Open Technical Databases: CDNs"
    log_prerequisites = "Requires IPS or network security appliance telemetry that normalises HTTP inspection events (NETWORK_HTTP with target.url populated) and connection or flow events (NETWORK_CONNECTION with principal.ip, target.ip and target.port populated)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external attack-surface management or vulnerability scanners not yet in the allowlist, search-engine or uptime crawlers requesting well-known config paths, developers testing deployments from external addresses, and bug-bounty researchers operating under an approved programme."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add approved management source addresses to %global_allowed_mgmt_sources. Raise the #http threshold in the condition or widen the URL regex for noisy environments. Tighten the non-standard port filter if the estate legitimately exposes many alternative service ports."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/\.git(\/|$)|\/\.svn(\/|$)|\/\.env|\/\.aws\/|\/\.ds_store|wp-config|web\.config|\.(bak|old|orig|sql|swp)(\?|$)|\/(cdn|static|assets|media|origin)[^\/?]*\/(\.\.|%2e%2e)\/)/ nocase
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.port != 80
    $net.target.port != 443
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1596.004")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_urls = array_distinct($http.target.url)
    $probed_hosts = array_distinct($http.target.hostname)
    $probed_ports = array_distinct($net.target.port)
    $target_ips = array_distinct($net.target.ip)
    $http_event_count = count($http.metadata.id)
    $net_event_count = count($net.metadata.id)

  condition:
    $http and $net
}
