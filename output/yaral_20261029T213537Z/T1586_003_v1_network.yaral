/*
  MITRE Technique : T1586.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:44:50.060475+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_003_Large_Upload_To_Unapproved_External_Cloud_Endpoint {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound HTTP PUT or POST from an internal client to an external, non-allowlisted named host. This is the network-observable pattern of compromised cloud accounts (object storage, hosting, messaging APIs) being used as staging or exfiltration infrastructure. Detection relies on upload behaviour (method and volume), not on named providers or indicators."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.003"
    mitre_technique_name = "Compromise Accounts: Cloud Accounts"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_HTTP with network.http.method, network.sent_bytes and target.hostname populated. TLS inspection or a proxy log is typically needed for the HTTP method and hostname."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Sanctioned SaaS backup or sync clients, software publishing pipelines, telemetry or crash-dump uploads to vendors, large email attachments through web mail, developers pushing container images or artifacts to external registries, and video conferencing or media uploads."
    tuning_guidance = "Add known-good external domains (backup vendors, CDNs, SaaS tenants, artifact registries) to %global_allowed_domains. The 10 MB threshold (10485760 bytes) can be raised for noisy environments or lowered for high-sensitivity clients. Ensure %rfc1918_internal is populated so internal-to-internal transfers are excluded."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|POST)$/ nocase
    $net.network.sent_bytes > 10485760
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1586.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
