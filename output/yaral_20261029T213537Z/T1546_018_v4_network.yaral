/*
  MITRE Technique : T1546.018 - Python Startup Hooks
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:32:33.844950+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_018_macOS_Python_Startup_Hook_Download_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP(S) GET through a proxy or firewall for a Python startup-hook file (a .pth path configuration file, sitecustomize.py or usercustomize.py) from an external, non-allowlisted host. Adversaries stage these files over the network before dropping them into site-packages or a user site directory to get code execution on every Python launch. This is a network-side view and complements endpoint file and process detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.018"
    mitre_technique_name = "Event Triggered Execution: Python Startup Hooks"
    log_prerequisites = "Requires proxy or firewall logs with HTTP URL visibility (explicit proxy or TLS inspection) normalized to NETWORK_HTTP with target.url populated. Without URL visibility the rule cannot fire."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Developers or build pipelines fetching sitecustomize.py or .pth files from public code repositories or internal artifact mirrors, Python package installation tooling that fetches loose .pth files, and IT automation that distributes Python environment configuration."
    tuning_guidance = "Add trusted package mirrors and repository domains to %global_allowed_domains. Internal destinations are already excluded through %rfc1918_internal. If proxy logs lack target.ip, rely on the %global_allowed_domains exclusion for internal artifact hosts. Raise severity when the source host is a server or a non-developer endpoint."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\/(sitecustomize|usercustomize)\.py([?#].*)?$|\/[^\/?#]+\.pth([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546.018")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
