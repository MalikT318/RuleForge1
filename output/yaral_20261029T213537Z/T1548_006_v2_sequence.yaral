/*
  MITRE Technique : T1548.006 - TCC Manipulation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:35:08.256055+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_006_TCC_DB_Modified_After_Untrusted_Path_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a binary launched from a user-writable or temporary location on a macOS host, followed within 10 minutes by a modification of a TCC database (TCC.db) on the same host by a process that is not the TCC daemon or an approved tool. This sequence indicates an attempt to grant a malicious executable privacy permissions such as Full Disk Access or Accessibility by tampering with the TCC database."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.006"
    mitre_technique_name = "Abuse Elevation Control Mechanism: TCC Manipulation"
    log_prerequisites = "Requires macOS endpoint telemetry that reports both process launch events and file modification events, including writes to /Library/Application Support/com.apple.TCC/ and /Users/*/Library/Application Support/com.apple.TCC/. Hostname must be populated on both event types."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or device management agents that manage privacy permissions, security or EDR agents that inspect or repair the TCC database, IT staff running tccutil or sqlite3 during troubleshooting, and software installers launched from Downloads that legitimately register permissions. Temporary-path execution is also common in developer workflows and package installs."
    tuning_guidance = "Add approved MDM and management agents to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and approved remote support tools to %global_allowed_remote_mgmt. Add noisy developer or build hosts to %global_allowed_script_hosts. If installer noise persists, narrow the user-writable path regex on the launch event."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(private\/)?(tmp|var\/tmp|var\/folders)\/|^\/Users\/Shared\/|^\/Users\/[^\/]+\/(Downloads|Public|Library\/Caches)\// nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/com\.apple\.TCC\/TCC\.db(-journal|-wal)?$/ nocase
    not $file.principal.process.file.full_path = /\/(tccd|tccutil|mdmclient|system_installd|syspolicyd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1548.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $launched_binaries = array_distinct($proc.target.process.file.full_path)
    $launching_users = array_distinct($proc.principal.user.userid)
    $tcc_modifying_processes = array_distinct($file.principal.process.file.full_path)
    $tcc_files_modified = array_distinct($file.target.file.full_path)
    $tcc_modification_count = count($file.metadata.id)

  condition:
    $proc and $file
}
