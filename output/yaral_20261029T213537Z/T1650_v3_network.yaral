/*
  MITRE Technique : T1650 - Acquire Access
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:36:31.231866+00:00
  Reference       : https://attack.mitre.org/techniques/T1650
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1650_DNS_Long_Label_Or_TXT_Tunnel_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries with abnormally long, encoded-looking subdomain labels, or long labels combined with TXT/NULL record types. This is the network-side signature of an implant or 'load' left on a host by an access broker, which beacons or tunnels over DNS to hand access to a buyer. It does not observe the purchase of access itself, which happens off-network."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1650"
    mitre_technique_name = "Acquire Access"
    log_prerequisites = "Requires DNS query or resolver logs normalised to NETWORK_DNS with network.dns.questions.name and questions.type populated. Resolver-side logging is preferred so that all internal clients are visible."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services using long hashed hostnames, DKIM/SPF/DMARC TXT lookups, email security and anti-spam DNSBL services, endpoint security cloud lookups, software licensing and telemetry services that encode data in subdomains, and DNS-based service discovery."
    tuning_guidance = "Add known-good parent domains to %global_allowed_domains. Note that this list is matched against the full queried name, so also add the specific FQDNs of noisy services. Raise the label-length thresholds (52 for any type, 30 for TXT/NULL) if the environment is noisy. The rule also passes events with no target.ip. If your resolver logs record internal resolver addresses in target.ip, those events are excluded through %rfc1918_internal, so adjust the exclusion or the log field mapping as needed."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    (
      $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{52,}\./ nocase
      or
      (
        $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{30,}\./ nocase
        and
        (
          $dns.network.dns.questions.type = 16
          or $dns.network.dns.questions.type = 10
        )
      )
    )
    not $dns.network.dns.questions.name = /\.arpa$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1650")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $source_ips = array_distinct($dns.principal.ip)

  condition:
    $dns
}
