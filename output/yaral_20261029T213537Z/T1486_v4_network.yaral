/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:50:04.578019+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_macOS_Staged_Process_Tor_Relay_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS process running from a user-writable staging location (tmp, Downloads, Users/Shared, user Library or hidden user directories) that opens an outbound connection to an external address on default Tor relay ports (ORPort 9001, DirPort 9030). Ransomware families targeting macOS commonly use Tor for key exchange and ransom-note communication. This is the network-side precursor or companion to encryption activity and does not rely on process command-line content."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires macOS endpoint network telemetry that populates the originating process path and the destination IP and port on connection events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Tor Browser or privacy tools run directly from Downloads or a mounted or extracted location, security researchers, developer tooling or test builds that run Tor relays from user directories, and peer-to-peer clients using the same ports."
    tuning_guidance = "Add sanctioned privacy or security tooling to %global_allowed_security_tools and approved IT utilities to %global_allowed_admin_tools. Known research hosts can be handled by suppressing on principal.hostname per client. Extend the port list per client if their threat model includes other Tor or proxy ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(private\/)?(tmp|var\/tmp)\/|^\/Users\/Shared\/|^\/Users\/[^\/]+\/(Library\/|Downloads\/|\.[^\/]+\/)/ nocase
    ($net.target.port = 9001 or $net.target.port = 9030)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
