/*
  MITRE Technique : T1588.003 - Code Signing Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:58:14.368378+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_003_Code_Signing_Key_Material_Upload_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP upload (POST or PUT) to an external destination where the URL path references code signing key or certificate container files (.pfx, .p12, .pvk, .spc, .snk). The acquisition of a code signing certificate happens outside the victim's visibility, so this rule covers the observable part of the technique: theft and exfiltration of signing material from a compromised organisation. It matches on the file-type extension, not a named tool, domain or IP."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.003"
    mitre_technique_name = "Obtain Capabilities: Code Signing Certificates"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL-level HTTP visibility (TLS inspection or explicit proxy) that populate network.http.method and target.url. Without TLS inspection, URL paths are not visible and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Build and release engineering uploading signing certificates to approved secrets managers or CI/CD platforms, certificate lifecycle or PKI management tooling, developers sharing test certificates through sanctioned SaaS, and MDM or device enrolment workflows that upload PKCS#12 bundles."
    tuning_guidance = "Add sanctioned destination domains (secrets managers, CI/CD, PKI vendors) to %global_allowed_domains. If the perimeter device logs the internal source address as a hostname, add known build or PKI hosts to %global_allowed_service_accounts or %global_allowed_admin_users only if those identifiers are populated in your telemetry. Review the uploading host first, then check whether it holds signing material."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.target.url = /\.(pfx|p12|pvk|spc|snk)([?#;].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1588.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $uploaded_urls = array_distinct($net.target.url)

  condition:
    $net
}
