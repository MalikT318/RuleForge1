/*
  MITRE Technique : T1110.002 - Password Cracking
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:08:20.620235+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_002_IdP_Burst_Logins_Single_Account_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of login events against a single identity-provider account from external (non-RFC1918) source addresses within 10 minutes. Password cracking happens offline, so the observable result is a cracked credential being used or tested against the identity provider. A normal user rarely produces this volume of external authentication events in such a short window."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.002"
    mitre_technique_name = "Brute Force: Password Cracking"
    log_prerequisites = "Requires identity provider sign-in logs (e.g. Entra ID, Okta, ADFS) normalized to UDM USER_LOGIN with target.user.userid and principal.ip populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Users behind corporate VPN or proxy egress addresses that are not in the internal ranges, mobile clients with aggressive token refresh, unlisted service or automation accounts, SSO-integrated applications re-authenticating repeatedly, authorized penetration tests."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, privileged admins to %global_allowed_admin_users, and approved testing sources to %global_allowed_scanners. Raise the #auth threshold for tenants with noisy token-refresh behaviour. Review the distinct_source_ips outcome: many unique IPs for one account strongly suggest credential reuse after cracking."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid != ""
    $auth.principal.ip != ""
    $auth.target.user.userid = $user
    not $auth.principal.ip in %rfc1918_internal
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_scanners

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1110.002")
    $primary_entity = array_distinct($user)
    $login_count = count($auth.metadata.id)
    $distinct_source_ips = array_distinct($auth.principal.ip)
    $target_applications = array_distinct($auth.target.application)

  condition:
    #auth >= 10
}
