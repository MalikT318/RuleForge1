/*
  MITRE Technique : T1608.002 - Upload Tool
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:22:26.495854+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_002_Tool_Download_From_IP_Literal_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client fetching an executable, script, library or archive over HTTP from an external server addressed by a bare IP literal in the URL instead of a domain name. This is the network-observable footprint of a tool staged on adversary-controlled infrastructure (T1608.002) being pulled into the environment. Legitimate software distribution almost always uses named, certificate-backed hosts."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.002"
    mitre_technique_name = "Stage Capabilities: Upload Tool"
    log_prerequisites = "Requires firewall or web proxy logs normalised to NETWORK_HTTP with target.url populated. TLS-inspecting or cleartext-visible traffic is needed to see the full URL path."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal or partner software distribution by IP address, IoT or OT vendor firmware and update servers addressed by IP, legacy appliances that fetch updates from hard-coded IPs, developers testing against ad-hoc servers, and authorised penetration tests."
    tuning_guidance = "Add known-good external update hosts to %global_allowed_domains (matched on target.hostname, which holds the IP string for IP-literal URLs). Add authorised testing sources to %global_allowed_scanners. Trim the extension list (for example drop zip or sh) if the environment is noisy. Optionally add a response-code filter (network.http.response_code >= 200 and < 300) if the log source populates it reliably."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.target.url = /^https?:\/\/(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?\/[^?#]*\.(exe|dll|msi|ps1|psm1|bat|vbs|hta|jar|elf|bin|sh|zip|7z|rar)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1608.002")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
