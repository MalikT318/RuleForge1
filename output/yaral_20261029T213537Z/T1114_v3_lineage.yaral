/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:08:39.049020+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_Linux_Service_Parent_Spawns_Shell_Accessing_Mailstore {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell or script interpreter whose command line references local mail storage (mbox spools, Maildir, IMAP/virtual mail stores, PST/OST archives). These services do not normally launch interpreters that read mailboxes, so this lineage points to a web shell or exploited service collecting email."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records that populate parent and child process paths and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Webmail applications (for example PHP-based webmail) that call shell helpers against mail stores, mail-migration or mailbox-quota scripts launched from an application server, database-driven mail administration panels, and backup or maintenance jobs triggered by a service parent."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling paths to %global_allowed_admin_tools. If webmail or mail administration software legitimately spawns helpers, allowlist its parent process path. Broaden or narrow the parent list (for example remove java or node) to match the customer's application estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*-fpm|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|csh|tcsh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\/var\/(spool\/)?mail\/|\/var\/vmail|\/var\/spool\/postfix|\/var\/lib\/dovecot|\/Maildir\b|\/\.maildir\b|\/home\/[^\/]+\/(Maildir|mail|\.thunderbird)\b|\.mbox\b|\.pst\b|\.ost\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
