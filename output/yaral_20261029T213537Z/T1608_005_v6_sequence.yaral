/*
  MITRE Technique : T1608.005 - Link Target
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:29:41.340701+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_005_Lookalike_Domain_Resolved_Then_Credential_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the network-observable footprint of a staged phishing link target. An internal client resolves a hyphenated, credential-themed domain, then within 10 minutes submits an HTTP POST to a login-style URL on that same domain. The domain must not be in the known-good list. This sequence indicates a user followed a link to an adversary-hosted credential-harvesting page."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.005"
    mitre_technique_name = "Stage Capabilities: Link Target"
    log_prerequisites = "Requires perimeter or proxy logs that populate both NETWORK_DNS (question name) and NETWORK_HTTP (method, target hostname, target URL), with a consistent principal.ip across both. TLS-intercepting proxy or equivalent visibility is needed to see HTTP method and URL on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS or SSO vendors that use hyphenated login hostnames (for example regional or tenant-specific sign-in portals), partner or customer portals, newly onboarded third-party authentication services, and security awareness phishing simulations."
    tuning_guidance = "Add known-good vendor and SSO domains to %global_allowed_domains. Add authorised phishing-simulation infrastructure to %global_allowed_scanners if it is sourced from known addresses. Adjust the keyword list in the DNS regex to suit the client's brand and SSO vocabulary. Raise severity when the destination is also first-seen in the environment."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)((login|signin|sso|auth|verify|secure|account|webmail|portal)[a-z0-9]*-|-[a-z0-9]*(login|signin|sso|auth|verify|secure|account|webmail|portal))/
    not $dns.network.dns.questions.name in %global_allowed_domains
    $dns.principal.ip = $src_ip
    $dns.network.dns.questions.name = $domain

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /(login|signin|logon|auth|verify|password|account|session)/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    $http.principal.ip = $src_ip
    $http.target.hostname = $domain

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip, $domain over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608.005")
    $primary_entity = array_distinct($src_ip)
    $suspect_domain = array_distinct($domain)
    $post_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $post_count = count($http.metadata.id)

  condition:
    $dns and $http
}
