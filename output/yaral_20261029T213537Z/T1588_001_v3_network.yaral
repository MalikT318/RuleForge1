/*
  MITRE Technique : T1588.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:54:34.653449+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_001_Direct_To_IP_Executable_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal client retrieving an executable or script payload (PE, installer, script, archive-style loader) over HTTP(S) from an external server addressed by a raw IP literal rather than a domain name. This is a network-side indicator that malware or post-compromise tooling acquired by an adversary is being pulled from staging infrastructure. Legitimate software distribution almost always uses named, reputable domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.001"
    mitre_technique_name = "Obtain Capabilities: Malware"
    log_prerequisites = "Requires web proxy or firewall logs with URL inspection, normalised to NETWORK_HTTP with target.url populated. Plain NETWORK_CONNECTION logs without URL visibility will not trigger this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal or lab software distribution by IP address, IoT/OT firmware updates fetched from vendor IP endpoints, developers testing build artefacts on external hosts, and legacy update mechanisms that use hard-coded IP addresses."
    tuning_guidance = "Add known-good external update or distribution hostnames to %global_allowed_domains. Review the URL and destination in the alert; repeated hits from one source toward the same IP warrant escalation. Consider raising severity if the HTTP response is a successful download and the extension is a PE or script type."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?\/[^?#]*\.(exe|dll|msi|scr|bat|cmd|ps1|vbs|hta|jar|apk|elf|bin|sh)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1588.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
