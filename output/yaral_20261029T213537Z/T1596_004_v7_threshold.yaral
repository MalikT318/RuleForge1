/*
  MITRE Technique : T1596.004 - CDNs
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:06:19.280892+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_004_CDN_Asset_Enumeration_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Low"
    description = "Detects a single external source generating a high volume of failed HTTP requests (4xx or 5xx) against CDN-style static content paths within ten minutes. T1596.004 itself (lookups against third-party CDN data) is not visible to the victim. This rule detects the observable follow-on behaviour: enumerating CDN-fronted or origin asset paths to find misconfigured or leaked content. Individual 404s are benign. The volume from one source is not."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.004"
    mitre_technique_name = "Search Open Technical Databases: CDNs"
    log_prerequisites = "Requires network security appliance or inline sensor logs that normalise HTTP transactions to NETWORK_HTTP, with principal.ip, target.url and network.http.response_code populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime or synthetic monitors, broken front-end deployments referencing missing assets, external penetration tests, and CDN or WAF health probes."
    tuning_guidance = "Add authorised scanners and crawlers to %global_allowed_scanners. Add approved management or monitoring sources to %global_allowed_mgmt_sources. Raise the #http threshold for high-traffic sites, or extend the static-path regex to match the customer's asset path conventions."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.ip = $src
    not $http.principal.ip in %rfc1918_internal
    $http.target.url = /\/(static|assets|cdn|media|content|uploads|public|images|img|js|css|fonts|downloads|backup|bucket)(\/|$)/ nocase
    $http.network.http.response_code >= 400
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1596.004")
    $primary_entity = array_distinct($src)
    $request_count = count($http.metadata.id)
    $distinct_urls = count_distinct($http.target.url)
    $sample_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    #http >= 30
}
