/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:18:50.527748+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_Linux_WebServer_Spawns_Shell_Writing_WebRoot {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server or web application runtime process (apache, nginx, httpd, php-fpm, lighttpd, caddy) spawning a shell or script interpreter whose command line writes to, overwrites, or downloads content into a web document root. This lineage anomaly is a strong indicator of external website defacement via a web shell or exploited web application."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path, child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CMS or framework update mechanisms (for example plugin or theme installers run through PHP), web-based deployment hooks, cache or static-site generators that shell out to write into the document root, and hosting control panels."
    tuning_guidance = "Add legitimate deployment or CMS-update parent process paths and build hosts to %global_allowed_script_hosts. Extend the document-root regex if the client uses non-standard web roots. Consider also adding approved deployment tooling to %global_allowed_admin_tools as a child-process exclusion if required."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|php-cgi|lighttpd|caddy)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|php[0-9.]*|ruby)$/ nocase
    $proc.target.process.command_line = /(\/var\/www|\/srv\/(www|http)|\/usr\/share\/nginx|\/usr\/local\/apache2\/htdocs|\/htdocs|\/public_html|\/wwwroot)/ nocase
    $proc.target.process.command_line = /(>|>>|\btee\b|\bsed\s+-i|\bcp\b|\bmv\b|\bwget\b|\bcurl\b|\bdd\b|\bbase64\s+-d|\binstall\b|\bprintf\b|\becho\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
