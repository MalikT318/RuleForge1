/*
  MITRE Technique : T1584 - Compromise Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:16:47.355578+00:00
  Reference       : https://attack.mitre.org/techniques/T1584
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_DNS_Tunnel_TXT_Then_LongLabel_Same_Domain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single client issues a TXT or NULL DNS query with an abnormally long subdomain label, then within 10 minutes issues A/AAAA queries with long labels to the same parent domain. This pattern is typical of DNS-based C2 or staging through attacker-controlled or compromised third-party domains and DNS infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584"
    mitre_technique_name = "Compromise Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with client IP (principal.ip), network.dns.questions.name and network.dns.questions.type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services using long hashed labels, DKIM/SPF/TXT lookups by mail security gateways, anti-spam DNSBL lookups, antivirus cloud lookups using encoded labels, and DNS-based licensing or telemetry from software vendors."
    tuning_guidance = "Add known-good parent domains (two-label form, e.g. example.com) to %global_allowed_domains. Adjust the label length threshold (35) to suit the client's baseline. For multi-part public suffixes (e.g. co.uk) refine the domain capture regex. Consider excluding mail gateway resolvers by client IP at the log-ingestion layer."

  events:
    $txt.metadata.event_type = "NETWORK_DNS"
    ($txt.network.dns.questions.type = 16 or $txt.network.dns.questions.type = 10)
    $txt.network.dns.questions.name = /(^|\.)[a-z0-9_-]{35,}\./ nocase
    $txt.principal.ip = $client
    $domain = re.capture($txt.network.dns.questions.name, `([^.]+\.[^.]+)\.?$`)
    not $domain in %global_allowed_domains

    $addr.metadata.event_type = "NETWORK_DNS"
    ($addr.network.dns.questions.type = 1 or $addr.network.dns.questions.type = 28)
    $addr.network.dns.questions.name = /(^|\.)[a-z0-9_-]{35,}\./ nocase
    $addr.principal.ip = $client
    $domain = re.capture($addr.network.dns.questions.name, `([^.]+\.[^.]+)\.?$`)

    $txt.metadata.event_timestamp.seconds <= $addr.metadata.event_timestamp.seconds

  match:
    $client, $domain over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1584")
    $primary_entity = array_distinct($client)
    $suspect_domain = array_distinct($domain)
    $txt_query_names = array_distinct($txt.network.dns.questions.name)
    $addr_query_count = count($addr.metadata.id)

  condition:
    $txt and $addr
}
