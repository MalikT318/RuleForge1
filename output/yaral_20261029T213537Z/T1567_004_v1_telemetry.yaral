/*
  MITRE Technique : T1567.004 - Exfiltration Over Webhook
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:49:23.666833+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_004_SaaS_Webhook_Configuration_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of an outbound webhook or incoming-hook integration in a SaaS tenant, taken from the audit-log configuration change rather than any endpoint command line. An adversary with a compromised account can use a webhook to push repository, mail, chat or ticket data to an external endpoint they control, giving repeated automated exfiltration. Deletion, removal and disable actions are excluded. Approved service accounts, admin users, cloud principals and known-good destination domains are excluded through reference lists."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.004"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration Over Webhook"
    log_prerequisites = "SaaS or cloud control-plane audit logs normalised to UDM SETTING_MODIFICATION, with metadata.product_event_type populated with the native audit action name (e.g. a hook/webhook create or update action)."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Developers or project admins wiring up CI/CD, chat notifications, ticketing or monitoring integrations; IT onboarding of approved SaaS-to-SaaS automation; service accounts managing integrations through infrastructure-as-code."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named integration admins to %global_allowed_admin_users. Add approved destination hosts to %global_allowed_domains. If a tenant's audit action names differ, adjust the product_event_type regex per log source. Raise severity for tenants where webhooks should never be created outside change windows."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(web_?hook|incoming_?hook|outgoing_?hook|hook\.|hooks\.|_hook_|\.hook)/ nocase
    $setting.metadata.product_event_type = /(creat|add|updat|modif|edit|enabl|regist|config|set)/ nocase
    not $setting.metadata.product_event_type = /(delet|remov|disabl|destroy|revok)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_cloud_principals
    not $setting.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567.004")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $actor_ip = array_distinct($setting.principal.ip)
    $audit_action = array_distinct($setting.metadata.product_event_type)
    $changed_resource = array_distinct($setting.target.resource.name)
    $destination_host = array_distinct($setting.target.hostname)

  condition:
    $setting
}
