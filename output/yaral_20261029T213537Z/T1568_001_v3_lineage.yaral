/*
  MITRE Technique : T1568.001 - Fast Flux DNS
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:50:39.161997+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_001_Linux_Service_Parent_Spawns_DNS_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process launching a DNS lookup utility directly, or a shell that runs DNS resolution commands. These service processes have no legitimate reason to resolve names through command-line tools. When it happens, it usually means a webshell, injected code or a compromised service is repeatedly resolving a flux domain to find the current C2 address. Detection depends on the unexpected parent-to-child lineage, not on the command line alone."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.001"
    mitre_technique_name = "Dynamic Resolution: Fast Flux DNS"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process telemetry normalised to UDM PROCESS_LAUNCH with populated principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legacy CGI or PHP monitoring scripts that call dig/nslookup/host for health checks; database maintenance or replication scripts launched from the database service that check DNS; application diagnostics pages that shell out to resolver utilities; deployment hooks run by a service user."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts. Add approved monitoring or admin tooling to %global_allowed_admin_tools. Add authorised scanning sources to %global_allowed_scanners. If a client runs additional service runtimes that should never resolve names via CLI, extend the parent regex for that client only."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|mysqld|mariadbd|postgres|mongod|redis-server|tomcat[0-9]*)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(dig|nslookup|host|drill|getent|resolvectl|systemd-resolve)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(bash|dash|sh|zsh|ash|ksh|csh|tcsh)$/ nocase
        and $proc.target.process.command_line = /\b(dig|nslookup|host|drill|resolvectl|systemd-resolve|getent\s+(ahosts|ahostsv4|hosts))\b/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1568.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
