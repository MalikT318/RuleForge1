/*
  MITRE Technique : T1684.002 - Email Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:43:59.862556+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_002_Linux_Server_Process_Spawns_Mail_With_Sender_Override {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, or database service process spawning a mail client or shell that sends email with an overridden sender (envelope-from flag or forged From header). Server-side processes do not normally set an arbitrary sender identity, so this lineage suggests a compromised web application or service being used to spoof email."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.002"
    mitre_technique_name = "Email Spoofing"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (with full command line) normalised to UDM PROCESS_LAUNCH, including parent process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications (contact forms, CMS, ticketing, or newsletter plugins) that legitimately set a From address through a local MTA; database or monitoring alert scripts that send mail with a custom sender; application servers sending notifications through sendmail wrappers."
    tuning_guidance = "Add approved application parent processes to %global_allowed_script_hosts and legitimate mailer service accounts to %global_allowed_service_accounts. Add approved mail automation binaries to %global_allowed_admin_tools. If a web app legitimately sends mail with a fixed sender, allowlist its service account rather than loosening the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|php[0-9.]*|lighttpd|uwsgi|gunicorn|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod)$/ nocase
    $proc.target.process.file.full_path = /\/(sendmail|sendmail\.postfix|sendmail\.sendmail|mail|mailx|s-nail|mutt|msmtp|ssmtp|sh|bash|dash)$/ nocase
    $proc.target.process.command_line = /(\b(sendmail|mailx?|s-nail|mutt|msmtp|ssmtp)\b.*\s-(f|r|-from)[\s=]*\S+|\bfrom:\s*[^\s@]+@[^\s@]+|my_hdr\s+from:|-S\s+from=)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1684.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $account = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
