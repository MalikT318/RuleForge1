/*
  MITRE Technique : T1584.008 - Network Devices
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:32:11.999476+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_008_Outbound_To_External_Edge_Device_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external address on service ports typical of SOHO routers and edge network devices (telnet, alternate telnet, TR-069, Winbox, SOCKS, Realtek SDK). Compromised third-party network devices are used as relays, proxies, payload hosts or C2 hops, and this is the network-side signal of that use. Internal destinations are excluded with a reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.008"
    mitre_technique_name = "Compromise Infrastructure: Network Devices"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs with populated principal.ip, target.ip and target.port. Direction should be populated, and the sensor should sit on the egress path."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Administrators legitimately managing remote customer or vendor network devices, authorised external vulnerability or penetration-test sources, partner or supplier remote-support tunnels, legacy telnet-based business applications, approved SOCKS proxy use, and ISP or MSP TR-069 provisioning."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources, authorised scanner addresses to %global_allowed_scanners, and approved automation or egress addresses to %global_allowed_remote_mgmt. Narrow or extend the port list per client. Raise severity for hosts that are not network or IT administration systems."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    (
      $net.target.port = 23 or
      $net.target.port = 2323 or
      $net.target.port = 7547 or
      $net.target.port = 8291 or
      $net.target.port = 1080 or
      $net.target.port = 37215
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_remote_mgmt
    not $net.target.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.008")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
