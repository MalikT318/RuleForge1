/*
  MITRE Technique : T1590.001 - Domain Properties
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:13:32.321727+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_001_External_Domain_Property_Endpoint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting identity and domain-discovery endpoints (federation or realm lookups, autodiscover, OpenID and federation metadata) on an organisation's web or identity-facing services. Adversaries use these public endpoints to learn domain properties such as federation status, managed vs federated realm, and tenant naming before targeting. The rule is network-side: it looks at HTTP requests seen by an inline IDS/IPS or network security appliance and does not depend on endpoint telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.001"
    mitre_technique_name = "Gather Victim Network Information: Domain Properties"
    log_prerequisites = "IDS/IPS or network security appliance with HTTP/URL visibility (decrypted or reverse-proxy inspected traffic) normalised to UDM NETWORK_HTTP with principal.ip and target.url populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate mail clients and mobile devices performing autodiscover; SaaS onboarding and identity-federation partners; SSO and OIDC relying parties reading metadata; external vulnerability scanners and attack-surface-management services; search-engine and uptime crawlers."
    tuning_guidance = "Add authorised scanner and ASM source IPs to %global_allowed_scanners. If the appliance only logs inbound traffic to published services, keep %rfc1918_internal as is. If autodiscover traffic from mail clients is noisy, scope the rule to hosts that do not publish mail services, or raise severity only when the same source also appears in other recon rules. Consider correlating by source IP in SOAR before escalating."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(getuserrealm\.srf|\/common\/userrealm\/|\/autodiscover\/autodiscover\.(xml|json)|\/_autodiscover\/|\.well-known\/(openid-configuration|autodiscover)|\/federationmetadata\/|\/adfs\/ls\/idpinitiatedsignon)/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1590.001")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
