/*
  MITRE Technique : T1592.001 - Hardware
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:35:26.486735+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_001_External_Hardware_Fingerprint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting hardware and device-information endpoints (out-of-band management, device-info and hardware-inventory URL paths) on internet-facing web services. This is network-side evidence of hardware fingerprinting during reconnaissance. It is based on the observed HTTP request and does not depend on endpoint process telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.001"
    mitre_technique_name = "Gather Victim Host Information: Hardware"
    log_prerequisites = "Requires perimeter firewall, reverse proxy or web gateway logs that parse into NETWORK_HTTP with target.url and principal.ip populated, covering inbound traffic to internet-facing services."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface management services; internet-wide exposure survey crawlers; third-party monitoring or vendor support that legitimately queries device status pages; administrators reaching management interfaces from outside the corporate range."
    tuning_guidance = "Add authorised scanner and attack-surface-management source addresses to %global_allowed_scanners. Add approved administrator or support source addresses to %global_allowed_mgmt_sources. Management interfaces that are exposed to the internet should be remediated, not allowlisted. To reduce noise, require a successful HTTP response code or raise the risk score for repeated hits from one source."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(redfish\/v1|ipmi|hwinfo|sysinfo|deviceinfo|device_info|device-info|hardware[_-]?info|system[_-]?info|cgi-bin\/(hwinfo|sysinfo|deviceinfo|system_info)|api\/(v[0-9]+\/)?(system|device|hardware)(\/|[_-]?info)|SDK\/deviceInfo|ISAPI\/System\/deviceInfo|dev\.rsp|device\.rsp)/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1592.001")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
