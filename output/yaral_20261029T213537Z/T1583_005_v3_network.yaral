/*
  MITRE Technique : T1583.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:07:14.640478+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_005_DNS_DGA_Style_Botnet_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for names with a very long, random-looking leftmost label containing long consonant runs. This is characteristic of algorithmically generated domains used by leased or acquired botnets and ORB-style relay networks for rendezvous and C2. Queries whose answers resolve to internal address space and queries for allow-listed domains are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.005"
    mitre_technique_name = "Acquire Infrastructure: Botnet"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Answer data (network.dns.answers.data) is used only to exclude internal resolutions."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services using long hashed hostnames, DNS-based blocklist and reputation lookups, email authentication and anti-spam lookups, software update and telemetry endpoints, content-addressed storage hostnames, security vendor cloud lookups."
    tuning_guidance = "Add known-good domains to %global_allowed_domains. The list is matched against the full queried name, so include the specific noisy hostnames. Raise the label length threshold (currently 24 characters) in noisy environments. Review the matched domain and the requesting client IP, and pivot to endpoint telemetry on that client."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9]{24,}\.[a-z0-9-]{2,63}\.?[a-z]{2,24}\.?$/ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz]{5,}/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.005")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
