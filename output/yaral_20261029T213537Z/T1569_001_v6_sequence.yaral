/*
  MITRE Technique : T1569.001 - Launchctl
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:52:31.585403+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_001_Launchd_Plist_Dropped_Then_Launchctl_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A launchd property list is written to a LaunchAgents or LaunchDaemons directory, then launchctl loads or bootstraps a plist on the same host within 10 minutes. This sequence is typical of an adversary staging a Launch Agent or Daemon and using launchctl to execute it."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.001"
    mitre_technique_name = "System Services: Launchctl"
    log_prerequisites = "macOS endpoint telemetry that provides both file creation events (with the creating process) and process launch events with full command lines."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Software installers and updaters, MDM and device management agents, IT deployment scripts, and developers installing local services (for example via package managers)."
    tuning_guidance = "Add approved installers, MDM and deployment binaries to %global_allowed_admin_tools. This list is applied to the process that writes the plist and to the parent of launchctl. Add approved remote management tooling to %global_allowed_remote_mgmt. For noisy fleets, narrow the file path regex to /Library/LaunchDaemons only."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/Users\/[^\/]+)?\/Library\/Launch(Agents|Daemons)\/[^\/]+\.plist$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/launchctl$/ nocase
    $proc.target.process.command_line = /\b(load|bootstrap)\b.*\.plist/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $plist_paths = array_distinct($file.target.file.full_path)
    $launchctl_commands = array_distinct($proc.target.process.command_line)
    $plist_writer_processes = array_distinct($file.principal.process.file.full_path)
    $launchctl_parents = array_distinct($proc.principal.process.file.full_path)

  condition:
    $file and $proc
}
