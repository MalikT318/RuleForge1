/*
  MITRE Technique : T1608.006 - SEO Poisoning
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:31:23.143518+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_006_SEO_Poisoned_Search_Referral_To_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client fetching an executable, installer, script or archive from an external site where the HTTP referrer is a search results page (the URL carries a search query parameter). This is the victim-side, network-observable result of SEO poisoning, where a search lure leads to a payload download. The rule matches the referrer and download pattern, not specific search engines or attacker sites."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.006"
    mitre_technique_name = "Stage Capabilities: SEO Poisoning"
    log_prerequisites = "Requires perimeter or proxy HTTP logs normalised to NETWORK_HTTP with target.url and network.http.referral_url populated. HTTPS traffic needs TLS inspection to expose the URL and referrer; without it the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users legitimately downloading software, installers or documents from vendor sites reached via a search engine; developers fetching archives or packages after searching; IT staff searching for drivers or tools; in-site search pages on download portals."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains (matched against target.hostname). Narrow or widen the download extension list for your client's software policy. Raise severity where the client has TLS inspection and strict software-install controls. Pair with proxy category or reputation enrichment for newly registered or low-reputation destinations."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.referral_url = /[?&](q|query|search_query|searchterm|wd|text)=[^&]+/ nocase
    $http.target.url = /\.(exe|msi|msix|iso|img|dmg|pkg|zip|rar|7z|js|vbs|scr|jar|apk)([?#]|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.006")
    $primary_entity = array_distinct($http.principal.ip)
    $download_urls = array_distinct($http.target.url)
    $referrer_urls = array_distinct($http.network.http.referral_url)
    $destination_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
