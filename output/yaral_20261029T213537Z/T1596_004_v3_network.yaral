/*
  MITRE Technique : T1596.004 - CDNs
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:05:07.838447+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_004_CDN_Misconfiguration_Probing_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects external clients sending web requests to organisation-facing content endpoints that probe for CDN or object-storage misconfigurations: bucket-style listing query parameters (list-type, max-keys, delimiter) and requests for sensitive configuration or credential files that are commonly exposed on mis-scoped content origins. This is the only part of CDN data harvesting visible from the victim side. Passive lookups against third-party CDN datasets cannot be observed and are out of scope."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.004"
    mitre_technique_name = "Search Open Technical Databases: CDNs"
    log_prerequisites = "Requires IDS/IPS or network security appliance HTTP inspection with the request URL (target.url) and external source address (principal.ip) populated in UDM NETWORK_HTTP events. Detection is based on request content, not on the allow/block verdict."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability or attack-surface scanners not yet in the allowlist, legitimate S3-compatible clients and sync tools that list content with list-type or max-keys parameters, search engine and SEO crawlers requesting well-known files, and partner integrations that enumerate hosted assets."
    tuning_guidance = "Add authorised scanner and attack-surface-management source addresses to %global_allowed_scanners. If a client legitimately serves bucket-style listings, scope exclusions by source address. Consider aggregating by principal.ip in a Threshold variant to raise fidelity in high-noise environments. Raise severity for sources that also appear in other reconnaissance detections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /([?&](list-type=\d|max-keys=\d+|delimiter=)|\/\.git\/|\/\.env($|\?)|\/\.aws\/credentials|\/\.htpasswd|\/\.svn\/|\/web\.config(\.bak|\.old)?($|\?))/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1596.004")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
