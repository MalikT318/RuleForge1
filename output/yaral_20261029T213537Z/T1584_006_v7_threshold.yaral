/*
  MITRE Technique : T1584.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:29:23.180989+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_006_Repeated_External_Web_Service_POST_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host sends a high volume of HTTP POST requests to one external, non-allowlisted web-service domain within ten minutes. Any single request is benign, but the sustained volume to one third-party service fits beaconing or data staging through a compromised legitimate web service (T1584.006) that is later used for C2 or exfiltration. This is the network-observable footprint of adversary-controlled web service infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.006"
    mitre_technique_name = "Compromise Infrastructure: Web Services"
    log_prerequisites = "Requires perimeter firewall or web proxy logs normalised to UDM NETWORK_HTTP with principal.hostname, target.hostname, target.ip and network.http.method populated. SSL inspection or proxy visibility is needed to see HTTP method and host."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "SaaS sync clients (cloud storage, collaboration tools), browser telemetry, software update and licensing agents, API-driven business applications, monitoring agents posting to vendor endpoints, and chat or webhook integrations."
    tuning_guidance = "Add known-good SaaS and vendor domains to %global_allowed_domains. If firewall logs do not populate principal.hostname, map the client asset name at ingestion. Raise the #http threshold in high-volume environments. Review the destination_domains and request_count outcome values to separate sync clients from beaconing."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.principal.hostname = $host
    $http.target.hostname = $dest
    $http.target.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_mgmt_sources

  match:
    $host, $dest over 10m

  outcome:
    $risk_score = max(55)
    $request_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1584.006")
    $primary_entity = array_distinct($host)
    $destination_domains = array_distinct($dest)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 20
}
