/*
  MITRE Technique : T1588.003 - Code Signing Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:58:49.768809+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_003_Code_Signing_Key_Material_Transfer_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single internal source making repeated external web requests for private-key or certificate container files (PFX, P12, PVK, SPC) within ten minutes. T1588.003 happens outside the victim's visibility, so this rule covers only the observable edge: a host staging, buying or pulling code-signing key material across the perimeter. One request is routine; a burst from one source is not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.003"
    mitre_technique_name = "Obtain Capabilities: Code Signing Certificates"
    log_prerequisites = "Requires perimeter or proxy HTTP logs that populate target.url and principal.ip. TLS inspection is needed to see URL paths on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers or build systems fetching signing certificates from vendor or internal portals, PKI enrolment and renewal workflows, MDM or VPN certificate provisioning, and IT staff distributing client certificates."
    tuning_guidance = "Add approved vendor and PKI distribution domains to %global_allowed_domains. If the build or PKI team uses a fixed egress, add that source to %global_allowed_mgmt_sources. Raise the #http threshold for environments with heavy certificate automation."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(pfx|p12|pvk|spc)(\?.*)?$/ nocase
    $http.principal.ip = $src
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1588.003")
    $primary_entity = array_distinct($src)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    #http >= 3
}
