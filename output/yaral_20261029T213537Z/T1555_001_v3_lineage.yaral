/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:40:03.044932+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Keychain_Access_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the macOS security utility running a keychain credential-retrieval subcommand when its parent is a process that should never handle keychain secrets. Such parents include Office applications, browsers, mail clients, web or application servers, database services, the print daemon, and scripting interpreters such as osascript, python, ruby, perl, php, node and java. Lineage is the primary signal. This is typical of a macro, a web shell, a malicious script or a compromised service harvesting Login or System Keychain credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "macOS endpoint telemetry that populates the parent process path (principal.process.file.full_path), child process path and command line for process launch events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developer or build tooling (python, ruby, node, java) that calls security to read signing identities or certificates; IT automation and MDM scripts run via interpreters that unlock or export keychain items; browser or Office helper features that legitimately query the keychain; admin troubleshooting."
    tuning_guidance = "Add approved parent interpreters, build agents and automation to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users. If developer fleets generate noise, scope the interpreter alternatives of the parent regex per client rather than removing the Office, browser and server parents."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/security$/ nocase
    $proc.target.process.command_line = /\b(dump-keychain|find-generic-password|find-internet-password|export|unlock-keychain|import)\b/ nocase
    $proc.principal.process.file.full_path = /\/Contents\/MacOS\/(Microsoft (Word|Excel|PowerPoint|Outlook)|Safari|Google Chrome|firefox|Mail|Preview)$|\/(osascript|python[0-9.]*|ruby|perl|php|node|java|httpd|nginx|php-fpm|mysqld|postgres|cupsd)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
