/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:23:44.424910+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_Linux_Service_Parent_Spawns_Account_Lockout {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, database, print or file-sharing service process spawning a shell, script interpreter or account-management utility that deletes, locks, expires or resets local accounts (userdel, usermod -L, passwd -l/-d, chpasswd, chage -E). Service daemons do not normally manage local accounts, so this lineage points to web shell, injection or RCE activity used to remove legitimate user access (T1531)."
    mitre_tactic = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "Linux EDR or auditd (execve / SYSCALL records) populating parent and child process paths and the child command line for process launch events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hosting control panels or web-based admin tools that provision and deprovision local users, database or application installers that create and remove service accounts, configuration management agents launched from a service context, and identity-sync scripts invoked by a service daemon."
    tuning_guidance = "Add legitimate provisioning parents or tooling to %global_allowed_admin_tools, approved parent processes to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Extend the parent regex with additional service daemons for the environment (for example application servers run as java or node)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|catalina|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd|nmbd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|ash|python[0-9.]*|perl|php|ruby|usermod|userdel|deluser|passwd|chpasswd|chage)$/ nocase
    $proc.target.process.command_line = /(^|[\s;|&`(\/])(userdel|deluser|chpasswd|usermod\s.*(-L\b|--lock|--expiredate|-e\s|-s\s+\S*(nologin|false)|--shell\s+\S*(nologin|false))|passwd\s+(-[a-z]*[ld]\b|--(lock|delete|expire))|chage\s.*(-E\b|--expiredate|-M\s+0))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
