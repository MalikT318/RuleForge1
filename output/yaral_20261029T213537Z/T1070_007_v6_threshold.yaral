/*
  MITRE Technique : T1070.007 - Clear Network Connection History and Configurations
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:03:31.833514+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_007_Network_Device_Connection_History_Clearing_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of management-plane configuration events on a network or perimeter device in which one administrator clears connection state, session tables, ARP/NAT translation tables, logging buffers or command history within ten minutes. A single clear command is routine troubleshooting. Repeated clearing by one account is consistent with an adversary removing traces of connections they made through the device."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.007"
    mitre_technique_name = "Indicator Removal: Clear Network Connection History and Configurations"
    log_prerequisites = "Requires firewall or perimeter device management-plane audit logs (admin command or configuration change events) normalised to UDM SETTING_MODIFICATION, with the executed command text populated in security_result.description and the administrator in principal.user.userid. Command accounting must be enabled on the device."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network engineers troubleshooting stuck sessions or NAT translations, change-window maintenance, post-failover cleanup, automated orchestration or configuration-management accounts, and log rotation scripts."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or orchestration accounts to %global_allowed_service_accounts. Raise the #setting threshold in noisy environments, or lower it to 2 for high-assurance perimeter devices. If the command text is mapped to a different UDM field in your parser, update the security_result.description references."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.security_result.description = /\b(clear|reset|flush|purge|erase)\s+(ip\s+)?(conn|connection|connections|session|sessions|xlate|nat|local-host|arp|logging|log|logs|audit|history|counters|flow|flows|state|statistics)\b|\bno\s+logging\b|\bhistory\s+(size\s+0|clear)\b/ nocase
    $setting.principal.user.userid = $user
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($setting.metadata.id)
    $mitre_technique_id = array_distinct("T1070.007")
    $primary_entity = array_distinct($user)
    $affected_devices = array_distinct($setting.target.hostname)
    $source_hosts = array_distinct($setting.principal.hostname)

  condition:
    #setting >= 3
}
