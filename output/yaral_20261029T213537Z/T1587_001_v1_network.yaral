/*
  MITRE Technique : T1587.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:47:56.415985+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_001_Raw_IP_HTTP_Post_NonBrowser_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP POST from an internal client to an external server addressed by a bare IPv4 literal, with a non-browser or missing User-Agent. Adversary-developed malware (custom implants, droppers, bespoke C2 protocols) often beacons or exfiltrates this way because it skips DNS and uses a minimal hand-written HTTP client. Development itself happens off-network, so this rule looks for the network behaviour of the finished tooling, and the result is a hunting-grade lead rather than proof of development."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.001"
    mitre_technique_name = "Develop Capabilities: Malware"
    log_prerequisites = "Requires forward or explicit proxy, or a firewall with HTTP inspection, that logs the full request URL, HTTP method, and User-Agent as NETWORK_HTTP events with target.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Appliance and IoT management agents that phone home to IP literals, in-house applications calling internal-facing services through public IPs, monitoring or health-check probes, software updaters using raw-IP mirrors, and developer or QA tooling hitting test servers."
    tuning_guidance = "Add authorised scanner or test sources to %global_allowed_scanners. Add known vendor destinations to %global_allowed_domains. If the proxy does not populate target.hostname for raw-IP requests, the domain exclusion is inert and has no effect. Raise severity for hosts that also show other beaconing or threat-intel hits. Consider restricting to specific client subnets where noise is high."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^(https?:\/\/)?([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]{1,5})?(\/|$)/ nocase
    not $net.network.http.user_agent = /^Mozilla\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1587.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
