/*
  MITRE Technique : T1589 - Gather Victim Identity Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:06:01.561283+00:00
  Reference       : https://attack.mitre.org/techniques/T1589
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_Auth_Endpoint_Identity_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source sends a high volume of POST requests to authentication, password-reset or user-realm discovery endpoints within ten minutes. Each request is benign on its own. The volume is consistent with username, valid-account or MFA-method enumeration used to gather victim identity information. Detection is by request pattern and rate, not by tool or infrastructure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589"
    mitre_technique_name = "Gather Victim Identity Information"
    log_prerequisites = "Requires perimeter proxy, WAF or reverse-proxy HTTP logs normalised to UDM NETWORK_HTTP, with principal.ip, target.url and network.http.method populated. network.http.response_code improves risk scoring but is not required."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Shared NAT or corporate egress gateways, partner or SSO federation integrations, load-testing and uptime monitors that hit login pages, mobile apps retrying authentication, and users behind carrier-grade NAT."
    tuning_guidance = "Add authorised scanners and monitoring sources to %global_allowed_scanners. Raise the #http threshold for high-traffic authentication portals, or lower it for low-volume ones. Narrow the URL regex to the client's actual login and reset paths if needed. Correlate with failed-login telemetry for confirmation."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(login|signin|sign-in|logon|sso|oauth|authenticate|auth\/|password|passwd|forgot|reset|recover|sspr|userrealm|getuserrealm|autodiscover|mfa|account\/verify|username)/ nocase
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($http.network.http.response_code >= 400, 70, 55))
    $mitre_technique_id = array_distinct("T1589")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($http.metadata.id)
    $targeted_hosts = array_distinct($http.target.hostname)
    $targeted_urls = array_distinct($http.target.url)

  condition:
    #http >= 20
}
