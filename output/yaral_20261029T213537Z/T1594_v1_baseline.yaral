/*
  MITRE Technique : T1594 - Search Victim-Owned Websites
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:48:01.592976+00:00
  Reference       : https://attack.mitre.org/techniques/T1594
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1594_Sensitive_Web_Resource_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting hidden or sensitive web resources on victim-owned sites: VCS and environment dotfiles, configuration and backup files, and server diagnostic endpoints. Legitimate users never browse to these paths, so a request to one indicates forced browsing or wordlist scanning to discover content for targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1594"
    mitre_technique_name = "Search Victim-Owned Websites"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs that parse HTTP requests into UDM NETWORK_HTTP with target.url populated (inline inspection or TLS-decrypted traffic)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and external attack-surface assessments, penetration tests, uptime or monitoring probes that request diagnostic endpoints, legitimate download of published archives, and search engine or security research crawlers."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners. Add monitoring sources to %global_allowed_mgmt_sources if they probe diagnostic endpoints. If a site publishes archive downloads, narrow the backup-archive branch of the URL regex. For noisy internet-facing sites, raise severity only when the same source is seen repeatedly, for example via a companion threshold variant."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD)$/ nocase
    $http.target.url = /(\/\.(git|svn|hg|env|aws|ssh|htpasswd|htaccess|ds_store|bash_history)(\/|$|\?))|(\/(wp-config|web|config|settings|database)\.(php|config|inc|ini|yml|json)(\.(bak|old|orig|txt|save|swp))?(\?|$))|(\/(backup|backups|db|dump|site|www|website|archive)[^\/?]*\.(zip|tar|tgz|gz|sql|bak|7z|rar)(\?|$))|(\/(phpinfo|server-status|server-info)(\.php)?(\?|$))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1594")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)

  condition:
    $http
}
