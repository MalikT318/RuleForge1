/*
  MITRE Technique : T1608.006 - SEO Poisoning
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:31:57.658824+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_006_SEO_Poisoning_Search_Referred_Payload_Downloads {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host makes several HTTP requests within ten minutes for downloadable payload or installer file types, where the referrer is a search results page identified by its query-string pattern. This is consistent with users being lured by SEO-poisoned results to attacker-staged download sites. One such download is common; repeated search-referred payload downloads from one host are not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.006"
    mitre_technique_name = "Stage Capabilities: SEO Poisoning"
    log_prerequisites = "Requires forward-proxy, secure web gateway or perimeter firewall logs with URL inspection that populate network.http.referral_url and target.url (NETWORK_HTTP). TLS inspection is needed to see full URLs for HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers or IT staff searching for and downloading legitimate software, drivers or installers from vendor sites not yet in the allowlist; software labs and QA hosts; help-desk staff fetching tools; users downloading documents (zip/iso) from legitimate sites found via search."
    tuning_guidance = "Add known-good vendor and download domains to %global_allowed_domains. Raise the #http threshold for developer or IT subnets, or narrow the file-extension regex to the types relevant to the client. If the client's proxy does not populate referral_url, this rule will not fire and should be disabled."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.referral_url = /[?&](q|query|search_query|wd|p|text)=/ nocase
    $http.target.url = /\.(exe|msi|iso|img|zip|rar|7z|scr|js|vbs|hta|dmg|apk)(\?|$)/ nocase
    $http.principal.hostname = $host
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.006")
    $primary_entity = array_distinct($host)
    $event_count = count($http.metadata.id)
    $destination_hosts = array_distinct($http.target.hostname)
    $download_urls = array_distinct($http.target.url)
    $referrers = array_distinct($http.network.http.referral_url)

  condition:
    #http >= 3
}
