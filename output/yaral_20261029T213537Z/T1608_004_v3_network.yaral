/*
  MITRE Technique : T1608.004 - Drive-by Target
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:26:54.458051+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_004_External_Write_Of_Web_Script_Content {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external source using a write-style HTTP method (PUT, MOVE, COPY) to place or alter script or web-page content (js, html, php, asp/aspx, jsp) on a web server, with a successful response. This is the network-visible footprint of an adversary staging drive-by content, such as injected JavaScript, on a web property."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.004"
    mitre_technique_name = "Stage Capabilities: Drive-by Target"
    log_prerequisites = "Requires perimeter, proxy or WAF logs normalised to NETWORK_HTTP with network.http.method, target.url, network.http.response_code and principal.ip populated. TLS-encrypted traffic must be inspected or terminated at the perimeter to expose the method and URL."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "CMS or web-publishing tools that deploy content over WebDAV or PUT; CI/CD pipelines pushing static site assets; hosting-provider or agency staff updating customer sites from external addresses; authorised penetration tests."
    tuning_guidance = "Add trusted publishing or deployment source addresses to %global_allowed_mgmt_sources and authorised testers to %global_allowed_scanners. If a client legitimately accepts uploads, add the upload hostnames to %global_allowed_domains. Where only a few hosts are in scope, add a target.hostname restriction."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|MOVE|COPY)$/ nocase
    $net.target.url = /\.(js|html?|php[0-9]?|aspx?|jsp|jspx)(\?.*)?$/ nocase
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608.004")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $written_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
