/*
  MITRE Technique : T1586.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:46:12.130900+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_003_Outbound_SMTP_Submission_To_External_Relay {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external mail-submission port (587, 465 or 2525). Compromised cloud messaging accounts (SMTP relay services, bulk email APIs) are abused for spam and phishing, and a workstation or server speaking authenticated SMTP submission directly to an external relay is the perimeter-visible result. Firewalls cannot see the pre-compromise account takeover itself, so this rule covers the observable use of such accounts from inside the client network."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.003"
    mitre_technique_name = "Compromise Accounts: Cloud Accounts"
    log_prerequisites = "Requires firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with source IP, destination IP and destination port populated. Egress logging must be enabled for permitted traffic, not just denied traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate mail servers or gateways relaying through a cloud email provider on the submission port, SaaS applications and multifunction devices that send notifications through an external relay, and user mail clients configured for a personal or third-party mailbox."
    tuning_guidance = "Add approved external mail relay and email provider domains to %global_allowed_domains. If the firewall does not resolve target.hostname, filter known mail gateway source addresses at the log pipeline level, or raise the severity only for non-server subnets. Port 25 is intentionally excluded because MTA-to-MTA delivery would generate excessive noise."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 587 or $net.target.port = 465 or $net.target.port = 2525)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1586.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
