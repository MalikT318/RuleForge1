/*
  MITRE Technique : T1584.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:28:29.536541+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_006_Scripted_Client_Write_To_External_Web_Service_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser, scripted HTTP client (command-line or library user agent) sending write-type requests (POST/PUT/PATCH) to API, upload, webhook or bot-style paths on an external web service not on the approved domain list. This is the network-side footprint of internal hosts using attacker-controlled or compromised third-party web service accounts (code hosting, storage, messaging, paste or mail APIs) for C2, staging or exfiltration. It is domain-agnostic: it keys on client behaviour and request shape, not on specific service names."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.006"
    mitre_technique_name = "Compromise Infrastructure: Web Services"
    log_prerequisites = "Requires proxy, secure web gateway or TLS-inspecting perimeter firewall logs that populate HTTP method, user agent and target URL or hostname as NETWORK_HTTP events. Without TLS inspection or proxy logging these fields will be empty and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate automation: CI/CD pipelines, backup and monitoring agents, SaaS integrations and developer scripts that call external APIs with curl or an HTTP library; software updaters and telemetry agents using library user agents; vulnerability scanners and approved testing sources."
    tuning_guidance = "Add approved SaaS and vendor API hostnames to %global_allowed_domains. Add known automation or build hosts to %global_allowed_script_hosts. Add sanctioned scanner sources to %global_allowed_scanners. If the volume is still high, raise the severity only for hosts that also appear in endpoint-side alerts, or narrow the URL path regex to the services relevant to the client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.network.http.user_agent = /(curl|wget|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|okhttp|java\/[0-9]|apache-httpclient|powershell|winhttp|node-fetch|axios)/ nocase
    $net.target.url = /\/(api|v[0-9]+|upload|uploads|webhook|webhooks|hooks|bot[a-z0-9:_-]*|messages|files|gists?|paste|contents)(\/|\?|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
