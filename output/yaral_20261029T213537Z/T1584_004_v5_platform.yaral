/*
  MITRE Technique : T1584.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:24:40.500666+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_004_Direct_IP_HTTP_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP/HTTPS request through the network perimeter to an external server addressed by raw IP with an explicit non-standard high port in the URL. Adversaries commonly stage payloads or run C2 from compromised third-party servers (T1584.004), and these servers are typically reached by bare IP on ephemeral ports with no DNS name. This is a network-observable heuristic, because the compromise of the third-party server itself is not visible to the defender."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.004"
    mitre_technique_name = "Compromise Infrastructure: Server"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url, target.ip and target.port populated. The proxy or firewall must perform URL logging (explicit proxy or TLS inspection) so the raw-IP URL is visible."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software vendors and updaters that serve content from bare IPs on high ports, IoT or camera cloud services, developer and test traffic to external lab servers, CDN or appliance health checks, external management portals reached by IP, and approved scanning or testing sources."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains, authorised scanning or testing sources to %global_allowed_scanners, and approved admin tooling hosts or jump hosts to %global_allowed_admin_tools. If noise remains, raise the port threshold or restrict the rule to specific client subnets."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}:\d{2,5}(\/|$)/ nocase
    $net.target.port > 1024
    $net.network.http.method = /^(GET|POST|PUT)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.hostname in %global_allowed_admin_tools

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1584.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
