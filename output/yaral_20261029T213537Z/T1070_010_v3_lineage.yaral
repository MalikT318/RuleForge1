/*
  MITRE Technique : T1070.010 - Relocate Malware
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:04:32.678475+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_010_Linux_Service_Parent_Spawns_File_Relocation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service process (web server, application runtime, database, cache or print service) directly spawning a file copy/move utility that places content into a world-writable, persistence or autostart location. Server daemons do not normally relocate files this way, so the lineage points to a web shell or exploited service staging or moving a payload to evade defenses."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.010"
    mitre_technique_name = "Indicator Removal: Relocate Malware"
    log_prerequisites = "Requires Linux EDR or auditd EXECVE/SYSCALL process telemetry normalised to PROCESS_LAUNCH with populated parent process path (principal.process.file.full_path), child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or CMS plugins that copy uploads or cache files to /tmp or /var/tmp via shell-outs, database maintenance or backup jobs launched by the database service (for example postgres archive_command), print services moving spool files, and deployment hooks run by the application server."
    tuning_guidance = "Add legitimate parent binaries or hosts to %global_allowed_script_hosts and approved deployment/maintenance tooling to %global_allowed_admin_tools. For noisy web hosts, narrow the destination regex to exclude application-specific cache directories. Extend the parent regex with in-house service daemon names where needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(cp|mv|install|rsync|dd)$/ nocase
    $proc.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/usr\/(local\/)?s?bin\/|\/etc\/cron|\/etc\/systemd\/|\/lib\/systemd\/|\/var\/spool\/cron|\/\.ssh\/|\/etc\/init\.d\/|\/etc\/profile\.d\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1070.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
