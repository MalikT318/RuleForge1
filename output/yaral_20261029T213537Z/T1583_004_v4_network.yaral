/*
  MITRE Technique : T1583.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:05:13.202693+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_004_Outbound_To_Self_Hosted_Server_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external address on a non-standard high port commonly used by self-hosted attacker infrastructure, such as C2 team servers, reverse shell listeners and ad-hoc relays. This is the network-observable result of an adversary standing up their own server (T1583.004). The acquisition itself happens outside the victim's visibility, so this rule only catches the server being used."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.004"
    mitre_technique_name = "Acquire Infrastructure: Server"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers and admins using alternate ports for SSH, VPN, remote support, game or test servers; peer-to-peer or chat applications; legitimate SaaS or vendor services on non-standard ports; authorised penetration tests."
    tuning_guidance = "Add approved scanner and pen-test source addresses to %global_allowed_scanners. Add approved management source addresses to %global_allowed_mgmt_sources. Add known-good external domains to %global_allowed_domains. Adjust the port list to the client's baseline, and consider suppressing noisy internal sources after review."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 4444 or
      $net.target.port = 4443 or
      $net.target.port = 1337 or
      $net.target.port = 31337 or
      $net.target.port = 6666 or
      $net.target.port = 6667 or
      $net.target.port = 9001 or
      $net.target.port = 2222 or
      $net.target.port = 5555 or
      $net.target.port = 8888 or
      $net.target.port = 50050
    )
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
