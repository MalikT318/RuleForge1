/*
  MITRE Technique : T1583.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:11:31.773664+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_007_Serverless_Function_Endpoint_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP(S) requests from an internal host to hostnames in the structural namespaces of public serverless function platforms (edge workers, function URLs, API gateway invoke endpoints, managed function runtimes). Adversaries use such endpoints as disposable redirectors or direct C2 responders so that traffic looks like ordinary cloud-provider traffic. Matching is on the platform hostname structure, not on any specific attacker-owned name."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.007"
    mitre_technique_name = "Acquire Infrastructure: Serverless"
    log_prerequisites = "Requires firewall or secure web proxy logs normalised to NETWORK_HTTP with target.hostname populated (TLS inspection or SNI logging enabled for HTTPS)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS and internal applications hosted on serverless platforms, developer and DevOps workstations calling their own functions, partner webhooks and APIs, and web apps that use cloud function backends."
    tuning_guidance = "Add sanctioned serverless destinations to %global_allowed_domains. Consider scoping the rule to non-developer subnets or user populations through your SIEM tenant configuration. Raise severity when the same source host contacts many distinct function hostnames or when the destination is first seen in the environment."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /(^|\.)(workers\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app)$/ nocase
    $http.principal.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.007")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
