/*
  MITRE Technique : T1052 - Exfiltration Over Physical Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:58:27.686959+00:00
  Reference       : https://attack.mitre.org/techniques/T1052
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_macOS_Removable_Volume_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process running from an external or removable volume mounted under /Volumes on macOS that opens an outbound connection to a non-internal address. Executables staged on removable media (USB drives, external disks, phone-backed storage) that then reach the internet indicate media-borne tooling being used to stage or exfiltrate data, or to bridge an otherwise isolated host. The boot volume (Macintosh HD and its Data volume) is excluded."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052"
    mitre_technique_name = "Exfiltration Over Physical Medium"
    log_prerequisites = "Requires macOS endpoint network telemetry that populates the originating process path on outbound connections (NETWORK_CONNECTION). Reference lists %rfc1918_internal, %global_allowed_admin_tools and %global_allowed_security_tools must exist in the tenant."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Applications launched directly from a mounted DMG (first-run installers, updaters, licence checks), portable apps run from external drives by users, IT imaging or deployment tools run from USB media, and backup or sync clients installed on external volumes."
    tuning_guidance = "Add approved tooling executables that legitimately run from external volumes to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. If the customer renames the boot volume to something other than 'Macintosh HD', extend the boot-volume exclusion regex. Consider raising severity where the host is in a high-security or air-gapped enclave."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/Volumes\/[^\/]+\/.+/ nocase
    not $net.principal.process.file.full_path = /^\/Volumes\/Macintosh HD/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1052")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
