/*
  MITRE Technique : T1569.001 - Launchctl
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:52:17.598537+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_001_macOS_Launchctl_Load_From_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects launchctl invoked by a shell or scripting interpreter to load, bootstrap, submit or start a job whose plist or target sits in a user-writable or staging location (tmp, var/folders, Users/Shared, hidden directories, or a per-user LaunchAgents folder). Adversaries use this to execute payloads as Launch Agents or Daemons without writing to the protected system plist directories."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.001"
    mitre_technique_name = "System Services: Launchctl"
    log_prerequisites = "macOS endpoint process-launch telemetry with full command line and parent process path populated, from EDR or unified log."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party installers and updaters that load per-user LaunchAgents from a shell script, developer tooling (Homebrew services, local dev daemons), MDM or admin scripts that stage plists in temporary folders before loading, and user-driven troubleshooting."
    tuning_guidance = "Add approved deployment or management parent binaries to %global_allowed_admin_tools, approved parent shells or script hosts to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. If per-user LaunchAgents are noisy in a developer-heavy tenant, remove that branch from the path regex and keep the temp and hidden-directory branches."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/launchctl$/ nocase
    $proc.target.process.command_line = /\b(load|bootstrap|submit|start|kickstart)\b/ nocase
    $proc.target.process.command_line = /(\/(private\/)?(tmp|var\/tmp|var\/folders)\/|\/Users\/Shared\/|\/dev\/shm\/|\/Users\/[^\/]+\/Library\/LaunchAgents\/|\/\.[^\/ ]+\/)/ nocase
    $proc.principal.process.file.full_path = /\/(bash|zsh|sh|dash|osascript|python[0-9.]*|perl|ruby|node)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $launchctl_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
