/*
  MITRE Technique : T1591.001 - Determine Physical Locations
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:27:39.120595+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_001_Location_Page_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Low"
    description = "A single external source makes a high volume of HTTP requests to location, office, facility or contact pages within 10 minutes. Each request is benign on its own, but the volume suggests scraping to collect victim physical-location information (T1591.001). Behavioural proxy only: physical-location gathering is mostly invisible to the victim, so this catches only the part that touches monitored web assets."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.001"
    mitre_technique_name = "Gather Victim Org Information: Determine Physical Locations"
    log_prerequisites = "Requires IPS or inline network security appliance telemetry with HTTP inspection, normalised to NETWORK_HTTP with principal.ip and target.url populated. Needs visibility of inbound traffic to the organisation's public web assets."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and synthetic monitors, partner or aggregator integrations, store-locator widgets, customers on shared NAT or proxy egress, and penetration tests or external attack-surface scans."
    tuning_guidance = "Add authorised scanner and testing sources to %global_allowed_scanners. Raise or lower the #http threshold per client web traffic profile. Extend the URL keyword list for client-specific location page naming. Severity can be raised when the same source also appears in other reconnaissance detections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.ip = $src
    $http.target.url = /\/(locations?|offices?|branch(es)?|store-?locator|find-?(us|a-?store)|directions|facilit(y|ies)|data-?cent(er|re)s?|headquarters|sites?|contact(-?us)?|visit-?us|where-?to-?find)([\/?#.]|$)/ nocase
    not $http.network.http.user_agent = /(googlebot|bingbot|duckduckbot|baiduspider|yandexbot|applebot)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(40)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1591.001")
    $primary_entity = array_distinct($src)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    #http >= 15
}
