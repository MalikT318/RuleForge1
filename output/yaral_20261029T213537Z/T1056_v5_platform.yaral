/*
  MITRE Technique : T1056 - Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:58:51.457759+00:00
  Reference       : https://attack.mitre.org/techniques/T1056
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_003_Cleartext_Credential_POST_To_External_Portal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client submitting an HTTP POST to a credential-style URL (login, signin, password, auth) over a cleartext web port to an external destination that is not on the known-good domain list. This is the network-observable result of Web Portal Capture or input-capture collectors forwarding user-entered credentials to attacker infrastructure. It is network-only coverage, so it adds to endpoint process-creation rules for this technique."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056"
    mitre_technique_name = "Input Capture"
    log_prerequisites = "Requires firewall or proxy logs that populate the HTTP method and full URL (explicit proxy, or a perimeter device with TLS inspection or cleartext visibility). Without URL visibility the rule cannot evaluate."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy internal or partner applications served over HTTP on external addresses, IoT or appliance admin portals reached via public IPs, vendor SaaS login endpoints not yet on the allowlist, and web-based captive portals."
    tuning_guidance = "Add sanctioned external destinations to %global_allowed_domains. Review captive-portal and guest-network egress and scope them out at the log source if noisy. Widen the port list if the proxy reports non-standard cleartext HTTP ports."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /(login|logon|signin|sign-in|password|passwd|credential|authenticate|verify)/ nocase
    ($http.target.port = 80 or $http.target.port = 8080)
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1056")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)

  condition:
    $http
}
