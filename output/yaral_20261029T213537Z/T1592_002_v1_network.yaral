/*
  MITRE Technique : T1592.002 - Software
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:37:12.689255+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_002_External_Software_Version_Disclosure_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting well-known software version or banner disclosure resources (server status/info pages, phpinfo, framework version files, readme/changelog files, management info endpoints) on an internet-facing web service. This is the network-side signature of victim software fingerprinting during reconnaissance (Active Scanning to gather host software details)."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.002"
    mitre_technique_name = "Gather Victim Host Information: Software"
    log_prerequisites = "Requires perimeter firewall, web proxy or reverse proxy logs normalised to NETWORK_HTTP with target.url and principal.ip populated (URL-aware inspection or TLS decryption must be enabled on the perimeter device)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Uptime and health monitoring that polls status or version endpoints, authorised external vulnerability or attack-surface scanners, search engine crawlers requesting readme or changelog files, CI/CD or package managers checking version files, and legitimate customers or partners calling public version APIs."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and trusted monitoring or partner sources to %global_allowed_mgmt_sources. For noisy internet-facing sites, route this rule to a low-priority queue or pair it with a threshold or correlation rule that counts distinct matched URLs per source. Extend or narrow the path regex to match the web stacks actually deployed at the client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(server-status|server-info|phpinfo\.php|info\.php|wp-includes\/version\.php|readme\.html|readme\.txt|changelog(\.txt|\.md)?|release-notes(\.txt|\.md)?|version(\.txt|\.json|\.xml)?|actuator\/(info|env|health)|manifest\.json)(\?.*)?$/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1592.002")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
