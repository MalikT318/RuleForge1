/*
  MITRE Technique : T1548.004 - Elevated Execution with Prompt
  Tactic(s)       : Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:34:31.141527+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_004_macOS_Privileged_Persistence_File_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Three or more files are created within 10 minutes in root-owned macOS persistence and privileged-helper locations (/Library/LaunchDaemons, /Library/LaunchAgents, /Library/PrivilegedHelperTools, /Library/StartupItems) on a single host by a process that is not an approved installer or management tool. Abusing AuthorizationExecuteWithPrivileges lets a user-prompted binary write to these locations with root rights. A single write is normal installer behaviour, but a burst from an unapproved process is a strong sign of privilege escalation followed by persistence. This rule is file-creation based and complements process command-line detections."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.004"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Elevated Execution with Prompt"
    log_prerequisites = "macOS endpoint telemetry that reports FILE_CREATION events with the target file path and the creating process path (EDR file-event telemetry or Endpoint Security framework data)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party application installers and updaters that drop a launch daemon plus a privileged helper in one run, MDM or software deployment agents, and developer or IT packaging tests."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools and approved remote management tooling to %global_allowed_remote_mgmt. The Apple installer and update daemons are already excluded by process name. Raise the #file threshold in noisy fleets, or lower it to 2 for high-security hosts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/(LaunchDaemons|LaunchAgents|PrivilegedHelperTools|StartupItems)\// nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(installer|system_installd|softwareupdated|mdmclient|storedownloadd|packagekit|pkd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.004")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
