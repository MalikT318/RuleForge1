/*
  MITRE Technique : T1585.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:38:21.926878+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_003_Cloud_Storage_Bulk_Upload_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound HTTP PUT or POST to an external host whose name carries generic cloud object-storage or file-hosting labels (storage, bucket, blob, s3, drive, upload). Adversary-created cloud accounts (T1585.003) are commonly used as staging, tool-upload and exfiltration endpoints, and the network side of that use is a bulk upload to an unsanctioned storage service. The rule matches generic service labels and upload behaviour, not provider domains, so it works across clients and across providers. It is a heuristic for the network side of cloud-account abuse, not proof of account creation."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.003"
    mitre_technique_name = "Establish Accounts: Cloud Accounts"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with network.http.method, network.sent_bytes and target.hostname populated. TLS inspection or SNI logging is needed for hostname visibility on HTTPS."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Sanctioned corporate cloud storage and backup uploads, software vendors' telemetry or crash-dump uploads, developers pushing build artifacts to object storage, large email or collaboration attachments, and media or CDN publishing workflows."
    tuning_guidance = "Add sanctioned storage and vendor domains to %global_allowed_domains. If the same hosts keep triggering, raise the sent_bytes threshold per client. Exclude approved automation accounts in %global_allowed_service_accounts if the proxy logs the user. Consider widening the method list or lowering the threshold in high-risk environments."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|POST)$/ nocase
    $net.network.sent_bytes > 10485760
    $net.target.hostname = /(^|[.-])(s3|blob|bucket|storage|objects|files|drive|upload)([.-]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1585.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
