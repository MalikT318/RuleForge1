/*
  MITRE Technique : T1591.001 - Determine Physical Locations
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:26:37.712265+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_001_External_Automated_Location_Page_Harvest {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external, non-allowlisted source using an automated client (crawler, scraper, headless or generic HTTP library user agent) to request web pages that disclose organisational physical locations, such as office, branch, facility, data centre or store-locator pages. This is network-side observation of reconnaissance for victim physical location information."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.001"
    mitre_technique_name = "Gather Victim Org Information: Determine Physical Locations"
    log_prerequisites = "Requires IDS/IPS or inline network security appliance logs with HTTP inspection that populate target.url, network.http.user_agent and principal.ip (normalised to NETWORK_HTTP)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate search engine and SEO crawlers, uptime and availability monitors, partner or aggregator integrations, mapping and business-listing services, and authorised external scanners or red-team activity."
    tuning_guidance = "Add authorised scanner and testing source IPs to %global_allowed_scanners. Adjust the URL path regex to the location-disclosing pages the client actually publishes. Known-good crawler domains can be added to %global_allowed_domains. This is a low-fidelity reconnaissance signal, so route it to enrichment or correlation rather than direct response."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(locations?|offices?|store-?locator|find-?(us|a-store)|facilit(y|ies)|data-?cent(er|re)s?|branch(es)?|directions|visit-?us|campus|sites)(\/|\?|$)/ nocase
    $http.network.http.user_agent = /(bot|crawl|spider|scrap|headless|libwww|http-?client|^$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1591.001")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
