/*
  MITRE Technique : T1594 - Search Victim-Owned Websites
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:49:33.179050+00:00
  Reference       : https://attack.mitre.org/techniques/T1594
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1594_Site_Recon_Then_Hidden_Content_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single external source requests site-structure discovery files (robots, sitemap, security.txt) and then, within ten minutes, repeatedly requests hidden or sensitive paths such as VCS metadata, environment/config files, backups and admin consoles. This sequence is typical of an adversary mapping victim-owned websites and running wordlist-style content discovery."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1594"
    mitre_technique_name = "Search Victim-Owned Websites"
    log_prerequisites = "IPS or network security appliance logs with HTTP inspection that populate the requested URL (target.url) and the source address (principal.ip). Sensors must see traffic to internet-facing web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and external attack-surface assessments not yet allowlisted; search engine and SEO crawlers that read robots.txt or sitemap files and follow links to admin or login pages; uptime monitors; legitimate administrators reaching admin paths from external addresses; penetration tests."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management source addresses to %global_allowed_mgmt_sources. Raise or lower the #probe threshold per customer based on web traffic volume. Extend %global_allowed_domains-style exclusions for known crawlers via your sensor allowlisting. Consider restricting to protected web server targets if the sensor also sees non-web HTTP."

  events:
    $recon.metadata.event_type = "NETWORK_HTTP"
    $recon.target.url = /\/(robots\.txt|sitemap[^\/]*\.xml|security\.txt|humans\.txt|crossdomain\.xml)(\?|$)/ nocase
    not $recon.principal.ip in %rfc1918_internal
    not $recon.principal.ip in %global_allowed_scanners
    not $recon.principal.ip in %global_allowed_mgmt_sources
    $recon.principal.ip = $src_ip

    $probe.metadata.event_type = "NETWORK_HTTP"
    $probe.target.url = /\/(\.git|\.svn|\.env|\.htpasswd|\.htaccess|\.ds_store|wp-config|phpinfo|server-status|server-info|phpmyadmin|backup|[^\/]*\.bak|[^\/]*\.sql|[^\/]*\.old|[^\/]*\.swp|admin|cgi-bin|config)(\/|\.|\?|$)/ nocase
    not $probe.principal.ip in %rfc1918_internal
    not $probe.principal.ip in %global_allowed_scanners
    not $probe.principal.ip in %global_allowed_mgmt_sources
    $probe.principal.ip = $src_ip

    $recon.metadata.event_timestamp.seconds <= $probe.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1594")
    $primary_entity = array_distinct($src_ip)
    $recon_urls = array_distinct($recon.target.url)
    $probed_urls = array_distinct($probe.target.url)
    $targeted_hosts = array_distinct($probe.target.hostname)
    $probe_count = count($probe.metadata.id)
    $first_seen = min($recon.metadata.event_timestamp.seconds)
    $last_seen = max($probe.metadata.event_timestamp.seconds)

  condition:
    $recon and $probe and #probe >= 5
}
