/*
  MITRE Technique : T1552.002 - Credentials in Registry
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:37:23.788181+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_002_Registry_Tool_Remote_SMB_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a native registry utility (reg.exe, regedit.exe, regini.exe) opening a network connection to SMB (TCP 445). These tools only use the network when querying a remote host's registry (for example reg query \\\\host\\HKLM /f password /), so this indicates remote credential hunting in the registry. This network-side view complements endpoint command-line detections and also covers renamed arguments, obfuscated command lines and scripted wrappers."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.002"
    mitre_technique_name = "Unsecured Credentials: Credentials in Registry"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR or Sysmon Event ID 3) normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or IT scripts querying remote registry settings for inventory, compliance checks or troubleshooting; RMM and patching tools that wrap reg.exe against remote hosts."
    tuning_guidance = "Internal address space is intentionally NOT excluded, because remote registry queries normally target internal hosts and excluding RFC1918 would remove the detection. Add approved admin accounts to %global_allowed_admin_users, approved tooling paths to %global_allowed_admin_tools, and service accounts to %global_allowed_service_accounts. Add vulnerability scanners to %global_allowed_scanners if the scanner source host is in scope."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(reg|regedit|regini)\.exe$/ nocase
    $net.target.port = 445
    $net.target.ip != ""
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $initiating_user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
