/*
  MITRE Technique : T1556.006 - Multi-Factor Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:41:20.316433+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_006_Linux_Outbound_RADIUS_To_External_MFA_Redirect {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host (typically a PAM-integrated server using a RADIUS-based MFA module) sending RADIUS authentication or accounting traffic to a non-internal destination. RADIUS is normally confined to internal address space. An external destination suggests the MFA/RADIUS server setting (for example in PAM or SSSD configuration) was altered to point at an adversary-controlled server that always approves, or that MFA is being proxied outside the trust boundary. Observed purely from the network perimeter, so it complements endpoint command-line and file-integrity detections."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.006"
    mitre_technique_name = "Modify Authentication Process: Multi-Factor Authentication"
    log_prerequisites = "Requires firewall, proxy, or perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Perimeter must see egress traffic from Linux server segments."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Cloud-hosted or managed RADIUS/MFA providers legitimately reached over the internet, branch or partner RADIUS roaming and federation (for example eduroam-style proxying), VPN concentrators or network devices authenticating to a SaaS RADIUS service, and misrouted or NATed internal traffic where internal ranges are missing from the internal reference list."
    tuning_guidance = "Add approved Linux or MFA proxy source addresses to %global_allowed_mgmt_sources. Add sanctioned cloud RADIUS provider domains to %global_allowed_domains (matched on target.hostname). Confirm %rfc1918_internal covers the customer's internal and private ranges. Raise severity for production bastion or jump hosts. Consider extending the port set if the customer runs RADIUS on non-standard ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1812 or
      $net.target.port = 1813 or
      $net.target.port = 1645 or
      $net.target.port = 1646
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
