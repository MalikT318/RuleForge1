/*
  MITRE Technique : T1593.002 - Search Engines
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:45:26.297686+00:00
  Reference       : https://attack.mitre.org/techniques/T1593/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_002_Search_Engine_Dork_Query_Observed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests whose query string carries search-engine dork operators (inurl, intitle, intext, filetype, inanchor) combined with sensitive-content keywords or file types. This is the network-side signature of search-engine reconnaissance and is visible where the IPS or network security appliance inspects decrypted web traffic. The rule matches query structure rather than named search engine domains, so it works across providers."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593.002"
    mitre_technique_name = "Search Engines"
    log_prerequisites = "Requires IPS or network security appliance HTTP logs with the full request URL (including query string) mapped to target.url. Requires TLS inspection or a decrypting sensor for HTTPS search traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security researchers, red teams and OSINT analysts running authorised dork queries; IT staff and developers searching for filetypes or config syntax; brand protection and exposure-monitoring services; web crawlers that replay query URLs."
    tuning_guidance = "Add authorised testing and OSINT source hosts to %global_allowed_scanners. Add known-good search or documentation domains to %global_allowed_domains. If the appliance does not log the query string, this rule will not fire and should not be deployed for that client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /[?&#](q|query|p|text|wd|k|search|s)=[^&]*(inurl|intitle|intext|filetype|inanchor)(:|%3a)/ nocase
    $http.target.url = /(password|passwd|credential|confidential|secret|backup|index(\+|%20|\s)of|api[_-]?key|id_rsa|\.env|\.sql|\.bak|\.conf|\.cfg|\.log|\.xls|\.xlsx|\.pdf|\.docx)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.hostname in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1593.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $search_urls = array_distinct($http.target.url)

  condition:
    $http
}
