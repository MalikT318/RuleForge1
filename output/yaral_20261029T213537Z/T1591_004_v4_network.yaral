/*
  MITRE Technique : T1591.004 - Identify Roles
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:32:25.951435+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_004_External_Automated_Role_Page_Harvesting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source using an automated or scripted HTTP client to request role-revealing pages (org charts, leadership, staff directories, team listings) on organization-owned web servers. This is the network-side footprint of adversaries harvesting information about personnel and business roles for later targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.004"
    mitre_technique_name = "Gather Victim Org Information: Identify Roles"
    log_prerequisites = "Requires IDS/IPS or inline network security appliance HTTP inspection (or decrypted web traffic) that populates network.http.method, network.http.user_agent, target.url and principal.ip."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, brand-monitoring and uptime services, partner or recruiter integrations, authorised external vulnerability or attack-surface scanners not yet allowlisted, and accessibility or archiving tools."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners. If legitimate crawlers are noisy, extend the user-agent filter exclusions or raise severity only when correlated with repeated requests. Review which web paths expose staff information in each environment, and consider converting to a Threshold rule grouped by source IP if volume is high."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /(org[-_ ]?chart|leadership|executive[-_ ]?(team|staff|bios?)|management[-_ ]?team|meet[-_ ]?(the[-_ ]?)?team|our[-_ ]?(team|people|staff)|staff[-_ ]?(directory|list|listing)|employee[-_ ]?(directory|list)|team[-_ ]?members|board[-_ ]?of[-_ ]?directors|\/people(\/|\?|$)|\/directory(\/|\?|$))/ nocase
    $http.network.http.user_agent = /(bot|crawl|spider|scrap|libwww|urllib|python|requests|curl|wget|go-http|java\/|okhttp|httpclient|aiohttp|node-fetch|axios|headless)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1591.004")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
