/*
  MITRE Technique : T1590 - Gather Victim Network Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:12:06.605002+00:00
  Reference       : https://attack.mitre.org/techniques/T1590
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_External_Network_Probe_Then_Infra_Disclosure_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single external source probes network-infrastructure service ports (DNS, SNMP, BGP, IKE, SSDP) and then, within ten minutes, requests web paths that disclose network or infrastructure details (status pages, server info, topology or inventory endpoints, WPAD/proxy config). This sequence is consistent with victim network information gathering ahead of targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590"
    mitre_technique_name = "Gather Victim Network Information"
    log_prerequisites = "Requires IDS/IPS or network security appliance telemetry that records connection events with source IP, destination port and HTTP request URLs, normalised to NETWORK_CONNECTION and NETWORK_HTTP. HTTP URL visibility needs TLS inspection or cleartext HTTP."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability or attack-surface scanners not yet in the allowlist, uptime and monitoring SaaS probes, search-engine and internet-measurement crawlers, partner or ISP monitoring of DNS and SNMP, CDN health checks."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners and approved management source addresses to %global_allowed_mgmt_sources. Raise the risk score or add a count threshold in the condition if internet-measurement noise is high. Extend or narrow the port list and URL regex to match the exposed services in each client environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 53 or
      $net.target.port = 161 or
      $net.target.port = 162 or
      $net.target.port = 179 or
      $net.target.port = 500 or
      $net.target.port = 1900
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(server-status|server-info|nginx_status|phpinfo|wpad\.dat|proxy\.pac|crossdomain\.xml|\/(network|topology|inventory|netmap|subnets|dns-query)(\/|\?|$)|\/api\/v[0-9]+\/(network|topology|interfaces|routes))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $net.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1590")
    $primary_entity = array_distinct($src_ip)
    $probed_ports = array_distinct($net.target.port)
    $probed_hosts = array_distinct($net.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $probe_event_count = count($net.metadata.id)
    $http_event_count = count($http.metadata.id)

  condition:
    $net and $http
}
