/*
  MITRE Technique : T1647 - Plist File Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:35:04.129034+00:00
  Reference       : https://attack.mitre.org/techniques/T1647
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1647_macOS_App_InfoPlist_Stealth_Key_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS plist editing utility (defaults, plutil or PlistBuddy) writing a background-execution or environment-injection key (LSUIElement, LSBackgroundOnly, LSEnvironment, DYLD_*) into an application bundle's Info.plist. Adversaries use this to hide an app from the Dock and UI, or to inject libraries and environment variables at launch. Matches the combination of editor, write verb, bundle Info.plist target and sensitive key, so renaming a payload does not evade it."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1647"
    mitre_technique_name = "Plist File Modification"
    log_prerequisites = "Requires macOS endpoint process-launch telemetry with full command-line capture (EDR or unified log) populating target.process.command_line and principal.process.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or software-packaging tooling that sets LSUIElement for menu-bar helper apps; developers editing their own app bundles in Xcode build scripts; IT scripts that adjust app behaviour after deployment; installers that patch Info.plist during setup."
    tuning_guidance = "Add approved MDM, packaging and deployment parent binaries to %global_allowed_admin_tools. Add build-host or CI script parents to %global_allowed_script_hosts. Add named admin accounts that routinely repackage apps to %global_allowed_admin_users. If developer-heavy tenants are noisy, scope by host group in the SOAR playbook rather than editing the key list."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(defaults|plutil|PlistBuddy)$/ nocase
    $proc.target.process.command_line = /(\bwrite\b|-insert|-replace|-c\s+["']?\s*(set|add|merge)\b)/ nocase
    $proc.target.process.command_line = /\.app\/Contents\/Info/ nocase
    $proc.target.process.command_line = /(LSUIElement|LSBackgroundOnly|LSEnvironment|DYLD_INSERT_LIBRARIES|DYLD_FRAMEWORK_PATH|DYLD_LIBRARY_PATH)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1647")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $editor_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
