/*
  MITRE Technique : T1546.014 - Emond
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:31:12.092653+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_014_Emond_Rule_And_Queue_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a plist rule file written to the emond rules directory followed within 10 minutes by a file created in the emond QueueDirectories path on the same macOS host. emond only runs if the QueueDirectories path contains a file, so an attacker installing emond persistence typically does both. This rule uses file-creation telemetry and does not duplicate command-line based detections."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.014"
    mitre_technique_name = "Event Triggered Execution: Emond"
    log_prerequisites = "Requires macOS endpoint telemetry that reports FILE_CREATION events with the target file path, the host name and the creating process. Coverage of /etc, /private/etc and /private/var/db is required."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Rare. Legitimate sources are MDM or configuration management agents deploying custom emond rules, administrators testing emond rules, and OS upgrades or restores that recreate emond default files."
    tuning_guidance = "Add approved deployment or configuration management binaries to %global_allowed_admin_tools. Emond is deprecated and unused in most environments, so the rule should need little tuning. If a client's tooling writes the queue file before the rule file, swap the timestamp ordering or widen the window."

  events:
    $emond_rule.metadata.event_type = "FILE_CREATION"
    $emond_rule.target.file.full_path = /^\/(private\/)?etc\/emond\.d\/rules\/[^\/]+\.plist$/ nocase
    not $emond_rule.principal.process.file.full_path in %global_allowed_admin_tools
    $emond_rule.principal.hostname = $hostname

    $emond_queue.metadata.event_type = "FILE_CREATION"
    $emond_queue.target.file.full_path = /^\/(private\/)?var\/db\/emondClients\/[^\/]+/ nocase
    not $emond_queue.principal.process.file.full_path in %global_allowed_admin_tools
    $emond_queue.principal.hostname = $hostname

    $emond_rule.metadata.event_timestamp.seconds <= $emond_queue.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.014")
    $primary_entity = array_distinct($hostname)
    $rule_file_paths = array_distinct($emond_rule.target.file.full_path)
    $queue_file_paths = array_distinct($emond_queue.target.file.full_path)
    $rule_writer_processes = array_distinct($emond_rule.principal.process.file.full_path)
    $rule_writer_users = array_distinct($emond_rule.principal.user.userid)

  condition:
    $emond_rule and $emond_queue
}
