/*
  MITRE Technique : T1591.001 - Determine Physical Locations
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:27:21.368180+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_001_External_Physical_Location_Recon_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Low"
    description = "Detects a single external source that browses location-oriented web content (contact, offices, facilities, directions) and then, within 10 minutes, browses personnel or organisational content (staff, leadership, careers, directory). The pattern is consistent with pre-compromise gathering of physical location and site information. Requires repeated requests on both sides to reduce noise from ordinary visitors."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.001"
    mitre_technique_name = "Gather Victim Org Information: Determine Physical Locations"
    log_prerequisites = "IDS/IPS or network security appliance telemetry normalised to UDM NETWORK_HTTP with principal.ip, target.url and network.http.method populated. Requires visibility of inbound HTTP traffic to client-owned web properties (inspection or decryption in place)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate prospective customers, job applicants, and partners researching offices and staff; search-engine and SEO crawlers; media and market research; uptime and brand-monitoring services; corporate proxies or NAT gateways that aggregate many visitors behind one IP."
    tuning_guidance = "Add known crawlers, monitoring services and authorised testing sources to %global_allowed_scanners. Raise the #loc and #emp thresholds in the condition for high-traffic public sites. Adjust the URL path regexes to match client site structure, and consider a stricter filter if the client has a store locator that is heavily browsed."

  events:
    $loc.metadata.event_type = "NETWORK_HTTP"
    $loc.network.http.method = "GET"
    $loc.target.url = /(?i)\/(contact(-us)?|locations?|offices?|facilit(y|ies)|directions|branch(es)?|store-locator|find-us|visit-us|headquarters|sites?)(\/|\.|\?|$)/
    not $loc.principal.ip in %rfc1918_internal
    not $loc.principal.ip in %global_allowed_scanners
    $loc.principal.ip = $src_ip

    $emp.metadata.event_type = "NETWORK_HTTP"
    $emp.network.http.method = "GET"
    $emp.target.url = /(?i)\/(careers?|jobs?|staff|team|our-team|leadership|management|directory|people|about(-us)?|investors?|press|newsroom)(\/|\.|\?|$)/
    not $emp.principal.ip in %rfc1918_internal
    not $emp.principal.ip in %global_allowed_scanners
    $emp.principal.ip = $src_ip

    $loc.metadata.event_timestamp.seconds <= $emp.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1591.001")
    $primary_entity = array_distinct($src_ip)
    $location_request_count = count($loc.metadata.id)
    $personnel_request_count = count($emp.metadata.id)
    $location_urls = array_distinct($loc.target.url)
    $personnel_urls = array_distinct($emp.target.url)
    $targeted_hosts = array_distinct($loc.target.hostname)
    $first_seen = min($loc.metadata.event_timestamp.seconds)
    $last_seen = max($emp.metadata.event_timestamp.seconds)

  condition:
    #loc >= 2 and #emp >= 2
}
