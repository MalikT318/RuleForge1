/*
  MITRE Technique : T1543.004 - Launch Daemon
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:27:57.244843+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_004_macOS_LaunchDaemon_Plist_Created_By_NonInstaller {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a launchd property list directly under /Library/LaunchDaemons by a process that is not a recognised installer, management agent or security tool. Launch Daemons run as root at boot before any user logs in, so an unexpected plist written by a shell, script interpreter, user-writable binary or other unknown process is a strong persistence and privilege-escalation signal. This rule uses file-creation telemetry rather than process command-line matching."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.004"
    mitre_technique_name = "Create or Modify System Process: Launch Daemon"
    log_prerequisites = "macOS endpoint telemetry that records file creation events with the creating (principal) process path populated, for example EDR file events or Endpoint Security framework NOTIFY_CREATE events normalised to UDM FILE_CREATION."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party software installers and updaters that write a daemon plist (VPN clients, backup agents, browser updaters, developer tooling installed via Homebrew or pkg scripts), MDM or RMM agents deploying configuration profiles and daemons, and administrators manually installing a service during testing."
    tuning_guidance = "Add approved deployment, packaging and MDM binaries to %global_allowed_admin_tools, approved remote management agents to %global_allowed_remote_mgmt, and EDR or AV agents to %global_allowed_security_tools. Compare the creating process path in $creator_process against the expected software inventory for the host. Extend the Apple installer name exclusion only after confirming the process is Apple-signed on the client estate."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/LaunchDaemons\/[^\/]+\.plist$/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(installd|system_installd|package_script_service|softwareupdated|mdmclient|storedownloadd|appstoreagent)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1543.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $plist_path = array_distinct($file.target.file.full_path)
    $creator_process = array_distinct($file.principal.process.file.full_path)
    $creator_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
