/*
  MITRE Technique : T1647 - Plist File Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:34:32.980085+00:00
  Reference       : https://attack.mitre.org/techniques/T1647
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1647_macOS_Plist_Modification_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a plist-editing utility (defaults, PlistBuddy, plutil) or a shell/interpreter running plist-modification commands when its parent is an Office application, web server, database service or print spooler. These parents do not normally edit preference or launchd plists. This lineage points to document-based or server-side exploitation being used to tamper with plist keys such as ProgramArguments, RunAtLoad, LSUIElement or LSEnvironment."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1647"
    mitre_technique_name = "Plist File Modification"
    log_prerequisites = "macOS endpoint telemetry from EDR or the unified log that records PROCESS_LAUNCH with parent process path, child process path and full command line."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Office applications or add-ins that run helper scripts to set preferences (for example licensing or auto-update helpers), locally hosted web or database stacks (httpd, nginx, php-fpm, mysqld, postgres) with deployment or provisioning scripts that call defaults or PlistBuddy, developer workstations running local web servers, and print driver installers launched from cupsd."
    tuning_guidance = "Add approved parent binaries (MDM or deployment tooling) to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. Extend or trim the parent process regex to fit the client's server and Office footprint. For developer-heavy clients, consider excluding web server and database parents on developer hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(Microsoft (Word|Excel|PowerPoint|Outlook)|httpd|nginx|php-fpm[0-9.]*|apache2|mysqld|mariadbd|postgres|mongod|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(defaults|PlistBuddy|plutil|sh|bash|zsh|osascript)$/ nocase
    $proc.target.process.command_line = /(\bdefaults\b.*\b(write|import|delete)\b|plistbuddy.*\b(add|set|merge|delete|import)\b|\bplutil\b.*\s-(insert|replace|remove|convert|create))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1647")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
