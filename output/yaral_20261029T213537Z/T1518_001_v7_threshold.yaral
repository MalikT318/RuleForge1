/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:22:30.723168+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_Security_Software_Discovery_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of built-in Windows utilities (tasklist, sc, reg, wmic, fltmc, PowerShell, cmd) used to enumerate installed antivirus, firewall, EDR or security-service state on a single host within 10 minutes. Each command is benign alone; repeated enumeration shows an adversary profiling defences."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and compliance scripts, RMM health checks, vulnerability scanners, security agent self-checks, and administrators troubleshooting endpoint protection."
    tuning_guidance = "Add approved tooling parent processes to %global_allowed_admin_tools, %global_allowed_security_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for noisy estates. Lower it to 3 for high-value servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(tasklist|sc|reg|wmic|fltmc|powershell|pwsh|cmd|findstr|driverquery|netsh)\.exe$/ nocase
    $proc.target.process.command_line = /(AntiVirusProduct|AntiSpywareProduct|FirewallProduct|root\\SecurityCenter2?|Get-MpComputerStatus|Get-MpPreference|\b(tasklist|sc(\.exe)?\s+query|reg(\.exe)?\s+query|get-service|get-process|get-childitem|wmic\s+service|findstr|dir)\b.{0,200}(anti-?virus|anti-?malware|anti-?spyware|endpoint.?(protection|security)|\bedr\b|\bxdr\b|sensor|security.?(agent|center|service))|fltmc(\.exe)?\s+filters)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.command_line = /AntiVirusProduct|AntiSpywareProduct|FirewallProduct|SecurityCenter2?|fltmc/ nocase, 70, 50))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $discovery_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
