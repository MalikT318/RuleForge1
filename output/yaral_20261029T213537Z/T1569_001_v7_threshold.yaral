/*
  MITRE Technique : T1569.001 - Launchctl
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:52:43.741050+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_001_Launchctl_Burst_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of launchctl service-execution subcommands (load, bootstrap, submit, kickstart, start) on a single macOS host within 10 minutes. One invocation is routine, but repeated launchctl runs in a short window suggest scripted loading of Launch Agents or Daemons to execute payloads."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.001"
    mitre_technique_name = "System Services: Launchctl"
    log_prerequisites = "macOS endpoint telemetry with process launch events including full process path, parent process path and command line."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Software installers and updaters loading several launchd jobs, MDM or configuration management runs, developer tooling such as package managers restarting services, and admins restarting services manually."
    tuning_guidance = "Add approved MDM, patching and deployment binaries to %global_allowed_admin_tools, endpoint agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts with heavy developer or installer activity, or lower it on servers with a stable launchd baseline."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/launchctl$/ nocase
    $proc.target.process.command_line = /\b(load|bootstrap|submit|kickstart|start)\b/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1569.001")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
