/*
  MITRE Technique : T1553.001 - Gatekeeper Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:38:49.162766+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_001_Gatekeeper_Policy_Store_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the macOS Gatekeeper/System Policy assessment store (the SystemPolicy database, SystemPolicy-prefs.plist and the SystemPolicyConfiguration directory under /var/db). These files hold the global Gatekeeper enable state and per-app assessment rules, so a change indicates Gatekeeper was disabled or an untrusted app was allow-listed. The rule works at the file-state layer, so it fires regardless of how the change was made (spctl, a script, or a direct write) and does not depend on command-line logging."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.001"
    mitre_technique_name = "Subvert Trust Controls: Gatekeeper Bypass"
    log_prerequisites = "macOS endpoint telemetry that reports file modification events with the writing process path and user, including writes under /var/db (/private/var/db). The EDR file-monitoring policy must cover this path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM-enforced Gatekeeper policy changes, administrators allow-listing internal apps with spctl --add, macOS system and security updates that rewrite the policy store, and enterprise software deployment or imaging workflows."
    tuning_guidance = "Add approved deployment and MDM tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and named administrators to %global_allowed_admin_users. If the EDR attributes policy writes to the system policy daemon, tune on the user and host. If baseline OS churn on SystemPolicyConfiguration is noisy, narrow the path regex to the SystemPolicy database and SystemPolicy-prefs.plist."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^(\/private)?\/var\/db\/SystemPolicy(-prefs\.plist|Configuration(\/.*)?)?$/ nocase
    not $file.principal.process.file.full_path = /\/(softwareupdated|installd|mdmclient|system_installd|storedownloadd|XProtectService)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1553.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_policy_files = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
