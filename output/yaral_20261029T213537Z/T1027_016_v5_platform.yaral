/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:44:06.887908+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_Linux_OnHost_Toolchain_Binary_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a linker writing a freshly built executable into a world-writable or memory-backed staging directory (/tmp, /var/tmp, /dev/shm). Adversaries who generate unique binary variants on the target, for example by assembling and linking code padded with NOPs or dead instructions, leave this file-creation artefact. Junk code cannot be seen directly in telemetry, so this is a behavioural proxy based on where the binary is produced, not on its content. It is deliberately file-event based and does not duplicate command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates the creating process path (principal.process.file.full_path) and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer workstations, CI/build runners, and package build sandboxes that compile software under /tmp or /var/tmp. DKMS and kernel module builds. Software installers that compile native extensions (pip, npm, gem) in temp directories."
    tuning_guidance = "Add build and CI hosts to %global_allowed_script_hosts. Add developer or build accounts to %global_allowed_admin_users. Add approved build service accounts to %global_allowed_service_accounts. Where build activity is noisy, narrow the path regex to /dev/shm only."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(ld|ld\.bfd|ld\.gold|ld\.lld|lld|mold)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $file.target.file.full_path = /\.(o|s|a|so|res|ld|d|tmp|gch|ltrans\d*)$/ nocase
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $linker_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
