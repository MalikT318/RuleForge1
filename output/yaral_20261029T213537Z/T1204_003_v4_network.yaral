/*
  MITRE Technique : T1204.003 - Malicious Image
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:13:14.580337+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_003_Container_Image_Pull_From_Unapproved_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a container runtime or orchestrator node pulling image manifests or layers over the OCI/Docker registry HTTP API (/v2/<repo>/manifests|blobs) from an external registry that is not on the approved domain list. Pulling an image from an unvetted public registry is the delivery step for backdoored or look-alike malicious images (for example cryptominer images). The rule keys on the registry protocol and container-runtime client behaviour, not on specific registry names, image names or IPs."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.003"
    mitre_technique_name = "User Execution: Malicious Image"
    log_prerequisites = "Requires egress HTTP visibility (proxy, TLS-inspecting gateway or cloud network inspection) normalised to UDM NETWORK_HTTP with target.url, target.hostname and network.http.user_agent populated, from container hosts or cluster nodes. Without TLS inspection or a proxy, the registry URL path and user agent are not observable."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Developers or CI pipelines pulling from legitimate public registries not yet on the allow-list, new vendor or base-image registries, mirrored or pull-through caches hosted on external domains, and managed-cluster system components pulling from cloud-provider registries not in the allow-list."
    tuning_guidance = "Add approved registry and mirror domains (public, vendor and cloud-provider) to %global_allowed_domains. Add CI and automation identities to %global_allowed_service_accounts and, if needed, extend the exclusions to cover them. Review the registry host and image path in the outcome fields, and prioritise first-seen registries and nodes that have no business pulling external images."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(docker|containerd|cri-o|crio|podman|kubelet|buildkit|skopeo)/ nocase
    $net.target.url = /\/v2\/.+\/(manifests|blobs)\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1204.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $registry_host = array_distinct($net.target.hostname)
    $registry_ip = array_distinct($net.target.ip)
    $pull_url = array_distinct($net.target.url)
    $client_user_agent = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
