/*
  MITRE Technique : T1585.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:36:51.549287+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_002_Email_Account_Signup_Over_Web {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an HTTP POST from the client network to an external URL whose path looks like a mailbox or email-account registration flow (signup, register, create account). This can indicate a user or compromised host creating email accounts that could be used for phishing or infrastructure acquisition. No provider domains are hardcoded. Detection relies on the registration-flow URL structure and requires URL visibility (TLS inspection or an explicit proxy)."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.002"
    mitre_technique_name = "Establish Accounts: Email Accounts"
    log_prerequisites = "Firewall or proxy logs normalised to UDM NETWORK_HTTP with target.url and network.http.method populated. Requires TLS inspection or a forward proxy for HTTPS visibility."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees creating legitimate personal or business mailboxes; marketing, HR or IT staff registering shared or test mailboxes; vendor onboarding portals; sanctioned email-provider trials; security awareness or phishing simulation testing."
    tuning_guidance = "Add known-good vendor and corporate mail domains to %global_allowed_domains. Review source IPs of approved testing activity and add authorised sources via the firewall policy. Raise severity for sources that also show high-volume repeated signups. Ensure %rfc1918_internal is populated for each tenant."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST"
    $net.target.url = /(mail|email|inbox|webmail)[^?#]*\/(signup|sign-up|register|registration|createaccount|create-account|newaccount|new-account)|\/(signup|sign-up|register|registration|createaccount|create-account|newaccount|new-account)[^?#]*(mail|email|inbox)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1585.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
