/*
  MITRE Technique : T1547.007 - Re-opened Applications
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:45:41.687400+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_007_Reopened_App_Loginwindow_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external network connection made by a process spawned by loginwindow that runs from a user-writable location (~/Library, /Users/Shared, /tmp, /private/var/folders, hidden directories). This is the network footprint of a payload persisted through the 'Reopen windows when logging back in' mechanism (com.apple.loginwindow.[UUID].plist in ~/Library/Preferences/ByHost). It complements existing process-creation and command-line coverage by observing the first outbound callback after login, rather than the plist change or the process launch itself."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.007"
    mitre_technique_name = "Boot or Logon Autostart Execution: Re-opened Applications"
    log_prerequisites = "Requires macOS endpoint network telemetry (NETWORK_CONNECTION) with the parent process populated (principal.process.parent_process.file.full_path) and the process image path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate per-user applications installed under ~/Library or hidden directories (browser or collaboration-tool updaters, menu-bar utilities, cloud sync clients) that are reopened at login and beat out to vendor infrastructure. Developer tools launched from /private/var/folders or /tmp after login."
    tuning_guidance = "Add approved per-user management or update binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Add known vendor update domains to %global_allowed_domains. Confirm that the EDR populates the parent process on network events; if it does not, the rule will not fire."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/loginwindow$/ nocase
    $net.principal.process.file.full_path = /^\/(Users\/[^\/]+\/(Library|Applications|Downloads|Desktop|\.[^\/]+)|Users\/Shared|private\/tmp|tmp|private\/var\/tmp|private\/var\/folders)\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1547.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
