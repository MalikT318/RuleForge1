/*
  MITRE Technique : T1485 - Data Destruction
  Tactic(s)       : Impact
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:17:46.148216+00:00
  Reference       : https://attack.mitre.org/techniques/T1485
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_Container_API_Destructive_Delete_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP DELETE requests to the container orchestration API that remove namespaces, persistent volumes or claims, or whole collections of secrets, config maps or workloads, when the request comes from outside internal address space. This is the network-side view of destructive API activity against cluster data and workloads, and it does not depend on endpoint process telemetry."
    mitre_tactic = "Impact"
    mitre_technique = "T1485"
    mitre_technique_name = "Data Destruction"
    log_prerequisites = "Requires container control-plane API request telemetry (Kubernetes API server audit or gateway logs) normalized to NETWORK_HTTP with network.http.method, target.url and principal.ip populated. Cloud audit ingestion must be enabled for the cluster."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Authorised cluster administrators operating from a VPN or public egress address, CI/CD or GitOps controllers running outside the internal range, scheduled environment teardown for ephemeral test clusters, and managed-cluster autoscaler or cleanup jobs."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Add trusted management egress addresses to %global_allowed_mgmt_sources. Add known scanners to %global_allowed_scanners. If the pipeline normalizes API server traffic with internal addresses only, drop the external-source condition and rely on the allowlists."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "DELETE" nocase
    (
      $http.target.url = /\/api\/v1\/namespaces\/[^\/?]+\/?$/ nocase or
      $http.target.url = /\/api\/v1\/persistentvolumes(\/[^\/?]+)?\/?(\?.*)?$/ nocase or
      $http.target.url = /\/api\/v1\/namespaces\/[^\/]+\/(persistentvolumeclaims|secrets|configmaps|pods)\/?(\?.*)?$/ nocase or
      $http.target.url = /\/apis\/apps\/v1\/namespaces\/[^\/]+\/(deployments|statefulsets|daemonsets)\/?(\?.*)?$/ nocase or
      $http.target.url = /\/apis\/storage\.k8s\.io\/v1\/(volumeattachments|storageclasses)(\/[^\/?]+)?\/?(\?.*)?$/ nocase
    )
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1485")
    $primary_entity = array_distinct($http.principal.user.userid)
    $source_ips = array_distinct($http.principal.ip)
    $deleted_resources = array_distinct($http.target.url)

  condition:
    $http
}
