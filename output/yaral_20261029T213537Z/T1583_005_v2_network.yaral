/*
  MITRE Technique : T1583.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:06:53.900328+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_005_Botnet_DGA_Style_DNS_Queries {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for algorithmically generated style names: a very long first label with a run of consonants and no recognisable word structure. Botnet nodes, including leased or rented botnets and ORB-style relay networks, commonly use such names to locate command infrastructure. Reverse-lookup and local-suffix names are excluded, as are known-good domains and names that resolve to internal address space."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.005"
    mitre_technique_name = "Acquire Infrastructure: Botnet"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. principal.hostname should be populated for best entity attribution."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud storage hostnames with long random labels, email security and anti-spam DNS lookups, DNS-based blocklist lookups, software update and telemetry services, content-addressed or tokenised hostnames, and security products that query hash-style names."
    tuning_guidance = "Add known-good domains to %global_allowed_domains; matching is on the full query name, so add the exact names seen. Names resolving to internal space are excluded via %rfc1918_internal. Raise the label length quantifier from 20 to 28 or more to reduce noise, or lower the consonant run from 5 to 4 for more sensitivity. If the tenant does not populate answer data, the internal-resolution exclusion has no effect, so rely on the domain allowlist."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^[a-z0-9]{20,}\.[a-z0-9.-]+\.[a-z]{2,}$/ nocase
    $dns.network.dns.questions.name = /^[a-z0-9]*[bcdfghjklmnpqrstvwxz]{5,}[a-z0-9]*\./ nocase
    not $dns.network.dns.questions.name = /\.(arpa|local|internal|lan|localdomain)$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.005")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
