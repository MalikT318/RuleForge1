/*
  MITRE Technique : T1590.006 - Network Security Appliances
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:22:38.443416+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_006_Appliance_Mgmt_Port_Probe_Then_Admin_Web_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An external source probes several management-plane ports on a perimeter host and then requests administrative or VPN portal URLs on the same destination within 10 minutes. This pattern indicates fingerprinting of firewalls, proxies, bastion hosts and other security appliances ahead of targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.006"
    mitre_technique_name = "Gather Victim Network Information: Network Security Appliances"
    log_prerequisites = "Requires IDS/IPS or network security appliance telemetry normalised to UDM NETWORK_CONNECTION (or flow records mapped to it) and NETWORK_HTTP, with principal.ip, target.ip, target.port and target.url populated. HTTP inspection must be enabled for the web-probe side to fire."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, penetration tests, remote administrators or MSP staff connecting from unlisted external addresses, uptime monitors checking login portals, and search-engine or internet-census crawlers."
    tuning_guidance = "Add approved external scanner addresses to %global_allowed_scanners and trusted administrator source addresses to %global_allowed_mgmt_sources. Raise the #conn threshold if noisy internet-wide scanning is common. Tighten the port list if a client exposes different management ports."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    (
      $conn.target.port = 22 or
      $conn.target.port = 23 or
      $conn.target.port = 161 or
      $conn.target.port = 4443 or
      $conn.target.port = 8443 or
      $conn.target.port = 10443 or
      $conn.target.port = 8080 or
      $conn.target.port = 8888
    )
    $conn.principal.ip = $src
    $conn.target.ip = $dst

    $http.metadata.event_type = "NETWORK_HTTP"
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.target.url = /\/(admin|administrator|login|logon|webui|console|manager|sslvpn|vpn|remote|portal|cgi-bin)(\/|\.|\?|$)/ nocase
    $http.principal.ip = $src
    $http.target.ip = $dst

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1590.006")
    $primary_entity = array_distinct($conn.principal.ip)
    $targeted_ip = array_distinct($conn.target.ip)
    $probed_ports = array_distinct($conn.target.port)
    $probed_urls = array_distinct($http.target.url)
    $conn_count = count($conn.metadata.id)
    $http_count = count($http.metadata.id)

  condition:
    #conn >= 3 and #http >= 2
}
