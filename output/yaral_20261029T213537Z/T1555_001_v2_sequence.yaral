/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:39:44.413784+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Keychain_Read_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-system process reads a macOS Keychain database file and, within ten minutes, the same process on the same host opens a connection to an external address. This sequence indicates keychain theft followed by exfiltration or C2 delivery, regardless of the tool or command line used."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "Requires macOS endpoint telemetry that records file read events (FILE_READ) on keychain files and process-attributed network connections (NETWORK_CONNECTION)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party password managers or browsers that read keychain files and sync to the cloud, backup and migration tools, MDM or enterprise management agents, and developer tools that use the keychain for signing or credential helpers."
    tuning_guidance = "Add approved backup tools to %global_allowed_backup_processes, EDR and security agents to %global_allowed_security_tools, and MDM or management agents to %global_allowed_admin_tools. Add approved sync clients to %global_allowed_remote_mgmt. If a legitimate application triggers the rule repeatedly, add its executable path to the most appropriate list rather than loosening the keychain path regex."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/Library\/Keychains\/[^\/]*\.keychain(-db)?$/ nocase
    not $file.principal.process.file.full_path = /^\/System\// nocase
    not $file.principal.process.file.full_path = /\/(securityd|secd|trustd|cfprefsd|assistantd|accountsd|Keychain Access)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $proc_path

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $proc_path

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($hostname)
    $keychain_files = array_distinct($file.target.file.full_path)
    $reading_process = array_distinct($proc_path)
    $reading_user = array_distinct($file.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $keychain_read_count = count($file.metadata.id)

  condition:
    $file and $net
}
