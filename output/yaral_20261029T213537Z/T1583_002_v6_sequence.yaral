/*
  MITRE Technique : T1583.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:01:57.827734+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_002_DNS_C2_TXT_Then_LongLabel_Same_Domain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a DNS client that issues TXT/NULL record queries and then queries abnormally long, encoded-looking subdomain labels under the same parent domain within 10 minutes. This pattern is typical of DNS-based C2 or exfiltration against adversary-operated authoritative DNS servers."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.002"
    mitre_technique_name = "Acquire Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated, and a client source IP (principal.ip) on the query."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security (SPF/DKIM/DMARC) TXT lookups, CDN and cloud services that use long hashed hostnames, DNS-based blocklist lookups, software licensing and telemetry services, and security products that use DNS-tunnel-style lookups."
    tuning_guidance = "Add known-good parent domains (CDNs, vendors, mail security, telemetry) to %global_allowed_domains. Raise or lower the label length threshold of 40 characters to suit the environment. Consider adding a count threshold in the condition if resolver-level source IPs cause noise."

  events:
    $txt.metadata.event_type = "NETWORK_DNS"
    ($txt.network.dns.questions.type = 16 or $txt.network.dns.questions.type = 10)
    not $txt.network.dns.questions.name = /\.arpa$/ nocase
    $txt.principal.ip = $client
    $apex = re.capture($txt.network.dns.questions.name, `([^.]+\.[^.]+)$`)
    not $apex in %global_allowed_domains

    $long.metadata.event_type = "NETWORK_DNS"
    $long.network.dns.questions.name = /^[a-z0-9_-]{40,}\./ nocase
    not $long.network.dns.questions.name = /\.arpa$/ nocase
    $long.principal.ip = $client
    $apex = re.capture($long.network.dns.questions.name, `([^.]+\.[^.]+)$`)

    $txt.metadata.event_timestamp.seconds <= $long.metadata.event_timestamp.seconds

  match:
    $client, $apex over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1583.002")
    $primary_entity = array_distinct($txt.principal.ip)
    $suspect_domain = array_distinct($apex)
    $txt_query_count = count($txt.metadata.id)
    $long_label_query_count = count($long.metadata.id)
    $sample_long_queries = array_distinct($long.network.dns.questions.name)

  condition:
    $txt and $long
}
