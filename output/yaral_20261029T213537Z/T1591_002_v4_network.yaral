/*
  MITRE Technique : T1591.002 - Business Relationships
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:28:39.137472+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_002_External_Scripted_Business_Relationship_Page_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source using a scripted or library HTTP client to request organisation web pages that disclose business relationships (partners, suppliers, vendors, customers, resellers, distributors). This is network-side evidence of reconnaissance into third-party relationships, supply chain and MSP connections. It is a weak, low-fidelity signal intended for enrichment and hunting, not for standalone response."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.002"
    mitre_technique_name = "Gather Victim Org Information: Business Relationships"
    log_prerequisites = "IDS/IPS or inline network security appliance with HTTP/URL visibility (decrypted or plaintext) normalised to NETWORK_HTTP with principal.ip, target.url and network.http.user_agent populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external scanners and brand-monitoring services; search and SEO tools; partner or customer integrations that poll these pages programmatically; uptime and content monitors; legitimate commercial intelligence and competitor-research crawlers; internal-facing proxies that present a public NAT address."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Add partner and integration sources to %global_allowed_mgmt_sources. Raise severity only if the same source also appears in related reconnaissance rules such as email harvesting or subdomain enumeration. Extend the URL keyword list to match the client's own site structure."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    $net.network.http.method = "GET" nocase
    $net.target.url = /\/(partners?|suppliers?|vendors?|customers|clients|resellers|distributors|affiliates|sponsors|alliances|supply-chain|case-studies)(\/|\.|\?|$)/ nocase
    $net.network.http.user_agent = /(curl|wget|python-requests|python-urllib|go-http-client|libwww|scrapy|aiohttp|httpclient|okhttp|java\/|node-fetch|axios|powershell)/ nocase
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1591.002")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $victim_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
