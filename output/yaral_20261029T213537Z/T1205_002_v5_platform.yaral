/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:14:15.416422+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Packet_Capture_Driver_Service_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects registry writes that register or reconfigure a packet-capture (WinPcap/Npcap-style NDIS) driver service under CurrentControlSet\\Services. Socket filter backdoors on Windows depend on such a driver to install BPF-style filters and watch for a trigger packet. The rule keys on the service registration behaviour, not on any attacker binary. Note: the requested alternate-platform angle conflicts with the mandatory Windows platform requirement, so this variant covers a different Windows mechanism (driver service registration) from the usual process-command-line detections."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13) that populates principal.process.file.full_path and target.registry fields."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installs or upgrades of Wireshark/Npcap/WinPcap, network monitoring and IDS agents that bundle a capture driver, VPN or network-security clients with NDIS filter drivers, and software deployment tooling pushing these packages."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools and approved monitoring agents to %global_allowed_security_tools. Extend the service-name alternation with other capture-driver service names used in your estate. Hosts that legitimately run packet capture (network engineering, SOC sensors) can be suppressed per client by exception."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\CurrentControlSet\\Services\\(npf|npcap|npcap_wifi|winpcap|nm3|ndisCap)(\\|$)/ nocase
    $reg.target.registry.registry_value_name = /^(ImagePath|Start|Type|DisplayName)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|services)\.exe$/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
