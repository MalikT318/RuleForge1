/*
  MITRE Technique : T1667 - Email Bombing
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:39:04.927506+00:00
  Reference       : https://attack.mitre.org/techniques/T1667
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1667_macOS_Scripted_SMTP_Submission_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a macOS interpreter or command-line transfer utility (python, perl, ruby, node, php, shell, curl, nc, osascript) opening an outbound connection to an external SMTP or mail-submission port (25, 465, 587). Legitimate macOS mail clients are not interpreters, so this pattern indicates scripted mass-mailing. That is the sending side of email bombing, where a compromised Mac is used as a relay or bot to flood a target mailbox. This rule covers only the sending side from a macOS endpoint. Inbound mail floods against a user mailbox are not visible in endpoint network telemetry and need mail gateway or SaaS mail logs."
    mitre_tactic = "Impact"
    mitre_technique = "T1667"
    mitre_technique_name = "Email Bombing"
    log_prerequisites = "Requires macOS endpoint network telemetry (EDR or unified log) that populates NETWORK_CONNECTION with principal process path, target.ip and target.port."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developer or admin scripts that send alert or notification mail directly via SMTP, monitoring and cron-driven mail scripts, CI agents on build Macs, and security awareness or phishing simulation tooling running from scripts."
    tuning_guidance = "Add approved automation hosts to %global_allowed_script_hosts and approved tooling paths to %global_allowed_admin_tools. Internal mail relays are excluded through %rfc1918_internal. If a client sends mail from scripts to an external smart host, add the sending process or host to the allowlists. Raise severity where the same host also shows remote access tool installation (T1663 or T1219)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(python[0-9.]*|perl|ruby|node|php|bash|zsh|sh|curl|nc|ncat|osascript)$/ nocase
    (
      $net.target.port = 25 or
      $net.target.port = 465 or
      $net.target.port = 587
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1667")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
