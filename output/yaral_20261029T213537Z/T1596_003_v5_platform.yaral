/*
  MITRE Technique : T1596.003 - Digital Certificates
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:03:32.021029+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_003_IPS_TLS_Cert_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source whose connection to an internet-facing service triggers an IPS verdict describing TLS or certificate enumeration, scanning, probing or fingerprinting. Public certificate lookups (CT logs, third-party search engines) are not visible in victim telemetry, so this rule covers the observable part of T1596.003: direct certificate harvesting against the organisation's own TLS endpoints. Written for the PRE platform (external-facing network security telemetry), not for Windows hosts."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.003"
    mitre_technique_name = "Search Open Technical Databases: Digital Certificates"
    log_prerequisites = "IPS or network security appliance logs normalised to NETWORK_CONNECTION with security_result.rule_name or security_result.description populated with the signature or verdict text, and principal.ip as the external source. TLS or certificate-scan signatures must be enabled on the appliance."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external attack-surface or vulnerability scanners not yet in the allowlist, internet-wide research scanners, partner or monitoring services validating certificate expiry, and TLS compliance testing by the client's own consultants."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Review which signature names in this tenant match the regex and narrow or widen it accordingly. Because the logic depends on vendor signature wording, validate it against each client's IPS UDM mapping before enabling. Raise severity when the same source also appears in other reconnaissance detections."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.rule_name = /((ssl|tls|x\.?509|certificate|cert).{0,40}(enumerat|scan|probe|harvest|recon|fingerprint|grabb?ing)|(enumerat|scan|probe|harvest|recon|fingerprint|grabb?ing).{0,40}(ssl|tls|x\.?509|certificate|cert))/ nocase or
      $net.security_result.description = /((ssl|tls|x\.?509|certificate|cert).{0,40}(enumerat|scan|probe|harvest|recon|fingerprint|grabb?ing)|(enumerat|scan|probe|harvest|recon|fingerprint|grabb?ing).{0,40}(ssl|tls|x\.?509|certificate|cert))/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1596.003")
    $primary_entity = array_distinct($net.principal.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $signatures = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
