/*
  MITRE Technique : T1547.007 - Re-opened Applications
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:45:22.927332+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_007_Unexpected_Parent_Modifies_Loginwindow_Reopen_Plist {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an unexpected parent process (Office application, browser, web server, database service, print daemon, or runtime host) spawning a shell, script interpreter, or plist-editing utility that references the loginwindow re-open plist (com.apple.loginwindow.*.plist in ByHost, or the TALAppsToRelaunchAtLogin key). This lineage indicates persistence via Re-opened Applications launched from a compromised or exploited application rather than by a user or administrator."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.007"
    mitre_technique_name = "Boot or Logon Autostart Execution: Re-opened Applications"
    log_prerequisites = "Requires macOS endpoint process telemetry with populated parent (principal.process) and child (target.process) executable paths and command lines."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Browser or Office helper processes launching legitimate scripts that touch loginwindow preferences, developer tooling run under node or java that manages login items, MDM or configuration management scripts launched via an uncommon parent, and administrators testing re-open behaviour."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. Extend or narrow the parent regex to match the applications in the client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(Microsoft (Word|Excel|PowerPoint|Outlook)|Safari|Google Chrome|firefox|httpd|nginx|php-fpm|mysqld|postgres|cupsd|java|node)[^\/]*$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|zsh|osascript|python[0-9.]*|perl|ruby|defaults|PlistBuddy|plutil)$/ nocase
    $proc.target.process.command_line = /(com\.apple\.loginwindow|Library\/Preferences\/ByHost|TALAppsToRelaunchAtLogin)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
