/*
  MITRE Technique : T1592 - Gather Victim Host Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:33:40.118238+00:00
  Reference       : https://attack.mitre.org/techniques/T1592
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_Inbound_External_Host_Fingerprint_Service_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a connection from an external (non-internal) source to a port whose service discloses host details such as OS version, hostname or domain name (NetBIOS, SNMP, RPC, SMB, RDP, WinRM). Remote probing of these services is a common way to gather victim host information before targeting. The rule is behavioural and uses destination port and direction only, with no scanner tool names or hardcoded addresses. It fires on both allowed and denied connections, because the probe itself is the signal."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592"
    mitre_technique_name = "Gather Victim Host Information"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated for inbound traffic. Both permitted and denied connections should be logged."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, internet-wide research scanners, intentionally exposed remote access (RDP, WinRM) used by staff or vendors, partner or VPN-concentrator traffic that appears as external, and SNMP monitoring by an external managed-service provider."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners, approved remote or partner source addresses to %global_allowed_mgmt_sources, and approved remote management sources to %global_allowed_remote_mgmt. This rule is deliberately low severity because internet background scanning is constant. For alert-volume control, deploy the threshold variant (distinct target IPs or ports per source over a time window) alongside it, or restrict the port set to services that should never be internet-reachable for the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip != ""
    $net.target.ip != ""
    (
      $net.target.port = 135 or
      $net.target.port = 137 or
      $net.target.port = 139 or
      $net.target.port = 161 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1592")
    $primary_entity = array_distinct($net.principal.ip)
    $probed_targets = array_distinct($net.target.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
