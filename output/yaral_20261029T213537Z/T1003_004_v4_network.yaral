/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:38:39.905239+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_Reg_Utility_External_SMB_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the built-in Windows registry utility making an outbound SMB connection to a non-internal address. reg.exe does not normally open network connections. When it does, it is usually saving or exporting the SECURITY/SAM/SYSTEM hives (which hold LSA secrets) to a remote UNC share, or operating on a remote registry. Internal address space is excluded via reference list to keep noise low."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path for outbound connections (EDR or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators managing registries of remote hosts across a routed or VPN address range not listed in %rfc1918_internal; cloud-hosted file shares used by sanctioned IT scripts; software deployment tooling that shells out to reg.exe against remote targets."
    tuning_guidance = "Make sure %rfc1918_internal covers all internal and VPN ranges for the client. Add approved administrative tooling to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. To hunt for internal remote-registry lateral movement, clone the rule and drop the %rfc1918_internal exclusion, then scope it by source host instead."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\reg\.exe$/ nocase
    ($net.target.port = 445 or $net.target.port = 139)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
