/*
  MITRE Technique : T1070.010 - Relocate Malware
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:04:10.645156+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_010_macOS_Payload_Fetch_DirectIP_Script_Or_Package {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a macOS client (Darwin, curl or CFNetwork user agent) fetching an executable, script, disk image, package or archive payload over HTTP from an external IP-literal URL. Staging or re-fetching a payload copy from raw infrastructure to replace or relocate an earlier artifact is the network-side signature of relocated malware. Domain-based downloads from known-good vendors are excluded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.010"
    mitre_technique_name = "Indicator Removal: Relocate Malware"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url and network.http.user_agent populated. TLS inspection is needed to see URLs on HTTPS traffic."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Developers pulling packages or scripts from raw-IP internal-lab or cloud hosts, Homebrew or MDM bootstrap scripts that use IP-literal URLs, and vendor installers served from CDNs by IP."
    tuning_guidance = "Add known-good vendor or update domains to %global_allowed_domains. Make sure %rfc1918_internal covers all internal address space for the client. Narrow the user-agent or extension regex if developer workstations are noisy."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /(darwin|cfnetwork|curl|libcurl)/ nocase
    $http.target.url = /^https?:\/\/[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]+)?\/.*\.(pkg|dmg|command|sh|zsh|py|scpt|applescript|dylib|plist|zip|tar|gz)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1070.010")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $fetched_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
