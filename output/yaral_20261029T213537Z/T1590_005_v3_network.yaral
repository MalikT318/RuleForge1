/*
  MITRE Technique : T1590.005 - IP Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:21:03.574565+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_005_External_Host_Header_IP_Literal_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source sending HTTP requests that are addressed to a raw IPv4 address (the Host/target is an IP literal rather than a hostname) and that the web service or inline security appliance rejected with a 4xx/5xx response. Legitimate users reach services by name, so this pattern is characteristic of internet-wide IP sweeps and scans enumerating which public addresses of an organisation host live web services (T1590.005 precursor activity)."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.005"
    mitre_technique_name = "Gather Victim Network Information: IP Addresses"
    log_prerequisites = "IDS/IPS or inline network security appliance emitting HTTP-layer events normalised to NETWORK_HTTP, with principal.ip, target.hostname (Host header or requested host) and network.http.response_code populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Internet background scanning and research crawlers (expected noise on any public address), misconfigured monitoring or load-balancer health checks that probe by IP, CDN or uptime services, and authorised external vulnerability scans not yet in the scanner list."
    tuning_guidance = "Add authorised external scanner and uptime-monitor source addresses to %global_allowed_scanners. Because this is noisy on internet-facing sensors, use it for enrichment and triage or raise severity only when the same principal_ip fires repeatedly across the targets. Tighten network.http.response_code if the appliance does not report the upstream status."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /^(\d{1,3}\.){3}\d{1,3}(:\d+)?$/
    $http.network.http.response_code >= 400
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1590.005")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_targets = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
