/*
  MITRE Technique : T1585.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:38:53.534531+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_003_Cloud_Account_Signup_Web_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP POST to an external cloud, storage or hosting-style service on an account sign-up or registration URL path, as seen at the perimeter. This is the network-visible footprint of creating a cloud account that could later stage tools, host infrastructure or receive exfiltrated data. It matches on behaviour (method, URL path semantics, hostname keywords) and not on named providers."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.003"
    mitre_technique_name = "Establish Accounts: Cloud Accounts"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection (TLS decryption or explicit proxy) that populate network.http.method, target.url and target.hostname, normalised to UDM NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate employee or developer registration for sanctioned SaaS, IaaS or trial services. Marketing, procurement or DevOps teams onboarding new cloud vendors. Security testing and sandbox traffic. Web crawlers or automation hitting sign-up forms."
    tuning_guidance = "Add approved vendor and SaaS domains to %global_allowed_domains. Add authorised testing sources to %global_allowed_scanners. Add approved cloud onboarding automation sources to %global_allowed_script_hosts. If volume is high, tighten the hostname keyword regex. If coverage is too narrow, remove the hostname keyword condition and rely on the allowlists."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|account\/create|new[-_]?account|free[-_]?trial|start[-_]?free)([\/?#]|$)/ nocase
    $net.target.hostname = /(cloud|storage|drive|vps|hosting|compute|serverless|bucket|s3|blob|share|files|workers)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1585.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
