/*
  MITRE Technique : T1583.008 - Malvertising
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:13:59.759503+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_008_Malvertising_AdClick_Installer_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound HTTP request to an external, non-allowlisted destination where the URL carries an advertising click-tracking identifier (for example gclid or msclkid) and the requested resource is an installer or archive file. This pattern is characteristic of malvertising, where a sponsored ad click leads to a lookalike site serving a trojanized download."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.008"
    mitre_technique_name = "Acquire Infrastructure: Malvertising"
    log_prerequisites = "Requires firewall or web proxy logs with URL-level visibility (TLS inspection or explicit proxy) that populate network.http.method, target.url and target.hostname. Without URL visibility this rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate vendors that run paid ad campaigns and serve installers directly from the ad landing URL, marketing-driven software trial downloads, and users downloading sanctioned software after clicking a search ad. Download sites and CDNs that pass ad-click parameters through to the file URL can also trigger it."
    tuning_guidance = "Add known-good vendor and download domains to %global_allowed_domains. Add scanners or web-crawling sources to %global_allowed_scanners. Extend the file extension list to match the client's risk appetite, or add other click-ID parameters seen in the client's proxy logs."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /[?&](gclid|msclkid|gbraid|wbraid|dclid|yclid)=/ nocase
    $net.target.url = /\.(exe|msi|msix|appx|dmg|pkg|iso|img|zip|7z|rar|js|vbs|ps1|bat|apk)(\?|#|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1583.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
