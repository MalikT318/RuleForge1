/*
  MITRE Technique : T1584 - Compromise Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:17:03.659397+00:00
  Reference       : https://attack.mitre.org/techniques/T1584
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_DNS_Long_Label_Query_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host issues a burst of DNS queries with very long, encoded-looking subdomain labels to domains outside the known-good list within ten minutes. One long label is common in CDN and security-vendor lookups. A sustained volume of them suggests the host is talking to compromised or hijacked DNS infrastructure used for C2 or data staging."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584"
    mitre_technique_name = "Compromise Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS, with network.dns.questions.name populated and a client hostname in principal.hostname."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and reputation services (DNSBL, DKIM-style lookups), CDN and cloud-provider hostnames with long generated labels, anti-malware cloud lookups, service-discovery and telemetry endpoints, and some VPN and mDNS-style tooling."
    tuning_guidance = "Add known-good domains to %global_allowed_domains. Add vulnerability scanners or approved testing hosts to %global_allowed_scanners. The match is on the full queried name, so add the exact names that recur. Raise the #dns threshold or lengthen the label-length quantifier (40) if noisy; lower the threshold for high-value hosts."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_\-]{40,}\./ nocase
    $dns.principal.hostname = $host
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1584")
    $primary_entity = array_distinct($host)
    $event_count = count($dns.metadata.id)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    #dns >= 15
}
