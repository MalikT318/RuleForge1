/*
  MITRE Technique : T1583.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:08:24.414526+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_005_DNS_Tunnel_Query_Then_DGA_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single client issues a TXT or NULL DNS query with a long encoded-looking subdomain label, then within ten minutes resolves another long algorithmic-looking name using A or AAAA records. This pairing suggests a bot or ORB node signalling a C2 channel and then resolving generated rendezvous domains. It is a behavioural indicator of botnet membership, not proof of acquisition."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.005"
    mitre_technique_name = "Acquire Infrastructure: Botnet"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with the client source IP (principal.ip), question name and question type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-provider hostnames with long machine-generated labels, mail gateways doing DKIM/SPF/DMARC TXT lookups, DNS-based blocklist (DNSBL) lookups, software licensing and telemetry services using encoded labels, and security products that query DNS to check reputation."
    tuning_guidance = "Add known-good CDN, vendor and update domains to %global_allowed_domains. If the DNS log shows a shared forwarder or NAT address instead of the real client, join on a more specific client identifier or exclude that resolver. Raise the label-length thresholds (20 and 24) in noisy environments, or lower them for higher sensitivity."

  events:
    $txt.metadata.event_type = "NETWORK_DNS"
    ($txt.network.dns.questions.type = 16 or $txt.network.dns.questions.type = 10)
    $txt.network.dns.questions.name = /^[a-z0-9]{20,}\.[^.]+/ nocase
    not $txt.network.dns.questions.name in %global_allowed_domains
    $txt.principal.ip = $client

    $dga.metadata.event_type = "NETWORK_DNS"
    ($dga.network.dns.questions.type = 1 or $dga.network.dns.questions.type = 28)
    $dga.network.dns.questions.name = /^[a-z0-9]{24,}\.[^.]+\.[a-z]{2,}$/ nocase
    not $dga.network.dns.questions.name in %global_allowed_domains
    $dga.principal.ip = $client

    $txt.metadata.event_timestamp.seconds <= $dga.metadata.event_timestamp.seconds

  match:
    $client over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.005")
    $primary_entity = array_distinct($client)
    $txt_query_names = array_distinct($txt.network.dns.questions.name)
    $dga_query_names = array_distinct($dga.network.dns.questions.name)
    $dga_query_count = count($dga.metadata.id)

  condition:
    $txt and $dga
}
