/*
  MITRE Technique : T1568.001 - Fast Flux DNS
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:49:56.311227+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_001_ESXi_Resolver_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a modification of the ESXi host DNS resolver configuration (DNS servers, search domains, resolver settings) by an account that is not an approved administrator or service account. Fast-flux C2 relies on the host resolving attacker-controlled names, and redirecting the host resolver to an adversary-controlled DNS server is the host-level state change that supports it. This is a configuration-state proxy for T1568.001 and does not observe fast-flux DNS answers directly. Pair it with network DNS telemetry for full coverage."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.001"
    mitre_technique_name = "Dynamic Resolution: Fast Flux DNS"
    log_prerequisites = "ESXi hostd and shell logs forwarded and parsed to UDM SETTING_MODIFICATION events, with principal.user.userid and principal.hostname populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Initial host build or re-IP, host profile or auto-deploy remediation, vCenter-driven network changes, planned DNS server migrations, and approved administrators changing DNS."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or lifecycle accounts to %global_allowed_service_accounts. Review changes made outside change windows first. If the resource naming differs in your parser, adjust the regex to the DNS-related setting names your hostd parser emits."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.target.resource.name = /(dns|resolv|nameserver|name[_ ]?server|search[_ ]?domain)/ nocase or
      $setting.metadata.description = /(dns|resolv|nameserver|name[_ ]?server|search[_ ]?domain)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1568.001")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
