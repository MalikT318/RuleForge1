/*
  MITRE Technique : T1595 - Active Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:51:15.593888+00:00
  Reference       : https://attack.mitre.org/techniques/T1595
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_Inbound_External_Probe_Risky_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an inbound connection from an external (non-RFC1918) source to a service port commonly probed during internet-wide and targeted scanning, such as telnet, SMB, RDP, VNC, database, cache, search and container-API ports. These ports should rarely be reachable from the internet. A hit indicates reconnaissance against perimeter-exposed infrastructure, or an exposure that needs review. Because blocked and allowed connections are both logged, the rule covers scanning that the perimeter drops as well as scanning that succeeds."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595"
    mitre_technique_name = "Active Scanning"
    log_prerequisites = "Perimeter firewall or network flow logs normalised to UDM NETWORK_CONNECTION with principal.ip (source), target.ip and target.port populated. Logs must include denied/dropped connections to capture scans the firewall blocks."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, penetration tests, legitimately published services such as VPN-fronted RDP or a public SSH/database endpoint, partner or vendor remote-support connections, and NAT'd egress traffic logged with a public source address."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add approved management source addresses to %global_allowed_mgmt_sources. Add approved remote-support source addresses to %global_allowed_remote_mgmt. Per client, remove ports from the list that are intentionally published. Raise severity or pair with a volume-based threshold rule for the same source IP if single-hit alert volume is too high."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip != ""
    $net.target.ip != ""
    (
      $net.target.port = 23 or
      $net.target.port = 2323 or
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 5432 or
      $net.target.port = 6379 or
      $net.target.port = 9200 or
      $net.target.port = 11211 or
      $net.target.port = 27017 or
      $net.target.port = 2375 or
      $net.target.port = 7547 or
      $net.target.port = 5985
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1595")
    $primary_entity = array_distinct($net.principal.ip)
    $scanned_targets = array_distinct($net.target.ip)
    $scanned_ports = array_distinct($net.target.port)

  condition:
    $net
}
