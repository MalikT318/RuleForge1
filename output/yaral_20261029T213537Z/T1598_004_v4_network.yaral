/*
  MITRE Technique : T1598.004 - Spearphishing Voice
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:17:35.613747+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_004_External_SIP_Signaling_From_Internal_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal host opening SIP signaling (TCP/UDP 5060 or 5061) to an external destination, with RFC1918 space excluded via reference list. This is a network-side proxy for softphone or VoIP callback activity that can follow a vishing or callback-phishing lure (T1598.004). The voice call itself is not visible on the wire, so this is a low-fidelity hunting-grade signal that should be triaged alongside user reports of suspicious calls."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.004"
    mitre_technique_name = "Phishing for Information: Spearphishing Voice"
    log_prerequisites = "Firewall or perimeter connection logs that record the destination port and destination IP, normalised to UDM NETWORK_CONNECTION."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Corporate PBX, SBC, or SIP trunk traffic; sanctioned softphone or UCaaS clients; contact-center agents; VoIP desk phones; home-office users on VPN with a softphone."
    tuning_guidance = "Add approved PBX/SBC source addresses to %global_allowed_mgmt_sources and approved SIP provider domains to %global_allowed_domains. Where UCaaS is widely used, restrict the rule to user VLANs or raise the severity only when the source is not a known voice network."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 5060 or $net.target.port = 5061)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1598.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
