/*
  MITRE Technique : T1591 - Gather Victim Org Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:25:28.367865+00:00
  Reference       : https://attack.mitre.org/techniques/T1591
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_External_Org_Info_Path_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting web paths that expose organisational structure or personnel data (org charts, staff or employee directories, rosters, exported contact lists), as seen by an IDS/IPS or network security appliance. This is typical of pre-compromise reconnaissance to gather victim organisation information for later phishing or social engineering. Written for the PRE platform, using external-facing network telemetry only."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591"
    mitre_technique_name = "Gather Victim Org Information"
    log_prerequisites = "IDS/IPS or inline network security appliance logs with HTTP inspection populated in UDM (target.url, principal.ip). Appliance must see traffic to externally exposed web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine crawlers and SEO tooling indexing public staff or team pages, legitimate partners or customers using a public directory, HR or recruiting integrations, authorised external attack-surface or penetration testing, and monitoring probes."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners. If the organisation intentionally publishes a staff directory, narrow the path regex to exclude that path. To reduce noise, route to a dashboard rather than alerting, or raise severity when the same source also appears in port-scan or web-exploit detections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(org[-_ ]?chart|organi[sz]ation[-_ ]?chart|staff[-_ ]?(list|directory|roster)|employee[-_ ]?(list|directory|roster|contacts?)|phone[-_ ]?directory|email[-_ ]?directory|contact[-_ ]?list|personnel|key[-_ ]?contacts)([\/\.\?_-]|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1591")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
