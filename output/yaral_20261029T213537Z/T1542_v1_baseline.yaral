/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:24:55.814090+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_External_TFTP_Network_Boot {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound TFTP (UDP/69) from an internal host to a non-internal destination. TFTP is the transfer protocol used by PXE/network boot to pull boot loaders and boot images before the OS loads. Such traffic crossing the perimeter is anomalous and may indicate network-boot abuse to load a malicious pre-OS boot image. This is the network-observable signal only; firewall logs cannot see firmware or bootloader tampering on the host itself."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with target.port, target.ip and network.ip_protocol populated. Traffic must be logged on the egress path."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Remote-site or branch PXE/WDS deployments booting from a central provisioning server across a WAN link, cloud-hosted imaging services, legacy network devices or appliances pulling configs or firmware over TFTP, lab and provisioning networks."
    tuning_guidance = "Add approved provisioning, imaging, or deployment source addresses to %global_allowed_mgmt_sources. Where branch-office PXE across the perimeter is normal, add the branch source ranges to the same list. Review whether the destination is a known provisioning service before escalating."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
