/*
  MITRE Technique : T1583.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:58:53.856173+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_001_DNS_Punycode_IDN_Homograph_Domain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for a registrable domain whose second-level label is Punycode-encoded (xn--). This is the network-side footprint of IDN homograph domains that adversaries acquire to impersonate legitimate brands for phishing, drive-by delivery and C2. Queries for known-good domains and queries that resolve only to internal address space are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.001"
    mitre_technique_name = "Acquire Infrastructure: Domains"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Answer data (network.dns.answers.data) is used for internal-address exclusion when present."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate internationalised domains (non-Latin-script businesses, regional news and government sites, IDN country-code TLDs), browser IDN support checks, and security-awareness or brand-protection tooling that resolves lookalike domains."
    tuning_guidance = "Add known-good Punycode domains (FQDNs) to %global_allowed_domains. In regions where IDNs are common, raise severity only when combined with other signals such as a newly observed domain or a user-click event. %rfc1918_internal is matched as exact strings against DNS answer data."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)xn--[a-z0-9-]+\.[a-z0-9-]+\.?$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.001")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $resolved_answers = array_distinct($dns.network.dns.answers.data)

  condition:
    $dns
}
