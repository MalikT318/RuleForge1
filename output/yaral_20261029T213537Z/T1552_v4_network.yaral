/*
  MITRE Technique : T1552 - Unsecured Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:36:58.965348+00:00
  Reference       : https://attack.mitre.org/techniques/T1552
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_SaaS_Network_Credential_File_Web_Retrieval {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external client successfully retrieving a well-known credential or secret-bearing file (environment files, cloud credential files, private keys, password files, secrets or config exports) over HTTP from a SaaS-hosted application or tenant. This is the network-side result of unsecured credentials being exposed and harvested, and it does not depend on endpoint process telemetry."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552"
    mitre_technique_name = "Unsecured Credentials"
    log_prerequisites = "Requires SaaS or identity-fronted web and API access logs normalised to NETWORK_HTTP, with principal.ip, target.url and network.http.response_code populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Authorised vulnerability scanners and penetration tests, external attack-surface monitoring services, uptime or crawler bots probing common paths (usually receive 404 and are filtered by the 2xx condition), legitimate public configuration files with a matching name, and developers fetching their own files through an approved gateway."
    tuning_guidance = "Add approved scanner and pen-test source addresses to %global_allowed_scanners. Extend %rfc1918_internal if internal proxies present non-private addresses. If a SaaS app legitimately publishes a file with a matching name, narrow the regex per client or scope by target.hostname. Raise or lower severity depending on whether the target host is production."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(\/|^)(\.env|\.git\/config|\.aws\/credentials|\.npmrc|\.htpasswd|\.pgpass|\.netrc|\.docker\/config\.json|id_rsa|id_dsa|id_ecdsa|id_ed25519|credentials\.json|client_secrets?\.json|secrets?\.(json|ya?ml)|appsettings\.json|wp-config\.php(\.bak|\.old|~)?)(\?.*)?$/ nocase
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $target_hosts = array_distinct($net.target.hostname)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
