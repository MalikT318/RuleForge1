/*
  MITRE Technique : T1583.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:02:39.112069+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_003_Direct_To_IP_HTTP_External_Infrastructure {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP request through a perimeter proxy or firewall to an external destination addressed by a raw IPv4 literal instead of a domain name. Operators of adversary-rented VPS infrastructure commonly run staging, payload-delivery and C2 services without registering a domain. This rule observes use of such infrastructure on the network side. It cannot observe the acquisition of a VPS, which happens outside the victim's telemetry."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.003"
    mitre_technique_name = "Acquire Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires firewall or proxy logs that populate HTTP host or URL information (normalised to NETWORK_HTTP) with target.hostname holding the requested Host value and target.ip holding the resolved destination."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software updaters and appliances that call vendor IPs directly, IoT and OT devices, internal health checks that reach external load balancers by IP, captive-portal detection, authorised vulnerability scanning or penetration testing, and developers testing their own cloud-hosted VPS instances."
    tuning_guidance = "Add authorised scanner source hostnames to %global_allowed_scanners. Add known-good vendor hosts to %global_allowed_domains. Exclude noisy internal source hosts or appliances by adding their hostnames to %global_allowed_scanners after review. To raise precision, add a port restriction such as $net.target.port != 443, or move to a threshold variant that counts distinct internal sources per destination."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.hostname = /^\d{1,3}(\.\d{1,3}){3}$/
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1583.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
