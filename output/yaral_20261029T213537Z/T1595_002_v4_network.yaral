/*
  MITRE Technique : T1595.002 - Vulnerability Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:54:40.585912+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_002_External_Probe_Of_Sensitive_Web_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting well-known sensitive or exposed-by-misconfiguration web paths (environment files, VCS metadata, debug and management endpoints, config backups) on a perimeter-observed HTTP flow. These requests have no legitimate use for an external visitor, and they are the core behaviour of automated vulnerability and exposure scanning against public-facing applications."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.002"
    mitre_technique_name = "Active Scanning: Vulnerability Scanning"
    log_prerequisites = "Requires perimeter HTTP visibility normalised to UDM NETWORK_HTTP with principal.ip and target.url populated (reverse proxy, web gateway or firewall with HTTP inspection, TLS-terminated)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scans or penetration tests, third-party attack-surface monitoring services engaged by the client, uptime or health checkers that probe actuator or status endpoints, and legitimate public monitoring of a deliberately exposed status page."
    tuning_guidance = "Add authorised scanner and pen-test source IPs to %global_allowed_scanners. Add approved management or monitoring sources to %global_allowed_mgmt_sources. Extend or trim the path regex for applications that legitimately expose a listed path externally. For volume-based escalation, pair this rule with a threshold variant grouped by source IP."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/(\.env|\.git\/(config|HEAD)|\.svn\/entries|\.aws\/credentials|\.htpasswd|\.DS_Store|phpmyadmin|phpinfo\.php|server-status|actuator\/(env|heapdump|configprops)|wp-config\.php(\.bak|~)?|web\.config(\.bak|\.old)?|backup\.(zip|sql|tar\.gz))(\?|\/|$)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1595.002")
    $primary_entity = array_distinct($net.principal.ip)
    $probed_urls = array_distinct($net.target.url)
    $target_hosts = array_distinct($net.target.hostname)
    $http_methods = array_distinct($net.network.http.method)
    $response_codes = array_distinct($net.network.http.response_code)

  condition:
    $net
}
