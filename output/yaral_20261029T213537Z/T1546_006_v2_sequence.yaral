/*
  MITRE Technique : T1546.006 - LC_LOAD_DYLIB Addition
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:29:27.723657+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_006_Dylib_Dropped_Then_App_Binary_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A dylib is written to a user-writable staging location and, within 10 minutes, a Mach-O executable inside an application bundle or a local bin directory is modified on the same host by a non-installer process. This is the file-level result of LC_LOAD_DYLIB injection, where a binary's load commands are rewritten to load an attacker dylib. It does not rely on process command lines."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.006"
    mitre_technique_name = "Event Triggered Execution: LC_LOAD_DYLIB Addition"
    log_prerequisites = "Requires macOS endpoint telemetry that reports FILE_CREATION and FILE_MODIFICATION events with the acting process path and target file path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developers building dylibs and patching local binaries (compilers, linkers, codesign and install_name_tool workflows), application self-updaters replacing bundle executables, package managers and installers, and MDM or software-deployment agents."
    tuning_guidance = "Add approved deployment and developer tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Extend the installer and updater process-name exclusion regex in the events block if a client has custom updaters. Consider restricting to non-developer host groups if build activity is noisy."

  events:
    $dylib.metadata.event_type = "FILE_CREATION"
    $dylib.target.file.full_path = /\.dylib$/ nocase
    $dylib.target.file.full_path = /^\/((private\/)?(tmp|var\/tmp)|private\/var\/folders|var\/folders)\/|^\/Users\/(Shared|[^\/]+\/(Library|Downloads|Desktop))\// nocase
    not $dylib.principal.process.file.full_path in %global_allowed_admin_tools
    not $dylib.principal.process.file.full_path in %global_allowed_security_tools
    not $dylib.principal.process.file.full_path = /\/(installd|system_installd|Installer|softwareupdated|mdmclient|pkgd_[a-z]+)$/ nocase
    $dylib.principal.hostname = $hostname

    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.target.file.full_path = /\.app\/Contents\/MacOS\/[^\/]+$|^\/(usr\/local\/bin|opt\/homebrew\/bin|Applications)\/[^\/]+$/ nocase
    not $mod.target.file.full_path = /\.(plist|dylib|json|log|txt|db|sqlite|cfg|conf)$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path = /\/(installd|system_installd|Installer|softwareupdated|mdmclient|Autoupdate|Sparkle|brew)$/ nocase
    $mod.principal.hostname = $hostname

    $dylib.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1546.006")
    $primary_entity = array_distinct($hostname)
    $dropped_dylibs = array_distinct($dylib.target.file.full_path)
    $dropper_processes = array_distinct($dylib.principal.process.file.full_path)
    $modified_binaries = array_distinct($mod.target.file.full_path)
    $modifier_processes = array_distinct($mod.principal.process.file.full_path)
    $modified_count = count($mod.metadata.id)

  condition:
    $dylib and $mod
}
