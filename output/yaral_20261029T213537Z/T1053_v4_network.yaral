/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:44:24.764753+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Scheduled_Task_Child_LOLBin_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or living-off-the-land binary launched by the Windows Task Scheduler engine (taskeng/taskhostw, or svchost hosting the Schedule service) that opens an outbound network connection to a non-internal address. This is the network-side footprint of a scheduled task used for persistence or recurring execution that beacons out, downloads payloads or exfiltrates data. It is independent of how the task was created or what its command line looked like."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires endpoint network telemetry (EDR network events or Sysmon Event ID 3) that populates the initiating process and its parent process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate scheduled jobs that run PowerShell or cmd to call external APIs, such as inventory, patching, licence checks and cloud backup scripts. Also RMM agents, software updaters that use scheduled tasks, and monitoring scripts that check external endpoints."
    tuning_guidance = "Add approved task-launched tooling to %global_allowed_admin_tools. Add known-good destinations to %global_allowed_domains. Add EDR and AV agents to %global_allowed_security_tools. Add service accounts that run sanctioned scheduled automation to %global_allowed_service_accounts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\\(taskeng|taskhostw)\.exe$/ nocase
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|mshta|rundll32|regsvr32|wscript|cscript|bitsadmin|certutil|msiexec|installutil|regasm|regsvcs|curl)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $launching_process = array_distinct($net.principal.process.file.full_path)
    $scheduler_parent = array_distinct($net.principal.process.parent_process.file.full_path)

  condition:
    $net
}
