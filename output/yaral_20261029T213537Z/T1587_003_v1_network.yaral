/*
  MITRE Technique : T1587.003 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:50:17.443397+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_003_Self_Signed_Server_Cert_External_TLS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound TLS connection to an external destination where the server certificate is self-signed (issuer identical to subject). Adversaries commonly generate self-signed certificates for C2 and staging infrastructure. This detects the network-observable result of that certificate use and does not depend on endpoint process data."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.003"
    mitre_technique_name = "Develop Capabilities: Digital Certificates"
    log_prerequisites = "Requires perimeter firewall or proxy logs with TLS inspection or certificate metadata, so that network.tls.server.certificate issuer and subject are populated. Without certificate fields the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet-facing appliances (VPN gateways, IoT devices, printers, NAS, hypervisor management interfaces) that ship default self-signed certificates. Developer or test infrastructure, SaaS on-premises connectors, and vendor update services that use private PKI."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains (matched against the TLS SNI). Add authorised scanning sources to %global_allowed_scanners. Add approved management sources to %global_allowed_mgmt_sources. Maintain %rfc1918_internal for the tenant's internal ranges. Consider raising severity for non-standard destination ports or for destinations seen only once."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.tls.server.certificate.issuer != ""
    $net.network.tls.server.certificate.subject != ""
    $net.network.tls.server.certificate.issuer = $net.network.tls.server.certificate.subject
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.network.tls.client.server_name in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1587.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $tls_server_names = array_distinct($net.network.tls.client.server_name)
    $cert_subject = array_distinct($net.network.tls.server.certificate.subject)

  condition:
    $net
}
