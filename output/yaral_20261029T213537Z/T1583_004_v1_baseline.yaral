/*
  MITRE Technique : T1583.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:04:23.436384+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_004_Direct_To_IP_HTTP_Adversary_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP/HTTPS request whose URL host is a raw public IP literal rather than a domain name. This is a network-observable sign of adversary-operated server infrastructure (staging, phishing or C2 hosting) that has no registered domain. Legitimate software almost always uses DNS names, so IP-literal URLs to external addresses are a high-signal pivot for infrastructure triage."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.004"
    mitre_technique_name = "Acquire Infrastructure: Server"
    log_prerequisites = "Requires perimeter proxy or firewall logs with URL inspection (HTTP or TLS-inspected HTTPS) that populate network.http and target.url, plus target.ip in UDM."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software updaters or telemetry agents that contact CDN or appliance IPs directly, IoT and embedded devices, captive portals, vendor health checks, vulnerability scanners and authorised pen-test sources, and developers testing against cloud VMs by IP."
    tuning_guidance = "Add scanner source addresses to %global_allowed_scanners, known-good external domains to %global_allowed_domains, and approved management source addresses to %global_allowed_mgmt_sources. If a client's proxy only logs the destination IP as the URL for all traffic, restrict this rule to clients with full URL logging or raise the severity threshold."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^(https?:\/\/)?(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?(\/|\?|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
