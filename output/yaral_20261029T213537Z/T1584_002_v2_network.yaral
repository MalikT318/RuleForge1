/*
  MITRE Technique : T1584.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:20:07.276861+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_002_DNS_Tunnel_Query_To_External_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for TXT or NULL records with an abnormally long subdomain label that are sent to a non-internal resolver. This is characteristic of C2 or data exfiltration through DNS infrastructure the adversary controls or has compromised, such as a hijacked third-party DNS server. Internal resolvers and known-good domains are excluded through reference lists."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.002"
    mitre_technique_name = "Compromise Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS, with network.dns.questions.name, network.dns.questions.type, and target.ip (resolver address) populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "DNS-based blocklist or reputation lookups, email authentication (DKIM/SPF/DMARC) TXT lookups with long selectors, CDN or cloud services using long hashed labels, some AV and telemetry products that encode data in DNS queries, and clients configured to use public resolvers."
    tuning_guidance = "Add known-good parent domains to %global_allowed_domains. Verify that %rfc1918_internal covers the customer's internal resolvers. If internal resolvers use public addresses, add those resolver names to the exclusion lists. Lower the label length threshold (50) to increase sensitivity or raise it to reduce noise."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /[a-z0-9_-]{50,}\./ nocase
    not $dns.target.ip in %rfc1918_internal
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ip = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $resolver_ip = array_distinct($dns.target.ip)

  condition:
    $dns
}
