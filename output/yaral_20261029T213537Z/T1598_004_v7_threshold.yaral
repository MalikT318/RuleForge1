/*
  MITRE Technique : T1598.004 - Spearphishing Voice
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:18:19.730736+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_004_Inbound_VoIP_Signaling_Volume_Single_Target {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a high volume of inbound external VoIP signaling connections (SIP ports 5060/5061) to a single internal endpoint within 10 minutes. A single signaling connection is routine telephony. A burst against one endpoint is consistent with automated or manual vishing, callback-phishing infrastructure, or SIP enumeration used to elicit information from a targeted user."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.004"
    mitre_technique_name = "Phishing for Information: Spearphishing Voice"
    log_prerequisites = "Requires perimeter firewall or network flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for inbound traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SIP trunk or hosted PBX provider traffic, softphone registration bursts after an outage or restart, conferencing and unified-communications platforms, internet-wide SIP scanners hitting exposed PBX or voice gateways, and authorised voice security testing."
    tuning_guidance = "Add approved SIP trunk and voice provider source addresses to %global_allowed_mgmt_sources, and authorised testing sources to %global_allowed_scanners. Raise the #net threshold for tenants with busy exposed voice gateways. Lower it for tenants with no inbound SIP exposure, where any such traffic is suspicious."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 5060 or $net.target.port = 5061)
    $net.target.ip = $target_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $target_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1598.004")
    $primary_entity = array_distinct($target_ip)
    $event_count = count($net.metadata.id)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
