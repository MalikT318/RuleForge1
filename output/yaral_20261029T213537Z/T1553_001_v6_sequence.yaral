/*
  MITRE Technique : T1553.001 - Gatekeeper Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:40:02.023089+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_001_Quarantine_Xattr_Stripped_Then_Untrusted_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the com.apple.quarantine extended attribute being removed with xattr (-d on the quarantine attribute, or -c to clear all attributes), followed within 10 minutes on the same host by execution of a binary from a user-writable download or staging location (Downloads, Desktop, /tmp, mounted volumes). This sequence indicates an attempt to bypass the Gatekeeper first-run prompt."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.001"
    mitre_technique_name = "Subvert Trust Controls: Gatekeeper Bypass"
    log_prerequisites = "macOS endpoint telemetry with process launch events that include full command line, executable path and parent process path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developers clearing quarantine from locally built or internally distributed tools, IT packaging and deployment scripts, power users opening trusted unsigned software, and Homebrew or other package managers that strip quarantine from installed applications."
    tuning_guidance = "Add approved deployment and packaging tooling to %global_allowed_admin_tools. Add developer or build accounts to %global_allowed_admin_users. Add approved script-running parents to %global_allowed_script_hosts. If developer-heavy tenants are noisy, narrow the staging path regex in the $exec block."

  events:
    $xattr.metadata.event_type = "PROCESS_LAUNCH"
    $xattr.target.process.file.full_path = /\/xattr$/ nocase
    $xattr.target.process.command_line = /(\s-[a-z]*d[a-z]*\s+(\S+\s+)*com\.apple\.quarantine|\s-[a-z]*c[a-z]*\s)/ nocase
    not $xattr.principal.process.file.full_path in %global_allowed_admin_tools
    not $xattr.principal.process.file.full_path in %global_allowed_script_hosts
    not $xattr.principal.user.userid in %global_allowed_admin_users
    $xattr.principal.hostname = $host

    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.target.process.file.full_path = /^\/(Users\/[^\/]+\/(Downloads|Desktop)|private\/tmp|tmp|Volumes\/[^\/]+)\// nocase
    not $exec.target.process.file.full_path = /\/(xattr|xcodebuild|codesign|spctl)$/ nocase
    not $exec.principal.process.file.full_path in %global_allowed_admin_tools
    $exec.principal.hostname = $host

    $xattr.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.001")
    $primary_entity = array_distinct($host)
    $xattr_commands = array_distinct($xattr.target.process.command_line)
    $executed_paths = array_distinct($exec.target.process.file.full_path)
    $users = array_distinct($exec.principal.user.userid)

  condition:
    $xattr and $exec
}
