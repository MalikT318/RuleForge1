/*
  MITRE Technique : T1596 - Search Open Technical Databases
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:58:32.528384+00:00
  Reference       : https://attack.mitre.org/techniques/T1596
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_External_Source_Perimeter_Probing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single external source IP generating a high volume of connection events seen by the IPS within 10 minutes. This is the traffic-side footprint of an actor enumerating exposed services, using results harvested from open technical databases (internet-wide scan data, passive DNS, certificate records) or probing the same targets directly. A single connection is benign. The volume from one external source is the signal. The breadth of targets and ports is reported in the outcome for triage."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596"
    mitre_technique_name = "Search Open Technical Databases"
    log_prerequisites = "Requires IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION events, with principal.ip populated for the connecting source. Sensor must have visibility of inbound perimeter traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and external attack-surface monitoring, uptime and availability monitors, search-engine and research crawlers, CDN or reverse-proxy health checks, partner or customer systems with legitimately high connection rates, NAT gateways aggregating many users behind one address."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Add trusted management or partner sources to %global_allowed_mgmt_sources. Raise or lower the #conn threshold per client based on baseline perimeter noise. A higher distinct_ports or distinct_targets count in the outcome indicates broader enumeration and warrants higher triage priority."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.principal.ip = $src
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1596")
    $primary_entity = array_distinct($src)
    $event_count = count($conn.metadata.id)
    $distinct_ports = count_distinct($conn.target.port)
    $distinct_targets = count_distinct($conn.target.ip)
    $targeted_ports = array_distinct($conn.target.port)

  condition:
    #conn >= 50
}
