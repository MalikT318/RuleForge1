/*
  MITRE Technique : T1010 - Application Window Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:51:30.114177+00:00
  Reference       : https://attack.mitre.org/techniques/T1010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1010_macOS_TCC_Database_Tampered_Window_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the macOS TCC privacy database (Accessibility / Screen Recording grants) by a process other than the TCC daemon or approved management tooling. Enumerating open application windows and window titles through System Events, JXA or the CoreGraphics window-list APIs depends on these TCC permissions, so a direct write to TCC.db is a state-change precursor to window discovery. This detects the permission change, not the enumeration itself, so it complements command-line rules. Direct writes by interpreters, sqlite3 or unknown binaries are rare in normal operation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1010"
    mitre_technique_name = "Application Window Discovery"
    log_prerequisites = "Requires macOS endpoint file-event telemetry (FILE_MODIFICATION) with populated principal process path and target file path, including coverage of /Library/Application Support/com.apple.TCC and /Users/*/Library/Application Support/com.apple.TCC."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or PPPC profile deployment agents, remote support tools that pre-grant Accessibility or Screen Recording, endpoint security agents enrolling themselves, OS upgrades and migration assistants, and IT staff resetting permissions via scripts."
    tuning_guidance = "Add MDM, RMM and remote-support binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt, and EDR/security agent binaries to %global_allowed_security_tools. Adjust the OS-process exclusion regex for client-specific management agents. Consider raising severity when the writing process is an interpreter (osascript, python, sqlite3) running from /tmp or a user Library path."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/Library\/Application Support\/com\.apple\.TCC\/TCC\.db(-journal|-wal|-shm)?$/ nocase
    not $file.principal.process.file.full_path = /\/(tccd|tccutil|mdmclient|MobileDeviceUpdater|System Settings|System Preferences|systemsettings|installd|system_installd|Migration Assistant)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1010")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $modified_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
