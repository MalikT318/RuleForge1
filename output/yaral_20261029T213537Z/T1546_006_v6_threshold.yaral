/*
  MITRE Technique : T1546.006 - LC_LOAD_DYLIB Addition
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:30:41.876868+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_006_Mass_Dylib_Drop_UserWritable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects several .dylib files written to user-writable or staging locations (/Users/*/Library, Downloads, Desktop, /Users/Shared, /tmp, /private/var/tmp) on a single macOS host within ten minutes by a process that is not an approved installer, toolchain or management tool. A single dylib write is routine. A burst of dylib drops in these locations is consistent with staging of malicious libraries for LC_LOAD_DYLIB injection into tainted Mach-O binaries, or with dylib hijacking and persistence preparation."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.006"
    mitre_technique_name = "Event Triggered Execution: LC_LOAD_DYLIB Addition"
    log_prerequisites = "Requires macOS endpoint file-event telemetry (FILE_CREATION) with populated principal.hostname, target.file.full_path and principal.process.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developer toolchains (Xcode, clang, ld, swift, cargo, Homebrew builds), application self-updaters unpacking bundled libraries into ~/Library/Application Support, software installers, Python/Node native extension builds, and IT deployment tools."
    tuning_guidance = "Add approved deployment, packaging and developer tooling executable paths to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Raise the threshold (#file >= 5) on developer-heavy hosts, or extend the executable-name exclusion for build tools not already covered."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(Users\/[^\/]+\/(Library|Downloads|Desktop)|Users\/Shared|tmp|private\/tmp|private\/var\/tmp|var\/tmp)\/.*\.dylib$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(installd|Installer|softwareupdated|ld|clang|cc|swift-frontend|swift-build|xcodebuild|brew|pkgd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($file.target.file.full_path, /(?i)^\/(private\/)?(var\/)?tmp\//), 80, 60))
    $file_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1546.006")
    $primary_entity = array_distinct($host)
    $dylib_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
