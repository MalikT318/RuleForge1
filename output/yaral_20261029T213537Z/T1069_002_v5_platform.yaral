/*
  MITRE Technique : T1069.002 - Domain Groups
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:01:25.042693+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_002_macOS_Directory_Global_Catalog_Query_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a macOS host connecting to directory Global Catalog services (LDAP GC ports 3268/3269), which hold forest-wide group and membership data. This is network-observable evidence of domain group enumeration such as dscacheutil or ldapsearch queries run from a Mac. It complements process-command-line detections because it fires even if the tooling is renamed, scripted, or run through a bundled library."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.002"
    mitre_technique_name = "Permission Groups Discovery: Domain Groups"
    log_prerequisites = "Requires firewall, proxy, or perimeter connection logs normalised to NETWORK_CONNECTION that include internal east-west traffic toward directory servers. The source asset must be enriched with an OS platform (asset inventory or IP-to-asset mapping), because a firewall log does not identify the OS or initiating process."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "AD-bound or Kerberos-enrolled Macs doing normal directory lookups, Mac login-window or Enterprise Connect style SSO agents, Mac-hosted IT inventory or identity tooling, and authorised internal security assessments."
    tuning_guidance = "Add approved vulnerability scanners to %global_allowed_scanners and approved admin or identity-management source addresses to %global_allowed_mgmt_sources. If AD-bound Macs routinely use the Global Catalog, allowlist their source addresses in %global_allowed_mgmt_sources or raise the rule to a threshold variant on connection volume. Consider raising severity for Macs that are not directory-joined."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.asset.platform_software.platform = "MAC"
    ($net.target.port = 3268 or $net.target.port = 3269)
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1069.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $directory_servers = array_distinct($net.target.ip)
    $directory_ports = array_distinct($net.target.port)

  condition:
    $net
}
