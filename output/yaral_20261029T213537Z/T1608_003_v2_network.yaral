/*
  MITRE Technique : T1608.003 - Install Digital Certificate
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:24:48.285362+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_003_ACME_Certificate_Issuance_Request_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a client or server generating HTTP requests to an external ACME certificate-authority API (account registration, new-order, challenge, finalize or certificate retrieval). Automated TLS certificate issuance for infrastructure that does not normally need it can indicate an adversary installing certificates to support C2 or credential-harvesting sites. Detection is based on the ACME protocol URL structure, not on any specific CA, domain or IP."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.003"
    mitre_technique_name = "Stage Capabilities: Install Digital Certificate"
    log_prerequisites = "Requires firewall or proxy logs with TLS inspection or URL logging, normalised to NETWORK_HTTP with target.url populated. Without HTTP-layer visibility this rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate certificate automation on web servers, load balancers and mail servers (certbot, acme.sh, cert-manager, built-in ACME clients on appliances); developers testing certificate issuance; hosting or CDN onboarding workflows."
    tuning_guidance = "Add approved certificate-CA domains to %global_allowed_domains and the addresses of known certificate-automation servers to %global_allowed_mgmt_sources. Expect higher volume in environments with public web hosting; consider raising severity for hosts that are not designated web or mail servers."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/acme\/(new-(acct|account|order|nonce)|acct|order|authz|chall|cert|finalize)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1608.003")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $acme_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
