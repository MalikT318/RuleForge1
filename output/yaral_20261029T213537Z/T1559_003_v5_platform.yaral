/*
  MITRE Technique : T1559.003 - XPC Services
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:44:19.906691+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_003_macOS_XPC_Helper_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS privileged helper tool (/Library/PrivilegedHelperTools) or XPC service bundle binary (*.xpc/Contents/MacOS) spawning a shell or scripting interpreter with inline-execution, download or staging arguments. XPC services normally perform fixed, narrow tasks, so a helper launching an interpreter is a strong indicator that a malicious XPC message (improper client validation or unsanitised input) has been turned into command execution. Detection is on the resulting process lineage, not on any specific application, helper name or payload."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.003"
    mitre_technique_name = "Inter-Process Communication: XPC Services"
    log_prerequisites = "macOS endpoint telemetry (EDR or unified log) that populates parent process path, child process path and command line on process launch events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate privileged helpers of installers, updaters, VPN clients, disk utilities and MDM or RMM agents that run shell scripts through /bin/sh -c during install or repair tasks; developer tooling that spawns interpreters from XPC services."
    tuning_guidance = "Add approved helper or agent binary paths to %global_allowed_admin_tools, EDR and AV helpers to %global_allowed_security_tools, and sanctioned scripting parents to %global_allowed_script_hosts. Review recurring hits by parent helper path to identify vendor updaters that can be allow-listed. Root-owned helpers score higher than user-context XPC services."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(\/Library\/PrivilegedHelperTools\/|\.xpc\/Contents\/MacOS\/)/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|zsh|dash|ksh|tcsh|osascript|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(\s-[a-z]*c\s|\s-e\s|do shell script|curl|wget|base64|chmod\s|\/private\/tmp\/|\/tmp\/|\/Users\/Shared\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(if($proc.principal.user.userid = "root", 85, 70))
    $mitre_technique_id = array_distinct("T1559.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $helper_path = array_distinct($proc.principal.process.file.full_path)
    $spawned_process = array_distinct($proc.target.process.file.full_path)
    $spawned_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
