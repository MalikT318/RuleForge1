/*
  MITRE Technique : T1595.003 - Wordlist Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:56:31.647263+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_003_Wordlist_Hidden_Content_Probe_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external client requesting content-discovery targets (VCS metadata, environment/config files, backup or dump file extensions, admin or database consoles) and receiving a 403 or 404 response. This is the network-side signature of wordlist-driven content enumeration against externally exposed web services. Because it is a single-event rule, each hit is one probe, so triage should group alerts by source IP. Use it as a low-severity reconnaissance signal and enrichment input."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.003"
    mitre_technique_name = "Active Scanning: Wordlist Scanning"
    log_prerequisites = "Requires perimeter web proxy, reverse proxy, WAF, or load balancer logs normalised to NETWORK_HTTP with target.url, network.http.response_code, and principal.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet background noise from opportunistic scanners, search-engine and uptime crawlers, authorised vulnerability scans or penetration tests not yet in the scanner list, and legitimate clients following stale links to removed admin or backup paths."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add trusted partner or monitoring sources to %global_allowed_mgmt_sources. Prioritise sources that trigger repeatedly in SOAR, and raise severity through alert grouping rather than by editing this rule. If clients log only successful requests, drop the response-code condition."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/\.(git|svn|env|htpasswd|ds_store)\b|\/(wp-config|web\.config|phpmyadmin|server-status|backup|dbadmin)|\.(bak|old|orig|sql|swp|tgz|7z)(\?|$))/ nocase
    ($http.network.http.response_code = 404 or $http.network.http.response_code = 403)
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1595.003")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_urls = array_distinct($http.target.url)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
