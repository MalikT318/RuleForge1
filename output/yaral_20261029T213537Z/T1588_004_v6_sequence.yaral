/*
  MITRE Technique : T1588.004 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:00:29.357273+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_004_ACME_DNS_Then_Certificate_Issuance_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single internal source that resolves an ACME-style certificate authority hostname and then issues ACME protocol requests (account registration, order creation, finalization) to an external server within 10 minutes. Because certificate purchase or theft happens outside the victim's network, this rule only covers the observable part of T1588.004: automated certificate issuance from inside the environment. Adversary-controlled infrastructure, rogue web servers, or compromised hosts can use it to obtain trusted TLS certificates for C2 or phishing."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.004"
    mitre_technique_name = "Obtain Capabilities: Digital Certificates"
    log_prerequisites = "Requires perimeter DNS logging and proxy or TLS-inspecting firewall logging that populates NETWORK_HTTP with target.url and target.hostname. Without TLS inspection the HTTP leg will not be visible and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate web servers, load balancers, reverse proxies, and container platforms that renew certificates automatically through ACME clients; developer and lab hosts; managed certificate automation agents; internal ACME-compatible private CAs."
    tuning_guidance = "Add known-good certificate authority and internal CA domains to %global_allowed_domains. Raise severity or restrict to non-server network segments where automated issuance is unexpected. Consider scoping to user-workstation subnets or to hosts that have no web-serving role."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|[-.])acme([-.]|$)/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    $dns.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(acme\/)?(new-acct|new-account|new-order|new-nonce|finalize|revoke-cert|key-change)(\/|\?|$)/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    $http.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1588.004")
    $primary_entity = array_distinct($src_ip)
    $acme_dns_names = array_distinct($dns.network.dns.questions.name)
    $acme_urls = array_distinct($http.target.url)
    $acme_destination_ips = array_distinct($http.target.ip)
    $acme_request_count = count($http.metadata.id)

  condition:
    $dns and $http
}
