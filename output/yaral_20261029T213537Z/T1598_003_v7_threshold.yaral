/*
  MITRE Technique : T1598.003 - Spearphishing Link
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:16:42.197410+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_003_Obfuscated_Link_Requests_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal client makes repeated outbound web requests to URLs that use phishing-style obfuscation within 10 minutes. The patterns are an embedded '@' userinfo prefix before the real host, and an integer or hexadecimal hostname. Each request alone is low-signal, but repeated requests from one client suggest the user is following spearphishing links used to harvest credentials or other information."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.003"
    mitre_technique_name = "Phishing for Information: Spearphishing Link"
    log_prerequisites = "Requires firewall or web proxy logs normalised to NETWORK_HTTP with target.url and principal.ip populated (URL-aware inspection or proxy logging)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legacy internal applications or monitoring tools that embed credentials in URLs, embedded devices or IoT management pages addressed by integer IP, software update checkers, security awareness phishing simulations, and URL-scanning or sandbox services."
    tuning_guidance = "Add trusted destination domains to %global_allowed_domains. Add authorised scanners or phishing-simulation sources to %global_allowed_scanners. Raise the #http threshold for noisy environments. Review the matched URLs in the outcome before escalating."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(?i)^[a-z][a-z0-9+.\-]*:\/\/([^\/?#]*@|(0x[0-9a-f]+|[0-9]{8,10})([:\/?#]|$))/
    $http.principal.ip = $src
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598.003")
    $primary_entity = array_distinct($src)
    $event_count = count($http.metadata.id)
    $matched_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 3
}
