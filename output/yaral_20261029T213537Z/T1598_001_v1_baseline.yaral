/*
  MITRE Technique : T1598.001 - Spearphishing Service
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:10:59.384632+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_001_Credential_Form_Post_Via_Referred_Link {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client submitting data via HTTP POST to an external, non-allowlisted site whose URL path looks like a credential or verification form, where the request was reached from a referring page. This pattern matches a user following a link from a third-party message (social media, personal webmail) and entering information on an attacker-controlled page, which is the observable result of spearphishing for information."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.001"
    mitre_technique_name = "Phishing for Information: Spearphishing Service"
    log_prerequisites = "Requires proxy or perimeter logs normalised to UDM NETWORK_HTTP with method, target.url and referral_url populated. Best fidelity needs TLS inspection so full URLs and POST methods are visible."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS or partner sign-in pages not yet allowlisted, SSO and identity providers, first-time use of new vendor portals, password reset flows on external services, and users logging in to personal accounts on sites reached via search or bookmarks."
    tuning_guidance = "Add sanctioned SaaS, identity provider and vendor domains to %global_allowed_domains. Add known scanner and security-awareness simulation sources to %global_allowed_scanners. Narrow or widen the URL path keywords to match client web usage. Increase severity for clients that enforce TLS inspection and have a low allowlist miss rate."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /^[a-z]+:\/\/[^\/]+\/[^?#]*(login|log-in|signin|sign-in|logon|verify|validate|password|credential|account-?recovery|secure-?update|confirm-?identity)/ nocase
    $http.network.http.referral_url != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1598.001")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_host = array_distinct($http.target.hostname)
    $destination_url = array_distinct($http.target.url)
    $referral_url = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
