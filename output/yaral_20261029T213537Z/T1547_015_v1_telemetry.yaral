/*
  MITRE Technique : T1547.015 - Login Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:46:29.790942+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_015_MacOS_LoginItem_Artifact_Written_By_Untrusted_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of macOS login item persistence artifacts (the Background Task Management database, the legacy loginitems plist, or the LaunchServices shared file list session login items) by a scripting interpreter or by a binary running from a user-writable staging location. This is file-state telemetry, not command-line matching, so it still fires when the osascript or SMAppService/LSSharedFileList call is obfuscated or the command line is not logged."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.015"
    mitre_technique_name = "Boot or Logon Autostart Execution: Login Items"
    log_prerequisites = "Requires macOS endpoint file-event telemetry (EDR or unified log) that populates target.file.full_path and principal.process.file.full_path for FILE_MODIFICATION events, including writes under /Users/*/Library."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Users or MDM/IT scripts adding login items via osascript or shell; application installers run from Downloads or mounted disk images (/Volumes) that register a helper login item on first launch; developer tooling run from interpreters."
    tuning_guidance = "Add approved deployment, MDM and packaging binaries to %global_allowed_admin_tools. Add approved script-launching binaries to %global_allowed_script_hosts. Clone the rule with metadata.event_type = FILE_CREATION if the EDR reports atomic replacement of these files as creation events. Review the matching writer process path and signing status before closing."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/Users\/[^\/]+\/Library\/(Application Support\/com\.apple\.backgroundtaskmanagementagent\/backgroundItems-v[0-9]+\.btm|Preferences\/com\.apple\.loginitems\.plist|Application Support\/com\.apple\.sharedfilelist\/[^\/]*SessionLoginItems\.sfl[0-9]*)$/ nocase
    $file.principal.process.file.full_path = /(\/(osascript|bash|sh|zsh|dash|python3?|perl|ruby|node|swift|swift-frontend)$|^\/(private\/)?(tmp|var\/tmp)\/|^\/Users\/[^\/]+\/(Downloads|Public)\/|^\/Users\/Shared\/|^\/Volumes\/)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.015")
    $primary_entity = array_distinct($file.principal.hostname)
    $login_item_artifact = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
