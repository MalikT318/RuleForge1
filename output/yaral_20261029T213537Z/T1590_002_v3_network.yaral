/*
  MITRE Technique : T1590.002 - DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:15:49.098284+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_002_External_DNS_Zone_Transfer_Recon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects network-side DNS reconnaissance against externally exposed DNS servers. An external source opens a TCP/53 session, which is characteristic of zone transfer (AXFR/IXFR) attempts and bulk record enumeration. It also fires when the IPS raises a DNS zone-transfer or enumeration signature. Internal sources are excluded via reference list."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.002"
    mitre_technique_name = "Gather Victim Network Information: DNS"
    log_prerequisites = "IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated. Signature name mapping into security_result.rule_name or security_result.description is optional and improves coverage."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate external recursive resolvers retrying over TCP after truncated UDP responses (large TXT, DNSSEC or SPF records). Secondary or partner name servers performing authorised zone transfers. Managed DNS or monitoring providers. Authorised external vulnerability scans or penetration tests."
    tuning_guidance = "Add authorised secondary DNS servers and management sources to %global_allowed_mgmt_sources. Add approved scanners to %global_allowed_scanners. Where noise from resolver TCP fallback is high, restrict the rule to the signature branch or add a threshold variant by source IP."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      (
        $net.target.port = 53 and
        $net.network.ip_protocol = "TCP"
      ) or
      $net.security_result.rule_name = /(?i)(zone.?transfer|axfr|ixfr|dns.{0,20}(enumerat|recon|brute|dump))/ or
      $net.security_result.description = /(?i)(zone.?transfer|axfr|ixfr|dns.{0,20}(enumerat|recon|brute|dump))/
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1590.002")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_dns_servers = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    $net
}
