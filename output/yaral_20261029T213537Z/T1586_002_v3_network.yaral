/*
  MITRE Technique : T1586.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:43:41.735177+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_002_Outbound_SMTP_Submission_From_Non_Mail_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a host opening an outbound connection to an external address on a mail submission or relay port (25, 465, 587, 2525). Hosts that are not approved mail relays rarely do this. It can indicate that compromised email account credentials are being used to send phishing or spam directly through an external mail service. This is an indirect network-side indicator of use of compromised email accounts, not proof of account compromise."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.002"
    mitre_technique_name = "Compromise Accounts: Email Accounts"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated. Egress traffic on mail ports must be logged, not only denied."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Approved mail gateways, application servers or multifunction devices that relay through external SMTP providers, marketing and ticketing platforms, legitimate mail client use on unmanaged hosts, vulnerability scanners probing mail ports."
    tuning_guidance = "Add approved mail relay and application server hostnames to %global_allowed_script_hosts. Add sanctioned external mail provider domains to %global_allowed_domains. Add authorised scanners to %global_allowed_scanners. Remove port 25 from the rule if the environment has many legitimate direct-to-MX senders."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 25 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 2525
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1586.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
