/*
  MITRE Technique : T1583.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:06:29.877851+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_005_DNS_DGA_Like_Domain_Botnet_Infrastructure {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for algorithmically generated (DGA-like) domain names, using very long random alphanumeric labels or long labels containing extended consonant runs. Botnet nodes (compromised routers, IoT devices, VPS relays) commonly resolve such names to find rented C2 or proxy infrastructure. Known-good domains and approved scanner hosts are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.005"
    mitre_technique_name = "Acquire Infrastructure: Botnet"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS with network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud provider hostnames with random-looking labels, email security and anti-spam DNS lookups (DNSBL/hash-based), software update and telemetry services, DKIM/SPF-style lookups with long selectors, Active Directory site or device-ID based names, and vulnerability scanners resolving random names."
    tuning_guidance = "Add recurring benign domains to %global_allowed_domains. Add approved scanner or security testing hosts to %global_allowed_scanners. If noise persists, raise the minimum label length in the regex (28) or the consonant run length (6)."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)([a-z0-9]{28,}|[a-z0-9]{3,}[bcdfghjklmnpqrstvwxz]{6,}[a-z0-9]{3,})\.[a-z0-9-]{2,63}(\.[a-z0-9-]{2,63})*$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.005")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $source_ips = array_distinct($dns.principal.ip)

  condition:
    $dns
}
