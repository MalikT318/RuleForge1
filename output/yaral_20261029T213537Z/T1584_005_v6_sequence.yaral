/*
  MITRE Technique : T1584.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:27:13.748574+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_005_DGA_NXDomain_Burst_Then_TXT_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single client issues several NXDOMAIN lookups for long, algorithmically generated looking names, then sends a TXT query for a long-label name within 10 minutes. This pattern is typical of bot rendezvous, where a bot walks a domain-generation list until one domain resolves and then pulls C2 instructions from TXT records. It indicates a client acting as part of a botnet, or a botnet takeover being staged."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.005"
    mitre_technique_name = "Compromise Infrastructure: Botnet"
    log_prerequisites = "DNS query and resolver logs normalised to UDM NETWORK_DNS, with the client IP in principal.ip, the question name and type populated, and the response code populated for NXDOMAIN detection."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services with long random hostnames, email security and anti-spam lookups that use TXT records (SPF, DKIM, DNSBL), software licensing and telemetry services that use long encoded labels, misconfigured clients retrying stale names, and security scanners or sandboxes."
    tuning_guidance = "Add known-good domains to %global_allowed_domains. The list is matched against the full queried name, so include the exact FQDNs seen in client environments. Raise the #dns_a threshold in condition for noisy resolvers. Adjust the label length quantifiers ({20,} and {15,}) per environment."

  events:
    $dns_a.metadata.event_type = "NETWORK_DNS"
    $dns_a.network.dns.response_code = 3
    $dns_a.network.dns.questions.name = /^[a-z0-9]{20,}\.[a-z0-9\-\.]+\.[a-z]{2,}$/ nocase
    not $dns_a.network.dns.questions.name in %global_allowed_domains
    $dns_a.principal.ip = $client_ip

    $dns_b.metadata.event_type = "NETWORK_DNS"
    $dns_b.network.dns.questions.type = 16
    $dns_b.network.dns.questions.name = /^[a-z0-9\-_]{15,}\.[a-z0-9\-\.]+\.[a-z]{2,}$/ nocase
    not $dns_b.network.dns.questions.name in %global_allowed_domains
    $dns_b.principal.ip = $client_ip

    $dns_a.metadata.event_timestamp.seconds <= $dns_b.metadata.event_timestamp.seconds

  match:
    $client_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1584.005")
    $primary_entity = array_distinct($client_ip)
    $nxdomain_count = count($dns_a.metadata.id)
    $nxdomain_names = array_distinct($dns_a.network.dns.questions.name)
    $txt_names = array_distinct($dns_b.network.dns.questions.name)
    $first_seen = min($dns_a.metadata.event_timestamp.seconds)
    $last_seen = max($dns_b.metadata.event_timestamp.seconds)

  condition:
    #dns_a >= 3 and $dns_b
}
