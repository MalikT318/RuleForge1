/*
  MITRE Technique : T1559.003 - XPC Services
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:43:29.069948+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_003_XPC_Privileged_Helper_Tool_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an executable in /Library/PrivilegedHelperTools by a process other than the OS installer, SMJobBless daemon (smd), or MDM agents. Privileged helper tools are root-level XPC service daemons. Dropping one outside a sanctioned install path is a state-change indicator of an adversary staging or replacing an XPC service to run code as root. Detection is at the file-artifact layer, so it does not depend on command-line logging."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.003"
    mitre_technique_name = "Inter-Process Communication: XPC Services"
    log_prerequisites = "macOS endpoint telemetry that reports file creation events with the creating (principal) process path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party applications that install their own privileged helper through a custom installer or updater (VPN clients, virtualization tools, disk utilities, creative suites); software deployment tooling not yet allow-listed; developers testing SMJobBless helpers."
    tuning_guidance = "Add approved deployment and updater binaries to %global_allowed_admin_tools, EDR/security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If a vendor updater generates recurring alerts, allow-list it by executable name rather than install path. Consider raising severity when the creating process is an interpreter or runs from /tmp, /private/tmp or /Users/*/Downloads."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/PrivilegedHelperTools\/[^\/]+$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(smd|installd|system_installd|installer|mdmclient|storedownloadd|softwareupdated)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1559.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $helper_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
