/*
  MITRE Technique : T1595.003 - Wordlist Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:57:05.525522+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_003_Wordlist_Scan_HTTP_404_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source generates a high volume of HTTP 404 (not found) responses against perimeter-facing web services within 10 minutes. Each 404 is benign on its own, but the volume indicates content and directory discovery with a wordlist (directory brute-forcing or crawling)."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.003"
    mitre_technique_name = "Active Scanning: Wordlist Scanning"
    log_prerequisites = "Requires perimeter proxy, reverse proxy, WAF or firewall logs with HTTP inspection that normalise to NETWORK_HTTP and populate principal.ip, target.url and network.http.response_code."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests not yet in the scanner list, search engine and SEO crawlers, uptime or link-checking monitors, misconfigured web applications or broken links that trigger repeated 404s, and CDN or NAT egress addresses shared by many legitimate users."
    tuning_guidance = "Add known scanner and testing source addresses to %global_allowed_scanners. Raise the #http threshold (default 50) for high-traffic public sites and lower it for low-traffic ones. Consider restricting the rule to specific protected web services by adding a target host filter per client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.response_code = 404
    $http.target.url != ""
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1595.003")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($http.metadata.id)
    $targeted_hosts = array_distinct($http.target.hostname)
    $sample_urls = array_distinct($http.target.url)

  condition:
    #http >= 50
}
