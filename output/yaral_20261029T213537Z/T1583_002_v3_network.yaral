/*
  MITRE Technique : T1583.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:01:03.593660+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_002_DNS_Tunnel_Query_To_External_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a DNS TXT or NULL query with an unusually long subdomain label sent to a non-internal DNS server. This is the network pattern of DNS-based C2 or exfiltration against attacker-operated DNS infrastructure. Known-good apex domains are excluded via reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.002"
    mitre_technique_name = "Acquire Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalised to NETWORK_DNS with network.dns.questions.name, network.dns.questions.type and target.ip (the DNS server queried) populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "DNSSEC or DKIM/SPF/DMARC lookups with long TXT labels, CDN or anti-spam/reputation services that encode data in subdomains (DNSBL, AV cloud lookups), email security gateways, and software licensing or telemetry services using long hashed labels."
    tuning_guidance = "Add legitimate apex domains (e.g. vendor telemetry, DNSBL, CDN) to %global_allowed_domains. Add authorised scanners or test sources to %global_allowed_scanners. Raise or lower the label length threshold ({40,}) to suit the environment. If a resolver proxies all client queries, the principal may be the resolver itself - review the resolver's upstream target.ip."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /[a-z0-9_\-]{40,}\.[^.]+\.[^.]+$/ nocase
    $dns.target.ip != ""
    not $dns.target.ip in %rfc1918_internal
    $apex = re.capture($dns.network.dns.questions.name, "([^.]+\\.[^.]+)$")
    not $apex in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.002")
    $primary_entity = array_distinct(strings.coalesce($dns.principal.hostname, $dns.principal.ip))
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $dns_server_ips = array_distinct($dns.target.ip)

  condition:
    $dns
}
