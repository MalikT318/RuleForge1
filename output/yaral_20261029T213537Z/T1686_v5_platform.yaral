/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:42:34.843269+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_Linux_Firewall_Config_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of persistent Linux host firewall configuration files (iptables, nftables, ufw, firewalld) by a process that is not an approved admin tool, package manager or service account. Adversaries edit these files to open ports, remove restrictions or disable the firewall so the change survives reboot. This is file-integrity based and does not depend on command-line matching, so it complements process-creation rules and also catches edits made through scripts, editors or custom binaries."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Requires Linux file-modification telemetry from EDR or auditd with watches (-w) on /etc/iptables, /etc/sysconfig, /etc/nftables.conf, /etc/ufw and /etc/firewalld, normalised to UDM FILE_MODIFICATION with principal process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt), approved sysadmin changes during maintenance windows, OS or firewall package upgrades, netfilter-persistent or iptables-save run by administrators, container or Kubernetes node agents that manage iptables, and image or golden-build provisioning."
    tuning_guidance = "Add configuration management and deployment binaries to %global_allowed_admin_tools. Add automation account userids to %global_allowed_service_accounts. Named admins on change windows can be handled by correlating on principal.user.userid in a downstream playbook. If container hosts are noisy, add the node agent binary path to %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(iptables\/(rules\.v[46]|iptables\.rules|ip6tables\.rules)|sysconfig\/(iptables|ip6tables|nftables\.conf)|nftables\.conf|nftables\/.*\.nft|ufw\/(ufw\.conf|(before|after|user)6?\.rules)|firewalld\/(firewalld\.conf|direct\.xml|zones\/.*\.xml|services\/.*\.xml))$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|yum|dnf|rpm|packagekitd|unattended-upgrade|snapd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
