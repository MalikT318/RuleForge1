/*
  MITRE Technique : T1596.003 - Digital Certificates
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:02:52.143055+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_003_IPS_TLS_Certificate_Recon_Signature {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external, non-allowlisted source triggering an IPS/network security signature that describes TLS/SSL certificate scanning, probing, or enumeration against an internal host on a TLS-bearing port. This is the network-side footprint of adversaries harvesting certificate data (subject, issuer, SAN, organisation) from exposed services for target development."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.003"
    mitre_technique_name = "Search Open Technical Databases: Digital Certificates"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with security_result.rule_name and/or security_result.description populated. The sensor must see inbound traffic from the internet to TLS services."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability or attack-surface scanners not yet in the scanner allowlist; internet-wide research and measurement crawlers; certificate transparency and CA validation or monitoring services; uptime and TLS-health monitoring providers; partner or customer systems doing TLS compatibility checks."
    tuning_guidance = "Add authorised external scanner source addresses to %global_allowed_scanners. Add approved management or monitoring source addresses to %global_allowed_mgmt_sources. Extend the TLS port list for non-standard TLS services. Because this is a low-severity reconnaissance signal, consider enriching it or promoting it to a higher-severity correlated alert when the same source also appears in exploit or brute-force detections."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"

    // Inbound from external space toward an internal TLS-bearing service
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 443 or
      $net.target.port = 8443 or
      $net.target.port = 465 or
      $net.target.port = 993 or
      $net.target.port = 995 or
      $net.target.port = 636 or
      $net.target.port = 990 or
      $net.target.port = 9443
    )

    // IPS verdict text describing TLS/certificate subject matter
    (
      $net.security_result.rule_name = /(ssl|tls|certificate|x\.?509|cert\b)/ nocase or
      $net.security_result.description = /(ssl|tls|certificate|x\.?509|cert\b)/ nocase
    )

    // ...combined with reconnaissance-style wording
    (
      $net.security_result.rule_name = /(scan|probe|enumerat|recon|harvest|grab|fingerprint|discover|sweep|info(rmation)?[ _-]?(leak|disclos|gather))/ nocase or
      $net.security_result.description = /(scan|probe|enumerat|recon|harvest|grab|fingerprint|discover|sweep|info(rmation)?[ _-]?(leak|disclos|gather))/ nocase
    )

    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596.003")
    $primary_entity = array_distinct($net.principal.ip)
    $target_hosts = array_distinct($net.target.hostname)
    $target_ips = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
