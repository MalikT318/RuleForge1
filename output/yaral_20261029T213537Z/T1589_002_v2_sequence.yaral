/*
  MITRE Technique : T1589.002 - Email Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:08:35.285680+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_002_Email_Enumeration_Probe_Then_SMTP_Contact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an external source repeatedly probing mail-service discovery and authentication endpoints (Autodiscover, GetCredentialType, OWA auth, EWS, RPC proxy), followed within 10 minutes by a connection to a mail transport port from the same source. This pattern is typical of email address and username enumeration against public mail infrastructure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.002"
    mitre_technique_name = "Gather Victim Identity Information: Email Addresses"
    log_prerequisites = "Requires perimeter proxy, WAF or reverse-proxy HTTP logs with the request URL populated (NETWORK_HTTP), plus firewall connection logs for SMTP ports (NETWORK_CONNECTION). Both must populate principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate Outlook and mobile mail clients doing Autodiscover from external networks; mail security and email-hygiene vendors testing SMTP; authorised external vulnerability scanners; partner mail gateways that also use OWA or EWS; roaming users on carrier-grade NAT."
    tuning_guidance = "Add authorised scanners to %global_allowed_scanners and trusted partner or management source addresses to %global_allowed_mgmt_sources. Raise the #http threshold (default 5) on tenants with heavy remote-mail usage. Extend the URL regex if the tenant exposes additional mail endpoints."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(autodiscover\/autodiscover\.(xml|json)|getcredentialtype|\/owa\/auth|\/ews\/exchange\.asmx|\/rpc\/rpcproxy\.dll)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src

    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 25 or $net.target.port = 465 or $net.target.port = 587)
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1589.002")
    $primary_entity = array_distinct($src)
    $probe_request_count = count($http.metadata.id)
    $probed_urls = array_distinct($http.target.url)
    $probed_hosts = array_distinct($http.target.hostname)
    $smtp_destinations = array_distinct($net.target.ip)
    $smtp_ports = array_distinct($net.target.port)

  condition:
    #http >= 5 and $net
}
