/*
  MITRE Technique : T1595.001 - Scanning IP Blocks
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:52:31.595405+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_001_Inbound_External_ICMP_Sweep_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects inbound ICMP traffic from an external, non-allowlisted source to a destination address on perimeter firewall telemetry. This is the ping-sweep behaviour adversaries use to find live hosts within a victim IP block. A single event is low fidelity on its own. Use it as a reconnaissance signal and pivot on the source address, or count distinct target.ip values per source in SOAR or the Chronicle UI to identify a sweep across a block."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.001"
    mitre_technique_name = "Active Scanning: Scanning IP Blocks"
    log_prerequisites = "Requires perimeter firewall or network flow logs normalised to NETWORK_CONNECTION with network.ip_protocol populated, including permitted and denied ICMP, and with the external source in principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "External uptime and availability monitors, ISP and CDN health probes, path-MTU and traceroute diagnostics, partner connectivity checks, and cloud provider health checks."
    tuning_guidance = "Add authorised external scanners and monitoring sources to %global_allowed_scanners. Add trusted management or partner source addresses to %global_allowed_mgmt_sources. If ICMP volume is high, consider scheduling a downstream aggregation that counts distinct target.ip per source before alerting."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "ICMP"
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1595.001")
    $primary_entity = array_distinct($net.principal.ip)
    $probed_targets = array_distinct($net.target.ip)

  condition:
    $net
}
