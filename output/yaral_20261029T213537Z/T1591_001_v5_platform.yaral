/*
  MITRE Technique : T1591.001 - Determine Physical Locations
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:27:02.871149+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_001_External_Automated_Location_Page_Harvesting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external, non-allowlisted source using a scripted or library HTTP client to request organisation location pages (offices, facilities, data centres, branches, directions) through IPS-inspected web traffic. This is consistent with automated collection of victim physical-location information (T1591.001). This is a low-fidelity reconnaissance indicator. Platform is PRE (external-facing telemetry), so the rule uses network and HTTP inspection data rather than host mechanisms."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.001"
    mitre_technique_name = "Gather Victim Org Information: Determine Physical Locations"
    log_prerequisites = "IPS or network security appliance logs normalised to UDM NETWORK_HTTP with target.url, network.http.user_agent and principal.ip populated. Requires inspection of traffic to externally hosted web properties (TLS inspection or a reverse-proxy position)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Uptime and SEO monitors, partner or vendor integrations that script requests to location pages, store-locator API consumers, legitimate mapping or data-aggregation services, customer-run scanners and internal tooling reaching the site via external IPs."
    tuning_guidance = "Add authorised scanners and monitoring sources to %global_allowed_scanners. Add known partner or service accounts to %global_allowed_service_accounts if they are surfaced as principal.user.userid. Extend the search-crawler exclusion for crawlers the organisation wants indexed. Adjust the URL path regex to match the client's actual location-related site structure. Consider raising severity only when combined with other recon rules for the same source IP."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(locations?|offices?|facilit(y|ies)|data-?cent(er|re)s?|store-?locator|branches|our-sites|find-us|directions|campus|contact-us)(\/|\?|\.|$)/ nocase
    $http.network.http.user_agent = /(python-requests|python-urllib|curl\/|wget|go-http-client|libwww-perl|scrapy|apache-httpclient|okhttp|aiohttp|node-fetch|axios|headless|java\/)/ nocase
    not $http.network.http.user_agent = /(googlebot|bingbot|duckduckbot|applebot)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1591.001")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
