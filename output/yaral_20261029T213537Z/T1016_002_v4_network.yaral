/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:49:15.039360+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_macOS_WiFi_Data_In_Outbound_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting or command-line network utility on macOS making an outbound HTTP request to an external destination, with Wi-Fi data in the URL. The data includes SSID/BSSID values, Wi-Fi password or profile parameters, or access-point lists. This is the network-side footprint of Wi-Fi discovery and credential harvesting (for example from the airport utility or the System keychain), followed by exfiltration or a BSSID-based geolocation lookup. The rule keys on the HTTP request, not on process command lines, so it complements endpoint process-creation rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires macOS endpoint telemetry or network-sensor HTTP logging that populates NETWORK_HTTP events with target.url and principal.process.file.full_path. Process attribution must be present for the interpreter or CLI utility. Plaintext HTTP, or TLS inspection / EDR URL visibility, is needed to see the URL."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Authorised IT inventory or asset-management scripts that report Wi-Fi SSID/BSSID to an internal or vendor portal. Developer scripts calling Wi-Fi-based geolocation or network-quality APIs. Wi-Fi provisioning or MDM helper scripts run through curl or python. Network-testing tools run by IT staff."
    tuning_guidance = "Add approved vendor or inventory domains to %global_allowed_domains. Add approved automation interpreters or parent tooling to %global_allowed_script_hosts. Add approved IT management binaries to %global_allowed_admin_tools. If URLs are not visible in your telemetry (TLS without inspection), the rule will not fire; pair it with endpoint-side rules."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\/(curl|python[0-9.]*|perl|ruby|osascript|bash|zsh|sh|node|php)$/ nocase
    $net.target.url = /[?&\/](b?ssid|wifi_?(password|pass|pwd|key|profiles?|networks?|aps?)|wlan_?(profiles?|keys?)|wifiaccesspoints|access_?points?)(=|&|\/|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $request_url = array_distinct($net.target.url)

  condition:
    $net
}
