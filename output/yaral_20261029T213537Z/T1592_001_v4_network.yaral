/*
  MITRE Technique : T1592.001 - Hardware
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:36:17.708353+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_001_External_Hardware_Fingerprint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting well-known device-information and hardware-inventory endpoints (device info, UPnP device descriptors, hardware/system info APIs) on an internet-facing web service. This is the network-side footprint of adversaries fingerprinting victim hardware through active scanning of banners and device descriptors."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.001"
    mitre_technique_name = "Gather Victim Host Information: Hardware"
    log_prerequisites = "Requires perimeter proxy, WAF or firewall HTTP logs that populate target.url and principal.ip (NETWORK_HTTP events)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface-management services, partner or vendor monitoring platforms, remote-support or IoT device management clouds that poll device info endpoints, and legitimate mobile or IoT clients that query device descriptors."
    tuning_guidance = "Add authorised scanner and ASM source addresses to %global_allowed_scanners. Add approved vendor management sources to %global_allowed_mgmt_sources. Raise severity or add a Threshold variant (for example, many distinct device-info URLs from one source) for noisy internet-facing tenants. Review the target.hostname in outcomes to confirm that the endpoint actually exposes a device."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/(get)?device[_-]?info(\.(xml|json|html|cgi|php))?(\/|\?|$)|\/devicedescription\.xml|\/rootdesc\.xml|\/isapi\/system\/deviceinfo|\/cgi-bin\/(sysinfo|hwinfo)|\/api\/(v[0-9]+\/)?(system|hardware)\/(info|inventory)|\/(hw|hardware|sys)info(\.(xml|json|html|cgi|php))?(\/|\?|$)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1592.001")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_host = array_distinct($net.target.hostname)
    $requested_url = array_distinct($net.target.url)

  condition:
    $net
}
