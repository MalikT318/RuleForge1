/*
  MITRE Technique : T1590.002 - DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:16:24.125119+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_002_External_DNS_Zone_Transfer_Recon_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source reaching an internal DNS service on port 53 where the IPS or network security appliance verdict names zone transfer (AXFR/IXFR), DNS enumeration or DNS reconnaissance. This is the externally observable footprint of an adversary harvesting a victim's name servers and subdomain, mail and host records before targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.002"
    mitre_technique_name = "Gather Victim Network Information: DNS"
    log_prerequisites = "IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION, with target.port populated and the signature or verdict text mapped into security_result.description or security_result.summary. The sensor must sit on the inbound path to authoritative or recursive DNS servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate secondary or partner name servers performing zone transfers, managed DNS providers, external uptime and DNS-health monitoring, authorised penetration tests and attack-surface scans, and security researchers' crawlers."
    tuning_guidance = "Add authorised secondary DNS and partner source addresses to %global_allowed_mgmt_sources. Add approved external scanners and pen-test sources to %global_allowed_scanners. If the appliance uses different signature wording, extend the regex alternatives per client. Raise severity for DNS servers that should never allow transfers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    (
      $net.security_result.description = /(axfr|ixfr|zone[\s_-]*transfer|dns[\s_-]*(enum|recon|brute|footprint|info(rmation)?[\s_-]*disclosure)|query[\s_-]*type[\s_-]*any)/ nocase or
      $net.security_result.summary = /(axfr|ixfr|zone[\s_-]*transfer|dns[\s_-]*(enum|recon|brute|footprint|info(rmation)?[\s_-]*disclosure)|query[\s_-]*type[\s_-]*any)/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1590.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_hostnames = array_distinct($net.target.hostname)
    $signature_text = array_distinct($net.security_result.description)

  condition:
    $net
}
