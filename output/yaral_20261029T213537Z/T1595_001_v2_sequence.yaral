/*
  MITRE Technique : T1595.001 - Scanning IP Blocks
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:52:14.522424+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_001_ICMP_Sweep_Then_Service_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an external source that sweeps address space with ICMP and then probes common service ports over TCP within ten minutes. This is the typical live-host discovery then service enumeration pattern of IP block scanning."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.001"
    mitre_technique_name = "Active Scanning: Scanning IP Blocks"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION, with network.ip_protocol, principal.ip, target.ip and target.port populated. ICMP traffic must be logged, including allowed and denied sessions."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and external attack-surface monitoring services, uptime and availability monitors, CDN or cloud health probes, ISP or partner network diagnostics, and internet-wide research scanners (which are still worth triaging)."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Raise or lower the #icmp and #probe thresholds in the condition to match the client's internet-facing exposure and log volume. Extend the probed port list for client-specific exposed services."

  events:
    $icmp.metadata.event_type = "NETWORK_CONNECTION"
    $icmp.network.ip_protocol = "ICMP"
    $icmp.principal.ip != ""
    $icmp.target.ip != ""
    not $icmp.principal.ip in %rfc1918_internal
    not $icmp.principal.ip in %global_allowed_scanners
    $icmp.principal.ip = $src_ip

    $probe.metadata.event_type = "NETWORK_CONNECTION"
    $probe.network.ip_protocol = "TCP"
    (
      $probe.target.port = 21 or
      $probe.target.port = 22 or
      $probe.target.port = 23 or
      $probe.target.port = 25 or
      $probe.target.port = 80 or
      $probe.target.port = 110 or
      $probe.target.port = 135 or
      $probe.target.port = 139 or
      $probe.target.port = 443 or
      $probe.target.port = 445 or
      $probe.target.port = 1433 or
      $probe.target.port = 3306 or
      $probe.target.port = 3389 or
      $probe.target.port = 5900 or
      $probe.target.port = 8080
    )
    not $probe.principal.ip in %rfc1918_internal
    not $probe.principal.ip in %global_allowed_scanners
    $probe.principal.ip = $src_ip

    $icmp.metadata.event_timestamp.seconds <= $probe.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1595.001")
    $primary_entity = array_distinct($src_ip)
    $icmp_event_count = count($icmp.metadata.id)
    $probe_event_count = count($probe.metadata.id)
    $swept_targets = array_distinct($icmp.target.ip)
    $probed_targets = array_distinct($probe.target.ip)
    $probed_ports = array_distinct($probe.target.port)

  condition:
    $icmp and $probe and #icmp >= 5 and #probe >= 5
}
