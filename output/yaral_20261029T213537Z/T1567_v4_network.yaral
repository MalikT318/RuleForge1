/*
  MITRE Technique : T1567 - Exfiltration Over Web Service
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:49:08.692418+00:00
  Reference       : https://attack.mitre.org/techniques/T1567
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_macOS_Large_Upload_To_Unlisted_Web_Service_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound HTTP POST or PUT upload from a macOS client, identified by its Apple or Macintosh user agent in proxy logs, to an external destination not in the known-good domain list. This is the network-side signature of exfiltration over a web service. It does not depend on endpoint process telemetry and complements existing command-line detections."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567"
    mitre_technique_name = "Exfiltration Over Web Service"
    log_prerequisites = "Requires forward or transparent proxy logs, or a firewall with HTTP inspection (TLS decryption for HTTPS), normalised to NETWORK_HTTP with network.http.method, network.http.user_agent, network.sent_bytes, target.hostname and target.ip populated."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Users uploading large files to legitimate but unlisted SaaS or cloud storage, Time Machine or iCloud-style backups to unlisted endpoints, developers pushing build artifacts or container images, video conferencing recording uploads, and software crash or telemetry uploads to vendor domains not yet allowlisted."
    tuning_guidance = "Add sanctioned SaaS, cloud storage and vendor domains to %global_allowed_domains. Add known sanctioned upload sources to %global_allowed_scanners or %global_allowed_mgmt_sources if appropriate. Adjust the sent_bytes threshold (default about 50 MB) per client baseline. Ensure %rfc1918_internal is populated for the client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /(Macintosh|Mac OS X|Darwin|CFNetwork)/ nocase
    $net.network.sent_bytes > 52428800
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
