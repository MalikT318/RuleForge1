/*
  MITRE Technique : T1559.003 - XPC Services
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:43:45.417580+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_003_XPC_Helper_Spawns_Shell_Or_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS XPC service bundle binary (*.xpc/Contents/MacOS/*) or a privileged helper tool (/Library/PrivilegedHelperTools/*) spawning a shell or script interpreter. XPC services and privileged helpers normally perform fixed, compiled tasks. A shell or interpreter child suggests malicious input was passed to the XPC handler (improper client validation or unsanitised parameters) and led to command execution, often as root."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.003"
    mitre_technique_name = "Inter-Process Communication: XPC Services"
    log_prerequisites = "Requires macOS endpoint telemetry (EDR or unified log) that records PROCESS_LAUNCH events with parent and child process paths and the child command line."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party applications whose privileged helper runs installer or uninstaller shell scripts (VPN clients, disk utilities, virtualization software, printer drivers), software updaters that use a helper to run a shell script, and MDM or RMM helpers. These are most common during install, update and uninstall events."
    tuning_guidance = "Add approved helper or agent binaries to %global_allowed_admin_tools, %global_allowed_remote_mgmt or %global_allowed_security_tools. Add known script-running parents to %global_allowed_script_hosts. Review the parent_process and child_command_line outcome values to find vendor helpers that need allowlisting for this client. If a vendor helper is noisy, add its executable path to the relevant list rather than loosening the child interpreter regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(\/Library\/PrivilegedHelperTools\/[^\/]+|\.xpc\/Contents\/MacOS\/[^\/]+)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|zsh|dash|ksh|tcsh|csh|osascript|python[0-9.]*|perl|ruby|php|node|pwsh)$/ nocase
    not $proc.principal.process.file.full_path = /^\/System\/Library\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1559.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
