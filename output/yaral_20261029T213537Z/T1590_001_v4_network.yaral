/*
  MITRE Technique : T1590.001 - Domain Properties
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:14:22.157198+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_001_External_Domain_Property_Enumeration_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting public identity and domain-discovery endpoints (federation realm lookups, OpenID/federation metadata, autodiscover service documents) on a monitored web service. Adversaries use these endpoints to learn which domains a victim owns, whether they are federated, and which name servers or tenants back them (T1590.001). This is network-side coverage seen by an IPS or network security appliance."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.001"
    mitre_technique_name = "Gather Victim Network Information: Domain Properties"
    log_prerequisites = "Requires IPS or network security appliance HTTP inspection logs that populate target.url and principal.ip (decrypted or reverse-proxied traffic for TLS services)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate mobile or remote Outlook and mail clients using autodiscover, federated SSO clients and browsers retrieving realm or OpenID metadata, SaaS integrations and partner federation checks, authorised external attack-surface scanners, and uptime monitors."
    tuning_guidance = "Add authorised external scanners to %global_allowed_scanners. Add known partner or service source addresses to %global_allowed_mgmt_sources and extend the exclusion if needed. If autodiscover generates noise for mail-hosting customers, remove the autodiscover alternative from the URL regex or promote the rule to a threshold on repeated distinct endpoints per source IP. Raise severity if the same source also shows scanning activity."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(getuserrealm\.srf|\/common\/userrealm\/|\/autodiscover\/autodiscover\.(json|xml)|\/\.well-known\/openid-configuration|\/federationmetadata\/|\/\.well-known\/(host-meta|webfinger))/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1590.001")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
