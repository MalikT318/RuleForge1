/*
  MITRE Technique : T1591.004 - Identify Roles
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:31:50.381331+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_004_External_Role_Directory_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source successfully requesting a staff, team or directory page on a victim-owned web asset with role, title or department query parameters. This is characteristic of an adversary harvesting business roles and key personnel to support targeting (T1591.004). Observed from the network side through HTTP inspection by an IDS/IPS or network security appliance."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.004"
    mitre_technique_name = "Gather Victim Org Information: Identify Roles"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with HTTP inspection (URL, method and response code) normalised to UDM NETWORK_HTTP. TLS-encrypted traffic needs decryption or inspection at the appliance for the URL to be populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers indexing team pages, legitimate recruiters or job seekers using directory filters, partner or customer portals with a public staff search, external penetration tests or attack-surface-management scans, and public marketing sites that filter staff by department."
    tuning_guidance = "Add authorised external scanners and ASM sources to %global_allowed_scanners. Where legitimate crawler or partner source addresses are known, add them to the same list. If the public site uses different directory paths or parameter names, extend the two regexes per client. Consider raising severity when the same source is also seen in other reconnaissance rules."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^GET$/ nocase
    $http.target.url = /\/(staff|our-team|team|leadership|management|executives?|people|directory|org-?chart|employees|board|key-personnel)(\/|\?|$)/ nocase
    $http.target.url = /[?&](role|title|job_?title|position|department|dept)=/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 400
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1591.004")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
