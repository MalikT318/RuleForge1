/*
  MITRE Technique : T1586.003 - Cloud Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:45:34.108149+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_003_External_Scripted_Auth_Failure_Cloud_Login_Endpoint {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source sending a failed (HTTP 401) POST to a cloud identity or legacy-auth endpoint (OAuth token, ADFS, Autodiscover, EWS, ActiveSync, generic login API) using a scripted HTTP client user agent rather than a browser. This is the network-visible footprint of automated credential stuffing or password spraying used to compromise cloud accounts before they are used for adversary infrastructure, storage or messaging."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.003"
    mitre_technique_name = "Compromise Accounts: Cloud Accounts"
    log_prerequisites = "Requires reverse proxy, WAF or TLS-inspecting perimeter firewall logs that populate NETWORK_HTTP with method, target.url, response code and user agent for inbound traffic to client-hosted identity endpoints."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate service integrations or mail clients using scripted HTTP libraries with stale credentials, authorised penetration tests and vulnerability scans, monitoring or synthetic-login probes, and users on legacy mobile clients with an expired password."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners. Add monitoring or management source addresses to %global_allowed_mgmt_sources. Extend the endpoint path regex to match the client's identity provider paths. For volume-based spray detection, build a companion Threshold rule grouped by principal.ip."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.network.http.response_code = 401
    $net.target.url = /(\/oauth2?\/(v2\.0\/)?token|\/adfs\/ls|\/autodiscover\/autodiscover\.(xml|json)|\/ews\/exchange\.asmx|\/microsoft-server-activesync|\/api\/v[0-9]+\/(auth|login|signin)|\/rpc\/openrpcproxy\.dll)/ nocase
    $net.network.http.user_agent = /(python-requests|python-urllib|aiohttp|curl\/|wget\/|go-http-client|okhttp|axios|node-fetch|libwww-perl|java\/[0-9]|apache-httpclient|httpx|scrapy)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1586.003")
    $primary_entity = array_distinct($net.principal.ip)
    $target_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $targeted_users = array_distinct($net.target.user.userid)

  condition:
    $net
}
