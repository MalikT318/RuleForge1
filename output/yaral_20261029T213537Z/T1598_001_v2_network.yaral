/*
  MITRE Technique : T1598.001 - Spearphishing Service
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:11:16.887747+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_001_Spearphish_Service_Credential_Form_Submission {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client submitting an HTTP POST to a credential-style URL (login, sign-in, verify, password, etc.) on an external, non-allowlisted host after arriving via a referral link. This is the network-observable result of a user following a link from a third-party spearphishing message (social media, personal webmail, messaging service) to an information-harvesting page. The rule uses behavioural URL and method patterns and does not hardcode any domain."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.001"
    mitre_technique_name = "Phishing for Information: Spearphishing Service"
    log_prerequisites = "Requires firewall or web proxy logs with HTTP inspection (TLS decryption or explicit proxy) that populate network.http.method, network.http.referral_url and target.url. Without HTTP-layer visibility this rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate sign-in to SaaS or partner portals not yet in %global_allowed_domains, SSO and federated identity redirects, marketing or survey forms submitted by staff, and online banking or benefits portals used by employees."
    tuning_guidance = "Add known-good SaaS, identity-provider and vendor domains to %global_allowed_domains. Validate that the proxy populates network.http.referral_url; if it does not, the referral condition can be relaxed (expect more false positives). Consider raising severity when the destination domain is newly seen or low-prevalence in the tenant."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.network.http.referral_url = /^https?:\/\// nocase
    $http.target.url = /(login|log-in|signin|sign-in|logon|verify|validate|account|password|passwd|credential|secure|auth|survey|webmail)/ nocase
    $http.target.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1598.001")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)
    $referral_urls = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
