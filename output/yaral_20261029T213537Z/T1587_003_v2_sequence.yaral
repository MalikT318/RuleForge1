/*
  MITRE Technique : T1587.003 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:50:42.592810+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_003_SelfSigned_TLS_Then_Repeat_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An internal host completes a TLS session with an external server presenting a self-signed certificate (issuer equals subject), then reconnects to the same external IP and port within ten minutes. Repeat contact with a self-signed server is typical of adversary-built C2 infrastructure using self-created certificates. This covers the network-observable use of the certificate rather than endpoint command lines."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.003"
    mitre_technique_name = "Develop Capabilities: Digital Certificates"
    log_prerequisites = "Perimeter logs that populate TLS server certificate issuer and subject (for example, TLS inspection or a TLS-aware firewall or proxy). Without these fields the first event never matches."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal or lab services reached through public IPs, IoT and appliance management interfaces, dev/test endpoints, and vendor appliances shipped with default self-signed certificates."
    tuning_guidance = "Add known-good vendor or partner domains to %global_allowed_domains. Review frequent hosts, and consider adding authorised testing sources to %global_allowed_scanners by extending the rule. Raise the window or require more repeat connections if noisy."

  events:
    $first.metadata.event_type = "NETWORK_CONNECTION"
    $first.principal.hostname = $hostname
    $first.target.ip = $dst_ip
    $first.network.tls.server.certificate.issuer != ""
    $first.network.tls.server.certificate.subject != ""
    $first.network.tls.server.certificate.issuer = $first.network.tls.server.certificate.subject
    not $first.target.ip in %rfc1918_internal
    not $first.network.tls.client.server_name in %global_allowed_domains

    $repeat.metadata.event_type = "NETWORK_CONNECTION"
    $repeat.principal.hostname = $hostname
    $repeat.target.ip = $dst_ip
    $repeat.target.port = $first.target.port
    not $repeat.target.ip in %rfc1918_internal

    $first.metadata.event_timestamp.seconds < $repeat.metadata.event_timestamp.seconds

  match:
    $hostname, $dst_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1587.003")
    $primary_entity = array_distinct($hostname)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($first.target.port)
    $cert_subjects = array_distinct($first.network.tls.server.certificate.subject)
    $repeat_connection_count = count($repeat.metadata.id)

  condition:
    $first and $repeat
}
