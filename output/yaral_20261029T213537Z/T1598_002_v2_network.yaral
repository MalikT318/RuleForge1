/*
  MITRE Technique : T1598.002 - Spearphishing Attachment
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:13:16.415846+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_002_Office_Client_External_Auth_Challenge {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an Office-family HTTP client receiving an HTTP 401 authentication challenge from an external web server. This is the network signature of a spearphishing attachment (e.g. a document with a remote template or link) that prompts the victim for credentials and sends them to an attacker-controlled server. Observed at the proxy or perimeter, independent of endpoint telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.002"
    mitre_technique_name = "Phishing for Information: Spearphishing Attachment"
    log_prerequisites = "Requires proxy or firewall logs normalised to UDM NETWORK_HTTP, with network.http.user_agent, network.http.response_code and target.hostname populated (TLS inspection or an explicit proxy is typically needed)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Office clients authenticating to external SaaS or collaboration services not yet in the known-good domain list (e.g. SharePoint or WebDAV on partner tenants, vendor add-in services, federated document sharing with business partners)."
    tuning_guidance = "Add legitimate vendor and collaboration domains to %global_allowed_domains. Confirm %rfc1918_internal covers the client's internal address space. If volume is high, review which Office user agents are seen in the environment and restrict to the ones that generate hits."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(microsoft office|ms-office|office\/[0-9]|winword|excel\/|powerpnt)/ nocase
    $net.network.http.response_code = 401
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
