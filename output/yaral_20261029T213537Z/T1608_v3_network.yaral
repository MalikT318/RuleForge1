/*
  MITRE Technique : T1608 - Stage Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:19:17.043420+00:00
  Reference       : https://attack.mitre.org/techniques/T1608
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_Direct_IP_Payload_Download_Staged_Capability {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful HTTP GET from an internal client to an external server addressed by raw IP (no domain name), where the URL path points to an executable, script, installer, disk image or archive. Adversaries commonly stage payloads on throwaway infrastructure that has no domain, so a payload-type fetch from a bare IP is a network-side indicator of staged capabilities being retrieved."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608"
    mitre_technique_name = "Stage Capabilities"
    log_prerequisites = "Requires firewall or proxy logs with HTTP URL inspection (NETWORK_HTTP with target.url, network.http.method and network.http.response_code populated). TLS-inspected or cleartext traffic only."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate software vendors or appliances distributing firmware/installers from bare IPs, internal-style lab or CDN nodes with public IPs, patch distribution from partner infrastructure, developers testing external build servers, authorised red team or penetration test activity."
    tuning_guidance = "Add known-good vendor domains to %global_allowed_domains. Add authorised scanning or testing sources to %global_allowed_scanners. Add known download clients to %global_allowed_admin_tools if the log carries that field. Adjust the file extension list to match client policy, and raise severity for segments such as servers that should never fetch payloads."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.response_code = 200
    $http.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?\/[^?#]*\.(exe|dll|msi|scr|ps1|psm1|bat|cmd|vbs|vbe|js|jse|hta|jar|lnk|iso|img|zip|7z|rar|cab|apk|elf|sh)([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
