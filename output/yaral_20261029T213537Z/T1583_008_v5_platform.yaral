/*
  MITRE Technique : T1583.008 - Malvertising
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:14:16.184715+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_008_Malvertising_Ad_Click_To_Installer_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a proxy-observed HTTP download of an installer or archive package where the referring page carries an advertising click-tracking identifier (gclid, msclkid, fbclid and similar). This pattern is typical of malvertising campaigns that use paid ads to lure users to trojanized software downloads on external infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.008"
    mitre_technique_name = "Acquire Infrastructure: Malvertising"
    log_prerequisites = "Requires web proxy or perimeter firewall logs with HTTP inspection that populate target.url and network.http.referral_url (TLS inspection recommended for full URLs)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate software vendors whose download pages are reached through paid search or social ads; marketing-driven download campaigns; users downloading approved tools from sponsored results."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Internal destinations are already excluded by %rfc1918_internal. Raise severity or add a prevalence check in the SIEM if the same download host is seen from several internal clients."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.referral_url = /[?&](gclid|gbraid|wbraid|msclkid|fbclid|ttclid|dclid|twclid|li_fat_id)=/ nocase
    $net.target.url = /\.(exe|msi|msix|appx|dmg|pkg|iso|img|zip|7z|rar|apk|jar)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.008")
    $primary_entity = array_distinct($net.principal.ip)
    $download_hosts = array_distinct($net.target.hostname)
    $download_urls = array_distinct($net.target.url)
    $referrers = array_distinct($net.network.http.referral_url)

  condition:
    $net
}
