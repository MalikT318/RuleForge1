/*
  MITRE Technique : T1595.002 - Vulnerability Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:53:48.442635+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_002_Perimeter_Web_Probe_Sensitive_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting URL patterns typical of automated vulnerability scanning in firewall or proxy HTTP logs. The patterns are directory traversal sequences, exposed dotfile and configuration paths (.env, .git, .svn, .aws, .ssh), and diagnostic or management endpoints (phpinfo, server-status, actuator env/heapdump, phpmyadmin). Legitimate clients do not request these paths, so a single hit from an external address is a strong sign of scanner reconnaissance against the exposed web estate."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.002"
    mitre_technique_name = "Active Scanning: Vulnerability Scanning"
    log_prerequisites = "Requires perimeter firewall, reverse proxy or WAF logs normalised to NETWORK_HTTP with target.url and principal.ip populated, covering inbound traffic to externally exposed web services."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and ASV scans, bug bounty or penetration test sources, external uptime or security-posture monitoring services, and search engine or research crawlers requesting well-known paths."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners. Add approved management source addresses to %global_allowed_mgmt_sources. Raise severity or add a response-code filter for internet-facing assets where a 200 response to these paths indicates exposure."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(\.\.(\/|\\|%2f|%5c)|%2e%2e(\/|\\|%2f|%5c)|\/\.(env|git|svn|hg|aws|ssh|ds_store)(\/|\?|$)|\/(phpinfo(\.php)?|server-status|server-info|phpmyadmin)(\/|\?|$)|\/actuator\/(env|heapdump|configprops))/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1595.002")
    $primary_entity = array_distinct($net.principal.ip)
    $probed_urls = array_distinct($net.target.url)
    $probed_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
