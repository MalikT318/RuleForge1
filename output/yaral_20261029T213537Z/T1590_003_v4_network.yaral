/*
  MITRE Technique : T1590.003 - Network Trust Dependencies
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:17:51.941172+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_003_External_Probe_Of_Directory_Trust_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-internal) source connecting to directory and trust-related services such as Kerberos, LDAP/LDAPS, Global Catalog, RPC endpoint mapper and SMB. These services expose domain and forest trust information and should not be reachable from the internet. Probing of them is characteristic of reconnaissance on network trust dependencies."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.003"
    mitre_technique_name = "Gather Victim Network Information: Network Trust Dependencies"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated. Perimeter or inbound-facing sensors must be in scope."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, partner or MSP connections that legitimately use LDAPS or Kerberos over a site-to-site path, remote administrators reaching management services before VPN enforcement, and internet-wide research scanners hitting exposed hosts."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved partner or management source addresses to %global_allowed_mgmt_sources. If the sensor sits behind NAT and reports internal addresses, confirm %rfc1918_internal covers the tenant's internal address space. Raise severity for targets that should never expose these ports. Consider restricting the sensor scope to perimeter-facing interfaces."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 88 or
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 445 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1590.003")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
