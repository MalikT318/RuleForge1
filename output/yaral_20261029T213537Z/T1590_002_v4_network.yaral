/*
  MITRE Technique : T1590.002 - DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:16:03.987869+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_002_External_TCP_DNS_Zone_Transfer_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source opening a TCP connection to port 53 on a DNS server. Outside normal resolver fallback, TCP/53 from the internet is the transport for zone transfer (AXFR/IXFR) attempts and bulk DNS enumeration. Attackers use these to map name servers, subdomains, mail servers and hosts before targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.002"
    mitre_technique_name = "Gather Victim Network Information: DNS"
    log_prerequisites = "Requires IDS/IPS or network security appliance telemetry that records inbound connections with source IP, destination IP, destination port and IP protocol, normalised to UDM NETWORK_CONNECTION."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate secondary or partner name servers performing authorised zone transfers; recursive resolvers falling back to TCP for large or truncated responses; DNSSEC-related queries; authorised external scanners or penetration tests; uptime and DNS health-monitoring services."
    tuning_guidance = "Add authorised scanner and pen-test source IPs to %global_allowed_scanners. Add secondary or partner DNS server IPs to %global_allowed_mgmt_sources. If resolver fallback is noisy, restrict the rule to authoritative DNS servers by adding a target-side filter in a per-client copy. Raise severity if the same source also appears in other reconnaissance alerts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    $net.network.ip_protocol = "TCP"
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1590.002")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_dns_servers = array_distinct($net.target.ip)

  condition:
    $net
}
