/*
  MITRE Technique : T1588.004 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:59:50.087740+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_004_ACME_Certificate_Issuance_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects outbound web requests carrying ACME certificate-issuance protocol paths (directory, new-account, new-order, new-nonce, or HTTP-01 challenge paths) to an external destination that is not an approved domain. Hosts that enrol for SSL/TLS certificates from an unapproved public CA may be acquiring certificates for adversary infrastructure or for C2 traffic. The rule matches the protocol behaviour, not a specific CA or domain."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.004"
    mitre_technique_name = "Obtain Capabilities: Digital Certificates"
    log_prerequisites = "Requires proxy or firewall logs with URL-level (HTTP) visibility, normalised to NETWORK_HTTP with target.url populated. TLS-inspection or a forward proxy is needed to see request paths; plain L4 firewall logs will not populate target.url."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate certificate automation on web servers and load balancers, container and Kubernetes cert-manager, developer or lab hosts using public ACME CAs, and managed hosting or CDN onboarding workflows."
    tuning_guidance = "Add approved certificate authority and vendor domains to %global_allowed_domains. If a known subnet or internal PKI generates a lot of ACME traffic, add the source host to %global_allowed_script_hosts. If the rule is still noisy, raise severity only for hosts outside the approved certificate-automation population."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/\.well-known\/acme-challenge\/|\/acme\/([^\/]+\/)?(directory|new-acct|new-order|new-nonce)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1588.004")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
