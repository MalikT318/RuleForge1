/*
  MITRE Technique : T1608.005 - Link Target
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:29:23.219377+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_005_Login_Page_On_Raw_IP_Link_Target {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client requesting an external URL whose host is a bare IP address and whose path resembles a credential-harvesting or login page (login, signin, verify, webmail, password). Adversaries stage link-target pages for spearphishing on throwaway infrastructure, often addressed by raw IP. The rule is based on URL structure, not named domains or IPs."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.005"
    mitre_technique_name = "Stage Capabilities: Link Target"
    log_prerequisites = "Requires web proxy or perimeter firewall logs with full URL inspection (NETWORK_HTTP with target.url populated). HTTPS traffic must be decrypted or the URL logged for the rule to evaluate."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Appliance, device, and IoT management portals reached by IP (printers, UPS, out-of-band controllers), captive portals, internal-style apps hosted on public IPs, penetration tests and phishing simulations, and SaaS or partner portals addressed by IP."
    tuning_guidance = "Add known-good destination hostnames to %global_allowed_domains and authorised testing or simulation sources to %global_allowed_scanners. If device-management portals are noisy, limit the URL path keywords or add the destination to %global_allowed_domains. Raise severity when the same client submits POST requests to the same URL."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?\/[^?#]*(login|log-in|signin|sign-in|verify|validate|webmail|password|account|secure|auth)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1608.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
