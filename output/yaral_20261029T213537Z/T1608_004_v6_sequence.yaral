/*
  MITRE Technique : T1608.004 - Drive-by Target
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:27:48.742459+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_004_DriveBy_Payload_Fetch_After_DNS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects the network-observable result of staged drive-by content (T1608.004). An internal client resolves a domain that is not on the known-good list and then, within 10 minutes, makes a browser-style HTTP GET to that same domain for an executable, script, installer, or archive payload on an external address. The client IP and the domain are the join keys."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.004"
    mitre_technique_name = "Stage Capabilities: Drive-by Target"
    log_prerequisites = "Requires firewall or web proxy logs that populate both DNS (NETWORK_DNS) and HTTP (NETWORK_HTTP) events, with principal.ip, target.hostname, target.url, and network.http.user_agent. HTTP URL visibility requires proxy logging or TLS inspection."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate software downloads from vendor or CDN domains not yet in the allowlist, developers fetching installers or archives, unattended update mechanisms that use browser-like user agents, and security sandboxes or scanners."
    tuning_guidance = "Add known-good vendor, CDN, and update domains to %global_allowed_domains. Add scanner and sandbox source addresses to %global_allowed_scanners. Extend or narrow the payload extension list per client download policy. If the proxy does not populate target.hostname, confirm the log parser maps the HTTP Host header to it."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.ip = $client_ip
    $dns.network.dns.questions.name = $domain
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.ip = $client_ip
    $http.target.hostname = $domain
    $http.network.http.method = "GET"
    $http.network.http.user_agent = /(mozilla|chrome|safari|edge|firefox)/ nocase
    $http.target.url = /\.(exe|msi|dll|scr|jar|hta|js|vbs|ps1|iso|img|zip|rar|7z|apk)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $client_ip, $domain over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.004")
    $primary_entity = array_distinct($client_ip)
    $staged_domain = array_distinct($domain)
    $payload_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $http_request_count = count($http.metadata.id)

  condition:
    $dns and $http
}
