/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:42:05.093774+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_Cloud_Log_Config_Tampering_API_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP-level API calls that stop, delete or modify cloud logging configuration (audit trails, log sinks, diagnostic settings, flow logs, log groups) when the caller originates from outside internal address space and is not an approved principal or management source. Provides network-side coverage for defense impairment that complements endpoint command-line detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Log"
    log_prerequisites = "Requires cloud control-plane API traffic normalised as NETWORK_HTTP with target.url, network.http.method and principal.ip populated (API gateway, egress proxy or HTTP-normalised control-plane audit feed). Callers using JSON-body style APIs with no action name in the URL will not match."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines or cloud admins working from external or home networks, planned log pipeline migrations, decommissioning of environments or projects, sink or trail rotation by approved automation."
    tuning_guidance = "Add automation identities to %global_allowed_cloud_principals, named administrators to %global_allowed_admin_users, and VPN/bastion egress addresses to %global_allowed_mgmt_sources. Extend the URL resource-type list if the tenant uses additional logging services."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    (
      $net.target.url = /(action=|\/)(stoplogging|deletetrail|updatetrail|deleteflowlogs|deleteloggroup|deletelogstream|puteventselectors)\b/ nocase or
      (
        $net.network.http.method = "DELETE" and
        $net.target.url = /\/(sinks|diagnosticsettings|flowlogs|trails|logmetrics)\/[^\/?]+/ nocase
      )
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_cloud_principals
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($net.principal.user.userid)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
