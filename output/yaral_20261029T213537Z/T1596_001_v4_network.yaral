/*
  MITRE Technique : T1596.001 - DNS/Passive DNS
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:59:38.404609+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_001_External_TCP_DNS_Zone_Transfer_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source opening a TCP connection to port 53 on a protected host. Ordinary DNS queries use UDP. Inbound TCP/53 from the internet is characteristic of DNS zone transfer (AXFR/IXFR) attempts and direct nameserver enumeration, which adversaries use to harvest subdomains, mail servers, and host addressing for targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.001"
    mitre_technique_name = "Search Open Technical Databases: DNS/Passive DNS"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated. Appliance must sit on the perimeter and see inbound traffic to authoritative or recursive DNS servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate secondary or partner nameservers performing zone transfers; resolvers retrying over TCP after truncated UDP responses (large DNSSEC or EDNS answers); external DNS health-check and monitoring services; authorised external vulnerability scanners; registrar or managed-DNS provider sync."
    tuning_guidance = "Add approved secondary nameserver and partner source addresses to %global_allowed_mgmt_sources. Source addresses of authorised external scanners can be added to the same list. If the environment legitimately serves public TCP DNS, raise severity only when the same source also appears in IPS signature hits, or move to a Threshold variant that counts distinct DNS server targets per source."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    $net.network.ip_protocol = "TCP"
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1596.001")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_dns_servers = array_distinct($net.target.ip)
    $targeted_hostnames = array_distinct($net.target.hostname)

  condition:
    $net
}
