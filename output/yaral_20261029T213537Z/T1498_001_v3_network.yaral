/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:20:45.984189+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Asymmetric_Outbound_Stateless_Flood_macOS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single firewall flow record in which a macOS host sends a very large volume of stateless (UDP or ICMP) traffic to an external destination with almost no return traffic. This one-sided pattern is characteristic of a host being used as a source in a direct network flood (DoS/DDoS botnet participation). Detection is purely network-side and uses no endpoint process fields."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Firewall or perimeter flow logs normalised to UDM NETWORK_FLOW with network.ip_protocol, network.sent_bytes and network.received_bytes populated. Flow records must be emitted at a regular interval or at flow close. macOS hosts must be identifiable via principal.platform (asset enrichment) or the rule must be scoped to macOS client address ranges."
    platform = "macOS"
    log_source = "firewall"
    false_positives = "Large UDP-based uploads such as QUIC/HTTP3 backups or video conferencing with sparse acknowledgements, NTP/syslog/NetFlow or telemetry exporters, UDP-based VPN or tunnel traffic (WireGuard, IPsec NAT-T), authorised load or stress testing, and large one-way media streaming."
    tuning_guidance = "Add authorised load-test or scanner source addresses to %global_allowed_scanners. Add known-good external destinations to %global_allowed_domains (matched on target.hostname). Raise or lower the sent_bytes threshold (default 100 MB per flow record) to match the client's flow-export interval and typical upload volumes. If the firewall does not populate principal.platform, remove that condition and scope the rule to macOS address ranges via a client-specific allowlist or host group."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.principal.platform = "MAC"
    ($net.network.ip_protocol = "UDP" or $net.network.ip_protocol = "ICMP")
    $net.network.sent_bytes > 100000000
    $net.network.received_bytes < 10000
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
