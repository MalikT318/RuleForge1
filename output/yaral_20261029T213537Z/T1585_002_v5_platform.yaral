/*
  MITRE Technique : T1585.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:37:24.011754+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_002_Email_Account_Signup_Via_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an outbound HTTP POST to a mail-service hostname on an account-registration URL path, as seen at the network perimeter. This is the network-observable footprint of someone creating a new email account, including disposable or throwaway mailbox services used to stage phishing or register infrastructure. Matching on generic hostname and path patterns rather than named providers keeps the rule portable across tenants."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.002"
    mitre_technique_name = "Establish Accounts: Email Accounts"
    log_prerequisites = "Requires perimeter proxy or firewall logs normalised to UDM NETWORK_HTTP with the HTTP method, target hostname and full target URL populated. TLS inspection is needed for the URL path to be visible. Without it the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Staff legitimately registering for a vendor or personal webmail account, marketing or QA teams creating test mailboxes, IT onboarding of hosted mail tenants, and sign-up flows on corporate-sanctioned mail platforms."
    tuning_guidance = "Add sanctioned mail and identity provider domains to %global_allowed_domains. Add onboarding or test-account administrators to %global_allowed_admin_users. Raise severity when the source belongs to a sensitive segment or when the same source registers several accounts."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.hostname = /(mail|inbox|webmail|mailbox|tempmail|throwaway|disposable)/ nocase
    $http.target.url = /\/(signup|sign-up|register|registration|createaccount|create-account|newaccount|new-account|join)(\/|\?|$|\.)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1585.002")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)

  condition:
    $http
}
