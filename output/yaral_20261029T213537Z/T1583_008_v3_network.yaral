/*
  MITRE Technique : T1583.008 - Malvertising
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:13:42.844340+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_008_Malvertising_AdClickID_Binary_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client issuing an HTTP GET to an external host for an installer or archive file (exe, msi, dmg, iso, zip, etc.) where the URL still carries an advertising click-identifier query parameter. Legitimate ad clicks normally land on a web page, not directly on a binary. A click-ID attached to a direct software download is characteristic of malvertising campaigns that push trojanized installers from cloned vendor sites."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.008"
    mitre_technique_name = "Acquire Infrastructure: Malvertising"
    log_prerequisites = "Requires forward proxy, secure web gateway, or perimeter firewall logs with full URL logging (TLS inspection needed for HTTPS paths) normalised to UDM NETWORK_HTTP with target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Marketing or software vendors that append ad click-IDs to legitimate download links (SaaS agent installers, trial downloads); users following vendor ads to genuine installers; link-shortener or email-tracking redirectors that preserve click parameters; IT staff downloading tools from search results."
    tuning_guidance = "Add known-good software distribution and vendor domains to %global_allowed_domains. Exclude sanctioned build or patching hosts via %global_allowed_admin_tools if they appear as principal.hostname values. Raise severity or pair with a newly-registered-domain lookup for high-risk client groups. Trim the extension list if archive downloads are noisy."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /[?&](gclid|gbraid|wbraid|msclkid|dclid|fbclid|ttclid|twclid|yclid)=/ nocase
    $net.target.url = /\.(exe|msi|msix|appx|dmg|pkg|iso|img|zip|7z|rar|scr|jar)(\?|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $download_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $referrers = array_distinct($net.network.http.referral_url)

  condition:
    $net
}
