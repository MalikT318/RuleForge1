/*
  MITRE Technique : T1593.002 - Search Engines
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:45:04.810834+00:00
  Reference       : https://attack.mitre.org/techniques/T1593/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_002_Search_Engine_Dork_Query_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects outbound HTTP requests whose URL query string carries two or more advanced search-operator (dork) tokens such as inurl:, intitle:, filetype: or site:. Reconnaissance staff or compromised internal hosts use this syntax to find leaked documents, credentials and exposed assets. Detection is on the query-syntax pattern, not on any search provider domain."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593.002"
    mitre_technique_name = "Search Open Websites/Domains: Search Engines"
    log_prerequisites = "IPS or network security appliance with HTTP inspection that populates target.url (requires TLS decryption or cleartext traffic to see the query string). Source hosts should populate principal.ip."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security researchers, OSINT and red-team staff, SEO and marketing staff, developers and sysadmins using operator syntax for legitimate searching, authorised external attack-surface monitoring."
    tuning_guidance = "Add authorised scanner or OSINT workstation hostnames to %global_allowed_scanners. Raise the operator count in the regex for noisy environments. Pair with sensitive-keyword enrichment downstream for prioritisation. Low severity because this is an indicator of reconnaissance interest, not compromise."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /[?&](q|query|p|text|search_query|wd)=[^&]*\b(inurl|allinurl|intitle|allintitle|intext|allintext|inanchor|filetype|ext)(:|%3a)[^&]*\b(inurl|allinurl|intitle|allintitle|intext|inanchor|filetype|ext|site)(:|%3a)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1593.002")
    $primary_entity = array_distinct($http.principal.ip)
    $source_hostname = array_distinct($http.principal.hostname)
    $destination_host = array_distinct($http.target.hostname)
    $search_url = array_distinct($http.target.url)

  condition:
    $http
}
