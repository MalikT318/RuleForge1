/*
  MITRE Technique : T1595 - Active Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:50:06.814300+00:00
  Reference       : https://attack.mitre.org/techniques/T1595
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_External_Web_Probe_Sensitive_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting well-known sensitive or administrative paths (environment files, VCS metadata, cloud credential files, debug and management endpoints) and receiving a 403/404 response. Blind requests for paths that do not exist on the server are characteristic of automated reconnaissance against public-facing web infrastructure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595"
    mitre_technique_name = "Active Scanning"
    log_prerequisites = "Requires proxy, WAF, load balancer or perimeter firewall logs with URL inspection, normalised to NETWORK_HTTP with target.url and network.http.response_code populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and external attack-surface monitoring services not yet in the scanner list, search engine and security research crawlers, uptime monitors, and penetration tests."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners. Add trusted external sources to %global_allowed_mgmt_sources. Raise severity or follow up with a threshold or correlation rule when the same source IP triggers repeatedly. Remove the 403/404 response filter if the log source does not populate response codes."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(\.env|\.git\/(config|HEAD)|\.svn\/entries|\.aws\/credentials|\.ds_store|phpmyadmin|server-status|actuator\/(env|heapdump)|web-inf\/web\.xml|config\.php\.bak|backup\.(zip|sql|tar\.gz))(\?|\/|$)/ nocase
    ($http.network.http.response_code = 404 or $http.network.http.response_code = 403)
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1595")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_host = array_distinct($http.target.hostname)
    $probed_url = array_distinct($http.target.url)
    $response_code = array_distinct($http.network.http.response_code)

  condition:
    $http
}
