/*
  MITRE Technique : T1543.001 - Launch Agent
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:25:12.364578+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_001_macOS_LaunchAgent_Plist_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a property list (.plist) file in a macOS LaunchAgents directory (/Library/LaunchAgents or a user's ~/Library/LaunchAgents), the file artifact used to persist a Launch Agent. Detection is at the file-state layer, so it still fires if command-line logging is evaded, for example when the plist is written by a script, API call or renamed tooling."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.001"
    mitre_technique_name = "Create or Modify System Process: Launch Agent"
    log_prerequisites = "macOS endpoint telemetry that records file creation events with the full target path and the writing (principal) process path. Endpoint Security framework based sensors or equivalent."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate application installers and updaters (browsers, collaboration tools, VPN clients, cloud storage sync clients), MDM-driven configuration profiles, developer tooling installing helper agents, and IT deployment scripts."
    tuning_guidance = "Add approved deployment and patching tools to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation or MDM service accounts to %global_allowed_service_accounts. Review the writer process path in $writer_process: shells, interpreters, curl or osascript writing a plist should be treated as higher confidence. Enable a companion FILE_MODIFICATION variant if the sensor reports overwrites of existing plists as modifications."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(Library|Users\/[^\/]+\/Library|var\/root\/Library)\/LaunchAgents\/[^\/]+\.plist$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\/(mdmclient|softwareupdated)$/ nocase

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1543.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $plist_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
