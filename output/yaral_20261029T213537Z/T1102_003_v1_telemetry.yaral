/*
  MITRE Technique : T1102.003 - One-Way Communication
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:06:56.535015+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_003_Linux_Downloader_Drops_Staged_Instruction_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a network-transfer utility (curl/wget) creating a hidden file or a script/config/data-style file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This is the file artifact left when a host retrieves one-way C2 instructions from a legitimate web service (paste site, social media, cloud document, repository) and stages them locally. Detection is on the resulting file-creation state change, not the command line, so it still fires when command-line logging is evaded or obfuscated."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.003"
    mitre_technique_name = "Web Service: One-Way Communication"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates the creating process path (principal.process.file.full_path) and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package or install scripts that download to /tmp, configuration management agents, CI/CD runners, admins fetching files manually, monitoring or health-check scripts, container image builds."
    tuning_guidance = "Add approved downloader parent tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and build, CI or jump hosts to %global_allowed_script_hosts. Tighten the extension list or require hidden files only to reduce noise. Consider raising severity when the dropped file is later executed or followed by outbound connections."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(curl|wget)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(\.[^\/]+|[^\/]+\.(sh|py|pl|rb|txt|json|cfg|conf|dat|b64|enc|bin))$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1102.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $creator_process = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
