/*
  MITRE Technique : T1587.003 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:51:47.616489+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_003_Repeated_Alt_TLS_Port_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes many outbound connections to external destinations on alternate TLS ports (8443, 4443, 9443 and similar) within ten minutes. Self-signed certificates are not visible in firewall logs. This is an indirect network indicator of attacker-built TLS infrastructure using non-standard ports, as in C2 channels that rely on self-signed certificates. Treat it as a hunting lead rather than confirmation."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.003"
    mitre_technique_name = "Develop Capabilities: Digital Certificates"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Web management consoles on 8443, VPN and SSL gateways, SaaS vendors using alternate TLS ports, developer and test traffic, and legitimate backup or sync clients."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains and approved scanners or test hosts to %global_allowed_scanners. Raise the #net threshold for noisy clients or reduce the alternate port list. Review outcome $unique_dest_ips: one destination suggests a persistent channel, many suggest scanning."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    (
      $net.target.port = 8443 or
      $net.target.port = 4443 or
      $net.target.port = 9443 or
      $net.target.port = 8444 or
      $net.target.port = 10443 or
      $net.target.port = 7443 or
      $net.target.port = 2083
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1587.003")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $unique_dest_ips = count_distinct($net.target.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 15
}
