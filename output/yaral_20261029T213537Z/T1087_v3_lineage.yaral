/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:49:34.587478+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_macOS_Unexpected_Parent_Spawns_Account_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects macOS account discovery tooling (dscl, dscacheutil, id, who, last, etc.), or a shell running such commands, launched by a parent process that should never enumerate accounts. Unexpected parents include Microsoft Office apps, document viewers, web servers, database services and the CUPS print daemon. These lineages typically indicate macro, document or web-shell exploitation followed by hands-on-keyboard discovery."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "macOS endpoint telemetry that records process launch events with parent process path, child process path and command line."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Database or web application maintenance scripts that call id or who for permission checks, Office add-ins or enterprise plug-ins that query the local user, MDM or inventory agents launched from an unusual parent, developers running local web stacks that enumerate users."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, and add expected service identities (for example web or database service users) to %global_allowed_service_accounts. To broaden coverage, extend the parent regex with additional application bundles or daemons used in the client estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, document viewers, web/db services, print spooler
    (
      $proc.principal.process.file.full_path = /\/Microsoft (Word|Excel|PowerPoint|Outlook)\.app\/Contents\/MacOS\// nocase or
      $proc.principal.process.file.full_path = /\/(Preview|Adobe Acrobat Reader|Adobe Acrobat)\.app\/Contents\/MacOS\// nocase or
      $proc.principal.process.file.full_path = /\/(httpd|nginx|php-fpm|php-cgi|tomcat|mysqld|postgres|mongod|redis-server|cupsd)$/ nocase
    )

    // Child: account discovery binary directly, or shell running account discovery
    (
      $proc.target.process.file.full_path = /\/(dscl|dscacheutil|id|who|w|last|lastlog|finger|users|groups|sysadminctl)$/ nocase or
      (
        $proc.target.process.file.full_path = /\/(bash|zsh|sh|dash|ksh|tcsh)$/ nocase and
        $proc.target.process.command_line = /\b(dscl|dscacheutil|sysadminctl|finger|lastlog)\b|\b(id|who|last|groups)(\s|;|\||$)|\/etc\/passwd/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
