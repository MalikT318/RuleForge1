/*
  MITRE Technique : T1588.005 - Exploits
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:01:34.076297+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_005_Perimeter_Inbound_Exploit_Pattern_Web_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects external sources sending HTTP requests that carry generic exploit-technique structures to perimeter-exposed web services: repeated encoded directory traversal, shell command-injection chaining, or nested expression-language lookups. Acquisition of exploits (T1588.005) happens off-network and cannot be seen directly. This rule detects the observable result, which is an adversary using an acquired or modified exploit against an exposed asset. It matches exploit classes, not specific CVE payloads."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.005"
    mitre_technique_name = "Obtain Capabilities: Exploits"
    log_prerequisites = "Requires perimeter HTTP visibility with the request URL populated in UDM target.url (reverse proxy, WAF-fronting proxy, or firewall with application inspection / TLS decryption). Encrypted traffic without inspection will not match."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, internet-wide research scanners, applications that legitimately pass encoded paths or templated expressions in URLs, and security-product health checks."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners. Add approved management or test sources to %global_allowed_admin_users only if the identity is populated. If the rule is noisy on a given client, restrict it to the client's internet-facing destination hostnames or require a successful response code once that field is reliably populated."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /((\.\.|%2e%2e)(\/|%2f|%5c|\\).{0,80}(\.\.|%2e%2e)(\/|%2f|%5c|\\)|(;|%3b|\||%7c|`|%60|\$\(|%24%28)\s*(wget|curl|bash|\/bin\/sh|nc|certutil|powershell|cmd)(\s|\+|%20|%09)|(\$|%24)(\{|%7b)[^}]{0,60}(\$|%24)(\{|%7b))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1588.005")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ip = array_distinct($http.principal.ip)
    $request_url = array_distinct($http.target.url)

  condition:
    $http
}
