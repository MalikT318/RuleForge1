/*
  MITRE Technique : T1589.003 - Employee Names
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:10:18.803033+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_003_Staff_Directory_Browse_Then_User_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single external source requests staff, team or directory pages on an organisation-owned web property and then probes user-enumeration endpoints (author ID iteration, user listing APIs, directory lookups) within ten minutes. This pattern is typical of harvesting employee names to build email addresses, username lists and phishing lures."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.003"
    mitre_technique_name = "Gather Victim Identity Information: Employee Names"
    log_prerequisites = "Requires perimeter proxy, WAF or firewall logs that record HTTP requests with the full target URL (UDM NETWORK_HTTP, target.url and principal.ip populated). Pure L3/L4 firewall logs without URL visibility cannot satisfy this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Search engine and SEO crawlers indexing team pages, authorised external vulnerability or web scanners, uptime and content monitoring services, recruiters or journalists using legitimate site search, and CMS plugins calling the user API from external SaaS."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add monitoring, partner or CDN source addresses to %global_allowed_mgmt_sources. Adjust the staff-page and enumeration URL regexes to match the CMS and URL structure in use at the client. Raise risk_score or alert only when enum_request_count exceeds a client-specific baseline."

  events:
    $web.metadata.event_type = "NETWORK_HTTP"
    $web.target.url = /\/(our[-_]?team|meet[-_]?the[-_]?team|team|staff|people|leadership|management|employees|directory|our[-_]?people|contact[-_]?us\/staff)(\/|\?|$)/ nocase
    not $web.principal.ip in %rfc1918_internal
    not $web.principal.ip in %global_allowed_scanners
    not $web.principal.ip in %global_allowed_mgmt_sources
    $web.principal.ip = $src_ip

    $enum.metadata.event_type = "NETWORK_HTTP"
    $enum.target.url = /(wp-json\/wp\/v2\/users|[?&]author=[0-9]+|\/_api\/web\/siteusers|\/api\/v[0-9]+\/(users|employees|people)|\/(ldap|directory)\/(search|lookup|query)|\/\.well-known\/webfinger)/ nocase
    not $enum.principal.ip in %rfc1918_internal
    not $enum.principal.ip in %global_allowed_scanners
    not $enum.principal.ip in %global_allowed_mgmt_sources
    $enum.principal.ip = $src_ip

    $web.metadata.event_timestamp.seconds <= $enum.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1589.003")
    $primary_entity = array_distinct($src_ip)
    $staff_pages_requested = array_distinct($web.target.url)
    $enum_urls_requested = array_distinct($enum.target.url)
    $enum_request_count = count($enum.metadata.id)
    $targeted_hosts = array_distinct($enum.target.hostname)

  condition:
    $web and $enum
}
