/*
  MITRE Technique : T1586.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:43:05.788138+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_002_Outbound_SMTP_From_Non_Mail_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter-observed outbound SMTP or SMTP submission (ports 25, 465, 587) from an internal source to an external destination, where the source is not an approved mail relay. Compromised email accounts and the hosts that hold their credentials are used to send phishing or spam directly. Legitimate clients normally send through an approved internal relay or gateway, so direct external SMTP from other sources is a network-side sign of a compromised mailbox or credential in use."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.002"
    mitre_technique_name = "Compromise Accounts: Email Accounts"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress SMTP must be logged, not just allowed."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Approved mail gateways, relays and marketing or transactional mail platforms not yet in the allowlist; multifunction printers and scanners that send scan-to-email; monitoring and alerting appliances that send notifications; users on guest or BYOD segments with direct mail client access."
    tuning_guidance = "Add the addresses of approved mail relays, gateways and mail-sending appliances to %global_allowed_mgmt_sources. Add known-good bulk or transactional mail provider hostnames to %global_allowed_domains where the firewall resolves the destination hostname. Monitor-only deployments can restrict to ports 465 and 587 by removing the port 25 condition if MTA traffic is noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 25 or $net.target.port = 465 or $net.target.port = 587)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1586.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
