/*
  MITRE Technique : T1584.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:25:28.292683+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_005_DGA_Like_Domain_Botnet_C2_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a DNS query for a domain whose registrable label is long, alphanumeric and has a high-entropy structure: a run of five or more consonants plus embedded digits. This is typical of algorithmically generated domains used by botnet bots to find their C2 servers, including after a botnet takeover that redirects bots to new infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.005"
    mitre_technique_name = "Compromise Infrastructure: Botnet"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Client identity (principal.hostname or principal.ip) should be present at the resolver or forwarder."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud storage hostnames with random labels, software update and telemetry services, email security and DNSBL lookups, anti-malware cloud lookups, content-addressed or session-token subdomains, and some browser or captive-portal probes."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Where many clients sit behind a shared resolver, make sure principal.hostname or principal.ip identifies the real client. To reduce noise, raise the label length from 15 to 20. To raise sensitivity, lower the consonant run from 5 to 4."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9]{15,}\.[a-z]{2,}$/ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz]{5,}/ nocase
    $dns.network.dns.questions.name = /[0-9]/
    not $dns.network.dns.questions.name = /\.(arpa|local|localdomain|internal|lan)$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.005")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
