/*
  MITRE Technique : T1593 - Search Open Websites/Domains
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:43:18.239517+00:00
  Reference       : https://attack.mitre.org/techniques/T1593
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_Search_Engine_Dork_Query_Observed_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects HTTP requests to external destinations whose query-string search parameter contains advanced search-operator syntax (inurl:, intitle:, intext:, filetype:, ext:) commonly used in Google-dorking to harvest information about a target organisation from open websites. Observed on the network side from IPS/network security appliance HTTP telemetry. Matches on the operator-plus-colon combination inside a search parameter, not on a specific search engine, tool or domain."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593"
    mitre_technique_name = "Search Open Websites/Domains"
    log_prerequisites = "Requires IPS or network security appliance logs with HTTP URL visibility (plaintext HTTP, or TLS-inspected traffic) normalised to UDM NETWORK_HTTP with target.url populated."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security researchers, OSINT and red-team staff, threat intelligence analysts, developers and IT staff using advanced search operators for legitimate research, authorised external attack-surface assessments, and SEO or marketing teams using filetype:/inurl: operators."
    tuning_guidance = "Add authorised testing sources to %global_allowed_scanners, known-good search or research domains to %global_allowed_domains, and analyst or OSINT-team service identities to %global_allowed_admin_users. Raise severity or require repeat activity per source in downstream triage if volume is high. Rule only fires where the appliance can see the full URL (plaintext or TLS inspection)."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /[?&](q|query|search|search_query|p|text|wd|keywords?)=[^&]*(inurl|intitle|intext|allinurl|allintitle|allintext|filetype|ext)(:|%3a)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1593")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $queried_urls = array_distinct($http.target.url)

  condition:
    $http
}
