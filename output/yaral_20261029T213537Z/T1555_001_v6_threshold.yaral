/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:40:52.608005+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_macOS_Keychain_File_Read_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects an abnormal volume of file-read events against macOS Keychain database files (login, System and Local Items keychains) on a single host within ten minutes, by processes other than the native keychain and security daemons. A single read is routine; repeated reads indicate direct keychain harvesting or staging for offline decryption."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "Requires macOS endpoint telemetry that records file read or open events (for example EDR file-access events or Endpoint Security framework data) normalised to FILE_READ, with principal.process.file.full_path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Backup and imaging software copying ~/Library/Keychains; MDM and migration tooling; browsers and mail clients using Keychain Services; password managers and sync agents; user migrations (Migration Assistant); forensic or IR collection."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and MDM tooling to %global_allowed_admin_tools. Raise the #file threshold on hosts with heavy keychain-using software, or extend the native daemon exclusion regex for noisy system processes in your fleet."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/Library\/Keychains\/(.*\/)?[^\/]*(\.keychain|\.keychain-db|keychain-2\.db)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(securityd|secd|trustd|cloudd|accountsd|apsd|assistantd|keychainaccess|Keychain Access|SecurityAgent|com\.apple\.[A-Za-z0-9_.-]+)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $keychain_files = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
