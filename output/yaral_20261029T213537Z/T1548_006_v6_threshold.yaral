/*
  MITRE Technique : T1548.006 - TCC Manipulation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:36:11.289484+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_006_TCC_Database_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated modification of a TCC.db privacy database (system or per-user) on a single macOS host within 10 minutes by a process other than the TCC daemon. A single write can be benign, but repeated direct writes indicate an attempt to grant Full Disk Access, Accessibility, screen capture or similar permissions to a malicious binary."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.006"
    mitre_technique_name = "Abuse Elevation Control Mechanism: TCC Manipulation"
    log_prerequisites = "Requires macOS endpoint file-modification telemetry (EDR or unified log) that records the writing process path and target file path, including protected locations under /Library/Application Support/ and /Users/*/Library/Application Support/."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM agents or configuration profile tooling provisioning privacy permissions, IT deployment and imaging scripts, security agents that read or repair the TCC database, and system migration or restore operations after OS upgrades."
    tuning_guidance = "Add approved MDM, deployment and RMM binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt, and EDR agents to %global_allowed_security_tools. Raise the #file threshold for fleets with heavy provisioning activity. Review hosts where the writing process is an interpreter, a user-writable path binary, or an application not normally granted privacy permissions."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(^|\/)Library\/Application Support\/com\.apple\.TCC\/TCC\.db(-journal|-wal|-shm)?$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(tccd|tccutil)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1548.006")
    $primary_entity = array_distinct($host)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $modified_files = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
