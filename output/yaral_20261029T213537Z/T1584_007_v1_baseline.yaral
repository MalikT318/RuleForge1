/*
  MITRE Technique : T1584.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:29:40.903198+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_007_Serverless_Endpoint_NonBrowser_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP request to a public serverless function endpoint (Cloudflare Workers, AWS Lambda function URLs or API Gateway, Google Cloud Functions or Cloud Run, Google Apps Script, Azure App Service) using a non-browser user agent. Adversaries who compromise or abuse serverless runtimes use them to answer implants directly or to proxy command-and-control traffic. Because the endpoint sits on a trusted cloud provider's domain, the scripted-client pattern is a more useful signal than the domain alone."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.007"
    mitre_technique_name = "Compromise Infrastructure: Serverless"
    log_prerequisites = "Requires perimeter or proxy HTTP logs that populate target.hostname and network.http.user_agent. TLS inspection or an explicit proxy is needed for hostname visibility on HTTPS."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS integrations, webhooks, CI/CD jobs, monitoring agents and internal developer scripts that call company-owned serverless APIs; mobile or desktop applications that use a custom user agent and are backed by serverless functions; empty user-agent fields from proxies that do not log it."
    tuning_guidance = "Add known-good function hostnames (company-owned and approved vendor endpoints) to %global_allowed_domains. Add approved scanners and integration sources to %global_allowed_scanners. If user-agent logging is unreliable, review the empty user-agent hits first. Raise severity for hosts that make repeated requests (use as a pivot in SOAR enrichment)."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /(\.workers\.dev|\.lambda-url\.[a-z0-9-]+\.on\.aws|\.execute-api\.[a-z0-9-]+\.amazonaws\.com|\.cloudfunctions\.net|\.run\.app|\.azurewebsites\.net|^script\.google\.com|^script\.googleusercontent\.com)$/ nocase
    not $http.network.http.user_agent = /(mozilla|chrome|safari|firefox|edge|opera|applewebkit)/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.007")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $serverless_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)
    $request_count = count($http.metadata.id)

  condition:
    $http
}
