/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:22:07.056699+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_Linux_Network_Security_Product_Lookup_By_Script_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a shell, scripting interpreter or command-line transfer utility on a Linux host making an outbound HTTP request to an external hostname whose label names security tooling (antivirus, EDR/XDR, endpoint protection, threat protection). This is the network-side trace of an adversary or script checking for, or fetching information about, defensive software before deciding on follow-on actions. The rule matches a generic naming pattern in the destination label, not specific vendor domains or tool names."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd with network and process attribution) normalised to NETWORK_HTTP, with principal.process.file.full_path and target.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or configuration-management scripts (curl/wget/python) that download legitimate security agent installers or signature updates, health-check scripts that poll security vendor APIs, and package or provisioning automation run during agent rollout."
    tuning_guidance = "Add approved security vendor and update domains to %global_allowed_domains. Add deployment and patching tooling to %global_allowed_admin_tools. Add legitimate agent binaries to %global_allowed_security_tools. Add approved automation hosts to %global_allowed_script_hosts. Consider raising severity if the same host also shows security-product process or file enumeration."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|ruby|php|nc|ncat|bash|sh|dash|zsh)$/ nocase
    $http.target.hostname = /(^|[.\-_])(antivirus|anti-virus|edr|xdr|endpoint-?(security|protection)|threat-?(protection|detection)|malware-?(protection|defense))([.\-_]|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_security_tools
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_hosts = array_distinct($http.target.hostname)
    $source_process = array_distinct($http.principal.process.file.full_path)
    $source_user = array_distinct($http.principal.user.userid)

  condition:
    $http
}
