/*
  MITRE Technique : T1588.003 - Code Signing Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:57:59.000238+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_003_Code_Signing_Key_Material_Transfer_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests through a perimeter proxy or firewall to external destinations that transfer code-signing key containers (.pfx, .p12, .pvk, .spc) by URL file extension. Acquiring code-signing material (T1588.003) happens outside the victim's network, so this rule covers only the part that touches the perimeter: stolen certificates and private keys being staged, downloaded, or exfiltrated. It is a proxy for the technique, not direct observation of certificate purchase."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.003"
    mitre_technique_name = "Obtain Capabilities: Code Signing Certificates"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url populated. TLS inspection is needed to see full URLs on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers or build engineers fetching or uploading signing certificates to approved CI/CD or certificate management services; PKI administrators using certificate enrolment portals; software vendors distributing .p12 or .spc files; mobile app provisioning workflows."
    tuning_guidance = "Add approved vendor and PKI domains to %global_allowed_domains. Add PKI and build administrators to %global_allowed_admin_users. Internal destinations are excluded through %rfc1918_internal. If HTTPS is not decrypted, expect low coverage, and consider restricting the rule to sensitive source segments through client-level tuning."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(pfx|p12|pvk|spc)([?#;].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1588.003")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.user.userid))
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
