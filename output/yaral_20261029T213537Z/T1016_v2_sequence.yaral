/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:48:36.665688+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_NetBIOS_Name_Queries_Then_SMB_RPC_Followup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single source sends repeated NetBIOS name service queries (UDP/137, the network behaviour of nbtstat-style node status and MAC discovery) to remote hosts, then opens SMB, RPC or NetBIOS session connections from the same source within the window. This is network-observable remote network configuration discovery followed by follow-up enumeration. Detection is based purely on perimeter or internal firewall telemetry and does not duplicate command-line rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Requires firewall or network perimeter logs, including internal segmentation firewalls, normalised to UDM NETWORK_CONNECTION events with principal.ip, target.ip and target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy Windows name resolution (WINS/NetBIOS fallback), network inventory and asset discovery tools, domain controllers and file servers talking to peers, vulnerability scanners, and IT admins troubleshooting name resolution."
    tuning_guidance = "Add scanner and inventory sources to %global_allowed_scanners (by hostname) and %global_allowed_mgmt_sources (by address). Raise the #nbns threshold in the condition for environments that still rely on NetBIOS name resolution. Where NetBIOS is disabled by policy, lower the threshold to 2."

  events:
    $nbns.metadata.event_type = "NETWORK_CONNECTION"
    $nbns.target.port = 137
    $nbns.principal.ip = $src_ip
    not $nbns.principal.hostname in %global_allowed_scanners
    not $nbns.principal.ip in %global_allowed_mgmt_sources

    $smb.metadata.event_type = "NETWORK_CONNECTION"
    ($smb.target.port = 135 or $smb.target.port = 139 or $smb.target.port = 445)
    $smb.principal.ip = $src_ip
    not $smb.principal.hostname in %global_allowed_scanners
    not $smb.principal.ip in %global_allowed_mgmt_sources

    $nbns.metadata.event_timestamp.seconds <= $smb.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($src_ip)
    $nbns_query_count = count($nbns.metadata.id)
    $nbns_targets = array_distinct($nbns.target.ip)
    $followup_targets = array_distinct($smb.target.ip)
    $followup_ports = array_distinct($smb.target.port)

  condition:
    #nbns >= 3 and $smb
}
