/*
  MITRE Technique : T1591.003 - Identify Business Tempo
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:30:18.807101+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_003_Scripted_Client_Business_Tempo_Page_Harvest {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external, non-browser HTTP client requesting web content that discloses business tempo (operating hours, holiday or delivery schedules, shipping and dispatch information) on an organisation-owned web service. Business tempo gathering is mostly passive and invisible to the victim, so this is a low-fidelity heuristic for the only observable slice: automated harvesting of tempo-revealing pages. Use it as a reconnaissance enrichment signal or for correlation with other recon activity, not as a standalone alert."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.003"
    mitre_technique_name = "Gather Victim Org Information: Identify Business Tempo"
    log_prerequisites = "IDS/IPS or inline network security appliance with HTTP inspection that populates network.http.user_agent, target.url and principal.ip for inbound traffic to internet-facing web services. Without URL and user-agent visibility (for example encrypted traffic with no TLS inspection) the rule will not fire."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and synthetic monitoring, partner or logistics integrations polling delivery or shipping pages, price and availability aggregators, accessibility and archiving bots, and internal or third-party vulnerability scanners not yet allowlisted."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners. Add known partner or integration sources to %global_allowed_mgmt_sources if appropriate. Adjust the URL keyword regex to match the customer's web taxonomy (for example add local-language terms for hours or shipping). Consider alerting only when the same source also appears in other recon detections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\/[^\s?#]*(opening[-_ ]?hours|business[-_ ]?hours|store[-_ ]?hours|hours[-_ ]?of[-_ ]?operation|holiday[-_ ]?(schedule|closure|hours)|delivery[-_ ]?schedule|shipping[-_ ]?(schedule|info|policy)|dispatch|order[-_ ]?cutoff|cut[-_ ]?off[-_ ]?times?)/ nocase
    $http.network.http.user_agent = /(curl\/|wget\/|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|scrapy|okhttp|java\/[0-9]|apache-httpclient|node-fetch|axios|headless)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1591.003")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
