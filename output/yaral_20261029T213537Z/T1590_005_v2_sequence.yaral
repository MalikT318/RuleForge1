/*
  MITRE Technique : T1590.005 - IP Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:20:47.562407+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_005_External_Scan_Sweep_Then_Web_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single external source IP that triggers multiple IPS reconnaissance/scan verdicts at the network layer and then triggers a scan or probe verdict at the HTTP layer within 10 minutes. This pattern is typical of an adversary enumerating which public IP addresses and services in an organization's address space are live (T1590.005 / T1595 precursor activity)."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.005"
    mitre_technique_name = "Gather Victim Network Information: IP Addresses"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION and NETWORK_HTTP events, with the signature or rule name populated in security_result.rule_name."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface management services, search-engine and internet-measurement crawlers, partner penetration tests, and noisy but benign monitoring probes."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Adjust the signature keyword regex to match the client's IPS signature naming. Raise the #conn threshold in the condition for internet-facing segments with heavy background scanning."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.security_result.rule_name = /scan|recon|probe|sweep|enumerat|discovery/ nocase
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    $conn.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.security_result.rule_name = /scan|recon|probe|sweep|enumerat|discovery/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1590.005")
    $primary_entity = array_distinct($src_ip)
    $targeted_ips = array_distinct($conn.target.ip)
    $targeted_ports = array_distinct($conn.target.port)
    $scan_signatures = array_distinct($conn.security_result.rule_name)
    $conn_event_count = count($conn.metadata.id)
    $http_event_count = count($http.metadata.id)

  condition:
    #conn >= 5 and $http
}
