/*
  MITRE Technique : T1574.004 - Dylib Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:53:39.094648+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_004_Dylib_Hijack_App_Bundle_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or download utility launched directly by a commonly hijacked GUI application running from an /Applications bundle (Office suite, Adobe, Slack, Zoom). A hijacked dylib runs inside the host application's process, so malicious code often surfaces as an unexpected child process of that application. This is a lineage-based detection and does not rely on command-line content."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.004"
    mitre_technique_name = "Hijack Execution Flow: Dylib Hijacking"
    log_prerequisites = "macOS endpoint telemetry that records process launches with parent (principal.process) and child (target.process) executable paths."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Office macros or add-ins that call osascript, Microsoft AutoUpdate helpers, Zoom or Slack updaters and installers that call shell scripts, Adobe installers and Creative Cloud helpers, and IT-managed plug-ins that run scripts from within the application."
    tuning_guidance = "Add legitimate parent application paths to %global_allowed_script_hosts. Add approved management tooling to %global_allowed_admin_tools. Extend the parent application regex with line-of-business applications known to be dylib-hijack candidates in the client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /^\/Applications\/(Microsoft (Word|Excel|PowerPoint|Outlook|OneNote)|Slack|zoom\.us|Adobe [^\/]+)\.app\/Contents\/MacOS\// nocase
    $proc.target.process.file.full_path = /\/(bash|sh|zsh|dash|osascript|python3?|perl|ruby|curl)$/ nocase
    not $proc.principal.process.file.full_path = /AutoUpdate|Updater|Installer/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
