/*
  MITRE Technique : T1543.001 - Launch Agent
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:26:06.900792+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_001_LaunchAgent_Persisted_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound external network connection from a process that launchd started and whose binary sits in a user-writable or staging location (temp directories, /Users/Shared, hidden folders in a user home, or ~/Library/LaunchAgents and Preferences). This is the network footprint of a Launch Agent payload beaconing after login or load. It is independent of plist creation and of command-line matching."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.001"
    mitre_technique_name = "Create or Modify System Process: Launch Agent"
    log_prerequisites = "macOS endpoint telemetry that records network connections with the initiating process path and its parent process path (EDR network events or unified log network attribution)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party updaters or developer tools that run from hidden folders in a home directory under launchd, user-installed menu-bar utilities kept in /Users/Shared, package installers staging in /private/tmp, and RMM or MDM helpers launched by launchd from user-writable paths."
    tuning_guidance = "Add approved agent binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt, and EDR/AV binaries to %global_allowed_security_tools. Add known-good vendor update domains to %global_allowed_domains. Adjust the path regex if a client legitimately runs software from hidden home-directory folders. Extend %rfc1918_internal if the client uses additional internal ranges."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /^\/sbin\/launchd$/ nocase
    $net.principal.process.file.full_path = /^(\/(private\/)?(var\/)?tmp\/|\/Users\/Shared\/|\/Users\/[^\/]+\/(\.[^\/]+\/|Library\/(LaunchAgents|Preferences)\/|Library\/[^\/]+\/\.[^\/]+\/))/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
