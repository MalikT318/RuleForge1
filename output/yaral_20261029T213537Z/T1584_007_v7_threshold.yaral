/*
  MITRE Technique : T1584.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:31:39.179080+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_007_Serverless_Platform_Beaconing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes a high volume of web requests to serverless platform hostnames (function-as-a-service, edge worker and script-hosting endpoints) within ten minutes. Compromised serverless infrastructure is used to relay or answer C2 traffic, and the repetition looks like beaconing. A single request is benign. The volume to a platform that is not on the approved list is the signal."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.007"
    mitre_technique_name = "Compromise Infrastructure: Serverless"
    log_prerequisites = "Requires perimeter firewall or web proxy logs normalised to UDM NETWORK_HTTP with principal.ip and target.hostname populated (TLS SNI or HTTP host). Logs that do not carry a destination hostname cannot evaluate this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal applications or SaaS integrations that legitimately call serverless APIs (webhooks, API gateways, CI/CD pipelines, monitoring probes), developer workstations testing functions, and browser-based tools served from serverless hosting."
    tuning_guidance = "Add trusted serverless-hosted destinations to %global_allowed_domains. Raise the #http threshold for noisy environments. Review the $destination_hosts outcome to separate a single repeated endpoint (likely beaconing) from many different endpoints (likely developer activity)."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /(^script\.google(usercontent)?\.com$)|(\.(workers\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app|azurewebsites\.net|pages\.dev|vercel\.app|netlify\.app)$)/ nocase
    $http.principal.ip = $src
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  match:
    $src over 10m

  outcome:
    $risk_score = max(50)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1584.007")
    $primary_entity = array_distinct($src)
    $destination_hosts = array_distinct($http.target.hostname)

  condition:
    #http >= 20
}
