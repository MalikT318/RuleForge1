/*
  MITRE Technique : T1584.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:19:31.849313+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_001_DNS_Long_Label_Subdomain_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single DNS client issues a burst of queries for names with unusually long, machine-generated-looking subdomain labels within ten minutes. This pattern is consistent with traffic to hijacked domains or subdomains, domain shadowing (malicious subdomains created under a compromised legitimate domain), and algorithmically generated C2 or tunnelling names. One long-label query is benign; repeated long-label queries from one client are not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.001"
    mitre_technique_name = "Compromise Infrastructure: Domains"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with principal.ip (client address) and network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud services using long hashed hostnames, email security and anti-spam DNS blocklist lookups, software update and telemetry services, DKIM or service-discovery records, some endpoint security cloud-lookup queries, and content-addressed hosting."
    tuning_guidance = "Add known-good parent domains to %global_allowed_domains. Note this list is matched against the full queried name, so add the exact names that recur in your environment. Raise the #dns threshold for noisy clients such as DNS forwarders or proxies, whose principal.ip aggregates many users. Consider excluding resolver or forwarder source addresses upstream."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^[a-z0-9_-]{30,}\.[^.]+\.[^.]+/ nocase
    $dns.principal.ip = $client
    not $dns.network.dns.questions.name in %global_allowed_domains

  match:
    $client over 10m

  outcome:
    $risk_score = max(65)
    $query_count = count($dns.metadata.id)
    $unique_queried_names = count_distinct($dns.network.dns.questions.name)
    $sample_queried_names = array_distinct($dns.network.dns.questions.name)
    $mitre_technique_id = array_distinct("T1584.001")
    $primary_entity = array_distinct($client)

  condition:
    #dns >= 10
}
