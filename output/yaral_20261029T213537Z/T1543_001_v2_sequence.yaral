/*
  MITRE Technique : T1543.001 - Launch Agent
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:25:29.844125+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_001_LaunchAgent_Plist_Drop_Then_Launchctl_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A launchd plist is written to a LaunchAgents directory (system or per-user) by a process outside the OS-managed locations, and launchctl then loads, bootstraps or kickstarts a LaunchAgents job on the same host within 10 minutes. This drop-then-load sequence is how Launch Agent persistence is typically installed and activated. The rule is additive to command-line detections because it requires the file-write evidence as well."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.001"
    mitre_technique_name = "Create or Modify System Process: Launch Agent"
    log_prerequisites = "macOS endpoint telemetry that reports both FILE_CREATION (with the creating process path) and PROCESS_LAUNCH (with the parent process path and command line)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party application installers and auto-updaters that register a helper Launch Agent, MDM or software deployment agents, developer tools such as Homebrew services, and administrators scripting launchd job installation."
    tuning_guidance = "Add approved deployment and updater binaries to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. If a specific installer is noisy, add its full process path to the same list, not its install directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/Library\/LaunchAgents\/[^\/]+\.plist$/ nocase
    not $file.principal.process.file.full_path = /^\/(System\/|usr\/libexec\/|usr\/sbin\/|sbin\/)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/bin\/launchctl$/ nocase
    $proc.target.process.command_line = /\b(load|bootstrap|kickstart)\b/ nocase
    $proc.target.process.command_line = /LaunchAgents/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1543.001")
    $primary_entity = array_distinct($hostname)
    $plist_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $launchctl_commands = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
