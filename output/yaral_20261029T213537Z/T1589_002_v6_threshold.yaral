/*
  MITRE Technique : T1589.002 - Email Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:09:43.412576+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_002_Email_Enumeration_Endpoint_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source sends a high volume of HTTP requests to email and identity discovery endpoints (Autodiscover, GetCredentialType, EWS, OWA auth, RPC proxy) within ten minutes. One request to these endpoints is normal mail client behaviour. Volume from one source indicates active email address and username enumeration."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.002"
    mitre_technique_name = "Gather Victim Identity Information: Email Addresses"
    log_prerequisites = "Requires perimeter firewall, reverse proxy or WAF logs that normalise to NETWORK_HTTP with principal.ip and target.url populated (URL logging or TLS inspection enabled for inbound traffic to published mail services)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Mail clients and mobile devices re-running Autodiscover after a profile or password change, large NAT or carrier-grade NAT egress addresses shared by many legitimate users, migration or onboarding projects, external monitoring and synthetic transaction services, authorised penetration tests."
    tuning_guidance = "Add authorised scanners and monitoring sources to %global_allowed_scanners. Raise the #http threshold for tenants behind large shared NAT addresses. Extend the URL pattern with tenant-specific published mail paths if needed. Add known-good vendor sources to %global_allowed_mgmt_sources if they poll mail endpoints."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(autodiscover\/autodiscover\.(xml|json)|getcredentialtype|\/owa\/auth|\/ews\/exchange\.asmx|\/rpc\/rpcproxy\.dll|\/mapi\/emsmdb|\/oab\/)/ nocase
    $http.principal.ip = $src
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1589.002")
    $primary_entity = array_distinct($src)
    $event_count = count($http.metadata.id)
    $targeted_hosts = array_distinct($http.target.hostname)
    $targeted_urls = array_distinct($http.target.url)

  condition:
    #http >= 25
}
