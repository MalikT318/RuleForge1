/*
  MITRE Technique : T1587 - Develop Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:47:33.453094+00:00
  Reference       : https://attack.mitre.org/techniques/T1587
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_Direct_Payload_Download_Then_NonStandard_Port_Callback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An internal client downloads an executable, script, or archive payload by direct HTTP GET from an external host. Within 10 minutes the same client opens a connection to the same external IP on a non-standard high port. This pattern fits staging and callback of custom-developed capability hosted on adversary-built infrastructure. The detection is network-observable only and is a proxy for T1587, since the development itself happens outside the victim environment."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587"
    mitre_technique_name = "Develop Capabilities"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP (with target.url and http method) and NETWORK_CONNECTION (with target.port) events, with principal.ip and target.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software vendors distributing installers or updates from bare IP hosts, developers pulling build artifacts and testing services on custom ports, vulnerability scanners, and CDN or update services not yet in the known-good domain list."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add authorised scanner or test sources to %global_allowed_scanners. Adjust the payload extension regex or the excluded ports to match client web-filtering policy. Widen or narrow the 10m window as needed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(exe|dll|msi|scr|ps1|vbs|hta|bat|jar|elf|bin|apk|zip|7z|rar)([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip
    $http.target.ip = $dst_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port > 1024
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1587")
    $primary_entity = array_distinct($src_ip)
    $external_ip = array_distinct($dst_ip)
    $downloaded_urls = array_distinct($http.target.url)
    $callback_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $http and $net
}
