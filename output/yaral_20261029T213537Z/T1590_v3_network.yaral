/*
  MITRE Technique : T1590 - Gather Victim Network Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:12:23.145795+00:00
  Reference       : https://attack.mitre.org/techniques/T1590
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_External_Probe_Of_Network_Info_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-internal) source connecting to network-infrastructure information-disclosure services (SNMP, TFTP, vendor Smart Install) as seen by an IDS/IPS or network security appliance. Adversaries probe these services to harvest victim network details such as device configuration, topology and addressing."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590"
    mitre_technique_name = "Gather Victim Network Information"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs that populate NETWORK_CONNECTION with principal.ip, target.ip and target.port. Logs must cover inbound or perimeter traffic, including traffic that was blocked or alerted on."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and penetration tests; managed service providers or ISPs polling customer-premises equipment over SNMP; legitimate remote network monitoring services; internet-wide research scanners (benign but noisy); NAT or proxy deployments where internal clients appear with public source addresses."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners. Add ISP, MSP and monitoring sources that legitimately poll network devices to %global_allowed_mgmt_sources. If the sensor sits behind NAT and reports public addresses for internal hosts, add those addresses to %rfc1918_internal or a tenant-specific equivalent. Raise severity for targets that are known network devices. For volume-based detection, pair this rule with a threshold variant that counts distinct target.ip per source."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 69 or
      $net.target.port = 4786
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1590")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    $net
}
