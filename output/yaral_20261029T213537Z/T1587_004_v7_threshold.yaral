/*
  MITRE Technique : T1587.004 - Exploits
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:53:09.498465+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_004_Perimeter_Repeated_Probing_Single_Target {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens a high volume of connections to one internal destination within ten minutes. Each connection is benign on its own, but the volume matches fuzzing or exploit-testing against an exposed service. T1587.004 (exploit development) happens off-victim and cannot be observed directly, so this rule detects the perimeter-visible symptom: an adversary iterating on an exploit against a target."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.004"
    mitre_technique_name = "Develop Capabilities: Exploits"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, uptime and synthetic monitoring, CDN or load-balancer health checks, partner integrations with chatty API clients, NAT gateways aggregating many legitimate users behind one address."
    tuning_guidance = "Add authorised scanner and pen-test sources to %global_allowed_scanners. Add approved monitoring or partner source addresses to %global_allowed_mgmt_sources. Raise or lower the #net threshold per client based on baseline traffic to exposed services. Consider a higher threshold for destinations that sit behind shared NAT."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    $net.target.ip = $dst
    $net.target.port > 0
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(45)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1587.004")
    $primary_entity = array_distinct($src)
    $target_ips = array_distinct($dst)
    $target_ports = array_distinct($net.target.port)

  condition:
    #net >= 150
}
