/*
  MITRE Technique : T1596.003 - Digital Certificates
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:02:33.195138+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_003_External_Certificate_File_Retrieval {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source retrieving digital certificate artefacts (.crt, .cer, .pem, .der, .p7b, .p7c) over HTTP from an organisation-hosted web service, as observed by an IDS/IPS or network security appliance. Adversaries harvest certificate data to learn organisation names, locations, subject alternative names and issuing CAs for later targeting. Scanning or approved testing sources are excluded via reference lists."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.003"
    mitre_technique_name = "Search Open Technical Databases: Digital Certificates"
    log_prerequisites = "IDS/IPS or network security appliance with HTTP/URL visibility on inbound traffic, normalised to NETWORK_HTTP with principal.ip and target.url populated. Passive inspection of TLS handshakes alone will not populate this."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate clients fetching CA or intermediate certificates (AIA), publicly hosted PKI trust bundles or enrolment pages, partners and mobile device enrolment fetching trust anchors, search engine and internet-measurement crawlers, and authorised external attack-surface assessments."
    tuning_guidance = "Add authorised scanner and assessment source IPs to %global_allowed_scanners. If the organisation intentionally publishes PKI artefacts (AIA or CRL distribution points), consider excluding that web service's hostname or tuning the URL regex. Raise severity or aggregate by source IP in SOAR when the same source requests certificates across multiple hosts."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(crt|cer|pem|der|p7b|p7c)(\?.*)?$/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
