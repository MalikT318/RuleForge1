/*
  MITRE Technique : T1586.001 - Social Media Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:42:17.312178+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_001_Scripted_Login_POST_External_Web_Auth {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP POST requests to external authentication endpoints (login, signin, token, session paths) sent by a scripted or headless HTTP client rather than an interactive browser. Automated credential submission to external web platforms is the network-observable footprint of credential stuffing, replayed breach credentials and bulk takeover of existing online personas (including social media accounts) as described in T1586.001. Internal-only destinations and known-good domains are excluded. The technique is mostly performed off-network, so this rule covers only the part visible from the client perimeter and is a behavioural proxy, not a platform-specific detection."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.001"
    mitre_technique_name = "Compromise Accounts: Social Media Accounts"
    log_prerequisites = "Requires proxy or firewall logs normalised to NETWORK_HTTP with network.http.method, network.http.user_agent, target.url and target.hostname populated. TLS inspection is needed to see URL paths and user agents on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developer and QA scripts exercising authentication flows, synthetic monitoring and uptime probes, SaaS integration and sync jobs that authenticate by API, marketing or social media management automation operated by the business, and penetration tests."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Add source hosts that legitimately run automation to %global_allowed_script_hosts, and authorised testing sources to %global_allowed_scanners. For high-volume clients, consider a companion Threshold rule grouped by principal.hostname."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST"
    $net.target.url = /\/(log[_-]?in|sign[_-]?in|signon|authenticate|auth\/login|oauth2?\/token|session[s]?\/create|accounts\/login)(\/|\?|$)/ nocase
    $net.network.http.user_agent = /(python-requests|python-urllib|aiohttp|curl\/|wget\/|go-http-client|okhttp|libwww-perl|java\/|node-fetch|axios|headlesschrome|phantomjs|httpclient|scrapy)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1586.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
