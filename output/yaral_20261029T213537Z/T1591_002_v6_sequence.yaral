/*
  MITRE Technique : T1591.002 - Business Relationships
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:29:16.891953+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_002_External_Partner_Page_Then_Business_Doc_Harvest {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Low"
    description = "Detects an external source that browses business-relationship content (partner, supplier, vendor, contractor or customer pages) and then, within 10 minutes, retrieves business documents referencing those relationships. This pattern is consistent with reconnaissance of third-party and supply-chain relationships. Crawlers on the allowlist and internal sources are excluded."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.002"
    mitre_technique_name = "Gather Victim Org Information: Business Relationships"
    log_prerequisites = "IDS/IPS or inline network security appliance that decodes HTTP and populates network.http fields and target.url for traffic to externally exposed web servers. TLS inspection or a reverse-proxy sensor is needed to see URLs on HTTPS."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, partner or supplier staff legitimately using the partner portal, procurement and journalism research, authorised external attack-surface monitoring, and accessibility or archiving bots."
    tuning_guidance = "Add authorised external scanners and monitoring sources to %global_allowed_scanners. Extend the user-agent exclusion for crawlers you accept. Raise severity or add a distinct-URL count threshold in the outcome for internet-facing sites with heavy partner traffic. Add client portal domains to %global_allowed_domains if partner traffic is normal."

  events:
    $partner_page.metadata.event_type = "NETWORK_HTTP"
    $partner_page.target.url = /\/(partners?|suppliers?|vendors?|contractors?|resellers?|distributors?|customers?|clients?|case-studies|alliances?|supply-chain|procurement)(\/|\.|\?|$)/ nocase
    not $partner_page.network.http.user_agent = /(googlebot|bingbot|duckduckbot|baiduspider|yandexbot|applebot)/ nocase
    not $partner_page.principal.ip in %rfc1918_internal
    not $partner_page.principal.ip in %global_allowed_scanners
    $partner_page.principal.ip = $src_ip

    $biz_doc.metadata.event_type = "NETWORK_HTTP"
    $biz_doc.target.url = /(contract|supplier|vendor|partner|procurement|subcontract|msp|reseller|customer-list|annual-report|sow|master-agreement)[^\/]*\.(pdf|docx?|xlsx?|pptx?|csv)(\?|$)/ nocase
    not $biz_doc.network.http.user_agent = /(googlebot|bingbot|duckduckbot|baiduspider|yandexbot|applebot)/ nocase
    not $biz_doc.principal.ip in %rfc1918_internal
    not $biz_doc.principal.ip in %global_allowed_scanners
    $biz_doc.principal.ip = $src_ip

    $partner_page.metadata.event_timestamp.seconds <= $biz_doc.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1591.002")
    $primary_entity = array_distinct($src_ip)
    $partner_pages_viewed = count_distinct($partner_page.target.url)
    $documents_retrieved = count_distinct($biz_doc.target.url)
    $targeted_hosts = array_distinct($biz_doc.target.hostname)

  condition:
    $partner_page and $biz_doc
}
