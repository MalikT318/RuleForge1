/*
  MITRE Technique : T1584.008 - Network Devices
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:32:58.973767+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_008_External_Mgmt_Plane_Access_To_Edge_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external, non-allowlisted source connecting to common network-device management and remote-administration ports (SSH, Telnet, alternate Telnet, TR-069, MikroTik Winbox-style management, alternate HTTPS admin, SNMP). Adversaries who compromise SOHO routers and edge appliances as third-party infrastructure must first reach these management planes. This rule is written for pre-compromise perimeter telemetry (PRE) and uses only firewall connection fields, with no endpoint process data."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.008"
    mitre_technique_name = "Compromise Infrastructure: Network Devices"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover inbound traffic to edge or WAN-facing devices."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Managed service provider or vendor remote support from public addresses not yet allowlisted; internet-wide research scanners; customer staff administering devices remotely from home or mobile networks; external monitoring probes hitting SNMP or SSH."
    tuning_guidance = "Add known admin, MSSP and vendor source addresses to %global_allowed_mgmt_sources and approved scanner addresses to %global_allowed_scanners. Narrow the port list per client if a service such as 8443 is intentionally exposed. To reduce volume, convert to a Threshold rule grouped by principal.ip, or raise severity when the same source reaches multiple distinct target.ip values."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 2323 or
      $net.target.port = 7547 or
      $net.target.port = 8291 or
      $net.target.port = 8443
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1584.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
