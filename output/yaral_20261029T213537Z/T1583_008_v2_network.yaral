/*
  MITRE Technique : T1583.008 - Malvertising
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:13:27.527123+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_008_Malvertising_Ad_Click_To_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP request for an installer, archive, disk image or script file where the URL or referrer carries an advertising-platform click identifier, and the destination is an external host outside the known-good domain list. This is the network-observable result of a malvertising chain, where a sponsored result redirects the user to a lookalike site that serves a trojanized download. It does not depend on specific domains, filenames or hashes."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.008"
    mitre_technique_name = "Acquire Infrastructure: Malvertising"
    log_prerequisites = "Requires proxy or perimeter firewall logs normalized to NETWORK_HTTP with target.url populated. Referrer coverage (network.http.referral_url) improves detection but is not required. TLS inspection is needed to see full URLs on HTTPS traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate vendor software download pages reached through paid search ads, marketing campaign links to whitepaper or ZIP downloads, IT staff downloading tools from search results, and CDNs serving installers behind tracked campaign links."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Add approved update or deployment sources to %global_allowed_admin_tools if the log source exposes them. Exclude expected scanner sources via %global_allowed_scanners. If a client has heavy software-download traffic, narrow the extension list to executable and script types only."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /^[^?#]*\.(exe|msi|msix|appx|dmg|pkg|iso|img|zip|rar|7z|scr|js|vbs|bat|ps1|jar|apk)([?#].*)?$/ nocase
    (
      $http.target.url = /[?&](gclid|gbraid|wbraid|dclid|msclkid|gad_source|yclid|twclid|ttclid)=/ nocase or
      $http.network.http.referral_url = /[?&](gclid|gbraid|wbraid|dclid|msclkid|gad_source|yclid|twclid|ttclid)=/ nocase
    )
    $http.target.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.008")
    $primary_entity = array_distinct($http.principal.ip)
    $client_hostname = array_distinct($http.principal.hostname)
    $destination_host = array_distinct($http.target.hostname)
    $destination_url = array_distinct($http.target.url)
    $referrer_url = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
