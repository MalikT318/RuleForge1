/*
  MITRE Technique : T1591 - Gather Victim Org Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:25:12.034881+00:00
  Reference       : https://attack.mitre.org/techniques/T1591
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_External_Org_Info_Page_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting web resources that expose organisational structure information, such as org charts, staff or employee directories, department rosters and exported personnel lists. Seen at the network perimeter, this is characteristic of adversary organisation reconnaissance ahead of phishing or social engineering."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591"
    mitre_technique_name = "Gather Victim Org Information"
    log_prerequisites = "Requires IDS/IPS or network security appliance HTTP inspection logs normalised to NETWORK_HTTP, with target.url and principal.ip populated. TLS inspection or a decrypted web-facing sensor is needed to see URLs."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate visitors, job applicants and business partners browsing public staff directory pages; search engine crawlers and SEO tooling; the organisation's own external marketing or brand-monitoring services; authorised external penetration tests."
    tuning_guidance = "Add authorised external scanners and testing sources to %global_allowed_scanners. Add known-good partner or crawler source addresses to %global_allowed_mgmt_sources. If the public website intentionally publishes a staff directory, scope the rule to the other path patterns or raise the threshold by converting it to a Threshold rule grouped by source IP. Results are best triaged by correlating repeated hits from the same source IP."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(org(anization(al)?)?[-_ ]?chart|staff[-_ ]?(directory|list(ing)?)|employee[-_ ]?(directory|list(ing)?|roster|export)|personnel[-_ ]?(list|directory|roster)|(department|division)[-_ ]?(list|roster|directory)|company[-_ ]?directory|who[-_ ]?works[-_ ]?here)([\/._?-]|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1591")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
