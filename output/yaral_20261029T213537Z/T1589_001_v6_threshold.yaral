/*
  MITRE Technique : T1589.001 - Credentials
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:07:57.389113+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_001_External_Credential_Exposure_Probing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source requests many URLs that typically expose credentials or secrets (environment files, repository metadata, cloud credential files, private keys, config backups, password files) against perimeter-facing web services within ten minutes. One such request is background noise, but sustained volume from one source indicates deliberate credential-harvesting reconnaissance. Severity scales in outcome when the service answers with HTTP 200."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.001"
    mitre_technique_name = "Gather Victim Identity Information: Credentials"
    log_prerequisites = "Requires perimeter firewall, proxy or web gateway logs normalised to NETWORK_HTTP with principal.ip, target.url and network.http.response_code populated (TLS inspection or reverse-proxy visibility needed for URL fields)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface management services, internet-wide research scanners and search-engine crawlers that probe common paths, penetration tests, and legitimate monitoring services requesting configuration-style paths."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners. Raise the #http threshold for internet-facing hosts that receive heavy background scanning. Add known-good partner or monitoring sources to %global_allowed_mgmt_sources. Lower the threshold for high-value applications. Review sources whose requests received HTTP 200 first."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.ip = $src_ip
    $http.target.url = /(\/\.env|\/\.git\/(config|head)|\.aws\/credentials|\.htpasswd|\.npmrc|\.pgpass|id_rsa|id_dsa|wp-config|web\.config|credentials\.json|secrets?\.(json|ya?ml)|\.(bak|old|orig|save|swp)$|\/\.ssh\/|\/\.docker\/config)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($http.network.http.response_code = 200, 80, 55))
    $mitre_technique_id = array_distinct("T1589.001")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($http.metadata.id)
    $requested_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    #http >= 10
}
