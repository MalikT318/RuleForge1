/*
  MITRE Technique : T1598 - Phishing for Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:09:51.231587+00:00
  Reference       : https://attack.mitre.org/techniques/T1598
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_Cleartext_Credential_Form_Post_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client submitting an HTTP POST over unencrypted HTTP to an external destination whose URL path looks like a login, password or account-verification form. Phishing-for-information kits commonly serve credential-harvesting pages from throwaway hosts without TLS. This detects the victim-side network result of a successful lure, not any specific kit or domain."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598"
    mitre_technique_name = "Phishing for Information"
    log_prerequisites = "Requires firewall or proxy logs with URL-level visibility normalised to NETWORK_HTTP, with network.http.method, target.url, target.hostname and target.ip populated. Plain HTTP is visible without TLS inspection."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legacy internal-facing or partner portals served over HTTP, IoT or appliance admin consoles reached through NAT, captive portals and guest Wi-Fi logins, and old vendor extranets that still lack HTTPS."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Hostnames are matched exactly, so list each hostname you want to exclude. If client logs carry target.url without a scheme, adjust the leading http:// anchor. Raise severity if the source address belongs to a high-value user group."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^http:\/\/[^\/]+\/.*(login|logon|signin|sign-in|verify|validate|password|passwd|credential|webmail|account|secure|auth)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1598")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $posted_urls = array_distinct($net.target.url)

  condition:
    $net
}
