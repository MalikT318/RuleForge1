/*
  MITRE Technique : T1584.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:19:15.435816+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_001_DNS_Shadowed_Domain_TXT_Then_Resolution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a likely domain-shadowing or hijacked-domain pattern in DNS telemetry. A single client queries a TXT or NULL record on a long, random-looking subdomain of a registered domain, then within 10 minutes resolves another long-label subdomain of the same registered domain through an A or AAAA lookup. This staged pattern (record-based tasking followed by address resolution) is typical of attacker-created subdomains under a compromised or hijacked parent domain."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.001"
    mitre_technique_name = "Compromise Infrastructure: Domains"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name, network.dns.questions.type and principal.ip populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-hosted services using long generated hostnames, email security and anti-spam DNSBL lookups, DKIM or SPF TXT lookups on machine-generated subdomains, software licensing and telemetry services, and DNS-based update checks."
    tuning_guidance = "Add known-good domains (CDNs, security vendors, update services) to %global_allowed_domains. If a recursive resolver or forwarder masks real clients, exclude it by joining on a client field that is not the resolver address. Raise the label length thresholds (currently 20 and 25 characters) for noisy environments."

  events:
    $txt.metadata.event_type = "NETWORK_DNS"
    $txt.network.dns.questions.type = 16 or $txt.network.dns.questions.type = 10
    $txt.network.dns.questions.name = /^[a-z0-9_-]{20,}\./ nocase
    not $txt.network.dns.questions.name in %global_allowed_domains
    $txt.principal.ip = $client
    $domain = re.capture($txt.network.dns.questions.name, "(?i)([a-z0-9-]+\\.[a-z0-9-]+)$")

    $addr.metadata.event_type = "NETWORK_DNS"
    $addr.network.dns.questions.type = 1 or $addr.network.dns.questions.type = 28
    $addr.network.dns.questions.name = /^[a-z0-9_-]{25,}\./ nocase
    not $addr.network.dns.questions.name in %global_allowed_domains
    $addr.principal.ip = $client
    $domain = re.capture($addr.network.dns.questions.name, "(?i)([a-z0-9-]+\\.[a-z0-9-]+)$")

    $txt.metadata.event_timestamp.seconds <= $addr.metadata.event_timestamp.seconds

  match:
    $client, $domain over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1584.001")
    $primary_entity = array_distinct($client)
    $suspect_domain = array_distinct($domain)
    $txt_query_names = array_distinct($txt.network.dns.questions.name)
    $addr_query_names = array_distinct($addr.network.dns.questions.name)
    $txt_query_count = count($txt.metadata.id)
    $addr_query_count = count($addr.metadata.id)

  condition:
    $txt and $addr
}
