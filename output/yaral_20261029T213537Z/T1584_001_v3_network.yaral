/*
  MITRE Technique : T1584.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:18:10.669860+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_001_Shadow_Subdomain_Random_Label_Resolves {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful DNS resolution (NOERROR with at least one answer) for a name containing a very long, machine-generated-looking subdomain label under a two-label parent domain that is not in the known-good list. Domain shadowing and subdomain takeover often create bulk random subdomains under a hijacked, previously trusted parent domain. These subdomains resolve normally, so the parent domain's reputation hides them. Resolutions that point only to internal address space are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.001"
    mitre_technique_name = "Compromise Infrastructure: Domains"
    log_prerequisites = "Requires DNS query/resolver logs normalised to UDM NETWORK_DNS, with the question name, response code and answer data populated. Responses must be logged, not just queries."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud-storage edge hostnames, email DKIM/tracking and marketing link domains, software update and telemetry services, security vendor cloud lookups (hash-based names), content-addressed or per-session SaaS hostnames, and mesh/VPN or dynamic-DNS services that use long identifier labels."
    tuning_guidance = "Add the registered (two-label) parent domains of known-good services to %global_allowed_domains; the rule compares the last two labels of the queried name against that list. For multi-label public suffixes such as co.uk, add the suffix-plus-one form to the list or tighten the regex. Raise or lower the label length (currently 24 characters) per client. Resolutions answered with internal addresses are excluded through %rfc1918_internal. Review the outcome variable $queried_names to see whether many distinct labels share one parent domain; that pattern indicates domain shadowing."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.response_code = 0
    $dns.network.dns.answers.data = /./
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9]{24,}\.[a-z0-9-]+\.[a-z]{2,}$/ nocase
    not re.capture($dns.network.dns.questions.name, "([^.]+\\.[^.]+)$") in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1584.001")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ip = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $resolved_answers = array_distinct($dns.network.dns.answers.data)

  condition:
    $dns
}
