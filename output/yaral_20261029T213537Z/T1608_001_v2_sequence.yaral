/*
  MITRE Technique : T1608.001 - Upload Malware
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:21:01.642817+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_001_Payload_Fetch_Then_NonStd_Port_Same_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An internal host downloads an executable, script, or archive payload over HTTP from an external server, then connects to the same external IP on a non-standard port within 10 minutes. This pattern indicates staged malware hosting (T1608.001), where one adversary-controlled server serves the payload and also accepts follow-on staging or C2 traffic. It is observed from the victim side at the network perimeter and does not depend on process telemetry."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.001"
    mitre_technique_name = "Stage Capabilities: Upload Malware"
    log_prerequisites = "Requires proxy or firewall logs with URL visibility (NETWORK_HTTP with target.url populated) and perimeter connection logs (NETWORK_CONNECTION) with principal.ip, target.ip and target.port populated. Both log types must be normalised to the same source IP representation."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software vendors that distribute installers from the same host that exposes a custom service port; developers and admins downloading tools from self-hosted artifact servers; CI/CD systems pulling packages and then connecting to an application port on the same server; authorised red team or penetration test activity."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add scanner and test sources to %global_allowed_scanners. Extend the excluded port list in the NETWORK_CONNECTION event if the client's baseline includes common alternate web ports. Raise the match window or add a minimum download count in the condition if the rule is noisy."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(exe|dll|msi|scr|hta|ps1|bat|vbs|jar|apk|iso|img|zip|7z|rar|elf|sh)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip
    $http.target.ip = $dest_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 1024
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = $src_ip
    $net.target.ip = $dest_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip, $dest_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608.001")
    $primary_entity = array_distinct($src_ip)
    $staging_server_ip = array_distinct($dest_ip)
    $payload_urls = array_distinct($http.target.url)
    $followon_ports = array_distinct($net.target.port)
    $download_count = count($http.metadata.id)

  condition:
    $http and $net
}
