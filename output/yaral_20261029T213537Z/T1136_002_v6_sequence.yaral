/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:10:31.006992+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_Linux_Domain_Account_Created_Then_Privileged_Group {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a directory (domain) account being created from a Linux host using identity-management or Samba/AD command-line tooling, followed within 10 minutes by the same user on the same host adding a member to a privileged domain group. This sequence indicates persistence through a new, privileged domain account."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry (execve) with full command lines, normalised to UDM PROCESS_LAUNCH with principal.user.userid and principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Identity and directory administrators provisioning accounts and group memberships; onboarding automation (IdM/FreeIPA or Samba AD provisioning scripts, configuration management runs); lab or domain-controller build and migration activity."
    tuning_guidance = "Add provisioning and automation accounts to %global_allowed_service_accounts. Add approved identity-management tooling or its parent processes to %global_allowed_admin_tools. Extend the privileged group name list in the second event to match customer-specific privileged groups."

  events:
    $create.metadata.event_type = "PROCESS_LAUNCH"
    $create.target.process.command_line = /(samba-tool\s+user\s+(create|add)\b|ipa\s+user-add\b|adcli\s+create-user\b|net\s+(rpc|ads)\s+user\s+add\b)/ nocase
    $create.principal.hostname = $hostname
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.process.file.full_path in %global_allowed_admin_tools

    $priv.metadata.event_type = "PROCESS_LAUNCH"
    $priv.target.process.command_line = /(samba-tool\s+group\s+addmembers\s+["']?(domain admins|enterprise admins|schema admins|administrators|account operators)|ipa\s+group-add-member\s+["']?(admins|trust admins)|net\s+(rpc|ads)\s+group\s+addmem\s+["']?(domain admins|enterprise admins|schema admins|administrators))/ nocase
    $priv.principal.hostname = $hostname
    $priv.principal.user.userid = $user
    not $priv.principal.user.userid in %global_allowed_service_accounts
    not $priv.principal.process.file.full_path in %global_allowed_admin_tools

    $create.metadata.event_timestamp.seconds <= $priv.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity = array_distinct($create.principal.hostname)
    $acting_user = array_distinct($create.principal.user.userid)
    $create_commands = array_distinct($create.target.process.command_line)
    $privilege_commands = array_distinct($priv.target.process.command_line)
    $event_count = count($priv.metadata.id)

  condition:
    $create and $priv
}
