/*
  MITRE Technique : T1552.003 - Shell History
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:37:58.492017+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_003_Linux_Service_Parent_Spawns_History_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, or database service process spawning a shell, script interpreter, or text utility that references a shell or database client history file (bash, zsh, mysql, psql and similar). Server-side service processes have no legitimate need to read user command history, so this lineage anomaly suggests post-exploitation credential hunting, for example via a web shell or SQL-injection-to-OS pivot."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.003"
    mitre_technique_name = "Unsecured Credentials: Shell History"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path, child process path, and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hosting control panels or deployment hooks run by the web server that archive home directories; admin troubleshooting scripts launched from application servers; backup or migration jobs launched by a Java or Node service that copy dotfiles; database maintenance scripts invoked by the DB service account."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. To widen coverage, extend the parent regex with the customer's own service daemons. To tighten it, remove the broad java and node parents where those are used as general-purpose job runners."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|php-cgi|lighttpd|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|ash|python[0-9.]*|perl|ruby|php|cat|grep|egrep|awk|sed|head|tail|less|more|strings|cp|tar|base64|find)$/ nocase
    $proc.target.process.command_line = /(\.(bash|zsh|sh|ash|ksh|mysql|psql|python|node_repl|rediscli)_history|fish_history|\bHISTFILE\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
