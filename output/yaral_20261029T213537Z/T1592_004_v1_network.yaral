/*
  MITRE Technique : T1592.004 - Client Configurations
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:40:35.899292+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_004_External_Probe_Client_Config_Files {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external (non-RFC1918) source requesting client-configuration disclosure files, such as proxy auto-config, WPAD, browser configuration and cross-domain policy files, from a perimeter-facing web service. External hosts rarely have a legitimate reason to request these files. They are commonly requested during reconnaissance to learn client proxy settings, browser configuration and the client technology stack ahead of targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.004"
    mitre_technique_name = "Gather Victim Host Information: Client Configurations"
    log_prerequisites = "Requires reverse-proxy, web gateway, WAF or firewall HTTP logs that populate network.http.method and target.url for inbound requests to externally exposed services, normalised to NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legacy browsers or plugins fetching cross-domain policy files from public sites, mobile or roaming clients that legitimately retrieve a published proxy auto-config file, search-engine crawlers, and authorised external vulnerability scans or penetration tests."
    tuning_guidance = "Add authorised external scanner and pen-test source addresses to %global_allowed_scanners. Add trusted management source addresses to %global_allowed_mgmt_sources. If the organisation intentionally publishes a proxy auto-config file to roaming users, allowlist its hostname in %global_allowed_domains. Consider raising severity or converting to a threshold rule when several distinct config paths are requested from one source."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD|POST)$/ nocase
    $http.target.url = /\/(wpad\.dat|proxy\.pac|browserconfig\.xml|crossdomain\.xml|clientaccesspolicy\.xml)(\?.*)?$/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1592.004")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
