/*
  MITRE Technique : T1587.004 - Exploits
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:52:33.025466+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_004_External_Fuzzing_Induced_Server_Errors {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source sending HTTP requests that carry memory-corruption or fuzzing artefacts (NUL bytes, format-string tokens, long repeated-byte runs, NOP-sled bytes) and that drew a server error (5xx) response. T1587.004 exploit development is mostly invisible to a defender. The part a perimeter can see is an adversary testing a developed exploit or fuzzer against an exposed service, so this rule is a proxy for that activity, not direct observation of development. Platform is PRE (external-facing telemetry), which takes precedence over the 'alternate platform' angle."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.004"
    mitre_technique_name = "Develop Capabilities: Exploits"
    log_prerequisites = "Requires perimeter, proxy or WAF HTTP logs normalised to NETWORK_HTTP, with target.url and network.http.response_code populated. Source and destination must be visible before NAT, or reverse-proxy logs must carry the true client address."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners or penetration tests not yet in the scanner list, QA load or fuzz testing of internet-facing apps, applications that legitimately pass binary or encoded data in URLs, buggy clients that trigger server-side errors, and security research crawlers."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners. Add known-good destinations to %global_allowed_domains if the proxy logs outbound traffic. If the deployment is noisy, require response_code >= 500 on repeated hits by promoting this to a Threshold rule grouped by source IP. Tighten or loosen the artefact regex to match local application behaviour."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.response_code >= 500
    $http.target.url = /(?i)(%00|%n%n|(?:%41){64,}|A{256,}|(?:%90){16,}|(?:%ff){16,})/
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1587.004")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)
    $request_count = count($http.metadata.id)

  condition:
    $http
}
