/*
  MITRE Technique : T1588.002 - Tool
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:57:23.237108+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_002_Bulk_Executable_Download_From_Untrusted_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source retrieves several executable, script, or archive-type files over HTTP from external hosts outside the known-good domain list within ten minutes. Each download is routine on its own; the volume of tool-style file retrieval from unvetted destinations is what suggests tool acquisition or staging."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.002"
    mitre_technique_name = "Obtain Capabilities: Tool"
    log_prerequisites = "Requires firewall or proxy logs normalised to NETWORK_HTTP with target.url, target.hostname, target.ip and principal.ip populated. TLS-inspection or URL-logging must be enabled to see request paths."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers and IT staff pulling installers or packages, software update mechanisms, CI/CD build agents fetching dependencies, patch and deployment tooling using non-listed vendor domains, sandbox or malware-analysis hosts."
    tuning_guidance = "Add vendor and update domains to %global_allowed_domains. Raise the #http threshold for developer-heavy or build-agent networks. The extension list can be narrowed if archive downloads are too noisy. Risk scales with volume: 15 or more downloads raises the score."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(exe|dll|msi|ps1|bat|vbs|jar|zip|7z|rar|iso|elf|sh)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $event_count = count($http.metadata.id)
    $risk_score = if($event_count >= 15, 70, 45)
    $mitre_technique_id = array_distinct("T1588.002")
    $primary_entity = array_distinct($src)
    $download_hosts = array_distinct($http.target.hostname)
    $download_urls = array_distinct($http.target.url)

  condition:
    #http >= 5
}
