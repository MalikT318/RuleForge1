/*
  MITRE Technique : T1590 - Gather Victim Network Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:11:47.730291+00:00
  Reference       : https://attack.mitre.org/techniques/T1590
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_External_Source_Network_Info_Service_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-RFC1918) source connecting to services that expose network topology and administrative data: TCP/53 (DNS zone transfer / AXFR attempts), UDP/161 (SNMP community and MIB enumeration) and RPC portmapper on 111. These are classic victim-network information gathering probes seen at the perimeter, observed from IDS/IPS or network security appliance connection telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590"
    mitre_technique_name = "Gather Victim Network Information"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated. Sensor must see perimeter-facing inbound traffic, including allowed and blocked sessions."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate secondary or slave DNS servers performing authorised zone transfers over TCP/53, large resolvers falling back to TCP DNS, external SNMP monitoring providers or MSP NMS platforms, internet-wide research scanners, and third-party attack-surface management services."
    tuning_guidance = "Add approved secondary DNS and external monitoring source addresses to %global_allowed_mgmt_sources, and authorised external assessment sources to %global_allowed_scanners. Remove the TCP/53 clause for customers that do not host authoritative DNS, since TCP/53 is then never legitimate inbound. Raise severity for targets that are known authoritative DNS servers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      ($net.target.port = 53 and $net.network.ip_protocol = "TCP" nocase) or
      ($net.target.port = 161 and $net.network.ip_protocol = "UDP" nocase) or
      ($net.target.port = 111)
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1590")
    $primary_entity = array_distinct($net.principal.ip)
    $probed_targets = array_distinct($net.target.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
