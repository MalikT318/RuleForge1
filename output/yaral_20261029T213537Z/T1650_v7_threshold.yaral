/*
  MITRE Technique : T1650 - Acquire Access
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:37:40.598888+00:00
  Reference       : https://attack.mitre.org/techniques/T1650
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1650_DNS_Long_Label_Query_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Indirect indicator of purchased or brokered access (T1650). A single host issues a high volume of DNS queries with very long, encoded-looking subdomain labels to domains outside the known-good list within ten minutes. This pattern is typical of a broker-planted loader or backdoor beaconing, or of DNS tunnelling. Acquisition itself happens outside the victim's visibility, so this rule detects the resulting C2 behaviour only."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1650"
    mitre_technique_name = "Acquire Access"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS, with principal.hostname populated and network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud hostnames with long generated labels, email security and DKIM/DNSBL lookups, endpoint security cloud-reputation lookups, telemetry and tracking domains, and software update services that use hashed subdomains."
    tuning_guidance = "Add known-good registered domains to %global_allowed_domains. Raise the #dns threshold or label length for noisy environments. If the resolver logs only the client IP, change the grouping field to principal.ip."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)[a-z0-9_\-]{30,}\.[^.]+\.[^.]+$/
    $dns.principal.hostname = $host
    $domain = re.capture($dns.network.dns.questions.name, `([^.]+\.[^.]+)$`)
    not $domain in %global_allowed_domains

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($dns.network.dns.questions.name = /(?i)[a-z0-9_\-]{50,}\.[^.]+\.[^.]+$/, 85, 60))
    $event_count = count($dns.metadata.id)
    $mitre_technique_id = array_distinct("T1650")
    $primary_entity = array_distinct($host)
    $queried_domains = array_distinct($domain)

  condition:
    #dns >= 20
}
