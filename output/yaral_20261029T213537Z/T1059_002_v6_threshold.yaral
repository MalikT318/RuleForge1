/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:37:50.908659+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_AppleScript_Bulk_Script_Drop_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several AppleScript files (.scpt, .scptd, .applescript) are written to temporary or user-writable staging locations on one macOS host within ten minutes. A single script drop is benign. Repeated drops indicate a loader, malicious installer or persistence routine staging AppleScript payloads for execution through osascript, Mail rules, Calendar alarms or Automator. The rule uses file-creation telemetry, so it complements command-line detections and also covers scripts run through NSAppleScript or OSAScript."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "macOS endpoint telemetry that reports file creation events with the creating process and user populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Software installers and updaters that unpack AppleScript helpers into cache or temp folders, Script Editor or Automator users saving work in Downloads, MDM or Jamf-style deployment scripts, developers building AppleScript-based apps."
    tuning_guidance = "Add approved deployment or scripting tools to %global_allowed_admin_tools or %global_allowed_script_hosts, automation accounts to %global_allowed_service_accounts, and EDR or AV agents to %global_allowed_security_tools. Raise the #file threshold on developer or scripting-heavy hosts. Lower it on kiosk or locked-down fleets."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(scpt|scptd|applescript)$/ nocase
    $file.target.file.full_path = /^\/(private\/)?(tmp|var\/tmp|var\/folders)\/|^\/Users\/[^\/]+\/(Downloads|Public|Library\/(Caches|Application Support|Containers))\// nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(Script Editor|Automator)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($host)
    $script_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
