/*
  MITRE Technique : T1559.003 - XPC Services
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:44:02.675030+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_003_XPC_Helper_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a macOS privileged helper tool, or an XPC service bundle binary running from a user-writable location, making an outbound connection to a non-internal address. XPC is local IPC, so the network-side signal of abuse is a root-privileged helper or an unexpected XPC service reaching out to external infrastructure after being fed malicious content. This could be retrieving a payload, staging, or establishing C2."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.003"
    mitre_technique_name = "Inter-Process Communication: XPC Services"
    log_prerequisites = "Requires macOS endpoint telemetry that populates NETWORK_CONNECTION events with the originating process path (principal.process.file.full_path) and the destination IP."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party applications whose privileged helper tools legitimately call home (VPN clients, disk utilities, update agents, virtualization software, printer or driver helpers). Per-user installed apps that bundle XPC services under /Users. Developer builds of XPC services during testing."
    tuning_guidance = "Add approved helper binary paths to %global_allowed_admin_tools, EDR/AV helpers to %global_allowed_security_tools, and approved support tooling to %global_allowed_remote_mgmt. Add known vendor update domains to %global_allowed_domains. Review %rfc1918_internal for the client's internal address space coverage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/Library\/PrivilegedHelperTools\/|^\/(Users|private\/tmp|tmp|private\/var\/tmp)\/.*\.xpc\/Contents\/MacOS\// nocase
    $net.target.ip != ""
    not $net.principal.process.file.full_path = /^\/System\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1559.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $helper_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
