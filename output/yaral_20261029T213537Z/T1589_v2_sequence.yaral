/*
  MITRE Technique : T1589 - Gather Victim Identity Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:04:50.637423+00:00
  Reference       : https://attack.mitre.org/techniques/T1589
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_External_Identity_Enumeration_Then_Auth_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single external source that first sends repeated requests to identity-lookup endpoints (username or realm discovery, password-reset or recovery checks), then sends repeated failed login attempts to the same host within 10 minutes. This pattern indicates username enumeration followed by credential probing."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589"
    mitre_technique_name = "Gather Victim Identity Information"
    log_prerequisites = "Requires perimeter proxy, WAF or firewall web-inspection logs normalised to NETWORK_HTTP with populated principal.ip, target.hostname, target.url, network.http.method and network.http.response_code."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate users repeatedly hitting password-reset pages after forgetting credentials, mobile or SSO clients behind shared NAT or carrier-grade NAT addresses, uptime and synthetic monitoring of login flows, authorised penetration tests and vulnerability scanners not yet allowlisted."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add trusted partner or management source addresses to %global_allowed_mgmt_sources. Raise or lower the #enum and #auth thresholds in the condition according to the baseline traffic of the exposed identity portal. For environments with large shared NAT egress, raise the thresholds."

  events:
    $enum.metadata.event_type = "NETWORK_HTTP"
    $enum.target.url = /(getuserrealm|userrealm|getcredentialtype|forgot|passwordreset|password\/reset|sspr|account\/recover|recover(y)?\/(user|account)|usernameexists|checkuser|users?\/(exists|lookup|search)|validate[_-]?(user|email))/ nocase
    not $enum.principal.ip in %rfc1918_internal
    not $enum.principal.ip in %global_allowed_scanners
    not $enum.principal.ip in %global_allowed_mgmt_sources
    $enum.principal.ip = $src_ip
    $enum.target.hostname = $target_host

    $auth.metadata.event_type = "NETWORK_HTTP"
    $auth.network.http.method = "POST"
    $auth.target.url = /(login|signin|logon|oauth2?\/token|\/auth|authenticate)/ nocase
    ($auth.network.http.response_code = 401 or $auth.network.http.response_code = 403)
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_scanners
    not $auth.principal.ip in %global_allowed_mgmt_sources
    $auth.principal.ip = $src_ip
    $auth.target.hostname = $target_host

    $enum.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $src_ip, $target_host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1589")
    $primary_entity = array_distinct($src_ip)
    $targeted_host = array_distinct($target_host)
    $enum_request_count = count($enum.metadata.id)
    $failed_auth_count = count($auth.metadata.id)
    $enum_urls = array_distinct($enum.target.url)

  condition:
    $enum and $auth and #enum >= 3 and #auth >= 3
}
