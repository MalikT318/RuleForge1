/*
  MITRE Technique : T1583.004 - Server
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:04:38.957141+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_004_Direct_To_IP_Server_Nonstandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects internal clients making HTTP requests to a bare external IP address (no domain name) on a non-standard high port. This is typical of adversary-operated servers that were stood up without DNS and are used for payload staging, phishing kits, or C2. Detection is based on the network-observable behaviour of connecting to the server, not on any specific indicator."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.004"
    mitre_technique_name = "Acquire Infrastructure: Server"
    log_prerequisites = "Requires firewall or proxy logs that populate NETWORK_HTTP events with target.url, target.ip and target.port (URL-aware inspection or explicit proxy)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal-facing appliances or IoT management interfaces reached by IP, software update or telemetry services that use raw IPs, developer and test tooling hitting cloud VMs by IP, and authorised penetration tests or scanners."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Verify that %rfc1918_internal covers the tenant's internal address space. Raise or lower the port threshold per client. For approved sources, add them to %global_allowed_scanners or %global_allowed_mgmt_sources and extend the events block with the matching exclusion on a string field the client's firewall populates."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(?i)^(https?:\/\/)?[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]{2,5})?(\/|$)/
    $net.target.port > 1024
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1583.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
