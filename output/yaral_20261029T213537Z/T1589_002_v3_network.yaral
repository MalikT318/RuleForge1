/*
  MITRE Technique : T1589.002 - Email Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:08:56.272188+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_002_External_Autodiscover_Email_Probe_Failed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source sending an HTTP request to a mail autodiscover endpoint with an email address embedded in the URL, where the server answered with a client-error code (400, 403 or 404). This is the pattern of email address and username enumeration against public-facing mail infrastructure, where probing for valid mailboxes yields 'not found' style responses."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.002"
    mitre_technique_name = "Gather Victim Identity Information: Email Addresses"
    log_prerequisites = "Requires perimeter proxy, reverse proxy, WAF or firewall HTTP logging with URL (including query string) and response code populated in UDM NETWORK_HTTP events, with TLS inspection or termination in front of the mail endpoint."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Misconfigured or stale mail clients and mobile devices retrying autodiscover for decommissioned or mistyped mailboxes; authorised external penetration tests and attack-surface scanners; mail migration tooling during cutovers."
    tuning_guidance = "Add authorised scanner or pentest source addresses to %global_allowed_scanners. Add trusted partner or management source addresses to %global_allowed_mgmt_sources. If a client generates noisy stale-device traffic, exclude the source through the same lists. Consider a companion threshold variant to alert on volume per source address."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /autodiscover.*(@|%40)[a-z0-9\-\.]+\.[a-z]{2,}/ nocase
    ($http.network.http.response_code = 400 or $http.network.http.response_code = 403 or $http.network.http.response_code = 404)
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1589.002")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $probed_urls = array_distinct($http.target.url)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
