/*
  MITRE Technique : T1548.006 - TCC Manipulation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:35:56.386103+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_006_TCC_Database_Modified_By_Untrusted_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the macOS TCC database (system-level or per-user TCC.db, including its SQLite journal/WAL files) by any process other than the TCC daemon, MDM agent or approved tooling. Direct writes to TCC.db are how adversaries silently grant themselves Full Disk Access, Screen Recording, Accessibility or other protected permissions without a user prompt. Detection is file-write based, so it complements process command-line rules and still fires if the writer is renamed or an in-memory SQLite library is used."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.006"
    mitre_technique_name = "Abuse Elevation Control Mechanism: TCC Manipulation"
    log_prerequisites = "macOS endpoint telemetry that reports file modification events with the writing process path (EDR file events or Endpoint Security framework NOTIFY_WRITE/CLOSE_MODIFIED). Full Disk Access must be granted to the sensor so it can observe TCC-protected paths."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM agents pushing PPPC profiles, IT enrolment or provisioning scripts, security agents resetting or inspecting permissions, macOS upgrades or migration assistants, and administrators running tccutil reset during troubleshooting."
    tuning_guidance = "Add approved MDM, deployment and enrolment binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Add approved remote-management agents to %global_allowed_remote_mgmt if they write TCC.db during enrolment. Review the process path in the alert; writes from user-writable locations (/tmp, /Users/*, /private/var/folders) or interpreters are high confidence."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/Library\/Application Support\/com\.apple\.TCC\/TCC\.db(-journal|-wal|-shm)?$/ nocase
    not $file.principal.process.file.full_path = /\/(tccd|tccutil|mdmclient|mdmd|system settings|system preferences|softwareupdated|installd|migrationhelper)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)
    $tcc_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
