/*
  MITRE Technique : T1592 - Gather Victim Host Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:35:09.425989+00:00
  Reference       : https://attack.mitre.org/techniques/T1592
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_Perimeter_Host_Recon_Connection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens a high volume of connections to common host-fingerprinting and service-banner ports (remote access, file sharing, SNMP, management and web ports) within 10 minutes. Each connection is benign on its own. The volume indicates active host information gathering ahead of targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592"
    mitre_technique_name = "Gather Victim Host Information"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated, including inbound connections from the internet."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet-wide research scanners, external vulnerability assessments or penetration tests not yet allowlisted, uptime and availability monitors, partner or CDN health checks, and legitimate remote users retrying VPN or RDP connections."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners. Adjust the #net threshold per client based on internet-facing exposure and baseline noise, and review the distinct-port and distinct-target outcome values to separate wide scans from single-service retries."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 25 or
      $net.target.port = 53 or
      $net.target.port = 80 or
      $net.target.port = 110 or
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 143 or
      $net.target.port = 161 or
      $net.target.port = 389 or
      $net.target.port = 443 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5985 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1592")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $distinct_ports = array_distinct($net.target.port)
    $target_ips = array_distinct($net.target.ip)

  condition:
    #net >= 30
}
