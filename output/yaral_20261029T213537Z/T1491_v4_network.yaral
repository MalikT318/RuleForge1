/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:18:33.896434+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_ESXi_Outbound_Fetch_Of_Defacement_Content {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host using a command-line HTTP client (wget, curl or similar) to fetch image, HTML or text content from an external destination. On a hypervisor this pattern is characteristic of staging defacement material, such as ransom wallpapers, replacement login banners, or welcome-page and message-of-the-day content, before the host's visual content is overwritten. ESXi hosts rarely retrieve this content type from the internet."
    mitre_tactic = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "Requires ESXi outbound HTTP telemetry normalised to NETWORK_HTTP with principal.hostname, target.url, target.ip, target.hostname and network.http.user_agent populated (for example from a network sensor or proxy that sees management-network egress, correlated to the ESXi host). Host-side syslog alone usually does not produce this event type."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators downloading branding or banner assets, scripted retrieval of patch or driver metadata and HTML manifests from vendor sites, custom host-profile or automation scripts using wget/curl, and vendor support bundles pulling documentation text."
    tuning_guidance = "Add approved vendor and update domains to %global_allowed_domains, approved automation binaries to %global_allowed_admin_tools, and authorised management sources to %global_allowed_mgmt_sources. Extend or narrow the file-extension regex per client. If the user-agent field is unpopulated for a client, remove the user-agent condition and rely on the extension and destination filters."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.user_agent = /(wget|curl|python|fetch|busybox)/ nocase
    $net.target.url = /\.(jpe?g|png|gif|bmp|svg|ico|html?|txt)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct($net.principal.hostname)
    $fetched_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
