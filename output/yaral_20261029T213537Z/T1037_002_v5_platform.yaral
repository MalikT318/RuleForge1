/*
  MITRE Technique : T1037.002 - Login Hook
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:55:04.109839+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_002_macOS_Login_Logout_Hook_Plist_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS command-line utility (defaults, PlistBuddy or plutil) writing a LoginHook or LogoutHook value into the com.apple.loginwindow preferences. This registers a script that runs as root at the next user login or logout, giving persistence and privilege escalation. Matching on the utility, the loginwindow domain and the hook key together means renamed scripts or payloads do not evade the rule."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.002"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Login Hook"
    log_prerequisites = "Requires macOS endpoint process-launch telemetry that includes full command-line arguments and the parent process path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or configuration-management agents that still deploy legacy login/logout hooks, IT imaging and provisioning scripts, and administrators maintaining older lab or kiosk Macs. Login hooks have been deprecated since OS X 10.11, so legitimate use is rare in modern fleets."
    tuning_guidance = "Add approved MDM, imaging and deployment parent process paths to %global_allowed_admin_tools. If a client legitimately uses login hooks, review and document the hook script path before excluding the parent process. The command-line verb filter (write, add, set, merge, import, -insert, -replace) can be extended if other plist editors are in use."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(defaults|PlistBuddy|plutil)$/ nocase
    $proc.target.process.command_line = /com\.apple\.loginwindow/ nocase
    $proc.target.process.command_line = /(Login|Logout)Hook/ nocase
    $proc.target.process.command_line = /(\b(write|add|set|merge|import)\b|-insert|-replace)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $hook_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
