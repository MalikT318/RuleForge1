/*
  MITRE Technique : T1583.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:01:39.210015+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_002_DNS_Long_Label_TXT_NULL_Queries {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for TXT or NULL records whose name contains an unusually long, encoded-looking label. This pattern is typical of DNS tunnelling and C2 against attacker-operated authoritative DNS servers, where data is carried in the subdomain and returned in TXT/NULL answers."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.002"
    mitre_technique_name = "Acquire Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam DNS blocklist lookups, DKIM/SPF/DMARC TXT lookups with long selectors, CDN and cloud vendor hashed hostnames, endpoint security cloud-lookup services, and software licensing or telemetry services that encode identifiers in subdomains."
    tuning_guidance = "Add the registered domain (for example example.com) of known-good services to %global_allowed_domains. The exclusion is applied to the last two labels of the queried name. Raise or lower the label length quantifier {40,} to match the environment. Consider a companion Threshold rule on query volume per source if noise is low."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    (
      $dns.network.dns.questions.type = 16 or
      $dns.network.dns.questions.type = 10
    )
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{40,}\.[^.]+\.[^.]+$/ nocase
    not $dns.network.dns.questions.name = /\.(arpa|local|internal|lan)$/ nocase
    $reg_domain = re.capture($dns.network.dns.questions.name, `([^.]+\.[^.]+)$`)
    not $reg_domain in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.002")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $query_types = array_distinct($dns.network.dns.questions.type)
    $registered_domains = array_distinct($reg_domain)

  condition:
    $dns
}
