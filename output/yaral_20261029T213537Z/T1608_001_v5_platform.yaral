/*
  MITRE Technique : T1608.001 - Upload Malware
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:21:53.568723+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_001_Payload_Download_From_Bare_IP_Staging_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal client fetching an executable, script, installer or archive over HTTP(S) from an external host addressed by a bare IP literal instead of a domain name. Adversary-staged payload servers (T1608.001) are commonly stood up this way, and legitimate software distribution almost never is. Based purely on perimeter proxy/firewall HTTP telemetry, so no endpoint process fields are used. The platform is PRE because the evidence is external-facing network telemetry."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.001"
    mitre_technique_name = "Stage Capabilities: Upload Malware"
    log_prerequisites = "Requires perimeter proxy or firewall logs with HTTP inspection that populate metadata.event_type NETWORK_HTTP, target.url, target.ip and principal.hostname. TLS-encrypted traffic needs SSL inspection to expose the URL path."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal software mirrors or appliances reached by IP, vendor update and OEM driver servers addressed by IP, CI/CD or build agents pulling artifacts from external IP-hosted repositories, and authorised red-team or penetration-test staging."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains, expected admin or deployment users to %global_allowed_admin_users, and authorised scanner or test sources to %global_allowed_scanners. If proxy logs populate network.http.response_code, require a 2xx response to confirm delivery and cut noise from blocked requests. Extend or trim the file-extension list to suit client software norms."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /^https?:\/\/(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?\/[^?#]*\.(exe|dll|msi|ps1|vbs|hta|scr|js|sh|bin|elf|apk|jar|iso|zip|7z|rar)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $staging_urls = array_distinct($net.target.url)
    $staging_ips = array_distinct($net.target.ip)
    $requesting_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
