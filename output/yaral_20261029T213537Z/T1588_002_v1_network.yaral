/*
  MITRE Technique : T1588.002 - Tool
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:55:54.738323+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_002_Scripted_Tool_Download_Via_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client using a command-line or scripting HTTP client (PowerShell, curl, wget, Python, Go, BITS, certutil) to download an executable, library, script, installer or archive from an external destination. This is the network-observable result of adversary tool acquisition (T1588.002) and does not depend on endpoint process telemetry. Matching is on the client behaviour and payload type, not on any named tool, domain or IP."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.002"
    mitre_technique_name = "Obtain Capabilities: Tool"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL inspection (SSL inspection recommended) that populate network.http.method, network.http.user_agent and target.url."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Patch and package managers (apt, yum, pip, chocolatey), CI/CD runners and build servers fetching dependencies, admins and developers pulling legitimate installers with curl or wget, RMM or software deployment agents, monitoring agents self-updating."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add build servers, jump hosts and patching hosts to %global_allowed_script_hosts. Raise severity for client IPs in user or workstation subnets, and lower it for server subnets with known automation. Consider requiring an HTTP 200 response code if the log source populates it reliably."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.user_agent = /(powershell|curl\/|wget\/|python-requests|python-urllib|go-http-client|certutil|microsoft bits|winhttp|libwww-perl|aiohttp)/ nocase
    $http.target.url = /\.(exe|dll|msi|ps1|bat|vbs|hta|jar|elf|sh|iso|zip|7z|rar|gz)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1588.002")
    $primary_entity = array_distinct($http.principal.ip)
    $source_hostnames = array_distinct($http.principal.hostname)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $downloaded_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
