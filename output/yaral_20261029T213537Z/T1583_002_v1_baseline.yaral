/*
  MITRE Technique : T1583.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:00:27.139901+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_002_DNS_C2_Long_Label_TXT_NULL_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for TXT or NULL records whose name contains an unusually long, encoded-looking label. This is the typical signature of DNS tunnelling or C2 against an adversary-operated authoritative DNS server, where data is carried in the subdomain and the answer is returned in a TXT or NULL record."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.002"
    mitre_technique_name = "Acquire Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated. Record type is matched numerically (TXT=16, NULL=10)."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security mechanisms (DKIM, SPF, DMARC lookups with long selectors), DNS-based blocklist and reputation lookups, CDN or cloud service hostnames with long generated labels, antivirus or telemetry agents that use DNS TXT lookups, and software licensing checks."
    tuning_guidance = "Add known-good domains to %global_allowed_domains. Entries are compared against the full queried name, so include the exact FQDNs that recur in your environment. Raise the label-length threshold (currently 40 characters) in noisy environments. Combine with a volume threshold variant to raise fidelity."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_\-]{40,}\.[^.]+\.[^.]+$/ nocase
    not $dns.network.dns.questions.name = /\.(arpa|local)$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
