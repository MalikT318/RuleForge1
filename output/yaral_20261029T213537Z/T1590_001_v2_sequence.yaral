/*
  MITRE Technique : T1590.001 - Domain Properties
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:13:47.669510+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_001_External_Domain_Recon_Web_Then_DNS_TCP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an external source that queries domain-discovery web endpoints (tenant realm lookups, autodiscover, WHOIS-style lookups) and then opens a TCP/53 connection (zone transfer or name-server enumeration) within ten minutes. The sequence indicates targeted collection of the victim's domain properties."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.001"
    mitre_technique_name = "Gather Victim Network Information: Domain Properties"
    log_prerequisites = "Requires IDS/IPS or network security appliance telemetry that normalises HTTP requests (target.url) to NETWORK_HTTP and TCP connections to NETWORK_CONNECTION, with the external source in principal.ip."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate mail clients and mobile devices using autodiscover; secondary DNS servers and registrars performing authorised zone transfers; external monitoring and uptime services; authorised security assessments."
    tuning_guidance = "Add authorised scanners and testing sources to %global_allowed_scanners. Exclude approved secondary DNS and partner source addresses by listing them in %global_allowed_mgmt_sources. If autodiscover noise is high, narrow the URL regex or raise the match threshold."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(autodiscover|getuserrealm|openid-configuration|\.well-known\/(host-meta|openid|security\.txt)|whois|dns-query)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip

    $flow.metadata.event_type = "NETWORK_CONNECTION"
    $flow.target.port = 53
    $flow.network.ip_protocol = "TCP"
    not $flow.principal.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    not $flow.principal.ip in %global_allowed_mgmt_sources
    $flow.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1590.001")
    $primary_entity = array_distinct($src_ip)
    $http_request_count = count($http.metadata.id)
    $requested_urls = array_distinct($http.target.url)
    $dns_targets = array_distinct($flow.target.ip)

  condition:
    $http and $flow
}
