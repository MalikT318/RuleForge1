/*
  MITRE Technique : T1584 - Compromise Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:16:27.382951+00:00
  Reference       : https://attack.mitre.org/techniques/T1584
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_DNS_Long_Label_TXT_NULL_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS TXT or NULL record queries whose name contains an unusually long, machine-generated-looking subdomain label. This pattern is typical of DNS tunnelling, C2 or staging over compromised third-party DNS or web infrastructure. Internal clients resolving such names suggest a tunnelling or C2 channel through attacker-controlled or hijacked domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584"
    mitre_technique_name = "Compromise Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS, with the queried name (network.dns.questions.name) and record type (network.dns.questions.type) populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam DNSBL lookups, DKIM/SPF/DMARC TXT lookups with long selectors, CDN and cloud services using long hashed hostnames, software licensing and telemetry services using encoded subdomains, and endpoint security cloud-lookup services."
    tuning_guidance = "Add known-good apex domains (CDNs, vendors, security cloud lookups) to %global_allowed_domains; entries should be the registered domain such as example.com. Raise the label length threshold (currently 45) for noisy environments, or lower it to 35 for higher sensitivity. Pair with volume-based threshold variants for tunnelling confirmation."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{45,}\.[^.]+\.[^.]+$/ nocase
    not $dns.network.dns.questions.name = /\.arpa$/ nocase
    $apex = re.capture($dns.network.dns.questions.name, `([^.]+\.[^.]+)$`)
    not $apex in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ip = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $apex_domains = array_distinct($apex)

  condition:
    $dns
}
