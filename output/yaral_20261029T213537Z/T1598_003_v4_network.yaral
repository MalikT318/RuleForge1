/*
  MITRE Technique : T1598.003 - Spearphishing Link
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:15:53.002283+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_003_Obfuscated_Phishing_Link_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound web requests whose URL uses spearphishing-link obfuscation. The two patterns are a userinfo prefix that makes the URL look like a trusted domain (trusted.example@real-host) and an integer, hexadecimal or octal encoded hostname. Both are used to hide the true destination of a credential-harvesting link. The rule fires at the perimeter after a user clicks the link."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.003"
    mitre_technique_name = "Phishing for Information: Spearphishing Link"
    log_prerequisites = "Requires perimeter or proxy HTTP logs normalised to NETWORK_HTTP with target.url populated. The proxy must log the full URL, including the userinfo portion. With TLS interception disabled, only the CONNECT host may be visible and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legacy applications or scripts that embed credentials in URLs (user@host basic-auth style). Internal tools and monitoring probes that browse to IP-literal hosts in integer form. Security awareness phishing simulations. Link-scanning services that detonate URLs."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Exclude sanctioned scanner sources by adding them to %global_allowed_scanners. Confirm that the proxy logs the full URL. If userinfo URLs from legacy apps are noisy, exclude those destination hostnames via %global_allowed_domains."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    (
      $net.target.url = /^https?:\/\/[^\/?#@]*\.[a-z]{2,}[^\/?#@]*@[^\/?#]+/ nocase or
      $net.target.url = /^https?:\/\/(0x[0-9a-f]+|[0-9]{8,10}|0[0-7]{3,}(\.[0-7]+){0,3})(:[0-9]+)?([\/?#]|$)/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598.003")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
