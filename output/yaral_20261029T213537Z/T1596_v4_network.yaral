/*
  MITRE Technique : T1596 - Search Open Technical Databases
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:57:48.919557+00:00
  Reference       : https://attack.mitre.org/techniques/T1596
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_Outbound_WHOIS_Query_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a connection to an external host on the WHOIS protocol port (TCP/43), as seen by a network security appliance. WHOIS is a core open technical database lookup for domain and IP registration data. Legitimate WHOIS traffic is rare from most client networks, so a lookup from an internal host can indicate reconnaissance by an insider or by a compromised system. It can also flag an unsanctioned research tool. Searches an adversary runs from their own infrastructure are not visible to the victim network; this rule covers only lookups that cross the monitored perimeter."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596"
    mitre_technique_name = "Search Open Technical Databases"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection or flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, with perimeter visibility of outbound traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security and threat-intel teams doing authorised domain or IP research, brand-protection and domain-registrar tooling, mail gateways or anti-spam systems that perform WHOIS lookups, network engineers troubleshooting, and approved vulnerability or attack-surface scanners."
    tuning_guidance = "Add source IPs of approved research hosts and scanners to %global_allowed_scanners. Add authorised management source addresses to %global_allowed_mgmt_sources. If a mail gateway or similar system produces recurring hits, exclude its address in the same way. Consider raising severity if the source host is a server or has no history of WHOIS traffic. To detect volume-based lookups, convert to a Threshold rule grouped by source IP."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 43
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
