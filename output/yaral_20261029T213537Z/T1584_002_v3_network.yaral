/*
  MITRE Technique : T1584.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:20:25.758923+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_002_DNS_Tunnel_Query_To_External_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a DNS TXT or NULL query with an abnormally long subdomain label sent directly to an external (non-internal) resolver. This pattern is characteristic of DNS tunnelling or C2 through attacker-controlled or compromised third-party DNS servers, and it bypasses the internal resolver."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.002"
    mitre_technique_name = "Compromise Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query logs from network sensors, firewalls, or resolvers, normalised to NETWORK_DNS with network.dns.questions populated and target.ip set to the resolver queried."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam services using TXT lookups (SPF/DKIM/DMARC/DNSBL), CDN or vendor telemetry using long encoded labels, software licensing and endpoint-security cloud lookups, and DNS-based reputation services."
    tuning_guidance = "Add known-good registered domains (for example, DNSBL and security vendor domains) to %global_allowed_domains. The rule compares the last two labels of the queried name, so list entries should be in the form example.com. Add approved internal or partner resolver addresses to %rfc1918_internal if they are not already covered. Raise or lower the label length threshold {40,} per environment."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    (
      $dns.network.dns.questions.type = 16 or
      $dns.network.dns.questions.type = 10
    )
    $dns.network.dns.questions.name = /(^|\.)[^.]{40,}\./ nocase
    $dns.target.ip != ""
    not $dns.target.ip in %rfc1918_internal
    $reg_domain = re.capture($dns.network.dns.questions.name, "([^.]+\\.[^.]+)$")
    not $reg_domain in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $resolver_ips = array_distinct($dns.target.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
