/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:37:15.637581+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_AppleScript_Host_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS AppleScript execution host (osascript, Script Editor, or Automator stub) making an outbound network connection to a non-internal address. Legitimate AppleScript rarely talks to the internet directly. Direct external connections indicate a script fetching payloads (for example via 'do shell script' curl), staging data, or beaconing to C2. This is network-side coverage that complements process command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "macOS endpoint telemetry that records NETWORK_CONNECTION events with the originating process path (EDR network events or equivalent unified log collection)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "IT automation or MDM-driven AppleScripts that call vendor or update services, admin scripts that check public IP or connectivity, Automator workflows that upload to cloud services, and Script Editor used by developers to test web-service calls."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains, automation accounts to %global_allowed_service_accounts, and approved management hosts to %global_allowed_mgmt_sources. Review the user and destination fields in the outcome before escalating."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(osascript|Script Editor|Automator Application Stub)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
