/*
  MITRE Technique : T1592.002 - Software
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:38:23.681029+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_002_External_Software_Version_Disclosure_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source successfully (HTTP 200) requesting well-known software and version disclosure endpoints on an internet-facing web service, such as server status pages, PHP info pages, framework management/info endpoints, and version or readme files. This reconnaissance gathers victim software types and versions for later targeting. This is the network-observable result of banner and version collection, not endpoint command-line activity."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.002"
    mitre_technique_name = "Gather Victim Host Information: Software"
    log_prerequisites = "Requires perimeter proxy, WAF or firewall logs with HTTP inspection that populate network.http.response_code, target.url and an external principal.ip. Plain L4 firewall logs without URL visibility will not trigger this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners or attack-surface monitoring services not yet in the allowlist; uptime or health-check monitors that poll /version or info endpoints; search engine crawlers fetching readme or version files; legitimate API clients that read a public version endpoint; CDN or partner integrations checking application version."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners. Add known-good source hostnames or domains to %global_allowed_domains if the log source resolves them. If the log source does not populate network.http.response_code, remove the response code condition and raise the alerting threshold downstream. Narrow the URL regex if an application intentionally exposes a public version endpoint."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(server-status|server-info|phpinfo(\.php)?|info\.php|actuator\/(info|env|beans|configprops)|solr\/admin\/info\/system|_cluster\/health|_nodes|jmx-console|readme\.(html|txt|md)|changelog(\.txt|\.md)?|release-notes(\.txt)?|license\.txt|version(\.txt|\.json|\.html)?|wp-includes\/version\.php)(\?|$)/ nocase
    $http.network.http.response_code = 200
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1592.002")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
