/*
  MITRE Technique : T1592.002 - Software
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:38:06.045292+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_002_External_Software_Version_Disclosure_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-RFC1918) client requesting well-known software and version disclosure endpoints on an internal web service, such as server status pages, framework info endpoints, version files and readme or changelog files. This is characteristic of pre-compromise reconnaissance that fingerprints installed server software and versions to select exploits."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.002"
    mitre_technique_name = "Gather Victim Host Information: Software"
    log_prerequisites = "Requires proxy, WAF or perimeter firewall logs with HTTP inspection that populate target.url and principal.ip (NETWORK_HTTP). The reference list %rfc1918_internal must be populated for the tenant."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internet-wide research scanners and search-engine crawlers, external uptime or availability monitors, authorised third-party penetration tests and vulnerability assessments, partner or CI integrations that read a public /version endpoint, and legitimate users opening a public readme or changelog."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Review the $response_codes outcome: 2xx responses mean the endpoint disclosed information and should be prioritised, and the exposed endpoint should be restricted. If a public version or readme endpoint is intentional, narrow the URL regex. Raise severity for repeated hits from one source by adding a companion threshold rule."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(server-status|server-info|phpinfo\.php|info\.php|actuator\/(info|env|health)|wp-includes\/version\.php|(readme|license|changelog|release-notes)\.(txt|html|md)|version(\.txt|\.json|\.xml)?)(\?.*)?$/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1592.002")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $response_codes = array_distinct($http.network.http.response_code)
    $user_agents = array_distinct($http.network.http.user_agent)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
