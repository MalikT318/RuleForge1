/*
  MITRE Technique : T1595.002 - Vulnerability Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:54:24.009822+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_002_External_Sensitive_Path_Probing_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting well-known exposure-probe paths on web services (environment and config files, VCS metadata, admin consoles, framework debug endpoints, credential and password files). These requests are typical of automated vulnerability scanning and do not occur in normal browsing. The rule observes the network side only, using proxy/firewall HTTP telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.002"
    mitre_technique_name = "Active Scanning: Vulnerability Scanning"
    log_prerequisites = "Requires firewall, WAF, reverse proxy or perimeter telemetry that is normalised to NETWORK_HTTP with target.url and principal.ip populated (URL-aware inspection must be enabled)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, bug bounty researchers, penetration tests, uptime or compliance checkers, and legitimate admin access to a publicly exposed management console."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add known management or admin source addresses to %global_allowed_scanners as well. If a client intentionally exposes an admin console, narrow the path regex for that client. Raise severity for targets that return successful responses; response codes are captured in the outcome."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(\.env|\.git\/(config|HEAD)|\.svn\/entries|\.htpasswd|\.aws\/credentials|\.DS_Store|phpmyadmin|server-status|actuator\/(env|heapdump|configprops)|wp-config\.php(\.bak|\.old|~)?|WEB-INF\/web\.xml|etc\/passwd|cgi-bin\/\.\.)/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1595.002")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
