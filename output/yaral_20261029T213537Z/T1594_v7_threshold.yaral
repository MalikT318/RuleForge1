/*
  MITRE Technique : T1594 - Search Victim-Owned Websites
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:49:51.062650+00:00
  Reference       : https://attack.mitre.org/techniques/T1594
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1594_Web_Content_Enumeration_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source generates a high volume of HTTP GET/HEAD requests that return client-error responses (403/404 and similar) against victim-owned web servers within 10 minutes. This pattern is typical of directory and file wordlist scanning used to find hidden or sensitive content. Any single request is benign, but the volume of failed lookups from one source is not."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1594"
    mitre_technique_name = "Search Victim-Owned Websites"
    log_prerequisites = "Requires IDS/IPS or network security appliance HTTP inspection logs, normalised to UDM NETWORK_HTTP with principal.ip, target.url, network.http.method and network.http.response_code populated. Sensors must see traffic to externally exposed web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and availability monitors, broken-link checkers, external vulnerability scanners not yet allowlisted, misconfigured clients or CDNs repeatedly requesting removed content, and users behind a large shared NAT address."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Raise the #http threshold (default 40) for very high-traffic public sites, or lower it for low-traffic sites. Extend the response_code range if the appliance maps denied requests differently. Review the $distinct_urls and $event_count outcomes to separate crawlers from wordlist scans."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD)$/ nocase
    $http.network.http.response_code >= 400
    $http.network.http.response_code <= 499
    $http.target.url != ""
    $http.principal.ip = $src_ip
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1594")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($http.metadata.id)
    $distinct_urls = count_distinct($http.target.url)
    $targeted_hosts = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    #http >= 40
}
