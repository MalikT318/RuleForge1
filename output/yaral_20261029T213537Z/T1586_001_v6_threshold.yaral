/*
  MITRE Technique : T1586.001 - Social Media Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:42:49.548592+00:00
  Reference       : https://attack.mitre.org/techniques/T1586/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_001_Login_Endpoint_Credential_Stuffing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source sends a high volume of HTTP POST requests to authentication endpoints within ten minutes. This is the network-visible signature of credential stuffing or brute forcing, which adversaries use to take over existing accounts (including corporate social media and brand persona logins and the SSO portals that front them) as described in T1586.001. Each login POST is benign on its own; the volume from one source is not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586.001"
    mitre_technique_name = "Compromise Accounts: Social Media Accounts"
    log_prerequisites = "Requires perimeter firewall, reverse proxy or WAF logs normalised to NETWORK_HTTP with principal.ip, network.http.method and target.url populated. TLS-inspected or terminated traffic is needed to see URL paths."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, load-testing tools, uptime and synthetic monitoring, corporate NAT or VPN egress addresses shared by many legitimate users, mobile apps that retry logins aggressively, and partner API integrations that authenticate frequently."
    tuning_guidance = "Add authorised scanner and test sources to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Raise the #http threshold for high-traffic portals or lower it for low-volume ones. Review sources that also appear in other recon or phishing detections first."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(login|signin|sign-in|logon|auth|authenticate|session|sso|oauth2?\/token|accounts\/login|wp-login\.php|xmlrpc\.php)/ nocase
    $http.principal.ip = $src
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1586.001")
    $primary_entity = array_distinct($src)
    $targeted_hosts = array_distinct($http.target.hostname)
    $targeted_urls = array_distinct($http.target.url)

  condition:
    #http >= 30
}
