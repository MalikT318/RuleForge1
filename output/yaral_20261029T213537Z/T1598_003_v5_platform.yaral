/*
  MITRE Technique : T1598.003 - Spearphishing Link
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:16:07.665966+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_003_Obfuscated_URL_Authority_Web_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound web requests whose URL authority is obfuscated, either with embedded userinfo (text before an '@' symbol) or with an integer or hexadecimal hostname. These are common spearphishing-link tricks to disguise credential-harvesting destinations. Internal destinations and known-good domains are excluded."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.003"
    mitre_technique_name = "Phishing for Information: Spearphishing Link"
    log_prerequisites = "Requires perimeter firewall or web proxy logs normalised to NETWORK_HTTP with metadata.event_type and target.url populated. The device must log full URLs, which usually means TLS inspection or a forward proxy for HTTPS."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legacy applications or scripts that pass credentials in the URL (user:pass@host), internal tools reached by a numeric IP-style hostname, URL shorteners or trackers that embed an '@' in the authority, and long numeric hostnames from some CDN or telemetry services."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Internal destinations are already excluded through %rfc1918_internal. If the proxy only logs hostnames (no full URL), this rule will not fire; confirm target.url is populated before deploying for a client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^https?:\/\/([^\/?#]*@|(0x[0-9a-f]+|[0-9]{8,10})(:[0-9]+)?([\/?#]|$))/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598.003")
    $primary_entity = array_distinct($net.principal.ip)
    $source_host = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $requested_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
