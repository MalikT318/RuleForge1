/*
  MITRE Technique : T1584.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:21:19.798279+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_002_DNS_LongLabel_Then_TXT_NULL_Same_Domain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single client issues a DNS query containing an abnormally long, encoded-looking subdomain label and then a TXT or NULL record query to the same registered domain within ten minutes. This pattern is consistent with DNS-based C2 or tunnelling through attacker-controlled or compromised third-party DNS infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.002"
    mitre_technique_name = "Compromise Infrastructure: DNS Server"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS, with principal.ip (the client) and network.dns.questions populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam DNS blocklist lookups, DKIM/SPF/DMARC TXT validation, CDN and cloud provider hostnames with long generated labels, software licensing and telemetry services, and security products that use DNS for reputation lookups."
    tuning_guidance = "Add known-good registered domains (for example CDN, mail security and licensing vendors) to %global_allowed_domains. The registered domain is extracted as the last two labels, so multi-part public suffixes such as co.uk group by the suffix; keep that in mind when tuning. Adjust the label length threshold (40) per environment. Resolver or forwarder IPs that appear as the client should be excluded at the log source or by ingestion filter."

  events:
    $dns1.metadata.event_type = "NETWORK_DNS"
    $dns1.network.dns.questions.name = /(?i)[a-z0-9_-]{40,}\.[a-z0-9-]+\.[a-z]{2,}$/
    $dns1.principal.ip = $client
    $sld = re.capture($dns1.network.dns.questions.name, /(?i)([a-z0-9-]+\.[a-z0-9-]+)$/)
    not $sld in %global_allowed_domains

    $dns2.metadata.event_type = "NETWORK_DNS"
    ($dns2.network.dns.questions.type = 16 or $dns2.network.dns.questions.type = 10)
    $dns2.principal.ip = $client
    $sld = re.capture($dns2.network.dns.questions.name, /(?i)([a-z0-9-]+\.[a-z0-9-]+)$/)

    $dns1.metadata.event_timestamp.seconds <= $dns2.metadata.event_timestamp.seconds

  match:
    $client, $sld over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1584.002")
    $primary_entity = array_distinct($client)
    $suspect_domain = array_distinct($sld)
    $long_label_queries = array_distinct($dns1.network.dns.questions.name)
    $txt_null_queries = array_distinct($dns2.network.dns.questions.name)
    $query_count = count($dns2.metadata.id)

  condition:
    $dns1 and $dns2
}
