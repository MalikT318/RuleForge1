/*
  MITRE Technique : T1583.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:10:52.997653+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_007_Serverless_Function_Endpoint_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP(S) request through a perimeter proxy or firewall to a serverless function-hosting endpoint. The endpoint can be a function-URL namespace, an edge worker namespace, or a script-execution web-app path. Adversaries use these endpoints as disposable redirectors or C2 front-ends because the traffic blends into traffic to large cloud providers. The rule matches provider function-hosting namespace patterns, not specific attacker domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.007"
    mitre_technique_name = "Acquire Infrastructure: Serverless"
    log_prerequisites = "Requires firewall or web proxy logs normalised to NETWORK_HTTP with target.hostname populated (target.url populated for the script web-app match). HTTPS inspection or SNI/host logging is needed for hostname visibility."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SaaS integrations, webhooks, internal or vendor applications hosted on serverless platforms, developer and DevOps traffic, and business automation built on script web-apps."
    tuning_guidance = "Add known-good serverless hostnames used by the business or its vendors to %global_allowed_domains. Hosts with approved developer or automation activity can be handled by suppressing on the primary_entity outcome. Raise severity or pair with a rarity or volume rule for hosts that beacon repeatedly to a single function endpoint."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    (
      $net.target.hostname = /\.lambda-url\.[a-z0-9-]+\.on\.aws$/ nocase or
      $net.target.hostname = /\.workers\.dev$/ nocase or
      $net.target.hostname = /\.cloudfunctions\.net$/ nocase or
      (
        $net.target.hostname = /^script\.google(usercontent)?\.com$/ nocase and
        $net.target.url = /\/macros\/s\/[^\/]+\/(exec|dev)/ nocase
      )
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.007")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
