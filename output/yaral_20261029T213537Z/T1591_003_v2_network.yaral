/*
  MITRE Technique : T1591.003 - Identify Business Tempo
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:29:54.948768+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_003_Network_Business_Tempo_Page_Automated_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source using a scripted or library HTTP client to request pages that disclose business tempo, such as operating hours, holiday, shipping or delivery schedules. Passing through the IDS/IPS or network security appliance, this is characteristic of automated reconnaissance for timing an attack or social-engineering campaign."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.003"
    mitre_technique_name = "Gather Victim Org Information: Identify Business Tempo"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs that record HTTP transactions (URL and user agent) with the external source address, normalised to NETWORK_HTTP. TLS inspection is needed for HTTPS visibility."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and availability monitors, partner or logistics integrations polling schedule pages, third-party marketing and reputation tools, authorised scanners."
    tuning_guidance = "Add authorised scanner and monitoring sources to %global_allowed_scanners. Add known-good partner or monitor source addresses to %global_allowed_mgmt_sources. Extend the URL keyword regex with client-specific schedule page naming. Raise severity if the same source also appears in other recon detections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(business|opening|office|store|operating|working|support)[-_+ ]*hours|hours[-_ ]of[-_ ]operation|(holiday|shipping|delivery|shipment|maintenance|release)[-_ ]?(schedule|calendar|dates)/ nocase
    $http.network.http.user_agent = /(curl|wget|python-requests|python-urllib|go-http-client|scrapy|libwww|okhttp|aiohttp|httpclient|java\/|node-fetch|axios)/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1591.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
