/*
  MITRE Technique : T1555.001 - Keychain
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:39:26.768579+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_001_Keychain_File_Copied_Outside_Keychain_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a macOS Keychain database file (login, System or iCloud-synced .keychain / .keychain-db) outside the standard Keychains directories. Copying a keychain to /tmp, a Shared folder, a Desktop or a removable volume is a common staging step before offline cracking or exfiltration. The rule works on the resulting file artifact, so it still fires when command-line logging is evaded or the copy is made with cp, ditto, a script or a custom binary."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.001"
    mitre_technique_name = "Credentials from Password Stores: Keychain"
    log_prerequisites = "Requires macOS endpoint file-event telemetry (FILE_CREATION) with populated target.file.full_path and principal.process.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Backup and imaging agents, Time Machine or migration assistants, MDM or IT tooling that migrates or re-provisions keychains, users manually exporting or backing up a keychain, and Apple Migration Assistant during device replacement."
    tuning_guidance = "Add approved backup or migration binaries to %global_allowed_backup_processes, MDM and deployment agents to %global_allowed_admin_tools, and EDR agents to %global_allowed_security_tools. Add named administrators who legitimately export keychains to %global_allowed_admin_users. If a legitimate staging directory is common in the tenant, extend the path exclusion."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.keychain(-db)?$/ nocase
    not $file.target.file.full_path = /\/Library\/Keychains\// nocase
    not $file.principal.process.file.full_path = /\/(securityd|secd|trustd|keychainsharingd|CloudKeychainProxy|cloudd|accountsd|Keychain Access)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1555.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $keychain_copy_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
