/*
  MITRE Technique : T1569.001 - Launchctl
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:51:24.337494+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_001_macOS_LaunchPlist_Dropped_By_Script_Or_Temp_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a launchd property list in a user or system LaunchAgents/LaunchDaemons directory by a shell, scripting interpreter, download utility, or a process running from a world-writable staging location. Adversaries drop the plist and then use launchctl load/start to execute it. This detects the resulting file artifact rather than the launchctl command line, so it still fires if command-line logging is evaded, the subcommand is fed through stdin, or launchctl is invoked interactively."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.001"
    mitre_technique_name = "System Services: Launchctl"
    log_prerequisites = "Requires macOS endpoint file-creation telemetry that populates the writing process path (principal.process.file.full_path) and target.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developer or admin shell scripts that install agents; Homebrew services and other package managers that write plists via ruby or shell; MDM or configuration management scripts; third-party software installers and updaters that use a shell or python postinstall script."
    tuning_guidance = "Add approved deployment and MDM tooling to %global_allowed_admin_tools, approved script parents to %global_allowed_script_hosts, EDR and security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Extend the Apple installer process-name exclusion if a client's software deployment tool writes plists under a different name."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(Users\/[^\/]+\/)?Library\/Launch(Agents|Daemons)\/[^\/]+\.plist$/ nocase
    $file.principal.process.file.full_path = /(\/(bash|sh|zsh|dash|ksh|osascript|python[0-9.]*|perl|ruby|node|curl|wget)$)|(^\/(private\/)?(var\/)?tmp\/)|(^\/Users\/Shared\/)|(^\/Users\/[^\/]+\/(Downloads|Library\/Caches)\/)/ nocase
    not $file.principal.process.file.full_path = /\/(installer|system_installd|installd|softwareupdated|launchd|mdmclient|cfprefsd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $plist_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
