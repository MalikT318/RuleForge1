/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:50:31.850665+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_macOS_Interpreter_Drops_Random_Named_Staging_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Heuristic, low-fidelity file-artifact detection for C2 junk-data/padding tooling on macOS. Junk data inside C2 protocol traffic is not directly observable in endpoint telemetry. This rule instead flags a scripting interpreter or network transfer utility creating an extensionless, long, random-looking file name in a world-writable staging location (/tmp, /private/tmp, /var/tmp, /Users/Shared). Implants commonly stage padded or obfuscated C2 request and response blobs this way. Use it as a hunting lead or enrichment signal, not as standalone proof."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "macOS endpoint telemetry (EDR or unified log) that records FILE_CREATION with the creating process path and the full target file path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Package managers and build tools (pip, npm, Homebrew helpers), developer scripts that write random-named temp files, installers and MDM or patching agents, and curl or Python-based update checkers that cache downloads under random names."
    tuning_guidance = "Add approved interpreter parents and automation hosts to %global_allowed_script_hosts, deployment and MDM tooling to %global_allowed_admin_tools, and EDR agents to %global_allowed_security_tools. Raise the minimum name length or restrict the directories if developer endpoints are noisy. Pair this with a network-layer signal (beaconing, uniform payload sizes) before escalating."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /(^|\/)(python[0-9.]*|osascript|perl|ruby|bash|zsh|sh|curl|nscurl|node|php|swift)$/ nocase
    $file.target.file.full_path = /^(\/private)?\/(tmp|var\/tmp)\/[A-Za-z0-9_-]{20,64}$|^\/Users\/Shared\/[A-Za-z0-9_-]{20,64}$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $staged_file = array_distinct($file.target.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
