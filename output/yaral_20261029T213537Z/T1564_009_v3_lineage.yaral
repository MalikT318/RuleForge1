/*
  MITRE Technique : T1564.009 - Resource Forking
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:47:23.286563+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_009_Unexpected_Parent_Spawns_Interpreter_Resource_Fork {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a document, browser, mail, web server, or database parent process spawning a shell or script interpreter that touches a file's resource fork (..namedfork/rsrc or com.apple.ResourceFork). Legitimate use of these parents to read resource forks is rare, so the lineage anomaly combined with the fork access indicates hidden payload staging or execution (T1564.009)."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.009"
    mitre_technique_name = "Hide Artifacts: Resource Forking"
    log_prerequisites = "Requires macOS endpoint process telemetry (EDR or unified log) populating parent and child process paths and command lines."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy Mac applications and installers that read resource forks through a shell helper, developer tooling launched from a web server or Java process, and macOS packaging or migration scripts started by a browser-downloaded installer."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. If a parent family is noisy, narrow the parent regex. The child interpreter list can be extended with other interpreters in use."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/Contents\/MacOS\/(Microsoft (Word|Excel|PowerPoint|Outlook)|Safari|Mail|Preview|Google Chrome|Firefox)$|\/(httpd|nginx|java|node|mysqld|postgres|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|zsh|dash|python3?|perl|ruby|osascript)$/ nocase
    $proc.target.process.command_line = /\.\.namedfork\/(rsrc|data)|com\.apple\.ResourceFork/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
