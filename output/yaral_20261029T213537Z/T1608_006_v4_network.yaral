/*
  MITRE Technique : T1608.006 - SEO Poisoning
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:31:04.077918+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_006_SEO_Poisoning_Search_Referral_To_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client following a search-engine result directly to an executable, installer, disk-image, script or archive download hosted on a domain that is not known-good. This is the network-observable result of SEO poisoning, where poisoned results lure victims to staged payloads (drive-by or supply-chain lures)."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.006"
    mitre_technique_name = "Stage Capabilities: SEO Poisoning"
    log_prerequisites = "Requires proxy or firewall HTTP logging with full URL and Referer (network.http.referral_url) visibility. For HTTPS this needs TLS inspection; without it the referrer is not available."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users legitimately searching for and downloading software from vendor or open-source sites that are not yet in the allowlist; IT staff downloading tools from search results; developers fetching packages or ISOs via search; software mirrors and CDNs not covered by the known-good domain list."
    tuning_guidance = "Populate %global_allowed_domains with known-good vendor, CDN and software-mirror domains, including the subdomains actually seen, since matching is on the exact target hostname. Add scanner or proxy-test sources to %global_allowed_scanners. Extend or trim the file-extension list per client policy. Consider raising severity for user groups that cannot install software."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.referral_url = /^https?:\/\/([a-z0-9-]+\.)*(google|bing|duckduckgo|yahoo|baidu|yandex|ecosia|search\.brave)\.[a-z.]{2,}\// nocase
    $http.target.url = /\.(exe|msi|msix|appx|iso|img|scr|js|vbs|jar|dll|zip|rar|7z)(\?.*)?$/ nocase
    not $http.target.hostname = /(^|\.)(google|bing|duckduckgo|yahoo|baidu|yandex|ecosia|brave)\.[a-z.]{2,}$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.006")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $download_urls = array_distinct($http.target.url)
    $referrers = array_distinct($http.network.http.referral_url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
