/*
  MITRE Technique : T1615 - Group Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:32:37.629402+00:00
  Reference       : https://attack.mitre.org/techniques/T1615
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1615_GPO_Discovery_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Group Policy discovery (gpresult, GroupPolicy module cmdlets, PowerView-style Get-*GPO functions, or SYSVOL policy path enumeration) run by a shell or script interpreter spawned from an unexpected parent such as an Office application, web server, print spooler, database service, or script host. These lineages are strong indicators of post-exploitation or macro/webshell-driven reconnaissance."
    mitre_tactic = "Discovery"
    mitre_technique = "T1615"
    mitre_technique_name = "Group Policy Discovery"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web-based or database-driven IT management portals that call gpresult or GroupPolicy cmdlets, Office-hosted admin macros or add-ins used by IT staff, inventory or compliance scripts launched from a script host, and administrators testing GPO scenarios through approved tools."
    tuning_guidance = "Add legitimate parent process paths to %global_allowed_admin_tools or %global_allowed_script_hosts. Extend the parent regex with additional client-specific server processes if needed. Review the parent_process and command_line outcome values before tuning."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|java|php-cgi|spoolsv|sqlservr|mysqld|oracle|mshta|wscript|cscript)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|gpresult|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(gpresult|\bGet-\w*GPO\w*|Get-GPResultantSetOfPolicy|Get-GPInheritance|sysvol\\[^\\]+\\policies)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1615")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
