/*
  MITRE Technique : T1589.002 - Email Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:08:14.929440+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_002_External_Email_Enumeration_Endpoint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source querying public mail-service user-validation endpoints (autodiscover JSON with an Email= parameter, or getuserrealm with a login= parameter) with a full email address. Adversaries use these endpoints to learn which email addresses are valid, because the response differs for existing and non-existing accounts."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.002"
    mitre_technique_name = "Gather Victim Identity Information: Email Addresses"
    log_prerequisites = "Requires reverse-proxy, WAF, or perimeter web-gateway logs that populate network URLs for inbound HTTP traffic, normalised to UDM NETWORK_HTTP with principal.ip and target.url."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external pentests or attack-surface scans; third-party email-security or migration tooling validating mailboxes; mobile or Outlook clients with misconfigured autodiscover that include the email address in the query string; partner onboarding checks."
    tuning_guidance = "Add authorised testing and scanning source addresses to %global_allowed_scanners. Add sanctioned partner or migration source addresses to the same list. If a client does not publish autodiscover or federation endpoints externally, severity can be raised because any hit is unexpected. Consider pairing this with a volume-based threshold variant to prioritise sources probing many distinct addresses."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(autodiscover\/autodiscover\.json[^\s]*[?&]email=[^&\s]+(@|%40)|getuserrealm\.srf[^\s]*[?&]login=[^&\s]+(@|%40))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1589.002")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $probed_urls = array_distinct($http.target.url)

  condition:
    $http
}
