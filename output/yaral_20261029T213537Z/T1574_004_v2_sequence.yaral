/*
  MITRE Technique : T1574.004 - Dylib Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:53:21.848697+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_004_Dylib_Dropped_In_App_Bundle_Then_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A .dylib is written into the Contents directory of an application bundle (MacOS, Frameworks, PlugIns or Resources) by a non-installer process. The main executable of the same bundle is then launched on the same host within 10 minutes. This sequence indicates a planted library that the dynamic loader will pick up through @rpath or weak-link search order, and it does not depend on command-line content."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.004"
    mitre_technique_name = "Hijack Execution Flow: Dylib Hijacking"
    log_prerequisites = "Requires macOS endpoint telemetry with file creation events (including creating process path) and process launch events populating principal.hostname and full file paths."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party application auto-updaters (Sparkle-style updaters, vendor update agents) that replace bundle libraries and relaunch the app, developer builds of apps into /Applications, MDM or software deployment tools installing apps, and plugin installers for creative or IDE applications."
    tuning_guidance = "Add approved deployment and updater binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Extend the creator-process exclusion regex with additional Apple installer daemons if noisy. For developer fleets, consider scoping to hosts outside the engineering group."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(Applications|Users\/[^\/]+\/Applications)\/[^\/]+\.app\/Contents\/(MacOS|Frameworks|PlugIns|Resources)\/.*\.dylib$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\/(installd|system_installd|Installer|softwareupdated|mdmclient|storedownloadd|appstoreagent)$/ nocase
    $file.principal.hostname = $hostname
    $bundle = re.capture($file.target.file.full_path, "^(/(?:Applications|Users/[^/]+/Applications)/[^/]+[.]app)/Contents/")

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(Applications|Users\/[^\/]+\/Applications)\/[^\/]+\.app\/Contents\/MacOS\/[^\/]+$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $bundle = re.capture($proc.target.process.file.full_path, "^(/(?:Applications|Users/[^/]+/Applications)/[^/]+[.]app)/Contents/")

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $bundle over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.004")
    $primary_entity = array_distinct($hostname)
    $app_bundle = array_distinct($bundle)
    $dropped_dylibs = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $launched_executables = array_distinct($proc.target.process.file.full_path)
    $dylib_count = count_distinct($file.target.file.full_path)

  condition:
    $file and $proc
}
