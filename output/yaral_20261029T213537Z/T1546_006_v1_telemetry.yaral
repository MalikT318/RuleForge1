/*
  MITRE Technique : T1546.006 - LC_LOAD_DYLIB Addition
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:29:08.112854+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_006_MachO_Bundle_Executable_Modified_By_NonInstaller {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects in-place modification of a Mach-O executable inside an application bundle (Contents/MacOS) by a process that is not a recognised installer, updater or administrative tool. Adding an LC_LOAD_DYLIB load command, or stripping LC_CODE_SIGNATURE, rewrites the binary on disk. This rule detects that file-state change rather than the command line that caused it, so it still fires when the process is renamed, run through a wrapper or launched with obfuscated arguments."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.006"
    mitre_technique_name = "Event Triggered Execution: LC_LOAD_DYLIB Addition"
    log_prerequisites = "Requires macOS endpoint file telemetry that reports FILE_MODIFICATION events with the writing process path and the target file path (EDR file-write events or Endpoint Security framework events)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Application updaters that patch binaries in place, developer toolchains (compilers, linkers, codesign and install_name_tool during builds), MDM and software deployment agents, ad-hoc re-signing of applications by IT, and security tools that repair bundles."
    tuning_guidance = "Add approved updater, build or deployment binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Build and developer hosts that legitimately re-sign binaries generate most of the noise; consider scoping or suppressing the rule for those hosts. Extend the installer-name exclusion regex only with executable names, not install paths."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\.app\/Contents\/MacOS\/[^\/]+$/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(installd|system_installd|softwareupdated|storedownloadd|appstoreagent|Installer|PackageKit|mdmclient|Autoupdate|ShipIt|Squirrel)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_binary = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
