/*
  MITRE Technique : T1608 - Stage Capabilities
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:18:48.184710+00:00
  Reference       : https://attack.mitre.org/techniques/T1608
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_Payload_Download_From_IP_Literal_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful HTTP GET for an executable, script, installer, disk image or archive payload where the URL host is a bare IP address rather than a domain. Capabilities staged on adversary-controlled infrastructure are commonly served from raw IP hosts, with no domain registered. The rule keys on the observable result (a payload type fetched from an IP-literal external host), not on specific indicators, filenames or domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608"
    mitre_technique_name = "Stage Capabilities"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL-level HTTP visibility (TLS inspection or cleartext HTTP) normalised to NETWORK_HTTP, with target.url and the HTTP response code populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal or partner software distribution served by IP, appliance or firmware update mechanisms, developer or lab downloads from IP-addressed test servers, vulnerability scanners and sandbox detonation traffic, CDN edge nodes addressed by IP."
    tuning_guidance = "Add known-good vendor update domains to %global_allowed_domains. Add scanner and sandbox source addresses to %global_allowed_scanners. Narrow or extend the extension list in the target.url regex to match client policy. Pair with proxy category blocks for uncategorised hosts."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    $http.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\/[^?#]*\.(exe|dll|msi|scr|bat|cmd|ps1|vbs|js|hta|jar|iso|img|zip|7z|rar|lnk|apk|elf|sh)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608")
    $primary_entity = array_distinct(strings.coalesce($http.principal.hostname, $http.principal.ip))
    $staging_urls = array_distinct($http.target.url)
    $staging_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
