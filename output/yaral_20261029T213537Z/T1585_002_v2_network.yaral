/*
  MITRE Technique : T1585.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:36:36.823339+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_002_Email_Account_Signup_Web_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an HTTP POST to an account-registration URL path on a mail-oriented external host, which indicates creation of a new email account (including disposable or free webmail accounts). Only the victim-side footprint is visible: a managed host or user registering an email account. The rule cannot see an adversary registering accounts from their own infrastructure. Treat hits as low-fidelity resource-development context to be correlated with phishing or infrastructure-acquisition activity."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.002"
    mitre_technique_name = "Establish Accounts: Email Accounts"
    log_prerequisites = "Requires proxy or perimeter logs that populate network.http.method and target.url, normally with TLS inspection enabled. Without URL visibility the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees opening personal webmail accounts, IT staff provisioning accounts on approved mail platforms, QA or marketing teams testing signup flows, and sanctioned SaaS onboarding."
    tuning_guidance = "Add approved vendor and mail domains to %global_allowed_domains. Exclude sanctioned administrator-run onboarding hosts. Raise severity only when the hit correlates with phishing activity or new-domain registration. Consider suppressing per source host if user self-registration is common."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.hostname = /mail/ nocase
    $http.target.url = /\/(signup|sign-up|register|registration|createaccount|create-account|newaccount|new-account|accounts?\/create)(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1585.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_user = array_distinct($http.principal.user.userid)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
