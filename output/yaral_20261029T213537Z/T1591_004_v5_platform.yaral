/*
  MITRE Technique : T1591.004 - Identify Roles
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:32:44.160826+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_004_External_Automated_Role_Page_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external client using a scripted or crawler-style HTTP client to request organisational role pages (team, leadership, staff directory, org chart). This pattern is consistent with pre-compromise gathering of identities and roles. The request is seen by an IDS/IPS or network security appliance that inspects HTTP traffic to organisation-owned web properties."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.004"
    mitre_technique_name = "Gather Victim Org Information: Identify Roles"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs that decode inbound HTTP and populate network.http.user_agent and target.url (UDM NETWORK_HTTP). The sensor must see decrypted or inspected traffic to external-facing web servers."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Legitimate search engine and SEO crawlers, uptime and brand-monitoring services, partner or recruiter integrations that pull staff pages, authorised external penetration tests or scanners not yet allowlisted, and customer scripts that poll a public team page."
    tuning_guidance = "Add authorised external scanners and monitoring sources to %global_allowed_scanners. Extend the URL keyword group to match the organisation's own role-page naming. Raise severity if the same source IP also triggers other reconnaissance rules (for example T1593 or T1594 variants). Review the risk score before auto-response, because this is a low-fidelity reconnaissance signal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\/(our-?team|meet-the-team|leadership|management-team|executive-team|staff-directory|employee-directory|org-?chart|who-we-are|board-of-directors|people)(\/|\?|\.|$)/ nocase
    $http.network.http.user_agent = /(bot|crawler|spider|scrap|python|curl|wget|go-http|libwww|java\/|okhttp|httpclient|axios|node-fetch|headless)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1591.004")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
