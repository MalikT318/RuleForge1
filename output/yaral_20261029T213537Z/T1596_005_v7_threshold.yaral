/*
  MITRE Technique : T1596.005 - Scan Databases
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:07:25.042642+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_005_External_Scan_Database_Crawler_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source makes a high volume of connections to the organisation's perimeter within 10 minutes. Searching scan databases (T1596.005) is passive and invisible to the victim. What the victim can see is the crawling that populates those databases, and the follow-on active probing of services an adversary found in them. One connection is benign, but a burst from one external IP across many ports or hosts matches Internet-wide survey behaviour."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.005"
    mitre_technique_name = "Search Open Technical Databases: Scan Databases"
    log_prerequisites = "Requires IPS or network security appliance connection telemetry normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Sensors must see inbound Internet-facing traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, uptime and availability monitors, CDN or reverse-proxy health checks, partner or customer systems with legitimately high connection volume, NAT gateways aggregating many users behind one source IP, security research crawlers the client has accepted."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Add trusted management or partner source addresses to %global_allowed_mgmt_sources. Raise the #net threshold for tenants with busy public services, or lower it for tenants with small perimeters. Risk is raised automatically when commonly attacked management ports are probed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.port > 0
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port = 22 or $net.target.port = 23 or $net.target.port = 445 or $net.target.port = 3389 or $net.target.port = 5900, 65, 45))
    $mitre_technique_id = array_distinct("T1596.005")
    $primary_entity = array_distinct($src_ip)
    $connection_count = count($net.metadata.id)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 30
}
