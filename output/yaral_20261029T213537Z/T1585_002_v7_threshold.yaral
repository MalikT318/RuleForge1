/*
  MITRE Technique : T1585.002 - Email Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:37:57.829648+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_002_Bulk_Email_Account_Signup_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source submits repeated POST requests to account-registration paths on mail-related hosts within 10 minutes. This can indicate bulk or automated creation of email accounts or disposable mailboxes for later phishing or infrastructure acquisition. A single signup is benign; the repeated volume from one source is not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.002"
    mitre_technique_name = "Establish Accounts: Email Accounts"
    log_prerequisites = "Requires forward-proxy or perimeter firewall logs with URL visibility (TLS inspection or SNI/URL logging) that populate NETWORK_HTTP, including principal.ip, target.hostname, target.url and network.http.method."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Corporate onboarding or provisioning automation creating mailboxes at an external provider, QA or web-testing teams exercising signup flows, marketing or security-awareness teams creating test accounts, and NAT or proxy egress addresses that aggregate many users behind one IP."
    tuning_guidance = "Add known-good vendor or mail-provider domains to %global_allowed_domains. If principal.ip is a shared NAT or proxy address, raise the threshold or tune per client. Raise the #http threshold in noisy environments. Add sanctioned automation sources to the exclusion lists. Scale severity in outcome using $signup_count and $distinct_mail_hosts."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.hostname = /(mail|inbox|webmail|mailbox)/ nocase
    $http.target.url = /(signup|sign-up|sign_up|register|registration|create[-_]?account|new[-_]?account|createmailbox|join)/ nocase
    $http.principal.ip = $src
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal

  match:
    $src over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1585.002")
    $primary_entity = array_distinct($src)
    $signup_count = count($http.metadata.id)
    $distinct_mail_hosts = array_distinct($http.target.hostname)
    $signup_urls = array_distinct($http.target.url)

  condition:
    #http >= 5
}
