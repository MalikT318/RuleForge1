/*
  MITRE Technique : T1543.001 - Launch Agent
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:26:21.431635+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_001_macOS_LaunchAgent_Plist_Written_By_NonInstaller {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a launchd property list in a system-wide or per-user LaunchAgents directory by a process that is not a recognised macOS installer, MDM or software-update component. Launch Agents run at user login and are a common macOS persistence mechanism. This rule uses file-creation telemetry, not process command lines, so it also catches plists dropped by scripts, interpreters or compiled implants without any launchctl call."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.001"
    mitre_technique_name = "Create or Modify System Process: Launch Agent"
    log_prerequisites = "Requires macOS endpoint file-creation telemetry (EDR or Endpoint Security framework events) populating target.file.full_path and principal.process.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party application installers and auto-updaters that register login helpers (browsers, collaboration clients, VPN clients, cloud-storage sync clients), developer tools, MDM or configuration-management agents writing plists, and administrators deploying agents by script."
    tuning_guidance = "Add approved deployment, packaging and MDM tooling to %global_allowed_admin_tools. Add EDR and security agents to %global_allowed_security_tools. Add approved remote-support tooling to %global_allowed_remote_mgmt. Review recurring benign writers and add them to these lists by executable path. The built-in Apple installer and updater exclusion is name-based, so it survives OS updates."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(Library|Users\/[^\/]+\/Library|var\/root\/Library)\/LaunchAgents\/[^\/]+\.plist$/ nocase
    not $file.principal.process.file.full_path = /\/(installd|system_installd|Installer|PackageKit|mdmclient|softwareupdated|storedownloadd|appstoreagent)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $plist_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
