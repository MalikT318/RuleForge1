/*
  MITRE Technique : T1564.009 - Resource Forking
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:48:09.216510+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_009_MacOS_Resource_Fork_Write_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated file writes to the resource fork (..namedfork/rsrc) of files on a single macOS host within ten minutes. A single resource fork write is common in legitimate Mac software, but repeated writes by non-allowlisted processes suggest an adversary staging or hiding payloads in resource forks. Scores are raised when the writes target world-writable staging locations."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.009"
    mitre_technique_name = "Hide Artifacts: Resource Forking"
    log_prerequisites = "macOS endpoint telemetry that records file modification events with the full path, including the ..namedfork/rsrc suffix, and the acting process path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Finder custom-icon assignment, legacy Carbon/Classic applications and installers, Xcode and developer resource tooling (Rez/SetFile), archive extraction of old Mac archives, backup and migration tools restoring forked files, and design applications that save legacy resources."
    tuning_guidance = "Add backup/imaging processes to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and IT packaging or deployment tooling to %global_allowed_admin_tools. Raise the #file threshold on developer-heavy fleets, or add extra executable-name exclusions to the Finder/ditto regex."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/\.\.namedfork\/rsrc$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path = /\/(Finder|ditto|Xcode|Rez|DeRez|SetFile)$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /^\/(private\/)?(tmp|var\/tmp)\/|^\/Users\/Shared\/|^\/Users\/[^\/]+\/(Downloads|Library\/Caches)\//, 85, 60))
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1564.009")
    $primary_entity = array_distinct($host)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $forked_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
