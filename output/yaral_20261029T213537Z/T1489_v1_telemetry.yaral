/*
  MITRE Technique : T1489 - Service Stop
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:18:10.510502+00:00
  Reference       : https://attack.mitre.org/techniques/T1489
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1489_macOS_Launchd_Disabled_Overrides_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the launchd disabled-services override database (disabled.plist or disabled.<uid>.plist under /var/db/com.apple.xpc.launchd). This state file changes when a launchd service is persistently disabled, for example through launchctl disable or bootout. It catches service-stop activity at the file-artifact layer, so it still fires when the command line is obfuscated, wrapped in a script, or issued through an API."
    mitre_tactic = "Impact"
    mitre_technique = "T1489"
    mitre_technique_name = "Service Stop"
    log_prerequisites = "macOS endpoint telemetry with file modification events and full path (EDR or unified log). Paths may appear as /var/... or /private/var/... depending on the sensor, and the rule covers both."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or configuration-management enrolment and policy changes that disable bundled services, administrators disabling services such as sharing or remote login, macOS upgrades and security hardening scripts, and endpoint security agents that manage their own launch jobs."
    tuning_guidance = "Add approved MDM, patching and hardening tool paths to %global_allowed_admin_tools, and endpoint security agents to %global_allowed_security_tools. Some sensors attribute the write to launchd rather than the requesting process. In that case correlate with the host's other activity at triage and treat the change as a state change rather than relying on the writer. Consider raising severity on servers or on hosts running a security agent."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(private\/)?var\/db\/com\.apple\.xpc\.launchd\/disabled(\.[0-9]+)?\.plist$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1489")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
