/*
  MITRE Technique : T1583.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:08:03.044113+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_005_DNS_Botnet_HighEntropy_TXT_NULL_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a DNS TXT or NULL query for a name with a very long, consonant/digit-dense label under a domain that is not on the allowlist. This pattern is typical of algorithmically generated domains and DNS-based C2 or tasking used by botnet nodes, including leased ORB and IoT botnets. It is a resolver-side proxy for a client acting as a botnet node, since the acquisition of a botnet cannot be observed directly."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.005"
    mitre_technique_name = "Acquire Infrastructure: Botnet"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam DNSBL/SPF lookups, DKIM TXT lookups with long selectors, CDN and cloud-provider generated hostnames, software licensing or telemetry services using encoded TXT queries, and security-vendor reputation lookups."
    tuning_guidance = "Add the registered domains of known-good vendors, CDNs and mail-security services to %global_allowed_domains. Raise the label length threshold (24) or the consonant/digit run length (7) to reduce noise, or lower them for higher sensitivity. Confirm that the resolver populates network.dns.questions.type (TXT=16, NULL=10)."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9\-]{24,}\./ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz0-9]{7,}/ nocase
    not $dns.network.dns.questions.name = /\.(arpa|local|internal|lan)$/ nocase
    $regdomain = re.capture(strings.to_lower($dns.network.dns.questions.name), "([a-z0-9\\-]+\\.[a-z0-9\\-]+)$")
    not $regdomain in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1583.005")
    $primary_entity = array_distinct($dns.principal.ip)
    $client_hostname = array_distinct($dns.principal.hostname)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $registered_domains = array_distinct($regdomain)

  condition:
    $dns
}
