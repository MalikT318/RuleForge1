/*
  MITRE Technique : T1647 - Plist File Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:33:58.122370+00:00
  Reference       : https://attack.mitre.org/techniques/T1647
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1647_Plist_Modification_Via_CLI_Tools {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the macOS built-in plist editing utilities (defaults, PlistBuddy, plutil) being used to write, add, insert, or replace security-relevant keys in plist files. Targeted keys and locations include LSUIElement, LSBackgroundOnly, LSEnvironment, EnvironmentVariables, ProgramArguments, RunAtLoad, DYLD_INSERT_LIBRARIES, application Info.plist, Dock and loginwindow preferences, and LaunchAgents/LaunchDaemons plists. Adversaries use these changes to hide applications, inject environment variables, or persist code."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1647"
    mitre_technique_name = "Plist File Modification"
    log_prerequisites = "Requires macOS endpoint process-execution telemetry (EDR or unified log) with full command-line capture, normalised to UDM PROCESS_LAUNCH."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM and configuration-management agents setting preferences, IT provisioning scripts, software installers and updaters editing their own Info.plist or launchd plists, developers editing app bundles or entitlements during builds, and users changing Dock settings via scripted dotfiles."
    tuning_guidance = "Add approved MDM, deployment, and provisioning binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add build hosts and developer script parents to %global_allowed_script_hosts. If com.apple.dock noise is high in a client, remove the Dock alternative from the regex for that client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(defaults|PlistBuddy|plutil)$/ nocase
    $proc.target.process.command_line = /(\swrite\s|\simport\s|\s-c\s|\s-insert\s|\s-replace\s|\s-remove\s|\sdelete\s|\sadd\s|\sset\s|\smerge\s)/ nocase
    $proc.target.process.command_line = /(LSUIElement|LSBackgroundOnly|LSEnvironment|EnvironmentVariables|DYLD_INSERT_LIBRARIES|DYLD_FRAMEWORK_PATH|ProgramArguments|RunAtLoad|com\.apple\.dock|persistent-apps|com\.apple\.loginwindow|LaunchAgents|LaunchDaemons|\/Contents\/Info(\.plist)?)/ nocase
    not $proc.principal.process.file.full_path = /\/(installd|system_installd|mdmclient|softwareupdated|Installer)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1647")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $tool = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
