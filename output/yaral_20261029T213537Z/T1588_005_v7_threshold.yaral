/*
  MITRE Technique : T1588.005 - Exploits
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:02:15.820322+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_005_External_Exploit_Probe_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Acquisition of exploits (T1588.005) happens off-network and cannot be observed directly. This rule detects the observable downstream result, which is a single external source sending many HTTP requests to perimeter-facing services in 10 minutes. The requests carry generic exploit-delivery patterns: path traversal, shell command chaining, SQL UNION injection, expression-injection markers and sensitive system file references. One such request can be benign noise. Repeated attempts from one source suggest weaponised exploit tooling is being used against exposed assets."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.005"
    mitre_technique_name = "Obtain Capabilities: Exploits"
    log_prerequisites = "Requires perimeter logs with URL visibility (HTTP-aware firewall, reverse proxy or inspecting gateway) normalised to NETWORK_HTTP with principal.ip and target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, security research crawlers, applications that legitimately pass URLs or paths as parameters, misconfigured monitoring probes, and benign internet background scanning."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add approved management sources to %global_allowed_mgmt_sources. Raise the #http threshold on internet-facing hosts with heavy background noise. Lower it for crown-jewel services. Correlate results with application error responses before escalating."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\.\.(\/|\\|%2f|%5c)|%2e%2e(\/|%2f|%5c)|\/etc\/passwd|union(\s|\+|%20)+select|(;|\||%3b|%7c)(\s|\+|%20)*(cat|wget|curl|bash|sh|nc)\b|\$\{|%24%7b)/ nocase
    $http.principal.ip = $src
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1588.005")
    $primary_entity = array_distinct($src)
    $targeted_hosts = array_distinct($http.target.hostname)
    $targeted_ips = array_distinct($http.target.ip)
    $sample_urls = array_distinct($http.target.url)

  condition:
    #http >= 10
}
