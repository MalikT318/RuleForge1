/*
  MITRE Technique : T1583.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:04:08.192608+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_003_External_Source_Connection_Sweep {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source address makes a high volume of connection attempts to perimeter-facing destinations within ten minutes. Each connection is benign on its own. The volume indicates reconnaissance or staging from rented VPS or cloud infrastructure (T1583.003) ahead of later intrusion stages."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.003"
    mitre_technique_name = "Acquire Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, and with inbound traffic logged."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Uncatalogued vulnerability scanners and internet-wide research crawlers, partner or customer systems with heavy legitimate API traffic, CDN or monitoring probes, NAT gateways aggregating many users behind one address, and load-testing from cloud hosts."
    tuning_guidance = "Add authorised scanning sources to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. The default threshold is 100 connections in 10 minutes per source address. Raise it for high-traffic perimeters and lower it for low-traffic environments. Review the $distinct_ports and $distinct_targets outcome values to separate port sweeps from busy legitimate clients."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.port > 0
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port < 1024, 70, 55))
    $mitre_technique_id = array_distinct("T1583.003")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $distinct_ports = array_distinct($net.target.port)
    $distinct_targets = array_distinct($net.target.ip)

  condition:
    #net >= 100
}
