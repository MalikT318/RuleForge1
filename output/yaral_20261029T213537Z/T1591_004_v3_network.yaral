/*
  MITRE Technique : T1591.004 - Identify Roles
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:32:07.654447+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_004_External_Automated_Role_Directory_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source using an automated or scripted HTTP client to request staff, leadership, or organisational-directory pages on an internet-facing web service. This is the network-side footprint of an adversary harvesting business roles and key-personnel information for targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.004"
    mitre_technique_name = "Gather Victim Org Information: Identify Roles"
    log_prerequisites = "Requires IDS/IPS or network security appliance HTTP inspection logs normalised to NETWORK_HTTP, with principal.ip, target.url, and network.http.user_agent populated. TLS inspection or a decrypting sensor is needed for HTTPS traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers indexing team or leadership pages; uptime and content-monitoring services; partner or recruiter integrations that pull staff listings; authorised external penetration tests or web scans; internal-facing reverse proxies that present an external source address."
    tuning_guidance = "Add authorised external scanners and monitoring sources to %global_allowed_scanners. Add trusted partner or proxy source addresses to %global_allowed_mgmt_sources. Search engine crawlers are the main noise source, so add their source addresses to %global_allowed_scanners or raise the user-agent specificity. Hunt for repeat hits from the same principal.ip across hosts, or escalate the score when the same source also requests several directory paths."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(leadership|management[-_]?team|executive[-_]?team|our[-_]?team|meet[-_]?the[-_]?team|staff[-_]?directory|staff|people|org[-_]?chart|employee[-_]?directory|directory|board[-_]?of[-_]?directors)(\/|\.|\?|$)/ nocase
    $http.network.http.user_agent = /(curl|wget|python|scrapy|go-http-client|libwww|httpclient|okhttp|java\/|bot|crawler|spider|scraper|headless)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1591.004")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $target_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
