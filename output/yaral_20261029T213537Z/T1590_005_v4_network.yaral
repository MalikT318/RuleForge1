/*
  MITRE Technique : T1590.005 - IP Addresses
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:21:19.315092+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_005_IPS_External_Recon_Verdict {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IDS/IPS reconnaissance verdict (scan, sweep, probe, or enumeration signature) on a connection from an external source address. This is network-side evidence of an adversary mapping the organisation's public IP space, which supports T1590.005 and typically precedes active scanning or exploitation."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.005"
    mitre_technique_name = "Gather Victim Network Information: IP Addresses"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION, with security_result.category, rule_name, or description populated for reconnaissance signatures. The sensor must sit at the internet edge so the source IP is the real external address."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and penetration tests, internet-wide research scanners (benign survey crawlers), uptime and monitoring probes, partner or ISP connectivity checks, and noisy signatures whose names contain generic words like 'probe' or 'scan'."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners, and approved management or monitoring sources to %global_allowed_mgmt_sources. If a vendor signature is consistently noisy, narrow the rule_name regex per tenant. Because this rule is single-event, consider routing high-volume tenants to a threshold variant that counts distinct targets per source."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.category = "NETWORK_RECON" or
      $net.security_result.rule_name = /(scan|sweep|probe|recon|enumerat|fingerprint|footprint)/ nocase or
      $net.security_result.description = /(scan|sweep|probe|recon|enumerat|fingerprint|footprint)/ nocase
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1590.005")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
