/*
  MITRE Technique : T1588.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:55:21.942166+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_001_Payload_Download_Then_NonWeb_Port_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An internal host downloads an executable, script, or archive payload over HTTP from an external server and, within ten minutes, opens a connection to the same external IP on a non-web port. This suggests acquired malware being staged, followed by a hand-off to a separate C2 or tool-delivery channel."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.001"
    mitre_technique_name = "Obtain Capabilities: Malware"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_HTTP (with URL and method, e.g. from TLS-inspecting or proxy devices) and NETWORK_CONNECTION, with principal.ip and target.ip populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers or admins downloading installers or archives from a vendor that also exposes non-web service ports (FTP, SSH, custom update channels), software update mechanisms, and security researchers or sandboxes."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Review the allowed non-web ports in the second event and extend the exclusions if a client uses 8080 or 8443 for legitimate services. Scope out sandbox or research egress ranges by excluding them upstream."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(exe|dll|msi|scr|ps1|bat|vbs|hta|jar|iso|7z|rar|zip)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.ip = $src_ip
    $http.target.ip = $dst_ip

    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.target.port != 80
    $conn.target.port != 443
    $conn.target.port != 53
    not $conn.target.ip in %rfc1918_internal
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip

    $http.metadata.event_timestamp.seconds <= $conn.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1588.001")
    $primary_entity = array_distinct($src_ip)
    $external_server = array_distinct($dst_ip)
    $download_urls = array_distinct($http.target.url)
    $followup_ports = array_distinct($conn.target.port)
    $connection_count = count($conn.metadata.id)

  condition:
    $http and $conn
}
