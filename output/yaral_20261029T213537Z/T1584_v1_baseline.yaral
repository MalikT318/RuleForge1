/*
  MITRE Technique : T1584 - Compromise Infrastructure
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:15:09.363508+00:00
  Reference       : https://attack.mitre.org/techniques/T1584
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_DNS_Tunnel_Style_Query_To_Compromised_Infra {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for TXT or NULL record types where a subdomain label is unusually long (45+ characters). This is the pattern used to move staging data or C2 over DNS to attacker-controlled or compromised third-party authoritative DNS infrastructure. Known-good domains are excluded through a reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584"
    mitre_technique_name = "Compromise Infrastructure"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated. Resolver-side logging is preferred so the internal client address is visible."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam DNS block lists, DKIM/SPF/DMARC lookups with long selectors, CDN and cloud vendor validation records, software licensing and telemetry services that encode data in subdomains, and some endpoint security cloud lookups."
    tuning_guidance = "Add legitimate parent domains (for example security vendors and mail-authentication providers) to %global_allowed_domains. Raise the label length from 45 to 55 in noisy environments, or lower it to 35 for higher sensitivity. Check that the DNS parser populates the question type as an integer (TXT=16, NULL=10)."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_\-]{45,}\.[a-z0-9_\-]+\.[a-z0-9_\-]+$/ nocase
    not $dns.network.dns.questions.name = /\.arpa$/ nocase
    $reg_domain = re.capture($dns.network.dns.questions.name, "([^.]+\\.[^.]+)$")
    not $reg_domain in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ips = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $queried_parent_domain = array_distinct($reg_domain)

  condition:
    $dns
}
