/*
  MITRE Technique : T1037.002 - Login Hook
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:54:48.138141+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_002_LoginHook_Script_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound external network connection made by a shell, scripting interpreter or command-line transfer utility whose parent process is loginwindow. On macOS, loginwindow executes the script named by the LoginHook or LogoutHook key in com.apple.loginwindow.plist as root at logon or logout. A hook script that reaches an external host is typical of a persistence implant staging a payload or beaconing at each logon. Login hooks are deprecated and rarely used, so any such network activity is high-signal."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.002"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Login Hook"
    log_prerequisites = "macOS endpoint telemetry that records network connections with the initiating process and its parent process (principal.process.parent_process populated). Assumes endpoint process and file coverage already exists for correlation."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy enterprise login or logout scripts that check in to a management server, inventory or licensing service, or mount remote shares and sync configuration. Older MDM or directory-binding scripts that still use loginwindow hooks. Admin-authored logon scripts that call curl for compliance checks."
    tuning_guidance = "Add approved management or inventory tooling binaries to %global_allowed_admin_tools and known-good vendor or update destinations to %global_allowed_domains. Add approved EDR or agent binaries to %global_allowed_security_tools. If the sensor records the parent in a different field, adjust the parent_process path. Corroborate hits with the endpoint rule for defaults writes to com.apple.loginwindow LoginHook or LogoutHook."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/loginwindow$/ nocase
    $net.principal.process.file.full_path = /\/(sh|bash|zsh|dash|ksh|tcsh|curl|wget|nscurl|python[0-9.]*|perl|ruby|osascript|php|node)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
