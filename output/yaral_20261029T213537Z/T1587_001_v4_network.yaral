/*
  MITRE Technique : T1587.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:48:45.103785+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_001_Raw_IP_Nonbrowser_HTTP_POST_Custom_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host sending an HTTP POST to an external raw-IP URL on a non-standard port using a non-browser client. This pattern is characteristic of custom-developed implants and bespoke C2 protocols (T1587.001) beaconing or exfiltrating without a resolvable domain."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.001"
    mitre_technique_name = "Develop Capabilities: Malware"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL inspection, normalised to NETWORK_HTTP with network.http.method, network.http.user_agent, target.url and target.port populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal-developed applications or IoT/OT devices posting telemetry to a raw-IP cloud endpoint, software updaters or agents that use IP-literal URLs on custom ports, authorised penetration tests and security scanners, and CI/CD or developer test traffic."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains, authorised scanner sources to %global_allowed_scanners, and approved management or IoT sources to %global_allowed_mgmt_sources. Consider raising severity for hosts that repeat this behaviour; add further approved ports by extending the port exclusions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d+)?(\/|$)/
    $net.target.port != 80
    $net.target.port != 443
    not $net.network.http.user_agent = /^mozilla\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1587.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
