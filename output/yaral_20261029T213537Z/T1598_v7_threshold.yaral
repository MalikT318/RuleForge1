/*
  MITRE Technique : T1598 - Phishing for Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:10:42.725648+00:00
  Reference       : https://attack.mitre.org/techniques/T1598
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_Credential_Form_Submission_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source submits repeated HTTP POST requests to external URLs with credential or account-verification keywords within ten minutes. Each request is benign on its own, but the volume suggests a user is entering information into phishing or credential-harvesting pages (T1598 phishing for information)."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598"
    mitre_technique_name = "Phishing for Information"
    log_prerequisites = "Requires perimeter or proxy logs normalised to NETWORK_HTTP with network.http.method, target.url, target.hostname and principal.ip populated. URL visibility requires TLS inspection or a explicit proxy."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users repeatedly signing in to legitimate SaaS or SSO portals not yet in the allowed domains list, password manager and SSO token refresh traffic, and web apps that poll login endpoints. Penetration tests and sanctioned phishing simulations can also trigger it."
    tuning_guidance = "Add known-good external login domains to %global_allowed_domains. Raise the #net threshold for large NAT egress addresses, where many users share one source IP. Add authorised testing sources to %global_allowed_scanners."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /(login|log-in|signin|sign-in|verify|validation|account|password|passwd|credential|secure|webmail|authenticate|reset)/ nocase
    $net.principal.ip = $src_ip
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1598")
    $primary_entity = array_distinct($src_ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)

  condition:
    #net >= 5
}
