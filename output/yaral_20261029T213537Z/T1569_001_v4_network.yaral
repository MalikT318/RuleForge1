/*
  MITRE Technique : T1569.001 - Launchctl
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:52:01.459937+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_001_macOS_Launchd_Child_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a process that launchd started and that runs from a temporary, shared or hidden location. This is the network footprint of a payload started via launchctl load/start as a Launch Agent or Daemon. Legitimate launchd services normally run from /Applications, /Library or /usr and are unlikely to beacon from /tmp, /Users/Shared or a hidden directory."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.001"
    mitre_technique_name = "System Services: Launchctl"
    log_prerequisites = "Requires macOS endpoint telemetry that records NETWORK_CONNECTION events with principal process path and parent process path populated (parent must resolve to launchd). Pair with PROCESS_LAUNCH and FILE_CREATION rules for the launchctl and plist side."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Self-updating third-party agents installed in /Users/Shared or hidden directories; developer tooling or build agents running as launchd jobs from temporary directories; MDM or RMM helpers staged in /private/tmp during install or upgrade; per-user menu bar apps that keep helpers in hidden folders under ~/Library."
    tuning_guidance = "Add approved RMM and deployment helper binaries to %global_allowed_admin_tools, EDR and AV agents to %global_allowed_security_tools, and approved remote support tooling to %global_allowed_remote_mgmt. Add known-good vendor destinations to %global_allowed_domains. Review %rfc1918_internal so it covers all internal ranges for the client. If parent process data is unreliable on a client, validate the field mapping before deploying."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /(^|\/)launchd$/ nocase
    (
      $net.principal.process.file.full_path = /^\/(private\/)?(tmp|var\/tmp)\// nocase or
      $net.principal.process.file.full_path = /^\/Users\/Shared\// nocase or
      $net.principal.process.file.full_path = /^\/Users\/[^\/]+\/Library\/.*\/\.[^\/]+/ nocase or
      $net.principal.process.file.full_path = /\/\.[^\/]+$/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_cmdline = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
