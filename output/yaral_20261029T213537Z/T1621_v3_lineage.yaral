/*
  MITRE Technique : T1621 - Multi-Factor Authentication Request Generation
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:33:34.874433+00:00
  Reference       : https://attack.mitre.org/techniques/T1621
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1621_Linux_Service_Parent_Spawns_Auth_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or data-tier service process (web server, PHP/app gateway, database, cache or print daemon) directly spawning a binary that starts an interactive or PAM-backed authentication (ssh, su, sudo, login, pamtester, kinit, TOTP/OTP generators). These services have no legitimate reason to start authentication flows. On hosts where PAM is wired to an MFA provider, such a child can generate push, SMS or voice MFA prompts for the targeted account, so this lineage is consistent with MFA request generation or fatigue abuse after a service compromise (for example a webshell). The rule keys on parent-child lineage rather than command-line content, so it complements command-line rules. It cannot see the MFA prompt itself; it flags the anomalous process that can trigger it."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1621"
    mitre_technique_name = "Multi-Factor Authentication Request Generation"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH, with parent process path (principal.process.file.full_path) and child process path (target.process.file.full_path) populated. PAM-based MFA on the host raises confidence but is not required for the rule to evaluate."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web-based admin panels (for example hosting control panels) that call su or sudo; database maintenance or replication jobs that launch ssh or su (backup, failover, pg_basebackup wrappers); print or CUPS filters that use su; application deployment hooks run from a service account; monitoring checks run by a service that call ssh."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Add expected automation accounts to %global_allowed_service_accounts. Extend or narrow the parent service list for the customer's stack (for example add application-server runtimes only where they are not expected to call ssh or su). Escalate if the same host later shows repeated authentication failures or MFA prompts for one user."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(ssh|sshpass|su|sudo|login|pamtester|kinit|oathtool|google-authenticator)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1621")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
