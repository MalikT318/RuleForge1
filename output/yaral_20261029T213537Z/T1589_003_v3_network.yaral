/*
  MITRE Technique : T1589.003 - Employee Names
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:10:34.269856+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_003_External_Staff_Enumeration_Web_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting web endpoints that expose employee or author names in bulk, such as CMS user-listing APIs, numeric author-ID enumeration and staff-directory exports. Adversaries use these to harvest names and derive email addresses and lures. Network-side coverage that complements any endpoint rule."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.003"
    mitre_technique_name = "Gather Victim Identity Information: Employee Names"
    log_prerequisites = "Requires proxy, WAF or perimeter logs that record inbound HTTP requests with the request URL, normalised to NETWORK_HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Search engine and SEO crawlers, uptime and content monitors, site owners or marketing staff browsing from external networks, partner integrations that read the user or author API, and unlisted authorised scanners."
    tuning_guidance = "Add authorised scanner and testing source addresses to %global_allowed_scanners and trusted admin source addresses to %global_allowed_mgmt_sources. Raise severity or add a Threshold variant keyed on source IP if a client sees repeated hits. If the client's sites do not use the matched CMS paths, narrow the regex to the staff-directory pattern."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(\/wp-json\/wp\/v2\/users|[?&]author=[0-9]+|\/(staff|employee|employees|personnel)[-_]?(directory|list|listing|export)|\/api\/(v[0-9]+\/)?(users|employees|staff)(\/|\?|$))/ nocase
    $net.network.http.response_code = 200
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1589.003")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $victim_hosts = array_distinct($net.target.hostname)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
