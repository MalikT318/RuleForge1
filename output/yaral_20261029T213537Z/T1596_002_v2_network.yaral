/*
  MITRE Technique : T1596.002 - WHOIS
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:00:56.273669+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_002_WHOIS_Outbound_Port43_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a network connection to TCP port 43 (the WHOIS protocol) on an external address, as seen by a network security appliance. Direct WHOIS lookups from internal hosts are rare in most enterprises and can indicate reconnaissance tooling, or a compromised host or analyst workstation gathering registrant, netblock and nameserver data. The rule keys on the protocol port, not on any tool, domain or WHOIS server address, so it still fires if the tool is renamed or the registry changes."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.002"
    mitre_technique_name = "Search Open Technical Databases: WHOIS"
    log_prerequisites = "Requires IDS/IPS or network security appliance connection or flow logs mapped to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated. The appliance must have visibility of egress traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Security and threat intelligence analysts running WHOIS lookups, domain and brand-protection teams, abuse and spam handling desks, mail gateways or anti-abuse tooling that query WHOIS, authorised external attack-surface scanners, and registrar or hosting administration hosts."
    tuning_guidance = "Add the source IPs of approved analyst workstations, scanners or intel tooling to %global_allowed_scanners. If the tenant has a legitimate WHOIS-heavy business function (registrar, brand protection), scope the rule by source or drop it for that tenant. Internal destinations are excluded through %rfc1918_internal. To reduce noise further, raise severity only for sources that also show other reconnaissance activity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 43
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1596.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
