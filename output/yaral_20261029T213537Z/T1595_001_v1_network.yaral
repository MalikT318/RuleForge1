/*
  MITRE Technique : T1595.001 - Scanning IP Blocks
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:51:54.582794+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_001_Inbound_External_Probe_Common_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects inbound connection attempts from external (non-internal) sources to ports commonly probed during IP block sweeps (telnet, SMB, RDP, VNC, database ports), or inbound ICMP probes from external sources. These are the per-flow artefacts of adversaries enumerating live hosts and services across an organisation's public address space. Individual hits are low fidelity; volume per source IP is the real signal, so use this rule to feed risk scoring or promote it to a threshold rule (see tuning_guidance)."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.001"
    mitre_technique_name = "Active Scanning: Scanning IP Blocks"
    log_prerequisites = "Perimeter firewall, proxy or network flow logs normalised to UDM NETWORK_CONNECTION with network.direction, principal.ip, target.port and network.ip_protocol populated. Logs must include allowed and denied/dropped connections to see scan traffic."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, uptime or availability monitors that ping public addresses, partner or customer-site VPN and remote-access users connecting to RDP or SSH, legitimate inbound SMB or database access from trusted third parties, and internet background noise from research scanners (high volume, low risk)."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners and approved remote-access source IPs to %global_allowed_mgmt_sources. Where the client publishes none of the listed services, severity can be raised. For higher fidelity, clone this rule as a Threshold rule grouped by principal.ip over 10m with a distinct target.ip count condition. Adjust the port list per client exposure."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    (
      $net.network.ip_protocol = "ICMP" or
      $net.target.port = 21 or
      $net.target.port = 23 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 8080
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1595.001")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    $net
}
