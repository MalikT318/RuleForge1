/*
  MITRE Technique : T1589.003 - Employee Names
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:10:00.630397+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_003_External_Staff_Enumeration_Web_Requests {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external client successfully (HTTP 200) requesting web endpoints that expose employee or user listings: CMS user-enumeration APIs, author-ID enumeration, collaboration-platform user lists, generic user/employee/staff API collections, and exported staff directory files. Adversaries use these to harvest employee names for email derivation and phishing lures. Network-side proxy/firewall web telemetry only."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.003"
    mitre_technique_name = "Gather Victim Identity Information: Employee Names"
    log_prerequisites = "Requires firewall, reverse-proxy or WAF logs normalised to NETWORK_HTTP with target.url, principal.ip and network.http.response_code populated. Needs visibility of inbound traffic to client-owned web properties."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate public staff directories, authorised external penetration tests or scanners, SEO and search-engine crawlers, partner integrations consuming user or people APIs, and public WordPress themes or plugins that call the users endpoint for author pages."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add approved partner source addresses to %global_allowed_mgmt_sources and extend the rule's exclusions accordingly. If a client intentionally publishes a staff directory, narrow the URL regex for that tenant. Use the alert grouping in the SOAR playbook to raise priority when one source IP triggers repeatedly."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.response_code = 200
    $http.target.url = /(\/wp-json\/wp\/v2\/users|[?&]author=[0-9]+|\/_api\/web\/(site)?users|\/_vti_bin\/listdata\.svc\/userinformationlist|\/api\/v[0-9]+\/(users|employees|staff|people)(\/|\?|$)|\/(staff|employees|team|people|directory)[-_]?(list|directory|export)?\.(csv|xlsx|json))/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1589.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
