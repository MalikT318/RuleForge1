/*
  MITRE Technique : T1592 - Gather Victim Host Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:34:03.087549+00:00
  Reference       : https://attack.mitre.org/techniques/T1592
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_External_Port_Probe_Then_Host_Fingerprint_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single external source makes repeated connections to commonly fingerprinted service ports on internal hosts, then requests configuration-disclosing or server-information URLs within ten minutes. This sequence indicates host and service reconnaissance of the victim environment."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592"
    mitre_technique_name = "Gather Victim Host Information"
    log_prerequisites = "Requires perimeter firewall connection logs (NETWORK_CONNECTION) and web proxy, reverse proxy or WAF logs (NETWORK_HTTP) with source IP, destination IP, destination port and requested URL populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, search-engine and uptime-monitoring crawlers, partner integrations that probe health or status endpoints, and penetration tests."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add known-good partner or monitoring sources to %global_allowed_mgmt_sources. Raise the #conn or #http thresholds on noisy internet-facing perimeters. If the firewall logs are post-NAT, validate that principal.ip holds the real external client address."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    not $conn.principal.ip in %rfc1918_internal
    $conn.target.ip in %rfc1918_internal
    (
      $conn.target.port = 21 or
      $conn.target.port = 22 or
      $conn.target.port = 23 or
      $conn.target.port = 25 or
      $conn.target.port = 80 or
      $conn.target.port = 110 or
      $conn.target.port = 139 or
      $conn.target.port = 143 or
      $conn.target.port = 443 or
      $conn.target.port = 445 or
      $conn.target.port = 1433 or
      $conn.target.port = 3306 or
      $conn.target.port = 3389 or
      $conn.target.port = 5900 or
      $conn.target.port = 8080 or
      $conn.target.port = 8443
    )
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    $conn.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    not $http.principal.ip in %rfc1918_internal
    $http.target.url = /(server-status|server-info|phpinfo|\.env\b|\.git\/|actuator\/(env|health|info)|web\.config|\.DS_Store|elmah\.axd|\/cgi-bin\/|\/manager\/html|\/\.well-known\/security\.txt|\/version(\.txt|\.json)?$)/ nocase
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1592")
    $primary_entity = array_distinct($src_ip)
    $probed_ports = array_distinct($conn.target.port)
    $targeted_hosts = array_distinct($conn.target.ip)
    $probed_urls = array_distinct($http.target.url)
    $connection_count = count($conn.metadata.id)

  condition:
    #conn >= 10 and #http >= 3
}
