/*
  MITRE Technique : T1595 - Active Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:50:56.888246+00:00
  Reference       : https://attack.mitre.org/techniques/T1595
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_Perimeter_HTTP_Sensitive_Path_Probing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting well-known sensitive or administrative web paths (exposed environment files, version-control metadata, admin consoles, debug and status endpoints) through a perimeter proxy or web gateway. Legitimate users do not browse to these paths. Requests for them are characteristic of automated content discovery and fingerprinting during active scanning of public-facing infrastructure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595"
    mitre_technique_name = "Active Scanning"
    log_prerequisites = "Requires firewall, proxy, WAF or web gateway logs that perform HTTP inspection and populate target.url and principal.ip (normalised to NETWORK_HTTP). Plain L3/L4 firewall logs without URL visibility will not trigger this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners or penetration tests not yet in the scanner list; external uptime or health monitors that probe status or admin endpoints; legitimate administrators reaching a public admin console (for example a CMS login page) from the internet; SEO and security-rating crawlers."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add known administrator egress addresses to %global_allowed_mgmt_sources. If a client legitimately exposes a CMS login page, trim that path from the regex for that client. Consider promoting to a Threshold rule (distinct paths per source over 10m) where alert volume is high."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(\.env|\.git\/(config|HEAD)|\.svn\/entries|\.DS_Store|\.aws\/credentials|\.htpasswd|phpmyadmin|phpinfo\.php|server-status|server-info|wp-login\.php|xmlrpc\.php|actuator\/(env|heapdump|configprops)|web\.config\.bak|config\.php\.bak|id_rsa)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1595")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_urls = array_distinct($http.target.url)
    $probed_hosts = array_distinct($http.target.hostname)
    $http_methods = array_distinct($http.network.http.method)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
