/*
  MITRE Technique : T1585 - Establish Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:34:00.190393+00:00
  Reference       : https://attack.mitre.org/techniques/T1585
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_Account_Signup_Web_Registration_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an HTTP POST to an external web endpoint whose URL path is an account-registration or sign-up flow (signup, register, create-account, join). Adversary persona and account cultivation (T1585) is largely off-network. This rule only covers cases where the activity is staged from, or proxied through, the monitored perimeter, such as an insider, a compromised host, or a red team. Treat it as a hunting-grade, low-fidelity signal and correlate it with volume or repetition downstream."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585"
    mitre_technique_name = "Establish Accounts"
    log_prerequisites = "Requires firewall or web proxy logs with HTTP inspection (URL path and method) normalised to UDM NETWORK_HTTP. TLS inspection is needed to see paths on HTTPS traffic. Without it this rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate employee sign-ups to SaaS products, vendor portals, webinar or event registrations, marketing and procurement staff registering on third-party sites, and authorised red team or brand-protection activity."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Add approved scanning or testing sources to %global_allowed_scanners. Add automation and proxy service accounts to %global_allowed_service_accounts. Raise severity only when the same source repeats registrations across many distinct domains, for example by a downstream threshold rule on $source_ips."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|join)(\/|\?|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1585")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
