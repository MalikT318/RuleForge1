/*
  MITRE Technique : T1546.014 - Emond
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:30:58.169228+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_014_Emond_Rule_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file in the emond rules directory (/etc/emond.d/rules) or the emond QueueDirectories path (/private/var/db/emondClients). Emond rule plists run arbitrary commands at system startup or user authentication, and a file in emondClients is required for the daemon to launch. Detection is at the file-artifact layer, so it still fires if command-line logging is evaded or the rule is dropped by a renamed tool, script or editor."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.014"
    mitre_technique_name = "Event Triggered Execution: Emond"
    log_prerequisites = "Requires macOS endpoint file-creation telemetry (EDR or unified log file events) covering /etc, /private/etc and /private/var/db, with the writing process populated in principal.process.file.full_path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "macOS upgrades or system restores that recreate the default emond sample rule files; legitimate admin or MDM configuration management that deploys emond rules (rare, since emond is deprecated); security agents or imaging tools that restore /etc contents."
    tuning_guidance = "Add approved deployment or configuration tooling (writer process path) to %global_allowed_admin_tools and EDR/security agents to %global_allowed_security_tools. Review OS-upgrade windows when sample rule files are recreated. Because emond is deprecated and rarely used, any remaining hit should be investigated."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/private)?\/etc\/emond\.d\/rules\/|^(\/private)?\/var\/db\/emondClients\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
