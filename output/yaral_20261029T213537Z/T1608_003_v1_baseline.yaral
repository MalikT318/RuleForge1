/*
  MITRE Technique : T1608.003 - Install Digital Certificate
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:24:29.231984+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_003_Self_Signed_TLS_Cert_External_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client completing a TLS session to an external server on a web port where the server certificate is self-signed (issuer equals subject). Adversary-installed self-signed certificates on staging or C2 infrastructure (T1608.003) are visible at the perimeter only through this result. The installation itself happens on attacker-controlled infrastructure and cannot be observed directly."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.003"
    mitre_technique_name = "Stage Capabilities: Install Digital Certificate"
    log_prerequisites = "Requires firewall or proxy telemetry with TLS inspection or TLS metadata populating network.tls.server.certificate.issuer and subject. Without these fields the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Vendor appliances, IoT or OT devices and lab or development servers with self-signed certificates; small-vendor SaaS; internal-style services exposed on public IPs; legitimate self-hosted tools such as VPN or backup portals."
    tuning_guidance = "Add known-good server names to %global_allowed_domains. Scope to the egress segment so internal and RFC1918 destinations are excluded via %rfc1918_internal. Raise severity or add a volume threshold on a per-client basis if self-signed certificates are common in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.tls.established = true
    $net.target.port = 443
    $net.network.tls.server.certificate.issuer != ""
    $net.network.tls.server.certificate.subject != ""
    $net.network.tls.server.certificate.issuer = $net.network.tls.server.certificate.subject
    not $net.target.ip in %rfc1918_internal
    not $net.network.tls.client.server_name in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1608.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $server_names = array_distinct($net.network.tls.client.server_name)
    $cert_subjects = array_distinct($net.network.tls.server.certificate.subject)

  condition:
    $net
}
