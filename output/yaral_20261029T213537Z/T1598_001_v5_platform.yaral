/*
  MITRE Technique : T1598.001 - Spearphishing Service
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:12:07.680521+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_001_Credential_Harvest_Prefilled_Email_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host requesting an external login, verification or account-style URL whose query string carries a pre-filled email address or username. Spearphishing-for-information messages delivered through third-party services (personal webmail, social media, messaging platforms) commonly link to credential-harvesting pages that pre-populate the target's address. The rule matches this URL structure, not any named service or domain, so it still fires when the attacker changes hosting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.001"
    mitre_technique_name = "Phishing for Information: Spearphishing Service"
    log_prerequisites = "Requires proxy, secure web gateway or perimeter firewall logs with URL-level visibility (normalised to NETWORK_HTTP with target.url populated). TLS inspection is needed for HTTPS paths and query strings; without it, only plain HTTP URLs are visible."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate SSO and identity-provider redirects that pass login_hint or email parameters, SaaS onboarding or invitation links, password-reset links from vendors, and marketing or survey links that pre-fill an address. Authorised phishing-awareness simulations also trigger it."
    tuning_guidance = "Add trusted identity providers, SaaS vendors and simulation platforms to %global_allowed_domains. Add URL-detonation sandboxes and authorised scanners to %global_allowed_scanners. Raise severity for users in high-risk groups, or correlate with email gateway click events downstream."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.hostname != ""
    $http.network.http.method = "GET" nocase
    $http.target.url = /\/(login|log-in|signin|sign-in|verify|validate|auth|account|secure|webmail|password)[^?#]*\?[^#]*(email|e-mail|mail|user|username|login_hint|rcpt|account)=[^&#\s]*(@|%40)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1598.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)
    $source_user = array_distinct($http.principal.user.userid)

  condition:
    $http
}
