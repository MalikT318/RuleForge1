/*
  MITRE Technique : T1059.002 - AppleScript
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:36:32.373527+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_002_AppleScript_Artifact_Written_To_Execution_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an AppleScript artifact (.scpt, .scptd, .applescript) in a location used for staging or for automatic AppleScript execution: temp directories, shared or Downloads folders, per-user Application Scripts (Mail rules, Calendar alarms), and Folder Action Scripts. This is the file-state result of AppleScript abuse and fires regardless of how the script is later launched (osascript, NSAppleScript, OSAScript, Automator, Mail rules, Folder Actions), so it still works when command-line logging is evaded."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.002"
    mitre_technique_name = "Command and Scripting Interpreter: AppleScript"
    log_prerequisites = "macOS endpoint telemetry that records file creation events with the writing process path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Users or admins building Mail rules, Calendar alarms or Folder Actions with Script Editor or Automator; IT management and deployment tooling that drops compiled AppleScripts into user Library paths; software installers unpacking AppleScript-based helpers to temp folders; developers compiling AppleScripts."
    tuning_guidance = "Add approved management and deployment binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. If a specific Application Scripts location is noisy, narrow the path regex rather than disabling the rule. Raise severity for hosts with no history of AppleScript use."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(private\/)?(tmp|var\/tmp|var\/folders)\/.*\.(scpt|scptd|applescript)$|^\/Users\/(Shared|[^\/]+\/(Downloads|Library\/(Application Scripts|Scripts\/Folder Action Scripts)))\/.*\.(scpt|scptd|applescript)$|^\/Library\/Scripts\/Folder Action Scripts\/.*\.(scpt|scptd|applescript)$/ nocase
    not $file.principal.process.file.full_path = /\/(Script Editor|installer|softwareupdated)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $script_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
