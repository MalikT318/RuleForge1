/*
  MITRE Technique : T1591.003 - Identify Business Tempo
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:30:35.796008+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_003_Automated_Business_Tempo_Page_Harvesting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external, non-browser HTTP client (scripting or HTTP-library user agent) requesting web resources that disclose business tempo, such as operating hours, holiday or shipping schedules, delivery calendars and maintenance windows. Adversaries collect this information before targeting, for example to time phishing or intrusion for when staffing is low. Written for pre-compromise, external-facing telemetry as seen by an IDS/IPS or network security appliance, with HTTP inspection populating NETWORK_HTTP events. The alternate-platform angle is not applied because the PRE platform requirement takes precedence."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.003"
    mitre_technique_name = "Gather Victim Org Information: Identify Business Tempo"
    log_prerequisites = "IDS/IPS or network security appliance with HTTP inspection that populates target.url and network.http.user_agent in NETWORK_HTTP events for inbound traffic to externally hosted web properties."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and synthetic monitoring, partner or customer integrations polling schedule pages through scripts, mobile apps built on HTTP libraries, and legitimate price or schedule aggregators."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners. Narrow the URL regex to the business-tempo paths your client actually publishes. For high-traffic sites, raise severity only when the same source is also seen in other reconnaissance rules for this technique."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(business|opening|store|office|working|operating|support|service)[-_ ]?(hours|times)|\/(holiday|shipping|delivery|shipment|maintenance|release|purchasing|ordering)[-_ ]?(schedule|calendar|dates|windows?)|\/(hours|schedule|calendar)(\/|\?|$)/ nocase
    $http.network.http.user_agent = /(?i)(curl|wget|python-requests|python-urllib|go-http-client|libwww|scrapy|httpclient|okhttp|java\/|node-fetch|axios|powershell|^$)/
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1591.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
