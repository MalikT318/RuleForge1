/*
  MITRE Technique : T1598 - Phishing for Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:10:06.646436+00:00
  Reference       : https://attack.mitre.org/techniques/T1598
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_Credential_Form_Post_To_IP_Literal_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal client submitting an HTTP POST to a credential-themed URL (login, signin, verify, password, webmail and similar) on an external host addressed by a raw IP literal. Legitimate identity providers and SaaS logins are served from named domains. A form submission to a bare IP is a strong indicator of a credential-harvesting page reached through a phishing-for-information lure, whether delivered by email, chat or a callback scam."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598"
    mitre_technique_name = "Phishing for Information"
    log_prerequisites = "Requires forward or transparent proxy, or a perimeter firewall with HTTP inspection, that logs the HTTP method and full URL. TLS decryption is needed to see the URL and method of HTTPS traffic. Without it, the rule only sees plain HTTP."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal or lab web applications reached by IP literal, IoT or appliance admin consoles, captive portals, network device management pages, and developer or test servers on public IPs."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. The target.ip exclusion already drops internal space through %rfc1918_internal. Extend the credential keyword set in the URL regex to suit client portals. If a client legitimately uses IP-addressed external portals, scope the exclusion by client policy rather than loosening the regex."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /^(https?:\/\/)?[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]{1,5})?\/.*(login|log-in|signin|sign-in|logon|verify|validate|password|passwd|credential|account|webmail|owa|sso|auth|secure)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1598")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
