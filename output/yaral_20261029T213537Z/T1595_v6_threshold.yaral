/*
  MITRE Technique : T1595 - Active Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:51:32.581452+00:00
  Reference       : https://attack.mitre.org/techniques/T1595
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_Inbound_Multi_Port_Connection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source IP opens a high volume of connections to internal addresses on non-web ports within ten minutes. Each connection is benign on its own, but the volume is consistent with port sweeps and service discovery against perimeter infrastructure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595"
    mitre_technique_name = "Active Scanning"
    log_prerequisites = "Requires firewall or perimeter network connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, including inbound allowed and denied connections."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and external attack-surface monitoring not yet in the allowlist, uptime and health-check monitors, partner or VPN concentrators with heavy legitimate inbound traffic, mail or VoIP peers using many non-web ports, and misconfigured clients retrying aggressively."
    tuning_guidance = "Add known scanner and monitoring source IPs to %global_allowed_scanners. Raise the #net threshold on noisy perimeters or lower it for quiet ones. Review the distinct_target_ports and distinct_target_ips outcome values to separate port sweeps (many ports) from host sweeps (many hosts)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1595")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $distinct_target_ports = array_distinct($net.target.port)
    $distinct_target_ips = array_distinct($net.target.ip)

  condition:
    #net >= 50
}
