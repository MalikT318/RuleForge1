/*
  MITRE Technique : T1592.003 - Firmware
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:38:54.267274+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_003_External_Probe_Of_Firmware_Management_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects connections from external address space to out-of-band firmware management services (IPMI/RMCP and Intel AMT/vPro). Adversaries probe these services to fingerprint host firmware type and version for later targeting. Reaching them from the internet is rarely legitimate."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.003"
    mitre_technique_name = "Gather Victim Host Information: Firmware"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must show the pre-NAT or externally visible source address."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners or attack-surface monitoring, managed-service or hardware vendor remote support reaching BMC/AMT interfaces, internet-wide research scanners (Shodan-style) that generate noise on exposed services."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners and approved remote management or vendor support sources to %global_allowed_mgmt_sources. If a client legitimately exposes AMT or IPMI through a VPN concentrator, add that address to %global_allowed_mgmt_sources. Any hit that is not on these lists should be treated as an exposure finding, and the management interface should be removed from the internet."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 623 or
      $net.target.port = 664 or
      ($net.target.port >= 16992 and $net.target.port <= 16995)
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1592.003")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
