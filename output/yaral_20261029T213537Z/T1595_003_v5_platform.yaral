/*
  MITRE Technique : T1595.003 - Wordlist Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:56:50.426182+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_003_External_Probe_Of_Hidden_Content_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting a commonly enumerated hidden, backup, or administrative content path (VCS metadata, environment files, config files, database dumps, admin portals) and receiving a 403 or 404 response. This is the per-request footprint of wordlist-driven content discovery against public web infrastructure. The rule uses only perimeter-observable HTTP fields, not endpoint process data, and does not depend on the OS of the scanning host. It complements command-line based detections by covering the target side of the scan."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.003"
    mitre_technique_name = "Active Scanning: Wordlist Scanning"
    log_prerequisites = "Requires perimeter web telemetry with URL inspection that populates target.url and network.http.response_code (reverse proxy, secure web gateway, or firewall with HTTP/URL logging). Pure L3/L4 firewall logs without URL data cannot evaluate this rule."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and external attack-surface management services; search engine and SEO crawlers requesting stale URLs; uptime monitors; legitimate users following old bookmarks to retired admin or backup paths; internal penetration tests."
    tuning_guidance = "Add authorised scanner and ASM source addresses to %global_allowed_scanners. This rule is intentionally low severity per event. Use the $primary_entity output to count hits per source in SOAR or a companion threshold rule, and escalate sources with many distinct paths. Extend or trim the path regex to match the web stacks protected for each client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    not $http.principal.ip in %rfc1918_internal
    $http.network.http.response_code >= 403
    $http.network.http.response_code <= 404
    $http.target.url = /(\/\.(git|svn|hg)\/(config|HEAD|entries)|\/\.env(\.|$|\?)|\/\.htpasswd|\/\.htaccess|\/\.ds_store|\/\.aws\/credentials|\/phpinfo\.php|\/wp-config\.php|\/web\.config|\/server-status|\/phpmyadmin|\/(admin|administrator|backup|backups|dump|db)(\/|\?|$)|\.(bak|old|orig|sql|swp|tar\.gz|zip)(\?|$))/ nocase
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1595.003")
    $primary_entity = array_distinct($http.principal.ip)
    $probed_urls = array_distinct($http.target.url)
    $response_codes = array_distinct($http.network.http.response_code)
    $targeted_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
