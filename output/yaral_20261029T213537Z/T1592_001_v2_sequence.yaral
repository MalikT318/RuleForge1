/*
  MITRE Technique : T1592.001 - Hardware
  Tactic(s)       : Reconnaissance
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:35:47.941716+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_001_External_Device_Port_Probe_Then_Hardware_Info_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An external source connects to device and hardware management service ports (SNMP, IPMI, printer, VNC, ICS protocols) and then requests hardware or device-information web endpoints within ten minutes. This sequence is consistent with reconnaissance to fingerprint the victim's hardware model, serial or banner."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.001"
    mitre_technique_name = "Gather Victim Host Information: Hardware"
    log_prerequisites = "Requires perimeter firewall connection logs and proxy, reverse-proxy or inspecting-firewall HTTP logs with the request URL populated. Both must record the external source address in principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability or attack-surface scanners not yet allowlisted, partner or MSP monitoring platforms polling devices, vendor remote-support tools, search-engine or internet-census crawlers touching exposed devices, and legitimate remote administrators of exposed appliances."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Add approved partner or management source addresses to %global_allowed_mgmt_sources. Adjust the device port list if the client legitimately exposes these services. Raise severity for sources that also appear in other reconnaissance detections."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
      $conn.target.port = 161 or
      $conn.target.port = 502 or
      $conn.target.port = 623 or
      $conn.target.port = 631 or
      $conn.target.port = 5900 or
      $conn.target.port = 9100 or
      $conn.target.port = 47808
    )
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    $conn.principal.ip = $src

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(cgi-bin\/)?(sysinfo|system[_\-]?info|hwinfo|hardware|device[_\-]?info|get[_\-]?info|serial|model)(\.(cgi|php|json|xml|html|asp|aspx))?(\?|\/|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src

    $conn.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1592.001")
    $primary_entity = array_distinct($src)
    $probed_ports = array_distinct($conn.target.port)
    $probed_targets = array_distinct($conn.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $connection_count = count($conn.metadata.id)

  condition:
    $conn and $http
}
