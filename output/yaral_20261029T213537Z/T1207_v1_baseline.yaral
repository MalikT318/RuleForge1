/*
  MITRE Technique : T1207 - Rogue Domain Controller
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:14:36.447207+00:00
  Reference       : https://attack.mitre.org/techniques/T1207
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1207_Rogue_DC_Registration_NTDSDSA_Or_DRS_SPN {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a process launched with a command line that creates or manipulates nTDSDSA/server objects in the AD Configuration partition, or that registers the directory replication (DRS) SPN GUID on a computer object. These are the core steps of registering a rogue domain controller (DCShadow). The rule keys on the AD objects and protocol identifiers the technique depends on, not on any tool name."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1207"
    mitre_technique_name = "Rogue Domain Controller"
    log_prerequisites = "Requires Windows process creation telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled) from domain-joined workstations, servers and domain controllers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate domain controller promotion or demotion, AD migration and consolidation tooling, scripted AD site/server provisioning by administrators, and AD health or replication-audit scripts that query nTDSDSA objects."
    tuning_guidance = "Add approved AD provisioning and migration tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and named AD administrators to %global_allowed_admin_users. Validate any hit against recent DC promotion change tickets before closing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.command_line = /ntdsdsa/ nocase and
        $proc.target.process.command_line = /(cn=sites|cn=configuration|cn=servers|objectclass)/ nocase
      )
      or
      (
        $proc.target.process.command_line = /e3514235-4b06-11d1-ab04-00c04fc2dcd2/ nocase and
        $proc.target.process.command_line = /(setspn|serviceprincipalname|\bspn\b|set-adcomputer|adsi|directoryservices)/ nocase
      )
    )
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1207")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $process_path = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
