/*
  MITRE Technique : T1585.001 - Social Media Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:36:10.619640+00:00
  Reference       : https://attack.mitre.org/techniques/T1585/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1585_001_Repeated_External_Account_Signup_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Low"
    description = "A single internal source submits repeated HTTP POST requests to account-registration or signup URL paths on external sites within ten minutes. This is a network-observable proxy for bulk persona or social media account creation staged from inside the environment, for example a compromised host or an analyst workstation used for persona building. A single signup is benign, but repeated signups from one source are not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1585.001"
    mitre_technique_name = "Establish Accounts: Social Media Accounts"
    log_prerequisites = "Requires perimeter or proxy HTTP logs with URL path and HTTP method populated (for example SSL-inspected web proxy or firewall URL logging). Without TLS inspection the URL path is not visible and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Marketing or social media teams managing corporate brand accounts, employees registering for SaaS trials, webinars or vendor portals, QA or developer automation testing signup flows, and penetration testers or red teams running authorised activity."
    tuning_guidance = "Add known-good sites to %global_allowed_domains. Add sanctioned scanners and test sources to %global_allowed_scanners. Add approved automation and service accounts to %global_allowed_service_accounts. Raise the #http threshold in noisy environments. Because the rule only sees traffic leaving the monitored network, treat hits as indicators of staging activity and not as confirmation of the technique."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /\/(signup|sign-up|sign_up|register|registration|join|create[-_]?account|accounts?\/new)(\/|\?|$)/ nocase
    $http.principal.ip = $src_ip
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.user.userid in %global_allowed_service_accounts

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(45)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1585.001")
    $primary_entity = array_distinct($src_ip)
    $signup_sites = array_distinct($http.target.hostname)
    $signup_urls = array_distinct($http.target.url)

  condition:
    #http >= 5
}
