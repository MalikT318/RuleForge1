/*
  MITRE Technique : T1608.006 - SEO Poisoning
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:30:46.789581+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_006_Search_Referred_Executable_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a proxy or firewall HTTP transaction where a user is referred from a search-results page (the referrer carries a search query parameter) and lands directly on an external download of an executable, installer, script, disk image or archive. This is the victim-side network footprint of SEO poisoning, where a poisoned search result leads to a staged payload (Drive-by Target / Supply Chain lure)."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.006"
    mitre_technique_name = "Stage Capabilities: SEO Poisoning"
    log_prerequisites = "Requires proxy or firewall logs with full HTTP inspection that populate network.http.referral_url and target.url (TLS inspection is needed for HTTPS traffic)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users who search for legitimate software and download it from a vendor site not yet in the allowlist; developers fetching tools or packages from search results; IT staff downloading drivers or installers; documentation sites that serve archives or PDFs reached via site search."
    tuning_guidance = "Add known-good vendor, CDN and software distribution domains to %global_allowed_domains. Narrow or widen the download extension list to match client policy. Review severity upward for user segments that are not permitted to download software. Internal destinations are already excluded via %rfc1918_internal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.referral_url = /[?&#](q|query|search|search_query|keyword|keywords|text|wd)=[^&]+/ nocase
    $http.target.url = /\.(exe|msi|msix|scr|iso|img|zip|rar|7z|js|jse|vbs|ps1|bat|hta|dmg|pkg|apk)(\?|#|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1608.006")
    $primary_entity = array_distinct($http.principal.ip)
    $download_urls = array_distinct($http.target.url)
    $referrer_urls = array_distinct($http.network.http.referral_url)
    $destination_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
