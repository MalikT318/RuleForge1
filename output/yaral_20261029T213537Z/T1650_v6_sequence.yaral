/*
  MITRE Technique : T1650 - Acquire Access
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:37:22.238491+00:00
  Reference       : https://attack.mitre.org/techniques/T1650
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1650_DNS_TXT_Query_Then_Long_Label_Tunnel_Pattern {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single client issues TXT or NULL record queries and then queries abnormally long, encoded-looking subdomain labels under the same registered domain within 10 minutes. This pattern is consistent with a brokered implant or loader using DNS for tasking and data transfer. It is a network-side indicator of access that may have been sold or shared (T1650), and is a proxy rather than direct proof of the acquisition itself."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1650"
    mitre_technique_name = "Acquire Access"
    log_prerequisites = "Requires DNS query or resolver logs normalised to NETWORK_DNS with network.dns.questions.name, network.dns.questions.type and principal.ip populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security and anti-spam DNSBL/SPF lookups (TXT), DKIM/DMARC validation, domain-ownership verification by SaaS onboarding, CDN and cloud services using long hashed hostnames, security vendor reputation lookups, and software update services."
    tuning_guidance = "Add known-good domains (full query names as stored in the list) to %global_allowed_domains. If resolver logs only show the resolver address as principal.ip, ingest the forwarded client address or move the join to a more specific field. Lower or raise the 40-character label threshold per environment."

  events:
    $txt.metadata.event_type = "NETWORK_DNS"
    ($txt.network.dns.questions.type = 16 or $txt.network.dns.questions.type = 10)
    $txt.network.dns.questions.name != ""
    not $txt.network.dns.questions.name in %global_allowed_domains
    $txt.principal.ip = $client
    $domain = re.capture($txt.network.dns.questions.name, "([^.]+\\.[^.]+)$")
    $domain != ""

    $lbl.metadata.event_type = "NETWORK_DNS"
    $lbl.network.dns.questions.name = /[a-z0-9_-]{40,}\.[^.]+\.[^.]+$/ nocase
    not $lbl.network.dns.questions.name in %global_allowed_domains
    $lbl.principal.ip = $client
    $domain = re.capture($lbl.network.dns.questions.name, "([^.]+\\.[^.]+)$")

    $txt.metadata.event_timestamp.seconds <= $lbl.metadata.event_timestamp.seconds

  match:
    $client, $domain over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1650")
    $primary_entity = array_distinct($client)
    $queried_domain = array_distinct($domain)
    $long_label_queries = count($lbl.metadata.id)
    $txt_null_queries = count($txt.metadata.id)
    $sample_names = array_distinct($lbl.network.dns.questions.name)

  condition:
    $txt and $lbl
}
