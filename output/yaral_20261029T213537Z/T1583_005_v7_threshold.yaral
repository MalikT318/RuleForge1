/*
  MITRE Technique : T1583.005 - Botnet
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:08:41.850713+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_005_DNS_Botnet_Style_Query_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single client issues a high volume of DNS queries for algorithmically generated or abnormally long-label domains within ten minutes. This is the resolver-side signature of botnet membership, such as DGA-based C2 rendezvous, and of ORB or proxy-botnet nodes. Any one query is benign; the volume is not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.005"
    mitre_technique_name = "Acquire Infrastructure: Botnet"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS with principal.ip (client) and network.dns.questions.name populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "CDN and cloud provider hostnames with long hashed labels, email security and anti-spam DNS blocklist lookups, software update and telemetry services, DKIM or other TXT-based service lookups, security scanners and DNS-based reputation checks, and browsers prefetching tracking domains."
    tuning_guidance = "Add known-good parent domains to %global_allowed_domains. Add authorised scanners to %global_allowed_scanners. If the resolver is a shared forwarder, ensure principal.ip reflects the real client, otherwise the grouping spans many users. Raise the #dns threshold for noisy environments."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9\-]{32,}\.|[bcdfghjklmnpqrstvwxz]{8,}/ nocase
    not $dns.network.dns.questions.name = /\.(arpa|local|internal|lan)$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $client

  match:
    $client over 10m

  outcome:
    $query_count = count($dns.metadata.id)
    $risk_score = max(if($query_count >= 100, 85, if($query_count >= 50, 70, 55)))
    $mitre_technique_id = array_distinct("T1583.005")
    $primary_entity = array_distinct($client)
    $sample_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    #dns >= 20
}
