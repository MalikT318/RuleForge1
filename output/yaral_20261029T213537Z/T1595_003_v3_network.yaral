/*
  MITRE Technique : T1595.003 - Wordlist Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:56:12.076910+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_003_Wordlist_Scan_Sensitive_Path_Probe_NetHTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting a well-known content-discovery target (VCS metadata, environment/config files, backup or dump artifacts, server status pages) and receiving a 403/404 response. Probing for files that rarely exist on a given host, and getting 'not found' or 'forbidden' back, is typical of wordlist-driven content discovery. The rule matches the observable request pattern and response, not a scanner's name or user-agent."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.003"
    mitre_technique_name = "Active Scanning: Wordlist Scanning"
    log_prerequisites = "Requires perimeter or proxy HTTP telemetry (web proxy, reverse proxy, WAF or firewall with URL logging) normalised to NETWORK_HTTP, with principal.ip, target.url, network.http.method and network.http.response_code populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and external attack-surface assessments, SEO and uptime crawlers, security researchers' benign internet-wide scans, and misconfigured clients requesting stale backup or config URLs."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add known partner or monitoring sources to %global_allowed_mgmt_sources if appropriate for the tenant. Because one hit is low-fidelity on its own, use the alert as an enrichment pivot: raise severity when the same $primary_entity triggers repeatedly across alerts. Extend the path regex per client technology stack."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD)$/ nocase
    $http.target.url = /\/(\.git\/(config|HEAD|index)|\.svn\/entries|\.env|\.htpasswd|\.htaccess|\.DS_Store|wp-config\.php[~.a-z]*|phpinfo\.php|server-status|server-info|[^\/?#]+\.(bak|old|orig|sql|swp|zip|tar\.gz|tgz|7z))([?#]|$)/ nocase
    $http.network.http.response_code >= 403
    $http.network.http.response_code <= 404
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1595.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $target_hosts = array_distinct($http.target.hostname)
    $response_codes = array_distinct($http.network.http.response_code)

  condition:
    $http
}
