/*
  MITRE Technique : T1589 - Gather Victim Identity Information
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:04:29.269843+00:00
  Reference       : https://attack.mitre.org/techniques/T1589
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_External_User_Enumeration_Web_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting web endpoints that expose or confirm user identities (CMS user listings, author-ID iteration, webfinger account lookups, Autodiscover lookups keyed on an email address, and user-list REST APIs). These requests are typical of adversaries harvesting valid usernames and email addresses before credential attacks or phishing. This is network-side coverage and does not depend on endpoint process telemetry."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589"
    mitre_technique_name = "Gather Victim Identity Information"
    log_prerequisites = "Requires inbound web traffic logged as NETWORK_HTTP with target.url and principal.ip populated, such as reverse proxy, WAF, or perimeter proxy logs in front of internet-facing web applications."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate mobile or desktop mail clients using Autodiscover or webfinger, CMS themes and plugins that query the public user REST endpoint, SEO crawlers and search engine bots requesting author archive pages, authorised external penetration tests or vulnerability scans, and first-party API consumers calling user-list APIs."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add trusted partner or management source addresses to %global_allowed_mgmt_sources. Add sanctioned external domains to %global_allowed_domains if the target hostname is a vendor-managed site. If the rule is noisy, restrict to sites that do not intentionally publish user data, or convert it to a Threshold rule grouped by principal.ip."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.ip != ""
    $http.target.url = /(\/wp-json\/wp\/v2\/users|[?&]author=\d+|\/\.well-known\/webfinger\?.*resource=acct:|\/autodiscover\/autodiscover\.(json|xml).*[?&=]\S+@\S+|\/api\/v\d+\/users(\/|\?|$)|\/rest\/api\/\d+\/user(\/|\?|$)|\/_users\/|\/user\/(lookup|search|exists)\b)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1589")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
