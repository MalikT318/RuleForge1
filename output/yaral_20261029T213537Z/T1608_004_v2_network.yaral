/*
  MITRE Technique : T1608.004 - Drive-by Target
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:26:38.120289+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_004_External_Web_Content_Write_Via_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external (non-internal) client successfully writing script or web-page content to a web server using HTTP write methods (PUT, MOVE, COPY). Staging drive-by content by injecting or uploading malicious JavaScript or HTML into a site shows up on the network as this pattern. Logic keys on the method, the web-content file type and a successful response, not on any tool name or indicator."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.004"
    mitre_technique_name = "Stage Capabilities: Drive-by Target"
    log_prerequisites = "Requires firewall, reverse-proxy or WAF perimeter logs normalised to NETWORK_HTTP, with HTTP method, target URL, source IP and response code populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate WebDAV or CMS publishing from external editors or contractors, CI/CD or deployment pipelines pushing static site content, authorised vulnerability scanners testing PUT methods, and managed hosting providers updating customer sites."
    tuning_guidance = "Add authorised publishing and deployment source addresses to %global_allowed_mgmt_sources, authorised scanners to %global_allowed_scanners, and known publishing hostnames or accounts to %global_allowed_admin_users. If the proxy does not log response codes, remove the response_code condition and raise the review priority instead."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(PUT|MOVE|COPY)$/ nocase
    $http.target.url = /\.(js|html?|php[0-9]?|aspx?|jsp|jspx|svg)(\?.*)?$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1608.004")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $written_urls = array_distinct($http.target.url)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
