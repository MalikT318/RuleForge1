/*
  MITRE Technique : T1583.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:09:41.998734+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_006_Outbound_Web_Service_Account_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal client sending an HTTP POST to an external web service URL that looks like an account sign-up or registration endpoint. Adversaries registering throwaway accounts on public web services for later C2, exfiltration or phishing use generate this pattern when the registration is made from the monitored network. Detection is based on the behaviour (POST to a registration-style path on an external destination), not on specific service names or domains."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.006"
    mitre_technique_name = "Acquire Infrastructure: Web Services"
    log_prerequisites = "Requires firewall or proxy logs with HTTP inspection (URL and method populated, including TLS-inspected traffic) normalised to NETWORK_HTTP. Without TLS inspection, URL paths are not visible and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Employees signing up for legitimate SaaS or trial services, developers registering for API or package-registry accounts, marketing and recruiting staff creating accounts on third-party platforms, shadow IT adoption, and security staff or red teams performing authorised research."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Add authorised testing sources to %global_allowed_scanners. Add approved proxy or egress addresses that should be ignored to %global_allowed_mgmt_sources. Consider raising severity for high-value user segments or when the activity occurs on servers, which should rarely register web accounts."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(sign[-_]?up|register|registration|create[-_]?account|new[-_]?account|join|accounts?\/new|users?\/new)(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1583.006")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
