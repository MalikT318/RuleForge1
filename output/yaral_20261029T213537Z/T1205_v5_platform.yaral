/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:13:35.983731+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_Windows_External_Source_To_Hidden_Admin_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-RFC1918) source opening a connection through the perimeter to an internal host on a Windows remote-administration port (RDP, WinRM, SMB, RPC endpoint mapper). Port-knocking and magic-packet implants on Windows hosts open or unlock these listeners only after a signal sequence, so an unexpected external session to one of them is the network-observable result of traffic signaling. Pair with the sequence or threshold variants for the knock pattern itself."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover inbound traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate published RDP gateways or VPN-less remote administration, WinRM management from managed service provider networks, authorised vulnerability scanners and penetration tests, partner SMB file exchange, and internet-wide scanner noise where the firewall permits the session."
    tuning_guidance = "Add approved remote administration source addresses to %global_allowed_mgmt_sources, authorised scanner sources to %global_allowed_scanners, and approved remote-management tooling sources to %global_allowed_remote_mgmt. If the client intentionally publishes one of these ports, exclude it by narrowing the port list for that tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 445 or
      $net.target.port = 135
    )
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
