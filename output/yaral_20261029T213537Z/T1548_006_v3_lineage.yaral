/*
  MITRE Technique : T1548.006 - TCC Manipulation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:35:25.533245+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_006_macOS_Unexpected_Parent_Spawns_Interpreter_TCC_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter, or TCC-relevant utility (sqlite3, tccutil) launched directly by a parent process that should not spawn one: Finder (holds Full Disk Access), Office applications, web browsers, web or application servers, the print spooler, or a database service. Adversaries abuse TCC-privileged applications by using them to execute code, inheriting the parent's TCC grants, or exploit a service to run commands that modify the TCC database. The rule keys on parent-child lineage, not command-line content."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.006"
    mitre_technique_name = "Abuse Elevation Control Mechanism: TCC Manipulation"
    log_prerequisites = "macOS endpoint telemetry that populates both parent (principal.process) and child (target.process) executable paths on process launch events, for example EDR or Endpoint Security framework data."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Finder-initiated launch of user-opened .command or .sh scripts on some EDR sensors; Office macros or add-ins legitimately calling osascript (Outlook and Word automation); developer web stacks (httpd, nginx, php-fpm) running shell-based CGI or deploy hooks; MDM or admin scripts launched from a database or application service; print drivers invoking helper scripts via cupsd."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. On developer fleets, consider removing web server parents from the parent regex or scoping by host group."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(\/Finder\.app\/Contents\/MacOS\/Finder|\/Microsoft (Word|Excel|PowerPoint|Outlook)\.app\/Contents\/MacOS\/Microsoft (Word|Excel|PowerPoint|Outlook)|\/Safari\.app\/Contents\/MacOS\/Safari|\/(httpd|nginx|php-fpm|cupsd|mysqld|postgres|mongod))$/ nocase
    $proc.target.process.file.full_path = /\/(bin\/(sh|bash|zsh|dash|ksh|csh|tcsh)|usr\/bin\/(osascript|python3?|perl|ruby|sqlite3|tccutil))$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
