/*
  MITRE Technique : T1608.002 - Upload Tool
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:23:56.022369+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_002_External_Tool_Download_Then_Followon_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An internal host downloads an executable, script or archive over HTTP from an external server, then connects to the same external IP on a non-web port within 10 minutes. This pattern suggests a tool staged on third-party or adversary-controlled infrastructure (T1608.002) being pulled and followed by direct communication with the same host."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.002"
    mitre_technique_name = "Stage Capabilities: Upload Tool"
    log_prerequisites = "Requires proxy or perimeter logs normalised to NETWORK_HTTP (with target.url and principal.hostname) and firewall NETWORK_CONNECTION logs with target.ip, target.port and principal.hostname."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software update mechanisms and vendor installers that download packages and then connect to the same CDN IP on a custom port, developers fetching build artifacts, admins pulling tooling from self-managed external repositories, and remote support tools."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Review noisy hosts and widen the extension regex or port exclusions per client. If proxy logs lack principal.hostname, adjust the join to use principal.ip."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(exe|dll|msi|ps1|bat|vbs|jar|sh|elf|zip|7z|rar|tar|gz|iso)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.hostname = $hostname
    $http.target.ip = $dest_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.principal.hostname = $hostname
    $net.target.ip = $dest_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $dest_ip over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1608.002")
    $primary_entity = array_distinct($hostname)
    $downloaded_urls = array_distinct($http.target.url)
    $followon_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $http and $net
}
