/*
  MITRE Technique : T1553.001 - Gatekeeper Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:39:42.522626+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_001_macOS_Gatekeeper_Quarantine_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects macOS command-line actions that disable Gatekeeper system-wide (spctl --master-disable or --global-disable) or turn off the Launch Services quarantine flag (defaults write LSQuarantine to false/0). Either change lets untrusted downloaded applications run without the Gatekeeper prompt."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.001"
    mitre_technique_name = "Subvert Trust Controls: Gatekeeper Bypass"
    log_prerequisites = "macOS endpoint telemetry that records process launches with full command lines (EDR or unified log based process execution events)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or configuration-management scripts that adjust Gatekeeper policy during provisioning, IT staff preparing developer or lab machines, and software packagers or developers testing unsigned builds."
    tuning_guidance = "Add approved MDM/deployment binaries to %global_allowed_admin_tools (matched against the parent process path) and named administrators to %global_allowed_admin_users. Developer and build hosts that legitimately disable Gatekeeper should be handled by per-client allowlisting, not by relaxing the command-line logic."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/spctl$/ nocase and
        $proc.target.process.command_line = /--(master|global)-disable/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\/defaults$/ nocase and
        $proc.target.process.command_line = /\bwrite\b/ nocase and
        $proc.target.process.command_line = /LSQuarantine/ nocase and
        $proc.target.process.command_line = /(-bool\s+(no|false)|-int\s+0|\s0\s*$)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
