/*
  MITRE Technique : T1219.003 - Remote Access Hardware
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:17:13.115985+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_003_Linux_Udev_Spawns_Interpreter_Remote_HW {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the Linux device manager (systemd-udevd/udevd) spawning a shell, script interpreter, network relay utility, or a binary from a world-writable directory. Attaching remote access hardware such as an IP-KVM, HID gadget or USB-attached KVM adapter fires udev events. An attacker can abuse these events to run a script that configures or enables the device, or to establish persistence for it. This rule pivots on the anomalous parent-child lineage and does not match command-line content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.003"
    mitre_technique_name = "Remote Access Software: Remote Access Hardware"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry with populated parent and child process image paths (principal.process.file.full_path and target.process.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Distribution udev rules that legitimately use RUN+= with /bin/sh (storage, LVM/mdadm, multipath, power management, docking stations, printer or scanner hotplug), hardware provisioning scripts, laptop docking and KVM-switch management software, and VM or cloud agents that react to device hotplug."
    tuning_guidance = "Add hosts or parent process paths with known hotplug scripting to %global_allowed_script_hosts. Add approved provisioning or hardware management tooling to %global_allowed_admin_tools. Correlate hits with USB device attach events (new HID or gadget devices) in the same time window. Raise severity on servers where hotplug is not expected."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(systemd-udevd|udevd)$/ nocase
    $proc.target.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm)\/)|(\/(sh|bash|dash|zsh|ksh|python[0-9.]*|perl|ruby|php|nc|ncat|socat)$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1219.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
