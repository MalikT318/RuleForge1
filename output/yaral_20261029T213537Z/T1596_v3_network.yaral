/*
  MITRE Technique : T1596 - Search Open Technical Databases
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:57:33.314667+00:00
  Reference       : https://attack.mitre.org/techniques/T1596
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_Outbound_WHOIS_Query_To_External_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal host opening a connection to an external server on TCP/43, the WHOIS protocol port. WHOIS lookups are a way to search open technical databases for registration data on domains and IP blocks. Most internal hosts never query WHOIS directly, so this is a protocol-level signal of manual or scripted reconnaissance. Adversary queries made from their own infrastructure are not visible to the victim network, so this covers only queries originating from inside the monitored perimeter."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596"
    mitre_technique_name = "Search Open Technical Databases"
    log_prerequisites = "Requires IPS or network security appliance connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for outbound traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Network or security staff running WHOIS lookups, domain and brand-protection tooling, mail gateways or anti-spam systems doing registration checks, authorised external attack-surface scanners, and IT inventory scripts."
    tuning_guidance = "Add authorised scanner and analyst source addresses to %global_allowed_scanners. Add approved management or jump-host sources to %global_allowed_mgmt_sources. If a client has a legitimate WHOIS-heavy workflow such as a domain registrar function, scope the rule by source address with these lists. Raise severity only if the same source repeats lookups across many destinations."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 43
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1596")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $source_hosts = array_distinct($net.principal.hostname)

  condition:
    $net
}
