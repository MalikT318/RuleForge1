/*
  MITRE Technique : T1574.004 - Dylib Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:53:57.379074+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_004_macOS_Staged_App_Bundle_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS application bundle executable running from a user-writable staging location (Downloads, Desktop, /Users/Shared, /tmp, /private/var/tmp) that makes an outbound connection to a non-internal address. Dylib hijacking is often performed by copying a legitimate, hijackable application into a writable directory and planting a rogue dylib at an @rpath or weak-link location. The planted dylib then inherits the host process's network access. This rule observes the network side-effect and does not depend on process command-line matching."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.004"
    mitre_technique_name = "Hijack Execution Flow: Dylib Hijacking"
    log_prerequisites = "macOS endpoint telemetry that emits NETWORK_CONNECTION events with principal.process.file.full_path and target.ip populated. The %rfc1918_internal reference list must be populated in the tenant."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Users running unpacked apps directly from Downloads or Desktop (browsers, chat clients, portable utilities), first-run installers and self-updaters staged in /tmp, developer builds executed from temp directories, and software deployment tooling that runs from staging paths."
    tuning_guidance = "Add approved deployment or updater binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Review recurring hits by application name; confirmed-benign portable apps should be allowlisted by executable path through the reference lists. To widen coverage, extend the staging directory regex (for example mounted /Volumes images) after baselining."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(Users\/[^\/]+\/(Downloads|Desktop)|Users\/Shared|private\/tmp|tmp|private\/var\/tmp)\/.*\.app\/Contents\/MacOS\/[^\/]+$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
