/*
  MITRE Technique : T1583.001 - Domains
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:58:38.418995+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_001_Punycode_IDN_Lookalike_Domain_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a DNS query for a name containing a punycode (xn--) label, the encoded form of an internationalized domain name. Adversaries register IDN homograph domains with look-alike characters from other scripts to impersonate trusted brands for phishing, drive-by delivery and C2 (T1583.001). The rule keys on the IDN encoding itself, so it does not depend on a specific domain, brand or TLD. Queries for known-good names are excluded through a reference list."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.001"
    mitre_technique_name = "Acquire Infrastructure: Domains"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Resolver logs should record the client address in principal.ip or principal.hostname."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Legitimate internationalized domains (non-Latin-script sites, regional ccTLD IDNs such as xn--p1ai), multilingual business partners and customers, browsers and mail clients resolving IDN links, and security tooling or URL scanners that resolve suspicious domains on purpose."
    tuning_guidance = "Add known-good IDN domains (partners, regional sites, vendors) to %global_allowed_domains. Because matching is on the full queried name, include the exact names clients resolve. Where the client base legitimately uses non-Latin scripts, lower the risk or route to triage rather than paging. Exclude security scanner source hosts if they generate noise, for example by filtering on principal.hostname in the SOAR playbook."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)xn--[a-z0-9-]+(\.|$)/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.001")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $client_ips = array_distinct($dns.principal.ip)

  condition:
    $dns
}
