/*
  MITRE Technique : T1583.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:12:29.781841+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_007_Serverless_DNS_Then_HTTP_Post {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an internal source resolving a hostname on a public serverless or function-hosting platform and then sending HTTP POST requests to a serverless-platform hostname within 10 minutes. This DNS-then-POST pattern is consistent with a client or implant reaching an adversary-operated serverless redirector or C2 relay."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.007"
    mitre_technique_name = "Acquire Infrastructure: Serverless"
    log_prerequisites = "Requires perimeter firewall or proxy telemetry normalised to UDM NETWORK_DNS (query name) and NETWORK_HTTP (target hostname, HTTP method). The source IP must be populated in principal.ip on both event types. Requires the reference lists %global_allowed_domains and %rfc1918_internal to be populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal developers and SaaS integrations that legitimately call serverless-hosted APIs, webhooks, or function endpoints; third-party SaaS products hosted on serverless platforms; CI/CD pipelines and monitoring agents posting telemetry to function URLs."
    tuning_guidance = "Add known-good serverless-hosted vendor domains to %global_allowed_domains. Narrow the platform suffix regex to the providers relevant to the client. Raise the risk score or require a higher count of POST events for developer-heavy environments. Exclude developer and build subnets at the source-IP level in the client-specific copy of the rule."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)(workers\.dev|pages\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app|azurewebsites\.net|netlify\.app|vercel\.app|deno\.dev)\.?$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    $dns.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.hostname = /(^|\.)(workers\.dev|pages\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app|azurewebsites\.net|netlify\.app|vercel\.app|deno\.dev)\.?$/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    $http.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1583.007")
    $primary_entity = array_distinct($src_ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $serverless_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $post_count = count($http.metadata.id)

  condition:
    $dns and $http
}
