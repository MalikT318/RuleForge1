/*
  MITRE Technique : T1584.006 - Web Services
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:28:11.052147+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_006_Scripted_Client_API_Upload_To_External_Web_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser, scripted HTTP client (command-line or library user agent) sending POST or PUT requests to an API, upload, webhook or messaging style URL on an external web service that is not on the tenant's known-good domain list. This is the network-observable pattern of attacker-controlled accounts on third-party web services being used for command-and-control, staging or exfiltration. It does not depend on any specific service domain, so it still fires if the adversary switches providers."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.006"
    mitre_technique_name = "Compromise Infrastructure: Web Services"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP visibility (URL, method and user agent), typically via TLS inspection, normalised to NETWORK_HTTP. Without TLS inspection the URL and user agent fields are usually empty and the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate automation using curl or scripting libraries against SaaS APIs (CI/CD pipelines, monitoring agents, backup and sync jobs, ticketing and chat webhooks), developer workstations calling cloud APIs, and vendor software or agents that use a Go, Java or Python HTTP stack for telemetry upload."
    tuning_guidance = "Add sanctioned SaaS and API domains to %global_allowed_domains. Add authorised scanners and automation egress sources to %global_allowed_scanners. Use %global_allowed_mgmt_sources if the client has dedicated automation or jump-host egress addresses. Narrow the user agent or URL path regexes for clients with heavy API automation."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT)$/ nocase
    $http.network.http.user_agent = /(curl|wget|python-requests|python-urllib|aiohttp|go-http-client|okhttp|libwww-perl|winhttp|powershell|java|apache-httpclient|node-fetch|axios)/ nocase
    $http.target.url = /\/(api|rest|graphql|webhooks?|upload|uploads|content|gists?|paste|messages|sendMessage|files)(\/|\?|$)/ nocase
    $http.target.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1584.006")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
