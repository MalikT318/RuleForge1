/*
  MITRE Technique : T1590.001 - Domain Properties
  Tactic(s)       : Reconnaissance
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:14:42.687500+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_001_External_Domain_Discovery_Endpoint_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source using a scripted or empty HTTP client to request domain and tenant discovery endpoints on organisation-facing web infrastructure. These endpoints are the autodiscover, realm lookup, OpenID configuration and federation metadata paths. Adversaries query them to enumerate domain properties, federation type, and name or tenant details before targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.001"
    mitre_technique_name = "Gather Victim Network Information: Domain Properties"
    log_prerequisites = "IDS/IPS or inline network security appliance with HTTP/URL inspection (decrypted or reverse-proxy-fronted traffic) that populates target.url, network.http.user_agent and principal.ip."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external attack-surface scanners and pentests, email or identity SaaS onboarding checks, monitoring and uptime probes that use scripted clients, and customer or partner automation that legitimately reads OpenID or federation metadata."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners. Add monitoring or management source addresses to %global_allowed_mgmt_sources. If the client uses scripted clients for legitimate federation metadata retrieval, exclude those sources. To reduce noise further, raise the risk score only when the same source also appears in other reconnaissance detections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/autodiscover\/autodiscover\.(xml|json)|getuserrealm|\/common\/userrealm|openid-configuration|federationmetadata\.xml|\/autodiscover\/metadata\/json1/ nocase
    $http.network.http.user_agent = /^$|^(curl|wget|python|go-http-client|libwww|java|node|axios|powershell|httpie|scrapy)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1590.001")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
