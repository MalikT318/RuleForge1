/*
  MITRE Technique : T1590.004 - Network Topology
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:19:23.832964+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_004_External_Probe_Of_Network_Infrastructure_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source connecting to network-infrastructure and topology-disclosing services (SNMP, BGP, RIP, vendor Smart Install) as seen by an IDS/IPS or network security appliance. Unsolicited external access to these services is characteristic of reconnaissance that maps network devices, routing and topology ahead of targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.004"
    mitre_technique_name = "Gather Victim Network Information: Network Topology"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Appliance must sit on the perimeter and log both allowed and blocked or alerted sessions."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scans and attack-surface monitoring, ISP or MSP monitoring over SNMP, legitimate BGP or RIP peering with upstream providers, internet-wide research scanners hitting perimeter addresses, and partner-managed network devices."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Add upstream peers, ISP or MSP monitoring sources and management hosts to %global_allowed_mgmt_sources. If a client intentionally exposes one of these services, adjust the port list or add a destination-specific exclusion for that client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 162 or
      $net.target.port = 179 or
      $net.target.port = 520 or
      $net.target.port = 521 or
      $net.target.port = 4786
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1590.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
