/*
  MITRE Technique : T1598.002 - Spearphishing Attachment
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:13:00.225176+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_002_Credential_Form_Post_No_Referrer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP POST from an internal client to an external host on a credential-style path (login, signin, verify, password, etc.) with no web referrer or a file:// referrer. This pattern is typical of a credential-harvesting form delivered as a spearphishing attachment, such as an HTML attachment opened from local disk or email, which submits entered data to attacker infrastructure. Logic is behavioural (method, path semantics, referrer origin, external destination) and does not depend on specific domains or IPs."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.002"
    mitre_technique_name = "Phishing for Information: Spearphishing Attachment"
    log_prerequisites = "Requires forward or secure web proxy, or firewall with URL/HTTP inspection (TLS decryption recommended), normalised to UDM NETWORK_HTTP with network.http.method, network.http.referral_url and target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate applications or scripts that POST to external login or API endpoints without a Referer header (native mobile or desktop apps, SSO/OAuth token clients, password managers, CLI tools); privacy extensions or browser policies that strip Referer headers; legitimate SaaS logins launched from locally saved HTML bookmarks or portals."
    tuning_guidance = "Add sanctioned SaaS and identity provider domains to %global_allowed_domains. Exclude RMM or automation sources via %global_allowed_remote_mgmt or %global_allowed_service_accounts if the proxy logs user identity. If volume is high, restrict the path regex to the most specific keywords. Consider escalating when the same destination is hit by multiple internal clients."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /^https?:\/\/[^\/]+\/[^?#]*(login|log-in|logon|signin|sign-in|verify|validate|authenticate|account|password|passwd|credential|webmail|secure)/ nocase
    (
      $http.network.http.referral_url = "" or
      $http.network.http.referral_url = /^file:/ nocase
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1598.002")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_host = array_distinct($http.target.hostname)
    $destination_url = array_distinct($http.target.url)

  condition:
    $http
}
