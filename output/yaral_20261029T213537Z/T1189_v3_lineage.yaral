/*
  MITRE Technique : T1189 - Drive-by Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:11:45.932877+00:00
  Reference       : https://attack.mitre.org/techniques/T1189
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1189_Linux_Browser_Spawns_Shell_Or_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web browser process directly spawning a shell, script interpreter or download utility on a Linux host. Browsers do not normally launch these children. This lineage is a strong indicator of successful browser exploitation or a drive-by download, where code runs in or escapes from the browser and executes a payload. Detection is based on parent-child process lineage, not on command-line content."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1189"
    mitre_technique_name = "Drive-by Compromise"
    log_prerequisites = "Linux EDR or auditd (execve) telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Browser native-messaging hosts implemented as shell or Python scripts (password managers, desktop integration); xdg-open or MIME handler scripts launched from the browser; browser-based developer tooling and extensions; headless browsers used for test automation or CI (Selenium, Puppeteer-style jobs); kiosk or VDI launchers that start browsers through wrapper scripts."
    tuning_guidance = "Add approved browser parents or wrapper hosts to %global_allowed_script_hosts. Add automation and test-runner accounts to %global_allowed_service_accounts. Add approved helper binaries to %global_allowed_admin_tools. For noisy native-messaging hosts, review the child_command_lines outcome and allowlist by parent path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(firefox|firefox-bin|firefox-esr|chrome|google-chrome|google-chrome-stable|chromium|chromium-browser|brave|brave-browser|opera|vivaldi|vivaldi-bin|msedge|microsoft-edge|epiphany|midori|falkon|librewolf|waterfox)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|fish|ash|python[0-9.]*|perl|ruby|php|node|lua|curl|wget|nc|ncat|netcat|socat)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1189")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_browser = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
