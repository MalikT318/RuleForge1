/*
  MITRE Technique : T1598.001 - Spearphishing Service
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:11:32.685798+00:00
  Reference       : https://attack.mitre.org/techniques/T1598/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1598_001_External_Credential_Form_Submission {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client submitting an HTTP POST to an external destination whose URL path indicates a credential, verification or survey form, outside known-good domains. This is the network-side footprint of a user responding to spearphishing delivered through a third-party service (social media, personal webmail) that directs them to an information-harvesting page."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1598.001"
    mitre_technique_name = "Phishing for Information: Spearphishing Service"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection that populate network.http.method and target.url (for HTTPS, TLS inspection or a secure web gateway is needed). Destination IP must be populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Legitimate sign-in to SaaS, SSO or partner portals not yet in the allowlist; employee use of personal webmail or banking sites; third-party survey or HR/benefits portals; vendor support portals."
    tuning_guidance = "Add sanctioned SaaS, SSO and vendor domains to %global_allowed_domains. Treat a first-seen external domain posting credentials as higher priority. Narrow the URL keyword regex per client if a business portal is noisy. Internal destinations are excluded via %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\/[^?#]*(login|log-in|signin|sign-in|logon|verify|verification|validate|password|passwd|credential|secure-?update|webmail|survey|questionnaire|account-?recover)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1598.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
