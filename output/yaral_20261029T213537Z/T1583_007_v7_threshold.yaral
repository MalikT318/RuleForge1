/*
  MITRE Technique : T1583.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:12:49.370003+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_007_Serverless_Endpoint_Repeated_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes a high volume of web requests to hostnames in public serverless-platform namespaces (edge workers, function URLs, app-script hosts) within ten minutes. Adversary-configured serverless functions are used to answer implants or relay C2 traffic, so one source repeatedly beaconing to such an endpoint is a strong signal. Any single request is benign; the volume and repetition are not."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.007"
    mitre_technique_name = "Acquire Infrastructure: Serverless"
    log_prerequisites = "Requires proxy or firewall web telemetry normalised to NETWORK_HTTP with target.hostname populated (for example, proxy or SSL-inspection logs). Source address must be populated in principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Internal or sanctioned applications built on public serverless platforms, SaaS vendors hosted on cloud function or edge worker domains, developer or CI/CD activity, monitoring or health-check agents polling serverless APIs, and Google Apps Script based business automations."
    tuning_guidance = "Add known-good serverless-hosted vendor and internal application domains to %global_allowed_domains. If a client has heavy legitimate serverless usage, raise the #http threshold (for example, to 50) or widen the hostname exclusions. Review $destination_hosts in the outcome to separate a single repeated beacon destination from broad developer traffic."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /\.(workers\.dev|pages\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|execute-api\.[a-z0-9-]+\.amazonaws\.com|cloudfunctions\.net|run\.app|azurewebsites\.net|netlify\.app|vercel\.app|deno\.dev)$|^script\.(google|googleusercontent)\.com$/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    $http.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1583.007")
    $primary_entity = array_distinct($src)
    $destination_hosts = array_distinct($http.target.hostname)

  condition:
    #http >= 20
}
