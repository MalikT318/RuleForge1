/*
  MITRE Technique : T1608.006 - SEO Poisoning
  Tactic(s)       : Resource Development
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:30:15.356592+00:00
  Reference       : https://attack.mitre.org/techniques/T1608/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1608_006_SEO_Poisoned_Search_Referral_Payload_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client retrieving an executable, installer, script, disk-image or archive payload from an external host when the HTTP referrer is a search-results page (URL carrying a search-query parameter). This is the victim-side result of SEO poisoning, where a poisoned search result sends the user straight to a staged payload. The rule does not depend on any specific search engine, domain, or payload filename."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1608.006"
    mitre_technique_name = "Stage Capabilities: SEO Poisoning"
    log_prerequisites = "Requires firewall or secure web proxy logs with full HTTP URL and referrer visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP, with network.http.referral_url and target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users who search for legitimate software and download it directly from a vendor or open-source site, IT staff searching for drivers or tools, and software mirrors or CDNs not yet in the allowlist."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Extend or narrow the payload extension list per client risk appetite. If the proxy does not log referrers, this rule will not fire and an alternative variant is needed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.referral_url = /[?&](q|query|search_query|wd|text|keywords?)=/ nocase
    $http.target.url = /\.(exe|msi|msix|iso|img|zip|rar|7z|js|vbs|scr|dmg|apk|jar)(\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1608.006")
    $primary_entity = array_distinct(strings.coalesce($http.principal.hostname, $http.principal.ip))
    $download_urls = array_distinct($http.target.url)
    $referrer_urls = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
