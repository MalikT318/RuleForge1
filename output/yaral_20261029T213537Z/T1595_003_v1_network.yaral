/*
  MITRE Technique : T1595.003 - Wordlist Scanning
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:55:30.998029+00:00
  Reference       : https://attack.mitre.org/techniques/T1595/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1595_003_External_Probe_Of_Sensitive_Paths_Rejected {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source requesting a sensitive or administrative web path (VCS metadata, environment/config files, backup or dump artefacts, admin consoles, management endpoints) and receiving a 4xx rejection. This is the per-request signature of wordlist-based content discovery and is observed on the network side with no endpoint telemetry. Each alert is one probe, so repeated alerts for the same source indicate an active scan."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1595.003"
    mitre_technique_name = "Active Scanning: Wordlist Scanning"
    log_prerequisites = "Requires perimeter proxy, WAF-style or firewall HTTP logs normalised to NETWORK_HTTP, with target.url, principal.ip and network.http.response_code populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and penetration tests, uptime or SEO crawlers, broken links to retired admin or backup paths, legitimate users mistyping an admin URL, security research scanners."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Internal sources are excluded via %rfc1918_internal. To reduce volume, alert on repeat sources via SIEM aggregation over $primary_entity, or promote this to a Threshold rule (for example 10 or more hits per source within 10 minutes). Extend or trim the path regex to match the client's web stack."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.response_code >= 400
    $net.network.http.response_code < 500
    $net.target.url = /(\/\.(git|svn|hg|env|aws|ssh|htpasswd|htaccess|ds_store)(\/|$|\?)|\/(phpmyadmin|pma|wp-admin|wp-login\.php|administrator|admin|manager\/html|server-status|actuator|console|cgi-bin|backup|backups|config|conf)(\/|$|\?)|\.(bak|old|orig|swp|sql|zip|tar|tgz|gz|7z|rar|inc|log)(\?|$))/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1595.003")
    $primary_entity = array_distinct($net.principal.ip)
    $probed_urls = array_distinct($net.target.url)
    $target_hosts = array_distinct($net.target.hostname)
    $response_codes = array_distinct($net.network.http.response_code)

  condition:
    $net
}
