/*
  MITRE Technique : T1574.004 - Dylib Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:54:14.331855+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_004_macOS_Dylib_Dropped_In_App_Bundle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a .dylib file inside an application bundle's MacOS, Frameworks or Resources directories by a process that is not an installer, updater or approved tool. Planting a library with an expected or missing name in an application's @rpath or weak-link search path (dylib hijacking) gives code execution under the privileges of the legitimate host application. This rule looks at the file-write side of the technique (FILE_CREATION), not process command lines."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.004"
    mitre_technique_name = "Hijack Execution Flow: Dylib Hijacking"
    log_prerequisites = "macOS endpoint telemetry that records file creation events with the creating process path (EDR file-write events or Endpoint Security framework NOTIFY_CREATE normalised to UDM FILE_CREATION)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Third-party application self-updaters (Sparkle-style updaters, vendor auto-update helpers), developer build tools (Xcode, compilers, linkers) writing into locally built .app bundles, package managers, MDM-driven software deployment, and drag-and-drop or archive extraction of new application versions into /Applications."
    tuning_guidance = "Add legitimate deployment and patching binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Extend the updater and installer process-name exclusion regex for client-specific updaters. For developer-heavy fleets, consider scoping to non-developer hosts or raising the threshold via a wrapping Threshold rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/Users\/[^\/]+)?\/Applications\/[^\/]+\.app\/Contents\/(MacOS|Frameworks|Resources)\/(.+\/)?[^\/]+\.dylib$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\/(installd|system_installd|Installer|softwareupdated|mdmclient|pkgcommands|PackageKit|Autoupdate|ShipIt|ld|clang|swift-frontend|xcodebuild)$/ nocase

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_dylib = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
