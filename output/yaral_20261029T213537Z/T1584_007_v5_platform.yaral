/*
  MITRE Technique : T1584.007 - Serverless
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:30:58.578943+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_007_Scripted_Client_To_Serverless_Endpoint {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client using a scripting or CLI HTTP library (curl, wget, python, Go, PowerShell and similar) to call a hostname in a public serverless function namespace (edge workers, function URLs, cloud functions, managed container run endpoints, Apps Script content hosts). Compromised serverless runtimes are used as C2 responders or redirectors, and the traffic blends in with ordinary cloud provider traffic. Non-browser clients calling these endpoints are rare and worth review. The match uses the provider namespace structure only, not specific attacker-controlled hostnames. This is a perimeter-side proxy for adversary use of compromised serverless infrastructure, which cannot be observed directly."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.007"
    mitre_technique_name = "Compromise Infrastructure: Serverless"
    log_prerequisites = "Requires forward or transparent proxy, or firewall with HTTP inspection, that populates NETWORK_HTTP with target.hostname and network.http.user_agent. TLS inspection is needed for HTTPS visibility into the user agent."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Developers and CI/CD pipelines calling their own serverless APIs with curl or SDKs; monitoring and health-check agents; SaaS integrations and webhooks that legitimately use function endpoints; cloud-native applications whose SDKs use generic HTTP client user agents."
    tuning_guidance = "Add sanctioned function hostnames to %global_allowed_domains (exact hostnames). Add developer, build and automation hosts to %global_allowed_script_hosts. If the proxy does not populate user agent, the rule will not fire. In that case, review the user agent logging configuration before relaxing the rule. Extend the provider namespace regex as new serverless offerings appear."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.hostname = /\.(workers\.dev|lambda-url\.[a-z0-9-]+\.on\.aws|cloudfunctions\.net|a\.run\.app|script\.googleusercontent\.com|functions\.azure\.com|azurewebsites\.net)$/ nocase
    $http.network.http.user_agent = /(curl\/|wget\/|python-requests|python-urllib|aiohttp|go-http-client|powershell|winhttp|libwww-perl|okhttp|node-fetch|java\/[0-9])/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1584.007")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $serverless_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)
    $request_count = count($http.metadata.id)

  condition:
    $http
}
