/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:41:08.395383+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_macOS_Keychain_Memory_Tool_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a keychain or process-memory inspection binary (securityd itself, the security CLI, gcore, vmmap, lldb, leaks) opening a network connection to an external address. These OS binaries normally operate locally. Outbound traffic from them suggests securityd memory or keychain material is being staged or exfiltrated, or that the binary is being used as a remote implant channel. This complements process command-line detections by observing the network result of the technique."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires macOS endpoint network telemetry that attributes each connection to the initiating process (principal.process.file.full_path) and is normalised to UDM NETWORK_CONNECTION."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developers using lldb for remote debugging against external hosts, Xcode or Instruments remote profiling, authorised IR or forensics collection using gcore or vmmap with upload, and endpoint management agents that invoke the security CLI and proxy traffic."
    tuning_guidance = "Add approved debugging, forensics or management binaries to %global_allowed_admin_tools. Add EDR and security agents to %global_allowed_security_tools. Add approved service accounts to %global_allowed_service_accounts. If developer fleets use remote lldb, restrict by host group or add the user to %global_allowed_admin_users."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/usr\/(bin|sbin|libexec)\/(securityd|security|gcore|vmmap|lldb|leaks)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
