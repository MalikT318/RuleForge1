/*
  MITRE Technique : T1590.003 - Network Trust Dependencies
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:18:32.888649+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_003_External_Trust_Service_Probing_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source generates a high volume of connection attempts to ports that expose network trust dependencies (IKE/IPsec, PPTP, L2TP, OpenVPN, Kerberos, LDAP/LDAPS/Global Catalog) within ten minutes. Each connection is benign on its own; the volume from one source suggests reconnaissance of VPN, directory and partner-trust infrastructure."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.003"
    mitre_technique_name = "Gather Victim Network Information: Network Trust Dependencies"
    log_prerequisites = "IPS or network security appliance connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Appliance must be placed at the perimeter so external sources are visible."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners or attack-surface monitoring services, internet-wide research scanners, remote users or branch sites repeatedly re-establishing VPN tunnels, partner or MSP site-to-site tunnels renegotiating, misconfigured directory-integrated SaaS connectors retrying LDAP or Kerberos."
    tuning_guidance = "Add known scanner source addresses to %global_allowed_scanners and approved partner or management source addresses to %global_allowed_mgmt_sources. Raise the #net threshold in noisy environments where VPN gateways are internet-facing. Lower the threshold for environments with no exposed VPN or directory services. Review the target_ips and target_ports outcome values to separate a broad sweep from a single misbehaving VPN client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 500 or
      $net.target.port = 4500 or
      $net.target.port = 1701 or
      $net.target.port = 1723 or
      $net.target.port = 1194 or
      $net.target.port = 88 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.ip = $src_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1590.003")
    $primary_entity = array_distinct($src_ip)
    $target_ips = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    #net >= 30
}
