/*
  MITRE Technique : T1543.004 - Launch Daemon
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:28:10.525211+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_004_Burst_LaunchDaemon_Plist_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several launchd plist files are written to /Library/LaunchDaemons on a single macOS host within ten minutes. Dropping one daemon plist can be routine. A burst of them is consistent with an adversary staging multiple root-level persistence mechanisms or a malicious installer. This rule is file-creation based and complements process command-line detections for launchctl."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.004"
    mitre_technique_name = "Create or Modify System Process: Launch Daemon"
    log_prerequisites = "macOS endpoint telemetry that reports file creation events (EDR or unified log) with the writing process path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Software installers and updaters that register several helper daemons, MDM and device management agents, enterprise deployment or patching tools, and IT staff building images or packages."
    tuning_guidance = "Add approved deployment, MDM and patching binaries to %global_allowed_admin_tools. Add EDR and security agent binaries to %global_allowed_security_tools. Raise the #file threshold in high-churn environments such as imaging or build hosts. Review the writer process and plist names in the outcome before escalating."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/LaunchDaemons\/[^\/]+\.plist$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543.004")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $plist_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
