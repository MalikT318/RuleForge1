/*
  MITRE Technique : T1037.005 - Startup Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:56:33.855466+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_005_macOS_StartupItems_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file inside a startup item directory under /Library/StartupItems (for example the item executable or StartupParameters.plist). StartupItems is a deprecated macOS boot-time mechanism whose items run as root during the final boot phase. Adversaries create these directories and files to gain persistence and privilege. Legitimate use on modern macOS is rare, so any new file here is high fidelity."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.005"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Startup Items"
    log_prerequisites = "Requires macOS endpoint telemetry from EDR or unified log that reports file creation events with the full target path and the initiating process path."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy third-party software installers or uninstallers that still register StartupItems, IT deployment and MDM tooling packaging older agents, and authorised administrators maintaining legacy boot scripts."
    tuning_guidance = "Add approved installer, deployment, and MDM binaries (full path of the initiating process) to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools. Review hits for newly created StartupParameters.plist files and for items created by shell, script interpreter, or user-writable parent processes, which warrant escalation."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/StartupItems\/[^\/]+\/[^\/]+/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_command_line = array_distinct($file.principal.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
