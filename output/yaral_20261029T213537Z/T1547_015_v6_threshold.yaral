/*
  MITRE Technique : T1547.015 - Login Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:48:08.532875+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_015_MacOS_Login_Item_Store_Burst_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of modifications to macOS login item persistence stores on a single host within ten minutes. The stores covered are the shared file list (sfl) login item files, the legacy com.apple.loginitems.plist, the background task management (btm) database, and per-user LaunchAgents plists. A single change is routine, but repeated rewrites in a short window can indicate scripted login item registration (AppleScript, SMLoginItemSetEnabled helpers or persistence tooling). This is a file-telemetry rule and does not depend on process command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.015"
    mitre_technique_name = "Boot or Logon Autostart Execution: Login Items"
    log_prerequisites = "Requires macOS endpoint file-modification telemetry (EDR or unified log) that populates target.file.full_path and principal.hostname."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "MDM or software deployment runs that register several login items at once, bulk application installs or upgrades, user-profile migration or first-login setup, and users rearranging items in System Settings. Security agents that touch these files can also fire it."
    tuning_guidance = "Add MDM, deployment and RMM binaries to %global_allowed_admin_tools and EDR agents to %global_allowed_security_tools. Raise the #file threshold in noisy fleets, for example during imaging or onboarding windows. Tune the severity or risk score in outcome after reviewing the writing_processes values."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/Library\/(Application Support\/com\.apple\.backgroundtaskmanagementagent\/backgroundItems-v\d+\.btm|Application Support\/com\.apple\.sharedfilelist\/.*\.sfl\d*|Preferences\/com\.apple\.loginitems\.plist)$|^\/Users\/[^\/]+\/Library\/LaunchAgents\/[^\/]+\.plist$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1547.015")
    $primary_entity = array_distinct($host)
    $modified_paths = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 4
}
