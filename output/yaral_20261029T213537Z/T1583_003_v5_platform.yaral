/*
  MITRE Technique : T1583.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:03:34.569255+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_003_External_Source_Probing_Internal_Admin_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter-observable proxy for adversary-rented VPS infrastructure (T1583.003). Acquisition itself happens off-network and cannot be seen directly, so this rule flags the first observable use of such infrastructure: an external, non-allowlisted source initiating a connection to an internal host on a remote-administration port (SSH, Telnet, RDP, VNC, WinRM). Rented VPS nodes are the most common origin of this reconnaissance and initial-access traffic. Internal-to-internal traffic and approved management or scanner sources are excluded."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.003"
    mitre_technique_name = "Acquire Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must be captured on the internet-facing side, where the source address is not NATed."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSP remote support, remote staff using intentionally exposed SSH or RDP, external vulnerability scanners and attack-surface monitoring services not yet allowlisted, internet-wide research scanners hitting exposed services, and partner site-to-site access."
    tuning_guidance = "Add approved external administration sources to %global_allowed_mgmt_sources and authorised scanning sources to %global_allowed_scanners. Ensure %rfc1918_internal covers client private ranges. Where internet-exposed admin ports are known and expected, scope the rule down to the relevant target hosts. Consider a threshold or sequence variant for noisy perimeters."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip != ""
    $net.target.ip != ""
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1583.003")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
