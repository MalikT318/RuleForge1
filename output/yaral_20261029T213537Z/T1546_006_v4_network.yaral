/*
  MITRE Technique : T1546.006 - LC_LOAD_DYLIB Addition
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:30:04.507839+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_006_MacOS_Staged_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side proxy for tainted Mach-O binaries (LC_LOAD_DYLIB addition). Detects a process executing from a user-writable staging location (tmp directories, /Users/Shared, hidden directories under a home folder, or ~/Applications) that opens a connection to an external address. Binaries modified to load a rogue dylib, or implants dropped alongside them, typically run from these locations and call out to attacker infrastructure. This does not observe the header modification itself, so it complements endpoint process and file rules rather than replacing them."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.006"
    mitre_technique_name = "Event Triggered Execution: LC_LOAD_DYLIB Addition"
    log_prerequisites = "Requires macOS endpoint network telemetry that populates the initiating process path (principal.process.file.full_path) and the destination IP on NETWORK_CONNECTION events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Developer builds and test binaries run from home-directory dot-folders, user-installed apps in ~/Applications (browsers, chat clients, updaters), package managers or toolchains that install under hidden directories, and installers unpacked to /private/tmp that download payloads."
    tuning_guidance = "Add approved updater, developer-tooling and RMM binaries to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add known-good destinations by extending the exclusion with %global_allowed_domains if the log source populates a destination hostname. Narrow the path regex for environments where ~/Applications is widely used. Raise severity for hosts that also show a preceding file write to the same path."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(private\/)?(tmp|var\/tmp)\/|^\/Users\/Shared\/|^\/Users\/[^\/]+\/(Applications\/|\.[^\/]+\/)|^\/Users\/[^\/]+\/Library\/(Application Support|Caches|Containers)\/(.*\/)?\.[^\/]+/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not net.ip_in_range_cidr($net.target.ip, "127.0.0.0/8")
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
