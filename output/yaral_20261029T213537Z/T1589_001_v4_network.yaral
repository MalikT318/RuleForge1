/*
  MITRE Technique : T1589.001 - Credentials
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:07:19.921867+00:00
  Reference       : https://attack.mitre.org/techniques/T1589/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1589_001_External_Probe_For_Exposed_Credential_Files {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-internal) source requesting well-known credential-bearing files or secret-store paths over HTTP, such as environment files, VCS config, cloud credential files, password files and private keys. This is the network-observable behaviour of adversaries harvesting credentials from exposed web content, and complements endpoint command-line rules."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1589.001"
    mitre_technique_name = "Gather Victim Identity Information: Credentials"
    log_prerequisites = "Requires web proxy, reverse proxy, WAF or firewall with URL inspection that populates NETWORK_HTTP events with target.url and principal.ip."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface management services, penetration tests, security researchers running benign exposure checks, and misconfigured applications that legitimately request dotfile paths."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Review the response code outcome: 2xx responses indicate the sensitive file was actually served and should be escalated and remediated immediately. Narrow or extend the path regex per client application stack if noisy."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(\.env(\.[a-z0-9_-]+)?|\.git\/(config|HEAD)|\.aws\/credentials|\.htpasswd|\.htaccess\.bak|\.npmrc|\.pgpass|\.netrc|\.ssh\/(id_[a-z0-9]+|authorized_keys)|id_(rsa|dsa|ecdsa|ed25519)|wp-config\.php(\.bak|\.old|\.txt|~|\.save|\.swp)?|credentials(\.json|\.xml|\.txt)?|secrets?(\.json|\.ya?ml|\.txt)|web\.config\.(bak|old|txt)|config\.(php|json|ya?ml)\.(bak|old|save|txt)|database\.ya?ml|passwords?\.(txt|csv|xlsx?)|appsettings\.json)(\?.*)?$/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1589.001")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $max_response_code = max($http.network.http.response_code)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
