/*
  MITRE Technique : T1583.003 - Virtual Private Server
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:02:55.811538+00:00
  Reference       : https://attack.mitre.org/techniques/T1583/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1583_003_Raw_IP_HTTP_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client making an HTTP/HTTPS request through a proxy or firewall where the requested URL authority is a bare IPv4 address rather than a domain name, and the destination is external. Rented VPS infrastructure (T1583.003) is commonly used as short-lived staging or C2 and is addressed directly by IP without DNS registration. This rule detects use of such infrastructure. The acquisition itself happens outside the victim's telemetry and cannot be observed."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1583.003"
    mitre_technique_name = "Acquire Infrastructure: Virtual Private Server"
    log_prerequisites = "Requires proxy or next-generation firewall HTTP logs with the full request URL populated in target.url (URL logging or SSL inspection enabled for HTTPS)."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software updaters or appliances that call vendor endpoints by raw IP, IoT/OT devices, captive-portal or connectivity checks, internal tooling reached through public addressing, and authorised penetration tests."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains, approved scanner or test hosts to %global_allowed_scanners, and approved external management endpoints to %global_allowed_mgmt_sources. If volume is high, scope the rule to specific egress zones or non-standard ports, or raise it to a Threshold rule per source host."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^(https?:\/\/)?([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]{1,5})?(\/|\?|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1583.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
