/*
  MITRE Technique : T1588.001 - Malware
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:54:48.665760+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_001_Executable_Payload_Download_From_Bare_IP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client downloading an executable, library, installer or script payload over HTTP from an external host addressed by a bare IP instead of a domain name. This is the network-observable result of acquiring malware from attacker-hosted or criminal infrastructure. Detection is based on URL structure and file type, not on any specific indicator."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.001"
    mitre_technique_name = "Obtain Capabilities: Malware"
    log_prerequisites = "Requires proxy or firewall logs with URL-level visibility (HTTP inspection or TLS-decrypted traffic) normalised to NETWORK_HTTP with target.url populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Software or firmware updates served directly from an IP address, internal-lab or staging systems reached via public IPs, developers fetching build artefacts from IP-addressed hosts, and appliance or IoT vendors that distribute updates without a DNS name."
    tuning_guidance = "Add known-good vendor domains to %global_allowed_domains. Extend %rfc1918_internal if the tenant has additional internal address space. Raise severity or add a count threshold for high-risk subnets. Consider enriching with threat intelligence on the destination IP downstream in SOAR."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\// nocase
    $http.target.url = /\.(exe|dll|msi|scr|ps1|vbs|hta|jar|bat|cmd|elf|apk|sh|bin)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1588.001")
    $primary_entity = array_distinct($http.principal.ip)
    $downloaded_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
