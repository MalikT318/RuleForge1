/*
  MITRE Technique : T1546.014 - Emond
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:31:24.851185+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_014_Emond_Daemon_Spawns_Shell_Or_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the macOS Event Monitor Daemon (/sbin/emond) acting as the parent of a shell, script interpreter or download utility. emond only launches child processes when a rule in /etc/emond.d/rules/ fires, so this lineage is the execution stage of emond persistence or privilege escalation. This rule pivots on parent-child lineage and does not match command-line content, so it complements command-line rules."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.014"
    mitre_technique_name = "Event Triggered Execution: Emond"
    log_prerequisites = "macOS endpoint telemetry that records process launch events with parent and child executable paths populated (EDR or unified log based process events)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Rare legacy administrative emond rules, such as custom startup or login hooks on older macOS releases. emond is deprecated and removed in recent macOS versions, so legitimate child processes are uncommon. Some management tooling may also use emond rules for compliance scripts."
    tuning_guidance = "Add approved child tooling to %global_allowed_admin_tools. Add hosts with a documented, approved emond rule to %global_allowed_script_hosts. Review the emond rule files in /etc/emond.d/rules/ on any hit and confirm /private/var/db/emondClients contents."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /^\/sbin\/emond$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|zsh|dash|csh|tcsh|ksh|osascript|python[0-9.]*|perl|ruby|php|curl|nscurl)$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
