/*
  MITRE Technique : T1594 - Search Victim-Owned Websites
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:48:36.111984+00:00
  Reference       : https://attack.mitre.org/techniques/T1594
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1594_Web_Hidden_Content_Probe_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source requesting hidden, backup, configuration or version-control resources on a victim-owned web property. These requests are characteristic of automated directory and wordlist discovery (T1594) and rarely occur in legitimate browsing. Observed on the network side from IDS/IPS HTTP inspection."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1594"
    mitre_technique_name = "Search Victim-Owned Websites"
    log_prerequisites = "Requires IDS/IPS or inline network security appliance logs with HTTP inspection that populate network.http and target.url, normalised to NETWORK_HTTP. TLS-encrypted traffic must be decrypted or terminated before inspection for URLs to be visible."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners and external attack-surface assessments, search-engine and uptime crawlers that follow links to backup or config-like paths, penetration tests, and developers or partners accessing legitimately published hidden-style paths such as .well-known."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners. Add approved monitoring or admin sources to %global_allowed_mgmt_sources. Add known-good destination hostnames to %global_allowed_domains. To reduce volume, pair with a response-code filter such as network.http.response_code = 200 to alert only on exposed content. For burst detection, build a companion Threshold rule grouped by principal.ip."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(\.git|\.svn|\.hg|\.env|\.htpasswd|\.htaccess|\.ds_store|\.bash_history|\.ssh|web\.config|phpinfo\.php|server-status|server-info|backup|backups|old|archive|dump|db_backup|config\.(php|json|yml|yaml|xml)|[^\/?]+\.(bak|old|orig|swp|sql|tar|tgz|gz|zip|7z|rar))(\/|\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1594")
    $primary_entity = array_distinct($http.principal.ip)
    $target_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
