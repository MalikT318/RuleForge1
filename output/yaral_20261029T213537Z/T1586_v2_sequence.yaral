/*
  MITRE Technique : T1586 - Compromise Accounts
  Tactic(s)       : Resource Development
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:40:20.392057+00:00
  Reference       : https://attack.mitre.org/techniques/T1586
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1586_Credential_Stuffing_Failures_Then_Success {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an external source making repeated failed authentication POST requests against a web login endpoint, followed by a successful response from the same source to the same host within ten minutes. This pattern indicates credential stuffing or brute forcing that ended in a compromised account."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1586"
    mitre_technique_name = "Compromise Accounts"
    log_prerequisites = "Requires perimeter logs with HTTP inspection (reverse proxy, web gateway or firewall with application visibility), normalised to NETWORK_HTTP with network.http.method, network.http.response_code, target.url, principal.ip and target.hostname populated."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Users mistyping passwords before succeeding (especially behind shared NAT or VPN egress), password manager misfires, mobile clients with stale cached credentials, uptime or synthetic login monitors, and authorised penetration tests."
    tuning_guidance = "Raise the failure count in the condition for noisy tenants. Add authorised testing sources to %global_allowed_scanners and monitoring or partner egress addresses to %global_allowed_mgmt_sources. Narrow the login URL regex to the tenant's authentication paths if coverage is too broad."

  events:
    $fail.metadata.event_type = "NETWORK_HTTP"
    $fail.network.http.method = "POST"
    $fail.target.url = /(login|logon|signin|sign-in|auth|oauth|token|session|sso|owa|webmail)/ nocase
    ($fail.network.http.response_code = 401 or $fail.network.http.response_code = 403)
    not $fail.principal.ip in %rfc1918_internal
    not $fail.principal.ip in %global_allowed_scanners
    not $fail.principal.ip in %global_allowed_mgmt_sources
    $fail.principal.ip = $src_ip
    $fail.target.hostname = $dst_host

    $succ.metadata.event_type = "NETWORK_HTTP"
    $succ.network.http.method = "POST"
    $succ.target.url = /(login|logon|signin|sign-in|auth|oauth|token|session|sso|owa|webmail)/ nocase
    ($succ.network.http.response_code = 200 or $succ.network.http.response_code = 302)
    not $succ.principal.ip in %rfc1918_internal
    not $succ.principal.ip in %global_allowed_scanners
    not $succ.principal.ip in %global_allowed_mgmt_sources
    $succ.principal.ip = $src_ip
    $succ.target.hostname = $dst_host

    $fail.metadata.event_timestamp.seconds <= $succ.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1586")
    $primary_entity = array_distinct($src_ip)
    $failed_attempts = count($fail.metadata.id)
    $targeted_host = array_distinct($dst_host)
    $targeted_urls = array_distinct($succ.target.url)
    $first_failure = min($fail.metadata.event_timestamp.seconds)
    $success_time = max($succ.metadata.event_timestamp.seconds)

  condition:
    #fail >= 5 and $succ
}
