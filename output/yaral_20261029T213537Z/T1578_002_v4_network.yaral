/*
  MITRE Technique : T1578.002 - Create Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:55:18.506940+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_002_Instance_Created_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a compute instance or virtual machine through the cloud control plane by a caller whose source address is outside internal address space. Cloud audit logs do not emit NETWORK_CONNECTION, NETWORK_DNS or NETWORK_HTTP events, so the network-side pivot is the API caller's source IP on the resource-creation event. Attackers who create a VM to bypass the restrictions on existing instances typically do so from external infrastructure with stolen credentials."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.002"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Cloud Instance"
    log_prerequisites = "Requires cloud control-plane audit logs (management or activity logging with write events enabled) ingested and normalised to UDM RESOURCE_CREATION with principal.ip and metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Administrators or developers working remotely over VPN or from a home or office egress IP; CI/CD pipelines and IaC runners hosted outside the tenant; autoscaling or managed-service principals launching instances; approved third-party cloud management platforms."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Add corporate VPN and egress addresses to %global_allowed_mgmt_sources, and confirm %rfc1918_internal covers the client's internal ranges. Raise severity when the creating identity has never launched instances before or when the event is followed by snapshot or volume attachment activity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(RunInstances|bulkInsert|instances\.insert|virtualMachines\/write|virtualMachineScaleSets\/write)/ nocase
    $cloud.principal.ip != ""
    not $cloud.principal.ip in %rfc1918_internal
    not $cloud.principal.ip in %global_allowed_mgmt_sources
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1578.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $created_resource = array_distinct($cloud.target.resource.name)
    $api_call = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
