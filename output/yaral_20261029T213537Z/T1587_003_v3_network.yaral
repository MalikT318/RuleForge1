/*
  MITRE Technique : T1587.003 - Digital Certificates
  Tactic(s)       : Resource Development
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:50:57.136115+00:00
  Reference       : https://attack.mitre.org/techniques/T1587/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1587_003_Self_Signed_TLS_Cert_External_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound TLS connection to an external destination whose server certificate is self-signed (issuer identical to subject). Adversaries create self-signed certificates for C2 infrastructure (T1587.003) because they do not need a third-party CA. The network perimeter can see the resulting certificate when TLS metadata is logged, independent of any endpoint process telemetry."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1587.003"
    mitre_technique_name = "Develop Capabilities: Digital Certificates"
    log_prerequisites = "Requires perimeter firewall or proxy logs with TLS server certificate metadata (issuer and subject) parsed into UDM network.tls.server.certificate fields, typically via TLS inspection or a certificate-aware parser. Without these fields the rule will not fire."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Self-signed certificates on legitimate external appliances (VPN gateways, IoT or OT devices, small-business routers, lab or test servers), partner systems using private PKI, and security scanners or honeypots."
    tuning_guidance = "Add known-good external domains (partner or vendor SNI names) to %global_allowed_domains. Review the server_name and destination outcome values to separate legitimate self-signed appliances from C2. Rule fires only on external destinations; internal traffic is excluded via %rfc1918_internal. Consider raising severity for rare destinations or non-standard ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.tls.server.certificate.issuer != ""
    $net.network.tls.server.certificate.subject != ""
    $net.network.tls.server.certificate.issuer = $net.network.tls.server.certificate.subject
    not $net.target.ip in %rfc1918_internal
    not $net.network.tls.client.server_name in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1587.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $tls_server_name = array_distinct($net.network.tls.client.server_name)
    $cert_subject = array_distinct($net.network.tls.server.certificate.subject)

  condition:
    $net
}
