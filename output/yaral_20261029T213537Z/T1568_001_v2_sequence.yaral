/*
  MITRE Technique : T1568.001 - Fast Flux DNS
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T22:50:18.719043+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_001_FastFlux_DNS_Churn_Then_External_Connect {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single non-browser process on a Windows host issues repeated DNS lookups for non-allowlisted domains and then makes repeated connections to external IPs within 10 minutes. This pattern is consistent with a beacon re-resolving a fast-flux C2 name (short TTL, rotating A records) and connecting to whichever address currently answers. It complements command-line based detections by using network-behaviour telemetry rather than process creation."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.001"
    mitre_technique_name = "Dynamic Resolution: Fast Flux DNS"
    log_prerequisites = "Requires endpoint telemetry that attributes DNS queries (NETWORK_DNS) and outbound connections (NETWORK_CONNECTION) to the initiating process, e.g. EDR network events or Sysmon Event IDs 22 and 3."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software updaters, sync clients, telemetry agents and CDN-backed or cloud-hosted applications that legitimately re-resolve frequently-rotating DNS names; RMM and backup agents; developer tooling and package managers."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains, approved tooling to %global_allowed_admin_tools, and approved remote management software to %global_allowed_remote_mgmt. Raise the #dns and #net counts in the condition, or shorten the window, to reduce noise in busy environments. Review the $domains and $dest_ips outcome values: a single domain resolving to many unrelated IPs from one process is the strongest signal."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.hostname = $hostname
    $dns.principal.process.file.full_path = $proc_path
    not $dns.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera|svchost|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $dns.principal.process.file.full_path in %global_allowed_admin_tools
    not $dns.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.questions.name = /\.(local|lan|arpa|internal|corp)$/ nocase

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $proc_path
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera|svchost|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1568.001")
    $primary_entity = array_distinct($hostname)
    $process_path = array_distinct($proc_path)
    $domains = array_distinct($dns.network.dns.questions.name)
    $dest_ips = array_distinct($net.target.ip)
    $dns_query_count = count($dns.metadata.id)
    $connection_count = count($net.metadata.id)

  condition:
    $dns and $net and #dns >= 4 and #net >= 4
}
