/*
  MITRE Technique : T1596.004 - CDNs
  Tactic(s)       : Reconnaissance
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:05:24.691680+00:00
  Reference       : https://attack.mitre.org/techniques/T1596/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1596_004_CDN_Origin_Storage_Enumeration_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external source sending HTTP GET/HEAD requests to a CDN-fronted or origin web asset that enumerate object-storage listings (list-type, prefix, delimiter, max-keys, versions parameters) or probe for leaked sensitive content (VCS metadata, environment/config files, backup archives). This is characteristic of adversaries harvesting CDN data and looking for CDN misconfigurations that expose content not meant to be public."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1596.004"
    mitre_technique_name = "Search Open Technical Databases: CDNs"
    log_prerequisites = "Requires IPS or network security appliance logs with HTTP inspection that populate network.http.method, target.url, and principal.ip (for example TLS-decrypted or reverse-proxy-visible traffic)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and attack-surface management services, legitimate S3-compatible storage clients and sync tools listing buckets, SEO and web crawlers requesting robots-style paths, partner integrations that list objects using prefix parameters, and developers testing CDN configuration from outside the corporate network."
    tuning_guidance = "Add authorised external scanner and ASM source IPs to %global_allowed_scanners. Add known partner or integration source addresses to %global_allowed_mgmt_sources if appropriate. Narrow the URL regex to the listing parameters used by your storage platform, or raise severity when combined with repeated hits from the same principal.ip in a separate Threshold rule."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|HEAD)$/ nocase
    $http.target.url = /([?&](list-type=[0-9]|prefix=|delimiter=|max-keys=|versions(&|=|$)|uploads(&|=|$))|\/\.(git|svn|hg)\/|\/\.env(\.|$|\?)|\/\.DS_Store|\/\.aws\/|\/web\.config|\/backup[^\/?]*\.(zip|tar|tgz|gz|sql|bak))/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1596.004")
    $primary_entity = array_distinct($http.principal.ip)
    $targeted_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
