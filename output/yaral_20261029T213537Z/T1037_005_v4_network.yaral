/*
  MITRE Technique : T1037.005 - Startup Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:57:13.832984+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_005_StartupItems_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process executing from, or running a script located in, /Library/StartupItems that opens an outbound connection to a non-internal address. StartupItems is a deprecated boot-time persistence location that runs as root. Legitimate use is now rare, so network activity from it suggests a persistence implant beaconing or staging a payload."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.005"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Startup Items"
    log_prerequisites = "Requires macOS endpoint network telemetry that populates the originating process path or command line on network connection events."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy third-party software that still installs a StartupItems bundle and phones home (old licensing or update agents), and IT-managed legacy startup scripts that call out to internal or vendor services."
    tuning_guidance = "Add approved legacy agent binaries to %global_allowed_admin_tools, approved security agents to %global_allowed_security_tools, and known-good destinations to %global_allowed_domains. Make sure %rfc1918_internal covers the client's internal address space. Validate that the endpoint sensor populates principal.process.command_line, because shell-interpreted startup scripts appear as /bin/sh or /bin/bash with the script path in the command line."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /^\/Library\/StartupItems\// nocase or
      $net.principal.process.command_line = /\/Library\/StartupItems\// nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
