/*
  MITRE Technique : T1588.006 - Vulnerabilities
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:02:47.082997+00:00
  Reference       : https://attack.mitre.org/techniques/T1588/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1588_006_Outbound_Web_Request_For_CVE_Research {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal client making an outbound HTTP(S) request whose URL contains a CVE identifier (CVE-YYYY-NNNN+), such as a vulnerability database or advisory lookup. Adversary acquisition of vulnerability information normally happens outside the victim network, so this rule only catches the narrow case where a compromised host or insider performs the research from inside the perimeter. Treat it as a low-fidelity hunting and context signal, not a standalone alert. Any URL carrying a CVE identifier will match, whatever the destination."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1588.006"
    mitre_technique_name = "Obtain Capabilities: Vulnerabilities"
    log_prerequisites = "Requires firewall or proxy logs with HTTP URL visibility (TLS inspection or explicit proxy) normalized to NETWORK_HTTP, with principal.hostname and target.url populated. Encrypted traffic without inspection exposes no URL, so the rule will not fire there."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Security, vulnerability management and patching teams researching advisories; helpdesk staff following vendor security bulletins; patch-management and software-update clients that fetch vendor advisory pages; developers checking dependency vulnerabilities; threat intel platforms and automated feed collectors."
    tuning_guidance = "Add approved vendor and advisory domains to %global_allowed_domains. Add security team and vulnerability management accounts to %global_allowed_admin_users. Add scanner and research hosts to %global_allowed_scanners. In production, scope to non-security-team user segments or correlate with other suspicious activity from the same host before alerting."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /cve-\d{4}-\d{4,7}/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(25)
    $mitre_technique_id = array_distinct("T1588.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
