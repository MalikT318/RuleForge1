/*
  MITRE Technique : T1037.005 - Startup Items
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : macOS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T21:57:21.017102+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_005_macOS_StartupItems_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file under /Library/StartupItems, including the StartupParameters.plist or executable script that macOS runs as root during the final phase of boot. The StartupItems mechanism is deprecated in favour of launchd, so any new file written there is rare and a strong persistence indicator."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.005"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Startup Items"
    log_prerequisites = "Requires macOS EDR or unified log file-creation telemetry with principal process path and target file path populated."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Legacy third-party installers (older hardware utilities, audio or driver packages) that still register a StartupItems directory; MDM or software deployment agents pushing legacy packages; administrators manually maintaining legacy startup items."
    tuning_guidance = "Add approved deployment and installer process paths to %global_allowed_admin_tools. Add EDR or security agent processes to %global_allowed_security_tools. Add known automation accounts to %global_allowed_service_accounts. Review the writing process and the target file path to confirm that the item belongs to a legitimate legacy package."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/Library\/StartupItems\/./ nocase
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.005")
    $primary_entity = array_distinct($hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $writing_users = array_distinct($file.principal.user.userid)
    $writing_command_lines = array_distinct($file.principal.process.command_line)

  condition:
    $file
}
