/*
  MITRE Technique : T1593.002 - Search Engines
  Tactic(s)       : Reconnaissance
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:44:44.274224+00:00
  Reference       : https://attack.mitre.org/techniques/T1593/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1593_002_Search_Engine_Dork_Referral_To_Web_Asset {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an external visitor reaching a protected web asset through a search-engine referral whose query uses advanced search operators (inurl:, intitle:, intext:, filetype:, ext:). This is the victim-side trace of 'Google dorking' used to find exposed files, login portals and leaked data."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1593.002"
    mitre_technique_name = "Search Open Websites/Domains: Search Engines"
    log_prerequisites = "IPS or network security appliance with HTTP inspection that records the Referer header (network.http.referral_url) for inbound requests to internet-facing web servers. Without referral URL parsing the rule will not fire. Search engines that strip the query from the referrer (most modern HTTPS referrer policies) reduce coverage."
    platform = "PRE"
    log_source = "ips"
    false_positives = "SEO and web-analytics crawlers, penetration tests and red-team exercises, security researchers, marketing staff checking their own site's indexing with site:/inurl: queries, and vulnerability scanners that spoof search referrers."
    tuning_guidance = "Add authorised testing and scanning source IPs to %global_allowed_scanners. Add known corporate egress addresses to %rfc1918_internal handling or %global_allowed_scanners. Raise severity or correlate by source IP when the same visitor follows up with probing of the referenced path. Treat as low-fidelity context for enrichment and not as a standalone incident."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.referral_url != ""
    $http.network.http.referral_url = /[?&#](q|query|p|text|wd|k|search_query)=([^&]*(\+|%20|%2B))?(inurl|allinurl|intitle|allintitle|intext|allintext|inanchor|filetype|ext)(:|%3a)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1593.002")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ip = array_distinct($http.principal.ip)
    $requested_url = array_distinct($http.target.url)
    $referral_url = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
