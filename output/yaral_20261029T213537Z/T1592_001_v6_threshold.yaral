/*
  MITRE Technique : T1592.001 - Hardware
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:36:54.892493+00:00
  Reference       : https://attack.mitre.org/techniques/T1592/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1592_001_External_Hardware_Service_Probing_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source makes a high volume of connections to ports that expose hardware and device details (SNMP, IPMI/BMC, telnet, SSH, RDP, VNC, printer and device web consoles) within ten minutes. This pattern is typical of active scanning to fingerprint host hardware, firmware and banners. Each connection is benign on its own; the volume from one source is the signal."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1592.001"
    mitre_technique_name = "Gather Victim Host Information: Hardware"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must include inbound traffic, including allowed and denied connections."
    platform = "PRE"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, internet-wide research scanners, uptime and monitoring probes, partner or MSP remote support from fixed addresses, and legitimate users behind a shared NAT address hitting remote-access services."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Raise the #net threshold on internet-facing networks with heavy background scanning. Adjust the port list to the services each client exposes. Severity scales through $risk_score once the event count reaches 100."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 80 or
      $net.target.port = 161 or
      $net.target.port = 162 or
      $net.target.port = 443 or
      $net.target.port = 515 or
      $net.target.port = 623 or
      $net.target.port = 631 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 9100
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 100, 75, 45))
    $mitre_technique_id = array_distinct("T1592.001")
    $primary_entity = array_distinct($src)
    $targeted_ports = array_distinct($net.target.port)
    $targeted_ips = array_distinct($net.target.ip)

  condition:
    #net >= 20
}
