/*
  MITRE Technique : T1590.003 - Network Trust Dependencies
  Tactic(s)       : Reconnaissance
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:17:33.602982+00:00
  Reference       : https://attack.mitre.org/techniques/T1590/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1590_003_External_Probe_Of_Trust_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-internal) source connecting to directory and trust-related service ports (Kerberos, RPC endpoint mapper, LDAP/LDAPS, SMB, Global Catalog, kpasswd). These ports expose domain and forest trust information. Inbound traffic to them from outside the organisation indicates reconnaissance of trust dependencies, and it also flags unintended exposure of these services. Intended for IDS/IPS or network security appliance connection logs."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1590.003"
    mitre_technique_name = "Gather Victim Network Information: Network Trust Dependencies"
    log_prerequisites = "IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover internet-facing or perimeter-ingress traffic."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Authorised external vulnerability scanners and penetration tests, partner or MSP links that legitimately use LDAP/Kerberos/SMB across a trust, cloud-hosted identity sync services, internet-wide research scanners hitting exposed hosts, and misdirected traffic against NAT'd address space."
    tuning_guidance = "Add approved scanner sources to %global_allowed_scanners and trusted partner or management source addresses to %global_allowed_mgmt_sources. If sensor placement is internal-only, confirm that %rfc1918_internal covers the client's non-routable space. Raise severity if the target ports are expected to be closed at the perimeter. To tune noise, remove 135 and 445 from the port list first."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 88 or
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 445 or
      $net.target.port = 464 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1590.003")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
