/*
  MITRE Technique : T1650 - Acquire Access
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T01:36:55.981496+00:00
  Reference       : https://attack.mitre.org/techniques/T1650
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1650_DNS_Tunnel_Style_Load_Beaconing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side proxy for T1650 Acquire Access. Purchased or brokered footholds are often implanted with a 'load' that beacons to operator infrastructure. DNS is a common channel because it is rarely blocked. This rule detects TXT or NULL record queries whose name contains a very long, encoded-looking label, which is characteristic of DNS tunnelling or C2. The acquisition itself happens off-network and cannot be observed. This rule only catches the resulting post-acquisition beaconing, so treat it as a lead for triage."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1650"
    mitre_technique_name = "Acquire Access"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS, with network.dns.questions.name and network.dns.questions.type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Security and anti-spam services that look up hashes or encoded tokens via TXT or NULL records (DNSBL, URIBL, file-reputation lookups), CDN and telemetry services with long generated labels, mail authentication records with unusually long labels, and some VPN or licensing products that use DNS signalling."
    tuning_guidance = "Add known-good registered domains to %global_allowed_domains (the rule compares the last two labels of the queried name, so use entries such as example.com). Multi-label public suffixes such as co.uk need the full suffix-plus-one form to be listed as the two-label zone, or must be excluded another way. Lower or raise the label length in the regex ({40,}) to suit resolver noise. Internal split-horizon names are excluded when their answers resolve to addresses in %rfc1918_internal."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    // 16 = TXT, 10 = NULL: record types commonly used to carry tunnelled data
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    // Very long, encoded-looking left-most label (base32/base64/hex style)
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_\-]{40,}\.[^.]+\.[^.]+$/ nocase
    // Exclude reverse lookups
    not $dns.network.dns.questions.name = /\.arpa$/ nocase
    // Exclude known-good registered domains
    $zone = re.capture($dns.network.dns.questions.name, "([^.]+\\.[^.]+)$")
    not $zone in %global_allowed_domains
    // Exclude internal names that resolve to internal address space
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1650")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $resolver_ips = array_distinct($dns.target.ip)

  condition:
    $dns
}
