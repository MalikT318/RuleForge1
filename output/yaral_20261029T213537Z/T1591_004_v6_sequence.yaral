/*
  MITRE Technique : T1591.004 - Identify Roles
  Tactic(s)       : Reconnaissance
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-30T00:33:01.532179+00:00
  Reference       : https://attack.mitre.org/techniques/T1591/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1591_004_Identify_Roles_Staff_Page_Then_User_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects one external source requesting organisation, staff or leadership pages and then probing user, author, directory or role enumeration endpoints within ten minutes. This pattern is consistent with an adversary mapping business roles and personnel before targeting."
    mitre_tactic = "Reconnaissance"
    mitre_technique = "T1591.004"
    mitre_technique_name = "Gather Victim Org Information: Identify Roles"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with HTTP inspection that populate NETWORK_HTTP events with principal.ip and target.url (decrypted or reverse-proxy visibility is needed for HTTPS)."
    platform = "PRE"
    log_source = "ips"
    false_positives = "Search engine and SEO crawlers, uptime and content monitors, authorised penetration tests or external attack-surface scans not in the scanner list, sites with public author archives, and legitimate job seekers or journalists browsing team pages and then author or directory pages."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Adjust the URL regexes to the client's application layout. Raise the match threshold or add a response-code filter if the IPS populates network.http.response_code. Correlate with repeated blocked-attempt verdicts for escalation."

  events:
    $roles.metadata.event_type = "NETWORK_HTTP"
    $roles.target.url = /\/(about(-us)?|team|our-team|staff|leadership|management|executives|our-people|people|meet-the-team|board)(\/|\.html?|\.php|\?|$)/ nocase
    not $roles.principal.ip in %rfc1918_internal
    not $roles.principal.ip in %global_allowed_scanners
    $roles.principal.ip = $src_ip

    $enum.metadata.event_type = "NETWORK_HTTP"
    $enum.target.url = /(wp-json\/wp\/v2\/users|[?&]author=\d+|\/author\/|\/members(\/|\?|$)|\/users(\/|\?|$)|\/employees|\/org-chart|\/ldap|\/api\/[^?]*(users|employees|roles|groups)|\/staff-directory)/ nocase
    not $enum.principal.ip in %rfc1918_internal
    not $enum.principal.ip in %global_allowed_scanners
    $enum.principal.ip = $src_ip

    $roles.metadata.event_timestamp.seconds <= $enum.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1591.004")
    $primary_entity = array_distinct($src_ip)
    $roles_urls = array_distinct($roles.target.url)
    $enum_urls = array_distinct($enum.target.url)
    $enum_request_count = count($enum.metadata.id)
    $target_hosts = array_distinct($enum.target.hostname)

  condition:
    $roles and $enum
}
