/*
  MITRE Technique : T1584.002 - DNS Server
  Tactic(s)       : Resource Development
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : PRE
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T23:20:43.187535+00:00
  Reference       : https://attack.mitre.org/techniques/T1584/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1584_002_DNS_TXT_NULL_Long_Label_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for TXT or NULL records whose name contains an abnormally long, high-entropy-looking label under a domain that is not on the known-good list. This is the network-side signature of DNS used as a covert C2 or exfiltration channel, which is typical of attacker-controlled or compromised third-party DNS infrastructure."
    mitre_tactic = "Resource Development"
    mitre_technique = "T1584.002"
    mitre_technique_name = "Compromise Infrastructure: DNS Server"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS, with network.dns.questions.name and network.dns.questions.type populated."
    platform = "PRE"
    log_source = "dns"
    false_positives = "Email security (SPF/DKIM/DMARC) lookups, DNS-based blocklist and reputation services, CDN and cloud vendor verification records, antivirus cloud lookups, domain-ownership verification TXT queries, and some VPN or telemetry agents that encode data in labels."
    tuning_guidance = "Add legitimate vendor, CDN and reputation-service domains to %global_allowed_domains. Add approved DNS-based tooling and resolver sources to %global_allowed_mgmt_sources. Raise or lower the label length quantifier {40,} to fit the environment. Keep %rfc1918_internal current so internal resolver targets are excluded."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 16 or $dns.network.dns.questions.type = 10)
    $dns.network.dns.questions.name = /[a-z0-9_-]{40,}\./ nocase
    $reg = re.capture(strings.to_lower($dns.network.dns.questions.name), /([a-z0-9-]+\.[a-z0-9-]+)\.?$/)
    not $reg in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1584.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $queried_domains = array_distinct($reg)
    $source_ips = array_distinct($dns.principal.ip)

  condition:
    $dns
}
