/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T18:46:44.256546+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Linux_Proc_Mem_Write_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to /proc/<pid>/mem of another process. Writing to a live process's memory file is the core primitive of Linux proc-memory injection (T1055.009). It lets an attacker place shellcode or overwrite code and GOT entries in a legitimate process without ptrace-style command lines. The rule works on the resulting file-modification artifact, not on process creation or command-line content. Writes to /proc/self/mem are excluded because they are common in runtimes and JITs."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires Linux EDR file-activity telemetry or auditd with file-write watches or syscall rules (openat/write on /proc/*/mem) normalised to UDM FILE_MODIFICATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers (gdb, lldb), live-patching and checkpoint/restore tools (criu), crash dumpers, runtime profilers and instrumentation frameworks, and EDR/security agents that write process memory."
    tuning_guidance = "Add approved debugger, profiler and live-patch binaries to %global_allowed_admin_tools. Add EDR and security agent binaries to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Developer and build hosts typically need the most tuning."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/mem$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(gdb|gdbserver|lldb|lldb-server|strace|ltrace|criu)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $target_mem_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
