/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T18:47:02.440054+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Injection_Into_Common_Host_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process injects into a different process, and that injected-into process then makes an outbound connection to a non-internal address within five minutes. Injection into a commonly abused Windows host process followed by external network activity is a strong sign of injected implant code beaconing from a trusted process. It does not depend on command-line content."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires endpoint telemetry that emits process injection events (remote thread creation, process hollowing or APC injection) and network connection events with process context."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, application compatibility shims, game overlays, DRM or anti-cheat components, third-party security or DLP agents hooking explorer.exe, and remote-support tooling that injects into user sessions."
    tuning_guidance = "Add approved injecting agents to %global_allowed_security_tools, %global_allowed_admin_tools or %global_allowed_backup_processes. Recurring benign injector-to-victim pairs can be excluded by injector executable name. Extend or narrow the victim process name list per environment."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(explorer|svchost|notepad|rundll32|regsvr32|dllhost|werfault|taskhostw|sihost|spoolsv|msiexec|searchindexer|wuauclt|runtimebroker|smartscreen)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services|lsass)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    $inj.principal.hostname = $hostname
    $inj.target.process.file.full_path = $victim

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(explorer|svchost|notepad|rundll32|regsvr32|dllhost|werfault|taskhostw|sihost|spoolsv|msiexec|searchindexer|wuauclt|runtimebroker|smartscreen)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $victim

    $inj.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $victim over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($hostname)
    $injector_processes = array_distinct($inj.principal.process.file.full_path)
    $victim_processes = array_distinct($victim)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $injection_count = count($inj.metadata.id)

  condition:
    $inj and $net
}
