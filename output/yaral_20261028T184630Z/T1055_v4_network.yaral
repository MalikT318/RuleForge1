/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T18:47:35.557517+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Injection_Host_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows process that normally has no reason to talk to the internet (a sacrificial or hollowing target such as notepad, calc, mspaint, dllhost, werfault, rundll32, taskhostw, or sihost) opening an outbound connection to an external address. Injected implants commonly run inside these hosts and beacon from them. This is a network-side behavioural detection that does not depend on command lines or process creation."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path, such as EDR network events or Sysmon Event ID 3, normalised to NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rundll32 or dllhost launched by legitimate shell extensions, cloud-storage or telemetry components, and OS diagnostics. Werfault.exe sending crash reports to vendor endpoints. Taskhostw or sihost reaching Microsoft services. Notepad or wordpad opening documents from external UNC or WebDAV shares. Software installers that proxy their traffic through rundll32."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add approved agents and management tooling that legitimately use these hosts to %global_allowed_security_tools or %global_allowed_admin_tools. Narrow or extend the host-process list in the regex to fit the client environment. If a client proxies all egress, make sure target.ip carries the real destination and not the proxy address."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|write|wordpad|dllhost|werfault|rundll32|taskhostw|sihost|ctfmon|searchprotocolhost|gpupdate|backgroundtaskhost)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($net.principal.hostname)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
