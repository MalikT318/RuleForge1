/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T18:47:19.696207+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Linux_Service_Daemon_Spawns_Shell_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service daemon (web server, PHP FastCGI, database, cache, or print service) directly spawning a shell or script interpreter. These daemons rarely launch interactive interpreters. When they do, it commonly means code was injected into or executed within the daemon's address space (T1055), or the daemon was exploited. The rule matches on parent-child lineage only and does not inspect command lines, so it complements command-line rules."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications that call system()/exec() through a shell (PHP, CGI, legacy admin panels), database maintenance hooks (postgres archive_command, MySQL UDF or backup scripts), print filters run by the CUPS daemon, and monitoring or health-check scripts launched by the daemon."
    tuning_guidance = "Add approved parent binaries or hosts to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Extend or narrow the parent daemon list for the client's stack. For noisy PHP or CGI hosts, scope with an allowlist of expected parent paths rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|fish|python[0-9.]*|perl|ruby|lua)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
