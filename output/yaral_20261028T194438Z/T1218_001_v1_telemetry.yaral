/*
  MITRE Technique : T1218.001 - Compiled HTML File
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:41:54.337042+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_001_CHM_File_Dropped_By_Unusual_Writer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a Compiled HTML Help (.chm) file in a user-writable or staging location by an Office application, script host, shell, or archive utility. Detects the dropped CHM artifact rather than hh.exe command-line arguments, so it still fires if process command-line logging is evaded. Dropping a CHM this way commonly precedes its execution through the HTML Help executable."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.001"
    mitre_technique_name = "System Binary Proxy Execution: Compiled HTML File"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or help-documentation updaters that extract .chm files to temp folders, developers building help files with script tooling, users extracting vendor documentation archives, and IT packaging scripts."
    tuning_guidance = "Add approved packaging and deployment tool executables to %global_allowed_admin_tools, approved automation hosts to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. If archive extraction is noisy, remove the archive utilities from the writer regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata\\local\\temp|appdata\\roaming|appdata\\local|downloads|desktop|documents)|users\\public|programdata|windows\\temp|temp)\\.*\.chm$/ nocase
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|wscript|cscript|mshta|powershell|pwsh|cmd|rundll32|regsvr32|certutil|bitsadmin|curl|7z|7zg|winrar|rar|unrar|winzip)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1218.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
