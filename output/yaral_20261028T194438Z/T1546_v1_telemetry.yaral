/*
  MITRE Technique : T1546 - Event Triggered Execution
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:58:36.967673+00:00
  Reference       : https://attack.mitre.org/techniques/T1546
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_Office_Suite_Mailbox_Rule_Or_Workflow_Trigger_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of event-triggered automation inside a cloud productivity tenant: mailbox inbox rules (fire on every inbound message) and workflow automation flows (fire on mail, file or schedule triggers). Adversaries abuse these server-side triggers to keep persistent, repeatable execution or data movement that survives password resets and requires no endpoint foothold. The rule works at the configuration-change layer (SETTING_MODIFICATION) and does not depend on any command-line or process telemetry."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546"
    mitre_technique_name = "Event Triggered Execution"
    log_prerequisites = "Unified audit logs from the tenant ingested and parsed to UDM with metadata.product_event_type populated. Mailbox auditing and workflow/flow activity auditing must be enabled in the tenant."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users creating legitimate mailbox organisation rules (foldering, categorising, out-of-office), business users building approved workflow automations, IT-managed provisioning scripts and migration tooling, onboarding of new staff, and approved low-code citizen-developer programmes."
    tuning_guidance = "Add automation and provisioning identities to %global_allowed_service_accounts, approved administrators to %global_allowed_admin_users, and approved integration principals to %global_allowed_cloud_principals. If volume is high, restrict the product_event_type regex to workflow creation and inbox rule modification only, or promote to a threshold rule grouped per user. Consider raising severity when the actor is also flagged for risky sign-in."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules|CreateFlow|EditFlow|PutFlow|CreateFlowPermission|EditFlowPermission)$/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $change_types = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)
    $target_resources = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
