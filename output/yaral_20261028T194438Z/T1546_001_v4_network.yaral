/*
  MITRE Technique : T1546.001 - Change Default File Association
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:01:09.895899+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_001_Script_Handler_Opening_Document_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side indicator of a hijacked file-association handler. A script host or LOLBin interpreter whose own command line ends in a document, media or text file argument (for example a .txt, .pdf or .jpg being 'opened') makes an outbound connection to a non-internal address. Legitimate viewers do not run through wscript, mshta, powershell or rundll32 and then call out. This pattern appears when a registry shell\\open\\command handler is replaced with a malicious interpreter and the user opens a file of that type. Complements process-creation and registry rules by observing the resulting network behaviour."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.001"
    mitre_technique_name = "Event Triggered Execution: Change Default File Association"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates principal.process.file.full_path and principal.process.command_line on NETWORK_CONNECTION events, plus target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or logon scripts that take a data file (.csv, .txt, .log) as a parameter and then call internal or external web services; PowerShell-based reporting or inventory tools that accept a document argument; software packagers using rundll32 with a file argument; RMM-driven scripts."
    tuning_guidance = "Add approved scripting hosts to %global_allowed_script_hosts and approved admin tooling binaries to %global_allowed_admin_tools. Narrow or widen the interpreter list and the extension list in the regexes to match the client's environment. If NETWORK_CONNECTION events lack command_line in a client's telemetry, the rule will not fire for that client and the log source needs review."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(wscript|cscript|mshta|powershell|pwsh|rundll32|regsvr32)\.exe$/ nocase
    $net.principal.process.command_line = /\.(txt|log|rtf|csv|ini|jpe?g|png|gif|bmp|pdf|docx?|xlsx?|pptx?|mp3|mp4|avi|zip)["']?\s*$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $handler_process = array_distinct($net.principal.process.file.full_path)
    $handler_command_line = array_distinct($net.principal.process.command_line)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
