/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:35:00.622229+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_Container_Kube_Discovery_Cache_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of Kubernetes client API discovery/HTTP cache files (.kube/cache/discovery, .kube/cache/http, .kube/http-cache) inside a container or on a node. These files are written as a side effect of a client enumerating cluster resources (pods, nodes, deployments, API groups) and persist even when command-line logging is evaded, renamed, or wrapped in a script."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Requires container runtime or node-level file telemetry that produces FILE_CREATION events with target.file.full_path populated (runtime security sensor or EDR on container hosts)."
    platform = "Containers"
    log_source = "container"
    false_positives = "Cluster administrators or developers running Kubernetes CLI tooling from jump hosts or build nodes, CI/CD runners and GitOps agents that query the API, debug or ephemeral troubleshooting containers started by approved operators, and monitoring or inventory agents."
    tuning_guidance = "Add approved admin and CI binaries to %global_allowed_admin_tools, automation identities to %global_allowed_service_accounts, and named cluster administrators to %global_allowed_admin_users. Consider scoping to production workload namespaces or nodes where interactive cluster queries are never expected. Note: setting a custom client cache directory moves the artifact, so pair with Kubernetes audit-log rules for list/get API calls from pod service accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(^|\/)\.kube\/(cache\/(discovery|http)|http-cache)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($file.principal.hostname)
    $acting_user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $cache_paths = array_distinct($file.target.file.full_path)

  condition:
    $file
}
