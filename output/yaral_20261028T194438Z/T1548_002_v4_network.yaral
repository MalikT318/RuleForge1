/*
  MITRE Technique : T1548.002 - Bypass User Account Control
  Tactic(s)       : Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:31:12.802796+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_002_UAC_AutoElevate_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in auto-elevating Windows binary (commonly abused for UAC bypass via registry hijack, COM elevation or remote INF) initiating a network connection to a non-internal address. These binaries have no routine need to talk to external hosts, so outbound traffic indicates hijacked execution flow or payload retrieval during elevation. This is network-side coverage and does not depend on command-line matching."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.002"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Bypass User Account Control"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "CMSTP profile installs that fetch a connection profile from an external server, VPN or DCC packaging tools, sdclt backup features with cloud targets, EDR or sandbox agents that inject into these processes, and admin troubleshooting."
    tuning_guidance = "Add known-good remote destinations to %global_allowed_domains, approved tooling to %global_allowed_admin_tools, and security agents to %global_allowed_security_tools. If cmstp or sdclt generates noise in a given tenant, scope the exclusion by host through %global_allowed_remote_mgmt rather than removing the binary from the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(fodhelper|computerdefaults|eventvwr|cmstp|sdclt|dccw)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
