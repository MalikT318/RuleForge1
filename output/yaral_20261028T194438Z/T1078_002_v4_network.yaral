/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:31:36.506627+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Linux_External_Kerberos_LDAP_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host opening a connection to a non-internal address on Active Directory authentication and directory ports (Kerberos 88, kpasswd 464, LDAP 389, LDAPS 636, Global Catalog 3268/3269). Domain controllers should be reached over internal address space. Direct internet-bound domain authentication from a Linux endpoint suggests domain credentials are being used from a compromised host, through a tunnel or proxy, or against an exposed or attacker-controlled domain service."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) normalised to NETWORK_CONNECTION with principal hostname, target IP and target port populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hybrid or cloud-hosted Linux servers that reach a domain controller or managed AD service by public or NAT address; sssd/realmd/adcli domain-join and enrolment jobs; sites whose DCs sit outside RFC1918 space; approved vendor federation or LDAP-as-a-service integrations."
    tuning_guidance = "Add approved directory-integration binaries (sssd, realmd, adcli, winbind wrappers) to %global_allowed_admin_tools. Add service accounts used for directory sync to %global_allowed_service_accounts. Populate %rfc1918_internal with any customer-owned non-RFC1918 internal ranges that host DCs, or add the hosts to a per-client exclusion in %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 88 or
      $net.target.port = 464 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
