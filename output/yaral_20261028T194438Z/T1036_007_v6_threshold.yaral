/*
  MITRE Technique : T1036.007 - Double File Extension
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:08:37.566864+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_007_Double_Extension_File_Creation_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several files with a document or image extension followed by an executable or script extension (for example name.pdf.exe or name.docx.scr) were created on a single host within ten minutes. One such file may be an oddity, but a burst points to a masquerading payload drop, such as phishing attachments being extracted or staged."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.007"
    mitre_technique_name = "Masquerading: Double File Extension"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software packaging or build systems producing test artifacts, malware-analysis or sandbox hosts, developers generating sample files, backup or restore jobs, and security awareness training simulations."
    tuning_guidance = "Add approved installer, deployment and packaging processes to %global_allowed_admin_tools. Add backup and imaging software to %global_allowed_backup_processes. The #file threshold of 3 is conservative; raise it on build servers, or lower it to 2 on high-value hosts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(doc|docx|docm|xls|xlsx|xlsm|ppt|pptx|pdf|rtf|txt|csv|jpg|jpeg|png|gif|bmp|zip|mp3|mp4)\.(exe|scr|com|pif|bat|cmd|js|jse|vbs|vbe|wsf|hta|ps1|jar|cpl)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($file.target.file.full_path, /(?i)\.(scr|pif|hta|vbe|vbs|js|jse|wsf|cpl)$/), 85, 65))
    $file_count = count($file.metadata.id)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)
    $mitre_technique_id = array_distinct("T1036.007")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 3
}
