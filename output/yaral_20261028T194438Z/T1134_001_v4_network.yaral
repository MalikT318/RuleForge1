/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:53:43.157821+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_SYSTEM_Context_Interpreter_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side indicator of token impersonation or theft. Token theft (DuplicateTokenEx, ImpersonateLoggedOnUser, SetThreadToken) has no direct network signature, so this rule detects the result: a scripting or LOLBin interpreter running in the SYSTEM security context that makes an outbound connection to a non-internal address. This pattern is typical of a process whose token was duplicated from a SYSTEM process and then used for C2 or tool download. It is an indirect, heuristic indicator and should be correlated with endpoint token-manipulation telemetry."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires Windows EDR or Sysmon network connection telemetry (Sysmon Event ID 3 or equivalent) with the initiating process path and user context populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate SYSTEM-context PowerShell or cmd launched by RMM agents, software deployment tools, patching, or inventory scripts; scheduled tasks running as SYSTEM that call external update or licensing endpoints; management scripts run through approved remote tooling."
    tuning_guidance = "Add approved RMM, deployment, and patching binaries to %global_allowed_admin_tools. Add approved script-running processes to %global_allowed_script_hosts and approved remote support tooling to %global_allowed_remote_mgmt. Adjust the interpreter list to match client baselines. Consider enabling a destination-domain exclusion through %global_allowed_domains if NETWORK_HTTP data is added."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil)\.exe$/ nocase
    $net.principal.user.userid = /^((nt authority|autorite nt)\\)?system$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
