/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:15:01.396941+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_Linux_Python_Interpreter_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Python interpreter on Linux making an outbound connection to an external address while running inline code (-c) or a script staged in a world-writable directory (/tmp, /var/tmp, /dev/shm). This is the network-side footprint of Python reverse shells, in-memory stagers and downloaders. Complements process-creation rules by observing the resulting network behaviour."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd with connect syscall auditing) that populates NETWORK_CONNECTION events with the originating process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or automation scripts run from /tmp that call external APIs; configuration management agents (for example Ansible modules executed via python -c); package or patching helpers fetching updates; developers testing scripts from scratch directories; cloud-init and monitoring agents written in Python."
    tuning_guidance = "Add approved automation and patching binaries to %global_allowed_admin_tools, approved service accounts to %global_allowed_service_accounts, and build, jump or developer hosts to %global_allowed_script_hosts. Populate %rfc1918_internal with the client's internal address space so only external destinations alert."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/python[0-9.]*$/ nocase
    $net.principal.process.command_line = /(\s-c\s|\/(tmp|var\/tmp|dev\/shm)\/)/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $python_command_lines = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
