/*
  MITRE Technique : T1543.005 - Container Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:57:50.599592+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_005_Container_Daemon_API_Remote_Create_Or_Update {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP requests from a non-internal source to a container runtime daemon API or node agent API (Docker Engine API, kubelet) that create, update or start a container, or run or exec a command in one. Remote container creation with a restart policy, or modification of an existing container's restart policy, is a known persistence and privilege escalation path via exposed daemon APIs. This is a network-side view that complements endpoint command-line detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.005"
    mitre_technique_name = "Create or Modify System Process: Container Service"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with target.url, target.port and network.http.method populated, for example from a network sensor, service mesh, proxy or an ingress/east-west HTTP log in front of container hosts. TLS-protected daemon APIs (for example 2376) need TLS inspection or sidecar logging to expose the URL path."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD runners or external orchestration platforms that deploy to remote Docker hosts, managed-service control planes using public source addresses, and approved remote administration from a jump host with a public egress IP."
    tuning_guidance = "Add approved management and CI/CD source addresses to %global_allowed_mgmt_sources. Add service accounts that legitimately drive the API to %global_allowed_service_accounts. To also cover lateral movement from compromised internal hosts, remove the %rfc1918_internal exclusion and rely on %global_allowed_mgmt_sources alone. Adjust the daemon port list if the environment uses non-default ports."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    (
      $net.target.port = 2375 or
      $net.target.port = 2376 or
      $net.target.port = 10250
    )
    (
      $net.target.url = /\/(v[0-9]+(\.[0-9]+)?\/)?containers\/(create|[a-f0-9]{12,64}\/(update|start|exec))/ nocase or
      $net.target.url = /\/(run|exec)\/[^\/]+\/[^\/]+/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1543.005")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $request_urls = array_distinct($net.target.url)
    $request_count = count($net.metadata.id)

  condition:
    $net
}
