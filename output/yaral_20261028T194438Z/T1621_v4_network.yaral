/*
  MITRE Technique : T1621 - Multi-Factor Authentication Request Generation
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:46:50.010374+00:00
  Reference       : https://attack.mitre.org/techniques/T1621
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1621_Linux_Scripted_Client_MFA_Push_Endpoint {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host sending an HTTP POST to an MFA push or challenge API path using a non-browser scripting client user-agent, or no user-agent at all. Legitimate MFA pushes come from interactive login flows and browsers, or from authentication proxies. Scripted push generation from a server is characteristic of MFA fatigue tooling that uses stolen credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1621"
    mitre_technique_name = "Multi-Factor Authentication Request Generation"
    log_prerequisites = "Requires a forward proxy or TLS-inspecting perimeter that logs full HTTP URL path, method and user-agent. Without TLS inspection the URL path is not visible and the rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Self-hosted PAM, SSH or sudo MFA integrations that call push APIs from a Linux bastion; CI or automation jobs that exercise MFA APIs; identity-provider health monitors; authorised red-team or identity testing."
    tuning_guidance = "Add approved bastion and automation hosts to %global_allowed_script_hosts. Add authorised testing sources to %global_allowed_scanners. If a legitimate Linux PAM integration is noisy, add its source hostname to %global_allowed_script_hosts rather than loosening the URL pattern."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /(\/auth\/v[0-9]+\/(auth|preauth)|\/authn\/factors\/[^\/]+\/verify|\/SAS\/(BeginAuth|ProcessAuth)|\/(mfa|2fa|push)\/(challenge|send|push|notify|initiate|verify))/ nocase
    (
      $net.network.http.user_agent = /^(curl|wget|python|go-http-client|libwww-perl|okhttp|java|ruby|node|axios|powershell)/ nocase or
      $net.network.http.user_agent = ""
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1621")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
