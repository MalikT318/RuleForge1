/*
  MITRE Technique : T1072 - Software Deployment Tools
  Tactic(s)       : Execution, Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:15:57.979501+00:00
  Reference       : https://attack.mitre.org/techniques/T1072
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1072_Firewall_Deployment_Mgmt_Port_Fanout {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single internal source opens a high volume of connections to internal destinations on ports used by software deployment and remote management channels (WinRM, ConfigMgr client notification and remote control, WSUS/ConfigMgr HTTP/HTTPS) within ten minutes. Each connection is routine on its own. Wide fan-out from one source suggests a compromised deployment server or an adversary using one to push code to many endpoints."
    mitre_tactic = "Execution, Lateral Movement"
    mitre_technique = "T1072"
    mitre_technique_name = "Software Deployment Tools"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see east-west or inter-VLAN traffic between internal segments."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate deployment servers (patching, ConfigMgr, RMM) during maintenance windows; vulnerability scanners and asset discovery probing management ports; admin jump hosts running bulk WinRM tasks; monitoring systems polling management ports."
    tuning_guidance = "Add legitimate deployment server and jump host source addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to the same list, or to %global_allowed_scanners with a matching exclusion. Raise the #net threshold in high-volume environments. Review $distinct_targets: a high distinct-destination count is more suspicious than repeated connections to a few hosts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 8530 or
      $net.target.port = 8531 or
      $net.target.port = 10123 or
      $net.target.port = 2701
    )
    $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 2701, 80, 65))
    $mitre_technique_id = array_distinct("T1072")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $distinct_targets = count_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 20
}
