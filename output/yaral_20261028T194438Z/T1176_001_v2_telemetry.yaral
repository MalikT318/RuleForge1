/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:26:47.475856+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Linux_Browser_Prefs_Or_Policy_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-browser process modifying a Chromium-family browser Preferences or Secure Preferences file, or a managed browser policy JSON file under /etc. Both are used to silently install or force-install browser extensions for persistence. Detection is at the file-artifact layer, so it fires regardless of how the writer was invoked or whether command-line logging is evaded."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Software Extensions: Browser Extensions"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write watches covering user browser profile directories (~/.config, ~/snap, ~/.var/app) and /etc/opt/chrome, /etc/chromium, /etc/opt/edge, /etc/brave policy directories, with the writing process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) deploying managed browser policies; enterprise MDM or RMM agents; package managers installing or upgrading browsers; profile migration or backup-restore tooling; legitimate administrator edits of policy files."
    tuning_guidance = "Add approved configuration management and deployment binaries to %global_allowed_admin_tools and approved remote management agents to %global_allowed_remote_mgmt. Extend the browser or package manager process regex if the client uses a custom browser wrapper or an unusual install path. If the sensor does not populate the writer process path, the rule will not fire by design, so confirm that telemetry first."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(\/(google-chrome|google-chrome-beta|chromium|BraveSoftware|microsoft-edge|vivaldi|opera)[^\/]*\/(.*\/)?(Secure )?Preferences$|^\/etc\/(opt\/chrome|chromium|opt\/edge|brave)[^\/]*\/policies\/(managed|recommended)\/[^\/]+\.json$)/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(chrome|chromium|chromium-browser|google-chrome|google-chrome-stable|brave|brave-browser|msedge|microsoft-edge|opera|vivaldi|vivaldi-bin|dpkg|apt|apt-get|rpm|dnf|yum|snapd|flatpak)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
