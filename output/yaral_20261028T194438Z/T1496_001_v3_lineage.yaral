/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:52:23.456709+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Linux_Service_Parent_Spawns_Miner_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application runtime or database service process spawning a shell or script interpreter whose command line carries cryptocurrency-mining behaviour: Stratum pool URIs or miner-specific CPU/algorithm/pool flags. A service process launching a shell is rare, and doing so with mining arguments strongly suggests exploitation of an internet-facing service or container workload followed by compute hijacking."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Requires Linux process-launch telemetry with full parent and child executable paths and command lines, from a node or container runtime agent, EDR or auditd execve events. The agent must run on the host or inside the container workload."
    platform = "Linux"
    log_source = "container"
    false_positives = "Authorised blockchain or mining research hosts, developer or CI containers that run miner benchmarks, and application runtimes (java, node) that legitimately shell out with mining-related strings in the command line, such as a crypto-wallet service."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. Narrow or extend the parent regex for the application stacks in use. Review hits from java and node parents first, as they are the noisiest."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|redis-server|mysqld|mariadbd|postgres|mongod|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|python[0-9.]*|perl|ruby|php)$/ nocase
    $proc.target.process.command_line = /stratum\+(tcp|ssl|tls)|stratum2\+|--donate-level|--cpu-priority|--randomx|--cryptonight|--algo[= ]|--coin[= ]|--rig-id/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
