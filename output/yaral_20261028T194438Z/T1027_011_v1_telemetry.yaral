/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:55:07.431141+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Registry_Encoded_Blob_Written_By_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script host or proxy-execution binary writing a large encoded blob (long base64 or comma-separated hex) into a Software registry value. This is the registry-as-fileless-storage pattern used to stage payloads, shellcode or configuration outside the file system. Detection is based on the registry state change, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon event IDs 12/13/14) that populates target.registry.registry_value_data and the writing process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrative PowerShell scripts that store certificates, license blobs, serialized configuration or encoded settings in Software keys; software installers and configuration management scripts; enterprise application deployments writing large base64 settings."
    tuning_guidance = "Add approved deployment, RMM and configuration tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Raise or lower the blob length thresholds (300 characters / 200 hex bytes) per client baseline. If a specific legitimate software key is noisy, add a key exclusion for that vendor's Software subtree. Correlate hits with later PROCESS_LAUNCH events that read the same value."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msbuild|wmic|reg)\.exe$/ nocase
    $reg.target.registry.registry_key = /\\Software\\/ nocase
    (
      $reg.target.registry.registry_value_data = /[A-Za-z0-9+\/]{300,}/ or
      $reg.target.registry.registry_value_data = /(?i)([0-9a-f]{2},){200,}/
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_value_names = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
