/*
  MITRE Technique : T1056 - Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:44:58.450361+00:00
  Reference       : https://attack.mitre.org/techniques/T1056
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_Cleartext_Credential_Form_POST_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of web portal credential capture (T1056.003). Flags an HTTP POST over unencrypted HTTP to an external destination, where the URL path looks like a login or authentication endpoint. This pattern is typical of a spoofed login page or harvesting endpoint receiving user-entered credentials. Because it observes the proxy or firewall rather than the endpoint, it adds coverage where process-based detections cannot see the traffic."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056"
    mitre_technique_name = "Input Capture"
    log_prerequisites = "Requires proxy or firewall logs with URL inspection that populate network.http.method and target.url (NETWORK_HTTP). Plain-HTTP traffic must be visible, or TLS-inspected, for the URL to be logged."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy internet-facing applications or IoT and appliance web consoles that still use plain HTTP for login. Captive portals and guest Wi-Fi authentication pages. Third-party vendor portals that have not enforced HTTPS. Authorised phishing simulations and penetration tests."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains (matched against target.hostname). Add authorised phishing-simulation or testing sources to %global_allowed_scanners. Narrow or widen the login-path regex to suit client web traffic. If the log source does not record the HTTP method, switch to a URL-only variant."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST"
    $net.target.url = /^http:\/\/[^\/]+\/[^?#]*(login|logon|signin|sign-in|sso|auth|authenticate|password|passwd|credential|verify)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1056")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
