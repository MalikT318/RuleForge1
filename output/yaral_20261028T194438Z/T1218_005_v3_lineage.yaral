/*
  MITRE Technique : T1218.005 - Mshta
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:48:36.679612+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_005_Mshta_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects mshta.exe launched by a parent process that should never legitimately spawn it, such as an Office application, web server worker, database service, print spooler, WMI provider host or script host. Detection is based on process lineage rather than command-line content, so it complements command-line rules and still fires when the HTA or script payload is obfuscated or fetched remotely."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.005"
    mitre_technique_name = "System Binary Proxy Execution: Mshta"
    log_prerequisites = "Requires Windows EDR or Sysmon process-creation telemetry (or Windows Security Event 4688 with parent process populated) normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business Office macros or add-ins that deliberately launch HTA front-ends; web or database applications that legitimately invoke HTA helpers; software installers and RMM or deployment tooling launching HTA-based wizards through a script host; IT login scripts run through wscript or cscript."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools. Remove parent families that are noisy in a given environment from the parent regex (for example wscript or cscript where HTA-based login scripts are in use). Review the $parent_process outcome to identify recurring benign lineage before allowlisting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\mshta\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|java|php-cgi|sqlservr|mysqld|oracle|postgres|spoolsv|wmiprvse|scrcons|wscript|cscript)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
