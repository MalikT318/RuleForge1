/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:29:45.145053+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_Audio_File_Upload_External_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound HTTP POST or PUT to an external destination where the URL references an audio file (wav, mp3, m4a, wma, flac, ogg, opus, amr, aac). This is the network-side signature of recorded audio from microphone capture being staged and exfiltrated over HTTP. Internal destinations, allowlisted domains, and approved remote-management tooling are excluded."
    mitre_tactic = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires NETWORK_HTTP events with http.method and target.url populated (web proxy, secure web gateway, or EDR HTTP telemetry). Process path fields are used for exclusions only when present."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Voicemail and call-recording uploads from collaboration or contact-centre clients, dictation and transcription tools, sanctioned cloud backup or sync of media files, users sharing audio through web apps, and developers testing speech APIs."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Add approved support and conferencing tooling to %global_allowed_remote_mgmt. Raise severity for hosts that also show endpoint microphone-access alerts from companion T1123 rules. Tighten the extension list if the client has a large legitimate media workflow."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.target.url = /\.(wav|mp3|m4a|wma|flac|ogg|opus|amr|aac)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|teams|ms-teams|zoom)\.exe$/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $uploaded_urls = array_distinct($net.target.url)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
