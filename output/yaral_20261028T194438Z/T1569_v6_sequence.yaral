/*
  MITRE Technique : T1569 - System Services
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:10:28.867992+00:00
  Reference       : https://attack.mitre.org/techniques/T1569
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_Service_Create_Interpreter_Then_Services_Spawn_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Windows service being created or reconfigured through sc.exe with a binary path that launches a command interpreter or script host. The service control manager (services.exe) then spawns an interpreter with execution-style arguments on the same host within 10 minutes. This pattern indicates a service used as an execution vehicle, as with PsExec-style tooling, ransomware deployment, or lateral movement."
    mitre_tactic = "Execution"
    mitre_technique = "T1569"
    mitre_technique_name = "System Services"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines and parent process paths (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and deployment tools that register services with wrapper scripts, RMM and patching agents, admin troubleshooting, and vendor service wrappers that start through cmd.exe."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Add known build or deployment hosts to %global_allowed_script_hosts. If a specific installer is noisy, exclude it by its parent executable name rather than by path."

  events:
    $svc_create.metadata.event_type = "PROCESS_LAUNCH"
    $svc_create.target.process.file.full_path = /\\sc\.exe$/ nocase
    $svc_create.target.process.command_line = /\b(create|config)\b/ nocase
    $svc_create.target.process.command_line = /\bbinpath\s*=/ nocase
    $svc_create.target.process.command_line = /\b(cmd|powershell|pwsh|mshta|wscript|cscript|rundll32|regsvr32)(\.exe)?\b/ nocase
    not $svc_create.principal.process.file.full_path in %global_allowed_admin_tools
    not $svc_create.principal.user.userid in %global_allowed_admin_users
    $svc_create.principal.hostname = $hostname

    $svc_exec.metadata.event_type = "PROCESS_LAUNCH"
    $svc_exec.principal.process.file.full_path = /\\services\.exe$/ nocase
    $svc_exec.target.process.file.full_path = /\\(cmd|powershell|pwsh|mshta|wscript|cscript|rundll32|regsvr32)\.exe$/ nocase
    $svc_exec.target.process.command_line = /(\s\/[ck]\s|\s-(enc|encodedcommand|command|nop|w)\b|\.(vbs|js|hta|ps1))/ nocase
    not $svc_exec.principal.hostname in %global_allowed_script_hosts
    $svc_exec.principal.hostname = $hostname

    $svc_create.metadata.event_timestamp.seconds <= $svc_exec.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1569")
    $primary_entity = array_distinct($hostname)
    $creating_users = array_distinct($svc_create.principal.user.userid)
    $service_commands = array_distinct($svc_create.target.process.command_line)
    $spawned_processes = array_distinct($svc_exec.target.process.file.full_path)
    $spawned_command_lines = array_distinct($svc_exec.target.process.command_line)

  condition:
    $svc_create and $svc_exec
}
