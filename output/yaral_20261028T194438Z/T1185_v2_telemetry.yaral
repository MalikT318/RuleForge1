/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:30:50.186280+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_Browser_Process_Handle_Opened_By_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-browser process opening a handle to a running web browser process. Browser session hijacking (man-in-the-browser, browser pivoting, cookie and session inheritance) requires injecting into, or reading the memory of, a browser that holds the victim's authenticated sessions. This rule works at the process-handle layer, so it fires regardless of command-line obfuscation or logging gaps."
    mitre_tactic = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires endpoint telemetry that records process-handle requests (for example Sysmon Event ID 10 or equivalent EDR process-access events) normalised to PROCESS_OPEN, with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint security agents, DLP and browser-isolation agents, accessibility and screen-reader tools, remote support and RMM tools, backup agents, browser updaters and crash handlers, automated UI testing frameworks (for example Selenium or Playwright drivers) on developer or QA machines."
    tuning_guidance = "Add approved EDR/AV binaries to %global_allowed_security_tools, RMM and deployment tooling to %global_allowed_admin_tools, and backup agents to %global_allowed_backup_processes. If automated browser-testing hosts are noisy, scope them out per client using %global_allowed_script_hosts. Keep the browser executable regex aligned with the browsers approved in each client environment."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore|msedgewebview2)\.exe$/ nocase
    $open.principal.process.file.full_path != ""
    $open.principal.hostname != ""

    // Browsers legitimately open their own child processes
    not $open.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore|msedgewebview2)\.exe$/ nocase

    // Core Windows components and browser updaters that routinely touch browser handles
    not $open.principal.process.file.full_path = /\\(csrss|wininit|winlogon|services|lsass|smss|svchost|dwm|werfault|conhost|taskhostw|explorer)\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv|elevation_service|GoogleUpdate|MicrosoftEdgeUpdate)\.exe$/ nocase

    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity = array_distinct($open.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $browser_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
