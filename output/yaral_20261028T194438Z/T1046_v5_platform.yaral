/*
  MITRE Technique : T1046 - Network Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:29:41.396054+00:00
  Reference       : https://attack.mitre.org/techniques/T1046
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1046_Linux_K8s_ClusterWide_Service_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-system identity listing Services, Endpoints or EndpointSlices across all namespaces through the Kubernetes API. Adversaries who land in a pod or hold a stolen service-account token use this call to map the services and backend addresses reachable in the cluster, with no scanner binary or process command line involved. This is the control-plane equivalent of a port or service scan."
    mitre_tactic = "Discovery"
    mitre_technique = "T1046"
    mitre_technique_name = "Network Service Discovery"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher for services, endpoints and endpointslices, and ingested into Chronicle with requestURI normalised to target.url and the caller to principal.user.userid."
    platform = "Linux"
    log_source = "container"
    false_positives = "Service meshes, ingress controllers, API gateways, monitoring and observability agents, service-discovery operators, GitOps controllers and cluster administrators running kubectl get svc -A. These often use dedicated service accounts."
    tuning_guidance = "Add expected discovery service accounts (mesh, ingress, monitoring, operators) to %global_allowed_service_accounts and named cluster admins to %global_allowed_admin_users. Built-in control-plane identities (system:kube-*, system:node:*, kube-system service accounts) are already excluded by regex. Raise severity for identities that are default or workload service accounts in application namespaces."

  events:
    $k8s.metadata.event_type = "USER_RESOURCE_ACCESS"
    $k8s.target.url = /^(https?:\/\/[^\/]+)?\/(api\/v1\/(services|endpoints)|apis\/discovery\.k8s\.io\/v[0-9a-z]+\/endpointslices)(\?.*)?$/ nocase
    $k8s.principal.user.userid != ""
    not $k8s.principal.user.userid = /^system:(kube-|node:|serviceaccount:kube-system:)/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1046")
    $primary_entity = array_distinct($k8s.principal.user.userid)
    $queried_endpoints = array_distinct($k8s.target.url)
    $source_ips = array_distinct($k8s.principal.ip)

  condition:
    $k8s
}
