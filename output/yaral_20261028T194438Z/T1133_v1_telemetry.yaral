/*
  MITRE Technique : T1133 - External Remote Services
  Tactic(s)       : Persistence, Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:49:04.018744+00:00
  Reference       : https://attack.mitre.org/techniques/T1133
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1133_Container_K8s_External_Exposure_Resource_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a Kubernetes Service or Ingress object (the API resource that publishes a workload to external clients) by an identity that is not an approved administrator or automation account. The rule alerts on the resulting control-plane configuration state change, not on any command line. Unapproved external exposure of a workload is a common way to establish an external remote service foothold, for example an exposed shell, SSH, VNC or management endpoint inside a pod."
    mitre_tactic = "Persistence, Initial Access"
    mitre_technique = "T1133"
    mitre_technique_name = "External Remote Services"
    log_prerequisites = "Requires Kubernetes API server audit logs, ingested with create verbs on services and ingresses and populating metadata.product_event_type or target.resource.name, plus principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "Developers and CI/CD pipelines deploying new applications, GitOps controllers and Helm or operator-driven releases, ingress controllers and cloud load balancer integrations, and legitimate new service onboarding."
    tuning_guidance = "Add deployment pipeline and controller identities to %global_allowed_service_accounts and named platform engineers to %global_allowed_admin_users. Add trusted management source addresses to %global_allowed_mgmt_sources. System namespaces are excluded by resource path. Extend the exclusion regex if additional platform namespaces are noisy in a given tenant."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    (
      $res.metadata.product_event_type = /(^|\.)(services|ingresses)\.create$/ nocase or
      $res.target.resource.name = /\/(services|ingresses)\/[^\/]+$/ nocase
    )
    not $res.target.resource.name = /\/namespaces\/kube-(system|public|node-lease)\// nocase
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_admin_users
    not $res.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1133")
    $primary_entity = array_distinct($res.principal.user.userid)
    $resource_name = array_distinct($res.target.resource.name)
    $source_ip = array_distinct($res.principal.ip)

  condition:
    $res
}
