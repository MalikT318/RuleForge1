/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:00:36.361239+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_ESXi_VM_File_Appended_Extension_Datastore {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects creation of a file in an ESXi datastore whose name is a virtual machine artifact (vmdk, vmx, vmsd, vmsn, vmss, nvram, vswp) followed by an additional appended extension. Ransomware that encrypts VMs on ESXi typically renames or rewrites these files with a new suffix. The rule matches the resulting file artifact rather than the command line, so it still fires if process logging is evaded or the encryptor binary is renamed."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires ESXi host file-activity telemetry (shell, hostd or an agent) normalised to UDM FILE_CREATION with target.file.full_path populated for /vmfs/volumes paths."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and replication tooling that writes temporary or renamed VM files, VM clone, migration or export jobs, administrators manually renaming or archiving VM files, and snapshot consolidation helpers."
    tuning_guidance = "Add backup, replication and imaging process paths to %global_allowed_backup_processes. Add approved automation accounts to %global_allowed_service_accounts. Add approved administrator tooling to %global_allowed_admin_tools. Extend the benign-suffix exclusion regex if a client uses a custom suffix for legitimate VM file handling."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/vmfs\/volumes\/.+\.(vmdk|vmx|vmsd|vmsn|vmss|nvram|vswp)\.[a-z0-9_\-]{3,20}$/ nocase
    not $file.target.file.full_path = /\.(lck|bak|tmp|log|sf|old|orig|swp)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
