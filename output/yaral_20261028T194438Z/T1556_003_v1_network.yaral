/*
  MITRE Technique : T1556.003 - Pluggable Authentication Modules
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:17:40.084068+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_003_PAM_Shared_Object_Download_Via_CLI_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host fetching a shared object (.so) file from an external destination using a command-line HTTP client (curl, wget, scripting libraries), as seen at a proxy or perimeter device. Staging a replacement or trojanised PAM module (for example a patched pam_unix.so or a credential-harvesting module) normally requires such a transfer before the module is placed in the PAM library directory. This is network-side coverage that complements endpoint file and command-line detections."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.003"
    mitre_technique_name = "Modify Authentication Process: Pluggable Authentication Modules"
    log_prerequisites = "Requires proxy or firewall HTTP logs with full URL and user-agent populated (TLS inspection or explicit forward proxy for HTTPS traffic). Destination IP must be populated for internal address exclusion."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Package or software installers that fetch .so libraries with curl or wget from vendor sites not in the allowed domain list; developers and build pipelines pulling native libraries; configuration management bootstrapping; legitimate PAM module deployment such as MFA or SSO agent installation."
    tuning_guidance = "Add known-good vendor, repository and CDN domains to %global_allowed_domains. Internal traffic is excluded through %rfc1918_internal. Extend the user-agent list per client if their tooling is unusual. For higher fidelity, restrict the URL regex to paths containing 'pam' once baseline noise is understood."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client|fetch)/ nocase
    $http.target.url = /\.so(\.[0-9]+)*(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1556.003")
    $primary_entity = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
