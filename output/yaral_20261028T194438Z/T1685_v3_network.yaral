/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:14:49.616606+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_Network_Log_Pipeline_Egress_Syslog_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects syslog-class log forwarding (TCP/UDP 514, 601, 6514) leaving the perimeter toward a non-internal destination. After an adversary tampers with logging configuration on a network device or host, redirecting telemetry to an external collector is a network-visible sign that the logging pipeline has been altered to reduce or divert defender visibility. This covers the log-redirection and pipeline-interference part of T1685 and is independent of any endpoint process or command-line rule."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "Requires firewall, proxy, or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated. Egress logging must cover traffic from network devices and server segments toward the internet."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate cloud-hosted SIEM or MDR log collectors, managed-service syslog relays, third-party SOC onboarding, vendor telemetry or support forwarding, and newly approved external log destinations that are not yet allowlisted."
    tuning_guidance = "Add approved external collector domains to %global_allowed_domains (matched on target.hostname). Add sanctioned log-forwarder source addresses to %global_allowed_mgmt_sources (matched on principal.ip). If the firewall does not resolve hostnames, rely on the source allowlist. Maintain %rfc1918_internal so internal collectors are never alerted on."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 514 or $net.target.port = 601 or $net.target.port = 6514)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
