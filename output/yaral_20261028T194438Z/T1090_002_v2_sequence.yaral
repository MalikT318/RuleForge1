/*
  MITRE Technique : T1090.002 - External Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:28:37.467580+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_002_ESXi_External_Login_Then_Network_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a management-plane or shell login to an ESXi host from a non-internal source address, followed within 10 minutes by a network-related configuration change on the same host (firewall ruleset, port group, virtual switch, or network stack). This pattern is consistent with an adversary opening or redirecting traffic on the hypervisor so it can act as a relay or port-forwarding hop toward external command and control infrastructure. This is not a command-line rule; it correlates authentication with a host configuration change."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.002"
    mitre_technique_name = "Proxy: External Proxy"
    log_prerequisites = "ESXi hostd, vmkernel and shell logs forwarded to Chronicle and parsed into UDM USER_LOGIN and SETTING_MODIFICATION events. The source IP must be populated on login events, and the configuration object name must be populated in target.resource.name on setting events."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators working remotely through a VPN or jump host whose egress IP is not in the approved management source list; approved network or security changes made soon after an external login; infrastructure automation and orchestration that logs in and adjusts firewall rulesets or port groups; initial host build or reconfiguration after a rebuild."
    tuning_guidance = "Add jump hosts, VPN egress addresses and management subnets to %global_allowed_mgmt_sources. Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. If your parser stores the ESXi hostname in principal.hostname instead of target.hostname, adjust the join fields accordingly. Narrow or widen the configuration-object regex to match local change conventions."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $hostname
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.hostname = $hostname
    $setting.target.resource.name = /(firewall|ruleset|portgroup|port\s?group|vswitch|netstack|tcpip|portforward)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

    $auth.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1090.002")
    $primary_entity = array_distinct($hostname)
    $source_ips = array_distinct($auth.principal.ip)
    $login_users = array_distinct($auth.target.user.userid)
    $changed_objects = array_distinct($setting.target.resource.name)
    $login_count = count($auth.metadata.id)
    $change_count = count($setting.metadata.id)

  condition:
    $auth and $setting
}
