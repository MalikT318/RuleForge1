/*
  MITRE Technique : T1090.004 - Domain Fronting
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:32:51.852423+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_004_Domain_Fronting_SNI_Host_Mismatch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTPS traffic to an external destination where the registered domain in the TLS SNI differs from the registered domain in the HTTP Host header. This is the core network signature of domain fronting, where a CDN-hosted front domain in the SNI hides the real destination in the Host header. Allowlisted domains and internal destinations are excluded."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.004"
    mitre_technique_name = "Proxy: Domain Fronting"
    log_prerequisites = "Requires NETWORK_HTTP telemetry that populates both the TLS SNI (network.tls.client.server_name) and the HTTP Host (target.hostname). Typical sources are EDR network events with TLS inspection, a TLS-inspecting proxy or secure web gateway, or Zeek/NDR HTTP and SSL logs normalised into UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "CDN and cloud services legitimately serving multiple related domains (Microsoft 365, Azure, Akamai, Cloudflare, Fastly), software update clients that use a different API host than the SNI, ad and telemetry redirects across vendor-owned domains, and TLS-inspecting proxies that rewrite the Host or SNI."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains (matched against both the Host and the SNI). Add approved security agents to %global_allowed_security_tools and approved management tooling to %global_allowed_admin_tools. The registered domain is approximated as the last two labels, so multi-part public suffixes such as co.uk need an allowlist entry. Review the Host and SNI values in the outcome fields to triage."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.tls.client.server_name != ""
    $http.target.hostname != ""

    // Normalise SNI and Host to a lowercase two-label registered-domain approximation (port stripped)
    $sni_base = re.capture(strings.to_lower($http.network.tls.client.server_name), "([^.:]+\\.[^.:]+)(?::\\d+)?$")
    $host_base = re.capture(strings.to_lower($http.target.hostname), "([^.:]+\\.[^.:]+)(?::\\d+)?$")
    $sni_base != ""
    $host_base != ""
    $sni_base != $host_base

    // External destinations only
    not $http.target.ip in %rfc1918_internal

    // Known-good domains and tooling
    not $http.target.hostname in %global_allowed_domains
    not $http.network.tls.client.server_name in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_security_tools
    not $http.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1090.004")
    $primary_entity = array_distinct($http.principal.hostname)
    $tls_sni = array_distinct($http.network.tls.client.server_name)
    $http_host = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $source_ips = array_distinct($http.principal.ip)
    $source_process = array_distinct($http.principal.process.file.full_path)

  condition:
    $http
}
