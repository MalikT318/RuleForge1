/*
  MITRE Technique : T1606 - Forge Web Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:22:53.849838+00:00
  Reference       : https://attack.mitre.org/techniques/T1606
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_Linux_Burst_Token_Endpoint_Requests_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Linux host, seen in proxy or firewall HTTP logs, sends a burst of scripted POST requests to external token, SAML or federation endpoints within ten minutes. This pattern is consistent with automated minting or forging of web credentials (forged tokens, SAML assertions, federated sessions), where a single request would be benign."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606"
    mitre_technique_name = "Forge Web Credentials"
    log_prerequisites = "Requires proxy or firewall logs normalised to UDM NETWORK_HTTP with principal.hostname, target.url, network.http.method and network.http.user_agent populated. TLS inspection is needed to see URL paths for HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "CI/CD runners and automation refreshing OAuth tokens, configuration management agents, cloud CLI and SDK clients on servers, monitoring agents authenticating to SaaS APIs, and batch jobs using client-credential flows."
    tuning_guidance = "Add sanctioned vendor and identity provider domains to %global_allowed_domains, automation accounts to %global_allowed_service_accounts, and approved management hosts to %global_allowed_mgmt_sources. Raise the #net threshold (default 20) for hosts that legitimately run frequent token refreshes. Review hosts that exceed the threshold against the identity provider's issuance logs."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /(\/oauth2?\/(v[0-9.]+\/)?token|\/connect\/token|\/saml2?(\/|$|\?)|\/adfs\/ls|\/federation|\/sts\/|\/\.well-known\/openid|\/api\/v[0-9]+\/(auth|token|session))/ nocase
    $net.network.http.user_agent = /(curl|wget|python|go-http-client|libwww|java|okhttp|node|axios|powershell|ruby|perl)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1606")
    $primary_entity = array_distinct($host)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 20
}
