/*
  MITRE Technique : T1574.010 - Services File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:39:34.279997+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_010_Service_Binary_Replaced_Then_Launched_By_SCM {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an executable file being created or overwritten by a non-installer process and then launched by the Service Control Manager (services.exe) from the same path on the same host within 10 minutes. This indicates a service binary was replaced because of weak file or directory permissions, so the attacker's payload runs with the service's privileges."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.010"
    mitre_technique_name = "Hijack Execution Flow: Services File Permissions Weakness"
    log_prerequisites = "Requires Windows endpoint telemetry that populates file creation events (e.g. Sysmon Event ID 11 or EDR file write events) with the writing process, plus process launch events with parent process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software self-updaters that replace a service executable and restart the service, in-place application upgrades run by custom deployment scripts, developers rebuilding and restarting a locally registered service, and RMM or patching agents not yet on the allowlist."
    tuning_guidance = "Add approved updater and deployment binaries to %global_allowed_admin_tools, and EDR/AV agents that update their own service binaries to %global_allowed_security_tools. If a vendor updater is noisy, add its executable name to the writer-process exclusion regex. Raise severity for events where the writer process runs from a user profile or temp directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.exe$/ nocase
    not $file.target.file.full_path = /\\windows\\(winsxs|servicing|softwaredistribution|installer)\\/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|wuauclt|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $path = strings.to_lower($file.target.file.full_path)

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\services\.exe$/ nocase
    $proc.target.process.file.full_path = /\.exe$/ nocase
    not $proc.target.process.file.full_path = /\\windows\\(system32|syswow64)\\svchost\.exe$/ nocase
    $proc.principal.hostname = $hostname
    $path = strings.to_lower($proc.target.process.file.full_path)

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.010")
    $primary_entity = array_distinct($hostname)
    $replaced_binary = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)
    $launched_by = array_distinct($proc.principal.process.file.full_path)
    $first_write_time = min($file.metadata.event_timestamp.seconds)
    $launch_time = max($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
