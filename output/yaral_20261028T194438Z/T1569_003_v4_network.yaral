/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:13:43.444172+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Systemd_Service_Writable_Path_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external network connection made by a process that was spawned by systemd (for example via systemctl start/enable) and whose binary runs from a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Legitimate system services do not run from these paths, so this is the network-side result of a malicious service unit executing attacker-supplied code."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR or auditd network connection telemetry with process lineage (parent process path) populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or self-updaters that temporarily run from /tmp under a transient systemd unit, CI/CD or build agents running as systemd services out of /var/tmp, and containerised or ephemeral workloads that stage binaries in /dev/shm."
    tuning_guidance = "Add approved binaries or tooling paths to %global_allowed_admin_tools, add known automation accounts to %global_allowed_service_accounts, and extend %global_allowed_domains / %global_allowed_mgmt_sources if a known update service legitimately triggers this. Internal traffic is excluded via %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/systemd$/ nocase
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_cmdline = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
