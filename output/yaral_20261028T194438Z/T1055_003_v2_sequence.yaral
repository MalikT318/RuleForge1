/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:49:10.192257+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Process_Handle_Then_Injection_Same_Victim {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process opens a handle to a commonly hijacked Windows host process and then triggers a process-injection event against the same victim process on the same host within five minutes. This sequence is consistent with thread execution hijacking (OpenThread/OpenProcess, SuspendThread, WriteProcessMemory, SetThreadContext, ResumeThread). The rule does not depend on command lines, so it is additive to process-creation detections."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires endpoint telemetry that emits process-handle-open (PROCESS_OPEN, e.g. Sysmon Event 10 or equivalent EDR telemetry) and process-injection (PROCESS_INJECTION) events with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security agents and EDR sensors, backup and imaging software, accessibility and screen-reader tools, application-compatibility shims, game anti-cheat or overlay software, debuggers and profilers used by developers, RMM and remote-support tooling."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and IT tooling or debuggers to %global_allowed_admin_tools. Extend or narrow the victim process list to match the environment. If the actor path is sparsely populated for a client, remove the $actor join."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $actor
    $open.target.process.file.full_path = $victim
    $open.target.process.file.full_path = /\\(explorer|svchost|notepad|winlogon|lsass|spoolsv|taskhostw|dllhost|rundll32|services|wmiprvse|searchindexer|runtimebroker|sihost|ctfmon)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|smss|werfault)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $hostname
    $inj.principal.process.file.full_path = $actor
    $inj.target.process.file.full_path = $victim
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $actor, $victim over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($open.principal.hostname)
    $actor_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $actor_user = array_distinct($open.principal.user.userid)
    $open_event_count = count($open.metadata.id)
    $injection_event_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
