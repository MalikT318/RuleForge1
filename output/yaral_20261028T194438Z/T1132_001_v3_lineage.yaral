/*
  MITRE Technique : T1132.001 - Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:45:57.172669+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_001_ESXi_MgmtDaemon_Spawns_Encoder {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or web-facing daemon (hostd, rhttpproxy, vpxa, openwsman, sfcb, slpd) spawning a data-encoding utility or scripting interpreter (base64, uuencode, xxd, openssl, python, perl). These daemons do not normally launch encoders. Spawning one suggests a web or management-plane exploit, or a hijacked service, staging encoded command-and-control data. The rule keys on process lineage, not command-line content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.001"
    mitre_technique_name = "Data Encoding: Standard Encoding"
    log_prerequisites = "ESXi shell/process execution logging forwarded to Chronicle and normalised to PROCESS_LAUNCH with parent and child process paths populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Diagnostic bundle generation or support tooling launched by hostd, vendor or third-party VIB agents that call python or openssl, certificate renewal workflows invoked by management daemons, and approved automation or health-check scripts."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools, %global_allowed_script_hosts or %global_allowed_backup_processes. If certificate renewal or vendor agents are noisy, narrow the child regex or exclude those parent paths. Review any hit where the child is base64, xxd or uuencode first, since these are rarely launched by daemons."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|rhttpproxy|vpxa|openwsman|sfcbd|sfcb-[a-z0-9_-]+|slpd|fdm)$/ nocase
    $proc.target.process.file.full_path = /\/(base64|uuencode|uudecode|xxd|openssl|python[0-9.]*|perl)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1132.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
