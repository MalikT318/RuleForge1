/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:56:57.590311+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Proc_Mem_Write_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated write activity against /proc/<pid>/mem pseudo-files by processes on a single Linux host within ten minutes. A single write is rare, and repeated writes are consistent with proc memory injection, where an attacker overwrites a live process's stack or code through the /proc filesystem, often with dd or a custom loader. The rule keys on the file-write behaviour, not on any command line or tool name."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write rules (for example watches on /proc/*/mem) normalised to UDM FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracing tools (gdb, strace, ptrace-based profilers), live-patching and hot-fix agents, crash and memory forensics tooling, EDR or runtime security agents, JIT or language runtime diagnostics, and developer workstations doing low-level debugging."
    tuning_guidance = "Add approved debuggers, profilers and patching agents to %global_allowed_admin_tools. Add security agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Raise the threshold on developer or build hosts that routinely debug processes, and lower it to 3 on hardened production servers."

  events:
    $proc.metadata.event_type = "FILE_MODIFICATION"
    $proc.target.file.full_path = /^\/proc\/(\d+|self|thread-self)\/(task\/\d+\/)?mem$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($host)
    $writer_processes = array_distinct($proc.principal.process.file.full_path)
    $target_mem_files = array_distinct($proc.target.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 5
}
