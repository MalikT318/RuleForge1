/*
  MITRE Technique : T1553.003 - SIP and Trust Provider Hijacking
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:03:15.159665+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Registry_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of Subject Interface Package (SIP) registrations (CryptSIPDll* OID entries) or Trust Provider FinalPolicy entries, where the Dll/FuncName values are redirected. Adversaries use this to make unsigned or malicious code appear validly signed to WinVerifyTrust and application control tools. The rule matches the registry mechanism rather than any tool name or DLL name."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon Event IDs 12/13/14) normalised to REGISTRY_MODIFICATION, including registry key and value name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installers that register custom SIPs or trust providers (code-signing and document-signing products, PKI client software, some application control or DLP agents), Windows servicing (TrustedInstaller/TiWorker) during updates, and admin-run regsvr32 registrations of approved signing components."
    tuning_guidance = "Add approved software deployment and signing-product installers to %global_allowed_admin_tools. Add security agents that legitimately register trust providers to %global_allowed_security_tools. Add trusted deployment or service accounts to %global_allowed_service_accounts. Review the registry key and value name in the alert to confirm whether the redirected DLL is unsigned or outside system directories."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Cryptography\\OID\\EncodingType 0\\CryptSIPDll(GetSignedDataMsg|PutSignedDataMsg|RemoveSignedDataMsg|CreateIndirectData|VerifyIndirectData|GetCaps)\\/ nocase or
      $reg.target.registry.registry_key = /\\Cryptography\\Providers\\Trust\\FinalPolicy\\/ nocase
    )
    $reg.target.registry.registry_value_name = /^(\$?dll|funcname|\$function)$/ nocase
    $reg.principal.hostname = $hostname
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity = array_distinct($hostname)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
