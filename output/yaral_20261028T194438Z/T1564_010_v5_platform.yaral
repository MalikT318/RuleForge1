/*
  MITRE Technique : T1564.010 - Process Argument Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:28:46.509492+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_010_PEB_Tamper_Cross_Process_Memory_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cross-process injection or memory-write activity from one process into a different, commonly spoofed Windows host process (shell, script host or proxy-execution binary). This is the memory-tampering step used for PEB command-line overwrite (argument spoofing) and process hollowing. It is additive to command-line rules because it detects the PEB/memory modification itself rather than the launch arguments. PEB argument spoofing exists only on Windows, so the platform stays Windows and the pivot is memory-tamper telemetry instead of an alternate OS."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.010"
    mitre_technique_name = "Hide Artifacts: Process Argument Spoofing"
    log_prerequisites = "Requires EDR or Sysmon-equivalent telemetry that normalises remote-thread, memory-write or process-injection activity to PROCESS_INJECTION, with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents and DLP or application-compatibility shims that write into other processes, debuggers and profilers used by developers, software installers, accessibility or input-method tools, and RMM/patching agents."
    tuning_guidance = "Add approved agents to %global_allowed_security_tools, deployment and RMM tooling to %global_allowed_admin_tools, and approved developer or debugging hosts to %global_allowed_script_hosts. If noise remains, review the principal process paths that recur on a host and allowlist them by executable name."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(cmd|powershell|pwsh|rundll32|regsvr32|mshta|wscript|cscript|msbuild|installutil|regasm|regsvcs|certutil|conhost|dllhost)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services|lsass|smss)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.010")
    $primary_entity = array_distinct($inj.principal.hostname)
    $source_process = array_distinct($inj.principal.process.file.full_path)
    $target_process = array_distinct($inj.target.process.file.full_path)
    $target_command_line = array_distinct($inj.target.process.command_line)
    $acting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
