/*
  MITRE Technique : T1090.001 - Internal Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:27:47.877668+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_001_Linux_Proxy_Forwarder_Config_Dropped_By_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a TCP proxy or port-forwarding configuration on a Linux host (xinetd service definitions, HAProxy configs, NGINX stream configs, stunnel configs, systemd .socket units) by a shell or scripting interpreter rather than a package manager. Adversaries use this to turn a compromised internal host into a relay for C2 traffic. This rule is file-creation based and does not match process command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.001"
    mitre_technique_name = "Proxy: Internal Proxy"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /etc/xinetd.d, /etc/haproxy, /etc/nginx, /etc/stunnel, /etc/systemd/system) normalised to UDM FILE_CREATION with principal process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or provisioning scripts (shell or Python based) deploying legitimate load balancers, reverse proxies or TLS tunnels. Container or image build scripts. Homegrown deployment tooling that is not a package manager or configuration management agent."
    tuning_guidance = "Add approved deployment or provisioning binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts. Where proxy roles are expected (load balancer tier), tune the path regex or suppress by host. Alert triage should check for a listening socket opened by the new service shortly after the file was created."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/etc\/(xinetd\.d\/[^\/]+|haproxy\/[^\/]+|nginx\/(conf\.d|stream[^\/]*)\/[^\/]+|stunnel\/[^\/]+|systemd\/system\/[^\/]+\.socket)$/ nocase
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|tee|cp|mv|install|cat|curl|wget)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|snapd|puppet|chef-client|salt-minion|ansible[^\/]*)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1090.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
