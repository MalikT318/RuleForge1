/*
  MITRE Technique : T1568 - Dynamic Resolution
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:03:05.541308+00:00
  Reference       : https://attack.mitre.org/techniques/T1568
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_Linux_Service_Parent_Spawns_DNS_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a web server, database or cache service process spawning a DNS lookup utility, either directly or through a shell wrapper. These services rarely run interactive resolver tools. When they do, it often means a webshell or compromised service is resolving attacker-controlled or algorithmically generated C2 names, as in dynamic resolution (T1568). The rule keys on the unexpected parent-child lineage, not on a specific domain or command string."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568"
    mitre_technique_name = "Dynamic Resolution"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH, with both parent and child process paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application health checks or monitoring scripts launched by the web server or database; PHP or CGI applications that shell out to dig/nslookup/host for mail or domain validation; database maintenance jobs that perform DNS diagnostics; admin troubleshooting through a web-based control panel."
    tuning_guidance = "Add legitimate parent service or wrapper paths to %global_allowed_script_hosts and approved monitoring or diagnostic tooling to %global_allowed_admin_tools. Extend the parent regex with client-specific application server binaries where appropriate. If a web control panel generates frequent noise, exclude it by parent path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(dig|nslookup|host|drill|resolvectl)$/ nocase or
      (
        $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash)$/ nocase and
        $proc.target.process.command_line = /(^|[\s;|&\/`(])(dig|nslookup|host|drill|resolvectl)\s+/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1568")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
