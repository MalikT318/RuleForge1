/*
  MITRE Technique : T1688 - Safe Mode Boot
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:34:58.477769+00:00
  Reference       : https://attack.mitre.org/techniques/T1688
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1688_SafeBoot_Registry_Persistence_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry changes under the SafeBoot control key that add an entry to the Minimal or Network safe-mode service lists, or that change the safe-mode AlternateShell value. Adversaries use these changes to make malicious services or shells load in safe mode, where EDR and other defences often do not start. This rule looks at the resulting registry state change, so it still fires when command-line logging is evaded."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1688"
    mitre_technique_name = "Safe Mode Boot"
    log_prerequisites = "Requires Windows endpoint registry telemetry from an EDR or Sysmon (registry events 12/13/14) that populates target.registry.registry_key and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security and backup agents that register their drivers or services to start in safe mode, driver or software installers, and IT deployment tooling that legitimately sets safe-mode service entries. AlternateShell changes are rare and usually deliberate."
    tuning_guidance = "Add approved installers, deployment tools and agents to %global_allowed_admin_tools or %global_allowed_security_tools (by executable path). Add known automation accounts to %global_allowed_service_accounts. Review the registry key and value outcomes to identify recurring legitimate products."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Control\\SafeBoot\\(Minimal|Network)\\[^\\]+/ nocase or
      (
        $reg.target.registry.registry_key = /\\Control\\SafeBoot$/ nocase and
        $reg.target.registry.registry_value_name = /^AlternateShell$/ nocase
      )
    )
    $reg.principal.hostname != ""
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1688")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
