/*
  MITRE Technique : T1537 - Transfer Data to Cloud Account
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:36:26.549417+00:00
  Reference       : https://attack.mitre.org/techniques/T1537
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1537_Bulk_File_Download_Then_External_Share {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single user downloads or syncs several files and then creates an anonymous sharing link, guest sharing invitation or secure link within 10 minutes. This pattern suggests data being staged and shared to an account the adversary controls, rather than moved through normal file transfer channels."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1537"
    mitre_technique_name = "Transfer Data to Cloud Account"
    log_prerequisites = "Requires unified audit logs with file download/sync and sharing activity, normalised to UDM USER_RESOURCE_ACCESS and USER_RESOURCE_UPDATE_CONTENT, with metadata.product_event_type and principal.user.userid populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users legitimately collaborating with external partners or contractors after downloading files, offline-sync clients performing initial sync followed by a share, project hand-offs, and migration or eDiscovery service accounts."
    tuning_guidance = "Add service and migration accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Adjust the download threshold in the condition (#access >= 5) to the customer baseline. Extend the product_event_type regexes if the tenant normalises sharing events under different names."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(FileDownloaded|FileSyncDownloadedFull|FileCopied)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

    $share.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $share.metadata.product_event_type = /(AnonymousLinkCreated|SharingInvitationCreated|AddedToSecureLink|SecureLinkCreated)/ nocase
    $share.principal.user.userid = $user
    not $share.principal.user.userid in %global_allowed_service_accounts
    not $share.principal.user.userid in %global_allowed_admin_users

    $access.metadata.event_timestamp.seconds <= $share.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1537")
    $primary_entity = array_distinct($user)
    $download_count = count($access.metadata.id)
    $share_count = count($share.metadata.id)
    $shared_resources = array_distinct($share.target.url)
    $source_ips = array_distinct($share.principal.ip)

  condition:
    #access >= 5 and #share >= 1
}
