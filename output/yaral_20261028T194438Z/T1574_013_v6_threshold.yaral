/*
  MITRE Technique : T1574.013 - KernelCallbackTable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:46:23.608599+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_013_KernelCallbackTable_Repeated_Injection_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of cross-process injection events on a single host within 10 minutes. Hijacking the KernelCallbackTable in the PEB of a GUI process requires a foreign process to obtain a handle, write memory into the victim and trigger the replaced callback. One injection can be benign; repeated injection from non-allowlisted processes into other processes on the same host is not."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.013"
    mitre_technique_name = "Hijack Execution Flow: KernelCallbackTable"
    log_prerequisites = "Requires Windows endpoint telemetry (EDR or Sysmon-equivalent) that emits cross-process injection or remote-thread/memory-write events normalised to PROCESS_INJECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, input method editors, game overlays, application-compatibility shims, DRM and anti-cheat agents, UI automation and test frameworks, EDR/DLP agents not yet in the allowlist, software deployment tools."
    tuning_guidance = "Add legitimate injecting binaries to %global_allowed_security_tools, %global_allowed_admin_tools or %global_allowed_backup_processes. Raise the #inj threshold on hosts with heavy UI-automation or overlay software. Review $target_processes in the outcome and prioritise hits on explorer, winlogon or other long-lived GUI processes."
 
  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.principal.process.file.full_path = /\.exe$/ nocase
    $inj.target.process.file.full_path = /\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services|lsass)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($inj.target.process.file.full_path = /(?i)\\(explorer|winlogon|taskmgr|sihost|dwm)\.exe$/, 85, 70))
    $mitre_technique_id = array_distinct("T1574.013")
    $primary_entity = array_distinct($host)
    $injection_count = count($inj.metadata.id)
    $injector_processes = array_distinct($inj.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $affected_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 3
}
