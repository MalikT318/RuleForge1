/*
  MITRE Technique : T1574.014 - AppDomainManager
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:47:53.567792+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_014_AppDomainManager_Env_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects persistent .NET runtime hijack settings written to the registry Environment keys (user or machine scope). The values APPDOMAIN_MANAGER_ASM, APPDOMAIN_MANAGER_TYPE and DOTNET_STARTUP_HOOKS make every .NET process started afterwards load an attacker-chosen assembly. This is registry-based coverage, separate from process command-line detection. The Windows registry is the only valid mechanism for this technique, so the alternate-platform angle was not applied."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.014"
    mitre_technique_name = "Hijack Execution Flow: AppDomainManager"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (value set events) populating target.registry.registry_key and registry_value_name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or build agents setting DOTNET_STARTUP_HOOKS for profiling or diagnostics (APM and observability agents, .NET instrumentation installers), and IT configuration management that deploys .NET runtime environment variables."
    tuning_guidance = "Add approved installers and configuration tools to %global_allowed_admin_tools. Add approved administrator accounts to %global_allowed_admin_users. Consider excluding developer workstation hosts through a client-specific scoping process."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment$/ nocase
    $reg.target.registry.registry_value_name = /^(APPDOMAIN_MANAGER_ASM|APPDOMAIN_MANAGER_TYPE|DOTNET_STARTUP_HOOKS)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $value_name = array_distinct($reg.target.registry.registry_value_name)
    $value_data = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
