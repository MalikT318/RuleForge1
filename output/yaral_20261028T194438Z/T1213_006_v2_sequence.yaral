/*
  MITRE Technique : T1213.006 - Databases
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:30:32.569182+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_006_Bulk_Database_Pull_Then_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single internal source pulls a large volume of data from a well-known database service port and then, within ten minutes, sends a large volume of data to an external destination. This pattern fits bulk collection from a database followed by staging or exfiltration. It uses network-observable behaviour only (ports, byte volumes, timing) and does not rely on process or command-line telemetry."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.006"
    mitre_technique_name = "Data from Information Repositories: Databases"
    log_prerequisites = "Requires perimeter or internal segmentation firewall or flow logs that record source IP, destination IP, destination port and per-session byte counts (sent and received), normalised to UDM NETWORK_CONNECTION. The firewall must see client-to-database traffic (internal segmentation) as well as outbound internet traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Database backup or replication jobs that also upload to external cloud storage, ETL and BI tools that pull large result sets and push to SaaS analytics, authorised vulnerability scanners, and DBAs running exports to approved vendors."
    tuning_guidance = "Add scanner and testing source IPs to %global_allowed_scanners. Add approved external destinations (backup, analytics and vendor domains) to %global_allowed_domains. Adjust the byte thresholds (10 MB database pull, 50 MB egress) to the customer baseline. Add or remove database ports (1433, 1521, 3306, 5432, 27017) to match the customer estate."

  events:
    $db.metadata.event_type = "NETWORK_CONNECTION"
    (
      $db.target.port = 1433 or
      $db.target.port = 1521 or
      $db.target.port = 3306 or
      $db.target.port = 5432 or
      $db.target.port = 27017
    )
    $db.network.received_bytes > 10000000
    $db.principal.ip = $src_ip
    not $db.principal.ip in %global_allowed_scanners

    $out.metadata.event_type = "NETWORK_CONNECTION"
    $out.network.sent_bytes > 50000000
    not $out.target.ip in %rfc1918_internal
    not $out.target.hostname in %global_allowed_domains
    not $out.principal.ip in %global_allowed_scanners
    $out.principal.ip = $src_ip

    $db.metadata.event_timestamp.seconds <= $out.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1213.006")
    $primary_entity = array_distinct($src_ip)
    $database_servers = array_distinct($db.target.ip)
    $database_ports = array_distinct($db.target.port)
    $external_destinations = array_distinct($out.target.ip)
    $max_db_received_bytes = max($db.network.received_bytes)
    $max_egress_sent_bytes = max($out.network.sent_bytes)

  condition:
    $db and $out
}
