/*
  MITRE Technique : T1578.004 - Revert Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:55:06.637556+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_004_Cloud_Instance_Snapshot_Restore {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a cloud control-plane API call that restores or reverts a compute instance, volume, disk or database from a snapshot or restore point, or replaces an instance root volume. Adversaries use these operations to roll a workload back to a pre-compromise state and destroy evidence of their activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.004"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Revert Cloud Instance"
    log_prerequisites = "Cloud provider control-plane audit logs (management or admin activity events) ingested and normalised to UDM with metadata.product_event_type populated with the API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Disaster-recovery tests and failover drills; backup validation jobs; infrastructure-as-code pipelines rebuilding environments from golden snapshots; autoscaling or patching automation replacing root volumes; developers resetting dev/test instances; database administrators performing point-in-time recovery after legitimate data corruption."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named administrators who perform recovery to %global_allowed_admin_users. Raise severity or $risk_score for production or high-value accounts and projects. If a client's logs use different operation names, extend the product_event_type regex. Pair with alerts on snapshot deletion and instance stop events for stronger coverage."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(RestoreDB(Instance|Cluster)From|RestoreDBInstanceToPointInTime|RestoreDBClusterToPointInTime|CreateReplaceRootVolumeTask|RestoreSnapshot|RevertToSnapshot|RevertSnapshot|RestoreVolume|RestoreManagedInstance|snapshots?\.(restore|revert)|restorePoints?\.(restore|revert)|virtualMachines?\/restore)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1578.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
