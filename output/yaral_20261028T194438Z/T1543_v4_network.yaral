/*
  MITRE Technique : T1543 - Create or Modify System Process
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:52:48.241106+00:00
  Reference       : https://attack.mitre.org/techniques/T1543
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_Linux_K8s_DaemonSet_Write_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write request (create, replace or patch) to the Kubernetes DaemonSet API from a non-internal source address. A DaemonSet schedules a pod on every node and restarts it automatically, so it is the cluster equivalent of installing a persistent system service. A request from outside internal address space suggests an exposed API server, stolen credentials or token abuse. This is a network-side detection on the control-plane API call, not on process command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543"
    mitre_technique_name = "Create or Modify System Process"
    log_prerequisites = "Requires Kubernetes API server audit or request logs normalised to NETWORK_HTTP, with network.http.method, target.url and principal.ip populated."
    platform = "Linux"
    log_source = "container"
    false_positives = "Remote CI/CD runners or GitOps controllers outside internal ranges, administrators working over a public VPN egress or NAT address, managed-cluster add-on installers, and cloud provider control-plane integrations that deploy node agents (CNI, logging, monitoring DaemonSets)."
    tuning_guidance = "Add approved CI/CD and GitOps identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named cluster administrators to %global_allowed_admin_users. Make sure %rfc1918_internal covers every customer's internal address space, including any NAT or VPN egress ranges. If the audit pipeline records response codes, consider restricting to successful requests per client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.target.url = /\/apis\/apps\/v1\/(namespaces\/[^\/]+\/)?daemonsets(\/|\?|$)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_cloud_principals
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543")
    $primary_entity = array_distinct($net.principal.ip)
    $request_urls = array_distinct($net.target.url)
    $request_methods = array_distinct($net.network.http.method)
    $acting_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
