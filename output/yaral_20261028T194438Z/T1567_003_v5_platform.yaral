/*
  MITRE Technique : T1567.003 - Exfiltration to Text Storage Sites
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:00:17.624826+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_003_Perimeter_Scripted_Upload_To_Unlisted_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter-observed HTTP POST/PUT upload to an external, non-allowlisted named host made by a non-browser scripting or library client (PowerShell, WinHTTP, curl, Python, Go and similar). This is the network-side signature of data pushed to a paste or text-storage service. The rule does not rely on endpoint process telemetry, so it adds coverage where the process-creation rule is blind (unmanaged hosts, in-memory tooling, renamed binaries). It is written for Windows-originated traffic but depends only on proxy/firewall fields. The Windows client user-agent strings are used as a generic scripted-client signal, not a named attacker tool."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.003"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Text Storage Sites"
    log_prerequisites = "Requires secure web gateway, proxy or NGFW logs normalised to NETWORK_HTTP with network.http.method, network.http.user_agent, network.sent_bytes and target.hostname populated. HTTPS requires TLS inspection to expose method and user agent. Populate %global_allowed_domains with known-good vendor, update and API domains before enabling."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Windows software updaters and telemetry agents using WinHTTP or PowerShell to post to vendor domains missing from the allowlist; developer or CI hosts calling REST APIs with curl or Python; IT automation posting inventory or logs to SaaS endpoints; backup or monitoring agents using Go or Java HTTP libraries."
    tuning_guidance = "Add known-good vendor and SaaS API domains to %global_allowed_domains. Add automation, CI and build hosts to %global_allowed_script_hosts. Add approved automation accounts to %global_allowed_service_accounts. Add named administrators who legitimately script uploads to %global_allowed_admin_users. Raise or lower the sent_bytes floor per client to balance noise against small-paste coverage."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /(powershell|winhttp|bits|curl|wget|python|go-http-client|java\/|okhttp|libwww|node-fetch|axios|urllib|aiohttp|httpclient)/ nocase
    $net.network.sent_bytes >= 1024
    $net.network.sent_bytes <= 52428800
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $bytes_uploaded = max($net.network.sent_bytes)

  condition:
    $net
}
