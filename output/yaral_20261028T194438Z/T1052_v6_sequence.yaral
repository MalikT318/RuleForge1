/*
  MITRE Technique : T1052 - Exfiltration Over Physical Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:41:56.351859+00:00
  Reference       : https://attack.mitre.org/techniques/T1052
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_Linux_Removable_Media_Mount_Then_Data_Copy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a removable block device (/dev/sdX) being mounted on a Linux host, followed within 10 minutes by a copy, archive or move command that reads from a sensitive data location and writes to a removable mount point (/media, /run/media, /mnt). This pattern is consistent with staging and exfiltration of data over a physical medium."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052"
    mitre_technique_name = "Exfiltration Over Physical Medium"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates full process command lines for PROCESS_LAUNCH events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or users performing legitimate backups to external disks, field engineers moving approved data, software or firmware deployment from USB media, and ad-hoc copies to manually mounted /mnt volumes such as NFS or secondary internal disks."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, automation accounts to %global_allowed_service_accounts, and approved IT tooling to %global_allowed_admin_tools. Environments that mount internal data disks under /mnt should drop /mnt from the copy-event destination regex. Desktop auto-mounts performed by the udisks daemon may not show a mount command line, so confirm telemetry coverage."

  events:
    $mount.metadata.event_type = "PROCESS_LAUNCH"
    $mount.target.process.file.full_path = /\/(mount|udisksctl)$/ nocase
    $mount.target.process.command_line = /\/dev\/sd[b-z][0-9]*/ nocase
    not $mount.principal.process.file.full_path in %global_allowed_admin_tools
    not $mount.principal.user.userid in %global_allowed_service_accounts
    $mount.principal.hostname = $hostname

    $copy.metadata.event_type = "PROCESS_LAUNCH"
    $copy.target.process.file.full_path = /\/(cp|rsync|tar|zip|7z|7za|dd|mv)$/ nocase
    $copy.target.process.command_line = /(\s|=)\/(media|run\/media|mnt)\// nocase
    $copy.target.process.command_line = /\/(home|etc|var|srv|opt|root)\// nocase
    not $copy.principal.process.file.full_path in %global_allowed_backup_processes
    not $copy.principal.user.userid in %global_allowed_service_accounts
    not $copy.target.process.file.full_path in %global_allowed_admin_tools
    $copy.principal.hostname = $hostname

    $mount.metadata.event_timestamp.seconds <= $copy.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1052")
    $primary_entity = array_distinct($hostname)
    $mount_commands = array_distinct($mount.target.process.command_line)
    $copy_commands = array_distinct($copy.target.process.command_line)
    $acting_users = array_distinct($copy.principal.user.userid)
    $copy_event_count = count($copy.metadata.id)

  condition:
    $mount and $copy
}
