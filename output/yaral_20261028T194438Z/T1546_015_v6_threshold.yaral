/*
  MITRE Technique : T1546.015 - Component Object Model Hijacking
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:21:43.010454+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_015_COM_Hijack_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple per-user COM class or TypeLib registry modifications (InprocServer32, LocalServer32, InprocHandler32, TreatAs, ScriptletURL, TypeLib win32/win64) on a single host within 10 minutes. One COM registration is routine, but a burst of user-hive COM redirections is characteristic of COM hijacking for persistence."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.015"
    mitre_technique_name = "Event Triggered Execution: Component Object Model Hijacking"
    log_prerequisites = "Requires EDR or Sysmon-equivalent registry modification telemetry (Sysmon Event ID 12/13/14 or equivalent) with registry key and writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user application installers and updaters (collaboration clients, cloud storage clients, browsers), MSI repair or self-registration (regsvr32-style), developer machines registering COM components, Office add-in deployment."
    tuning_guidance = "Add approved installers and deployment tools to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and deployment service accounts to %global_allowed_service_accounts. Raise the #reg threshold on developer workstations. Review the writing process and value path in the outcome fields; user-writable DLL paths or script monikers are high confidence."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Classes\\(wow6432node\\)?(clsid\\\{[0-9a-f-]{36}\}\\(inprocserver32|localserver32|inprochandler32|treatas|scriptleturl)|typelib\\\{[0-9a-f-]{36}\}\\[0-9.]+\\[0-9a-f]+\\win(32|64))/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($reg.target.registry.registry_key, `(?i)(scriptleturl|treatas)`), 85, 65))
    $mitre_technique_id = array_distinct("T1546.015")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
