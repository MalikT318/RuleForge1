/*
  MITRE Technique : T1021.008 - Direct Cloud VM Connections
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:46:58.429557+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_008_Cloud_VM_Direct_Connect_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity performs a burst of cloud-native direct VM connection API calls (SSH key push to an instance, serial console access, or managed shell session start) within ten minutes. One such call is routine administration. Repeated calls from one principal suggest pivoting across virtual infrastructure with valid accounts."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.008"
    mitre_technique_name = "Remote Services: Direct Cloud VM Connections"
    log_prerequisites = "Cloud control-plane audit logs (management and data-plane API events for compute and instance-management services) ingested and normalised to UDM USER_RESOURCE_ACCESS with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud engineers and SREs troubleshooting several instances, break-glass console access during incidents, automation or CI/CD pipelines opening managed sessions, helpdesk staff using session-based remote support, and migration or patching windows."
    tuning_guidance = "Add automation and break-glass identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise the #cloud threshold for environments where session-based administration is the norm. Review the target_resources and source_ips outcomes to separate fan-out across many instances from repeated access to one host."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(SendSSHPublicKey|SendSerialConsoleSSHPublicKey|StartSession|ResumeSession|serialconsole.*connect|serialports.*connect|getSerialPortOutput|start-iap-tunnel|tunnelInstances|ssh.*instances|osLogin)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1021.008")
    $primary_entity = array_distinct($user)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 5
}
