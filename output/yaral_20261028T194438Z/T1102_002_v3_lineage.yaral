/*
  MITRE Technique : T1102.002 - Bidirectional Communication
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:56:15.902409+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_002_Unexpected_Parent_Spawns_Web_Capable_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process that is not expected to launch interpreters or download utilities (Office applications, web server workers, print spooler, database engines) spawning a web-capable script interpreter or transfer LOLBin. Such lineage is a strong indicator of an implant using a legitimate web service for bidirectional C2 (polling for commands and posting output). The rule matches on lineage only, not on the command line or destination, so it still fires when the C2 service, URL or payload changes."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.002"
    mitre_technique_name = "Web Service: Bidirectional Communication"
    log_prerequisites = "Windows endpoint process-creation telemetry with parent and child image paths populated (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros used by legitimate business workflows that call PowerShell or WScript; SQL Server Agent jobs or CLR procedures that run PowerShell; IIS applications that intentionally shell out to PowerShell (admin portals, deployment tools); print management or driver-install software launched by the spooler; software deployment and RMM agents."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Add service accounts that legitimately run scheduled SQL or IIS-driven automation to %global_allowed_service_accounts. If a single application is noisy, narrow the parent alternation rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|spoolsv|sqlservr)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|bitsadmin|certutil|curl)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1102.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
