/*
  MITRE Technique : T1552 - Unsecured Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:44:41.401144+00:00
  Reference       : https://attack.mitre.org/techniques/T1552
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_Container_Mass_Secret_Read_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity performs an unusually high number of get/list reads against Kubernetes Secret objects within 10 minutes. Any single secret read is routine, but bulk enumeration indicates harvesting of unsecured credentials such as tokens, registry pull credentials and application passwords from the cluster."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552"
    mitre_technique_name = "Unsecured Credentials"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher, with secret resource requests (get/list/watch) ingested and normalised to USER_RESOURCE_ACCESS."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "GitOps and deployment controllers, secret-sync operators (external secrets, CSI drivers), backup tooling, cluster upgrade or migration jobs, and administrators auditing secrets during troubleshooting."
    tuning_guidance = "Add controller and operator identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #k8s threshold for clusters with many operators. Lower it for high-security clusters."

  events:
    $k8s.metadata.event_type = "USER_RESOURCE_ACCESS"
    $k8s.metadata.product_event_type = /^(get|list)$/ nocase
    (
      $k8s.target.resource.resource_subtype = /^secrets?$/ nocase or
      $k8s.target.url = /\/secrets(\/|\?|$)/ nocase
    )
    $k8s.principal.user.userid = $user
    not $k8s.principal.user.userid = /^system:(kube-|node:|apiserver)/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(if(count_distinct($k8s.target.resource.name) >= 40, 85, 60))
    $event_count = count($k8s.metadata.id)
    $distinct_secrets = count_distinct($k8s.target.resource.name)
    $source_ips = array_distinct($k8s.principal.ip)
    $mitre_technique_id = array_distinct("T1552")
    $primary_entity = array_distinct($user)

  condition:
    #k8s >= 15
}
