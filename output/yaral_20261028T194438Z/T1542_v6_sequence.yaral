/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:41:41.625104+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_NetDevice_Mgmt_Access_Then_External_TFTP_Pull {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network device receiving an SSH or Telnet management session from a source outside the approved management sources, followed within 10 minutes by the same device initiating a TFTP (UDP/69) connection to an external address. This sequence matches the network-observable pattern of boot image, ROMMON or firmware replacement on a network device (Pre-OS Boot / TFTP Boot), where an attacker logs in and has the device pull a modified image from an outside server."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Firewall or perimeter logs that record both inbound management-plane sessions to the device and outbound connections initiated by the device, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must be positioned so it sees the device's management and egress traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised engineers upgrading device firmware from a vendor or staging TFTP server on an external address; managed-service or carrier staff working from addresses not yet in the approved management source list; automated config or image backup jobs that use external TFTP; lab or staging devices."
    tuning_guidance = "Add approved admin jump hosts, VPN egress and NOC addresses to %global_allowed_mgmt_sources. This list also excludes approved image or TFTP servers as destinations. Internal address space is excluded through %rfc1918_internal, so internal TFTP servers do not alert. Schedule firmware maintenance windows to suppress alerts per client. Consider raising severity to Critical for core or edge devices."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    $mgmt.target.ip = $device_ip

    $tftp.metadata.event_type = "NETWORK_CONNECTION"
    $tftp.target.port = 69
    not $tftp.target.ip in %rfc1918_internal
    not $tftp.target.ip in %global_allowed_mgmt_sources
    $tftp.principal.ip = $device_ip

    $mgmt.metadata.event_timestamp.seconds <= $tftp.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($device_ip)
    $mgmt_sources = array_distinct($mgmt.principal.ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $tftp_servers = array_distinct($tftp.target.ip)
    $mgmt_event_count = count($mgmt.metadata.id)
    $tftp_event_count = count($tftp.metadata.id)

  condition:
    $mgmt and $tftp
}
