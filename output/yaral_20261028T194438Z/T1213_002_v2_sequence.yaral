/*
  MITRE Technique : T1213.002 - Sharepoint
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:24:59.644370+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_002_Permission_Grant_Then_SharePoint_Mass_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user account receives a permission change from a different actor and then performs bulk SharePoint resource access within 10 minutes. This pattern suggests an adversary or insider elevating an account and mining SharePoint content for network diagrams, credentials, and documentation. It uses identity and audit telemetry only, so it does not duplicate process or command-line detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.002"
    mitre_technique_name = "Data from Information Repositories: Sharepoint"
    log_prerequisites = "Requires identity provider directory audit logs (permission and role changes) and SharePoint or collaboration audit logs normalised to USER_RESOURCE_ACCESS with target.application populated, both carrying a consistent user identifier."
    platform = "Windows"
    log_source = "identity"
    false_positives = "New-hire or role-change onboarding where access is granted and the user immediately syncs or browses many SharePoint items; project kickoffs; migration or eDiscovery staff; helpdesk-assisted access restoration; OneDrive or SharePoint sync clients generating many access events."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or migration identities to %global_allowed_service_accounts. Raise or lower the #access threshold per client based on normal SharePoint audit volume. Add approved scanning sources to %global_allowed_scanners if they appear as the principal."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.user.userid != ""
    $perm.principal.user.userid != $perm.target.user.userid
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    $perm.target.user.userid = $user

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.application = /sharepoint/ nocase
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    $access.principal.user.userid = $user

    $perm.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1213.002")
    $primary_entity = array_distinct($user)
    $access_count = count($access.metadata.id)
    $accessed_resources = array_distinct($access.target.resource.name)
    $source_ips = array_distinct($access.principal.ip)
    $permission_granted_by = array_distinct($perm.principal.user.userid)

  condition:
    $perm and #access >= 10
}
