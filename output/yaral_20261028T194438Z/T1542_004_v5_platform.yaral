/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:49:10.974588+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_ROMMON_External_TFTP_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) flows crossing the network perimeter to an external destination. Unauthenticated TFTP is the standard transport for loading a ROM Monitor (ROMMON) or boot image onto a network device. A flow to a non-internal address is a strong indicator of an unauthorized firmware pull, or of a device being staged for a malicious ROMMON upgrade. TFTP to the internet has almost no legitimate business use."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Firewall, proxy, or perimeter flow/connection logs normalized to UDM with target.ip, target.port, and network.ip_protocol populated. Perimeter devices must log permitted and denied UDP traffic, including TFTP."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate vendor firmware or configuration downloads by network engineers using TFTP to an external or cloud-hosted repository, managed-service-provider staging servers, remote-site zero-touch provisioning that uses TFTP across a WAN or NAT'd address space, and misrouted internal traffic when internal ranges are not fully covered by the internal address list."
    tuning_guidance = "Add approved management or staging source addresses to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers all private ranges used by the client, including WAN and provisioning networks. Where TFTP is normally blocked at the perimeter, treat any hit as high priority and verify the device boot-variable and ROMMON version via the management plane."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.ip_protocol = "UDP"
    $net.target.port = 69
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $flow_count = count($net.metadata.id)

  condition:
    $net
}
