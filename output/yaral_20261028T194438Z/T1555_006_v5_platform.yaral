/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:01:38.811838+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_Cloud_Secret_Retrieval_Scripted_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a secret value being retrieved from a cloud secrets manager through the control plane API by a programmatic client (CLI, SDK, scripting runtime or HTTP library) from a non-approved identity or source address. Adversaries with stolen cloud credentials use these retrieval calls to harvest passwords, API keys and tokens. This rule covers the cloud audit log angle only and does not depend on endpoint process or command-line telemetry."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Requires cloud audit logging with secrets manager data events or data access logs enabled and ingested into UDM as USER_RESOURCE_ACCESS. Secret retrieval is often not logged by default in some providers; confirm it is enabled per client. network.http.user_agent and principal.user.userid must be populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines and deployment automation that fetch secrets at build or deploy time, infrastructure-as-code runs, application bootstrap scripts using SDKs, secret rotation tooling, backup and DR tooling, administrators and engineers legitimately retrieving secrets with a CLI during troubleshooting, and security posture or scanning tools."
    tuning_guidance = "Add automation and workload identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Add named administrators to %global_allowed_admin_users. Add trusted egress addresses such as corporate VPN, bastion or CI runner NAT to %global_allowed_mgmt_sources. Consider raising severity or adding a sibling threshold rule for bulk retrieval across many secrets."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(GetSecretValue|BatchGetSecretValue|AccessSecretVersion|SecretGet)$/ nocase
    $cloud.network.http.user_agent = /(cli|boto|sdk|python|curl|wget|powershell|go-http|terraform|java|ruby|node)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $secret_names = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $user_agents = array_distinct($cloud.network.http.user_agent)

  condition:
    $cloud
}
