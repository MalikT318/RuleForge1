/*
  MITRE Technique : T1218 - System Binary Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:39:56.310017+00:00
  Reference       : https://attack.mitre.org/techniques/T1218
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_SignedBinaryProxy_Drops_Executable_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Microsoft-signed proxy-execution binary (mshta, regsvr32, rundll32, cmstp, installutil, regasm, regsvcs, odbcconf, msxsl, ieexec) writing an executable or script file into a user-writable staging location. This is the file artifact left by T1218 proxy execution and does not depend on command-line logging, so it still fires when command lines are obfuscated or not captured."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218"
    mitre_technique_name = "System Binary Proxy Execution"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters that run through rundll32, regsvr32 or installutil and stage DLLs or executables in ProgramData or Temp. Legitimate .NET deployment tooling using installutil, regasm or regsvcs. Admin scripts that register components from a temp folder."
    tuning_guidance = "Add approved deployment and RMM tooling paths to %global_allowed_admin_tools and deployment or service identities to %global_allowed_service_accounts. Security agents that write to these paths belong in %global_allowed_security_tools. If a specific installer is noisy, restrict by its parent process rather than widening the file extension list."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(mshta|regsvr32|rundll32|cmstp|installutil|regasm|regsvcs|odbcconf|msxsl|ieexec)\.exe$/ nocase
    $file.target.file.full_path = /\.(exe|dll|scr|sct|hta|js|jse|vbs|vbe|wsf|ps1|bat|cmd|cpl|ocx|msi)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|users\\public|programdata|windows\\temp)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218")
    $primary_entity = array_distinct($file.principal.hostname)
    $proxy_binary = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
