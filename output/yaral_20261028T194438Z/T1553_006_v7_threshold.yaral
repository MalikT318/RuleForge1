/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:10:22.288905+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_Code_Signing_Policy_Registry_Tampering_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several modifications to Windows code-integrity and signature-enforcement registry settings (Code Integrity config/policy, Device Guard / HVCI, Driver Signing policy, Software Restriction code identifiers) on a single host within ten minutes. A single change can be benign, but a burst of changes indicates an attempt to weaken signing enforcement so that unsigned drivers or code can run."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (Sysmon Event ID 13, or equivalent EDR registry events) normalised to UDM REGISTRY_MODIFICATION with principal.hostname and target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing and feature updates, security hardening or baseline deployment (GPO, Intune, DSC) enabling HVCI or Device Guard, driver developers and kernel test labs, EDR or AV agents updating their own integrity settings, and OS imaging or build pipelines."
    tuning_guidance = "Add approved deployment, hardening and patching tooling to %global_allowed_admin_tools, endpoint security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #reg threshold on driver-development or build hosts. Lower it to 2 for high-value servers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Control\\CI\\(Config|Policy)|Control\\DeviceGuard|Policies\\Microsoft\\Windows NT\\Driver Signing|Policies\\Microsoft\\Windows\\Safer\\CodeIdentifiers)(\\|$)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TiWorker|TrustedInstaller)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_value_name = /^(BehaviorOnFailedVerify|Enabled|VulnerableDriverBlocklistEnable|DefaultLevel)$/ nocase, 85, 65))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $acting_users = array_distinct($reg.principal.user.userid)
    $acting_processes = array_distinct($reg.principal.process.file.full_path)

  condition:
    #reg >= 3
}
