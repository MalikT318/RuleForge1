/*
  MITRE Technique : T1499 - Endpoint Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:14:28.884690+00:00
  Reference       : https://attack.mitre.org/techniques/T1499
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_Container_Resource_Guardrail_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects deletion of a container orchestration resource guardrail object (resource quota or limit range) through the control plane API. These objects cap CPU, memory and object counts per namespace. Removing them is a configuration state change that lets a workload exhaust node or cluster resources and deny service to co-located applications. This rule works at the control-plane configuration layer, not process command lines."
    mitre_tactic = "Impact"
    mitre_technique = "T1499"
    mitre_technique_name = "Endpoint Denial of Service"
    log_prerequisites = "Requires container orchestration control plane audit logs ingested and normalised to UDM RESOURCE_DELETION events, with the API request path populated in target.url or the object type in target.resource.resource_subtype. Delete verbs must be audited at Metadata level or higher."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Platform teams re-baselining namespace quotas, GitOps or infrastructure-as-code controllers replacing quota objects, namespace teardown by automation, and cluster migration or decommissioning work."
    tuning_guidance = "Add GitOps and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named platform administrators to %global_allowed_admin_users. Built-in control plane controllers are already excluded by regex. If your audit parser leaves target.url empty, confirm that target.resource.resource_subtype carries the object type."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    (
      $cloud.target.url = /\/(resourcequotas|limitranges)(\/|\?|$)/ nocase or
      $cloud.target.resource.resource_subtype = /^(resourcequotas?|limitranges?)$/ nocase
    )
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid = /^system:(serviceaccount:kube-system:|node:|kube-controller-manager|apiserver)/ nocase
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1499")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $deleted_objects = array_distinct($cloud.target.url)

  condition:
    $cloud
}
