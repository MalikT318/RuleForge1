/*
  MITRE Technique : T1546.012 - Image File Execution Options Injection
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:16:32.027555+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_012_IFEO_GlobalFlag_Then_SilentProcessExit_Monitor {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the registry-based Silent Process Exit variant of IFEO persistence. A GlobalFlag value is written under an Image File Execution Options key, and a MonitorProcess value is then written under the SilentProcessExit key on the same host within 10 minutes. Together these arm an arbitrary monitor program to launch when a chosen process exits. The rule needs no process command-line telemetry. It matches a fundamental registry mechanism, so it still fires if the tooling (GFlags, reg.exe, PowerShell, custom code) changes."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.012"
    mitre_technique_name = "Event Triggered Execution: Image File Execution Options Injection"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) populating target.registry.registry_key and ideally target.registry.registry_value_name for REGISTRY_MODIFICATION or REGISTRY_CREATION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application developers and QA staff using GFlags or Application Verifier, crash-dump and diagnostic tooling (WER, ProcDump-based silent exit dump collection), and software deployment or hardening scripts that configure silent process exit monitoring."
    tuning_guidance = "Add approved diagnostic, developer and deployment tooling to %global_allowed_admin_tools, and EDR or AV agents to %global_allowed_security_tools. If the telemetry places the value name inside registry_key, the rule already handles it through the key-suffix alternative. The rule is ordered, with the IFEO GlobalFlag write first. If your environment commonly sees the reverse order, duplicate the rule and swap the timestamp comparison."

  events:
    $reg_ifeo.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg_ifeo.target.registry.registry_key = /\\Image File Execution Options\\[^\\]+/ nocase
    (
      $reg_ifeo.target.registry.registry_value_name = /^GlobalFlag$/ nocase or
      $reg_ifeo.target.registry.registry_key = /\\GlobalFlag$/ nocase
    )
    not $reg_ifeo.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg_ifeo.principal.process.file.full_path in %global_allowed_security_tools
    $reg_ifeo.principal.hostname = $hostname

    $reg_spe.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg_spe.target.registry.registry_key = /\\Windows NT\\CurrentVersion\\SilentProcessExit\\[^\\]+/ nocase
    (
      $reg_spe.target.registry.registry_value_name = /^MonitorProcess$/ nocase or
      $reg_spe.target.registry.registry_key = /\\MonitorProcess$/ nocase
    )
    not $reg_spe.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg_spe.principal.process.file.full_path in %global_allowed_security_tools
    $reg_spe.principal.hostname = $hostname

    $reg_ifeo.metadata.event_timestamp.seconds <= $reg_spe.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.012")
    $primary_entity = array_distinct($hostname)
    $ifeo_keys = array_distinct($reg_ifeo.target.registry.registry_key)
    $silent_exit_keys = array_distinct($reg_spe.target.registry.registry_key)
    $monitor_values = array_distinct($reg_spe.target.registry.registry_value_data)
    $writer_processes = array_distinct($reg_spe.principal.process.file.full_path)
    $users = array_distinct($reg_spe.principal.user.userid)

  condition:
    $reg_ifeo and $reg_spe
}
