/*
  MITRE Technique : T1505 - Server Software Component
  Tactic(s)       : Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:25:22.613433+00:00
  Reference       : https://attack.mitre.org/techniques/T1505
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_Firewall_WebShell_Script_POST_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source sends a high volume of HTTP POST requests to server-side script endpoints (ASP.NET/classic ASP handlers) within 10 minutes. Individual POSTs to these endpoints are normal. Sustained volume from one source is consistent with an operator interacting with a planted web shell or malicious server component on a Windows web server (T1505.003), or with brute-forcing and probing of one. Detection is based on perimeter-observable HTTP traffic only."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505"
    mitre_technique_name = "Server Software Component"
    log_prerequisites = "Requires firewall, reverse proxy or WAF logs normalised to UDM NETWORK_HTTP with network.http.method, target.url and principal.ip populated, and with web-server traffic logged inbound."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Busy line-of-business web applications (ASP.NET form posts, AJAX/API calls, SOAP/ASMX services), partner integrations or webhooks from fixed external IPs, uptime and synthetic monitors, authorised vulnerability scanners and penetration tests, and CDN or proxy egress addresses that aggregate many users behind one IP."
    tuning_guidance = "Add authorised scanner and pentest sources to %global_allowed_scanners. Raise the #http threshold for high-traffic applications, or lower it for low-traffic admin or internal-facing servers. Exclude known partner or CDN source IPs by adding them to %global_allowed_scanners. Review the targeted URLs in the outcome: a few distinct, rarely-seen script paths receiving most of the POSTs is the strongest signal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\.(aspx|ashx|asmx|asp|cshtml)(\?|\/|$)/ nocase
    $http.principal.ip = $src
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1505")
    $primary_entity = array_distinct($src)
    $post_count = count($http.metadata.id)
    $targeted_hosts = array_distinct($http.target.hostname)
    $targeted_urls = array_distinct($http.target.url)

  condition:
    #http >= 25
}
