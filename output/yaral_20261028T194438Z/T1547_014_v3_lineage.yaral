/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:42:09.849370+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_Active_Setup_Anomalous_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, print spooler, database service or document reader spawning a shell, script interpreter or registry tool that references the Active Setup Installed Components key or StubPath value. These parents never legitimately create Active Setup persistence, so the lineage is the strong signal."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing) that populates both the parent and child process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Installers or software-packaging tools launched from a document viewer or a Java/web-hosted deployment console, application-hosting web servers running legitimate setup scripts, and IT automation that stages Active Setup components through an unusual parent."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved admin accounts to %global_allowed_admin_users. Add packaging or deployment tooling that legitimately writes Active Setup entries to %global_allowed_admin_tools. Extend the parent regex for client-specific line-of-business services."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|acrord32|acrobat|foxitreader|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|reg|regedit|rundll32|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(active\s+setup\\installed\s+components|stubpath)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
