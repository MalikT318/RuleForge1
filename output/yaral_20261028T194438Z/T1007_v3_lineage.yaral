/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:14:34.398341+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1007_Service_Discovery_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Windows service or scheduled-task discovery commands (sc query, tasklist /svc, net start, schtasks /query, Get-Service, WMI Win32_Service) launched by a parent process that should never perform host enumeration, such as an Office application, web server worker, print spooler, database service or application server. Matching on lineage plus discovery arguments catches web shell and macro-driven reconnaissance regardless of the tool name or payload used."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros used by IT for inventory, IIS-hosted or Tomcat-hosted admin and monitoring applications that query service state, SQL Server maintenance jobs using xp_cmdshell for health checks, print management software that restarts or inspects the spooler, and application health-check scripts."
    tuning_guidance = "Add approved management parent binaries to %global_allowed_admin_tools, approved script-hosting parents to %global_allowed_script_hosts, and monitoring service accounts to %global_allowed_service_accounts. Extend or narrow the parent process regex to match the client's web, database and application server estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|sqlservr|spoolsv|inetinfo)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|sc|net|net1|tasklist|schtasks|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(\bsc(\.exe)?\s+(query|queryex|qc)\b|\btasklist(\.exe)?\b.*\/svc|\bnet1?(\.exe)?\s+start\s*$|\bschtasks(\.exe)?\b.*\/query|\bget-service\b|\bget-scheduledtask\b|\bget-ciminstance\b.*win32_service|\bget-wmiobject\b.*win32_service|\bwmic(\.exe)?\b.*\bservice\b|\bgwmi\b.*win32_service)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
