/*
  MITRE Technique : T1546.017 - Udev Rules
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:24:09.771537+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_017_Udev_Rule_Drop_Then_Reload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A udev rule file is created in a udev rules directory by a process that is not a package manager or approved admin tool, and udevadm is then run on the same host to reload or trigger the rules within 10 minutes. This sequence activates a udev persistence rule (RUN+= action) and is driven by the file write, not by a command-line pattern alone."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.017"
    mitre_technique_name = "Event Triggered Execution: Udev Rules"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry (watch on /etc/udev/rules.d and the other udev rules directories) normalised to FILE_CREATION, plus process launch telemetry (EDR or auditd execve) normalised to PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs and upgrades that ship udev rules (dpkg, rpm, dnf, apt), configuration management agents (Ansible, Puppet, Chef, Salt) deploying device rules, cloud-init or provisioning scripts, hardware or driver installers (GPU, storage, USB), and admins hand-writing rules for custom devices."
    tuning_guidance = "Add approved config-management and provisioning binaries to %global_allowed_admin_tools (matched against the writing process path). Extend the package-manager regex if the fleet uses other installers. The rule only fires if udevadm is run; udevd also reloads rules automatically via inotify, so pair this with a file-only rule on rules.d writes where coverage is needed. Review hosts that legitimately handle frequent hardware changes (VDI, kiosks, lab systems)."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc|run|usr\/lib|usr\/local\/lib|lib)\/udev\/rules\.d\/[^\/]+\.rules$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|pacman|snapd|unattended-upgrade|packagekitd|cloud-init)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $reload.metadata.event_type = "PROCESS_LAUNCH"
    $reload.target.process.file.full_path = /\/udevadm$/ nocase
    $reload.target.process.command_line = /\b(control\s+.*(-R\b|--reload)|trigger|test)\b/ nocase
    not $reload.principal.process.file.full_path in %global_allowed_admin_tools
    $reload.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reload.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.017")
    $primary_entity = array_distinct($file.principal.hostname)
    $rule_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $writer_users = array_distinct($file.principal.user.userid)
    $reload_commands = array_distinct($reload.target.process.command_line)
    $file_event_count = count($file.metadata.id)

  condition:
    $file and $reload
}
