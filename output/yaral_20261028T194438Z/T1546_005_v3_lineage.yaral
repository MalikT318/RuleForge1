/*
  MITRE Technique : T1546.005 - Trap
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:07:40.864104+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_005_Linux_Service_Parent_Spawns_Shell_With_Trap {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell interpreter spawned by a web server, application server, database, or print service process whose command line registers a trap handler for a signal or pseudo-signal such as EXIT, INT, TERM, HUP or DEBUG. Network-facing service daemons do not normally launch shells that install trap handlers, so this lineage anomaly points to a web shell or exploited service planting signal-triggered persistence or cleanup code (T1546.005)."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.005"
    mitre_technique_name = "Event Triggered Execution: Trap"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path (principal.process.file.full_path), child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate CGI or application wrapper scripts that use trap for temp-file cleanup, database maintenance or backup hooks launched by the database service (for example a postgres archive_command script), print filter scripts run by the print service, and deployment hooks run by application servers."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. Add hosts that legitimately run service-launched wrapper scripts to %global_allowed_script_hosts. Extend the parent regex with additional service daemons used in the client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|uwsgi|gunicorn|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|cups-browsed)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|dash|sh|zsh|ksh|csh|tcsh|ash)$/ nocase
    $proc.target.process.command_line = /\btrap\s+.+\s+(SIG)?(EXIT|INT|TERM|HUP|QUIT|DEBUG|ERR|USR1|USR2|0|1|2|3|15)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1546.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
