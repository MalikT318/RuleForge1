/*
  MITRE Technique : T1124 - System Time Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:31:29.198464+00:00
  Reference       : https://attack.mitre.org/techniques/T1124
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1124_Linux_External_NTP_Then_CLI_HTTP_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single internal source that queries an external NTP service (UDP/123) and then, within 10 minutes, makes an outbound HTTP request using a command-line or scripting HTTP client user agent. Hosts that probe external time sources and then immediately egress with scripted clients are consistent with system time discovery (clock/timezone checks, sandbox or uptime evasion) ahead of staging or C2. Detection uses only network-observable behaviour (destination port, protocol, user agent, and internal/external direction) and does not depend on endpoint process telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1124"
    mitre_technique_name = "System Time Discovery"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM with NETWORK_CONNECTION events (target.port, network.ip_protocol) and NETWORK_HTTP events (network.http.user_agent, target.ip). The source address (principal.ip) must be populated consistently in both event types."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Linux servers or containers that sync time directly with public NTP pools and then run package managers, curl-based health checks or cron scripts. Configuration-management and monitoring agents that use curl or wget. Developer and build hosts. Network appliances acting as NTP relays."
    tuning_guidance = "Add approved NTP relay and infrastructure source addresses to %global_allowed_mgmt_sources. Add known-good time providers and update or package mirrors to %global_allowed_domains. Hosts that legitimately sync with public NTP pools should be moved to an internal time source, or their source addresses added to the allowlist. Extend or narrow the user agent regex to match the client mix in each environment."

  events:
    $ntp.metadata.event_type = "NETWORK_CONNECTION"
    $ntp.target.port = 123
    $ntp.network.ip_protocol = "UDP"
    not $ntp.target.ip in %rfc1918_internal
    not $ntp.principal.ip in %global_allowed_mgmt_sources
    not $ntp.target.hostname in %global_allowed_domains
    $ntp.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $ntp.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1124")
    $primary_entity = array_distinct($src_ip)
    $ntp_server_ips = array_distinct($ntp.target.ip)
    $http_destination_ips = array_distinct($http.target.ip)
    $http_user_agents = array_distinct($http.network.http.user_agent)
    $http_request_count = count($http.metadata.id)

  condition:
    $ntp and $http
}
