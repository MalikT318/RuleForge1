/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:19:05.117226+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_PowerShell_Broad_Principal_ACL_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects PowerShell modifying a file or directory DACL by building a FileSystemAccessRule that grants Everyone, Authenticated Users, or the local Users group Full Control, Modify, or Write rights, then applying it with Set-Acl or SetAccessControl. This is the cmdlet and .NET route to the same result as icacls/takeown abuse, and it is often used to open protected files or directories to any account. The platform is Windows, as required by the target platform for this rule."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 or Windows Event 4688 with command-line auditing enabled, so that target.process.command_line is populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and deployment scripts that relax folder permissions for shared application data, IT automation and DSC or configuration-management runs, admins preparing shared folders, and build agents."
    tuning_guidance = "Add approved deployment and automation parents to %global_allowed_admin_tools, trusted script-host parents to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Consider raising severity when the command line also references system directories or when the parent is an Office application or a script interpreter."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(set-acl|setaccesscontrol|setaccessrule|addaccessrule)/ nocase
    $proc.target.process.command_line = /filesystemaccessrule/ nocase
    $proc.target.process.command_line = /(everyone|authenticated\s+users|builtin\\users|s-1-1-0|s-1-5-11|s-1-5-32-545)/ nocase
    $proc.target.process.command_line = /(fullcontrol|modify|write)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
