/*
  MITRE Technique : T1110.001 - Password Guessing
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:04:17.457199+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_001_OfficeSuite_Failed_Logins_Then_Success {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects repeated failed sign-ins for one cloud office account from a single source address, followed within ten minutes by a successful sign-in to the same account from the same address. This pattern indicates password guessing that has probably succeeded."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.001"
    mitre_technique_name = "Brute Force: Password Guessing"
    log_prerequisites = "Requires identity provider sign-in audit logs for the office suite (M365 / Workspace) normalised to USER_LOGIN. security_result.action must be populated with BLOCK for failed sign-ins and ALLOW for successful ones. principal.ip and target.user.userid must be populated."
    platform = "Office Suite"
    log_source = "identity"
    false_positives = "Users who mistype a password repeatedly, or who have a stale saved password on a mobile mail client or desktop sync client that retries before the correct credentials are entered. Shared egress NAT addresses where many users fail from one IP. Password-reset or onboarding flows with several failures. Unlisted automation or legacy-protocol service accounts."
    tuning_guidance = "Add automation and legacy-protocol accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. Raise the failure count in the condition (#fail >= 10) for tenants with noisy sign-in telemetry. Lower it for high-value accounts. If attackers rotate source IPs, create a variant that joins on user only."

  events:
    $fail.metadata.event_type = "USER_LOGIN"
    $fail.security_result.action = "BLOCK"
    $fail.target.user.userid = $user
    $fail.principal.ip = $src_ip
    not $fail.target.user.userid in %global_allowed_service_accounts
    not $fail.target.user.userid in %global_allowed_admin_users

    $success.metadata.event_type = "USER_LOGIN"
    $success.security_result.action = "ALLOW"
    $success.target.user.userid = $user
    $success.principal.ip = $src_ip
    not $success.target.user.userid in %global_allowed_service_accounts
    not $success.target.user.userid in %global_allowed_admin_users

    $fail.metadata.event_timestamp.seconds <= $success.metadata.event_timestamp.seconds

  match:
    $user, $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1110.001")
    $primary_entity = array_distinct($user)
    $failed_attempts = count($fail.metadata.id)
    $source_ips = array_distinct($src_ip)
    $first_failure = min($fail.metadata.event_timestamp.seconds)
    $success_time = max($success.metadata.event_timestamp.seconds)

  condition:
    #fail >= 10 and $success
}
