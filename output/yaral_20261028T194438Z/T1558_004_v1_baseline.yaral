/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:45:17.239007+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_ASREP_Preauth_Disabled_Account_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process launched with command-line logic that enumerates or sets accounts with Kerberos preauthentication disabled (DONT_REQ_PREAUTH, userAccountControl bit 4194304). Adversaries run this account discovery before requesting AS-REP material for offline cracking. Setting the flag on an account for persistence or roasting is also covered."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Identity and AD hygiene audits (for example, scripts that report accounts with DoesNotRequirePreAuth), approved penetration tests and red-team exercises, AD health-check or posture-management tooling, and administrators legitimately configuring legacy application service accounts."
    tuning_guidance = "Add approved audit and AD management tooling to %global_allowed_admin_tools, approved assessment sources to %global_allowed_scanners, and named administrator accounts that perform routine AD reviews to %global_allowed_admin_users. Correlate hits with Event ID 4768 (PreAuthType 0) on domain controllers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(DoesNotRequirePreAuth|DONT_REQ_PREAUTH|1\.2\.840\.113556\.1\.4\.803\s*:?\s*=\s*4194304|userAccountControl.{0,60}4194304)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $process_path = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
