/*
  MITRE Technique : T1559 - Inter-Process Communication
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:49:43.083307+00:00
  Reference       : https://attack.mitre.org/techniques/T1559
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_Linux_IPC_Socket_Or_FIFO_In_Writable_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a shell, scripting interpreter or socket/pipe utility creating a Unix domain socket or named pipe (FIFO) style file in a world-writable directory (/tmp, /var/tmp, /dev/shm). Adversaries use these IPC artifacts to relay commands between local processes, stage reverse-shell plumbing, or link a persistent implant to short-lived executors. The rule detects the resulting file artifact, not the command line."
    mitre_tactic = "Execution"
    mitre_technique = "T1559"
    mitre_technique_name = "Inter-Process Communication"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records (e.g. watches on /tmp, /var/tmp and /dev/shm) normalised to UDM FILE_CREATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer tooling and test frameworks that create sockets or FIFOs in /tmp, language runtimes and IDE language servers, CI/CD build agents, container tooling, database or message-broker clients, and admin scripts that use mkfifo for legitimate pipelines."
    tuning_guidance = "Add approved automation and deployment binaries to %global_allowed_admin_tools, approved interpreter hosts or parents to %global_allowed_script_hosts, and build or automation accounts to %global_allowed_service_accounts. If build servers are noisy, scope them out with a host-based exclusion in the client's own overlay."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(sock|socket|pipe|fifo|ipc)$/ nocase
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|php|socat|ncat|nc|mkfifo)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1559")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
