/*
  MITRE Technique : T1025 - Data from Removable Media
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:48:00.665961+00:00
  Reference       : https://attack.mitre.org/techniques/T1025
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1025_Linux_Removable_Media_Path_Network_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux transfer or network utility opening an outbound connection to an external address while its command line references a removable media mount point (/media, /run/media, or a removable-style /mnt subdirectory). This is the network-side signature of data collected from USB or optical media being staged or sent off-host."
    mitre_tactic = "Collection"
    mitre_technique = "T1025"
    mitre_technique_name = "Data from Removable Media"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry that populates the connecting process path and command line on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users or admins deliberately uploading files from a USB drive with scp/rsync/curl, approved backup or media-ingest jobs, software installers fetched from mounted ISO media, and NFS or SMB shares mounted under /mnt that look like removable media."
    tuning_guidance = "Add approved backup and imaging binaries to %global_allowed_backup_processes, approved transfer tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If /mnt is heavily used for network shares, remove the /mnt branch of the command-line regex for that tenant. Add known-good destination domains or sources to the existing exclusions as needed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|scp|sftp|rsync|ftp|lftp|nc|ncat|netcat|socat|openssl)$/ nocase
    $net.principal.process.command_line = /(^|\s|=|:|@)\/(media|run\/media)\/[^\s]+|(^|\s|=|:|@)\/mnt\/(usb|cdrom|dvd|flash|removable|external|sd[a-z]|disk)[^\s]*/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1025")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)
    $acting_process = array_distinct($net.principal.process.file.full_path)
    $command_lines = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
