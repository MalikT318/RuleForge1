/*
  MITRE Technique : T1135 - Network Share Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:04:53.542935+00:00
  Reference       : https://attack.mitre.org/techniques/T1135
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1135_Perimeter_SMB_Share_Discovery_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal Windows host opening SMB (445) or NetBIOS session (139) connections to a non-internal destination as seen by perimeter firewall logs. Windows hosts normally reach SMB shares on internal servers, so SMB crossing the perimeter indicates share discovery or enumeration against remote systems, or SMB-based credential harvesting. This is network-layer coverage for T1135 that complements process and command-line detections. It sees only traffic that crosses the monitored firewall; east-west enumeration needs internal segmentation firewall or NDR flow logs."
    mitre_tactic = "Discovery"
    mitre_technique = "T1135"
    mitre_technique_name = "Network Share Discovery"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port populated. Logs must record permitted and denied connections to be effective."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud file services reached over SMB (e.g. Azure Files, hosted file shares), site-to-site or VPN-routed SMB traffic that egresses via the perimeter, authorised vulnerability scanners and penetration tests, misconfigured clients or WebDAV/SMB fallback."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners. Add known-good SMB destination hostnames (cloud storage endpoints) to %global_allowed_domains. If remote offices route SMB through the perimeter, add the VPN or branch address space to %rfc1918_internal or the mgmt source list %global_allowed_mgmt_sources. Consider raising severity for sources with many distinct blocked SMB attempts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal_exempt_placeholder_removed
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1135")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
