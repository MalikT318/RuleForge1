/*
  MITRE Technique : T1069.003 - Cloud Groups
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:00:21.088568+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_003_M365_Admin_Audit_Group_Role_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects directory and admin audit records showing a user enumerating cloud permission groups, role groups, role assignments or group membership (Get-RoleGroup, Get-RoleGroupMember, Get-ManagementRoleAssignment, Get-MsolRole, Get-DistributionGroupMember, Get-UnifiedGroupLinks and similar). Office Suite has no process, file or registry telemetry, so this detects at the audit-record layer (the logged API/cmdlet resource access) instead of command-line capture, and still fires if the attacker uses a renamed client, SDK or API wrapper."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.003"
    mitre_technique_name = "Permission Groups Discovery: Cloud Groups"
    log_prerequisites = "Microsoft 365 unified audit log ingestion with Exchange admin audit logging and the Entra ID (directory) workload enabled. Read-only Get-* cmdlet auditing is not on by default in every tenant and must be enabled for this rule to see enumeration. Events must be normalised to USER_RESOURCE_ACCESS with the operation name in metadata.product_event_type."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Tenant administrators reviewing role groups, IAM and governance tooling that syncs group membership, access review and audit scripts, help-desk staff checking distribution list membership, and onboarding automation."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation and sync accounts to %global_allowed_service_accounts, and approved integration principals to %global_allowed_cloud_principals. If volume is high, restrict to the privileged-role operations (RoleGroup, ManagementRole, MsolRole) or convert to a Threshold rule per user."

  events:
    $audit.metadata.event_type = "USER_RESOURCE_ACCESS"
    $audit.metadata.product_event_type = /^(Get-(RoleGroup|RoleGroupMember|ManagementRole|ManagementRoleAssignment|ManagementRoleEntry|DistributionGroupMember|UnifiedGroupLinks|MsolRole|MsolRoleMember|MsolGroupMember|AdminAuditLogConfig)|List (role|group)[a-z ]*|Get (role|group)[a-z ]*members?)$/ nocase
    $audit.principal.user.userid != ""
    not $audit.principal.user.userid in %global_allowed_admin_users
    not $audit.principal.user.userid in %global_allowed_service_accounts
    not $audit.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1069.003")
    $primary_entity = array_distinct($audit.principal.user.userid)
    $operations = array_distinct($audit.metadata.product_event_type)
    $source_ips = array_distinct($audit.principal.ip)
    $target_resources = array_distinct($audit.target.resource.name)

  condition:
    $audit
}
