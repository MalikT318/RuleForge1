/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:54:54.868084+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_Indirect_Command_Execution_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated use of built-in utilities that execute commands indirectly (forfiles /c, pcalua -a, scriptrunner -appvscript, ssh ProxyCommand/LocalCommand, wsl --exec/bash -c) on a single host within 10 minutes. A single launch can be benign, but repeated proxy execution on one host suggests an attempt to bypass interpreter restrictions."
    mitre_tactic = "Stealth"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or logon scripts that use forfiles for batch file housekeeping, application compatibility tooling that launches pcalua, developers using WSL or ssh with ProxyCommand (jump hosts) for legitimate workflows, App-V deployment scripts using scriptrunner, and RMM or patching agents."
    tuning_guidance = "Add approved parent processes to %global_allowed_admin_tools or %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for developer-heavy hosts or hosts that run housekeeping scripts. Lower it to 2 for servers where these utilities are never expected."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(forfiles|pcalua|scriptrunner|ssh|wsl)\.exe$/ nocase
    $proc.target.process.command_line = /(forfiles(\.exe)?"?\s.*\/c\b|pcalua(\.exe)?"?\s.*\s-a\s*\S|scriptrunner(\.exe)?"?\s.*-appvscript|ssh(\.exe)?"?\s.*(proxycommand|localcommand)|wsl(\.exe)?"?\s.*(\s-e\s|--exec\b|\bbash\s+-c\b))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($host)
    $utilities_used = array_distinct($proc.target.process.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)
    $sample_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
