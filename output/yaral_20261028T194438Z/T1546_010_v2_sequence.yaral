/*
  MITRE Technique : T1546.010 - AppInit DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:13:10.024780+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_010_AppInit_DLL_Drop_Then_Registry_Set {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A DLL is written to a user-writable or staging location and the AppInit_DLLs registry value is then modified on the same host within 10 minutes. This pattern indicates a payload being staged and registered for loading into every process that loads user32.dll. The rule uses file and registry telemetry only, so it complements command-line detections."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.010"
    mitre_technique_name = "Event Triggered Execution: AppInit DLLs"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11) and registry-modification telemetry (Sysmon Event ID 13), normalised to UDM FILE_CREATION and REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy third-party software such as accessibility tools, screen readers, older VPN or DLP agents, and some graphics or overlay utilities that install an AppInit DLL. Software deployment or RMM agents that stage DLLs in ProgramData and then configure the registry. Authorised administrators testing AppInit functionality."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools, which is checked against both the DLL-writing process and the registry-writing process. Add security agents to %global_allowed_security_tools. If a legacy product legitimately uses AppInit_DLLs, exclude its installer process through %global_allowed_admin_tools. Widen or narrow the staging-path regex to suit the customer's software estate."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.dll$/ nocase
    $file.target.file.full_path = /\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\|\\\$recycle\.bin\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\software\\(wow6432node\\)?microsoft\\windows nt\\currentversion\\windows$/ nocase
    $reg.target.registry.registry_value_name = "AppInit_DLLs" nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.010")
    $primary_entity = array_distinct($hostname)
    $dropped_dll_paths = array_distinct($file.target.file.full_path)
    $dll_writer_processes = array_distinct($file.principal.process.file.full_path)
    $registry_keys_modified = array_distinct($reg.target.registry.registry_key)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
