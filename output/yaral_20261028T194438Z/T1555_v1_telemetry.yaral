/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:51:56.538248+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_Linux_Credential_Store_Staged_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a credential-store file (keyring, browser or mail profile credential database, password-manager vault, GnuPG key store, plaintext credential file) inside a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This is the file artifact left behind when an adversary copies a password store for later exfiltration or offline cracking, and it does not depend on command-line logging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch/syscall rules (open/creat/rename) that populate FILE_CREATION events with target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or imaging agents staging profile data in /tmp, admins or support staff migrating a browser profile or KeePass vault, configuration management copying .pgpass or .netrc templates, forensic or IR collection tooling, browsers that create temporary profile copies for automated testing."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, approved admin and migration tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and authorised security tooling to %global_allowed_security_tools. If a client uses additional staging directories, extend the directory regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = /\/(login\.keyring|[^\/]+\.keyring|key[34]\.db|logins\.json|login data|[^\/]+\.kdbx?|\.git-credentials|\.pgpass|\.netrc|pubring\.kbx|secrets\.json|private-keys-v1\.d\/[^\/]+)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
