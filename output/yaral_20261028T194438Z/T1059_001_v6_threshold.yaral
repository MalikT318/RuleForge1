/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:09:04.450032+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_Script_Staging_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a PowerShell host process writing several .ps1/.psm1 script files into user-writable or temporary locations on a single host within 10 minutes. One script write is routine, but a burst indicates script staging by a loader, offensive framework or dropper. This is file-creation volume rather than command-line matching, so it complements process-creation rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon Event ID 11 or equivalent) with the creating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and module managers (Install-Module, package managers), RMM and deployment agents, developer workstations, admin automation that generates scripts, and profile or module caching during first-run setup."
    tuning_guidance = "Add approved script-generating tools to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and build or automation hosts to %global_allowed_script_hosts. Raise the #file threshold on developer or build servers. The PowerShell policy-test temp files are already excluded in the rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $file.target.file.full_path = /\\(temp|tmp|appdata|programdata|users\\public)\\.*\.(ps1|psm1)$/ nocase
    not $file.target.file.full_path = /__PSScriptPolicyTest_/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $file_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($host)
    $dropped_scripts = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
