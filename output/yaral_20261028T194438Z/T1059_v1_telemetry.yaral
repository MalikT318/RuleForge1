/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Office Suite
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:06:11.426067+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_Office_App_Drops_Script_Or_Launch_Artifact_macOS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a macOS Office suite application (Word, Excel or PowerPoint) creating a script file, a launchd plist, or a file in an Office Application Scripts directory. This is the file artifact left when a malicious macro or document stages an interpreter payload through AppleScriptTask, shell scripts or launchd persistence. It works at the file-creation layer, so it still fires if command-line logging is evaded."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires macOS endpoint telemetry (EDR or unified log) that records file creation events with the creating process path. The Office Suite scope is the Office desktop applications running on macOS endpoints. Cloud audit logs (Microsoft 365 or Google Workspace) carry no file-creation process context and are not used by this rule."
    platform = "Office Suite"
    log_source = "macos_endpoint"
    false_positives = "Users who legitimately install AppleScriptTask helper scripts for approved macro-enabled workbooks. Enterprise Office add-ins that write helper scripts. Deployment or configuration tooling running under an Office process. Users saving a script-extension file from Word or Excel (for example, exporting code snippets as plain text)."
    tuning_guidance = "Add approved deployment or management tooling to %global_allowed_admin_tools. Add named administrators who legitimately author macro helper scripts to %global_allowed_admin_users. If an approved add-in writes script files, exclude its exact target directory with a further 'not' regex condition. Test first on a small set of hosts to baseline Office behaviour."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/Microsoft (Word|Excel|PowerPoint)\.app\// nocase
    $file.target.file.full_path = /(\/Library\/Application Scripts\/com\.microsoft\.[^\/]+\/[^\/]+$|\/Library\/Launch(Agents|Daemons)\/[^\/]+\.plist$|\.(scpt|scptd|applescript|sh|command|zsh|bash|py|pl|rb|jxa)$)/ nocase
    not $file.target.file.full_path = /\/(Caches|WebKit)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
