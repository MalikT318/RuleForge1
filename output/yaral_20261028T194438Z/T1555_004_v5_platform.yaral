/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:58:29.092752+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_Vault_Credential_Files_Copied_Outside_Vault {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of Windows Credential Manager vault artefacts (.vcrd credential files or the Policy.vpol key file) outside the native Vault/Credentials directories. This is file-based staging or exfiltration prep for offline decryption and does not depend on process command lines. The Windows platform is retained because the Windows-only requirement overrides the alternate-platform angle."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires endpoint file-creation telemetry with full target paths (EDR file events or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup, imaging and profile-migration tools copying user profiles; forensic or IR collection; user-state migration (USMT) and profile roaming software; EDR agents quarantining or scanning copies."
    tuning_guidance = "Add backup and imaging process paths to %global_allowed_backup_processes, migration and IT tooling to %global_allowed_admin_tools, and EDR agents to %global_allowed_security_tools. Review hosts with repeated hits for staging activity."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\.vcrd|\\policy\.vpol)$/ nocase
    not $file.target.file.full_path = /\\microsoft\\(vault|credentials)\\/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $created_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
