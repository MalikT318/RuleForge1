/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:52:55.952466+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_Linux_Interpreter_Connects_To_Secrets_Store_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a generic network or scripting utility (shell, curl, wget, python, perl, etc.) on a Linux host opening an outbound connection to an external hostname that looks like a cloud or enterprise secrets store (secrets manager, key vault, vault API). Complements process command-line rules by observing the network side of credential retrieval from password stores and cloud secrets vaults."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires Linux EDR or auditd-derived network telemetry that populates principal.process.file.full_path, target.hostname and target.ip on NETWORK_CONNECTION events. DNS-resolved or SNI-derived destination hostnames must be present in target.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "DevOps and CI/CD scripts that legitimately fetch secrets at deploy time, configuration management bootstrap scripts, backup and rotation jobs, and admins testing vault access from a shell."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and sanctioned vault or secrets endpoints to %global_allowed_domains. Add trusted script-running hosts to %global_allowed_script_hosts if noise persists."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|ruby|node|nc|ncat|socat|bash|sh|dash)$/ nocase
    $net.target.hostname = /(^|[.-])(secretsmanager|secretmanager|keyvault|vault)([.-]|$)/ nocase
    $net.target.port = 443
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
