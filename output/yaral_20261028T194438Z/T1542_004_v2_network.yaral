/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:48:29.459214+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_Perimeter_TFTP_External_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (port 69) traffic crossing the network perimeter to or from an external address. Adversaries replace ROMMON firmware on network devices by pulling a modified image over TFTP, usually followed by a reload. TFTP is unauthenticated and unencrypted and should never cross the perimeter in normal operation. The rule observes the transfer from the firewall side, independent of any device-level logging."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Firewall or perimeter NETWORK_CONNECTION logs that populate principal.ip, target.ip and target.port. TFTP must not be dropped before logging, and denied sessions should also be logged. Populate %rfc1918_internal and %global_allowed_mgmt_sources."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised firmware or config staging from a vendor or managed-service TFTP server, remote-site PXE or zero-touch provisioning over a WAN link, lab devices, legacy backup jobs that use TFTP."
    tuning_guidance = "Add approved management or provisioning source addresses to %global_allowed_mgmt_sources. Ensure %rfc1918_internal covers all internal and VPN-routed ranges so internal TFTP is excluded. Alerts for traffic from network device management interfaces should be triaged first. Correlate with a device reload or boot-variable change in management-plane logs."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)

  condition:
    $net
}
