/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:11:16.407936+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_External_TFTP_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a TFTP session (UDP/TCP port 69) crossing the network perimeter to a non-internal destination. TFTP is the standard protocol for network devices to pull or push OS images and configuration files. Legitimate image transfers stay on the internal management network, so an external TFTP connection from a device or internal host can indicate a modified or replacement system image being staged or exfiltrated."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress traffic from management VLANs and network devices must traverse the logging firewall."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor-assisted firmware upgrades over TFTP to a support or lab server outside the perimeter, remote branch devices pulling images from a central TFTP server across a WAN or public address space, PXE or provisioning services hosted externally, and misconfigured devices pointing at a decommissioned or public TFTP host."
    tuning_guidance = "Add authorised management or provisioning source addresses to %global_allowed_mgmt_sources. Add approved service or automation accounts to %global_allowed_service_accounts if the log carries a user. Ensure %rfc1918_internal contains the internal ranges, including any private WAN space used between sites. Review any hit against recent change tickets for firmware upgrades."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
