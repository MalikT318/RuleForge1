/*
  MITRE Technique : T1568.002 - Domain Generation Algorithms
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:05:29.000732+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_002_ESXi_Network_Config_Set_To_DGA_Like_Domain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host configuration change to a name-resolution or outbound-service setting (DNS server or search domain, NTP, syslog target, hostname or domain) where the logged value contains a DGA-like domain: a long, vowel-poor or digit-mixed random label. DGA-driven implants or operators who pivot to a freshly generated domain may persist it into host configuration. This rule detects the resulting configuration state change, not a command line."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.002"
    mitre_technique_name = "Dynamic Resolution: Domain Generation Algorithms"
    log_prerequisites = "ESXi hostd and config-change logs ingested and normalised to SETTING_MODIFICATION. The setting name must populate target.resource.name and the change message must populate metadata.description, including the new value."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate vendor, cloud or CDN-hosted NTP, syslog or DNS names with long or machine-generated labels; auto-generated internal hostnames; lab or test environments; admins pasting unusual but valid FQDNs."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation accounts (host-profile or desired-state tooling) to %global_allowed_service_accounts. If a known-good generated domain recurs, tighten or extend the label regex for the client rather than hardcoding the domain. Raise the risk score if the change was made outside the change window or from a non-management session."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.resource.name = /(?i)(dns|ntp|syslog|searchdomain|resolv|hostname|domain)/
    $cfg.metadata.description = /(?i)\b(?:[a-z0-9]*[bcdfghjklmnpqrstvwxz]{5,}[a-z0-9]*|[a-z]{14,}|[a-z]{4,}[0-9]{3,}[a-z0-9]*)\.[a-z]{2,10}\b/
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1568.002")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $changed_setting = array_distinct($cfg.target.resource.name)
    $changed_by = array_distinct($cfg.principal.user.userid)
    $change_message = array_distinct($cfg.metadata.description)

  condition:
    $cfg
}
