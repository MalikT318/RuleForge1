/*
  MITRE Technique : T1570 - Lateral Tool Transfer
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:15:43.299617+00:00
  Reference       : https://attack.mitre.org/techniques/T1570
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1570_Linux_Transfer_Binary_Outbound_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of a Linux file-transfer client (scp, sftp, rsync, ftp, tftp, smbclient) opening an outbound connection to a non-internal address on a file-transfer port (FTP, SSH/SFTP, TFTP, rsync daemon, SMB). This is the network footprint of tools or staged files being moved between systems or to a relay or sync endpoint outside internal address space. It complements process command-line rules because it keys on the connection itself, not the arguments."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1570"
    mitre_technique_name = "Lateral Tool Transfer"
    log_prerequisites = "Linux endpoint telemetry that emits NETWORK_CONNECTION with the originating process path (EDR network events or auditd connect() records), plus a populated %rfc1918_internal reference list."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and mirroring jobs using rsync or sftp to offsite or cloud targets; sysadmins copying files to public-addressed servers; configuration management and deployment pipelines; package or repository mirroring; hosts in cloud VPCs where peer systems use public addresses."
    tuning_guidance = "Add approved transfer binaries or jobs to %global_allowed_admin_tools and backup software to %global_allowed_backup_processes. Add automation identities to %global_allowed_service_accounts. Keep %rfc1918_internal current for the client's address plan. Raise severity for servers that should never initiate file transfers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    $net.principal.process.file.full_path = /\/(scp|sftp|rsync|ftp|lftp|tftp|smbclient)$/ nocase
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 69 or
      $net.target.port = 445 or
      $net.target.port = 873
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1570")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $transfer_processes = array_distinct($net.principal.process.file.full_path)
    $acting_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
