/*
  MITRE Technique : T1654 - Log Enumeration
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:58:30.176826+00:00
  Reference       : https://attack.mitre.org/techniques/T1654
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1654_Windows_Event_Log_Query_Export {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the Windows event log utility being used to query or export sensitive event logs (Security, System, Sysmon, PowerShell, RDP, Task Scheduler, WinRM), or PowerShell cmdlets reading the same logs. Adversaries enumerate these logs to find authentication records, security software and remote hosts, or to track incident response activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1654"
    mitre_technique_name = "Log Enumeration"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators troubleshooting, IT health-check and inventory scripts, RMM and patching tooling, SIEM or log-collection agents that read local event logs, and authorised forensic or IR collection."
    tuning_guidance = "Add approved admin tooling parents to %global_allowed_admin_tools, EDR/log-forwarding agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Review hosts with recurring benign hits and consider raising severity when the parent is an Office application, script host or remote-execution service."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\wevtutil\.exe$/ nocase
        $proc.target.process.command_line = /\b(qe|query-events|epl|export-log)\b.*(security|system|microsoft-windows-(sysmon|powershell|terminalservices|taskscheduler|winrm|remoteconnectionmanager))/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        $proc.target.process.command_line = /\b(get-winevent|get-eventlog)\b.*(security|system|microsoft-windows-(sysmon|powershell|terminalservices|taskscheduler|winrm|remoteconnectionmanager))/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1654")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
