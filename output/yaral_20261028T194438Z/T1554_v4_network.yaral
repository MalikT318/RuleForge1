/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:11:38.361689+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_Non_Network_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in desktop utility that has no network function (text editor, calculator, paint, wordpad, on-screen keyboard and similar) making an outbound connection to an external address. A trojanized or patched host binary acting as a persistent backdoor will beacon to its controller, which is the network-side symptom of T1554. Detection keys on the process role, not on file hashes, destination infrastructure or attacker tool names."
    mitre_tactic = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes each connection to the initiating process (EDR network events or Sysmon Event ID 3) and populates principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Modern Windows builds of Notepad, Paint and similar utilities contacting vendor update, telemetry or cloud-feature endpoints. Also expect OS-integrated AI/cloud features, RMM or software-deployment tooling that launches these utilities, and security agents that sandbox or detonate files."
    tuning_guidance = "Add vendor update and cloud-service domains to %global_allowed_domains. Add approved launcher or management binaries to %global_allowed_admin_tools. Add EDR/AV agents to %global_allowed_security_tools. Extend the process-name regex with other non-networked utilities that are common in the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|wordpad|write|charmap|osk|magnify|sndvol|mplay32)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
