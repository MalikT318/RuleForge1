/*
  MITRE Technique : T1526 - Cloud Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:26:40.397090+00:00
  Reference       : https://attack.mitre.org/techniques/T1526
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1526_SaaS_Identity_Directory_Service_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an identity or directory principal performing list, enumerate or read operations against tenant-level service objects (applications, service principals, consent grants, policies, subscriptions, tenants). This is the SaaS and identity control-plane form of cloud service discovery. Adversaries with a stolen token or account use it to map the cloud services in a tenant before targeting data or privileges. The rule keys on the action and object type, not on any tool name, so it still fires if the tool is renamed."
    mitre_tactic = "Discovery"
    mitre_technique = "T1526"
    mitre_technique_name = "Cloud Service Discovery"
    log_prerequisites = "Identity provider directory audit or API activity logs ingested and normalised to UDM USER_RESOURCE_ACCESS, with metadata.product_event_type and/or target.url populated, and principal.user.userid populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "IT administrators reviewing app registrations, IAM governance and access-review tooling, CASB and SaaS posture-management connectors, onboarding or migration projects, auditors running inventory exports, and developers listing their own app registrations."
    tuning_guidance = "Add known automation and connector accounts to %global_allowed_service_accounts, sanctioned admins to %global_allowed_admin_users, approved integration principals to %global_allowed_cloud_principals, and trusted admin source addresses to %global_allowed_mgmt_sources. Pair with a Threshold variant if single-event volume is high in a given tenant. Raise severity when the principal is a first-seen or recently consented application."

  events:
    $saas.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $saas.metadata.product_event_type = /(?i)(list|enumerate|get|read|query|search).{0,40}(service.?principal|application|app.?registration|oauth.?grant|consent.?grant|directory.?role|conditional.?access|policy|subscription|tenant|organization)/ or
      $saas.target.url = /(?i)\/(serviceprincipals|applications|oauth2permissiongrants|directoryroles|subscriptions|tenants|policies|organization)(\/|\?|$)/
    )
    $saas.principal.user.userid != ""
    not $saas.principal.user.userid in %global_allowed_service_accounts
    not $saas.principal.user.userid in %global_allowed_admin_users
    not $saas.principal.user.userid in %global_allowed_cloud_principals
    not $saas.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1526")
    $primary_entity = array_distinct($saas.principal.user.userid)
    $source_ips = array_distinct($saas.principal.ip)
    $operations = array_distinct($saas.metadata.product_event_type)
    $targets = array_distinct($saas.target.url)

  condition:
    $saas
}
