/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:11:25.289378+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Cloud_Mass_Compute_Launch_Then_Network_Rule_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects likely staging of cloud-hosted flood capacity. One identity launches several compute instances and then opens or changes network access rules within ten minutes. The control plane does not carry packet volume, so this rule flags the precursor (mass instance launch plus firewall or security-group loosening) and not the flood itself. Compromised cloud credentials are commonly used this way to build DoS botnet nodes."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Requires cloud control-plane audit logs ingested with principal.user.userid and metadata.product_event_type populated for compute-instance creation and firewall or security-group rule changes."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Autoscaling and infrastructure-as-code pipelines, CI/CD deployments, cloud migration or DR tests, new environment builds by platform teams, and batch or HPC clusters that launch many instances and adjust security groups."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named platform engineers to %global_allowed_admin_users. Raise the #inst threshold in condition for clients with large autoscaling fleets. Extend the product_event_type regexes if the client uses additional compute or firewall API names."

  events:
    $inst.metadata.event_type = "RESOURCE_CREATION"
    $inst.metadata.product_event_type = /(RunInstances|instances\.(insert|bulkInsert)|virtualMachines\/write|virtualMachineScaleSets\/write)/ nocase
    $inst.principal.user.userid = $user
    not $inst.principal.user.userid in %global_allowed_service_accounts
    not $inst.principal.user.userid in %global_allowed_cloud_principals
    not $inst.principal.user.userid in %global_allowed_admin_users

    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.metadata.product_event_type = /(AuthorizeSecurityGroup(Ingress|Egress)|firewalls\.(insert|patch|update)|securityRules\/write|networkSecurityGroups\/write)/ nocase
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.principal.user.userid in %global_allowed_admin_users

    $inst.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($inst.principal.user.userid)
    $instances_launched = count_distinct($inst.metadata.id)
    $network_rule_changes = count_distinct($perm.metadata.id)
    $source_ips = array_distinct($inst.principal.ip)
    $launch_apis = array_distinct($inst.metadata.product_event_type)
    $rule_change_apis = array_distinct($perm.metadata.product_event_type)

  condition:
    #inst >= 3 and $perm
}
