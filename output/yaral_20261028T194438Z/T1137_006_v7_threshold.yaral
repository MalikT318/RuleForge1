/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:24:09.805860+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_Addin_File_Drops_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Multiple Office add-in or startup-template files (WLL, XLL, XLAM, XLA, PPAM, DOTM and similar) are created within Office add-in or startup folders on a single host within 10 minutes. A single add-in drop can be a normal install. A burst of drops by one host, especially from a non-Office parent such as a script host, indicates add-in persistence staging."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file-creation telemetry (Sysmon Event ID 11 or equivalent) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching of Office add-ins, Office Click-to-Run updates, enterprise add-in rollouts (finance or reporting XLL/XLAM packages), users installing legitimate add-ins, and IT imaging or profile-migration tasks."
    tuning_guidance = "Add deployment and RMM tool binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Raise the threshold (#file) for environments with heavy add-in rollouts. Review $creating_processes in the outcome for script hosts or user-writable paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)\\Microsoft\\(Word\\STARTUP|Excel\\XLSTART|AddIns|Outlook|PowerPoint\\AddIns)\\[^\\]+\.(wll|xll|xlam|xla|ppam|ppa|dotm|xltm|vsto|dll)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(OfficeClickToRun|OfficeC2RClient|integrator)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.principal.process.file.full_path = /(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/, 85, 60))
    $file_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($host)
    $dropped_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
