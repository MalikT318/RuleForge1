/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:24:23.423241+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_Linux_Environment_Fingerprinting_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of host and environment fingerprinting commands (hostname, domain, resolver, machine-id, disk, network and DMI queries) launched by an interpreter or from a world-writable directory on a single Linux host within ten minutes. This pattern is typical of payload execution guardrails, where malware checks for expected target-specific values (domain, hostname, machine-id, mounted devices, addressing) before continuing."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path and target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt), inventory and asset collection scripts, cloud-init and provisioning scripts, monitoring agents, installers that check the environment, and administrators troubleshooting from a shell or interpreter."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for noisy fleets. Investigate hosts where the matching commands were launched from /tmp, /var/tmp or /dev/shm first."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(^|\/|\s)(hostname|domainname|dnsdomainname|realm|dmidecode|lsblk|blkid|findmnt|ifconfig)(\s|$)|\bip\s+(a|addr|address|route|link)\b|\/etc\/(resolv\.conf|machine-id|krb5\.conf|sssd\/sssd\.conf)/ nocase
    $proc.principal.process.file.full_path = /(\/(tmp|var\/tmp|dev\/shm)\/|\/(ba|da|z|k|c|tc|a)?sh$|\/python[0-9.]*$|\/perl$|\/ruby$)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 6
}
