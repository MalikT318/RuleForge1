/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:17:57.560508+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_External_Inbound_Device_CLI_Mgmt_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from an external (non-internal) source to an internal host on a network device CLI management port (SSH 22 or Telnet 23), as seen at the perimeter. Remote CLI access to network devices from the internet is the network-side signature of an adversary reaching the device CLI (T1059.008) to change device behaviour, alter configuration or disable logging. Complements endpoint and command-line detections by observing the management-plane exposure itself."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover the internet-facing boundary so that external source addresses are visible. Populate %rfc1918_internal with the client's internal address space."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSP remote support reaching device CLI over SSH; administrators working remotely without VPN; external vulnerability scanners and attack-surface monitoring; internet-wide scanning noise when the firewall permits inbound SSH (a misconfiguration worth fixing); NAT or VPN concentrators whose external-facing address is logged as the source."
    tuning_guidance = "Add approved support and jump-host source addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to %global_allowed_scanners. Add vetted administrator accounts to %global_allowed_admin_users where user identity is logged. If the firewall logs denied traffic as NETWORK_CONNECTION, expect scanning noise and consider pairing this rule with a threshold variant. Confirm %rfc1918_internal covers all client private ranges, including any carrier-grade NAT space in use."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23)
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)
    $target_hostnames = array_distinct($net.target.hostname)

  condition:
    $net
}
