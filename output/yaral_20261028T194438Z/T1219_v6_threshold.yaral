/*
  MITRE Technique : T1219 - Remote Access Tools
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:05:37.497392+00:00
  Reference       : https://attack.mitre.org/techniques/T1219
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_Remote_Access_Tool_Install_Footprint_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of registry changes on a single host within 10 minutes that match the install footprint of a remote access tool: service ImagePath registration, host firewall rule creation, and autorun persistence. Each change is routine alone. Several together from the same host, written by processes outside the approved admin, remote-management and security tooling, suggest an unapproved remote access agent being installed for interactive command and control. The rule is behavioral, does not depend on tool names, and complements command-line based detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219"
    mitre_technique_name = "Remote Access Tools"
    log_prerequisites = "Requires EDR or Sysmon registry value-set telemetry (Sysmon Event ID 13 equivalent) normalised to REGISTRY_MODIFICATION with registry key, value name and writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party software installs (drivers, VPN clients, collaboration tools, backup agents), RMM or helpdesk agent rollouts not yet in the allowlists, golden-image build and sysprep activity, and software deployment during patch windows."
    tuning_guidance = "Add approved RMM and deployment binaries to %global_allowed_admin_tools and %global_allowed_remote_mgmt. Add EDR and AV agents to %global_allowed_security_tools. Add deployment service accounts to %global_allowed_service_accounts. Raise the #reg threshold on noisy build or imaging hosts. Severity and risk score scale with event volume in the outcome section."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.principal.hostname = $host
    (
      (
        $reg.target.registry.registry_key = /\\CurrentControlSet\\Services\\[^\\]+$/ nocase and
        $reg.target.registry.registry_value_name = /^ImagePath$/ nocase
      ) or
      $reg.target.registry.registry_key = /\\SharedAccess\\Parameters\\FirewallPolicy\\FirewallRules$/ nocase or
      $reg.target.registry.registry_key = /\\CurrentVersion\\Run(Once)?$/ nocase
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $event_count = count($reg.metadata.id)
    $risk_score = max(if($event_count >= 10, 80, if($event_count >= 6, 65, 50)))
    $mitre_technique_id = array_distinct("T1219")
    $primary_entity = array_distinct($host)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 4
}
