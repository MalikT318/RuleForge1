/*
  MITRE Technique : T1496 - Resource Hijacking
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:51:21.546692+00:00
  Reference       : https://attack.mitre.org/techniques/T1496
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_SaaS_Bulk_Compute_Resource_Creation_By_Single_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity creates an unusually high number of compute-type resources (instances, VMs, clusters, containers, functions) within 10 minutes. Each creation is benign on its own. A burst from one identity is a common cryptojacking pattern, where stolen cloud or SaaS credentials are used to spin up compute for mining or proxy abuse."
    mitre_tactic = "Impact"
    mitre_technique = "T1496"
    mitre_technique_name = "Resource Hijacking"
    log_prerequisites = "Requires cloud or SaaS control-plane audit logs that populate principal.user.userid and metadata.product_event_type for resource creation events, normalised to RESOURCE_CREATION."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines, autoscaling and CI/CD runners, legitimate cluster or batch-job launches, data-science or load-test provisioning, and migration projects."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved cloud principals to %global_allowed_cloud_principals, and named admins to %global_allowed_admin_users. Raise or lower the #res threshold per client baseline. Narrow the product_event_type regex if the client's logs use different API naming."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.metadata.product_event_type = /(?i)(create|run|launch|start|provision).*(instance|virtualmachine|vm|cluster|node|container|compute|function|job)/
    $res.principal.user.userid = $user
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_cloud_principals
    not $res.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($res.metadata.id)
    $mitre_technique_id = array_distinct("T1496")
    $primary_entity = array_distinct($user)
    $created_resources = array_distinct($res.target.resource.name)
    $api_actions = array_distinct($res.metadata.product_event_type)
    $source_ips = array_distinct($res.principal.ip)

  condition:
    #res >= 10
}
