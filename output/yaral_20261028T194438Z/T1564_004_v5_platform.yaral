/*
  MITRE Technique : T1564.004 - NTFS File Attributes
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:20:01.795780+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_004_NTFS_Alternate_Data_Stream_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a named NTFS Alternate Data Stream (file.ext:streamname) by a non-allowlisted process. It uses file-creation telemetry rather than process command lines, so it is additive to command-line rules. NTFS attributes exist only on Windows, so the alternate-platform angle cannot apply and this rule targets Windows."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.004"
    mitre_technique_name = "Hide Artifacts: NTFS File Attributes"
    log_prerequisites = "Requires endpoint file-stream creation telemetry normalised to FILE_CREATION with the stream suffix preserved in target.file.full_path (for example Sysmon Event ID 15 or equivalent EDR stream-creation events)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Browsers and mail clients writing Mark-of-the-Web streams not covered by the exclusion, cloud sync clients (OneDrive, Dropbox) writing metadata streams, backup and indexing software, Office or Explorer property streams, and software installers or developer tools that legitimately use named streams."
    tuning_guidance = "Add legitimate stream-writing process paths to %global_allowed_security_tools, %global_allowed_backup_processes or %global_allowed_admin_tools. Extend the benign stream-name exclusion regex with client-specific stream names seen in the first week of baselining. To reduce volume further, restrict to user-writable directories after baselining."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\(.*\\)?[^\\:]+:[^\\:]+/ nocase
    not $file.target.file.full_path = /:(zone\.identifier|encryptable|summaryinformation|documentsummaryinformation|favicon|smartscreen|oecustomproperty|com\.dropbox\.attrs|afp_afpinfo|afp_resource)(:\$data)?$/ nocase
    not $file.target.file.full_path = /:\$data$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1564.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $stream_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
