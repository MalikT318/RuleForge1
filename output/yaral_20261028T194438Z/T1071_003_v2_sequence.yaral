/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:07:33.654706+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_Mail_Protocol_Send_And_Retrieve_Same_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single internal source opens an outbound SMTP submission connection and then a POP3/IMAP retrieval connection to the same external IP within five minutes. Ordinary clients normally use the organisation's own mail server or a known mail provider. Using both send and receive mail protocols with one unknown external host resembles a mail-protocol command-and-control channel, where tasking is read over POP3/IMAP and results are returned over SMTP."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires firewall or perimeter connection and flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress traffic on mail ports must be logged, not dropped before logging."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Users or applications with personal or third-party mail accounts on external providers, SaaS applications and appliances that send and poll mail, multifunction devices, and migration or backup tooling that connects to a hosted mailbox over several protocols. Legitimate on-premises mail relays reached by public IP are another source."
    tuning_guidance = "Add known external mail providers to %global_allowed_domains, which is matched against target.hostname. This only helps where the firewall log resolves the destination hostname. For mail servers reached by public IP, add the source servers to %global_allowed_mgmt_sources, or filter them on the SIEM side. Raise severity for workstation or server-segment sources that should never speak mail protocols directly to the internet."

  events:
    $smtp.metadata.event_type = "NETWORK_CONNECTION"
    ($smtp.target.port = 25 or $smtp.target.port = 465 or $smtp.target.port = 587)
    $smtp.principal.ip = $src_ip
    $smtp.target.ip = $dst_ip
    not $smtp.target.ip in %rfc1918_internal
    not $smtp.target.hostname in %global_allowed_domains

    $retr.metadata.event_type = "NETWORK_CONNECTION"
    ($retr.target.port = 110 or $retr.target.port = 143 or $retr.target.port = 993 or $retr.target.port = 995)
    $retr.principal.ip = $src_ip
    $retr.target.ip = $dst_ip
    not $retr.target.ip in %rfc1918_internal
    not $retr.target.hostname in %global_allowed_domains

    $smtp.metadata.event_timestamp.seconds <= $retr.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($src_ip)
    $external_mail_host = array_distinct($dst_ip)
    $smtp_ports = array_distinct($smtp.target.port)
    $retrieval_ports = array_distinct($retr.target.port)
    $smtp_connection_count = count($smtp.metadata.id)
    $retrieval_connection_count = count($retr.metadata.id)

  condition:
    $smtp and $retr
}
