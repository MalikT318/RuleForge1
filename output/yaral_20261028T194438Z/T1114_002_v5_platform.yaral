/*
  MITRE Technique : T1114.002 - Remote Email Collection
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:20:14.315596+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_002_M365_Mailbox_Delegate_Permission_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a mailbox or mailbox-folder permission grant in the Microsoft 365 / Google Workspace audit trail (for example full-access or folder delegation). Adversaries with stolen credentials or tokens use delegation to read a victim's mail remotely without keeping a session in that mailbox. Alternate-platform variant: SaaS control plane, no endpoint telemetry required."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.002"
    mitre_technique_name = "Email Collection: Remote Email Collection"
    log_prerequisites = "Microsoft 365 unified audit log with Exchange admin and mailbox audit operations ingested and normalised to UDM. The operation name must be populated in metadata.product_event_type. Equivalent Google Workspace delegation audit events may be matched if they normalise to the same event type."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Helpdesk or IT granting delegate access for executive assistants, shared mailboxes or onboarding; leave-of-absence coverage; mailbox migration and eDiscovery tooling; legal hold or compliance review access."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, provisioning and migration identities to %global_allowed_service_accounts, and approved cloud app principals to %global_allowed_cloud_principals. If the tenant maps these operations to a different UDM event type (for example SETTING_MODIFICATION or USER_RESOURCE_UPDATE_CONTENT), adjust metadata.event_type accordingly. Consider raising severity for grants on executive or finance mailboxes via an enrichment step in the SOAR playbook."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /^(Add-MailboxPermission|Add-MailboxFolderPermission|Set-MailboxFolderPermission|Add-RecipientPermission)$/ nocase
    $perm.principal.user.userid != ""
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.002")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $granted_to = array_distinct($perm.target.user.userid)
    $operation = array_distinct($perm.metadata.product_event_type)
    $source_ip = array_distinct($perm.principal.ip)

  condition:
    $perm
}
