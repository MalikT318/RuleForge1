/*
  MITRE Technique : T1546.002 - Screensaver
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:03:08.817043+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_002_Screensaver_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the SCRNSAVE.EXE screensaver registry value under the Control Panel\\Desktop key, where the new value does not point to a standard .scr file in the Windows system directories. Adversaries set this value to a malicious PE so it runs after user inactivity. This is registry-based coverage and does not depend on process command lines. Screensaver persistence is Windows-only, so the alternate-platform angle could not be applied; this variant takes the registry-telemetry angle on Windows instead."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.002"
    mitre_technique_name = "Event Triggered Execution: Screensaver"
    log_prerequisites = "Requires Windows registry modification telemetry (EDR registry events or Sysmon Event IDs 12/13/14) that populates target.registry.registry_key and ideally registry_value_name and registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or logon scripts that enforce a corporate screensaver, desktop-customisation or kiosk software, branded vendor screensavers installed to Program Files, and IT imaging or profile-provisioning tools."
    tuning_guidance = "Add deployment and profile tooling to %global_allowed_admin_tools, and automation or GPO accounts to %global_allowed_service_accounts. If the registry_value_data field is not populated by the client's EDR, the system-directory exclusion is a no-op and every SCRNSAVE.EXE write will alert. Review corporate branded screensavers and add their writers to the allowlists."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control Panel\\Desktop/ nocase
    (
      $reg.target.registry.registry_value_name = /^SCRNSAVE\.EXE$/ nocase or
      $reg.target.registry.registry_key = /\\SCRNSAVE\.EXE$/ nocase
    )
    not $reg.target.registry.registry_value_data = /^"?[a-z]:\\windows\\(system32|syswow64)\\[^\\]+\.scr"?$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $screensaver_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
