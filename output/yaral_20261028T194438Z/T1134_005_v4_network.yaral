/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:02:29.758125+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_SID_History_AD_Protocol_Interpreter_NonInternal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a script or living-off-the-land interpreter opening a connection to a non-internal destination on Active Directory and remote-service ports (LDAP/LDAPS/Global Catalog, Kerberos, RPC endpoint mapper, SMB, WinRM). SID-History injection needs domain-level rights and is normally followed by lateral movement over these protocols. Internal address space is excluded via %rfc1918_internal, so this rule only covers AD or remote-service traffic that leaves private address space. Examples are a hybrid or cloud-hosted domain controller, a pivot or tunnel through a public relay, and exposure of AD services. It is a low-volume, high-signal network indicator. It does not replace endpoint detection of the SID-History write itself."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path and destination IP and port (EDR or Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators managing hybrid or cloud-hosted domain controllers through PowerShell remoting or LDAP over public address space; approved RMM or deployment tooling; domain-join or migration scripts against cloud directories; VPN or NAT ranges that appear as non-RFC1918 space; vulnerability scanners and authorised security testing."
    tuning_guidance = "Add approved admin and migration tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and approved remote management software to %global_allowed_remote_mgmt. Add jump hosts and admin workstations to %global_allowed_script_hosts. Populate %rfc1918_internal with any customer-specific private or VPN ranges. To widen coverage to internal domain controllers, remove the %rfc1918_internal exclusion and baseline with %global_allowed_admin_tools first, as internal volume will be much higher."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|wmic|powershell_ise)\.exe$/ nocase
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269 or
      $net.target.port = 88 or
      $net.target.port = 135 or
      $net.target.port = 445 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
