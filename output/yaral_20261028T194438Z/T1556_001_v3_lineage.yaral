/*
  MITRE Technique : T1556.001 - Domain Controller Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:14:54.080173+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_001_LSASS_Parent_Spawns_Shell_Or_LOLBin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects the Local Security Authority process (lsass.exe), the authentication engine patched by Skeleton Key-style domain controller authentication backdoors, acting as the PARENT of a shell, script interpreter or common living-off-the-land binary. LSASS does not normally spawn interactive or scripting child processes, so this lineage indicates the authentication process has been compromised, injected into or patched. Detection is based on process lineage only, not on command-line content."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.001"
    mitre_technique_name = "Modify Authentication Process: Domain Controller Authentication"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR or Sysmon Event ID 1) that populates both parent (principal.process) and child (target.process) image paths. Deploy on domain controllers as a priority."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Crash-handling helpers (WerFault) after an LSASS fault, EDR/AV agents performing remediation or memory-scan actions, and approved admin or forensic tooling that is launched from an LSASS-parented context during incident response."
    tuning_guidance = "Add approved child binaries to %global_allowed_admin_tools or %global_allowed_security_tools. If a specific endpoint security product legitimately spawns helpers from LSASS, add its executable to %global_allowed_security_tools rather than excluding by install directory. Extend or narrow the child regex per customer baseline."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic|msiexec|certutil|bitsadmin|installutil|regasm|regsvcs|msbuild|schtasks|sc|net|net1|whoami|reg)\.exe$/ nocase
    not $proc.target.process.file.full_path = /\\(WerFault|WerFaultSecure)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1556.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
