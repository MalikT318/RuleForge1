/*
  MITRE Technique : T1564.008 - Email Hiding Rules
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:25:47.240436+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_008_Linux_Mail_Filter_Rule_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of per-user mail filtering rule files on Linux (Sieve scripts, procmail and maildrop rules, Thunderbird msgFilterRules.dat, Evolution filters.xml). Adversaries with access to a compromised account can edit these files to silently move, delete or mark as read inbound mail such as security alerts or replies to internal phishing. This rule works on the file-write artifact rather than the command line, so it still fires when the edit comes from an editor, script, or managesieve daemon."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.008"
    mitre_technique_name = "Hide Artifacts: Email Hiding Rules"
    log_prerequisites = "Linux EDR or auditd file-write telemetry (FILE_MODIFICATION) with file watches on user home directories, including mail client profile paths, and on user Sieve and procmail rule files."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users legitimately editing their own mail filters in Thunderbird, Evolution or a webmail Sieve plugin (Roundcube managesieve); mail administrators deploying Sieve or procmail templates; configuration management pushing mail rules; user-profile migration or backup restore jobs."
    tuning_guidance = "Add approved mail administration and configuration management binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Dovecot-compiled .svbin output is already excluded. On hosts with many desktop mail users, consider scoping to servers only or raising severity when the writer is not a mail client or mail daemon. A sibling rule on FILE_CREATION can cover first-time rule file creation if the EDR separates create from write events."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(\/\.dovecot\.sieve$|\.sieve$|\/\.procmailrc$|\/\.mailfilter$|\/msgFilterRules\.dat$|\/\.config\/evolution\/mail\/filters\.xml$)/ nocase
    not $file.target.file.full_path = /\.svbin$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|puppet|chef-client|salt-minion)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1564.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
