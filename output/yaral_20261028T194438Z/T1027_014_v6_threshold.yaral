/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:01:36.263893+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Polymorphic_Executable_Drop_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of executable or library files (exe, dll, scr, sys, ocx, cpl) written to user-writable staging locations on a single host within ten minutes. Each file is individually benign, but high-volume creation of fresh binaries is consistent with a polymorphic or mutation-engine dropper emitting a new variant on every run."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters unpacking binaries to temp folders, developer build and compile output, CI agents, self-extracting archives, application streaming or virtualisation tools, and patching or RMM agents."
    tuning_guidance = "Add approved installers and deployment tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Raise the #file threshold on developer or build hosts. Extend the executable-name exclusion for client-specific updaters."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(exe|dll|scr|sys|ocx|cpl)$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\appdata\\(local|roaming)\\|\\programdata\\|\\users\\public\\|\\windows\\temp\\)/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker|MsMpEng|MpCopyAccelerator|MpSigStub)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $dropped_paths = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 15
}
