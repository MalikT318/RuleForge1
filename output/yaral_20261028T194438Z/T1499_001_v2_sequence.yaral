/*
  MITRE Technique : T1499.001 - OS Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:16:35.703749+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_001_External_TCP_Half_Open_Flood_Linux_Target {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a TCP state-exhaustion flood (SYN/ACK flood pattern) seen at the network perimeter. One external source opens a high volume of TCP connections to a single destination, followed by a high volume of flows to the same destination that get no response bytes back (half-open or unanswered). This is the network-observable result of OS connection-table exhaustion against a Linux host and does not depend on endpoint process telemetry."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.001"
    mitre_technique_name = "Endpoint Denial of Service: OS Exhaustion Flood"
    log_prerequisites = "Requires firewall, proxy, or perimeter logs normalised to UDM NETWORK_CONNECTION and NETWORK_FLOW with principal.ip, target.ip, target.port, network.ip_protocol, and network.received_bytes populated. Flow logging must be enabled on the inbound interface or zone that protects the Linux servers."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners or load-testing sources not yet in the allowlist, CDN or reverse-proxy egress nodes that open many short-lived connections, NAT gateways aggregating many users behind one public IP, monitoring or health-check probes, and busy public services receiving legitimate bursts such as marketing events or crawlers."
    tuning_guidance = "Add authorised scanners and load-test sources to %global_allowed_scanners and approved sources to %global_allowed_mgmt_sources. Raise or lower the #conn and #flow thresholds per client based on the baseline connection rate of the protected service. For clients whose firewalls do not populate network.received_bytes, check that the field is mapped before deploying, because the flow leg depends on it. Shorten the window for high-volume edge environments."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.network.ip_protocol = "TCP"
    $conn.target.port > 0
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip

    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.ip_protocol = "TCP"
    $flow.network.received_bytes = 0
    not $flow.principal.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    not $flow.principal.ip in %global_allowed_mgmt_sources
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip

    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1499.001")
    $primary_entity = array_distinct($dst_ip)
    $attacker_ip = array_distinct($src_ip)
    $conn_count = count($conn.metadata.id)
    $unanswered_flow_count = count($flow.metadata.id)
    $targeted_ports = array_distinct($conn.target.port)
    $first_seen = min($conn.metadata.event_timestamp.seconds)
    $last_seen = max($flow.metadata.event_timestamp.seconds)

  condition:
    #conn >= 200 and #flow >= 100
}
