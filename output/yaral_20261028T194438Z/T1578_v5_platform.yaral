/*
  MITRE Technique : T1578 - Modify Cloud Compute Infrastructure
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:49:06.142835+00:00
  Reference       : https://attack.mitre.org/techniques/T1578
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_Cloud_Snapshot_Image_Sharing_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a permission or sharing change on a compute snapshot, machine image, or disk in a cloud control plane (for example snapshot or image attribute modification, disk or snapshot access grants, and IAM policy changes on compute images, snapshots, and disks). Adversaries use these changes to copy infrastructure into an account they control, expose data, or alter compute components to evade defenses and remove evidence (T1578). The rule matches the permission-change API behavior, not a specific tool or destination account."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578"
    mitre_technique_name = "Modify Cloud Compute Infrastructure"
    log_prerequisites = "Cloud control-plane audit logs (management or admin activity events) ingested and normalized to UDM as RESOURCE_PERMISSIONS_CHANGE with metadata.product_event_type populated with the API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Approved backup and disaster-recovery automation sharing snapshots to a recovery account, golden-image publishing pipelines, cross-account migration projects, platform engineers sharing images between environments, and scheduled DR replication jobs."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_cloud_principals and approved platform administrators to %global_allowed_admin_users. Review the principal, resource, and operation outcome fields to decide whether the sharing target is a known account. Consider raising severity if the change occurs outside business hours or follows a recent credential or access-key event for the same principal."

  events:
    $cloud.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $cloud.metadata.product_event_type = /(ModifySnapshotAttribute|ModifyImageAttribute|ModifyDBSnapshotAttribute|ModifyDBClusterSnapshotAttribute|compute\.(snapshots|images|disks)\.setIamPolicy|compute\/(snapshots|disks)\/(beginGetAccess|grantAccess))/ nocase
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1578")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
