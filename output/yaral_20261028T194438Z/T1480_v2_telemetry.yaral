/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:22:48.642439+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_ESXi_Execution_Guardrail_Marker_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of lock, pid, mutex or marker files in world-writable ESXi staging locations (/tmp, /var/tmp, /dev/shm, /scratch/tmp) by a shell or interpreter. Malware uses these files as execution guardrails so a payload runs only once per host or only on hosts it has not already processed. Detection pivots on the resulting file artifact, not on command-line content, so it still fires when command-line logging is evaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "ESXi shell, hostd or audit telemetry that is normalised to UDM FILE_CREATION events with principal.process and target.file.full_path populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrator maintenance scripts that use lock files to prevent overlapping runs, patching and upgrade scripts, third-party backup or monitoring agents that run through a shell and write pid files in /tmp, and support-bundle collection scripts."
    tuning_guidance = "Add approved automation accounts to %global_allowed_service_accounts and approved script or tooling binaries to %global_allowed_admin_tools. Add backup agents to %global_allowed_backup_processes. If marker files are legitimately created on specific hosts, scope the exclusions with %global_allowed_script_hosts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch\/tmp)\/[^\/]*(lock|\.pid|mutex|\.flag|\.done|\.marker|\.running)[^\/]*$/ nocase
    $file.principal.process.file.full_path = /\/(busybox|sh|ash|bash|python[0-9.]*|perl)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($file.principal.hostname)
    $marker_paths = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
