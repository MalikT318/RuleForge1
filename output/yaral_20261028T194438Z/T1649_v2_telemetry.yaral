/*
  MITRE Technique : T1649 - Steal or Forge Authentication Certificates
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:51:10.174635+00:00
  Reference       : https://attack.mitre.org/techniques/T1649
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1649_AD_CS_Config_Object_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to Active Directory Certificate Services objects stored under the Public Key Services container in the directory (certificate templates, enrollment services, NTAuth store, OID objects). Altering template flags, EKUs, enrollment permissions or CA trust objects is a state change that enables forged or illegitimately issued authentication certificates, and it is visible whether or not command-line activity was logged."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1649"
    mitre_technique_name = "Steal or Forge Authentication Certificates"
    log_prerequisites = "Directory service object change auditing (Windows Security Event 5136/5137/5141 equivalents) on domain controllers with SACLs on the Public Key Services container in the Configuration partition, ingested and normalized to SETTING_MODIFICATION with the object distinguished name in target.resource.name. Requires identity/directory audit logs only, no endpoint telemetry."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Authorised PKI administrators editing or publishing certificate templates, new CA deployment or CA migration, scheduled template version upgrades, auto-enrollment configuration changes, AD CS role installation."
    tuning_guidance = "Add PKI administrator accounts to %global_allowed_admin_users and automation or CA computer/service accounts to %global_allowed_service_accounts. Validate during change windows and confirm that the directory audit pipeline maps the object DN to target.resource.name; if your parser uses another field, adjust this single field reference."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.target.resource.name = /CN=Public Key Services,CN=Services,CN=Configuration/ nocase
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1649")
    $primary_entity = array_distinct($set.principal.user.userid)
    $modified_objects = array_distinct($set.target.resource.name)
    $source_ips = array_distinct($set.principal.ip)

  condition:
    $set
}
