/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:04:47.694622+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_Mass_Executable_Drops_User_Writable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of executable or library file creations (exe, dll, scr, sys) in user-writable directories on a single host within 10 minutes. Each event is benign. The volume points to a builder, polymorphic dropper or packer generating many junk-padded, unique binary variants, which is the file-level footprint of T1027.016 junk code insertion. This rule deliberately avoids process command-line matching so it complements existing PROCESS_LAUNCH detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters unpacking into temp or AppData, developer build output (compilers, CI agents on workstations), browser or collaboration-client auto-updates, game launchers and patchers, and portable-app extractors."
    tuning_guidance = "Add approved deployment, patching and build tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add known build or CI service accounts to %global_allowed_service_accounts. Raise the #file threshold on developer hosts. Extend the creator-name exclusion regex for noisy updaters in your environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata\\(local|roaming)|downloads|desktop|documents)|users\\public|programdata|windows\\temp)\\.*\.(exe|dll|scr|sys)$/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|tiworker|trustedinstaller|msmpeng|mpcmdrun|wuauclt|chrome|msedge|firefox|onedrive|teams)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity = array_distinct($host)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 10
}
