/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:58:37.666192+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_Cloud_Account_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity issues a high volume of account, role, group or IAM-policy listing API calls within ten minutes. Each call is benign on its own, but bulk enumeration of cloud accounts is a typical post-compromise discovery pattern."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires cloud control-plane audit logging with read/list API calls enabled and normalised to USER_RESOURCE_ACCESS with metadata.product_event_type populated. Some providers disable read-event (data-plane or management-read) logging by default."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "IAM governance and access-review tooling, CSPM and inventory collectors, SSO or identity-sync connectors, infrastructure-as-code pipelines refreshing state, administrators running audits or offboarding reviews."
    tuning_guidance = "Add expected automation identities to %global_allowed_service_accounts, %global_allowed_cloud_principals or %global_allowed_admin_users. Raise the #cloud threshold for tenants with heavy governance tooling. Narrow or extend the product_event_type regex to match the provider's list API naming."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(?i)(ListUsers|ListRoles|ListGroups|ListGroupsForUser|ListRoleMembers|ListServiceAccounts|ListAccessKeys|ListAttachedUserPolicies|ListUserPolicies|GetIamPolicy|users\.list|serviceAccounts\.list|roleAssignments\.list|directoryRoles\.members|members\.list)/
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $event_count = count($cloud.metadata.id)
    $risk_score = max(if($event_count >= 50, 85, 55))
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($user)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 10
}
