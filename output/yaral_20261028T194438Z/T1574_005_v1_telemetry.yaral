/*
  MITRE Technique : T1574.005 - Executable Installer File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:30:18.041302+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_005_Installer_Temp_Binary_Overwrite {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an existing executable or DLL being modified inside a temporary installer unpack directory (self-extracting installer, Inno, NSIS, IExpress, GUID-named or 7z-style staging folders under a Temp path). Installers normally create these files once and then execute them. An in-place overwrite by a different process is the result of the installer file-permission weakness, where a low-privileged actor replaces a binary that a higher-privileged installer is about to run. The rule works from the file artifact, not the command line, so it still fires when command-line logging is evaded."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.005"
    mitre_technique_name = "Hijack Execution Flow: Executable Installer File Permissions Weakness"
    log_prerequisites = "Requires Windows endpoint file-modification telemetry (EDR or Sysmon file events) that populates target.file.full_path and the writing process path in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that patch their own unpacked binaries during setup (for example, multi-stage bootstrappers and some self-updating applications), software deployment agents, packaging and build tooling that rewrites DLLs in Temp, and developer workstations compiling into Temp subfolders."
    tuning_guidance = "Add approved installer, patching and deployment tool executables to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add service accounts that run unattended installs to %global_allowed_service_accounts. If a specific installer framework is noisy, exclude its writing process path rather than the Temp directory. Raise severity for servers or hosts where installs only occur in change windows."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\(appdata\\local\\temp|windows\\temp)\\(is-[^\\]+\.tmp|n[a-z]{1,2}[0-9a-z]+\.tmp|ixp[0-9]+\.tmp|7zs[^\\]+|wzse[0-9]\.tmp|\{[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\}|_mei[0-9]+|[^\\]+)\\([^\\]+\\)*[^\\]+\.(exe|dll|sys|ocx|scr|cpl)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
