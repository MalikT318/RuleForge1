/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:40:50.020820+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_Linux_Traffic_Interception_Redirect_Rule {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux netfilter rule (iptables, ip6tables or nft) that diverts traffic to a userspace queue or a local proxy listener, or rewrites its destination. The targets are NFQUEUE, TPROXY, REDIRECT and DNAT. These are the kernel mechanisms an adversary on a gateway, router or intermediate host uses to intercept, alter and forward data in transit. Interception of this kind usually precedes tampering with transmitted data."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records, normalised to UDM PROCESS_LAUNCH with full command-line arguments populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Container runtimes and orchestrators (Docker, Podman, Kubernetes kube-proxy, CNI plugins) and firewalld or ufw write NAT rules routinely. Legitimate transparent proxies, load balancers, NAT gateways, VPN and IDS/IPS deployments (NFQUEUE) and admin-authored port forwarding also match."
    tuning_guidance = "Add approved automation or firewall management binaries to %global_allowed_admin_tools (matched on parent process path) and automation accounts to %global_allowed_service_accounts. Extend the parent-name regex for client-specific container or CNI agents. On known gateway, proxy or IDS hosts, tune per host or reduce the target set to NFQUEUE|TPROXY only."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(iptables|ip6tables|nft|iptables-nft|iptables-legacy|ip6tables-nft|ip6tables-legacy|xtables-nft-multi|xtables-legacy-multi)$/ nocase
    $proc.target.process.command_line = /(-j|--jump)\s+(NFQUEUE|TPROXY|REDIRECT|DNAT)\b|\s(queue\s+(num|to|flags)|tproxy\s+(to|ip|ip6)|dnat\s+(to|ip|ip6)|redirect\s+to)\b/ nocase
    not $proc.principal.process.file.full_path = /\/(dockerd|containerd|containerd-shim|kube-proxy|kubelet|crio|podman|netavark|firewalld|ufw|libvirtd)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $netfilter_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
