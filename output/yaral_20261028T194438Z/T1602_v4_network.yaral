/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:16:51.299556+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_External_Access_To_Device_Config_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to a network device configuration-repository service: SNMP (161), TFTP (69) or Cisco Smart Install (4786). These services expose device configuration, and unsolicited external access is characteristic of configuration harvesting. Observed from the network perimeter, so no endpoint process telemetry is needed."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Requires firewall or perimeter logs that normalise to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Both allowed and denied connection logs are useful, so confirm which the client's firewall forwards."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Third-party network monitoring or NMS providers polling SNMP over the internet, managed service provider management stations, authorised external vulnerability scans, ISP or partner TFTP provisioning, internet-wide scanning noise (this fires on blocked probes too if denies are logged)."
    tuning_guidance = "Add approved external management or monitoring source addresses to %global_allowed_mgmt_sources and authorised scanner addresses to %global_allowed_scanners. If blocked probes create excess noise, restrict ingestion to allowed-connection logs or raise severity only when the connection was permitted. Confirm %rfc1918_internal covers the client's internal space, including any NATed or carrier-grade ranges."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 161 or $net.target.port = 69 or $net.target.port = 4786)
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
