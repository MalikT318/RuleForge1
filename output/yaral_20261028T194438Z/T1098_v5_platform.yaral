/*
  MITRE Technique : T1098 - Account Manipulation
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:40:30.428350+00:00
  Reference       : https://attack.mitre.org/techniques/T1098
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_Linux_Account_Database_Modified_By_Non_Standard_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Linux account and privilege files (/etc/passwd, /etc/shadow, /etc/group, /etc/gshadow, /etc/sudoers, /etc/sudoers.d/*) by a process other than the standard account management utilities. Attackers who have gained root commonly edit these files directly, with echo, sed, tee or a custom binary, to add a UID 0 account, set a known password hash, or grant passwordless sudo, which avoids the useradd/usermod command lines that process-creation rules look for. This rule keys on the file change itself."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098"
    mitre_technique_name = "Account Manipulation"
    log_prerequisites = "Linux endpoint telemetry that records file modification events with the acting process (EDR file events or auditd with watches on /etc/passwd, /etc/shadow, /etc/group, /etc/gshadow, /etc/sudoers and /etc/sudoers.d), normalised to UDM FILE_MODIFICATION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager post-install scripts that create service accounts; configuration management agents (Ansible, Puppet, Chef, Salt) that manage users or sudoers drop-ins; provisioning and cloud-init at first boot; identity or directory clients (SSSD, realmd) joining a domain; administrators editing files directly during break-glass work; image build pipelines."
    tuning_guidance = "Add approved configuration management, provisioning and deployment binaries to %global_allowed_admin_tools. Add automation account userids to %global_allowed_service_accounts. If package-manager noise is high on a client, extend the standard-utility exclusion regex with the relevant package manager binary names after confirming change control. Ensure auditd watch rules cover the monitored paths, otherwise the rule will not see the events."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(passwd|shadow|group|gshadow|sudoers)(-)?$|^\/etc\/sudoers\.d\/./ nocase
    not $file.principal.process.file.full_path = /\/(useradd|usermod|userdel|adduser|deluser|groupadd|groupmod|groupdel|passwd|chpasswd|chage|chfn|chsh|gpasswd|vipw|vigr|visudo|newusers|pwconv|grpconv|pwunconv|systemd-sysusers)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1098")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
