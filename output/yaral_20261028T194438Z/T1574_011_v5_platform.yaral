/*
  MITRE Technique : T1574.011 - Services Registry Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:42:28.806010+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_011_Service_Registry_ImagePath_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to a Windows service's ImagePath, FailureCommand or ServiceDll value that points to a user-writable location or a script interpreter. This is registry-telemetry coverage that does not depend on process command lines, so it also catches edits made through direct registry APIs, reg.exe, PowerShell or WMI. T1574.011 exists only on Windows, so the alternate-platform angle cannot be applied and this rule stays on Windows registry telemetry."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.011"
    mitre_technique_name = "Hijack Execution Flow: Services Registry Permissions Weakness"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13 equivalent) with registry key, value name and value data populated, and coverage of HKLM\\SYSTEM\\CurrentControlSet\\Services."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software installers or updaters that register services under ProgramData or user-profile paths, developer machines installing test services, RMM or deployment agents, and self-updating agents that rewrite ImagePath."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. Narrow or widen the suspicious-path regex per customer if ProgramData-based services are common."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d+)\\Services\\[^\\]+/ nocase
    (
      $reg.target.registry.registry_value_name = /^(ImagePath|FailureCommand|ServiceDll)$/ nocase or
      $reg.target.registry.registry_key = /\\(ImagePath|FailureCommand|ServiceDll)$/ nocase
    )
    $reg.target.registry.registry_value_data = /(\\users\\[^\\]+\\|\\appdata\\|\\temp\\|\\programdata\\|\\users\\public\\|\\windows\\debug\\|\\perflogs\\|\\windows\\tasks\\|cmd(\.exe)?\s+\/c|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript)/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1574.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $new_value = array_distinct($reg.target.registry.registry_value_data)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
