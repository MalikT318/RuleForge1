/*
  MITRE Technique : T1552.001 - Credentials In Files
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:45:01.245322+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_001_Credential_File_Transfer_External_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound HTTP POST or PUT to an external destination where the URL references a file type or name that commonly holds stored credentials (password databases, private keys, GPP Groups.xml, unattend/sysprep answer files, web.config, cloud credential files). This is the network-side view of credential-file collection and staging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.001"
    mitre_technique_name = "Unsecured Credentials: Credentials In Files"
    log_prerequisites = "Requires forward or explicit proxy, or TLS-inspecting firewall, logs that populate network.http.method and target.url. Without URL visibility the rule will not evaluate."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Users uploading password-manager databases or key files to approved backup or sync services; developers pushing config templates to external repositories; vendor support portals receiving web.config files for troubleshooting; sanctioned certificate or key enrollment services."
    tuning_guidance = "Add approved vendor and sync/backup domains to %global_allowed_domains. Internal destinations are already excluded via %rfc1918_internal. If a specific client has noisy file-sync tooling, add its destination domain to %global_allowed_domains for that client rather than loosening the URL regex."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.target.url = /(\/(groups\.xml|unattend\.xml|sysprep\.xml|web\.config|appsettings\.json|\.git-credentials|id_rsa|id_ed25519|\.?credentials|passwords?\.(txt|xlsx?|csv)|secrets?\.(json|ya?ml|txt))|\.(kdbx|kdb|ppk|pfx|rdg))([?#]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.001")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
