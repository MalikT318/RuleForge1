/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:45:30.956137+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_Process_Handle_Open_Injection_Host_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location (AppData, Temp, ProgramData, Public) that opens a handle to a commonly injected Windows host process. This handle request is the prerequisite for DLL injection (VirtualAllocEx, WriteProcessMemory, CreateRemoteThread). It works at the process-handle layer, so it does not depend on command-line logging."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires endpoint telemetry that records process handle access (EDR process-access events or Sysmon Event ID 10) normalised to PROCESS_OPEN, with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed software (collaboration clients, updaters, overlay or accessibility tools) that opens handles to explorer.exe. Unlisted EDR/AV agents or backup agents running from ProgramData. Game launchers and screen-capture utilities. Software installers staged in Temp."
    tuning_guidance = "Add EDR/AV agent paths to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and approved IT tooling to %global_allowed_admin_tools. Where a client has noisy per-user software, add its executable path to %global_allowed_admin_tools. The target process list can be narrowed or widened in the regex to suit the environment."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\\(users\\[^\\]+\\appdata\\|windows\\temp\\|programdata\\|users\\public\\|temp\\)/ nocase
    $open.target.process.file.full_path = /\\(explorer|svchost|winlogon|spoolsv|taskhostw|dllhost|runtimebroker|sihost|searchindexer|notepad|werfault)\.exe$/ nocase
    $open.principal.process.pid != $open.target.process.pid
    $open.principal.hostname != ""
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
