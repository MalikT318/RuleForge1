/*
  MITRE Technique : T1560 - Archive Collected Data
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:55:51.990119+00:00
  Reference       : https://attack.mitre.org/techniques/T1560
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_Linux_Staged_Archive_Then_External_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An archive or encrypted file is created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) by a compression or encryption utility. The same host then makes an outbound connection to a non-internal address from a transfer-capable process within 10 minutes. This pattern suggests collected data was packaged for exfiltration. The rule uses file-creation and network telemetry rather than command-line matching."
    mitre_tactic = "Collection"
    mitre_technique = "T1560"
    mitre_technique_name = "Archive Collected Data"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates FILE_CREATION (with the creating process path) and NETWORK_CONNECTION (with the originating process path and destination IP)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup jobs staging archives in /tmp before upload, admins moving log bundles to a support portal, CI/CD or build agents packaging artifacts, and software deployment tooling that downloads or uploads packages."
    tuning_guidance = "Add backup software to %global_allowed_backup_processes. Add approved transfer or deployment tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add known-good vendor destinations to %global_allowed_domains if domain telemetry is populated. If volume is high, narrow the staging directory regex or require the network process to match the archive creator's user."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(tar|tar\.gz|tgz|tar\.bz2|tbz2|tar\.xz|txz|zip|7z|rar|gz|bz2|xz|zst|gpg|enc|pgp)$/ nocase
    $file.principal.process.file.full_path = /\/(tar|gzip|pigz|bzip2|xz|zstd|zip|7z|7za|7zr|rar|gpg|gpg2|openssl)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|scp|sftp|ftp|nc|ncat|netcat|socat|rsync)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1560")
    $primary_entity = array_distinct($hostname)
    $archive_paths = array_distinct($file.target.file.full_path)
    $archive_tools = array_distinct($file.principal.process.file.full_path)
    $transfer_tools = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $archive_count = count($file.metadata.id)

  condition:
    $file and $net
}
