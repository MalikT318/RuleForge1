/*
  MITRE Technique : T1548.003 - Sudo and Sudo Caching
  Tactic(s)       : Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:33:25.367619+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_003_Sudoers_Repeated_Modification_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated modification of /etc/sudoers or files under /etc/sudoers.d/ on a single Linux host within ten minutes. A single sudoers change can be routine administration, but several in a short window suggest an adversary editing sudo policy (for example granting NOPASSWD rights or altering timestamp_timeout and tty_tickets) to elevate privileges or keep sudo access persistent."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.003"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Sudo and Sudo Caching"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules on /etc/sudoers and /etc/sudoers.d, normalised to FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management runs (Ansible, Puppet, Chef, Salt) pushing sudoers policy, provisioning and golden-image builds, package installs that drop files in /etc/sudoers.d, administrators making several edits with visudo during a maintenance window."
    tuning_guidance = "Add configuration management and deployment binaries to %global_allowed_admin_tools, add automation accounts to %global_allowed_service_accounts, and add named administrators to %global_allowed_admin_users. Raise the #file threshold on hosts under frequent automated change. Lower it to 2 for high-value servers."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/sudoers(\.d\/.+)?$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1548.003")
    $primary_entity = array_distinct($host)
    $modified_files = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)
    $acting_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 3
}
