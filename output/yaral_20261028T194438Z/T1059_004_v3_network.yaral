/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:11:30.601220+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_Network_Shell_Script_Download_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP request to an external destination for a shell script (.sh/.bash) made by a command-line downloader user agent (curl, wget, Busybox, fetch). This is the network-side footprint of an adversary staging a Unix shell payload on a Linux-based network device or embedded host. It is visible at the perimeter even when endpoint process telemetry is missing. Typical activity is a dropper pulling a stager script and piping it into sh."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires firewall or proxy logs with HTTP inspection (URL and user agent populated), normalised to UDM NETWORK_HTTP. HTTPS traffic must be decrypted for URL and user agent visibility."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Administrators or automation (config management, provisioning, firmware or bootstrap scripts) fetching install scripts with curl or wget. Vendor-hosted installer scripts for approved software. Authorised vulnerability scanners requesting script paths."
    tuning_guidance = "Add approved vendor and package-distribution domains to %global_allowed_domains. Add scanner source addresses to %global_allowed_scanners. Add approved automation or management source addresses to %global_allowed_mgmt_sources. Review principal.ip to identify the device making the request."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /(^|[^a-z])(curl|wget|busybox|fetch|libwww-perl|python-urllib)([^a-z]|$)/ nocase
    $http.target.url = /\.(sh|bash)(\?[^\/]*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
