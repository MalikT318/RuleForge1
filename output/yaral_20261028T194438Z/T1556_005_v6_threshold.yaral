/*
  MITRE Technique : T1556.005 - Reversible Encryption
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:22:03.019627+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_005_Reversible_Encryption_Policy_Template_Churn {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Repeated modification of the Group Policy security template (GptTmpl.inf) on a single host within ten minutes. This file holds the 'Store passwords using reversible encryption' (ClearTextPassword) setting. A single write is routine; repeated writes in a short window match an adversary iterating on password-policy settings to enable reversible encryption. This is file-write telemetry and does not depend on process command lines."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.005"
    mitre_technique_name = "Modify Authentication Process: Reversible Encryption"
    log_prerequisites = "Requires EDR or Sysmon file-modification telemetry (Sysmon Event ID 11/23 equivalent) with file path and initiating process populated, ideally on domain controllers and administrative workstations with SYSVOL access."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised Group Policy edits by domain admins (GPMC, Security Compliance Toolkit baseline imports), SYSVOL replication (DFSR) staging writes on domain controllers, security baseline deployment tooling, and GPO backup/restore operations."
    tuning_guidance = "Add approved GPO management and deployment binaries to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Raise the threshold on domain controllers where DFSR replication is noisy. Confirm any alert by inspecting the ClearTextPassword value in the modified template."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\policies\\\{[0-9a-f\-]{36}\}\\machine\\microsoft\\windows nt\\securitysettings\\gpttmpl\.inf$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|dfsrs)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1556.005")
    $primary_entity = array_distinct($host)
    $modified_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
