/*
  MITRE Technique : T1578.001 - Create Snapshot
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:51:07.390097+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_001_Cloud_Snapshot_Creation_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity creates or copies several compute or database snapshots within ten minutes. One snapshot is routine. A burst can mean an adversary is copying volumes so they can mount them on an attacker-controlled instance, bypassing restrictions on the original infrastructure and evading defenses."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.001"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Snapshot"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM RESOURCE_CREATION with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and disaster-recovery automation, snapshot lifecycle policies, infrastructure-as-code pipelines, migration projects, administrators preparing for maintenance or upgrades, and forensic or incident-response teams imaging volumes."
    tuning_guidance = "Add automation and backup identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise the #cloud threshold for tenants with heavy scheduled snapshotting. Lower it for high-value accounts. Review the snapshot_resources and source_ips outcome values to see whether the activity is unusual for the identity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(CreateSnapshot|CreateSnapshots|CopySnapshot|CreateDBSnapshot|CreateDBClusterSnapshot|snapshots\.insert|disks\.createSnapshot|snapshots\/write)/ nocase
    $cloud.principal.user.userid != ""
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1578.001")
    $primary_entity = array_distinct($user)
    $snapshot_resources = array_distinct($cloud.target.resource.name)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 5
}
