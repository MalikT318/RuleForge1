/*
  MITRE Technique : T1210 - Exploitation of Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:17:49.676748+00:00
  Reference       : https://attack.mitre.org/techniques/T1210
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1210_Firewall_Admin_Port_Fanout_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes a high volume of connections to Windows remote-service ports (SMB, RPC, RDP, WinRM, MSSQL) within 10 minutes. This fan-out pattern is typical of post-compromise scanning for vulnerable remote services, or of exploit attempts against them, before lateral movement. Each connection is benign on its own; the volume from one source is the signal."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1210"
    mitre_technique_name = "Exploitation of Remote Services"
    log_prerequisites = "Requires firewall or network perimeter logs that include east-west (internal) traffic, normalized to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Vulnerability scanners and asset discovery tools, RMM and patching servers, domain controllers and file servers replying to or serving many clients, backup servers, jump hosts and administrators managing many servers."
    tuning_guidance = "Add scanner sources to %global_allowed_scanners and management or jump hosts to %global_allowed_mgmt_sources. Raise the #net threshold in noisy environments, or lower it (for example to 15) for segmented networks. Review the distinct_targets and distinct_ports outcomes to separate a wide sweep from one chatty client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 135 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 1433
    )
    $net.principal.ip = $src
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 445 or $net.target.port = 3389, 70, 55))
    $mitre_technique_id = array_distinct("T1210")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $distinct_targets = array_distinct($net.target.ip)
    $distinct_ports = array_distinct($net.target.port)

  condition:
    #net >= 25
}
