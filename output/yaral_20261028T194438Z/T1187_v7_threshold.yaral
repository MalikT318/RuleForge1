/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:34:10.962918+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_Outbound_SMB_Volume_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single internal host makes repeated outbound SMB/NetBIOS session connections (TCP 445/139) to external addresses within ten minutes. A Windows client automatically sends NTLM credential material when it connects to an SMB share, so this pattern indicates forced authentication, for example a UNC link in a phishing document, a crafted shortcut, or a malicious icon path, pointing at an attacker-controlled server. A single connection can be benign. Repeated attempts from one host are not."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION events with principal.ip, target.ip and target.port populated. Egress SMB must be logged, whether allowed or denied, since attempted connections are the signal."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SMB access to cloud-hosted file services over VPN or private peering that appears as a public address, hybrid-cloud file shares, misconfigured clients retrying a stale external share, authorised external vulnerability scanners or security testing, and migration tooling."
    tuning_guidance = "Add authorised scanner or test source addresses to %global_allowed_scanners. If the tenant has approved external SMB endpoints, enrich the data upstream or adjust the threshold. Raise the #net threshold in noisy environments. Block egress TCP 445/139 at the perimeter so this rule becomes a pure indicator of attempted forced authentication."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.principal.ip = $src
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($src)
    $external_destinations = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 5
}
