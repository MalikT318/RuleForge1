/*
  MITRE Technique : T1671 - Cloud Application Integration
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:15:16.331039+00:00
  Reference       : https://attack.mitre.org/techniques/T1671
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1671_OAuth_App_Consent_Then_Credential_Added {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user granting consent or a delegated permission to an application and then adding credentials (secret or certificate) to an application or service principal within ten minutes. This sequence is a common way to build a persistent OAuth foothold that survives a password reset or account disablement."
    mitre_tactic = "Persistence"
    mitre_technique = "T1671"
    mitre_technique_name = "Cloud Application Integration"
    log_prerequisites = "Requires Microsoft 365 unified audit logs including Entra ID directory audit events (application consent, delegated permission grant, and application or service principal credential changes), ingested into UDM as SETTING_MODIFICATION with metadata.product_event_type populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Application owners and developers registering a new internal integration, IT onboarding of approved SaaS connectors, identity engineers rotating application secrets right after granting admin consent, and automated deployment pipelines running under a named admin account."
    tuning_guidance = "Add named administrators who legitimately onboard applications to %global_allowed_admin_users. Add automation identities to %global_allowed_service_accounts. Add approved integration principals to %global_allowed_cloud_principals. If a client uses different audit operation names, adjust the product_event_type regexes for that tenant. Consider raising severity when the actor is a privileged role holder or the sign-in comes from an unfamiliar source."

  events:
    $consent.metadata.event_type = "SETTING_MODIFICATION"
    $consent.metadata.product_event_type = /(consent to application|add delegated permission grant|add oauth2permissiongrant)/ nocase
    $consent.principal.user.userid = $user
    not $consent.principal.user.userid in %global_allowed_admin_users
    not $consent.principal.user.userid in %global_allowed_service_accounts
    not $consent.principal.user.userid in %global_allowed_cloud_principals

    $cred.metadata.event_type = "SETTING_MODIFICATION"
    $cred.metadata.product_event_type = /(add service principal credentials|update application.{0,6}certificates and secrets management|add password credential|add key credential)/ nocase
    $cred.principal.user.userid = $user
    not $cred.principal.user.userid in %global_allowed_admin_users
    not $cred.principal.user.userid in %global_allowed_service_accounts
    not $cred.principal.user.userid in %global_allowed_cloud_principals

    $consent.metadata.event_timestamp.seconds <= $cred.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1671")
    $primary_entity = array_distinct($user)
    $consent_operations = array_distinct($consent.metadata.product_event_type)
    $credential_operations = array_distinct($cred.metadata.product_event_type)
    $consented_resources = array_distinct($consent.target.resource.name)
    $credential_resources = array_distinct($cred.target.resource.name)
    $source_ips = array_distinct($consent.principal.ip)
    $first_seen = min($consent.metadata.event_timestamp.seconds)
    $last_seen = max($cred.metadata.event_timestamp.seconds)

  condition:
    $consent and $cred
}
