/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:48:35.792746+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Linux_Ccache_File_Access_Copy_Or_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process launch where a copy, archive, encoding, transfer or scripting utility is pointed at a Kerberos credential cache (ccache) file such as /tmp/krb5cc_<uid>, /var/tmp/krb5cc_*, or *.ccache. Adversaries stage or exfiltrate ccache files to replay the stolen tickets (Pass the Ticket) from another session or host. The rule keys on the combination of a file-handling utility and a ccache file reference in the command line, not on a specific attacker tool."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or support staff troubleshooting Kerberos authentication by copying or inspecting ccache files; backup and configuration-management agents sweeping /tmp or /var/tmp; Kerberised service wrappers or automation that relocates ccache files for batch jobs; developer testing of Kerberos-enabled applications."
    tuning_guidance = "Add approved admin and configuration-management binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and backup agents to %global_allowed_backup_processes. If a client uses KRB5CCNAME with a custom ccache naming scheme, extend the file-name regex accordingly for that tenant. Consider raising severity when the user is a privileged account or the host is a Kerberos-joined server."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(cp|mv|scp|rsync|tar|zip|gzip|base64|xxd|cat|dd|nc|ncat|socat|curl|wget|openssl|sftp|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(krb5cc_[0-9a-z_]*|\bkrb5\.ccache\b|\.ccache\b)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $utility_path = array_distinct($proc.target.process.file.full_path)
    $ccache_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
