/*
  MITRE Technique : T1219.002 - Remote Desktop Software
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:09:25.474926+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_002_Outbound_Remote_Desktop_Port_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host makes repeated outbound connections to external addresses on ports commonly used by remote desktop and remote support software (RDP, VNC, and common commercial remote support relay ports) within ten minutes. Each connection is benign on its own. Sustained volume suggests an established interactive remote access channel and may indicate misuse of legitimate desktop support software as command and control."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.002"
    mitre_technique_name = "Remote Access Software: Remote Desktop Software"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must be captured at the egress boundary so that internal-to-external traffic is visible. The Windows hosts of interest are identified by their source address."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved IT helpdesk or RMM tooling, vendor remote support sessions, administrators using outbound RDP or VNC to cloud-hosted servers, and users on sanctioned remote support tools."
    tuning_guidance = "Add approved helpdesk or RMM source hosts to %global_allowed_mgmt_sources. Add approved remote support destinations to %global_allowed_remote_mgmt. Raise the #net threshold in the condition for environments with heavy sanctioned remote support use, or lower it for high-security segments such as servers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5901 or
      $net.target.port = 5931 or
      $net.target.port = 5938 or
      $net.target.port = 6568 or
      $net.target.port = 7070
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_remote_mgmt
    $net.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 3389, 80, 65))
    $mitre_technique_id = array_distinct("T1219.002")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
