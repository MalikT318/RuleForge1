/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:43:36.872071+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_Linux_Web_Content_Modification_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single external source issues repeated successful content-modifying HTTP requests (PUT, MOVE, COPY, PROPPATCH) against web page or image resources within 10 minutes. This is the network-observable result of web content defacement on Linux-hosted web servers. A single publish request is benign, but a burst of successful writes to page and image resources from one source is not."
    mitre_tactic = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "Requires forward proxy, reverse proxy, WAF, or perimeter firewall logs with TLS inspection that populate network.http.method, target.url, and network.http.response_code as NETWORK_HTTP events. Firewalls that cannot see the HTTP layer will not generate matches."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised WebDAV or CMS publishing from external contractors or SaaS deployment services, external CI/CD pipelines pushing static site content, web-hosting customers uploading files to shared hosting, and vulnerability or penetration-test sources that have not been allowlisted."
    tuning_guidance = "Add approved external publishing sources and authorised testers to %global_allowed_scanners and %global_allowed_mgmt_sources. Raise the #http threshold for busy hosting or CMS environments. Narrow the target.url regex to the content types that matter for the client. Correlate hits with host-side file modification telemetry on the target web server."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(PUT|MOVE|COPY|PROPPATCH)$/ nocase
    $http.target.url = /\.(html?|php|aspx?|jsp|jpe?g|png|gif|svg|css|js)(\?.*)?$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    $http.principal.ip = $src
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct($src)
    $event_count = count($http.metadata.id)
    $targeted_hosts = array_distinct($http.target.hostname)
    $targeted_urls = array_distinct($http.target.url)

  condition:
    #http >= 5
}
