/*
  MITRE Technique : T1573.001 - Symmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:22:33.746100+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_001_ESXi_SSH_Daemon_Config_Modified_For_Tunnel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the SSH daemon or SSH client configuration files on an ESXi host. Attackers alter these files to enable TCP forwarding, gateway ports or relaxed session settings so they can tunnel command-and-control traffic inside an SSH session, which is encrypted with a symmetric cipher. Detection is at the file-artifact layer, so it still fires when command-line logging is evaded or the shell history is wiped."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.001"
    mitre_technique_name = "Encrypted Channel: Symmetric Cryptography"
    log_prerequisites = "ESXi host file-integrity or shell audit telemetry normalised to UDM FILE_MODIFICATION events with target.file.full_path populated, forwarded to Chronicle."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised administrators hardening or changing SSH settings, host profile or configuration-management remediation, post-patch or upgrade scripts that rewrite the SSH configuration, and approved security baselining tools."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and configuration-management or patching binaries to %global_allowed_admin_tools. Correlate with change tickets. Alerts outside maintenance windows warrant escalation."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/ssh\/(sshd_config|ssh_config)(\.d\/[^\/]+)?$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1573.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $actor = array_distinct($file.principal.user.userid)
    $actor_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
