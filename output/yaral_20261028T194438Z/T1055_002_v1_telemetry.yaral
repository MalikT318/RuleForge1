/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:47:14.794962+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_Untrusted_Path_Process_Handle_To_Injection_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location (user profile, temp, downloads, public) opening a handle to a different, commonly abused Windows host process such as explorer, svchost or notepad. This is the handle-acquisition step that precedes PE injection (VirtualAllocEx, WriteProcessMemory, CreateRemoteThread). The rule works on the process-handle telemetry layer, so it is independent of command-line logging and of the injector's filename."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires endpoint telemetry that records process handle requests (EDR process-access events or Sysmon Event ID 10), normalised to PROCESS_OPEN with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed software that legitimately interacts with shell or host processes (collaboration clients, updaters, screen-capture or accessibility tools, game overlays), software installers and uninstallers run from Temp or Downloads, and developer debugging tools running from a profile directory."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools, imaging and backup software to %global_allowed_backup_processes, and IT tooling or RMM agents to %global_allowed_admin_tools. If a client has per-user software that fires repeatedly, add its executable path to %global_allowed_admin_tools after review. Adjust the target host process list or the source path regex per client where needed."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.hostname != ""
    $open.principal.process.file.full_path = /(?i)(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\windows\\temp\\|\\users\\public\\|\\\$recycle\.bin\\)/
    $open.target.process.file.full_path = /\\(explorer|svchost|notepad|rundll32|dllhost|taskhostw|sihost|runtimebroker|spoolsv|searchindexer|werfault|wuauclt|msiexec)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCnProxy|NisSrv)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $source_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
