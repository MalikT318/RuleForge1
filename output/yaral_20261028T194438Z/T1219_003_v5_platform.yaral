/*
  MITRE Technique : T1219.003 - Remote Access Hardware
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:11:07.160354+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_003_New_HID_Device_Registry_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects first-time creation of a USB HID (keyboard/mouse) device instance under the Windows Enum\\HID registry hive. IP-KVM devices (for example PiKVM or TinyPilot-class hardware) enumerate to the host as USB HID input devices, so a new HID instance on a host that should not be gaining input hardware is a host-side artifact of remote access hardware being attached. Per the task's mandatory platform requirement this rule is written for Windows registry telemetry and not for the alternate-platform angle. It deliberately avoids PROCESS_LAUNCH command-line logic. No vendor or device identifiers are hardcoded, so it triggers on any new HID VID/PID pair."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.003"
    mitre_technique_name = "Remote Access Software: Remote Access Hardware"
    log_prerequisites = "Requires Windows endpoint registry-creation telemetry covering HKLM\\SYSTEM\\CurrentControlSet\\Enum\\HID (EDR registry events or Sysmon Event ID 12/13). Many EDR agents filter PnP enumeration keys by default, so confirm collection."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate new keyboards, mice, headsets, gaming peripherals, docking stations, and barcode scanners on user workstations; new hardware imaging or provisioning; USB KVM switches; approved admin out-of-band KVM; virtual machines and RDP/VDI sessions, which create virtual HID devices on first connection."
    tuning_guidance = "Scope deployment to servers, jump hosts, and high-value or locked-down endpoints where new input hardware is unexpected. Add device-provisioning and imaging tooling to %global_allowed_admin_tools. Add approved remote-management tooling to %global_allowed_remote_mgmt. Consider enabling only for hosts outside standard user-workstation groups. Baseline noisy VID/PID pairs per client before raising severity."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /\\Enum\\HID\\VID_[0-9a-f]{4}&PID_[0-9a-f]{4}/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1219.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $device_registry_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
