/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:14:42.744963+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_Office_Remote_Template_Cached_To_INetCache {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application writing a macro-capable or template-type file into the user's INetCache. This is the on-disk result of Office fetching a remote document template (attachedTemplate relationship) over HTTP/WebDAV when a document is opened, which is the core outcome of OOXML template injection. The rule matches the behaviour and the file type, not a specific URL, payload or tool."
    mitre_tactic = "Defense Evasion (Stealth), Credential Access"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates the creating process path and the target file path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users opening documents that legitimately reference templates hosted on SharePoint, OneDrive or corporate intranet sites; Office online template galleries; macro-enabled documents opened from web links; document management systems that distribute .dotm templates."
    tuning_guidance = "Add named administrator or template-publisher accounts to %global_allowed_admin_users. If an organisation uses centrally hosted .dotm templates, restrict the target path further or allowlist the affected hosts. Consider raising severity when the same host also shows an Office process spawning a shell."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt)\.exe$/ nocase
    $file.target.file.full_path = /\\AppData\\Local\\Microsoft\\Windows\\INetCache\\.*\.(dotm|dotx|dot|docm|xlsm|xltm|xlam|potm|ppam)$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $office_process = array_distinct($file.principal.process.file.full_path)
    $cached_template = array_distinct($file.target.file.full_path)

  condition:
    $file
}
