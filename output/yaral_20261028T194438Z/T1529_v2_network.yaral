/*
  MITRE Technique : T1529 - System Shutdown/Reboot
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:28:52.405852+00:00
  Reference       : https://attack.mitre.org/techniques/T1529
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1529_External_Access_To_Network_Device_Mgmt_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a connection from an external (non-internal) source to a network device management-plane port (SSH, Telnet, NETCONF over SSH, SNMP). Remote CLI or management access is the precondition for an adversary issuing a remote reload or shutdown of a network device. A perimeter firewall cannot see the reload command itself, so this rule flags the network-observable access path to the management plane from outside the trusted address space."
    mitre_tactic = "Impact"
    mitre_technique = "T1529"
    mitre_technique_name = "System Shutdown/Reboot"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Management interfaces of network devices must sit on a path that the logging firewall observes."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Remote administration by the MSSP or customer staff over the internet or VPN egress addresses, third-party vendor support sessions, external vulnerability scanners probing management ports, SNMP monitoring from a cloud-hosted NMS, and internet-wide scanning noise against exposed management ports (which is itself an exposure finding)."
    tuning_guidance = "Add approved administration source addresses to %global_allowed_mgmt_sources, authorised scanners to %global_allowed_scanners, and extend %rfc1918_internal if the tenant uses additional internal ranges. Alert on this rule together with any management-plane SETTING_MODIFICATION or reload events from the device syslog. Management ports should not be reachable from the internet, so confirmed hits usually warrant a firewall policy fix."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 830 or
      $net.target.port = 161
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1529")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
