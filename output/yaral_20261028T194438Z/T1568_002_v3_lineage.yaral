/*
  MITRE Technique : T1568.002 - Domain Generation Algorithms
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:06:09.857187+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_002_Linux_Service_Parent_Spawns_DGA_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internet-facing service or database process (web server, application runtime, database) spawning a shell, script interpreter or DNS resolver utility whose arguments combine hostname resolution with dynamic name-generation primitives (random values, date/time, hashing, loops). Server-side processes do not normally launch resolvers that build lookup names on the fly, so this lineage anomaly is a strong indicator of a webshell or implant running a DGA-style fallback C2 lookup routine."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.002"
    mitre_technique_name = "Dynamic Resolution: Domain Generation Algorithms"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates both parent (principal.process) and child (target.process) executable paths and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application health-check or monitoring scripts launched by a web or application server that loop over hostnames; Java or Node.js applications shelling out to dig or nslookup for diagnostics; database maintenance jobs performing DNS checks; developer or QA hosts running DNS test harnesses."
    tuning_guidance = "Add approved parent runtimes or hosts to %global_allowed_script_hosts and approved diagnostic or monitoring binaries to %global_allowed_admin_tools. If java or node parents are noisy in the environment, scope the exclusion by the specific wrapper binary path rather than removing the parent from the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|ruby|php[0-9.]*|dig|nslookup|host|getent|resolvectl|drill)$/ nocase
    (
      $proc.target.process.command_line = /\b(dig|nslookup|host|drill|resolvectl|getent\s+hosts)\b.*(\$RANDOM|\$\(\s*date|`\s*date|md5sum|sha1sum|sha256sum|base64|openssl\s+rand|\/dev\/urandom|\bfor\s+\w+\s+in\b|\bwhile\b)/ nocase or
      $proc.target.process.command_line = /(gethostbyname|getaddrinfo|dns\.resolver|Resolver\(\)).*(random|hashlib|md5|sha256|datetime|strftime|time\.time|rand\()/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1568.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
