/*
  MITRE Technique : T1070.009 - Clear Persistence
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:12:24.605066+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_009_Linux_Persistence_File_Created_Then_Deleted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux persistence artifact (cron entry, systemd unit, init script, rc.local, profile.d script or XDG autostart entry) that is created and then deleted at the same path on the same host within 10 minutes. This pattern indicates an implant that installed persistence and then cleaned it up to remove evidence. It is file-telemetry based and does not rely on process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.009"
    mitre_technique_name = "Indicator Removal: Clear Persistence"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that produces FILE_CREATION and FILE_DELETION events with principal.hostname, target.file.full_path and the acting process populated. Watches on /etc/cron*, /var/spool/cron, systemd unit directories, /etc/init.d, /etc/rc.local, /etc/profile.d and /etc/xdg/autostart are required if using auditd."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers installing and removing services, configuration management agents (Ansible, Puppet, Chef, Salt) rendering and removing units or cron files, temporary systemd units from deployment scripts, container or image build processes, and admins testing a service or cron job."
    tuning_guidance = "Add approved deployment and configuration management binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add approved script-running parents to %global_allowed_script_hosts. Narrow the path regex to the persistence locations relevant to the client."

  events:
    $file_create.metadata.event_type = "FILE_CREATION"
    $file_create.target.file.full_path = /^\/(etc\/cron\.(d|hourly|daily|weekly|monthly)\/|etc\/cron\.allow$|var\/spool\/cron\/|etc\/systemd\/system\/|usr\/lib\/systemd\/system\/|lib\/systemd\/system\/|etc\/init\.d\/|etc\/rc\.local$|etc\/profile\.d\/|etc\/xdg\/autostart\/|home\/[^\/]+\/\.config\/systemd\/user\/|home\/[^\/]+\/\.config\/autostart\/)/ nocase
    $file_create.principal.hostname = $hostname
    $file_create.target.file.full_path = $path
    not $file_create.principal.process.file.full_path in %global_allowed_admin_tools
    not $file_create.principal.user.userid in %global_allowed_service_accounts
    not $file_create.principal.process.file.full_path in %global_allowed_script_hosts
    not $file_create.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|snapd|packagekitd)$/ nocase

    $file_del.metadata.event_type = "FILE_DELETION"
    $file_del.target.file.full_path = /^\/(etc\/cron\.(d|hourly|daily|weekly|monthly)\/|etc\/cron\.allow$|var\/spool\/cron\/|etc\/systemd\/system\/|usr\/lib\/systemd\/system\/|lib\/systemd\/system\/|etc\/init\.d\/|etc\/rc\.local$|etc\/profile\.d\/|etc\/xdg\/autostart\/|home\/[^\/]+\/\.config\/systemd\/user\/|home\/[^\/]+\/\.config\/autostart\/)/ nocase
    $file_del.principal.hostname = $hostname
    $file_del.target.file.full_path = $path
    not $file_del.principal.process.file.full_path in %global_allowed_admin_tools
    not $file_del.principal.user.userid in %global_allowed_service_accounts
    not $file_del.principal.process.file.full_path in %global_allowed_script_hosts
    not $file_del.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|snapd|packagekitd)$/ nocase

    $file_create.metadata.event_timestamp.seconds <= $file_del.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070.009")
    $primary_entity = array_distinct($file_del.principal.hostname)
    $persistence_path = array_distinct($file_del.target.file.full_path)
    $creating_process = array_distinct($file_create.principal.process.file.full_path)
    $deleting_process = array_distinct($file_del.principal.process.file.full_path)
    $deleting_user = array_distinct($file_del.principal.user.userid)
    $first_created = min($file_create.metadata.event_timestamp.seconds)
    $last_deleted = max($file_del.metadata.event_timestamp.seconds)

  condition:
    $file_create and $file_del
}
