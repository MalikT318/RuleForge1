/*
  MITRE Technique : T1559 - Inter-Process Communication
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:49:59.660473+00:00
  Reference       : https://attack.mitre.org/techniques/T1559
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_IPC_Host_Process_Spawns_Shell_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application or a COM/DCOM host process (mmc.exe, dllhost.exe) launching a command shell or script interpreter. This is the typical result of abusing DDE, COM or DCOM for local or remote code execution, and these parents do not normally spawn interpreters."
    mitre_tactic = "Execution"
    mitre_technique = "T1559"
    mitre_technique_name = "Inter-Process Communication"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent and child process paths (EDR, Sysmon Event ID 1, or Security Event 4688 with process creation auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins used by line-of-business workflows that call cmd or PowerShell, finance or reporting spreadsheets with legitimate DDE or shell calls, MMC snap-ins that launch consoles for admins, and software installers or helper tools hosted by dllhost.exe (COM surrogate)."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved admin or deployment tooling to %global_allowed_admin_tools. Where a business workflow legitimately spawns interpreters from Office, add its parent path to %global_allowed_script_hosts and narrow the child pattern per client. Consider also excluding trusted automation accounts via %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|mmc|dllhost)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1559")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
