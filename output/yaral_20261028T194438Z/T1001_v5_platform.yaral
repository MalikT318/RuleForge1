/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:04:53.795270+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_HTTP_Protocol_Impersonation_IP_Literal_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP POST requests seen at the perimeter that go to a raw IP-literal URL on a non-standard port. This is a common pattern for C2 traffic disguised as web traffic (T1001 protocol impersonation). The rule uses only network-observable fields, so it applies to Windows client egress without needing endpoint process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection, normalised to UDM NETWORK_HTTP with network.http.method, target.url, target.port and target.ip populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internal-facing or vendor appliances reached by IP, software update or telemetry agents that use IP-literal endpoints, developer or test web servers on custom ports, IoT or OT management interfaces, and cloud APIs on custom ports."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Review %rfc1918_internal for completeness. For noisy hosts, widen the port exclusions or add a hostname exclusion using an approved list. Raise severity if the same source repeats the pattern against several destinations."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}:\d{2,5}(\/|\?|$)/ nocase
    $net.target.port != 80
    $net.target.port != 443
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $request_urls = array_distinct($net.target.url)

  condition:
    $net
}
