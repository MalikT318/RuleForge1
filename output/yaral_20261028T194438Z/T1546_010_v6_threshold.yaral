/*
  MITRE Technique : T1546.010 - AppInit DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:14:19.055157+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_010_AppInit_DLLs_Registry_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of registry writes to the AppInit_DLLs, LoadAppInit_DLLs or RequireSignedAppInit_DLLs values under the Windows NT CurrentVersion Windows key (native or Wow6432Node) on a single host within ten minutes. A single write may be benign, but repeated writes to these values indicate an attacker registering a DLL, enabling AppInit loading, and/or disabling signature enforcement to persist or escalate privileges."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.010"
    mitre_technique_name = "Event Triggered Execution: AppInit DLLs"
    log_prerequisites = "Requires EDR or Sysmon-equivalent registry telemetry (Sysmon Event IDs 12/13, or EDR registry modification events) normalised to UDM REGISTRY_MODIFICATION with registry key and value name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy accessibility, screen-reader or overlay software that still uses AppInit_DLLs; older application-compatibility, GPU or input-device utilities during install or upgrade; software deployment tools and golden-image build scripts; administrators toggling the AppInit settings during troubleshooting."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and change-management accounts to %global_allowed_admin_users. Raise the #reg threshold for estates with known legacy AppInit software, or lower it to 2 for high-security tiers. Note that single writes are deliberately not alerted on by this rule."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Windows NT\\CurrentVersion\\Windows(\\|$)/ nocase
    $reg.target.registry.registry_value_name = /^(AppInit_DLLs|LoadAppInit_DLLs|RequireSignedAppInit_DLLs)$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1546.010")
    $primary_entity = array_distinct($host)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
