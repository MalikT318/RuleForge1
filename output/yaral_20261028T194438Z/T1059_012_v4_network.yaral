/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:24:40.094834+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Shell_CLI_Outbound_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host shell or hypervisor CLI process (esxcli, vim-cmd) or a native transfer or remote-shell utility (wget, curl, nc, ssh, scp, python, openssl) opening a network connection to an external address. Hypervisor CLIs normally talk only to local management services. External connections from these processes suggest payload staging, reverse shells, or exfiltration from a compromised hypervisor. This is a network-side detection and complements process command-line rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "ESXi network connection telemetry (for example firewall or connection logging forwarded from the host, or an agent that attributes sockets to processes) with principal.process.file.full_path populated. Hosts must be tagged or identifiable by principal.hostname."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators downloading patches, VIBs, or ISOs with wget or curl; approved backup or monitoring scripts using python or curl; scp or ssh to approved external jump hosts; vendor support sessions; hosts using external NTP, syslog, or update repositories reached via these tools."
    tuning_guidance = "Add approved admin tooling process paths to %global_allowed_admin_tools. Add approved management or jump host addresses to %global_allowed_mgmt_sources. Add known update or vendor domains to %global_allowed_domains. Add loopback and link-local addresses to %rfc1918_internal if local esxcli traffic appears in the results. Narrow or extend the process regex to match client binaries."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(esxcli|vim-cmd|wget|curl|nc|ncat|netcat|python|python3|ssh|scp|openssl)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
