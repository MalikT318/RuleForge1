/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:23:52.889518+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_AddIn_File_Drop_Then_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects Office add-in persistence: an add-in payload file (XLL/WLL/XLAM/XLA/PPAM/VSTO) is written to a per-user Office AddIns, Word STARTUP or Excel XLSTART folder, then the same host registers it for load at Office startup through an Office Addins key (LoadBehavior/Manifest) or an Options OPEN value, all within 10 minutes. The file and registry artefacts come from the Windows endpoint hosting the Office client, because add-in persistence is configured locally rather than in cloud audit logs."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires Windows endpoint telemetry (EDR or Sysmon) that populates FILE_CREATION (Sysmon EID 11) and REGISTRY_MODIFICATION (Sysmon EID 13) with principal.hostname, target.file.full_path, target.registry.registry_key and target.registry.registry_value_name. Microsoft 365 and Google Workspace audit logs do not carry these artefacts and cannot satisfy this rule."
    platform = "Office Suite"
    log_source = "windows_endpoint"
    false_positives = "Legitimate add-in deployment by IT (Analysis ToolPak, finance or ERP Excel add-ins, CRM and e-signature Outlook add-ins), Office Click-to-Run updates and repairs, software deployment agents, and power users installing a trusted add-in."
    tuning_guidance = "Add approved deployment tooling to %global_allowed_admin_tools, trusted installer or admin accounts to %global_allowed_admin_users, and approved add-in rollout hosts to %global_allowed_script_hosts. If a vendor add-in is noisy, extend the installer-name regex rather than allowlisting install directories."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\Microsoft\\(AddIns|Word\\STARTUP|Excel\\XLSTART)\\[^\\]+\.(xll|wll|xlam|xla|ppam|ppa|vsto)$/ nocase
    not $file.principal.process.file.full_path = /\\(OfficeClickToRun|OfficeC2RClient|setup|msiexec|TrustedInstaller)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Office\\([0-9.]+\\)?(Excel|Word|PowerPoint|Outlook)\\(Addins\\[^\\]+|Options)$/ nocase
    $reg.target.registry.registry_value_name = /^(LoadBehavior|Manifest|OPEN[0-9]*)$/ nocase
    not $reg.principal.process.file.full_path = /\\(OfficeClickToRun|OfficeC2RClient|setup|msiexec|TrustedInstaller)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($hostname)
    $addin_files = array_distinct($file.target.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $users = array_distinct($reg.principal.user.userid)
    $writer_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $file and $reg
}
