/*
  MITRE Technique : T1564.007 - VBA Stomping
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:24:55.835112+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_007_Office_Process_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Microsoft Office application process opening an outbound network connection to an external address that is not on the known-good domain list. VBA stomping hides malicious source code while the compiled p-code still runs, so the macro's network activity is often the only observable artefact. This rule watches for that network behaviour from the Office process itself, such as a payload download or C2 beacon, rather than command-line or document content. It is additive to process-creation rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.007"
    mitre_technique_name = "Hide Artifacts: VBA Stomping"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Normal Office cloud traffic (licensing, telemetry, OneDrive/SharePoint co-authoring, add-in stores, online templates and images, linked or external workbook data connections), and Office add-ins that call vendor APIs."
    tuning_guidance = "Populate %global_allowed_domains with Microsoft 365 and approved SaaS or add-in domains for each client. Add approved security agents to %global_allowed_security_tools and approved admin tooling to %global_allowed_admin_tools. Raise severity when the destination has no hostname (raw IP) or the port is not 80/443, and correlate with endpoint alerts for the same host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(winword|excel|powerpnt|msaccess|mspub|visio)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1564.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $office_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
