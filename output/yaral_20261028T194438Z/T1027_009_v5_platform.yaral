/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:52:38.854360+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_Linux_Decoder_Drops_Payload_To_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a decoding or unpacking utility (base64, xxd, uudecode, openssl, dd, decompressors) writing a file into /dev/shm or a hidden file under /tmp or /var/tmp. This is the typical Linux pattern for extracting a payload embedded in a script or binary, such as self-extracting shell stubs or a base64 blob appended to a benign file. It is file-creation based and complements command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write events with the writing process populated (principal.process.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-extracting software installers, package or build tooling that unpacks to /tmp, backup and imaging utilities, admin scripts that decode base64 configs, CI runners."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools and backup software to %global_allowed_backup_processes. Add automation accounts to %global_allowed_service_accounts. Build or CI hosts may need a per-client exclusion."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(base64|basenc|xxd|uudecode|openssl|dd|gunzip|zcat|unxz|xzcat|bunzip2)$/ nocase
    $file.target.file.full_path = /^(\/dev\/shm\/.+|\/(var\/)?tmp\/([^\/]+\/)*\.[^\/]+)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
