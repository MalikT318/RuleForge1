/*
  MITRE Technique : T1012 - Query Registry
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:24:50.059965+00:00
  Reference       : https://attack.mitre.org/techniques/T1012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1012_Registry_Hive_File_Direct_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-system, non-allowlisted process reading registry hive files from disk or from a volume shadow copy (SOFTWARE, SYSTEM, DEFAULT, NTUSER.DAT, UsrClass.dat, Amcache.hve). This is offline registry querying that bypasses the Registry APIs and reg.exe, so command-line detections for T1012 do not see it. It complements existing process-creation coverage with file-access telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1012"
    mitre_technique_name = "Query Registry"
    log_prerequisites = "Requires endpoint telemetry that records file read or access events (EDR file-access telemetry or Sysmon-equivalent file access auditing) mapped to the UDM FILE_READ event type, with principal.process.file.full_path and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, forensic and DFIR collection tools, endpoint inventory and compliance scanners, profile migration utilities, and search indexers or antivirus engines not yet in the allowlists."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes, EDR/AV engines to %global_allowed_security_tools, and inventory or deployment tooling to %global_allowed_admin_tools. Extend the OS component executable-name exclusion if specific Windows servicing processes are noisy in a client environment."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\(windows\\system32\\config\\(software|system|default)|ntuser\.dat|usrclass\.dat|amcache\.hve)$/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|TiWorker|vssvc|wbengine|smss|wininit|services|csrss|winlogon|SearchIndexer)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1012")
    $primary_entity = array_distinct($file.principal.hostname)
    $hive_paths = array_distinct($file.target.file.full_path)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
