/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:05:27.472681+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Root_Cert_Store_Registry_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write of a certificate blob into the Windows Trusted Root Certification Authorities store (machine, user, or policy-deployed). This catches root certificate installs made through CryptoAPI, .NET X509Store, or direct registry edits, which do not depend on certutil or PowerShell command-line patterns. Windows variant that pivots on the store's registry mechanism rather than process command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon Event ID 12/13) that populates target.registry.registry_key, registry_value_name and the writing process path. The registry monitoring policy must cover HKLM and HKU SystemCertificates keys."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise PKI and Group Policy root distribution, MDM or device-enrolment agents, corporate TLS-inspection proxy agents, VPN and ZTNA clients that install their own CA, developer tooling that installs local dev CAs, OS feature updates, and software installers that add a vendor root."
    tuning_guidance = "Add approved deployment and MDM agent binaries to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. The System32 svchost.exe exclusion covers the Windows root program update and Group Policy client; remove it if clients want those writes reviewed. Raise severity for non-privileged user contexts or when the writing process runs from a user-writable path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SystemCertificates\\Root\\Certificates\\/ nocase
    $reg.target.registry.registry_value_name = /^blob$/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\System32\\svchost\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $writing_command_line = array_distinct($reg.principal.process.command_line)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
