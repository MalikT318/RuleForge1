/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:24:20.094069+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_Evtx_Log_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of Windows Event Log (.evtx) files from the winevt\\Logs directory by a process other than the Windows service host. Adversaries delete the stored log files directly to clear event logs and bypass wevtutil, Clear-EventLog and other command-line based detections. Because it keys on file-deletion telemetry rather than process command lines, it is additive to process-creation rules."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires endpoint file-deletion telemetry (EDR file events or Sysmon Event ID 23/26) with the target file path and initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup or imaging software pruning archived logs, endpoint security agents, log-forwarding and log-rotation utilities, administrators clearing logs during image preparation or sysprep, and golden-image build pipelines."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, log-management and IT tooling to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Add build or imaging service accounts to %global_allowed_service_accounts. If the Windows service host rotates archived logs in your estate, the built-in svchost exclusion already covers it."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /\\winevt\\logs\\[^\\]+\.evtx$/ nocase
    not $file.principal.process.file.full_path = /\\windows\\system32\\svchost\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_log_files = array_distinct($file.target.file.full_path)
    $deleting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
