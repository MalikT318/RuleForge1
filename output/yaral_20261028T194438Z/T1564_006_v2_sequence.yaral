/*
  MITRE Technique : T1564.006 - Run Virtual Instance
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:22:37.581828+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_006_VM_Artifact_Dropped_Then_Hypervisor_Launched {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A virtual disk, VM configuration, or Windows Sandbox (.wsb) file is written to a user-writable location by a non-approved process, and a hypervisor or emulator engine process starts on the same host within 10 minutes. This pattern indicates an adversary staging and running a virtual instance to hide activity from host-based security tooling. It complements command-line detections by correlating file-drop and engine-start telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.006"
    mitre_technique_name = "Hide Artifacts: Run Virtual Instance"
    log_prerequisites = "Requires Windows endpoint telemetry that populates FILE_CREATION (target.file.full_path, principal.process) and PROCESS_LAUNCH (target.process.file.full_path), for example EDR or Sysmon events 1 and 11."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers, QA and lab users who legitimately download or create VM images and run VirtualBox, QEMU or VMware Workstation. Windows Sandbox used by security analysts. Hyper-V administrators creating VHDX files in user profile or Public paths. Software packaging pipelines that unpack appliance images."
    tuning_guidance = "Add approved virtualization tooling and image-management processes to %global_allowed_admin_tools. Add developer and analyst accounts to %global_allowed_admin_users. Add lab hosts or sanctioned parent processes to %global_allowed_script_hosts. If Hyper-V is sanctioned, widen the file path exclusions or restrict the rule to non-server assets."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|windows\\temp|temp|programdata)\\.*\.(vhdx?|vdi|vmdk|qcow2?|wsb|ova|ovf)$/ nocase
    not $file.principal.process.file.full_path = /\\(vmms|vmwp|msiexec|TrustedInstaller|TiWorker)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_admin_users
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(WindowsSandbox|WindowsSandboxClient|WindowsSandboxRemoteSession|VBoxHeadless|VirtualBoxVM|VBoxManage|vmware-vmx|vmrun|qemu-system-[a-z0-9_]+)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.006")
    $primary_entity = array_distinct($hostname)
    $dropped_vm_files = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $hypervisor_processes = array_distinct($proc.target.process.file.full_path)
    $launching_parents = array_distinct($proc.principal.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)
    $file_event_count = count($file.metadata.id)

  condition:
    $file and $proc
}
