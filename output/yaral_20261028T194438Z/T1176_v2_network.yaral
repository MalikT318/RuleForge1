/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:24:41.913304+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_Extension_Package_Download_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request through a proxy or firewall for a browser or IDE extension package (.crx, .xpi, .vsix) from an external host outside the known-good domain list. Off-marketplace or direct-download extension packages are a common way to side-load a persistent malicious extension. This is a network-side view and does not depend on endpoint process telemetry."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Requires proxy or firewall logs with URL-level visibility (TLS inspection or explicit proxy) normalised to UDM NETWORK_HTTP with target.url and target.hostname populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers and IT staff installing approved browser or IDE extensions, enterprise extension deployment from internal or vendor-hosted repositories, security teams analysing extensions, and automated update checks that fetch extension packages from a CDN not yet on the allowlist."
    tuning_guidance = "Add approved extension marketplaces, vendor CDNs and internal artifact repositories to %global_allowed_domains. Add the proxy addresses of developer or lab segments to %global_allowed_mgmt_sources if they need a separate exception. Raise severity for hosts that are not in developer or IT groups. Without TLS inspection only the hostname is visible, so this rule will not fire on HTTPS traffic."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(crx|xpi|vsix)([?#].*)?$/ nocase
    $http.principal.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity = array_distinct($http.principal.hostname)
    $extension_urls = array_distinct($http.target.url)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
