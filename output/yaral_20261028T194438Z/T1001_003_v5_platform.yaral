/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:10:46.330477+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_Linux_Cleartext_HTTP_On_TLS_Port_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "IPS/network security telemetry shows cleartext HTTP (a parsed HTTP method) sent to an external host on a TLS port (443/8443) by a client with a Linux or command-line user agent. Legitimate traffic to these ports is TLS-encrypted, so cleartext HTTP there suggests a fake TLS channel or HTTP-based C2 disguised as HTTPS. This is a Linux-focused variant of protocol impersonation (T1001.003); Windows endpoint coverage is assumed to exist separately."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "IPS/IDS or network security appliance logs with HTTP protocol decoding mapped to UDM NETWORK_HTTP, populating network.http.method, network.http.user_agent, target.port and target.ip. The sensor must see traffic before or without TLS decryption and must not parse HTTP from decrypted TLS sessions as plaintext on the TLS port."
    platform = "Linux"
    log_source = "ips"
    false_positives = "TLS-inspecting proxies or decrypting IPS that log decrypted HTTP against port 443; misconfigured internal applications serving plaintext HTTP on 443/8443; vulnerability scanners and authorised pentest tools; developer or DevOps scripts (curl, wget, python) testing non-TLS services on TLS ports; health-check agents."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners, known-good destination domains to %global_allowed_domains, and approved management sources to %global_allowed_mgmt_sources. If the sensor decrypts TLS and reports the inner HTTP, exclude those sensor or proxy sources or remove the port condition for those clients. Add further TLS ports (for example 9443) by extending the port comparison."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.application_protocol = "HTTP"
    $net.network.http.method = /^(GET|POST|PUT|HEAD|OPTIONS|PATCH)$/ nocase
    ($net.target.port = 443 or $net.target.port = 8443)
    $net.network.http.user_agent = /(X11;.*Linux|Linux (x86_64|aarch64|i686)|^curl\/|^wget\/|python-requests|python-urllib|^go-http-client|libwww-perl)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
