/*
  MITRE Technique : T1652 - Device Driver Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:55:44.631129+00:00
  Reference       : https://attack.mitre.org/techniques/T1652
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1652_Driver_Enumeration_Via_WMI_Pnputil_SC_Fltmc {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects local device driver enumeration through built-in Windows mechanisms other than driverquery: WMI/CIM driver classes (Win32_SystemDriver, Win32_PnPSignedDriver), Get-WindowsDriver -Online, pnputil driver enumeration, sc.exe queries filtered to driver service types, and fltmc minifilter listing. Adversaries use these to identify security tooling (minifilter drivers), virtualization drivers, and vulnerable drivers before follow-on actions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1652"
    mitre_technique_name = "Device Driver Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and asset-management scripts, RMM health checks, driver and patch deployment tooling, hardware vendor update utilities, helpdesk staff troubleshooting driver or filter-driver problems, backup and AV agents checking minifilter state."
    tuning_guidance = "Add approved inventory, RMM and patching binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and named administrators to %global_allowed_admin_users. Raise severity or pair with other discovery rules on the same host if this fires alongside T1082/T1518 activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(win32_(systemdriver|pnpsigneddriver)|get-windowsdriver\s+.*-online|pnputil(\.exe)?["']?\s+[\/-](enum-drivers|e)\b|\bsc(\.exe)?["']?\s+(\\\\\S+\s+)?query(ex)?\s+.*type=\s*(driver|kernel|filesys)|fltmc(\.exe)?["']?\s+(filters|instances))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1652")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
