/*
  MITRE Technique : T1056 - Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:45:15.220565+00:00
  Reference       : https://attack.mitre.org/techniques/T1056
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_Cleartext_Credential_POST_To_External_IP_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a cleartext HTTP POST to an external server addressed by raw IP literal, with a credential-style path (login, signin, auth, password). This is the network-side footprint of web portal capture or of a keylogger or input-capture implant sending harvested credentials out. The rule uses perimeter telemetry only and does not rely on endpoint process data."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056"
    mitre_technique_name = "Input Capture"
    log_prerequisites = "Requires firewall or proxy logs that populate NETWORK_HTTP with HTTP method and URL. For HTTPS this needs TLS inspection, otherwise only cleartext HTTP is visible."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy internal-facing or lab web apps reached by IP address, embedded device or appliance admin portals on public IPs, captive portals, and vendor software that posts authentication to an IP-addressed licensing or telemetry server."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Review %rfc1918_internal for completeness against customer address space. If a customer has many legitimate IP-addressed portals, narrow the path keywords or raise the risk score only when combined with endpoint alerts."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^http:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\// nocase
    $net.target.url = /(login|logon|signin|sign-in|auth|passw(or)?d|credential|account|verify)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1056")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
