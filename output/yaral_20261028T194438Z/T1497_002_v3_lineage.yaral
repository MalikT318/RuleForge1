/*
  MITRE Technique : T1497.002 - User Activity Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:04:14.962146+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_002_Linux_Service_Parent_Spawns_User_Activity_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell or script interpreter whose command line probes for user activity (logged-in users, login history, shell history, browser profiles, idle time, home directory contents). Service daemons have no legitimate reason to check for an interactive user, so this lineage anomaly points to web-shell or exploited-service payloads performing sandbox and VM evasion checks."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.002"
    mitre_technique_name = "Virtualization/Sandbox Evasion: User Activity Based Checks"
    log_prerequisites = "Linux endpoint process-launch telemetry with parent and child process paths and command lines (EDR or auditd execve records normalised to UDM)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin troubleshooting through a web-based management console, application health-check or monitoring scripts launched by a Java or Node service, database maintenance jobs that call shell scripts using who or last, hosting control panels that report logged-in users."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. If a Java or Node application legitimately runs inventory scripts, allow-list that parent path. Narrow or extend the parent service list to match the client's stack."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/((ba|da|a|z|k|c|tc)?sh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /((^|[\s;|&`(])(who|w|last|lastb|lastlog|users|uptime|xprintidle|xdotool|loginctl)($|[\s;|&`)]))|\.bash_history|\.zsh_history|\.mozilla|\.config\/(google-chrome|chromium)|\/var\/run\/utmp|\/var\/log\/(wtmp|btmp)|\/dev\/input|\/proc\/(interrupts|[0-9]+\/stat)|ls\s+[^|;&]*\/(home|root)\b/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1497.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
