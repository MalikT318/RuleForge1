/*
  MITRE Technique : T1036.002 - Right-to-Left Override
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:59:26.149721+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_002_RTLO_Character_In_Outbound_HTTP_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound HTTP request from a Linux host whose URL contains the right-to-left override character (U+202E), either as a raw character or percent-encoded (%E2%80%AE). This indicates retrieval of a file whose name is disguised to look like a benign type. It is the network-side counterpart to endpoint command-line detections and works even when the process telemetry is incomplete."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.002"
    mitre_technique_name = "Masquerading: Right-to-Left Override"
    log_prerequisites = "Requires NETWORK_HTTP events carrying the full requested URL in target.url, from a Linux endpoint sensor, a proxy, or a network sensor that attributes the request to a Linux host. URL decoding must not be applied before ingestion, otherwise the percent-encoded form is lost."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate downloads of files with right-to-left language names (Arabic, Hebrew) that use bidirectional control characters; web crawlers and package mirrors that fetch user-generated content with such names; security awareness or red-team exercises."
    tuning_guidance = "Add trusted external domains such as CDNs and content portals that legitimately serve bidirectional filenames to %global_allowed_domains. Internal destinations are already excluded through %rfc1918_internal. For noisy hosts in right-to-left-language environments, raise severity only when the request comes from a command-line downloader or the URL path ends in an executable or script extension."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(?i)(%e2%80%ae|\x{202e}|\\u202e)/
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
