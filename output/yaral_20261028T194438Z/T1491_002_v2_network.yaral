/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:46:10.488906+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_Linux_External_Web_Content_Overwrite_Via_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external source using a content-writing HTTP method (PUT, MOVE or COPY, as used by WebDAV or misconfigured upload handlers) to overwrite a site landing page on a web server, with a successful 2xx response. Landing pages such as index/default/home are the usual targets of external defacement. Observed from the network side in proxy, WAF or perimeter logs, with no dependence on endpoint telemetry. Applies to Linux-hosted web servers (Apache, nginx, and similar)."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires firewall, reverse proxy or WAF logs that normalise to UDM NETWORK_HTTP with network.http.method, network.http.response_code, target.url and principal.ip populated. TLS-terminating inspection is needed for HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised CMS or WebDAV publishing workflows reached through an external address, deployment pipelines or CDN origin-push tooling that uploads index pages, vulnerability scanners probing PUT support, and partner or agency staff updating content from public IPs."
    tuning_guidance = "Add trusted publisher and CI/CD egress addresses to %global_allowed_mgmt_sources and approved scanner sources to %global_allowed_scanners. Extend the landing-page filename regex if the client uses other default documents. If the client's HTTP logs do not populate network.http.response_code, remove the response-code condition."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|MOVE|COPY)$/ nocase
    $net.target.url = /\/(index|default|home|main|welcome)\.(html?|php[0-9]?|aspx?|jsp|cgi)(\?.*)?$/ nocase
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
