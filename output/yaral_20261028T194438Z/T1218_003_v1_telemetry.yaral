/*
  MITRE Technique : T1218.003 - CMSTP
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:44:55.619903+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_003_CMSTP_Executable_Artifact_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Microsoft Connection Manager Profile Installer (cmstp.exe) writing executable or script content (DLL, EXE, SCT, script, HTA) to a user-writable location. Legitimate CMSTP activity only writes connection profile artifacts (.cmp, .cms, .inf, .pbk). Executable content dropped by cmstp.exe indicates an INF-driven proxy execution or UAC bypass payload. This rule works on the resulting file artifact, so it still fires when the command line is obfuscated or not logged."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.003"
    mitre_technique_name = "System Binary Proxy Execution: CMSTP"
    log_prerequisites = "Requires endpoint file-creation telemetry with the initiating process populated (EDR or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Corporate VPN or Connection Manager profile packages that bundle helper DLLs or custom actions, IT packaging and test activity on admin workstations, and software installers that call cmstp.exe to deploy a custom connection profile."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or deployment accounts to %global_allowed_service_accounts. If a known VPN profile package legitimately drops DLLs, narrow the extension list or add a path exclusion for the vendor-specific subfolder for that client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\cmstp\.exe$/ nocase
    $file.target.file.full_path = /\.(dll|exe|ocx|scr|sct|hta|bat|cmd|ps1|vbs|vbe|js|jse|wsf)$/ nocase
    $file.target.file.full_path = /\\(temp|appdata|programdata|users\\public|windows\\tasks|windows\\temp)\\/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
