/*
  MITRE Technique : T1505.006 - vSphere Installation Bundles
  Tactic(s)       : Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:35:56.449657+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_006_ESXi_VIB_Config_Change_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of host configuration changes on a single ESXi host within ten minutes that relate to vSphere Installation Bundle handling. These include host acceptance level changes, software profile or VIB database updates, and persistent bootbank or package store modifications. A single change can be routine patching. Several together suggest an adversary lowering the acceptance level and installing an unsigned or community-supported VIB to persist across reboots."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.006"
    mitre_technique_name = "Server Software Component: vSphere Installation Bundles"
    log_prerequisites = "ESXi hostd, esxupdate and shell logs forwarded to Chronicle and parsed into SETTING_MODIFICATION events with a populated metadata.description or target.resource.name."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Lifecycle or patch management tooling (image-based remediation, driver and firmware updates), administrators performing planned host upgrades or hardware vendor add-on installs, and host profile remediation applied to newly built hosts."
    tuning_guidance = "Add approved patching and automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #cfg threshold in hosts with frequent maintenance windows. Correlate alerts with change tickets and maintenance schedules."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    (
      $cfg.metadata.description = /(acceptance[\s_\-]?level|\bvib\b|esxupdate|software[\s_\-]?profile|\/bootbank|\/altbootbank|\/store\/packages|imageprofile)/ nocase or
      $cfg.target.resource.name = /(acceptance[\s_\-]?level|\bvib\b|esxupdate|software[\s_\-]?profile|\/bootbank|\/altbootbank|\/store\/packages|imageprofile)/ nocase
    )
    $cfg.principal.hostname = $host
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1505.006")
    $primary_entity = array_distinct($host)
    $event_count = count($cfg.metadata.id)
    $actor_users = array_distinct($cfg.principal.user.userid)

  condition:
    #cfg >= 3
}
