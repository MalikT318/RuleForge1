/*
  MITRE Technique : T1546.004 - Unix Shell Configuration Modification
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:06:00.557777+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_004_Linux_Shell_Profile_Remote_Script_Fetch_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side indicator of shell-profile persistence on Linux. A command-line downloader (curl or wget user agent) fetches a shell script, or fetches from a bare IP-literal URL, from an external destination. Commands planted in /etc/profile, /etc/profile.d, ~/.bashrc or ~/.bash_profile run at every login or shell start, so they commonly re-fetch a payload through a downloader like this. The firewall or proxy cannot see the profile file or the initiating process. This rule is a network proxy for the behaviour and complements endpoint command-line and file-modification rules."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.004"
    mitre_technique_name = "Event Triggered Execution: Unix Shell Configuration Modification"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with network.http.user_agent and target.url populated. Outbound traffic from Linux servers and workstations must be visible, with TLS inspection where possible."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Package and configuration bootstrap scripts (installers that pipe a .sh file to a shell), CI/CD runners and build agents, cloud-init and provisioning scripts, admins fetching install scripts, and monitoring or inventory agents pulling from IP-literal internal-facing endpoints that are NAT'd or public."
    tuning_guidance = "Add vendor and package-repository domains to %global_allowed_domains. Add build servers, provisioning hosts and jump hosts to %global_allowed_script_hosts. Raise severity for production servers where interactive downloads are unusual. Pair with endpoint FILE_MODIFICATION alerts on profile paths for confirmation."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget)\// nocase
    (
      $http.target.url = /\.(sh|bash)(\?.*)?$/ nocase or
      $http.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\// nocase
    )
    $http.principal.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546.004")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
