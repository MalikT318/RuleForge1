/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:48:22.184774+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_Remote_Process_Injection_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows process running from a user-writable location (AppData, Temp, Downloads, Public, ProgramData) that injects into a different, commonly abused host process. This pivots away from process-creation and command-line logic and uses native process-injection telemetry, which covers PE injection via VirtualAllocEx/WriteProcessMemory/CreateRemoteThread regardless of binary name or hash."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires endpoint telemetry that emits process-injection or remote-thread-creation events (Sysmon Event ID 8 or equivalent EDR sensor) normalised to PROCESS_INJECTION, with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed software that hooks or injects into other processes (screen recorders, overlays, accessibility tools, game anti-cheat, some password managers), self-updating applications run from AppData, developer debuggers and profilers, and security or DLP agents not yet allowlisted."
    tuning_guidance = "Add expected injecting binaries to %global_allowed_security_tools or %global_allowed_admin_tools. Add known automation or service accounts to %global_allowed_service_accounts. Review recurring hits by source process path and allowlist by executable name rather than install directory."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\Users\\[^\\]+\\(AppData|Downloads|Desktop|Documents)\\|\\Users\\Public\\|\\Windows\\Temp\\|\\ProgramData\\(?:[^\\]+\\)*[^\\]+\.exe$/ nocase
    $inj.target.process.file.full_path = /\\(explorer|svchost|winlogon|spoolsv|dllhost|taskhostw|RuntimeBroker|notepad|rundll32|msiexec|werfault|sihost)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCnProxy)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($inj.principal.hostname)
    $source_process = array_distinct($inj.principal.process.file.full_path)
    $target_process = array_distinct($inj.target.process.file.full_path)
    $acting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
