/*
  MITRE Technique : T1484.001 - Group Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:32:07.171946+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_001_SYSVOL_GPO_Policy_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of security-sensitive Group Policy Object files (scheduled tasks, local groups, services, security templates, startup/logon scripts, registry policy, file deployment) inside the SYSVOL Policies share. Pivots on the resulting file artifact rather than the command line, so it still fires when the GPO edit is made through PowerShell cmdlets, direct SMB writes, or tooling that evades command-line logging. DFS-R replication is excluded by process name."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.001"
    mitre_technique_name = "Domain or Tenant Policy Modification: Group Policy Modification"
    log_prerequisites = "Requires Windows endpoint file-modification telemetry (EDR or Sysmon file events, or Security event 4663 with auditing on SYSVOL) collected from domain controllers and, ideally, from hosts with SYSVOL mapped."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate GPO administration through GPMC or Group Policy cmdlets by domain admins, change-managed GPO deployments, GPO backup/restore or migration tooling, and AD/GPO management products."
    tuning_guidance = "Add approved GPO administrator accounts to %global_allowed_admin_users and approved GPO management or deployment tooling to %global_allowed_admin_tools. Scope deployment to domain controllers where the full SYSVOL write telemetry is available. Review hits that occur outside change windows or are made by non-admin accounts first."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\sysvol\\[^\\]+\\policies\\\{[0-9a-fA-F-]{36}\}\\(machine|user)\\(preferences\\(scheduledtasks|groups|services|files|registry|datasources|environmentvariables)\\[^\\]+\.xml|microsoft\\windows nt\\secedit\\gpttmpl\.inf|scripts\\(startup|shutdown|logon|logoff)\\[^\\]+|scripts\\(scripts|psscripts)\.ini|registry\.pol)$/ nocase
    not $file.principal.process.file.full_path = /\\dfsrs\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1484.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_gpo_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
