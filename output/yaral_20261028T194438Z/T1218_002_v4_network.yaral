/*
  MITRE Technique : T1218.002 - Control Panel
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:44:06.393099+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_002_Control_Panel_Process_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows Control Panel host process (control.exe) initiating a network connection to an external address. Legitimate control.exe rarely makes outbound connections; it normally only launches applets. An outbound connection suggests a malicious CPL/DLL payload loaded through control.exe that is calling out to C2 or staging infrastructure. This is the network-side view of T1218.002 and complements process-creation command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.002"
    mitre_technique_name = "System Binary Proxy Execution: Control Panel"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the initiating process (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Control Panel applets that legitimately reach the internet (Windows Update or Store settings pages, Microsoft account and sign-in pages, network and VPN applets), OEM or vendor Control Panel items that check for updates or licensing, and proxy-aware telemetry that reports the proxy or a cloud service address as the destination."
    tuning_guidance = "Add known-good vendor and Microsoft destination domains to %global_allowed_domains. Ensure %rfc1918_internal covers all internal address space for the client. Add approved administrator accounts to %global_allowed_admin_users if admins routinely use control panel applets that reach external services. Review the destination addresses and parent process in the outcome before escalating."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\control\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)
    $initiating_user = array_distinct($net.principal.user.userid)
    $initiating_command_line = array_distinct($net.principal.process.command_line)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)

  condition:
    $net
}
