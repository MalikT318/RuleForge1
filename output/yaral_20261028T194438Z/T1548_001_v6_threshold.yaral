/*
  MITRE Technique : T1548.001 - Setuid and Setgid
  Tactic(s)       : Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:30:00.145879+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_001_Linux_Setuid_Bit_Mass_Set_Writable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple file modifications on a single Linux host within 10 minutes in which chmod sets the setuid or setgid bit (symbolic u+s/g+s or numeric 2xxx/4xxx/6xxx/7xxx modes) on files in user-writable locations (/tmp, /var/tmp, /dev/shm, home directories, /root, /var/www). One setuid change can be benign, but repeated changes in staging paths indicate privilege-escalation persistence or SUID backdoor staging. This uses file-modification telemetry and does not duplicate process-launch command-line detections."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.001"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Setuid and Setgid"
    log_prerequisites = "Linux EDR or auditd (syscall chmod/fchmodat) normalised to FILE_MODIFICATION with target.file.full_path, principal.process.file.full_path and principal.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software build/packaging pipelines and CI runners producing SUID test artefacts, developers compiling and testing privileged binaries in home directories, configuration management (Ansible, Puppet, Chef) staging files, container image builds, and admins hardening or auditing permissions."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, automation and CI accounts to %global_allowed_service_accounts, and build hosts via %global_allowed_script_hosts. Raise the #proc threshold on build servers or lower it to 2 on hardened production servers."

  events:
    $proc.metadata.event_type = "FILE_MODIFICATION"
    $proc.principal.process.file.full_path = /\/chmod$/ nocase
    $proc.principal.process.command_line = /chmod\s+(-[a-z]+\s+)*([0-7]?[2467][0-7]{3}|[ugoa]*[+=][rwxXt]*s[rwxXt]*)(\s|,|$)/ nocase
    $proc.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|home\/[^\/]+|root|var\/www)\// nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1548.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $modified_files = array_distinct($proc.target.file.full_path)

  condition:
    #proc >= 3
}
