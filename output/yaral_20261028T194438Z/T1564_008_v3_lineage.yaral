/*
  MITRE Technique : T1564.008 - Email Hiding Rules
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:26:22.627977+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_008_Unexpected_Parent_Spawns_Shell_Inbox_Rule_Hiding {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by an unexpected parent process (Office application, web server worker, database service, print spooler, WMI provider host, or script host) whose command line creates or modifies a mailbox inbox rule with a hiding action such as delete, move to folder, or mark as read. Normal administrative inbox-rule changes come from an interactive admin shell or a management host. They do not come from a document, web, database, or spooler process, so this pivots on process lineage."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.008"
    mitre_technique_name = "Hide Artifacts: Email Hiding Rules"
    log_prerequisites = "Requires endpoint process telemetry with parent and child process paths and full command lines (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Exchange or Microsoft 365 provisioning and migration tooling launched from a web or application-pool process, helpdesk portals that run mailbox automation through w3wp or Java services, Outlook add-ins or macros that deliberately manage rules, and scheduled admin scripts launched via a script host."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_script_hosts and approved admin or provisioning tooling to %global_allowed_admin_tools. Add known mailbox automation service accounts to %global_allowed_service_accounts. The parent-process regex can be tightened or extended per client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|java|sqlservr|spoolsv|wmiprvse|mshta|wscript|cscript)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(powershell|powershell_ise|pwsh|cmd)\.exe$/ nocase
    $proc.target.process.command_line = /\b(new|set|enable)-inboxrule\b/ nocase
    $proc.target.process.command_line = /(-deletemessage|-movetofolder|-markasread|-permanentdelete|-movetofolder|-subjectcontainswords|-bodycontainswords|-fromaddresscontainswords|-subjectorbodycontainswords)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1564.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
