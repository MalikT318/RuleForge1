/*
  MITRE Technique : T1219.002 - Remote Desktop Software
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:07:41.955643+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_002_Linux_Outbound_Remote_Desktop_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host making an outbound connection to an external address on a port characteristic of remote desktop software: VNC display ports (5900-5909), reverse VNC listening viewer (5500), TeamViewer (5938), or AnyDesk direct (7070). This is network-side coverage that complements endpoint process-creation rules. It does not depend on binary names, so it still fires if the tool is renamed or repackaged."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.002"
    mitre_technique_name = "Remote Access Software: Remote Desktop Software"
    log_prerequisites = "Firewall, proxy, or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip, and target.port. Egress traffic must be logged at the perimeter. Linux hosts are identified by the client's source address ranges or asset context."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised helpdesk or RMM sessions to vendor cloud relays, sysadmins using VNC to externally hosted lab or cloud VMs, developers using remote desktop on cloud workstations, and vulnerability scanners probing VNC ports."
    tuning_guidance = "Add approved admin or jump-host source addresses to %global_allowed_mgmt_sources. Add authorised scanner source addresses to %global_allowed_scanners. Scope the rule to Linux server subnets or assets in the client's SIEM if the firewall logs do not carry OS context. Raise severity for server segments that should never initiate remote desktop sessions outbound."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      ($net.target.port >= 5900 and $net.target.port <= 5909) or
      $net.target.port = 5500 or
      $net.target.port = 5938 or
      $net.target.port = 7070
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1219.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
