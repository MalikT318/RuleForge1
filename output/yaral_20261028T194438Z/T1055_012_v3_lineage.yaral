/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:59:39.748698+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_System_Process_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a core Windows system process (svchost, lsass, services, wininit, winlogon, csrss) launched by a parent other than its one expected parent. Process hollowing and masquerading commonly create a suspended instance of one of these binaries from an arbitrary dropper, so the lineage is wrong even when the child image path is legitimate."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with populated parent and child image paths (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process name enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debuggers, crash-dump or sandbox tooling that deliberately launches system binaries; EDR or security agents that spawn system processes for testing; some OS-recovery or in-place upgrade components; telemetry gaps where the parent path is reported incorrectly for early-boot processes."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and approved deployment or debugging tooling to %global_allowed_admin_tools (matched on the parent process path). If a client's EDR reports early-boot parents inconsistently, review the parent_process outcome values and add the offending parent to an allowlist."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path != ""
    $proc.principal.hostname != ""
    (
      (
        $proc.target.process.file.full_path = /\\windows\\system32\\svchost\.exe$/ nocase and
        not $proc.principal.process.file.full_path = /\\services\.exe$/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\windows\\system32\\(lsass|services)\.exe$/ nocase and
        not $proc.principal.process.file.full_path = /\\wininit\.exe$/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\windows\\system32\\(wininit|winlogon|csrss)\.exe$/ nocase and
        not $proc.principal.process.file.full_path = /\\smss\.exe$/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
