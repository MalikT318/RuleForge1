/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:07:15.333852+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_Linux_Mail_Client_Config_Dropped_By_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a command-line mail client or relay configuration file (SMTP/IMAP/POP3 credentials and server settings) by a script interpreter or by a binary running from a world-writable staging directory. Adversaries abuse mail protocols for C2 or exfiltration. Writing a mail client config is the required state change, and it is visible even when command-line logging is evaded. This is a file-artifact detection and complements process command-line rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (write/attr on home directories, /etc/msmtprc and /etc/ssmtp) normalised to UDM FILE_CREATION with principal process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or provisioning scripts (shell, Python, Ansible-style modules) that configure msmtp, ssmtp, fetchmail, or mutt for cron job notifications; user dotfile sync scripts; first-time setup of mail relays on servers."
    tuning_guidance = "Add approved config-management and deployment binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and build or provisioning hosts to %global_allowed_script_hosts. If dotfile sync is common, restrict the interpreter portion of the writer regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/(home\/[^\/]+|root)\/\.(msmtprc|fetchmailrc|mailrc|muttrc|getmailrc|offlineimaprc|esmtprc)|\/(home\/[^\/]+|root)\/\.(mutt|getmail)\/[^\/]+|\/etc\/(msmtprc|ssmtp\/ssmtp\.conf|esmtprc|mailrc|nail\.rc))$/ nocase
    $file.principal.process.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)|\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|php|node)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $config_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
