/*
  MITRE Technique : T1021.004 - SSH
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:40:56.121162+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_004_Internal_SSH_Lateral_Connection_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal-to-internal SSH connection observed at the network perimeter or internal firewall. Both source and destination are inside internal address space and the source is not an approved management, jump or scanner host. This is the network-observable footprint of SSH lateral movement with valid accounts between Linux, ESXi or macOS systems, and it does not depend on endpoint process telemetry."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.004"
    mitre_technique_name = "Remote Services: SSH"
    log_prerequisites = "Requires firewall, proxy or network flow logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW, with internal east-west traffic visible (internal segmentation firewall, flow logs or a span feed). Source and destination IPs and the destination port must be populated. No endpoint process fields are used."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators connecting from unlisted jump hosts or workstations, configuration management and orchestration tooling (automation, CI/CD runners), backup and monitoring systems that poll over SSH, internal vulnerability scanners not yet in the allowlist, developers accessing internal Git or build servers over SSH."
    tuning_guidance = "Add approved bastion, jump and automation source addresses to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Roll out per client in alert-only mode first to baseline normal east-west SSH, then consider raising severity for server-to-server SSH from hosts that never normally initiate it."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.network.application_protocol = "SSH")
    $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1021.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
