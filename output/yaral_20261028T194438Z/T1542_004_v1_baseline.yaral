/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:48:16.829452+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_ROMMON_TFTP_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) traffic observed at the network perimeter. TFTP is the transfer method adversaries use to push or pull an unauthorized ROMMON image to a network device before a reload overwrites the boot firmware. The rule triggers on the protocol and port, not on a filename or server address, so it still fires if the attacker changes hosting or renames the image. A firewall cannot see the payload, so each alert needs follow-up on the device. Check the boot variable, ROMMON version and image integrity."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Firewall or perimeter connection/flow logs with UDP protocol and destination port populated, with traffic to and from network device management interfaces traversing the firewall."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate IOS or ROMMON upgrades by network engineers, zero-touch provisioning and PXE or network boot, scheduled device configuration backups over TFTP, lab and staging networks, and legacy VoIP phone firmware or config provisioning."
    tuning_guidance = "Add approved management, provisioning and backup source addresses to %global_allowed_mgmt_sources. Raise severity if the destination is outside internal address space. Correlate alerts with change tickets and with device syslog showing a reload or ROMMON upgrade."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity = array_distinct($net.principal.ip)
    $tftp_server_ips = array_distinct($net.target.ip)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
