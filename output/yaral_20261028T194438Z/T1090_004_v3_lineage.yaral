/*
  MITRE Technique : T1090.004 - Domain Fronting
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:32:32.488906+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_004_ESXi_Mgmt_Daemon_Spawns_HostHeader_Override_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a hypervisor management daemon or service process spawning an HTTP client or interpreter whose arguments override the HTTP Host header or the connection target (--connect-to, --resolve). Management daemons do not normally launch outbound HTTP tooling, and Host or connect overrides are the mechanics of domain fronting. The rule pivots on the unexpected parent-child lineage and adds a fronting-specific argument filter to keep fidelity high. It does not cover fronting launched from an interactive SSH session or from a shell child of the daemon with no override arguments."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.004"
    mitre_technique_name = "Proxy: Domain Fronting"
    log_prerequisites = "ESXi shell and process execution logging forwarded to the SIEM and normalised to PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) paths and command line. The auditing level must capture exec arguments."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or third-party agents and plugins that run under management daemons and call curl or wget with a custom Host header for health checks, VIB or patch downloads through proxies, or backup and monitoring integrations. Admin troubleshooting that uses curl --resolve against internal endpoints."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_security_tools. Add approved backup agents to %global_allowed_backup_processes. If a legitimate integration is noisy, exclude its parent path rather than loosening the child or argument patterns."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|rhttpproxy|sfcbd|openwsmand|vobd|fdm|vmware-hostd|snmpd|slpd)$/ nocase
    $proc.target.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|nc|ncat|busybox)$/ nocase
    $proc.target.process.command_line = /(\s-H\s*["']?host\s*:|--header[=\s]+["']?host\s*:|--connect-to|--resolve\s)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1090.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
