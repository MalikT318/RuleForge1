/*
  MITRE Technique : T1574 - Hijack Execution Flow
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:27:51.124941+00:00
  Reference       : https://attack.mitre.org/techniques/T1574
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_Windows_Registry_Hijack_Key_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several modifications to registry keys that control how Windows locates and loads executables and libraries (COM server paths, Image File Execution Options, AppInit/AppCert DLLs, KnownDLLs, Winlogon helpers, service ImagePath/ServiceDll) occur on one host within ten minutes. A single write is often benign (installers, COM registration), but a burst across hijack-prone locations indicates execution-flow hijacking for persistence, privilege escalation or defense evasion."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574"
    mitre_technique_name = "Hijack Execution Flow"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) that populates target.registry.registry_key and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters registering COM servers or services, application packaging and deployment tools, developer machines registering COM components, debugger or application-verifier configuration by IT, and AV/EDR agent upgrades."
    tuning_guidance = "Add deployment, patching and RMM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Raise the #reg threshold on developer or packaging hosts. Review the $modified_keys and $modifying_processes outcome values to identify noisy installers and add them to the allowlists."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(?i)(\\(inprocserver32|localserver32|treatas)$|image file execution options\\[^\\]+$|\\currentversion\\windows$|\\session manager\\(knowndlls|appcertdlls)|\\currentversion\\winlogon\\(userinit|shell|notify)|\\services\\[^\\]+\\parameters$|\\services\\[^\\]+$)/
    $reg.target.registry.registry_value_name = /(?i)^(\(default\)||debugger|globalflags|verifierdlls|appinit_dlls|loadappinit_dlls|userinit|shell|servicedll|imagepath|[^\\]+\.dll)$/
    not $reg.principal.process.file.full_path = /(?i)\\(msiexec|trustedinstaller|tiworker|msmpeng|mssense|senseir)\.exe$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_key = /(?i)(image file execution options|appcertdlls|knowndlls|\\currentversion\\winlogon)/, 85, 65))
    $event_count = count($reg.metadata.id)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)
    $mitre_technique_id = array_distinct("T1574")
    $primary_entity = array_distinct($host)

  condition:
    #reg >= 3
}
