/*
  MITRE Technique : T1557.003 - DHCP Spoofing
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:33:27.032476+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_003_Rogue_DHCP_Server_Reply_Observed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DHCP server-to-client traffic (UDP source port 67 to destination port 68) seen by the network perimeter or internal segmentation firewall from a source that is not an approved DHCP server or relay. A rogue DHCP server (T1557.003) must send OFFER and ACK messages on this port pair to hand victims a malicious gateway or DNS server. The rule is not limited to Linux hosts. It matches on the network side, so it fires whether the rogue server is a Linux host, a container or VM with bridged networking, or any other device. Internal address space is deliberately not excluded, because a rogue DHCP server is itself an internal host and excluding RFC1918 would remove every true positive."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.003"
    mitre_technique_name = "Adversary-in-the-Middle: DHCP Spoofing"
    log_prerequisites = "Firewall or network-perimeter logs that record UDP flows with source and destination ports, including internal segment or VLAN firewalls and DHCP snooping/ACL deny or allow logs. Ports must be parsed into principal.port and target.port. The sensor must see traffic crossing the DHCP broadcast domain."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate DHCP servers not yet in the allow list, DHCP relay agents or IP helpers on routers and L3 switches, HA or failover DHCP peers, new or migrated DHCP infrastructure, and lab or virtualisation hosts (dnsmasq, libvirt, Docker or Kubernetes networking) running intentional DHCP on isolated segments."
    tuning_guidance = "Populate %global_allowed_mgmt_sources with the IP address of every authorised DHCP server and relay agent or IP helper per client. Scope the rule to segments where the firewall sees client DHCP traffic. If the firewall only logs inter-VLAN traffic, relay addresses will dominate and must be listed. Raise severity for user or server VLANs and lower it for lab VLANs."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.principal.port = 67
    $net.target.port = 68
    $net.principal.ip != ""
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1557.003")
    $primary_entity = array_distinct($net.principal.ip)
    $rogue_server_hostname = array_distinct($net.principal.hostname)
    $dhcp_client_ips = array_distinct($net.target.ip)

  condition:
    $net
}
