/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:23:28.022060+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_Addin_Dropped_In_Startup_Folder {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an Office add-in file (XLL, WLL, XLA/XLAM, PPA/PPAM, DOTM) in a per-user or machine-wide Office startup or AddIns folder. Office loads these files automatically when the application starts, so a new file there is a persistence mechanism. This variant covers the file-drop mechanism and complements registry and COM add-in coverage. The requested alternate-platform angle was not applied because the mandatory platform requirement for this rule is Windows."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate add-in installers (MSI or ClickOnce deployments), users saving their own .xlam or .dotm add-ins through Office, software deployment and RMM agents, and finance or analytics plug-ins that install XLL add-ins."
    tuning_guidance = "Add approved deployment and installer process paths to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. Review the creating process in the alert: a script host, browser, mail client, archive tool or Office application writing the file is high risk. Consider adding known-good add-in publishers' installers to %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\microsoft\\(excel\\xlstart|word\\startup|addins|powerpoint\\addins)\\[^\\]+\.(xll|wll|xla|xlam|ppa|ppam|dotm|dot|xlb)$|\\microsoft office\\(root\\)?office\d+\\(xlstart|startup)\\[^\\]+\.(xll|wll|xla|xlam|ppa|ppam|dotm|dot)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $addin_path = array_distinct($file.target.file.full_path)
    $creator_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
