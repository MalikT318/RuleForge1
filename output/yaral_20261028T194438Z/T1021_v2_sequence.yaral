/*
  MITRE Technique : T1021 - Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:33:07.913919+00:00
  Reference       : https://attack.mitre.org/techniques/T1021
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_Linux_Remote_Login_Then_Persistence_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a remote (SSH) login to a Linux host followed within 10 minutes by the same user modifying a persistence or access-control file on that host (authorized_keys, cron, systemd units, shell profiles, ld.so.preload). This pattern indicates valid-account lateral movement followed by persistence staging."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021"
    mitre_technique_name = "Remote Services"
    log_prerequisites = "Requires Linux auth telemetry (sshd via auditd/syslog/EDR) normalised to USER_LOGIN with a populated source IP, plus EDR or auditd file-integrity telemetry normalised to FILE_MODIFICATION with principal.user.userid populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators adding their own SSH keys or cron jobs right after logging in, configuration management agents (Ansible, Puppet, Chef) that connect over SSH and write config, provisioning and onboarding scripts, package installs that drop systemd units."
    tuning_guidance = "Add jump hosts and bastion source addresses to %global_allowed_mgmt_sources, automation and deployment accounts to %global_allowed_service_accounts, named admins to %global_allowed_admin_users, and approved config-management binaries to %global_allowed_admin_tools. Narrow or extend the persistence path regex to match the client's OS baseline."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /ssh/ nocase
    $auth.principal.ip != ""
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    $auth.target.hostname = $hostname
    $auth.target.user.userid = $user

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(\/\.ssh\/authorized_keys2?$|^\/etc\/cron(\.d|\.daily|\.hourly|\.weekly)?\/|^\/var\/spool\/cron\/|^\/etc\/systemd\/system\/[^\/]+\.(service|timer)$|\/\.(bashrc|bash_profile|profile)$|^\/etc\/ld\.so\.preload$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $user

    $auth.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021")
    $primary_entity = array_distinct($file.principal.hostname)
    $source_ips = array_distinct($auth.principal.ip)
    $modified_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $file_event_count = count($file.metadata.id)

  condition:
    $auth and $file
}
