/*
  MITRE Technique : T1557.003 - DHCP Spoofing
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:34:08.828042+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_003_Rogue_DHCP_Server_Offer_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DHCP server-to-client traffic (UDP source port 67 to destination port 68) from an internal host that is not on the approved DHCP/network infrastructure source list. A rogue DHCP server answering clients gives an adversary an adversary-in-the-middle position by handing out malicious gateway or DNS settings. Observed on the network side from firewall or perimeter flow logs, so it works regardless of the Linux endpoint tooling."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.003"
    mitre_technique_name = "Adversary-in-the-Middle: DHCP Spoofing"
    log_prerequisites = "Firewall, switch, or network perimeter logs that record permitted and denied UDP sessions on DHCP ports 67 and 68, including inter-VLAN or DHCP-relay segments, normalised to UDM NETWORK_CONNECTION with principal.ip, principal.port, target.ip, target.port and network.ip_protocol populated. The rule can only see DHCP traffic that crosses the logging device, so same-segment broadcast offers need DHCP snooping or span-port telemetry."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate DHCP servers or relays not yet in the allowlist (new site, failover peer, network appliance acting as DHCP server); Linux hosts running dnsmasq, isc-dhcp-server or libvirt/Docker/lab DHCP for VMs and PXE or provisioning networks; home-lab or guest Wi-Fi gear; DHCP failover between redundant servers."
    tuning_guidance = "Populate %global_allowed_mgmt_sources with the approved DHCP server and relay addresses for each client; this is the main tuning control. The rule requires the source to be internal (in %rfc1918_internal) because a rogue server on the victim network is by definition internal, and this removes external or spoofed-source noise. If your tenant's %rfc1918_internal list holds literal addresses rather than prefixes, make sure it covers the client's server subnets. Consider a separate rule for repeated offers from many sources, and correlate hits with endpoint Linux telemetry for dnsmasq/dhcpd/scapy-style listeners on UDP 67."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.principal.port = 67
    $net.target.port = 68
    $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1557.003")
    $primary_entity = array_distinct($net.principal.ip)
    $client_ips = array_distinct($net.target.ip)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
