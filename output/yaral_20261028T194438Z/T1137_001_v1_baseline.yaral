/*
  MITRE Technique : T1137.001 - Office Template Macros
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:14:12.868597+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_001_Office_Base_Template_Modified_In_Cloud_Storage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects content modification of an Office base template file (Normal.dotm, NormalEmail.dotm, PERSONAL.XLSB) or a macro-enabled workbook or add-in placed in an Excel XLSTART folder, as recorded in cloud unified audit file activity. Modifying these files is the core persistence mechanism of Office Template Macros, because the embedded VBA runs each time the Office application starts. The same event also covers roaming or redirected profile sync and tampered templates in cloud storage that are later used as remote or shared templates."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.001"
    mitre_technique_name = "Office Application Startup: Office Template Macros"
    log_prerequisites = "Requires unified audit logs with file activity (file modified or content updated events) ingested and normalised to USER_RESOURCE_UPDATE_CONTENT with target.file.full_path populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users with redirected or roaming profiles whose templates sync to cloud storage; legitimate edits to a shared corporate template or Personal Macro Workbook; IT staff deploying standardised templates or macros; backup or migration tools copying user profile folders."
    tuning_guidance = "Add approved template-management accounts to %global_allowed_admin_users and automation or migration identities to %global_allowed_service_accounts. If the client uses a managed corporate template library, exclude that service account. Raise severity where macro-enabled templates are not permitted by policy."

  events:
    $file.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $file.target.file.full_path = /(^|[\\\/])(normal|normalemail)\.dotm$|(^|[\\\/])personal\.xlsb$|[\\\/]xlstart[\\\/][^\\\/]+\.(xlsb|xlsm|xlam|xla)$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.001")
    $primary_entity = array_distinct($file.principal.user.userid)
    $modified_file = array_distinct($file.target.file.full_path)
    $source_ips = array_distinct($file.principal.ip)

  condition:
    $file
}
