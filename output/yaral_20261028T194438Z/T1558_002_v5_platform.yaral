/*
  MITRE Technique : T1558.002 - Silver Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:42:30.781469+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_002_Kerberos_Network_Logon_Lowercase_Domain_Forged_TGS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Kerberos network logon (Windows Security 4624 type 3 equivalent) in which the account domain is recorded entirely in lowercase. Windows domain controllers and member servers record the NetBIOS account domain in uppercase for genuine Kerberos logons. Ticket-forging tooling commonly writes the domain into a forged TGS (silver ticket) as typed, in lowercase or DNS style, and the target service copies it into the logon event. Because forged service tickets never touch the KDC, this service-side logon artefact is one of the few identity-layer indicators. Coverage here is for Windows domain authentication. This is a Windows variant that uses identity-source logon telemetry, not endpoint process fields."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.002"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Silver Ticket"
    log_prerequisites = "Windows Security logon events (4624) from servers and domain controllers, normalised to USER_LOGIN with extensions.auth.mechanism, extensions.auth.auth_details (authentication package) and target.administrative_domain populated. Advanced Audit Policy 'Audit Logon' (success) must be enabled on member servers hosting services."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Third-party appliances or Kerberos-enabled Linux/Java services that authenticate with a lowercase realm or domain string; some SSO gateways and storage devices that join AD; lab or migration environments with unusual domain naming; service accounts with legacy clients."
    tuning_guidance = "Add known service accounts to %global_allowed_service_accounts and named admin accounts to %global_allowed_admin_users. If a client's parser populates target.administrative_domain in lowercase for all logons, verify the field mapping first and disable the rule for that tenant rather than widening exclusions. Correlate hits with absence of a preceding TGS request (4769) for the same account and host during triage."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.extensions.auth.auth_details = /kerberos/ nocase
    $auth.target.administrative_domain = /^[a-z][a-z0-9\-\.]*$/
    $auth.target.user.userid != ""
    not $auth.target.user.userid = /^(anonymous logon|.*\$)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.002")
    $primary_entity = array_distinct($auth.target.hostname)
    $logon_users = array_distinct($auth.target.user.userid)
    $logon_domains = array_distinct($auth.target.administrative_domain)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
