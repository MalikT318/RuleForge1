/*
  MITRE Technique : T1210 - Exploitation of Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:17:14.254411+00:00
  Reference       : https://attack.mitre.org/techniques/T1210
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1210_Linux_Network_Daemon_Outbound_NonStandard {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing Linux service daemon (web server, database, SMB, FTP, mail, cache or application server) initiating an outbound connection to a non-internal address on a non-standard port. Such daemons normally only accept inbound connections. Outbound connections of this kind are a common result of successful remote service exploitation (reverse shell, staged payload download, callback). The rule detects the network behaviour of the compromised service rather than the exploit payload."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1210"
    mitre_technique_name = "Exploitation of Remote Services"
    log_prerequisites = "Requires Linux endpoint network telemetry from EDR or auditd (connect syscall) that populates principal.process.file.full_path, target.ip and target.port on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web servers or reverse proxies calling external upstream APIs on custom ports, database replication or backup to external cloud endpoints, mail transfer agents relaying on non-standard ports, application servers calling SaaS integrations on custom ports, and monitoring or update agents embedded in service processes."
    tuning_guidance = "Add approved destination management or integration addresses to %global_allowed_mgmt_sources. Add legitimate service binaries that need outbound access to %global_allowed_admin_tools. Extend the excluded port list (80, 443, 53, 123) with ports used by approved integrations. Ensure %rfc1918_internal is populated for each client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached|smbd|nmbd|vsftpd|proftpd|pure-ftpd|named|exim4?|dovecot|tomcat[0-9]*|catalina|jboss|wildfly)$/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 123
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1210")
    $primary_entity = array_distinct($net.principal.hostname)
    $service_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
