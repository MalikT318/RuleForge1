/*
  MITRE Technique : T1070.008 - Clear Mailbox Data
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:10:19.242451+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_008_Mailbox_Evidence_Removal_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects administrative configuration changes in the unified audit log that remove mailbox export or compliance search evidence, or exempt a mailbox from auditing. These are state changes attackers make to hide mailbox collection and exfiltration, and they are visible even when endpoint command-line logging is evaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.008"
    mitre_technique_name = "Indicator Removal: Clear Mailbox Data"
    log_prerequisites = "Requires unified audit log ingestion with administrator and mailbox-management activity enabled, normalised to SETTING_MODIFICATION with metadata.product_event_type populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Messaging administrators cleaning up completed mailbox export or eDiscovery requests, compliance teams removing finished searches, approved audit-bypass for service or journaling mailboxes, and migration projects."
    tuning_guidance = "Add automation and migration accounts to %global_allowed_service_accounts and named messaging or compliance administrators to %global_allowed_admin_users. Review the audit-bypass cmdlets separately if they are noisy, and raise severity when the actor is not a known administrator."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^(Remove-MailboxExportRequest|Remove-ComplianceSearch|Remove-ComplianceSearchAction|Set-MailboxAuditBypassAssociation|Remove-MailboxAuditBypassAssociation)$/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070.008")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operations = array_distinct($setting.metadata.product_event_type)
    $affected_mailbox = array_distinct($setting.target.user.userid)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
