/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:00:48.283373+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_Linux_Burst_VM_Sandbox_Artifact_Checks {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of virtualization or sandbox artifact checks on a single Linux host within 10 minutes. The checks include systemd-detect-virt, virt-what, dmidecode, reads of /sys/class/dmi/id and /proc/cpuinfo, and hypervisor vendor string lookups. One check is benign. Several in quick succession suggest malware profiling the environment before it decides whether to detonate."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with populated command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and inventory agents, cloud-init and provisioning scripts, hardware or asset inventory collectors, monitoring agents, and administrators troubleshooting VMs. Container and VM image build pipelines also trigger it."
    tuning_guidance = "Add inventory, provisioning and config-management binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add EDR and monitoring agents to %global_allowed_security_tools. Raise the #proc threshold in noisy estates, or lower it for high-value servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\bsystemd-detect-virt\b|\bvirt-what\b|\bdmidecode\b|\/sys\/class\/dmi\/id\/(product_name|product_version|sys_vendor|bios_vendor|bios_version|board_vendor|chassis_vendor)|\/proc\/scsi\/scsi|\/proc\/cpuinfo|\/sys\/hypervisor|\blscpu\b.*hypervisor|\b(vmware|virtualbox|vbox|qemu|hypervisor|xen|bochs|parallels)\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $commands_observed = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
