/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:19:25.092289+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Linux_Security_Agent_Status_File_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of a security agent's status, health or heartbeat state file by an interpreter or by a binary running from a user-writable or temporary location. This is the file-level result of spoofing a security tool's reported state (a fake 'healthy' or 'protected' indication) after the agent has been disabled or degraded. The rule works on the resulting file artifact rather than process command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry (FILE_MODIFICATION) with the writing process path populated, covering /run, /var/run, /var/lib, /opt, /etc and /usr/local."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or configuration management scripts (Ansible, Puppet, Chef, custom shell or Python) that legitimately reset agent state during upgrades or troubleshooting; agent installers or updaters that are scripted in an interpreter; in-house monitoring wrappers that write health files for security agents; backup or restore jobs that restore agent state directories."
    tuning_guidance = "Add legitimate agent binaries to %global_allowed_security_tools, deployment and patching tooling to %global_allowed_admin_tools, and approved automation hosts or parent processes to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If a client's agent uses a directory name not matched by the security-directory regex, extend the alternation for that client. Raise severity if the same host also shows security service stop events."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.principal.hostname != ""
    $file.target.file.full_path = /^\/(run|var\/run|var\/lib|opt|etc|usr\/local)\// nocase
    $file.target.file.full_path = /(edr|antivirus|anti-virus|endpoint[-_]?(security|protection)|security[-_]?(agent|sensor)|av[-_]?agent)[^\/]*\// nocase
    $file.target.file.full_path = /\/[^\/]*(status|health|heartbeat|last[-_]?(scan|update|checkin))[^\/]*$/ nocase
    $file.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm|root|home\/[^\/]+)\/|\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|php|node)$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
