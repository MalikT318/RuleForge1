/*
  MITRE Technique : T1213.004 - Customer Relationship Management Software
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:28:22.726079+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_004_CRM_App_Login_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Identity provider records a user sign-in to a CRM or customer-data application from a non-internal source address, where neither the account nor the source is on an approved list. Attackers with stolen credentials or hijacked SSO sessions use this access to mine customer PII for phishing, SIM swapping, or resale. This is a SaaS control-plane detection and complements endpoint command-line coverage."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.004"
    mitre_technique_name = "Data from Information Repositories: Customer Relationship Management Software"
    log_prerequisites = "Identity provider sign-in or SSO audit logs normalised to UDM USER_LOGIN, with target.application or target.resource.name populated with the application name and principal.ip populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Sales, support, and marketing staff working remotely, travelling, or on mobile carrier networks. Contractors and outsourced support desks. Corporate VPN or proxy egress addresses not covered by the internal list. Integration or service accounts that sign in non-interactively."
    tuning_guidance = "Add integration and automation identities to %global_allowed_service_accounts. Add administrators who routinely work in the CRM to %global_allowed_admin_users. Add corporate egress, VPN, and proxy addresses to %global_allowed_mgmt_sources. Adjust the application-name regex to match the CRM application display names in the customer's identity provider catalogue. For higher fidelity, pair this rule with a CRM bulk-export rule, or raise severity when the account is privileged."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.target.application = /\b(crm|customer[ _-]?relationship|customer[ _-]?(service|support|data)|help[ _-]?desk|sales)\b/ nocase or
      $auth.target.resource.name = /\b(crm|customer[ _-]?relationship|customer[ _-]?(service|support|data)|help[ _-]?desk|sales)\b/ nocase
    )
    $auth.principal.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1213.004")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)

  condition:
    $auth
}
