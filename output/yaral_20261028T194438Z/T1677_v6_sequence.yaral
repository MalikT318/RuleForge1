/*
  MITRE Technique : T1677 - Poisoned Pipeline Execution
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:23:14.840688+00:00
  Reference       : https://attack.mitre.org/techniques/T1677
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1677_Pipeline_Config_Change_Then_Secret_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user modifying a CI/CD pipeline definition file (direct pipeline execution) and then accessing pipeline secrets, tokens or CI variables within 10 minutes. This pattern is consistent with poisoned pipeline execution, where a modified workflow is used to expose or exfiltrate build credentials."
    mitre_tactic = "Execution"
    mitre_technique = "T1677"
    mitre_technique_name = "Poisoned Pipeline Execution"
    log_prerequisites = "Requires SaaS source-control and CI/CD audit logs normalised to UDM. Content-update events must populate target.file.full_path with the changed file path, and secret or variable access events must populate target.resource.name. Requires principal.user.userid on both events."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "DevOps engineers legitimately editing a pipeline and then rotating or reading CI variables in the same session; platform engineering teams bootstrapping new pipelines; infrastructure-as-code automation committing workflow templates and configuring secrets; release managers adjusting deployment jobs."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named platform or DevOps administrators to %global_allowed_admin_users. If the environment names secrets differently, adjust the resource-name regex. Consider raising severity when the pipeline change comes from a first-time contributor."

  events:
    $cfg.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $cfg.target.file.full_path = /(^|\/)(\.gitlab-ci\.ya?ml|\.github\/workflows\/[^\/]+\.ya?ml|jenkinsfile|azure-pipelines\.ya?ml|\.circleci\/config\.yml|bitbucket-pipelines\.yml|\.drone\.yml)$/ nocase
    $cfg.principal.user.userid = $user
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users

    $sec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $sec.target.resource.name = /(secret|credential|token|ci[_-]?variable|pipeline[_-]?variable|deploy[_-]?key|runner[_-]?token)/ nocase
    $sec.principal.user.userid = $user
    not $sec.principal.user.userid in %global_allowed_service_accounts
    not $sec.principal.user.userid in %global_allowed_admin_users

    $cfg.metadata.event_timestamp.seconds <= $sec.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1677")
    $primary_entity = array_distinct($user)
    $modified_pipeline_files = array_distinct($cfg.target.file.full_path)
    $accessed_resources = array_distinct($sec.target.resource.name)
    $secret_access_count = count($sec.metadata.id)

  condition:
    $cfg and $sec
}
