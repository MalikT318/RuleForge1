/*
  MITRE Technique : T1127 - Trusted Developer Utilities Proxy Execution
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:34:57.326735+00:00
  Reference       : https://attack.mitre.org/techniques/T1127
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_Dev_Utility_Drops_Executable_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a trusted developer utility (MSBuild, rcsi/csi, jsc, DNX, AddIn utilities, debuggers) writing an executable or script artifact into a user-writable staging location such as AppData, ProgramData, Users\\Public or Windows\\Temp. This is the file-system result of proxy execution and payload staging through signed developer tooling, and it fires even when command-line logging is evaded or the command line is obfuscated."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the creating process path populated in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations and build servers running MSBuild or Visual Studio builds that emit DLL/EXE output or restore packages into AppData or ProgramData; CI/CD agents; ClickOnce or installer packaging tasks; admins using debuggers to write dump or helper files."
    tuning_guidance = "Add build servers and developer workstation hostnames to %global_allowed_script_hosts. Add sanctioned build or deployment tooling to %global_allowed_admin_tools. Add known security tooling to %global_allowed_security_tools. If a client runs heavy MSBuild activity from AppData, narrow the target path regex for that tenant."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(msbuild|jsc|rcsi|csi|dnx|addinprocess|addinprocess32|addinutil|cdb|ntsd|windbg|kd)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\(local|roaming)|users\\public|programdata|windows\\temp|windows\\tasks)\\.*\.(exe|dll|scr|cpl|sys|msi|ps1|bat|cmd|vbs|vbe|js|jse|hta|wsf)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1127")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
