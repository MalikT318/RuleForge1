/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:31:50.962787+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_ESXi_Domain_Account_Login_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful management-plane or shell login to an ESXi host using a domain-formatted account (DOMAIN\\user or user@domain.tld) from a source not in the approved management source list. Domain accounts on ESXi usually mean the host is AD-joined, so a stolen domain credential gives hypervisor access without any local ESXi password. This is authentication-event coverage, not process or command-line coverage."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "ESXi hostd and shell authentication logs forwarded to Chronicle and parsed into USER_LOGIN events with the account name in target.user.userid and the client address in principal.ip. Hosts are AD-joined (or use identity federation) so domain accounts can authenticate."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Domain administrators managing hosts from jump servers or workstations missing from the management source list; vCenter or backup service accounts using domain identities; monitoring and inventory tools authenticating with domain service accounts; new admin workstations after a refresh."
    tuning_guidance = "Add approved jump hosts and management subnets to %global_allowed_mgmt_sources. Add named domain administrators to %global_allowed_admin_users and automation or service identities to %global_allowed_service_accounts. If ESXi is not AD-joined in a given tenant, any hit is high-fidelity and should be escalated. Raise severity for logins outside business hours."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = /^([^\\@\s]+\\[^\\@\s]+|[^\\@\s]+@[^\\@\s]+\.[^\\@\s]+)$/ nocase
    $auth.target.hostname != ""
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($auth.target.hostname)
    $source_ips = array_distinct($auth.principal.ip)
    $login_accounts = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
