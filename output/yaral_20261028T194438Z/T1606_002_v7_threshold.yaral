/*
  MITRE Technique : T1606.002 - SAML Tokens
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:26:30.703643+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_002_Federation_Trust_Changes_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of federation and domain-authentication configuration changes by a single identity within 10 minutes. Each change alone can be routine administration. Several together (add or verify a domain, convert it to federated authentication, set federation or token-signing settings) match the setup an adversary needs to establish a rogue federation trust and mint forged SAML tokens."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.002"
    mitre_technique_name = "Forge Web Credentials: SAML Tokens"
    log_prerequisites = "Requires Microsoft 365 / Entra ID unified audit logs ingested into UDM as SETTING_MODIFICATION with metadata.product_event_type populated and principal.user.userid mapped."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Planned tenant onboarding, domain migration, or M&A federation projects. Identity engineers rotating AD FS token-signing certificates. Managed identity-provider integration changes performed by an approved administrator."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users and automation or provisioning accounts to %global_allowed_service_accounts. The default threshold is 3 changes in 10m. Raise it for tenants with frequent domain work, or lower it to 2 for high-security tenants. Correlate hits with new sign-ins from unfamiliar sources afterwards."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(set|update|new|add|verify|convert|remove).{0,40}(federat|domain\s*authentication|domainfederation|trusted\s*domain|token.?signing|service\s*principal\s*credential|domain)/ nocase
    $setting.principal.user.userid = $user
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $event_count = count($setting.metadata.id)
    $mitre_technique_id = array_distinct("T1606.002")
    $primary_entity = array_distinct($user)
    $operations = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    #setting >= 3
}
