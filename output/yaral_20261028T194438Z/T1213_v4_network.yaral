/*
  MITRE Technique : T1213 - Data from Information Repositories
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:22:16.540194+00:00
  Reference       : https://attack.mitre.org/techniques/T1213
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_Linux_Scripted_Client_Repository_API_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host using a non-browser, scripted HTTP client (command-line downloader, scripting-language HTTP library) to query or export content from an information repository (wiki, document library, source-code or knowledge-base API) on an external destination. Scripted clients mining repository search, content, export and archive endpoints indicate automated collection of repository data. This is the network-side view and does not depend on process command-line telemetry."
    mitre_tactic = "Collection"
    mitre_technique = "T1213"
    mitre_technique_name = "Data from Information Repositories"
    log_prerequisites = "Requires NETWORK_HTTP events with target.url and network.http.user_agent populated, for example from a forward proxy, TLS-inspecting gateway, or an EDR/host sensor that records HTTP metadata."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Sanctioned automation such as CI/CD jobs, documentation sync or backup scripts, wiki/Git mirroring, developers using API scripts against SaaS repositories, and approved compliance or eDiscovery exports."
    tuning_guidance = "Add approved vendor or SaaS repository domains to %global_allowed_domains. Add known automation binaries to %global_allowed_admin_tools. Add CI/CD and integration accounts to %global_allowed_service_accounts. Add sanctioned script hosts to %global_allowed_script_hosts. Raise severity for hosts that are not build servers."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|okhttp|java|node-fetch|axios|ruby|php)/ nocase
    $http.target.url = /\/(rest\/api\/(content|search)|wiki\/rest\/api|_api\/(web\/lists|search\/query)|api\/v[34]\/(projects|search)|api\/v3\/search\/code|-\/archive|repository\/archive|export\/(pdf|word|xml))/ nocase
    $http.principal.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.process.file.full_path in %global_allowed_script_hosts
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1213")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_user = array_distinct($http.principal.user.userid)
    $client_process = array_distinct($http.principal.process.file.full_path)
    $user_agents = array_distinct($http.network.http.user_agent)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
