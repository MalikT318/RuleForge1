/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:14:10.938207+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_Office_Parent_Spawns_Script_Or_LOLBin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Microsoft Office application spawning a command shell, script interpreter, or download/proxy-execution LOLBin. This lineage is the typical result of a document that loads a remote template (template injection) and then runs the fetched macro or payload. The rule matches the abnormal parent-child relationship rather than any specific template URL or payload."
    mitre_tactic = "Stealth"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing) populating both parent and child process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy Office macros or add-ins that call cmd.exe or PowerShell (finance and reporting workbooks, ERP/CRM export plugins), document-management or DLP add-ins launching helper scripts, Excel-driven automation run by power users, and software-packaging tools that script Office."
    tuning_guidance = "Add approved Office add-in hosts or parent binaries to %global_allowed_script_hosts. Add automation or service accounts that legitimately drive Office to %global_allowed_service_accounts. Add sanctioned deployment or IT tooling to %global_allowed_admin_tools. If a specific business macro is noisy, narrow the child list for that tenant rather than removing the parent condition."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|msaccess|mspub|visio|onenote)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|installutil|msbuild)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
