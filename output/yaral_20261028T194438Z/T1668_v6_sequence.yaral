/*
  MITRE Technique : T1668 - Exclusive Control
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:11:37.207898+00:00
  Reference       : https://attack.mitre.org/techniques/T1668
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1668_Remote_Service_Disable_Then_Inbound_Block {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a remote-access service (RDP, SMB, WinRM, Remote Registry, SSH) being disabled through the service control manager, followed within 10 minutes by a host firewall rule blocking inbound traffic to remote-administration ports on the same host. Together these indicate an adversary closing the door behind themselves to keep exclusive access."
    mitre_tactic = "Persistence"
    mitre_technique = "T1668"
    mitre_technique_name = "Exclusive Control"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardening scripts and security baselines (CIS/STIG) run by administrators, golden-image build pipelines, decommissioning workflows, and endpoint protection or compliance agents that disable legacy services and block SMB or RDP inbound."
    tuning_guidance = "Add approved hardening and deployment tooling to %global_allowed_admin_tools and trusted administrator accounts to %global_allowed_admin_users. Both events are excluded using these lists. If a client runs scheduled baseline enforcement, scope it by parent process in %global_allowed_admin_tools rather than loosening the regexes."

  events:
    $svc.metadata.event_type = "PROCESS_LAUNCH"
    $svc.target.process.file.full_path = /\\sc\.exe$/ nocase
    $svc.target.process.command_line = /\bconfig\b/ nocase
    $svc.target.process.command_line = /\bstart\s*=\s*disabled\b/ nocase
    $svc.target.process.command_line = /\b(termservice|umrdpservice|sessionenv|lanmanserver|winrm|remoteregistry|sshd|ssh-agent)\b/ nocase
    not $svc.principal.process.file.full_path in %global_allowed_admin_tools
    not $svc.principal.user.userid in %global_allowed_admin_users
    $svc.principal.hostname = $hostname

    $fw.metadata.event_type = "PROCESS_LAUNCH"
    $fw.target.process.file.full_path = /\\netsh\.exe$/ nocase
    $fw.target.process.command_line = /\badvfirewall\s+firewall\s+add\s+rule\b/ nocase
    $fw.target.process.command_line = /\bdir\s*=\s*in\b/ nocase
    $fw.target.process.command_line = /\baction\s*=\s*block\b/ nocase
    $fw.target.process.command_line = /\blocalport\s*=\s*"?([0-9,\-]*,)?(22|135|139|445|3389|5985|5986)\b/ nocase
    not $fw.principal.process.file.full_path in %global_allowed_admin_tools
    not $fw.principal.user.userid in %global_allowed_admin_users
    $fw.principal.hostname = $hostname

    $svc.metadata.event_timestamp.seconds <= $fw.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1668")
    $primary_entity = array_distinct($hostname)
    $acting_users = array_distinct($svc.principal.user.userid)
    $service_commands = array_distinct($svc.target.process.command_line)
    $firewall_commands = array_distinct($fw.target.process.command_line)
    $event_count = count($svc.metadata.id)

  condition:
    $svc and $fw
}
