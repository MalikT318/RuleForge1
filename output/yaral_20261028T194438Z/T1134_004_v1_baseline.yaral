/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:59:08.155459+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_Core_System_Process_Spawns_Shell_PPID_Spoof {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or LOLBin launched with a core Windows system process (lsass, csrss, smss, wininit, winlogon, lsm, audiodg, fontdrvhost, dwm) as its apparent parent. These processes never legitimately spawn interactive shells or script hosts. This lineage is the classic result of Parent PID spoofing (CreateProcess with PROC_THREAD_ATTRIBUTE_PARENT_PROCESS), used to inherit a SYSTEM token or hide the true parent."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process creation telemetry (Sysmon Event ID 1 or Security Event 4688 with parent process name) populating principal.process.file.full_path and target.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Winlogon-launched accessibility or recovery utilities (Utilman/sticky-keys style debugging), EDR or security agents injecting helper processes, crash and debugging tooling, and custom credential providers or logon helpers launching helper binaries."
    tuning_guidance = "Add approved agents to %global_allowed_security_tools and approved administrative or deployment tooling to %global_allowed_admin_tools. If a specific parent/child pair is legitimate in a client environment, tune the child regex for that client rather than widening the parent list."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(lsass|csrss|smss|wininit|winlogon|lsm|audiodg|fontdrvhost|dwm)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|rundll32|regsvr32|mshta|wscript|cscript|wmic|msbuild|installutil|regasm|regsvcs|certutil|bitsadmin)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $spoofed_parent = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
