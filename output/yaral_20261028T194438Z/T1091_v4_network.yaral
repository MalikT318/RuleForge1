/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:34:19.956007+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Network_Egress_From_Removable_Drive_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process executing from a non-system drive letter (D: to Z:), the typical mount point for USB or other removable media, that opens a network connection to an external address. This network-side signal suggests removable-media-borne malware, such as an Autorun payload or a renamed executable on a USB stick, beaconing out or retrieving a second stage after being run on the host."
    mitre_tactic = "Lateral Movement, Initial Access"
    mitre_technique = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the initiating process image path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable applications run from a USB drive by users (browsers, chat clients, sync tools), line-of-business software installed on secondary fixed data volumes (D:, E:) on servers, applications launched from mapped network drives or virtual disks that use a drive letter, and software installers run from mounted ISO or media images."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_remote_mgmt, %global_allowed_security_tools or %global_allowed_backup_processes. Add known-good external destinations to %global_allowed_domains. On servers with secondary fixed volumes, scope the rule to workstation assets or add the application's parent path to %global_allowed_script_hosts. Raise severity when the same host also shows a USB device insertion or an Autorun-related registry change."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^[d-z]:\\/ nocase
    not $net.principal.process.file.full_path = /^[d-z]:\\(windows|program files|program files \(x86\)|programdata)\\/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
