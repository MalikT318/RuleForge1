/*
  MITRE Technique : T1546.007 - Netsh Helper DLL
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:09:24.471756+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_007_Netsh_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects netsh.exe initiating a network connection to an external (non-internal) address. Netsh normally configures local network settings and does not make outbound connections to the internet. A malicious Netsh helper DLL loaded into netsh.exe (persistence via HKLM\\SOFTWARE\\Microsoft\\Netsh) typically beacons out from inside the netsh.exe process, so this surfaces the network-side result of the technique regardless of the DLL name, path, or hash."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.007"
    mitre_technique_name = "Event Triggered Execution: Netsh Helper DLL"
    log_prerequisites = "Requires endpoint network telemetry that records the originating process for each connection (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources: VPN or network-management software that invokes netsh.exe and proxies traffic through it, netsh http or winhttp proxy commands that reach a remote PAC/WPAD host, netsh trace or capture tooling that uploads results, and EDR sensors that attribute traffic to the wrong process (PID reuse)."
    tuning_guidance = "Add known-good external destination domains to %global_allowed_domains and approved automation accounts to %global_allowed_service_accounts. If the telemetry source attributes traffic poorly, validate the process attribution before adding exclusions. Correlate hits with REGISTRY_MODIFICATION events under HKLM\\SOFTWARE\\Microsoft\\Netsh on the same host for triage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\netsh\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
