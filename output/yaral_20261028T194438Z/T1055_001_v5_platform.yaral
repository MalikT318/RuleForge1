/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:46:42.125165+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_Sensitive_Process_Loads_DLL_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a core Windows system process (lsass, winlogon, services, svchost, spoolsv, csrss, wininit, smss) loading a DLL from a user-writable location such as a user profile, ProgramData, Public or Windows\\Temp. This catches the RESULT of DLL injection (LoadLibrary via remote thread, module stomping, malicious SSP/provider loading) through module-load telemetry. It does not rely on process-creation command lines. It is Windows-only, because the supplied target platform and log source are both Windows."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires EDR or Sysmon-equivalent image/module-load telemetry (Sysmon Event ID 7) normalised to PROCESS_MODULE_LOAD, with principal.process.file.full_path (loading process) and target.file.full_path (loaded DLL) populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party credential providers, password filters or AV/DLP/EDR components that load from ProgramData; print-driver or port-monitor DLLs staged by spoolsv from non-standard paths; software installers or patching tools briefly loading modules from Windows\\Temp; developer or test hosts."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and approved deployment or patching binaries to %global_allowed_admin_tools (matched on the loading process full path). If a client has a legitimate ProgramData-based provider, scope it by adding the loading process to those lists rather than editing the regex. Pair with a prevalence check on the DLL path before escalating."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.principal.process.file.full_path = /\\(lsass|winlogon|services|svchost|spoolsv|csrss|wininit|smss)\.exe$/ nocase
    $mod.target.file.full_path = /\.dll$/ nocase
    $mod.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\\$recycle\.bin\\)/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $loaded_dll = array_distinct($mod.target.file.full_path)
    $affected_user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
