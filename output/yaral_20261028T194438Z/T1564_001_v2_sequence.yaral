/*
  MITRE Technique : T1564.001 - Hidden Files and Directories
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:13:45.444987+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_001_Explorer_Hidden_Files_Setting_Then_Staged_Executable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a non-Explorer process changing the Explorer Advanced 'Hidden', 'ShowSuperHidden' or 'SuperHidden' values, which hide hidden and protected-OS files from the user. Within 10 minutes the same user on the same host then drops executable or script content into a user-writable staging location. Registry-based and file-based sequence logic that complements command-line detections for attrib-style hiding."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.001"
    mitre_technique_name = "Hide Artifacts: Hidden Files and Directories"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION with registry key, value name and acting process) and file creation telemetry (FILE_CREATION with target path and acting process), both with principal hostname and user populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or logon scripts that enforce Folder Options, user profile customisation tools, IT imaging and provisioning scripts, software installers that drop binaries into ProgramData or AppData shortly after a profile settings change, developers toggling hidden-file visibility via scripts."
    tuning_guidance = "Add approved deployment, imaging and configuration tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add known installer or updater service accounts to %global_allowed_service_accounts. If GUI-driven changes are noisy, confirm that explorer.exe is populated as the registry writer so it stays excluded. Extend the staging path or extension regex per client if needed."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced$/ nocase
    $reg.target.registry.registry_value_name = /^(Hidden|ShowSuperHidden|SuperHidden)$/ nocase
    not $reg.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname
    $reg.principal.user.userid = $user

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(ProgramData|Users\\[^\\]+\\AppData\\(Local|Roaming)|Users\\Public|Windows\\Temp)\\.*\.(exe|dll|scr|bat|cmd|ps1|vbs|js|hta)$/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $user

    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $affected_user = array_distinct($reg.principal.user.userid)
    $registry_value_names = array_distinct($reg.target.registry.registry_value_name)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $dropped_file_count = count($file.metadata.id)

  condition:
    $reg and $file
}
