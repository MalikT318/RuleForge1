/*
  MITRE Technique : T1102.001 - Dead Drop Resolver
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:53:47.583694+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_001_Script_Client_Fetch_Of_Raw_Paste_Content {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser HTTP client (scripting runtime, Windows HTTP stack or command-line downloader user agent) issuing a GET to an external web service for raw, paste or snippet style content. This is the network-side pattern of malware reading a dead drop resolver on a legitimate user-content web service to learn its real C2 address. Matching is on the request pattern, not on any named service or domain."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.001"
    mitre_technique_name = "Web Service: Dead Drop Resolver"
    log_prerequisites = "Requires proxy or firewall logs normalised to UDM NETWORK_HTTP with network.http.method, network.http.user_agent and target.url populated. TLS inspection is needed for URL path visibility on HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers and admins pulling raw scripts or configs with curl, Python or PowerShell; package managers and CI agents fetching raw files; software update components using BITS or WinHTTP against content hosting services; monitoring scripts reading public status or paste pages."
    tuning_guidance = "Add known-good external domains (code or content hosting used by the client, update services) to %global_allowed_domains. Narrow or extend the user-agent and URL path regexes per client proxy log format. Raise severity when the same source host repeats the request at regular intervals."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.user_agent = /(WindowsPowerShell|WinHttp|Microsoft BITS|python-requests|python-urllib|Go-http-client|curl\/|Wget|Java\/|okhttp|libwww|node-fetch|axios)/ nocase
    $http.target.url = /\/(raw|paste|pastes|snippet|snippets|rawfile)(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1102.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
