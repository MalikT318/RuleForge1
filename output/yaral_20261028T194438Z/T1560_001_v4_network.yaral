/*
  MITRE Technique : T1560.001 - Archive via Utility
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:58:05.220713+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_001_Archive_Utility_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file compression or archiving utility (cabinet tools such as diantz/makecab, tar, or third-party archivers such as 7-Zip, WinRAR and WinZip) initiating a network connection to a non-internal address. Archivers do not normally talk to the internet. This pattern can indicate remote data staging (diantz fetching and compressing remote files) or archived data being sent out. It is a network-side view and complements process command-line detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.001"
    mitre_technique_name = "Archive Collected Data: Archive via Utility"
    log_prerequisites = "Requires endpoint network telemetry that attributes outbound connections to the originating process (EDR or Sysmon Event ID 3 equivalent) and populates principal.process.file.full_path and target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party archivers performing update or licence checks (WinRAR, WinZip, 7-Zip installers); archivers opening files on remote UNC/WebDAV shares that resolve to external addresses; software deployment tools that invoke makecab or tar to fetch packages; admins extracting archives from approved external repositories."
    tuning_guidance = "Add approved update or vendor domains to %global_allowed_domains. Add sanctioned deployment or packaging tooling to %global_allowed_admin_tools. Add approved backup tooling to %global_allowed_backup_processes. Ensure %rfc1918_internal covers the customer's internal address space. Raise severity for servers or hosts holding sensitive data."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(diantz|makecab|tar|7z|7za|7zg|rar|unrar|winrar|wzzip|winzip32|winzip64)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1560.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $archive_process = array_distinct($net.principal.process.file.full_path)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
