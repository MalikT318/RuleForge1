/*
  MITRE Technique : T1659 - Content Injection
  Tactic(s)       : Initial Access, Command and Control
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:02:25.132953+00:00
  Reference       : https://attack.mitre.org/techniques/T1659
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1659_Plaintext_HTTP_Executable_Content_Delivery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows client retrieving an executable, installer, script or archive payload over unencrypted HTTP from an external destination. Plaintext transfers of executable content can be modified in transit by a man-in-the-middle or man-on-the-side adversary, for example a compromised edge device or ISP-level injector serving a fake update or replaced download. Detection relies only on proxy and firewall URL telemetry and does not depend on endpoint process fields."
    mitre_tactic = "Initial Access, Command and Control"
    mitre_technique = "T1659"
    mitre_technique_name = "Content Injection"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url populated. TLS inspection is not required, because the rule only fires on cleartext HTTP URLs."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate plaintext software distribution (Windows Update/Delivery Optimization CAB/MSU packages, vendor update services, CRL/OCSP-adjacent downloads, legacy internal-facing vendor portals, package mirrors served over HTTP), vulnerability scanners and web crawlers, and admins downloading tools over HTTP."
    tuning_guidance = "Add known-good update and vendor domains to %global_allowed_domains (matched against target.hostname). Add scanner source addresses to %global_allowed_scanners. Narrow or extend the extension list per client. Raise severity for clients that enforce HTTPS-only policy, where any hit is anomalous."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /^http:\/\/[^\/]+\/[^?#]*\.(exe|msi|msu|cab|dll|scr|hta|vbs|vbe|js|jse|ps1|bat|cmd|jar|iso|img|zip)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1659")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
