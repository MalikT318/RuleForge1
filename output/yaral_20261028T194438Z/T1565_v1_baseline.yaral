/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:36:42.307346+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_Linux_Direct_Datastore_File_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects in-place modification of database or datastore files under /var/lib by a general-purpose utility (sed -i, truncate, tee, dd of=). Legitimate datastores are changed through their own engines, so editing their on-disk files directly suggests stored-data manipulation that bypasses application and audit controls."
    mitre_tactic = "Impact"
    mitre_technique = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with full command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "DBA maintenance or manual recovery work, restore or migration scripts using dd or tee, configuration management touching datastore files, and storage or snapshot tooling run by approved administrators."
    tuning_guidance = "Add approved admin tooling to %global_allowed_admin_tools, backup and restore software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. If a client runs other datastores under /var/lib, extend the directory alternation in the command_line regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(sed|truncate|tee|dd)$/ nocase
    $proc.target.process.command_line = /(\bsed\b.*\s(-[a-z]*i\S*|--in-place\S*)\s.*|\btruncate\b.*|\btee\b.*|\bdd\b.*\bof=)\/var\/lib\/(mysql|mariadb|postgresql|pgsql|mongodb|mongo|redis|couchdb|elasticsearch|influxdb|cassandra)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $tool_path = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
