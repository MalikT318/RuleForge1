/*
  MITRE Technique : T1653 - Power Settings
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:56:43.928411+00:00
  Reference       : https://attack.mitre.org/techniques/T1653
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1653_Powercfg_Disable_Sleep_Hibernate_Timeout {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects powercfg.exe being used to stop a Windows host from sleeping, hibernating, or turning off the display or disk. It matches the combination of the powercfg change or setvalueindex switches, a sleep, hibernate, video or disk timeout setting, and a value of 0 (never), or hibernation being turned off. Adversaries use this to keep an infected host awake and extend access."
    mitre_tactic = "Persistence"
    mitre_technique = "T1653"
    mitre_technique_name = "Power Settings"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Kiosk, digital signage, point-of-sale and lab or server build scripts that disable sleep. Administrators or helpdesk staff troubleshooting power issues. Presentation or conference-room provisioning. VDI golden-image preparation. Software installers or RMM and deployment tools that temporarily prevent sleep during long-running jobs."
    tuning_guidance = "Add approved deployment, imaging and RMM parent processes to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. For kiosk or signage fleets, consider scoping the rule by asset group in the SIEM, or exclude the provisioning parent process. Raise the severity when the parent process is a script host, an Office application, or a process running from a user-writable directory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\powercfg\.exe$/ nocase
    (
      $proc.target.process.command_line = /\s[\/-](change|x)\s+[\/-]?(standby|hibernate|monitor|disk)-timeout-(ac|dc)\s+0(\s|"|$)/ nocase or
      $proc.target.process.command_line = /\s[\/-](hibernate|h)\s+off(\s|"|$)/ nocase or
      $proc.target.process.command_line = /\sset(ac|dc)valueindex\s+\S+\s+\S+\s+(standbyidle|hibernateidle|videoidle|diskidle|unattendsleep)\s+0(\s|"|$)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1653")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
