/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:41:52.096673+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_ActiveSetup_Dropped_Payload_Then_StubPath {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an executable or script written to a user-writable or staging location, followed within 10 minutes on the same host by a StubPath value being set under the Active Setup Installed Components registry key. This sequence indicates Active Setup persistence, where the dropped payload runs at the next user logon."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires endpoint file-creation telemetry and registry value-set telemetry (EDR or Sysmon Event IDs 11 and 13) with the registry value name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that stage a helper in ProgramData or Temp and register an Active Setup component (browsers, Office, runtimes, VPN clients, driver packages); enterprise deployment tooling; image-build or golden-image processes."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools if they write to this key. Review the writer_processes and dropped_files outcome fields to identify recurring benign installers per client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\|users\\public\\|programdata\\|windows\\temp\\|temp\\).*\.(exe|dll|bat|cmd|ps1|vbs|vbe|js|jse|hta|scr)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Active Setup\\Installed Components\\/ nocase
    $reg.target.registry.registry_value_name = /^StubPath$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $stubpath_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
