/*
  MITRE Technique : T1204.002 - Malicious File
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:01:56.899600+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_002_Burst_Of_Lure_File_Drops_On_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several high-risk lure or script file types (scr, pif, cpl, hta, js, vbs, iso, lnk, and similar) are written to user-writable locations such as Downloads, Desktop, Temp or the mail/browser cache. The writer is a mail client, browser, archiver, Office app or Explorer, and all writes land on one host within ten minutes. One such file is common. A burst suggests an attachment or archive being unpacked for user execution (T1204.002)."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.002"
    mitre_technique_name = "User Execution: Malicious File"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the writing process path and the full target file path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or admins extracting script repositories, users downloading ISO or script bundles, software installers unpacking .cpl/.js/.lnk files to Temp, login-script deployment, and browser-based download of multiple legitimate installers."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools, automation or build accounts to %global_allowed_service_accounts, and security agents that drop files to %global_allowed_security_tools. Raise the #file threshold on developer or IT workstation groups. Remove noisy extensions such as lnk or js if the environment produces many of them."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\users\\[^\\]+\\(downloads|desktop|appdata\\local\\temp|appdata\\local\\microsoft\\windows\\inetcache|appdata\\local\\microsoft\\olk)\\.*\.(scr|pif|cpl|hta|js|jse|vbs|vbe|wsf|iso|img|lnk|chm|reg)$/ nocase
    $file.principal.process.file.full_path = /\\(outlook|olk|chrome|msedge|firefox|brave|opera|winword|excel|powerpnt|7zfm|7zg|winrar|explorer|teams|thunderbird)\.exe$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1204.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($file.principal.user.userid)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)

  condition:
    #file >= 4
}
