/*
  MITRE Technique : T1127.002 - ClickOnce
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:38:45.339527+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_002_ClickOnce_Dropped_Binary_Executed_By_Dfsvc {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects the ClickOnce deployment host (dfsvc.exe) writing an executable into the per-user ClickOnce application cache (AppData\\Local\\Apps\\2.0) and that same file then being launched as a child of dfsvc.exe within ten minutes. This sequence is the install-then-run pattern of ClickOnce proxy execution. It is correlated on file creation and process lineage rather than command-line matching."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.002"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: ClickOnce"
    log_prerequisites = "Requires Windows endpoint telemetry (EDR or Sysmon) providing both FILE_CREATION events with the writing process path and PROCESS_LAUNCH events with parent process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate internal line-of-business ClickOnce applications, vendor software that deploys through ClickOnce, and first-run installs or self-updates of ClickOnce apps such as some reporting or engineering tools."
    tuning_guidance = "Add approved ClickOnce application binaries to %global_allowed_admin_tools, and service or kiosk accounts that legitimately run ClickOnce apps to %global_allowed_service_accounts. Consider raising severity when the user is not a member of the software-publishing population or when the host is a server."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\dfsvc\.exe$/ nocase
    $file.target.file.full_path = /\\AppData\\Local\\Apps\\2\.0\\.+\.exe$/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\dfsvc\.exe$/ nocase
    $proc.target.process.file.full_path = /\\AppData\\Local\\Apps\\2\.0\\.+\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1127.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $executed_binary = array_distinct($proc.target.process.file.full_path)
    $executing_users = array_distinct($proc.principal.user.userid)
    $child_command_lines = array_distinct($proc.target.process.command_line)
    $file_event_count = count($file.metadata.id)

  condition:
    $file and $proc
}
