/*
  MITRE Technique : T1564.003 - Hidden Window
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:18:04.611083+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_003_Linux_Hidden_Autostart_Desktop_Entry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an XDG autostart .desktop entry (per-user or system-wide) that is either a dot-prefixed hidden filename or written by a shell or scripting interpreter rather than a desktop application or package manager. Autostart entries let an implant launch silently at graphical login with no visible window, and the dot-prefixed filename hides the entry from default file-manager listings. Provides file-telemetry coverage that does not depend on process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.003"
    mitre_technique_name = "Hide Artifacts: Hidden Window"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd watches (-w) on /etc/xdg/autostart and ~/.config/autostart, normalized to UDM FILE_CREATION with principal process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Dotfile and provisioning scripts (Ansible, cloud-init, user onboarding scripts) that write autostart entries; developers installing desktop apps from tarballs via install scripts; desktop environment setup scripts."
    tuning_guidance = "Add approved provisioning or configuration-management binaries to %global_allowed_admin_tools, approved automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Hosts without a graphical desktop (servers) can be raised in severity since autostart entries should never appear there."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/home\/[^\/]+|\/root)\/\.config\/autostart\/[^\/]+\.desktop$|^\/etc\/xdg\/autostart\/[^\/]+\.desktop$/ nocase
    (
      $file.target.file.full_path = /\/\.[^\/]+\.desktop$/ nocase or
      $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|curl|wget|nc|ncat|socat)$/ nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $autostart_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
