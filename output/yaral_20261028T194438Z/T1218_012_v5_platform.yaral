/*
  MITRE Technique : T1218.012 - Verclsid
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:58:29.994443+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_012_Verclsid_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects verclsid.exe (Extension CLSID Verification Host) making an outbound network connection to a non-internal address. Verclsid normally only verifies local shell extension CLSIDs and has no legitimate reason to talk to external hosts. External connections indicate remote COM scriptlet (SCT) retrieval or a proxied payload download. This is a network-behaviour detection and complements command-line rules. The technique is Windows-only, so the rule targets Windows telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.012"
    mitre_technique_name = "System Binary Proxy Execution: Verclsid"
    log_prerequisites = "Requires Windows endpoint network telemetry with process attribution (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are proxy-aware or VPN agents that hook shell processes and cause verclsid.exe to resolve network-based shell extensions (UNC or WebDAV paths), certificate revocation or CRL lookups triggered by signature verification, and sandbox or detonation hosts used for testing."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains and approved management or scanner destinations to %global_allowed_mgmt_sources. Exclude detonation or lab hosts by adding their hostnames to %global_allowed_scanners. If WebDAV or UNC shell extensions are used legitimately, review destinations before allowlisting."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\verclsid\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
