/*
  MITRE Technique : T1211 - Exploitation for Stealth
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:18:24.603078+00:00
  Reference       : https://attack.mitre.org/techniques/T1211
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1211_Audit_Logging_Config_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change that stops, disables, deletes or alters an audit-logging pipeline (trail, log sink, diagnostic or flow-log setting) in a cloud control plane. Exploitation for stealth often shows up as the resulting logging-configuration state change, which is visible even when the exploit and its payload are not. Covers the SETTING_MODIFICATION layer instead of process or command-line telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1211"
    mitre_technique_name = "Exploitation for Stealth"
    log_prerequisites = "Cloud control-plane audit logs ingested and parsed to UDM, with metadata.product_event_type populated with the API or operation name, and principal.user.userid populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Planned logging re-architecture, cloud platform or landing-zone automation, IaC pipelines rotating log destinations, log retention or cost-optimisation changes by cloud administrators, and security tooling reconfiguring log sinks."
    tuning_guidance = "Add approved automation identities to %global_allowed_service_accounts, named cloud administrators to %global_allowed_admin_users, and approved cloud or identity principals to %global_allowed_cloud_principals. Review the operation names in $operation to extend or narrow the regex for your tenant's logging APIs."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(stop|disable|suspend|delete|remove|update|put|modify|patch|set).*(logging|trail|logsink|sink|auditconfig|diagnosticsetting|eventselector|flowlog)|(diagnosticsettings|logsinks|sinks)\/(write|delete)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1211")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $target_resource = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
