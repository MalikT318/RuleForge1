/*
  MITRE Technique : T1526 - Cloud Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:26:14.770841+00:00
  Reference       : https://attack.mitre.org/techniques/T1526
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1526_IaaS_Discovery_Role_Granted_Via_Identity_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a permission change in identity provider directory audit logs that grants a read-only, reader, viewer or auditor style role to an account. This is a state change that enables cloud service and resource enumeration, so it is a precursor to Cloud Service Discovery. It pivots on the resulting permission change rather than on command lines or API read calls, which are high volume and easy to hide. Grants made by approved administrators and automation accounts are excluded."
    mitre_tactic = "Discovery"
    mitre_technique = "T1526"
    mitre_technique_name = "Cloud Service Discovery"
    log_prerequisites = "Identity provider directory/audit logs that record role or permission assignments, normalised to USER_CHANGE_PERMISSIONS with the assigned role name in target.resource.attribute.roles.name. Role-assignment auditing must be enabled in the tenant."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Onboarding of new staff, auditors or compliance reviewers; access reviews; just-in-time or privileged access management tooling that grants reader roles; joiner/mover/leaver automation; vendor or MSSP accounts being given read-only visibility."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users. Add provisioning and automation identities to %global_allowed_service_accounts. Add approved cloud or identity service principals to %global_allowed_cloud_principals. If the role regex is too broad, narrow it to the reader-type roles that are sensitive in your tenant, for example global or security reader roles."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.resource.attribute.roles.name = /(reader|viewer|auditor|read[\s_\-]?only)/ nocase
    $perm.principal.user.userid != ""
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1526")
    $primary_entity = array_distinct($perm.target.user.userid)
    $granting_actor = array_distinct($perm.principal.user.userid)
    $granted_roles = array_distinct($perm.target.resource.attribute.roles.name)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    $perm
}
