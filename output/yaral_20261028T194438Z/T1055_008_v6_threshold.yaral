/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:55:33.324585+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Mass_Process_Access_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of process-handle or process-attach events (ptrace-style access) from a single Linux host within 10 minutes, where one process repeatedly accesses other processes. A single attach is routine debugging. Repeated attaches from the same host fit ptrace injection, a process-memory sweep, or an injection tool probing for a viable victim. This rule uses process-access telemetry rather than process-creation command lines, so it complements command-line rules and does not duplicate them."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR or auditd with the ptrace syscall audited (for example -a always,exit -F arch=b64 -S ptrace), normalised to PROCESS_OPEN with principal and target process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Interactive debugging by developers (gdb, strace, ltrace, perf), crash handlers and core-dump collectors, language-runtime profilers and APM agents, container runtime tooling, CI test harnesses, and anti-cheat or sandbox software."
    tuning_guidance = "Add approved debugger, profiler and APM binaries to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Add automation identities to %global_allowed_service_accounts. Raise the #open threshold on developer or build hosts. Risk score is raised automatically when the target is a privileged long-running daemon such as sshd, systemd, cron or dbus-daemon."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.hostname = $host
    $open.principal.process.file.full_path = /^\/.+/
    $open.principal.process.pid != $open.target.process.pid
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($open.target.process.file.full_path = /\/(sshd|systemd|init|cron|crond|dbus-daemon|login)$/, 90, 70))
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($host)
    $event_count = count($open.metadata.id)
    $source_processes = array_distinct($open.principal.process.file.full_path)
    $target_processes = array_distinct($open.target.process.file.full_path)
    $source_users = array_distinct($open.principal.user.userid)

  condition:
    #open >= 5
}
