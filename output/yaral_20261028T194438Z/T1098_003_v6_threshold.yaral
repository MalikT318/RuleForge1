/*
  MITRE Technique : T1098.003 - Additional Cloud Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:44:50.262988+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_003_IdP_Rapid_Role_Assignments_Single_Actor {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single actor performs several permission or role assignment changes within ten minutes. One role assignment is routine administration. A burst from one account is consistent with an adversary granting additional cloud roles to a compromised or attacker-controlled identity to establish persistent privileged access."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.003"
    mitre_technique_name = "Account Manipulation: Additional Cloud Roles"
    log_prerequisites = "Identity provider directory audit logs (role and permission assignment events) normalised to USER_CHANGE_PERMISSIONS with principal.user.userid populated for the acting account."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Bulk onboarding or offboarding by helpdesk or IAM teams, joiner/mover/leaver automation, privileged access management tools activating or expiring just-in-time role assignments, tenant migrations, and delegated admin changes during scheduled projects."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation and provisioning accounts to %global_allowed_service_accounts, and approved identity governance service principals to %global_allowed_cloud_principals. Raise the #perm threshold for tenants with heavy bulk provisioning. Lower it to 2 for high-security tenants. Review the $target_users and $event_count outcomes to separate bulk administration from privilege escalation."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid != ""
    $perm.principal.user.userid = $actor
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  match:
    $actor over 10m

  outcome:
    $event_count = count($perm.metadata.id)
    $risk_score = max(if($event_count >= 10, 90, if($event_count >= 5, 80, 65)))
    $mitre_technique_id = array_distinct("T1098.003")
    $primary_entity = array_distinct($actor)
    $target_users = array_distinct($perm.target.user.userid)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    #perm >= 3
}
