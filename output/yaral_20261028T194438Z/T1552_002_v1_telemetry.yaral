/*
  MITRE Technique : T1552.002 - Credentials in Registry
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:46:49.839982+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_002_Winlogon_Cleartext_Password_Registry_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the Winlogon DefaultPassword or AltDefaultPassword registry value. These values store an automatic-logon credential in cleartext, readable by any local user. Writing one exposes a credential in the registry (T1552.002). It also indicates an adversary planting or staging credentials for reuse. This rule detects the resulting registry state change, so it does not depend on command-line logging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.002"
    mitre_technique_name = "Unsecured Credentials: Credentials in Registry"
    log_prerequisites = "Requires Windows endpoint registry telemetry that populates the registry key and value name (EDR registry events or Sysmon Event ID 12/13), normalised to UDM REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or imaging/deployment tooling configuring automatic logon for kiosks, lab machines, digital signage, or POS terminals. Golden image builds and some OEM provisioning scripts."
    tuning_guidance = "Add approved deployment and provisioning binaries to %global_allowed_admin_tools. Add named administrators who legitimately configure autologon to %global_allowed_admin_users. Add EDR and security agents to %global_allowed_security_tools. For kiosk estates, consider scoping by hostname through a client-specific copy of the rule."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Windows NT\\CurrentVersion\\Winlogon/ nocase
    $reg.target.registry.registry_value_name = /^(Alt)?DefaultPassword$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)

  condition:
    $reg
}
