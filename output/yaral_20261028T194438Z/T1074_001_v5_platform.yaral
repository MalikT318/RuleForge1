/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:19:02.153752+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_Bulk_Copy_To_Local_Staging_Dir {
  // Note: the "alternate platform" angle conflicts with the mandatory Windows platform and log_source requirements.
  // The mandatory Windows requirement is followed here. This variant covers native Windows bulk-copy utilities
  // that move user data into common staging directories.
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects native Windows bulk-copy utilities (robocopy/xcopy) recursively copying content from user profile data folders (Documents, Desktop, Downloads) into common world-writable or low-visibility staging locations (Users\\Public, ProgramData, Windows\\Temp, PerfLogs, Recycle Bin). This behaviour is typical of local data staging before archiving and exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Data Staged: Local Data Staging"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and migration scripts, profile migration during device refresh, IT deployment jobs, user data redirection tooling, and admins manually copying files for troubleshooting."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, IT tooling parents to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If profile migrations are frequent, scope exclusions by parent process or service account rather than by path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(robocopy|xcopy)\.exe$/ nocase
    $proc.target.process.command_line = /\\users\\[^\\]+\\(documents|desktop|downloads)(\\|"|\s|$)/ nocase
    $proc.target.process.command_line = /(\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\perflogs\\|\$recycle\.bin)/ nocase
    $proc.target.process.command_line = /\s\/(s|e|mir|mov|move)(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
