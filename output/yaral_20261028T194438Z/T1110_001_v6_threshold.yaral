/*
  MITRE Technique : T1110.001 - Password Guessing
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:05:03.774155+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_001_Firewall_Mgmt_Port_Connection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a high volume of connections from a single external source to one management service port (SSH, Telnet, FTP, RDP, SMB, VNC, MSSQL, MySQL, Oracle) on a single destination within 10 minutes. Each connection is benign on its own, but sustained repeated connections to an authentication service are consistent with password guessing against network-device or perimeter-exposed management interfaces."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.001"
    mitre_technique_name = "Brute Force: Password Guessing"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, monitoring or uptime probes polling management ports, remote administrators using automated tooling or reconnecting repeatedly over unstable links, file-transfer automation over FTP, NAT or proxy egress addresses that aggregate many legitimate users behind one source IP."
    tuning_guidance = "Add scanner and test sources to %global_allowed_scanners and approved administration source addresses to %global_allowed_mgmt_sources. Raise the #net threshold (default 20) for noisy environments, or lower it for exposed management planes. Remove the %rfc1918_internal source exclusion to also cover internal sources (lateral password guessing). Add or remove ports to match services actually exposed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 1521 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5900
    )
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    $net.target.port = $dst_port
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip, $dst_ip, $dst_port over 10m

  outcome:
    $risk_score = max(if($net.target.port = 21 or $net.target.port = 23 or $net.target.port = 3389, 75, 60))
    $mitre_technique_id = array_distinct("T1110.001")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $targeted_hosts = array_distinct($dst_ip)
    $targeted_ports = array_distinct($dst_port)

  condition:
    #net >= 20
}
