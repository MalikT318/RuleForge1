/*
  MITRE Technique : T1567.003 - Exfiltration to Text Storage Sites
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:59:50.607039+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_003_ESXi_Host_Outbound_Upload_To_External_Site {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host sending an HTTP POST or PUT with a scripted or command-line client user agent (curl, wget, python, etc.) to an external, non-allowlisted destination. ESXi hosts do not normally upload data to arbitrary internet sites. This is the network-side behaviour of exfiltration to text storage or paste sites, detected without hardcoding any site name."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.003"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Text Storage Sites"
    log_prerequisites = "Requires network telemetry (proxy, firewall with HTTP inspection, or network sensor) that attributes outbound HTTP requests to the ESXi host management IP or hostname and populates the HTTP method and user agent fields."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host or vendor update and telemetry uploads, approved support-bundle uploads to a vendor case portal, monitoring or log-forwarding agents that POST to external SaaS, and admin troubleshooting that uses curl or wget."
    tuning_guidance = "Add approved external destinations (vendor support, update, and monitoring domains) to %global_allowed_domains. Entries must match target.hostname exactly, so list the full hostnames. Add approved management or jump-host sources to %global_allowed_mgmt_sources. Add the hostname of any approved automation host to %global_allowed_service_accounts if it is the principal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /(curl|wget|python|libwww|go-http-client|busybox|urllib|powershell)/ nocase
    $net.principal.hostname != ""
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1567.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
