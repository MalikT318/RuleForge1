/*
  MITRE Technique : T1204.003 - Malicious Image
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:03:26.722542+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_003_IaaS_Compute_Launch_From_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a virtual machine or container workload through the cloud control plane by an identity that is not an approved automation, admin or cloud principal. Instances and containers launched from a backdoored or look-alike machine image or container image (public, community or marketplace) are created through these API calls, so this covers the deployment step of Malicious Image execution (for example, cryptominer images). The rule does not parse the image reference, because that field is not consistently normalised across providers. Triage should check the image source and owner in the raw audit record."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.003"
    mitre_technique_name = "User Execution: Malicious Image"
    log_prerequisites = "Cloud control-plane audit logging must be enabled and ingested with management write events (instance and container group creation) for all accounts, subscriptions and projects."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Developers or engineers launching instances manually, autoscaling and infrastructure-as-code pipelines running under identities not yet allow-listed, new-environment build-outs, disaster-recovery tests, CI runners that create ephemeral instances, and approved penetration tests."
    tuning_guidance = "Add pipeline, autoscaling and IaC identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named platform engineers to %global_allowed_admin_users. For higher fidelity, enrich in the SOAR playbook by checking whether the launched image is owned by the same account or tenant, and whether it comes from an approved image catalogue. Suppress by hostname or user for noisy build accounts."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /^(RunInstances|CreateContainerGroup|Microsoft\.Compute\/virtualMachines\/write|Microsoft\.ContainerInstance\/containerGroups\/write|(v1|beta)\.compute\.instances\.insert)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1204.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_call = array_distinct($cloud.metadata.product_event_type)
    $resource_name = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
