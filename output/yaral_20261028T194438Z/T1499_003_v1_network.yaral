/*
  MITRE Technique : T1499.003 - Application Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:20:20.279603+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_003_Inbound_Expensive_Request_Server_Error {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external client sending an HTTP request that targets a resource-intensive application feature (oversized result-set or page-size parameter, or a bare wildcard search) that the server answers with a 5xx error. The 5xx response shows the expensive request is straining the application, which is the observable result of an application exhaustion flood. Detection is by request shape and server response, not by tool or payload."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.003"
    mitre_technique_name = "Endpoint Denial of Service: Application Exhaustion Flood"
    log_prerequisites = "Requires perimeter firewall, reverse proxy or WAF logs normalised to NETWORK_HTTP with target.url, principal.ip and network.http.response_code populated. The protected web application is assumed to be hosted on Windows (for example IIS) behind the perimeter device."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate bulk export or reporting clients using large page-size parameters during back-end outages; partner integrations and API consumers; uptime or load-testing services not yet listed as authorised scanners; search crawlers hitting wildcard queries while the application is erroring for unrelated reasons."
    tuning_guidance = "Add authorised load-testing and vulnerability scanning sources to %global_allowed_scanners. Add known partner or integration source addresses to %global_allowed_mgmt_sources and extend the exclusion if needed. This rule fires per request, so use the SOAR playbook to aggregate by source IP and target hostname. For earlier warning, remove the response_code condition (higher volume). To suit the application's API conventions, adjust the parameter names and digit count in the URL regex (default is 4 or more digits)."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /[?&;](page_?size|per_?page|limit|rows|max_?results|count|top|take)=[0-9]{4,}|[?&;](q|query|search|keyword|term)=(\*|%2a|%25)(&|$)/ nocase
    $net.network.http.response_code >= 500
    $net.network.http.response_code <= 599
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1499.003")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $response_codes = array_distinct($net.network.http.response_code)

  condition:
    $net
}
