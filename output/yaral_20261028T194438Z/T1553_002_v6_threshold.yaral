/*
  MITRE Technique : T1553.002 - Code Signing
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:01:58.893809+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_002_Bulk_Code_Signing_Key_Material_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects several certificate or private-key container files (.pfx, .p12, .pvk, .spc, .snk) created on a single Windows host within 10 minutes. Staging or exporting multiple code signing credentials is a precursor to signing malware with stolen or created certificates. Any one file write is routine; the volume is the signal."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.002"
    mitre_technique_name = "Subvert Trust Controls: Code Signing"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon Event ID 11 or equivalent) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Build and CI servers that generate or restore signing certificates, PKI administrators exporting certificates, certificate enrollment and auto-renewal services, software developers working with strong-name keys (.snk), backup or restore of certificate stores, and IT provisioning scripts for device certificates."
    tuning_guidance = "Add approved PKI, build, and deployment tooling to %global_allowed_admin_tools. Add CI and build service accounts to %global_allowed_service_accounts. Add backup software to %global_allowed_backup_processes. Raise the #file threshold on developer or build hosts. Extend the extension list only if the environment uses other key container formats."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(pfx|p12|pvk|spc|snk)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1553.002")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $key_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
