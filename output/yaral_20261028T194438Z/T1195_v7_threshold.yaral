/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:39:22.960516+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_Linux_Package_Manager_Spawns_Download_Exec_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple download-and-execute, reverse-shell or staged-binary command lines spawned by a package manager or language runtime (npm, yarn, pip, gem, cargo, composer, node) on a single Linux host within 10 minutes. Install hooks that fetch and run remote payloads or stage executables in world-writable directories are a hallmark of a poisoned dependency or compromised software distribution channel."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with parent process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate install scripts that fetch installers via curl|sh (language version managers, vendor bootstrap scripts), native module builds that chmod and run helpers under /tmp, CI/CD build agents, and developer workstations installing dependencies."
    tuning_guidance = "Add approved build and deployment tooling to %global_allowed_admin_tools (matched on parent process path) and CI or build service accounts to %global_allowed_service_accounts. Raise the #proc threshold on build servers with heavy dependency churn. Review $parent_processes and $command_lines in the outcome to identify the offending package."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(npm|npx|yarn|pnpm|node|pip|pip3|pip3\.[0-9]+|gem|cargo|composer)$/ nocase
    $proc.target.process.command_line = /(curl|wget)\b[^|;&]*\|\s*(sudo\s+)?(ba|da|z)?sh\b|\/dev\/tcp\/|base64\s+(-d|--decode)|chmod\s+(\+x|[0-7]{3,4})\s+\/(tmp|dev\/shm|var\/tmp)\/|\b(nc|ncat|socat)\b.*\s-e\s/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.command_line, /(?i)\/dev\/tcp\/|\b(nc|ncat|socat)\b.*\s-e\s/), 90, 70))
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 3
}
