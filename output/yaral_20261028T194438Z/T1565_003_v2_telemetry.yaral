/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:43:13.151598+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_Linux_Data_Display_Binary_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of core data-display and data-query utilities (cat, ls, ps, netstat, ss, grep, jq and similar) in system binary directories by a process that is not a package manager or approved admin tool. Adversaries replace or patch these binaries so that data shown to operators or scripts is silently altered at runtime. The rule keys on the resulting file-integrity state change, not on command lines, so it still fires if command-line logging is evaded."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Data Manipulation: Runtime Data Manipulation"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w on /bin, /usr/bin, /sbin, /usr/sbin, /usr/local/bin with -p wa) normalised to UDM FILE_MODIFICATION with principal process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and unattended-upgrade jobs not matched by the built-in name exclusion, container image builds, live kernel or OS patching agents, configuration management tooling (Ansible, Puppet, Chef) replacing binaries, and busybox or alternatives updates."
    tuning_guidance = "Add approved patching and deployment tooling to %global_allowed_admin_tools, EDR and integrity agents to %global_allowed_security_tools, and backup or imaging software to %global_allowed_backup_processes. Extend or narrow the utility-name list in the target path regex per client baseline."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(usr\/(local\/)?)?s?bin\/(cat|tac|less|more|head|tail|ls|ps|top|htop|netstat|ss|ip|ifconfig|grep|egrep|awk|sed|sort|uniq|cut|column|date|df|du|who|w|last|lastlog|lsof|find|stat|file|wc|jq|journalctl|dmesg|md5sum|sha256sum|sha1sum|diff|cmp)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|packagekitd|unattended-upgrade|snapd|pacman|apk)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
