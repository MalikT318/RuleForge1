/*
  MITRE Technique : T1574.005 - Executable Installer File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:30:38.734923+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_005_Temp_Subdir_Exe_Dropped_Then_Run_As_System {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-SYSTEM process writes an executable into a subdirectory of a Temp folder, and a different SYSTEM-context process then launches that same file within 10 minutes. This is the installer-directory weakness: a low-privilege user plants or overwrites a binary in a world-writable installer unpack directory and a privileged installer runs it. Detection is based on file-write to process-launch correlation on the same path, not on command lines."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.005"
    mitre_technique_name = "Hijack Execution Flow: Executable Installer File Permissions Weakness"
    log_prerequisites = "Requires endpoint telemetry with FILE_CREATION events (including full path and acting user) and PROCESS_LAUNCH events with the acting user populated, from an EDR or Sysmon (Event IDs 11 and 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching agents that stage a package as a standard user and then run it as SYSTEM; self-extracting installers started by users who then elevate; Windows servicing and update components; developer build tools writing to Temp. Self-updaters for browsers and collaboration apps may also fit."
    tuning_guidance = "Add approved deployment, patching and RMM binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools; both are excluded on the writer and launcher sides. Narrow the Temp subdirectory regex if a client has a known noisy installer staging layout. If SYSTEM-level user IDs are normalised differently in a client's telemetry, adjust the SYSTEM-account regex on the launcher side."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(Windows\\Temp|AppData\\Local\\Temp)\\[^\\]+\\([^\\]+\\)*[^\\]+\.exe$/ nocase
    not $file.principal.user.userid = /(^|\\)(system|local service|network service)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    strings.to_lower($file.target.file.full_path) = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(Windows\\Temp|AppData\\Local\\Temp)\\[^\\]+\\([^\\]+\\)*[^\\]+\.exe$/ nocase
    $proc.principal.user.userid = /(^|\\)system$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname
    strings.to_lower($proc.target.process.file.full_path) = $path

    $file.principal.process.file.full_path != $proc.principal.process.file.full_path
    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.005")
    $primary_entity = array_distinct($hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)
    $launcher_process = array_distinct($proc.principal.process.file.full_path)
    $launcher_user = array_distinct($proc.principal.user.userid)
    $first_write_time = min($file.metadata.event_timestamp.seconds)
    $launch_time = max($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
