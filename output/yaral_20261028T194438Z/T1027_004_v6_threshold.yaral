/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:44:33.898769+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_Linux_Source_Code_Download_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host uses a command-line or scripted HTTP client to download several uncompiled source-code files (C, C++, Go, Rust, C#, Java, assembly) from external servers within 10 minutes. Adversaries deliver payloads as source and compile them on the victim to evade binary scanning. One such download is benign, but a burst from a non-browser client is a strong staging indicator."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url, target.hostname and network.http.user_agent populated. TLS inspection is needed to see URLs on HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers and build engineers fetching source tarballs or code files, CI/CD runners, package builders, DevOps bootstrap scripts, and educational or lab hosts."
    tuning_guidance = "Add trusted code-hosting, vendor and mirror domains to %global_allowed_domains. If the proxy does not populate principal.hostname, map the client IP to a hostname in the parser or enrichment. Raise the threshold on build-server segments. Keep internal destinations excluded via %rfc1918_internal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(c|cc|cpp|cxx|go|rs|cs|java|asm)(\?.*)?$/ nocase
    $http.network.http.user_agent = /(curl|wget|python-requests|python-urllib|go-http-client)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity = array_distinct($host)
    $event_count = count($http.metadata.id)
    $source_hosts = array_distinct($http.target.hostname)
    $downloaded_urls = array_distinct($http.target.url)

  condition:
    #http >= 4
}
