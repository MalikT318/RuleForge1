/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:51:13.193494+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Unexpected_Parent_Spawn {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter, or commonly hijacked Windows host process (the sacrificial processes used for Early Bird APC injection and process hollowing) launched by an unexpected parent: an Office application, web server worker, print spooler, or database service. This is a lineage-only detection with no command-line logic. It complements command-line rules by catching the process-creation stage of Early Bird style APC injection and post-exploitation from exploited server and document-handling processes."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with populated parent and child image paths (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins that legitimately launch rundll32 or script hosts; IIS applications that shell out to cmd or powershell for admin or deployment functions; SQL Server agent jobs or xp_cmdshell used by DBAs; print drivers or print management utilities launching rundll32 from the spooler; line-of-business apps that automate Office and run scripts."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts (for example, a known IIS deployment worker or SQL Agent job host). Add sanctioned management tooling to %global_allowed_admin_tools. Add EDR or AV agents that spawn helper processes to %global_allowed_security_tools. If a client heavily uses Office automation, narrow the child list to host processes only (svchost, dllhost, werfault, notepad) for that tenant."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|svchost|dllhost|werfault|notepad)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
