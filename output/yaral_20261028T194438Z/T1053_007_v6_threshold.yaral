/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:20:37.569921+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_K8s_Excessive_CronJob_Job_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity created five or more Kubernetes CronJob or Job objects through the API server within one hour. Each creation is normally benign, but bulk scheduling of orchestration jobs can indicate an adversary using the orchestrator for persistence, execution on multiple nodes, or privilege escalation. Built-in control-plane identities, such as the CronJob controller that spawns Jobs from a CronJob, are excluded."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes API server audit logs at Metadata level or higher, ingested and normalised to UDM RESOURCE_CREATION with principal.user.userid and target.url (request URI) populated. Verify that the batch API request path is present in target.url for your parser."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD pipelines and GitOps controllers deploying batch workloads, data and ML pipeline schedulers (workflow engines), Helm releases that install many Jobs, platform engineers bulk-applying manifests, and operators that create Jobs for backups, migrations, or certificate renewal."
    tuning_guidance = "Add CI/CD, GitOps and workflow-engine identities to %global_allowed_service_accounts, and platform engineers to %global_allowed_admin_users. Raise the #res threshold in busy clusters. Escalate when the identity is a human or a pod service account that does not normally create batch objects, or when the activity is paired with exec or privileged pod creation by the same user."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.target.url = /\/apis\/batch\/v1(beta1)?\/namespaces\/[^\/]+\/(cronjobs|jobs)(\?|$)/ nocase
    $res.principal.user.userid = $user
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_admin_users
    not $res.principal.user.userid = /^system:(kube-controller-manager|kube-scheduler|node:|serviceaccount:kube-system:(cronjob|job)-controller)/ nocase

  match:
    $user over 1h

  outcome:
    $risk_score = max(60)
    $event_count = count($res.metadata.id)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($res.principal.ip)
    $request_uris = array_distinct($res.target.url)

  condition:
    #res >= 5
}
