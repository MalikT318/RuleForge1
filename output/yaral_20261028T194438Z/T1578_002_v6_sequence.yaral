/*
  MITRE Technique : T1578.002 - Create Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:52:23.832337+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_002_Instance_Created_Then_Network_Policy_Loosened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the same cloud identity creating a new compute instance and then changing a network security policy (firewall rule, security group or network security rule) within 10 minutes. This matches the pattern of an adversary standing up a fresh instance and relaxing its security controls to bypass existing guardrails, stage data or mount snapshots."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.002"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Cloud Instance"
    log_prerequisites = "Requires cloud control-plane audit logs (management and admin activity events) ingested and normalised to UDM, with principal.user.userid and metadata.product_event_type populated for compute and network API calls."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines and CI/CD roles launching instances and attaching firewall rules in one deployment; autoscaling or provisioning automation; engineers legitimately building new environments; cloud migration or DR test tooling."
    tuning_guidance = "Add pipeline, automation and provisioning identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named platform admins to %global_allowed_admin_users. Widen or narrow the product_event_type regexes to match the client's cloud providers. Raise severity where the second event opens ingress to broad sources."

  events:
    $inst.metadata.event_type = "RESOURCE_CREATION"
    $inst.metadata.product_event_type = /(RunInstances|instances\.insert|instances\.bulkInsert|virtualMachines\/write|virtualMachineScaleSets\/write)/ nocase
    $inst.principal.user.userid = $user
    not $inst.principal.user.userid in %global_allowed_service_accounts
    not $inst.principal.user.userid in %global_allowed_cloud_principals
    not $inst.principal.user.userid in %global_allowed_admin_users

    $sec.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $sec.metadata.product_event_type = /(AuthorizeSecurityGroupIngress|AuthorizeSecurityGroupEgress|ModifySecurityGroupRules|CreateNetworkAclEntry|ReplaceNetworkAclEntry|firewalls\.(insert|patch|update)|networkSecurityGroups\/(write|securityRules\/write)|securityRules\/write)/ nocase
    $sec.principal.user.userid = $user
    not $sec.principal.user.userid in %global_allowed_service_accounts
    not $sec.principal.user.userid in %global_allowed_cloud_principals
    not $sec.principal.user.userid in %global_allowed_admin_users

    $inst.metadata.event_timestamp.seconds <= $sec.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1578.002")
    $primary_entity = array_distinct($inst.principal.user.userid)
    $instance_api_calls = array_distinct($inst.metadata.product_event_type)
    $policy_api_calls = array_distinct($sec.metadata.product_event_type)
    $created_resources = array_distinct($inst.target.resource.name)
    $modified_resources = array_distinct($sec.target.resource.name)
    $source_ips = array_distinct($inst.principal.ip)
    $instance_event_count = count($inst.metadata.id)
    $policy_event_count = count($sec.metadata.id)

  condition:
    $inst and $sec
}
