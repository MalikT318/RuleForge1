/*
  MITRE Technique : T1657 - Financial Theft
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:00:37.058975+00:00
  Reference       : https://attack.mitre.org/techniques/T1657
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1657_Ransom_Note_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a ransom-note style file (decryption or recovery instructions in a text, HTML, HTA, RTF or URL file) by a process that is not an approved tool or a browser. Ransom notes are the extortion artifact of ransomware, a common route to financial theft. The rule works on the resulting file artifact, so it still fires when command-line logging is evaded or the ransomware binary is renamed."
    mitre_tactic = "Impact"
    mitre_technique = "T1657"
    mitre_technique_name = "Financial Theft"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with populated target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security awareness or incident-response material saved to disk, ransomware research or sandbox hosts, documentation or help-desk articles about file recovery, backup or restore software writing its own instruction files, and file-sync clients replicating such documents."
    tuning_guidance = "Add approved security, backup and IT tooling to %global_allowed_security_tools, %global_allowed_backup_processes and %global_allowed_admin_tools. Exclude research or sandbox hosts through scoping or a hostname allowlist at the SOAR layer. If the rule is noisy, drop the broader 'ransom' keyword from the filename regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\[^\\]*(how[ _-]?to[ _-]?(decrypt|recover|restore)|decrypt[ _-]?(your[ _-]?)?(files|data|instructions)|recover[ _-]?(your[ _-]?)?(files|data)|restore[ _-]?(your[ _-]?)?(files|data)|read[ _-]?me[ _-]?(to[ _-]?)?(decrypt|restore|recover)|your[ _-]?files[ _-]?(are|have)[ _-]?(been[ _-]?)?encrypted|ransom)[^\\]*\.(txt|html|hta|rtf|url)$/ nocase
    not $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1657")
    $primary_entity = array_distinct($file.principal.hostname)
    $note_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
