/*
  MITRE Technique : T1529 - System Shutdown/Reboot
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:29:13.843460+00:00
  Reference       : https://attack.mitre.org/techniques/T1529
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1529_ESXi_Shutdown_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host shutdown, reboot or VM power-off command launched by an unexpected parent process. Expected parents are an interactive shell or the management agents. Anomalous parents are a binary running from a writable staging location (/tmp, /var/tmp, /dev/shm, /scratch, /vmfs/volumes), a script interpreter, a download utility, or a network-facing service daemon. This lineage points to scripted or remote-exploited impact activity such as ransomware precursors or destructive attacks, rather than an administrator typing a command."
    mitre_tactic = "Impact"
    mitre_technique = "T1529"
    mitre_technique_name = "System Shutdown/Reboot"
    log_prerequisites = "ESXi shell and process execution logging forwarded to Chronicle (shell.log, hostd) and normalised to PROCESS_LAUNCH with both parent and child process paths and the child command line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Patching or lifecycle automation that stages scripts under /tmp or /scratch and then reboots the host; configuration-management agents using python or perl wrappers; vendor or backup appliances that power-cycle VMs through scripts; maintenance windows where administrators run reboot scripts from a datastore."
    tuning_guidance = "Add approved automation parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Review the parent path in the alert, and if a legitimate patching workflow stages scripts in a writable directory, allowlist that parent by executable name rather than loosening the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch|vmfs\/volumes|var\/run)\/|\/(python[0-9.]*|perl|nc|ncat|wget|curl|openwsman|sfcb-[a-z]+|rhttpproxy|lighttpd)$/ nocase
    $proc.target.process.file.full_path = /\/(reboot|poweroff|halt|esxcli|vim-cmd|busybox)$/ nocase
    $proc.target.process.command_line = /(^|\/|\s)(reboot|poweroff|halt)(\s|$)|esxcli\s+system\s+shutdown\s+(poweroff|reboot)|hostsvc\/host_(shutdown|reboot)|vmsvc\/power\.(off|shutdown|reboot)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1529")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
