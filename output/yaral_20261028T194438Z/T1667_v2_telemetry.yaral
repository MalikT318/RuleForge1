/*
  MITRE Technique : T1667 - Email Bombing
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:08:33.041779+00:00
  Reference       : https://attack.mitre.org/techniques/T1667
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1667_Scripted_EML_Dropped_In_SMTP_Pickup_Queue {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting or interpreter process writing .eml message files into a Windows SMTP pickup or replay queue directory (IIS SMTP mailroot or Exchange Transport Pickup/Replay). A local script that bulk-generates messages into these queues, so the host's own SMTP service delivers them, is a way to mass-send mail and flood a target mailbox. The rule detects the file artifact, not the command line, so it still fires when command-line logging is evaded. It fires on each qualifying file creation, so a burst of alerts from one host is the email-bombing signature."
    mitre_tactic = "Impact"
    mitre_technique = "T1667"
    mitre_technique_name = "Email Bombing"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) that populates the writing process path and the target file path. Only applies to hosts that run IIS SMTP or Exchange Transport, or any host where a pickup directory exists."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business applications, monitoring or alerting scripts, and scheduled reporting jobs that legitimately drop .eml files into a pickup directory using PowerShell, Python or VBScript. Administrators testing mail flow or replaying messages manually."
    tuning_guidance = "Add approved script host or automation process paths, and hosts that run known mail-generating jobs, to %global_allowed_script_hosts. Consider alerting only when several alerts fire for the same host within a short period. Review the SOAR playbook for correlation with later inbound mail-volume alerts from the mail platform."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(mailroot|TransportRoles)\\(Pickup|Replay)\\[^\\]+\.eml$/ nocase
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|python[w]?|cmd|node|perl|ruby)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1667")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $queue_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
