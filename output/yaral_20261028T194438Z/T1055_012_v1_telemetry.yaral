/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:59:00.551842+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Process_Handle_To_Hollowing_Host_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process executing from a user-writable location (AppData, Temp, ProgramData, Public) that opens a handle to a core Windows system binary commonly used as a hollowing host (svchost, rundll32, dllhost, etc.). This is the handle-acquisition step of process hollowing, where the injector creates a suspended host process, then opens it to unmap and rewrite its memory. The rule works at the PROCESS_OPEN layer, so it does not depend on command-line logging."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires endpoint telemetry that records process handle access (Sysmon Event ID 10 or equivalent EDR process-open events) normalised to PROCESS_OPEN with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters staged in Temp or ProgramData that touch system processes, application launchers or game anti-cheat engines running from AppData, unlisted EDR/AV agents or backup agents, and developer debugging tools run from user profiles."
    tuning_guidance = "Add approved agents and tooling to %global_allowed_security_tools, %global_allowed_backup_processes and %global_allowed_admin_tools. Extend the host-binary list or writable-path regex per environment. If the telemetry source exposes the granted access mask, add a filter for VM write/operation and thread-context rights to cut volume further."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /(\\users\\[^\\]+\\appdata\\(local|roaming)\\|\\windows\\temp\\|\\programdata\\|\\users\\public\\|\\users\\[^\\]+\\(downloads|desktop)\\|\\temp\\)/ nocase
    $open.target.process.file.full_path = /\\windows\\(system32|syswow64)\\(svchost|rundll32|dllhost|regsvr32|werfault|msiexec|searchprotocolhost|wuauclt|taskhostw|conhost|notepad|calc)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $hollow_host_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
