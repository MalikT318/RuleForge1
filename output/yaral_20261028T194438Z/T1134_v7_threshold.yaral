/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:52:35.217034+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_Repeated_Runas_Alternate_Credential_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated process launches on a single host within 10 minutes that use runas-style alternate-credential switches (/netonly or /savecred combined with /user:). One such launch is routine, but a burst suggests token or credential manipulation to run under a different security context. Matching on the switch combination rather than the binary name means a renamed copy still alerts."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators using runas /netonly for cross-domain management consoles, helpdesk staff running tools under a support account, IT automation or login scripts that use /savecred, and lab or test environments."
    tuning_guidance = "Add approved admin tooling and parent processes to %global_allowed_admin_tools. Add named administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold in noisy environments. Review $distinct_users and $sample_commands in the outcome to separate admin workflows from abuse."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\/(netonly|savecred)\b/ nocase
    $proc.target.process.command_line = /\/user:/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity = array_distinct($host)
    $distinct_users = array_distinct($proc.principal.user.userid)
    $sample_commands = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 3
}
