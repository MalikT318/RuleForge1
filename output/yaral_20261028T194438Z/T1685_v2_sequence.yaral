/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:14:33.212992+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_Container_Security_Agent_Deleted_Then_Logging_Config_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a single identity deleting a security, monitoring or logging agent workload in a container cluster and then modifying logging, audit or telemetry configuration within ten minutes. This sequence indicates deliberate impairment of cluster visibility. It is based on control-plane audit activity, not process command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "Requires Kubernetes or managed-cluster control-plane audit logs ingested and normalised to UDM with principal.user.userid and target.resource.name populated for delete and configuration-change API calls."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Planned agent upgrades or re-deployments done by platform engineers, GitOps or CI/CD controllers that remove and re-apply monitoring workloads, cluster decommissioning, namespace clean-up jobs, and logging pipeline migrations."
    tuning_guidance = "Add GitOps controllers, CI/CD identities and platform automation accounts to %global_allowed_service_accounts. Add platform engineers to %global_allowed_admin_users. Add approved cloud identities to %global_allowed_cloud_principals. If a client uses unusual agent naming, extend the resource-name regexes per client."

  events:
    $del.metadata.event_type = "RESOURCE_DELETION"
    $del.target.resource.name = /(^|[-_.\/])(security|runtime-security|monitor|monitoring|sensor|edr|ids|ips|siem|threat|audit|auditd|collector|forwarder|(log|logging)-(agent|collector|forwarder|shipper))($|[-_.\/])/ nocase
    $del.principal.user.userid = $user
    not $del.principal.user.userid in %global_allowed_service_accounts
    not $del.principal.user.userid in %global_allowed_admin_users
    not $del.principal.user.userid in %global_allowed_cloud_principals

    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.resource.name = /(audit|logging|log-?(config|policy|sink|forward)|telemetry|collector|forwarder)/ nocase
    $cfg.principal.user.userid = $user
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_cloud_principals

    $del.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($user)
    $deleted_resources = array_distinct($del.target.resource.name)
    $modified_settings = array_distinct($cfg.target.resource.name)
    $source_ips = array_distinct($del.principal.ip)
    $event_count = count($del.metadata.id)

  condition:
    $del and $cfg
}
