/*
  MITRE Technique : T1546.013 - PowerShell Profile
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:19:48.594071+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_013_PowerShell_Profile_Repeated_Writes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several PowerShell profile script files (profile.ps1 and the host-specific profile variants for the console, ISE, VS Code and PowerShell 7) are created on a single host within ten minutes. One profile write is often benign. A burst of writes across profile locations suggests an adversary staging persistence for every host program, user scope or all-users scope."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.013"
    mitre_technique_name = "Event Triggered Execution: PowerShell Profile"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon Event ID 11 or equivalent) with the full target path and the writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Configuration management or RMM tools deploying standard profiles, user-environment and logon customization tooling, developers or admins setting up new workstations (oh-my-posh, posh-git, VS Code or Windows Terminal installers), and profile-roaming or backup restore operations."
    tuning_guidance = "Add deployment and configuration tooling executables to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and EDR or AV agents to %global_allowed_security_tools. Raise the #file threshold in noisy environments such as VDI golden-image builds."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(windowspowershell|powershell)\\(v1\.0\\|7\\)?([a-z]+\.[a-z]+_)?profile\.ps1$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.013")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $profile_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
