/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:53:09.046830+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_Token_Theft_Privileged_Process_Handle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location opening a handle to a SYSTEM-level token-holding process (winlogon, lsass, services, wininit). Handle acquisition on these processes is the prerequisite for DuplicateTokenEx/ImpersonateLoggedOnUser/SetThreadToken token theft. The rule works at the process-handle layer, so it fires even when command-line logging is evaded or the tool is renamed."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process-access telemetry (Sysmon Event ID 10 or EDR handle-open events) normalised to PROCESS_OPEN with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Unsigned or user-profile-installed security, backup or RMM agents; software installers or updaters run from Temp/ProgramData; developer debugging tools; sanctioned red team or penetration test activity."
    tuning_guidance = "Add approved EDR/AV binaries to %global_allowed_security_tools, RMM and deployment tooling to %global_allowed_admin_tools, and imaging or backup agents to %global_allowed_backup_processes. Review recurring hits by source process name and allowlist by executable name rather than directory. Optionally narrow the target regex (for example to lsass and winlogon only) for noisy estates."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(winlogon|lsass|services|wininit)\.exe$/ nocase
    $open.principal.process.file.full_path = /\\(users\\[^\\]+|programdata|windows\\temp|temp|appdata|users\\public|perflogs|\$recycle\.bin)\\.+\.(exe|scr|com)$/ nocase
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $source_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
