/*
  MITRE Technique : T1568.002 - Domain Generation Algorithms
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:07:14.643464+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_002_Linux_DGA_Like_DNS_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Linux host issues many DNS queries for long, random-looking second-level domain names within ten minutes. Each lookup is benign on its own. The volume of algorithmically generated names is characteristic of malware cycling through DGA domains to find a live C2 server."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.002"
    mitre_technique_name = "Dynamic Resolution: Domain Generation Algorithms"
    log_prerequisites = "Requires Linux endpoint telemetry or a DNS resolver/sensor feed that populates NETWORK_DNS events with principal.hostname and network.dns.questions.name."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CDN and cloud services with hashed hostnames, software update and telemetry endpoints, container registries, anti-spam/DNSBL lookups, mail servers, and security or crawler tooling resolving many unique names."
    tuning_guidance = "Add known-good domains to %global_allowed_domains, add EDR/AV agents and DNS-heavy tooling to %global_allowed_security_tools, and raise the #dns threshold for busy mail, proxy or crawler hosts."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.hostname = $host
    $dns.network.dns.questions.name = /(?i)(^|\.)[a-z0-9]{12,30}\.[a-z]{2,10}$/
    $dns.network.dns.questions.name = /(?i)[bcdfghjklmnpqrstvwxz0-9]{5,}/
    not $dns.network.dns.questions.name = /(?i)\.(arpa|local|internal|lan|localdomain)$/
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($dns.metadata.id)
    $mitre_technique_id = array_distinct("T1568.002")
    $primary_entity = array_distinct($host)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $source_processes = array_distinct($dns.principal.process.file.full_path)

  condition:
    #dns >= 15
}
