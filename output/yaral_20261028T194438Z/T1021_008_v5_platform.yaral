/*
  MITRE Technique : T1021.008 - Direct Cloud VM Connections
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:46:41.583452+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_008_Cloud_VM_Direct_Console_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an identity opening a direct interactive path to a cloud-hosted VM through the control plane. This covers serial console connections, temporary SSH public key pushes to an instance, and managed shell session starts. These paths can give console-level or root/SYSTEM access without network-level SSH/RDP, so they are a lateral movement route for adversaries holding valid cloud credentials. This rule is a control-plane audit rule and does not use endpoint process telemetry."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.008"
    mitre_technique_name = "Remote Services: Direct Cloud VM Connections"
    log_prerequisites = "Cloud provider control-plane audit logging must be enabled and ingested with management/admin activity events (including serial console, instance key push and session-manager style API calls) normalised to UDM USER_RESOURCE_ACCESS with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Break-glass or emergency troubleshooting by cloud administrators, SRE/on-call staff using managed shell sessions instead of SSH, automation or CI/CD pipelines pushing temporary keys, helpdesk or support tooling, and break-fix work on VMs with broken networking where serial console is the only access path."
    tuning_guidance = "Add expected administrator identities to %global_allowed_admin_users, automation and pipeline identities to %global_allowed_service_accounts, and approved identity or service principals to %global_allowed_cloud_principals. If managed shell sessions are routine in an environment, remove the session-start alternative from the regex or restrict it to production resource names. Consider raising severity for connections outside business hours."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(SendSSHPublicKey|SendSerialConsoleSSHPublicKey|StartSession|serialPorts\/connect|serialConsole.*connect|StartSerialPortSession)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.008")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
