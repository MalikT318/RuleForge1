/*
  MITRE Technique : T1566.001 - Spearphishing Attachment
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:46:59.159735+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_001_Attachment_Download_Then_Anomalous_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A host downloads a file type commonly used as a phishing attachment or its payload container (archive, disk image, shortcut, macro document, script or executable) from an external web destination. Within 10 minutes the same source then opens an outbound connection to a different external address on a non-standard high port. This sequence is consistent with user execution of a delivered attachment followed by a payload callback. It uses only perimeter telemetry and does not duplicate process command-line detections."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.001"
    mitre_technique_name = "Phishing: Spearphishing Attachment"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP (with target.url populated) and NETWORK_CONNECTION (with target.ip and target.port populated). Source IP must be consistent across both log types, so the same NAT or proxy-egress view must apply."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Users downloading legitimate installers, archives or Office macro templates and then using software that connects to a custom port (VoIP, gaming, VPN clients, remote support, developer tooling). Software deployment from external vendor portals. Shared NAT or proxy egress IPs can merge unrelated users' activity."
    tuning_guidance = "Add trusted vendor and update domains to %global_allowed_domains. Add scanner and authorised testing sources to %global_allowed_scanners. Add RMM or deployment servers to %global_allowed_admin_tools. If the egress IP is shared NAT, restrict this rule to proxy logs that carry the real client IP. Raise the port floor or add port exclusions for known corporate applications."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(iso|img|zip|rar|7z|lnk|docm|xlsm|pptm|js|jse|vbs|hta|scr|exe|msi|chm|one)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_admin_tools
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port >= 1024
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_admin_tools
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1566.001")
    $primary_entity = array_distinct($src_ip)
    $downloaded_urls = array_distinct($http.target.url)
    $download_hosts = array_distinct($http.target.hostname)
    $callback_ips = array_distinct($net.target.ip)
    $callback_ports = array_distinct($net.target.port)
    $callback_count = count($net.metadata.id)

  condition:
    $http and $net
}
