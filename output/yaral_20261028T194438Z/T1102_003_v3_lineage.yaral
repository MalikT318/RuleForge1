/*
  MITRE Technique : T1102.003 - One-Way Communication
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:57:55.170272+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_003_Linux_Service_Parent_Spawns_Shell_Or_Fetcher {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service process (web server, PHP handler, or database daemon) spawning a shell, scripting interpreter, or HTTP retrieval utility on Linux. Pulling C2 instructions from a legitimate web service (T1102.003, one-way communication) by a compromised service typically shows up as this anomalous lineage, because these daemons rarely launch interactive shells or fetch tools in normal operation. The rule keys on process lineage rather than command-line content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.003"
    mitre_technique_name = "Web Service: One-Way Communication"
    log_prerequisites = "Requires Linux endpoint process-launch telemetry (EDR or auditd execve) with both parent and child process paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "PHP applications that call exec/system for image processing or mail; CMS plugins and update routines using curl or wget; database maintenance hooks and backup scripts launched by the database daemon; web-hosting control panels; health-check scripts started by the service."
    tuning_guidance = "Add legitimate parent binaries to %global_allowed_script_hosts and approved management or deployment tooling to %global_allowed_admin_tools. Scope the parent regex to the service stack deployed at the client if there is noise. Consider raising severity when the host is internet-facing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|ruby|curl|wget)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1102.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $service_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
