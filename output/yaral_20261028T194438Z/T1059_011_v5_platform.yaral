/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:23:07.498026+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Fetch_Outbound_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests to external hosts that are network-observable signs of Lua script delivery or Lua runtime activity: a Lua HTTP client library user agent, or a request for a .lua script made by a command-line downloader typical of Linux hosts. Adds perimeter coverage for Lua execution (T1059.011) that process-creation rules cannot see, such as embedded Lua runtimes and in-memory loaders."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with network.http.user_agent and target.url populated. Egress traffic from Linux server segments must pass through the inspection point (TLS inspection is needed for HTTPS URL and user-agent visibility)."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate Lua-based software such as OpenResty/nginx Lua modules, game servers, Neovim or Redis tooling, and package or plugin managers fetching .lua modules from vendor repositories. Developers pulling Lua libraries with curl or wget."
    tuning_guidance = "Add known-good vendor and repository domains to %global_allowed_domains. If a source segment legitimately runs Lua applications, scope that source out in the SIEM or add its management address to %global_allowed_mgmt_sources. Raise severity for server segments that should have no direct internet egress."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    (
      $net.network.http.user_agent = /(luasocket|lua-resty|lua[- ]?http|^lua\/)/ nocase or
      (
        $net.target.url = /\.lua(\?.*)?$/ nocase and
        $net.network.http.user_agent = /^(curl|wget)/ nocase
      )
    )

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
