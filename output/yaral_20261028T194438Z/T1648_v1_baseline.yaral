/*
  MITRE Technique : T1648 - Serverless Execution
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:49:18.881848+00:00
  Reference       : https://attack.mitre.org/techniques/T1648
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1648_SaaS_Automation_Flow_Created_By_Non_Admin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a cloud workflow-automation flow (serverless execution and integration service) by a user who is not an approved administrator or service account. Adversaries abuse these services to run arbitrary actions, exfiltrate data, or persist through event-triggered execution without touching an endpoint."
    mitre_tactic = "Execution"
    mitre_technique = "T1648"
    mitre_technique_name = "Serverless Execution"
    log_prerequisites = "Requires the unified audit log, including the workflow automation workload, to be ingested and parsed into UDM. Flow creation must be normalised to USER_RESOURCE_CREATION with metadata.product_event_type populated."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Business users building legitimate productivity automations, citizen-developer programs, IT-approved flow templates, onboarding or provisioning automations created by service desk staff, and migration projects."
    tuning_guidance = "Add named citizen-developer or automation administrators to %global_allowed_admin_users, and automation or integration accounts to %global_allowed_service_accounts. Consider raising severity for accounts with recent risky sign-ins or for flows created from unfamiliar source IPs. Extend the product_event_type regex to cover edit or permission-grant operations if your tenant exposes them and the noise is acceptable."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /^(CreateFlow|CreateFlowPermission|CreateFlowConnection)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1648")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $flow_names = array_distinct($cloud.target.resource.name)
    $operations = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
