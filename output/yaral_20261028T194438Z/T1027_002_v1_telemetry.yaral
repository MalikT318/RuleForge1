/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:39:28.288718+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Packed_Executable_Written_To_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an executable file (EXE/DLL/SCR) in a user-writable location whose file name carries packing, crypting or obfuscation markers. This is the file artifact left by packing or protection utilities, and it does not depend on command-line logging. Packers often write their output to a new file whose name signals the transformation, and the output is then staged from temp, profile or public directories."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software developers and build pipelines producing release builds named 'packed' or 'protected'; legitimate installers or self-extractors staging 'packed' components in Temp; game modding and software-protection tooling used by authorised teams; IT packaging teams building deployment bundles."
    tuning_guidance = "Add approved build, packaging and deployment tooling to %global_allowed_admin_tools. Add endpoint agents to %global_allowed_security_tools. Add developer or build-server accounts to %global_allowed_service_accounts, or exclude them by host. Narrow or widen the file-name keyword group to fit the client's naming conventions. Raise severity when the creating process is itself running from a user-writable path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|users\\public)\\.*(pack(ed|er)|crypt(ed|er|or)|obfuscated)[^\\]*\.(exe|dll|scr)$/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
