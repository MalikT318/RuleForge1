/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:03:41.427308+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_Linux_OnHost_Linker_Output_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Proxy detection for junk code insertion (T1027.016) at the file-artifact layer. Junk or dead code is a binary content property that Linux file telemetry cannot see, so this rule flags the typical on-host build step instead. A native linker or compiler driver writes a new executable or shared object into a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Malware with a metamorphic or polymorphic build step regenerates itself on the victim this way, with random junk code inserted at each rebuild to defeat static analysis and signatures. Intermediate objects, archives and compiler temp files are excluded. Treat this as a hunting-grade lead rather than proof of junk code, and triage by checking what executes the artifact next."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that populates principal.process.file.full_path and target.file.full_path on file creation events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer workstations, CI/build servers, package builds (pip, cargo, go, DKMS kernel module builds), and autotools configure checks that link test binaries in /tmp. Compilers on internet-facing servers are rarely legitimate."
    tuning_guidance = "Add build and CI hosts to %global_allowed_script_hosts. Add approved build tooling to %global_allowed_admin_tools. Add build service accounts to %global_allowed_service_accounts. Raise severity for production servers, which should not have a toolchain installed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(ld|ld\.bfd|ld\.gold|ld\.lld|lld|mold|collect2|tcc)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    not $file.target.file.full_path = /\.(o|a|lo|la|res|tmp|log|d)$/ nocase
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $builder_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
