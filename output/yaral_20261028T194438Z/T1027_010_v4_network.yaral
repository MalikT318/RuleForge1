/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:54:09.879067+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Obfuscated_Interpreter_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of a script interpreter that makes an outbound connection to a non-internal address while its own command line carries obfuscation markers: encoded command blobs, caret escape-character padding, string-splitting concatenation, or [char] and Base64 reconstruction. This fires on the network telemetry of the obfuscated process, so it adds coverage beyond process-creation command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) with the initiating process path and command line populated on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate admin or deployment scripts that pass Base64 -EncodedCommand payloads (RMM, SCCM, Intune, backup agents), software installers that wrap PowerShell, and build or CI scripts that concatenate strings and then download packages."
    tuning_guidance = "Add approved RMM and deployment binaries to %global_allowed_admin_tools, approved automation hosts to %global_allowed_script_hosts, and known-good destinations to %global_allowed_domains. If encoded-command noise remains, raise the minimum Base64 length in the regex."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $net.principal.process.command_line = /(\s-(e|ec|enc|encodedcommand)\s+[a-z0-9+\/=]{40,}|(\^[^\^\s]*){5,}|('[^']{1,6}'\s*\+\s*){3,}|\[char\]\s*\(?\d+|frombase64string|\$env:[a-z]+\[\d+,\d+\])/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $obfuscated_command_line = array_distinct($net.principal.process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
