/*
  MITRE Technique : T1036 - Masquerading
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:54:39.788254+00:00
  Reference       : https://attack.mitre.org/techniques/T1036
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_Container_Masquerade_Binary_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file inside a container, in a world-writable location (/tmp, /var/tmp, /dev/shm, /run), whose name mimics a core system, runtime or Kubernetes component (systemd, sshd, crond, kworker, kthreadd, dockerd, containerd, kubelet, kube-proxy, pause and similar). It also matches files or directories that use deceptive names (a '...' directory, or names with trailing whitespace). This detects the masquerading artifact written to the container filesystem, not the command used to create it, so it still fires if command-line logging is evaded or the dropper is renamed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036"
    mitre_technique_name = "Masquerading"
    log_prerequisites = "Requires container runtime or node-level file telemetry (FILE_CREATION events with a populated target.file.full_path) from containerized workloads."
    platform = "Containers"
    log_source = "container"
    false_positives = "Package managers or image build steps unpacking files into /tmp, init or entrypoint scripts that stage helper binaries under standard names, sidecar and debug tooling, CI runners building images, and legitimate temporary copies of shells during troubleshooting."
    tuning_guidance = "Add approved build, deployment and admin tooling to %global_allowed_admin_tools, EDR or runtime agents to %global_allowed_security_tools, and automation identities to %global_allowed_service_accounts. Extend the package-manager executable exclusion if base images use other installers. Consider scoping by hostname or cluster if CI nodes are noisy."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run)\/(.*\/)?(systemd[^\/]*|sshd|crond?|kworker[^\/]*|kthreadd|dockerd|containerd[^\/]*|kubelet|kube-proxy|rsyslogd|udevd|auditd|pause)$/ nocase or
      $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run)\/(.*\/)?(\.\.\.(\/|$)|[^\/]*\s(\/|$))/ nocase
    )
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|apk|rpm|yum|dnf|pip3?)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1036")
    $primary_entity = array_distinct($file.principal.hostname)
    $masquerade_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
