/*
  MITRE Technique : T1137.003 - Outlook Forms
  Tactic(s)       : Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:18:02.616750+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_003_Mailbox_Outlook_Forms_Library_Item_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of items in a user mailbox forms library or hidden form-design folders, as recorded in Microsoft 365 mailbox audit logs. Adversaries publish custom Outlook forms with embedded script to a mailbox so that code runs when a crafted message is received or the client starts. This rule covers the cloud control plane and complements any endpoint rule on the client process."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.003"
    mitre_technique_name = "Office Application Startup: Outlook Forms"
    log_prerequisites = "Requires Microsoft 365 unified audit log ingestion with mailbox auditing enabled for item Create and Update operations (enabled by default for user mailboxes). The audit record must populate the item or folder name and path, which UDM normalises to target.resource.name or target.file.full_path."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Organisations that deliberately publish custom or organisational forms (HR, helpdesk, or line-of-business forms). Mailbox migrations and restores. Legacy add-ins that write to the forms library. Administrators deploying approved templates."
    tuning_guidance = "Add approved forms publishers and migration or automation accounts to %global_allowed_service_accounts. Add named administrators who deploy forms to %global_allowed_admin_users. If the tenant legitimately uses custom forms, scope the allowlist per client rather than loosening the regex."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /^(Create|Update|Set|Move|Copy)/ nocase
    (
      $cloud.target.resource.name = /(ipm\.microsoft\.(folderdesign|formsdescription)|forms library|personal forms|organizational forms|frmcache)/ nocase or
      $cloud.target.file.full_path = /(ipm\.microsoft\.(folderdesign|formsdescription)|forms library|personal forms|organizational forms|frmcache)/ nocase
    )
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $item_names = array_distinct($cloud.target.resource.name)
    $operations = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
