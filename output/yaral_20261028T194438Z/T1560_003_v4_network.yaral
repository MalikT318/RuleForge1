/*
  MITRE Technique : T1560.003 - Archive via Custom Method
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:01:31.057997+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_003_Interpreter_Large_Outbound_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a large outbound HTTP POST/PUT upload to an external destination from a script interpreter or living-off-the-land binary. Custom archiving (XOR, stream ciphers, hand-rolled compression) leaves no archiver command line. The network-side trace is a script host sending a large opaque body to an external host. This is additive to command-line based archive detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.003"
    mitre_technique_name = "Archive Collected Data: Archive via Custom Method"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon) that records HTTP requests with the initiating process path and bytes sent, normalised to NETWORK_HTTP."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or deployment scripts uploading logs, diagnostics or inventory to external SaaS endpoints; PowerShell-based backup or telemetry jobs; developer tooling (Python or Node) pushing artifacts to external package or storage services; legitimate software publishing scripts."
    tuning_guidance = "Add approved script-driven upload tools to %global_allowed_admin_tools and backup agents to %global_allowed_backup_processes. Add trusted SaaS and vendor domains to %global_allowed_domains. Add known automation hosts to %global_allowed_script_hosts. Raise or lower the sent_bytes threshold (1048576 = 1 MB) per client based on baseline upload volumes."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.sent_bytes >= 1048576
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|python[0-9.]*|node)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1560.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $uploading_process = array_distinct($net.principal.process.file.full_path)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
