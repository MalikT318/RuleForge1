/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:00:11.423837+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_External_Access_To_Boundary_Device_Mgmt_Plane {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to a management-plane service (SSH, Telnet, SNMP, NETCONF over SSH, or the legacy Smart Install director port) on an internal destination, as seen in firewall or perimeter logs. Reaching the management plane of a boundary device from outside is the precursor to the policy reconfiguration that lets an adversary bridge trust boundaries (T1599). The rule uses only network-observable fields: source, destination and destination port."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must record permitted traffic, since a successful management session is the case that matters."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed service provider or vendor support jump hosts, external monitoring and SNMP pollers, authorised penetration tests and vulnerability scans, remote administrators connecting from home or cloud egress addresses not yet allowlisted, and internet-wide scanner noise where the firewall logs permitted traffic to exposed management services."
    tuning_guidance = "Add approved administrative source addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_mgmt_sources as well, or exclude them with %global_allowed_scanners. Where an internal destination is intentionally exposed on one of these ports (for example a public SSH bastion), exclude it by adding its address to the allowlist. Do not widen the port list without measuring volume first."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.ip != ""
    $net.principal.ip != ""
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 830 or
      $net.target.port = 4786
    )
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1599")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
