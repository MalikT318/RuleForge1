/*
  MITRE Technique : T1568.002 - Domain Generation Algorithms
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:06:31.324750+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_002_ESXi_DGA_Like_DNS_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host resolving a domain whose registered label is long, alphanumeric and contains an unbroken run of consonants, which is typical of algorithmically generated C2 domains. Internal and sinkholed resolutions are excluded via reference list. Hypervisors should only resolve a small, stable set of vendor, NTP, and management names, so DGA-like lookups from a host are high-value."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.002"
    mitre_technique_name = "Dynamic Resolution: Domain Generation Algorithms"
    log_prerequisites = "ESXi host DNS resolution telemetry normalised to UDM NETWORK_DNS (for example from a network sensor or resolver log that sees ESXi management VMkernel traffic, attributed to the ESXi host). Requires network.dns.questions.name to be populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "CDN or cloud-storage hostnames with random-looking labels, vendor telemetry or update endpoints not yet allowlisted, hardware vendor health or phone-home services, and certificate validation (OCSP/CRL) endpoints."
    tuning_guidance = "Add legitimate external domains (vendor update, NTP, licensing, hardware health, certificate endpoints) to %global_allowed_domains. Adjust the label length (12-30) and consonant-run (5+) thresholds if the environment is noisy. Treat repeated hits from the same host as higher confidence and pivot to shell and SSH activity on that host."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9]{12,30}\.[a-z]{2,10}\.?$/ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz]{5,}/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal
    $dns.principal.hostname != ""

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1568.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $resolver_ips = array_distinct($dns.target.ip)

  condition:
    $dns
}
