/*
  MITRE Technique : T1136.003 - Cloud Account
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:12:05.355691+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_003_Bulk_Cloud_Account_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single actor creates several cloud user accounts within ten minutes. One account creation is routine, but a burst from one identity is a common way to establish persistent secondary access, for example after an administrator session has been compromised."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.003"
    mitre_technique_name = "Create Account: Cloud Account"
    log_prerequisites = "Requires identity provider directory audit logs normalised to UDM USER_CREATION, with principal.user.userid (the actor) and target.user.userid (the new account) populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "HR-driven or identity governance bulk onboarding, SCIM or directory sync provisioning, tenant migrations, scheduled new-hire or student/seasonal batch imports, and administrators running approved bulk-creation scripts."
    tuning_guidance = "Add provisioning and sync identities to %global_allowed_service_accounts, approved onboarding administrators to %global_allowed_admin_users, and approved automation principals to %global_allowed_cloud_principals. Raise the #user threshold for tenants with regular bulk onboarding. Lower it to 3 for high-security tenants."

  events:
    $user.metadata.event_type = "USER_CREATION"
    $user.principal.user.userid != ""
    $user.target.user.userid != ""
    $user.principal.user.userid = $actor
    not $user.principal.user.userid in %global_allowed_service_accounts
    not $user.principal.user.userid in %global_allowed_admin_users
    not $user.principal.user.userid in %global_allowed_cloud_principals

  match:
    $actor over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($user.metadata.id)
    $accounts_created = array_distinct($user.target.user.userid)
    $source_ips = array_distinct($user.principal.ip)
    $mitre_technique_id = array_distinct("T1136.003")
    $primary_entity = array_distinct($actor)

  condition:
    #user >= 5
}
