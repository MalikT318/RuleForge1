/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:19:49.269979+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Defender_Disable_Then_Health_UI_Suppression {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a host where Windows Defender protection is disabled through registry changes and, within 10 minutes, the registry settings that drive security health UI are changed (notification suppression, hidden tray icon, Security Center overrides). This pairing indicates an attempt to hide the lost protection from the user and from defenders, as in fake 'protected' interface activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION) with populated registry key, value name and principal process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise GPO or MDM rollouts that swap Defender for a third-party AV and set Security Center and notification policies, admin hardening scripts, kiosk or lockdown images that hide the Defender tray icon, and AV migration tooling."
    tuning_guidance = "Add third-party AV, EDR and deployment agents to %global_allowed_security_tools. Add approved GPO, MDM or imaging tooling to %global_allowed_admin_tools. Add named admins to %global_allowed_admin_users. Tighten or widen the value-name lists to match client baselines."

  events:
    // Event 1: Defender protection features disabled via registry
    $reg_defender.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg_defender.target.registry.registry_key = /\\Windows Defender(\\Real-Time Protection)?$/ nocase
    $reg_defender.target.registry.registry_value_name = /^(DisableAntiSpyware|DisableAntiVirus|DisableRealtimeMonitoring|DisableBehaviorMonitoring|DisableIOAVProtection|DisableOnAccessProtection|TamperProtection)$/ nocase
    not $reg_defender.principal.process.file.full_path in %global_allowed_security_tools
    not $reg_defender.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg_defender.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller)\.exe$/ nocase
    not $reg_defender.principal.user.userid in %global_allowed_admin_users
    $reg_defender.principal.hostname = $hostname

    // Event 2: security health UI / notification state manipulated
    $reg_ui.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg_ui.target.registry.registry_key = /\\(Windows Defender Security Center\\(Notifications|Systray)|Microsoft\\Security Center)$/ nocase
    $reg_ui.target.registry.registry_value_name = /^(DisableNotifications|DisableEnhancedNotifications|HideSystray|UILockdown|AntiVirusDisableNotify|AntiVirusOverride|UpdatesDisableNotify|FirewallDisableNotify|FirewallOverride)$/ nocase
    not $reg_ui.principal.process.file.full_path in %global_allowed_security_tools
    not $reg_ui.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg_ui.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller)\.exe$/ nocase
    not $reg_ui.principal.user.userid in %global_allowed_admin_users
    $reg_ui.principal.hostname = $hostname

    $reg_defender.metadata.event_timestamp.seconds <= $reg_ui.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity = array_distinct($hostname)
    $disabled_settings = array_distinct($reg_defender.target.registry.registry_value_name)
    $ui_settings = array_distinct($reg_ui.target.registry.registry_value_name)
    $acting_processes = array_distinct($reg_ui.principal.process.file.full_path)
    $acting_users = array_distinct($reg_ui.principal.user.userid)

  condition:
    $reg_defender and $reg_ui
}
