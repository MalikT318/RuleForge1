/*
  MITRE Technique : T1036.006 - Space after Filename
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:06:15.223866+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_006_Trailing_Space_File_Created_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a file whose name ends in an extension followed by one or more trailing spaces being created in a user-writable Linux location, and the same path then being executed as a process within 10 minutes. The trailing space hides the true file type and makes the file look benign. This rule joins the file-creation and execution events on the exact path and does not match on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.006"
    mitre_technique_name = "Masquerading: Space after Filename"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates FILE_CREATION (target.file.full_path) and PROCESS_LAUNCH (target.process.file.full_path) events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build or packaging tools that generate files with accidental trailing spaces and then run them, user-created scripts with sloppy names, and file-sync clients or archive extractors that preserve odd filenames from other operating systems."
    tuning_guidance = "Add approved build, deployment or automation tooling to %global_allowed_admin_tools and approved interpreter parents to %global_allowed_script_hosts. Add EDR/AV agents to %global_allowed_security_tools. Extend or narrow the directory regex to suit client filesystem layouts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|root|home\/[^\/]+)\/.*\.[a-z0-9]{1,8} +$/ nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\.[a-z0-9]{1,8} +$/ nocase
    $proc.target.process.file.full_path = $path
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.006")
    $primary_entity = array_distinct($hostname)
    $executed_path = array_distinct($path)
    $executing_users = array_distinct($proc.principal.user.userid)
    $creator_processes = array_distinct($file.principal.process.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $event_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
