/*
  MITRE Technique : T1203 - Exploitation for Client Execution
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:56:21.618939+00:00
  Reference       : https://attack.mitre.org/techniques/T1203
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1203_Office_Reader_UserAgent_Downloads_Executable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects proxy or firewall-observed HTTP requests where the user agent identifies a Windows Office or document-reader client and the requested URL is an executable or script payload on an external destination. A document application fetching code is a network-observable result of client-side exploitation or a malicious document. It adds network-layer coverage alongside process command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1203"
    mitre_technique_name = "Exploitation for Client Execution"
    log_prerequisites = "Requires a proxy, secure web gateway or firewall with URL and HTTP user-agent logging (including TLS inspection where applicable), normalised to UDM NETWORK_HTTP with network.http.user_agent and target.url populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Office add-ins or updaters that legitimately download installers, Click-to-Run or plugin updates from vendor CDNs not in the allow list, users opening a hyperlink to a download from inside a document or PDF reader, and software deployment portals that serve .msi or .exe files."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add approved scanners or test sources to %global_allowed_scanners. Add approved management source hosts to %global_allowed_mgmt_sources if they proxy on behalf of clients. If the proxy does not populate network.http.user_agent, this rule will not fire for that client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(microsoft office|ms-office|office\/1[0-9]|microsoft (word|excel|powerpoint|outlook)|acrobat|acrord|foxit|AdobeReader)/ nocase
    $net.target.url = /\.(exe|dll|scr|hta|jar|msi|vbs|vbe|js|jse|wsf|ps1|bat|cmd|cpl)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1203")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
