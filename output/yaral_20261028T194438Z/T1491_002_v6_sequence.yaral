/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:47:04.197881+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_Cloud_Bucket_Exposed_Then_Web_Content_Overwritten {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single identity loosens access or website settings on a storage bucket and then writes a web entry-point object (index/default/home page) within ten minutes. This is the cloud-hosted static website defacement pattern: expose the content origin, then replace the public page."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires cloud control-plane audit logs with data-event or object-level write logging enabled for storage buckets. Management events alone will not populate the second event."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines publishing static sites, web developers or content teams deploying a new site version, infrastructure-as-code runs that set bucket policy and upload the index page together, and initial setup of a new static website."
    tuning_guidance = "Add deployment pipeline identities to %global_allowed_service_accounts, release engineers to %global_allowed_admin_users, and approved automation roles to %global_allowed_cloud_principals. If object-level logs are not enabled, this rule will not fire. Extend the entry-point filename regex if customers use other landing page names."

  events:
    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.target.resource.resource_type = "STORAGE_BUCKET"
    $perm.metadata.product_event_type = /(PutBucketPolicy|PutBucketAcl|PutBucketWebsite|PutBucketPublicAccessBlock|DeleteBucketPublicAccessBlock|setIamPolicy|setIamPermissions|storageAccounts\/(write|blobServices\/containers\/write))/ nocase
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_cloud_principals

    $obj.metadata.event_type = "RESOURCE_CREATION"
    $obj.metadata.product_event_type = /(PutObject|CompleteMultipartUpload|CopyObject|objects\.create|objects\.insert|blobs\/write)/ nocase
    $obj.target.resource.name = /(^|\/)(index|default|home|main)\.(html?|php|aspx?|jsp)$/ nocase
    $obj.principal.user.userid = $user
    not $obj.principal.user.userid in %global_allowed_service_accounts
    not $obj.principal.user.userid in %global_allowed_admin_users
    not $obj.principal.user.userid in %global_allowed_cloud_principals

    $perm.metadata.event_timestamp.seconds <= $obj.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity = array_distinct($user)
    $changed_resources = array_distinct($perm.target.resource.name)
    $written_objects = array_distinct($obj.target.resource.name)
    $source_ips = array_distinct($obj.principal.ip)
    $first_change_time = min($perm.metadata.event_timestamp.seconds)
    $last_write_time = max($obj.metadata.event_timestamp.seconds)

  condition:
    $perm and $obj
}
