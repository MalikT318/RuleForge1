/*
  MITRE Technique : T1021 - Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:32:49.965815+00:00
  Reference       : https://attack.mitre.org/techniques/T1021
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_External_Source_To_Remote_Service_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network connection from an external (non-internal) source address to a remote-access service port (RDP, SSH, Telnet, VNC, WinRM) on a Windows environment, as seen at the perimeter. This indicates remote service exposure and possible use of valid accounts for initial or lateral access, and complements endpoint command-line detections by observing the network side."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021"
    mitre_technique_name = "Remote Services"
    log_prerequisites = "Requires firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Logs must record both permitted and denied connections for full visibility; the rule does not filter on action."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSP remote support, administrators connecting over a permitted VPN exit or jump host, approved internet-facing bastion or RD Gateway services, authorised vulnerability scanning, and internet-wide opportunistic scanners hitting exposed ports (these appear as blocked connections)."
    tuning_guidance = "Add approved admin or VPN egress addresses to %global_allowed_mgmt_sources, authorised scanner sources to %global_allowed_scanners, and sanctioned support tooling sources to %global_allowed_remote_mgmt. If scanner noise is high, forward only permitted connections from the firewall or pair this rule with a threshold or sequence variant. Adjust the port list to the protocols in use at each client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3389 or
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 5900 or
      $net.target.port = 5901 or
      $net.target.port = 5902
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
