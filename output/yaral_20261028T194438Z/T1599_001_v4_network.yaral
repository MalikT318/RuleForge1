/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:02:25.147101+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_Inbound_External_To_NAT_Translated_Admin_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side indicator of NAT traversal. A connection from an external source reaches a management or remote-access service port on a destination whose address was rewritten by the perimeter device (translated destination differs from the original). This can mean a NAT or port-forward rule was added or altered to bridge untrusted and trusted networks. The rule observes the result of the NAT change in traffic, not the configuration change itself."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Boundary Bridging: Network Address Translation Traversal"
    log_prerequisites = "Firewall or perimeter connection logs that record the translated (post-NAT) destination in target.nat_ip and the destination port. %rfc1918_internal must be populated with the client's internal address strings."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate published services such as VPN concentrators, bastion or jump hosts, SSH or RDP gateways, and DMZ servers behind documented static NAT or port forwards. Authorised external vulnerability scans and penetration tests. Vendor remote-support access through approved NAT rules."
    tuning_guidance = "Add authorised external scanner sources to %global_allowed_scanners. Add approved external addresses that may reach published services to %global_allowed_mgmt_sources. Add named admin or service accounts to %global_allowed_admin_users if user attribution is present. For intentionally published services, narrow the port list or add the published destination to an allowlist. Compare matches against the change-management record of NAT or port-forward rules."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.nat_ip != ""
    $net.target.ip != $net.target.nat_ip
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 135 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct($net.target.ip)
    $external_sources = array_distinct($net.principal.ip)
    $translated_destinations = array_distinct($net.target.nat_ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
