/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:37:49.654309+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_Linux_Outbound_ICMP_Large_Payload_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter telemetry shows ICMP traffic from an internal host to an external address carrying an unusually large payload. Normal echo traffic is small (about 64-100 bytes per packet), so large outbound ICMP volume points to ICMP tunnelling or covert C2 over a non-application layer protocol. Written for Linux hosts such as servers and containers that egress through the firewall."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with network.ip_protocol and network.sent_bytes populated. Flow records must carry per-connection byte counters."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Path MTU discovery and large-packet connectivity tests run by network engineers, uptime or SLA monitoring probes, long-lived flows where the firewall aggregates many pings into one record, and approved vulnerability scanners."
    tuning_guidance = "Raise or lower the sent_bytes threshold to match how the client's firewall aggregates ICMP flows. Add monitoring probes and scanners to %global_allowed_scanners, and approved management source addresses to %global_allowed_mgmt_sources. Known-good external destinations can be added to %global_allowed_domains if the log source resolves target hostnames."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "ICMP"
    $net.network.sent_bytes > 1024
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
