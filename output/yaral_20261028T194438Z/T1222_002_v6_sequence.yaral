/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:21:50.006571+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_Linux_Permission_Change_Then_Sensitive_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a permission or ownership change (chmod, chown, chgrp, setfacl, chattr -i) against a security-sensitive Linux file, followed within 10 minutes by a content modification of a sensitive file on the same host by a non-permission process. This pattern indicates an adversary unlocking or taking ownership of a protected file such as sudoers, shadow, authorized_keys, cron, shell profile or PAM config, and then tampering with it."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with command lines (execve) and file modification telemetry (watches on /etc, cron, systemd, PAM and user home dotfiles)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt) hardening or rewriting /etc files; administrators manually editing sudoers or sshd/PAM config after a chown; package managers updating /etc/passwd or /etc/shadow; user provisioning scripts writing authorized_keys; image build pipelines."
    tuning_guidance = "Add configuration management and provisioning binaries to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Extend or narrow the sensitive path regex in both event blocks to match client-specific protected files."

  events:
    $perm.metadata.event_type = "PROCESS_LAUNCH"
    $perm.target.process.file.full_path = /\/(chmod|chown|chgrp|setfacl|chattr)$/ nocase
    $perm.target.process.command_line = /(\bchown\b|\bchgrp\b|\bsetfacl\b|\schattr\s+(-\S+\s+)*-i\b|\s[0-7]?[0-7]{2}[2367]\s|\s[2467][0-7]{3}\s|\s[ugoa]*[+=][rxXt]*[ws][rwxXst]*(\s|,))/ nocase
    $perm.target.process.command_line = /(\/etc\/(sudoers|shadow|passwd|gshadow|cron|crontab|ld\.so\.preload|pam\.d|ssh\/sshd_config|profile|systemd\/system)|\.ssh\/authorized_keys|\/\.(bashrc|bash_profile|profile|zshrc)|\/var\/spool\/cron)/ nocase
    not $perm.principal.process.file.full_path in %global_allowed_admin_tools
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    $perm.principal.hostname = $hostname

    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.target.file.full_path = /(^\/etc\/(sudoers|shadow|passwd|gshadow|crontab|ld\.so\.preload|profile)$|^\/etc\/(sudoers\.d|cron\.[a-z]+|pam\.d|systemd\/system)\/|\/\.ssh\/authorized_keys$|\/\.(bashrc|bash_profile|profile|zshrc)$|^\/var\/spool\/cron\/)/ nocase
    not $mod.principal.process.file.full_path = /\/(chmod|chown|chgrp|setfacl|chattr)$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.user.userid in %global_allowed_service_accounts
    $mod.principal.hostname = $hostname

    $perm.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity = array_distinct($hostname)
    $perm_commands = array_distinct($perm.target.process.command_line)
    $perm_users = array_distinct($perm.principal.user.userid)
    $modified_files = array_distinct($mod.target.file.full_path)
    $modifying_processes = array_distinct($mod.principal.process.file.full_path)
    $modification_count = count($mod.metadata.id)

  condition:
    $perm and $mod
}
