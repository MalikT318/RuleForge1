/*
  MITRE Technique : T1217 - Browser Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:39:01.485180+00:00
  Reference       : https://attack.mitre.org/techniques/T1217
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1217_Browser_Remote_Debug_Port_NonBrowser_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser process opening a network connection to the Chromium remote-debugging port (TCP 9222), the DevTools protocol endpoint. Connecting to it lets a process list open tabs and URLs, history, and cookies from a running browser, which is browser information discovery. This is a network-side detection that complements process command-line rules: it fires on the resulting connection, whatever launched the browser or renamed the client binary. Internal address space is deliberately not excluded, because the technique's traffic is loopback or internal. Noise is controlled by excluding the initiating process through reference lists."
    mitre_tactic = "Discovery"
    mitre_technique = "T1217"
    mitre_technique_name = "Browser Information Discovery"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path and the destination port, normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Browser test automation (Selenium, Puppeteer, Playwright, WebDriver), web developers using DevTools tooling or IDE debuggers, remote-support or screen-capture tools that drive a browser, and enterprise browser management agents."
    tuning_guidance = "Add approved automation, IDE, and developer tooling executables to %global_allowed_script_hosts or %global_allowed_admin_tools. Add EDR or DLP agents to %global_allowed_security_tools. On developer-heavy tenants, scope the rule to non-developer hosts, or raise severity only when the client process runs from a user-writable path."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 9222
    $net.principal.process.file.full_path = /\\[^\\]+\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(chrome|msedge|msedgewebview2|brave|opera|vivaldi|firefox|iexplore)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1217")
    $primary_entity = array_distinct($net.principal.hostname)
    $client_process = array_distinct($net.principal.process.file.full_path)
    $client_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
