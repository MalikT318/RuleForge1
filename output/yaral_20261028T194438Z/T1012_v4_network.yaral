/*
  MITRE Technique : T1012 - Query Registry
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:24:29.874706+00:00
  Reference       : https://attack.mitre.org/techniques/T1012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1012_Reg_Utility_Remote_Registry_SMB_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a native registry utility (reg.exe, regedit.exe, regedt32.exe) initiating an SMB/NetBIOS network connection. These tools only use the network when querying a remote host's registry through the Remote Registry service (\\\\host\\winreg named pipe over TCP 445/139), so this indicates remote registry discovery or lateral reconnaissance. The rule intentionally does NOT exclude RFC1918 space, because remote registry access is an internal lateral protocol and excluding internal destinations would remove the detection."
    mitre_tactic = "Discovery"
    mitre_technique = "T1012"
    mitre_technique_name = "Query Registry"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path on outbound connections."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or RMM and compliance tooling querying remote registries, software inventory and patch-audit scripts, and authorised vulnerability or configuration assessment tooling."
    tuning_guidance = "Add approved admin tooling paths to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Remote registry from reg.exe is rare in most estates; if a client uses it for inventory, allowlist the executing tool or account rather than loosening the port or process logic."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(reg|regedit|regedt32)\.exe$/ nocase
    ($net.target.port = 445 or $net.target.port = 139)
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1012")
    $primary_entity = array_distinct($net.principal.hostname)
    $remote_targets = array_distinct($net.target.ip)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
