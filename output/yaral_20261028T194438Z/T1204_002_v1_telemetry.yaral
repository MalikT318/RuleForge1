/*
  MITRE Technique : T1204.002 - Malicious File
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:00:21.546912+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_002_Linux_Masqueraded_Double_Extension_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file in a user-reachable or world-writable Linux location (home directories, /tmp, /var/tmp, /dev/shm, removable media) whose name pairs a document or media extension with an executable or launcher extension (e.g. .pdf.sh, .docx.AppImage, .jpg.desktop). This is the file artifact left by a user-execution lure delivered via phishing, download or archive extraction. It works at the file-artifact layer, so it does not depend on command-line logging."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.002"
    mitre_technique_name = "User Execution: Malicious File"
    log_prerequisites = "Linux EDR or auditd file telemetry that populates FILE_CREATION events with target.file.full_path and principal.process.file.full_path (inotify/fanotify-based EDR, or auditd watch rules on home, /tmp and /dev/shm)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or admins saving scripts with descriptive double extensions (e.g. report.txt.sh); software packaged as AppImage with a version or document-style name; documentation build or conversion tooling in /tmp; desktop launchers created by installers."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools, and approved script-generating hosts or parent processes to %global_allowed_script_hosts. Add EDR or AV agents that stage files to %global_allowed_security_tools. If developer workstations are noisy, narrow the path prefix group or remove the less common launcher extensions."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/home\/[^\/]+\/|\/root\/|\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/mnt\/|\/media\/).*\.(pdf|docx?|xlsx?|pptx?|rtf|odt|ods|txt|jpe?g|png|gif|zip|iso)\.(sh|bash|elf|bin|run|appimage|desktop|py|pl|rb|x86_64|out|so)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1204.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
