/*
  MITRE Technique : T1560 - Archive Collected Data
  Tactic(s)       : Collection
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:56:11.418461+00:00
  Reference       : https://attack.mitre.org/techniques/T1560
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_Unexpected_Parent_Spawns_Archiver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects data compression or archiving activity originating from a process lineage that should never produce it: an Office application, web server, database service, or print spooler spawning either an archiving utility directly or a shell/script interpreter whose command line performs archive creation. Pivots on the parent-child relationship rather than on the archive command alone."
    mitre_tactic = "Collection"
    mitre_technique = "T1560"
    mitre_technique_name = "Archive Collected Data"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry that populates both the parent (principal.process) and child (target.process) image paths and the child command line. Sources include EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications or reporting services that legitimately zip exports (for example a w3wp-hosted export feature), SQL Server jobs that compress backups through a shell, Office macros or add-ins in document-automation workflows, and print or document management systems that bundle spool files."
    tuning_guidance = "Add approved parent processes to %global_allowed_admin_tools, %global_allowed_script_hosts, or %global_allowed_backup_processes. Add known service accounts to %global_allowed_service_accounts. If a specific web or database workload legitimately archives data, exclude it by parent executable name and host rather than widening the child match."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent lineage that should not normally spawn archiving activity
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|sqlservr|mysqld|spoolsv)\.exe$/ nocase

    (
      // Child is an archiving or compression binary
      $proc.target.process.file.full_path = /\\(7z|7za|7zr|7zg|rar|winrar|zip|tar|makecab)\.exe$/ nocase
      or
      // Child is a shell or script interpreter performing archive creation
      (
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
        and $proc.target.process.command_line = /(compress-archive|system\.io\.compression|createfromdirectory|makecab|\btar(\.exe)?\s+-?[a-z]*c[a-z]*f|\b(7z|7za|rar|winrar)(\.exe)?\s+a\s|\bzip(\.exe)?\s+-?r)/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1560")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
