/*
  MITRE Technique : T1499.002 - Service Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:19:59.010317+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_002_Linux_Inbound_Service_Connection_Flood {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single external source opens an abnormally high volume of inbound connections to the web service ports of one Linux host within 10 minutes. This is consistent with an HTTP/TLS service exhaustion flood, including connection floods and SSL/TLS renegotiation abuse. Each connection is benign on its own; the volume from one source to one host is the signal."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.002"
    mitre_technique_name = "Endpoint Denial of Service: Service Exhaustion Flood"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd socket accept/connect events) that populates inbound NETWORK_CONNECTION events with network.direction, principal.ip, target.hostname and target.port on the server being protected."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Corporate NAT or proxy egress addresses, CDN or WAF edge nodes forwarding client traffic, uptime and synthetic monitoring, load testing, legitimate traffic spikes (marketing events, API clients, package mirrors), and misconfigured clients retrying aggressively."
    tuning_guidance = "Add authorised scanners and load-test sources to %global_allowed_scanners. Add known CDN, WAF and proxy source addresses to %global_allowed_mgmt_sources, or raise the #net threshold for high-traffic public web servers. Lower the threshold for low-traffic internal services. Extend the port list for non-standard web service ports. Internal sources are excluded via %rfc1918_internal; remove that exclusion if internal flood detection is required."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    $net.target.hostname = $host
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $host, $src over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499.002")
    $primary_entity = array_distinct($host)
    $source_address = array_distinct($src)
    $event_count = count($net.metadata.id)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 1000
}
