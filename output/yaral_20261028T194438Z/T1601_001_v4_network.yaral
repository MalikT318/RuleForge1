/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:13:05.550673+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_External_TFTP_FTP_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter-observed TFTP (UDP/TCP 69) or FTP (21) connection from an internal source to an external destination. Network devices typically fetch or push OS images with these protocols, so this traffic can indicate an attacker staging a modified system image on a device (Patch System Image). Both protocols are unauthenticated or cleartext and are rarely needed across the internet. Because a perimeter log has no device inventory, the rule cannot confirm the source is a network device. Scope it by excluding approved management sources."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Management-plane traffic from network devices must traverse the logging perimeter."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised firmware or OS upgrades pulled from a vendor or partner FTP/TFTP server, scheduled configuration or image backups to an off-site server, legacy applications or file-transfer jobs using FTP, and lab or staging devices in a test network."
    tuning_guidance = "Add approved management or upgrade-server source addresses to %global_allowed_mgmt_sources and known-good vendor update domains to %global_allowed_domains. For stricter deployments, scope the rule to network-device address ranges at the client level through the reference list. Review hits against change tickets for device upgrades."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 21)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
