/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:14:11.892107+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_Inbound_UDP_Amplification_Responses_Per_Victim {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single internal host receives a high volume of inbound UDP flows sourced from well-known amplification-service ports (chargen, DNS, NTP, SNMP, CLDAP, SSDP, WS-Discovery, memcached) from external addresses within ten minutes. The individual flow is benign; the volume of unsolicited reflector responses converging on one victim is the signature of a reflection amplification DDoS."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Perimeter firewall or flow logs normalised to UDM NETWORK_FLOW events with principal.ip/port (remote source), target.ip (victim), network.ip_protocol and network.received_bytes where available. Inbound traffic must be logged and not sampled too aggressively."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Busy internal DNS resolvers or NTP clients that legitimately receive large volumes of responses from external servers; SNMP or SSDP discovery tooling; vulnerability scanners and monitoring probes; memcached or CLDAP deployments that communicate across the perimeter."
    tuning_guidance = "Add known external-facing resolvers and legitimate scanner or monitoring sources to %global_allowed_scanners, and approved management sources to %global_allowed_mgmt_sources. Raise the #net threshold on high-traffic resolvers or narrow the port list (for example, drop port 53) for tenants with heavy DNS recursion. Lower the threshold for small sites."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.ip_protocol = "UDP" nocase
    (
      $net.principal.port = 19 or
      $net.principal.port = 53 or
      $net.principal.port = 123 or
      $net.principal.port = 161 or
      $net.principal.port = 389 or
      $net.principal.port = 1900 or
      $net.principal.port = 3702 or
      $net.principal.port = 11211
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.target.ip = $victim

  match:
    $victim over 10m

  outcome:
    $risk_score = max(if($net.network.received_bytes >= 1000, 85, 65))
    $event_count = count($net.metadata.id)
    $reflector_ips = array_distinct($net.principal.ip)
    $source_ports = array_distinct($net.principal.port)
    $max_received_bytes = max($net.network.received_bytes)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($victim)

  condition:
    #net >= 500
}
