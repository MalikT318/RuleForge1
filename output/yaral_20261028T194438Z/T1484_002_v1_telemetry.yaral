/*
  MITRE Technique : T1484.002 - Trust Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:34:02.687039+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_002_IdP_Federation_Trust_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to identity provider trust or federation settings, such as converting a domain to federated authentication, altering token-signing certificates or issuer details, or modifying tenant/partner trust and external identity provider definitions. These changes let an adversary forge tokens or authenticate as arbitrary users, and they are detected here from the resulting directory configuration change rather than from any command line."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.002"
    mitre_technique_name = "Domain or Tenant Policy Modification: Trust Modification"
    log_prerequisites = "Requires identity provider directory/admin audit logs normalized to UDM SETTING_MODIFICATION with metadata.product_event_type populated and the acting administrator in principal.user.userid."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned federation or SSO onboarding and migrations, scheduled token-signing certificate rollover, M&A tenant consolidation, approved cross-tenant collaboration changes, and identity automation or synchronization service accounts."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users, automation and sync identities to %global_allowed_service_accounts, and approved cloud service principals to %global_allowed_cloud_principals. If the product_event_type naming in your parser differs, extend the regex with the local event names for federation or trust changes."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(federat|domain[ _.-]?authentication|(domain|tenant|forest|cross[ _.-]?tenant)[ _.-]?(trust|access)|identity[ _.-]?provider|\bidp\b|token[ _.-]?signing|issuer[ _.-]?uri)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1484.002")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $change_type = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
