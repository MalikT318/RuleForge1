/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:26:09.999034+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_Share_Enumeration_Then_Bulk_Copy_From_UNC {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a host enumerating or mapping a network share (net view/use, New-PSDrive, pushd, Get-SmbMapping) and then, within 10 minutes, running a bulk copy or archive command (robocopy, xcopy, Copy-Item, Compress-Archive, tar) against a UNC path. This sequence is typical of an adversary locating and collecting files of interest from network shared drives before exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "File-server migration or sync jobs, logon scripts that map drives and copy data, IT staff performing manual data transfers, software deployment from a share, user-initiated backups to a network drive."
    tuning_guidance = "Add approved IT tooling to %global_allowed_admin_tools, backup software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Tighten the match to the same user by adding a shared user placeholder if telemetry populates principal.user.userid consistently. Raise severity when the host is a server or holds sensitive data."

  events:
    $enum.metadata.event_type = "PROCESS_LAUNCH"
    $enum.target.process.file.full_path = /\\(net1?|powershell|pwsh|cmd)\.exe$/ nocase
    $enum.target.process.command_line = /(\bnet1?(\.exe)?\s+(view|use)\s+\\\\[^\s\\]+|\bnew-psdrive\b.*-root\s+["']?\\\\[^\s\\]+|\bpushd\s+["']?\\\\[^\s\\]+|\bget-smb(share|mapping)\b.*\\\\[^\s\\]+|\bdir\s+["']?\\\\[^\s\\]+\\)/ nocase
    not $enum.principal.process.file.full_path in %global_allowed_admin_tools
    not $enum.principal.user.userid in %global_allowed_service_accounts
    $enum.principal.hostname = $hostname

    $copy.metadata.event_type = "PROCESS_LAUNCH"
    $copy.target.process.file.full_path = /\\(robocopy|xcopy|cmd|powershell|pwsh|tar)\.exe$/ nocase
    $copy.target.process.command_line = /\b(robocopy|xcopy|copy-item|compress-archive|tar|copy|move)\b.*\\\\[^\s\\]+\\[^\s]+/ nocase
    not $copy.principal.process.file.full_path in %global_allowed_admin_tools
    not $copy.principal.process.file.full_path in %global_allowed_backup_processes
    not $copy.principal.user.userid in %global_allowed_service_accounts
    $copy.principal.hostname = $hostname

    $enum.metadata.event_timestamp.seconds <= $copy.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity = array_distinct($hostname)
    $users = array_distinct($copy.principal.user.userid)
    $enumeration_commands = array_distinct($enum.target.process.command_line)
    $copy_commands = array_distinct($copy.target.process.command_line)
    $copy_event_count = count($copy.metadata.id)

  condition:
    $enum and $copy
}
