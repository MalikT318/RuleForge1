/*
  MITRE Technique : T1047 - Windows Management Instrumentation
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:31:46.164060+00:00
  Reference       : https://attack.mitre.org/techniques/T1047
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1047_Remote_WMI_Connection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single host making a high volume of outbound DCOM/RPC (135) or WinRM (5985/5986) connections within 10 minutes from a scripting or command interpreter process. This is consistent with remote WMI execution or lateral movement across multiple systems. Each connection is benign on its own; the volume from an interpreter process is the signal."
    mitre_tactic = "Execution"
    mitre_technique = "T1047"
    mitre_technique_name = "Windows Management Instrumentation"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry (Sysmon Event ID 3 or equivalent) with populated initiating process path and destination port."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and patch scripts that query many hosts over WMI or WinRM, RMM or monitoring tooling run via PowerShell, vulnerability scanners, and administrators running bulk remote management from a jump host."
    tuning_guidance = "Add approved management tooling to %global_allowed_admin_tools, authorised scanner hosts to %global_allowed_scanners, and approved admin jump hosts to %global_allowed_remote_mgmt. Raise the #net threshold in noisy environments. This rule only covers the listed interpreter processes. Extend the process regex if clients use other WMI client binaries."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 135 or $net.target.port = 5985 or $net.target.port = 5986)
    $net.principal.process.file.full_path = /\\(wmic|powershell|pwsh|cscript|wscript|mshta|cmd|rundll32|regsvr32)\.exe$/ nocase
    $net.principal.hostname = $host
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1047")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_processes = array_distinct($net.principal.process.file.full_path)
    $initiating_users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 10
}
