/*
  MITRE Technique : T1491.001 - Internal Defacement
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:45:38.854669+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_001_ESXi_Login_Banner_Defacement_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated shell commands on a single ESXi host that rewrite login banners (motd, issue), the welcome-message advanced setting, or the host web UI document root within ten minutes. One edit is routine administration. A burst of edits to these user-facing messages and pages is consistent with internal defacement, which often follows ransomware staging or other intrusion goals."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.001"
    mitre_technique_name = "Defacement: Internal Defacement"
    log_prerequisites = "ESXi shell command logging (shell.log or syslog forwarded to Chronicle) normalized to PROCESS_LAUNCH with target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately setting compliance or legal login banners, configuration management or host-profile remediation that rewrites motd/issue across hosts, and initial build or hardening scripts."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and provisioning or configuration tooling to %global_allowed_admin_tools. Raise the #proc threshold if build or hardening scripts run in bulk. Lower it to 2 for high-sensitivity clusters."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $host
    $proc.target.process.command_line = /(\/etc\/(motd|issue)\b|\/Annotations\/WelcomeMessage|\/Config\/Etc\/(motd|issue)|\/hostd\/docroot\/ui\/[^\s]*\.(html|htm|png|jpg|jpeg|svg|gif))/ nocase
    $proc.target.process.command_line = /(>|\btee\b|\b(cp|mv|dd|vi|vim)\b|\bsed\s+-i|advanced\s+set|\bwget\b|\bcurl\b)/ nocase
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491.001")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $acting_users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
