/*
  MITRE Technique : T1021.002 - SMB/Windows Admin Shares
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:36:20.083762+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_002_Network_Logon_Then_Admin_Share_Executable_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a remote network logon (logon type 3) to a Windows host followed within 10 minutes by an executable or script written into the Windows directory by the kernel SMB server (System process). This is the typical result of copying a payload to ADMIN$ or C$ before remote execution via service, scheduled task or WMI. Complements command-line rules by correlating authentication and file-write telemetry."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.002"
    mitre_technique_name = "Remote Services: SMB/Windows Admin Shares"
    log_prerequisites = "Requires Windows Security 4624 (network logon) normalised to USER_LOGIN with auth mechanism NETWORK, plus EDR or Sysmon file creation telemetry (FILE_CREATION) that attributes SMB writes to the System process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching tools that push installers over ADMIN$, RMM agents, domain admins performing manual remote maintenance, imaging and provisioning systems."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and deployment or automation accounts to %global_allowed_service_accounts. If the EDR reports SMB writes under a different process name, adjust the writer process regex. Narrow the extension list for noisy environments."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.principal.ip != ""
    $auth.principal.hostname != $auth.target.hostname
    not $auth.target.user.userid = /^(anonymous logon|.*\$)$/ nocase
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts
    $auth.target.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /(^|\\)(system|ntoskrnl\.exe)$/ nocase
    $file.target.file.full_path = /^[a-z]:\\windows\\(system32\\)?[^\\]+\.(exe|dll|bat|cmd|ps1|vbs|js|scr)$/ nocase
    $file.principal.hostname = $hostname

    $auth.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.002")
    $primary_entity = array_distinct($hostname)
    $source_ips = array_distinct($auth.principal.ip)
    $source_hosts = array_distinct($auth.principal.hostname)
    $logon_users = array_distinct($auth.target.user.userid)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropped_file_count = count($file.metadata.id)

  condition:
    $auth and $file
}
