/*
  MITRE Technique : T1036.007 - Double File Extension
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:07:38.813232+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_007_Double_Extension_Created_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a file with a document or media extension followed by an executable extension (e.g. invoice.pdf.exe) being written to disk and then launched as a process from the same path on the same host within 10 minutes. Correlating the file write with the execution of that exact path removes the noise of double-extension files that are only stored or downloaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.007"
    mitre_technique_name = "Masquerading: Double File Extension"
    log_prerequisites = "Requires Windows endpoint telemetry that populates both FILE_CREATION (with target.file.full_path) and PROCESS_LAUNCH (with target.process.file.full_path), e.g. EDR or Sysmon Event IDs 11 and 1."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software packagers or build pipelines producing test binaries with names such as setup.txt.exe, developer or QA workstations, legitimate installers that use a descriptive name before the extension, and IT deployment tooling that stages renamed executables."
    tuning_guidance = "Add approved deployment, build and RMM binaries to %global_allowed_admin_tools (applied to both the file writer and the launching parent). Add automation accounts to %global_allowed_service_accounts. Add developer or build hosts to %global_allowed_script_hosts if needed. To reduce noise further, extend the extension lists or restrict the path regex to user-writable locations such as Downloads, Temp and AppData."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(pdf|docx?|xlsx?|pptx?|txt|rtf|csv|jpe?g|png|gif|zip|mp3|mp4)\.(exe|scr|com|pif)$/ nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\.(pdf|docx?|xlsx?|pptx?|txt|rtf|csv|jpe?g|png|gif|zip|mp3|mp4)\.(exe|scr|com|pif)$/ nocase
    $proc.target.process.file.full_path = $path
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1036.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $masquerade_path = array_distinct($proc.target.process.file.full_path)
    $launch_command_lines = array_distinct($proc.target.process.command_line)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $launching_parents = array_distinct($proc.principal.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
