/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:10:32.001026+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_DNS_Tunneling_High_Volume_Long_Label_Queries {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal client issues a high volume of DNS queries with very long, encoded-looking subdomain labels within ten minutes. Each query is benign on its own, but the volume of long-label queries is characteristic of DNS tunneling or DNS beaconing, where commands and data are encoded in query names."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Requires firewall or perimeter DNS logging with the query name populated (network.dns.questions.name), normalised to UDM NETWORK_DNS events with principal.ip set to the client."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "CDN and cloud services with long hashed hostnames, security products doing DNS-based reputation or file lookups, DNSSEC and DKIM-related lookups, email security tools, and software update or telemetry services that use encoded subdomains."
    tuning_guidance = "Add known-good domains to %global_allowed_domains. Raise the #dns threshold or the label length (currently 40 or more characters) in noisy environments. Scale up the risk score by hand for hosts that also show other C2 indicators."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^[^.]{40,}\.[^.]+\.[^.]+/ nocase
    $dns.principal.ip = $src
    not $dns.network.dns.questions.name in %global_allowed_domains

  match:
    $src over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($src)
    $query_count = count($dns.metadata.id)
    $sample_query_names = array_distinct($dns.network.dns.questions.name)
    $resolver_ips = array_distinct($dns.target.ip)

  condition:
    #dns >= 25
}
