/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:27:09.631663+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_Time_Provider_Persistence_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, print spooler, database service or script host spawning a shell, script interpreter or registry utility that references the W32Time TimeProviders registry key and a DllName value. This lineage is highly anomalous and indicates time provider DLL registration for persistence, which runs as Local Service at boot."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line populated (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are software installers or management agents launched from a script host or Office macro that legitimately configure a custom time provider (for example a vendor time-sync or PTP agent), and admin automation run through a script host."
    tuning_guidance = "Add approved deployment or time-sync tooling parent binaries to %global_allowed_admin_tools. Add named administrators who legitimately register time providers to %global_allowed_admin_users. Review the parent and child command line, then check the referenced DLL path and the new subkey under W32Time\\TimeProviders."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub|visio|acrord32|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres|mshta|wscript|cscript)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|reg|regedit|wscript|cscript|mshta|rundll32|regsvr32|wmic|sc)\.exe$/ nocase
    $proc.target.process.command_line = /w32time\\timeproviders/ nocase
    $proc.target.process.command_line = /dllname/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
