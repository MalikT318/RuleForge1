/*
  MITRE Technique : T1546.009 - AppCert DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:11:48.022407+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_009_AppCert_DLL_Drop_Then_Registry_Set {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A DLL is written to System32, SysWOW64, ProgramData, a user AppData directory, a Temp directory or Users\\Public, and the AppCertDLLs value under Session Manager is modified on the same host within 10 minutes. AppCert DLLs are loaded into every process that calls CreateProcess-family APIs, giving persistence and privilege escalation. Correlating the file drop with the registry write detects the result of the technique rather than a command line."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.009"
    mitre_technique_name = "Event Triggered Execution: AppCert DLLs"
    log_prerequisites = "Requires Windows endpoint telemetry that records FILE_CREATION and REGISTRY_MODIFICATION events with principal hostname, target file path and target registry key populated (EDR or Sysmon Event IDs 11 and 13)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security products that legitimately register an AppCert DLL (rare, some legacy endpoint protection or application-compatibility and DLP agents), software installers or updaters that drop a DLL and register it, and admin deployment tooling."
    tuning_guidance = "Add approved installers and deployment tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Both lists are matched against the process that wrote the file and the process that wrote the registry value. If a client legitimately uses an AppCert DLL, allowlist the writing process rather than loosening the registry key match."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(windows\\system32|windows\\syswow64|programdata|users\\[^\\]+\\appdata|windows\\temp|users\\public)\\.*\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Session Manager\\AppCertDLLs/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1546.009")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_dll_paths = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
