/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:24:04.402091+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_Env_Check_Then_ScriptHost_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A script host (PowerShell, WScript, CScript, MSHTA) launches a domain or environment discovery command (wmic computersystem, nltest, net config workstation), then makes an external network connection from the same host within 10 minutes. This is consistent with an execution guardrail: the payload verifies it is on the intended target domain before fetching or running the next stage."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "Requires EDR or Sysmon process launch telemetry with parent process and command line (or Windows Event 4688 with command-line auditing), plus network connection telemetry with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or logon scripts that check domain membership and then download content (software deployment, inventory, RMM health checks), and PowerShell-based installers or update checkers."
    tuning_guidance = "Add approved scripting hosts to %global_allowed_script_hosts and deployment or inventory tooling to %global_allowed_admin_tools. Add known-good external domains to %global_allowed_domains if network events carry resolved domains. If noise remains, restrict the host join to servers or to specific script parents."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(wmic|nltest|net|net1)\.exe$/ nocase
    $proc.target.process.command_line = /(computersystem.*(domain|username)|nltest.*\/(dsgetdc|domain_trusts|dclist|dom_list)|config\s+workstation)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($hostname)
    $guardrail_commands = array_distinct($proc.target.process.command_line)
    $script_hosts = array_distinct($proc.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $event_count = count($net.metadata.id)

  condition:
    $proc and $net
}
