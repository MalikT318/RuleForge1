/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:34:59.970080+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_Cloud_Account_Login_Volume_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud account records an unusually high number of sign-in events from external (non-RFC1918) source addresses within one hour. One sign-in is normal, but this volume suggests credential stuffing, token or session replay, or use of a compromised valid account (T1078.004) from attacker infrastructure. The rule groups by the individual account, never by tenant."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires cloud and identity sign-in audit logs normalised to UDM USER_LOGIN, with target.user.userid and principal.ip populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Automation or CI/CD pipelines using interactive-style logins, shared or kiosk accounts, users behind large NAT or VPN egress with frequent session refresh, SSO clients that re-authenticate often, and monitoring or synthetic-login probes."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, authorised testing sources to %global_allowed_scanners, and corporate VPN or proxy egress addresses to %global_allowed_mgmt_sources. Raise or lower the #auth threshold per client based on baseline sign-in volume."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid != ""
    $auth.target.user.userid = $user
    not $auth.principal.ip in %rfc1918_internal
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.ip in %global_allowed_scanners

  match:
    $user over 1h

  outcome:
    $risk_score = max(60)
    $login_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $source_countries = array_distinct($auth.principal.location.country_or_region)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($user)

  condition:
    #auth >= 15
}
