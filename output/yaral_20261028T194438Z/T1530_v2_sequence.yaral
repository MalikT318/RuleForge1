/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:02:34.378030+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_Permission_Grant_Then_Bulk_SaaS_Storage_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a permission, role or consent grant to a user in the identity provider, followed within one hour by bulk resource access from the same user in a SaaS storage or document platform. This pattern is consistent with an adversary elevating access and then harvesting data from cloud storage."
    mitre_tactic = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Requires identity provider directory audit events normalised to USER_CHANGE_PERMISSIONS (with target.user.userid populated) and SaaS storage/document audit events normalised to USER_RESOURCE_ACCESS with a shared user identifier format."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "New starters or role changes followed by legitimate onboarding file access, project handovers, administrators performing approved migrations or eDiscovery, sync clients doing initial bulk downloads, and approved backup or archiving integrations."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or integration accounts to %global_allowed_service_accounts. Raise or lower the #access threshold in the condition to match each client's normal document access volume. Narrow the permission-grant description regex if the identity provider uses different wording."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.description = /(add|assign|grant|elevat|consent|owner|member)/ nocase
    $perm.target.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.target.user.userid in %global_allowed_service_accounts

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.resource.name = /.+/
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

    $perm.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 1h

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1530")
    $primary_entity = array_distinct($user)
    $access_count = count($access.metadata.id)
    $distinct_resources = array_distinct($access.target.resource.name)
    $granting_users = array_distinct($perm.principal.user.userid)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $perm and #access >= 10
}
