/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:33:58.875474+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_Container_Host_Image_Build_Remote_Context {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container image build started on a Linux container host through a container runtime CLI, where the build uses a remote context (URL or git), reads the Dockerfile or context from stdin, or runs with host networking. Adversaries use these patterns to build a custom image locally from a vanilla base image, so registry-pull monitoring never sees a malicious image. Legitimate builds from a local directory context with the default network are not matched."
    mitre_tactic = "Stealth"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires Linux host process telemetry (EDR, auditd execve or runtime-security sensor) with full command lines from container hosts or Kubernetes nodes."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD build agents and developer workstations building from remote git contexts, build pipelines that pipe a Dockerfile through stdin, builds that use host networking to reach internal package mirrors, and platform engineering scripts."
    tuning_guidance = "Add approved build tooling and deployment parent processes to %global_allowed_admin_tools. Add CI runner and automation accounts to %global_allowed_service_accounts. Add approved build hosts to %global_allowed_script_hosts. If host networking is routine in your environment, remove that branch of the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(docker|podman|buildah|nerdctl)$/ nocase
    $proc.target.process.command_line = /\s(build|image\s+build|builder\s+build|buildx\s+build|bud)\s/ nocase
    $proc.target.process.command_line = /(https?:\/\/|git:\/\/|git@|--network[=\s]+host|\s-f\s*-(\s|$)|\s-\s*$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity = array_distinct($proc.principal.hostname)
    $build_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
