/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:29:01.008550+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_Workload_Created_In_Protected_Namespace {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a pod or workload controller (pod, daemonset, deployment, statefulset, job, cronjob) in the kube-system namespace by an identity that is neither a built-in Kubernetes control-plane component nor an approved administrator or service account. Adversaries use this to deploy privileged or host-mounted containers on nodes, for execution or as a stepping stone to host escape. The rule works at the control-plane resource-creation layer, so it does not depend on command-line or in-container process logging."
    mitre_tactic = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires Kubernetes API server audit logs (create verb, ResponseComplete stage) ingested and normalised to RESOURCE_CREATION, with metadata.product_event_type holding the API resource and verb (for example <group>.<version>.<resource>.create) and target.resource.name holding the namespaced resource path."
    platform = "Containers"
    log_source = "container"
    false_positives = "Cluster administrators or GitOps and CI/CD pipelines legitimately deploying system add-ons (CNI, CSI, logging, monitoring or policy agents) into kube-system; managed-cluster upgrade operations performed by the cloud provider's own identities; break-glass troubleshooting pods."
    tuning_guidance = "Add approved deployment identities to %global_allowed_service_accounts, %global_allowed_admin_users or %global_allowed_cloud_principals. If your cluster uses other protected namespaces, extend the namespace regex on target.resource.name. Adjust the built-in control-plane principal exclusion if your distribution uses different controller identities."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.metadata.product_event_type = /\.(pods|daemonsets|deployments|statefulsets|replicasets|jobs|cronjobs)\.create$/ nocase
    $res.target.resource.name = /namespaces\/kube-system\// nocase
    not $res.principal.user.userid = /^system:(node:|kube-controller-manager|kube-scheduler|apiserver|serviceaccount:kube-system:[a-z-]*-controller$)/ nocase
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_admin_users
    not $res.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($res.principal.user.userid)
    $created_resource = array_distinct($res.target.resource.name)
    $api_operation = array_distinct($res.metadata.product_event_type)

  condition:
    $res
}
