/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:48:26.665098+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_IaaS_Instance_OS_Detail_API_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects control-plane API calls that return detailed operating system, patch, inventory, console or guest-attribute data about a compute instance. These calls expose OS version, patch level and architecture without running any command on the host, so they bypass process and command-line logging. Narrower than generic list/describe calls, which are too noisy to alert on in a single-event rule."
    mitre_tactic = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Cloud provider audit logs (management or control-plane events) ingested and normalised to UDM USER_RESOURCE_ACCESS with metadata.product_event_type populated with the API operation name. Data-plane or read-event logging must be enabled where the provider does not log read operations by default."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Patch compliance and inventory tooling, CSPM and asset-management platforms, cloud cost and governance tools, administrators troubleshooting boot problems via serial or console output, and infrastructure automation run by identities not yet in the allowlists."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Add scanners and CSPM identities to %global_allowed_scanners. If volume is high, prioritise events from principals with no prior inventory activity, or where the source IP is external."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(DescribeInstanceInformation|DescribeInstancePatches|DescribeInstancePatchStates|GetInventory|ListInventoryEntries|GetConsoleOutput|GetConsoleScreenshot|DescribeInstanceAttribute|getSerialPortOutput|getGuestAttributes|instanceView\/read)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
