/*
  MITRE Technique : T1216.001 - PubPrn
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:34:44.918361+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_001_PubPrn_Script_Moniker_Remote_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound network connection to an external address made by a Windows script host (cscript/wscript) whose command line invokes the PubPrn script with a remote script: moniker. This is the network-side footprint of PubPrn proxying execution of a remote scriptlet over HTTP(S)."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.001"
    mitre_technique_name = "System Script Proxy Execution: PubPrn"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path and command line on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are red team or purple team exercises, application-control bypass testing by authorised scanners, and administrators testing printer publishing scripts against an externally reachable scriptlet. Legacy Windows builds (pre-10) with unusual printer publishing automation may also trigger it."
    tuning_guidance = "Add authorised test or management hosts to %global_allowed_script_hosts. Internal destinations are already excluded through %rfc1918_internal; keep that list current for each client's address space. Review the destination IPs in the outcome before suppressing."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase
    $net.principal.process.command_line = /pubprn/ nocase
    $net.principal.process.command_line = /script:\s*["']?https?:\/\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_command_line = array_distinct($net.principal.process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
