/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:25:31.505142+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_LSA_Auth_Package_Modified_By_Anomalous_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a write to the LSA 'Authentication Packages', 'Security Packages' or 'Notification Packages' registry values by a process that should never configure LSA. The writer is an Office application, web server worker, print spooler, database service or script interpreter. This is a lineage anomaly: a document, web or database context, or a scripting host, is modifying a pre-boot credential-handling autostart. It complements command-line rules because it still fires when the change is made through native APIs, WMI or in-memory scripts with no reg.exe command line."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) normalised to REGISTRY_MODIFICATION, with the acting process path populated in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party credential providers, smart-card or MFA/SSO agents, and password-filter products (installers sometimes run through script hosts); IT deployment scripts run via PowerShell or cmd that legitimately register LSA notification packages; security products that harden LSA settings."
    tuning_guidance = "Add approved deployment or installer binaries to %global_allowed_admin_tools and EDR or credential-protection agents to %global_allowed_security_tools. Review any hit from Office, web server, spooler or database parents as high confidence, since there is almost no legitimate reason for them. Script-interpreter hits are the most likely to need tuning."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa/ nocase
    (
      $reg.target.registry.registry_value_name = /^(Authentication|Security|Notification) Packages$/ nocase or
      $reg.target.registry.registry_key = /\\Control\\Lsa\\(Authentication|Security|Notification) Packages$/ nocase
    )
    $reg.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|mspub|visio|w3wp|httpd|nginx|tomcat\d*|java|php-cgi|spoolsv|sqlservr|mysqld|postgres|powershell|pwsh|cmd|wscript|cscript|mshta|wmic|rundll32|regsvr32)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_command_line = array_distinct($reg.principal.process.command_line)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_data = array_distinct($reg.target.registry.registry_value_data)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
