/*
  MITRE Technique : T1556.009 - Conditional Access Policies
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:27:35.962344+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_009_Conditional_Access_Policy_Change_Via_Web_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects state-changing HTTP requests (create, update, delete, deactivate) sent to identity-provider management API paths for conditional access policies, named or trusted locations, and sign-on policy rules. Observed on the network side through a TLS-inspecting proxy, secure web gateway or firewall with URL visibility. This covers changes made with stolen tokens or from unmanaged hosts that never appear in endpoint process telemetry."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.009"
    mitre_technique_name = "Modify Authentication Process: Conditional Access Policies"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with populated target.url and network.http.method, for example from a TLS-inspecting proxy or SWG. Identity provider API traffic must be decrypted for the URL path to be visible."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Authorised identity administrators changing policies through the portal or API, infrastructure-as-code pipelines and identity governance tooling that manage policies, and approved change windows."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users. Add automation identities and pipelines to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add trusted admin jump hosts to %global_allowed_mgmt_sources. If URL visibility is partial, tighten the path regex to the policy endpoints in use."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH|DELETE)$/ nocase
    $net.target.url = /\/(identity\/)?conditionalAccess\/(policies|namedLocations|authenticationStrength)|\/api\/v1\/policies\/[^\/]+\/(rules|lifecycle\/deactivate)|\/policies\/[^\/]+\/lifecycle\/deactivate/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.009")
    $primary_entity = array_distinct(strings.coalesce($net.principal.user.userid, $net.principal.hostname))
    $source_hosts = array_distinct($net.principal.hostname)
    $target_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
