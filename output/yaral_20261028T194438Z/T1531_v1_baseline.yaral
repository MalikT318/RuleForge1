/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:30:22.440993+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_IaaS_Credential_Reset_On_Other_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a password or credential change on a cloud account performed by a different identity than the account owner. Adversaries reset or change credentials on legitimate accounts to lock users out (Account Access Removal), often ahead of ransomware or destructive activity. Self-service password changes are excluded, as are approved administrators, service accounts and cloud principals."
    mitre_tactic = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "Requires identity provider or cloud IAM audit logs normalised to UDM USER_CHANGE_PASSWORD with principal.user.userid (actor) and target.user.userid (affected account) populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Help desk password resets, delegated administrators performing user onboarding or offboarding, automated identity lifecycle or self-service reset workflows running under a service identity, and break-glass account use during incident response."
    tuning_guidance = "Add approved help desk and administrator accounts to %global_allowed_admin_users, lifecycle and automation identities to %global_allowed_service_accounts, and approved IAM service principals to %global_allowed_cloud_principals. If volume is high, build a companion threshold rule that counts distinct target accounts per actor and raise severity there."

  events:
    $pw.metadata.event_type = "USER_CHANGE_PASSWORD"
    $pw.principal.user.userid != ""
    $pw.target.user.userid != ""
    $pw.principal.user.userid != $pw.target.user.userid
    not $pw.principal.user.userid in %global_allowed_admin_users
    not $pw.principal.user.userid in %global_allowed_service_accounts
    not $pw.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity = array_distinct($pw.target.user.userid)
    $actor = array_distinct($pw.principal.user.userid)
    $source_ip = array_distinct($pw.principal.ip)

  condition:
    $pw
}
