/*
  MITRE Technique : T1621 - Multi-Factor Authentication Request Generation
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:47:28.547369+00:00
  Reference       : https://attack.mitre.org/techniques/T1621
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1621_MFA_Prompt_Flood_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects MFA fatigue: ten or more unfulfilled or denied MFA challenges (push, app prompt, SMS or voice) for a single user within 10 minutes. Each challenge is benign alone. The volume suggests an adversary holding valid credentials is repeatedly triggering prompts until the user approves one."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1621"
    mitre_technique_name = "Multi-Factor Authentication Request Generation"
    log_prerequisites = "Requires identity provider sign-in audit logs, from the Microsoft 365 or Google Workspace unified audit sources, normalised to UDM USER_LOGIN. MFA challenge outcomes must be present in security_result.summary or security_result.description, and target.user.userid must be populated."
    platform = "Office Suite"
    log_source = "identity"
    false_positives = "Users with a broken or unregistered authenticator device retrying repeatedly, expired or misconfigured conditional access policies, legacy clients or mail apps that re-prompt automatically, helpdesk-assisted enrolment, and automation or service accounts using interactive sign-in."
    tuning_guidance = "Add automation and service identities to %global_allowed_service_accounts. Add privileged administrators who legitimately re-authenticate often to %global_allowed_admin_users. Raise the #auth threshold (default 10) for noisy tenants, or lower it to 6 for privileged-user groups. If a tenant's logs use different MFA wording, adjust the regex."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = $user
    (
      $auth.security_result.summary = /(mfa|multi.?factor|two.?factor|2fa|strong authentication|authenticator|push (notification|request)|verification (request|code))/ nocase or
      $auth.security_result.description = /(mfa|multi.?factor|two.?factor|2fa|strong authentication|authenticator|push (notification|request)|verification (request|code))/ nocase
    )
    (
      $auth.security_result.summary = /(denied|declined|rejected|timed?.?out|no response|not (approved|completed|answered)|pending|interrupted|challenge|required|failed|sent)/ nocase or
      $auth.security_result.description = /(denied|declined|rejected|timed?.?out|no response|not (approved|completed|answered)|pending|interrupted|challenge|required|failed|sent)/ nocase
    )
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1621")
    $primary_entity = array_distinct($user)
    $event_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $source_countries = array_distinct($auth.principal.location.country_or_region)

  condition:
    #auth >= 10
}
