/*
  MITRE Technique : T1213.002 - Sharepoint
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:24:38.000868+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_002_SharePoint_Sensitive_Doc_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a user downloading or syncing a SharePoint document whose path suggests sensitive internal knowledge (network diagrams, architecture, runbooks, credentials, VPN or firewall documentation). Detection is at the unified audit log resource-access layer, so it does not depend on endpoint command-line telemetry."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.002"
    mitre_technique_name = "Data from Information Repositories: Sharepoint"
    log_prerequisites = "Requires Microsoft 365 unified audit logs with SharePoint file operations (FileDownloaded, FileSyncDownloadedFull, FileCopied) ingested and normalised to USER_RESOURCE_ACCESS, with the object URL or path populated in target.url."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "IT and network engineers legitimately retrieving architecture or runbook documents; onboarding and audit activity; documentation migration projects; backup or eDiscovery service accounts not yet allowlisted."
    tuning_guidance = "Add service accounts to %global_allowed_service_accounts and named IT/network administrators to %global_allowed_admin_users. Extend or narrow the keyword regex per client document naming conventions. Consider raising severity for users who are not in IT-related groups."

  events:
    $sp.metadata.event_type = "USER_RESOURCE_ACCESS"
    $sp.metadata.product_event_type = /^(FileDownloaded|FileSyncDownloadedFull|FileCopied)$/ nocase
    $sp.target.url = /\/(sites|teams|personal)\// nocase
    $sp.target.url = /(network[ _\-%20]*diagram|topology|architecture|as[ _\-]?built|runbook|run[ _\-]book|password|credential|secret|vpn|firewall|network[ _\-]*map|ip[ _\-]*plan|\.vsdx?$|\.drawio$)/ nocase
    $sp.principal.user.userid != ""
    not $sp.principal.user.userid in %global_allowed_service_accounts
    not $sp.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1213.002")
    $primary_entity = array_distinct($sp.principal.user.userid)
    $accessed_objects = array_distinct($sp.target.url)
    $source_ips = array_distinct($sp.principal.ip)

  condition:
    $sp
}
