/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:27:56.002206+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_Windows_Peripheral_Device_Enumeration_CmdLine {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects Windows built-in utilities (PowerShell, WMI command line, pnputil) used to enumerate attached peripheral devices such as USB devices, keyboards, pointing devices, printers, disk and optical drives, or smart card readers. Matches the combination of an enumeration verb and a peripheral device class rather than a specific tool, so renamed wrappers that still run these queries are covered."
    mitre_tactic = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT asset inventory scripts, RMM health checks, driver and printer deployment tooling, helpdesk troubleshooting of USB or printer issues, endpoint DLP and device-control agents, software installers checking for hardware."
    tuning_guidance = "Add inventory and RMM parent binaries to %global_allowed_admin_tools, service accounts used for inventory to %global_allowed_service_accounts, and EDR or DLP agents to %global_allowed_security_tools. Raise severity when the parent is an Office application, script host, or browser, or when combined with other discovery activity on the same host."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wmic|pnputil|cmd)\.exe$/ nocase
    $proc.target.process.command_line = /(get-pnpdevice|get-pnpdeviceproperty|pnputil(\.exe)?["']?\s+[\/-]enum-devices|(wmic|get-wmiobject|gwmi|get-ciminstance|gcim).{0,80}win32_(pnpentity|usbcontrollerdevice|usbhub|keyboard|pointingdevice|printer|diskdrive|cdromdrive|smartcardreader|1394controller|tapedrive))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
