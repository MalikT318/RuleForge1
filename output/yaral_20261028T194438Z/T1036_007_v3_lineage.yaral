/*
  MITRE Technique : T1036.007 - Double File Extension
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:07:54.480747+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_007_Double_Extension_Binary_From_User_Facing_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process whose image file name carries a document, image or archive extension followed by an executable or script extension (for example report.pdf.exe). The process must be launched by a user-facing parent such as an email client, browser, Office application, archive utility or Explorer. This lineage is typical of a user opening a masqueraded email attachment or download."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.007"
    mitre_technique_name = "Masquerading: Double File Extension"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR, Sysmon Event ID 1 or Security Event 4688) with parent and child image paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Internally developed or legacy software with unusual file names (for example setup.pdf.exe from a vendor), software packagers or installers that embed a document extension in the executable name, and IT staff testing masquerading controls."
    tuning_guidance = "Add approved deployment or packaging tools to %global_allowed_admin_tools (matched on the parent or the child image path). Extend the parent regex with organisation-specific mail or file-transfer clients, or narrow it to mail and Office parents only if Explorer launches are noisy."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(outlook|olk|thunderbird|winword|excel|powerpnt|explorer|chrome|msedge|firefox|brave|7zfg|7zg|winrar)\.exe$/ nocase
    $proc.target.process.file.full_path = /\.(txt|pdf|docx?|xlsx?|pptx?|rtf|csv|jpe?g|png|gif|bmp|zip|mp3|mp4)\s*\.(exe|scr|com|pif|bat|cmd|js|jse|vbs|vbe|wsf|hta)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
