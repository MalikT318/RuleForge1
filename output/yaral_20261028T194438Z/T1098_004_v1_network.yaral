/*
  MITRE Technique : T1098.004 - SSH Authorized Keys
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:45:08.008701+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_004_Linux_SSH_Public_Key_Download_Via_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripted HTTP client (curl, wget, python and similar) fetching an SSH public key or authorized_keys-style file from an external destination. Adversaries commonly stage or pull adversary-supplied keys this way before appending them to ~/.ssh/authorized_keys. This is network-side coverage that does not depend on endpoint process or command-line telemetry."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.004"
    mitre_technique_name = "Account Manipulation: SSH Authorized Keys"
    log_prerequisites = "Requires forward-proxy or perimeter firewall logs with HTTP inspection (full URL and user agent) normalised to NETWORK_HTTP. HTTPS traffic is only visible with TLS inspection enabled."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Configuration management and provisioning tools (cloud-init, Ansible, Puppet) fetching keys from internal or external key servers; admins retrieving their own published keys from a code-hosting platform during server build; bootstrap scripts in CI/CD pipelines."
    tuning_guidance = "Add known-good key distribution domains to %global_allowed_domains. Add provisioning and bastion hosts to %global_allowed_script_hosts. Internal destinations are excluded via %rfc1918_internal; if the proxy logs the internal proxy address as the target IP, confirm the target.ip population before deployment."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.user_agent = /(curl|wget|python|libwww|go-http-client|fetch|aiohttp)/ nocase
    $http.target.url = /\/(authorized_keys2?|id_(rsa|dsa|ecdsa|ed25519)\.pub|[^\/?#]+\.keys)([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1098.004")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
