/*
  MITRE Technique : T1125 - Video Capture
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:34:37.498796+00:00
  Reference       : https://attack.mitre.org/techniques/T1125
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1125_Linux_Outbound_Video_Stream_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Network-observable proxy for T1125 on Linux hosts: one internal host opens many outbound connections to external destinations on video-streaming ports (RTSP 554/8554, RTMP 1935) within 10 minutes. A single stream is benign, but repeated sessions from a server-class Linux host can indicate captured webcam or video content being streamed or exfiltrated. A perimeter log cannot see the capture itself, so this is a low-fidelity indicator that needs host-level correlation."
    mitre_tactic = "Collection"
    mitre_technique = "T1125"
    mitre_technique_name = "Video Capture"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalized to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated. Egress must be logged at the perimeter."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate IP camera or NVR cloud uplinks, video conferencing or live-streaming services, media servers, and developer or lab hosts publishing RTMP or RTSP streams."
    tuning_guidance = "Add known-good streaming and vendor domains to %global_allowed_domains. If the firewall does not populate principal.hostname, map the host identity at ingestion. Raise the #net threshold on sites with cameras or media workloads. Scope the rule to Linux assets through the asset inventory, since perimeter logs do not identify the OS."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 554 or $net.target.port = 8554 or $net.target.port = 1935)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $distinct_destinations = count_distinct($net.target.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $mitre_technique_id = array_distinct("T1125")
    $primary_entity = array_distinct($host)

  condition:
    #net >= 10
}
