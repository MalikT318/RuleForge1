/*
  MITRE Technique : T1137 - Office Application Startup
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:12:24.952174+00:00
  Reference       : https://attack.mitre.org/techniques/T1137
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_Office_Addin_Or_Startup_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of the Office persistence locations: application add-in registration (Addins\\<name>), the Office test Special Perf DLL-load key, and the Outlook Today/Webview home page keys. Each is read by Office when an Office application starts, so a change gives an adversary code execution on every launch. Writes by Office installer and update processes are excluded by executable name."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137"
    mitre_technique_name = "Office Application Startup"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry value set events) mapped to UDM REGISTRY_MODIFICATION with target.registry.registry_key and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office COM/VSTO add-in installs (CRM, PDF, e-signature, DLP, and telemetry add-ins), Office updates and repairs run through msiexec or Click-to-Run, software deployment tools pushing add-ins, and users enabling or disabling add-ins from the Office UI."
    tuning_guidance = "Add software deployment and RMM binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. If a client deploys a standard add-in through a known installer, add that installer's full path to %global_allowed_admin_tools. Review the registry key outcome before suppressing any process."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\(Office\\([0-9.]+\\)?[^\\]+\\Addins\\|Office test\\Special\\Perf|Office\\[0-9.]+\\Outlook\\(Webview|Today)(\\|$))/ nocase
    not $reg.principal.process.file.full_path = /\\(OfficeClickToRun|OfficeC2RClient|integrator)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
