/*
  MITRE Technique : T1505.003 - Web Shell
  Tactic(s)       : Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:30:35.896640+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_003_Linux_WebServer_Process_Drops_Script_In_Webroot {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server or application runtime process (Apache, nginx, PHP-FPM, Tomcat/Java, and similar) creating a server-side script file (php, phtml, jsp, jspx, cgi, asp/aspx) inside a web-served directory on Linux. This is the file-write result of a web shell upload or exploitation of an upload or RCE flaw. It uses file-creation telemetry, not command-line matching, so it complements process-creation rules."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.003"
    mitre_technique_name = "Server Software Component: Web Shell"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (FILE_CREATION) with the writing process path populated, covering web root directories."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CMS and plugin updates (WordPress, Drupal, Joomla) that write PHP files as the web server user; Tomcat/Java WAR auto-deployment extracting JSPs; framework template or cache compilation written inside the web root; legitimate file-manager or upload features that permit script types; web-based installers."
    tuning_guidance = "Add deployment and configuration-management binaries to %global_allowed_admin_tools and deploy accounts to %global_allowed_admin_users. For CMS-heavy tenants, consider scoping out known update and cache subdirectories per client by cloning the rule. Raise severity when the file lands in an upload or temp-style subdirectory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(var\/www|srv\/www|srv\/http|usr\/share\/nginx|webapps|htdocs|public_html|wwwroot)\/.*\.(php[0-9]?|phtml|phar|jsp|jspx|cgi|aspx?)$/ nocase
    $file.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|php-cgi|java|tomcat[0-9]*|lighttpd|uwsgi|gunicorn|node)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
