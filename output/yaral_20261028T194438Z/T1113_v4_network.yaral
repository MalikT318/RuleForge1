/*
  MITRE Technique : T1113 - Screen Capture
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:14:53.683062+00:00
  Reference       : https://attack.mitre.org/techniques/T1113
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1113_Linux_Screen_Capture_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of Linux screen capture. A process that is a screen-grab utility, or a media tool configured with a screen or framebuffer capture input (x11grab, kmsgrab, fbdev), opens a connection to an external address. Native screenshot tools have no reason to talk to the internet, so this indicates captured screen content being exfiltrated or streamed to an operator. It complements process-creation command-line rules by observing the resulting network behaviour."
    mitre_tactic = "Collection"
    mitre_technique = "T1113"
    mitre_technique_name = "Screen Capture"
    log_prerequisites = "Requires Linux EDR or auditd network connection telemetry (connect syscalls) that populates the principal process path and command line along with the target IP."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Screenshot tools with built-in cloud upload (for example flameshot uploading to an image host), approved screen-sharing or remote support sessions using framebuffer capture, legitimate livestream or screen-recording workflows that push to an external RTMP endpoint, and helpdesk tooling."
    tuning_guidance = "Add approved remote support and screen-sharing binaries to %global_allowed_remote_mgmt, and IT tooling to %global_allowed_admin_tools. Review hosts that legitimately stream screens (training or media workstations) and exclude them via the allowlists. Raise severity for servers with no desktop session, where any screen capture activity is anomalous."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /\/(xwd|scrot|maim|grim|import|gnome-screenshot|spectacle|flameshot)$/ nocase
      or
      $net.principal.process.command_line = /-f\s+(x11grab|kmsgrab|fbdev)/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1113")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $capture_process = array_distinct($net.principal.process.file.full_path)
    $capture_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
