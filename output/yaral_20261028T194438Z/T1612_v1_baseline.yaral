/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:32:49.803641+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_Container_Image_Build_On_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container image build started on a host or node through a container build CLI (build, buildx build, image build, bud). Adversaries build images locally so a vanilla base image plus attacker-supplied Dockerfile steps avoids registry-pull scanning. Builds outside approved CI/build hosts and service accounts are unexpected on production runtime nodes."
    mitre_tactic = "Stealth"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires container-host or in-container process launch telemetry (EDR/runtime sensor or auditd execve) populating target.process.file.full_path, target.process.command_line, principal.hostname and principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD build agents, developer workstations or build nodes, image-baking pipelines, admins troubleshooting images on a node, and scheduled rebuild jobs."
    tuning_guidance = "Add approved build hosts and CI parent processes to %global_allowed_script_hosts, build tooling to %global_allowed_admin_tools, and pipeline identities to %global_allowed_service_accounts. Scope the rule to production runtime and Kubernetes worker nodes where builds are never expected."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(docker|podman|buildah|nerdctl|buildctl|img)$/ nocase
    $proc.target.process.command_line = /(^|\s)(image\s+build|buildx\s+build|builder\s+build|build|bud)(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity = array_distinct($proc.principal.hostname)
    $build_command = array_distinct($proc.target.process.command_line)
    $build_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
