/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:14:59.766094+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_Office_Remote_Fetch_Then_Executable_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An Office application makes an outbound web or SMB connection to an external address and then writes an executable, script, or macro-enabled template file to a user-writable location on the same host within 10 minutes. This is consistent with a remote template reference (template injection) pulling down and staging a payload when a document is opened."
    mitre_tactic = "Stealth"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry (Sysmon EID 3) and file creation telemetry (Sysmon EID 11) with populated initiating process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-in installers and updaters, VSTO or XLL add-in deployment, Click-to-Run updates writing DLLs to user profile paths, users saving macro-enabled templates (.dotm) downloaded from legitimate SharePoint or web template libraries, and software deployment run from within Office."
    tuning_guidance = "Add approved deployment or add-in tooling paths to %global_allowed_admin_tools. Exclude service or automation accounts via %global_allowed_service_accounts. Narrow the file extension regex or directory regex if a client's line-of-business add-ins generate noise."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(winword|excel|powerpnt|visio|mspub)\.exe$/ nocase
    ($net.target.port = 80 or $net.target.port = 443 or $net.target.port = 445)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|visio|mspub)\.exe$/ nocase
    $file.target.file.full_path = /\.(exe|dll|scr|hta|js|jse|vbs|vbe|wsf|ps1|bat|cmd|dotm|wll|xll)$/ nocase
    $file.target.file.full_path = /\\(appdata|temp|programdata|users\\public)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    $net.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($file.principal.hostname)
    $remote_ips = array_distinct($net.target.ip)
    $office_processes = array_distinct($file.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropped_file_count = count($file.metadata.id)

  condition:
    $net and $file
}
