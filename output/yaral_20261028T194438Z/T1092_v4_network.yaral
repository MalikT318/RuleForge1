/*
  MITRE Technique : T1092 - Communication Through Removable Media
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:36:11.025487+00:00
  Reference       : https://attack.mitre.org/techniques/T1092
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1092_Linux_Removable_Media_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process whose executable image resides on a removable-media or external mount point (/media, /run/media, /mnt) initiating an outbound connection to a non-internal address. This is the network-side footprint of an Internet-connected relay host executing implant code carried in from an air-gapped host over removable media, or exfiltrating relayed data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1092"
    mitre_technique_name = "Communication Through Removable Media"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Portable applications run from USB drives, software installers or updaters run from mounted install media, admin tools run from NFS or network mounts under /mnt, backup or imaging agents run from external disks, and developers running binaries from external storage."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_backup_processes or %global_allowed_security_tools. Add approved destination domains or addresses via %global_allowed_domains or %global_allowed_mgmt_sources if needed. If /mnt is heavily used for permanent NFS or data volumes in a client environment, remove it from the path regex and keep /media and /run/media."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(media|run\/media|mnt)\/.+/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1092")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
