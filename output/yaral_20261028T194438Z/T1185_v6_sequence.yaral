/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:32:01.887102+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_Browser_Injection_Then_Unusual_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-browser process injects into a web browser process, and that browser then connects to an external destination on a non-standard web port within 10 minutes on the same host. This pattern is consistent with browser session hijacking, man-in-the-browser or browser-pivot proxying, where an implant inherits the user's authenticated browser context and relays traffic."
    mitre_tactic = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires Windows endpoint telemetry that records cross-process injection (PROCESS_INJECTION) and per-process network connections (NETWORK_CONNECTION) with process paths populated, such as EDR or Sysmon events 8/10 and 3."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, password managers and browser-integrated security or DLP agents that inject into browsers, game overlays and input-method editors, application-compatibility shims, browser-based developer or debugging tools that use uncommon ports, and enterprise web-isolation or proxy agents."
    tuning_guidance = "Add approved injecting agents (EDR, DLP, accessibility tools) to %global_allowed_security_tools or %global_allowed_admin_tools. Add known-good destination domains to %global_allowed_domains. Add legitimate management or automation accounts to %global_allowed_service_accounts. If developer endpoints cause noise, consider extending the excluded port list or scoping the rule to non-developer asset groups."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera|vivaldi)\.exe$/ nocase
    not $inj.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera|vivaldi)\.exe$/ nocase
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.user.userid in %global_allowed_service_accounts
    $inj.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera|vivaldi)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    $inj.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity = array_distinct($hostname)
    $injector_processes = array_distinct($inj.principal.process.file.full_path)
    $injected_browsers = array_distinct($inj.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $injection_count = count($inj.metadata.id)

  condition:
    $inj and $net
}
