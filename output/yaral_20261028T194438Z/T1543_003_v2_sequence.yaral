/*
  MITRE Technique : T1543.003 - Windows Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:55:41.016487+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_003_Dropped_Binary_Then_Service_ImagePath_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An executable or driver (.exe/.sys/.dll) is written to a user-writable or staging directory, and within 10 minutes a service ImagePath registry value is created or modified under the Services key on the same host. This indicates a dropped payload being registered as a Windows service for persistence or driver loading, regardless of whether sc.exe, the registry, or the service API was used."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.003"
    mitre_technique_name = "Create or Modify System Process: Windows Service"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon EID 11) and registry modification telemetry (Sysmon EID 12/13) for HKLM\\SYSTEM\\CurrentControlSet\\Services, normalized to UDM FILE_CREATION and REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that stage binaries in ProgramData or Temp and then register a service; RMM and deployment agents; driver installers; EDR/AV agent self-updates."
    tuning_guidance = "Add approved deployment, patching and RMM binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Narrow or extend the staging-directory regex per customer. Raise severity if the registry writer is not services.exe or a known installer."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|users\\public|programdata|windows\\temp|perflogs|\$recycle\.bin)\\.*\.(exe|sys|dll)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d+)\\Services\\[^\\]+$/ nocase
    $reg.target.registry.registry_value_name = /^ImagePath$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1543.003")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $service_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)
    $file_event_count = count($file.metadata.id)

  condition:
    $file and $reg
}
