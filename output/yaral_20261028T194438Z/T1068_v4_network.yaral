/*
  MITRE Technique : T1068 - Exploitation for Privilege Escalation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:54:22.980984+00:00
  Reference       : https://attack.mitre.org/techniques/T1068
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1068_SYSTEM_Process_From_UserWritable_Path_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a process running as SYSTEM whose image sits in a user-writable location (user profile, Public, Windows\\Temp, Windows\\Tasks). Binaries staged in low-privilege-writable paths that then run as SYSTEM and call out are a network-side result of local privilege escalation exploitation, such as a payload dropped by a low-privilege foothold and executed in SYSTEM context after a kernel or service exploit. The rule keys on the privilege and location mismatch rather than on any tool name or exploit string."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1068"
    mitre_technique_name = "Exploitation for Privilege Escalation"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path and user context on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SYSTEM-context software installers or updaters that run from Windows\\Temp or a user profile and download packages; RMM and deployment agents staging in temp folders; per-user applications deployed via SYSTEM-level management tooling; EDR or AV self-update components."
    tuning_guidance = "Add approved deployment, RMM and updater binaries to %global_allowed_admin_tools, and security agents to %global_allowed_security_tools. Add known-good vendor and update destinations to %global_allowed_domains. If Windows\\Temp installer noise is high for a client, narrow the path regex for that client to the user profile and Public folders only."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.user.userid = /^(nt authority\\)?system$/ nocase
    $net.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|windows\\temp|windows\\tasks)\\/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1068")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
