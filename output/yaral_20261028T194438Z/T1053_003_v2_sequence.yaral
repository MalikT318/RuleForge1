/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:14:17.305687+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_ESXi_Login_Then_Crontab_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a remote login to an ESXi host followed within one hour by a modification of a crontab file under /var/spool/cron/crontabs/ on the same host. ESXi has no crontab utility workflow, so cron persistence is created by editing the root crontab file directly, a technique seen in ESXi ransomware campaigns. This rule is based on file-modification telemetry correlated with authentication, not on process command lines."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Requires ESXi host logs (shell, auth/sshd, hostd) forwarded to Chronicle, with login events parsed to USER_LOGIN and file-integrity or audit telemetry for the crontab directory parsed to FILE_MODIFICATION."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Approved administrators or automation adding scheduled maintenance jobs such as log rotation, health checks, or backup scripts; vendor or lifecycle tooling that edits the root crontab after patching; configuration management pushing cron entries."
    tuning_guidance = "Add expected administrator accounts to %global_allowed_admin_users. Add approved automation and management binaries to %global_allowed_admin_tools. If SSH logins are not labelled in metadata.description in your parser, relax or adjust the description filter on the login event."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.metadata.description = /ssh/ nocase
    not $login.target.user.userid in %global_allowed_admin_users
    $login.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/var\/spool\/cron\/crontabs\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    $file.principal.hostname = $hostname

    $login.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($login.target.user.userid)
    $modified_crontabs = array_distinct($file.target.file.full_path)
    $login_count = count($login.metadata.id)

  condition:
    $login and $file
}
