/*
  MITRE Technique : T1036.002 - Right-to-Left Override
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:59:41.172133+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_002_RTLO_Executable_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file whose name contains the right-to-left override character (U+202E) followed by an executable or script extension. This is the classic RTLO masquerading pattern where a .scr or .js file is made to look like a document or image. Uses FILE_CREATION telemetry rather than process command lines, so it complements process-launch coverage and fires at drop time, before execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.002"
    mitre_technique_name = "Masquerading: Right-to-Left Override"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR file events or Sysmon Event ID 11) with the full file path populated and Unicode characters preserved in the path during UDM normalisation."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Legitimate files with names in right-to-left languages (Arabic, Hebrew) that include an explicit override character and an executable extension, such as localised installers or software packaged by developers in RTL locales. Security tools writing quarantine or sample copies of malicious files."
    tuning_guidance = "Add endpoint security agents and sandbox or quarantine writers to %global_allowed_security_tools. Add approved software deployment tooling that drops localised installers to %global_allowed_admin_tools. If the client's UDM mapping strips non-printing characters from paths, this rule will not fire and a client-specific field mapping is needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\x{202E}[^\\]*\.(exe|scr|com|pif|bat|cmd|js|jse|vbs|vbe|wsf|hta|ps1|lnk|cpl|msi|dll)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
