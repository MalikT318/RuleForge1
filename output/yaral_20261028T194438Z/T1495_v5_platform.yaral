/*
  MITRE Technique : T1495 - Firmware Corruption
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:48:52.346266+00:00
  Reference       : https://attack.mitre.org/techniques/T1495
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1495_Network_Device_Firmware_TFTP_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a TFTP connection (UDP/69) observed at the network perimeter from a source that is not an approved management host. TFTP is the usual transport for pushing firmware or OS images to routers, switches and firewalls, so an unapproved source may be staging or overwriting device firmware (T1495). This is a network-observable precursor and does not confirm that corruption occurred."
    mitre_tactic = "Impact"
    mitre_technique = "T1495"
    mitre_technique_name = "Firmware Corruption"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. TFTP traffic must traverse the logging firewall, either as a flow between network segments or as inbound traffic from outside."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network engineers performing approved firmware upgrades or config backups over TFTP from a jump host; zero-touch provisioning and PXE boot servers; lab or staging networks; automated network configuration management platforms."
    tuning_guidance = "Add approved network management and jump host source addresses to %global_allowed_mgmt_sources. Add authorised scanners or testing sources to %global_allowed_scanners. Where PXE or provisioning servers legitimately use TFTP, add them to %global_allowed_mgmt_sources. Consider raising severity for sources outside internal address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1495")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
