/*
  MITRE Technique : T1560.002 - Archive via Library
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:58:52.939763+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_002_Interpreter_Created_Archive_In_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an archive file (zip, 7z, rar, tar, gz, bz2) in a common staging location by a scripting or interpreter host process. Scripting runtimes do not normally write archives to user-writable staging folders unless they link a compression library (Python zipfile/zlib/rarfile, .NET System.IO.Compression via PowerShell, WSH). This is the file artifact of library-based archiving ahead of exfiltration, and it fires regardless of how the command line was obfuscated or logged."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.002"
    mitre_technique_name = "Archive Collected Data: Archive via Library"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Python-based or PowerShell-based IT automation and backup scripts, software packaging or build jobs, developer workstations running Python tooling, Compress-Archive used by admins for log collection, and installers or updaters that unpack zip payloads to ProgramData or Temp."
    tuning_guidance = "Add approved script hosts and parent tools to %global_allowed_script_hosts, %global_allowed_admin_tools or %global_allowed_backup_processes. Add automation accounts to %global_allowed_service_accounts. On developer-heavy tenants, scope by host group or tighten the staging path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(zip|7z|rar|tar|gz|tgz|bz2|xz)$/ nocase
    $file.target.file.full_path = /\\users\\[^\\]+\\(appdata\\local\\temp|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\perflogs\\/ nocase
    $file.principal.process.file.full_path = /\\(pythonw?[0-9.]*|powershell|pwsh|wscript|cscript)\.exe$/ nocase
    not $file.target.file.full_path = /\\(pip|pip-[^\\]*|site-packages|windowsapps)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1560.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $archive_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
