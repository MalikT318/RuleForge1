/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:49:29.681329+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Unexpected_Process_Injecting_Into_Another_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process injection or remote-thread handle event whose source is a process that should never inject into other processes: an Office application, web server worker, print spooler or database service. This lineage anomaly points to exploitation or macro-driven thread execution hijacking, where the host process hijacks a thread in a separate live process. It does not rely on command-line matching."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires Windows endpoint telemetry that emits cross-process injection, remote-thread or thread-context events (EDR, or Sysmon event IDs 8 and 10) normalised to PROCESS_INJECTION, with principal.process and target.process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint security or DLP agents hooking Office and web server processes; application-compatibility shims; APM and profiling agents attached to IIS or database services; legitimate Office add-ins that use injection-based accessibility or automation; backup agents touching database processes."
    tuning_guidance = "Add legitimate agent binaries to %global_allowed_security_tools, %global_allowed_admin_tools or %global_allowed_backup_processes. If an APM or profiler legitimately attaches to a web or database process, add its full path to %global_allowed_admin_tools. Extend or trim the source-process regex to match the services deployed in each client environment."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $inj.target.process.file.full_path != ""
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    $inj.principal.hostname != ""
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($inj.principal.hostname)
    $source_process = array_distinct($inj.principal.process.file.full_path)
    $victim_process = array_distinct($inj.target.process.file.full_path)
    $source_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
