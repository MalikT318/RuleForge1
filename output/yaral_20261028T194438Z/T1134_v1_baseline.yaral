/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:50:55.523011+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_SYSTEM_Shell_Spawned_By_NonSystem_Context {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script host or common proxy-execution binary that starts under the SYSTEM security context while its parent process runs as an ordinary, non-system account. This is the typical result of token theft or duplication followed by CreateProcessWithToken or CreateProcessAsUser, where an administrator elevates to SYSTEM without going through the Service Control Manager."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR or Sysmon Event ID 1) that populates both the parent (principal) user and the child (target) user on PROCESS_LAUNCH events. Windows Security Event 4688 works only if token elevation and user fields are mapped into UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Sanctioned RMM or software-deployment agents that launch SYSTEM shells on behalf of a logged-in technician. Interactive admin tools that deliberately launch SYSTEM consoles (for example, support tooling run by helpdesk staff). Some EDR live-response shells. Endpoint agents whose telemetry reports a user-mode parent user for SYSTEM children."
    tuning_guidance = "Add approved RMM, deployment and live-response parent binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Add approved automation hosts to %global_allowed_script_hosts. Add named administrator accounts that legitimately launch SYSTEM shells to %global_allowed_admin_users. If your EDR reports an empty parent user for service-launched processes, the non-empty principal user condition already prevents false positives."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child is an interpreter or common proxy-execution binary
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|powershell_ise|wscript|cscript|mshta|rundll32|regsvr32|wmic)\.exe$/ nocase

    // Child runs as SYSTEM
    $proc.target.user.userid = /^((nt authority|nt-autorit.t)\\)?system$|^s-1-5-18$/ nocase

    // Parent runs as a real, non-system principal
    $proc.principal.user.userid = /.+/
    not $proc.principal.user.userid = /^((nt authority|nt-autorit.t)\\)?(system|local service|network service)$|\$$|^s-1-5-(18|19|20)$|^(font driver host|window manager)\\/ nocase

    // Parent is not a native SYSTEM service launcher
    not $proc.principal.process.file.full_path = /\\(services|wininit|winlogon|smss|csrss|svchost|msiexec|taskhostw|taskeng)\.exe$/ nocase

    // Tunable exclusions
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
