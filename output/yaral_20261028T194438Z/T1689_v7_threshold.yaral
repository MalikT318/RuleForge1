/*
  MITRE Technique : T1689 - Downgrade Attack
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:38:37.500146+00:00
  Reference       : https://attack.mitre.org/techniques/T1689
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1689_PowerShell_Version_Downgrade_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Repeated launches of Windows PowerShell with the -Version 2 switch (or any accepted abbreviation) on a single host within 10 minutes. Forcing the legacy engine downgrades the host to a version without Script Block Logging, AMSI, or Constrained Language Mode support. One launch can be a legitimate compatibility test, but a burst indicates scripted or interactive defense impairment."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1689"
    mitre_technique_name = "Downgrade Attack"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled, normalized to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy application compatibility testing, old installers or vendor scripts that explicitly request PowerShell 2.0, admin troubleshooting, and RMM or deployment tooling running legacy scripts."
    tuning_guidance = "Add approved deployment, RMM, and patching parent processes to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts with known legacy workloads. Scale triage priority by event_count and the number of distinct users in the outcome."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\powershell(_ise)?\.exe$/ nocase
    $proc.target.process.command_line = /\s[-\/]v(e|er|ers|ersi|ersio|ersion)?[\s:]+2(\.0)?(\s|$)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1689")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
