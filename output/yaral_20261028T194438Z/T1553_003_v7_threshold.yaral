/*
  MITRE Technique : T1553.003 - SIP and Trust Provider Hijacking
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:03:57.696447+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Registry_Tampering_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of registry modifications on a single host within 10 minutes under the Windows SIP (CryptSIPDll*) and Trust Provider (Providers\\Trust\\FinalPolicy and related) keys. Registering a malicious SIP or trust provider takes several value writes (Dll, FuncName) across these keys. A single write can occur during legitimate installs, but several in a short window indicate signature-validation hijacking."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 equivalent) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Code-signing, PKI or application-control products that register their own SIP or trust provider during install or upgrade; Windows servicing (TrustedInstaller, TiWorker) during cumulative updates; PowerShell or Windows SDK component installs; software deployment agents."
    tuning_guidance = "Add approved deployment or signing tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Raise the #reg threshold (default 3) in noisy estates, or lower it to 2 for high-security hosts. Review the $registry_keys and $modifying_processes outcome values to identify the Dll values being registered."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Cryptography\\(OID\\EncodingType\s+\d\\CryptSIPDll(GetSignedDataMsg|PutSignedDataMsg|CreateIndirectData|VerifyIndirectData|RemoveSignedDataMsg|IsMyFileType2?)|Providers\\Trust\\(FinalPolicy|Initialization|Cleanup|Certificate|Message|Signature|DiagnosticPolicy|CertCheck))/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_key = /CryptSIPDllVerifyIndirectData|Trust\\FinalPolicy/ nocase, 90, 75))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity = array_distinct($host)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
