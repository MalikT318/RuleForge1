/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:54:30.814908+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Linux_ServiceParent_Spawns_Credential_Memory_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or data service process (web server, application server, database, print spooler) spawning a shell, script interpreter or debugger whose command line targets process memory (/proc/<pid>/mem or /proc/<pid>/maps) or a keyring/secret-service daemon. This is the Linux analogue of scraping securityd memory for keychain master keys. The detection pivots on the anomalous parent-child lineage, not on the command line alone."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH, with parent process path (principal.process.file.full_path), child process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application servers or database engines that legitimately shell out to diagnostic scripts (JVM heap or thread dump helpers, core-dump collectors, support tooling); developers debugging a service with gdb under a service parent; monitoring agents launched by an application server that read /proc/<pid>/maps."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add EDR and monitoring agents to %global_allowed_security_tools. Add approved backup or imaging parents to %global_allowed_backup_processes. Extend the parent regex with client-specific service names if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(httpd|apache2|nginx|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|catalina|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby|php[0-9.]*|lua|gdb|gcore|strace|ltrace)$/ nocase
    $proc.target.process.command_line = /(\/proc\/(\d+|self|\$[^\/\s]+)\/(mem|maps))|((gnome-keyring|kwalletd|secret-?service|keyring).*(gcore|gdb|strings|ptrace|\bdd\b))|((gcore|gdb|strings|ptrace|\bdd\b).*(gnome-keyring|kwalletd|secret-?service|keyring|pidof))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
