/*
  MITRE Technique : T1133 - External Remote Services
  Tactic(s)       : Persistence, Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:49:58.198349+00:00
  Reference       : https://attack.mitre.org/techniques/T1133
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1133_Container_External_Access_To_Exposed_Control_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an inbound network connection from a non-internal source address to a container control-plane port: the container runtime API (2375/2376), kubelet (10250/10255), etcd client (2379) or the Kubernetes API server (6443). Unauthenticated or weakly protected exposure of these services is a documented initial-access and persistence path for containerized environments."
    mitre_tactic = "Persistence, Initial Access"
    mitre_technique = "T1133"
    mitre_technique_name = "External Remote Services"
    log_prerequisites = "Requires network connection telemetry (node or VPC flow logs, CNI or service-mesh connection logs, or host firewall logs) from container hosts and cluster nodes, normalised to UDM NETWORK_CONNECTION with principal.ip as the client and target.port as the service port."
    platform = "Containers"
    log_source = "container"
    false_positives = "Managed Kubernetes clusters with a public API endpoint used by CI/CD runners, remote administrators or SaaS posture tools; external monitoring or uptime probes; NAT or proxy egress addresses of corporate VPNs that are not in the internal address list; authorised external penetration tests."
    tuning_guidance = "Add approved admin, CI/CD and VPN egress source addresses to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. If the clusters intentionally expose a public Kubernetes API endpoint, remove port 6443 from the rule or rely on the allowlist. Keep the container runtime, kubelet and etcd ports alerting at all times."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 2375 or
      $net.target.port = 2376 or
      $net.target.port = 10250 or
      $net.target.port = 10255 or
      $net.target.port = 2379 or
      $net.target.port = 6443
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1133")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
