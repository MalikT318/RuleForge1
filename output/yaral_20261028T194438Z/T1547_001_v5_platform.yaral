/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:24:25.650630+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_Startup_Folder_Executable_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an executable, script or shortcut file inside a per-user or all-users Windows Startup folder by a process other than known installers or security tooling. The Startup folder is the file-system counterpart of Registry Run keys and runs the dropped item at user logon. This rule uses FILE_CREATION telemetry rather than process command lines, so it complements command-line rules. The requested alternate-platform angle was not applied because the platform requirement for this task is Windows only."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates target.file.full_path and the principal process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that create startup shortcuts, RMM and deployment agents, user-driven shortcut creation by IT staff, and profile migration tools."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. If .lnk creation by installers is noisy, remove lnk from the extension list for that tenant. Raise severity for script or PE extensions written by Office, browser or interpreter parent processes."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\Start Menu\\Programs\\Start-?up\\[^\\]+\.(exe|dll|scr|com|cpl|bat|cmd|ps1|vbs|vbe|js|jse|wsf|wsh|hta|lnk)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|MsMpEng|MsSense|SenseIR|TiWorker|wuauclt|usoclient)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $startup_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
