/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:40:02.304167+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Hive_Export_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file named like an exported SAM registry hive (for example from 'reg save', hive copy from a shadow copy, or an offline dump) outside the protected Windows configuration directories. Detection is on the resulting file artefact, not the process command line, so it complements command-line rules. Note: T1003.002 applies only to Windows, so the alternate-platform angle could not be met; this rule provides additive Windows coverage by pivoting on the FILE_CREATION result instead."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates target.file.full_path and the principal process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software exporting registry hives, forensic or incident-response collection, system migration tools, administrators performing authorised hive backups, and OS servicing or repair operations."
    tuning_guidance = "Add approved backup and imaging executables to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and approved IT tooling to %global_allowed_admin_tools. Attackers can choose arbitrary output file names, so pair with the command-line rule for full coverage. Extend the filename extension list per client if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(^|\\)sam(\.(save|hive|hiv|bak|backup|old|dmp|out|dat|copy|tmp))?$/ nocase
    not $file.target.file.full_path = /\\windows\\(system32\\config|system32\\config\\regback|repair|servicing|winsxs|softwaredistribution)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
