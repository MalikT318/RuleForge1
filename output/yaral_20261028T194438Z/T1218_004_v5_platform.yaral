/*
  MITRE Technique : T1218.004 - InstallUtil
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:47:31.128088+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// NOTE: InstallUtil is a Windows-only binary, so this variant stays on Windows as the platform requirement mandates. It pivots away from process-launch command lines to network telemetry: InstallUtil making an outbound connection.
rule MSSP_T1218_004_InstallUtil_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects InstallUtil making an outbound network connection to a non-internal address. InstallUtil is an installer-component host that rarely needs internet access. External connections suggest a malicious .NET installer assembly is staging a payload or beaconing to C2. This is based on network telemetry, not on process-creation command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.004"
    mitre_technique_name = "System Binary Proxy Execution: InstallUtil"
    log_prerequisites = "Requires endpoint network-connection telemetry with the initiating process path populated (EDR or Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that fetch dependencies or licence checks during .NET service installation; developer machines running InstallUtil against assemblies that call out; RMM or deployment tooling that installs .NET services."
    tuning_guidance = "Add approved deployment and RMM parent tooling to %global_allowed_admin_tools. Add known-good vendor and update destinations to %global_allowed_domains. Add automation accounts that legitimately install .NET services to %global_allowed_service_accounts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\installutil\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
