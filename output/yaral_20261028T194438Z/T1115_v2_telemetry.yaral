/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:23:25.982637+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_Linux_Clipboard_Dump_Staging_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file with a clipboard-related name in a world-writable Linux staging directory (/tmp, /var/tmp, /dev/shm). This catches the artifact left when clipboard contents (X11 or Wayland selections) are dumped to disk for later collection or exfiltration. The rule works on the resulting file artifact, so it still fires when command-line logging is evaded or the clipboard utility is renamed."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records (for example watches on /tmp, /var/tmp and /dev/shm) normalised to UDM FILE_CREATION with principal process and target file path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop clipboard managers or screenshot and remote-desktop tools that cache clipboard data in /tmp; developer or admin scripts that save clipboard output for troubleshooting; unrelated files whose names contain a delimited 'clip' token (for example media clips)."
    tuning_guidance = "Add approved tooling executables to %global_allowed_admin_tools, approved script hosts to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Extend the desktop-application process-name exclusion if a client runs additional clipboard managers. On server fleets without a desktop environment, consider raising severity because legitimate clipboard use is rare."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*[^a-z])?(clip(board)?|pasteboard|xsel|xclip|wl-?paste|cliphist)([^a-z]|$)/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(gnome-shell|plasmashell|klipper|copyq|gpaste-daemon|clipit|parcellite|wl-clip-persist|firefox|chrome|chromium|code)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
