/*
  MITRE Technique : T1564.003 - Hidden Window
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:17:48.067830+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_003_Hidden_Window_Interpreter_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound connection to an external address made by a scripting interpreter whose own command line requests a hidden window (WindowStyle Hidden or an equivalent short form). This is the network-side footprint of hidden-window tradecraft, such as a concealed PowerShell or script-host download or beacon. It is observed on NETWORK_CONNECTION telemetry rather than process creation, so it complements command-line rules on PROCESS_LAUNCH."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.003"
    mitre_technique_name = "Hide Artifacts: Hidden Window"
    log_prerequisites = "Requires Windows endpoint network-connection telemetry (EDR or Sysmon-equivalent) in which the initiating process command line (principal.process.command_line) is populated on NETWORK_CONNECTION events. If the sensor does not enrich network events with the command line, this rule will not fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or deployment scripts that run hidden by design and reach external update or licensing endpoints, RMM and patching agents launching PowerShell with a hidden window, software installers and logon scripts that fetch content from vendor CDNs, and monitoring agents using hidden PowerShell for external health checks."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools, trusted vendor and CDN destinations to %global_allowed_domains, and known automation or jump hosts to %global_allowed_script_hosts. Review the command_line outcome values before allowlisting. If volume is high, restrict to powershell/pwsh only or add a non-standard destination port condition."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $net.principal.process.command_line = /[-\/]w(in(dow(style)?)?)?[\s:]+(hidden|hid|h|1)\b/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1564.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
