/*
  MITRE Technique : T1505.002 - Transport Agent
  Tactic(s)       : Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:28:49.939624+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_002_Linux_MTA_Config_Modified_Outside_Package_Mgmt {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Linux mail transfer agent configuration (Postfix main.cf/master.cf, Exim, Sendmail, milter/DKIM/DMARC configs) by a process other than package managers or approved admin tooling. Exchange transport agents do not exist on Linux; the equivalent persistence mechanism is registering a malicious content_filter, milter, router or local_scan hook in the MTA configuration so attacker code runs on mail passing through the server."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.002"
    mitre_technique_name = "Server Software Component: Transport Agent"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w on /etc/postfix, /etc/exim4, /etc/mail with -p wa) normalised to FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators editing MTA configuration by hand or with postconf; configuration management runs (Ansible, Puppet, Chef, Salt); mail gateway or anti-spam installers that register milters; OS upgrades not run through the listed package managers."
    tuning_guidance = "Add configuration management and approved mail admin tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Restrict auditd watches to MTA hosts only to reduce noise. Review any hit where the modifying process is a shell, interpreter or runs from /tmp, /dev/shm or /var/tmp."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(postfix\/(main|master)\.cf|exim4?\/.+|mail\/(sendmail|submit)\.(cf|mc)|opendkim\.conf|opendmarc\.conf)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
