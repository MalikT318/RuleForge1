/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:30:06.836099+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_Linux_Audio_Capture_To_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Linux audio capture behaviour: a command-line recorder writing to a world-writable or hidden staging path, a media tool reading from an ALSA/Pulse/OSS/JACK capture input with a fixed duration or staging output, or direct reads of an ALSA PCM capture device node (/dev/snd/pcmC*D*c). Matches the combination of capture source and staging or duration arguments, not a single tool name."
    mitre_tactic = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with the full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Podcast and screen-recording workflows run by developers or media staff, voice-assistant or speech-to-text services, VoIP/conferencing test scripts, audio hardware QA and diagnostics, and accessibility tooling on desktop Linux workstations. Rare on servers."
    tuning_guidance = "Add approved parent processes or automation wrappers to %global_allowed_admin_tools. Add known service or kiosk accounts to %global_allowed_service_accounts. Add approved script-launching parents to %global_allowed_script_hosts. Scope to server and non-media host groups first if workstations are noisy."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /\b(arecord|parecord|parec|pw-record|pw-cat)\b.*(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/\.[a-z0-9_])/ nocase or
      $proc.target.process.command_line = /\s-f\s*(alsa|pulse|oss|jack)\s.*-i\s.*(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\s-t\s*\d+)/ nocase or
      $proc.target.process.command_line = /\/dev\/snd\/pcmC[0-9]+D[0-9]+c/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $capture_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
