/*
  MITRE Technique : T1021.005 - VNC
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:42:03.631819+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_005_Linux_VNC_Server_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a VNC server process (Xvnc, x11vnc, x0vncserver, vino, wayvnc and similar) launched by an unexpected parent: a web server, application server, database service, print daemon, or a binary running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Legitimate VNC servers are normally started by systemd, a display manager, an interactive login session, or an approved management tool. A VNC server spawned by a compromised service or dropped payload suggests an adversary standing up remote desktop access for lateral movement."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.005"
    mitre_technique_name = "Remote Services: VNC"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd execve) that populates both the parent process path (principal.process.file.full_path) and the child process path (target.process.file.full_path) on process launch events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admins launching VNC from a Java-based management console or web-based remote support portal; application servers that legitimately start a VNC or Xvnc session for headless browser or GUI automation (for example CI test runners using Tomcat or Java); software installers or configuration management that stage and run VNC from /tmp during provisioning; VDI or lab platforms that spawn Xvnc from a web front end."
    tuning_guidance = "Add approved remote support and VNC deployment tooling to %global_allowed_remote_mgmt and configuration management or provisioning binaries to %global_allowed_admin_tools. Add automation accounts that legitimately launch headless VNC sessions to %global_allowed_service_accounts. If a customer runs a VDI or test-automation platform that spawns Xvnc from a service, allowlist that parent path or user rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(Xvnc|Xtigervnc|x11vnc|x0vncserver|x0tigervncserver|vncserver|tigervncserver|vino-server|wayvnc|krfb|vnc4server|tightvncserver)$/ nocase
    $proc.principal.process.file.full_path = /(\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|caddy|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|cups-browsed)$|^\/(tmp|var\/tmp|dev\/shm)\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1021.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
