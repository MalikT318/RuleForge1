/*
  MITRE Technique : T1546.017 - Udev Rules
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:24:55.168219+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_017_Udev_Rule_File_Created_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a udev rule file (*.rules) in any of the system udev rule directories by a process other than a package manager or an approved admin tool. Adversaries drop udev rules containing RUN+= actions to execute payloads whenever a device event fires, giving persistence and root-level execution. This is file-telemetry based and complements process command-line detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.017"
    mitre_technique_name = "Event Triggered Execution: Udev Rules"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (for example -w /etc/udev/rules.d -p wa) normalised to UDM FILE_CREATION with principal process and target file path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs or upgrades that ship udev rules (drivers, hypervisor guest tools, GPU and storage utilities), configuration management agents (Ansible, Puppet, Chef, Salt), image-build and provisioning pipelines, and administrators who manually add device-permission rules."
    tuning_guidance = "Add approved configuration-management and deployment binaries to %global_allowed_admin_tools. Extend the package-manager regex with any distribution-specific installers. Pair with a copy of this rule on FILE_MODIFICATION (a separate rule, since each rule targets one event type) to cover edits to existing rule files. Consider raising severity when the writing process is a shell, interpreter or runs from /tmp, /dev/shm or /var/tmp."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc|run|usr\/lib|usr\/local\/lib|lib)\/udev\/rules\.d\/[^\/]+\.rules$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|dnf|yum|zypper|pacman|snapd|unattended-upgrade|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.017")
    $primary_entity = array_distinct($file.principal.hostname)
    $rule_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_command_line = array_distinct($file.principal.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
