/*
  MITRE Technique : T1505.005 - Terminal Services DLL
  Tactic(s)       : Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:34:12.508658+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_005_TermService_Registry_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of registry modifications to the Terminal Services configuration (TermService Parameters, including ServiceDll, and Control\\Terminal Server settings such as session limits and connection toggles) on a single host within 10 minutes. A single change can be benign, but several in a short window match the RDP-wrapper / termsrv.dll replacement pattern used to persist RDP access and enable concurrent sessions."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.005"
    mitre_technique_name = "Server Software Component: Terminal Services DLL"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) normalised to REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or Group Policy enabling or hardening RDP (fDenyTSConnections, UserAuthentication, SecurityLayer), RMM and golden-image build tooling, RDS role installation, Windows feature updates that reconfigure Terminal Server settings."
    tuning_guidance = "Add legitimate configuration tooling to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Raise the threshold (#reg) in noisy RDS farm environments. Any ServiceDll modification raises the risk score and should be reviewed regardless of volume."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d+)\\(services\\TermService\\Parameters|Control\\Terminal Server)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_value_name = /^ServiceDll$/ nocase, 90, 65))
    $mitre_technique_id = array_distinct("T1505.005")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $modifying_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
