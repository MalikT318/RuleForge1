/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:36:38.115100+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_Script_Client_Fetches_Encoded_Payload_Over_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external HTTP GET made by a Windows scripting or built-in downloader client (PowerShell, WinHTTP COM object, BITS) where the URL either carries a long encoded blob or points to a decoy-type file (image, text, .dat, .bin, .b64, .enc). Obfuscated or encoded payloads are commonly staged this way to slip past content inspection, and the network-side signal is independent of endpoint command-line obfuscation."
    mitre_tactic = "Stealth (Defense Evasion)"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "IDS/IPS or inline network security appliance logs that populate NETWORK_HTTP with target.url and network.http.user_agent. TLS-encrypted traffic is only visible if the appliance performs TLS inspection."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Windows Update and Store traffic delivered over BITS, software deployment and RMM agents that download .dat or .bin content, PowerShell modules or admin scripts fetching legitimate data files, and CDN URLs with long signed tokens requested by scripted clients."
    tuning_guidance = "Add trusted vendor and update domains to %global_allowed_domains. Add authorised scanners and test hosts to %global_allowed_scanners. If BITS is noisy, narrow the user agent regex to the PowerShell and WinHTTP alternatives. If long-token URLs are noisy, raise the {120,} length threshold."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.user_agent = /(WindowsPowerShell|WinHttp\.WinHttpRequest|Microsoft BITS)/ nocase
    (
      $net.target.url = /[A-Za-z0-9+\/_=-]{120,}/ nocase or
      $net.target.url = /\.(b64|base64|enc|bin|dat|jpg|jpeg|png|gif|ico|txt|log)(\?.*)?$/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
