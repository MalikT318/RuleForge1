/*
  MITRE Technique : T1568.003 - DNS Calculation
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:07:36.750572+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_003_Linux_DNS_Lookup_Then_HighPort_Connect_Temp_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process running from a world-writable Linux directory (/tmp, /var/tmp, /dev/shm) resolves a DNS name and then, within 10 minutes, connects to an external IP on a non-standard high port. This sequence is consistent with DNS-calculated C2, where the port or destination is derived from the DNS answer to evade egress filtering."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.003"
    mitre_technique_name = "Dynamic Resolution: DNS Calculation"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces both NETWORK_DNS and NETWORK_CONNECTION events with the originating process path (principal.process.file.full_path) populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer or CI build tools executed from /tmp, self-extracting installers, package or update helpers staged in /var/tmp, containerised workloads using ephemeral paths, and peer-to-peer or custom-port internal tooling reached via external addresses."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, trusted destinations to %global_allowed_domains, and scanner or security agents to %global_allowed_security_tools. Extend the excluded standard-port list for customers with legitimate custom-port services."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $dns.principal.process.file.full_path in %global_allowed_admin_tools
    not $dns.principal.process.file.full_path in %global_allowed_security_tools
    not $dns.network.dns.questions.name in %global_allowed_domains
    $dns.principal.hostname = $hostname
    $dns.principal.process.file.full_path = $proc_path

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.ip in %rfc1918_internal
    $net.target.port >= 1024
    $net.target.port != 8080
    $net.target.port != 8443
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $proc_path

    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1568.003")
    $primary_entity = array_distinct($hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $dns and $net
}
