/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:37:33.566883+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_Spoolsv_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows print spooler service (spoolsv.exe) initiating a network connection to an external address. A malicious port monitor DLL registered under the Print Monitors registry key is loaded into spoolsv.exe as SYSTEM at boot, so any C2 beaconing or payload retrieval from that DLL appears as outbound traffic from the spooler process. This is network-side coverage that complements endpoint registry and process-creation rules."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the originating process for each connection (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Spooler-initiated connections to cloud print services, external IPP/IPPS printers or print servers, remote printer driver downloads from vendor or Windows Update CDNs, and WSD/LPR printing over VPN to remote sites."
    tuning_guidance = "Add known-good vendor, CDN and cloud-print domains to %global_allowed_domains. Confirm %rfc1918_internal covers the client's internal ranges. If a client legitimately prints to remote IPP printers, add the destination hostname to %global_allowed_domains. Investigate hits by reviewing HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors for unexpected Driver values and unsigned DLLs loaded by spoolsv.exe."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\spoolsv\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
