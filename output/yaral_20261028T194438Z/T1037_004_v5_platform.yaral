/*
  MITRE Technique : T1037.004 - RC Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:23:51.826664+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_004_ESXi_RC_Script_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell command on an ESXi host that writes to, copies over, moves, edits or changes permissions on a boot-time RC script (/etc/rc.local, /etc/rc.local.d/ including local.sh, or /etc/init.d/). ESXi keeps most system files in memory and discards changes on reboot, so adversaries use /etc/rc.local.d/local.sh to persist backdoors as root."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.004"
    mitre_technique_name = "Boot or Logon Initialization Scripts: RC Scripts"
    log_prerequisites = "ESXi shell command logging forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with target.process.command_line populated. Shell and hostd logging must be enabled on the host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators adding legitimate startup commands to local.sh (for example NTP, firewall or advanced setting persistence), host provisioning and kickstart scripts, vendor driver or agent installers that register init scripts, configuration management tooling."
    tuning_guidance = "Add approved automation and provisioning binaries to %global_allowed_admin_tools, named admin accounts to %global_allowed_admin_users, and service accounts to %global_allowed_service_accounts. Treat any hit outside a change window as suspicious and review the script contents and recent SSH logins."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\/etc\/(rc\.local\.d\/|rc\.local\b|init\.d\/)/ nocase
    $proc.target.process.command_line = /(>|\btee\b|\bsed\s+-i|\bcp\b|\bmv\b|\bvi\b|\bvim\b|\bchmod\b|\bln\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
