/*
  MITRE Technique : T1480.002 - Mutual Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:27:58.995625+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_002_Dropped_Binary_Creates_Dynamic_Mutex {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A binary running from a user-writable path is launched by an Office app, script host or LOLBin, then creates a system mutex with a GUID-like or random hex name within 10 minutes. This is a typical single-instance check used by malware to avoid re-infecting a host."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.002"
    mitre_technique_name = "Execution Guardrails: Mutual Exclusion"
    log_prerequisites = "Requires endpoint telemetry with process launch events and mutex creation events (EDR with handle/mutex visibility). The mutex name must be populated in target.resource.name. Sysmon alone does not log mutex creation."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate per-user applications installed under AppData (updaters, collaboration clients, browsers, installers) that are started by a script or shell and use GUID-named mutexes. Software deployment scripts that launch installers from Temp."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools or %global_allowed_script_hosts. Add EDR/AV agents to %global_allowed_security_tools. Add known-good deployment hosts to %global_allowed_script_hosts. Tighten or widen the mutex-name regex to match what your EDR populates."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|wscript|cscript|mshta|powershell|pwsh|cmd|rundll32|regsvr32)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(users\\[^\\]+\\appdata\\|users\\public\\|windows\\temp\\).*\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $mutex.metadata.event_type = "MUTEX_CREATION"
    $mutex.target.resource.name = /^((global|local)\\)?(\{?[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}\}?|[0-9a-f]{16,})$/ nocase
    not $mutex.principal.process.file.full_path in %global_allowed_security_tools
    $mutex.principal.hostname = $hostname
    $mutex.principal.process.file.full_path = $path

    $proc.metadata.event_timestamp.seconds <= $mutex.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1480.002")
    $primary_entity = array_distinct($mutex.principal.hostname)
    $dropped_binary = array_distinct($path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $mutex_names = array_distinct($mutex.target.resource.name)
    $mutex_count = count($mutex.metadata.id)

  condition:
    $proc and $mutex
}
