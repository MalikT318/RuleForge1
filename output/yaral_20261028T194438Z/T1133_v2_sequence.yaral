/*
  MITRE Technique : T1133 - External Remote Services
  Tactic(s)       : Persistence, Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:49:22.806812+00:00
  Reference       : https://attack.mitre.org/techniques/T1133
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1133_External_Source_Multi_Remote_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single external source address connects to an RDP port and then to a second remote-access service port (WinRM or VNC) on the same internal Windows destination within ten minutes. This indicates probing or use of exposed external remote services (T1133), or credential-based access to them, and is seen from the network perimeter without any endpoint process data."
    mitre_tactic = "Persistence, Initial Access"
    mitre_technique = "T1133"
    mitre_technique_name = "External Remote Services"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must include inbound (Internet to internal) traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vendors or MSPs administering servers over RDP and WinRM, external vulnerability scanners and attack-surface monitoring, remote administrators using jump hosts published to the Internet, and NAT or VPN concentrator addresses that aggregate many legitimate users behind one source IP."
    tuning_guidance = "Add approved scanner sources to %global_allowed_scanners, approved vendor or admin source addresses to %global_allowed_mgmt_sources, and sanctioned remote support gateways to %global_allowed_remote_mgmt. Deny-only traffic cannot be told apart without a populated action field, so confirm the firewall log scope (allowed versus all traffic) per client. Consider raising severity for destinations that are not published remote access gateways."

  events:
    $rdp.metadata.event_type = "NETWORK_CONNECTION"
    $rdp.target.port = 3389
    not $rdp.principal.ip in %rfc1918_internal
    not $rdp.principal.ip in %global_allowed_mgmt_sources
    not $rdp.principal.ip in %global_allowed_scanners
    not $rdp.principal.ip in %global_allowed_remote_mgmt
    $rdp.principal.ip = $src
    $rdp.target.ip = $dst

    $wrm.metadata.event_type = "NETWORK_CONNECTION"
    ($wrm.target.port = 5985 or $wrm.target.port = 5986 or $wrm.target.port = 5900 or $wrm.target.port = 5901)
    not $wrm.principal.ip in %rfc1918_internal
    not $wrm.principal.ip in %global_allowed_mgmt_sources
    not $wrm.principal.ip in %global_allowed_scanners
    not $wrm.principal.ip in %global_allowed_remote_mgmt
    $wrm.principal.ip = $src
    $wrm.target.ip = $dst

    $rdp.metadata.event_timestamp.seconds <= $wrm.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1133")
    $primary_entity = array_distinct($dst)
    $source_ips = array_distinct($src)
    $rdp_connection_count = count($rdp.metadata.id)
    $second_service_ports = array_distinct($wrm.target.port)

  condition:
    $rdp and $wrm
}
