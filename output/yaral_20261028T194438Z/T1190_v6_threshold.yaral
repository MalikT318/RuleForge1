/*
  MITRE Technique : T1190 - Exploit Public-Facing Application
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:37:06.342959+00:00
  Reference       : https://attack.mitre.org/techniques/T1190
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1190_Network_Device_Mgmt_Port_Connection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single external source makes many connections to one device on a management-plane or network-infrastructure service port (SSH, Telnet, SNMP, NETCONF, Smart Install, web-management or proprietary admin ports) within ten minutes. Each connection is benign on its own. The volume indicates exploitation attempts, brute-force or probing of an Internet-exposed management service."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1190"
    mitre_technique_name = "Exploit Public-Facing Application"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalized to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Allowed (accepted) traffic must be logged."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, external monitoring or uptime probes, managed-service or vendor remote administration from non-listed addresses, NAT egress addresses shared with legitimate admins, and SNMP pollers hosted outside the internal ranges."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners and approved administrative source addresses to %global_allowed_mgmt_sources. Raise the #net threshold in noisy environments. Lower it for devices that should never be reachable from the Internet. Extend the port list with any management ports specific to the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 830 or
      $net.target.port = 4786 or
      $net.target.port = 8291 or
      $net.target.port = 8443
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port = 23 or $net.target.port = 4786 or $net.target.port = 161, 85, 65))
    $mitre_technique_id = array_distinct("T1190")
    $primary_entity = array_distinct($dst_ip)
    $event_count = count($net.metadata.id)
    $source_ips = array_distinct($src_ip)
    $targeted_ports = array_distinct($net.target.port)
    $target_hosts = array_distinct($net.target.hostname)

  condition:
    #net >= 25
}
