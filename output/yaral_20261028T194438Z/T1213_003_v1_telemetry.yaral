/*
  MITRE Technique : T1213.003 - Code Repositories
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:26:04.364029+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_003_Code_Repo_Exposure_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change on a hosted code repository that widens access to source code. Examples: a repository made public or internal, a deploy or SSH key added, branch protection removed, or the repository transferred. These settings are what an adversary with a compromised account changes to collect or stage proprietary source code and embedded credentials. The rule works on the resulting configuration state change in SaaS audit logs, not on git command lines."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.003"
    mitre_technique_name = "Data from Information Repositories: Code Repositories"
    log_prerequisites = "Requires SaaS code-repository or source-control audit logs ingested into Chronicle and normalised to SETTING_MODIFICATION. metadata.product_event_type must carry the audit action name, and principal.user.userid should be populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Planned open-sourcing of a project, CI/CD onboarding that adds deploy keys, repository migrations or transfers during reorganisations, and admins temporarily relaxing branch protection for a hotfix or release."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add platform and repository administrators to %global_allowed_admin_users. Narrow or extend the product_event_type regex to match the action names your repository audit log uses."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(deploy_key\.(create|add)|ssh_key\.(create|add)|(repo|repository)\.(access|visibility|change_visibility|make_public|set_public|transfer)|protected_branch\.(destroy|disable|delete|policy_override)|branch_protection\.(disable|delete|remove))/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1213.003")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $repo_resource = array_distinct($setting.target.resource.name)
    $audit_action = array_distinct($setting.metadata.product_event_type)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
