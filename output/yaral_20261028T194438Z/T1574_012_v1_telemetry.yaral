/*
  MITRE Technique : T1574.012 - COR_PROFILER
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:43:01.827512+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_012_COR_PROFILER_Environment_Registry_Set {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write that sets a .NET CLR profiler environment variable (COR_ENABLE_PROFILING, COR_PROFILER, COR_PROFILER_PATH and the _32/_64 variants) in a persistent user or system Environment key. This registers a profiler DLL that loads into every .NET process, which gives persistence, privilege escalation and defence evasion. The rule detects the registry state change, not the command line, so it still fires when the value is set through APIs, scripts or renamed tooling."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.012"
    mitre_technique_name = "Hijack Execution Flow: COR_PROFILER"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) populating target.registry.registry_key and target.registry.registry_value_name, covering HKCU\\Environment and HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application performance monitoring and observability agents (APM, .NET profilers, code-coverage tools), developers enabling profilers on workstations, and IT deployment tooling that configures .NET diagnostics."
    tuning_guidance = "Add APM, profiler and diagnostic agent binaries to %global_allowed_security_tools or %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Review the registry value data in the alert: a profiler path in a user-writable location such as Temp, AppData or ProgramData is high confidence malicious."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Volatile )?Environment$/ nocase
    $reg.target.registry.registry_value_name = /^(COR_ENABLE_PROFILING|COR_PROFILER|COR_PROFILER_PATH(_32|_64)?)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $value_names = array_distinct($reg.target.registry.registry_value_name)
    $value_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
