/*
  MITRE Technique : T1556.009 - Conditional Access Policies
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:27:16.846369+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_009_Conditional_Access_Change_Then_External_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a conditional access, sign-in policy or trusted location/network setting being modified by an account that then performs a sign-in from an external source address within 10 minutes. This pattern indicates an adversary weakening access controls and immediately using the relaxed policy to log in with a compromised identity."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.009"
    mitre_technique_name = "Modify Authentication Process: Conditional Access Policies"
    log_prerequisites = "Requires identity provider directory/admin audit logs normalised to SETTING_MODIFICATION with the policy name in target.resource.name, plus identity provider sign-in logs normalised to USER_LOGIN with principal.user.userid and principal.ip populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Planned changes to conditional access or trusted locations by identity administrators who then sign in from home or a remote site; onboarding of new offices or VPN egress ranges; break-glass account testing; infrastructure-as-code pipelines applying policy updates."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or pipeline identities to %global_allowed_service_accounts. Add approved admin access source addresses to %global_allowed_mgmt_sources. Narrow the policy-name regex if the tenant uses custom naming, and extend the 10m window only after reviewing alert volume."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(conditional.?access|sign.?in.?polic|named.?location|trusted.?(ip|location|network)|access.?polic|mfa.?polic|authentication.?polic)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    $setting.principal.user.userid = $user

    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources
    $auth.principal.user.userid = $user

    $setting.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.009")
    $primary_entity = array_distinct($user)
    $modified_policies = array_distinct($setting.target.resource.name)
    $login_source_ips = array_distinct($auth.principal.ip)
    $login_count = count($auth.metadata.id)

  condition:
    $setting and $auth
}
