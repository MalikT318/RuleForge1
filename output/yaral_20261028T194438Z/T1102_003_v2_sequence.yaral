/*
  MITRE Technique : T1102.003 - One-Way Communication
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:57:38.377223+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_003_ScriptHost_Web_Fetch_Then_Dropped_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A scripting host or LOLBin makes an HTTP GET to an external web service, then the same process family writes an executable or script into a user-writable staging location on the same host within 10 minutes. This pattern fits one-way C2 over a legitimate web service, where instructions or payloads are pulled down and acted on without a return channel. It complements process command-line rules by correlating network and file telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.003"
    mitre_technique_name = "Web Service: One-Way Communication"
    log_prerequisites = "Requires EDR or Sysmon telemetry that populates NETWORK_HTTP (with principal process path, HTTP method and target hostname) and FILE_CREATION (with principal process path and target file path)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrative PowerShell scripts that download installers or modules from vendor sites, package managers and software deployment scripts, developer tooling, legitimate update scripts run via script hosts, and login scripts that fetch configuration from cloud services."
    tuning_guidance = "Add approved scripting parents or script-host processes to %global_allowed_script_hosts. Add known-good vendor, CDN and update domains to %global_allowed_domains. Add RMM or deployment binaries that drop files to %global_allowed_admin_tools. If HTTP telemetry lacks a hostname, tune on target.url instead. Consider adding a pid join if the EDR populates principal.process.pid on both event types."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32|msiexec|certutil|bitsadmin)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32|msiexec|certutil|bitsadmin)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\(local|roaming)\\|programdata\\|windows\\temp\\|users\\public\\)/ nocase
    $file.target.file.full_path = /\.(exe|dll|ps1|bat|cmd|vbs|vbe|js|jse|hta|scr)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $net.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1102.003")
    $primary_entity = array_distinct($hostname)
    $fetch_hosts = array_distinct($net.target.hostname)
    $fetch_urls = array_distinct($net.target.url)
    $fetching_processes = array_distinct($net.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $http_event_count = count($net.metadata.id)
    $file_event_count = count($file.metadata.id)

  condition:
    $net and $file
}
