/*
  MITRE Technique : T1127.001 - MSBuild
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:36:53.134852+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_001_MSBuild_Writes_Artifacts_To_UserWritable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects MSBuild.exe creating executable, library, script or compiler-artifact files (dll, exe, cs, vb, cmdline, script) in user-writable staging locations such as Temp, AppData, ProgramData or Public. This is the file-level artifact left by inline-task compilation or payload staging, and it is independent of command-line logging."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.001"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: MSBuild"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations and build servers running legitimate MSBuild projects with inline tasks (CodeTaskFactory/RoslynCodeTaskFactory); CI/CD agents building into temp directories; software installers that invoke MSBuild; Visual Studio build tooling."
    tuning_guidance = "Add build servers and developer hosts to %global_allowed_script_hosts. Add CI/CD service accounts to %global_allowed_service_accounts. If developer noise remains, narrow the extension list to dll|exe|ps1|bat|vbs|js and drop cs|vb|cmdline."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\msbuild\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\(local\\temp|roaming|locallow)|windows\\temp|programdata|users\\public)\\.*\.(dll|exe|scr|cs|vb|cmdline|ps1|bat|vbs|js|hta)$/ nocase
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1127.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
