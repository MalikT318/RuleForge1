/*
  MITRE Technique : T1564.010 - Process Argument Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:27:35.127804+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_010_Process_Open_Spoofable_Binary_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location opening a handle to a native Windows binary that is commonly abused for command-line (PEB) spoofing, such as a shell, script host or proxy-execution LOLBin. The pattern is the handle request that precedes overwriting the target's PEB or memory. It operates at the PROCESS_OPEN layer and is independent of the command line logged at process creation."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.010"
    mitre_technique_name = "Hide Artifacts: Process Argument Spoofing"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process-access telemetry (handle open or ProcessAccess) normalised to UDM PROCESS_OPEN with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters staged in temp or AppData, developer debuggers and test harnesses, EDR/AV or DLP agents running from ProgramData, application packaging and virtualization tools, and legitimate launchers that create and manage helper shells."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup and imaging software to %global_allowed_backup_processes, and approved deployment or RMM binaries to %global_allowed_admin_tools. If a particular updater is noisy, add its executable to the appropriate list rather than widening the regex. Consider raising the risk score where the principal process is unsigned or a script host."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|music|pictures)|programdata|windows\\temp|temp|perflogs|users\\public)\\/ nocase
    $open.target.process.file.full_path = /\\windows\\(system32|syswow64)\\(cmd|powershell|pwsh|rundll32|regsvr32|mshta|wscript|cscript|msbuild|installutil|regasm|regsvcs|wmic|certutil|schtasks|net|net1|reg|sc)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    $open.principal.hostname != ""
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.010")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
