/*
  MITRE Technique : T1216 - System Script Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:32:18.703969+00:00
  Reference       : https://attack.mitre.org/techniques/T1216
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_Signed_Proxy_Script_Dropped_Outside_System_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file whose name matches a Microsoft-signed proxy-execution script (for example the print, app-virtualization, BitLocker, WinRM and diagnostic helper scripts) inside a user-writable location. These scripts ship only in Windows system directories. A copy in Temp, a user profile, ProgramData or Public is a staged artifact, typically used to hijack the script's relative-path lookups or to run attacker content under a trusted signed script. The rule works from the file-write artifact rather than command-line content, so it still fires when command-line logging is evaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216"
    mitre_technique_name = "System Script Proxy Execution"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or packagers copying Windows scripts into a user or temp directory for testing, backup or restore jobs that replicate system script folders, software deployment tooling staging Microsoft diagnostic scripts, and security researchers or red teams running authorised exercises."
    tuning_guidance = "Add approved deployment or imaging tools to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add backup software to %global_allowed_backup_processes if it restores system scripts to user paths. Extend the directory regex if clients use other non-system staging locations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(pubprn\.vbs|syncappvpublishingserver\.vbs|manage-bde\.wsf|winrm\.vbs|cl_invocation\.ps1|cl_mutexverifiers\.ps1|cl_loadassembly\.ps1|utilityfunctions\.ps1)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\|users\\public\\|programdata\\|windows\\temp\\|perflogs\\|temp\\)/ nocase
    not $file.target.file.full_path = /\\windows\\(system32|syswow64|winsxs|servicing)\\/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1216")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
