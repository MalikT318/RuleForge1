/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:42:47.393400+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_Active_Setup_StubPath_Registry_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the StubPath value under an Active Setup Installed Components key where the command points at a user-writable location, a script interpreter or a download-capable LOLBin. Active Setup is a Windows-only mechanism with no Linux, macOS or cloud equivalent, so this rule stays on Windows and adds coverage through registry telemetry instead of process command-line matching."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION or REGISTRY_CREATION) that populates registry key, value name and value data for HKLM\\SOFTWARE\\Microsoft\\Active Setup, including the Wow6432Node view."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party installers (browsers, Office add-ins, VPN and printer clients, line-of-business software) that register per-user setup commands from ProgramData or temp directories; software deployment tooling; admin scripts that deliberately configure Active Setup."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Review the stub_command outcome for recurring legitimate installers and allowlist the writing process by executable name."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\(Wow6432Node\\)?Microsoft\\Active Setup\\Installed Components\\/ nocase
    $reg.target.registry.registry_value_name = /^StubPath$/ nocase
    $reg.target.registry.registry_value_data = /(\\users\\|\\appdata\\|\\temp\\|\\programdata\\|\\public\\|\\downloads\\|powershell|pwsh|cmd(\.exe)?"?\s+\/[ck]|wscript|cscript|mshta|regsvr32|bitsadmin|certutil|curl|\\\\[a-z0-9._-]+\\)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $stub_command = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
