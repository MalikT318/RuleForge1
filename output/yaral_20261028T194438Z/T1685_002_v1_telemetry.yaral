/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:18:04.245154+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_Identity_Audit_Logging_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a tenant or mailbox audit-logging configuration change (SETTING_MODIFICATION) that bypasses, disables or alters audit log collection. Pivots on the administrative configuration-change record rather than any command line, so it fires regardless of whether the change came from a portal, API, or remote shell session."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Log"
    log_prerequisites = "Unified audit log ingestion with admin/configuration operations normalised to SETTING_MODIFICATION and the operation name populated in metadata.product_event_type. Admin audit logging must itself be enabled in the tenant."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Planned audit-policy changes by the security or compliance team, onboarding of service mailboxes that are intentionally excluded from auditing to reduce noise, tenant migrations or licensing changes, and approved automation that manages audit configuration."
    tuning_guidance = "Add approved compliance and security administrators to %global_allowed_admin_users, and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Review any audit-bypass entries for service mailboxes once and allowlist the owning account. Correlate with a change ticket before closing."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^(Set-MailboxAuditBypassAssociation|Set-AdminAuditLogConfig|Set-.*AuditConfig.*|Disable-.*Audit.*|Remove-.*Audit.*|Set-.*AuditLog.*|Update-.*AuditConfig.*)$/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $source_ip = array_distinct($setting.principal.ip)
    $target_resource = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
