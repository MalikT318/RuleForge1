/*
  MITRE Technique : T1204.001 - Malicious Link
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:59:29.666655+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_001_Linux_Browser_Mail_Client_Fetches_Executable_Content {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of a user-facing application (web browser or mail client) making an HTTP request to an external host for an executable or script payload (shell script, ELF binary, installer package, AppImage, .run installer). This is the network footprint of a user clicking a malicious link that delivers code for execution. It complements process-creation and command-line coverage by observing the download itself."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.001"
    mitre_technique_name = "User Execution: Malicious Link"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR network sensor or auditd-derived network events) that populates NETWORK_HTTP with the originating process path and the request URL. Events without a populated principal process path or target.url will not match."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or administrators downloading legitimate installers or scripts through a browser (.deb, .rpm, .AppImage, .run, install.sh) from vendor or open-source sites not yet in the allowed domain list; software portals that serve installers; mail clients fetching legitimate attachments by link."
    tuning_guidance = "Add known-good vendor, package and CDN domains to %global_allowed_domains (matched against target.hostname). Internal destinations are excluded using %rfc1918_internal. Narrow or extend the extension list in the target.url regex to fit client policy. In developer-heavy environments, raise severity only when the host is a non-developer workstation, or when the target is a bare IP address."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\/(firefox|firefox-bin|chrome|google-chrome|chromium|chromium-browser|brave|brave-browser|opera|vivaldi|epiphany|thunderbird|thunderbird-bin|evolution|geary)$/ nocase
    $net.target.url = /\.(sh|bash|run|bin|elf|appimage|deb|rpm|py|pl|so)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1204.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $requesting_process = array_distinct($net.principal.process.file.full_path)
    $requested_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
