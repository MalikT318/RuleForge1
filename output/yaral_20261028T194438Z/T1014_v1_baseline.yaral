/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:25:22.040184+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_Kernel_Driver_Service_Registered_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a kernel driver service being registered under the Services registry hive with an ImagePath pointing to a .sys file in a user-writable or non-standard location. Loading an unsigned or untrusted driver from outside the system driver store is the core enabling mechanism for kernel-mode rootkits (BYOVD and custom rootkits), which hide processes, files, and connections by hooking OS APIs."
    mitre_tactic = "Stealth"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13 equivalent) that populates target.registry.registry_key, registry_value_name and registry_value_data for HKLM\\SYSTEM\\*ControlSet*\\Services."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party driver installers that stage .sys files in ProgramData or Temp before registering them (hardware vendor utilities, VPN and virtualization clients, anti-cheat, disk and backup software); software deployment and RMM agents; developers testing drivers."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. If a specific vendor driver repeatedly triggers, allow the installing parent process by name in those lists rather than by path. Consider raising severity when the installing process is an interpreter or Office application."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d{3})\\Services\\[^\\]+$/ nocase
    $reg.target.registry.registry_value_name = "ImagePath" nocase
    $reg.target.registry.registry_value_data = /\.sys\b/ nocase
    $reg.target.registry.registry_value_data = /(\\Users\\|\\AppData\\|\\Temp\\|\\ProgramData\\|\\Public\\|\\Downloads\\|\\\$Recycle\.Bin\\|\\Windows\\Debug\\|\\Windows\\Tasks\\)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $service_key = array_distinct($reg.target.registry.registry_key)
    $driver_path = array_distinct($reg.target.registry.registry_value_data)
    $installing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
