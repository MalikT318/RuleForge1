/*
  MITRE Technique : T1525 - Implant Internal Image
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:25:16.738423+00:00
  Reference       : https://attack.mitre.org/techniques/T1525
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1525_Image_Created_Then_Shared_Same_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a principal creating, registering or pushing a machine or container image and then changing the permissions or sharing policy on an image or image repository within 10 minutes. This sequence matches the T1525 pattern of implanting a backdoored image and exposing it so that new infrastructure launches from it."
    mitre_tactic = "Persistence"
    mitre_technique = "T1525"
    mitre_technique_name = "Implant Internal Image"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM with metadata.product_event_type and principal.user.userid populated. Image registry and compute image management events must be enabled in the audit configuration."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Golden-image or AMI build pipelines that publish and share images with other accounts, CI/CD jobs that push container images and then set repository policies, platform teams sharing approved images with child accounts or projects, and DR or region-replication automation."
    tuning_guidance = "Add build pipeline and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named platform engineers to the same lists if they routinely publish images. To narrow the rule further, require that the permission change targets the same image name as the creation event once resource naming is confirmed to be consistent in the tenant."

  events:
    $img.metadata.event_type = "RESOURCE_CREATION"
    $img.metadata.product_event_type = /(CreateImage|RegisterImage|CopyImage|ImportImage|PutImage|CompleteLayerUpload|images\.insert|images\/write)/ nocase
    $img.principal.user.userid != ""
    not $img.principal.user.userid in %global_allowed_service_accounts
    not $img.principal.user.userid in %global_allowed_cloud_principals
    $img.principal.user.userid = $user

    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.metadata.product_event_type = /(ModifyImageAttribute|SetRepositoryPolicy|PutRegistryPolicy|images\.setIamPolicy|ModifyInstanceAttribute|images\/setIamPolicy)/ nocase
    $perm.principal.user.userid != ""
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    $perm.principal.user.userid = $user

    $img.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1525")
    $primary_entity = array_distinct($img.principal.user.userid)
    $image_events = array_distinct($img.metadata.product_event_type)
    $permission_events = array_distinct($perm.metadata.product_event_type)
    $image_resources = array_distinct($img.target.resource.name)
    $permission_resources = array_distinct($perm.target.resource.name)
    $source_ips = array_distinct($img.principal.ip)
    $first_seen = min($img.metadata.event_timestamp.seconds)
    $last_seen = max($perm.metadata.event_timestamp.seconds)

  condition:
    $img and $perm
}
