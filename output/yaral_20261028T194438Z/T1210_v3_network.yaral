/*
  MITRE Technique : T1210 - Exploitation of Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:16:57.725437+00:00
  Reference       : https://attack.mitre.org/techniques/T1210
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1210_Perimeter_External_Source_To_Windows_Remote_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to a port used by Windows remote services (SMB, RPC endpoint mapper, NetBIOS session, RDP, WinRM). These services are common targets for remote exploitation, so external reachability of them seen at the network perimeter is a strong signal of exploitation attempts or the scanning that precedes them. Source exclusion uses reference lists, so the rule holds no hardcoded address ranges."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1210"
    mitre_technique_name = "Exploitation of Remote Services"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated. Logs must include permitted traffic, and ideally denied traffic too, so that exposure and probing both show up. No endpoint process fields are used."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and penetration tests, intentionally published RDP gateways or WinRM endpoints, VPN concentrator or NAT egress addresses that appear as non-internal sources, and internet-wide scanning noise against exposed hosts."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management or VPN egress addresses to %global_allowed_mgmt_sources. If %rfc1918_internal does not cover a client's private or carrier-grade NAT space, extend that list per client. Narrow the port set per client if some services are intentionally published."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 135 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1210")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
