/*
  MITRE Technique : T1102.001 - Dead Drop Resolver
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:55:06.062215+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_001_Linux_Scripted_Client_Dead_Drop_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser, scripted HTTP client of the kind used on Linux servers (curl, wget, python, Go, perl) issuing a GET to an external web service for raw-content, paste, gist, snippet or social-post style URL paths. This is the network-observable pattern of a Linux implant or shell script fetching a dead drop resolver that holds encoded C2 addresses. The rule uses proxy/firewall HTTP telemetry only and does not rely on endpoint process fields, so it complements process command-line detections. Linux servers rarely need to fetch user-generated content from public web services, so a hit is worth triage."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.001"
    mitre_technique_name = "Web Service: Dead Drop Resolver"
    log_prerequisites = "Requires proxy or TLS-inspecting firewall logs normalised to UDM NETWORK_HTTP with network.http.user_agent, network.http.method and target.url populated. Without TLS inspection the URL path and user agent are not visible and the rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Package and config bootstrap scripts pulling raw files from public code-hosting services, CI/CD runners, container build hosts, configuration-management agents, monitoring or inventory scripts polling JSON or RSS feeds, and developer workstations running Linux."
    tuning_guidance = "Add approved update, repository and vendor domains to %global_allowed_domains. Add build servers, CI runners and automation hosts to %global_allowed_script_hosts. Tighten or extend the URL path regex per client if raw-content fetching from public services is routine."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl|lwp-trivial|aiohttp|httpie)\b/ nocase
    not $http.network.http.user_agent = /(windows|mozilla\/[0-9.]+ \(windows|msie|powershell)/ nocase
    $http.target.url = /(\/raw(\/|\?|$)|\/(pastes?|gist|snippets?)\/[a-z0-9_\-]+|\/(comments|status|statuses)\/[a-z0-9_\-]+)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1102.001")
    $primary_entity = array_distinct($http.principal.ip)
    $dead_drop_hosts = array_distinct($http.target.hostname)
    $dead_drop_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
