/*
  MITRE Technique : T1653 - Power Settings
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:58:11.060854+00:00
  Reference       : https://attack.mitre.org/techniques/T1653
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1653_Power_Settings_Repeated_Powercfg_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects multiple powercfg.exe invocations on a single host within 10 minutes that change sleep, hibernate, monitor or disk timeouts, or disable hibernation. Adversaries use this to keep an infected machine awake and extend access. One change is common; a burst of changes on one host is not."
    mitre_tactic = "Persistence"
    mitre_technique = "T1653"
    mitre_technique_name = "Power Settings"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR or Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled) populating target.process.file.full_path and target.process.command_line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT provisioning or imaging scripts, RMM and endpoint-management power-policy deployments, kiosk or digital-signage and conference-room setup, VDI golden-image builds, and admins or developers tuning power plans on lab machines."
    tuning_guidance = "Add approved deployment and RMM parent processes to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for noisy provisioning environments, or lower it to 2 for high-security hosts such as servers. Review the command_lines outcome to distinguish timeouts set to 0 from normal tuning."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\powercfg\.exe$/ nocase
    $proc.target.process.command_line = /(standby-timeout|hibernate-timeout|monitor-timeout|disk-timeout|\s[-\/]h(ibernate)?\s+off|\s[-\/]x\s|setacvalueindex|setdcvalueindex|\s[-\/]change\s)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1653")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $command_lines = array_distinct($proc.target.process.command_line)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 3
}
