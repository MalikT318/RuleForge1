/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:23:02.548310+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_Linux_Staged_Archive_Then_Bluetooth_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an archive being created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) followed within 10 minutes by a Bluetooth OBEX file-transfer utility run on the same host and referencing a staging path or archive file. This sequence indicates data staged for exfiltration over a Bluetooth channel instead of the routed network path."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Other Network Medium: Exfiltration Over Bluetooth"
    log_prerequisites = "Requires Linux EDR or auditd telemetry providing process launch events with full command lines and file creation events with the creating process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users legitimately sending files to paired phones or headsets via desktop Bluetooth utilities, IoT or embedded device provisioning that pushes firmware or config archives over Bluetooth, lab and field-engineering workstations, backup jobs that write archives to /tmp."
    tuning_guidance = "Add approved provisioning or admin tooling to %global_allowed_admin_tools, authorised administrator accounts to %global_allowed_admin_users, and approved archiving jobs to %global_allowed_backup_processes. On hosts with no Bluetooth hardware or where Bluetooth is disabled by policy, consider raising severity to Critical."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(tar|tgz|gz|zip|7z|bz2|xz|rar)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_admin_users
    $file.principal.hostname = $hostname

    $bt.metadata.event_type = "PROCESS_LAUNCH"
    $bt.target.process.file.full_path = /\/(obexftp|bluetooth-sendto|bt-obex|ussp-push|obex_push)$/ nocase
    $bt.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\.(tar|tgz|gz|zip|7z|bz2|xz|rar)(\s|$))/ nocase
    not $bt.principal.process.file.full_path in %global_allowed_admin_tools
    not $bt.principal.user.userid in %global_allowed_admin_users
    $bt.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $bt.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($hostname)
    $staged_archives = array_distinct($file.target.file.full_path)
    $archiving_processes = array_distinct($file.principal.process.file.full_path)
    $bluetooth_commands = array_distinct($bt.target.process.command_line)
    $users = array_distinct($bt.principal.user.userid)

  condition:
    $file and $bt
}
