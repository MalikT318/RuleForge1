/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:54:09.574108+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Keyring_Daemon_Memory_Access_Then_Dump_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process opens a handle to a credential-caching daemon (keyring, wallet, agent or securityd-style daemon), then the same process writes a memory-dump-style file to a world-writable staging directory on the same host within 10 minutes. This is the Linux analogue of scraping securityd memory for master keys."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux endpoint telemetry that reports process-handle or ptrace-style access (PROCESS_OPEN) and file creation events with the acting process path populated. auditd ptrace and open syscall rules, or EDR sensor data, normalised to UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Crash handlers and core-dump collectors, authorised debugging by developers or SREs, EDR or forensic acquisition tools, backup agents that snapshot process state, desktop session managers that touch the keyring daemon."
    tuning_guidance = "Add approved debuggers and acquisition tooling to %global_allowed_admin_tools, EDR agents to %global_allowed_security_tools, and imaging software to %global_allowed_backup_processes. Extend the dump-file name regex or daemon list to match local conventions."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\/(gnome-keyring-daemon|kwalletd[0-9]*|ssh-agent|gpg-agent|securityd)$/ nocase
    not $open.principal.process.file.full_path = /\/(gnome-keyring-daemon|kwalletd[0-9]*|ssh-agent|gpg-agent|securityd|systemd|dbus-daemon|dbus-broker)$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $actor

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*(core|\.dmp|\.dump|\.mem|\.raw|heap|memdump)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $actor

    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $actor over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($hostname)
    $actor_process = array_distinct($actor)
    $accessed_daemons = array_distinct($open.target.process.file.full_path)
    $dump_files = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($open.principal.user.userid)
    $open_count = count($open.metadata.id)

  condition:
    $open and $file
}
