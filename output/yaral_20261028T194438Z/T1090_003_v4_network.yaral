/*
  MITRE Technique : T1090.003 - Multi-hop Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:31:08.999533+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_003_DNS_Onion_Proxy_Resolution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for Tor hidden-service names, either the .onion pseudo-TLD or a 56-character base32 label (the v3 onion address length) under a normal TLD, as used by onion-to-web gateways. Seen from network infrastructure or from clients sending queries straight to an external resolver, this suggests onion-routed multi-hop proxying or C2. It is network-side coverage that does not depend on endpoint process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.003"
    mitre_technique_name = "Proxy: Multi-hop Proxy"
    log_prerequisites = "Requires DNS query or resolver logs normalised to NETWORK_DNS with network.dns.questions.name populated, and target.ip set to the resolver address."
    platform = "Network Devices"
    log_source = "dns"
    false_positives = "Security researchers or threat-intel staff investigating onion services, privacy-focused users or browsers with sanctioned Tor use, sandbox or malware-analysis hosts, and DNS-filter or test tooling that probes onion names."
    tuning_guidance = "Add known research or analysis hosts to %global_allowed_scanners and sanctioned domains to %global_allowed_domains. The %rfc1918_internal exclusion on target.ip limits the rule to queries sent to external resolvers. If your DNS logs record only internal recursive resolvers as the target, remove that exclusion and rely on the domain and host allowlists instead."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(\.onion\.?$|(^|\.)[a-z2-7]{56}\.[a-z]{2,}\.?$)/ nocase
    not $dns.target.ip in %rfc1918_internal
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1090.003")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $resolver_ips = array_distinct($dns.target.ip)

  condition:
    $dns
}
