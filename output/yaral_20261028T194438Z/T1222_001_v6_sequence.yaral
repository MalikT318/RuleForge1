/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:19:21.633186+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_Takeown_Then_Icacls_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a host running takeown.exe to seize ownership of a file or directory, followed within ten minutes by icacls.exe or cacls.exe granting full, modify or inherited access. This ownership-then-ACL-rewrite chain is used to bypass access controls on protected files, for example before tampering with security tooling or encrypting or deleting data."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled, populating principal.hostname and target.process.command_line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and uninstallers resetting permissions, IT staff repairing broken folder ACLs, profile migration scripts, deployment and RMM tooling, and OS servicing or hardening scripts."
    tuning_guidance = "Add approved deployment and RMM parent binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. If noise persists, tighten the icacls grant regex or add a user join to the match block."

  events:
    $take.metadata.event_type = "PROCESS_LAUNCH"
    $take.target.process.file.full_path = /\\takeown\.exe$/ nocase
    $take.target.process.command_line = /\s\/f\s/ nocase
    not $take.principal.process.file.full_path in %global_allowed_admin_tools
    $take.principal.hostname = $hostname

    $acl.metadata.event_type = "PROCESS_LAUNCH"
    $acl.target.process.file.full_path = /\\(icacls|cacls)\.exe$/ nocase
    $acl.target.process.command_line = /\/grant(:r)?\s+\S+:\(?(f|m|oi|ci)\b/ nocase
    not $acl.principal.process.file.full_path in %global_allowed_admin_tools
    not $acl.principal.user.userid in %global_allowed_service_accounts
    $acl.principal.hostname = $hostname

    $take.metadata.event_timestamp.seconds <= $acl.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($hostname)
    $takeown_commands = array_distinct($take.target.process.command_line)
    $acl_commands = array_distinct($acl.target.process.command_line)
    $acting_users = array_distinct($acl.principal.user.userid)

  condition:
    $take and $acl
}
