/*
  MITRE Technique : T1048 - Exfiltration Over Alternative Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:32:21.120289+00:00
  Reference       : https://attack.mitre.org/techniques/T1048
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_SaaS_External_Login_Then_Bulk_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user logs in to a SaaS application from an external (non-RFC1918) source and, within 10 minutes, performs a burst of download, export or sync operations on resources. This pattern indicates data exfiltration through the application's native web or API channel, which is an alternative to the existing C2 channel. It does not rely on endpoint process telemetry."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048"
    mitre_technique_name = "Exfiltration Over Alternative Protocol"
    log_prerequisites = "Requires SaaS application audit logs normalised to UDM with USER_LOGIN and USER_RESOURCE_ACCESS events. The resource-access events must populate principal.user.userid, principal.ip and metadata.product_event_type (the action name)."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Remote or travelling staff bulk-syncing files after login, approved data migration or e-discovery exports, backup and archiving integrations that use user accounts, sync clients re-indexing after a reinstall, and users logging in through corporate VPN or proxy egress addresses that are not RFC1918."
    tuning_guidance = "Add automation and integration accounts to %global_allowed_service_accounts. Add approved migration or eDiscovery principals to %global_allowed_cloud_principals. Add named administrators who routinely perform exports to %global_allowed_admin_users. Raise or lower the #access threshold per customer based on the typical download volume. If the corporate VPN egress is public, add its range to %rfc1918_internal for that tenant."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(download|export|sync)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.ip in %rfc1918_internal
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals

    $login.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048")
    $primary_entity = array_distinct($user)
    $download_count = count($access.metadata.id)
    $resources_accessed = array_distinct($access.target.resource.name)
    $source_ips = array_distinct($access.principal.ip)
    $actions = array_distinct($access.metadata.product_event_type)

  condition:
    $login and #access >= 10
}
