/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:03:06.776892+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_Protocol_Port_Mismatch_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter telemetry shows a web (HTTP/HTTPS) or DNS application protocol going to an external destination on a port that does not normally carry it. Adversaries tunnel C2 over application-layer protocols on non-standard ports to blend in or slip past port-based filtering, and this rule catches that mismatch from the network side without relying on endpoint process data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Firewall or proxy logs with application identification (network.application_protocol populated), normalised to NETWORK_CONNECTION with target.ip and target.port."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developer or test web servers on custom ports, SaaS or vendor APIs on non-standard HTTPS ports, DNS-over-alternate-port resolvers, application-ID misclassification on the firewall, and remote support tools tunnelling over web protocols."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Extend the accepted port list for protocols the client legitimately uses on custom ports. Confirm the firewall populates network.application_protocol before enabling, because the rule cannot fire without it. Review the repeat source IPs in $primary_entity and treat sources that recur over many connections as beaconing."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      (
        ($net.network.application_protocol = "HTTP" or $net.network.application_protocol = "HTTPS") and
        $net.target.port != 80 and
        $net.target.port != 443 and
        $net.target.port != 8000 and
        $net.target.port != 8008 and
        $net.target.port != 8080 and
        $net.target.port != 8443
      ) or
      (
        $net.network.application_protocol = "DNS" and
        $net.target.port != 53 and
        $net.target.port != 853
      )
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $app_protocols = array_distinct($net.network.application_protocol)

  condition:
    $net
}
