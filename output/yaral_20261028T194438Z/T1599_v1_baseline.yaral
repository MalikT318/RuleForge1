/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:59:21.202001+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_Inbound_External_Session_To_Internal_Admin_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an established, bidirectional flow recorded at a network boundary device from an external source to an internal host on a remote administration or lateral-movement port (SSH, Telnet, RPC, SMB, RDP, VNC, WinRM). Such traffic should be blocked at the trust boundary. A completed session means policy was bypassed, which is the result of a compromised or reconfigured perimeter device bridging the boundary."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Firewall or perimeter flow logs normalized to UDM NETWORK_FLOW with principal.ip, target.ip, target.port, network.sent_bytes and network.received_bytes populated. Logs must be collected from the boundary device itself."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Sanctioned vendor or third-party remote support, published services intentionally exposed on these ports, jump hosts or VPN concentrators, external vulnerability scanners and pen-test sources that are not yet allowlisted, and asymmetric NAT or hairpin traffic logged with external-looking source addresses."
    tuning_guidance = "Add approved external administration sources to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. Confirm %rfc1918_internal covers the customer's internal address space. Adjust the port set per customer policy. If the firewall parser reliably populates security_result.action, consider adding an allow-only filter. Byte counters already suppress most denied or unanswered probes."

  events:
    $flow.metadata.event_type = "NETWORK_FLOW"
    (
      $flow.target.port = 22 or
      $flow.target.port = 23 or
      $flow.target.port = 135 or
      $flow.target.port = 445 or
      $flow.target.port = 3389 or
      $flow.target.port = 5900 or
      $flow.target.port = 5985 or
      $flow.target.port = 5986
    )
    $flow.network.sent_bytes > 0
    $flow.network.received_bytes > 0
    not $flow.principal.ip in %rfc1918_internal
    $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_mgmt_sources
    not $flow.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1599")
    $primary_entity = array_distinct($flow.principal.ip)
    $internal_targets = array_distinct($flow.target.ip)
    $target_ports = array_distinct($flow.target.port)

  condition:
    $flow
}
