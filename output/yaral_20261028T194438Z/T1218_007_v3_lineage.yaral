/*
  MITRE Technique : T1218.007 - Msiexec
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:50:01.827777+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_007_Msiexec_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects msiexec.exe launched by a parent process that does not normally run installers: Office applications, web or application server workers, database services, the print spooler, or script and LOLBin hosts. This is a lineage-based signal for msiexec proxy execution after document exploitation, web shell activity, or script-based loaders. It does not depend on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.007"
    mitre_technique_name = "System Binary Proxy Execution: Msiexec"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with populated parent process path (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or Click-to-Run updaters that invoke Windows Installer, legitimate web or database management consoles that deploy MSI packages, WMI-driven software deployment via WmiPrvSE, installers that launch msiexec through rundll32 or script hosts, and administrator logon scripts run through wscript/cscript."
    tuning_guidance = "Add approved deployment parent binaries to %global_allowed_admin_tools, approved installer service accounts to %global_allowed_service_accounts, and approved script hosts to %global_allowed_script_hosts. If WmiPrvSE or script-host noise is high in a client environment, remove those names from the parent regex after reviewing the deployment tooling in use."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\msiexec\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|sqlservr|spoolsv|mshta|wscript|cscript|wmiprvse|rundll32|regsvr32)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
