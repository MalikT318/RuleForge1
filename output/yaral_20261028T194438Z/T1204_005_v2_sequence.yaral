/*
  MITRE Technique : T1204.005 - Malicious Library
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:06:12.106486+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_005_Linux_Package_Install_Drops_Binary_Then_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A package-manager or language-runtime install process (pip/python/npm/node) writes a file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Within 10 minutes, that same dropped file runs as a process and connects to an external address. This is the typical result of a malicious library install-time payload: drop, execute, call out."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.005"
    mitre_technique_name = "User Execution: Malicious Library"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with file creation events (principal process and target file path populated) and network connection events with the originating process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate native-extension builds that compile helpers in /tmp and fetch dependencies; CI/CD build agents; developer workstations running install scripts that download prebuilt binaries; node-gyp or pip build isolation fetching toolchain components."
    tuning_guidance = "Add approved build or CI hosts to %global_allowed_script_hosts. Add approved install tooling paths to %global_allowed_admin_tools. Add known-good installer destinations through allowlisting upstream or by extending the network-side exclusions."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(pip[0-9.]*|python[0-9.]*|node|nodejs|npm|yarn)$/ nocase
    $file.principal.process.command_line = /(\binstall\b|setup\.py|node_modules|site-packages|postinstall)/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/[^\/]+/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $dropped_path

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/[^\/]+/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $dropped_path

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $dropped_path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1204.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $installer_processes = array_distinct($file.principal.process.file.full_path)
    $installer_command_lines = array_distinct($file.principal.process.command_line)
    $dropped_files = array_distinct($file.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($file.principal.user.userid)
    $connection_count = count($net.metadata.id)

  condition:
    $file and $net
}
