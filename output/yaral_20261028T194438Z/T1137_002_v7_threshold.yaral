/*
  MITRE Technique : T1137.002 - Office Test
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:16:37.666794+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_002_Office_Test_Perf_Key_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated writes to the Office Test 'Special\\Perf' registry key on a single host within 10 minutes. This key is not created by default and lets an arbitrary DLL load whenever an Office application starts, so it is a known persistence mechanism. Repeated writes also suggest a script or implant setting both the user and machine keys or retrying."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.002"
    mitre_technique_name = "Office Application Startup: Office Test"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office or add-in developers and testers who use the Office Test key for debugging or performance DLLs; software deployment or RMM tooling that configures Office; security agents that snapshot or restore registry keys."
    tuning_guidance = "Add approved deployment or RMM writer processes to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. The threshold is set to 2 modifications in 10m to reduce noise from a single benign write; raise it if developer workstations are noisy, or lower it to 1 on endpoints where the key should never exist."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Office test\\Special\\Perf/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.002")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 2
}
