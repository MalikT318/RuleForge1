/*
  MITRE Technique : T1036.009 - Break Process Trees
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:11:57.428063+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_009_Orphaned_Exec_From_Writable_Dirs_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several processes executed from world-writable staging directories (/tmp, /var/tmp, /dev/shm) are parented directly by PID 1 on one Linux host within ten minutes. A single orphaned process is normal daemon behaviour. A burst of init-adopted binaries running from staging paths matches the double-fork or daemon() technique, which detaches a payload from its original process tree."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.009"
    mitre_technique_name = "Masquerading: Break Process Trees"
    log_prerequisites = "Linux EDR or auditd execve telemetry that populates the parent process PID and the child executable path on PROCESS_LAUNCH events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or build systems that run helper binaries from /tmp under systemd, container runtimes, CI agents, configuration management (Ansible, Puppet, Chef) executing staged scripts, and admin scripts using nohup or setsid."
    tuning_guidance = "Add approved tooling executables to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and trusted parent launchers to %global_allowed_script_hosts. Raise the #proc threshold on build or CI hosts. Check whether the parent PID field is populated in your EDR or auditd parser, since the rule needs it."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.pid = "1"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $proc.principal.hostname = $host
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1036.009")
    $primary_entity = array_distinct($host)
    $orphaned_binaries = array_distinct($proc.target.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 3
}
