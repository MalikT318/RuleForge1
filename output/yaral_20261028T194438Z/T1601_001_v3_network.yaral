/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:12:50.633244+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Outbound_TFTP_FTP_Image_Transfer_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a connection from an internal source to an external destination over TFTP (UDP/69) or FTP control (TCP/21). These are the legacy file-transfer protocols network device operators use to push or pull OS images, so this behaviour can indicate a patched or replaced system image being staged on or retrieved by a network device. Internal-to-internal transfers are excluded via reference list, as are approved management sources."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. The firewall must log traffic originating from network device management interfaces."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate firmware or image upgrades fetched from a vendor or external staging server by authorised network engineers, zero-touch provisioning during device deployment, legacy backup jobs using TFTP or FTP to an off-site host, and unrelated user or application FTP use to external partners."
    tuning_guidance = "Add approved network engineering jump hosts and device management addresses to %global_allowed_mgmt_sources. Add authorised vulnerability scanners to %global_allowed_scanners. Where FTP (21) is noisy, remove that port clause and keep TFTP only, which is rarely legitimate across the perimeter. Ensure %rfc1918_internal covers all internal address space for the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 69 or
      $net.target.port = 21
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
