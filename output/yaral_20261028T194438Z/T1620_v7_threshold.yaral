/*
  MITRE Technique : T1620 - Reflective Code Loading
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:45:51.895269+00:00
  Reference       : https://attack.mitre.org/techniques/T1620
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1620_Linux_Reflective_Memfd_Execution_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated process launches on a single Linux host within 10 minutes that execute from anonymous memory-backed file descriptors (memfd:, /proc/<pid>/fd/<n>) or invoke memfd_create from an interpreter. A single occurrence can be benign runtime behavior, but repeated fileless execution on one host indicates reflective code loading."
    mitre_tactic = "Stealth"
    mitre_technique = "T1620"
    mitre_technique_name = "Reflective Code Loading"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd (execve/EXECVE records) normalised to UDM PROCESS_LAUNCH with target.process.file.full_path and target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Container runtimes and runc (which re-execute from a sealed memfd copy of the binary), JIT runtimes and language VMs, browsers and sandboxes using memfd, systemd and package or update tooling, and developers testing fileless loaders."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on container hosts. Check whether runc or container runtimes dominate the hits and exclude their parent paths."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /^\/memfd:/ nocase or
      $proc.target.process.file.full_path = /^\/proc\/(self|\d+)\/fd\/\d+/ nocase or
      $proc.target.process.command_line = /memfd_create/ nocase or
      $proc.target.process.command_line = /^\/proc\/(self|\d+)\/fd\/\d+/ nocase
    )
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(count($proc.metadata.id) >= 10, 85, 60))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1620")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $child_paths = array_distinct($proc.target.process.file.full_path)

  condition:
    #proc >= 3
}
