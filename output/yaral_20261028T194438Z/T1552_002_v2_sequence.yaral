/*
  MITRE Technique : T1552.002 - Credentials in Registry
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:47:16.818255+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_002_Registry_Credential_Export_Then_File_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the built-in registry utility exporting or saving credential-bearing registry hives or keys (Winlogon autologon, SAM/SECURITY, PuTTY, VNC, SNMP), followed within 10 minutes by that utility writing a dump file to a user-writable location on the same host. The file-creation leg confirms that registry data was actually harvested to disk, which makes this sequence additive to command-line-only detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.002"
    mitre_technique_name = "Unsecured Credentials: Credentials in Registry"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry and file-creation telemetry (EDR or Sysmon Event IDs 1 and 11) with the creating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators backing up Winlogon, PuTTY or VNC settings before migration; profile migration and imaging tools; configuration-management jobs exporting registry state; kiosk or autologon provisioning scripts."
    tuning_guidance = "Add approved admin and deployment tooling to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Narrow the credential-key regex if a client regularly exports a specific key. Expand the user-writable path regex if clients stage dumps elsewhere."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\reg\.exe$/ nocase
    $proc.target.process.command_line = /\b(export|save)\b/ nocase
    $proc.target.process.command_line = /(winlogon|putty|vnc|snmp|(hklm|hkey_local_machine)\\(sam|security))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\reg\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\|temp\\|programdata\\|perflogs\\)/ nocase
    $file.target.file.full_path = /\.(reg|hiv|txt|dat|bak|save)$/ nocase
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $users = array_distinct($proc.principal.user.userid)
    $export_commands = array_distinct($proc.target.process.command_line)
    $dump_files = array_distinct($file.target.file.full_path)
    $dump_count = count($file.metadata.id)

  condition:
    $proc and $file
}
