/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:47:31.082045+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_Linux_Large_External_HTML_Download_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux client retrieving an unusually large HTML-type document (.html, .htm, .xhtml, .shtml, .hta) from an external host through a proxy or firewall with HTTP visibility. Ordinary web pages are small. An HTML file of 1 MB or more is consistent with embedded JavaScript Blob or Data URL payloads, which is the delivery mechanism of HTML smuggling. This is a network-side detection that complements endpoint process-creation coverage."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires firewall or web proxy logs with HTTP visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP, with target.url, network.http.user_agent, network.http.response_code and network.received_bytes populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Large legitimate single-page web applications, saved or generated HTML reports and documentation, offline-bundled HTML exports from vendors, package or mirror index pages, and automation (curl/wget) fetching large HTML artifacts."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Raise or lower the network.received_bytes threshold per client baseline. Add approved automation accounts to %global_allowed_service_accounts. Confirm that the proxy populates the user agent so the Linux client filter works."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(html?|xhtml|shtml|hta)([?#].*)?$/ nocase
    $net.network.http.user_agent = /(X11;.*Linux|Linux (x86_64|aarch64|armv)|\bcurl\/|\bwget\/)/ nocase
    $net.network.http.response_code = 200
    $net.network.received_bytes > 1000000
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $max_received_bytes = max($net.network.received_bytes)

  condition:
    $net
}
