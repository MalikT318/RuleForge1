/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:38:38.093649+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_NonLsass_Kerberos_Traffic_Then_Klist {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process other than LSASS connects directly to a KDC on TCP/UDP 88, then klist.exe is used on the same host within 10 minutes to inspect, request or purge cached Kerberos tickets. This pattern is consistent with ticket requests or forging by a user-mode tool, followed by verification of the injected ticket."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires Windows endpoint EDR or Sysmon telemetry with process-attributed network connections (NETWORK_CONNECTION with principal process path and target port) and process launch events with full command lines."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Java, Python or other applications with their own Kerberos stack; third-party SSO, VPN or authentication agents; SQL and database clients using native Kerberos; administrators troubleshooting Kerberos issues with klist after running such tools; identity and PAM agents."
    tuning_guidance = "Add approved Kerberos-capable agents to %global_allowed_security_tools or %global_allowed_admin_tools. Add troubleshooting admins to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. If one application dominates, allow its executable by name in the lists instead of widening the regex exclusions."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    $net.principal.process.file.full_path != ""
    not $net.principal.process.file.full_path = /\\(lsass|system)(\.exe)?$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\klist\.exe$/ nocase
    $proc.target.process.command_line = /\bklist(\.exe)?"?\s+(tgt|get|purge|sessions|tickets)\b/ nocase
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $net.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($hostname)
    $kerberos_client_processes = array_distinct($net.principal.process.file.full_path)
    $kdc_ips = array_distinct($net.target.ip)
    $klist_command_lines = array_distinct($proc.target.process.command_line)
    $klist_users = array_distinct($proc.principal.user.userid)

  condition:
    $net and $proc
}
