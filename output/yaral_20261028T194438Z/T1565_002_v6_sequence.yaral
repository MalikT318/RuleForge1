/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:42:17.933685+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_RootCert_Install_Then_Proxy_Redirect {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a trusted root certificate being added through a command line, followed within 10 minutes by a change to the system or user proxy settings on the same host. This sequence is the usual set-up for a local man-in-the-middle position, in which transmitted data can be intercepted and altered."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Requires EDR or Sysmon process telemetry with full command lines (PROCESS_LAUNCH) and registry modification telemetry (REGISTRY_MODIFICATION) that includes the registry key and value name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Corporate TLS-inspection or secure web gateway agent onboarding, enterprise PKI or MDM enrollment, VPN and ZTNA client installs that set proxy or PAC settings, developer or QA staff using debugging proxies, and help-desk proxy reconfiguration."
    tuning_guidance = "Add approved deployment and PKI tooling to %global_allowed_admin_tools. Add approved remote or endpoint management agents that configure proxies to %global_allowed_remote_mgmt. Add the service accounts that run these deployments to %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\certutil\.exe$/ nocase
    $proc.target.process.command_line = /-addstore/ nocase
    $proc.target.process.command_line = /\b(root|authroot|trustedpublisher)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\(Policies\\)?Microsoft\\Windows\\CurrentVersion\\Internet Settings/ nocase
    $reg.target.registry.registry_value_name = /^(ProxyServer|AutoConfigURL|ProxyEnable)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    $reg.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($hostname)
    $users = array_distinct($proc.principal.user.userid)
    $cert_commands = array_distinct($proc.target.process.command_line)
    $proxy_registry_keys = array_distinct($reg.target.registry.registry_key)
    $proxy_value_names = array_distinct($reg.target.registry.registry_value_name)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $registry_event_count = count($reg.metadata.id)

  condition:
    $proc and $reg
}
