/*
  MITRE Technique : T1675 - ESXi Administration Command
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:20:04.960955+00:00
  Reference       : https://attack.mitre.org/techniques/T1675
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1675_ESXi_Guest_Operation_Config_Event {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects hypervisor host management-service events recording guest operations (start program, list processes or files, file transfer to or from a guest) executed through the management API. This is the resulting host-side state or audit record rather than a command line. It surfaces abuse of the guest tools daemon channel to run commands inside hosted VMs without logging in to the guest."
    mitre_tactic = "Execution"
    mitre_technique = "T1675"
    mitre_technique_name = "ESXi Administration Command"
    log_prerequisites = "ESXi host management service (hostd) logs forwarded to Chronicle and parsed so that guest operation events map to SETTING_MODIFICATION, with the event text in metadata.description. Host and user fields should be populated by the parser."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and snapshot quiescing jobs, patch and configuration management that uses guest operations, VM provisioning and customization workflows, monitoring or inventory integrations, and administrators running approved guest scripts."
    tuning_guidance = "Add automation and integration accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Add jump hosts and orchestration servers to %global_allowed_mgmt_sources. Add backup users to %global_allowed_backup_processes only if the parser places them in the same field. Raise severity when the same user performs operations on many VMs, which can be tracked with the vm_targets outcome."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /(StartProgramInGuest|ListProcessesInGuest|ListFilesInGuest|InitiateFileTransferFromGuest|InitiateFileTransferToGuest|ReadEnvironmentVariableInGuest|guest\s+operation)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1675")
    $primary_entity = array_distinct(strings.coalesce($setting.target.hostname, $setting.principal.hostname))
    $acting_users = array_distinct($setting.principal.user.userid)
    $source_ips = array_distinct($setting.principal.ip)
    $vm_targets = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
