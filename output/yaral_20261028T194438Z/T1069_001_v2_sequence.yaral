/*
  MITRE Technique : T1069.001 - Local Groups
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:57:04.275254+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_001_Local_Group_Enum_Then_Privileged_Group_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Local group or local administrator enumeration followed within ten minutes by a membership change to a privileged local group on the same host. This pattern suggests discovery being used to pick a target and then escalate or persist. It adds sequence coverage beyond stand-alone command-line discovery detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.001"
    mitre_technique_name = "Permission Groups Discovery: Local Groups"
    log_prerequisites = "Requires EDR process telemetry or Windows Event 4688 with command-line auditing, plus Windows Security events 4732/4728/4756 normalised to GROUP_MODIFICATION with target.group.group_display_name populated and principal.hostname set to the host that logged the event."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Helpdesk or onboarding scripts that audit and then update local Administrators membership; software installers that add service accounts to local groups; RMM or endpoint management agents; GPO restricted-groups enforcement; administrators troubleshooting access."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Add service or automation accounts to %global_allowed_service_accounts. Extend the privileged group name regex for non-English Windows locales. Raise severity if the enumerating and modifying accounts differ or the activity comes from a remote session."

  events:
    $enum.metadata.event_type = "PROCESS_LAUNCH"
    $enum.target.process.command_line = /(\bnet1?(\.exe)?"?\s+localgroup\s+"?(administrators|remote desktop users|backup operators|power users|remote management users|distributed com users)|\bnet1?(\.exe)?"?\s+localgroup\s*$|get-localgroupmember|get-localgroup\b|win32_group(user)?\b|adsi\]\s*"winnt:\/\/.*group)/ nocase
    not $enum.principal.process.file.full_path in %global_allowed_admin_tools
    not $enum.principal.user.userid in %global_allowed_admin_users
    not $enum.principal.user.userid in %global_allowed_service_accounts
    $enum.principal.hostname = $hostname

    $mod.metadata.event_type = "GROUP_MODIFICATION"
    $mod.target.group.group_display_name = /^(administrators|remote desktop users|backup operators|power users|remote management users|distributed com users)$/ nocase
    not $mod.principal.user.userid in %global_allowed_admin_users
    not $mod.principal.user.userid in %global_allowed_service_accounts
    $mod.principal.hostname = $hostname

    $enum.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1069.001")
    $primary_entity = array_distinct($hostname)
    $enum_commands = array_distinct($enum.target.process.command_line)
    $enum_users = array_distinct($enum.principal.user.userid)
    $modified_groups = array_distinct($mod.target.group.group_display_name)
    $modifying_users = array_distinct($mod.principal.user.userid)
    $added_members = array_distinct($mod.target.user.userid)
    $enum_event_count = count($enum.metadata.id)

  condition:
    $enum and $mod
}
