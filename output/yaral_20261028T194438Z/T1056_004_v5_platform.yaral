/*
  MITRE Technique : T1056.004 - Credential API Hooking
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:51:49.997192+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_004_Global_Hook_Injection_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-empty write to the AppInit_DLLs / LoadAppInit_DLLs values or the AppCertDLLs key. These Windows mechanisms force a DLL into every process that loads user32.dll or calls CreateProcess. Credential-stealing malware uses them to install API hooks in processes that handle credentials. This rule is registry-based and complements command-line detections."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.004"
    mitre_technique_name = "Input Capture: Credential API Hooking"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 equivalent) that populates target.registry.registry_key, registry_value_name and registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy accessibility, screen-reader or OEM utilities that register AppInit DLLs; older application-compatibility or DLP/EDR agents that use AppCertDLLs; software installers writing these values during setup."
    tuning_guidance = "Add the writing process executable path to %global_allowed_security_tools or %global_allowed_admin_tools. Add known service accounts to %global_allowed_service_accounts. Review the registry value data to confirm the DLL is legitimately signed before allowlisting."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Windows NT\\CurrentVersion\\Windows$/ nocase
        and $reg.target.registry.registry_value_name = /^(AppInit_DLLs|LoadAppInit_DLLs)$/ nocase
      )
      or
      $reg.target.registry.registry_key = /\\Control\\Session Manager\\AppCertDLLs$/ nocase
    )
    not $reg.target.registry.registry_value_data = /^0?$/
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1056.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
