/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:03:37.347762+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_VDSO_Hijack_Daemon_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external network connection initiated by a Linux system daemon that does not normally make outbound connections (cron, atd, rsyslogd, systemd-logind, dbus-daemon, auditd, polkitd and similar), or by a process executing from a world-writable or memory-backed location (/tmp, /var/tmp, /dev/shm, memfd). Code injected through VDSO hijacking runs under the identity of a legitimate live process, so the visible symptom is a trusted process making an unexpected external connection, such as reverse-shell or C2 traffic. This is network-side coverage that complements endpoint process-creation rules."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd (connect syscall auditing) telemetry that populates NETWORK_CONNECTION events with principal.process.file.full_path, principal.hostname and target.ip."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Daemons with legitimate outbound functions, for example rsyslogd forwarding logs to an external collector, auditd remote logging, cron-spawned jobs on EDR agents that attribute child traffic to the parent, and dbus-daemon activated services. Installers, build tools or software run from /tmp or /dev/shm that download packages. Containers and CI runners that execute binaries from temporary directories."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and approved admin or deployment binaries to %global_allowed_admin_tools. Add approved log-forwarding destinations or known-good egress sources to the tenant allowlists, and narrow the daemon list per client if rsyslogd or auditd legitimately forward logs externally. Confirm that %rfc1918_internal covers the client's internal ranges."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(\/(cron|crond|atd|rsyslogd|irqbalance|systemd-logind|dbus-daemon|auditd|agetty|systemd-udevd|polkitd|acpid)$|^\/(tmp|var\/tmp|dev\/shm)\/|^\/memfd:)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
