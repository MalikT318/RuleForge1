/*
  MITRE Technique : T1098.003 - Additional Cloud Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:44:33.028981+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_003_Cloud_IAM_Role_Or_Policy_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a cloud control-plane API call that grants additional permissions to an identity: attaching or inlining an IAM policy, creating or promoting a policy version, adding a user to a group, changing a role trust policy, setting an IAM policy binding, or writing a role assignment. Adversaries use these calls to give a compromised or newly created account persistent elevated access to a tenant."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.003"
    mitre_technique_name = "Account Manipulation: Additional Cloud Roles"
    log_prerequisites = "Cloud provider management-plane audit logs ingested and normalised to UDM RESOURCE_PERMISSIONS_CHANGE, with metadata.product_event_type populated with the API operation name. Write or management events must be enabled in the audit trail."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned IAM changes by cloud platform teams, infrastructure-as-code pipelines (Terraform, CloudFormation, Bicep) running under automation identities, joiner/mover/leaver identity governance workflows, just-in-time privileged access tools, and onboarding of new projects or accounts."
    tuning_guidance = "Add pipeline and automation identities to %global_allowed_service_accounts, approved platform or identity-governance principals to %global_allowed_cloud_principals, and named cloud administrators to %global_allowed_admin_users. Triage alerts first where the actor is not the usual change owner, the grant targets the actor's own identity, or the change follows account creation or an unusual login. To reduce volume, narrow the operation regex to the API names relevant to the client."

  events:
    $cloud.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $cloud.metadata.product_event_type = /(AttachUserPolicy|AttachRolePolicy|AttachGroupPolicy|PutUserPolicy|PutRolePolicy|PutGroupPolicy|CreatePolicyVersion|SetDefaultPolicyVersion|AddUserToGroup|UpdateAssumeRolePolicy|SetIamPolicy|roleAssignments\/write|add member to role)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $target_user = array_distinct($cloud.target.user.userid)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
