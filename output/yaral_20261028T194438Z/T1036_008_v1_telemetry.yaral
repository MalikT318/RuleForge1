/*
  MITRE Technique : T1036.008 - Masquerade File Type
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:08:58.186419+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_008_Masquerade_File_Type_Benign_Extension_Staged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file with a benign image, text or document extension in a user-writable staging location, where the file content is identified as a Windows executable or the writer is a script host or built-in download utility. This is the file artifact left when a payload is renamed or retyped to pass as a harmless file type."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.008"
    mitre_technique_name = "Masquerading: Masquerade File Type"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with target.file.full_path and the writing process populated. The content-type branch also needs target.file.mime_type, which is only populated by EDRs that classify file content."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or build scripts that legitimately write logs, text files or images to Temp, ProgramData or AppData. Software installers and updaters that stage resources in these paths. Screenshot or reporting tools run from PowerShell. RMM and deployment agents."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_script_hosts or %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. If the script-host branch is noisy, remove it and keep only the mime_type content-mismatch branch. Without mime_type telemetry, keep the script-host branch and raise severity only when the same host also shows execution from the created path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(Users\\[^\\]+\\(AppData|Downloads|Desktop)|ProgramData|Users\\Public|Windows\\Temp|Temp)\\.*\.(jpe?g|png|gif|bmp|ico|txt|pdf|log)$/ nocase
    (
      $file.target.file.mime_type = /(x-dosexec|x-msdownload|portable-executable|x-msdos-program|vnd\.microsoft\.portable-executable)/ nocase
      or $file.principal.process.file.full_path = /\\(powershell|pwsh|certutil|bitsadmin|mshta|wscript|cscript|rundll32|regsvr32|curl)\.exe$/ nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1036.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $detected_mime_type = array_distinct($file.target.file.mime_type)

  condition:
    $file
}
