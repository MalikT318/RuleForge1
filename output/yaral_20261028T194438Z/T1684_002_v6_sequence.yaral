/*
  MITRE Technique : T1684.002 - Email Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:34:29.336816+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_002_Spoofed_Sender_Reply_To_Mismatch_Victim_Reply {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an email whose From header domain differs from its Reply-To domain (a common spoofing pattern), followed within 10 minutes by the recipient replying to that Reply-To address. This indicates a user engaged with a likely spoofed sender and is now communicating with attacker-controlled infrastructure."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.002"
    mitre_technique_name = "Email Spoofing"
    log_prerequisites = "Requires mail transaction / unified audit logs normalised to UDM EMAIL_TRANSACTION with network.email.from, network.email.reply_to, network.email.to and network.email.subject populated for both inbound and outbound messages."
    platform = "Windows"
    log_source = "m365"
    false_positives = "Legitimate bulk-mail and marketing platforms that send on behalf of a brand with a different Reply-To domain, helpdesk and ticketing systems, CRM notification mail, mailing-list software, and shared-mailbox workflows."
    tuning_guidance = "Add known-good sending and reply domains (marketing, ticketing, CRM vendors) to %global_allowed_domains. Add automation or shared mailbox identities to %global_allowed_service_accounts. Consider raising severity when the reply goes to a free-mail domain."

  events:
    $inbound.metadata.event_type = "EMAIL_TRANSACTION"
    $inbound.network.email.from != ""
    $inbound.network.email.reply_to != ""
    $from_domain = re.capture($inbound.network.email.from, "@([A-Za-z0-9.-]+)")
    $reply_domain = re.capture($inbound.network.email.reply_to, "@([A-Za-z0-9.-]+)")
    $from_domain != $reply_domain
    not $from_domain in %global_allowed_domains
    not $reply_domain in %global_allowed_domains
    $inbound.network.email.to = $recipient
    $inbound.network.email.reply_to = $reply_addr
    not $recipient in %global_allowed_service_accounts

    $reply.metadata.event_type = "EMAIL_TRANSACTION"
    $reply.network.email.subject = /^\s*(re|aw|sv)\s*:/ nocase
    $reply.network.email.from = $recipient
    $reply.network.email.to = $reply_addr

    $inbound.metadata.event_timestamp.seconds <= $reply.metadata.event_timestamp.seconds

  match:
    $recipient, $reply_addr over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1684.002")
    $primary_entity = array_distinct($recipient)
    $spoofed_from = array_distinct($inbound.network.email.from)
    $attacker_reply_to = array_distinct($reply_addr)
    $inbound_subjects = array_distinct($inbound.network.email.subject)
    $first_seen = min($inbound.metadata.event_timestamp.seconds)
    $last_seen = max($reply.metadata.event_timestamp.seconds)

  condition:
    $inbound and $reply
}
