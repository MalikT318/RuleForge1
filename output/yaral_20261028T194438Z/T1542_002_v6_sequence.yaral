/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:45:36.011695+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Linux_Staged_Firmware_Image_Then_Flash_Command {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a firmware-style image (.bin, .rom, .fw, .cap, .img, .hex) written to a user-writable or volatile staging directory, followed on the same host within 10 minutes by a command that flashes component firmware (disk, NVMe, NIC, SPI flash, or fwupd local install). This staging-then-flash pattern is typical of component firmware implants and is rare outside planned maintenance."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates both file creation events (target.file.full_path) and process launch events (target.process.command_line)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Planned hardware maintenance by sysadmins or datacenter technicians, vendor firmware update workflows run manually from /tmp, RMM or fleet firmware tooling, and lab or engineering hosts that flash devices routinely."
    tuning_guidance = "Add approved firmware and maintenance tooling to %global_allowed_admin_tools, add authorised operators to %global_allowed_admin_users, and add provisioning or maintenance hosts to %global_allowed_script_hosts or exclude them per tenant. Extend the staging-directory regex only if clients stage updates elsewhere."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|root|home\/[^\/]+)\/.*\.(bin|rom|fw|cap|img|hex)$/ nocase
    not $file.principal.process.file.full_path = /\/(apt|apt-get|dpkg|rpm|dnf|yum|zypper|fwupd|fwupdmgr|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(hdparm\s.*--fwdownload|nvme\s+fw-(download|commit)|flashrom\s.*(\s-w\s|--write)|ethtool\s+(-f|--flash)\s|(mstflint|flint)\s.*\sburn|sg_write_buffer\s|fwupd(tool|mgr)?\s+install)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $staged_files = array_distinct($file.target.file.full_path)
    $flash_commands = array_distinct($proc.target.process.command_line)
    $acting_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
