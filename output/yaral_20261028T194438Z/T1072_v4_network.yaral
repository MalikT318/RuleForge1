/*
  MITRE Technique : T1072 - Software Deployment Tools
  Tactic(s)       : Execution, Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:15:22.643156+00:00
  Reference       : https://attack.mitre.org/techniques/T1072
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1072_Linux_Rogue_Deployment_Agent_External_Mgmt_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process that is not an approved management tool making an outbound connection to an external address on well-known configuration-management master ports (Salt 4505/4506, Puppet 8140). The process must run from a writable staging directory (/tmp, /var/tmp, /dev/shm) or be a general-purpose shell or interpreter. This pattern suggests a rogue or hijacked deployment agent, or a script enrolling the host with an attacker-controlled management server so the adversary can push commands to it. It complements process command-line detections by observing the network side of the technique."
    mitre_tactic = "Execution, Lateral Movement"
    mitre_technique = "T1072"
    mitre_technique_name = "Software Deployment Tools"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry that populates principal process path, target IP and target port on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate configuration-management agents (Salt minion, Puppet agent) that are installed in non-standard locations and talk to a cloud-hosted or externally reachable master. Provisioning scripts or containers bootstrapping a new host into management from a temporary directory. Authorised red-team or lab activity."
    tuning_guidance = "Add approved agent binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Add approved external master addresses to %global_allowed_mgmt_sources. Add approved bootstrap or provisioning service accounts to %global_allowed_service_accounts. Add scanner sources to %global_allowed_scanners. Extend the port list to match the deployment tooling used by the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    (
      $net.target.port = 4505 or
      $net.target.port = 4506 or
      $net.target.port = 8140
    )
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/|\/(bash|sh|dash|zsh|python[0-9.]*|perl|ruby)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1072")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
