/*
  MITRE Technique : T1559 - Inter-Process Communication
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:50:19.768926+00:00
  Reference       : https://attack.mitre.org/techniques/T1559
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_Linux_Outbound_Remote_IPC_Port_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host initiating a connection to a non-internal address on ports used by remote inter-process communication and RPC/DCOM services (MSRPC endpoint mapper 135, RPC-over-HTTP/DCOM 593, rpcbind 111, and the conventional D-Bus TCP transport port 55556). Legitimate Linux workloads rarely use these remote IPC mechanisms across the internet. Their use is characteristic of remote IPC or DCOM execution tooling run from a compromised Linux host, or of D-Bus exposed over TCP."
    mitre_tactic = "Execution"
    mitre_technique = "T1559"
    mitre_technique_name = "Inter-Process Communication"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR network events or auditd connect syscall records) normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip, target.port and, ideally, principal.process.file.full_path populated. The %rfc1918_internal reference list must be populated for the tenant."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hybrid-cloud or VPN-routed environments where internal ranges are not covered by %rfc1918_internal (for example carrier-grade NAT or public address space used internally); NFS/rpcbind clients mounting storage from a provider-hosted endpoint; approved vulnerability scanners and penetration tests; legitimate Samba/Windows interoperability tooling reaching a cloud-hosted domain controller; custom applications using D-Bus over TCP."
    tuning_guidance = "Add legitimate external RPC peers or management sources to %global_allowed_mgmt_sources, approved tooling binaries to %global_allowed_admin_tools, remote support tooling to %global_allowed_remote_mgmt, and scanners to %global_allowed_scanners. Confirm %rfc1918_internal covers all internal and VPN address space for the tenant. Extend the port list only if the client runs a known custom IPC-over-TCP service."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 593 or
      $net.target.port = 111 or
      $net.target.port = 55556
    )
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_scanners
    not $net.principal.process.file.full_path = /\/(rpcbind|rpc\.statd|mount\.nfs[0-9]*|nfsiod)$/ nocase

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1559")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
