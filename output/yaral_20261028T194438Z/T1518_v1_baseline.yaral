/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:36:08.819759+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_ESXi_Software_Inventory_Via_Esxcli {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of installed software on an ESXi host from the shell, using esxcli or localcli to list or inspect VIBs, components, software profiles, or acceptance levels. Adversaries use this inventory to identify installed security agents, drivers and vulnerable VIB versions before choosing follow-on actions such as ransomware deployment or malicious VIB installation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "Requires ESXi shell command auditing (shell.log / hostd) forwarded and parsed to UDM PROCESS_LAUNCH with target.process.command_line populated. ESXi SSH or Shell must be enabled for this activity to occur."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host patching and lifecycle tooling, hardware vendor health or driver checks, configuration management and compliance scripts, and administrators verifying VIB or driver versions before upgrades or support cases."
    tuning_guidance = "Add approved lifecycle and patching tooling parent processes to %global_allowed_admin_tools, and automation or compliance accounts to %global_allowed_service_accounts. Raise severity when the activity follows an SSH login from an unexpected source or occurs outside change windows."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(esxcli|localcli)\b(\s+--?\S+(\s+\S+)?)*\s+software\s+(vib|component|profile|acceptance|sources)\s+(list|get)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
