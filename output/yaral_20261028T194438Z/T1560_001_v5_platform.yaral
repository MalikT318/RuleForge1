/*
  MITRE Technique : T1560.001 - Archive via Utility
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:58:17.497144+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_001_Linux_Archive_Created_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a native Linux compression or archiving utility writing an archive file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Adversaries commonly package collected data there before exfiltration. This rule uses file-creation telemetry and does not depend on command-line matching, so it complements process-creation detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.001"
    mitre_technique_name = "Archive Collected Data: Archive via Utility"
    log_prerequisites = "Linux EDR or auditd file-creation telemetry that populates the creating process path (principal.process.file.full_path) and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software build and packaging jobs, developers and admins staging troubleshooting bundles (support archives, core dump packaging), configuration management and deployment agents, backup and log-collection scripts that stage archives in /tmp, and package manager hooks."
    tuning_guidance = "Add approved backup or imaging utilities to %global_allowed_backup_processes, approved admin and deployment tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise severity for hosts holding sensitive data, or extend the staging path regex with client-specific scratch directories."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(tar|zip|gzip|bzip2|xz|zstd|pigz|7z|7za|7zr|rar|p7zip)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(tar|tar\.gz|tgz|tar\.bz2|tbz2|tar\.xz|txz|tar\.zst|zip|7z|rar|gz|bz2|xz|zst)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1560.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $archive_path = array_distinct($file.target.file.full_path)
    $archiver_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
