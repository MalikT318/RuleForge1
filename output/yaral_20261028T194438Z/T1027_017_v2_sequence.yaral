/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:05:26.669135+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Fetch_Then_Payload_Download_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A Linux client fetches an SVG file from an external web source and, within five minutes, downloads an executable, script, archive or disk-image payload from an external destination. This is the network-observable pattern of SVG smuggling, where an SVG delivers or fetches a payload that bypasses content filters. The rule uses proxy or firewall HTTP telemetry only and does not depend on process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires proxy or firewall HTTP telemetry normalised to NETWORK_HTTP with principal.ip, target.url, target.hostname and network.http.user_agent populated. The SSL/TLS inspection or URL logging must be enabled to see full URLs."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Web developers or designers downloading SVG assets and then packages or archives (npm, icon packs, font bundles); package managers and CI jobs on Linux workstations; documentation sites that serve SVG diagrams alongside downloadable archives; software vendors hosting installers on the same site as SVG artwork."
    tuning_guidance = "Add known-good CDN, vendor and package-repository domains to %global_allowed_domains. If developer or CI subnets are noisy, scope them out at the log-source level. To tighten, remove less common extensions from the payload regex. To widen coverage for non-browser clients, relax or remove the user-agent condition on the SVG event."

  events:
    $svg.metadata.event_type = "NETWORK_HTTP"
    $svg.target.url = /\.svg(\?|#|$)/ nocase
    $svg.network.http.user_agent = /(linux|x11)/ nocase
    not $svg.target.hostname in %global_allowed_domains
    not $svg.target.ip in %rfc1918_internal
    $svg.principal.ip = $client_ip

    $payload.metadata.event_type = "NETWORK_HTTP"
    $payload.target.url = /\.(sh|run|bin|elf|appimage|deb|rpm|jar|js|jse|vbs|hta|iso|img|zip|7z|rar|exe|msi|dll|lnk)(\?|#|$)/ nocase
    not $payload.target.hostname in %global_allowed_domains
    not $payload.target.ip in %rfc1918_internal
    $payload.principal.ip = $client_ip

    $svg.metadata.event_timestamp.seconds <= $payload.metadata.event_timestamp.seconds

  match:
    $client_ip over 5m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.017")
    $primary_entity = array_distinct($client_ip)
    $svg_urls = array_distinct($svg.target.url)
    $payload_urls = array_distinct($payload.target.url)
    $payload_hosts = array_distinct($payload.target.hostname)
    $client_hostnames = array_distinct($svg.principal.hostname)
    $event_count = count($payload.metadata.id)

  condition:
    $svg and $payload
}
