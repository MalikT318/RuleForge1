/*
  MITRE Technique : T1137 - Office Application Startup
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:12:41.946347+00:00
  Reference       : https://attack.mitre.org/techniques/T1137
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_Outlook_Rule_Run_Application_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a mailbox inbox-rule creation or modification whose audit record shows an action that starts an application or executes a process (e.g. Outlook rule-based persistence and code execution). This is detected at the configuration-change layer of the unified audit log, so it does not depend on endpoint command-line logging."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137"
    mitre_technique_name = "Office Application Startup"
    log_prerequisites = "Requires Microsoft 365 unified audit logging with mailbox auditing enabled, so that Exchange admin and mailbox audit operations (New-InboxRule, Set-InboxRule, UpdateInboxRules) are ingested. The rule parameters or actions must be present in the security_result.description field after parsing."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Administrators or help-desk staff creating legitimate rules through approved scripts; migration tools restoring rules in bulk; service accounts that provision mailbox rules; legacy line-of-business rules that launch a local notifier application."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and provisioning or migration identities to %global_allowed_service_accounts. Add automation principals to %global_allowed_cloud_principals. If the client parser stores rule actions in a different field, adjust the security_result.description match. Consider raising severity when the actor is also seen in an anomalous USER_LOGIN."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules)$/ nocase
    $set.security_result.description = /(ExecuteProcess|StartApplication|RunApplication|ApplicationPath|CustomAction|\.(exe|dll|bat|cmd|ps1|vbs|hta)\b)/ nocase
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137")
    $primary_entity = array_distinct($set.principal.user.userid)
    $source_ips = array_distinct($set.principal.ip)
    $affected_mailbox = array_distinct($set.target.user.userid)
    $operation = array_distinct($set.metadata.product_event_type)

  condition:
    $set
}
