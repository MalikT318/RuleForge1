/*
  MITRE Technique : T1008 - Fallback Channels
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:17:37.553046+00:00
  Reference       : https://attack.mitre.org/techniques/T1008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1008_Firewall_Fallback_Channel_HighPort_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes a high volume of outbound connections to external destinations on non-standard high ports within 10 minutes. This pattern is consistent with malware cycling through alternate ports and destinations when its primary C2 channel is blocked. Each connection is benign on its own; the volume and port churn are the signal."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1008"
    mitre_technique_name = "Fallback Channels"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Peer-to-peer or collaboration clients (VoIP, video conferencing, game launchers), software updaters using high ports, backup or sync agents, VPN clients, and authorised vulnerability scanners or penetration tests."
    tuning_guidance = "Add scanner sources to %global_allowed_scanners and known-good external destinations to %global_allowed_domains. Raise the #net threshold for noisy environments. Review the distinct_ports and distinct_destinations outcome values to separate port cycling (suspicious) from a single busy service (benign)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 1024
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1008")
    $primary_entity = array_distinct($src_ip)
    $connection_count = count($net.metadata.id)
    $distinct_destinations = array_distinct($net.target.ip)
    $distinct_ports = array_distinct($net.target.port)

  condition:
    #net >= 20
}
