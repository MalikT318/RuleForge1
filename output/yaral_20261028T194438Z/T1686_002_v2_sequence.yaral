/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:30:04.428197+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Firewall_External_Mgmt_Access_Then_Policy_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-internal source IP connecting to a network device management service and then, within ten minutes, the same source IP making a firewall policy, ACL, rule, or zone configuration change on the device. This sequence is consistent with an adversary using valid accounts or an exploited management interface to weaken perimeter controls."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Requires firewall traffic logs normalised as NETWORK_CONNECTION, plus device configuration-audit logs normalised as SETTING_MODIFICATION. The admin source IP must be populated in principal.ip on both event types, and the configuration event description must be populated in metadata.description."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Remote administrators or MSP engineers working over VPN or from a public egress IP; authorised vendor support sessions; network automation or orchestration platforms that push policy from an external or cloud-hosted address; change-window work by approved network engineers."
    tuning_guidance = "Add approved admin and jump-host source addresses to %global_allowed_mgmt_sources. Add approved network engineers to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Adjust the management port list to match the services exposed in each client environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 4443 or
      $net.target.port = 8443 or
      $net.target.port = 10443
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.description = /(firewall|security[-_ ]?policy|access[-_ ]?list|access[-_ ]?rule|\bacl\b|\brule\b|\bzone\b|\bpolicy\b)/ nocase
    $cfg.metadata.description = /(add|creat|modif|chang|edit|delet|remov|disabl|permit|allow|\bany\b)/ nocase
    not $cfg.principal.ip in %global_allowed_mgmt_sources
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    $cfg.principal.ip = $src_ip

    $net.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $source_ips = array_distinct($src_ip)
    $mgmt_ports = array_distinct($net.target.port)
    $admin_users = array_distinct($cfg.principal.user.userid)
    $config_changes = array_distinct($cfg.metadata.description)
    $config_change_count = count($cfg.metadata.id)

  condition:
    $net and $cfg
}
