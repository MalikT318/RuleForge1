/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:14:12.586117+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Systemd_Unit_Written_Then_Systemctl_Start {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a new systemd service unit file written to a persistent or runtime unit directory, followed within 10 minutes by systemctl starting, enabling or restarting units on the same host. This pattern indicates abuse of systemctl to execute attacker-supplied commands as a service. Package-manager writers and approved admin tooling are excluded."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (FILE_CREATION with writer process populated) and process-launch telemetry (PROCESS_LAUNCH with command line) normalised to UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt) deploying units; software installers and package managers not matched by the built-in exclusion; container or runtime installers; administrators creating legitimate custom services; automated provisioning at first boot."
    tuning_guidance = "Add configuration management and deployment tooling to %global_allowed_admin_tools (matched on the writing process and on the parent of systemctl). Add automation accounts to %global_allowed_service_accounts. Extend the package-manager regex on the file-writer process if the estate uses other installers. Raise the risk score for hosts that are internet-facing servers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc\/systemd\/(system|user)|run\/systemd\/(system|transient)|usr\/lib\/systemd\/system|lib\/systemd\/system|home\/[^\/]+\/\.config\/systemd\/user)\/[^\/]+\.service$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|snapd|packagekitd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/systemctl$/ nocase
    $proc.target.process.command_line = /\b(start|restart|enable|reload-or-restart|try-restart)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity = array_distinct($hostname)
    $unit_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $writer_users = array_distinct($file.principal.user.userid)
    $systemctl_commands = array_distinct($proc.target.process.command_line)
    $systemctl_parents = array_distinct($proc.principal.process.file.full_path)

  condition:
    $file and $proc
}
