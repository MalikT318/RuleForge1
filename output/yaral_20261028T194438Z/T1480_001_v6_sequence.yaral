/*
  MITRE Technique : T1480.001 - Environmental Keying
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:26:10.702370+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Linux_Host_Identifier_Read_Then_Keyed_Decrypt {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux host reading environment-unique identifiers (machine-id, DMI UUID or serial) followed within ten minutes by a decryption utility writing to or reading from a world-writable staging path on the same host. This sequence is consistent with environmentally keyed payloads, where the decryption key is derived from host-specific values."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.001"
    mitre_technique_name = "Execution Guardrails: Environmental Keying"
    log_prerequisites = "Requires Linux EDR or auditd EXECVE telemetry normalised to UDM PROCESS_LAUNCH with populated command lines and parent process paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management or licensing agents that read machine-id or DMI data and then decrypt artefacts in /tmp, backup or restore jobs using gpg or openssl, software installers that unpack encrypted bundles, and inventory scripts."
    tuning_guidance = "Add approved inventory, licensing and deployment tooling to %global_allowed_admin_tools. Add backup and restore binaries to %global_allowed_backup_processes. Add trusted parent shells or script hosts to %global_allowed_script_hosts. If noise remains, narrow the staging-path regex to the directories used by your estate."

  events:
    $env.metadata.event_type = "PROCESS_LAUNCH"
    $env.target.process.command_line = /(\/etc\/machine-id|\/var\/lib\/dbus\/machine-id|\/sys\/class\/dmi\/id\/(product_uuid|product_serial|board_serial|chassis_serial)|dmidecode\s+(-s|--string)\s+(system|baseboard|chassis)-(uuid|serial-number))/ nocase
    not $env.principal.process.file.full_path in %global_allowed_admin_tools
    not $env.principal.process.file.full_path in %global_allowed_script_hosts
    $env.principal.hostname = $hostname

    $dec.metadata.event_type = "PROCESS_LAUNCH"
    $dec.target.process.file.full_path = /\/(openssl|gpg|gpg2)$/ nocase
    $dec.target.process.command_line = /(\benc\b.*\s-(d|decrypt)\b|--decrypt|\s-d\s.*\benc\b)/ nocase
    $dec.target.process.command_line = /(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/)/ nocase
    not $dec.principal.process.file.full_path in %global_allowed_backup_processes
    not $dec.principal.process.file.full_path in %global_allowed_admin_tools
    $dec.principal.hostname = $hostname

    $env.metadata.event_timestamp.seconds <= $dec.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1480.001")
    $primary_entity = array_distinct($env.principal.hostname)
    $env_commands = array_distinct($env.target.process.command_line)
    $decrypt_commands = array_distinct($dec.target.process.command_line)
    $users = array_distinct($dec.principal.user.userid)
    $event_count = count($dec.metadata.id)

  condition:
    $env and $dec
}
