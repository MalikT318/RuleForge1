/*
  MITRE Technique : T1484.002 - Trust Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:34:19.806149+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_002_Privileged_Group_Change_Then_Trust_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "The same actor adds a member to a highly privileged directory group and then modifies or creates a domain trust or federation setting within 10 minutes. This pattern suggests an adversary first gaining directory privileges and then changing trust configuration, for example to add a rogue signing certificate or federate a domain for token forgery."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.002"
    mitre_technique_name = "Domain or Tenant Policy Modification: Trust Modification"
    log_prerequisites = "Requires normalized directory audit telemetry: group membership changes (GROUP_MODIFICATION, e.g. Windows Security events 4728/4732/4756) and directory or federation setting changes (SETTING_MODIFICATION, e.g. events 4706/4707/4716/5136 or federation service audit). The actor must be populated in principal.user.userid and the changed object in target.resource.name."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Planned domain migrations or mergers, authorized federation onboarding, admin account provisioning during project work, and break-glass administrators performing emergency changes."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or migration accounts to %global_allowed_service_accounts. If trust changes are frequent in a client environment, narrow the privileged group regex or target.resource.name regex, or lengthen the privileged-group list exclusions."

  events:
    $grp.metadata.event_type = "GROUP_MODIFICATION"
    $grp.target.group.group_display_name = /(domain admins|enterprise admins|schema admins|administrators|account operators|global administrators?|privileged role administrators?|hybrid identity administrators?)/ nocase
    $grp.principal.user.userid != ""
    not $grp.principal.user.userid in %global_allowed_admin_users
    not $grp.principal.user.userid in %global_allowed_service_accounts
    $grp.principal.user.userid = $user

    $trust.metadata.event_type = "SETTING_MODIFICATION"
    $trust.target.resource.name = /(trust|federat|issuer|token.?signing|claim.?(rule|issuance)|relying.?party)/ nocase
    not $trust.principal.user.userid in %global_allowed_admin_users
    not $trust.principal.user.userid in %global_allowed_service_accounts
    $trust.principal.user.userid = $user

    $grp.metadata.event_timestamp.seconds <= $trust.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1484.002")
    $primary_entity = array_distinct($user)
    $privileged_groups = array_distinct($grp.target.group.group_display_name)
    $trust_objects = array_distinct($trust.target.resource.name)
    $source_hosts = array_distinct($trust.principal.hostname)
    $event_count = count($trust.metadata.id)

  condition:
    $grp and $trust
}
