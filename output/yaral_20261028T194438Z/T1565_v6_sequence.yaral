/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:38:03.196656+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Hosts_File_Unlock_Then_Modify {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a command that clears the read-only attribute or changes permissions or ownership on the Windows hosts file, followed within 10 minutes by a modification of that file on the same host. This pattern indicates deliberate manipulation of local name-resolution data to redirect traffic or hide activity."
    mitre_tactic = "Impact"
    mitre_technique = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites = "Requires endpoint process telemetry with command lines (EDR, Sysmon Event 1 or Windows Event 4688 with command-line auditing) and file modification telemetry (EDR or Sysmon Event 11/2)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators legitimately editing the hosts file for testing or migrations, endpoint management and VPN or ad-blocking software that writes host entries, and security agents that manage hosts-file entries."
    tuning_guidance = "Add approved management tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and named administrator accounts to %global_allowed_admin_users. Raise severity if the modifying process is a script interpreter or runs from a user-writable path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\\drivers\\etc\\hosts/ nocase
    $proc.target.process.command_line = /(attrib|icacls|cacls|takeown|isreadonly)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\drivers\\etc\\hosts$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity = array_distinct($hostname)
    $unlock_commands = array_distinct($proc.target.process.command_line)
    $unlock_users = array_distinct($proc.principal.user.userid)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $modified_files = array_distinct($file.target.file.full_path)

  condition:
    $proc and $file
}
