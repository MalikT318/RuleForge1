/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:35:20.223500+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_LSASS_Process_Handle_Open_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process requesting a handle to the LSASS process (PROCESS_OPEN) from a source that is not core Windows, an approved security tool, backup software or approved admin tooling. Handle acquisition to LSASS is the required step for in-memory credential dumping, and it fires regardless of command-line obfuscation, renamed tools, or in-memory-only tooling."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires EDR or Sysmon process-access telemetry (Sysmon Event ID 10 or equivalent) normalised to UDM PROCESS_OPEN with principal.process and target.process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Unlisted EDR/AV or DLP agents, backup and imaging software, performance and monitoring agents, crash-dump handlers, IT support tools that read process memory, and legitimate administrator troubleshooting with Task Manager or Sysinternals."
    tuning_guidance = "Add security agents to %global_allowed_security_tools, backup/imaging software to %global_allowed_backup_processes, and approved admin tooling to %global_allowed_admin_tools. Extend the executable-name regex only for core OS or vendor binaries seen in the client environment. If a client's telemetry source emits very high volumes of PROCESS_OPEN for LSASS from monitoring agents, allowlist those agents by executable name rather than by install path."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\lsass\.exe$/ nocase
    $open.principal.hostname != ""
    // Ignore LSASS acting on itself
    not $open.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    // Core OS processes that legitimately touch LSASS (anchored to System32 to prevent masquerading)
    not $open.principal.process.file.full_path = /^[a-z]:\\windows\\system32\\(csrss|wininit|winlogon|services|svchost|smss|lsm|wermgr|werfault)\.exe$/ nocase
    // Defender engine and sensor, matched by executable name (install path varies by version)
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCnC|NisSrv)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $source_user = array_distinct($open.principal.user.userid)
    $source_command_line = array_distinct($open.principal.process.command_line)

  condition:
    $open
}
