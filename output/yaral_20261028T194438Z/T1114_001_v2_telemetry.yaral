/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:17:50.366617+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Outlook_Data_File_Created_In_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an Outlook data file (.pst or .ost) in a user-writable staging location (Temp, Public, ProgramData, Downloads, Desktop, Recycle Bin) by a process other than Outlook. Copying or exporting mailbox data files to these locations is a common precursor to exfiltrating local email. The rule works at the file-artifact layer, so it does not depend on command-line logging."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT-led mailbox migrations or PST exports, eDiscovery and legal-hold collection tools, backup and imaging software, user-initiated Outlook archive exports handled by non-Outlook helper processes, profile migration utilities."
    tuning_guidance = "Add approved backup software to %global_allowed_backup_processes, migration and RMM tooling to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Add known export service accounts to %global_allowed_service_accounts. Extend the staging-directory regex if the client uses other known staging paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(pst|ost)$/ nocase
    $file.target.file.full_path = /\\(users\\public|programdata|windows\\temp|perflogs|\$recycle\.bin|users\\[^\\]+\\(appdata\\local\\temp|downloads|desktop))\\/ nocase
    not $file.principal.process.file.full_path = /\\(outlook|olk|searchindexer|searchprotocolhost|onedrive|msmpeng|sensecncproxy|senseir)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $data_file_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
