/*
  MITRE Technique : T1505.006 - vSphere Installation Bundles
  Tactic(s)       : Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:35:06.707569+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_006_ESXi_VIB_Tooling_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, interpreter or host package/management CLI (esxcli, localcli) launched by an unexpected parent on an ESXi host. Unexpected parents are network-facing management daemons (slpd, openwsman, sfcbd, rhttpproxy, snmpd) or binaries run from world-writable or datastore staging paths (/tmp, /var/tmp, /dev/shm, /scratch, /vmfs/volumes). This lineage is characteristic of an attacker who has exploited a management service or staged a payload and is now installing a persistent VIB. The rule keys on process lineage, not on command-line content."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.006"
    mitre_technique_name = "Server Software Component: vSphere Installation Bundles"
    log_prerequisites = "ESXi shell/process execution telemetry that populates both parent (principal.process) and child (target.process) executable paths, forwarded through syslog or an agent and parsed into UDM PROCESS_LAUNCH."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrator maintenance scripts staged under /tmp, /scratch or a datastore (patching, driver or firmware updates by hardware vendor tooling); lifecycle or patch-orchestration agents invoking esxcli from a non-standard parent; monitoring agents (SNMP/CIM-based) that legitimately run helper scripts; backup or automation frameworks that run scripts from a datastore."
    tuning_guidance = "Add approved automation parents (full path) to %global_allowed_admin_tools or %global_allowed_script_hosts. Add dedicated automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. If a datastore-hosted maintenance script is routine, allowlist its parent interpreter path rather than removing the /vmfs/volumes branch."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(esxcli|localcli|ash|sh|bash|busybox|python|python3|perl)$/ nocase
    (
      $proc.principal.process.file.full_path = /\/(slpd|openwsman|sfcbd|sfcb-[a-z]+|rhttpproxy|snmpd)$/ nocase or
      $proc.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch|vmfs\/volumes)\// nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
