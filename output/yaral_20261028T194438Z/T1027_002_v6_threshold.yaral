/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:41:03.942569+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Linux_Staged_Binary_Unpack_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A process running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) creates several files inside staging directories on the same host within ten minutes. This is the runtime footprint of a packed or self-extracting binary unpacking its stages to disk. Packing is detected by what the packed binary does after launch, so it does not depend on packer names, command lines or hashes. One file write is benign; the volume is the signal."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Linux EDR or auditd file-creation telemetry with the creating process path populated (principal.process.file.full_path) and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-extracting installers and vendor setup bundles run from /tmp, AppImage or snap-style runtimes unpacking to temp directories, CI/build agents and test runners executing from /tmp, language-runtime bootstrappers (e.g. compiled-script launchers extracting to /tmp), and software deployed by RMM tooling."
    tuning_guidance = "Add approved deployment, installer and build-agent binaries to %global_allowed_admin_tools, approved interpreter hosts or parents to %global_allowed_script_hosts, and CI/automation accounts to %global_allowed_service_accounts. Raise the #file threshold on build servers or developer workstations. Scale the threshold per client noise level."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($host)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
