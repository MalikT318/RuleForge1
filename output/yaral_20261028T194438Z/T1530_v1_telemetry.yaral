/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:02:15.916914+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_Office_Storage_Sharing_Setting_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a tenant-level or site-level configuration change that widens external or anonymous sharing of cloud document storage. Attackers with a compromised administrator account use these changes to expose or collect stored data without touching endpoints. The rule detects the configuration state change in the unified audit log, not a command line."
    mitre_tactic = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Microsoft 365 or Google Workspace unified audit logs ingested and normalised to UDM SETTING_MODIFICATION, with metadata.product_event_type populated by the admin and sharing audit workloads."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Planned collaboration or partner-onboarding projects that legitimately enable external sharing; IT administrators adjusting sharing policy during tenant migration or governance reviews; automated provisioning of new sites with default sharing settings."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and provisioning or automation identities to %global_allowed_service_accounts. If change-management windows are known, route matching alerts to the change-approval workflow. Narrow or extend the product_event_type regex to match the operation names present in the client's audit schema."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(sharing.*(polic|capabil|setting|domain)|(anonymous|external|guest).*(link|sharing|access)|SPOTenant|SiteCollectionAdmin)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1530")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_operation = array_distinct($setting.metadata.product_event_type)
    $changed_resource = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
