/*
  MITRE Technique : T1651 - Cloud Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:52:55.350060+00:00
  Reference       : https://attack.mitre.org/techniques/T1651
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1651_Cloud_Run_Command_Execution_On_Instance {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects use of cloud management run-command APIs that execute scripts or commands inside virtual machines through the installed VM agent (remote command send, VM run-command actions, automation runbook job creation). Adversaries with administrative cloud access abuse these APIs to execute code on instances without network access to the guest."
    mitre_tactic = "Execution"
    mitre_technique = "T1651"
    mitre_technique_name = "Cloud Administration Command"
    log_prerequisites = "Cloud control-plane audit logging enabled and ingested with management and write events, normalized to UDM with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Patch management and configuration-management automation, approved IT administrators running troubleshooting or inventory scripts, deployment pipelines, managed service provider operations using delegated access."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts, approved administrators to %global_allowed_admin_users, and approved cloud service principals to %global_allowed_cloud_principals. Consider raising severity when the caller is a first-seen identity or the source is outside expected management ranges."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(SendCommand|StartAutomationExecution)$|virtualMachines\/runCommands?\/(action|write)$|automationAccounts\/jobs\/write$|virtualMachineScaleSets\/virtualMachines\/runCommand\/action$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1651")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
