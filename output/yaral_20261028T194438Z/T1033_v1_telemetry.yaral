/*
  MITRE Technique : T1033 - System Owner/User Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:53:25.013548+00:00
  Reference       : https://attack.mitre.org/techniques/T1033
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1033_Linux_Session_Database_Raw_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a file read of Linux login-session databases (utmp, wtmp, btmp, lastlog) by an interpreter, a raw file reader, or a binary running from a user-writable location. Adversaries use these files to find the logged-in user, the usual users of a host, and recent logins. Detecting the file read does not depend on command-line logging, so it still fires when the process is renamed or the command is obfuscated."
    mitre_tactic = "Discovery"
    mitre_technique = "T1033"
    mitre_technique_name = "System Owner/User Discovery"
    log_prerequisites = "Requires Linux file-read telemetry from an EDR sensor or auditd watch rules on the session files (for example: -w /var/run/utmp -p r, -w /var/log/wtmp -p r, -w /var/log/btmp -p r, -w /var/log/lastlog -p r) forwarded to Chronicle with UDM FILE_READ normalisation."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or monitoring scripts written in Python, Perl or shell that parse login records; log-analysis and audit tooling; configuration management agents; compliance scanners; users checking logins with cat, strings or utmpdump."
    tuning_guidance = "Add approved monitoring, audit or inventory tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, backup software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. If auditd read watches are too noisy, restrict the audit rules to the btmp and lastlog files first."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/(var\/run\/utmp|run\/utmp|var\/log\/(wtmp|btmp|lastlog))(\.\d+)?$/ nocase
    $file.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm|home\/[^\/]+|root)\/)|(\/(python[0-9.]*|perl|ruby|php|node|cat|strings|utmpdump|xxd|od|hexdump|bash|sh|dash)$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1033")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessed_file = array_distinct($file.target.file.full_path)
    $reader_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
