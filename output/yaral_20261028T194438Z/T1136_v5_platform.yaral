/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:06:28.401434+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_Office_Suite_Tenant_User_Created_By_Non_Admin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new user account in a SaaS productivity suite tenant by an actor that is not a recognised administrator, service account or cloud principal. Adversaries with a compromised or delegated identity create secondary accounts to keep credentialed access without deploying tooling. The rule relies on the identity-lifecycle audit event, not on any account name, so it does not depend on attacker naming."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136"
    mitre_technique_name = "Create Account"
    log_prerequisites = "Requires unified tenant audit logs for the office/collaboration suite (user administration events) ingested and normalised to USER_CREATION with principal.user.userid (actor) and target.user.userid (created account) populated."
    platform = "Office Suite"
    log_source = "cloud_audit"
    false_positives = "HR-driven or identity-governance provisioning run through an unlisted account, helpdesk staff delegated user-admin rights who are not in the admin list, onboarding automation using a new service identity, directory synchronisation connectors, and tenant migration projects."
    tuning_guidance = "Populate %global_allowed_admin_users with named administrators and helpdesk operators, %global_allowed_service_accounts with provisioning and directory-sync identities, and %global_allowed_cloud_principals with approved identity-governance principals. During migrations or bulk onboarding, temporarily add the project identity to the relevant list rather than disabling the rule."

  events:
    $user.metadata.event_type = "USER_CREATION"
    $user.principal.user.userid != ""
    $user.target.user.userid != ""
    $user.principal.user.userid != $user.target.user.userid
    not $user.principal.user.userid in %global_allowed_admin_users
    not $user.principal.user.userid in %global_allowed_service_accounts
    not $user.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1136")
    $primary_entity = array_distinct($user.principal.user.userid)
    $created_account = array_distinct($user.target.user.userid)
    $source_ips = array_distinct($user.principal.ip)

  condition:
    $user
}
