/*
  MITRE Technique : T1057 - Process Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:52:53.851299+00:00
  Reference       : https://attack.mitre.org/techniques/T1057
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1057_ESXi_Anomalous_Parent_Process_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects ESXi process-enumeration utilities (ps, top, lsof, pgrep, esxcli system process) spawned by an unexpected parent: a network-facing management daemon, a scripting interpreter, or a binary running from a world-writable path (/tmp, /var/tmp, /dev/shm). Normal administrator activity descends from sshd and an interactive shell, so these lineages suggest a web-service or management-plane compromise, a dropped implant, or a script-driven discovery stage before ransomware deployment."
    mitre_tactic = "Discovery"
    mitre_technique = "T1057"
    mitre_technique_name = "Process Discovery"
    log_prerequisites = "ESXi shell and process execution telemetry that populates parent and child process paths, forwarded to Chronicle and normalised to PROCESS_LAUNCH."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup agents that run from /tmp during install or upgrade. Management daemons that legitimately shell out for health checks (for example monitoring integrations that call esxcli). Admin automation written in python or perl. Support bundle collection (vm-support) run via scripts."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools, %global_allowed_security_tools or %global_allowed_script_hosts. Add approved service-account automation hosts to %global_allowed_mgmt_sources. Extend the parent daemon list with hostd or vpxa only after baselining, since both spawn helper processes legitimately."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(ps|top|lsof|pgrep|esxcli)$/ nocase
    $proc.target.process.command_line = /((^|[\s\/])(ps|top|lsof|pgrep)(\s|$)|esxcli\s+system\s+process|\/proc\/[0-9*])/ nocase
    (
      $proc.principal.process.file.full_path = /\/(rhttpproxy|openwsmand|sfcbd|sfcb-[a-z]+|slpd|python[0-9.]*|perl|lua|php|wget|curl|nc|ncat)$/ nocase or
      $proc.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch\/tmp)\// nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1057")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
