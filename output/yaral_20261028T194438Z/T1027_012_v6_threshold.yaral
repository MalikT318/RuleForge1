/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:58:18.011523+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_Bulk_LNK_Drop_In_Staging_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects five or more .lnk shortcut files created on one host within 10 minutes in user-writable staging locations (Downloads, Temp, Outlook attachment cache, browser cache, Desktop). Mass delivery of shortcuts to these paths is consistent with phishing or script-driven LNK drops, where the IconEnvironmentDataBlock points at a remote URL or UNC path to smuggle a payload download. A single LNK creation is benign; the volume is the signal. This is file-creation based and does not overlap with process command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 equivalent) that populates target.file.full_path, principal.hostname and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Archive extraction of software bundles containing shortcuts, application installers or updaters staging in Temp, user profile migration tools, Office or Outlook opening several shortcut attachments, IT onboarding scripts that create desktop shortcuts, and RMM or software-deployment agents."
    tuning_guidance = "Add approved deployment, packaging and RMM binaries to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools. Raise the #file threshold for noisy build or VDI hosts. Lower it to 3 for high-risk user groups. Review the correlated list of .lnk paths and the writing process in the outcome fields."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(Downloads|AppData\\Local\\Temp|AppData\\Local\\Microsoft\\Windows\\INetCache|Content\.Outlook|Desktop|Temp)\\.*\.lnk$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TiWorker|TrustedInstaller|msiexec)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($file.target.file.full_path, `(?i)(Content\.Outlook|INetCache|Downloads)`), 70, 55))
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($host)
    $lnk_event_count = count($file.metadata.id)
    $lnk_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
