/*
  MITRE Technique : T1102.002 - Bidirectional Communication
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:57:09.598969+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_002_Interpreter_Repeated_WebService_Beaconing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Windows host shows a high volume of outbound HTTP(S) requests from script interpreters or LOLBin network clients to external web services within 10 minutes. Each request is benign on its own. Sustained, repeated, beacon-like volume from non-browser processes suggests bidirectional C2 over a legitimate web service (commands pulled and output posted back). POST requests raise the risk score."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.002"
    mitre_technique_name = "Web Service: Bidirectional Communication"
    log_prerequisites = "Requires EDR or network telemetry normalised to UDM NETWORK_HTTP events with principal process path, target hostname, target IP and HTTP method populated. TLS-inspecting proxy or EDR-level HTTP visibility is needed for HTTPS traffic."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "PowerShell-based management or monitoring scripts polling SaaS or cloud APIs, software deployment and patching tooling, certutil or bitsadmin downloads from update services, RMM agents, admin automation talking to vendor APIs."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools, known-good SaaS and update domains to %global_allowed_domains, and trusted automation hosts or parents to %global_allowed_script_hosts. Raise the #net threshold in high-noise environments. Lower it for high-value servers."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|certutil|bitsadmin)\.exe$/ nocase
    $net.principal.hostname = $host
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($net.network.http.method = "POST", 80, 60))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1102.002")
    $primary_entity = array_distinct($host)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $initiating_processes = array_distinct($net.principal.process.file.full_path)
    $users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 15
}
