/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:42:02.245521+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_ESXi_Login_Banner_Defacement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the ESXi host login banner, welcome message, or MOTD/issue text. This covers the esxcli welcome message command, advanced settings for Annotations/WelcomeMessage and Config/Etc/motd or issue, and shell redirection into /etc/motd or /etc/issue. Ransomware operators and intruders use these to display ransom notes or claim credit on the DCUI and SSH/console login screens."
    mitre_tactic = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "ESXi shell and hostd command auditing forwarded to Chronicle and parsed so executed commands populate target.process.command_line as PROCESS_LAUNCH events. Shell logging must be enabled on the host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators setting a legal or compliance login banner during host build or hardening. Configuration management or host profile remediation pushing a standard MOTD. Post-patch or post-upgrade scripts that rewrite the welcome message."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and approved automation or hardening tooling to %global_allowed_admin_tools. Run a baseline period during host builds to identify routine banner pushes. For stricter fidelity, restrict to hosts outside maintenance windows."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\s+system\s+welcomemsg\s+set|esxcli\s+system\s+settings\s+advanced\s+set\s.*(Annotations\/WelcomeMessage|Config\/Etc\/(motd|issue))|(>|>>|tee(\s+-a)?)\s*\/etc\/(motd|issue)(\s|$))/ nocase
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
