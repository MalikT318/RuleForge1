/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:35:29.712511+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_Startup_Shortcut_After_Payload_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process drops an executable or script into a user-writable location and then, within ten minutes, creates a .lnk shortcut in a Windows Startup folder. This sequence indicates shortcut-based boot or logon persistence for a freshly staged payload."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 equivalent) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that stage a binary in AppData or ProgramData and add a Startup shortcut (collaboration clients, VPN clients, sync tools); user-profile setup scripts; software deployment agents."
    tuning_guidance = "Add deployment, packaging and RMM tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. If a specific installer is noisy, add its process path to %global_allowed_admin_tools after verifying it is authorised."

  events:
    $drop.metadata.event_type = "FILE_CREATION"
    $drop.target.file.full_path = /(\\users\\[^\\]+\\appdata\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\).*\.(exe|dll|scr|bat|cmd|vbs|vbe|js|jse|wsf|hta|ps1)$/ nocase
    not $drop.target.file.full_path = /\\start menu\\programs\\startup\\/ nocase
    not $drop.principal.process.file.full_path in %global_allowed_admin_tools
    not $drop.principal.process.file.full_path in %global_allowed_security_tools
    $drop.principal.hostname = $hostname
    $drop.principal.process.file.full_path = $writer

    $lnk.metadata.event_type = "FILE_CREATION"
    $lnk.target.file.full_path = /\\microsoft\\windows\\start menu\\programs\\startup\\[^\\]+\.lnk$/ nocase
    not $lnk.principal.process.file.full_path in %global_allowed_admin_tools
    not $lnk.principal.process.file.full_path in %global_allowed_security_tools
    $lnk.principal.hostname = $hostname
    $lnk.principal.process.file.full_path = $writer

    $drop.metadata.event_timestamp.seconds <= $lnk.metadata.event_timestamp.seconds

  match:
    $hostname, $writer over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity = array_distinct($hostname)
    $writer_process = array_distinct($writer)
    $dropped_files = array_distinct($drop.target.file.full_path)
    $startup_shortcuts = array_distinct($lnk.target.file.full_path)
    $affected_users = array_distinct($lnk.principal.user.userid)

  condition:
    $drop and $lnk
}
