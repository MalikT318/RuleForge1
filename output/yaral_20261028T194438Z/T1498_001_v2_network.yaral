/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:10:18.515700+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Linux_Network_Oversized_UDP_ICMP_Flow_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single perimeter flow record in which an internal Linux host sends an abnormally large volume of stateless-protocol traffic (UDP or ICMP) to an external destination. This pattern is characteristic of an outbound direct network flood (botnet-style DoS) launched from a compromised host. Stateless protocols are the most common flood transport, and legitimate single flows of this size are rare outside bulk transfer, backup, and media use cases."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs normalised to UDM NETWORK_FLOW with network.ip_protocol, network.sent_bytes, principal.ip, target.ip and target.port populated. Flow records should be emitted on long-flow interval or flow-close. The log does not carry process information."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Large UDP-based transfers on non-standard ports (video conferencing, game servers, VoIP/media relays, WireGuard or other UDP VPN tunnels, UDP-based file acceleration), network performance testing (iperf), authorised stress or load tests, and monitoring systems sending large ICMP probe volumes."
    tuning_guidance = "Add sanctioned load-test, VPN, or media-relay source addresses to %global_allowed_mgmt_sources. Raise or lower the sent_bytes threshold (default 500 MB per flow record) to match the customer's baseline and the firewall's flow-logging interval. Add further known-good UDP service ports to the port exclusion. Pair with a Threshold variant for many-flow floods made up of small records."

  events:
    $flow.metadata.event_type = "NETWORK_FLOW"
    ($flow.network.ip_protocol = "UDP" or $flow.network.ip_protocol = "ICMP")
    $flow.network.sent_bytes > 524288000
    $flow.target.port != 53
    $flow.target.port != 123
    $flow.target.port != 443
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($flow.principal.ip)
    $destination_ips = array_distinct($flow.target.ip)
    $destination_ports = array_distinct($flow.target.port)
    $protocols = array_distinct($flow.network.ip_protocol)
    $max_sent_bytes = max($flow.network.sent_bytes)

  condition:
    $flow
}
