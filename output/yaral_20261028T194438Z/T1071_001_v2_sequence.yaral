/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:04:13.058998+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Linux_Dropped_Binary_Web_C2_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A file is created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) and the same file path then acts as the process image making an outbound web-port connection (80/443/8080/8443) to an external address within five minutes. This pattern is typical of a dropped implant beaconing over HTTP/S. It is not based on command-line matching."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Linux EDR or auditd telemetry providing FILE_CREATION events and NETWORK_CONNECTION events with the originating process image path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers, self-updating agents or package tooling that unpack and run a binary from /tmp, CI/CD build runners, developer test binaries, and AppImage-style applications that stage in /tmp or /var/tmp and then call out over HTTPS."
    tuning_guidance = "Add approved deployment and updater binaries to %global_allowed_admin_tools, add EDR and monitoring agents to %global_allowed_security_tools, and add build hosts to %global_allowed_script_hosts or exclude them by hostname via a customer-specific allowlist. Widen or narrow the staging directory regex to match the environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($hostname)
    $staged_path = array_distinct($path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $file and $net
}
