/*
  MITRE Technique : T1036.005 - Match Legitimate Resource Name or Location
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:05:30.785567+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_005_K8s_Masquerading_Workload_In_System_Namespace {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Kubernetes workload (pod, daemonset, deployment, cronjob, job, statefulset or replicaset) inside a protected system namespace (kube-system, kube-public, kube-node-lease) by a non-system identity, where the workload name imitates a cluster component such as kube-proxy, coredns, a CNI, metrics or a controller. This is the in-cluster masquerading pattern of hiding a backdoor or miner among trusted control-plane workloads. It uses control-plane audit telemetry, not process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.005"
    mitre_technique_name = "Masquerading: Match Legitimate Resource Name or Location"
    log_prerequisites = "Kubernetes API audit logs (or managed-cluster control-plane audit logs) ingested and normalised to RESOURCE_CREATION, with the full resource path (including namespaces/<ns>/<kind>/<name>) in target.resource.name and the requesting identity in principal.user.userid. Audit policy must record create verbs at Metadata level or higher."
    platform = "Linux"
    log_source = "container"
    false_positives = "Cluster administrators or GitOps/CD pipelines deploying legitimate add-ons (CNI plugins, CSI drivers, metrics-server, DNS caches, ingress or policy controllers) into kube-system; managed-Kubernetes upgrade operations run under human or federated identities; infrastructure-as-code runs that bootstrap new clusters."
    tuning_guidance = "Add GitOps and CD service accounts and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named cluster administrators to %global_allowed_admin_users. For managed clusters, add the provider's control-plane identities. Tighten or extend the component-name regex if the client uses different add-on naming conventions."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.target.resource.name = /namespaces\/kube-(system|public|node-lease)\/(pods|daemonsets|deployments|cronjobs|jobs|replicasets|statefulsets)\//  nocase
    $res.target.resource.name = /\/(pods|daemonsets|deployments|cronjobs|jobs|replicasets|statefulsets)\/[^\/]*(kube|k8s|coredns|etcd|proxy|dns|controller|scheduler|apiserver|metrics|calico|cilium|flannel|csi|cni|node-)[^\/]*$/ nocase
    $res.principal.user.userid != ""
    not $res.principal.user.userid = /^system:/ nocase
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_cloud_principals
    not $res.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.005")
    $primary_entity = array_distinct($res.principal.user.userid)
    $created_resource = array_distinct($res.target.resource.name)
    $source_ip = array_distinct($res.principal.ip)

  condition:
    $res
}
