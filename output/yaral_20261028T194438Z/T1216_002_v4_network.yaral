/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:36:39.176603+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_SyncAppvPublishingServer_Network_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external network connection made by a hidden-window PowerShell process whose parent is a Windows Script Host binary (wscript/cscript). This is the network footprint of SyncAppvPublishingServer.vbs proxying PowerShell, which launches PowerShell hidden from wscript. Internal destinations are excluded via reference list."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires endpoint network telemetry that records the originating process, its command line and its parent process (EDR network events or Sysmon Event ID 3 enriched with process lineage)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate login or logon scripts that run hidden PowerShell under wscript and reach external services; software deployment or inventory scripts wrapped in VBScript; real App-V publishing server syncs where the publishing server is hosted externally (cloud-hosted App-V); RMM tooling using the wscript-to-PowerShell pattern."
    tuning_guidance = "Add approved wrapper parents to %global_allowed_script_hosts and approved PowerShell-launching tools to %global_allowed_admin_tools. Add known-good vendor update destinations via %global_allowed_domains on the DNS-based variant of this rule. If the client hosts the App-V publishing server externally, exclude that PowerShell parent chain by host through %global_allowed_script_hosts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $net.principal.process.parent_process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    $net.principal.process.command_line = /(-w|-windowstyle)\s+hidden/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $ps_command_line = array_distinct($net.principal.process.command_line)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
