/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:41:55.275565+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Linux_Service_Parent_Spawns_Interpreter_Media_Decode {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service process (web server, application server, database, file or print service) spawning a shell or script interpreter whose command line handles an image or audio file together with decode or extract operations. This lineage is a strong indicator of a web shell or compromised service pulling a payload hidden in media (steganography). The primary pivot is the unexpected parent-to-child process relationship, not the command alone."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH, with principal.process.file.full_path (parent), target.process.file.full_path (child) and target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications that shell out for legitimate image processing or thumbnailing (for example a CMS plugin calling a script on uploaded media), database maintenance jobs, backup or media-conversion scripts launched by a service, and developers testing on application servers."
    tuning_guidance = "Add approved parent binaries or wrapper scripts to %global_allowed_script_hosts and approved administrative tooling to %global_allowed_admin_tools. If a specific application legitimately shells out for media handling, allowlist its parent path rather than loosening the child or command-line conditions. Add or remove service parent names in the parent regex to suit the client estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(^|\/)(apache2|httpd|nginx|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|java|mysqld|mariadbd|postgres|mongod|redis-server|smbd|cupsd)$/ nocase
    $proc.target.process.file.full_path = /(^|\/)(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|php[0-9.]*|ruby)$/ nocase
    $proc.target.process.command_line = /\.(png|jpe?g|gif|bmp|tiff?|webp|wav|mp3|mp4)\b/ nocase
    $proc.target.process.command_line = /(base64|xxd|\bdd\b|\btail\s+-c|\bhead\s+-c|\bstrings\b|\beval\b|\bexec\b|\|\s*(ba|da|z)?sh\b|getpixel|Image\.open|struct\.unpack|imagecreatefrom|exif_read_data)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
