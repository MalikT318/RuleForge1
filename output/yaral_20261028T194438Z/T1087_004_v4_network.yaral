/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:58:05.560663+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_Scripted_Directory_Account_Enumeration_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP GET requests to external cloud directory API endpoints that list users, role members, group members or service principals, made by a scripted or CLI HTTP client rather than a browser. This is the network-side footprint of cloud account discovery performed from PowerShell modules, CLIs, SDKs or custom scripts. It complements process command-line detections because it also covers hosts without endpoint telemetry, such as unmanaged devices, cloud shells and compromised workloads."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires web proxy, secure web gateway or TLS-inspecting firewall logs normalised to NETWORK_HTTP with target.url, network.http.method, network.http.user_agent and principal.user.userid populated. Without TLS inspection the URL path is not visible and the rule will not fire."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Identity governance and HR provisioning connectors, directory sync tooling, IT automation scripts, authorised access-review reports, SaaS-management and backup products that enumerate the directory, and admins running legitimate reporting scripts."
    tuning_guidance = "Add expected automation identities to %global_allowed_service_accounts, named admins to %global_allowed_admin_users, and approved integration principals to %global_allowed_cloud_principals. Keep %rfc1918_internal current so internal destinations stay excluded. If a client's proxy logs only hostnames, this rule will not fire for them; use the audit-log variants of this technique instead."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\/(v1\.0|beta)\/(users|directoryRoles(\/[^\/?]+\/members)?|groups\/[^\/?]+\/members|servicePrincipals|roleManagement\/directory\/roleAssignments)(\/?\?|\/?$)/ nocase
    $net.network.http.user_agent = /(powershell|python|curl|wget|go-http-client|okhttp|node-fetch|axios|java\/|libwww|azsdk|sdk|cli)/ nocase
    $net.principal.user.userid != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($net.principal.user.userid)
    $source_hosts = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
