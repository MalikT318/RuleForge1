/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:59:22.840690+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Linux_Encoded_Payload_Download_Over_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux command-line downloader or scripting runtime fetching a file with an encryption or encoding extension (.enc, .b64, .crypt, .aes, .gpg, .rc4, .xor and similar) over HTTP from an external destination. Adversaries stage encrypted or Base64-encoded payloads and configuration files this way so that static network and file inspection miss them, then decode them on the host at execution time (T1140). This is network-side coverage that complements endpoint command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires UDM NETWORK_HTTP events with target.url and principal.process.file.full_path populated (EDR network telemetry with process attribution, or a proxy or sensor enriched with process context). Reference lists %rfc1918_internal, %global_allowed_domains and %global_allowed_admin_tools must exist in the tenant."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package and repository key downloads (.gpg), vendor software or firmware distributed as encrypted archives, backup or configuration-management tooling that retrieves encrypted blobs, admins fetching GPG-encrypted artifacts from approved external storage, CI/CD jobs downloading encrypted secrets bundles."
    tuning_guidance = "Add known-good vendor, repository and CDN domains to %global_allowed_domains. Add approved deployment, configuration-management and backup binaries to %global_allowed_admin_tools. If a specific business process legitimately uses these extensions, scope the exclusion to the destination domain rather than broadening the extension list. Extend or trim the extension list in the target.url regex to fit client conventions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\/(curl|wget|fetch|aria2c|python[0-9.]*|perl|ruby|php[0-9.]*|nc|ncat)$/ nocase
    $net.target.url = /\.(enc|encrypted|b64|base64|crypt|crypted|aes|gpg|rc4|xor)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname != ""

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity = array_distinct($net.principal.hostname)
    $downloader_process = array_distinct($net.principal.process.file.full_path)
    $requested_url = array_distinct($net.target.url)
    $destination_ip = array_distinct($net.target.ip)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
