/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:59:12.395913+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_Linux_Trust_Material_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux command-line download utility or scripting runtime fetching certificate or key material (.crt, .cer, .pem, .der, .p12, .pfx) over HTTP from an external destination. Adversaries stage rogue root CA certificates or code-signing material this way before adding them to the system trust store (for example /usr/local/share/ca-certificates or /etc/pki/ca-trust) to subvert trust controls. This is the network-side view and complements endpoint file-write detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553"
    mitre_technique_name = "Subvert Trust Controls"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd) that produces NETWORK_HTTP events with the originating process path and the requested URL, or a proxy or network sensor feed correlated to the host process."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and provisioning tools fetching corporate CA bundles, container image builds and CI runners downloading CA certificates, admins manually installing a vendor or internal CA, and package or update scripts retrieving public certificate chains."
    tuning_guidance = "Add approved vendor and PKI distribution domains to %global_allowed_domains. Add approved provisioning and deployment binaries to %global_allowed_admin_tools. Add known build or automation hosts to %global_allowed_script_hosts. Raise severity if the same host also shows writes under the CA trust store paths."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|ruby|fetch)$/ nocase
    $net.target.url = /\.(crt|cer|pem|der|p12|pfx)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1553")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $requested_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
