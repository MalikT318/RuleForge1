/*
  MITRE Technique : T1546.010 - AppInit DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:13:30.419065+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_010_AppInit_DLLs_Modified_By_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the AppInit_DLLs, LoadAppInit_DLLs or RequireSignedAppInit_DLLs registry values by a process that should never configure them. Examples are Office applications, script interpreters and hosts, web server or application server processes, the print spooler, database services, and LOLBin proxies. This pivots on the lineage of the writing process rather than on a command line. It catches the registry change however it was made (reg.exe, PowerShell, API call from an injected or exploited process), which command-line rules miss."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.010"
    mitre_technique_name = "Event Triggered Execution: AppInit DLLs"
    log_prerequisites = "Requires Windows endpoint registry telemetry that populates the acting process path (EDR registry events or Sysmon Event ID 12/13), normalised to REGISTRY_MODIFICATION or REGISTRY_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers or legacy accessibility, graphics or input tools that register an AppInit DLL through a scripted installer (cmd or PowerShell). Hardening scripts that set LoadAppInit_DLLs to 0 via a script interpreter. Software deployment tooling running from an unusual parent."
    tuning_guidance = "Add approved deployment or hardening tooling paths to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. If hardening scripts are common, scope them out by adding the parent interpreter's host to %global_allowed_script_hosts or by requiring non-empty registry_value_data in this rule."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Windows NT\\CurrentVersion\\Windows\\(Load|RequireSigned)?AppInit_DLLs$/ nocase or
      (
        $reg.target.registry.registry_key = /\\Windows NT\\CurrentVersion\\Windows$/ nocase and
        $reg.target.registry.registry_value_name = /^(Load|RequireSigned)?AppInit_DLLs$/ nocase
      )
    )
    $reg.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|mshta|wscript|cscript|cmd|powershell|powershell_ise|pwsh|w3wp|httpd|nginx|tomcat[0-9]*|java|php-cgi|spoolsv|sqlservr|mysqld|wmiprvse|rundll32|regsvr32|msiexec)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)

  condition:
    $reg
}
