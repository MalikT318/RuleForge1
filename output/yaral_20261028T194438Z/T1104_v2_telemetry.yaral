/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:59:15.592335+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_Linux_Downloader_Drops_Stage_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network transfer utility (curl, wget, tftp, nc, ncat, socat) creating a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) where the file is hidden, extensionless, or has an executable or script extension. This is the file artifact left when a first-stage implant pulls down a second-stage payload, and it does not depend on command-line logging."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates the writing process path (principal.process.file.full_path) and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and bootstrap scripts that download installers to /tmp, package or agent installers fetched by curl or wget, CI/CD build agents, and admins manually downloading tools or scripts for troubleshooting."
    tuning_guidance = "Add approved deployment and bootstrap binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add EDR/AV update agents to %global_allowed_security_tools. If build servers are noisy, scope the rule by excluding those hosts via your SOAR or tenant-level rule exclusions."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(curl|wget|fetch|tftp|nc|ncat|netcat|socat)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(\.[^\/]+|[^\/.]+|[^\/]+\.(so|elf|bin|sh|py|pl|out))$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
