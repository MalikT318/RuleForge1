/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:10:14.482197+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_ESXi_Host_DNS_Resolver_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a modification of the DNS resolver configuration (name servers, search domains, DNS settings or resolv.conf) on an ESXi host, made by an account that is not an approved administrator or service account. Changing the host resolver is a precursor to DNS-based command and control, because it redirects the host's DNS traffic to an adversary-controlled resolver. This rule covers management-plane configuration telemetry (hostd and shell audit) and does not duplicate process command-line detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "ESXi hostd and shell audit logs forwarded via syslog and parsed into UDM SETTING_MODIFICATION events with the change description populated (metadata.description or target.resource.name)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned DNS server migrations, host provisioning or re-IP projects, host profile or desired-state remediation pushed from the central management server, and automated build pipelines applying baseline network settings."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or provisioning accounts to %global_allowed_service_accounts. Suppress during change windows using the host as a scoping key. Tighten or loosen the setting-name regex to match the verbosity of the client's hostd logging."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.metadata.description = /(dns\s*(server|servers|config|configuration|search|domain|suffix)|DnsConfig|nameserver|resolv\.conf)/ nocase or
      $setting.target.resource.name = /(dns\s*(server|servers|config|configuration|search|domain|suffix)|DnsConfig|nameserver|resolv\.conf)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)
    $change_detail = array_distinct($setting.metadata.description)

  condition:
    $setting
}
