/*
  MITRE Technique : T1614.001 - System Language Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:39:33.872227+00:00
  Reference       : https://attack.mitre.org/techniques/T1614/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_Linux_ServiceParent_Spawns_Language_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, database, or print service process spawning a shell, script interpreter, or locale utility whose command line queries the system language or keyboard layout (locale, localectl, /etc/default/locale, /etc/locale.conf, setxkbmap -query, $LANG/$LC_ALL). Service daemons have no legitimate need to profile host language, so this lineage anomaly is a strong indicator of a web shell or injected payload deciding whether to proceed based on the victim's geography."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614.001"
    mitre_technique_name = "System Location Discovery: System Language Discovery"
    log_prerequisites = "Linux endpoint process-launch telemetry with parent and child process paths and full command lines (EDR or auditd execve records)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Locale-aware web applications or CMS plugins that shell out to locale/localectl; PHP or Java apps that run locale -a during install or setup; database maintenance scripts or init wrappers that export LANG before starting; CUPS filters that inspect locale settings; configuration management run from an application service context."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. Exclude known automation accounts via %global_allowed_service_accounts. If a specific application legitimately runs locale checks on deployment, allowlist its parent path rather than loosening the command-line regex. To widen coverage, extend the parent regex with additional local service daemons."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|catalina|gunicorn|uwsgi|node|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|cups-browsed)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|ash|python[0-9.]*|perl|ruby|php[0-9.]*|locale|localectl|setxkbmap)$/ nocase
    $proc.target.process.command_line = /(\blocale\b|\blocalectl\b|\/etc\/(default\/locale|locale\.conf|locale\.gen|vconsole\.conf|sysconfig\/i18n)|setxkbmap\s+-query|\$\{?(LANG|LANGUAGE|LC_ALL)\b|\b(printenv|env)\b.*\b(LANG|LANGUAGE|LC_ALL)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1614.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $account = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
