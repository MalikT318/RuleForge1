/*
  MITRE Technique : T1207 - Rogue Domain Controller
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:15:37.998850+00:00
  Reference       : https://attack.mitre.org/techniques/T1207
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1207_Rogue_DC_Replication_Callback_From_Non_DC {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the network pattern of DCShadow. A host opens an LDAP connection to an internal directory server, and within ten minutes that same directory server opens an RPC endpoint-mapper connection (TCP 135) back to the initiating host. This reverse replication pull is what a rogue domain controller receives after registering itself, and ordinary member servers and workstations never receive it."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1207"
    mitre_technique_name = "Rogue Domain Controller"
    log_prerequisites = "Requires firewall or internal segmentation-gateway logs that record east-west connections between the client and server VLANs, with principal.ip, target.ip and target.port populated. Logs must cover traffic between workstation/server segments and the domain controller segment."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Newly promoted or rebuilt domain controllers before their IPs are allow-listed; AD replication partners and read-only DCs; AD health, monitoring and migration tooling that polls LDAP and RPC; Azure AD Connect or similar directory sync servers; vulnerability scanners probing LDAP and RPC."
    tuning_guidance = "Add legitimate domain controller and directory-sync server IPs to %global_allowed_mgmt_sources. Add authorised scanner source IPs to %global_allowed_scanners. If the firewall does not see east-west traffic between the client and DC segments, this rule will not fire, so confirm segment coverage before deploying."

  events:
    $ldap.metadata.event_type = "NETWORK_CONNECTION"
    ($ldap.target.port = 389 or $ldap.target.port = 3268)
    $ldap.principal.ip = $rogue_ip
    $ldap.target.ip = $dc_ip
    not $ldap.principal.ip in %global_allowed_mgmt_sources
    not $ldap.principal.ip in %global_allowed_scanners

    $repl.metadata.event_type = "NETWORK_CONNECTION"
    $repl.target.port = 135
    $repl.principal.ip = $dc_ip
    $repl.target.ip = $rogue_ip
    not $repl.target.ip in %global_allowed_mgmt_sources
    not $repl.target.ip in %global_allowed_scanners

    $rogue_ip != $dc_ip

    $ldap.metadata.event_timestamp.seconds <= $repl.metadata.event_timestamp.seconds

  match:
    $rogue_ip, $dc_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1207")
    $primary_entity = array_distinct($rogue_ip)
    $directory_servers = array_distinct($dc_ip)
    $ldap_ports = array_distinct($ldap.target.port)
    $ldap_connection_count = count($ldap.metadata.id)
    $callback_count = count($repl.metadata.id)

  condition:
    $ldap and $repl
}
