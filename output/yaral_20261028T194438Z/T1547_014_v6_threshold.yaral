/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:42:56.058674+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_Active_Setup_StubPath_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects multiple StubPath registry writes under the Active Setup Installed Components key on a single host within ten minutes. A single StubPath write is common during software installation, but a burst of writes by non-approved processes suggests persistence staging or mass component registration."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) normalised to REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters registering Active Setup components (browsers, Office, runtimes, VPN and endpoint agents), golden image build processes, software deployment tooling, and RMM agents."
    tuning_guidance = "Add approved installer, deployment and RMM process paths to %global_allowed_admin_tools, EDR/AV agent paths to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the threshold in the condition for environments with heavy software deployment."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Active Setup\\Installed Components\\/ nocase
    $reg.target.registry.registry_value_name = /^stubpath$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|msiexec)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $event_count = count($reg.metadata.id)
    $risk_score = max(
      if($event_count >= 10, 85,
        if($event_count >= 5, 70, 55)
      )
    )
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity = array_distinct($host)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
