/*
  MITRE Technique : T1219 - Remote Access Tools
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:05:11.805829+00:00
  Reference       : https://attack.mitre.org/techniques/T1219
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_Linux_Remote_Access_Persistence_Unit_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a systemd unit or desktop autostart entry whose filename indicates remote access, remote desktop, VNC/RDP, or tunnelling functionality, written by a process that is not a package manager. Remote access tools installed post-compromise typically register a service or autostart entry for persistent C2 access. This rule detects that persistence artifact through file telemetry rather than process command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219"
    mitre_technique_name = "Remote Access Tools"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (for example -w /etc/systemd/system -p wa) normalised to UDM FILE_CREATION with principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or configuration management hand-deploying approved remote support or VNC services; desktop environment remote-desktop features enabled by users; vendor installers that run scripts outside the package manager."
    tuning_guidance = "Add approved remote support tooling and deployment binaries to %global_allowed_remote_mgmt and %global_allowed_admin_tools. Add approved service accounts to %global_allowed_service_accounts. If configuration management creates these units in bulk, exclude its executable name."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/etc\/systemd\/system|\/usr\/lib\/systemd\/system|\/lib\/systemd\/system|\/etc\/systemd\/user|\/etc\/xdg\/autostart|\/root\/\.config\/systemd\/user|\/root\/\.config\/autostart|\/home\/[^\/]+\/\.config\/systemd\/user|\/home\/[^\/]+\/\.config\/autostart)\/[^\/]*(remote|vnc|rdp|tunnel|reverse|rmm|screenshare|screen-share|unattended)[^\/]*\.(service|desktop|timer)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|pacman|snapd|packagekitd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1219")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creator_process = array_distinct($file.principal.process.file.full_path)
    $creator_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
