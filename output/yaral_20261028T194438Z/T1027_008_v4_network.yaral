/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:50:55.453365+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Linux_Staging_Dir_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side proxy for stripped payloads on Linux. Stripping cannot be seen on the wire, so this detects the usual result: an extensionless binary running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) opens an outbound connection to a non-internal address. Stripped, compiled implants dropped by an adversary often beacon this way, and legitimate software rarely runs from these paths and talks to the internet."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd with socket/connect auditing) that populates principal.process.file.full_path on NETWORK_CONNECTION events. Reference lists %rfc1918_internal, %global_allowed_admin_tools, %global_allowed_security_tools and %global_allowed_script_hosts must exist."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-extracting installers or vendor updaters unpacking and running from /tmp, CI/CD build agents and test runners executing freshly compiled binaries, developer workstations running locally built programs, package-manager hooks, and containers that use /tmp as a working directory."
    tuning_guidance = "Add approved tooling paths to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and build servers or automation parents to %global_allowed_script_hosts. Keep %rfc1918_internal current for each client's internal ranges. For build-heavy hosts, scope the rule out by host via an exception or a client-specific copy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*\/)?[^\/.]+$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not re.regex($net.target.ip, `^(127\.|::1$)`)
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
