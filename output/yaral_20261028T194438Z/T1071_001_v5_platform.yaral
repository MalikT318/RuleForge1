/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:05:12.960326+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Windows_Script_Runtime_UA_To_IP_Literal_Web {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects web traffic seen at the network perimeter where the HTTP user agent is a native Windows scripting or HTTP runtime (PowerShell WebClient, WinHTTP, .NET default agents) and the destination is an external raw IP address URL rather than a named domain. Legitimate software normally talks to named, categorised services, so this pattern indicates web-protocol C2 or staging from a scripted Windows client. The rule uses only proxy and firewall HTTP telemetry, with no endpoint process fields, so it complements process command-line rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection (URL and user-agent populated) normalised to NETWORK_HTTP. TLS-inspection is needed to see user agents for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Admin or deployment scripts fetching from internal-style or cloud-hosted IP endpoints, software installers using WinHTTP against IP-addressed update servers, monitoring agents polling IP-addressed health endpoints, authorised vulnerability or pen-test activity."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains and hosts that legitimately run scripts to %global_allowed_script_hosts. Add scanner sources to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. If traffic volume is high, raise severity only when combined with repeated hits from the same host."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(WindowsPowerShell|PowerShell\/|WinHttp|WinINet|Microsoft WinRM|\.NET Framework|System\.Net\.Http)/ nocase
    $net.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d+)?(\/|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
