/*
  MITRE Technique : T1546.007 - Netsh Helper DLL
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:08:55.816874+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_007_Netsh_Helper_Registry_Write_Then_Netsh_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a registry write under the Netsh helper DLL key (HKLM\\SOFTWARE\\Microsoft\\Netsh) by a non-approved process, followed within 10 minutes by netsh.exe launching on the same host. The launch causes netsh to load the registered helper DLL, which triggers persistent code execution. Detection is based on the registry write and the process sequence, not on command-line content."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.007"
    mitre_technique_name = "Event Triggered Execution: Netsh Helper DLL"
    log_prerequisites = "Requires Windows endpoint telemetry that records registry modifications (for example Sysmon Event ID 12/13/14 or EDR registry events) and process launch events, both normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "VPN clients, network filtering or monitoring agents, and security or network-management software that register their own netsh helper during install or upgrade. Administrators legitimately adding a helper with 'netsh add helper'. Software deployment tools running installers."
    tuning_guidance = "Add approved installers and deployment tooling to %global_allowed_admin_tools and approved security agents to %global_allowed_security_tools. Review recurring hits by writer process and add the confirmed benign vendor tools to those lists. Raise severity where the registry writer is a scripting host or runs from a user-writable path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SOFTWARE\\Microsoft\\Netsh$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\netsh\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.007")
    $primary_entity = array_distinct($hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $netsh_parents = array_distinct($proc.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $proc
}
