/*
  MITRE Technique : T1505.003 - Web Shell
  Tactic(s)       : Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:30:17.471082+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_003_WebShell_External_POST_To_Script_In_Static_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external client successfully (HTTP 200) POSTing to a server-side script (ASP.NET, PHP, JSP) located in a directory normally holding static or uploaded content, such as uploads, images, assets or temp. Legitimate applications rarely accept POST requests to executable scripts in these paths. Web shell clients and dropped shells do. This is the network-side view of web shell use and does not depend on endpoint process telemetry."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.003"
    mitre_technique_name = "Server Software Component: Web Shell"
    log_prerequisites = "Requires firewall, WAF, reverse-proxy or web gateway logs normalised to UDM NETWORK_HTTP with network.http.method, target.url and network.http.response_code populated (TLS inspection or a proxy in front of the web server). Plain L3/L4 firewall logs without URL visibility will not trigger this rule."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "CMS or application upload handlers that legitimately accept POST requests in upload directories (for example editors, media managers, and SharePoint/IIS-hosted apps); authorised vulnerability scanners and penetration tests; legacy ASP/ASPX applications that keep handlers in asset folders."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add known application-specific upload endpoints or internal proxies to %global_allowed_mgmt_sources. If a client's application legitimately posts to scripts in these paths, narrow the directory list in the regex for that client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.network.http.response_code = 200
    $net.target.url = /\/(uploads?|images?|img|static|assets|media|files|tmp|temp|css|js|fonts|attachments|downloads)\/[^?#]*\.(aspx?|ashx|asmx|ascx|cshtml|php[0-9]?|phtml|jspx?)([?#].*)?$/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505.003")
    $primary_entity = array_distinct(strings.coalesce($net.target.hostname, $net.target.url))
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
