/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:41:52.791859+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// NOTE: NTDS.dit exists only on Windows domain controllers, so a Linux/macOS/cloud pivot is not possible for this technique.
// Following the mandatory Windows platform requirement, this rule gets its additive coverage from file-creation telemetry instead of process command lines.
rule MSSP_T1003_003_NTDS_Database_Copy_Created_Outside_Live_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an Active Directory database file (ntds.dit or a renamed variant such as an IFM or shadow-copy extract) anywhere other than the live NTDS directory. This catches the RESULT of NTDS theft (ntdsutil IFM, VSS copy, raw-disk copy, remote extraction) regardless of the tool or command line used."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the target file path and the creating process populated, from domain controllers and any servers or workstations where AD copies could be staged."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised AD backup or restore jobs, DC promotion (dcpromo / IFM media creation by AD admins), disaster-recovery test restores, AD health or migration tooling that stages database copies, and system-state backups writing to staging volumes."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes and approved AD admin or migration tooling to %global_allowed_admin_tools. If IFM media creation is routine, scope it by host or process rather than disabling the rule. Confirm that the live DC database path exclusion matches the client's SystemRoot layout."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\ntds[^\\]*\.dit$/ nocase
    not $file.target.file.full_path = /\\windows\\ntds\\ntds\.dit$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
