/*
  MITRE Technique : T1098.002 - Additional Email Delegate Permissions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:43:01.056466+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_002_Unexpected_Parent_Spawns_Shell_Mailbox_Permission {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched by an unexpected parent process (Office application, web server worker, print spooler or database service) whose command line grants mailbox, folder or recipient permissions or assigns Exchange management roles. This pattern suggests exploitation or macro-driven abuse to create a persistent mailbox delegate. The rule keys on process lineage combined with the mail-permission action, not on the command line alone."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.002"
    mitre_technique_name = "Account Manipulation: Additional Email Delegate Permissions"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Exchange servers where a web server worker (IIS) or management tooling legitimately runs mailbox administration; helpdesk Office add-ins or macros that automate delegate provisioning; database-driven onboarding jobs that call Exchange cmdlets via a shell; RMM or identity-governance tooling launched from an unusual parent."
    tuning_guidance = "Add approved parent process names or paths to %global_allowed_admin_tools. Add named administrator accounts that run provisioning to %global_allowed_admin_users. Add sanctioned automation hosts or parents to %global_allowed_script_hosts. On Exchange servers, consider scoping the rule to non-Exchange hosts if IIS-driven administration is expected."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|sqlagent)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(add|set)-(mailbox|mailboxfolder|recipient|adpermission)permission|new-managementroleassignment|-accessrights\s+(fullaccess|owner|editor|publishingeditor)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1098.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
