/*
  MITRE Technique : T1564.012 - File/Path Exclusions
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:31:11.110302+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_012_Linux_AV_Exclusion_Config_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of Linux endpoint AV/EDR scan-policy configuration files (/etc/clamav, /etc/clamd.d, /etc/clamd.conf, /etc/freshclam.conf, and managed policy JSON under /etc/opt/<vendor>/managed/) by a process that is not a package manager, configuration-management tool or approved security agent. Scan-policy files are where path and file exclusions live, so an unexpected write is the state change left behind when an adversary creates an exclusion to hide payloads. The rule works from the file-modification artifact, not the command line, so it still fires if command-line logging is evaded. File content is not available in UDM, so it alerts on the policy change itself rather than on the exclusion string."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.012"
    mitre_technique_name = "Hide Artifacts: File/Path Exclusions"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w on the scan-policy directories with -p wa) normalised to UDM FILE_MODIFICATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators legitimately tuning scan exclusions for databases, backup or container storage; configuration management (Ansible, Puppet, Chef, Salt) pushing policy; package upgrades rewriting default config; central-management agents syncing managed policy files."
    tuning_guidance = "Add approved config-management and deployment binaries to %global_allowed_admin_tools, endpoint agent binaries to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Named administrators who tune exclusions can go in %global_allowed_admin_users. Extend the path regex if the client uses other scanner config locations."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/((clamav|clamd\.d)\/[^\/]+\.conf|(clamd|freshclam)\.conf|opt\/[^\/]+\/managed\/[^\/]+\.json)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_config = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
