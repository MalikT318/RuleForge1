/*
  MITRE Technique : T1674 - Input Injection
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:18:13.493180+00:00
  Reference       : https://attack.mitre.org/techniques/T1674
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1674_Unexpected_Parent_Spawns_Scripted_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched by the interactive desktop shell or a web browser with inline-script indicators (hidden window, encoded command, download cradle). This lineage is typical of simulated keystrokes, such as a HID or BadUSB device driving the Win+R Run dialog, or tooling pasting script into a browser console or Run box. Legitimate users rarely start an interpreter from these parents with hidden or encoded inline payloads."
    mitre_tactic = "Execution"
    mitre_technique = "T1674"
    mitre_technique_name = "Input Injection"
    log_prerequisites = "Requires EDR or Sysmon process creation telemetry (or Windows Event 4688 with command-line auditing) populating parent process path, child process path and command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or power users running hidden or encoded PowerShell from the Run dialog, user logon scripts or helpdesk tools launched from the desktop shell, browser-based remote support or enterprise web apps that launch helper scripts, developer workflows."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Exclude named admin accounts via %global_allowed_admin_users. If browser parents are too noisy, narrow the parent regex to the desktop shell only."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(explorer|chrome|msedge|firefox|iexplore|brave|opera)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /([\-\/](w|win|windowstyle)\s+(hidden|h)\b)|([\-\/](e|ec|enc|encodedcommand)\s+[a-z0-9+\/=]{20,})|\b(iex|invoke-expression|downloadstring|downloadfile|invoke-webrequest|iwr|frombase64string|start-bitstransfer)\b|(mshta|wscript|cscript).*(https?:|javascript:|vbscript:)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1674")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
