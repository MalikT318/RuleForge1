/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:37:44.508569+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_Linux_Service_Parent_Spawns_Kerberos_Ticket_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, database, or print service process spawning a shell, script interpreter, or Kerberos utility whose command line touches Kerberos credential material (credential caches, keytabs, ticket listing or requesting utilities). These service processes should never interact with Kerberos tickets, so this lineage suggests webshell or injected-code activity attempting to steal or reuse tickets."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with parent process path, child process path and command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or application servers with built-in Kerberos/SPNEGO authentication that call kinit or klist from a wrapper script; database services using keytab-based authentication with maintenance scripts; Java-based services started with Kerberos keytab refresh jobs; administrators troubleshooting Kerberos from a service account shell."
    tuning_guidance = "Add legitimate parent service binaries or wrapper hosts to %global_allowed_script_hosts. Add approved service accounts that renew tickets to %global_allowed_service_accounts. If the java parent is noisy in environments with Kerberized application servers, scope exclusions via %global_allowed_script_hosts first rather than editing the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby|php[0-9.]*|klist|kinit|ktutil|kvno|kadmin|kadmin\.local)$/ nocase
    $proc.target.process.command_line = /(krb5cc_|\.ccache|\.keytab|\bkeytab\b|\bklist\b|\bkinit\b|\bktutil\b|\bkvno\b|\bkadmin(\.local)?\b|KRB5CCNAME|\/var\/lib\/sss\/secrets)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
