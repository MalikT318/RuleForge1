/*
  MITRE Technique : T1619 - Cloud Storage Object Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:42:30.788826+00:00
  Reference       : https://attack.mitre.org/techniques/T1619
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1619_Cloud_Storage_Object_Listing_By_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an identity enumerating the objects in a cloud storage bucket or container through the control-plane or data-plane audit API (object list, object-version list, blob list). Adversaries use this listing to find data to collect or exfiltrate after identifying storage resources. Known service accounts, approved cloud principals and named administrators are excluded."
    mitre_tactic = "Discovery"
    mitre_technique = "T1619"
    mitre_technique_name = "Cloud Storage Object Discovery"
    log_prerequisites = "Cloud provider audit logs with storage data-event or data-access logging enabled (object-level read/list events). These are often off by default and must be turned on per bucket, container or account. Events must normalise to USER_RESOURCE_ACCESS with metadata.product_event_type populated by the provider's API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and data-sync jobs run under user-assigned identities, data engineering and analytics pipelines, storage-browser use by administrators or developers, application start-up enumeration of buckets, cost and inventory tooling, and DLP or CSPM scanners not yet in the allowlists."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved workload or service principals to %global_allowed_cloud_principals, and administrators to %global_allowed_admin_users. Because listing is high-volume and routine, consider pairing this rule with a threshold or first-seen variant per principal and bucket in noisy tenants. Raise severity if the principal is newly created or the source is external to the tenant's normal egress."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(ListObjects|ListObjectsV2|ListObjectVersions|ListBlobs|List Blobs|storage\.objects\.list)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1619")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $target_storage = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
