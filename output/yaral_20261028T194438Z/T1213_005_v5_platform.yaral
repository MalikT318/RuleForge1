/*
  MITRE Technique : T1213.005 - Messaging Applications
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:29:33.884669+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_005_Chat_Message_Bulk_Retrieval_Audit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects collaboration-suite audit events showing chat or channel message content being retrieved, listed, read or exported through programmatic or compliance interfaces by an account that is not an approved service, admin or cloud principal. Adversaries with a compromised identity or consented application use these interfaces to mine chat history for credentials, source code, internal links and incident-response discussions."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.005"
    mitre_technique_name = "Data from Information Repositories: Messaging Applications"
    log_prerequisites = "Unified audit logging enabled for the collaboration workload (chat and channel audit events) and ingested into Chronicle with the operation name mapped to metadata.product_event_type. No endpoint telemetry required."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "eDiscovery and legal-hold exports run by compliance staff, archiving and retention connectors, DLP and CASB integrations, productivity or AI assistants reading chat content on behalf of users, and approved migration tooling."
    tuning_guidance = "Add compliance, archival and integration accounts to %global_allowed_service_accounts, named compliance officers to %global_allowed_admin_users, and approved application or service principals to %global_allowed_cloud_principals. If volume is still high, raise severity only for events from external or unfamiliar source addresses via SOAR enrichment."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(ChatRetrieved|MessagesListed|MessageHostedContentsListed|MessageHostedContentRead|MessagesExported)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1213.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
