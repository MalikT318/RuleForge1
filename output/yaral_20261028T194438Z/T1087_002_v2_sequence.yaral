/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:54:09.691654+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_Linux_Host_LDAP_Then_SAMR_Enumeration_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single internal source that opens an LDAP, LDAPS or Global Catalog connection to a host and then an SMB or RPC endpoint-mapper connection to the same host within 10 minutes. This network pattern matches domain account enumeration from a Linux system (for example ldapsearch followed by rpcclient/samr queries). It is based on perimeter connection telemetry, not process command lines. A firewall log has no OS or process context, so scope the rule to Linux server and workstation address space through tuning."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires firewall or network perimeter logs normalized to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Traffic between the source and the domain controller segment must traverse a logging inspection point."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Domain-joined Linux hosts using realmd/sssd/winbind (LDAP plus SMB/RPC to the same DC), file servers running Samba, identity management and SSO connectors, vulnerability scanners, and admin jump hosts performing directory maintenance."
    tuning_guidance = "Add approved admin, jump host and identity-sync source addresses to %global_allowed_mgmt_sources, and scanner sources to %global_allowed_scanners. Restrict the rule to Linux subnets or tagged assets in the client's environment. Shorten the match window or raise severity for server segments that should never query the directory."

  events:
    $ldap.metadata.event_type = "NETWORK_CONNECTION"
    (
      $ldap.target.port = 389 or
      $ldap.target.port = 636 or
      $ldap.target.port = 3268 or
      $ldap.target.port = 3269
    )
    $ldap.principal.ip in %rfc1918_internal
    not $ldap.principal.ip in %global_allowed_mgmt_sources
    not $ldap.principal.ip in %global_allowed_scanners
    $ldap.principal.ip = $src_ip
    $ldap.target.ip = $dc_ip

    $smb.metadata.event_type = "NETWORK_CONNECTION"
    (
      $smb.target.port = 445 or
      $smb.target.port = 135
    )
    $smb.principal.ip in %rfc1918_internal
    not $smb.principal.ip in %global_allowed_mgmt_sources
    not $smb.principal.ip in %global_allowed_scanners
    $smb.principal.ip = $src_ip
    $smb.target.ip = $dc_ip

    $ldap.metadata.event_timestamp.seconds <= $smb.metadata.event_timestamp.seconds

  match:
    $src_ip, $dc_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($src_ip)
    $directory_server = array_distinct($dc_ip)
    $ldap_ports = array_distinct($ldap.target.port)
    $smb_rpc_ports = array_distinct($smb.target.port)
    $ldap_connection_count = count($ldap.metadata.id)
    $smb_connection_count = count($smb.metadata.id)

  condition:
    $ldap and $smb
}
