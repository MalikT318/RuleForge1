/*
  MITRE Technique : T1560.003 - Archive via Custom Method
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:01:47.997898+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_003_Linux_Custom_Archive_Staged_By_NonArchiver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an archive-like or encrypted container file in a world-writable Linux staging directory (/tmp, /var/tmp, /dev/shm) by a process that is not a standard archive utility. The writer is either a scripting interpreter or a binary executing from a staging directory. This indicates a custom compression or encryption routine (e.g. XOR or stream cipher in a script or dropped binary) packaging collected data before exfiltration. File-creation telemetry is used instead of process command-line matching, so it complements existing command-line detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.003"
    mitre_technique_name = "Archive Collected Data: Archive via Custom Method"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry with the creating process path populated (principal.process.file.full_path) and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or log-rotation scripts written in Python/Perl that stage archives in /tmp; application installers and build or CI jobs that package artifacts in /tmp; developer tooling and package builders; database dump scripts; support-bundle generators."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes and approved scripting parents or automation hosts to %global_allowed_script_hosts. Add approved packaging tools to %global_allowed_admin_tools. Raise severity when the same host also shows outbound transfers shortly after."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(zip|7z|rar|tar|gz|tgz|bz2|xz|zst|lz4|lzma|enc|crypt|aes|pack)$/ nocase
    $file.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm)\/|\/(python[0-9.]*|perl[0-9.]*|ruby[0-9.]*|php[0-9.]*|node|nodejs|lua[0-9.]*)$)/ nocase
    not $file.principal.process.file.full_path = /\/(tar|gzip|pigz|bzip2|pbzip2|xz|zip|7z|7za|7zr|zstd|rar|cpio|lz4|zcat)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1560.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $archive_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
