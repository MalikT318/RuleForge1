/*
  MITRE Technique : T1614.001 - System Language Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:40:11.773860+00:00
  Reference       : https://attack.mitre.org/techniques/T1614/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_Linux_System_Language_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a shell or script interpreter on Linux launching a native utility to read system locale or keyboard layout configuration (/etc/default/locale, /etc/locale.conf, /etc/vconsole.conf, keyboard configuration) or to query the language and keyboard state (localectl, setxkbmap). Malware and operator scripts use these checks to infer the geographic location of a host and decide whether to proceed. The rule matches the combination of an interpreter parent, a reader or query utility and a locale-specific target, not a specific payload."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614.001"
    mitre_technique_name = "System Location Discovery: System Language Discovery"
    log_prerequisites = "Linux endpoint process-launch telemetry with full command line (EDR or auditd EXECVE records) normalised to UDM PROCESS_LAUNCH, with principal.process.file.full_path (parent) populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt) auditing locale settings; installer and first-boot scripts (cloud-init, package post-install hooks); administrators troubleshooting locale or keyboard issues; desktop session startup scripts calling setxkbmap; container entrypoint scripts that validate locale settings."
    tuning_guidance = "Add approved configuration-management and provisioning binaries to %global_allowed_admin_tools. Add trusted parent interpreters or script hosts to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Add EDR or compliance agents to %global_allowed_security_tools. Raise severity if the parent runs from /tmp, /var/tmp or /dev/shm, or if the host also shows other discovery activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|ash|python[0-9.]*|perl|ruby|php|node|lua)$/ nocase
    (
      (
        $proc.target.process.file.full_path = /\/(cat|head|tail|grep|egrep|fgrep|awk|gawk|sed|less|more|strings|cut|xxd|od)$/ nocase and
        $proc.target.process.command_line = /\/etc\/(default\/locale|locale\.conf|locale\.gen|vconsole\.conf|default\/keyboard|sysconfig\/i18n|sysconfig\/keyboard|X11\/xorg\.conf\.d\/[^\s]*keyboard[^\s]*)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/(localectl|setxkbmap)$/ nocase and
        $proc.target.process.command_line = /\b(status|show|list-locales|list-keymaps|-query|-print)\b/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1614.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
