/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:15:54.906649+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_JScript_File_Dropped_User_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a JavaScript/JScript-family script file (.js, .jse, .wsf, .hta) in a user-writable staging location (Downloads, Desktop, Temp, AppData, ProgramData, Windows Temp, browser/mail cache) by a download or delivery process (browser, mail client, Office application, archive tool, file manager, messaging client) or by a script host. This is the file artifact that precedes JScript/WSH/HTA execution and remains visible when command-line logging is evaded."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and the writing process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users saving or extracting legitimate .js files (web developers, IT staff), software installers or updaters unpacking JS into Temp, browser extensions and web caches, Node.js/npm tooling (partially excluded via node_modules), and legitimate HTA-based installers or login scripts."
    tuning_guidance = "Add approved deployment, RMM, or developer tooling to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Trusted script-hosting hosts and parent processes can be added to %global_allowed_script_hosts. Narrow the extension list or writer process list per customer if the noise level is high."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(js|jse|wsf|hta)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(downloads|desktop|appdata\\local\\temp|appdata\\roaming|appdata\\local\\microsoft\\windows\\inetcache)|programdata|windows\\temp)\\/ nocase
    $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|outlook|thunderbird|winword|excel|powerpnt|7z|7zg|7zfm|winrar|explorer|teams|slack|wscript|cscript|mshta)\.exe$/ nocase
    not $file.target.file.full_path = /\\node_modules\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
