/*
  MITRE Technique : T1546.001 - Change Default File Association
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:01:41.272967+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_001_File_Association_Handler_Mass_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several file-association handler command registry keys (shell\\<verb>\\command under the Classes hive) are written on one host within ten minutes. A single handler change is common during software installs. Repeated rewrites by one host suggest handler hijacking for persistence or privilege escalation."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.001"
    mitre_technique_name = "Event Triggered Execution: Change Default File Association"
    log_prerequisites = "Requires EDR or Sysmon-equivalent registry modification telemetry (Sysmon Event ID 12/13/14 or an equivalent EDR sensor) covering HKLM\\SOFTWARE\\Classes, HKCU\\Software\\Classes and HKCR."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters registering or re-registering file handlers (Office, PDF readers, browsers, archivers), default-app resets after OS feature updates, RMM and software deployment tooling, and profile-migration tools."
    tuning_guidance = "Add deployment, patching and RMM binaries to %global_allowed_admin_tools, EDR and AV agents to %global_allowed_security_tools, and packaging or automation accounts to %global_allowed_service_accounts. Raise the #reg threshold on hosts that regularly run installers. Severity scales in outcome: modification of shell\\open\\command scores higher."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(software\\classes|_classes|hkey_classes_root)\\[^\\]+\\shell\\[^\\]+\\command$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($reg.target.registry.registry_key, `(?i)\\shell\\open\\command$`), 80, 60))
    $mitre_technique_id = array_distinct("T1546.001")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
