/*
  MITRE Technique : T1564.007 - VBA Stomping
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:24:03.565263+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_007_Linux_Macro_Document_Modified_By_Runtime {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of an existing macro-enabled Office document, or of its embedded VBA project container (vbaProject.bin), in a staging or user-writable location by a scripting or managed runtime on Linux. VBA stomping overwrites the VBA source stream while leaving compiled p-code in place, so the file artifact is rewritten in place. Office is not native to Linux, so the in-place edit of a macro document by a runtime (mono, dotnet, python, perl, ruby, pwsh, node, java) is rare. It indicates a payload-builder or weaponisation step run on a compromised or attacker-operated host."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.007"
    mitre_technique_name = "Hide Artifacts: VBA Stomping"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that populates FILE_MODIFICATION events with target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Document-processing or conversion pipelines on mail or file gateways, build and CI jobs that generate or patch macro templates, legitimate python or java libraries that edit docm/xlsm files (openpyxl, Apache POI), and security-lab hosts doing authorised macro analysis."
    tuning_guidance = "Add approved document-processing runtimes or parent paths to %global_allowed_script_hosts, backup and imaging agents to %global_allowed_backup_processes, and approved automation tooling to %global_allowed_admin_tools. If a service account legitimately edits macro documents, narrow the staging-path regex or add its host to the exclusions."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\.(docm|dotm|xlsm|xlam|xltm|pptm|potm|ppam|sldm)$|(^|\/)vbaProject\.bin$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|home\/[^\/]+\/(Downloads|Documents|Desktop|\.cache)|root|srv|mnt|opt)\// nocase
    $file.principal.process.file.full_path = /(^|\/)(mono|dotnet|python[0-9.]*|perl|ruby|pwsh|node|java)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
