/*
  MITRE Technique : T1036.006 - Space after Filename
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:07:10.484146+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_006_Linux_Trailing_Space_File_Creation_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects several files created within ten minutes on one Linux host whose names end in a trailing space after a file extension (for example 'invoice.pdf '). Creating one such file can be accidental. A burst in user-writable locations suggests an adversary staging payloads that masquerade as benign document types, or a script that renames or drops files to evade extension-based handling (T1036.006). This rule uses file-creation telemetry and does not duplicate command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.006"
    mitre_technique_name = "Masquerading: Space after Filename"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (FILE_CREATION) with target.file.full_path populated and preserving trailing whitespace in file names."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Files synced from macOS or Windows clients that carry trailing-space names, browser or download managers saving files with sloppy names, archive extraction of third-party content, and backup or migration tooling restoring such files."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools and %global_allowed_backup_processes via the parent process path. Add automation accounts to %global_allowed_service_accounts. Raise the threshold (#file >= 3) on file-server or sync-heavy hosts. Narrow or widen the directory regex to match the client's user-writable locations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|root|home\/[^\/]+|var\/www|srv|mnt|media)\/.*[^\/ ]\.[A-Za-z0-9]{1,8} $/
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1036.006")
    $primary_entity = array_distinct($host)
    $affected_users = array_distinct($file.principal.user.userid)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 3
}
