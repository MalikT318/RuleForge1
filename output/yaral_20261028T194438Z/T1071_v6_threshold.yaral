/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:03:42.366369+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_Firewall_Repeated_External_Beaconing_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes a high volume of connections to the same external destination on common application-layer ports (web or DNS) within ten minutes. Each connection is benign, but the volume and persistence to one external endpoint are consistent with C2 beaconing blended into allowed application protocols."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Cloud-synced applications, SaaS and collaboration clients, software update agents, monitoring and health-check probes, video conferencing, and API polling by line-of-business applications."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains, and add authorised scanners or monitoring sources to %global_allowed_scanners. Raise the #net threshold in high-chatter environments. Lower it, or add jitter/size criteria, for sensitive segments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 53
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port = 80 or $net.target.port = 443, 55, 70))
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($net.target.port)
    $event_count = count($net.metadata.id)

  condition:
    #net >= 50
}
