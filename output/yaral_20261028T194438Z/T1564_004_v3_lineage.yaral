/*
  MITRE Technique : T1564.004 - NTFS File Attributes
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:19:23.955421+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_004_NTFS_ADS_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process launched by an unexpected parent (Office application, web server, print spooler or database service) that either executes from an NTFS Alternate Data Stream (child image path of the form file:stream) or is launched with a file:stream reference on its command line. Pivots on process lineage rather than on ADS command syntax alone, so it covers payloads hidden in or run from NTFS streams after exploitation or macro execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.004"
    mitre_technique_name = "Hide Artifacts: NTFS File Attributes"
    log_prerequisites = "Windows endpoint process-launch telemetry with parent and child image paths and command line (EDR or Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins that legitimately read or write alternate streams (for example Zone.Identifier or custom document metadata streams), web applications or database jobs that shell out to file utilities using stream syntax, backup or document management agents invoked by a database or web service, and Mark-of-the-Web removal scripts."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Extend or narrow the parent regex to match the client's web, print and database stack. Review the command_line outcome to confirm a real stream reference before escalating."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|spoolsv|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    (
      $proc.target.process.file.full_path = /^[a-z]:\\[^:]*:[^\\:]+$/ nocase or
      $proc.target.process.command_line = /[A-Za-z0-9_\-]+\.[A-Za-z0-9]{1,5}:[A-Za-z_][A-Za-z0-9_$.\-]*/ nocase
    )
    not $proc.target.process.command_line = /:Zone\.Identifier/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
