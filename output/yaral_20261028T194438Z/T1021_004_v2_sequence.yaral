/*
  MITRE Technique : T1021.004 - SSH
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:40:12.572372+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_004_ESXi_SSH_Enabled_Then_Remote_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects SSH service enablement on an ESXi host followed within ten minutes by a successful SSH login to the same host from a source outside the approved management addresses. This pattern is typical of an adversary who turns on SSH with valid accounts and then moves laterally onto the hypervisor."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.004"
    mitre_technique_name = "Remote Services: SSH"
    log_prerequisites = "Requires ESXi hostd, shell and auth logs forwarded and parsed to UDM. SETTING_MODIFICATION must carry the service or setting change text in metadata.description. USER_LOGIN must carry the sshd authentication message in metadata.description, with the source address in principal.ip."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned maintenance windows where an administrator enables SSH and logs in from a jump host or workstation not yet in the allowlist; vendor support sessions; backup or monitoring integrations that toggle SSH and then connect over it; automated host-remediation scripts."
    tuning_guidance = "Add jump hosts and admin workstation addresses to %global_allowed_mgmt_sources. Add named administrators to %global_allowed_admin_users, which suppresses events where the SSH change was made by them. Add automation or integration accounts to %global_allowed_service_accounts, which suppresses their SSH logins. If the client's parser stores the message in a different field, adjust the metadata.description conditions to match."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /(ssh|tsm-ssh|sshd)/ nocase
    $setting.metadata.description = /(enable|enabled|start|started|running|permit)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    $setting.principal.hostname = $hostname

    $auth.metadata.event_type = "USER_LOGIN"
    $auth.metadata.description = /sshd/ nocase
    $auth.metadata.description = /accepted\s+(password|publickey|keyboard-interactive)/ nocase
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts
    $auth.target.hostname = $hostname

    $setting.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.004")
    $primary_entity = array_distinct($hostname)
    $source_ips = array_distinct($auth.principal.ip)
    $logged_in_users = array_distinct($auth.target.user.userid)
    $setting_actors = array_distinct($setting.principal.user.userid)
    $login_count = count($auth.metadata.id)

  condition:
    $setting and $auth
}
