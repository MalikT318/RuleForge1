/*
  MITRE Technique : T1557 - Adversary-in-the-Middle
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:29:09.405275+00:00
  Reference       : https://attack.mitre.org/techniques/T1557
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_Outbound_Name_Resolution_Poisoning_Protocols_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects LLMNR (5355), NetBIOS Name Service (137) or mDNS (5353) traffic crossing the network perimeter to a non-internal, non-multicast destination. These local-segment name resolution protocols should never be routed externally. Their presence indicates a host being steered to resolve names through an adversary-controlled system (LLMNR/NBT-NS/mDNS poisoning, rogue gateway, or DNS/name-resolution redirection) or credential-bearing name lookups leaking off-net."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557"
    mitre_technique_name = "Adversary-in-the-Middle"
    log_prerequisites = "Firewall or perimeter flow/connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, with egress traffic logged including denied or dropped sessions where available."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Misconfigured remote-access VPN or split-tunnel clients leaking LLMNR/mDNS/NBNS to the tunnel gateway, cloud-bridged or stretched L2 segments, guest or BYOD Wi-Fi networks routed through the perimeter, authorised vulnerability scanners and network discovery tools, and consumer-grade devices (printers, media devices) on untrusted segments."
    tuning_guidance = "Add scanner or discovery source addresses to %global_allowed_scanners. Populate %rfc1918_internal with the tenant's internal address space as plain strings. If a VPN concentrator or stretched segment causes recurring hits, add its source address to %global_allowed_scanners after review. Raise severity if the source host also shows NTLM/SMB authentication to external addresses."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 5355 or
      $net.target.port = 137 or
      $net.target.port = 5353
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not net.ip_in_range_cidr($net.target.ip, "224.0.0.0/4")
    not net.ip_in_range_cidr($net.target.ip, "169.254.0.0/16")
    not net.ip_in_range_cidr($net.target.ip, "255.255.255.255/32")
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1557")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
