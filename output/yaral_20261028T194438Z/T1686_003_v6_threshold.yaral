/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:33:47.214732+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Policy_Registry_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of registry modifications under the Windows Firewall policy hierarchy (profile state, rules, settings) on a single host within 10 minutes. This catches firewall tampering through netsh, PowerShell cmdlets, direct registry edits or GUI changes, without relying on process command lines. A single change is normal, but a burst of changes indicates the firewall is being disabled or reconfigured in bulk."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Windows Host Firewall"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) covering HKLM\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy, normalised to UDM REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters that register multiple firewall rules, Group Policy refresh applying a firewall policy change, endpoint security or VPN agent installs, RMM or deployment tooling, and admins hardening a host."
    tuning_guidance = "Add approved deployment and patching binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Raise the threshold from 5 on estates with frequent software deployment. Note that netsh and PowerShell changes are written to the registry by the Windows Firewall service (svchost.exe), so do not allowlist svchost.exe. Scale the response on the EnableFirewall flag and event_count outcomes."

  events:
    $proc.metadata.event_type = "REGISTRY_MODIFICATION"
    $proc.target.registry.registry_key = /\\services\\sharedaccess\\parameters\\firewallpolicy\\/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.registry.registry_value_name = /^(EnableFirewall|DoNotAllowExceptions|DisableNotifications)$/ nocase, 85, 55))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($host)
    $registry_keys = array_distinct($proc.target.registry.registry_key)
    $value_names = array_distinct($proc.target.registry.registry_value_name)
    $modifying_processes = array_distinct($proc.principal.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 5
}
