/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:00:56.384534+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_PPID_Spoof_Handle_Open_Then_Shell_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process running from a user-writable location opens a handle to a commonly spoofed parent process (explorer, winlogon, services, wininit), and within 10 minutes that same parent PID appears as the parent of a suspicious interpreter launch. This sequence is characteristic of Parent PID Spoofing, where CreateProcess is called with a PROC_THREAD_ATTRIBUTE_PARENT_PROCESS attribute to hide the true lineage."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires EDR or Sysmon-equivalent telemetry with process handle-open events (PROCESS_OPEN, Sysmon EID 10) and process launch events including parent PID (PROCESS_LAUNCH, Sysmon EID 1 or Event 4688). Both event types must populate principal and target process PID and hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers or updaters run from Temp or ProgramData that open explorer.exe (shell extension registration, UI automation, accessibility tools); remote support and RMM agents injecting into the user session; developer debugging tools; management scripts that launch hidden PowerShell from explorer.exe."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools and RMM or deployment agents to %global_allowed_admin_tools. Add hosts or parent processes that legitimately run scripts to %global_allowed_script_hosts. If PROCESS_OPEN is too noisy in a given tenant, restrict the sensor to log only handle opens carrying the PROCESS_CREATE_PROCESS access right."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(explorer|winlogon|services|wininit)\.exe$/ nocase
    $open.principal.process.file.full_path = /\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\programdata\\|\\windows\\temp\\|\\temp\\/ nocase
    $open.principal.process.pid != $open.target.process.pid
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.target.process.pid = $ppid

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(explorer|winlogon|services|wininit)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|rundll32|regsvr32|mshta|wscript|cscript)\.exe$/ nocase
    $proc.target.process.command_line = /(-e(nc|ncodedcommand)?\s+[a-z0-9+\/=]{20,}|-w(indowstyle)?\s+hidden|-nop|downloadstring|invoke-expression|\biex\b|frombase64string|https?:\/\/|\\appdata\\|\\temp\\|\\programdata\\|scrobj|javascript:)/ nocase
    not $proc.principal.hostname in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname
    $proc.principal.process.pid = $ppid

    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $ppid over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity = array_distinct($hostname)
    $spoofing_process = array_distinct($open.principal.process.file.full_path)
    $spoofed_parent = array_distinct($open.target.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $open and $proc
}
