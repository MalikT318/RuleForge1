/*
  MITRE Technique : T1072 - Software Deployment Tools
  Tactic(s)       : Execution, Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:14:44.801386+00:00
  Reference       : https://attack.mitre.org/techniques/T1072
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1072_NetDev_External_Mgmt_Ingress_Then_Internal_Deployment_Fanout {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An internal host accepts an inbound management-plane connection from a non-internal source, then within ten minutes fans out to five or more targets on remote-execution and deployment ports (WinRM, SMB/RPC, SSH, Salt, Puppet). This network-observable pattern suggests an adversary has taken over a deployment or management server and is using it to push commands laterally."
    mitre_tactic = "Execution, Lateral Movement"
    mitre_technique = "T1072"
    mitre_technique_name = "Software Deployment Tools"
    log_prerequisites = "Firewall, proxy or perimeter connection logs that record source and destination IP and destination port for both inbound and internal east-west traffic. The firewall must see internal segment traffic (not only the perimeter), and %rfc1918_internal must be populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Admins connecting through a VPN or jump host whose address is not in the allowlist and then running patching or configuration pushes, managed-service-provider RMM sessions, CI/CD or orchestration servers reachable from the internet, vulnerability scanners run from a gateway host."
    tuning_guidance = "Add admin VPN, jump host and MSP source addresses to %global_allowed_mgmt_sources. Raise or lower the #net_out threshold per customer size. Add the port list to match the deployment tooling the customer uses. Exclude known scanner sources with %global_allowed_scanners."

  events:
    $net_in.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net_in.target.port = 22 or
      $net_in.target.port = 3389 or
      $net_in.target.port = 5986 or
      $net_in.target.port = 8443 or
      $net_in.target.port = 8530 or
      $net_in.target.port = 8531
    )
    not $net_in.principal.ip in %rfc1918_internal
    not $net_in.principal.ip in %global_allowed_mgmt_sources
    not $net_in.principal.ip in %global_allowed_scanners
    $net_in.target.ip = $pivot_ip

    $net_out.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net_out.target.port = 22 or
      $net_out.target.port = 135 or
      $net_out.target.port = 445 or
      $net_out.target.port = 5985 or
      $net_out.target.port = 5986 or
      $net_out.target.port = 4505 or
      $net_out.target.port = 4506 or
      $net_out.target.port = 8140
    )
    $net_out.principal.ip = $pivot_ip
    $net_out.target.ip != $net_out.principal.ip
    not $net_out.principal.ip in %global_allowed_mgmt_sources

    $net_in.metadata.event_timestamp.seconds <= $net_out.metadata.event_timestamp.seconds

  match:
    $pivot_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1072")
    $primary_entity = array_distinct($pivot_ip)
    $external_sources = array_distinct($net_in.principal.ip)
    $inbound_ports = array_distinct($net_in.target.port)
    $fanout_targets = count_distinct($net_out.target.ip)
    $fanout_ports = array_distinct($net_out.target.port)

  condition:
    $net_in and #net_out >= 5
}
