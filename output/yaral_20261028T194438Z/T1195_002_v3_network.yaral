/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:42:24.381219+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_Unencrypted_Software_Update_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a client downloading an executable or installer package (exe, msi, msp, msix, dll, cab) over unencrypted HTTP from an external destination, where the URL path looks like a software update or installer retrieval and the destination is not a known-good domain. Unprotected update channels are a common point for update-mechanism hijacking or compiled-release replacement in software supply chain compromise."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Supply Chain"
    log_prerequisites = "Requires perimeter proxy or firewall logs with URL-level visibility (normalised to NETWORK_HTTP) that populate target.url. Internal and known-good ranges are excluded via reference lists."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy line-of-business applications and hardware or driver updaters that still fetch installers over plain HTTP; OS or vendor update services not yet present in the known-good domain list; internal software mirrors addressed via public IPs; IT staff downloading installers manually."
    tuning_guidance = "Populate %global_allowed_domains with sanctioned vendor update and CDN domains. Confirm the proxy or firewall logs full URLs, otherwise the rule will not match. Extend the extension or keyword list per client if needed. Triage hits by checking whether the destination is a legitimate vendor, and review the downloaded file's signature on the endpoint."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /^http:\/\/[^\/]+\/[^?#]*(update|upgrade|patch|hotfix|setup|install|release)[^?#]*\.(exe|msi|msp|msix|dll|cab)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $download_urls = array_distinct($net.target.url)

  condition:
    $net
}
