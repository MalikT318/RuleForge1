/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:03:03.090125+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_SaaS_Storage_App_NonBrowser_External_Signin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an identity provider sign-in to a cloud file or object storage application from an external address using a non-browser, scripted or API client. Adversaries with stolen credentials or tokens commonly use programmatic clients to enumerate and bulk-download cloud-stored data (T1530) instead of the web interface. This rule provides identity-plane coverage and does not depend on endpoint process telemetry."
    mitre_tactic = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Requires identity provider sign-in audit logs normalised to UDM USER_LOGIN with target.application, principal.ip and network.http.user_agent populated. Non-interactive and service sign-in logs must be enabled and ingested."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Native desktop or mobile sync clients that do not send a browser-style user agent, approved backup or e-discovery connectors, DLP and CASB integrations, migration tooling, and legitimate automation using user-delegated tokens."
    tuning_guidance = "Add automation and integration identities to %global_allowed_service_accounts, approved app and service principals to %global_allowed_cloud_principals, and named admins to %global_allowed_admin_users. Extend the sync-client user-agent exclusion regex with client strings seen in the customer baseline. Narrow the application regex to the storage apps the customer actually licenses."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /(sharepoint|onedrive|drive|dropbox|\bbox\b|storage|blob|bucket|file|document)/ nocase
    $auth.network.http.user_agent != ""
    not $auth.network.http.user_agent = /(mozilla|chrome|safari|firefox|edge|opera)/ nocase
    not $auth.network.http.user_agent = /(sync|office|outlook|teams|mobile|cfnetwork)/ nocase
    $auth.principal.ip != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1530")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)
    $user_agents = array_distinct($auth.network.http.user_agent)

  condition:
    $auth
}
