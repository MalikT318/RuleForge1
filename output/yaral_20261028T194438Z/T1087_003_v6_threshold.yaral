/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:57:04.001713+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_Identity_Directory_Mass_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity performs a high volume of directory, address-list or mailbox listing operations within ten minutes. Each lookup is benign on its own, but bulk enumeration of email accounts and address lists indicates account discovery (for example, GAL harvesting with an authenticated session). This is identity-provider audit telemetry, not process command-line matching."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Requires identity provider or directory audit logs that record read, list and search operations against users, address lists, contacts or mailboxes, normalised to USER_RESOURCE_ACCESS with metadata.product_event_type populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Directory synchronisation connectors, HR or provisioning integrations, mail migration projects, helpdesk staff running bulk lookups, and compliance or eDiscovery tooling that enumerates mailboxes."
    tuning_guidance = "Add automation and sync accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #access threshold for tenants with heavy directory-integrated applications. Review metadata.product_event_type values in the tenant and narrow the regex if listing noise dominates."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(list|get|search|enumerate|query|read).*(user|addresslist|address_list|directory|mailbox|contact|recipient|people)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($access.metadata.id)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($access.principal.ip)
    $operations_seen = array_distinct($access.metadata.product_event_type)

  condition:
    #access >= 25
}
