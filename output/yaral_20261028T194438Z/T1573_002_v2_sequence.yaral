/*
  MITRE Technique : T1573.002 - Asymmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:24:50.327416+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_002_Linux_NonStandard_Port_TLS_NoSNI_Then_Beaconing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a likely asymmetric-crypto (TLS) C2 channel from a Linux host seen by an IPS or network security appliance. A TLS session with no SNI is opened to an external address on a non-standard port. Repeated small flows to the same destination and port then follow within 10 minutes, which looks like a beacon over a tunnel that normal web traffic does not use."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.002"
    mitre_technique_name = "Encrypted Channel: Asymmetric Cryptography"
    log_prerequisites = "Requires IPS/IDS or network security appliance logs that populate NETWORK_CONNECTION with TLS metadata (network.tls.version, network.tls.client.server_name) and NETWORK_FLOW with sent/received byte counts. Source addresses should be scoped to Linux server and workload subnets, or the rule should be deployed only to those sensors."
    platform = "Linux"
    log_source = "ips"
    false_positives = "Backup or replication agents using TLS on custom ports, database and message-queue TLS listeners (Kafka, MQTT, LDAPS variants) reached without SNI, monitoring agents polling external collectors, VPN or mesh tunnels run by IT, and vulnerability scanners."
    tuning_guidance = "Add approved scanners or known sources to %global_allowed_scanners. Add approved management sources to %global_allowed_mgmt_sources. Raise the #flow threshold or tighten the byte limit to reduce noise. Restrict the rule to Linux server subnets at ingestion or in a rule wrapper if the sensor also sees non-Linux traffic. Add further approved destination ports to the exclusions if the environment uses them."

  events:
    $tls.metadata.event_type = "NETWORK_CONNECTION"
    $tls.network.tls.version != ""
    $tls.network.tls.client.server_name = ""
    $tls.target.port != 443
    $tls.target.port != 8443
    $tls.target.port != 80
    $tls.target.port != 53
    not $tls.target.ip in %rfc1918_internal
    not $tls.principal.ip in %global_allowed_scanners
    not $tls.principal.ip in %global_allowed_mgmt_sources
    $tls.principal.ip = $src
    $tls.target.ip = $dst
    $tls.target.port = $port

    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.sent_bytes > 0
    $flow.network.sent_bytes < 2048
    $flow.network.received_bytes < 4096
    $flow.target.port != 443
    $flow.target.port != 80
    not $flow.target.ip in %rfc1918_internal
    $flow.principal.ip = $src
    $flow.target.ip = $dst
    $flow.target.port = $port

    $tls.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src, $dst, $port over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1573.002")
    $primary_entity = array_distinct($tls.principal.ip)
    $destination_ips = array_distinct($tls.target.ip)
    $destination_ports = array_distinct($tls.target.port)
    $beacon_flow_count = count($flow.metadata.id)
    $total_bytes_sent = sum($flow.network.sent_bytes)

  condition:
    $tls and #flow >= 3
}
