/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:31:36.539988+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_Admin_Credential_Reset_Then_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "One actor resets the credentials of another user's account and then changes that same account's permissions within 10 minutes. Together these remove the legitimate owner's access, as in SaaS account lockout or ransomware preparation."
    mitre_tactic = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "Requires identity provider directory audit logs normalised to UDM USER_CHANGE_PASSWORD and USER_CHANGE_PERMISSIONS, with principal.user.userid (actor) and target.user.userid (affected account) populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Help-desk staff resetting a password and adjusting roles during onboarding, offboarding or account recovery; identity governance automation; break-glass administrator activity during an incident."
    tuning_guidance = "Add help-desk and named administrator accounts to %global_allowed_admin_users. Add provisioning and automation identities to %global_allowed_service_accounts. Lengthen or shorten the window to fit the client's typical offboarding workflow."

  events:
    $pw.metadata.event_type = "USER_CHANGE_PASSWORD"
    $pw.principal.user.userid != ""
    $pw.target.user.userid != ""
    $pw.principal.user.userid != $pw.target.user.userid
    not $pw.principal.user.userid in %global_allowed_admin_users
    not $pw.principal.user.userid in %global_allowed_service_accounts
    $pw.principal.user.userid = $actor
    $pw.target.user.userid = $victim

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid != ""
    $perm.target.user.userid != ""
    $perm.principal.user.userid != $perm.target.user.userid
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    $perm.principal.user.userid = $actor
    $perm.target.user.userid = $victim

    $pw.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $actor, $victim over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity = array_distinct($actor)
    $affected_account = array_distinct($victim)
    $actor_source_ips = array_distinct($pw.principal.ip)
    $reset_count = count($pw.metadata.id)
    $permission_change_count = count($perm.metadata.id)

  condition:
    $pw and $perm
}
