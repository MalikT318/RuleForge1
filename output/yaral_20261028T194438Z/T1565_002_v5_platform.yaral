/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:42:00.305357+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_Linux_Netfilter_Traffic_Interception_Redirect {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects netfilter rules (iptables, ip6tables, nft) that divert forwarded or local traffic to a userspace interceptor or another destination, using NFQUEUE, TPROXY, REDIRECT or DNAT targets. These are the kernel mechanisms an adversary uses to place a man-in-the-middle process that can read and alter data in transit between systems. The rule keys on the combination of firewall binary and diversion target, not on any named tool."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Linux EDR or auditd EXECVE telemetry normalised to UDM PROCESS_LAUNCH with full command-line capture and parent process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Container runtimes and orchestrators (Docker, Podman, Kubernetes kube-proxy, CNI plugins) that program NAT/REDIRECT/DNAT rules; host firewall managers; libvirt/virtualisation NAT networking; load-balancer and VPN gateway provisioning; sysadmins configuring port forwarding or transparent proxies; legitimate IPS deployments using NFQUEUE."
    tuning_guidance = "Add approved provisioning or configuration-management binaries to %global_allowed_admin_tools, approved EDR/IPS agents that use NFQUEUE to %global_allowed_security_tools, and named admins to %global_allowed_admin_users. Container-host and firewall-manager parents are already excluded by executable name; extend the parent regex if the estate uses other orchestrators. On gateway or Kubernetes node hosts, consider scoping or lowering severity per client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(iptables|ip6tables|iptables-nft|ip6tables-nft|iptables-legacy|ip6tables-legacy|nft)$/ nocase
    (
      $proc.target.process.command_line = /(\s-j|\s--jump)\s+(nfqueue|tproxy|redirect|dnat)\b/ nocase or
      $proc.target.process.command_line = /\b(queue\s+(num|flags)|tproxy\s+(ip\s+)?to|redirect\s+to|dnat\s+(ip\s+)?to)\b/ nocase
    )
    not $proc.principal.process.file.full_path = /\/(dockerd|containerd|containerd-shim|runc|crun|podman|netavark|conmon|kubelet|kube-proxy|firewalld|ufw|libvirtd|cilium-agent|calico-node|flanneld|nm-dispatcher|NetworkManager)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $firewall_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
