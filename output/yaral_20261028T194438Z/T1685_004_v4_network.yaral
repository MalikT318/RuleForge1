/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:22:16.127913+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Audit_Daemon_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux audit daemon, dispatcher, remote-forwarding plugin or control utility opening a network connection to a non-internal address. Legitimate audit log forwarding (audisp-remote) normally targets an internal log collector. An external destination suggests audit forwarding was redirected by editing audisp-remote.conf or the audit plugin configuration, or that a trojanised or masquerading audit binary is beaconing. This is the network-side view of modifying the Linux Audit system to divert or subvert its logs."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Linux EDR or auditd-enriched telemetry that records outbound socket connections with the initiating process path (NETWORK_CONNECTION with principal.process.file.full_path populated)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Audit log forwarding to a cloud-hosted SIEM or managed log collector with a public IP; centralised audit aggregation across sites via public addresses; security agents that spawn from or wrap audit binaries."
    tuning_guidance = "Add approved external log collector addresses to %global_allowed_mgmt_sources, and sanctioned forwarding or agent binaries to %global_allowed_security_tools. Confirm internal address space is complete in %rfc1918_internal. Review audisp-remote.conf (remote_server) and /etc/audit/plugins.d/ on any alerting host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(auditd|audispd|audisp-remote|audisp-[a-z0-9_-]+|auditctl|augenrules)$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $audit_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
