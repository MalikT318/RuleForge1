/*
  MITRE Technique : T1132.002 - Non-Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:47:19.553272+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_002_Linux_Proxy_NonStandard_Encoded_HTTP_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests to external destinations from command-line style HTTP clients (the user-agent families typical of Linux scripting and implants) where the URL carries a long, unbroken blob of base64-style characters. Mixed standard and URL-safe alphabets, stripped padding and percent-encoded '+' are typical of custom or modified Base64 used to hide C2 data. This is network-side coverage seen at the proxy or firewall, and does not depend on endpoint command-line telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.002"
    mitre_technique_name = "Data Encoding: Non-Standard Encoding"
    log_prerequisites = "Requires proxy or firewall HTTP logging that populates target.url, network.http.user_agent and target.ip (for example a forward proxy or a TLS-inspecting perimeter device). Encrypted traffic without inspection will not expose the URL."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Package managers and software updaters using long signed or tokenised URLs; cloud storage pre-signed URLs; OAuth/SSO callback and JWT-in-URL flows; telemetry and licensing agents; CI/CD runners fetching artifacts; monitoring agents that beacon with encoded identifiers."
    tuning_guidance = "Add known-good vendor, update and storage domains to %global_allowed_domains. Add authorised scanner source addresses to %global_allowed_scanners. Raise or lower the blob length in the URL regex ({80,}) to suit client traffic. If a client's long tokenised URLs are legitimate, narrow the user-agent regex or exclude the destination domain."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl|okhttp|java)\b/ nocase
    $http.target.url = /[?&=\/][A-Za-z0-9+_%-]{80,}/
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1132.002")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
