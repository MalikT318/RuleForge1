/*
  MITRE Technique : T1098.002 - Additional Email Delegate Permissions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:42:22.349715+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_002_Exchange_Online_Mgmt_Session_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the file artifact created when PowerShell opens an Exchange Online management session: a dynamically generated temporary module folder containing .psm1, .psd1 or .ps1xml files. This session is the prerequisite for Add-MailboxPermission and Add-MailboxFolderPermission, which grant delegate or folder access for persistence (T1098.002). The rule works at the file-artifact layer, so it still fires when command-line logging is evaded or the command line is obfuscated. It detects the management session, not the permission change itself, so treat it as a hunting-grade or triage signal and pair it with cloud audit-log detections for the actual permission change."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.002"
    mitre_technique_name = "Account Manipulation: Additional Email Delegate Permissions"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the creating process path and user populated, covering user temp directories."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Exchange or Microsoft 365 administrators, helpdesk staff, and automation or runbook hosts connecting to Exchange Online from PowerShell. Migration and compliance tooling that uses the Exchange Online management module."
    tuning_guidance = "Add named Exchange and M365 administrators to %global_allowed_admin_users. Add jump hosts and automation servers to %global_allowed_script_hosts. Add approved management tooling executables to %global_allowed_admin_tools. Expect high volume on administrator workstations until these lists are populated. Consider raising severity when the host is a non-administrative workstation or a server that does not normally manage Exchange."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $file.target.file.full_path = /\\tmpEXO_[^\\]+\\[^\\]+\.(psm1|psd1|ps1xml)$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1098.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $acting_user = array_distinct($file.principal.user.userid)
    $artifact_paths = array_distinct($file.target.file.full_path)

  condition:
    $file
}
