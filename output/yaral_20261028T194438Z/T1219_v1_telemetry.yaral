/*
  MITRE Technique : T1219 - Remote Access Tools
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:03:53.354826+00:00
  Reference       : https://attack.mitre.org/techniques/T1219
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_Linux_Remote_Access_Persistence_Unit_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a systemd unit or desktop autostart entry whose file name indicates a remote access, remote support or tunnelling agent, written by a process that is not a package manager or an approved management tool. Remote access tools commonly persist through these artifacts after installation. The rule pivots on the resulting file artifact rather than command-line arguments, so it still fires if process command-line logging is evaded."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219"
    mitre_technique_name = "Remote Access Tools"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules on systemd unit directories (/etc/systemd, /usr/lib/systemd, /lib/systemd, /run/systemd), user ~/.config/systemd/user and autostart directories (~/.config/autostart, /etc/xdg/autostart), normalised to UDM FILE_CREATION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Sanctioned RMM or helpdesk agents installed by unlisted deployment scripts, configuration management (Ansible, Puppet, Chef, Salt) pushing remote-support or VNC services, administrators enabling xrdp or VNC servers on lab or VDI hosts, and VPN or tunnel clients with 'tunnel' or 'relay' in the unit name."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_remote_mgmt and %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Extend the package-manager and configuration-management process exclusion regex to match the client's tooling. Narrow or extend the file-name keyword group to suit the client's environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc|usr\/lib|lib|run)\/systemd\/(system|user)\/[^\/]+\.(service|socket|timer)$|\/\.config\/(systemd\/user|autostart)\/[^\/]+\.(service|socket|timer|desktop)$|^\/etc\/xdg\/autostart\/[^\/]+\.desktop$/ nocase
    $file.target.file.full_path = /\/[^\/]*(remote|vnc|rdp|rmm|screenshare|screen-share|tunnel|relay|helpdesk|support-agent)[^\/]*\.(service|socket|timer|desktop)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|pacman|snapd|packagekitd|unattended-upgrade|ansible-playbook|puppet|chef-client|salt-minion)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1219")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
