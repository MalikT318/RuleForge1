/*
  MITRE Technique : T1614.001 - System Language Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:40:44.640955+00:00
  Reference       : https://attack.mitre.org/techniques/T1614/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_Linux_Rapid_System_Language_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated system language, locale and keyboard layout queries on a single Linux host within ten minutes. One locale query is routine. Several different probes in a short window (locale, localectl, keyboard layout queries, reads of locale config files, LANG/LC_ALL environment lookups) suggest malware or an operator checking the system language to decide whether to proceed."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614.001"
    mitre_technique_name = "System Location Discovery: System Language Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records with full command lines, normalized to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents and provisioning scripts, locale-aware installers and package post-install scripts, login shells and profile scripts that call locale, admins troubleshooting locale or keyboard issues, container image builds, and monitoring or inventory agents."
    tuning_guidance = "Add inventory, provisioning and configuration management binaries to %global_allowed_admin_tools. Add approved parent shells or automation hosts to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for noisy build servers or lower it for high-value hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /(^|[\s\/])(locale|localectl|setxkbmap|kbd_mode|loadkeys|dumpkeys|showkey)(\s|$)/ nocase or
      $proc.target.process.command_line = /\b(cat|less|more|head|tail|grep|egrep|awk|sed|strings|xxd|od)\b.*\/etc\/(locale\.conf|default\/locale|vconsole\.conf|locale\.gen|sysconfig\/i18n|sysconfig\/keyboard|default\/keyboard|X11\/xorg\.conf\.d\/00-keyboard\.conf)/ nocase or
      $proc.target.process.command_line = /\b(echo|printenv|env|set)\b.*\b(LANG|LANGUAGE|LC_ALL|LC_CTYPE|LC_MESSAGES)\b/ nocase
    )
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(45)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1614.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 4
}
