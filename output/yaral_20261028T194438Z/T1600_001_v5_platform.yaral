/*
  MITRE Technique : T1600.001 - Reduce Key Space
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:07:22.045837+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_001_Weak_TLS_Cipher_Negotiated {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects external network sessions that negotiated export-grade, NULL, anonymous, single-DES or RC2/RC4 TLS cipher suites, or a deprecated SSL 2.0/3.0 protocol version. This is the network-observable result of an adversary reducing key size or cipher strength on a network device (T1600.001). The rule does not match on specific payloads or tools."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.001"
    mitre_technique_name = "Weaken Encryption: Reduce Key Space"
    log_prerequisites = "Firewall, proxy or TLS-inspection logs that populate network.tls.cipher and network.tls.version on NETWORK_CONNECTION events. Without TLS metadata in the logs the rule cannot fire."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy servers, appliances, or embedded/IoT devices that only support old ciphers; vendor or partner endpoints with outdated TLS stacks; authorised vulnerability or crypto-compliance scanners; lab or test traffic."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add known-good external domains with legacy TLS to %global_allowed_domains. Review the source and destination of each hit. A weak suite seen across many unrelated sessions through one device suggests the device was weakened, whereas a single legacy peer suggests a legacy endpoint. Raise severity if hits cluster on a single firewall or VPN gateway."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.network.tls.cipher = /(export|rc2|rc4|null|anon|(^|[_-])des[_-]cbc([_-]|$)|_40_|_56_)/ nocase or
      $net.network.tls.version = /^ssl[v_ ]*[23]/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1600.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $tls_cipher = array_distinct($net.network.tls.cipher)
    $tls_version = array_distinct($net.network.tls.version)

  condition:
    $net
}
