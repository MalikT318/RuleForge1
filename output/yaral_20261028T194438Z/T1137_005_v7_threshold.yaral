/*
  MITRE Technique : T1137.005 - Outlook Rules
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:21:55.466044+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_005_Mailbox_Rule_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of mailbox inbox-rule create, set or update operations by a single user within ten minutes. A single rule change is routine; several in a short window match attacker persistence or exfiltration tradecraft, such as rules that forward, delete or hide mail, or rules planted for later triggering."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.005"
    mitre_technique_name = "Office Application Startup: Outlook Rules"
    log_prerequisites = "Requires unified audit logs with Exchange mailbox audit events (inbox rule create, set and update operations) ingested and normalised to SETTING_MODIFICATION, with the operation name in metadata.product_event_type and the actor in principal.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users setting up several mail-organisation rules at once, mailbox migrations, onboarding scripts, shared-mailbox administrators, mail-client sync that rewrites rules, helpdesk bulk rule changes."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or migration accounts to %global_allowed_service_accounts. Raise the #rule threshold for tenants with heavy rule use, or lower it for high-risk users. Pivot on $source_ips and compare against the user's usual sign-in locations."

  events:
    $rule.metadata.event_type = "SETTING_MODIFICATION"
    $rule.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules|Enable-InboxRule)$/ nocase
    $rule.principal.user.userid = $user
    not $rule.principal.user.userid in %global_allowed_admin_users
    not $rule.principal.user.userid in %global_allowed_service_accounts

  match:
    $user over 10m

  outcome:
    $event_count = count($rule.metadata.id)
    $risk_score = if($event_count >= 10, 85, if($event_count >= 5, 70, 55))
    $mitre_technique_id = array_distinct("T1137.005")
    $primary_entity = array_distinct($user)
    $operations = array_distinct($rule.metadata.product_event_type)
    $source_ips = array_distinct($rule.principal.ip)

  condition:
    #rule >= 3
}
