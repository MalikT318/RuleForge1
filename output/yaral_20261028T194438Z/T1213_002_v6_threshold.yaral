/*
  MITRE Technique : T1213.002 - Sharepoint
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:25:49.110916+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_002_SharePoint_Bulk_Content_Access_By_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user account generated a high volume of SharePoint resource-access events within ten minutes. Individual file or page access is normal. Bulk access in a short window is consistent with an adversary using a compromised account to mine SharePoint for network diagrams, documentation, credentials and source code."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.002"
    mitre_technique_name = "Data from Information Repositories: Sharepoint"
    log_prerequisites = "Requires identity and collaboration audit logs in which SharePoint file, page and site access operations are normalised to USER_RESOURCE_ACCESS with principal.user.userid and target.url or target.application populated. No endpoint telemetry is needed."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Users doing legitimate bulk work such as library syncs, site migrations, reorganisations or large document reviews. Search crawlers, eDiscovery or compliance export accounts, and automation or integration accounts that read many files."
    tuning_guidance = "Add automation and integration identities to %global_allowed_service_accounts, and compliance, migration or eDiscovery administrators to %global_allowed_admin_users. Raise or lower the #access threshold per client based on baseline sync and browse volume. Use the event_count outcome to prioritise triage."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $access.target.url = /sharepoint/ nocase or
      $access.target.application = /sharepoint/ nocase
    )
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($access.metadata.id)
    $mitre_technique_id = array_distinct("T1213.002")
    $primary_entity = array_distinct($user)
    $accessed_urls = array_distinct($access.target.url)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    #access >= 50
}
