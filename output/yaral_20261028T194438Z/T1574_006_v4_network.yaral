/*
  MITRE Technique : T1574.006 - Dynamic Linker Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:32:52.780720+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_006_Linux_Shared_Object_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request from a Linux host to an external destination whose URL path ends in a shared object (.so or versioned .so.N). Dynamic linker hijacking via LD_PRELOAD or /etc/ld.so.preload requires a malicious library to be staged on disk, and remote retrieval of that library is the network-side signal. Package manager traffic, allowed domains, allowed admin tooling and internal destinations are excluded."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.006"
    mitre_technique_name = "Hijack Execution Flow: Dynamic Linker Hijacking"
    log_prerequisites = "Requires Linux endpoint network telemetry or a proxy/sensor feed normalised to NETWORK_HTTP with target.url populated. Process attribution (principal.process.file.full_path) improves tuning but is not required."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or build systems fetching prebuilt shared libraries from vendor or CDN hosts; software installers and language runtimes (Python wheels, Node native addons, JVM natives) downloading .so files; container image build steps; configuration management pulling library artifacts."
    tuning_guidance = "Add vendor and CDN domains to %global_allowed_domains. Add deployment and build tooling to %global_allowed_admin_tools. Add approved scripted download hosts to %global_allowed_script_hosts. Pair alerts with endpoint FILE_CREATION or FILE_MODIFICATION telemetry on /etc/ld.so.preload and library directories for triage."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/[^\/?#]+\.so(\.[0-9]+)*([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.network.http.user_agent = /(apt|dpkg|yum|dnf|zypper|rpm|pacman)/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1574.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $source_processes = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
