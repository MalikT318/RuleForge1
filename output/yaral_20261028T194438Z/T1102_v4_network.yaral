/*
  MITRE Technique : T1102 - Web Service
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:52:56.866489+00:00
  Reference       : https://attack.mitre.org/techniques/T1102
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_Linux_Scripted_Client_Web_Service_API_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP POST/PUT requests to API-style, webhook, bot, paste or file-storage URL paths on external web services, made by a scripted command-line HTTP client (curl, wget, Python, Go and similar user agents) as seen in firewall or proxy logs. Browsers do not use these user agents, so this pattern fits a Linux host relaying C2 or exfiltration data through a legitimate web service (T1102). It is network-side coverage and does not rely on endpoint process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102"
    mitre_technique_name = "Web Service"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection (TLS inspection or explicit proxy) that populate network.http.method, network.http.user_agent and target.url, normalised to NETWORK_HTTP. Without TLS inspection, URL paths and user agents are not visible and this rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate automation on Linux servers: CI/CD runners and deployment scripts calling SaaS APIs, monitoring and alerting agents posting to chat webhooks, backup scripts uploading to cloud storage, package or configuration management tools, and cron jobs reporting to ticketing systems."
    tuning_guidance = "Add approved SaaS and vendor API domains to %global_allowed_domains. Exclude known automation subnets or hosts with the source-side lists %global_allowed_scanners or %global_allowed_mgmt_sources if your tenant populates them. Raise severity for server segments that should have no outbound API access. Narrow the user agent or URL path regex if one client or service produces most of the noise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl|aiohttp)\b/ nocase
    $net.target.url = /\/(api|bot[^\/]*|webhooks?|hooks|gists?|paste|upload|messages|files|drive|graph|v[0-9]+)\// nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1102")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
