/*
  MITRE Technique : T1070.004 - File Deletion
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:05:00.891893+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_004_Unexpected_Parent_Spawns_Shell_For_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter that performs file or folder deletion and was spawned by a parent process that should never launch one (Office applications, web server workers, print spooler, database services). Pivots on process lineage rather than the deletion command alone, to catch post-exploitation cleanup of dropped payloads and artefacts through webshells, malicious documents, spooler exploitation or database command execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.004"
    mitre_technique_name = "Indicator Removal: File Deletion"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and child command line (EDR, Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins that clean up temp files, web applications that shell out to clean cache or upload directories, database maintenance jobs (xp_cmdshell housekeeping), print drivers or spooler-based cleanup, and software installers launched from web or database service accounts."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Extend the parent regex with client-specific application server process names if needed. Review the parent_process and command_line outcome values to separate legitimate cleanup jobs from attacker activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /\b(del|erase|rmdir|rd)\s+(\/[a-z]\s+)*\S|remove-item|\[io\.file\]::delete|\.delete\(|cipher(\.exe)?\s+\/w/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1070.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
