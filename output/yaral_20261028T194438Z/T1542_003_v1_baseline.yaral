/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:46:07.551318+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_Linux_Raw_Boot_Disk_Write_Via_dd {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects dd writing directly to a whole raw block device (not a partition) with MBR-sized block or count parameters. This is the core OS mechanism for overwriting the MBR or boot code ahead of the bootloader, as bootkits and boot-sector wipers do."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with full command line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators restoring or re-imaging a bootloader or MBR backup, provisioning scripts that write disk images, disk-wipe or secure-erase procedures during hardware decommissioning, and installer or recovery environments."
    tuning_guidance = "Add approved imaging, provisioning and recovery tooling to %global_allowed_backup_processes and %global_allowed_admin_tools (matched against the parent process path). Add known provisioning service accounts to %global_allowed_service_accounts. For hosts under maintenance windows, suppress by host in the SIEM rather than editing the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/dd$/ nocase
    $proc.target.process.command_line = /(^|\s)of=\/dev\/(sd[a-z]+|hd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)(\s|$)/ nocase
    $proc.target.process.command_line = /(^|\s)(bs=(440|446|512)|count=1)(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
