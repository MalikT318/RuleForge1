/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:48:01.474345+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_Linux_Boot_Partition_Bulk_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple file modifications within the EFI System Partition or GRUB boot directories on a single Linux host within 10 minutes, by processes that are not package managers or approved admin tooling. Bootkits and boot loader implants patch EFI binaries, GRUB modules and boot configuration to execute before the OS loads. A single write is common during updates, but a burst from an unexpected process is not."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules on /boot, /boot/efi and /efi, normalised to UDM FILE_MODIFICATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Kernel and boot loader package upgrades, firmware updates (fwupd), grub-install or update-grub run by administrators, initramfs regeneration, image-build and provisioning pipelines, secure boot key enrolment, dual-boot maintenance."
    tuning_guidance = "Add approved patching, provisioning and boot maintenance binaries (full path) to %global_allowed_admin_tools. Raise the #boot threshold for hosts that routinely rebuild boot images. Review the $modified_paths and $writer_processes outcomes to confirm the writer is not a shell, interpreter or a binary running from /tmp or /dev/shm."

  events:
    $boot.metadata.event_type = "FILE_MODIFICATION"
    $boot.target.file.full_path = /^\/(boot\/efi\/EFI|efi\/EFI|boot\/EFI|boot\/grub2?)\// nocase
    $boot.principal.hostname = $host
    not $boot.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|dnf|yum|zypper|packagekitd|fwupd|fwupdmgr|unattended-upgrade)$/ nocase
    not $boot.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($boot.target.file.full_path = /\.efi$/ nocase, 90, 70))
    $event_count = count($boot.metadata.id)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity = array_distinct($host)
    $modified_paths = array_distinct($boot.target.file.full_path)
    $writer_processes = array_distinct($boot.principal.process.file.full_path)
    $writer_users = array_distinct($boot.principal.user.userid)

  condition:
    #boot >= 5
}
