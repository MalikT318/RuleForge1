/*
  MITRE Technique : T1566 - Phishing
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:45:16.946896+00:00
  Reference       : https://attack.mitre.org/techniques/T1566
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_Phishing_External_Login_Then_Privilege_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a likely post-phishing account takeover: a user account authenticates from an external (non-RFC1918) source and, within 10 minutes, that same account makes a permission or privilege change. This is a typical follow-on to credential phishing or adversary-in-the-middle token theft. It adds identity-layer coverage and does not duplicate process-creation or command-line rules."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566"
    mitre_technique_name = "Phishing"
    log_prerequisites = "Requires identity provider or directory authentication and audit logs normalised to UDM USER_LOGIN and USER_CHANGE_PERMISSIONS, with the source IP in principal.ip and the account in target.user.userid or principal.user.userid."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Administrators or help-desk staff working remotely over VPN or from home who make legitimate permission changes. Newly onboarded users whose access is provisioned at first login. Automation run under a user account. Corporate egress IPs not included in %rfc1918_internal."
    tuning_guidance = "Add expected privileged operators to %global_allowed_admin_users. Add automation and service identities to %global_allowed_service_accounts. If VPN or proxy egress addresses generate noise, handle them through the client's %rfc1918_internal or %global_allowed_mgmt_sources mappings, or extend the rule with a client-specific exclusion."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = $user
    not $auth.principal.ip in %rfc1918_internal
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid in %global_allowed_service_accounts

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts

    $auth.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1566")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $login_count = count($auth.metadata.id)
    $permission_change_count = count($perm.metadata.id)

  condition:
    $auth and $perm
}
