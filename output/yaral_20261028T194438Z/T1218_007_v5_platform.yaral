/*
  MITRE Technique : T1218.007 - Msiexec
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:50:33.569426+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_007_AlwaysInstallElevated_Policy_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows Installer AlwaysInstallElevated policy being enabled in the registry. This makes every msiexec.exe package run as SYSTEM, which turns msiexec proxy execution into privilege escalation. Msiexec is Windows-only, so this rule covers it through registry telemetry (policy tampering) rather than process command lines. It complements existing PROCESS_LAUNCH detections."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1218.007"
    mitre_technique_name = "System Binary Proxy Execution: Msiexec"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) populating target.registry.registry_key and target.registry.registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy pushes by legacy software-deployment designs that deliberately enable AlwaysInstallElevated, IT build and imaging scripts, and admins testing installer policy. Domain GPO application normally appears as a svchost-initiated write."
    tuning_guidance = "Add approved deployment or configuration tooling to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. This policy is rarely legitimate, so keep exclusions narrow. Consider a companion rule on REGISTRY_CREATION if the EDR reports first-time value writes as creation events."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Windows\\Installer(\\AlwaysInstallElevated)?$/ nocase
    (
      $reg.target.registry.registry_value_name = "AlwaysInstallElevated" nocase or
      $reg.target.registry.registry_key = /\\AlwaysInstallElevated$/ nocase
    )
    $reg.target.registry.registry_value_data = /^(DWORD \()?(0x0*1|1)\)?$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.007")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
