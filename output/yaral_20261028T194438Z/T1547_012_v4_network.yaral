/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:39:07.441135+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_Spoolsv_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows Print Spooler service (spoolsv.exe) making an outbound connection to a non-internal address. A malicious print processor DLL (T1547.012) runs inside spoolsv.exe as SYSTEM, so its C2 beaconing or payload retrieval shows up as network activity from the spooler process. Legitimate spooler traffic is almost entirely to internal print servers and printers."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process (EDR network events or Sysmon Event ID 3) normalised to NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Cloud-based or hybrid print services (secure print release, universal print connectors), printers or print servers reachable on public or non-RFC1918 address space (for example, carrier-NAT or IPv6 ranges), and Microsoft driver or update retrieval initiated by the spooler."
    tuning_guidance = "Add known-good cloud print and vendor update domains to %global_allowed_domains. Ensure %rfc1918_internal covers the client's internal ranges. For clients with legitimate non-RFC1918 print infrastructure, add the destination hostnames to %global_allowed_domains. Pivot on the host to check for recent registry changes under the Print Processors key and new DLLs in the print-processor directory."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\spoolsv\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
