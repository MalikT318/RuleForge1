/*
  MITRE Technique : T1484.001 - Group Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:33:47.078500+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_001_GPO_SYSVOL_Bulk_Policy_File_Writes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of modifications to security-relevant Group Policy files (GptTmpl.inf, Registry.pol, ScheduledTasks.xml, Groups.xml, logon/startup scripts) under SYSVOL Policies GUID folders from a single host within 10 minutes. A single GPO file write is routine, but repeated writes to several policy payload files suggest malicious GPO tampering for persistence, privilege escalation or defense impairment. Complements process command-line rules by using file telemetry."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.001"
    mitre_technique_name = "Domain or Tenant Policy Modification: Group Policy Modification"
    log_prerequisites = "Requires EDR or Sysmon file-modification telemetry (Sysmon Event ID 11/23 equivalents) on domain controllers and admin workstations, with SYSVOL paths populated in target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate GPO edits by domain admins using GPMC, bulk GPO imports or migrations, GPO backup/restore operations, security baseline deployment tooling, and SYSVOL replication (DFSR) on domain controllers."
    tuning_guidance = "Add approved GPO administrators to %global_allowed_admin_users, GPO management and deployment tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on DCs with heavy DFSR activity, or lower it for high-security environments."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\sysvol\\[^\\]+\\policies\\\{[0-9a-f\-]{36}\}\\/ nocase
    $file.target.file.full_path = /(\\(gpttmpl\.inf|registry\.pol|scheduledtasks\.xml|immediatetasks\.xml|groups\.xml|services\.xml|files\.xml|datasources\.xml|scripts\.ini|psscripts\.ini)$|\\scripts\\(startup|shutdown|logon|logoff)\\)/ nocase
    $file.principal.hostname = $host
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $file_count = count($file.metadata.id)
    $risk_score = max(if($file_count >= 15, 85, 65))
    $mitre_technique_id = array_distinct("T1484.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($file.principal.user.userid)
    $modified_paths = array_distinct($file.target.file.full_path)

  condition:
    #file >= 5
}
