/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:22:31.792067+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_Linux_Shell_Environment_Guardrail_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux shell invoked with -c whose command line queries a host-specific identity value (hostname, domain name, machine-id, host ID, interface address, resolver config), compares it to an expected value, and then either exits or launches a payload depending on the result. This is the shell-level pattern of an execution guardrail, where a payload runs only on the intended target."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with full command lines populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and provisioning scripts (node-specific bootstrap logic), cloud-init and user-data scripts, deployment and licensing checks keyed to the hostname or machine-id, and administrators running one-liners that check the hostname before acting."
    tuning_guidance = "Add approved deployment, configuration management and RMM parent processes to %global_allowed_admin_tools. Add known automation parents or hosts to %global_allowed_script_hosts. Add service accounts that run node-aware bootstrap scripts to %global_allowed_service_accounts. If provisioning hosts are noisy, raise severity only for command lines that reference /tmp, /dev/shm or /var/tmp."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash)$/ nocase
    $proc.target.process.command_line = /\s-[a-zA-Z]*c\s/ nocase
    // Step 1: query of an environment-specific value
    $proc.target.process.command_line = /(\bhostname\b|\bhostnamectl\b|\bdnsdomainname\b|\bdomainname\b|machine-id|\bhostid\b|\buname\s+-n\b|realm\s+list|\bip\s+(-4\s+|-6\s+)?a(ddr)?\b|\bifconfig\b|\/etc\/resolv\.conf)/ nocase
    // Step 2: comparison against an expected value
    $proc.target.process.command_line = /(\bgrep\s+-[a-zA-Z]*q|\[\[?\s[^\]]*(==?|!=)|\btest\s[^;&|]*(=|!=)|\bcase\s+[^;]*\sin\b)/ nocase
    // Step 3: conditional exit, or gated payload execution
    $proc.target.process.command_line = /(\|\|\s*(exit|kill|rm)\b|&&\s*(exec\s+|nohup\s+)?(\.\/|\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|curl\b|wget\b|python[0-9.]*\b|perl\b|base64\b)|\bthen\s+[^;]*(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|curl\b|wget\b))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
