/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:13:29.797307+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Systemctl_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects systemctl (directly, or via a shell wrapper) starting, enabling, linking or reloading systemd units when the parent process is a web server, application runtime, database, print or file-sharing service. These processes do not normally manage systemd units. This lineage typically indicates a web shell, injected code or a compromised service executing commands through systemd to gain execution or persistence."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records, normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path (parent), target.process.file.full_path (child) and target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application deployment or self-update hooks run by a web or application server; Java-based tools (CI servers, application servers) that restart their own units; database packages whose maintainer scripts reload units; control-panel software that restarts web services. All are usually limited to a few known hosts."
    tuning_guidance = "Add legitimate parent binaries (full path) to %global_allowed_admin_tools or %global_allowed_script_hosts. Narrow or extend the parent regex for the client's stack (for example, remove java where it is a general-purpose runtime). Review hosts with repeated hits and add approved deployment tooling to the allowlists rather than loosening the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    (
      $proc.target.process.file.full_path = /\/systemctl$/ nocase or
      $proc.target.process.file.full_path = /\/(ba|da|z|a|k)?sh$/ nocase
    )
    $proc.target.process.command_line = /\bsystemctl\b.*\b(start|restart|try-restart|reload-or-restart|enable|link|daemon-reload|isolate)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
