/*
  MITRE Technique : T1505.005 - Terminal Services DLL
  Tactic(s)       : Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:33:08.439237+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_005_TermService_ServiceDll_Hijack_After_Dll_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a DLL written to a user-writable or staging location followed, on the same host within 10 minutes, by a modification of the TermService ServiceDll registry value. This sequence indicates the Terminal Services service is being repointed at an attacker-supplied DLL, which then loads inside svchost.exe. The rule relies on file and registry telemetry rather than process command lines."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.005"
    mitre_technique_name = "Server Software Component: Terminal Services DLL"
    log_prerequisites = "Requires endpoint file creation and registry modification telemetry (EDR or Sysmon file-create and registry-set events) that includes the registry key path and value name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Remote Desktop Services patching or feature updates, RDP wrapper or multi-session tooling deployed by IT, RMM or software deployment agents that reconfigure Terminal Services, and security products that stage DLLs in ProgramData."
    tuning_guidance = "Add approved deployment and patching binaries to %global_allowed_admin_tools, approved remote support tooling to %global_allowed_remote_mgmt, and EDR/AV agents to %global_allowed_security_tools. If a client legitimately uses a custom RDS component, scope an exclusion by the writing process, not by DLL path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(programdata|users|windows\\temp|perflogs|temp)\\.*\.dll$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\services\\termservice\\parameters$/ nocase
    $reg.target.registry.registry_value_name = "ServiceDll" nocase
    not $reg.target.registry.registry_value_data = /(^|\\)termsrv\.dll$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1505.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_dll_paths = array_distinct($file.target.file.full_path)
    $dll_writer_processes = array_distinct($file.principal.process.file.full_path)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $new_service_dll_values = array_distinct($reg.target.registry.registry_value_data)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
