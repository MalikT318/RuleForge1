/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:29:23.632133+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Cloud_Firewall_Mass_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity makes five or more firewall or security group changes (rule authorize/revoke, create/delete, modify) within ten minutes. One change is routine; a burst is typical of an adversary opening ingress, removing network restrictions, or clearing rules to enable access or cryptomining."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Disable or Modify Cloud Firewall"
    log_prerequisites = "Cloud control-plane audit logs ingested and parsed to UDM with metadata.product_event_type populated (API operation name). Management and write events must be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines applying network changes, autoscaling or orchestration services, network engineers during migrations or incident response, and cloud-native security automation that remediates rules."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved admins to %global_allowed_admin_users, and approved cloud principals to %global_allowed_cloud_principals. Raise the #cloud threshold for environments with heavy IaC activity, or lower it for high-sensitivity accounts."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(?i)(SecurityGroup|NetworkAcl|FirewallPolicy|FirewallRule|firewalls\.(insert|patch|update|delete)|securityRules|networkSecurityGroups|NetworkSecurityGroup)/
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($user)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $affected_resources = array_distinct($cloud.target.resource.name)

  condition:
    #cloud >= 5
}
