/*
  MITRE Technique : T1560.001 - Archive via Utility
  Tactic(s)       : Collection
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:57:51.802159+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_001_Linux_Service_Parent_Spawns_Archiver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application runtime or database service process launching an archive/compression utility, directly or through a shell one-liner. These service processes do not normally package files, so this lineage suggests a webshell or injected code staging collected data for exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.001"
    mitre_technique_name = "Archive Collected Data: Archive via Utility"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates both the parent process path (principal.process.file.full_path) and the child process path (target.process.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application-level backup or log-rotation hooks run by a web or database service, CMS plugins that build zip exports, database dump scripts launched by the DB engine, and deployment or build jobs run under a service runtime."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, approved admin or deployment tooling to %global_allowed_admin_tools, and legitimate service accounts to %global_allowed_service_accounts. If a specific application legitimately archives files, exclude it by parent executable name, not by install directory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|php-fpm[0-9.]*|php[0-9.]*|php-cgi|uwsgi|gunicorn|tomcat[0-9]*|node|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(tar|zip|gzip|bzip2|xz|zstd|pigz|7z|7za|7zr|rar|cpio)$/ nocase or
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash)$/ nocase and
        $proc.target.process.command_line = /\b(tar|zip|gzip|bzip2|xz|zstd|pigz|7z|7za|7zr|rar|cpio)\b/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1560.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
