/*
  MITRE Technique : T1110.004 - Credential Stuffing
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:09:38.334447+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_004_Failed_Logon_Unknown_Account_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a failed authentication against a Windows domain account that does not exist, from a non-internal source address. Breach-dump credential stuffing replays third-party username lists, so many pairs hit nonexistent directory accounts. This is identity-provider authentication coverage and is not a process or command-line detection. Single-event by design: it flags the per-attempt stuffing signature, and aggregate volume is handled by threshold coverage."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.004"
    mitre_technique_name = "Brute Force: Credential Stuffing"
    log_prerequisites = "Requires directory or identity sign-in logs (for example domain controller logon failures, Event 4625/4771/4776 equivalents, or federated sign-in logs) normalized to USER_LOGIN. The parser must populate the failure reason in security_result.summary or security_result.description, and the source address in principal.ip."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Users mistyping their username from home or mobile networks, stale credentials in mail clients or mobile devices after offboarding, misconfigured applications using decommissioned accounts, authorized external vulnerability scanners and penetration tests."
    tuning_guidance = "Add authorized scanner source addresses to %global_allowed_scanners. Add automation or legacy service identifiers to %global_allowed_service_accounts. If external sign-ins are expected, route the rule through a higher-fidelity downstream threshold or correlation rule rather than alerting on single events. Confirm the failure-reason wording for each client parser and extend the regex if needed."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.action = "BLOCK"
    (
      $auth.security_result.description = /(0xC0000064|user (name )?(does not exist|not found|unknown)|unknown (user|username)|no such (user|account)|account does not exist|invalid (user|username)|nonexistent (user|account))/ nocase or
      $auth.security_result.summary = /(0xC0000064|user (name )?(does not exist|not found|unknown)|unknown (user|username)|no such (user|account)|account does not exist|invalid (user|username)|nonexistent (user|account))/ nocase
    )
    $auth.target.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_scanners
    not $auth.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1110.004")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    $auth
}
